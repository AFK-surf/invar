// Phase 28-A: First Pure Pion Native Apple Metal + CoreText + iOS 27 Liquid Glass Offscreen Render
import "invar_host"

// Exported C callback invoked from C via c_fn_ptr (verifies P26-B export extern "C" fn)
extern "C" fn on_render_frame(w : Double, h : Double, scale : Double) -> Int = "pion_metal_glass_frame" {
  let s = invar_host::init_offscreen(w, h, scale)

  // ---------------------------------------------------------------------------
  // 1. Rich Vibrant Atmospheric Backdrop (gives Liquid Glass real geometry to refract!)
  // ---------------------------------------------------------------------------
  // Soft ambient color blooms via wide Gaussian shadows
  s.add_shadow(60.0, 40.0, 260.0, 260.0, 130.0, 95.0, 0.0, invar_host::rgb_hex(0x2563EB, 0.55), false)
  s.add_shadow(620.0, 20.0, 280.0, 220.0, 110.0, 90.0, 0.0, invar_host::rgb_hex(0xEC4899, 0.50), false)
  s.add_shadow(340.0, 320.0, 300.0, 200.0, 100.0, 95.0, 0.0, invar_host::rgb_hex(0x06B6D4, 0.45), false)
  s.add_shadow(720.0, 340.0, 220.0, 180.0, 90.0, 80.0, 0.0, invar_host::rgb_hex(0xF59E0B, 0.42), false)

  // Crisp colorful geometric ribbons behind the Liquid Glass panels so optical refraction is unmistakable
  s.add_rect(54.0, 96.0, 14.0, 360.0, 7.0, invar_host::rgb_hex(0x38BDF8, 0.85))
  s.add_rect(82.0, 120.0, 8.0, 310.0, 4.0, invar_host::rgb_hex(0x818CF8, 0.70))
  s.add_rect(510.0, 84.0, 44.0, 390.0, 22.0, invar_host::rgb_hex(0xF43F5E, 0.56))

  // High-contrast spectrum bars specifically positioned behind the Right-Top Optical Liquid Glass Lens
  s.add_rect(622.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0x06B6D4, 0.92))
  s.add_rect(672.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0x8B5CF6, 0.92))
  s.add_rect(722.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0xEC4899, 0.92))
  s.add_rect(772.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0xF59E0B, 0.92))
  s.add_rect(822.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0x10B981, 0.92))
  s.add_rect(872.0, 94.0, 36.0, 184.0, 18.0, invar_host::rgb_hex(0x3B82F6, 0.92))
  // Horizontal bright accent bar cutting across the lower bevel of the lens
  s.add_rect(596.0, 226.0, 336.0, 14.0, 7.0, invar_host::rgb_hex(0xF8FAFC, 0.85))

  // Vibrant horizontal ribbon behind the Bottom Floating Liquid Glass Dock
  s.add_rect(120.0, 488.0, 240.0, 24.0, 12.0, invar_host::rgb_hex(0x38BDF8, 0.88))
  s.add_rect(368.0, 488.0, 224.0, 24.0, 12.0, invar_host::rgb_hex(0xA855F7, 0.88))
  s.add_rect(600.0, 488.0, 240.0, 24.0, 12.0, invar_host::rgb_hex(0xFB7185, 0.88))

  // ---------------------------------------------------------------------------
  // 2. Top Navigation Pill (iOS 27 Dark Liquid Glass)
  // ---------------------------------------------------------------------------
  s.add_liquid_glass(
    40.0, 26.0, 880.0, 52.0, 26.0,
    2.5, 1.35, invar_host::rgb_hex(0x141928, 0.55),
    0.70, 14.0, 9.0, 0.18, 1.0,
  )
  s.add_shadow(40.0, 26.0, 880.0, 52.0, 26.0, 18.0, 8.0, invar_host::rgb_hex(0x000000, 0.42), true)

  // Brand dot + title (baseline-aligned inside y=26..78 pill)
  s.add_rect(62.0, 46.0, 12.0, 12.0, 6.0, invar_host::rgb_hex(0x38BDF8, 1.0))
  let _ = s.draw_text("Pion × Metal", 84.0, 42.5, 16.0, 700, 0, invar_host::rgb_hex(0xF8FAFC, 1.0))
  let _ = s.draw_text("原生 GPU 离屏首帧 · Phase 28-A", 200.0, 45.0, 13.0, 400, 0, invar_host::rgb_hex(0xCBD5E1, 0.90))

  // Top-right status badges
  s.add_bordered_rect(552.0, 38.0, 102.0, 28.0, 14.0, invar_host::rgb_hex(0x38BDF8, 0.16), 1.0, invar_host::rgb_hex(0x38BDF8, 0.45))
  s.draw_text_centered("Apple Metal", 552.0, 38.0, 102.0, 28.0, 11.5, 600, 0, invar_host::rgb_hex(0x7DD3FC, 1.0))

  s.add_bordered_rect(664.0, 38.0, 116.0, 28.0, 14.0, invar_host::rgb_hex(0xA855F7, 0.18), 1.0, invar_host::rgb_hex(0xC084FC, 0.45))
  s.draw_text_centered("CoreText 中英", 664.0, 38.0, 116.0, 28.0, 11.5, 600, 0, invar_host::rgb_hex(0xE9D5FF, 1.0))

  s.add_bordered_rect(790.0, 38.0, 112.0, 28.0, 14.0, invar_host::rgb_hex(0x10B981, 0.18), 1.0, invar_host::rgb_hex(0x34D399, 0.45))
  s.draw_text_centered("Liquid Glass", 790.0, 38.0, 112.0, 28.0, 11.5, 600, 0, invar_host::rgb_hex(0xA7F3D0, 1.0))

  // ---------------------------------------------------------------------------
  // 3. Left Hero Card (iOS 27 Dark Liquid Glass + Bilingual CoreText)
  // ---------------------------------------------------------------------------
  s.add_liquid_glass(
    40.0, 102.0, 540.0, 344.0, 24.0,
    3.5, 1.35, invar_host::rgb_hex(0x111726, 0.62),
    0.72, 18.0, 11.0, 0.20, 1.0,
  )
  s.add_shadow(40.0, 102.0, 540.0, 344.0, 24.0, 26.0, 12.0, invar_host::rgb_hex(0x000000, 0.48), true)

  // Eyebrow pill
  s.add_rect(68.0, 128.0, 188.0, 24.0, 12.0, invar_host::rgb_hex(0x38BDF8, 0.18))
  s.draw_text_centered("PURE PION NATIVE HOST", 68.0, 128.0, 188.0, 24.0, 10.5, 700, 0, invar_host::rgb_hex(0x7DD3FC, 1.0))

  // Main bilingual headline
  let _ = s.draw_text("纯 Pion 原生渲染引擎", 68.0, 164.0, 28.0, 700, 0, invar_host::rgb_hex(0xFFFFFF, 1.0))
  let _ = s.draw_text(
    "零 MoonBit 运行时 · 100% 复用 mbui Objective-C 宿主",
    68.0, 204.0, 14.0, 400, 0, invar_host::rgb_hex(0xCBD5E1, 0.92),
  )

  // Hairline divider
  s.add_rect(68.0, 236.0, 484.0, 1.0, 0.0, invar_host::rgb_hex(0xFFFFFF, 0.14))

  // 3 feature rows
  s.add_rect(68.0, 256.0, 8.0, 8.0, 4.0, invar_host::rgb_hex(0x38BDF8, 1.0))
  let _ = s.draw_text("Metal Pipeline", 88.0, 250.0, 13.5, 600, 0, invar_host::rgb_hex(0xF8FAFC, 1.0))
  let _ = s.draw_text("60-float 实例管线 · array_data_ptr 零拷贝直通 GPU", 214.0, 250.0, 13.0, 400, 0, invar_host::rgb_hex(0x94A3B8, 1.0))

  s.add_rect(68.0, 290.0, 8.0, 8.0, 4.0, invar_host::rgb_hex(0xC084FC, 1.0))
  let _ = s.draw_text("CoreText Atlas", 88.0, 284.0, 13.5, 600, 0, invar_host::rgb_hex(0xF8FAFC, 1.0))
  let _ = s.draw_text("UTF-8 → UTF-16 桥接 · 4096² R8 字形图集精准基线", 214.0, 284.0, 13.0, 400, 0, invar_host::rgb_hex(0x94A3B8, 1.0))

  s.add_rect(68.0, 324.0, 8.0, 8.0, 4.0, invar_host::rgb_hex(0x34D399, 1.0))
  let _ = s.draw_text("Liquid Glass", 88.0, 318.0, 13.5, 600, 0, invar_host::rgb_hex(0xF8FAFC, 1.0))
  let _ = s.draw_text("iOS 27 四分之一圆倒角折射 · 色散与高光轮廓", 214.0, 318.0, 13.0, 400, 0, invar_host::rgb_hex(0x94A3B8, 1.0))

  // Bottom CTA row inside Hero Card
  s.add_bordered_rect(68.0, 376.0, 248.0, 40.0, 20.0, invar_host::rgb_hex(0x3B82F6, 0.92), 1.0, invar_host::rgb_hex(0x93C5FD, 0.55))
  s.draw_text_centered("Metal Offscreen · 1920×1120 @2x", 68.0, 376.0, 248.0, 40.0, 13.0, 600, 0, invar_host::rgb_hex(0xFFFFFF, 1.0))

  s.add_bordered_rect(330.0, 376.0, 222.0, 40.0, 20.0, invar_host::rgb_hex(0xFFFFFF, 0.08), 1.0, invar_host::rgb_hex(0xFFFFFF, 0.22))
  s.draw_text_centered("Upstream apple_*.m: 0 改动", 330.0, 376.0, 222.0, 40.0, 13.0, 500, 0, invar_host::rgb_hex(0xE2E8F0, 1.0))

  // ---------------------------------------------------------------------------
  // 4. Right-Top Card: Pure Clear iOS 27 Optical Liquid Glass Lens
  // ---------------------------------------------------------------------------
  // Clear Liquid Glass (blur = 0.0, tint alpha < 0.12 -> is_clear = true!)
  // Shows unmistakable optical refraction & chromatic dispersion of the spectrum bars behind it
  s.add_liquid_glass(
    604.0, 102.0, 316.0, 168.0, 26.0,
    0.0, 1.25, invar_host::rgb_hex(0xFFFFFF, 0.04),
    0.92, 22.0, 14.0, 0.28, 1.0,
  )
  s.add_shadow(604.0, 102.0, 316.0, 168.0, 26.0, 22.0, 10.0, invar_host::rgb_hex(0x000000, 0.44), true)

  // Floating legible label pill inside the clear optical lens
  s.add_bordered_rect(632.0, 136.0, 260.0, 72.0, 16.0, invar_host::rgb_hex(0x0B1020, 0.76), 1.0, invar_host::rgb_hex(0xFFFFFF, 0.24))
  s.draw_text_centered("iOS 27 Clear Liquid Glass", 632.0, 144.0, 260.0, 28.0, 15.0, 700, 0, invar_host::rgb_hex(0xFFFFFF, 1.0))
  s.draw_text_centered("光学折射 · 22pt 倒角 · 色散透镜", 632.0, 172.0, 260.0, 26.0, 12.5, 400, 0, invar_host::rgb_hex(0xE2E8F0, 0.95))

  // ---------------------------------------------------------------------------
  // 5. Right-Bottom Card: Frosted Glass + Monospace Host Verification
  // ---------------------------------------------------------------------------
  s.add_frosted_glass(
    604.0, 290.0, 316.0, 156.0, 22.0,
    14.0, 1.4, invar_host::rgb_hex(0x13192B, 0.68),
    0.16, 0.22, 0.06, 1.0,
  )
  s.add_shadow(604.0, 290.0, 316.0, 156.0, 22.0, 20.0, 10.0, invar_host::rgb_hex(0x000000, 0.42), true)

  let _ = s.draw_text("原生宿主零修改清单", 626.0, 310.0, 15.0, 600, 0, invar_host::rgb_hex(0xF8FAFC, 1.0))
  let _ = s.draw_text("apple_render.m · apple_text.m", 626.0, 342.0, 12.0, 400, 2, invar_host::rgb_hex(0x7DD3FC, 0.95))
  let _ = s.draw_text("apple_image.m  · apple_film.m", 626.0, 366.0, 12.0, 400, 2, invar_host::rgb_hex(0x7DD3FC, 0.95))
  s.add_rect(626.0, 396.0, 272.0, 1.0, 0.0, invar_host::rgb_hex(0xFFFFFF, 0.12))
  let _ = s.draw_text("Compat Shim: ~150 LOC · zero-copy FFI", 626.0, 408.0, 12.0, 500, 0, invar_host::rgb_hex(0x34D399, 1.0))

  // ---------------------------------------------------------------------------
  // 6. Bottom Floating Liquid Glass Dock (over the 3-color bottom ribbon)
  // ---------------------------------------------------------------------------
  s.add_liquid_glass(
    180.0, 472.0, 600.0, 56.0, 28.0,
    1.5, 1.35, invar_host::rgb_hex(0x141928, 0.45),
    0.80, 16.0, 10.0, 0.22, 1.0,
  )
  s.add_shadow(180.0, 472.0, 600.0, 56.0, 28.0, 20.0, 8.0, invar_host::rgb_hex(0x000000, 0.45), true)

  // Active tab highlight (4 equal 146pt slots across x=188..772)
  s.add_bordered_rect(626.0, 480.0, 146.0, 40.0, 20.0, invar_host::rgb_hex(0xFFFFFF, 0.16), 1.0, invar_host::rgb_hex(0xFFFFFF, 0.28))

  s.draw_text_centered("总览 Overview", 188.0, 480.0, 146.0, 40.0, 13.0, 500, 0, invar_host::rgb_hex(0xF1F5F9, 0.95))
  s.draw_text_centered("渲染 Metal", 334.0, 480.0, 146.0, 40.0, 13.0, 500, 0, invar_host::rgb_hex(0xF1F5F9, 0.95))
  s.draw_text_centered("排版 CoreText", 480.0, 480.0, 146.0, 40.0, 13.0, 500, 0, invar_host::rgb_hex(0xF1F5F9, 0.95))
  s.draw_text_centered("玻璃 Glass", 626.0, 480.0, 146.0, 40.0, 13.0, 700, 0, invar_host::rgb_hex(0xFFFFFF, 1.0))

  // Render on Apple Metal GPU & snapshot to PNG
  let ok = s.render_and_snapshot(0.051, 0.067, 0.110, "out/pion_metal_glass.png")
  if ok { 1 } else { 0 }
}

pub fn main(world : World) -> Int {
  let res = invar_host::invoke_frame_cb(c_fn_ptr(on_render_frame), 960.0, 560.0, 2.0)
  if res == 1 {
    io_println(world, "OK: rendered out/pion_metal_glass.png (960x560 @2x = 1920x1120)")
    0
  } else {
    io_println(world, "ERR: render_and_snapshot failed")
    1
  }
}
