// Render-thread view built 100% with Pion-JSX + Leading-Dot `.Enum` + `packages/lg` + `ui::Worker`.
// Zero `let _ =` boilerplate inside the JSX tree, zero hand-rolled liquid glass, zero nested glass.

import "kit"
import "lg"
import "signals"
import "ui"
import "view"

/// Build the reactive Pion-JSX view tree connected to `worker`.
pub fn build_view(root : view::View, worker : ui::Worker[Cmd, Ev]) -> Unit {
  let next_seq = signals::signal(1)
  let done_count = signals::signal(0)
  let auto_log = signals::signal(true)
  let batch_size = signals::signal(4.0)
  let status = signals::signal("Ready — press Run Job")
  let log_text = signals::signal("Worker initialized.\nWaiting for jobs...")

  worker.bind(fn(ev : Ev) -> Unit {
    match ev {
      Ev::JobDone(seq, summary) => {
        done_count.set(seq)
        status.set(summary)
        if auto_log.untracked() {
          log_text.set("\{log_text.untracked()}\n[\{seq}] \{summary}")
        }
      }
      Ev::Cleared => {
        next_seq.set(1)
        done_count.set(0)
        status.set("Reset — ready")
        log_text.set("Worker log cleared.")
      }
    }
  })

  <ui::Col in={root} fill pad={16.0} gap={12.0}>
    <lg::Panel radius={20.0} pad={16.0} gap={12.0} label="Invar JSX App">
      <ui::Row align={.Middle} gap={8.0} rigid>
        <kit::IconView kind={.Refresh} size={16.0} color={0x0A84FFFFL} />
        <ui::Text size={16.0} weight={700} text="Invar JSX Worker" />
        <ui::Spacer />
        <lg::Badge label_by=>{"Done: \{done_count.get()}"} tone={.Accent} dot />
      </ui::Row>
      <ui::Text size={13.0} text_by=>{status.get()} />
      <ui::Box height={130.0} rigid radius={12.0} bg={0x00000014L} clip>
        <ui::Scroll>
          <ui::Col gap={6.0} pad={10.0}>
            <ui::Text size={12.0} wrap text_by=>{log_text.get()} />
            <ui::Box height={260.0} />
          </ui::Col>
        </ui::Scroll>
      </ui::Box>
      <ui::Row gap={8.0} align={.Middle} rigid>
        <lg::Button
          flat
          label="Run Job"
          on_press=>{
            let seq = next_seq.untracked()
            next_seq.set(seq + 1)
            let batch = batch_size.untracked().round().to_int()
            let _ = worker.send(Cmd::RunJob(seq, batch))
          }
        />
        <lg::Button
          flat
          label="Reset"
          on_press=>{
            let _ = worker.send(Cmd::Reset)
          }
        />
        <ui::Spacer />
        <lg::Badge
          label_by=>{if auto_log.get() { "Log: ON" } else { "Log: OFF" }}
          tone={.Neutral}
        />
      </ui::Row>
    </lg::Panel>
    <ui::Col gap={10.0} pad_x={8.0} rigid>
      <lg::Toggle
        on_by=>{auto_log.get()}
        on_change={fn(v : Bool) -> Unit { auto_log.set(v) }}
        label="Auto Log"
      />
      <lg::Slider
        value_by=>{batch_size.get()}
        on_change={fn(v : Double) -> Unit { batch_size.set(v) }}
        label="Batch Size"
        min={1.0}
        max={10.0}
        step={1.0}
      />
    </ui::Col>
  </ui::Col>
}
