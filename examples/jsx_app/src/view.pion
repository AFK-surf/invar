// Render-thread view built 100% with Pion-JSX + Leading-Dot `.Enum` + `packages/lg` + `ui::Worker`.
// Demonstrates Apple's Two-Layer Architecture:
// - Floating Liquid Glass chrome (`<lg::NavBar>` with `<lg::BarPillGroup>` & prominent `<lg::Button>`)
// - Clean solid Content Layer (`lg::surface().canvas`, `<lg::SurfaceCard>`, `<lg::CodeBlock>`).

import "kit"
import "lg"
import "signals"
import "ui"
import "view"

/// Build the reactive Pion-JSX view tree connected to `worker`.
pub fn build_view(root : view::View, worker : ui::Worker[Cmd, Ev]) -> Unit {
  let next_seq = signals::signal(1)
  let done_count = signals::signal(0)
  let auto_log = signals::signal(true)
  let batch_size = signals::signal(4.0)
  let status = signals::signal("Ready — press Run Job")
  let log_text = signals::signal("Worker initialized.\nWaiting for jobs...")

  let run_job = fn() -> Unit {
    let seq = next_seq.untracked()
    next_seq.set(seq + 1)
    let batch = batch_size.untracked().round().to_int()
    let _ = worker.send(Cmd::RunJob(seq, batch))
  }

  worker.bind(fn(ev : Ev) -> Unit {
    match ev {
      Ev::JobDone(seq, summary) => {
        done_count.set(seq)
        status.set(summary)
        if auto_log.untracked() {
          log_text.set("\{log_text.untracked()}\n[\{seq}] \{summary}")
        }
      }
      Ev::Cleared => {
        next_seq.set(1)
        done_count.set(0)
        status.set("Reset — ready")
        log_text.set("Worker log cleared.")
      }
    }
  })

  let _ = root.ground(view::Live::By(fn() { lg::surface().canvas }))

  <ui::Col in={root} fill pad={16.0} gap={12.0}>
    <lg::NavBar
      title="Invar JSX Worker"
      subtitle="Apple Two-Layer UI"
      trailing={fn(tr : view::View) -> Unit {
        <lg::BarPillGroup in={tr} height={36.0} label="Worker Actions">
          <lg::Button label="Reset" flat ghost on_press=>{ let _ = worker.send(Cmd::Reset) } />
        </lg::BarPillGroup>
      }}
    />
    <lg::SurfaceCard radius={28.0} pad={12.0} gap={12.0} label="Worker Console">
      <ui::Row align={.Middle} gap={8.0} rigid>
        <kit::IconView kind={.Refresh} size={16.0} color_by=>{lg::surface().accent} />
        <ui::Text size={15.0} weight={600} color_by=>{lg::surface().ink} text_by=>{status.get()} />
        <ui::Spacer />
        <lg::Badge label_by=>{"Done: \{done_count.get()}"} tone={.Accent} dot />
      </ui::Row>
      <lg::CodeBlock
        lang="log"
        code_by=>{log_text.get()}
        radius={lg::concentric(28.0, 12.0)}
        max_height={120.0}
      />
      <ui::Row gap={8.0} align={.Middle} rigid>
        <lg::Button
          prominent
          label="Run Job"
          on_press=>{run_job()}
        />
        <lg::Button
          flat
          label="Auto Log"
          active_by=>{auto_log.get()}
          on_press=>{auto_log.set(!auto_log.untracked())}
        />
        <ui::Spacer />
        <lg::Badge
          label_by=>{if auto_log.get() { "Log: ON" } else { "Log: OFF" }}
          tone={.Neutral}
        />
      </ui::Row>
    </lg::SurfaceCard>
    <ui::Col gap={8.0} pad_x={8.0} rigid>
      <lg::Slider
        value_by=>{batch_size.get()}
        on_change={fn(v : Double) -> Unit { batch_size.set(v) }}
        label="Batch Size"
        min={1.0}
        max={10.0}
        step={1.0}
      />
    </ui::Col>
  </ui::Col>
}
