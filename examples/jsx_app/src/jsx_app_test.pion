// Deterministic UI + Apple Two-Layer Liquid Glass + Scroll + Craft audit test for `examples/jsx_app`
// using `ui::Worker::inline` and `ui::Tester` (zero OS threads, zero sleep).

import "lg"
import "ui"
import "view"

test "jsx_app inline worker, toggle, scroll audit, and apple two-layer ui gate" {
  let worker = ui::Worker::inline(handle_cmd_pure)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { build_view(root, worker) },
    w=520.0,
    h=520.0,
    theme=lg::ui_theme,
  )

  // Initial state + full Apple Two-Layer UI audit (zero nested glass, coverage <= 45%, 0 scroll/craft faults)
  debug_assert(t.find("Invar JSX Worker").is_some(), "header title rendered")
  debug_assert(t.find("Done: 0").is_some(), "initial badge shows Done: 0")
  debug_assert(t.find("Log: ON").is_some(), "initial toggle badge shows Log: ON")
  lg::assert_apple_ui(t, label="jsx_app_initial")

  // Press Run Job
  t.click(view::Role::Button, label="Run Job")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 1").is_some(), "first job updates badge to Done: 1")
  debug_assert(
    t.find("Job #1 (batch 4) completed on worker").is_some(),
    "status reflects job #1 with default batch size 4",
  )
  lg::assert_apple_ui(t, label="jsx_app_after_job1")

  // Toggle Auto Log off
  t.click(view::Role::Button, label="Auto Log")
  t.frame(ms=16.0)
  debug_assert(t.find("Log: OFF").is_some(), "toggle flips Auto Log badge to Log: OFF")
  lg::assert_apple_ui(t, label="jsx_app_after_toggle")

  // Press Reset
  t.click(view::Role::Button, label="Reset")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 0").is_some(), "reset restores badge to Done: 0")
  debug_assert(t.find("Reset — ready").is_some(), "reset restores status text")
  lg::assert_apple_ui(t, label="jsx_app_after_reset")

  worker.close()
  t.dispose()
}
