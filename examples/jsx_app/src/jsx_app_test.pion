// Deterministic UI + Liquid Glass + Scroll audit test for `examples/jsx_app`
// using `ui::Worker::inline` and `ui::Tester` (zero OS threads, zero sleep).

import "lg"
import "ui"
import "view"

test "jsx_app inline worker, toggle, scroll audit, and zero nested glass" {
  let worker = ui::Worker::inline(handle_cmd_pure)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { build_view(root, worker) },
    width=520.0,
    height=460.0,
    theme=lg::ui_theme,
  )

  // Initial state + scroll & Liquid Glass audits
  debug_assert(t.find("Invar JSX Worker").is_some(), "header title rendered")
  debug_assert(t.find("Done: 0").is_some(), "initial badge shows Done: 0")
  debug_assert(t.find("Log: ON").is_some(), "initial toggle badge shows Log: ON")
  debug_assert(t.scroll_faults().length() == 0, "jsx_app has 0 scroll_faults initially")
  t.assert_scrollable(label="jsx_app_initial")
  lg::assert_no_nested_glass(t, label="jsx_app_initial")

  // Press Run Job
  t.press("Run Job")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 1").is_some(), "first job updates badge to Done: 1")
  debug_assert(
    t.find("Job #1 (batch 4) completed on worker").is_some(),
    "status reflects job #1 with default batch size 4",
  )
  t.assert_scrollable(label="jsx_app_after_job1")
  lg::assert_no_nested_glass(t, label="jsx_app_after_job1")

  // Toggle Auto Log off
  t.press("Auto Log")
  t.frame(ms=16.0)
  debug_assert(t.find("Log: OFF").is_some(), "toggle flips Auto Log badge to Log: OFF")
  lg::assert_no_nested_glass(t, label="jsx_app_after_toggle")

  // Press Reset
  t.press("Reset")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 0").is_some(), "reset restores badge to Done: 0")
  debug_assert(t.find("Reset — ready").is_some(), "reset restores status text")
  debug_assert(t.scroll_faults().length() == 0, "jsx_app keeps 0 scroll_faults after reset")
  lg::assert_no_nested_glass(t, label="jsx_app_after_reset")

  worker.close()
  t.dispose()
}
