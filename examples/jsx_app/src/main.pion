// Standard dual-thread Invar Pion-JSX application entry point.
// Render thread runs `ui::run`; background OS thread holds `World` and runs `WorkerCtx::run_loop`.

import "host"
import "lg"
import "ui"
import "view"

pub fn main(world : World) -> Int {
  host::install()
  let (worker, ctx) : (ui::Worker[Cmd, Ev], ui::WorkerCtx[Cmd, Ev]) = ui::Worker::pair()
  scope(world, fn(s : Scope) -> Unit {
    spawn(s, fn() -> Unit {
      ctx.run_loop(fn(cmd : Cmd, emit : (Ev) -> Unit) -> Unit {
        handle_cmd(world, cmd, emit)
      })
    })
    ui::run(
      "Invar JSX App",
      fn(root : view::View) -> Unit { build_view(root, worker) },
      theme=lg::ui_theme,
    )
    worker.close()
  })
  0
}
