import "host"
import "ui"

test "atlas pages check: a screen of 2000 ideographs at 48 points leaves no cell empty" {
  host::install()
  // (asked for: some seconds of a software renderer's, more than CI's budget; the film tests draw over pages on CI)
  if ui::env("ATLAS_CHECK") == "" {
    return
  }
  let g = Grid::from_env()
  match g.draw() {
    // (no offscreen renderer on this platform: nothing to check here)
    None => ()
    Some(rgba) => {
      let (empty, cells) = g.empty_cells(rgba)
      debug_assert(empty == 0, "\{empty} of \{cells} cells empty")
    }
  }
}
