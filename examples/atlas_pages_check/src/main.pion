// pionc build -o atlas_pages_check examples/atlas_pages_check && ./atlas_pages_check
// ATLAS_CHECK_OUT=<png> writes the picture; exit 0 when no cell is empty, 1 when some are, 2 with no offscreen renderer.
// As a test: ATLAS_CHECK=1 pionc test examples/atlas_pages_check (without it the test checks nothing).

import "host"
import "hostapi"
import "pixels"
import "ui"

pub fn main(world : World) -> Int {
  host::install()
  let g = Grid::from_env()
  let (pw, ph) = g.pixels()
  match g.draw() {
    None => {
      io_println(world, "atlas_pages_check: no offscreen renderer here")
      2
    }
    Some(rgba) => {
      let (empty, cells) = g.empty_cells(rgba)
      io_println(world, "atlas_pages_check: \{empty} of \{cells} cells empty (\{g.cols}x\{g.rows}, \{g.size}pt at \{g.scale}x, \{pw}x\{ph} px, atlas page \{hostapi::atlas_size(false)})")
      let out = ui::env("ATLAS_CHECK_OUT")
      if out != "" {
        match fs_write_bytes(world, out, pixels::png(pw, ph, rgba)) {
          Ok(_) => io_println(world, "atlas_pages_check: wrote \{out}")
          Err(e) => io_println(world, "atlas_pages_check: could not write \{out}: \{e}")
        }
      }
      if empty == 0 { 0 } else { 1 }
    }
  }
}
