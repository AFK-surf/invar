// Background worker protocol and command handlers for the dual-thread Invar example.
// Both `Cmd` and `Ev` are immutable enums, so they are statically `Send`.

pub enum Cmd {
  RunJob(Int)
  Reset
}

pub enum Ev {
  JobDone(Int, String)
  Cleared
}

/// Pure command handler shared by `ui::Worker::inline` (wasm32 & deterministic `ui::Tester`).
pub fn handle_cmd_pure(cmd : Cmd, emit : (Ev) -> Unit) -> Unit {
  match cmd {
    Cmd::RunJob(seq) => {
      let summary = "Job #\{seq} completed on worker"
      emit(Ev::JobDone(seq, summary))
    }
    Cmd::Reset => emit(Ev::Cleared)
  }
}

/// Native background-thread handler with explicit `World` capability for IO / clock / network work.
pub fn handle_cmd(world : World, cmd : Cmd, emit : (Ev) -> Unit) -> Unit {
  let _ = world
  match cmd {
    Cmd::RunJob(seq) => {
      let ts = clock_now_ms(world)
      let summary = "Job #\{seq} completed at \{ts} ms"
      emit(Ev::JobDone(seq, summary))
    }
    Cmd::Reset => emit(Ev::Cleared)
  }
}
