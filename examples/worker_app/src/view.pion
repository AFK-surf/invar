// Render-thread view built strictly from `signals::Signal` and `packages/lg` components.
// Zero `World` capability, zero blocking IO, zero hand-rolled liquid glass surfaces.

import "lg"
import "signals"
import "ui"
import "view"

pub fn build_view(root : view::View, worker : ui::Worker[Cmd, Ev]) -> Unit {
  let completed = signals::signal(0)
  let status = signals::signal("Ready — click Run Job to dispatch work")

  worker.bind(fn(ev : Ev) -> Unit {
    match ev {
      Ev::JobDone(seq, summary) => {
        completed.set(seq)
        status.set(summary)
      }
      Ev::Cleared => {
        completed.set(0)
        status.set("Ready — click Run Job to dispatch work")
      }
    }
  })

  let _ = root
    .padding(view::Live::Is((24.0, 24.0, 24.0, 24.0)))
    .gap(view::Live::Is(16.0))
    .ground(view::Live::By(fn() { lg::colors().paper }))

  let _ = lg::liquid_panel_node(root, fn(panel : view::View) -> Unit {
    let _ = panel.width(view::Live::Is(Some(360.0)))
    let _ = panel.box(fn(header : view::View) -> Unit {
      let _ = header
        .row(view::Live::Is(true))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .gap(view::Live::Is(8.0))
      let _ = header.box(fn(title : view::View) -> Unit {
        let _ = title
          .words(view::Live::Is("Dual-Thread Worker"), look=lg::words_at(lg::type_title))
          .ink(view::Live::By(fn() { lg::colors().content }))
      })
      let _ = lg::liquid_badge_node(
        header,
        fn() { "Done: \{completed.get()}" },
      )
    })
    let _ = panel.box(fn(msg : view::View) -> Unit {
      let _ = msg
        .words(view::Live::By(fn() { status.get() }), look=lg::words_at(lg::type_body, wrap=true))
        .ink(view::Live::By(fn() { lg::colors().content }))
    })
    let _ = panel.box(fn(actions : view::View) -> Unit {
      let _ = actions
        .row(view::Live::Is(true))
        .gap(view::Live::Is(10.0))
      // Inside a glass panel, child buttons MUST be flat (no nested liquid glass).
      let _ = lg::liquid_button_node(
        actions,
        fn() { "Run Job" },
        fn() {
          let next_seq = completed.untracked() + 1
          let _ = worker.send(Cmd::RunJob(next_seq))
        },
        flat=true,
        tint=0x007AFFFFL,
      )
      let _ = lg::liquid_button_node(
        actions,
        fn() { "Reset" },
        fn() {
          let _ = worker.send(Cmd::Reset)
        },
        flat=true,
        ghost=true,
      )
    })
  }, gap=12.0)
}
