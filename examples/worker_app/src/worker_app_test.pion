// Deterministic UI + Liquid Glass audit test for `examples/worker_app`
// using `ui::Worker::inline` and `ui::Tester` (zero OS threads, zero sleep).

import "lg"
import "ui"
import "view"

test "worker_app inline dispatch updates signals and passes nested-glass audit" {
  let worker = ui::Worker::inline(handle_cmd_pure)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { build_view(root, worker) },
    width=480.0,
    height=320.0,
    theme=lg::ui_theme,
  )

  debug_assert(t.find("Done: 0").is_some(), "initial badge shows Done: 0")
  debug_assert(t.scroll_faults().length() == 0, "worker_app reports 0 scroll_faults initially")
  lg::assert_no_nested_glass(t, label="worker_app_initial")

  t.press("Run Job")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 1").is_some(), "first job updates badge to Done: 1")
  debug_assert(t.find("Job #1 completed on worker").is_some(), "status reflects job #1")
  t.assert_scrollable(label="worker_app_after_job1")
  lg::assert_no_nested_glass(t, label="worker_app_after_job1")

  t.press("Run Job")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 2").is_some(), "second job updates badge to Done: 2")
  debug_assert(t.find("Job #2 completed on worker").is_some(), "status reflects job #2")

  t.press("Reset")
  t.frame(ms=16.0)
  debug_assert(t.find("Done: 0").is_some(), "reset restores badge to Done: 0")
  lg::assert_no_nested_glass(t, label="worker_app_after_reset")

  worker.close()
  t.dispose()
}
