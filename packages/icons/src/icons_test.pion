test "named icons have finite, nondegenerate geometry inside the optical inset" {
  let names = icon_names()
  debug_assert(names.length() == 108, "complete catalog")
  let ink = 0x345678FFL
  for i in 0..<names.length() {
    let name = names[i]
    for j in 0..<i {
      debug_assert(names[j] != name, "duplicate name: " + name)
    }
    let shapes = icon_shapes(name, 24.0, ink, weight=IconWeight::Semibold)
    debug_assert(shapes.length() > 0, name)
    for shape in shapes {
      debug_assert(shape.fill == ink || shape.stroke == ink, name)
      debug_assert(shape.outlines.length() > 0, name)
      for contour in shape.outlines {
        let (points, closed) = contour
        let n = points.length()
        let vertices = n / 2
        debug_assert(n % 2 == 0 && vertices >= 2 && (!closed || vertices >= 3), name)
        for v in points {
          let pad = 2.0 + shape.width * 0.5
          debug_assert(v >= pad && v <= 24.0 - pad, name)
        }
        let edges = if closed { vertices } else { vertices - 1 }
        for k in 0..<edges {
          let a = k * 2
          let b = ((k + 1) % vertices) * 2
          debug_assert(points[a] != points[b] || points[a + 1] != points[b + 1], name)
        }
      }
    }
  }
}

test "weights and geometry scale independently with a one point stroke floor" {
  let ink = 0x123456FFL
  let weights : Array[(IconWeight, Double)] = [
    (IconWeight::Thin, 1.35), (IconWeight::Regular, 1.75),
    (IconWeight::Medium, 2.0), (IconWeight::Semibold, 2.25),
  ]
  let reference = icon_shapes("circle", 24.0, ink)[0]
  debug_assert(reference.width == 1.75, "default regular")
  for pair in weights {
    let (weight, width) = pair
    for size in [8.0, 14.0, 16.0, 24.0, 48.0] {
      let scale = size / 24.0
      let shape = icon_shapes("circle", size, ink, weight=weight)[0]
      let expected = width * scale
      debug_assert(shape.width == (if expected < 1.0 { 1.0 } else { expected }), "stroke")
      let base = reference.outlines[0].0
      let scaled_points = shape.outlines[0].0
      for k in 0..<base.length() {
        debug_assert(scaled_points[k] == base[k] * scale, "coordinate scale")
      }
    }
  }
  let solid = icon_shapes("heart-filled", 16.0, ink)[0]
  debug_assert(solid.fill == ink && solid.even_odd && solid.width == 0.0, "solid fill")
  debug_assert(icon_shapes("unknown", 24.0, ink).length() == 0, "unknown name")
  debug_assert(icon_shapes("circle", 0.0, ink).length() == 0, "empty size")
}

test "icon_node uses View::tint reactively and skips draw for transparent 0L" {
  ui::clear_tree_theme()
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = icon_node(root, "circle", size=24.0)
  })
  let mut found_initial = false
  for d in t.drawn() {
    if d.shapes.length() > 0 {
      found_initial = true
      debug_assert(d.tint == ui::Theme::light().fg, "default icon tint follows light theme fg")
      debug_assert(d.shapes[0].stroke == 0x01010100L, "shape uses transparent sentinel")
    }
  }
  debug_assert(found_initial, "icon_node must be drawn with shapes")
  debug_assert(t.scene().ninst > 0, "opaque tint emits vector instances")

  ui::set_tree_theme(fn() { ui::Theme::dark() })
  t.frame()
  let mut found_dark = false
  for d in t.drawn() {
    if d.shapes.length() > 0 {
      found_dark = true
      debug_assert(d.tint == ui::Theme::dark().fg, "icon tint updates reactively on theme switch")
    }
  }
  debug_assert(found_dark, "icon_node still drawn after theme switch")
  ui::clear_tree_theme()
  t.dispose()

  // Transparent 0L ink falls back to 0x01010100L sentinel and emits 0 instances.
  let t0 = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = icon_node(root, "circle", size=24.0, ink=fn() -> Int64 { 0L })
  })
  let mut found_zero = false
  for d in t0.drawn() {
    if d.shapes.length() > 0 {
      found_zero = true
      debug_assert(d.tint == 0L, "0L tint recorded on drawn node")
    }
  }
  debug_assert(found_zero, "transparent icon node still has static shapes")
  debug_assert(t0.scene().ninst == 0, "0L transparent icon emits 0 scene instances")
  t0.dispose()
}
