import "paint"
import "ui"
import "view"

#derive(Eq)
pub enum IconWeight {
  Thin
  Regular
  Medium
  Semibold
}

// Each generated contour is a fresh array owned by its shape.
fn scaled(points : Array[Double], scale : Double) -> Array[Double] {
  if scale != 1.0 {
    for i in 0..<points.length() {
      points[i] = points[i] * scale
    }
  }
  points
}

/// Render a named symbol in a square of logical points. Unknown names return an empty array.
pub fn icon_shapes(
  name : String,
  size : Double,
  ink : Int64,
  weight~ : IconWeight = IconWeight::Regular,
) -> Array[paint::Shape] {
  if !(size > 0.0) {
    return []
  }
  let width = match weight {
    Thin => 1.35
    Regular => 1.75
    Medium => 2.0
    Semibold => 2.25
  }
  let scale = size / 24.0
  draw_icon(name, scale, ink, ui::dmax(1.0, width * scale))
}

/// A decorative, pointer-transparent view. Ink follows the tree theme by default.
pub fn icon_node(
  parent : view::View,
  name : String,
  size~ : Double = 16.0,
  ink? : () -> Int64,
  weight~ : IconWeight = IconWeight::Regular,
  loc~ : String = "",
) -> view::View {
  let color = match ink {
    Some(f) => f
    None => fn() -> Int64 { ui::tree_theme().fg }
  }
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .shapes(view::Live::Is(icon_shapes(name, size, 0x01010100L, weight=weight)))
    .tint(view::Live::By(color), loc=loc)
  })
}

pub fn Icon(
  parent : view::View,
  name~ : String,
  size~ : Double = 16.0,
  color? : Int64,
  color_by? : () -> Int64,
  weight~ : IconWeight = IconWeight::Regular,
  loc~ : String = "",
) -> view::View {
  let ink = match color_by {
    Some(f) => Some(f)
    None => match color {
      Some(c) => Some(fn() -> Int64 { c })
      None => None
    }
  }
  icon_node(parent, name, size=size, ink?=ink, weight=weight, loc=loc)
}
