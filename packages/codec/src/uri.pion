// URI component escaping/unescaping (JS encodeURIComponent / decodeURIComponent).
// Ported from libs/mbui/src/codec/uri.mbt.

fn is_uri_unreserved(x : Int) -> Bool {
  (x >= 0x30 && x <= 0x39) ||
  (x >= 0x41 && x <= 0x5A) ||
  (x >= 0x61 && x <= 0x7A) ||
  x == 45 || // -
  x == 95 || // _
  x == 46 || // .
  x == 33 || // !
  x == 126 || // ~
  x == 42 || // *
  x == 39 || // '
  x == 40 || // (
  x == 41    // )
}

/// As JavaScript's encodeURIComponent.
pub fn encode_uri_component(s : String) -> String {
  let sb = StringBuilder::new()
  let bytes = s.to_bytes()
  for i in 0..<bytes.length() {
    let x = bytes[i].to_int()
    if is_uri_unreserved(x) {
      sb.write_byte(x as Byte)
    } else {
      sb.write_byte(37 as Byte) // '%'
      sb.write_byte(hex_upper_byte(x >> 4))
      sb.write_byte(hex_upper_byte(x & 15))
    }
  }
  sb.to_string()
}

fn hex_value(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

/// As JavaScript's decodeURIComponent; None on invalid %XX or invalid UTF-8.
pub fn decode_uri_component(s : String) -> Option[String] {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 37 {
      if i + 2 >= n ||
        hex_value(s.code_unit_at(i + 1)) < 0 ||
        hex_value(s.code_unit_at(i + 2)) < 0 {
        return None
      }
      i += 3
    } else {
      i += 1
    }
  }
  unescaped(s)
}

/// Lenient percent decoding; invalid sequences kept as written.
pub fn percent_decoded(s : String) -> String {
  unescaped(s).unwrap_or(s)
}

fn unescaped(s : String) -> Option[String] {
  if !s.contains("%") {
    return Some(s)
  }
  let bytes = s.to_bytes()
  let raw : Array[Int] = []
  let mut i = 0
  while i < bytes.length() {
    if bytes[i].to_int() == 37 && i + 2 < bytes.length() {
      let a = hex_value(bytes[i + 1].to_int())
      let b = hex_value(bytes[i + 2].to_int())
      if a >= 0 && b >= 0 {
        raw.push(a * 16 + b)
        i += 3
        continue
      }
    }
    raw.push(bytes[i].to_int())
    i += 1
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < raw.length() {
    let b0 = raw[j]
    let (n, first) = if b0 < 0x80 {
      (1, b0)
    } else if (b0 >> 5) == 6 {
      (2, b0 & 0x1F)
    } else if (b0 >> 4) == 14 {
      (3, b0 & 0x0F)
    } else if (b0 >> 3) == 30 {
      (4, b0 & 0x07)
    } else {
      return None
    }
    if j + n > raw.length() {
      return None
    }
    let mut code = first
    for k in 1..<n {
      if (raw[j + k] >> 6) != 2 {
        return None
      }
      code = (code << 6) | (raw[j + k] & 0x3F)
    }
    write_utf8_cp(sb, code)
    j += n
  }
  Some(sb.to_string())
}
