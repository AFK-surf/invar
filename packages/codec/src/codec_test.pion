test "a link's part as encodeURIComponent and decodeURIComponent have it" {
  { let __mbt_aa_33 = encode_uri_component("a b/会?x=1&y=(2)"); let __mbt_aa_34 = "a%20b%2F%E4%BC%9A%3Fx%3D1%26y%3D(2)"; if !(__mbt_aa_33 == __mbt_aa_34) { panic("assert_eq failed at codec_test.mbt:36") } }
  { let __mbt_aa_35 = decode_uri_component("a%20b%2F%E4%BC%9A"); let __mbt_aa_36 = Some("a b/会"); if !({ let __eq_l_36 : Option[String] = __mbt_aa_35; let __eq_r_36 : Option[String] = __mbt_aa_36; match (__eq_l_36, __eq_r_36) { (Some(__oa_4), Some(__ob_4)) => __oa_4 == __ob_4, (None, None) => true, _ => false } }) { panic("assert_eq failed at codec_test.mbt:37") } }
  { let __mbt_aa_37 = decode_uri_component("100%"); if !({ let __eq_l_37 : Option[String] = __mbt_aa_37; let __eq_r_37 : Option[String] = None; match (__eq_l_37, __eq_r_37) { (Some(__oa_5), Some(__ob_5)) => __oa_5 == __ob_5, (None, None) => true, _ => false } }) { panic("assert_eq failed at codec_test.mbt:38") } }
  { let __mbt_aa_38 = decode_uri_component("%zz"); if !({ let __eq_l_38 : Option[String] = __mbt_aa_38; let __eq_r_38 : Option[String] = None; match (__eq_l_38, __eq_r_38) { (Some(__oa_6), Some(__ob_6)) => __oa_6 == __ob_6, (None, None) => true, _ => false } }) { panic("assert_eq failed at codec_test.mbt:39") } }
  { let __mbt_aa_39 = decode_uri_component("%E4%BC"); if !({ let __eq_l_39 : Option[String] = __mbt_aa_39; let __eq_r_39 : Option[String] = None; match (__eq_l_39, __eq_r_39) { (Some(__oa_7), Some(__ob_7)) => __oa_7 == __ob_7, (None, None) => true, _ => false } }) { panic("assert_eq failed at codec_test.mbt:40") } }
  // leniently: what makes no character kept as written
  { let __mbt_aa_40 = percent_decoded("50%25 off %zz"); let __mbt_aa_41 = "50% off %zz"; if !(__mbt_aa_40 == __mbt_aa_41) { panic("assert_eq failed at codec_test.mbt:42") } }
  { let __mbt_aa_42 = percent_decoded("%E4%BC"); let __mbt_aa_43 = "%E4%BC"; if !(__mbt_aa_42 == __mbt_aa_43) { panic("assert_eq failed at codec_test.mbt:43") } }
  { let __mbt_aa_44 = percent_decoded("plain"); let __mbt_aa_45 = "plain"; if !(__mbt_aa_44 == __mbt_aa_45) { panic("assert_eq failed at codec_test.mbt:44") } }
}

///|
test "text's bytes" {
  { let __mbt_aa_46 = looks_like_text(mbt_compat::utf8_encode("纯文本 plain")); mbt_compat::assert_true(__mbt_aa_46, "codec_test.mbt:49") }
  { let __mbt_aa_47 = !looks_like_text("\x00\x01\x02".to_bytes()); mbt_compat::assert_true(__mbt_aa_47, "codec_test.mbt:50") }
  { let __mbt_aa_48 = !looks_like_text("\xff\xfe".to_bytes()); mbt_compat::assert_true(__mbt_aa_48, "codec_test.mbt:51") }
  { let __mbt_aa_49 = utf8_text(mbt_compat::utf8_encode("会议"), 100); let __mbt_aa_50 = "会议"; if !(__mbt_aa_49 == __mbt_aa_50) { panic("assert_eq failed at codec_test.mbt:52") } }
  // a character the cut splits, and a byte of none
  { let __mbt_aa_51 = utf8_text(mbt_compat::utf8_encode("会议"), 4); let __mbt_aa_52 = "会\u{FFFD}"; if !(__mbt_aa_51 == __mbt_aa_52) { panic("assert_eq failed at codec_test.mbt:54") } }
  { let __mbt_aa_53 = utf8_text("a\xffb".to_bytes(), 100); let __mbt_aa_54 = "a\u{FFFD}b"; if !(__mbt_aa_53 == __mbt_aa_54) { panic("assert_eq failed at codec_test.mbt:55") } }
  let half = mbt_compat::utf8_encode("ab会")
  { let __mbt_aa_55 = utf8_end(half, 0, 4, true); let __mbt_aa_56 = 2; if !(__mbt_aa_55 == __mbt_aa_56) { panic("assert_eq failed at codec_test.mbt:57") } }
  { let __mbt_aa_57 = utf8_end(half, 0, 4, false); let __mbt_aa_58 = 4; if !(__mbt_aa_57 == __mbt_aa_58) { panic("assert_eq failed at codec_test.mbt:58") } }
  { let __mbt_aa_59 = utf8_end(half, 0, 5, true); let __mbt_aa_60 = 5; if !(__mbt_aa_59 == __mbt_aa_60) { panic("assert_eq failed at codec_test.mbt:59") } }
  { let __mbt_aa_61 = utf16_text("\xff\xfea\x00\x1aO".to_bytes(), 2, true); let __mbt_aa_62 = "a会"; if !(__mbt_aa_61 == __mbt_aa_62) { panic("assert_eq failed at codec_test.mbt:60") } }
  { let __mbt_aa_63 = utf16_text("\x00a\x4f\x1a\xd8\x00".to_bytes(), 0, false); let __mbt_aa_64 = "a会\u{FFFD}"; if !(__mbt_aa_63 == __mbt_aa_64) { panic("assert_eq failed at codec_test.mbt:61") } }
}

///|
test "CSV and TSV" {
  let rows = parse_csv("a,\"b,c\",\"d \"\"e\"\"\"\r\n1,2\n\n3", ',', 10)
  { let __mbt_aa_65 = rows; let __mbt_aa_66 = [["a", "b,c", "d \"e\""], ["1", "2"], [""], ["3"]]; if !({ let __eq_l_66 : Array[Array[String]] = __mbt_aa_65; let __eq_r_66 : Array[Array[String]] = __mbt_aa_66; { let mut __aeq = __eq_l_66.length() == __eq_r_66.length(); if __aeq { let mut __ai = 0; while __ai < __eq_l_66.length() { if !({ let mut __aeq_1 = __eq_l_66[__ai].length() == __eq_r_66[__ai].length(); if __aeq_1 { let mut __ai_1 = 0; while __ai_1 < __eq_l_66[__ai].length() { if !(__eq_l_66[__ai][__ai_1] == __eq_r_66[__ai][__ai_1]) { __aeq_1 = false; break }; __ai_1 = __ai_1 + 1 } }; __aeq_1 }) { __aeq = false; break }; __ai = __ai + 1 } }; __aeq } }) { panic("assert_eq failed at codec_test.mbt:67") } }
  { let __mbt_aa_67 = parse_csv("x\ty\n1\t2\n3\t4", '\t', 2); let __mbt_aa_68 = [["x", "y"], ["1", "2"]]; if !({ let __eq_l_67 : Array[Array[String]] = __mbt_aa_67; let __eq_r_67 : Array[Array[String]] = __mbt_aa_68; { let mut __aeq_2 = __eq_l_67.length() == __eq_r_67.length(); if __aeq_2 { let mut __ai_2 = 0; while __ai_2 < __eq_l_67.length() { if !({ let mut __aeq_3 = __eq_l_67[__ai_2].length() == __eq_r_67[__ai_2].length(); if __aeq_3 { let mut __ai_3 = 0; while __ai_3 < __eq_l_67[__ai_2].length() { if !(__eq_l_67[__ai_2][__ai_3] == __eq_r_67[__ai_2][__ai_3]) { __aeq_3 = false; break }; __ai_3 = __ai_3 + 1 } }; __aeq_3 }) { __aeq_2 = false; break }; __ai_2 = __ai_2 + 1 } }; __aeq_2 } }) { panic("assert_eq failed at codec_test.mbt:68") } }
}

///|
test "JSON written out" {
  let v : mbt_compat::MbtJson = mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("a", mbt_compat::MbtJson::Number(Double::from_bits(0x3FF0000000000000UL.reinterpret_as_int64()), Option::None)), ("b", mbt_compat::MbtJson::Array([mbt_compat::MbtJson::True, mbt_compat::MbtJson::Null])), ("c", mbt_compat::MbtJson::Object(mbt_compat::ordered_map_new())), ("d", mbt_compat::MbtJson::Array([]))]))
  { let __mbt_aa_69 = pretty_json(v); let __mbt_aa_70 = "{\n  \"a\": 1,\n  \"b\": [\n    true,\n    null\n  ],\n  \"c\": {},\n  \"d\": []\n}"; if !(__mbt_aa_69 == __mbt_aa_70) { panic("assert_eq failed at codec_test.mbt:74") } }
}
