test "hex" {
  { let __mbt_aa_27 = hex("\x00\x9f\xff".to_bytes()); let __mbt_aa_28 = "009fff"; if !(__mbt_aa_27 == __mbt_aa_28) { panic("assert_eq failed at codec_test.mbt:29") } }
  { let __mbt_aa_29 = from_hex("009fFF"); let __mbt_aa_30 = "\x00\x9f\xff".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_29, __mbt_aa_30)) { panic("assert_eq failed at codec_test.mbt:30") } }
  { let __mbt_aa_31 = from_hex("abc"); let __mbt_aa_32 = "\xab".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_31, __mbt_aa_32)) { panic("assert_eq failed at codec_test.mbt:31") } }
}

