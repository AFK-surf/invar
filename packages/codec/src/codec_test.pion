  { let __mbt_aa_5 = base64("fo".to_bytes()); let __mbt_aa_6 = "Zm8="; if !(__mbt_aa_5 == __mbt_aa_6) { panic("assert_eq failed at codec_test.mbt:8") } }
  { let __mbt_aa_7 = base64("foo".to_bytes()); let __mbt_aa_8 = "Zm9v"; if !(__mbt_aa_7 == __mbt_aa_8) { panic("assert_eq failed at codec_test.mbt:9") } }
  { let __mbt_aa_9 = base64("foobar".to_bytes()); let __mbt_aa_10 = "Zm9vYmFy"; if !(__mbt_aa_9 == __mbt_aa_10) { panic("assert_eq failed at codec_test.mbt:10") } }
  { let __mbt_aa_11 = from_base64("Zm9vYmFy"); let __mbt_aa_12 = "foobar".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_11, __mbt_aa_12)) { panic("assert_eq failed at codec_test.mbt:11") } }
  { let __mbt_aa_13 = from_base64("Zm9v\nYmFy=="); let __mbt_aa_14 = "foobar".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_13, __mbt_aa_14)) { panic("assert_eq failed at codec_test.mbt:12") } }
  // URL-safe: - and _ for + and /
  { let __mbt_aa_15 = base64("\xfb\xff".to_bytes()); let __mbt_aa_16 = "+/8="; if !(__mbt_aa_15 == __mbt_aa_16) { panic("assert_eq failed at codec_test.mbt:14") } }
  { let __mbt_aa_17 = from_base64("-_8"); let __mbt_aa_18 = "\xfb\xff".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_17, __mbt_aa_18)) { panic("assert_eq failed at codec_test.mbt:15") } }
  { let __mbt_aa_19 = from_base64("+/8="); let __mbt_aa_20 = "\xfb\xff".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_19, __mbt_aa_20)) { panic("assert_eq failed at codec_test.mbt:16") } }
}

