// Base64 (RFC 4648) & Hex encoding/decoding.
// Ported from libs/mbui/src/codec/base64.mbt.

fn b64_char_byte(idx : Int) -> Byte {
  if idx < 26 {
    (65 + idx) as Byte
  } else if idx < 52 {
    (97 + idx - 26) as Byte
  } else if idx < 62 {
    (48 + idx - 52) as Byte
  } else if idx == 62 {
    43 as Byte // '+'
  } else {
    47 as Byte // '/'
  }
}

/// Bytes as base64 (standard, padded).
pub fn base64(b : Bytes) -> String {
  let sb = StringBuilder::new()
  let n = b.length()
  let mut i = 0
  while i < n {
    let b0 = b[i].to_int()
    let b1 = if i + 1 < n { b[i + 1].to_int() } else { 0 }
    let b2 = if i + 2 < n { b[i + 2].to_int() } else { 0 }
    sb.write_byte(b64_char_byte(b0 >> 2))
    sb.write_byte(b64_char_byte(((b0 & 3) << 4) | (b1 >> 4)))
    if i + 1 < n {
      sb.write_byte(b64_char_byte(((b1 & 15) << 2) | (b2 >> 6)))
    } else {
      sb.write_byte(61 as Byte) // '='
    }
    if i + 2 < n {
      sb.write_byte(b64_char_byte(b2 & 63))
    } else {
      sb.write_byte(61 as Byte) // '='
    }
    i += 3
  }
  sb.to_string()
}

/// A digit's value, standard or URL-safe (-1: none).
fn b64_value(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c - 65
  } else if c >= 97 && c <= 122 {
    c - 97 + 26
  } else if c >= 48 && c <= 57 {
    c - 48 + 52
  } else if c == 43 || c == 45 {
    62
  } else if c == 47 || c == 95 {
    63
  } else {
    -1
  }
}

/// Bytes from base64, standard or URL-safe, padded or not (lenient).
pub fn from_base64(s : String) -> Bytes {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut acc = 0
  let mut bits = 0
  for i in 0..<n {
    let v = b64_value(s.code_unit_at(i))
    if v < 0 {
      continue
    }
    acc = ((acc << 6) | v) & 0xFFFFFF
    bits += 6
    if bits >= 8 {
      bits -= 8
      sb.write_byte(((acc >> bits) & 0xFF) as Byte)
    }
  }
  sb.to_string().to_bytes()
}

/// Bytes from standard base64, padding and whitespace ignored; None for anything else.
pub fn from_base64_exact(s : String) -> Option[Bytes] {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut acc = 0
  let mut bits = 0
  for i in 0..<n {
    let c = s.code_unit_at(i)
    if c == 61 || c == 32 || c == 10 || c == 13 || c == 9 {
      continue
    }
    if c == 45 || c == 95 {
      return None
    }
    let v = b64_value(c)
    if v < 0 {
      return None
    }
    acc = ((acc << 6) | v) & 0xFFFFFF
    bits += 6
    if bits >= 8 {
      bits -= 8
      sb.write_byte(((acc >> bits) & 0xFF) as Byte)
    }
  }
  Some(sb.to_string().to_bytes())
}

fn hex_lower_byte(v : Int) -> Byte {
  if v < 10 { (48 + v) as Byte } else { (87 + v) as Byte }
}

fn hex_upper_byte(v : Int) -> Byte {
  if v < 10 { (48 + v) as Byte } else { (55 + v) as Byte }
}

/// Bytes in hex, two lowercase digits each.
pub fn hex(b : Bytes) -> String {
  let sb = StringBuilder::new()
  for i in 0..<b.length() {
    let v = b[i].to_int()
    sb.write_byte(hex_lower_byte(v >> 4))
    sb.write_byte(hex_lower_byte(v & 15))
  }
  sb.to_string()
}

fn hex_digit_lenient(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    0
  }
}

/// Bytes from hex, two digits each (either case; invalid as 0, odd last digit dropped).
pub fn from_hex(s : String) -> Bytes {
  let sb = StringBuilder::new()
  let pairs = s.length() / 2
  for i in 0..<pairs {
    let hi = hex_digit_lenient(s.code_unit_at(2 * i))
    let lo = hex_digit_lenient(s.code_unit_at(2 * i + 1))
    sb.write_byte(((hi << 4) | lo) as Byte)
  }
  sb.to_string().to_bytes()
}

/// Binary LE/BE & varint helpers for Layer 0 codecs.
pub fn read_u16_le(b : Bytes, at : Int) -> Int {
  b[at].to_int() | (b[at + 1].to_int() << 8)
}

pub fn read_u16_be(b : Bytes, at : Int) -> Int {
  (b[at].to_int() << 8) | b[at + 1].to_int()
}

pub fn read_u32_le(b : Bytes, at : Int) -> Int64 {
  b[at].to_int().to_int64() |
  (b[at + 1].to_int().to_int64() << 8) |
  (b[at + 2].to_int().to_int64() << 16) |
  (b[at + 3].to_int().to_int64() << 24)
}

pub fn read_u32_be(b : Bytes, at : Int) -> Int64 {
  (b[at].to_int().to_int64() << 24) |
  (b[at + 1].to_int().to_int64() << 16) |
  (b[at + 2].to_int().to_int64() << 8) |
  b[at + 3].to_int().to_int64()
}

pub fn encode_uleb128(v : Int64) -> Bytes {
  let sb = StringBuilder::new()
  let mut x = v
  while true {
    let mut byte = (x & 0x7F.to_int64()).to_int()
    x = (x >> 7) & ((1.to_int64() << 57) - 1.to_int64())
    if x != 0.to_int64() {
      byte = byte | 0x80
    }
    sb.write_byte(byte as Byte)
    if x == 0.to_int64() {
      break
    }
  }
  sb.to_string().to_bytes()
}

pub fn decode_uleb128(b : Bytes, start : Int) -> Option[(Int64, Int)] {
  let mut res : Int64 = 0.to_int64()
  let mut shift = 0
  let mut i = start
  let n = b.length()
  while i < n {
    let byte = b[i].to_int()
    i += 1
    res = res | ((byte & 0x7F).to_int64() << shift)
    if (byte & 0x80) == 0 {
      return Some((res, i))
    }
    shift += 7
    if shift >= 64 {
      return None
    }
  }
  None
}
