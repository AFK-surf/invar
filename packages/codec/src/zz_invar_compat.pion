// Invar compatibility helpers preserved from baseline packages/codec/src/base64.pion
// for binary u16/u32 reads (LE/BE) and ULEB128 varint encoding/decoding.

pub fn read_u16_le(b : Bytes, at : Int) -> Int {
  b[at].to_int() | (b[at + 1].to_int() << 8)
}

pub fn read_u16_be(b : Bytes, at : Int) -> Int {
  (b[at].to_int() << 8) | b[at + 1].to_int()
}

pub fn read_u32_le(b : Bytes, at : Int) -> Int64 {
  b[at].to_int().to_int64() |
  (b[at + 1].to_int().to_int64() << 8) |
  (b[at + 2].to_int().to_int64() << 16) |
  (b[at + 3].to_int().to_int64() << 24)
}

pub fn read_u32_be(b : Bytes, at : Int) -> Int64 {
  (b[at].to_int().to_int64() << 24) |
  (b[at + 1].to_int().to_int64() << 16) |
  (b[at + 2].to_int().to_int64() << 8) |
  b[at + 3].to_int().to_int64()
}

pub fn encode_uleb128(v : Int64) -> Bytes {
  let sb = StringBuilder::new()
  let mut x = v
  while true {
    let mut byte = (x & 0x7F.to_int64()).to_int()
    x = (x >> 7) & ((1.to_int64() << 57) - 1.to_int64())
    if x != 0.to_int64() {
      byte = byte | 0x80
    }
    sb.write_byte(byte as Byte)
    if x == 0.to_int64() {
      break
    }
  }
  sb.to_string().to_bytes()
}

pub fn decode_uleb128(b : Bytes, start : Int) -> Option[(Int64, Int)] {
  let mut res : Int64 = 0.to_int64()
  let mut shift = 0
  let mut i = start
  let n = b.length()
  while i < n {
    let byte = b[i].to_int()
    i += 1
    res = res | ((byte & 0x7F).to_int64() << shift)
    if (byte & 0x80) == 0 {
      return Some((res, i))
    }
    shift += 7
    if shift >= 64 {
      return None
    }
  }
  None
}
