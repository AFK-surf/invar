// CSV/TSV parser and pretty JSON formatter.
// Ported from libs/mbui/src/codec/table.mbt.

/// RFC 4180 CSV/TSV parser (sep is ASCII byte code, e.g. 44 for ',', 9 for '\t').
pub fn parse_csv(s : String, sep : Int, limit : Int) -> Array[Array[String]] {
  let rows : Array[Array[String]] = []
  let mut row : Array[String] = []
  let field = StringBuilder::new()
  let mut empty = true
  let mut quoted = false
  let n = s.length()
  let mut i = 0
  while i < n && rows.length() < limit {
    let ch = s.code_unit_at(i)
    if quoted {
      if ch == 34 && i + 1 < n && s.code_unit_at(i + 1) == 34 {
        field.write_byte(34 as Byte)
        i += 1
      } else if ch == 34 {
        quoted = false
      } else {
        field.write_byte(ch as Byte)
      }
    } else if ch == 34 && empty {
      quoted = true
      empty = false
    } else if ch == sep {
      row.push(field.to_string())
      field.reset()
      empty = true
    } else if ch == 10 || ch == 13 {
      if ch == 13 && i + 1 < n && s.code_unit_at(i + 1) == 10 {
        i += 1
      }
      row.push(field.to_string())
      rows.push(row)
      row = []
      field.reset()
      empty = true
    } else {
      field.write_byte(ch as Byte)
      empty = false
    }
    i += 1
  }
  if (!empty || row.length() > 0) && rows.length() < limit {
    row.push(field.to_string())
    rows.push(row)
  }
  rows
}

/// Pure Pion JSON AST for pretty printing.
pub enum Json {
  JNull
  JBool(Bool)
  JInt(Int)
  JNumber(Double)
  JString(String)
  JArray(Array[Json])
  JObject(Array[(String, Json)])
}

fn json_escape_string(s : String) -> String {
  let sb = StringBuilder::new()
  sb.write_byte(34 as Byte)
  for i in 0..<s.length() {
    let c = s.code_unit_at(i)
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_byte(c as Byte)
    }
  }
  sb.write_byte(34 as Byte)
  sb.to_string()
}

fn pad_spaces(depth : Int) -> String {
  let sb = StringBuilder::new()
  for _ in 0..<depth {
    sb.write_string("  ")
  }
  sb.to_string()
}

pub fn pretty_json(v : Json) -> String {
  pretty_at(v, 0)
}

fn pretty_at(v : Json, depth : Int) -> String {
  match v {
    JNull => "null"
    JBool(b) => if b { "true" } else { "false" }
    JInt(n) => n.to_string()
    JNumber(x) => x.to_string()
    JString(s) => json_escape_string(s)
    JArray(a) => {
      if a.length() == 0 {
        return "[]"
      }
      let parts : Array[String] = []
      let p = pad_spaces(depth + 1)
      for x in a {
        parts.push(p + pretty_at(x, depth + 1))
      }
      "[\n" + parts.join(",\n") + "\n" + pad_spaces(depth) + "]"
    }
    JObject(m) => {
      if m.length() == 0 {
        return "{}"
      }
      let parts : Array[String] = []
      let p = pad_spaces(depth + 1)
      for entry in m {
        let (k, x) = entry
        parts.push(p + json_escape_string(k) + ": " + pretty_at(x, depth + 1))
      }
      "{\n" + parts.join(",\n") + "\n" + pad_spaces(depth) + "}"
    }
  }
}
