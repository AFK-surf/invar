import "mbt_compat"

// Subtitles read as text: SubRip, WebVTT and ASS/SSA's dialogue lines, each a cue (from when to when, its words),
// and what is said at a moment. Styling is left out (tags, ASS's overrides), the words and their lines kept: every
// host shows them alike (an app's player reads a video's subtitle beside it).

///|
/// A line of a subtitle: from when to when (ms), its words (lines apart by \n).
pub struct Cue {
  pub from : Double
  pub to : Double
  pub text : String
}

///|
/// The cues of a subtitle file `name` (its kind by its extension) in `bytes` (UTF-8, a byte order mark dropped).
pub fn parse_subtitles(name : String, bytes : Bytes) -> Array[Cue] {
  let text = mbt_compat::utf8_decode_lossy(mbt_compat::bytes_slice(bytes, 0, bytes.length()), ignore_bom=true)
  let text = text.replace("\r\n", "\n").replace("\r", "\n")
  let ext = match mbt_compat::str_rev_find(name, ".") {
    Option::Some(i) => mbt_compat::str_to_lower(mbt_compat::str_to_owned(mbt_compat::str_exact_view(name, start=i + 1)))
    Option::None => ""
  }
  match ext {
    "ass" | "ssa" => parse_ass(text)
    _ => parse_timed(text)
  }
}

///|
/// SubRip and WebVTT: blocks apart by blank lines, each with a `from --> to` line and its words under it.
pub fn parse_timed(text : String) -> Array[Cue] {
  let out : Array[Cue] = []
  let lines = mbt_compat::arr_to_array(mbt_compat::arr_map(text.split("\n"), fn(l) { mbt_compat::str_to_owned(l) }))
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    match mbt_compat::str_find(line, "-->") {
      Some(at) => {
        let a = mbt_compat::str_to_owned(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, end=at)).trim())
        // WebVTT's settings after the time (align:start …)
        let rest = mbt_compat::str_to_owned(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=at + 3)).trim())
        let b = match mbt_compat::str_find(rest, " ") {
          Some(k) => mbt_compat::str_to_owned(mbt_compat::str_exact_view(rest, end=k))
          None => rest
        }
        i += 1
        let words : Array[String] = []
        while i < lines.length() && mbt_compat::str_to_owned(lines[i].trim()) != "" {
          words.push(strip_tags(lines[i]))
          i += 1
        }
        match (subtitle_time(a), subtitle_time(b)) {
          (Some(f), Some(t)) if words.length() > 0 =>
          out.push(Cue::{ from: f, to: t, text: words.join("\n") })
          _ => ()
        }
      }
      None => i += 1
    }
  }
  out
}

///|
/// ASS/SSA: the [Events] section's Dialogue lines, read by its Format line (Start, End, Text the last field, which may
/// hold commas); {\…} overrides dropped, \N a new line, \h a space.
pub fn parse_ass(text : String) -> Array[Cue] {
  let out : Array[Cue] = []
  let mut events = false
  let mut fields : Array[String] = ["layer", "start", "end", "style", "name", "marginl", "marginr", "marginv", "effect", "text"]
  for raw in text.split("\n") {
    let line = mbt_compat::str_to_owned(mbt_compat::str_to_owned(raw).trim())
    if mbt_compat::str_has_prefix(line, "[") {
      events = mbt_compat::str_to_lower(line) == "[events]"
      continue
    }
    if !events {
      continue
    }
    if mbt_compat::str_has_prefix(mbt_compat::str_to_lower(line), "format:") {
      fields = mbt_compat::arr_to_array(mbt_compat::arr_map(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=7)).split(","), fn(f) { mbt_compat::str_to_lower(mbt_compat::str_to_owned(mbt_compat::str_to_owned(f).trim())) }))

      continue
    }
    if !mbt_compat::str_has_prefix(mbt_compat::str_to_lower(line), "dialogue:") {
      continue
    }
    let body = mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=9))
    let n = fields.length()
    // the first n - 1 fields, then the text whole
    let parts : Array[String] = []
    let mut from = 0
    let chars = mbt_compat::str_scalars(body)
    for k, ch in chars {
      if ch == ',' && parts.length() < n - 1 {
        parts.push(mbt_compat::str_to_owned(mbt_compat::str_from_char_array(mbt_compat::array_slice_clamp(chars, from, k)).trim()))
        from = k + 1
      }
    }
    parts.push(mbt_compat::str_from_char_array(mbt_compat::array_slice_clamp(chars, from, chars.length())))
    let get = fn(key : String) -> String {
      match mbt_compat::arr_search(fields, key) {
        Option::Some(k) if k < parts.length() => parts[k]
        _ => ""
      }
    }
    let words = ass_words(get("text"))
    match (subtitle_time(get("start")), subtitle_time(get("end"))) {
      (Some(f), Some(t)) if words != "" => out.push(Cue::{ from: f, to: t, text: words })
      _ => ()
    }
  }
  mbt_compat::arr_sort_by(out, fn(a, b) { a.from.compare(b.from) })
  out
}

///|
fn ass_words(s : String) -> String {
  let sb = StringBuilder()
  let chars = mbt_compat::str_scalars(s)
  let mut i = 0
  while i < chars.length() {
    let ch = chars[i]
    if ch == '{' {
      while i < chars.length() && chars[i] != '}' {
        i += 1
      }
      i += 1
      continue
    }
    if ch == '\\' && i + 1 < chars.length() {
      match chars[i + 1] {
        'N' | 'n' => {
          sb.write_char('\n')
          i += 2
          continue
        }
        'h' => {
          sb.write_char(' ')
          i += 2
          continue
        }
        _ => ()
      }
    }
    sb.write_char(ch)
    i += 1
  }
  mbt_compat::str_to_owned(sb.to_string().trim())
}

///|
/// A line's words without its tags (<i>, <font …>, WebVTT's <c.x>, <00:01.000>) and ASS-like {\an8}.
fn strip_tags(s : String) -> String {
  let sb = StringBuilder()
  let chars = mbt_compat::str_scalars(s)
  let mut i = 0
  while i < chars.length() {
    let ch = chars[i]
    if ch == '<' || (ch == '{' && i + 1 < chars.length() && chars[i + 1] == '\\') {
      let close = if ch == '<' { '>' } else { '}' }
      let mut k = i + 1
      while k < chars.length() && chars[k] != close {
        k += 1
      }
      if k < chars.length() {
        i = k + 1
        continue
      }
    }
    sb.write_char(ch)
    i += 1
  }
  sb.to_string()
  .replace("&amp;", "&")
  .replace("&lt;", "<")
  .replace("&gt;", ">")
  .replace("&nbsp;", " ")
}

///|
/// `hh:mm:ss,mmm`, `mm:ss.mmm`, `h:mm:ss.cc` (ASS's hundredths) in ms; None when it is none of them.
pub fn subtitle_time(s : String) -> Option[Double] {
  let s = mbt_compat::str_to_owned(s.trim()).replace(",", ".")
  if s == "" {
    return Option::None
  }
  let (whole, frac) = match mbt_compat::str_find(s, ".") {
    Some(k) => (mbt_compat::str_to_owned(mbt_compat::str_exact_view(s, end=k)), mbt_compat::str_to_owned(mbt_compat::str_exact_view(s, start=k + 1)))
    None => (s, "")
  }
  let parts = mbt_compat::arr_to_array(mbt_compat::arr_map(whole.split(":"), fn(p) { mbt_compat::str_to_owned(p) }))
  if parts.length() < 2 || parts.length() > 3 {
    return Option::None
  }
  let mut secs = 0.0
  for p in parts {
    let n = match mbt_compat::str_try_parse_int(mbt_compat::utf16_slice(p, 0, mbt_compat::utf16_len(p))) { Ok(__mbt_ok_71) => __mbt_ok_71, Err(_) => return Option::None }
    secs = secs * 60.0 + n.to_double()
  }
  let mut ms = secs * 1000.0
  if frac != "" {
    let n = match mbt_compat::str_try_parse_int(mbt_compat::utf16_slice(frac, 0, mbt_compat::utf16_len(frac))) { Ok(__mbt_ok_72) => __mbt_ok_72, Err(_) => return Option::None }
    let mut scale = 1.0
    for _ in 0..<mbt_compat::utf16_len(frac) {
      scale *= 10.0
    }
    ms += n.to_double() / scale * 1000.0
  }
  Option::Some(ms)
}

///|
/// What is said at `ms`: the words of every cue then, one under another ("" when none).
pub fn cues_at(cues : Array[Cue], ms : Double) -> String {
  let said : Array[String] = []
  for q in cues {
    if q.from <= ms && ms < q.to {
      said.push(q.text)
    }
  }
  said.join("\n")
}
