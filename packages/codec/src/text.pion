// UTF-8 / UTF-16 byte text inspection and decoding.
// Ported from libs/mbui/src/codec/text.mbt.

fn write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp as Byte)
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  } else {
    sb.write_byte((0xF0 | (cp >> 18)) as Byte)
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)) as Byte)
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)) as Byte)
    sb.write_byte((0x80 | (cp & 0x3F)) as Byte)
  }
}

fn write_fffd(sb : StringBuilder) -> Unit {
  sb.write_byte(0xEF as Byte)
  sb.write_byte(0xBF as Byte)
  sb.write_byte(0xBD as Byte)
}

/// Text when its first 8 KB decode as UTF-8 with no NULs.
pub fn looks_like_text(b : Bytes) -> Bool {
  let n = if b.length() < 8192 { b.length() } else { 8192 }
  for i in 0..<n {
    if b[i].to_int() == 0 {
      return false
    }
  }
  let end = if b.length() > 8192 { 8188 } else { n }
  let mut i = 0
  while i < end {
    let x = b[i].to_int()
    let more = if x < 0x80 {
      0
    } else if x >= 0xC2 && x < 0xE0 {
      1
    } else if x >= 0xE0 && x < 0xF0 {
      2
    } else if x >= 0xF0 && x < 0xF5 {
      3
    } else {
      return false
    }
    if i + more >= end && more > 0 {
      return true
    }
    for k in 1..=more {
      let y = b[i + k].to_int()
      if y < 0x80 || y >= 0xC0 {
        return false
      }
    }
    i = i + 1 + more
  }
  true
}

/// The first `limit` bytes as UTF-8 text (invalid bytes / split chars replaced by U+FFFD).
pub fn utf8_text(b : Bytes, limit : Int) -> String {
  let n = if b.length() < limit { b.length() } else { limit }
  let sb = StringBuilder::new()
  let mut i = 0
  while i < n {
    let x = b[i].to_int()
    let (more, start) = if x < 0x80 {
      (0, x)
    } else if x >= 0xC2 && x < 0xE0 {
      (1, x & 0x1F)
    } else if x >= 0xE0 && x < 0xF0 {
      (2, x & 0x0F)
    } else if x >= 0xF0 && x < 0xF5 {
      (3, x & 0x07)
    } else {
      (-1, 0)
    }
    let mut cp = start
    let mut ok = more >= 0 && i + more < n
    if ok {
      for k in 1..=more {
        let y = b[i + k].to_int()
        if y < 0x80 || y >= 0xC0 {
          ok = false
          break
        }
        cp = (cp << 6) | (y & 0x3F)
      }
    }
    if ok && (cp < 0xD800 || cp > 0xDFFF) && cp <= 0x10FFFF {
      write_utf8_cp(sb, cp)
      i = i + 1 + more
    } else {
      write_fffd(sb)
      i = i + 1
    }
  }
  sb.to_string()
}

/// Where UTF-8 from `from` to `n` ends; if `drop_tail`, before an incomplete trailing character.
pub fn utf8_end(b : Bytes, from : Int, n : Int, drop_tail : Bool) -> Int {
  if !drop_tail {
    return n
  }
  let mut k = 1
  while k <= 3 && n - k >= from {
    let x = b[n - k].to_int()
    if x < 0x80 {
      return n
    }
    if x >= 0xC0 {
      let need = if x >= 0xF0 { 4 } else if x >= 0xE0 { 3 } else { 2 }
      return if k < need { n - k } else { n }
    }
    k += 1
  }
  n
}

/// UTF-16 from `from` (little-endian or big-endian), lone surrogates as U+FFFD.
pub fn utf16_text(b : Bytes, from : Int, little : Bool) -> String {
  let out = StringBuilder::new()
  let n = b.length()
  let mut i = from
  while i + 1 < n {
    let u = if little {
      b[i].to_int() | (b[i + 1].to_int() << 8)
    } else {
      (b[i].to_int() << 8) | b[i + 1].to_int()
    }
    i += 2
    if u >= 0xD800 && u <= 0xDBFF && i + 1 < n {
      let v = if little {
        b[i].to_int() | (b[i + 1].to_int() << 8)
      } else {
        (b[i].to_int() << 8) | b[i + 1].to_int()
      }
      if v >= 0xDC00 && v <= 0xDFFF {
        i += 2
        write_utf8_cp(out, 0x10000 + ((u - 0xD800) << 10) + (v - 0xDC00))
        continue
      }
    }
    if u >= 0xD800 && u <= 0xDFFF {
      write_fffd(out)
    } else {
      write_utf8_cp(out, u)
    }
  }
  out.to_string()
}
