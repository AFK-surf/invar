          { let __mbt_aa_71 = rgba[i * 4 + 1]; let __mbt_aa_72 = palette[idx * 3 + 1]; if !(__mbt_aa_71 == __mbt_aa_72) { panic("assert_eq failed at pixels_test.mbt:256") } }
          { let __mbt_aa_73 = rgba[i * 4 + 2]; let __mbt_aa_74 = palette[idx * 3 + 2]; if !(__mbt_aa_73 == __mbt_aa_74) { panic("assert_eq failed at pixels_test.mbt:257") } }
          { let __mbt_aa_75 = rgba[i * 4 + 3]; let __mbt_aa_76 = alphas[idx]; if !(__mbt_aa_75 == __mbt_aa_76) { panic("assert_eq failed at pixels_test.mbt:258") } }
