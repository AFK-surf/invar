///|
/// An APP1 EXIF note saying `orientation`, its TIFF in Intel's byte order (`le`) or Motorola's.
fn exif_note(orientation : Int, le : Bool) -> Array[Byte] {
  let u16 = fn(n : Int) -> Array[Byte] {
    if le {
      [(n & 255).to_byte(), (n >> 8).to_byte()]
    } else {
      [(n >> 8).to_byte(), (n & 255).to_byte()]
    }
  }
  let u32 = fn(n : Int) -> Array[Byte] {
    if le {
      mbt_compat::arr_concat(u16(n & 0xFFFF), u16(n >> 16))
    } else {
      mbt_compat::arr_concat(u16(n >> 16), u16(n & 0xFFFF))
    }
  }
  let order : Array[Byte] = if le { [73.to_byte(), 73.to_byte()] } else { [77.to_byte(), 77.to_byte()] }
  // its first directory: an image width, then the orientation (SHORT, one), no next
  let tiff = mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(order, u16(42)), u32(8)), u16(2)), u16(0x0100)), u16(3)), u32(1)), u16(20)), u16(0)), u16(0x0112)), u16(3)), u32(1)), u16(orientation)), u16(0)), u32(0))

  let body : Array[Byte] = mbt_compat::arr_concat([69.to_byte(), 120.to_byte(), 105.to_byte(), 102.to_byte(), 0.to_byte(), 0.to_byte()], tiff)
  let len = body.length() + 2
  mbt_compat::arr_concat([255.to_byte(), 225.to_byte(), (len >> 8).to_byte(), (len & 255).to_byte()], body)
}

