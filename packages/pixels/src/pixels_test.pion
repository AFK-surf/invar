///|
fn isobmff_box(tag : String, body : Array[Byte], full? : Int) -> Array[Byte] {
  let full = match full { Some(__mbt_v) => __mbt_v, None => -1 }

  let head = if full >= 0 {
    [(full >> 24).to_byte(), ((full >> 16) & 255).to_byte(), ((full >> 8) & 255).to_byte(), (full & 255).to_byte()]
  } else {
    []
  }
  let n = 8 + head.length() + body.length()
  let b32 = fn(v : Int) -> Array[Byte] {
    [(v >> 24).to_byte(), ((v >> 16) & 255).to_byte(), ((v >> 8) & 255).to_byte(), (v & 255).to_byte()]
  }
  let t = mbt_compat::arr_map(mbt_compat::str_scalars(tag), fn(c) { c.to_int().to_byte() })
  mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(b32(n), t), head), body)
}

///|
fn heic_sample(brand : String, w : Int, h : Int, rot? : Int, thumb? : (Int, Int)) -> Bytes {
  let rot = match rot { Some(__mbt_v) => __mbt_v, None => -1 }

  let b32 = fn(v : Int) -> Array[Byte] {
    [(v >> 24).to_byte(), ((v >> 16) & 255).to_byte(), ((v >> 8) & 255).to_byte(), (v & 255).to_byte()]
  }
  let b16 = fn(v : Int) -> Array[Byte] { [((v >> 8) & 255).to_byte(), (v & 255).to_byte()] }
  let tag = fn(s : String) -> Array[Byte] { mbt_compat::arr_map(mbt_compat::str_scalars(s), fn(c) { c.to_int().to_byte() }) }
  let ftyp = isobmff_box("ftyp", mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(tag(brand), b32(0)), tag("mif1")), tag(brand)))
  let mut props : Array[Byte] = []
  let mut main_idx = 1
  match thumb {
    Some((tw, th)) => {
      // thumbnail property #1 comes before primary image property #2
      props = mbt_compat::arr_concat(props, isobmff_box("ispe", mbt_compat::arr_concat(b32(tw), b32(th)), full=0))
      main_idx = 2
    }
    Option::None => ()
  }
  props = mbt_compat::arr_concat(props, isobmff_box("ispe", mbt_compat::arr_concat(b32(w), b32(h)), full=0))
  let assoc = if rot >= 0 {
    props = mbt_compat::arr_concat(props, isobmff_box("irot", [(rot & 3).to_byte()]))
    [main_idx.to_byte(), (0x80 | (main_idx + 1)).to_byte()]
  } else {
    [main_idx.to_byte()]
  }
  let ipco = isobmff_box("ipco", props)
  // primary item id = 2 (after thumbnail item 1), ipma v0 flags 0: entry_count=1, item_id=2, assoc_count, indices
  let ipma = isobmff_box("ipma", mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(b32(1), b16(2)), [assoc.length().to_byte()]), assoc), full=0)
  let pitm = isobmff_box("pitm", b16(2), full=0)
  let iprp = isobmff_box("iprp", mbt_compat::arr_concat(ipco, ipma))
  let meta = isobmff_box("meta", mbt_compat::arr_concat(pitm, iprp), full=0)
  mbt_compat::bytes_from_array(mbt_compat::arr_concat(ftyp, meta))
}

