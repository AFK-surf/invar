///|
fn isobmff_box(tag : String, body : Array[Byte], full? : Int) -> Array[Byte] {
  let full = match full { Some(__mbt_v) => __mbt_v, None => -1 }

  let head = if full >= 0 {
    [(full >> 24).to_byte(), ((full >> 16) & 255).to_byte(), ((full >> 8) & 255).to_byte(), (full & 255).to_byte()]
  } else {
    []
  }
  let n = 8 + head.length() + body.length()
  let b32 = fn(v : Int) -> Array[Byte] {
    [(v >> 24).to_byte(), ((v >> 16) & 255).to_byte(), ((v >> 8) & 255).to_byte(), (v & 255).to_byte()]
  }
  let t = mbt_compat::arr_map(mbt_compat::str_scalars(tag), fn(c) { c.to_int().to_byte() })
  mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(b32(n), t), head), body)
}

///|
fn heic_sample(brand : String, w : Int, h : Int, rot? : Int, thumb? : (Int, Int)) -> Bytes {
  let rot = match rot { Some(__mbt_v) => __mbt_v, None => -1 }

  let b32 = fn(v : Int) -> Array[Byte] {
    [(v >> 24).to_byte(), ((v >> 16) & 255).to_byte(), ((v >> 8) & 255).to_byte(), (v & 255).to_byte()]
  }
  let b16 = fn(v : Int) -> Array[Byte] { [((v >> 8) & 255).to_byte(), (v & 255).to_byte()] }
  let tag = fn(s : String) -> Array[Byte] { mbt_compat::arr_map(mbt_compat::str_scalars(s), fn(c) { c.to_int().to_byte() }) }
  let ftyp = isobmff_box("ftyp", mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(tag(brand), b32(0)), tag("mif1")), tag(brand)))
  let mut props : Array[Byte] = []
  let mut main_idx = 1
  match thumb {
    Option::Some((tw, th)) => {
      // thumbnail property #1 comes before primary image property #2
      props = mbt_compat::arr_concat(props, isobmff_box("ispe", mbt_compat::arr_concat(b32(tw), b32(th)), full=0))
      main_idx = 2
    }
    Option::None => ()
  }
  props = mbt_compat::arr_concat(props, isobmff_box("ispe", mbt_compat::arr_concat(b32(w), b32(h)), full=0))
  let assoc = if rot >= 0 {
    props = mbt_compat::arr_concat(props, isobmff_box("irot", [(rot & 3).to_byte()]))
    [main_idx.to_byte(), (0x80 | (main_idx + 1)).to_byte()]
  } else {
    [main_idx.to_byte()]
  }
  let ipco = isobmff_box("ipco", props)
  // primary item id = 2 (after thumbnail item 1), ipma v0 flags 0: entry_count=1, item_id=2, assoc_count, indices
  let ipma = isobmff_box("ipma", mbt_compat::arr_concat(mbt_compat::arr_concat(mbt_compat::arr_concat(b32(1), b16(2)), [assoc.length().to_byte()]), assoc), full=0)
  let pitm = isobmff_box("pitm", b16(2), full=0)
  let iprp = isobmff_box("iprp", mbt_compat::arr_concat(ipco, ipma))
  let meta = isobmff_box("meta", mbt_compat::arr_concat(pitm, iprp), full=0)
  mbt_compat::bytes_from_array(mbt_compat::arr_concat(ftyp, meta))
}

///|
test "a HEIC or AVIF picture's size as it is shown: its primary item's ispe, turned a quarter where its irot says" {
  { let __mbt_aa_54 = image_size(heic_sample("heic", 4032, 3024)); let __mbt_aa_55 = Some((4032, 3024)); if !({ let __eq_l_229 : Option[(Int, Int)] = __mbt_aa_54; let __eq_r_229 : Option[(Int, Int)] = __mbt_aa_55; match (__eq_l_229, __eq_r_229) { (Some(__oa_7), Some(__ob_7)) => ((__oa_7).0 == (__ob_7).0) && ((__oa_7).1 == (__ob_7).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:224") } }
  { let __mbt_aa_56 = image_size(heic_sample("heic", 4032, 3024, rot=1)); let __mbt_aa_57 = Some((3024, 4032)); if !({ let __eq_l_230 : Option[(Int, Int)] = __mbt_aa_56; let __eq_r_230 : Option[(Int, Int)] = __mbt_aa_57; match (__eq_l_230, __eq_r_230) { (Some(__oa_8), Some(__ob_8)) => ((__oa_8).0 == (__ob_8).0) && ((__oa_8).1 == (__ob_8).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:225") } }
  { let __mbt_aa_58 = image_size(heic_sample("heic", 4032, 3024, rot=2)); let __mbt_aa_59 = Some((4032, 3024)); if !({ let __eq_l_231 : Option[(Int, Int)] = __mbt_aa_58; let __eq_r_231 : Option[(Int, Int)] = __mbt_aa_59; match (__eq_l_231, __eq_r_231) { (Some(__oa_9), Some(__ob_9)) => ((__oa_9).0 == (__ob_9).0) && ((__oa_9).1 == (__ob_9).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:226") } }
  { let __mbt_aa_60 = image_size(heic_sample("heic", 4032, 3024, rot=3, thumb=(512, 384))); let __mbt_aa_61 = Some((3024, 4032)); if !({ let __eq_l_232 : Option[(Int, Int)] = __mbt_aa_60; let __eq_r_232 : Option[(Int, Int)] = __mbt_aa_61; match (__eq_l_232, __eq_r_232) { (Some(__oa_10), Some(__ob_10)) => ((__oa_10).0 == (__ob_10).0) && ((__oa_10).1 == (__ob_10).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:227") } }
  { let __mbt_aa_62 = image_size(heic_sample("avif", 1920, 1080)); let __mbt_aa_63 = Some((1920, 1080)); if !({ let __eq_l_233 : Option[(Int, Int)] = __mbt_aa_62; let __eq_r_233 : Option[(Int, Int)] = __mbt_aa_63; match (__eq_l_233, __eq_r_233) { (Some(__oa_11), Some(__ob_11)) => ((__oa_11).0 == (__ob_11).0) && ((__oa_11).1 == (__ob_11).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:228") } }
}

///|
test "a 4-bit indexed PNG with PLTE and tRNS decodes back to its size and RGBA pixels (even and odd widths)" {
  let palette = FixedArray::make(16 * 3, 0.to_byte())
  let alphas = FixedArray::make(16, 0.to_byte())
  for i in 0..<16 {
    palette[i * 3] = (i * 16).to_byte()
    palette[i * 3 + 1] = (255 - i * 15).to_byte()
    palette[i * 3 + 2] = (i * 7 + 3).to_byte()
    alphas[i] = (i * 15).to_byte()
  }
  for dims in [(6, 3), (5, 4)] {
    let (w, h) = dims
    let indices = FixedArray::make(w * h, 0.to_byte())
    for y in 0..<h {
      for x in 0..<w {
        indices[y * w + x] = ((y * 5 + x * 3) & 0xF).to_byte()
      }
    }
    let png = png_indexed(w, h, palette, alphas, indices)
    { let __mbt_aa_64 = image_size(png); let __mbt_aa_65 = Some((w, h)); if !({ let __eq_l_255 : Option[(Int, Int)] = __mbt_aa_64; let __eq_r_255 : Option[(Int, Int)] = __mbt_aa_65; match (__eq_l_255, __eq_r_255) { (Some(__oa_12), Some(__ob_12)) => ((__oa_12).0 == (__ob_12).0) && ((__oa_12).1 == (__ob_12).1), (None, None) => true, _ => false } }) { panic("assert_eq failed at pixels_test.mbt:250") } }
    match decode_png(png) {
      Some((dw, dh, rgba)) => {

        { let __mbt_aa_67 = (dw, dh); let __mbt_aa_68 = (w, h); if !({ let __eq_l_259 : (Int, Int) = __mbt_aa_67; let __eq_r_259 : (Int, Int) = __mbt_aa_68; ((__eq_l_259).0 == (__eq_r_259).0) && ((__eq_l_259).1 == (__eq_r_259).1) }) { panic("assert_eq failed at pixels_test.mbt:252") } }
        for i in 0..<(w * h) {
          let idx = indices[i].to_int()
          { let __mbt_aa_69 = rgba[i * 4]; let __mbt_aa_70 = palette[idx * 3]; if !(__mbt_aa_69 == __mbt_aa_70) { panic("assert_eq failed at pixels_test.mbt:255") } }
          { let __mbt_aa_71 = rgba[i * 4 + 1]; let __mbt_aa_72 = palette[idx * 3 + 1]; if !(__mbt_aa_71 == __mbt_aa_72) { panic("assert_eq failed at pixels_test.mbt:256") } }
          { let __mbt_aa_73 = rgba[i * 4 + 2]; let __mbt_aa_74 = palette[idx * 3 + 2]; if !(__mbt_aa_73 == __mbt_aa_74) { panic("assert_eq failed at pixels_test.mbt:257") } }
          { let __mbt_aa_75 = rgba[i * 4 + 3]; let __mbt_aa_76 = alphas[idx]; if !(__mbt_aa_75 == __mbt_aa_76) { panic("assert_eq failed at pixels_test.mbt:258") } }
        }
      }
      _ => { { let __mbt_aa_66 = "decode_png failed"; mbt_compat::fail(__mbt_aa_66, "pixels_test.mbt:251") } }
    }
  }
}
