///|
/// The JPEG's entropy-coded data: what is between its scan's header and its end.
fn scan_data(j : Bytes) -> Array[Byte] {
  let a = mbt_compat::bytes_to_array(j)
  let mut at = 0
  while at + 1 < a.length() && !(a[at] == 255.to_byte() && a[at + 1] == 218.to_byte()) {
    at = at + 1
  }
  let len = (a[at + 2].to_int() << 8) | a[at + 3].to_int()
  mbt_compat::array_slice_clamp(a, at + 2 + len, a.length() - 2)
}

