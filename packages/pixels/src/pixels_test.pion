    palette[i * 3 + 2] = (i * 7 + 3).to_byte()
    alphas[i] = (i * 15).to_byte()
  }
  for dims in [(6, 3), (5, 4)] {
    let (w, h) = dims
    let indices = FixedArray::make(w * h, 0.to_byte())
    for y in 0..<h {
      for x in 0..<w {
