    match decode_png(png) {
      Some((dw, dh, rgba)) => {

        { let __mbt_aa_67 = (dw, dh); let __mbt_aa_68 = (w, h); if !(__mbt_aa_67 == __mbt_aa_68) { panic("assert_eq failed at pixels_test.mbt:252") } }
