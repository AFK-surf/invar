// Vector picture descriptor and CPU RGBA rasterizer.
// Ported from libs/mbui/src/pixels/vector.mbt.

pub struct VectorPath {
  pub d : String
  pub fill : Int64
  pub stroke : Int64
  pub width : Double
  pub even_odd : Bool
  pub sx : Double
  pub sy : Double
  pub tx : Double
  pub ty : Double
}

pub struct Vector {
  pub w : Double
  pub h : Double
  pub layers : Array[VectorPath]
}

pub fn VectorPath::outlines(self : VectorPath, k : Double, scale : Double) -> Array[(Array[Double], Bool)] {
  let raw = svg_path(self.d, cover_dmax(k * self.sx, k * self.sy) * scale)
  let out : Array[(Array[Double], Bool)] = []
  for sub in raw {
    let (pts, closed) = sub
    let moved = make_doubles(pts.length(), 0.0)
    let mut j = 0
    while j + 1 < pts.length() {
      moved[j] = (pts[j] * self.sx + self.tx) * k
      moved[j + 1] = (pts[j + 1] * self.sy + self.ty) * k
      j += 2
    }
    out.push((moved, closed))
  }
  out
}

pub fn tinted(color : Int64, tint : Option[Int64]) -> Int64 {
  match tint {
    None => color
    Some(t) => {
      let a = (color & 0xFF.to_int64()).to_double() * (t & 0xFF.to_int64()).to_double() / 255.0
      let rgb_mask = (0xFFFF.to_int64() << 16) | 0xFF00.to_int64()
      (t & rgb_mask) | a.round().to_int().to_int64()
    }
  }
}

fn composite(out : Array[Double], cover : Array[Double], color : Int64) -> Unit {
  let r = ((color >> 24) & 0xFF.to_int64()).to_double() / 255.0
  let g = ((color >> 16) & 0xFF.to_int64()).to_double() / 255.0
  let b = ((color >> 8) & 0xFF.to_int64()).to_double() / 255.0
  let a = (color & 0xFF.to_int64()).to_double() / 255.0
  for i in 0..<cover.length() {
    let c = cover[i]
    if c > 0.0 {
      let sa = (if c > 1.0 { 1.0 } else { c }) * a
      let k = 1.0 - sa
      out[i * 4] = r * sa + out[i * 4] * k
      out[i * 4 + 1] = g * sa + out[i * 4 + 1] * k
      out[i * 4 + 2] = b * sa + out[i * 4 + 2] * k
      out[i * 4 + 3] = sa + out[i * 4 + 3] * k
      cover[i] = 0.0
    }
  }
}

pub fn Vector::rgba(self : Vector, pw : Int, ph : Int, tint? : Int64) -> Bytes {
  let out = make_doubles(pw * ph * 4, 0.0)
  let cover = make_doubles(pw * ph, 0.0)
  let kx = pw.to_double() / self.w
  let ky = ph.to_double() / self.h
  for l in self.layers {
    let scale = cover_dmax(kx * l.sx, ky * l.sy)
    let raw = svg_path(l.d, scale)
    let subs : Array[(Array[Double], Bool)] = []
    let polys : Array[Array[Double]] = []
    for sub in raw {
      let (pts, closed) = sub
      let moved = make_doubles(pts.length(), 0.0)
      let mut k = 0
      while k + 1 < pts.length() {
        moved[k] = (pts[k] * l.sx + l.tx) * kx
        moved[k + 1] = (pts[k + 1] * l.sy + l.ty) * ky
        k += 2
      }
      subs.push((moved, closed))
      polys.push(moved)
    }
    if l.fill != 0.to_int64() {
      fill_cover(cover, pw, ph, polys, even_odd=l.even_odd)
      composite(out, cover, tinted(l.fill, tint))
    }
    if l.stroke != 0.to_int64() && l.width > 0.0 {
      let hw = l.width * l.sx * kx / 2.0
      for s in subs {
        stroke_cover(cover, pw, ph, s.0, s.1, hw)
      }
      composite(out, cover, tinted(l.stroke, tint))
    }
  }
  let rgba = make_bytes_arr(pw * ph * 4, 0 as Byte)
  for i in 0..<(pw * ph) {
    let a = out[i * 4 + 3]
    if a > 0.0 {
      for ch in 0..<3 {
        let v = out[i * 4 + ch] / a * 255.0
        rgba[i * 4 + ch] = (if v > 255.0 { 255.0 } else { v }).round().to_int() as Byte
      }
      rgba[i * 4 + 3] = ((if a > 1.0 { 1.0 } else { a }) * 255.0).round().to_int() as Byte
    }
  }
  bytes_from_arr(rgba)
}
