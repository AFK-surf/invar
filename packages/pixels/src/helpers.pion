// Shared helpers for pixels package.

fn u32_mask() -> Int64 {
  (1.to_int64() << 32) - 1.to_int64()
}

fn make_ints(n : Int, v : Int) -> Array[Int] {
  let a : Array[Int] = []
  for _ in 0..<n {
    a.push(v)
  }
  a
}

fn make_bytes_arr(n : Int, v : Byte) -> Array[Byte] {
  let a : Array[Byte] = []
  for _ in 0..<n {
    a.push(v)
  }
  a
}

fn make_doubles(n : Int, v : Double) -> Array[Double] {
  let a : Array[Double] = []
  for _ in 0..<n {
    a.push(v)
  }
  a
}

fn bytes_from_arr(arr : Array[Byte]) -> Bytes {
  let sb = StringBuilder::new()
  for b in arr {
    sb.write_byte(b)
  }
  sb.to_string().to_bytes()
}

fn bytes_from_ints(arr : Array[Int]) -> Bytes {
  let sb = StringBuilder::new()
  for x in arr {
    sb.write_byte((x & 0xFF) as Byte)
  }
  sb.to_string().to_bytes()
}

fn bytes_slice(b : Bytes, start : Int, end : Int) -> Bytes {
  let sb = StringBuilder::new()
  for i in start..<end {
    sb.write_byte(b[i])
  }
  sb.to_string().to_bytes()
}

fn bytes_eq_ascii(b : Bytes, at : Int, s : String) -> Bool {
  let sb = s.to_bytes()
  if at < 0 || at + sb.length() > b.length() {
    return false
  }
  for i in 0..<sb.length() {
    if b[at + i] != sb[i] {
      return false
    }
  }
  true
}

fn clamp_int(v : Int, lo : Int, hi : Int) -> Int {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

fn imin(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

fn imax(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

fn cover_dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

fn cover_dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}
