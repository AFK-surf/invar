// Thin Invar Layer-2 compatibility helpers (do NOT edit m2p-generated files).

pub fn bytes_to_fixed(b : Bytes) -> FixedArray[Byte] {
  let n = b.length()
  let out = FixedArray::make(n, b'\x00')
  let mut i = 0
  while i < n {
    out[i] = b[i]
    i = i + 1
  }
  out
}

pub fn array_to_fixed(arr : Array[Byte]) -> FixedArray[Byte] {
  let n = arr.length()
  let out = FixedArray::make(n, b'\x00')
  let mut i = 0
  while i < n {
    out[i] = arr[i]
    i = i + 1
  }
  out
}
