// PNG decoding (all color types, bit depths 1/2/4/8/16, PLTE/tRNS, Adam7 interlacing).
// Ported from libs/mbui/src/pixels/png_decode.mbt.

import "zip"

fn png_be32(b : Bytes, i : Int) -> Int {
  (b[i].to_int() << 24) | (b[i + 1].to_int() << 16) | (b[i + 2].to_int() << 8) | b[i + 3].to_int()
}

/// The image's width, height and RGBA bytes (straight), None where it is not a PNG this reads.
pub fn decode_png(b : Bytes) -> Option[(Int, Int, Bytes)] {
  if b.length() < 8 || b[0].to_int() != 0x89 || b[1].to_int() != 0x50 || b[2].to_int() != 0x4E || b[3].to_int() != 0x47 {
    return None
  }
  let mut i = 8
  let mut width = 0
  let mut height = 0
  let mut depth = 8
  let mut ctype = 6
  let mut interlace = 0
  let mut palette : Array[(Int, Int, Int)] = []
  let mut trns : Bytes = "".to_bytes()
  let idat : Array[Byte] = []
  while i + 8 <= b.length() {
    let len = png_be32(b, i)
    if len < 0 || i + 8 + len > b.length() {
      return None
    }
    let data = i + 8
    if bytes_eq_ascii(b, i + 4, "IHDR") {
      if len < 13 {
        return None
      }
      width = png_be32(b, data)
      height = png_be32(b, data + 4)
      depth = b[data + 8].to_int()
      ctype = b[data + 9].to_int()
      interlace = b[data + 12].to_int()
    } else if bytes_eq_ascii(b, i + 4, "PLTE") {
      if len == 0 || len % 3 != 0 || len > 768 {
        return None
      }
      palette = []
      for k in 0..<(len / 3) {
        palette.push((b[data + k * 3].to_int(), b[data + k * 3 + 1].to_int(), b[data + k * 3 + 2].to_int()))
      }
    } else if bytes_eq_ascii(b, i + 4, "tRNS") {
      trns = bytes_slice(b, data, data + len)
    } else if bytes_eq_ascii(b, i + 4, "IDAT") {
      for k in data..<(data + len) {
        idat.push(b[k])
      }
    } else if bytes_eq_ascii(b, i + 4, "IEND") {
      break
    }
    i = data + len + 4
  }
  if width <= 0 || height <= 0 || width > 65535 || height > 65535 {
    return None
  }
  let channels = if ctype == 0 {
    1
  } else if ctype == 2 {
    3
  } else if ctype == 3 {
    1
  } else if ctype == 4 {
    2
  } else if ctype == 6 {
    4
  } else {
    return None
  }
  if ctype == 3 && palette.length() == 0 {
    return None
  }
  if idat.length() < 6 {
    return None
  }
  let cmf = idat[0].to_int()
  let flg = idat[1].to_int()
  if (cmf & 0x0F) != 8 || (cmf >> 4) > 7 || ((cmf << 8) | flg) % 31 != 0 || (flg & 0x20) != 0 {
    return None
  }
  let raw = match zip::inflate(bytes_from_arr(idat), 2, 0) {
    Some(r) => r
    None => return None
  }
  let out = make_bytes_arr(width * height * 4, 0 as Byte)
  let bpp_bits = channels * depth
  let bpp = if bpp_bits < 8 { 1 } else { bpp_bits / 8 }
  let mut p = 0
  let passes = if interlace == 1 {
    [(0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4), (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2)]
  } else {
    [(0, 0, 1, 1)]
  }
  let mut expected_raw = 0
  for pass in passes {
    let (x0, y0, dx, dy) = pass
    let pw = if width > x0 { (width - x0 + dx - 1) / dx } else { 0 }
    let ph = if height > y0 { (height - y0 + dy - 1) / dy } else { 0 }
    if pw > 0 && ph > 0 {
      expected_raw += ph * (1 + (pw * bpp_bits + 7) / 8)
    }
  }
  if raw.length() != expected_raw {
    return None
  }
  for pass in passes {
    let (x0, y0, dx, dy) = pass
    let pw = if width > x0 { (width - x0 + dx - 1) / dx } else { 0 }
    let ph = if height > y0 { (height - y0 + dy - 1) / dy } else { 0 }
    if pw == 0 || ph == 0 {
      continue
    }
    let stride = (pw * bpp_bits + 7) / 8
    let cur = make_ints(stride, 0)
    let prev = make_ints(stride, 0)
    for py in 0..<ph {
      if p + 1 + stride > raw.length() {
        return None
      }
      let filter = raw[p].to_int()
      if filter < 0 || filter > 4 {
        return None
      }
      p += 1
      for x in 0..<stride {
        let rawv = raw[p + x].to_int()
        let a = if x >= bpp { cur[x - bpp] } else { 0 }
        let up = prev[x]
        let c = if x >= bpp { prev[x - bpp] } else { 0 }
        let v = if filter == 0 {
          rawv
        } else if filter == 1 {
          rawv + a
        } else if filter == 2 {
          rawv + up
        } else if filter == 3 {
          rawv + (a + up) / 2
        } else {
          let pp = a + up - c
          let pa = if pp > a { pp - a } else { a - pp }
          let pb = if pp > up { pp - up } else { up - pp }
          let pc = if pp > c { pp - c } else { c - pp }
          rawv + (if pa <= pb && pa <= pc { a } else if pb <= pc { up } else { c })
        }
        cur[x] = v & 0xFF
      }
      p += stride
      let sample_raw = fn(k : Int) -> Int {
        if depth == 8 {
          cur[k]
        } else if depth == 16 {
          (cur[k * 2] << 8) | cur[k * 2 + 1]
        } else {
          let per = 8 / depth
          let byte = cur[k / per]
          let shift = 8 - depth * (k % per + 1)
          (byte >> shift) & ((1 << depth) - 1)
        }
      }
      let to8 = fn(v : Int) -> Int {
        if depth == 16 {
          v >> 8
        } else if depth == 8 {
          v
        } else {
          v * 255 / ((1 << depth) - 1)
        }
      }
      let trns16 = fn(k : Int) -> Int {
        if trns.length() >= k * 2 + 2 {
          (trns[k * 2].to_int() << 8) | trns[k * 2 + 1].to_int()
        } else {
          -1
        }
      }
      let y = y0 + py * dy
      for px in 0..<pw {
        let x = x0 + px * dx
        let o = (y * width + x) * 4
        let (r, g, bl, al) = if ctype == 0 {
          let rv = sample_raw(px)
          let v = to8(rv)
          (v, v, v, if rv == trns16(0) { 0 } else { 255 })
        } else if ctype == 2 {
          let rr = sample_raw(px * 3)
          let rg = sample_raw(px * 3 + 1)
          let rb = sample_raw(px * 3 + 2)
          let transparent = trns.length() >= 6 && rr == trns16(0) && rg == trns16(1) && rb == trns16(2)
          (to8(rr), to8(rg), to8(rb), if transparent { 0 } else { 255 })
        } else if ctype == 3 {
          let idx = sample_raw(px)
          let (pr, pg, pb) = if idx < palette.length() { palette[idx] } else { (0, 0, 0) }
          (pr, pg, pb, if idx < trns.length() { trns[idx].to_int() } else { 255 })
        } else if ctype == 4 {
          let v = to8(sample_raw(px * 2))
          (v, v, v, to8(sample_raw(px * 2 + 1)))
        } else {
          (
            to8(sample_raw(px * 4)),
            to8(sample_raw(px * 4 + 1)),
            to8(sample_raw(px * 4 + 2)),
            to8(sample_raw(px * 4 + 3)),
          )
        }
        out[o] = r as Byte
        out[o + 1] = g as Byte
        out[o + 2] = bl as Byte
        out[o + 3] = al as Byte
      }
      for x in 0..<stride {
        prev[x] = cur[x]
      }
    }
  }
  Some((width, height, bytes_from_arr(out)))
}
