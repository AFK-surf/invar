// PNG encoding (RGBA stored and 4-bit indexed PLTE+tRNS).
// Ported from libs/mbui/src/pixels/png.mbt.

fn png_crc_table() -> Array[Int64] {
  let poly : Int64 = 0x76DC4190.to_int64() << 1 // 0xEDB88320
  let t : Array[Int64] = []
  for n in 0..<256 {
    let mut c = n.to_int64()
    for _ in 0..<8 {
      if (c & 1.to_int64()) != 0.to_int64() {
        c = poly ^ ((c >> 1) & 0x7FFFFFFF.to_int64())
      } else {
        c = (c >> 1) & 0x7FFFFFFF.to_int64()
      }
    }
    t.push(c)
  }
  t
}

struct PngOut {
  buf : Array[Byte]
}

fn PngOut::byte(self : PngOut, v : Int) -> Unit {
  self.buf.push((v & 0xFF) as Byte)
}

fn PngOut::u32(self : PngOut, v : Int64) -> Unit {
  self.byte(((v >> 24) & 0xFF.to_int64()).to_int())
  self.byte(((v >> 16) & 0xFF.to_int64()).to_int())
  self.byte(((v >> 8) & 0xFF.to_int64()).to_int())
  self.byte((v & 0xFF.to_int64()).to_int())
}

fn PngOut::chunk(self : PngOut, kind : String, data : Array[Byte]) -> Unit {
  self.u32(data.length().to_int64() & u32_mask())
  let start = self.buf.length()
  let kb = kind.to_bytes()
  for i in 0..<kb.length() {
    self.buf.push(kb[i])
  }
  for b in data {
    self.buf.push(b)
  }
  let table = png_crc_table()
  let mask = u32_mask()
  let mut c = mask
  for i in start..<self.buf.length() {
    let idx = ((c ^ self.buf[i].to_int().to_int64()) & 0xFF.to_int64()).to_int()
    c = table[idx] ^ ((c >> 8) & 0x00FFFFFF.to_int64())
  }
  self.u32((c ^ mask) & mask)
}

fn png_stored_idat(raw : Array[Byte]) -> Array[Byte] {
  let z = PngOut::{ buf: [] }
  z.byte(0x78)
  z.byte(0x01)
  let mut at = 0
  while at < raw.length() || at == 0 {
    let n = if raw.length() - at > 65535 { 65535 } else { raw.length() - at }
    z.byte(if at + n >= raw.length() { 1 } else { 0 })
    z.byte(n & 0xFF)
    z.byte(n >> 8)
    let nl = n ^ 0xFFFF
    z.byte(nl & 0xFF)
    z.byte((nl >> 8) & 0xFF)
    for i in at..<(at + n) {
      z.buf.push(raw[i])
    }
    at += n
    if n == 0 {
      break
    }
  }
  let mut a = 1.to_int64()
  let mut b = 0.to_int64()
  let mod_base = 65521.to_int64()
  for v in raw {
    a = (a + v.to_int().to_int64()) % mod_base
    b = (b + a) % mod_base
  }
  z.u32((b << 16) | a)
  z.buf
}

/// RGBA pixels (`w` x `h`, straight alpha, rows from the top) as a PNG.
pub fn png(w : Int, h : Int, rgba : Bytes) -> Bytes {
  let o = PngOut::{ buf: [] }
  let sig = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]
  for b in sig {
    o.byte(b)
  }
  let ihdr = PngOut::{ buf: [] }
  ihdr.u32(w.to_int64() & u32_mask())
  ihdr.u32(h.to_int64() & u32_mask())
  let hdr_tail = [8, 6, 0, 0, 0]
  for b in hdr_tail {
    ihdr.byte(b)
  }
  o.chunk("IHDR", ihdr.buf)
  let raw : Array[Byte] = []
  for y in 0..<h {
    raw.push(0 as Byte)
    for x in 0..<(w * 4) {
      raw.push(rgba[y * w * 4 + x])
    }
  }
  o.chunk("IDAT", png_stored_idat(raw))
  o.chunk("IEND", [])
  bytes_from_arr(o.buf)
}

/// 4-bit indexed-colour pixels (`w` x `h`, PLTE + tRNS, stored deflate blocks).
pub fn png_indexed(
  w : Int,
  h : Int,
  palette : Bytes,
  alphas : Bytes,
  indices : Bytes,
) -> Bytes {
  let o = PngOut::{ buf: [] }
  let sig = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]
  for b in sig {
    o.byte(b)
  }
  let ihdr = PngOut::{ buf: [] }
  ihdr.u32(w.to_int64() & u32_mask())
  ihdr.u32(h.to_int64() & u32_mask())
  let hdr_tail = [4, 3, 0, 0, 0]
  for b in hdr_tail {
    ihdr.byte(b)
  }
  o.chunk("IHDR", ihdr.buf)
  let plte : Array[Byte] = []
  for i in 0..<palette.length() {
    plte.push(palette[i])
  }
  o.chunk("PLTE", plte)
  if alphas.length() > 0 {
    let trns : Array[Byte] = []
    for i in 0..<alphas.length() {
      trns.push(alphas[i])
    }
    o.chunk("tRNS", trns)
  }
  let raw : Array[Byte] = []
  for y in 0..<h {
    raw.push(0 as Byte)
    let row = y * w
    let mut x = 0
    while x < w {
      let hi = indices[row + x].to_int() & 0x0F
      let lo = if x + 1 < w { indices[row + x + 1].to_int() & 0x0F } else { 0 }
      raw.push(((hi << 4) | lo) as Byte)
      x += 2
    }
  }
  o.chunk("IDAT", png_stored_idat(raw))
  o.chunk("IEND", [])
  bytes_from_arr(o.buf)
}
