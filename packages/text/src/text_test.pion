fn ints_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

test "grapheme clusters: combining, emoji ZWJ, flags, Devanagari GB9c, empty" {
  // e + combining acute (1+2=3 bytes), woman+ZWJ+woman+ZWJ+girl (4+3+4+3+4=18 bytes), CN flag (8 bytes), J flag (4 bytes)
  let s = "e\xCC\x81\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7\xF0\x9F\x87\xA8\xF0\x9F\x87\xB3\xF0\x9F\x87\xAF"
  let gs = graphemes(s)
  debug_assert(ints_eq(gs, [0, 3, 21, 29, 33]), "graphemes UTF-8 offsets")
  debug_assert(next_grapheme(s, 3) == 21, "next_grapheme ZWJ family")
  debug_assert(prev_grapheme(s, 10) == 3, "prev_grapheme from inside cluster")
  debug_assert(prev_grapheme(s, 33) == 29, "prev_grapheme last flag")
  debug_assert(prev_grapheme(s, 0) == 0, "prev_grapheme at 0")
  debug_assert(graphemes("").length() == 0, "empty graphemes")
  // GB9c: Devanagari KA (U+0915) + VIRAMA (U+094D) + SSA (U+0937) = 9 UTF-8 bytes, 1 cluster
  let dev = "\xE0\xA4\x95\xE0\xA5\x8D\xE0\xA4\xB7"
  debug_assert(ints_eq(graphemes(dev), [0, 9]), "GB9c Devanagari conjunct")
}

test "UAX #14 line breaks: CJK + English mixed, punctuation kinsoku, hard breaks, empty" {
  debug_assert(break_opportunities("").length() == 0, "empty string has no breaks")
  let s = "Hello, world (test).\n你好，世界。"
  // "Hello, " (7), "world " (13), "(test).\n" (21, hard), "你" (24), "好，" (30, kinsoku keeps ， with 好), "世" (33), "界。" (39, hard EOT)
  let b = break_opportunities(s)
  debug_assert(b.length() == 7, "7 break opportunities")
  debug_assert(b[0].0 == 7 && !b[0].1, "after Hello, ")
  debug_assert(b[1].0 == 13 && !b[1].1, "after world ")
  debug_assert(b[2].0 == 21 && b[2].1, "mandatory after newline")
  debug_assert(b[3].0 == 24 && !b[3].1, "after 你")
  debug_assert(b[4].0 == 30 && !b[4].1, "after 好， (kinsoku)")
  debug_assert(b[5].0 == 33 && !b[5].1, "after 世")
  debug_assert(b[6].0 == 39 && b[6].1, "mandatory EOT")
}

test "width_runs: CJK vs Latin ambiguous punctuation" {
  let r1 = width_runs("it's really you")
  debug_assert(r1.length() == 1 && !r1[0].2, "pure ASCII")

  // U+2019 = \xE2\x80\x99
  let r2 = width_runs("confirm it\xE2\x80\x99s really you")
  debug_assert(r2.length() == 1 && r2[0].2, "Latin with curly apostrophe -> narrow")

  // U+201C = \xE2\x80\x9C, U+201D = \xE2\x80\x9D
  let r3 = width_runs("我喜欢\xE2\x80\x9CHello\xE2\x80\x9D这个词")
  debug_assert(r3.length() == 1 && !r3[0].2, "quotes beside CJK -> full width")

  // Mixed line: "通行密钥 " (13 bytes) + "it’s ok" (9 bytes)
  let r4 = width_runs("通行密钥 it\xE2\x80\x99s ok")
  debug_assert(r4.length() == 2 && !r4[0].2 && r4[1].2, "mixed CJK and Latin split")
}

test "bidi_mixed, Bidi levels, mirror, visual_order" {
  debug_assert(bidi_mixed("").is_none(), "empty LTR")
  debug_assert(bidi_mixed("中文和 English 混排 (123)。").is_none(), "CJK+Latin LTR")
  // Hebrew "שלום"
  match bidi_mixed("hello שלום 123") {
    Some(bd) => {
      debug_assert(bd.is_mixed(), "mixed Hebrew+Latin")
      debug_assert(bd.paragraph_level(0) == 0, "LTR paragraph")
    }
    None => debug_assert(false, "expected mixed Bidi")
  }
  debug_assert(mirror(40) == 41 && mirror(41) == 40, "mirror parentheses")
  debug_assert(mirror(65) == 65, "non-mirrored A")
  let vo = visual_order([0, 1, 1, 2, 0])
  debug_assert(ints_eq(vo, [0, 3, 2, 1, 4]), "L2 visual order")
}

test "Run constructors" {
  let r0 = plain("hi")
  debug_assert(r0.text == "hi" && r0.weight == 0 && !r0.italic && r0.scale == 1.0, "plain")
  let r1 = bold("b")
  debug_assert(r1.weight == 700, "bold")
  let r2 = italic("i")
  debug_assert(r2.italic, "italic")
  let r3 = code("c")
  debug_assert(r3.code, "code")
  let r4 = strike("s")
  debug_assert(r4.strike, "strike")
  let r5 = link("doc", "https://still.fail")
  debug_assert(r5.link == "https://still.fail", "link")
}
