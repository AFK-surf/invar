import "mbt_compat"

fn ints_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

test "grapheme clusters: combining, emoji ZWJ, flags, Devanagari GB9c, empty (UTF-16 + UTF-8)" {
  // e + combining acute (2 UTF-16, 3 UTF-8), woman+ZWJ+woman+ZWJ+girl (8 UTF-16, 18 UTF-8), CN flag (4 UTF-16, 8 UTF-8), J flag (2 UTF-16, 4 UTF-8)
  let s = "e\xCC\x81\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7\xF0\x9F\x87\xA8\xF0\x9F\x87\xB3\xF0\x9F\x87\xAF"
  // Native UTF-16 offsets
  let gs16 = graphemes(s)
  debug_assert(ints_eq(gs16, [0, 2, 10, 14, 16]), "graphemes UTF-16 offsets")
  debug_assert(next_grapheme(s, 2) == 10, "next_grapheme UTF-16 ZWJ family")
  debug_assert(prev_grapheme(s, 6) == 2, "prev_grapheme UTF-16 from inside cluster")
  debug_assert(prev_grapheme(s, 16) == 14, "prev_grapheme UTF-16 last flag")
  debug_assert(prev_grapheme(s, 0) == 0, "prev_grapheme UTF-16 at 0")
  debug_assert(graphemes("").length() == 0, "empty graphemes")
  // invar_ext UTF-8 byte offsets
  let gs8 = graphemes_utf8(s)
  debug_assert(ints_eq(gs8, [0, 3, 21, 29, 33]), "graphemes UTF-8 offsets")
  debug_assert(next_grapheme_utf8(s, 3) == 21, "next_grapheme_utf8 ZWJ family")
  debug_assert(prev_grapheme_utf8(s, 10) == 3, "prev_grapheme_utf8 from inside cluster")
  debug_assert(prev_grapheme_utf8(s, 33) == 29, "prev_grapheme_utf8 last flag")
  debug_assert(prev_grapheme_utf8(s, 0) == 0, "prev_grapheme_utf8 at 0")
  // GB9c: Devanagari KA (U+0915) + VIRAMA (U+094D) + SSA (U+0937) = 3 UTF-16 / 9 UTF-8 bytes, 1 cluster
  let dev = "\xE0\xA4\x95\xE0\xA5\x8D\xE0\xA4\xB7"
  debug_assert(ints_eq(graphemes(dev), [0, 3]), "GB9c Devanagari conjunct UTF-16")
  debug_assert(ints_eq(graphemes_utf8(dev), [0, 9]), "GB9c Devanagari conjunct UTF-8")
}

test "UAX #14 line breaks: CJK + English mixed, punctuation kinsoku, hard breaks, empty (UTF-16 + UTF-8)" {
  debug_assert(break_opportunities("").length() == 0, "empty string has no breaks")
  let s = "Hello, world (test).\n你好，世界。"
  // UTF-16: "Hello, " (7), "world " (13), "(test).\n" (21, hard), "你" (22), "好，" (24), "世" (25), "界。" (27, hard EOT)
  let b16 = break_opportunities(s)
  debug_assert(b16.length() == 7, "7 break opportunities UTF-16")
  debug_assert(b16[0].0 == 7 && !b16[0].1, "UTF-16 after Hello, ")
  debug_assert(b16[1].0 == 13 && !b16[1].1, "UTF-16 after world ")
  debug_assert(b16[2].0 == 21 && b16[2].1, "UTF-16 mandatory after newline")
  debug_assert(b16[3].0 == 22 && !b16[3].1, "UTF-16 after 你")
  debug_assert(b16[4].0 == 24 && !b16[4].1, "UTF-16 after 好， (kinsoku)")
  debug_assert(b16[5].0 == 25 && !b16[5].1, "UTF-16 after 世")
  debug_assert(b16[6].0 == 27 && b16[6].1, "UTF-16 mandatory EOT")
  // UTF-8 via invar_ext: "Hello, " (7), "world " (13), "(test).\n" (21, hard), "你" (24), "好，" (30), "世" (33), "界。" (39, hard EOT)
  let b8 = break_opportunities_utf8(s)
  debug_assert(b8.length() == 7, "7 break opportunities UTF-8")
  debug_assert(b8[0].0 == 7 && !b8[0].1, "UTF-8 after Hello, ")
  debug_assert(b8[1].0 == 13 && !b8[1].1, "UTF-8 after world ")
  debug_assert(b8[2].0 == 21 && b8[2].1, "UTF-8 mandatory after newline")
  debug_assert(b8[3].0 == 24 && !b8[3].1, "UTF-8 after 你")
  debug_assert(b8[4].0 == 30 && !b8[4].1, "UTF-8 after 好， (kinsoku)")
  debug_assert(b8[5].0 == 33 && !b8[5].1, "UTF-8 after 世")
  debug_assert(b8[6].0 == 39 && b8[6].1, "UTF-8 mandatory EOT")
}

test "width_runs: CJK vs Latin ambiguous punctuation" {
  let r1 = width_runs("it's really you")
  debug_assert(r1.length() == 1 && !r1[0].2, "pure ASCII")

  // U+2019 = \xE2\x80\x99
  let r2 = width_runs("confirm it\xE2\x80\x99s really you")
  debug_assert(r2.length() == 1 && r2[0].2, "Latin with curly apostrophe -> narrow")

  // U+201C = \xE2\x80\x9C, U+201D = \xE2\x80\x9D
  let r3 = width_runs("我喜欢\xE2\x80\x9CHello\xE2\x80\x9D这个词")
  debug_assert(r3.length() == 1 && !r3[0].2, "quotes beside CJK -> full width")

  // Mixed line: "通行密钥 " (13 bytes) + "it’s ok" (9 bytes)
  let r4 = width_runs("通行密钥 it\xE2\x80\x99s ok")
  debug_assert(r4.length() == 2 && !r4[0].2 && r4[1].2, "mixed CJK and Latin split")
}

test "bidi_mixed, Bidi levels, mirror, visual_order" {
  debug_assert(bidi_mixed("").is_none(), "empty LTR")
  debug_assert(bidi_mixed("中文和 English 混排 (123)。").is_none(), "CJK+Latin LTR")
  // Hebrew "שלום"
  match bidi_mixed("hello שלום 123") {
    Some(bd) => {
      debug_assert(bd.is_mixed(), "mixed Hebrew+Latin")
      debug_assert(bd.paragraph_level(0) == 0, "LTR paragraph")
    }
    None => debug_assert(false, "expected mixed Bidi")
  }
  debug_assert(mirror(40) == 41 && mirror(41) == 40, "mirror parentheses")
  debug_assert(mirror(65) == 65, "non-mirrored A")
  let vo = visual_order(mbt_compat::ArrayBuf::from_array([0, 1, 1, 2, 0]).as_view())
  debug_assert(ints_eq(vo, [0, 3, 2, 1, 4]), "L2 visual order")
}

test "Run constructors" {
  let r0 = plain("hi")
  debug_assert(r0.text == "hi" && r0.weight == 0 && !r0.italic && r0.scale == 1.0, "plain")
  let r1 = bold("b")
  debug_assert(r1.weight == 700, "bold")
  let r2 = italic("i")
  debug_assert(r2.italic, "italic")
  let r3 = code("c")
  debug_assert(r3.code, "code")
  let r4 = strike("s")
  debug_assert(r4.strike, "strike")
  let r5 = link("doc", "https://example.com")
  debug_assert(r5.link == "https://example.com", "link")
}

test "malformed UTF-8 parity between UTF-16 and UTF-8 helpers" {
  let samples = [
    "\xE4ab",
    "a\xF0",
    "\xE0\x80\x80",
    "\xF0\x9F\x98",
    "\xF0\x9F\x98\x80\x80",
  ]
  for s in samples {
    let g16 = graphemes(s)
    let mapped_g : Array[Int] = []
    for u in g16 {
      mapped_g.push(mbt_compat::utf16_to_utf8_off(s, u))
    }
    let g8 = graphemes_utf8(s)
    debug_assert(ints_eq(g8, mapped_g), "graphemes_utf8 parity on malformed UTF-8")

    let b16 = break_opportunities(s)
    let b8 = break_opportunities_utf8(s)
    debug_assert(b8.length() == b16.length(), "break_opportunities_utf8 length parity")
    for idx in 0..<b16.length() {
      let (u, mand) = b16[idx]
      let (off, mand8) = b8[idx]
      debug_assert(off == mbt_compat::utf16_to_utf8_off(s, u) && mand8 == mand, "break_opportunities_utf8 entry parity")
    }
  }
  debug_assert(ints_eq(graphemes_utf8("\xE4ab"), [0, 1, 2, 3]), "truncated lead byte splits 1-byte U+FFFD")
  debug_assert(next_grapheme_utf8("\xE4ab", 0) == 1, "next_grapheme_utf8 on truncated lead byte")
  debug_assert(prev_grapheme_utf8("\xE4ab", 3) == 2, "prev_grapheme_utf8 after ASCII following malformed byte")
  debug_assert(prev_grapheme_utf8("a\xF0", 2) == 1, "prev_grapheme_utf8 before trailing truncated 4-byte lead")
}
