// Property lookup and UTF-8 code-point stepping.
// Ported from libs/mbui/src/text/props.mbt (adapted to Pion native UTF-8 Strings).

struct RangeTable {
  starts : Array[Int]
  vals : Array[Int]
  low : Array[Int]
}

fn digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 86 {
    c - 55
  } else if c >= 97 && c <= 122 {
    32 + c - 97
  } else if c == 33 {
    58
  } else if c == 36 {
    59
  } else if c == 37 {
    60
  } else if c == 38 {
    61
  } else if c == 42 {
    62
  } else if c == 43 {
    63
  } else {
    -1
  }
}

fn decode_range_table(data : String) -> RangeTable {
  let starts : Array[Int] = []
  let vals : Array[Int] = []
  let n = data.length()
  let mut i = 0
  let mut start = 0
  let mut nums = 0
  let mut acc = 0
  let mut shift = 0
  while i < n {
    let d = digit(data.code_unit_at(i))
    i += 1
    if d < 0 {
      continue
    }
    acc = acc | ((d & 31) << shift)
    shift += 5
    if d < 32 {
      if nums % 2 == 0 {
        start += acc
        starts.push(start)
      } else {
        vals.push(acc)
      }
      nums += 1
      acc = 0
      shift = 0
    }
  }
  let low : Array[Int] = []
  let t = RangeTable::{ starts, vals, low }
  for c in 0..<256 {
    t.low.push(t.search(c))
  }
  t
}

fn RangeTable::search(self : RangeTable, c : Int) -> Int {
  let starts = self.starts
  let mut lo = 0
  let mut hi = starts.length() - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if starts[mid] <= c {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  self.vals[lo]
}

fn RangeTable::get(self : RangeTable, c : Int) -> Int {
  if c >= 0 && c < 256 {
    self.low[c]
  } else {
    self.search(c)
  }
}

struct TextTables {
  mut grapheme : Option[RangeTable]
  mut line : Option[RangeTable]
  mut bidi : Option[RangeTable]
  mut class_sets : Option[Array[Int]]
}

let text_tables : TextTables = TextTables::{
  grapheme: None,
  line: None,
  bidi: None,
  class_sets: None,
}

fn get_grapheme_table() -> RangeTable {
  match text_tables.grapheme {
    Some(t) => t
    None => {
      let t = decode_range_table(grapheme_data)
      text_tables.grapheme = Some(t)
      t
    }
  }
}

fn get_line_table() -> RangeTable {
  match text_tables.line {
    Some(t) => t
    None => {
      let t = decode_range_table(line_data)
      text_tables.line = Some(t)
      t
    }
  }
}

fn get_bidi_table() -> RangeTable {
  match text_tables.bidi {
    Some(t) => t
    None => {
      let t = decode_range_table(bidi_data)
      text_tables.bidi = Some(t)
      t
    }
  }
}

/// Decodes the Unicode scalar value starting at UTF-8 byte offset `i`.
fn code_point_at(s : String, i : Int) -> Int {
  let n = s.length()
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return b0
  }
  if b0 >= 0xC2 && b0 < 0xE0 && i + 1 < n {
    let b1 = s.code_unit_at(i + 1)
    if (b1 & 0xC0) == 0x80 {
      return ((b0 & 0x1F) << 6) | (b1 & 0x3F)
    }
  } else if b0 >= 0xE0 && b0 < 0xF0 && i + 2 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 {
      return ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    }
  } else if b0 >= 0xF0 && b0 < 0xF5 && i + 3 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    if (b1 & 0xC0) == 0x80 && (b2 & 0xC0) == 0x80 && (b3 & 0xC0) == 0x80 {
      return ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
    }
  }
  0xFFFD
}

/// UTF-8 byte length of the code point starting at byte offset `i`.
fn cp_byte_len_at(s : String, i : Int) -> Int {
  let n = s.length()
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    1
  } else if b0 >= 0xC2 && b0 < 0xE0 && i + 1 < n {
    2
  } else if b0 >= 0xE0 && b0 < 0xF0 && i + 2 < n {
    3
  } else if b0 >= 0xF0 && b0 < 0xF5 && i + 3 < n {
    4
  } else {
    1
  }
}

/// Byte offset of the start of the UTF-8 code point ending at byte offset `i`.
fn cp_before(s : String, i : Int) -> Int {
  let mut p = i - 1
  while p > 0 && (s.code_unit_at(p) & 0xC0) == 0x80 {
    p -= 1
  }
  p
}
