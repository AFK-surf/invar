// Styled text run types and constructors.
// Ported from libs/mbui/src/text/run.mbt.

pub struct Ground {
  pub room : Double
  pub height : Double
  pub corner : Double
  pub after : Double
}

pub struct InlineDrawing {
  pub width : Double
  pub height : Double
  pub baseline : Double
  pub paths : Array[Array[(Array[Double], Bool)]]
  pub words : Array[(String, Double, Double, Double)]
}

pub struct Run {
  pub text : String
  pub weight : Int
  pub italic : Bool
  pub code : Bool
  pub mono : Bool
  pub serif : Bool
  pub face : Option[Int]
  pub scale : Double
  pub color : Int64
  pub bg : Int64
  pub ground : Option[Ground]
  pub strike : Bool
  pub underline : Bool
  pub link : String
  pub drawing : Option[InlineDrawing]
}

pub fn plain(text : String) -> Run {
  Run::{
    text,
    weight: 0,
    italic: false,
    code: false,
    mono: false,
    serif: false,
    face: None,
    scale: 1.0,
    color: 0.to_int64(),
    bg: 0.to_int64(),
    ground: None,
    strike: false,
    underline: false,
    link: "",
    drawing: None,
  }
}

pub fn bold(text : String) -> Run {
  Run::{ ..plain(text), weight: 700 }
}

pub fn italic(text : String) -> Run {
  Run::{ ..plain(text), italic: true }
}

pub fn code(text : String) -> Run {
  Run::{ ..plain(text), code: true }
}

pub fn strike(text : String) -> Run {
  Run::{ ..plain(text), strike: true }
}

pub fn link(text : String, href : String) -> Run {
  Run::{ ..plain(text), link: href }
}
