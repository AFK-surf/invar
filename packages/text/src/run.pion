// Styled text run types and constructors.
// Ported from libs/mbui/src/text/run.mbt.

pub struct Ground {
  pub room : Double
  pub height : Double
  pub corner : Double
  pub after : Double
}

pub struct InlineDrawing {
  pub width : Double
  pub height : Double
  pub baseline : Double
  pub paths : Array[Array[(Array[Double], Bool)]]
  pub words : Array[(String, Double, Double, Double)]
}

pub struct Run {
  pub text : String
  pub weight : Int
  pub italic : Bool
  pub code : Bool
  pub mono : Bool
  pub serif : Bool
  pub face : Option[Int]
  pub scale : Double
  pub color : Int64
  pub bg : Int64
  pub ground : Option[Ground]
  pub strike : Bool
  pub underline : Bool
  pub link : String
  pub drawing : Option[InlineDrawing]
}

/// Construct a styled `Run`, specifying only fields that differ from the paragraph.
/// When `weight != 0`, `weight` takes precedence over `bold`.
pub fn span(
  text : String,
  weight~ : Int = 0,
  bold~ : Bool = false,
  italic~ : Bool = false,
  code~ : Bool = false,
  mono~ : Bool = false,
  serif~ : Bool = false,
  face? : Int,
  scale~ : Double = 1.0,
  color~ : Int64 = 0L,
  bg~ : Int64 = 0L,
  ground? : Ground,
  strike~ : Bool = false,
  underline~ : Bool = false,
  link~ : String = "",
  drawing? : InlineDrawing,
) -> Run {
  Run::{
    text,
    weight: if bold && weight == 0 { 700 } else { weight },
    italic,
    code,
    mono,
    serif,
    face,
    scale,
    color,
    bg,
    ground,
    strike,
    underline,
    link,
    drawing,
  }
}

pub fn plain(text : String) -> Run {
  span(text)
}

pub fn bold(text : String) -> Run {
  span(text, bold=true)
}

pub fn italic(text : String) -> Run {
  span(text, italic=true)
}

pub fn code(text : String) -> Run {
  span(text, code=true)
}

pub fn strike(text : String) -> Run {
  span(text, strike=true)
}

pub fn link(text : String, href : String) -> Run {
  span(text, link=href)
}
