// East Asian Ambiguous width segmentation (UAX #11) for CJK + Latin mixed text.
// Offsets are UTF-8 byte offsets.
// Ported from libs/mbui/src/text/widths.mbt.

let wc_cjk : Int = 0
let wc_other : Int = 1
let wc_neutral : Int = 2

fn width_class_cp(c : Int) -> Int {
  if c < 0x80 {
    if (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) {
      return wc_other
    }
    return wc_neutral
  }
  if (c >= 0x1100 && c <= 0x11FF) ||
    (c >= 0x2E80 && c <= 0x9FFF) ||
    (c >= 0xA960 && c <= 0xA97F) ||
    (c >= 0xAC00 && c <= 0xD7AF) ||
    (c >= 0xF900 && c <= 0xFAFF) ||
    (c >= 0xFE10 && c <= 0xFE1F) ||
    (c >= 0xFE30 && c <= 0xFE4F) ||
    (c >= 0xFF00 && c <= 0xFFEF) ||
    (c >= 0x20000 && c <= 0x3FFFF) {
    return wc_cjk
  }
  if (c >= 0xA0 && c <= 0xBF) ||
    c == 0xD7 ||
    c == 0xF7 ||
    (c >= 0x2000 && c <= 0x2BFF) ||
    (c >= 0xFE50 && c <= 0xFE6F) ||
    (c >= 0x1F000 && c <= 0x1FBFF) {
    return wc_neutral
  }
  wc_other
}

pub fn width_mark(s : String, i : Int) -> Bool {
  let c = code_point_at(s, i)
  c == 0x2018 || c == 0x2019 || c == 0x201C || c == 0x201D || c == 0xB7 || c == 0x2027 || c == 0x2022 || c == 0x2026
}

/// Returns (byte_start, byte_end, narrow) runs.
pub fn width_runs(s : String) -> Array[(Int, Int, Bool)] {
  let n = s.length()
  let mut ascii = true
  for i in 0..<n {
    if s.code_unit_at(i) >= 0x80 {
      ascii = false
      break
    }
  }
  if ascii {
    return [(0, n, false)]
  }
  let cps : Array[Int] = []
  let starts : Array[Int] = []
  let ends : Array[Int] = []
  let mut pos = 0
  while pos < n {
    let c = code_point_at(s, pos)
    let len = cp_byte_len_at(s, pos)
    cps.push(c)
    starts.push(pos)
    ends.push(pos + len)
    pos += len
  }
  let m = cps.length()
  let cls : Array[Int] = []
  let narrow : Array[Bool] = []
  for k in 0..<m {
    cls.push(width_class_cp(cps[k]))
    narrow.push(false)
  }
  let mut any_cjk = false
  let mut i = 0
  while i < m {
    if cls[i] == wc_cjk {
      any_cjk = true
      i += 1
    } else if cls[i] == wc_other {
      narrow[i] = true
      i += 1
    } else {
      let mut j = i
      while j < m && cls[j] == wc_neutral {
        j += 1
      }
      let wide = (i > 0 && cls[i - 1] == wc_cjk) || (j < m && cls[j] == wc_cjk)
      if !wide {
        for k in i..<j {
          narrow[k] = true
        }
      }
      i = j
    }
  }
  let open_double : Array[Bool] = []
  let open_single : Array[Bool] = []
  for k in 0..<m {
    let c = cps[k]
    if c == 0x201C {
      open_double.push(narrow[k])
    } else if c == 0x2018 {
      open_single.push(narrow[k])
    } else if c == 0x201D {
      match open_double.pop() {
        Some(w) => { narrow[k] = w }
        None => ()
      }
    } else if c == 0x2019 {
      match open_single.pop() {
        Some(w) => { narrow[k] = w }
        None => ()
      }
    }
  }
  let mut needs = false
  for k in 0..<m {
    if narrow[k] && cls[k] == wc_neutral && cps[k] >= 0x80 {
      needs = true
      break
    }
  }
  if !needs {
    return [(0, n, false)]
  }
  if !any_cjk {
    return [(0, n, true)]
  }
  let runs : Array[(Int, Int, Bool)] = []
  let mut run_start_idx = 0
  for k in 1..<m {
    if narrow[k] != narrow[run_start_idx] {
      runs.push((starts[run_start_idx], starts[k], narrow[run_start_idx]))
      run_start_idx = k
    }
  }
  runs.push((starts[run_start_idx], n, narrow[run_start_idx]))
  runs
}
