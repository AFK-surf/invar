// Invar-specific UTF-8 offset compatibility helpers kept cleanly outside mbt2pion-generated files.
// Upstream `packages/text` functions (`graphemes`, `prev_grapheme`, `next_grapheme`,
// `break_opportunities`, `Bidi`, `width_runs`) operate on UTF-16 code-unit offsets;
// these helpers provide UTF-8 byte-offset wrappers for UTF-8 consumers (e.g. `editor`),
// sharing `mbt_compat`'s UTF-8 decoding rules and O(cluster) amortized grapheme stepping.

import "mbt_compat"

/// Converts a UTF-8 byte offset in `s` to its UTF-16 code-unit offset.
pub fn utf8_to_utf16_offset(s : String, byte_off : Int) -> Int {
  let n = s.length()
  let target = if byte_off <= 0 { 0 } else if byte_off >= n { n } else { byte_off }
  mbt_compat::utf8_to_utf16_off(s, target)
}

/// Converts a UTF-16 code-unit offset in `s` to its UTF-8 byte offset.
pub fn utf16_to_utf8_offset(s : String, u16_off : Int) -> Int {
  if u16_off <= 0 {
    return 0
  }
  let n16 = mbt_compat::utf16_len(s)
  if u16_off >= n16 {
    return s.length()
  }
  mbt_compat::utf16_to_utf8_off(s, u16_off)
}

fn utf8_seq_len(s : String, i : Int) -> Int {
  let n = s.length()
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    return 1
  }
  let want = if b0 >= 0xC2 && b0 <= 0xDF {
    2
  } else if b0 >= 0xE0 && b0 <= 0xEF {
    3
  } else if b0 >= 0xF0 && b0 <= 0xF4 {
    4
  } else {
    0
  }
  if want == 0 || i + want > n {
    return 1
  }
  let b1 = s.code_unit_at(i + 1)
  let lo = if b0 == 0xE0 {
    0xA0
  } else if b0 == 0xF0 {
    0x90
  } else {
    0x80
  }
  let hi = if b0 == 0xED {
    0x9F
  } else if b0 == 0xF4 {
    0x8F
  } else {
    0xBF
  }
  if b1 < lo || b1 > hi {
    return 1
  }
  let mut k = 2
  while k < want {
    let bk = s.code_unit_at(i + k)
    if bk < 0x80 || bk > 0xBF {
      return 1
    }
    k += 1
  }
  want
}

fn utf8_scalar(s : String, i : Int, l : Int) -> Int {
  let b0 = s.code_unit_at(i)
  if l == 1 {
    if b0 < 0x80 {
      return b0
    }
    return 0xFFFD
  }
  if l == 2 {
    return ((b0 & 0x1F) << 6) | (s.code_unit_at(i + 1) & 0x3F)
  }
  if l == 3 {
    return ((b0 & 0x0F) << 12) |
    ((s.code_unit_at(i + 1) & 0x3F) << 6) |
    (s.code_unit_at(i + 2) & 0x3F)
  }
  ((b0 & 0x07) << 18) |
  ((s.code_unit_at(i + 1) & 0x3F) << 12) |
  ((s.code_unit_at(i + 2) & 0x3F) << 6) |
  (s.code_unit_at(i + 3) & 0x3F)
}

fn utf8_cp_before(s : String, i : Int) -> Int {
  let mut cand = i - 1
  let floor = if i > 4 { i - 4 } else { 0 }
  while cand > floor && (s.code_unit_at(cand) & 0xC0) == 0x80 {
    cand -= 1
  }
  if (s.code_unit_at(cand) & 0xC0) != 0x80 {
    if cand + utf8_seq_len(s, cand) >= i {
      return cand
    }
  }
  i - 1
}

/// Grapheme cluster boundary strictly after UTF-8 byte offset `byte_off` (UAX #29).
/// `byte_off` should lie on a UTF-8 character/grapheme boundary (0 or a value returned
/// by this function or `prev_grapheme_utf8`).
pub fn next_grapheme_utf8(s : String, byte_off : Int) -> Int {
  let n = s.length()
  if byte_off >= n {
    return n
  }
  let i = if byte_off < 0 { 0 } else { byte_off }
  let b0 = s.code_unit_at(i)
  if b0 >= 0x20 && b0 <= 0x7E {
    let j0 = i + 1
    if j0 >= n || s.code_unit_at(j0) < 0x80 {
      return j0
    }
  }
  let l0 = utf8_seq_len(s, i)
  let c0 = utf8_scalar(s, i, l0)
  let mut p = grapheme_table.get(c0)
  let mut j = i + l0
  let mut ri = gcb(p) == G_RI
  let mut emoji = if is_xpict(p) { 1 } else { 0 }
  let mut linker = incb(p) == INCB_LINKER
  while j < n {
    let lj = utf8_seq_len(s, j)
    let cj = utf8_scalar(s, j, lj)
    let q = grapheme_table.get(cj)
    let a = gcb(p)
    let b = gcb(q)
    let brk = if pair_breaks(a, b) {
      if linker && incb(q) == INCB_CONSONANT && !is_ctl(a) {
        false
      } else if emoji == 2 && is_xpict(q) && a == G_ZWJ {
        false
      } else {
        !(ri && a == G_RI && b == G_RI)
      }
    } else {
      false
    }
    if brk {
      return j
    }
    ri = b == G_RI && !(ri && a == G_RI)
    emoji = if is_xpict(q) {
      1
    } else if emoji == 1 && b == G_EXTEND {
      1
    } else if emoji == 1 && b == G_ZWJ {
      2
    } else {
      0
    }
    linker = incb(q) == INCB_LINKER || (linker && incb(q) == INCB_EXTEND)
    p = q
    j = j + lj
  }
  n
}

fn certain_boundary_utf8(s : String, i : Int) -> Bool {
  let prev = utf8_cp_before(s, i)
  let ca = utf8_scalar(s, prev, utf8_seq_len(s, prev))
  let cb = utf8_scalar(s, i, utf8_seq_len(s, i))
  let a = grapheme_table.get(ca)
  let b = grapheme_table.get(cb)
  if !pair_breaks(gcb(a), gcb(b)) {
    return false
  }
  !(
    (gcb(a) == G_RI && gcb(b) == G_RI) ||
    (gcb(a) == G_ZWJ && is_xpict(b)) ||
    (incb(b) == INCB_CONSONANT && incb(a) != 0)
  )
}

/// Grapheme cluster boundary strictly before UTF-8 byte offset `byte_off` (UAX #29).
/// `byte_off` should lie on a UTF-8 character boundary; when it falls inside a multi-byte
/// character or cluster, this returns the start of the enclosing grapheme cluster.
pub fn prev_grapheme_utf8(s : String, byte_off : Int) -> Int {
  let n = s.length()
  let i = if byte_off > n { n } else { byte_off }
  if i <= 0 {
    return 0
  }
  let mut p = utf8_cp_before(s, i)
  while p > 0 && !certain_boundary_utf8(s, p) {
    p = utf8_cp_before(s, p)
  }
  let mut b = p
  while true {
    let q = next_grapheme_utf8(s, b)
    if q >= i {
      break
    }
    b = q
  }
  b
}

/// All grapheme cluster boundaries in `s` as UTF-8 byte offsets (UAX #29).
pub fn graphemes_utf8(s : String) -> Array[Int] {
  let n = s.length()
  let out : Array[Int] = []
  if n == 0 {
    return out
  }
  let mut i = 0
  out.push(0)
  while i < n {
    i = next_grapheme_utf8(s, i)
    out.push(i)
  }
  out
}

/// All UAX #14 line break opportunities in `s` as `(utf8_byte_offset, mandatory)` pairs.
pub fn break_opportunities_utf8(s : String) -> Array[(Int, Bool)] {
  let opps = break_opportunities(s)
  let out : Array[(Int, Bool)] = []
  let n = s.length()
  let mut b = 0
  let mut u = 0
  let mut i = 0
  while i < opps.length() {
    let (target_u, mand) = opps[i]
    while b < n && u < target_u {
      let l = utf8_seq_len(s, b)
      let us = if l == 4 { 2 } else { 1 }
      b += l
      u += us
    }
    out.push((b, mand))
    i += 1
  }
  out
}

/// Compatibility helper for `Bidi::new(s, dir=dir)`.
pub fn bidi_new(s : String, dir : Int) -> Bidi {
  Bidi::new(s, dir=dir)
}
