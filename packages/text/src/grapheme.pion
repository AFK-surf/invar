// Extended grapheme clusters (UAX #29, section 3), rules GB1-GB999.
// Offsets are UTF-8 byte offsets.
// Ported from libs/mbui/src/text/grapheme.mbt.

let g_cr : Int = 1
let g_lf : Int = 2
let g_control : Int = 3
let g_extend : Int = 4
let g_zwj : Int = 5
let g_ri : Int = 6
let g_prepend : Int = 7
let g_spacing_mark : Int = 8
let g_l : Int = 9
let g_v : Int = 10
let g_t : Int = 11
let g_lv : Int = 12
let g_lvt : Int = 13

let incb_linker : Int = 1
let incb_consonant : Int = 2
let incb_extend : Int = 3

fn gcb(p : Int) -> Int {
  p & 15
}

fn is_xpict(p : Int) -> Bool {
  (p & 16) != 0
}

fn incb(p : Int) -> Int {
  (p >> 5) & 3
}

fn is_ctl(g : Int) -> Bool {
  g == g_control || g == g_cr || g == g_lf
}

fn pair_breaks(a : Int, b : Int) -> Bool {
  if a == g_cr && b == g_lf {
    false
  } else if is_ctl(a) || is_ctl(b) {
    true
  } else if a == g_l && (b == g_l || b == g_v || b == g_lv || b == g_lvt) {
    false
  } else if (a == g_lv || a == g_v) && (b == g_v || b == g_t) {
    false
  } else if (a == g_lvt || a == g_t) && b == g_t {
    false
  } else if b == g_extend || b == g_zwj || b == g_spacing_mark {
    false
  } else {
    a != g_prepend
  }
}

/// The grapheme cluster boundary (UTF-8 byte offset) after `i`.
pub fn next_grapheme(s : String, i : Int) -> Int {
  let n = s.length()
  if i >= n {
    return n
  }
  let i = if i < 0 { 0 } else { i }
  let gt = get_grapheme_table()
  let c0 = code_point_at(s, i)
  let mut p = gt.get(c0)
  let mut j = i + cp_byte_len_at(s, i)
  let mut ri = gcb(p) == g_ri
  let mut emoji = if is_xpict(p) { 1 } else { 0 }
  let mut linker = incb(p) == incb_linker
  while j < n {
    let c = code_point_at(s, j)
    let q = gt.get(c)
    let a = gcb(p)
    let b = gcb(q)
    let brk = if pair_breaks(a, b) {
      if linker && incb(q) == incb_consonant && !is_ctl(a) {
        false
      } else if emoji == 2 && is_xpict(q) && a == g_zwj {
        false
      } else {
        !(ri && a == g_ri && b == g_ri)
      }
    } else {
      false
    }
    if brk {
      return j
    }
    ri = b == g_ri && !(ri && a == g_ri)
    emoji = if is_xpict(q) {
      1
    } else if emoji == 1 && b == g_extend {
      1
    } else if emoji == 1 && b == g_zwj {
      2
    } else {
      0
    }
    linker = incb(q) == incb_linker || (linker && incb(q) == incb_extend)
    p = q
    j += cp_byte_len_at(s, j)
  }
  n
}

fn certain_boundary(s : String, i : Int) -> Bool {
  let gt = get_grapheme_table()
  let a = gt.get(code_point_at(s, cp_before(s, i)))
  let b = gt.get(code_point_at(s, i))
  if !pair_breaks(gcb(a), gcb(b)) {
    return false
  }
  !(
    (gcb(a) == g_ri && gcb(b) == g_ri) ||
    (gcb(a) == g_zwj && is_xpict(b)) ||
    (incb(b) == incb_consonant && incb(a) != 0)
  )
}

/// The last grapheme cluster boundary (UTF-8 byte offset) before `i`.
pub fn prev_grapheme(s : String, i : Int) -> Int {
  let n = s.length()
  let i = if i > n { n } else { i }
  if i <= 0 {
    return 0
  }
  let mut p = cp_before(s, i)
  while p > 0 && !certain_boundary(s, p) {
    p = cp_before(s, p)
  }
  let mut b = p
  while true {
    let q = next_grapheme(s, b)
    if q >= i {
      break
    }
    b = q
  }
  b
}

/// All grapheme cluster boundaries of `s`, from 0 to `s.length()` (empty for "").
pub fn graphemes(s : String) -> Array[Int] {
  let n = s.length()
  let out : Array[Int] = []
  if n == 0 {
    return out
  }
  let mut i = 0
  out.push(0)
  while i < n {
    i = next_grapheme(s, i)
    out.push(i)
  }
  out
}
