// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/ControlCenterContent.kt.

import "headless"
import "ui"
import "view"

pub fn flight_icon(parent : view::View, size : Double, ink : () -> Int64, loc~ : String = "") -> Unit {
  let _ = parent.box(loc=loc, fn(i : view::View) -> Unit {
    let _ = i
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    let base = words_at(size * 0.6)
    let look = view::WordsLook::{
      size: base.size,
      weight: base.weight,
      line: size * 0.84,
      wrap: base.wrap,
      tracking: base.tracking,
      balance: base.balance,
      max_lines: base.max_lines,
      tabular: base.tabular,
      diagonal_fractions: base.diagonal_fractions,
    }
    let _ = i.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::Is("✈"), look=look).ink(view::Live::By(ink))
    })
  })
}

pub fn liquid_card_node(
  parent : view::View,
  w : Double,
  h : Double,
  label : () -> String,
  content~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  radius~ : Double = tile_size / 2.0,
  angle~ : Double = 45.0,
  floating~ : Bool = false,
  press? : () -> Unit,
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let ih = match light {
    Some(l) => l
    None => InteractiveHighlight::new()
  }
  let look = fn(c : view::View) -> Unit {
    ih.attach(c)
    let _ = c
    .width(view::Live::Is(Some(w)))
    .height(view::Live::Is(Some(h)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(radius))
    if floating {
      let _ = c.glass(view::Live::By(fn() {
        let _ = angle
        Some(lg_capsule_glass(surface=tile_container, bezel=18.0, refraction=24.0))
      }))
    } else {
      let _ = c
      .ground(view::Live::By(fn() { surface().card }))
      .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
    }
    let _ = c.box(fn(ov : view::View) -> Unit {
      let _ = ov
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .radius(view::Live::Is(radius))
      .ground(view::Live::Is(white))
      .alpha(view::Live::By(fn() { clamp(ih.pressed(ov), 0.0, 1.0) * 0.14 }))
    })
    content(c)
  }
  match press {
    Some(f) =>
    headless::button(loc=loc, parent, label, fn(_e) -> Unit { f() }, fn(c : view::View, btn : headless::Button) -> Unit {
      look(c)
      let _ = c.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit { ih.down(d.x, d.y, w, h) },
        tap=fn(_d : view::Drag) -> Unit {
          ih.up()
          btn.press()
        },
        drag=fn(d : view::Drag) -> Unit {
          match d.kind {
            Down => ih.moved(d.x, d.y)
            Moved => ih.moved(d.x, d.y)
            Up => {
              ih.up()
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => ih.up()
          }
        },
      )
    })
    None =>
    parent.box(loc=loc, fn(c : view::View) -> Unit {
      look(c)
      let _ = c.says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
    })
  }
}

pub fn liquid_control_tile_node(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  angle~ : Double = 45.0,
  icon? : (view::View, () -> Int64) -> Unit,
  loc~ : String = "",
) -> view::View {
  liquid_card_node(loc=loc, parent, tile_size, tile_size, label, angle=angle, floating=true, press=press, content=fn(c : view::View) -> Unit {
    let _ = c.lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    match icon {
      Some(draw) => draw(c, fn() { white })
      None => flight_icon(c, tile_size * 0.8, fn() { white })
    }
  })
}

pub fn liquid_control_item_node(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
  icon? : (view::View, () -> Int64) -> Unit,
  loc~ : String = "",
) -> view::View {
  headless::toggle(loc=loc, parent, headless::ToggleKind::Switch, label, on, turn, fn(c : view::View, sw : headless::Toggle) -> Unit {
    let _ = c
    .width(view::Live::Is(Some(tile_inner)))
    .height(view::Live::Is(Some(tile_inner)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(tile_inner / 2.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .ground(view::Live::By(fn() { if sw.on() { colors().accent } else { tile_inactive } }))
    match icon {
      Some(draw) => draw(c, fn() { white })
      None => flight_icon(c, tile_inner * 0.8, fn() { white })
    }
    lg_focus_ring(c, fn() { sw.focus_shown() }, tile_inner / 2.0, color=fn() { white })
  })
}
