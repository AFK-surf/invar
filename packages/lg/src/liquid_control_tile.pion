// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/ControlCenterContent.kt. The control
// center's glass: tiles 68 across (two of them and the 16 between for a wide or tall one), their corners half of that,
// what is under them made vivid and bent by a lens 24 deep moving it by up to 48 with depth, no shadow, their highlight
// Default along `angle` (the catalog's gravity's; 45 the top left's) falling off by 2, black at 5% over them; what a
// tile holds, capsules 56 across, white at 20% or the accent when on, the airplane's icon in white at 80%. A finger on a
// tile lights it where it is (InteractiveHighlight), as a LiquidButton's.

import "headless"
import "paint"
import "ui"
import "view"

/// A tile's glass (iOS 27 regular liquid glass), lit by a finger at `spot` while `light > 0.01`.
fn tile_glass(angle : Double, light : Double, spot : Option[(Double, Double)]) -> paint::Glass {
  let _ = angle
  let d = is_dark()
  let sp = if light > 0.01 { spot } else { None }
  paint::Glass::liquid(
    blur=2.1,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=over(colors().dialog_container, tile_container),
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=34.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
    spot?=sp,
  )
}

/// The airplane's icon (FlightIcon) in `parent`, `size` across, in `ink`.
pub fn flight_icon(parent : view::View, size : Double, ink : () -> Int64, loc~ : String = "") -> Unit {
  let _ = parent.box(loc=loc, fn(i) {
    let _ = i
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
    let base = words_at(size * 0.6)
    let look = view::WordsLook::{
      size: base.size,
      weight: base.weight,
      line: size * 0.84,
      wrap: base.wrap,
      tracking: base.tracking,
      balance: base.balance,
      max_lines: base.max_lines,
    }
    let _ = i.box(fn(w) { let _ = w.words(view::Live::Is("✈"), look=look).ink(view::Live::By(ink)) })
  })
}

/// A card of the control center's glass in `parent`, `w` × `h`, its corners `radius` (by default half its shorter
/// side's of a tile: 34), its highlight along `angle`; what it holds `content`'s. Read out a button named `label` and
/// lit by a finger where `press` is given (pressed, `press` is called); else read out a group named `label`. The node.
pub fn liquid_card_node(
  parent : view::View,
  w : Double,
  h : Double,
  label : () -> String,
  content~ : (view::View) -> Unit = fn(_v) { () },
  radius~ : Double = tile_size / 2.0,
  angle~ : Double = 45.0,
  press? : () -> Unit,
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let ih = match light {
    Some(l) => l
    None => InteractiveHighlight::new()
  }
  let look = fn(c : view::View) -> Unit {
    ih.attach(c)
    let _ = c
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(radius))
      .glass(view::Live::By(fn() {
        let p = ih.pressed(c)
        Some(tile_glass(angle, p, if p > 0.0 { Some(ih.spot(c, w, h)) } else { None }))
      }))
    content(c)
  }
  match press {
    Some(f) => {
      headless::button(parent, label, fn(_v) { f() }, fn(c, btn) {
        look(c)
        let _ = c.gesture(
          ui::touch_slop(),
          press=fn(d) { ih.down(d.x, d.y, w, h) },
          tap=fn(_d) {
            ih.up()
            btn.press()
          },
          drag=fn(d) {
            match d.kind {
              view::DragIs::Down => ih.moved(d.x, d.y)
              view::DragIs::Moved => ih.moved(d.x, d.y)
              view::DragIs::Up => {
                ih.up()
                if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                  btn.press()
                }
              }
              view::DragIs::Off => ih.up()
            }
          },
        )
      }, made_for=loc)
    }
    None => {
      parent.box(loc=loc, fn(c) {
        look(c)
        let _ = c.says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
      })
    }
  }
}

/// A control center tile in `parent`: a card 68 across holding the airplane's icon in white, 0.8 of it; pressed,
/// `press` is called. Read out a button named `label`. The node.
pub fn liquid_control_tile_node(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  angle~ : Double = 45.0,
  loc~ : String = "",
) -> view::View {
  liquid_card_node(parent, tile_size, tile_size, label, angle=angle, press=press, content=fn(c) {
    let _ = c.lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    flight_icon(c, tile_size * 0.8, fn() { white })
  }, loc=loc)
}

/// What a control center's tile holds that turns something on: a capsule 56 across, white at 20% or the accent while
/// `on`, the airplane's icon in white at 0.8 of it; pressed, `turn` is told what it turns to. Read out a switch named
/// `label`. The node.
pub fn liquid_control_item_node(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
  loc~ : String = "",
) -> view::View {
  headless::toggle(parent, headless::ToggleKind::Switch, label, on, turn, fn(c, sw) {
    let _ = c
      .width(view::Live::Is(Some(tile_inner)))
      .height(view::Live::Is(Some(tile_inner)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(tile_inner / 2.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(fn() { if sw.on() { colors().accent } else { tile_inactive } }))
    flight_icon(c, tile_inner * 0.8, fn() { white })
    c.show(fn() { sw.focus_shown() }, fn(ring) {
      let _ = ring
        .over(view::Live::Is(true))
        .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
        .radius(view::Live::Is(tile_inner / 2.0 + 3.0))
        .edge(view::Live::By(fn() { (2.0, white) }))
    })
  }, made_for=loc)
}
