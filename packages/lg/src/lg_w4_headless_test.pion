// Wave 4 Stage 2 (Track W4-I2) regression tests for `packages/lg` components migrated to
// `headless` / `headless_core`:
// - `liquid_color_picker_node`: Hue/Alpha `headless::slider` keyboard + SV canvas keyboard + Opacity `headless::NumberInput`
// - `lg_edit_bar`: `Role::Toolbar` + Roving Focus + `lg_edit_bar_placement` via `headless_core::anchor_place`
// - `liquid_toolbar_node` / `liquid_toolbar_with_node`: `Role::Toolbar` + Roving Focus
// - `liquid_drawer_node` & `liquid_sheet_node`: `headless::drawer` rubber-band overpull, reverse-flick guard, threshold dismiss, Escape/outside
// - `liquid_tooltip_node`: shared `headless::window_tooltip_group` warmup instant-open

import "headless"
import "signals"
import "ui"
import "view"

test "w4_i2_color_picker_keyboard_sliders_sv_and_opacity_number_input" {
  ui::set_glass_solid(None)
  // Start at H=120°, S=0.5, V=0.5, A=0.5
  let color = signals::signal(hsva_to_rgba(120.0, 0.5, 0.5, 0.5))
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_color_picker_node(
        page,
        fn() { color.get() },
        fn(next_c : Int64) -> Unit { color.set(next_c) },
      )
    },
    w=420.0,
    h=360.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)

  let sv = require_drawn(t, "Color Saturation Brightness", view::Role::Slider)
  let hue = require_drawn(t, "Hue", view::Role::Slider)
  let alpha_bar = require_drawn(t, "Alpha", view::Role::Slider)
  let op_inp = require_drawn(t, "Opacity", view::Role::TextField)

  // 1. Hue slider keyboard focus + Right (+1), PageUp (+10), End (360 -> 0), Home (0)
  t.tap(hue.x + hue.w * (120.0 / 360.0), hue.y + hue.h * 0.5)
  t.run_shown(a_frame)
  let (h0, _, _, _) = rgba_to_hsva(color.get())
  t.key(ui::key_code_right)
  t.run_shown(a_frame)
  let (h1, _, _, _) = rgba_to_hsva(color.get())
  debug_assert(h1 > h0 && (h1 - h0).abs() <= 4.0, "Hue Right key must increment hue, got \{h0} -> \{h1}")
  t.key(ui::key_code_page_up)
  t.run_shown(a_frame)
  let (h2, _, _, _) = rgba_to_hsva(color.get())
  debug_assert(h2 > h1 + 5.0, "Hue PageUp must step hue by +10, got \{h1} -> \{h2}")
  t.key(ui::key_code_home)
  t.run_shown(a_frame)
  let (h_home, _, _, _) = rgba_to_hsva(color.get())
  debug_assert(h_home < 2.0, "Hue Home must jump to 0 deg, got \{h_home}")

  // 2. Alpha slider keyboard focus + Left (-1%), PageUp (+10%), End (100%)
  t.tap(alpha_bar.x + alpha_bar.w * 0.5, alpha_bar.y + alpha_bar.h * 0.5)
  t.run_shown(a_frame)
  let (_, _, _, a0) = rgba_to_hsva(color.get())
  t.key(ui::key_code_page_up)
  t.run_shown(a_frame)
  let (_, _, _, a1) = rgba_to_hsva(color.get())
  debug_assert(a1 > a0 + 0.06, "Alpha slider PageUp must increase alpha by ~10%, got \{a0} -> \{a1}")
  t.key(ui::key_code_end)
  t.run_shown(a_frame)
  let (_, _, _, a_end) = rgba_to_hsva(color.get())
  debug_assert(a_end > 0.99, "Alpha slider End must set alpha to 100%, got \{a_end}")

  // 3. SV canvas keyboard focus + Right/Up fine step (±0.02) and Shift+Left/Down coarse step (±0.1)
  t.tap(sv.x + sv.w * 0.5, sv.y + sv.h * 0.5)
  t.run_shown(a_frame)
  let (_, s0, v0, _) = rgba_to_hsva(color.get())
  t.key(ui::key_code_right)
  t.key(ui::key_code_up)
  t.run_shown(a_frame)
  let (_, s1, v1, _) = rgba_to_hsva(color.get())
  debug_assert(s1 > s0 && v1 > v0, "SV canvas Right/Up must increase S and V")
  t.key(ui::key_code_left, mods=ui::mod_shift_key)
  t.key(ui::key_code_down, mods=ui::mod_shift_key)
  t.run_shown(a_frame)
  let (_, s2, v2, _) = rgba_to_hsva(color.get())
  debug_assert(s2 < s1 - 0.06 && v2 < v1 - 0.06, "SV canvas Shift+Left/Down must coarse-step S and V by ~0.1")

  // Verify SV a11y node exists with Slider role
  let sv_said = t.get("Color Saturation Brightness", role=view::Role::Slider)
  debug_assert(sv_said.is_some(), "SV canvas a11y node must exist")

  // 4. Opacity NumberInput Up/Down/PageDown/Home/End keyboard stepping
  t.tap(op_inp.x + op_inp.w * 0.5, op_inp.y + op_inp.h * 0.5)
  t.run_shown(a_frame)
  // Currently at 100%; press Down -> 99%, PageDown -> 89%
  t.key(ui::key_code_down)
  t.run_shown(a_frame)
  let (_, _, _, op_down) = rgba_to_hsva(color.get())
  debug_assert((op_down - 0.99).abs() < 0.02, "Opacity Down must decrement from 100% to 99%, got \{op_down}")
  t.key(ui::key_code_page_down)
  t.run_shown(a_frame)
  let (_, _, _, op_pgdn) = rgba_to_hsva(color.get())
  debug_assert((op_pgdn - 0.89).abs() < 0.02, "Opacity PageDown must decrement by 10% to 89%, got \{op_pgdn}")
  t.key(ui::key_code_up)
  t.run_shown(a_frame)
  let (_, _, _, op_up) = rgba_to_hsva(color.get())
  debug_assert((op_up - 0.90).abs() < 0.02, "Opacity Up must increment to 90%, got \{op_up}")

  assert_no_nested_glass(t, label="w4_i2_color_picker")
  assert_clean_tester(t, "w4_i2_color_picker")
  t.dispose()
}

test "w4_i2_edit_bar_toolbar_roving_focus_and_anchor_placement" {
  ui::set_glass_solid(None)
  let fired = ui::ref_new("")
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = lg_edit_bar(
        page,
        [
          edit_bar_item("Cut", fn() { fired.v = "cut" }),
          edit_bar_item("Copy", fn() { fired.v = "copy" }),
          edit_bar_item("Paste", fn() { fired.v = "paste" }),
        ],
      )
    },
    w=480.0,
    h=200.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)

  let _ = require_drawn(t, "Edit bar", view::Role::Toolbar)
  // Tab into toolbar -> focuses first roving stop ("Cut")
  t.key(ui::key_tab)
  t.run_shown(a_frame)
  // Right -> "Copy", Right -> "Paste", Enter -> fires "paste"
  t.key(ui::key_code_right)
  t.key(ui::key_code_right)
  t.enter()
  t.run_shown(a_frame)
  debug_assert(fired.v == "paste", "Roving focus Right+Right+Enter must activate Paste, got \{fired.v}")
  // Home -> "Cut", Enter -> fires "cut"
  t.key(ui::key_code_home)
  t.enter()
  t.run_shown(a_frame)
  debug_assert(fired.v == "cut", "Roving focus Home+Enter must activate Cut, got \{fired.v}")
  assert_no_nested_glass(t, label="w4_i2_edit_bar")
  assert_clean_tester(t, "w4_i2_edit_bar")
  t.dispose()

  // Placement right-edge clamping + flip regression
  let (xr, yr, flipr) = lg_edit_bar_placement(480.0, 120.0, 30.0, 20.0, 200.0, 38.0, 520.0, 340.0)
  debug_assert(!flipr, "right-edge anchor with top room stays above")
  debug_assert((xr - 310.0).abs() < 0.01 && (yr - 72.0).abs() < 0.01, "clamps right edge to viewport_w - margin - bar_w")
}

test "w4_i2_liquid_toolbar_roving_focus" {
  ui::set_glass_solid(None)
  let chosen = ui::ref_new("")
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_toolbar_with_node(page, fn(bar : view::View, tb : headless::Toolbar) -> Unit {
        let _ = tb.item(bar, fn() { "Bold" }, fn(_n) { chosen.v = "bold" }, fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b.height(view::Live::Is(Some(30.0))).padding(view::Live::Is((10.0, 0.0, 10.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
          lg_focus_ring(b, fn() { btn.focus_shown() }, 15.0)
          let _ = b.box(fn(w) { let _ = w.words(view::Live::Is("Bold"), look=words_at(13.0)).ink(view::Live::By(fn() { colors().content })) })
        })
        let _ = tb.item(bar, fn() { "Italic" }, fn(_n) { chosen.v = "italic" }, fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b.height(view::Live::Is(Some(30.0))).padding(view::Live::Is((10.0, 0.0, 10.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
          lg_focus_ring(b, fn() { btn.focus_shown() }, 15.0)
          let _ = b.box(fn(w) { let _ = w.words(view::Live::Is("Italic"), look=words_at(13.0)).ink(view::Live::By(fn() { colors().content })) })
        })
        let _ = tb.item(bar, fn() { "Underline" }, fn(_n) { chosen.v = "underline" }, fn(b : view::View, btn : headless::Button) -> Unit {
          let _ = b.height(view::Live::Is(Some(30.0))).padding(view::Live::Is((10.0, 0.0, 10.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
          lg_focus_ring(b, fn() { btn.focus_shown() }, 15.0)
          let _ = b.box(fn(w) { let _ = w.words(view::Live::Is("Underline"), look=words_at(13.0)).ink(view::Live::By(fn() { colors().content })) })
        })
      })
    },
    w=480.0,
    h=200.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)
  let _ = require_drawn(t, "Toolbar", view::Role::Toolbar)
  t.key(ui::key_tab)
  t.run_shown(a_frame)
  t.key(ui::key_code_right)
  t.enter()
  t.run_shown(a_frame)
  debug_assert(chosen.v == "italic", "Toolbar roving focus Right+Enter must activate Italic, got \{chosen.v}")
  t.key(ui::key_code_end)
  t.enter()
  t.run_shown(a_frame)
  debug_assert(chosen.v == "underline", "Toolbar roving focus End+Enter must activate Underline, got \{chosen.v}")
  assert_no_nested_glass(t, label="w4_i2_liquid_toolbar")
  assert_clean_tester(t, "w4_i2_liquid_toolbar")
  t.dispose()
}

test "w4_i2_drawer_overpull_reverse_flick_escape_and_outside" {
  ui::set_glass_solid(None)
  let open = signals::signal(true)
  let t = ovl_host_case(
    fn(_page : view::View, host : view::View) -> Unit {
      let _ = liquid_drawer_node(
        host,
        fn() { open.get() },
        fn() -> Unit { open.set(false) },
        fn() { "Nav Drawer" },
        fn(b : view::View) -> Unit {
          let _ = b.box(fn(w) { let _ = w.words(view::Live::Is("Drawer Body"), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content })) })
        },
        side=DrawerSide::Leading,
        width=300.0,
      )
    },
    w=800.0,
    h=600.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)
  let r0 = require_drawn(t, "Nav Drawer", view::Role::Dialog)
  let cx = r0.x + r0.w * 0.5
  let cy = r0.y + r0.h * 0.5

  // 1. Reverse-flick guard: drag past 32% left (-130pt), then flick strongly right (+80pt in 16ms) -> stays open!
  t.press_at(cx, cy)
  t.frame(ms=a_frame)
  t.move_to(cx - 130.0, cy)
  t.frame(ms=100.0)
  t.fake.now_ms = t.fake.now_ms + 16.0
  t.move_to(cx - 50.0, cy)
  t.release(cx - 50.0, cy)
  t.run_shown(springs_out)
  debug_assert(open.get(), "reverse flick toward open must prevent drawer dismissal")

  // 2. Escape closes drawer
  t.key(ui::key_escape)
  t.run_shown(springs_out)
  debug_assert(!open.get(), "Escape must close drawer")

  // 3. Re-open and outside tap closes drawer
  open.set(true)
  t.run_shown(springs_out)
  debug_assert(open.get(), "drawer reopened")
  t.tap(750.0, 300.0)
  t.run_shown(springs_out)
  debug_assert(!open.get(), "outside click must close drawer")
  t.dispose()
}

test "w4_i2_sheet_overpull_reverse_flick_and_outside" {
  ui::set_glass_solid(None)
  let open = signals::signal(true)
  let t = ovl_host_case(
    fn(_page : view::View, host : view::View) -> Unit {
      let _ = liquid_sheet_node(
        host,
        fn() { open.get() },
        fn() -> Unit { open.set(false) },
        fn() { "Filter Sheet" },
        fn(b : view::View) -> Unit {
          let _ = b.box(fn(w) { let _ = w.words(view::Live::Is("Sheet Body"), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content })) })
        },
      )
    },
    w=800.0,
    h=600.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)
  let r0 = require_drawn(t, "Filter Sheet", view::Role::Dialog)
  let hx = r0.x + r0.w * 0.5
  let hy = r0.y + 36.0

  // 1. Upward overpull is rubber-band damped and keeps sheet open
  t.drag(hx, hy, hx, hy - 120.0, steps=4)
  t.run_shown(springs_out)
  debug_assert(open.get(), "upward overpull must keep sheet open")

  // 2. Reverse-flick guard: drag down past dismiss threshold (+120pt) then flick sharply upward -> stays open!
  t.press_at(hx, hy)
  t.frame(ms=a_frame)
  t.move_to(hx, hy + 120.0)
  t.frame(ms=100.0)
  t.fake.now_ms = t.fake.now_ms + 16.0
  t.move_to(hx, hy + 40.0)
  t.release(hx, hy + 40.0)
  t.run_shown(springs_out)
  debug_assert(open.get(), "reverse flick upward must prevent sheet dismissal")

  // 3. Outside tap closes sheet
  t.tap(400.0, 20.0)
  t.run_shown(springs_out)
  debug_assert(!open.get(), "outside click must close sheet")
  t.dispose()
}

test "w4_i2_tooltip_shared_window_group_warmup_instant_open" {
  ui::set_glass_solid(None)
  let t = ovl_host_case(
    fn(page : view::View, host : view::View) -> Unit {
      let _ = page.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(140.0))
        let _ = liquid_tooltip_node(
          row,
          host,
          fn() { "First Tip" },
          fn(wrap : view::View) -> Unit {
            let _ = liquid_button_node(wrap, fn() { "One" }, fn() -> Unit { () })
          },
        )
        let _ = liquid_tooltip_node(
          row,
          host,
          fn() { "Second Tip" },
          fn(wrap : view::View) -> Unit {
            let _ = liquid_button_node(wrap, fn() { "Two" }, fn() -> Unit { () })
          },
        )
      })
    },
    w=600.0,
    h=320.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)

  let b1 = require_drawn(t, "One", view::Role::Button)
  let b2 = require_drawn(t, "Two", view::Role::Button)

  // Hover first trigger -> wait default delay (400ms) -> opens "First Tip"
  t.move_to(b1.x + b1.w * 0.5, b1.y + b1.h * 0.5)
  t.run_shown(450.0)
  let _ = require_drawn(t, "First Tip", view::Role::Tooltip)

  // Move to second trigger within warmup window -> opens "Second Tip" immediately (< 100ms, well below 400ms delay)!
  t.move_to(b2.x + b2.w * 0.5, b2.y + b2.h * 0.5)
  t.run_shown(80.0)
  let _ = require_drawn(t, "Second Tip", view::Role::Tooltip)
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="w4_i2_tooltip_warmup")
  assert_clean_tester(t, "w4_i2_tooltip_warmup")
  t.dispose()
}
