// Floating liquid glass text field and search bar built over headless::TextField + ui::field.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

fn ctrl_clear_button(
  parent : view::View,
  field : ui::Field,
  on_clear : Option[() -> Unit],
  loc~ : String = "",
) -> Unit {
  let _ = headless::button(
    loc=loc,
    parent,
    fn() { "Clear" },
    fn(_e) -> Unit {
      field.set("")
      match on_clear {
        Some(f) => f()
        None => ()
      }
      field.focus()
    },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_way = motion::NodeWay::new(0.0)
      let press_way = motion::NodeWay::new(0.0)
      b.reacts(at_start=false, fn() { btn.hovered() || btn.pressed() }, fn(on : Bool) -> Unit {
        hover_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
      })
      b.reacts(at_start=false, fn() { btn.pressed() }, fn(on : Bool) -> Unit {
        press_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
      })
      let _ = b
      .width(view::Live::Is(Some(ctrl_clear_size)))
      .height(view::Live::Is(Some(ctrl_clear_size)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(ctrl_clear_size / 2.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(ctrl_clear_bg))
      .scale(view::Live::By(fn() { 1.0 - 0.12 * clamp(press_way.shown(b), 0.0, 1.0) }))
      let _ = b.box(fn(hov : view::View) -> Unit {
        let _ = hov
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(ctrl_clear_size / 2.0))
        .ground(view::Live::By(ctrl_hover_ink))
        .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_hover_alpha }))
      })
      let _ = b.box(fn(ic : view::View) -> Unit {
        let _ = ic
        .width(view::Live::Is(Some(ctrl_clear_icon_size)))
        .height(view::Live::Is(Some(ctrl_clear_icon_size)))
        .shrink(view::Live::Is(0.0))
        .shapes(view::Live::By(fn() { ctrl_close_shapes(ctrl_clear_icon_size, ctrl_clear_ink()) }))
      })
      b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
        let _ = ring
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(ctrl_clear_size / 2.0))
        .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
      })
    },
  )
}

pub fn liquid_text_field_node(
  parent : view::View,
  field : ui::Field,
  placeholder~ : String = "",
  placeholder_by? : () -> String,
  height_by? : () -> Double,
  label~ : () -> String = fn() { "" },
  description~ : () -> String = fn() { "" },
  error~ : () -> String = fn() { "" },
  invalid~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  read_only~ : () -> Bool = fn() { false },
  secret~ : Bool = false,
  lead? : (view::View, () -> Int64) -> Unit,
  clearable~ : Bool = false,
  on_clear? : () -> Unit,
  submitted? : (String) -> Unit,
  edited? : (String) -> Unit,
  loc~ : String = "",
) -> view::View {
  let tf = headless::TextField::new(label, description=description, error=error, invalid=invalid, disabled=disabled, read_only=read_only)
  let prev_text = ui::ref_new(signals::untracked(fn() { field.text() }))
  parent.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col.gap(view::Live::Is(ctrl_field_gap))
    col.reacts(at_start=false, fn() { field.text() }, fn(s : String) -> Unit {
      if !signals::untracked(read_only) {
        prev_text.v = s
      }
    })
    col.reacts(at_start=false, read_only, fn(is_ro : Bool) -> Unit {
      if is_ro {
        prev_text.v = signals::untracked(fn() { field.text() })
      }
    })
    col.show(
      fn() { tf.label_text() != "" },
      fn(lbl_slot : view::View) -> Unit {
        let _ = tf.label(loc=loc, lbl_slot, fn(l : view::View) -> Unit {
          let _ = l
          .words(view::Live::By(fn() { tf.label_text() }), look=words_at(ctrl_type_label, weight=weight_medium))
          .ink(view::Live::By(fn() { colors().content }))
        })
      },
      at_once=true,
    )
    let _ = col.box(fn(cap : view::View) -> Unit {
      let _ = cap
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(match height_by {
        Some(f) => view::Live::By(fn() { Some(f()) })
        None => view::Live::Is(Some(ctrl_input_h))
      })
      .padding(view::Live::By(fn() {
        let has_clear = clearable && !tf.disabled() && !tf.read_only() && field.text() != ""
        let pr = if has_clear { 7.0 } else { ctrl_input_px }
        (ctrl_input_px, 0.0, pr, 0.0)
      }))
      .gap(view::Live::Is(ctrl_input_gap))
      .radius(match height_by {
        Some(f) => view::Live::By(fn() { f() / 2.0 })
        None => view::Live::Is(ctrl_input_r)
      })
      .edge(view::Live::By(fn() { if cap.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) } }))
      .alpha(view::Live::By(fn() { if tf.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
      lg_apply_glass_surface(cap, fn() { lg_capsule_glass() })
      lg_focus_ring(
        cap,
        fn() { tf.invalid() || tf.focused() },
        ctrl_input_r,
        color=fn() { if tf.invalid() { ctrl_danger_ink() } else { colors().accent } },
      )
      match lead {
        Some(draw_lead) => {
          let _ = cap.box(fn(l : view::View) -> Unit {
            let _ = l.shrink(view::Live::Is(0.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
            draw_lead(l, ctrl_muted_ink)
          })
        }
        None => ()
      }
      let on_edited = fn(s : String) -> Unit {
        if signals::untracked(read_only) {
          if s != prev_text.v {
            field.set(prev_text.v)
          }
          return
        }
        prev_text.v = s
        match edited {
          Some(f) => f(s)
          None => ()
        }
      }
      let typed = ui::field(
        cap,
        field,
        placeholder=placeholder,
        placeholder_by?=placeholder_by,
        font_size=ctrl_type_body,
        max_lines=1,
        enter_sends=true,
        secret=secret,
        label=signals::untracked(label),
        submitted=fn(s : String) -> Unit { match submitted { Some(f) => f(s); None => () } },
        edited=on_edited,
        color=colors().content,
        placeholder_color=ctrl_placeholder_ink(),
        caret_color=colors().accent,
      )
      let _ = typed
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .shrink(view::Live::Is(1.0))
      .presses(view::Live::By(fn() { !tf.disabled() }))
      .focusable(view::Live::By(fn() { !tf.disabled() }), keys=0)
      tf.control_node(typed)
      cap.show(
        fn() { clearable && !tf.disabled() && !tf.read_only() && field.text() != "" },
        fn(cl : view::View) -> Unit { ctrl_clear_button(loc=loc, cl, field, on_clear) },
        at_once=true,
      )
    })
    col.show(
      fn() { tf.error_text() != "" },
      fn(err_slot : view::View) -> Unit {
        let _ = tf.error(loc=loc, err_slot, fn(e : view::View) -> Unit {
          let _ = e
          .words(view::Live::By(fn() { tf.error_text() }), look=words_at(ctrl_type_caption, wrap=true))
          .ink(view::Live::By(ctrl_danger_ink))
        })
      },
      at_once=true,
    )
    col.show(
      fn() { tf.error_text() == "" && tf.description_text() != "" },
      fn(desc_slot : view::View) -> Unit {
        let _ = tf.description(loc=loc, desc_slot, fn(d : view::View) -> Unit {
          let _ = d
          .words(view::Live::By(fn() { tf.description_text() }), look=words_at(ctrl_type_caption, wrap=true))
          .ink(view::Live::By(ctrl_muted_ink))
        })
      },
      at_once=true,
    )
  })
}

pub fn liquid_search_bar_node(
  parent : view::View,
  field : ui::Field,
  placeholder~ : String = "Search",
  placeholder_by? : () -> String,
  height_by? : () -> Double,
  label~ : () -> String = fn() { "Search" },
  disabled~ : () -> Bool = fn() { false },
  submitted? : (String) -> Unit,
  edited? : (String) -> Unit,
  on_clear? : () -> Unit,
  on_escape? : () -> Unit,
  leading? : (view::View, () -> Int64) -> Unit,
  trailing? : (view::View) -> Unit,
  flat~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let tf = headless::TextField::new(label, disabled=disabled)
  parent.box(loc=loc, fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(ctrl_search_trailing_gap))
    let _ = row.box(fn(cap : view::View) -> Unit {
      match on_escape {
        Some(esc) => {
          let _ = cap.on_key(fn(k : view::Key) -> Bool {
            if k.code == ui::key_escape && k.mods == 0 && field.focused() {
              esc()
              true
            } else {
              false
            }
          })
        }
        None => ()
      }
      let _ = cap
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(match height_by {
        Some(f) => view::Live::By(fn() { Some(f()) })
        None => view::Live::Is(Some(ctrl_input_h))
      })
      .padding(view::Live::By(fn() {
        let has_clear = !tf.disabled() && field.text() != ""
        let pr = if has_clear { 7.0 } else { ctrl_input_px }
        (ctrl_input_px, 0.0, pr, 0.0)
      }))
      .gap(view::Live::Is(ctrl_input_gap))
      .radius(match height_by {
        Some(f) => view::Live::By(fn() { f() / 2.0 })
        None => view::Live::Is(ctrl_input_r)
      })
      .alpha(view::Live::By(fn() { if tf.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
      if flat {
        let focus_way = motion::NodeWay::new(if signals::untracked(fn() { tf.focused() }) { 1.0 } else { 0.0 })
        cap.reacts(at_start=false, fn() { tf.focused() }, fn(on : Bool) -> Unit {
          focus_way.go(cap, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
        })
        let _ = cap
        .ground(view::Live::By(fn() { if is_dark() { 0xFFFFFF18L } else { 0x0000000DL } }))
        .edge(view::Live::By(fn() {
          let t = clamp(focus_way.shown(cap), 0.0, 1.0)
          (
            lerp(ctrl_hairline_w, ctrl_input_focus_edge_w, t),
            lerp_color(ctrl_input_edge_ink(), colors().accent, t),
          )
        }))
      } else {
        let _ = cap.edge(view::Live::By(fn() { if cap.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) } }))
        lg_apply_glass_surface(cap, fn() { lg_capsule_glass() })
        lg_focus_ring(cap, fn() { tf.focused() }, ctrl_input_r)
      }
      match leading {
        Some(draw_lead) => {
          let _ = cap.box(fn(l : view::View) -> Unit {
            let _ = l.shrink(view::Live::Is(0.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
            draw_lead(l, ctrl_muted_ink)
          })
        }
        None => {
          let _ = cap.box(fn(ic : view::View) -> Unit {
            let _ = ic
            .width(view::Live::Is(Some(ctrl_search_icon_size)))
            .height(view::Live::Is(Some(ctrl_search_icon_size)))
            .shrink(view::Live::Is(0.0))
            .shapes(view::Live::By(fn() { ctrl_search_shapes(ctrl_search_icon_size, ctrl_muted_ink()) }))
          })
        }
      }
      let typed = ui::field(
        cap,
        field,
        placeholder=placeholder,
        placeholder_by?=placeholder_by,
        font_size=ctrl_type_body,
        max_lines=1,
        enter_sends=true,
        label=signals::untracked(label),
        submitted=fn(s : String) -> Unit { match submitted { Some(f) => f(s); None => () } },
        edited=fn(s : String) -> Unit { match edited { Some(f) => f(s); None => () } },
        color=colors().content,
        placeholder_color=ctrl_placeholder_ink(),
        caret_color=colors().accent,
      )
      let _ = typed
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .shrink(view::Live::Is(1.0))
      .presses(view::Live::By(fn() { !tf.disabled() }))
      .focusable(view::Live::By(fn() { !tf.disabled() }), keys=0)
      tf.control_node(typed)
      cap.show(
        fn() { !tf.disabled() && field.text() != "" },
        fn(cl : view::View) -> Unit { ctrl_clear_button(loc=loc, cl, field, on_clear) },
        at_once=true,
      )
    })
    match trailing {
      Some(draw_trail) => {
        let _ = row.box(fn(tr : view::View) -> Unit {
          let _ = tr.shrink(view::Live::Is(0.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
          draw_trail(tr)
        })
      }
      None => ()
    }
  })
}
