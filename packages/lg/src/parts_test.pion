// Unit tests for packages/lg: button, interactive highlight, toggle, slider, bottom tabs, dialog, damped drag,
// and glass rendering stability. Ported from libs/liquid-glass/src/lg/parts_wbtest.mbt.

import "signals"
import "ui"
import "view"

let springs_out : Double = 1000.0
let a_frame : Double = ui::input_step_ms

fn lg_case(make : (view::View) -> Unit, dark~ : Bool = false, w~ : Double = 800.0, h~ : Double = 600.0) -> ui::Tester {
  set_dark(Some(dark))
  ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(page) {
        let _ = page
        .grow(view::Live::Is(1.0))
        .padding(view::Live::Is((40.0, 40.0, 40.0, 40.0)))
        .gap(view::Live::Is(24.0))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        .ground(view::Live::By(fn() { if is_dark() { 0x202024FFL } else { 0x8899AAFFL } }))
        make(page)
      })
    },
    width=w,
    height=h,
    theme=ui_theme,
    platform=0,
    dark=dark,
  )
}

fn require_drawn(t : ui::Tester, name : String, role : view::Role) -> view::Drawn {
  match t.get(name, role=role) {
    Some(d) => d
    None => {
      debug_assert(false, "expected drawn node \{name}")
      t.drawn()[0]
    }
  }
}

test "lg_liquid_button_press_and_drag_cancel" {
  let pressed = ui::ref_new(0)
  let t = lg_case(fn(p) {
    let _ = liquid_button_node(p, fn() { "Send" }, fn() { pressed.v = pressed.v + 1 })
  })
  let d = require_drawn(t, "Send", view::Role::Button)
  let x = d.x + d.w / 2.0
  let y = d.y + d.h / 2.0
  t.tap(x, y)
  t.key(ui::key_tab)
  t.enter()
  let after_keys = pressed.v
  t.drag(x, y, x + 400.0, y + 200.0)
  t.run_shown(springs_out)
  debug_assert(after_keys == 2, "tap + Tab/Enter must press button twice")
  debug_assert(pressed.v == 2, "drag released outside button must not press")
  debug_assert((d.h - button_h).abs() < 0.01, "button height must equal button_h")
  t.dispose()
}

test "lg_liquid_button_interactive_highlight" {
  let light = InteractiveHighlight::new()
  let t = lg_case(fn(p) {
    let _ = liquid_button_node(p, fn() { "Send" }, fn() { () }, light=light)
  })
  let d = require_drawn(t, "Send", view::Role::Button)
  t.press_at(d.x + 10.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  let node = match light.node.v {
    Some(n) => n
    None => { debug_assert(false, "light node must be attached"); t.dispose(); return }
  }
  let held_p = light.pressed(node) > 0.99
  let held_spot = light.spot(node, d.w, d.h).0 < 20.0
  t.move_to(d.x + 60.0, d.y + d.h / 2.0)
  t.frame(ms=a_frame)
  let (dx, _) = light.offset(node)
  let (tx, _, sx, sy) = light.stretch(node)
  t.release(d.x + 60.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(held_p && held_spot, "button light must rise and track finger spot")
  debug_assert(dx > 0.0 && tx > 0.0 && sx > sy, "horizontal drag must offset and stretch wider than tall")
  debug_assert(light.pressed(node) < 0.001, "light must settle after release")
  t.dispose()
}

test "lg_liquid_toggle_tap_key_and_drag" {
  let on = signals::signal(false)
  let t = lg_case(fn(p) {
    let _ = liquid_toggle_node(p, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Wi-Fi" })
  })
  let d = require_drawn(t, "Wi-Fi", view::Role::Switch)
  t.tap(d.x + 20.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  let tapped = on.get()
  t.key(ui::key_tab)
  t.key(ui::key_space)
  t.run_shown(springs_out)
  let spaced = on.get()
  t.drag(d.x + 16.0, d.y + d.h / 2.0, d.x + 16.0 + 12.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  let dragged_on = on.get()
  t.drag(d.x + 32.0, d.y + d.h / 2.0, d.x + 32.0 - 7.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(tapped, "tap must turn toggle on")
  debug_assert(!spaced, "space key must turn toggle off")
  debug_assert(dragged_on, "drag past half must turn toggle on")
  debug_assert(on.get(), "short reverse drag under half must keep toggle on")
  t.dispose()
}

test "lg_liquid_toggle_thumb_glass_while_held" {
  let on = signals::signal(false)
  let drag = DampedDrag::new(0.0, lo=0.0, hi=1.0, held_scale=thumb_held_scale)
  let t = lg_case(fn(p) {
    let _ = liquid_toggle_node(p, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Wi-Fi" }, drag=drag)
  })
  let node = match drag.node.v {
    Some(n) => n
    None => { debug_assert(false, "drag node must be attached"); t.dispose(); return }
  }
  let rest_p = drag.pressed(node)
  let rest_j = drag.jelly(node, 50.0)
  let d = require_drawn(t, "Wi-Fi", view::Role::Switch)
  t.press_at(d.x + 20.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  let held_p = drag.pressed(node) > 0.999
  let held_s = drag.jelly(node, 50.0).0 > 1.31
  t.release(d.x + 20.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(rest_p == 0.0 && rest_j.0 == 1.0 && rest_j.1 == 1.0, "thumb at rest must have zero press and 1x scale")
  debug_assert(held_p && held_s, "held thumb must reach full glass press and ~1.32x scale")
  debug_assert(drag.pressed(node) < 0.001 && drag.value(node) > 0.999, "released toggle must settle on")
  t.dispose()
}

test "lg_liquid_slider_keys_drag_and_track_tap" {
  let level = signals::signal(50.0)
  let t = lg_case(fn(p) {
    let _ = p.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(400.0)))
      let _ = liquid_slider_node(b, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Volume" })
    })
  })
  let d = require_drawn(t, "Volume", view::Role::Slider)
  t.key(ui::key_tab)
  t.key(ui::key_code_right)
  let keyed = level.get()
  t.key(ui::key_code_home)
  let home = level.get()
  t.run_shown(springs_out)
  t.drag(d.x + 5.0, d.y + d.h / 2.0, d.x + 105.0, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  let dragged = level.get().round()
  t.tap(d.x + d.w * 0.75, d.y + d.h / 2.0)
  t.run_shown(springs_out)
  debug_assert((keyed - 51.0).abs() < 0.01, "Right arrow must step slider to 51")
  debug_assert((home - 0.0).abs() < 0.01, "Home key must move slider to 0")
  debug_assert((dragged - 25.0).abs() < 1.5, "100px drag on 400px track must move to ~25")
  debug_assert((level.get().round() - 75.0).abs() < 1.5, "tap at 75% track must move to ~75")
  t.dispose()
}

test "lg_liquid_bottom_tabs_keys_and_lens_drag" {
  let chosen = signals::signal(0)
  let t = lg_case(fn(p) {
    let _ = p.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(408.0)))
      let _ = liquid_bottom_tabs_node(b, ["Home", "Search", "Me"], fn() { chosen.get() }, fn(i) { chosen.set(i) }, label="Tabs")
    })
  })
  let me = require_drawn(t, "Me", view::Role::Tab)
  t.tap(me.x + me.w / 2.0, me.y + me.h / 2.0)
  t.run_shown(springs_out)
  let tapped_me = chosen.get()
  t.key(ui::key_tab)
  t.key(ui::key_code_left)
  t.run_shown(springs_out)
  let keyed = chosen.get()
  let search = require_drawn(t, "Search", view::Role::Tab)
  t.drag(search.x + search.w / 2.0, search.y + search.h / 2.0, search.x + search.w / 2.0 - 200.0, search.y + search.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(tapped_me == 2, "tapping Me tab must select index 2")
  debug_assert(keyed == 1, "Left arrow must move selection to Search (1)")
  debug_assert(chosen.get() == 0, "dragging lens left over Home must select index 0")
  t.dispose()
}

test "lg_liquid_dialog_escape_cancel_and_action" {
  let open = signals::signal(true)
  let acted = ui::ref_new(0)
  let t = lg_case(fn(p) {
    let _ = liquid_dialog_node(
      p,
      fn() { open.get() },
      fn() { open.set(false) },
      fn() { "Delete?" },
      fn() { "It cannot be undone." },
      on_action=fn() {
        acted.v = acted.v + 1
        open.set(false)
      },
    )
  })
  debug_assert(t.get("Delete?", role=view::Role::Dialog).is_some(), "open dialog must be present")
  t.key(ui::key_escape)
  t.run_shown(springs_out)
  debug_assert(!open.get() && t.get("Delete?", role=view::Role::Dialog).is_none(), "Escape must close dialog")
  open.set(true)
  t.frame()
  t.run_shown(springs_out)
  t.press("Cancel")
  t.run_shown(springs_out)
  debug_assert(!open.get(), "Cancel must close dialog")
  open.set(true)
  t.frame()
  t.run_shown(springs_out)
  t.press("Okay")
  t.run_shown(springs_out)
  debug_assert(!open.get() && acted.v == 1, "Okay must invoke on_action and close dialog")
  t.dispose()
}

test "lg_damped_drag_springs_and_jelly" {
  let drag = DampedDrag::new(0.0, lo=0.0, hi=1.0, held_scale=1.5)
  let n : ui::Ref[Option[view::View]] = ui::ref_new(None)
  let t = lg_case(fn(p) {
    let _ = p.box(fn(b) { n.v = Some(b) })
  })
  let node = match n.v {
    Some(v) => v
    None => { debug_assert(false, "node must exist"); t.dispose(); return }
  }
  drag.attach(node)
  drag.press()
  drag.update_value(0.5)
  t.frame(ms=a_frame)
  drag.update_value(1.0)
  t.frame(ms=a_frame)
  let (sx, sy) = drag.jelly(node, 50.0)
  let going = drag.velocity(node) > 0.0 && sx > drag.scale_x.shown(node) && sy < drag.scale_y.shown(node)
  drag.release()
  t.run_shown(springs_out * 2.0)
  debug_assert(going, "fast rightward drag must stretch wider and flatter")
  debug_assert((drag.value(node) - 1.0).abs() < 0.001, "value must settle at 1.0")
  debug_assert(drag.pressed(node).abs() < 0.001, "press must settle at 0.0")
  debug_assert(drag.velocity(node).abs() < 0.001, "velocity must settle at 0.0")
  t.dispose()
}

test "lg_scroll_edge_glass_and_capsule_adaptive_default" {
  let edge = lg_scroll_edge_glass()
  debug_assert(!edge.liquid && edge.progressive, "lg_scroll_edge_glass must be progressive frosted")
  debug_assert((edge.blur - 8.0).abs() < 1.0e-6 && (edge.saturation - 1.25).abs() < 1.0e-6, "scroll edge blur=8 saturation=1.25")
  let cap_default = lg_capsule_glass()
  debug_assert(cap_default.liquid && !cap_default.adaptive, "lg_capsule_glass defaults to adaptive=false")
  let cap_on = lg_capsule_glass(adaptive=true)
  debug_assert(cap_on.liquid && cap_on.adaptive, "lg_capsule_glass(adaptive=true) enables adaptive")
}

test "lg_liquid_bottom_tabs_tap_no_press_and_drag_capped_lens" {
  let chosen = signals::signal(0)
  let drag = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=tab_lens_held_scale)
  let t = lg_case(fn(p) {
    let _ = p.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(408.0)))
      let _ = liquid_bottom_tabs_node(b, ["Home", "Search", "Me"], fn() { chosen.get() }, fn(i) { chosen.set(i) }, label="Tabs", drag=drag)
    })
  })
  let node = match drag.node.v {
    Some(n) => n
    None => { debug_assert(false, "drag node must be attached"); t.dispose(); return }
  }
  let me = require_drawn(t, "Me", view::Role::Tab)
  t.press_at(me.x + me.w / 2.0, me.y + me.h / 2.0)
  t.run_for(60.0)
  let tap_down_p = drag.pressed(node)
  t.release(me.x + me.w / 2.0, me.y + me.h / 2.0)
  t.run_for(60.0)
  let tap_after_p = drag.pressed(node)
  t.run_shown(springs_out)
  debug_assert(tap_down_p == 0.0 && tap_after_p == 0.0, "tapping bottom tab must not trigger lens press")
  debug_assert(chosen.get() == 2 && (drag.value(node) - 2.0).abs() < 0.01, "tapping Me must slide smoothly to index 2")
  // Horizontal drag across touch_slop must raise lens with width capped at tab_w + tab_lens_max_grow_x
  let start_x = me.x + me.w / 2.0
  let mid_y = me.y + me.h / 2.0
  t.press_at(start_x, mid_y)
  t.move_to(start_x - 20.0, mid_y)
  t.run_for(120.0)
  t.move_to(start_x - 100.0, mid_y)
  t.run_for(200.0)
  let drag_p = drag.pressed(node)
  let iw = (408.0 - 2.0 * tab_bar_edge) / 3.0
  let expected_lw = dmin(tabs_h * tab_bar_lens_lift_h * tab_bar_lens_aspect, iw * tab_bar_lens_aspect)
  let mut lens_w = 0.0
  let glasses = t.drawn_glass()
  let mut i = 0
  while i < glasses.length() {
    let g = glasses[i]
    if g.2 < 300.0 && g.2 > lens_w {
      lens_w = g.2
    }
    i += 1
  }
  t.release(start_x - 100.0, mid_y)
  t.run_shown(springs_out)
  debug_assert(drag_p > 0.5, "horizontal drag on bottom tabs must raise refraction lens (pressed > 0.5)")
  debug_assert(lens_w > 40.0 && lens_w <= expected_lw + 20.0, "bottom tab lifted lens width must follow lifted aspect formula")
  debug_assert(drag.pressed(node) < 0.001, "bottom tab lens must settle after drag release")
  t.dispose()
}

test "lg_liquid_segmented_light_pill_tap_and_drag" {
  set_dark(Some(false))
  let idle_light = ctrl_seg_thumb_idle()
  let r = ((idle_light >> 24) & 0xFFL).to_double() / 255.0
  let g = ((idle_light >> 16) & 0xFFL).to_double() / 255.0
  let b = ((idle_light >> 8) & 0xFFL).to_double() / 255.0
  let luma = 0.2126 * r + 0.7152 * g + 0.0722 * b
  debug_assert(luma > 0.9, "light mode ctrl_seg_thumb_idle luminance must be > 0.9")
  let chosen = signals::signal(0)
  let drag = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=ctrl_seg_held_scale)
  let t = lg_case(
    fn(p) {
      let _ = liquid_segmented_node(
        p,
        fn() { ["Glass", "Clear", "Tinted"] },
        fn() { chosen.get() },
        fn(i) { chosen.set(i) },
        width=300.0,
        drag=drag,
      )
    },
    dark=false,
  )
  let node = match drag.node.v {
    Some(n) => n
    None => { debug_assert(false, "seg drag node must be attached"); t.dispose(); return }
  }
  let clear_tab = require_drawn(t, "Clear", view::Role::Tab)
  t.press_at(clear_tab.x + clear_tab.w / 2.0, clear_tab.y + clear_tab.h / 2.0)
  t.run_for(60.0)
  let tap_down_p = drag.pressed(node)
  t.release(clear_tab.x + clear_tab.w / 2.0, clear_tab.y + clear_tab.h / 2.0)
  t.run_for(60.0)
  let tap_after_p = drag.pressed(node)
  t.run_shown(springs_out)
  debug_assert(tap_down_p == 0.0 && tap_after_p == 0.0, "tapping segmented item must not trigger pressed lens")
  debug_assert(chosen.get() == 1 && (drag.value(node) - 1.0).abs() < 0.01, "tapping Clear must slide to index 1")
  // Drag across to Tinted
  let sx = clear_tab.x + clear_tab.w / 2.0
  let sy = clear_tab.y + clear_tab.h / 2.0
  t.press_at(sx, sy)
  t.move_to(sx + 20.0, sy)
  t.run_for(120.0)
  t.move_to(sx + 90.0, sy)
  t.run_for(200.0)
  let drag_p = drag.pressed(node)
  t.release(sx + 90.0, sy)
  t.run_shown(springs_out)
  debug_assert(drag_p > 0.5, "dragging segmented control must trigger pressed lens (> 0.5)")
  debug_assert(chosen.get() == 2 && drag.pressed(node) < 0.001, "releasing segmented drag must select Tinted and settle")
  t.dispose()
}

test "lg_liquid_slider_default_track_height" {
  debug_assert((slider_track_h - 6.0).abs() < 1.0e-6, "slider_track_h must be 6.0")
  debug_assert((slider_thumb_w - 36.0).abs() < 1.0e-6, "slider_thumb_w must be 36.0")
  debug_assert((slider_thumb_h - 22.0).abs() < 1.0e-6, "slider_thumb_h must be 22.0")
  debug_assert((thumb_held_scale - 1.32).abs() < 1.0e-6, "thumb_held_scale must be 1.32")
}

test "progressive_blur_dark_recipe_and_span" {
  debug_assert(light.blur_tint == 0xFFFFFFFFL, "light.blur_tint must remain pure white")
  debug_assert(dark.blur_tint == 0x11131AFFL, "dark.blur_tint must match dark glass surface")
  let dr = ((dark.blur_tint >> 24) & 0xFFL).to_double() / 255.0
  let dg = ((dark.blur_tint >> 16) & 0xFFL).to_double() / 255.0
  let db = ((dark.blur_tint >> 8) & 0xFFL).to_double() / 255.0
  let dark_luma = 0.2126 * dr + 0.7152 * dg + 0.0722 * db
  debug_assert(dark_luma < 0.2, "dark.blur_tint luminance must be below 0.2 to avoid grey wall")
  debug_assert(blur_band_blur >= 6.0, "blur_band_blur must be >= 6.0 for smooth progressive span")
  debug_assert((blur_band_blur - 8.0).abs() < 1.0e-6, "blur_band_blur must be 8.0")
  debug_assert((blur_band_tint - 0.56).abs() < 1.0e-6, "blur_band_tint must be 0.56")
}

test "lg_liquid_bottom_tabs_hold_and_drag_from_other_tab" {
  let chosen = signals::signal(0)
  let drag = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=tab_lens_held_scale)
  let t = lg_case(fn(p) {
    let _ = p.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(408.0)))
      let _ = liquid_bottom_tabs_node(b, ["Home", "Search", "Me"], fn() { chosen.get() }, fn(i) { chosen.set(i) }, label="Tabs", drag=drag)
    })
  })
  let node = match drag.node.v {
    Some(n) => n
    None => { debug_assert(false, "drag node must be attached"); t.dispose(); return }
  }
  let home = require_drawn(t, "Home", view::Role::Tab)
  let search = require_drawn(t, "Search", view::Role::Tab)
  let me = require_drawn(t, "Me", view::Role::Tab)
  let home_x = home.x + home.w / 2.0
  let search_x = search.x + search.w / 2.0
  let me_x = me.x + me.w / 2.0
  let mid_y = me.y + me.h / 2.0
  // 1. Short tap (< 120ms) on non-current tab: pressed == 0.0, slides smoothly to target
  t.press_at(me_x, mid_y)
  t.run_for(60.0)
  let tap_down_p = drag.pressed(node)
  t.release(me_x, mid_y)
  t.run_for(60.0)
  let tap_after_p = drag.pressed(node)
  t.run_shown(springs_out)
  debug_assert(tap_down_p == 0.0 && tap_after_p == 0.0, "short tap on non-current tab must keep pressed == 0")
  debug_assert(chosen.get() == 2 && (drag.value(node) - 2.0).abs() < 0.01, "short tap on Me must slide to 2")
  // Return to tab 0
  t.tap(home_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 0, "tap Home must reset to 0")
  // 2. Hold on non-current tab Me (index 2) for 300ms (past 200ms hold threshold + spring rise), then release without moving -> tap selects Me
  t.press_at(me_x, mid_y)
  t.run_for(300.0)
  let hold_tap_p = drag.pressed(node)
  let hold_tap_v = drag.value(node)
  t.release(me_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(hold_tap_p > 0.5, "holding non-current tab past 200ms must lift lens (pressed > 0.5)")
  debug_assert(hold_tap_v > 1.5, "holding non-current tab Me must move lens near index 2 (value > 1.5)")
  debug_assert(chosen.get() == 2 && drag.pressed(node) < 0.001, "releasing after stationary hold must select held tab and settle")
  // Return to tab 0
  t.tap(home_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 0, "tap Home must reset to 0 before hold-then-drag")
  // 3. Hold on non-current tab Me (index 2) for 300ms, then drag to Search (index 1)
  t.press_at(me_x, mid_y)
  t.run_for(300.0)
  let hold_p = drag.pressed(node)
  let hold_v = drag.value(node)
  t.move_to(search_x, mid_y)
  t.run_for(160.0)
  t.release(search_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(hold_p > 0.5, "holding non-current tab for 300ms must lift lens (pressed > 0.5)")
  debug_assert(hold_v > 1.5, "holding non-current tab Me must move lens near index 2 (value > 1.5)")
  debug_assert(chosen.get() == 1 && drag.pressed(node) < 0.001, "hold-then-drag to Search must select 1 and settle pressed")
  // Return to tab 0
  t.tap(home_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 0, "tap Home must reset to 0 before immediate drag")
  // 4. Immediate drag from non-current tab Me (index 2) toward Search (index 1)
  t.press_at(me_x, mid_y)
  t.move_to(me_x - 20.0, mid_y)
  t.run_for(100.0)
  let imm_p = drag.pressed(node)
  let imm_v = drag.value(node)
  t.move_to(search_x, mid_y)
  t.run_for(160.0)
  t.release(search_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(imm_p > 0.5, "immediate drag from non-current tab must lift lens (pressed > 0.5)")
  debug_assert(imm_v > 1.3, "immediate drag from Me must track from Me (~2) rather than Home (0)")
  debug_assert(chosen.get() == 1 && drag.pressed(node) < 0.001, "immediate drag from Me to Search must select 1 and settle")
  // 5. Fast fling from Home (index 0) rightward past Search -> projected fling lands on Me (index 2)
  t.tap(home_x, mid_y)
  t.run_shown(springs_out)
  t.press_at(home_x, mid_y)
  t.frame(ms=16.0)
  t.move_to(home_x + 40.0, mid_y)
  t.frame(ms=16.0)
  t.move_to(search_x, mid_y)
  t.release(search_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 2 && drag.pressed(node) < 0.001, "fast rightward fling released at Search must project onto Me (2)")
  t.dispose()
}

test "lg_liquid_segmented_hold_and_drag_from_other_item" {
  let chosen = signals::signal(0)
  let drag = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=ctrl_seg_held_scale)
  let t = lg_case(
    fn(p) {
      let _ = liquid_segmented_node(
        p,
        fn() { ["Glass", "Clear", "Tinted"] },
        fn() { chosen.get() },
        fn(i) { chosen.set(i) },
        width=300.0,
        drag=drag,
      )
    },
    dark=false,
  )
  let node = match drag.node.v {
    Some(n) => n
    None => { debug_assert(false, "seg drag node must be attached"); t.dispose(); return }
  }
  let glass = require_drawn(t, "Glass", view::Role::Tab)
  let clear_tab = require_drawn(t, "Clear", view::Role::Tab)
  let tinted = require_drawn(t, "Tinted", view::Role::Tab)
  let glass_x = glass.x + glass.w / 2.0
  let clear_x = clear_tab.x + clear_tab.w / 2.0
  let tinted_x = tinted.x + tinted.w / 2.0
  let mid_y = tinted.y + tinted.h / 2.0
  // 1. Short tap (< 200ms) on non-current item Tinted
  t.press_at(tinted_x, mid_y)
  t.run_for(60.0)
  let tap_down_p = drag.pressed(node)
  t.release(tinted_x, mid_y)
  t.run_for(60.0)
  let tap_after_p = drag.pressed(node)
  t.run_shown(springs_out)
  debug_assert(tap_down_p == 0.0 && tap_after_p == 0.0, "short tap on non-current segment must keep pressed == 0")
  debug_assert(chosen.get() == 2 && (drag.value(node) - 2.0).abs() < 0.01, "short tap on Tinted must slide to 2")
  // Return to item 0
  t.tap(glass_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 0, "tap Glass must reset to 0")
  // 2. Hold on non-current item Tinted (index 2) for 300ms, then drag to Clear (index 1)
  t.press_at(tinted_x, mid_y)
  t.run_for(300.0)
  let hold_p = drag.pressed(node)
  let hold_v = drag.value(node)
  t.move_to(clear_x, mid_y)
  t.run_for(160.0)
  t.release(clear_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(hold_p > 0.5, "holding non-current segment for 300ms must lift lens (pressed > 0.5)")
  debug_assert(hold_v > 1.5, "holding non-current segment Tinted must move lens near index 2 (value > 1.5)")
  debug_assert(chosen.get() == 1 && drag.pressed(node) < 0.001, "hold-then-drag to Clear must select 1 and settle pressed")
  // Return to item 0
  t.tap(glass_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(chosen.get() == 0, "tap Glass must reset to 0 before immediate drag")
  // 3. Immediate drag from non-current item Tinted (index 2) toward Clear (index 1)
  t.press_at(tinted_x, mid_y)
  t.move_to(tinted_x - 20.0, mid_y)
  t.run_for(100.0)
  let imm_p = drag.pressed(node)
  let imm_v = drag.value(node)
  t.move_to(clear_x, mid_y)
  t.run_for(160.0)
  t.release(clear_x, mid_y)
  t.run_shown(springs_out)
  debug_assert(imm_p > 0.5, "immediate drag from non-current segment must lift lens (pressed > 0.5)")
  debug_assert(imm_v > 1.3, "immediate drag from Tinted must track from Tinted (~2) rather than Glass (0)")
  debug_assert(chosen.get() == 1 && drag.pressed(node) < 0.001, "immediate drag from Tinted to Clear must select 1 and settle")
  t.dispose()
}
