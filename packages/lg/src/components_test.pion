test "lg_sheet_open_escape_and_zero_nested_glass" {
  ui::set_glass_solid(None)
  let sheet_open = signals::signal(false)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_sheet_node(
        page,
        fn() { sheet_open.get() },
        fn() -> Unit { sheet_open.set(false) },
        fn() { "Share" },
        fn(b : view::View) -> Unit {
          let _ = b.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("Sheet content"), look=words_at(15.0)) })
        },
      )
    },
    w=800.0,
    h=700.0,
  )
  t.run_shown(springs_out)
  sheet_open.set(true)
  t.frame()
  t.run_shown(springs_out)
  debug_assert(t.get("Share", role=view::Role::Dialog).is_some(), "sheet opens as modal dialog")
  assert_no_nested_glass(t, label="sheet open")
  t.key(ui::key_escape)
  t.run_shown(springs_out)
  debug_assert(!sheet_open.get(), "Escape closes sheet")
  t.dispose()
}

fn assert_clean_tester(t : ui::Tester, label : String) -> Unit {
  let uf = t.unasked_faults()
  let af = t.a11y_faults()
  debug_assert(uf.length() == 0, "unasked faults in \{label}: \{uf.length()}")
  debug_assert(af.length() == 0, "a11y faults in \{label}: \{af.length()}")
}

test "lg_button_compact_ghost_and_active" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let is_active = signals::signal(false)
    let clicks = ui::ref_new(0)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_button_node(row, fn() { "Default" }, fn() -> Unit { clicks.v = clicks.v + 1 })
          let _ = liquid_button_node(
            row,
            fn() { "Compact" },
            fn() -> Unit {
              is_active.set(!is_active.get())
              clicks.v = clicks.v + 1
            },
            flat=true,
            ghost=true,
            height=32.0,
            pad_x=10.0,
            active=fn() { is_active.get() },
          )
        })
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    assert_no_nested_glass(t, label="button compact ghost rest")
    let def_btn = require_drawn(t, "Default", view::Role::Button)
    let cmp_btn = require_drawn(t, "Compact", view::Role::Button)
    debug_assert((def_btn.h - button_h).abs() < 0.01, "default button keeps button_h")
    debug_assert((cmp_btn.h - 32.0).abs() < 0.01, "compact button uses height=32")
    t.press("Compact")
    t.run_shown(springs_out)
    debug_assert(is_active.get() && clicks.v == 1, "ghost button toggles active state on press")
    assert_no_nested_glass(t, label="button compact ghost active")
    assert_clean_tester(t, "button compact ghost")
    t.dispose()
  }
}

test "lg_toolbar_custom_spacing_divider_and_ghost_buttons" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let tool = signals::signal(0)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_toolbar_node(
          page,
          fn(bar : view::View) -> Unit {
            let _ = liquid_button_node(
              bar,
              fn() { "Select" },
              fn() -> Unit { tool.set(0) },
              flat=true,
              ghost=true,
              height=32.0,
              pad_x=10.0,
              active=fn() { tool.get() == 0 },
            )
            let _ = liquid_button_node(
              bar,
              fn() { "Pen" },
              fn() -> Unit { tool.set(1) },
              flat=true,
              ghost=true,
              height=32.0,
              pad_x=10.0,
              active=fn() { tool.get() == 1 },
            )
            let _ = liquid_toolbar_divider(bar, height=18.0)
            let _ = liquid_button_node(
              bar,
              fn() { "Note" },
              fn() -> Unit { tool.set(2) },
              flat=true,
              ghost=true,
              height=32.0,
              pad_x=10.0,
              active=fn() { tool.get() == 2 },
            )
          },
          height=40.0,
          pad_x=8.0,
          gap=4.0,
        )
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    assert_no_nested_glass(t, label="toolbar ghost buttons")
    debug_assert(count_liquid_glass(t) == 1, "toolbar with ghost buttons must have strictly 1 Glass::liquid")
    t.press("Pen")
    t.run_shown(springs_out)
    debug_assert(tool.get() == 1, "clicking Pen updates active tool")
    debug_assert(count_liquid_glass(t) == 1, "active ghost button still uses zero nested glass")
    assert_clean_tester(t, "toolbar ghost buttons")
    t.dispose()
  }
}

test "lg_panel_adaptive_height_role_and_solid_degrade" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_panel_node(
          page,
          fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Inspector Body"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
            })
          },
          gap=8.0,
          label=fn() { "Inspector" },
        )
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    let pnl = require_drawn(t, "Inspector", view::Role::Group)
    debug_assert(pnl.h > 30.0 && pnl.h < 120.0, "panel height adapts to content")
    debug_assert(count_liquid_glass(t) == 1, "liquid_panel_node emits 1 Glass::liquid")
    assert_no_nested_glass(t, label="liquid_panel_node")
    assert_clean_tester(t, "liquid_panel_node")
    t.dispose()

    ui::set_glass_solid(Some(true))
    let ts = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_panel_node(
          page,
          fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Solid Panel"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
            })
          },
          label=fn() { "SolidInspector" },
        )
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    ts.run_shown(springs_out)
    let lc = count_liquid_glass(ts)
    ui::set_glass_solid(None)
    debug_assert(lc == 0, "liquid_panel_node degrades cleanly when glass_solid=true")
    ts.dispose()
  }
}

test "lg_menu_panel_header_dynamic_filter_and_escape" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let query = signals::signal("")
    let hdr = signals::signal("Commands")
    let closed = ui::ref_new(0)
    let picked = ui::ref_new("")
    let checked = signals::signal(false)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_button_node(
          page,
          fn() { "Filter" },
          fn() -> Unit {
            query.set("code")
            hdr.set("")
          },
          flat=true,
          ghost=true,
          height=32.0,
          pad_x=10.0,
        )
        let _ = liquid_menu_panel_node(
          page,
          fn() {
            let q = query.get()
            if q == "code" {
              [
                LiquidMenuEntry::item(label="Code Block", shortcut="/code", on_select=fn() -> Unit { picked.v = "code" }),
              ]
            } else {
              [
                LiquidMenuEntry::item(label="Heading", shortcut="/h1", on_select=fn() -> Unit { picked.v = "h1" }),
                LiquidMenuEntry::item(label="Code Block", shortcut="/code", on_select=fn() -> Unit { picked.v = "code" }),
                LiquidMenuEntry::separator(),
                LiquidMenuEntry::check(label="Word Wrap", checked=fn() { checked.get() }, on_toggle=fn() -> Unit { checked.set(!checked.get()) }),
              ]
            }
          },
          fn() -> Unit { closed.v = closed.v + 1 },
          header=fn() { hdr.get() },
          menu_label=fn() { "Slash Menu" },
        )
      },
      dark=dark,
      w=640.0,
      h=480.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    assert_no_nested_glass(t, label="menu_panel initial")
    t.press("Word Wrap")
    t.run_shown(springs_out)
    debug_assert(checked.get() && closed.v == 0, "check item toggles without closing panel")
    t.press("Filter")
    t.run_shown(springs_out)
    debug_assert(t.get("Heading", role=view::Role::MenuItem).is_none(), "filtered-out item disappears reactively")
    t.press("Code Block")
    t.run_shown(springs_out)
    debug_assert(picked.v == "code" && closed.v == 1, "selecting filtered item calls on_close and on_select")
    t.key(ui::key_escape)
    t.run_shown(springs_out)
    debug_assert(closed.v == 2, "Escape triggers on_close on liquid_menu_panel_node")
    assert_clean_tester(t, "menu_panel")
    t.dispose()
  }
}

test "lg_menu_button_circle_and_capsule_morph" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let open_circle = signals::signal(false)
    let open_cap = signals::signal(false)
    let picked = ui::ref_new("")
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_menu_button_node(
            row,
            page,
            fn() { open_circle.get() },
            fn(v : Bool) -> Unit { open_circle.set(v) },
            fn() { "More" },
            fn() {
              [
                LiquidMenuEntry::item(label="Duplicate", on_select=fn() -> Unit { picked.v = "dup" }),
                LiquidMenuEntry::item(label="Archive", on_select=fn() -> Unit { picked.v = "arc" }),
              ]
            },
            icon=fn(c : view::View, ink : () -> Int64) -> Unit { flight_icon(c, 18.0, ink) },
            show_label=false,
            height=40.0,
          )
          let _ = liquid_menu_button_node(
            row,
            page,
            fn() { open_cap.get() },
            fn(v : Bool) -> Unit { open_cap.set(v) },
            fn() { "Insert" },
            fn() {
              [
                LiquidMenuEntry::item(label="Sticky Note", on_select=fn() -> Unit { picked.v = "note" }),
                LiquidMenuEntry::item(label="Frame", on_select=fn() -> Unit { picked.v = "frame" }),
              ]
            },
            icon=fn(c : view::View, ink : () -> Int64) -> Unit { flight_icon(c, 16.0, ink) },
            show_label=true,
            height=36.0,
            pad_x=12.0,
          )
        })
      },
      dark=dark,
      w=640.0,
      h=420.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    let circ = require_drawn(t, "More", view::Role::Button)
    debug_assert((circ.w - 40.0).abs() < 0.01 && (circ.h - 40.0).abs() < 0.01, "circle menu button is height x height")
    assert_no_nested_glass(t, label="menu_button closed")
    t.press("More")
    t.run_shown(springs_out)
    debug_assert(open_circle.get(), "circle menu button opens menu")
    assert_no_nested_glass(t, label="menu_button circle open")
    t.press("Duplicate")
    t.run_shown(springs_out)
    debug_assert(picked.v == "dup" && !open_circle.get(), "selecting circle menu item runs callback and closes")
    t.press("Insert")
    t.run_shown(springs_out)
    debug_assert(open_cap.get(), "capsule menu button opens menu")
    assert_no_nested_glass(t, label="menu_button capsule open")
    t.press("Frame")
    t.run_shown(springs_out)
    debug_assert(picked.v == "frame" && !open_cap.get(), "selecting capsule menu item runs callback and closes")
    assert_clean_tester(t, "menu_button")
    t.dispose()
  }
}

