}

test "lg_audit_glass_positive_single_layer_island" {
  ui::set_glass_solid(None)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_toolbar_node(
        page,
        fn(bar : view::View) -> Unit {
          let _ = liquid_button_node(bar, fn() { "Alpha" }, fn() -> Unit { () }, flat=true, ghost=true, height=32.0, pad_x=10.0)
          let _ = liquid_toolbar_divider(bar, height=18.0)
          let _ = liquid_button_node(bar, fn() { "Beta" }, fn() -> Unit { () }, flat=true, ghost=true, height=32.0, pad_x=10.0)
        },
        height=40.0,
        pad_x=8.0,
        gap=4.0,
      )
      let _ = liquid_button_node(page, fn() { "Solo" }, fn() -> Unit { () })
    },
    w=640.0,
    h=320.0,
  )
  t.run_shown(springs_out)
  debug_assert(count_liquid_glass(t) == 2, "expected 2 single-layer liquid glass islands")
  let faults = audit_glass(t, label="positive_single_layer")
  debug_assert(faults.length() == 0, "single-layer glass islands must pass audit_glass with 0 faults")
  assert_no_nested_glass(t, label="positive_single_layer")
  t.dispose()
}

test "lg_audit_glass_negative_detects_nested_glass" {
  ui::set_glass_solid(None)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = page.box(fn(outer : view::View) -> Unit {
        let _ = outer
          .width(view::Live::Is(Some(240.0)))
          .height(view::Live::Is(Some(120.0)))
          .padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))
          .radius(view::Live::Is(24.0))
          .glass(view::Live::Is(Some(lg_panel_glass())))
        let _ = outer.box(fn(inner : view::View) -> Unit {
          let _ = inner
            .width(view::Live::Is(Some(120.0)))
            .height(view::Live::Is(Some(48.0)))
            .radius(view::Live::Is(16.0))
            .glass(view::Live::Is(Some(lg_capsule_glass())))
        })
      })
    },
    w=640.0,
    h=320.0,
  )
  t.run_shown(springs_out)
  debug_assert(count_liquid_glass(t) == 2, "nested fixture emits 2 liquid glass passes")
  let faults = audit_glass(t, label="negative_nested_glass")
  debug_assert(faults.length() > 0, "audit_glass must detect nested Glass::liquid rectangles")
  t.dispose()
}

test "lg_button_neutral_active_no_blue_fill" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_toolbar_node(
          page,
          fn(bar : view::View) -> Unit {
            let _ = liquid_button_node(
              bar,
              fn() { "Bold" },
              fn() -> Unit { () },
              flat=true,
              ghost=true,
              height=32.0,
              pad_x=10.0,
              active=fn() { true },
              neutral_active=true,
            )
            let _ = liquid_button_node(
              bar,
              fn() { "Accent" },
              fn() -> Unit { () },
              flat=true,
              ghost=true,
              height=32.0,
              pad_x=10.0,
              active=fn() { true },
            )
          },
        )
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.run_shown(springs_out)
    let bold_btn = require_drawn(t, "Bold", view::Role::Button)
    let accent_btn = require_drawn(t, "Accent", view::Role::Button)
    let expected_neutral = if dark { 0xFFFFFF22L } else { 0x00000016L }
    debug_assert(bold_btn.ground == expected_neutral, "neutral_active=true must use neutral translucent fill, not blue")
    debug_assert(bold_btn.ground != ctrl_chip_selected_tint(), "neutral_active=true must not use ctrl_chip_selected_tint()")
    debug_assert(accent_btn.ground == ctrl_chip_selected_tint(), "neutral_active=false keeps accent active fill")
    assert_no_nested_glass(t, label="button neutral_active")
    t.dispose()
  }
}

test "lg_concentric_corner_ladder_and_monoid_sizing_invariants" {
  // Unified monoid sf-ui & PR #8038 sizing invariants
  debug_assert((button_h - 36.0).abs() < 0.01, "button_h must be 36.0")
  debug_assert((toggle_w - 48.0).abs() < 0.01 && (toggle_h - 24.0).abs() < 0.01, "toggle must be 48x24")
  debug_assert((toggle_w - 2.0 * toggle_pad - thumb_w - toggle_drag).abs() < 0.01, "toggle_drag must reach exact edge")
  debug_assert((tabs_h - 50.0).abs() < 0.01 && (tab_lens_h - 42.0).abs() < 0.01, "bottom tabs must be 50/42")
  debug_assert((ctrl_btn_sm - 28.0).abs() < 0.01 && (ctrl_btn_md - 32.0).abs() < 0.01 && (ctrl_btn_lg - 40.0).abs() < 0.01, "icon button sizes 28/32/40")
  debug_assert((ctrl_input_h - 36.0).abs() < 0.01 && (ctrl_input_r - 18.0).abs() < 0.01, "input must be 36pt r=18")
  debug_assert((ovl_select_h - 36.0).abs() < 0.01 && (ovl_select_radius - 18.0).abs() < 0.01, "select must be 36pt r=18")
  debug_assert((ovl_menu_item_h - 36.0).abs() < 0.01, "menu item min height must be 36pt")

  // Exact concentric corner ladder: R_outer - pad == R_inner
  debug_assert(((toggle_h / 2.0 - toggle_pad) - thumb_h / 2.0).abs() < 0.01, "Toggle concentric: 12 - 2 == 10")
  debug_assert(((tabs_h / 2.0 - tabs_pad) - tab_lens_h / 2.0).abs() < 0.01, "BottomTabs concentric: 25 - 4 == 21")
  debug_assert(((tile_size / 2.0 - (tile_size - tile_inner) / 2.0) - tile_inner / 2.0).abs() < 0.01, "ControlTile concentric: 28 - 6 == 22")
  debug_assert(((36.0 / 2.0 - ctrl_seg_pad) - (36.0 - 2.0 * ctrl_seg_pad) / 2.0).abs() < 0.01, "SegmentedControl concentric: 18 - 3 == 15")
  debug_assert(((42.0 / 2.0 - ovl_toolbar_px) - 32.0 / 2.0).abs() < 0.01, "Toolbar concentric: 21 - 5 == 16")
  debug_assert(((ovl_menu_radius - ovl_menu_pad) - ovl_menu_item_radius).abs() < 0.01, "Menu concentric: 18 - 6 == 12")
  debug_assert(((ovl_sheet_radius - ovl_sheet_hdr_pr) - ovl_close_btn_size / 2.0).abs() < 0.01, "Sheet close concentric: 28 - 12 == 16")
  debug_assert(((dialog_radius - 10.0) - button_h / 2.0).abs() < 0.01, "Dialog button concentric: 28 - 10 == 18")
  debug_assert(((ovl_action_radius - ovl_action_pad) - ovl_action_item_radius).abs() < 0.01, "ActionSheet concentric: 22 - 6 == 16")
  debug_assert(((ovl_toast_radius - ovl_toast_pr) - ovl_toast_action_h / 2.0).abs() < 0.01, "Toast concentric: 20 - 6 == 14")
  debug_assert(((ovl_list_radius - ovl_list_pad) - ovl_list_row_radius).abs() < 0.01, "List concentric: 24 - 6 == 18")
  debug_assert(((ovl_disc_radius - ovl_disc_pad) - ovl_disc_hdr_radius).abs() < 0.01, "Disclosure concentric: 22 - 6 == 16")
  debug_assert(((ctrl_chip_r - ctrl_chip_pad_rm) - ctrl_chip_rm_size / 2.0).abs() < 0.01, "Chip remove concentric: 14 - 4 == 10")
}

test "lg_inputs_floating_glass_zero_resting_edge" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let f1 = ui::Field::new()
    let f2 = ui::Field::new()
    let f3 = ui::Field::new()
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_text_field_node(page, f1, placeholder="Field")
        let _ = liquid_search_bar_node(page, f2, placeholder="Floating Search")
        let _ = liquid_search_bar_node(page, f3, placeholder="Flat Search", flat=true)
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.run_shown(springs_out)
    let mut glass_inputs = 0
    let mut flat_edged = 0
    for d in t.drawn() {
      if d.glass.is_some() {
        glass_inputs += 1
        debug_assert(d.edge.0 == 0.0, "floating glass text_field/search_bar at rest must have edge width 0.0, got \{d.edge.0}")
      } else if (d.edge.0 - ctrl_hairline_w).abs() < 0.01 && (d.h - ctrl_input_h).abs() < 0.01 {
        flat_edged += 1
      }
    }
    debug_assert(glass_inputs == 2, "expected 2 floating glass inputs, got \{glass_inputs}")
    debug_assert(flat_edged == 1, "flat=true search bar must retain hairline edge")
    assert_no_nested_glass(t, label="inputs floating glass resting edge")
    t.dispose()
  }
}

test "lg_all_floating_glass_surfaces_unified_no_resting_edge" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let seg = signals::signal(0)
    let qty = signals::signal(4)
    let sel_idx = signals::signal(0)
    let menu_open = signals::signal(false)
    let tab_idx = signals::signal(0)
    let f1 = ui::Field::new()
    let f2 = ui::Field::new()
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(row1 : view::View) -> Unit {
          let _ = row1.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_button_node(row1, fn() { "Btn" }, fn() -> Unit { () })
          let _ = liquid_icon_button_node(
            row1,
            fn() { "Icon" },
            fn(c : view::View, ink : () -> Int64) -> Unit { flight_icon(c, 16.0, ink) },
            fn() -> Unit { () },
          )
          let _ = liquid_button_group_node(row1, fn() {
            [
              LiquidGroupAction::new(label=fn() { "G1" }, icon=fn(c, ink) { flight_icon(c, 14.0, ink) }, press=fn() { () }),
              LiquidGroupAction::new(label=fn() { "G2" }, icon=fn(c, ink) { flight_icon(c, 14.0, ink) }, press=fn() { () }),
            ]
          })
          let _ = liquid_chip_node(row1, fn() { "Chip" }, fn() -> Unit { () })
          let _ = liquid_stepper_node(row1, fn() { qty.get() }, fn(v : Int) -> Unit { qty.set(v) }, label=fn() { "Qty" })
        })
        let _ = page.box(fn(row2 : view::View) -> Unit {
          let _ = row2.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_segmented_node(row2, fn() { ["A", "B"] }, fn() { seg.get() }, fn(i : Int) -> Unit { seg.set(i) }, width=180.0)
          let _ = liquid_select_node(
            row2,
            page,
            fn() { [LiquidSelectOption::new(label="Opt1"), LiquidSelectOption::new(label="Opt2")] },
            fn() { sel_idx.get() },
            fn(i : Int) -> Unit { sel_idx.set(i) },
            width=160.0,
          )
          let _ = liquid_menu_button_node(
            row2,
            page,
            fn() { menu_open.get() },
            fn(v : Bool) -> Unit { menu_open.set(v) },
            fn() { "Menu" },
            fn() { [LiquidMenuEntry::item(label="One", on_select=fn() { () })] },
          )
        })
        let _ = page.box(fn(row3 : view::View) -> Unit {
          let _ = row3.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = row3.box(fn(w1 : view::View) -> Unit {
            let _ = w1.width(view::Live::Is(Some(220.0)))
            let _ = liquid_text_field_node(w1, f1, placeholder="Text")
          })
          let _ = row3.box(fn(w2 : view::View) -> Unit {
            let _ = w2.width(view::Live::Is(Some(220.0)))
            let _ = liquid_search_bar_node(w2, f2, placeholder="Search")
          })
        })
        let _ = page.box(fn(row4 : view::View) -> Unit {
          let _ = row4.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_toolbar_node(row4, fn(bar : view::View) -> Unit {
            let _ = liquid_button_node(bar, fn() { "Tool" }, fn() -> Unit { () }, flat=true, ghost=true, height=32.0, pad_x=10.0)
          })
          let _ = liquid_panel_node(row4, fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Panel"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
            })
          })
        })
        let _ = page.box(fn(tabs_wrap : view::View) -> Unit {
          let _ = tabs_wrap.width(view::Live::Is(Some(320.0)))
          let _ = liquid_bottom_tabs_node(tabs_wrap, ["One", "Two"], fn() { tab_idx.get() }, fn(i : Int) -> Unit { tab_idx.set(i) }, label="Unified Tabs")
        })
      },
      dark=dark,
      w=960.0,
      h=760.0,
    )
    t.run_shown(springs_out)
    let mut liquid_n = 0
    for d in t.drawn() {
      if d.glass.is_some() {
        liquid_n += 1
        debug_assert(d.edge.0 == 0.0, "all floating Glass::liquid surfaces at rest must have edge.0 == 0.0, got \{d.edge.0}")
        debug_assert(d.shadow.0 > 0.0, "all floating Glass::liquid surfaces must carry outside shadow")
      }
    }
    debug_assert(liquid_n == 13 && count_liquid_glass(t) == 13, "expected 13 floating Glass::liquid surfaces, got \{liquid_n}")
    assert_no_nested_glass(t, label="all floating glass surfaces unified")
    t.dispose()
  }
}
