// Comprehensive tests for the upgraded 34-component Liquid Glass library:
// - Zero glass-on-glass invariant via `Tester::drawn_glass()`
// - `MBUI_GLASS=solid` (`ui::set_glass_solid(Some(true))`) degradation in Light & Dark
// - iOS 26/27 Collapsible Tabs, Search Morph, Liquid Merge, Liquid Morph overlays
//   (Menu, Select, Popover, Tooltip, Sheet, ActionSheet), Controls, Inputs, Selection & Feedback.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

test "lg_glass_solid_degrades_cleanly_light_and_dark" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(Some(true))
    let toggle_on = signals::signal(true)
    let slider_val = signals::signal(55.0)
    let tab_idx = signals::signal(0)
    let ctab_min = signals::signal(false)
    let smorph_exp = signals::signal(true)
    let search_field = ui::Field::new()
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_button_node(row, fn() { "Primary" }, fn() -> Unit { () })
          let _ = liquid_button_node(row, fn() { "Tinted" }, fn() -> Unit { () }, tint=0x0066CCFFL)
          let _ = liquid_toggle_node(row, fn() { toggle_on.get() }, fn(v : Bool) -> Unit { toggle_on.set(v) }, fn() { "Wi-Fi" })
        })
        let _ = page.box(fn(s : view::View) -> Unit {
          let _ = s.width(view::Live::Is(Some(320.0)))
          let _ = liquid_slider_node(s, fn() { slider_val.get() }, fn(v : Double) -> Unit { slider_val.set(v) }, fn() { "Volume" })
        })
        let _ = page.box(fn(tabs_wrap : view::View) -> Unit {
          let _ = tabs_wrap.width(view::Live::Is(Some(360.0)))
          let _ = liquid_bottom_tabs_node(tabs_wrap, ["Home", "Explore", "Library"], fn() { tab_idx.get() }, fn(i : Int) -> Unit { tab_idx.set(i) }, label="Solid Tabs")
        })
        let _ = liquid_collapsible_tabs_node(
          page,
          ["Home", "Browse", "Radio"],
          fn() { tab_idx.get() },
          fn(i : Int) -> Unit { tab_idx.set(i) },
          fn() { ctab_min.get() },
          fn() -> Unit { ctab_min.set(false) },
          fn() -> Unit { () },
          label="Solid Collapsible Tabs",
        )
        let _ = liquid_search_morph_node(
          page,
          search_field,
          fn() { smorph_exp.get() },
          fn(v : Bool) -> Unit { smorph_exp.set(v) },
          width=360.0,
          placeholder="Search library",
        )
        let _ = liquid_merge_node(page, label=fn() { "Solid Merge" })
      },
      dark=dark,
      w=900.0,
      h=760.0,
    )
    t.run_shown(springs_out)
    let liquid_count = count_liquid_glass(t)
    ui::set_glass_solid(None)
    debug_assert(liquid_count == 0, "glass_solid=true must emit zero Glass::liquid instances")
    t.dispose()
  }
}

test "lg_collapsible_tabs_expand_minimize_and_zero_nested_glass" {
  ui::set_glass_solid(None)
  let tab = signals::signal(0)
  let minimized = signals::signal(false)
  let actions = ui::ref_new(0)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_collapsible_tabs_node(
        page,
        ["Home", "Browse", "Radio"],
        fn() { tab.get() },
        fn(i : Int) -> Unit { tab.set(i) },
        fn() { minimized.get() },
        fn() -> Unit { minimized.set(false) },
        fn() -> Unit { actions.v = actions.v + 1 },
        label="iOS26 Tabs",
      )
    },
    w=640.0,
    h=320.0,
  )
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="collapsible_tabs expanded")
  let browse = require_drawn(t, "Browse", view::Role::Tab)
  t.tap(browse.x + browse.w / 2.0, browse.y + browse.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(tab.get() == 1, "tapping Browse selects tab 1")
  minimized.set(true)
  t.frame()
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="collapsible_tabs minimized")
  let srch = require_drawn(t, "Search", view::Role::Button)
  t.tap(srch.x + srch.w / 2.0, srch.y + srch.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(actions.v == 1, "tapping Search orb triggers on_action")
  let exp_btn = require_drawn(t, "Expand Browse", view::Role::Button)
  t.tap(exp_btn.x + exp_btn.w / 2.0, exp_btn.y + exp_btn.h / 2.0)
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="collapsible_tabs re-expanded")
  debug_assert(!minimized.get(), "tapping collapsed orb expands bar")
  t.dispose()
}

test "lg_search_morph_orb_and_cancel_bud_zero_nested_glass" {
  ui::set_glass_solid(None)
  let field = ui::Field::new()
  let expanded = signals::signal(false)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_search_morph_node(
        page,
        field,
        fn() { expanded.get() },
        fn(v : Bool) -> Unit { expanded.set(v) },
        width=360.0,
        placeholder="Search liquid glass",
      )
    },
    w=640.0,
    h=320.0,
  )
  t.run_shown(springs_out)
  debug_assert(count_liquid_glass(t) == 1, "collapsed search morph renders strictly 1 glass orb")
  assert_no_nested_glass(t, label="search_morph collapsed")
  let orb = require_drawn(t, "Search", view::Role::Button)
  t.tap(orb.x + orb.w / 2.0, orb.y + orb.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(expanded.get(), "tapping search orb expands search bar")
  debug_assert(count_liquid_glass(t) == 2, "expanded search morph renders 2 detached glass capsules")
  assert_no_nested_glass(t, label="search_morph expanded")
  let cancel = require_drawn(t, "Cancel Search", view::Role::Button)
  t.tap(cancel.x + cancel.w / 2.0, cancel.y + cancel.h / 2.0)
  t.run_shown(springs_out)
  debug_assert(!expanded.get(), "tapping cancel orb collapses search bar")
  debug_assert(count_liquid_glass(t) == 1, "re-collapsed search morph returns to 1 glass orb")
  assert_no_nested_glass(t, label="search_morph re-collapsed")
  t.dispose()
}

test "lg_liquid_merge_programmatic_split_and_fuse" {
  ui::set_glass_solid(None)
  let ctrl = LiquidMerge::new(separated=false)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_merge_node(page, controller=ctrl, label=fn() { "Merge Stage" })
    },
    w=640.0,
    h=320.0,
  )
  t.run_shown(springs_out)
  debug_assert(!ctrl.is_separated() && ctrl.is_bonded(), "LiquidMerge starts merged and bonded")
  // Law 2 Exception 2: bonded capillary fusion pair intentionally overlaps (merge_merged_gap = -8.0).
  debug_assert(count_liquid_glass(t) == 2, "LiquidMerge merged renders 2 bonded glass passes")
  ctrl.set_separated(true, at=t.time())
  t.run_shown(springs_out)
  debug_assert(ctrl.is_separated() && !ctrl.is_bonded(), "set_separated(true) splits bond cleanly")
  debug_assert(ctrl.merge_at(t.time()) == 0.0, "separated bond has merge == 0.0")
  assert_no_nested_glass(t, label="liquid_merge separated")
  ctrl.set_separated(false, at=t.time())
  t.run_shown(springs_out)
  debug_assert(!ctrl.is_separated() && ctrl.is_bonded(), "set_separated(false) re-fuses bond")
  t.dispose()
}

test "lg_controls_inputs_and_selection_components" {
  ui::set_glass_solid(None)
  let icon_clicks = ui::ref_new(0)
  let seg = signals::signal(0)
  let checked = signals::signal(false)
  let radio = signals::signal(0)
  let step_v = signals::signal(5)
  let chip_sel = signals::signal(false)
  let fld = ui::Field::new(text="hello")
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = page.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0))
        let _ = liquid_icon_button_node(
          row,
          fn() { "Star" },
          fn(c : view::View, ink : () -> Int64) -> Unit { flight_icon(c, 18.0, ink) },
          fn() -> Unit { icon_clicks.v = icon_clicks.v + 1 },
        )
        let _ = liquid_button_group_node(
          row,
          fn() {
            [
              LiquidGroupAction::new(label=fn() { "A1" }, icon=fn(c, ink) { flight_icon(c, 16.0, ink) }, press=fn() { () }),
              LiquidGroupAction::new(label=fn() { "A2" }, icon=fn(c, ink) { flight_icon(c, 16.0, ink) }, press=fn() { () }),
            ]
          },
        )
        let _ = liquid_badge_node(row, fn() { "Active" }, tone=LiquidTone::Success, dot=true)
        let _ = liquid_count_badge_node(row, fn() { 12 }, tone=LiquidTone::Danger)
      })
      let _ = liquid_segmented_node(page, fn() { ["Day", "Week", "Month"] }, fn() { seg.get() }, fn(i : Int) -> Unit { seg.set(i) }, width=300.0)
      let _ = liquid_text_field_node(page, fld, label=fn() { "Name" }, clearable=true)
      let _ = liquid_checkbox_node(page, fn() { checked.get() }, fn(v : Bool) -> Unit { checked.set(v) }, fn() { "Agree" })
      let _ = liquid_radio_group_node(page, fn() { ["One", "Two"] }, fn() { radio.get() }, fn(i : Int) -> Unit { radio.set(i) }, horizontal=true)
      let _ = liquid_stepper_node(page, fn() { step_v.get() }, fn(v : Int) -> Unit { step_v.set(v) }, min=0, max=10, label=fn() { "Qty" })
      let _ = liquid_chip_node(page, fn() { "Swift" }, fn() -> Unit { chip_sel.set(!chip_sel.get()) }, selected=fn() { chip_sel.get() })
    },
    w=800.0,
    h=700.0,
  )
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="controls & selection")
  t.press("Star")
  t.press("Agree")
  t.press("Increase Qty")
  t.press("Swift")
  t.run_shown(springs_out)
  debug_assert(icon_clicks.v == 1, "icon button press increments count")
  debug_assert(checked.get(), "checkbox toggles to checked")
  debug_assert(step_v.get() == 6, "stepper increments value to 6")
  debug_assert(chip_sel.get(), "chip toggles selected state")
  t.dispose()
}

test "lg_feedback_nav_toast_progress_disclosure_list_zero_nested_glass" {
  ui::set_glass_solid(None)
  let toast_on = signals::signal(true)
  let disc_open = signals::signal(false)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_nav_bar_node(page, fn() { "Settings" }, subtitle=fn() { "iOS 27" })
      let _ = liquid_toast_node(page, fn() { toast_on.get() }, fn() { "Saved" }, status=LiquidStatus::Success)
      let _ = liquid_progress_bar_node(page, fn() { Some(0.6) }, label=fn() { "Upload" }, show_value=true)
      let _ = liquid_progress_ring_node(page, fn() { Some(0.75) })
      let _ = liquid_disclosure_node(
        page,
        fn() { "Advanced" },
        fn() { disc_open.get() },
        fn(v : Bool) -> Unit { disc_open.set(v) },
        fn(b : view::View) -> Unit {
          let _ = b.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("Hidden details"), look=words_at(14.0)) })
        },
      )
      let _ = liquid_list_node(
        page,
        fn() { [LiquidListRow::new(title="Wi-Fi", value="Office", chevron=true)] },
        header=fn() { "Network" },
      )
    },
    w=800.0,
    h=700.0,
  )
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="feedback components at rest")
  t.dispose()
}

test "lg_menu_open_select_and_zero_nested_glass" {
  ui::set_glass_solid(None)
  let menu_open = signals::signal(false)
  let picked = ui::ref_new("")
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_menu_node(
        page,
        page,
        fn() { menu_open.get() },
        fn(v : Bool) -> Unit { menu_open.set(v) },
        fn() { "Actions" },
        fn(tr : view::View, _d : headless::Disclosure) -> Unit {
          let _ = tr.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0)))
          let _ = tr.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("Actions"), look=words_at(15.0)) })
        },
        fn() {
          [
            LiquidMenuEntry::item(label="Rename", on_select=fn() -> Unit { picked.v = "rename" }),
            LiquidMenuEntry::separator(),
            LiquidMenuEntry::item(label="Delete", destructive=true, on_select=fn() -> Unit { picked.v = "delete" }),
          ]
        },
      )
    },
    w=600.0,
    h=500.0,
  )
  t.run_shown(springs_out)
  assert_no_nested_glass(t, label="menu closed")
  t.press("Actions")
  t.run_shown(springs_out)
  debug_assert(menu_open.get(), "menu opens on trigger press")
  assert_no_nested_glass(t, label="menu open")
  t.press("Rename")
  t.run_shown(springs_out)
  debug_assert(picked.v == "rename" && !menu_open.get(), "picking menu item invokes callback and closes menu")
  t.dispose()
}

