    debug_assert(accent_btn.ground == ctrl_chip_selected_tint(), "neutral_active=false keeps accent active fill")
    assert_no_nested_glass(t, label="button neutral_active")
    t.dispose()
  }
}

test "lg_concentric_corner_ladder_and_sizing_invariants" {
  // Calibrated desktop & mobile sizing invariants
  debug_assert((button_h - 30.0).abs() < 0.01, "button_h must be 30.0")
  debug_assert((button_px - 12.0).abs() < 0.01, "button_px must be 12.0")
  debug_assert((toggle_w - 40.0).abs() < 0.01 && (toggle_h - 24.0).abs() < 0.01, "toggle must be 40x24")
  debug_assert((toggle_w - 2.0 * toggle_pad - thumb_w - toggle_drag).abs() < 0.01, "toggle_drag must reach exact edge")
  debug_assert((tabs_h - 50.0).abs() < 0.01 && (tab_lens_h - 42.0).abs() < 0.01, "bottom tabs must be 50/42")
  debug_assert((ctrl_btn_sm - 26.0).abs() < 0.01 && (ctrl_btn_md - 30.0).abs() < 0.01 && (ctrl_btn_lg - 36.0).abs() < 0.01, "icon button sizes 26/30/36")
  debug_assert((ctrl_input_h - 32.0).abs() < 0.01 && (ctrl_input_r - 16.0).abs() < 0.01, "input must be 32pt r=16")
  debug_assert((ovl_select_h - 32.0).abs() < 0.01 && (ovl_select_radius - 16.0).abs() < 0.01, "select must be 32pt r=16")
  debug_assert((ovl_menu_item_h - 32.0).abs() < 0.01, "menu item min height must be 32pt")

  // Exact concentric corner ladder: R_outer - pad == R_inner
  debug_assert(((toggle_h / 2.0 - toggle_pad) - thumb_h / 2.0).abs() < 0.01, "Toggle concentric: 12 - 2 == 10")
  debug_assert(((tabs_h / 2.0 - tabs_pad) - tab_lens_h / 2.0).abs() < 0.01, "BottomTabs concentric: 25 - 4 == 21")
  debug_assert(((tile_size / 2.0 - (tile_size - tile_inner) / 2.0) - tile_inner / 2.0).abs() < 0.01, "ControlTile concentric: 23 - 5 == 18")
  debug_assert(((30.0 / 2.0 - ctrl_seg_pad) - (30.0 - 2.0 * ctrl_seg_pad) / 2.0).abs() < 0.01, "SegmentedControl concentric: 15 - 2.5 == 12.5")
  debug_assert(((40.0 / 2.0 - ovl_toolbar_px) - button_h / 2.0).abs() < 0.01, "Toolbar concentric: 20 - 5 == 15")
  debug_assert(((34.0 / 2.0 - 2.0) - button_h / 2.0).abs() < 0.01, "BarPillGroup concentric: 17 - 2 == 15")
  debug_assert(((ovl_menu_radius - ovl_menu_pad) - ovl_menu_item_radius).abs() < 0.01, "Menu concentric: 16 - 6 == 10")
  debug_assert(((ovl_sheet_radius - ovl_sheet_hdr_pr) - ovl_close_btn_size / 2.0).abs() < 0.01, "Sheet close concentric: 27 - 12 == 15")
  debug_assert(((ovl_sheet_radius - ovl_sheet_footer_pad) - button_h / 2.0).abs() < 0.01, "Sheet footer button concentric: 27 - 12 == 15")
  debug_assert(((ovl_drawer_radius - ovl_drawer_pad) - button_h / 2.0).abs() < 0.01, "Drawer button concentric: 27 - 12 == 15")
  debug_assert(((dialog_radius - dialog_btn_inset) - button_h / 2.0).abs() < 0.01, "Dialog button concentric: 24 - 9 == 15")
  debug_assert(((ovl_action_radius - ovl_action_pad) - ovl_action_item_radius).abs() < 0.01, "ActionSheet concentric: 22 - 6 == 16")
  debug_assert(((ovl_toast_radius - ovl_toast_pr) - ovl_toast_action_h / 2.0).abs() < 0.01, "Toast concentric: 20 - 6 == 14")
  debug_assert(((ovl_list_radius - ovl_list_pad) - ovl_list_row_radius).abs() < 0.01, "List concentric: 24 - 6 == 18")
  debug_assert(((ovl_disc_radius - ovl_disc_pad) - ovl_disc_hdr_radius).abs() < 0.01, "Disclosure concentric: 22 - 6 == 16")
  debug_assert(((ctrl_chip_r - ctrl_chip_pad_rm) - ctrl_chip_rm_size / 2.0).abs() < 0.01, "Chip remove concentric: 13 - 4 == 9")
}

test "lg_inputs_floating_glass_zero_resting_edge" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let f1 = ui::Field::new()
    let f2 = ui::Field::new()
    let f3 = ui::Field::new()
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_text_field_node(page, f1, placeholder="Field")
        let _ = liquid_search_bar_node(page, f2, placeholder="Floating Search")
        let _ = liquid_search_bar_node(page, f3, placeholder="Flat Search", flat=true)
      },
      dark=dark,
      w=640.0,
      h=320.0,
    )
    t.run_shown(springs_out)
    let mut glass_inputs = 0
    let mut flat_edged = 0
    for d in t.drawn() {
      if d.glass.is_some() {
        glass_inputs += 1
        debug_assert(d.edge.0 == 0.0, "floating glass text_field/search_bar at rest must have edge width 0.0, got \{d.edge.0}")
      } else if (d.edge.0 - ctrl_hairline_w).abs() < 0.01 && (d.h - ctrl_input_h).abs() < 0.01 {
        flat_edged += 1
      }
    }
    debug_assert(glass_inputs == 2, "expected 2 floating glass inputs, got \{glass_inputs}")
    debug_assert(flat_edged == 1, "flat=true search bar must retain hairline edge")
    assert_no_nested_glass(t, label="inputs floating glass resting edge")
    t.dispose()
  }
}

test "lg_all_floating_glass_surfaces_unified_no_resting_edge" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let seg = signals::signal(0)
    let qty = signals::signal(4)
    let sel_idx = signals::signal(0)
    let menu_open = signals::signal(false)
    let tab_idx = signals::signal(0)
    let f1 = ui::Field::new()
    let f2 = ui::Field::new()
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(row1 : view::View) -> Unit {
          let _ = row1.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_button_node(row1, fn() { "Btn" }, fn() -> Unit { () })
          let _ = liquid_icon_button_node(
            row1,
            fn() { "Icon" },
            fn(c : view::View, ink : () -> Int64) -> Unit { flight_icon(c, 16.0, ink) },
            fn() -> Unit { () },
          )
          let _ = liquid_button_group_node(row1, fn() {
            [
              LiquidGroupAction::new(label=fn() { "G1" }, icon=fn(c, ink) { flight_icon(c, 14.0, ink) }, press=fn() { () }),
              LiquidGroupAction::new(label=fn() { "G2" }, icon=fn(c, ink) { flight_icon(c, 14.0, ink) }, press=fn() { () }),
            ]
          })
          let _ = liquid_chip_node(row1, fn() { "Chip" }, fn() -> Unit { () })
          let _ = liquid_stepper_node(row1, fn() { qty.get() }, fn(v : Int) -> Unit { qty.set(v) }, label=fn() { "Qty" })
        })
        let _ = page.box(fn(row2 : view::View) -> Unit {
          let _ = row2.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_segmented_node(row2, fn() { ["A", "B"] }, fn() { seg.get() }, fn(i : Int) -> Unit { seg.set(i) }, width=180.0)
          let _ = liquid_select_node(
            row2,
            page,
            fn() { [LiquidSelectOption::new(label="Opt1"), LiquidSelectOption::new(label="Opt2")] },
            fn() { sel_idx.get() },
            fn(i : Int) -> Unit { sel_idx.set(i) },
            width=160.0,
          )
          let _ = liquid_menu_button_node(
            row2,
            page,
            fn() { menu_open.get() },
            fn(v : Bool) -> Unit { menu_open.set(v) },
            fn() { "Menu" },
            fn() { [LiquidMenuEntry::item(label="One", on_select=fn() { () })] },
          )
        })
        let _ = page.box(fn(row3 : view::View) -> Unit {
          let _ = row3.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = row3.box(fn(w1 : view::View) -> Unit {
            let _ = w1.width(view::Live::Is(Some(220.0)))
            let _ = liquid_text_field_node(w1, f1, placeholder="Text")
          })
          let _ = row3.box(fn(w2 : view::View) -> Unit {
            let _ = w2.width(view::Live::Is(Some(220.0)))
            let _ = liquid_search_bar_node(w2, f2, placeholder="Search")
          })
        })
        let _ = page.box(fn(row4 : view::View) -> Unit {
          let _ = row4.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_toolbar_node(row4, fn(bar : view::View) -> Unit {
            let _ = liquid_button_node(bar, fn() { "Tool" }, fn() -> Unit { () }, flat=true, ghost=true, height=32.0, pad_x=10.0)
          })
          let _ = liquid_panel_node(row4, fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Panel"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
            })
          })
        })
        let _ = page.box(fn(tabs_wrap : view::View) -> Unit {
          let _ = tabs_wrap.width(view::Live::Is(Some(320.0)))
          let _ = liquid_bottom_tabs_node(tabs_wrap, ["One", "Two"], fn() { tab_idx.get() }, fn(i : Int) -> Unit { tab_idx.set(i) }, label="Unified Tabs")
        })
      },
      dark=dark,
      w=960.0,
      h=760.0,
    )
    t.run_shown(springs_out)
    let mut liquid_n = 0
    for d in t.drawn() {
      if d.glass.is_some() {
        liquid_n += 1
        debug_assert(d.edge.0 == 0.0, "all floating Glass::liquid surfaces at rest must have edge.0 == 0.0, got \{d.edge.0}")
        debug_assert(d.shadow.0 > 0.0, "all floating Glass::liquid surfaces must carry outside shadow")
      }
    }
    debug_assert(liquid_n == 13 && count_liquid_glass(t) == 13, "expected 13 floating Glass::liquid surfaces, got \{liquid_n}")
    assert_no_nested_glass(t, label="all floating glass surfaces unified")
    t.dispose()
  }
}

test "lg_glass_lift_surface_continuous_strength_and_solid_fallback" {
  let modes = [false, true]
  for dark in modes {
    let progress = signals::signal(0.0)
    ui::set_glass_solid(None)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = page.box(fn(card : view::View) -> Unit {
          let _ = card.width(view::Live::Is(Some(320.0))).padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
          let _ = lg_glass_lift_surface(
            card,
            fn() { progress.get() },
            18.0,
            flat_ground=fn() { if is_dark() { 0x1E1F24FFL } else { 0xF5F5F7FFL } },
          )
          let _ = card.box(fn(w : view::View) -> Unit {
            let _ = w.words(view::Live::Is("Lifted Row"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
          })
        })
      },
      dark=dark,
      w=400.0,
      h=240.0,
    )
    // t = 0.0: zero glass instances
    debug_assert(count_liquid_glass(t) == 0, "lift rest emits 0 glass")
    // t = 0.5: 1 liquid glass instance
    progress.set(0.5)
    t.fake.frame_requested = true
    t.frame(ms=16.0)
    debug_assert(count_liquid_glass(t) == 1, "lift mid emits 1 liquid glass")
    assert_no_nested_glass(t, label="glass_lift mid")
    // t = 1.0: 1 liquid glass instance
    progress.set(1.0)
    t.fake.frame_requested = true
    t.frame(ms=16.0)
    debug_assert(count_liquid_glass(t) == 1, "lift full emits 1 liquid glass")
    // overshoot clamps cleanly
    progress.set(-0.2)
    t.fake.frame_requested = true
    t.frame(ms=16.0)
    debug_assert(count_liquid_glass(t) == 0, "lift negative overshoot emits 0 glass")
    // solid fallback
    ui::set_glass_solid(Some(true))
    progress.set(0.5)
    t.fake.frame_requested = true
    t.frame(ms=16.0)
    debug_assert(count_liquid_glass(t) == 0, "lift solid fallback emits 0 glass")
    ui::set_glass_solid(None)
    t.dispose()
  }
}

test "lg_sheet_and_drawer_glass_symmetric_80_to_86_parity" {
  let modes = [false, true]
  for dark in modes {
    set_dark(Some(dark))
    let expected_rest = if dark { 0x202020CCL } else { 0xFDFCFDCCL }
    let expected_full = if dark { 0x202020DCL } else { 0xFDFCFDDCL }
    let sg = lg_sheet_glass()
    let dg = lg_drawer_glass()
    debug_assert(sg.tint == expected_rest, "lg_sheet_glass symmetric 80% tint")
    debug_assert(dg.tint == expected_rest, "lg_drawer_glass symmetric 80% tint")
    let sg_exp = lg_sheet_glass_at(1.0)
    debug_assert(sg_exp.tint == expected_full, "lg_sheet_glass_at(1.0) symmetric 86% tint")
    debug_assert(sg_exp.blur > sg.blur, "expanded blur increases")
    debug_assert(sg_exp.refraction < sg.refraction, "expanded refraction decreases")
    debug_assert((sg_exp.rim - 0.45).abs() < 0.01, "expanded rim == 0.45")
  }
  set_dark(None)
}

test "lg_liquid_drawer_leading_trailing_drag_and_zero_nested_glass" {
  let modes = [false, true]
  let sides = [DrawerSide::Leading, DrawerSide::Trailing]
  for dark in modes {
    for side in sides {
      let open = signals::signal(true)
      let t = lg_case(
        fn(page : view::View) -> Unit {
          let _ = liquid_drawer_node(
            page,
            fn() { open.get() },
            fn() { open.set(false) },
            fn() { "Inspector Drawer" },
            fn(b : view::View) -> Unit {
              let _ = liquid_list_node(
                b,
                fn() {
                  [
                    LiquidListRow::new(title="Dense Glass", value="80%"),
                    LiquidListRow::new(title="Spring Settle", value="60 fps"),
                  ]
                },
                dividers=false,
                flat=true,
              )
            },
            side=side,
            width=320.0,
            subtitle=fn() { "Floating Island" },
          )
        },
        dark=dark,
        w=900.0,
        h=700.0,
      )
      t.run_shown(springs_out)
      let rect = require_drawn(t, "Inspector Drawer", view::Role::Dialog)
      let expected_x = match side {
        DrawerSide::Leading => ovl_drawer_inset
        DrawerSide::Trailing => 900.0 - 320.0 - ovl_drawer_inset
      }
      debug_assert((rect.x - expected_x).abs() < 1.5, "drawer x=\{rect.x} expected \{expected_x}")
      debug_assert((rect.y - ovl_drawer_inset).abs() < 1.5, "drawer y=\{rect.y} expected \{ovl_drawer_inset}")
      debug_assert((rect.h - (700.0 - 2.0 * ovl_drawer_inset)).abs() < 1.5, "drawer h=\{rect.h}")
      debug_assert(count_liquid_glass(t) == 1, "drawer emits strictly 1 liquid glass")
      assert_no_nested_glass(t, label="liquid_drawer")

      // Over-pull toward expand direction -> rubber-band and stays open
      let cx = rect.x + rect.w / 2.0
      let cy = rect.y + rect.h / 2.0
      let expand_dx = match side {
        DrawerSide::Leading => 120.0
        DrawerSide::Trailing => -120.0
      }
      t.drag(cx, cy, cx + expand_dx, cy, steps=4)
      t.run_shown(springs_out)
      debug_assert(open.get(), "over-pull must keep drawer open")
      let after_over = require_drawn(t, "Inspector Drawer", view::Role::Dialog)
      debug_assert((after_over.x - expected_x).abs() < 1.5, "drawer springs back after over-pull")

      // Drag toward dismiss past 32% width -> closes cleanly
      let dismiss_dx = match side {
        DrawerSide::Leading => -160.0
        DrawerSide::Trailing => 160.0
      }
      t.drag(cx, cy, cx + dismiss_dx, cy, steps=6)
      t.run_shown(springs_out)
      debug_assert(!open.get(), "drag past 32% width must dismiss drawer")
      debug_assert(count_liquid_glass(t) == 0, "dismissed drawer emits 0 glass")
      t.dispose()
    }
  }
}

test "lg_liquid_sheet_responsive_detents_wide_and_narrow_zero_nested_glass" {
  // 1. Wide desktop (900x700): stays floating with symmetric close button
  let modes = [false, true]
  for dark in modes {
    let open = signals::signal(true)
    let exp = signals::signal(false)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_sheet_node(
          page,
          fn() { open.get() },
          fn() { open.set(false) },
          fn() { "Detent Sheet" },
          fn(b : view::View) -> Unit {
            let _ = b.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Morphing detent body"), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content }))
            })
          },
          subtitle=fn() { "Medium to Large" },
          detents=true,
          expanded=fn() { exp.get() },
          on_expanded=fn(v : Bool) -> Unit { exp.set(v) },
        )
      },
      dark=dark,
      w=900.0,
      h=700.0,
    )
    t.run_shown(springs_out)
    let r_med = require_drawn(t, "Detent Sheet", view::Role::Dialog)
    let close_r = require_drawn(t, "Close", view::Role::Button)
    let close_top_gap = close_r.y - r_med.y
    let close_right_gap = r_med.x + r_med.w - (close_r.x + close_r.w)
    debug_assert((close_top_gap - close_right_gap).abs() < 0.6, "close button symmetric top/right")
    debug_assert((close_top_gap - 12.0).abs() < 0.6, "close top gap == 12pt")
    debug_assert(count_liquid_glass(t) == 1, "detent sheet emits 1 liquid glass")
    assert_no_nested_glass(t, label="sheet-detent-wide-med")

    // Expand to Large detent on wide desktop -> taller while still floating
    let exp_btn = require_drawn(t, "Expand Sheet", view::Role::Button)
    t.tap(exp_btn.x + exp_btn.w / 2.0, exp_btn.y + exp_btn.h / 2.0)
    t.run_shown(springs_out)
    debug_assert(exp.get(), "Expand Sheet sets expanded=true")
    let r_large = require_drawn(t, "Detent Sheet", view::Role::Dialog)
    debug_assert(r_large.h > r_med.h + 120.0, "Large detent grows taller")
    debug_assert((700.0 - (r_large.y + r_large.h) - ovl_sheet_wide_inset).abs() < 1.5, "wide Large stays floating")
    assert_no_nested_glass(t, label="sheet-detent-wide-large")

    // Collapse back to Medium
    let col_btn = require_drawn(t, "Collapse Sheet", view::Role::Button)
    t.tap(col_btn.x + col_btn.w / 2.0, col_btn.y + col_btn.h / 2.0)
    t.run_shown(springs_out)
    debug_assert(!exp.get(), "Collapse Sheet sets expanded=false")

    // Drag header downward > 80pt -> dismisses sheet
    let r_back = require_drawn(t, "Detent Sheet", view::Role::Dialog)
    let hx = r_back.x + r_back.w / 2.0
    let hy = r_back.y + 40.0
    t.drag(hx, hy, hx, hy + 130.0, steps=6)
    t.run_shown(springs_out)
    debug_assert(!open.get(), "drag down > 80pt dismisses sheet")
    debug_assert(count_liquid_glass(t) == 0, "dismissed sheet emits 0 glass")
    t.dispose()
  }

  // 2. Narrow phone (390x720): Medium floats with 10pt inset, Large docks flush on left/right/bottom (0pt)
  let open_m = signals::signal(true)
  let exp_m = signals::signal(false)
  let tm = lg_case(
    fn(page : view::View) -> Unit {
      let _ = liquid_sheet_node(
        page,
        fn() { open_m.get() },
        fn() { open_m.set(false) },
        fn() { "Phone Sheet" },
        fn(b : view::View) -> Unit {
          let _ = b.box(fn(w : view::View) -> Unit {
            let _ = w.words(view::Live::Is("Phone sheet body"), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content }))
          })
        },
        width=390.0,
        detents=true,
        expanded=fn() { exp_m.get() },
        on_expanded=fn(v : Bool) -> Unit { exp_m.set(v) },
      )
    },
    dark=false,
    w=390.0,
    h=720.0,
  )
  tm.run_shown(springs_out)
  let rm_med = require_drawn(tm, "Phone Sheet", view::Role::Dialog)
  debug_assert((rm_med.x - ovl_sheet_inset).abs() < 1.5, "phone medium left inset")
  debug_assert((390.0 - (rm_med.x + rm_med.w) - ovl_sheet_inset).abs() < 1.5, "phone medium right inset")
  debug_assert((720.0 - (rm_med.y + rm_med.h) - ovl_sheet_inset).abs() < 1.5, "phone medium bottom inset")
  let eb = require_drawn(tm, "Expand Sheet", view::Role::Button)
  tm.tap(eb.x + eb.w / 2.0, eb.y + eb.h / 2.0)
  tm.run_shown(springs_out)
  let rm_large = require_drawn(tm, "Phone Sheet", view::Role::Dialog)
  debug_assert(rm_large.x.abs() < 1.0, "phone large docks left flush")
  debug_assert((390.0 - (rm_large.x + rm_large.w)).abs() < 1.0, "phone large docks right flush")
  debug_assert((720.0 - (rm_large.y + rm_large.h)).abs() < 1.5, "phone large docks bottom flush")
  assert_no_nested_glass(tm, label="sheet-detent-phone-large")
  tm.dispose()
}

test "lg_bar_pill_group_concentric_single_glass_and_solid_fallback" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let clicks = ui::ref_new(0)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_bar_pill_group_node(
          page,
          fn(pill : view::View) -> Unit {
            let _ = liquid_button_node(
              pill,
              fn() { "Share" },
              fn() -> Unit { clicks.v = clicks.v + 1 },
              flat=true,
              ghost=true,
              pad_x=12.0,
            )
            let _ = liquid_button_node(
              pill,
              fn() { "Export" },
              fn() -> Unit { clicks.v = clicks.v + 10 },
              flat=true,
              ghost=true,
              pad_x=12.0,
            )
          },
          label=fn() { "Top Bar Pill" },
        )
      },
      dark=dark,
      w=480.0,
      h=160.0,
    )
    t.set_a11y(true)
    t.run_shown(springs_out)
    let pill = require_drawn(t, "Top Bar Pill", view::Role::Group)
    let share = require_drawn(t, "Share", view::Role::Button)
    let exp = require_drawn(t, "Export", view::Role::Button)
    debug_assert((pill.h - 34.0).abs() < 0.01, "bar pill group default height must be 34pt")
    debug_assert((share.h - 30.0).abs() < 0.01 && (exp.h - 30.0).abs() < 0.01, "inner buttons must be 30pt")
    debug_assert(((pill.h / 2.0 - 2.0) - share.h / 2.0).abs() < 0.01, "bar pill concentric: 17 - 2 == 15")
    debug_assert((share.y - pill.y - 2.0).abs() < 0.01, "inner button top inset must be 2pt")
    debug_assert((share.x - pill.x - 2.0).abs() < 0.01, "first inner button left inset must be 2pt")
    debug_assert(count_liquid_glass(t) == 1, "bar pill group must emit strictly 1 liquid glass")
    let expected_shadow = if dark { 6.0 } else { 4.0 }
    debug_assert((pill.shadow.0 - expected_shadow).abs() < 0.01, "bar pill group must use tight lg_bar_pill_shadow")
    debug_assert(pill.edge.0 == 0.0, "bar pill group at rest has 0 edge width")
    assert_no_nested_glass(t, label="bar_pill_group")
    assert_clean_tester(t, "bar_pill_group")
    t.press("Share")
    t.run_shown(springs_out)
    debug_assert(clicks.v == 1, "clicking Share inside bar pill group triggers press")
    t.dispose()

    // glass_solid() fallback: 0 liquid glass, 1pt hairline edge, 0 faults
    ui::set_glass_solid(Some(true))
    let ts = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_bar_pill_group_node(
          page,
          fn(pill : view::View) -> Unit {
            let _ = liquid_button_node(pill, fn() { "Share" }, fn() -> Unit { () }, flat=true, ghost=true, pad_x=12.0)
          },
          label=fn() { "Solid Pill" },
        )
      },
      dark=dark,
      w=480.0,
      h=160.0,
    )
    ts.run_shown(springs_out)
    let solid_pill = require_drawn(ts, "Solid Pill", view::Role::Group)
    debug_assert(count_liquid_glass(ts) == 0, "glass_solid=true bar pill group emits 0 liquid glass")
    debug_assert((solid_pill.edge.0 - 1.0).abs() < 0.01, "glass_solid=true bar pill group shows 1pt hairline edge")
    assert_clean_tester(ts, "bar_pill_group solid")
    ui::set_glass_solid(None)
    ts.dispose()
  }
}

test "lg_capsule_lens_panel_and_collapsible_tabs_slide_invariants" {
  ui::set_glass_solid(None)
  // 1. liquid_capsule_node + liquid_panel_shell_node + liquid_lens_overlay_node: zero hidden glass at rest
  let lens_sig = signals::signal(0.0)
  let t1 = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_capsule_node(p, fn(c) {
      let _ = c.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(36.0)))
    }, radius=Some(18.0))
    let _ = liquid_panel_shell_node(p, fn(panel) {
      let _ = panel.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(80.0)))
    })
    liquid_lens_overlay_node(p, fn() { lens_sig.get() }, fn() { 30.0 }, width=fn() { 80.0 })
  })
  t1.run_shown(springs_out)
  debug_assert(count_liquid_glass(t1) == 2, "capsule + panel emit 2 glass; idle lens overlay emits 0")
  assert_no_nested_glass(t1, label="capsule_panel_lens")
  t1.dispose()

  // 2. liquid_collapsible_tabs_node: minimized trailing orb slides tightly beside 46x46 orb (x == ctab_h + ctab_gap == 56)
  let sel = signals::signal(0)
  let min_sig = signals::signal(false)
  let t2 = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_collapsible_tabs_node(
      p,
      ["Home", "Browse", "Radio"],
      fn() { sel.get() },
      fn(i) { sel.set(i) },
      fn() { min_sig.get() },
      fn() { min_sig.set(false) },
      fn() { () },
      action_label=fn() { "Collapsible Search" },
      expanded_width=260.0,
    )
  })
  t2.set_a11y(true)
  t2.run_shown(springs_out)
  let act_exp = require_drawn(t2, "Collapsible Search", view::Role::Button)
  min_sig.set(true)
  t2.run_shown(springs_out)
  let act_min = require_drawn(t2, "Collapsible Search", view::Role::Button)
  let exp_orb = require_drawn(t2, "Expand Home", view::Role::Button)
  debug_assert((exp_orb.w - 46.0).abs() < 0.5 && (exp_orb.h - 46.0).abs() < 0.5, "collapsed tab orb must be 46x46")
  debug_assert(act_min.x < act_exp.x - 150.0, "trailing action orb must slide left when minimized")
  debug_assert(((act_min.x - (exp_orb.x + exp_orb.w)) - 10.0).abs() < 1.0, "trailing orb must sit 10pt beside collapsed orb")
  assert_no_nested_glass(t2, label="collapsible_tabs_minimized")
  t2.dispose()

  // 3. liquid_bottom_tabs_node compact desktop height=44.0
  let tab_sel = signals::signal(0)
  let t3 = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(460.0)))
      let _ = liquid_bottom_tabs_node(
        b,
        ["A", "B", "C", "D"],
        fn() { tab_sel.get() },
        fn(i) { tab_sel.set(i) },
        label="Compact Dock",
        height=44.0,
      )
    })
  })
  t3.set_a11y(true)
  t3.run_shown(springs_out)
  let tab_a = require_drawn(t3, "A", view::Role::Tab)
  debug_assert((tab_a.h - 44.0).abs() < 0.5, "desktop compact bottom tabs must honor height=44.0")
  assert_no_nested_glass(t3, label="bottom_tabs_compact_44")
  t3.dispose()
}
