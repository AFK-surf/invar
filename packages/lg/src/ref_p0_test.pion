// Cross-package `signals::Ref[T]` identity and aliasing tests across
// `signals`, `view`, `headless_core`, `ui`, and `lg`.

import "headless_core"
import "signals"
import "ui"
import "view"

fn lg_bump_ref(r : signals::Ref[Int], delta : Int) -> Int {
  r.v = r.v + delta
  r.v
}

test "lg: cross-package Ref[T] across signals, view, headless_core, and ui" {
  let r_sig : signals::Ref[Int] = signals::ref_new(10)
  let r_view : signals::Ref[Int] = view::ref_new(20)
  let r_hc : signals::Ref[Int] = headless_core::ref_new(30)
  let r_ui : signals::Ref[Int] = ui::ref_new(40)

  // Strictly unique monotonically increasing phys_id across all 4 constructors
  debug_assert(r_sig.phys_id > 0, "signals::ref_new phys_id > 0")
  debug_assert(r_sig.phys_id < r_view.phys_id, "signals < view phys_id")
  debug_assert(r_view.phys_id < r_hc.phys_id, "view < headless_core phys_id")
  debug_assert(r_hc.phys_id < r_ui.phys_id, "headless_core < ui phys_id")

  // Alias write-back through lg helper
  let alias_hc = r_hc
  let alias_ui = r_ui
  debug_assert(lg_bump_ref(r_sig, 1) == 11 && r_sig.v == 11, "signals Ref mutated")
  debug_assert(lg_bump_ref(r_view, 2) == 22 && r_view.v == 22, "view Ref mutated")
  debug_assert(lg_bump_ref(r_hc, 3) == 33 && alias_hc.v == 33, "headless_core Ref alias write-back")
  debug_assert(lg_bump_ref(r_ui, 4) == 44 && alias_ui.v == 44, "ui Ref alias write-back")
}
