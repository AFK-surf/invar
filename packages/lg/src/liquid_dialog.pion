// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/DialogContent.kt. Over the page dimmed by
// the scrim's colour, a card of glass 40 in from the window's sides, its corners 48: what is under it brightened (by
// 0.2 in the light, none in the dark) and made vivid (a saturation of 1.5), blurred (16 in the light, 8 in the dark),
// bent by a lens 24 deep moving it by up to 48 with depth, its highlight Plain, the dialog's container colour over it.
// In it its title (24, medium) 28 in and 24 down, its words (15, at 68% of the words' colour, 5 lines at most) 24 in,
// and two capsule buttons 48 high side by side, 16 apart and 24 in: Cancel on the container's colour at 20%, the action
// on the accent in white. What it is to the keys and a screen reader is mbui's headless dialog's: modal, read out a
// dialog by its title, the focus taken in as it opens and given back as it goes, closed by Escape, the system's back
// and a press outside it (on the scrim).

import "headless"
import "paint"
import "view"

/// The card's glass (iOS 27 regular liquid glass, large card blur=8.0).
fn dialog_glass() -> paint::Glass {
  let d = is_dark()
  let c = colors()
  paint::Glass::liquid(
    blur=8.0,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=alpha(c.dialog_container, if d { 1.0 / 0.4 } else { 1.0 / 0.6 }),
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=48.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// One of a dialog's buttons in `parent`: a capsule 48 high taking its share of the row, its `label` (16) in `ink` on
/// `ground`; pressed, `press` is called.
fn dialog_button(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  ground : () -> Int64,
  ink : () -> Int64,
  loc~ : String = "",
) -> view::View {
  headless::button(parent, label, fn(_v) { press() }, fn(b, btn) {
    let _ = b
      .grow(view::Live::Is(1.0))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(button_h)))
      .padding(view::Live::Is((button_px, 0.0, button_px, 0.0)))
      .radius(view::Live::Is(button_h / 2.0))
      .ground(view::Live::By(ground))
    let _ = b.box(fn(w) { let _ = w.words(view::Live::By(label), look=words_at(type_body)).ink(view::Live::By(ink)) })
    b.show(fn() { btn.focus_shown() }, fn(ring) {
      let _ = ring
        .over(view::Live::Is(true))
        .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
        .radius(view::Live::Is(button_h / 2.0 + 3.0))
        .edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  }, made_for=loc)
}

/// A LiquidDialog in `parent` (the window's root, or a layer over all of it: what it is made in it covers), open while
/// `open` says: read out a dialog named `title`, its words `text`; `cancel` (its first button) and `close` (Escape,
/// back, a press on the scrim) tell `on_close`; its action, `action`, tells `on_action`. At most `width` wide in the
/// window's middle, 40 in from its sides. The node holding it.
pub fn liquid_dialog_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  text : () -> String,
  on_action~ : () -> Unit = fn() { () },
  cancel~ : () -> String = fn() { "Cancel" },
  action~ : () -> String = fn() { "Okay" },
  width~ : Double = 480.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h) {
    let _ = h.over(view::Live::Is(true))
    h.show(open, fn(s) {
      let _ = s.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = s.box(fn(scrim) { let _ = scrim.over(view::Live::Is(true)).ground(view::Live::By(fn() { colors().scrim })) })
      let _ = s.box(fn(room) {
        let _ = room
          .width(view::Live::Is(Some(width + 2.0 * dialog_inset)))
          .max_width(view::Live::Is(Some(width + 2.0 * dialog_inset)), within=true)
          .padding(view::Live::Is((dialog_inset, dialog_inset, dialog_inset, dialog_inset)))
        let _ = headless::dialog(room, title, open, on_close, fn(card, _dlg) {
          let _ = card
            .radius(view::Live::Is(dialog_radius))
            .shadow(view::Live::Is(shadow_default))
            .glass(view::Live::By(fn() { Some(dialog_glass()) }))
          let _ = card.box(fn(t) {
            let _ = t.padding(view::Live::Is((28.0, 24.0, 28.0, 12.0)))
            let _ = t.box(fn(w) {
              let _ = w
                .words(view::Live::By(title), look=words_at(type_title, weight=weight_medium, wrap=true))
                .ink(view::Live::By(fn() { colors().content }))
            })
          })
          let _ = card.box(fn(t) {
            let _ = t.padding(view::Live::Is((24.0, 12.0, 24.0, 12.0)))
            let _ = t.box(fn(w) {
              let _ = w
                .words(view::Live::By(text), look=words_at(type_dialog_text, wrap=true, lines=5))
                .ink(view::Live::By(fn() { alpha(colors().content, 0.68) }))
            })
          })
          let _ = card.box(fn(r) {
            let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((24.0, 12.0, 24.0, 24.0)))
            let _ = dialog_button(r, cancel, on_close, cancel_ground, fn() { colors().content })
            let _ = dialog_button(r, action, on_action, fn() { colors().accent }, fn() { white })
          })
        }, description=text)
      })
    })
  })
}

/// The Cancel button's ground: the dialog's container colour at 20% (`containerColor.copy(0.2f)`: its alpha put, not
/// scaled).
fn cancel_ground() -> Int64 {
  (colors().dialog_container & 0xFFFFFF00L) | 0x33L
}
