// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/DialogContent.kt.

import "headless"
import "motion"
import "paint"
import "view"

fn dialog_glass() -> paint::Glass {
  let d = is_dark()
  let c = colors()
  paint::Glass::liquid(
    blur=8.0,
    tint=if d { 0x202020BFL } else { 0xFDFCFDBFL },
    solid=alpha(c.dialog_container, if d { 1.0 / 0.4 } else { 1.0 / 0.6 }),
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=36.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

fn dialog_button(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  ground : () -> Int64,
  ink : () -> Int64,
  loc~ : String = "",
) -> view::View {
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, fn(b : view::View, btn : headless::Button) -> Unit {
    let _ = b
      .grow(view::Live::Is(1.0))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(button_h)))
      .padding(view::Live::Is((button_px, 0.0, button_px, 0.0)))
      .radius(view::Live::Is(button_h / 2.0))
      .ground(view::Live::By(ground))
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::By(label), look=words_at(type_body)).ink(view::Live::By(ink))
    })
    b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
      let _ = ring
        .over(view::Live::Is(true))
        .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
        .radius(view::Live::Is(button_h / 2.0 + 3.0))
        .edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  })
}

pub fn liquid_dialog_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  text : () -> String,
  on_action~ : () -> Unit = fn() -> Unit { () },
  cancel~ : () -> String = fn() { "Cancel" },
  action~ : () -> String = fn() { "Okay" },
  width~ : Double = 480.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    let shown_open = ovl_transitioned_bool(h, open)
    h.show(shown_open, leave=motion::dialog_out_ms, fn(s : view::View) -> Unit {
      let (look, live) = motion::overlay_presence(s, enter=motion::dialog_in, exit=motion::dialog_out)
      let _ = s.over(view::Live::Is(true)).points(view::Live::By(live)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = s.box(fn(scrim : view::View) -> Unit {
        let _ = scrim
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { colors().scrim }))
          .alpha(view::Live::By(fn() { look().alpha }))
      })
      let _ = s.box(fn(room : view::View) -> Unit {
        let _ = room
          .width(view::Live::Is(Some(width + 2.0 * dialog_inset)))
          .max_width(view::Live::Is(Some(width + 2.0 * dialog_inset)), within=true)
          .padding(view::Live::Is((dialog_inset, dialog_inset, dialog_inset, dialog_inset)))
        let _ = headless::dialog(room, title, open, on_close, description=text, fn(card : view::View, _dlg : headless::Dialog) -> Unit {
          let _ = card
            .radius(view::Live::Is(dialog_radius))
            .shadow(view::Live::Is(shadow_default))
            .shadow_outside(view::Live::Is(true))
            .glass(view::Live::By(fn() { Some(dialog_glass()) }))
            .alpha(view::Live::By(fn() { look().alpha }))
            .scale(view::Live::By(fn() { look().sx }))
            .offset(view::Live::By(fn() { (0.0, look().dy) }))
          let _ = card.box(fn(t : view::View) -> Unit {
            let _ = t.padding(view::Live::Is((20.0, 20.0, 20.0, 8.0)))
            let _ = t.box(fn(w : view::View) -> Unit {
              let _ = w
                .words(view::Live::By(title), look=words_at(type_title, weight=weight_medium, wrap=true))
                .ink(view::Live::By(fn() { colors().content }))
            })
          })
          let _ = card.box(fn(t : view::View) -> Unit {
            let _ = t.padding(view::Live::Is((20.0, 8.0, 20.0, 12.0)))
            let _ = t.box(fn(w : view::View) -> Unit {
              let _ = w
                .words(view::Live::By(text), look=words_at(type_dialog_text, wrap=true, lines=5))
                .ink(view::Live::By(fn() { alpha(colors().content, 0.68) }))
            })
          })
          let _ = card.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((10.0, 10.0, 10.0, 10.0)))
            let _ = dialog_button(r, cancel, on_close, cancel_ground, fn() { colors().content })
            let _ = dialog_button(r, action, on_action, fn() { colors().accent }, fn() { white })
          })
        })
      })
    })
  })
}

fn cancel_ground() -> Int64 {
  (colors().dialog_container & 0xFFFFFF00L) | 0x33L
}
