import "headless"
import "motion"
import "paint"
import "ui"
import "view"

/// Decorates an existing dialog container node `shell` in place (zero wrapper nodes) with symmetric dense
/// `liquid_dialog_glass`, optional light-mode veil override (`tint_light`, e.g. `0xFDFCFDD1L` 82%),
/// `shadow_outside(Is(true))`, solid-mode 1pt hairline fallback, and optional `radius` / `clips`.
pub fn liquid_dialog_surface_decorate(
  shell : view::View,
  radius? : Double,
  solid? : () -> Int64,
  tint_light? : Int64,
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = shell.radius(view::Live::Is(r))
    }
    None => ()
  }
  if clips {
    let _ = shell.clips(view::Live::Is(true))
  }
  let _ = shell
  .glass(
    view::Live::By(fn() {
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      let g = liquid_dialog_glass(solid=s)
      match tint_light {
        Some(tl) => if !is_dark() { Some(paint::Glass::{ ..g, tint: tl }) } else { Some(g) }
        None => Some(g)
      }
    }),
  )
  .edge(view::Live::By(fn() { if shell.glass_solid() || ui::glass_solid() { solid_edge() } else { (0.0, clear) } }))
  .shadow(view::Live::By(shadow))
  .shadow_outside(view::Live::Is(true))
  shell
}

/// Composable single-layer dense Liquid Glass dialog shell (`r=24pt` by default) with symmetric
/// `liquid_dialog_glass`, `glass_overlay_shadow`, `shadow_outside(Is(true))`, solid-mode 1pt hairline
/// fallback, and `clips(Is(true))`. Lets callers such as centered panels, confirm dialogs, and command
/// switchers own their routing, scroll body, and footer layout while reusing calibrated dialog optics.
pub fn liquid_dialog_shell_node(
  parent : view::View,
  body : (view::View) -> Unit,
  radius~ : Double = 24.0,
  solid? : () -> Int64,
  tint_light? : Int64,
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(shell : view::View) -> Unit {
    let _ = shell.lends(surface_context_lent, SurfaceContext::Content)
    let _ = liquid_dialog_surface_decorate(
      shell,
      radius?=Some(radius),
      solid?=solid,
      tint_light?=tint_light,
      shadow=shadow,
      solid_edge=solid_edge,
      clips=clips,
    )
    body(shell)
  })
}

/// Alert geometry: 24pt card radius, 30pt capsule buttons (r=15pt) inside 9pt padding -> 9 + 15 = 24pt exact concentric.
let dialog_card_radius : Double = 24.0
let dialog_button_h : Double = 30.0
/// 36pt hit target: the button reaches 3pt past the capsule above and below (zero visual shift).
let dialog_button_hit_h : Double = 36.0
let dialog_button_hit_out : Double = (dialog_button_hit_h - dialog_button_h) / 2.0

fn dialog_button(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  ground : () -> Int64,
  ink : () -> Int64,
  loc~ : String = "",
) -> view::View {
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, fn(b : view::View, btn : headless::Button) -> Unit {
    let btn_r = dialog_button_h / 2.0
    let hover_t = motion::hover_fade(b, fn() { btn.hovered() })
    let press_t = motion::hover_fade(b, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
    // 36pt hit area around the 30pt visual capsule: -3pt vertical margins keep layout height and the 9 + 15 = 24 concentric edge.
    let _ = b
    .grow(view::Live::Is(1.0))
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(dialog_button_hit_h)))
    .margin(view::Live::Is((0.0, -dialog_button_hit_out, 0.0, -dialog_button_hit_out)))
    .radius(view::Live::Is(dialog_button_hit_h / 2.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    let _ = b.box(fn(pill : view::View) -> Unit {
      let _ = pill
      .grow(view::Live::Is(1.0))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(dialog_button_h)))
      .padding(view::Live::Is((button_px, 0.0, button_px, 0.0)))
      .radius(view::Live::Is(btn_r))
      .ground(
        view::Live::By(fn() {
          let base = ground()
          let h = hover_t()
          let p = press_t()
          let with_hover = if h > 0.001 { over(base, alpha(ovl_row_hover(), h)) } else { base }
          if p > 0.001 {
            over(with_hover, alpha(ovl_row_press(), p))
          } else {
            with_hover
          }
        }),
      )
      let _ = pill.box(fn(w : view::View) -> Unit {
        let _ = w.words(view::Live::By(label), look=words_at(15.0, weight=weight_medium)).ink(view::Live::By(ink))
      })
      lg_focus_ring(pill, fn() { btn.focus_shown() }, btn_r)
    })
  })
}

/// A LiquidDialog in `parent` (the window's root, or a layer over all of it), open while `open` says.
/// Compact iOS 26/27 Alert proportions (`width=320pt`, `r=34pt`, concentric `40pt` buttons inside `14pt` padding).
pub fn liquid_dialog_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  text : () -> String,
  on_action~ : () -> Unit = fn() -> Unit { () },
  cancel~ : () -> String = fn() { "Cancel" },
  action~ : () -> String = fn() { "Okay" },
  width~ : Double = 320.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    let shown_open = ovl_transitioned_bool(h, open)
    h.show(shown_open, leave=motion::dialog_out_ms, fn(s : view::View) -> Unit {
      let (look, live) = motion::overlay_presence(s, enter=motion::dialog_in, exit=motion::dialog_out)
      let _ = s.over(view::Live::Is(true)).points(view::Live::By(live)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = s.box(fn(scrim : view::View) -> Unit {
        let _ = scrim
        .over(view::Live::Is(true))
        .ground(view::Live::By(fn() { colors().scrim }))
        .alpha(view::Live::By(fn() { look().alpha }))
      })
      let _ = s.box(fn(room : view::View) -> Unit {
        let _ = room
        .width(view::Live::Is(Some(width + 2.0 * dialog_inset)))
        .max_width(view::Live::Is(Some(width + 2.0 * dialog_inset)), within=true)
        .padding(view::Live::Is((dialog_inset, dialog_inset, dialog_inset, dialog_inset)))
        let _ = headless::dialog(room, title, open, on_close, description=text, fn(card : view::View, _dlg : headless::Dialog) -> Unit {
          let _ = card
          .radius(view::Live::Is(dialog_card_radius))
          .shadow(view::Live::By(glass_overlay_shadow))
          .shadow_outside(view::Live::Is(true))
          .glass(view::Live::By(fn() { Some(liquid_dialog_glass()) }))
          .edge(view::Live::By(fn() { if card.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
          .alpha(view::Live::By(fn() { look().alpha }))
          .scale(view::Live::By(fn() { look().sx }))
          .offset(view::Live::By(fn() { (0.0, look().dy) }))
          .lends(surface_context_lent, SurfaceContext::Content)
          let _ = card.box(fn(t : view::View) -> Unit {
            let _ = t.padding(view::Live::Is((20.0, 20.0, 20.0, 6.0)))
            let _ = t.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::By(title), look=words_at(17.0, weight=ovl_weight_semibold, wrap=true))
              .ink(view::Live::By(fn() { colors().content }))
            })
          })
          let _ = card.box(fn(t : view::View) -> Unit {
            let _ = t.padding(view::Live::Is((20.0, 0.0, 20.0, 20.0)))
            let _ = t.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::By(text), look=words_at(type_dialog_text, wrap=true, lines=5))
              .ink(view::Live::By(fn() { alpha(colors().content, if is_dark() { 0.78 } else { 0.72 }) }))
            })
          })
          let _ = card.box(fn(r : view::View) -> Unit {
            let _ = r
            .row(view::Live::Is(true))
            .gap(view::Live::Is(10.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((9.0, 0.0, 9.0, 9.0)))
            let _ = dialog_button(r, cancel, on_close, cancel_ground, fn() { colors().content })
            let _ = dialog_button(r, action, on_action, dialog_action_ground, fn() { white })
          })
        })
      })
    })
  })
}

/// The Cancel button's ground: iOS 26/27 `UIColor.systemFill` neutral capsule fill (`rgba(120,120,128,0.16)` in
/// Light so it stays crisp over light liquid glass, `rgba(255,255,255,0.16)` in Dark).
fn cancel_ground() -> Int64 {
  if is_dark() { 0xFFFFFF29L } else { 0x78788029L }
}

/// The primary Action button's ground: accessible iOS blue with >= 4.5:1 contrast against white label ink
/// (`#0066CC` 5.57:1 in Light, `#0071E3` 4.70:1 in Dark).
fn dialog_action_ground() -> Int64 {
  if is_dark() { 0x0071E3FFL } else { 0x0066CCFFL }
}
