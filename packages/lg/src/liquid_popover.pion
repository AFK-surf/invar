// Liquid Glass Popover and Tooltip components over headless::Popover and headless::tooltip_bubble.

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

fn popover_fade_ink(c : Int64, share : Double) -> Int64 {
  alpha(c, share)
}

/// Decorates an existing anchored popover container node `p` in place (zero wrapper nodes) in either:
/// 1. Standard anchored overlay mode (when `morph` is `None` or `p.glass_solid()` is true):
///    binds `liquid_panel_glass(solid=...)`, `shadow`, `shadow_outside(Is(true))`, solid hairline
///    fallback, and optional `alpha` / `scale`.
/// 2. iOS 27.0 liquid-bridge morph mode (when `morph` is `Some(eval)` and `!p.glass_solid()`):
///    encapsulates three-anchor `liquid_menu_morph_glass` optical interpolation, capillary `merge`/`layer`/`break_gap`,
///    `content_lens` blur/refraction (`kind == 8`, zero at rest), `ground_drawn` animated silhouette, `alpha` gating,
///    and smooth shadow ramp. Returns `p` for chaining.
pub fn liquid_popover_surface_decorate(
  p : view::View,
  radius? : Double,
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
  alpha? : () -> Double,
  scale? : () -> Double,
  scale_about~ : view::Pivot = view::Pivot::FromBeside,
  morph? : () -> Option[(Double, Bool, Double, Double, LiquidMorphFrame)],
  layer~ : Int = 0,
  break_gap~ : Double = 32.0,
  close_break_gap~ : Double = 24.0,
) -> view::View {
  let resolve_solid = fn() -> Int64 {
    match solid {
      Some(f) => f()
      None => clear
    }
  }
  match radius {
    Some(r) => {
      let _ = p.radius(view::Live::Is(r))
    }
    None => ()
  }
  if clips {
    let _ = p.clips(view::Live::Is(true))
  }
  let _ = p
  .edge(view::Live::By(fn() { if p.glass_solid() || ui::glass_solid() { solid_edge() } else { (0.0, clear) } }))
  .shadow_outside(view::Live::Is(true))
  match morph {
    Some(eval_morph) => {
      let _ = p
      .alpha(
        view::Live::By(fn() {
          match eval_morph() {
            Some((_, closing, _, _, f)) => {
              if closing && !f.platter_active {
                0.0
              } else if p.glass_solid() || ui::glass_solid() || ui::reduced_motion() {
                match alpha {
                  Some(af) => af()
                  None => 1.0
                }
              } else if !closing {
                if f.raw_value <= 0.001 { 0.0 } else { 1.0 }
              } else {
                1.0
              }
            }
            None =>
            match alpha {
              Some(af) => af()
              None => 1.0
            }
          }
        }),
      )
      .glass(
        view::Live::By(fn() {
          let s = resolve_solid()
          match eval_morph() {
            Some((t, closing, _, _, f)) => {
              if closing && !f.platter_active {
                None
              } else if p.glass_solid() || ui::glass_solid() || ui::reduced_motion() {
                Some(liquid_panel_glass(solid=s))
              } else if !closing {
                if f.raw_value <= 0.001 {
                  None
                } else {
                  let stage = 0.5 + 0.5 * lm_smoothstep(0.08, 0.20, t)
                  if f.open_anchor_scale > 0.15 {
                    Some(
                      liquid_menu_morph_glass(
                        stage,
                        solid=s,
                        merge=14.0 * f.open_anchor_scale,
                        layer=layer,
                        break_gap=break_gap,
                      ),
                    )
                  } else {
                    Some(liquid_menu_morph_glass(stage, solid=s))
                  }
                }
              } else {
                let stage = 0.5 * lm_smoothstep(0.0, 0.12, f.raw_value) +
                0.5 * lm_smoothstep(0.35, 0.95, f.raw_value)
                if f.blob_a_emerge > 0.001 {
                  Some(
                    liquid_menu_morph_glass(
                      stage,
                      solid=s,
                      merge=lm_close_blend(f.raw_value),
                      layer=layer,
                      break_gap=close_break_gap,
                    ),
                  )
                } else {
                  Some(liquid_menu_morph_glass(stage, solid=s))
                }
              }
            }
            None => Some(liquid_panel_glass(solid=s))
          }
        }),
      )
      .content_lens(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() || ui::reduced_motion() {
            return paint::ContentLens::none()
          }
          match eval_morph() {
            Some((_, _, _, _, f)) =>
            if f.content_opacity > 0.01 && f.content_blur > 0.05 {
              paint::ContentLens::{
                blur: f.content_blur,
                refraction: 6.0 * clamp(f.content_blur / 8.0, 0.0, 1.0),
                bezel: 24.0,
                alpha: f.content_opacity,
              }
            } else {
              paint::ContentLens::none()
            }
            None => paint::ContentLens::none()
          }
        }),
      )
      .shadow(
        view::Live::By(fn() {
          match eval_morph() {
            Some((_, closing, _, _, f)) => {
              if closing && !f.platter_active {
                shadow_none
              } else if p.glass_solid() || ui::glass_solid() || ui::reduced_motion() {
                shadow()
              } else {
                let ga = lm_smoothstep(0.25, 0.78, clamp(f.raw_value, 0.0, 1.0))
                if ga <= 0.001 {
                  shadow_none
                } else {
                  let (s, dy, ink) = shadow()
                  (s, dy, popover_fade_ink(ink, ga))
                }
              }
            }
            None => shadow()
          }
        }),
      )
      .ground_drawn(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() || ui::reduced_motion() {
            return view::ground_as_laid
          }
          match eval_morph() {
            Some((t, closing, w, h, f)) =>
            if w <= 0.0 || h <= 0.0 || (!closing && t >= lm_open_duration_ms / 1000.0 - 0.001) {
              view::ground_as_laid
            } else {
              let r = f.radius
              view::GroundShape::{ dx: f.mx, dy: f.my, dw: f.cur_w - w, dh: f.cur_h - h, corners: Some((r, r, r, r)) }
            }
            None => view::ground_as_laid
          }
        }),
      )
      p
    }
    None => {
      let _ = p.glass(view::Live::By(fn() { Some(liquid_panel_glass(solid=resolve_solid())) })).shadow(view::Live::By(shadow))
      match alpha {
        Some(af) => {
          let _ = p.alpha(view::Live::By(af))
        }
        None => ()
      }
      match scale {
        Some(sf) => {
          let _ = p.scale(view::Live::By(sf), about=scale_about)
        }
        None => ()
      }
      p
    }
  }
}

/// Decorates an existing tooltip node `v` in place (zero wrapper nodes) with `points(Is(false))` click-through,
/// `active` gating (submits `None` glass, zero edge, and zero shadow when inactive), `shadow_outside(Is(true))`,
/// solid hairline fallback, and single-layer liquid glass (`liquid_capsule_glass` by default, or
/// `liquid_panel_glass` when `panel=true`). Returns `v` for chaining.
pub fn liquid_tooltip_surface_decorate(
  v : view::View,
  radius? : Double,
  active~ : () -> Bool = fn() { true },
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  panel~ : Bool = false,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r))
    }
    None => ()
  }
  let _ = v
  .points(view::Live::Is(false))
  .glass(
    view::Live::By(fn() {
      if !active() {
        return None
      }
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      if panel {
        Some(liquid_panel_glass(solid=s))
      } else {
        Some(liquid_capsule_glass(solid=s))
      }
    }),
  )
  .edge(
    view::Live::By(fn() {
      if active() && (v.glass_solid() || ui::glass_solid()) {
        solid_edge()
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if active() {
        shadow()
      } else {
        shadow_none
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  v
}

let lg_tooltip_next_key : signals::Ref[Int] = ui::ref_new(0)

fn popover_attach_pill_trigger_morph(
  v : view::View,
  op : view::View,
  trig : PillTriggerScope,
  side : view::Side,
  along : view::Along,
  width : Double,
  radius : Double,
  pad : Double,
  content_look : (view::View) -> Unit,
  loc~ : String = "",
) -> Unit {
  match trig.morph_cancel {
    Some(cancel_prev) => cancel_prev()
    None => ()
  }
  trig.morph_owner += 1
  let my_owner = trig.morph_owner
  let superseded : signals::Signal[Bool] = signals::signal(false)
  let layer_leave_end = fref(0.0)
  let cancel_restore : signals::Ref[Option[() -> Unit]] = ui::ref_new(None)
  let cancel_close_delay : signals::Ref[Option[() -> Unit]] = ui::ref_new(None)
  let overlay_cleanups : Array[() -> Unit] = []
  let overlays_cleared = ui::ref_new(false)
  let clear_overlays = fn() -> Unit {
    if overlays_cleared.v {
      return
    }
    overlays_cleared.v = true
    let mut oi = 0
    while oi < overlay_cleanups.length() {
      (overlay_cleanups[oi])()
      oi += 1
    }
  }
  trig.morph_cancel = Some(fn() -> Unit {
    superseded.set(true)
    clear_overlays()
    match cancel_close_delay.v {
      Some(c) => {
        cancel_close_delay.v = None
        c()
      }
      None => ()
    }
    match cancel_restore.v {
      Some(c) => {
        cancel_restore.v = None
        c()
      }
      None => ()
    }
  })
  let (ax, ay, aw, ah) = op.placed_window_now()
  let pill_layer = ovl_next_morph_layer()
  let (pill_x, pill_y, pill_w_raw, pill_h_raw) = trig.pill.placed_window_now()
  let pill_h_eff = if pill_h_raw > 0.0 { pill_h_raw } else if trig.height > 0.0 { trig.height } else { ah }
  let pill_w = if pill_w_raw > 0.0 { pill_w_raw } else if trig.height > 0.0 { trig.height } else { aw }
  let core = dmin(pill_w, pill_h_eff)
  let tx_win = ax + aw * 0.5
  let ty_win = ay + ah * 0.5
  let tx_mid = clamp(tx_win - pill_x, core * 0.5, dmax(core * 0.5, pill_w - core * 0.5))
  let ty_mid = clamp(ty_win - pill_y, core * 0.5, dmax(core * 0.5, pill_h_eff - core * 0.5))
  let align_x = match along {
    Start => -1.0
    End => 1.0
    Middle => 0.0
  }
  let is_closing : signals::Signal[Bool] = signals::signal(false)
  let t_way = motion::NodeWay::new(0.0)
  let last_shell_bounds : signals::Ref[Option[(Double, Double, Double, Double)]] = ui::ref_new(None)
  let rest_glass = trig.rest_glass
  let trig_pill = trig.pill
  let trig_direction = trig.direction
  let (morph_pill_y, morph_pill_h) = match trig_direction {
    Vertical => (ty_win - core * 0.5, core)
    Horizontal => (pill_y, pill_h_eff)
  }
  let shell_bounds = fn() -> (Double, Double, Double, Double) {
    if v.alive() {
      let (px, py, w, h) = v.placed_window_now()
      if w > 0.0 && h > 0.0 {
        last_shell_bounds.v = Some((px, py, w, h))
        return (px, py, w, h)
      }
    }
    match last_shell_bounds.v {
      Some(b) => b
      None => (pill_x, morph_pill_y, dmax(pill_w, if width > 0.0 { width } else { 180.0 }), 220.0)
    }
  }
  let eval_frame = fn(px_win : Double, py_win : Double, mw : Double, mh : Double, closing : Bool, t : Double) -> LiquidMorphFrame {
    lm_eval_pill_morph(
      pill_x,
      morph_pill_y,
      pill_w,
      morph_pill_h,
      tx_win,
      px_win,
      py_win,
      mw,
      mh,
      radius,
      align_x,
      closing,
      t,
    )
  }
  let eval_trig = fn() -> (Double, Bool, LiquidMorphFrame) {
    let t = t_way.shown(trig_pill)
    let closing = is_closing.get()
    let (px_win, py_win, mw, mh) = shell_bounds()
    (t, closing, eval_frame(px_win, py_win, mw, mh, closing, t))
  }
  trig.morph_glass.v = Some(fn() -> Option[paint::Glass] {
    if ui::reduced_motion() {
      return Some(rest_glass())
    }
    let (t, closing, f) = eval_trig()
    if !closing {
      if f.open_anchor_scale <= 0.15 {
        None
      } else {
        let stage = 0.5 * lm_smoothstep(0.0, 0.06, t)
        Some(liquid_menu_morph_glass(stage, layer=pill_layer, break_gap=32.0))
      }
    } else if f.platter_active {
      if f.blob_a_emerge <= 0.001 {
        None
      } else {
        let stage = 0.5 * lm_smoothstep(0.0, 0.12, f.raw_value)
        Some(liquid_menu_morph_glass(stage, layer=pill_layer, break_gap=24.0))
      }
    } else {
      Some(rest_glass())
    }
  })
  trig.morph_shadow.v = Some(fn() -> (Double, Double, Int64) {
    if ui::reduced_motion() {
      return glass_control_shadow()
    }
    let (_, closing, f) = eval_trig()
    if closing && !f.platter_active {
      glass_control_shadow()
    } else {
      shadow_none
    }
  })
  let (sp0, _) = trig.fx.untracked()
  trig.fx.set((sp0, pill_layer))
  let bound_children : Array[view::View] = []
  if trig.children.length() > 0 {
    let mut ci = 0
    while ci < trig.children.length() {
      bound_children.push(trig.children[ci])
      ci += 1
    }
  } else if op.id() != trig.pill.id() {
    bound_children.push(op)
  }
  let pill_ov_stop = trig_pill.morph_overlay(
    offset=view::Live::By(fn() {
      if ui::reduced_motion() {
        return (0.0, 0.0)
      }
      let (_, closing, f) = eval_trig()
      if closing {
        (0.0, f.push_dy)
      } else {
        (0.0, 0.0)
      }
    }),
    scale=view::Live::By(fn() {
      if ui::reduced_motion() {
        return 1.0
      }
      let (t, closing, f) = eval_trig()
      if closing {
        lm_impact_scale(t, f.final_dy.abs())
      } else {
        1.0
      }
    }),
    ground_drawn=view::Live::By(fn() {
      if ui::reduced_motion() {
        return view::ground_as_laid
      }
      let (t, closing, f) = eval_trig()
      match trig_direction {
        Horizontal =>
        if !closing {
          let wp = lm_open_trigger_width(t)
          let cw = lm_lerp(core, pill_w, wp)
          let cx = lm_lerp(tx_mid, pill_w * 0.5, wp)
          let r = dmin(cw, pill_h_eff) * 0.5
          view::GroundShape::{ dx: cx - cw * 0.5, dy: 0.0, dw: cw - pill_w, dh: 0.0, corners: Some((r, r, r, r)) }
        } else if f.platter_active {
          let wp = lm_delayed_close_width(t)
          let cw = lm_lerp(core, pill_w, wp)
          let cx = lm_lerp(tx_mid, pill_w * 0.5, clamp(wp, 0.0, 1.0))
          let r = dmin(cw, pill_h_eff) * 0.5
          view::GroundShape::{ dx: cx - cw * 0.5, dy: 0.0, dw: cw - pill_w, dh: 0.0, corners: Some((r, r, r, r)) }
        } else {
          let raw_scale = lm_lerp(core, pill_w, lm_close_trigger_width(t)) / pill_w
          let cw = pill_w * clamp(raw_scale, 0.90, 1.04)
          let r = pill_h_eff * 0.5
          view::GroundShape::{ dx: (pill_w - cw) * 0.5, dy: 0.0, dw: cw - pill_w, dh: 0.0, corners: Some((r, r, r, r)) }
        }
        Vertical =>
        if !closing {
          let wp = lm_open_trigger_width(t)
          let ch = lm_lerp(core, pill_h_eff, wp)
          let cy = lm_lerp(ty_mid, pill_h_eff * 0.5, wp)
          let r = dmin(pill_w, ch) * 0.5
          view::GroundShape::{ dx: 0.0, dy: cy - ch * 0.5, dw: 0.0, dh: ch - pill_h_eff, corners: Some((r, r, r, r)) }
        } else if f.platter_active {
          let wp = lm_delayed_close_width(t)
          let ch = lm_lerp(core, pill_h_eff, wp)
          let cy = lm_lerp(ty_mid, pill_h_eff * 0.5, clamp(wp, 0.0, 1.0))
          let r = dmin(pill_w, ch) * 0.5
          view::GroundShape::{ dx: 0.0, dy: cy - ch * 0.5, dw: 0.0, dh: ch - pill_h_eff, corners: Some((r, r, r, r)) }
        } else {
          let raw_scale = lm_lerp(core, pill_h_eff, lm_close_trigger_width(t)) / pill_h_eff
          let ch = pill_h_eff * clamp(raw_scale, 0.90, 1.04)
          let r = pill_w * 0.5
          view::GroundShape::{ dx: 0.0, dy: (pill_h_eff - ch) * 0.5, dw: 0.0, dh: ch - pill_h_eff, corners: Some((r, r, r, r)) }
        }
      }
    }),
    alpha=view::Live::By(fn() {
      if ui::reduced_motion() {
        return 1.0
      }
      let (_, closing, f) = eval_trig()
      if !closing {
        if f.open_anchor_scale <= 0.15 { 0.0 } else { 1.0 }
      } else if f.platter_active {
        if f.blob_a_emerge <= 0.001 { 0.0 } else { 1.0 }
      } else {
        1.0
      }
    }),
  )
  overlay_cleanups.push(pill_ov_stop)
  let mut bi = 0
  while bi < bound_children.length() {
    let child = bound_children[bi]
    let (cx0, cy0, cw0, ch0) = child.placed_window_now()
    let child_cx_local = cx0 + cw0 * 0.5 - pill_x
    let child_cx_off = child_cx_local - pill_w * 0.5
    let child_to_tx = tx_mid - child_cx_local
    let child_cy_local = cy0 + ch0 * 0.5 - pill_y
    let child_cy_off = child_cy_local - pill_h_eff * 0.5
    let child_to_ty = ty_mid - child_cy_local
    let child_ov_stop = child.morph_overlay(
      alpha=view::Live::By(fn() {
        if ui::reduced_motion() {
          return 1.0
        }
        let t = t_way.shown(child)
        if is_closing.get() {
          if t < 0.19 { 0.0 } else { lm_smoothstep(0.19, 0.275, t) }
        } else {
          1.0 - lm_smoothstep(0.0, 0.032, t)
        }
      }),
      offset=view::Live::By(fn() {
        if ui::reduced_motion() {
          return (0.0, 0.0)
        }
        let t = t_way.shown(child)
        match trig_direction {
          Horizontal =>
          if !is_closing.get() {
            let wp = lm_open_trigger_width(t)
            (child_to_tx * (1.0 - wp) * 0.45, 0.0)
          } else {
            let w_prog = clamp(lm_delayed_close_width(t), 0.0, 1.0)
            let blob_a_w = lm_lerp(core, pill_w, w_prog)
            (-child_cx_off * (1.0 - clamp(blob_a_w / pill_w, 0.5, 1.0)), 0.0)
          }
          Vertical =>
          if !is_closing.get() {
            let wp = lm_open_trigger_width(t)
            (0.0, child_to_ty * (1.0 - wp) * 0.45)
          } else {
            let h_prog = clamp(lm_delayed_close_width(t), 0.0, 1.0)
            let blob_a_h = lm_lerp(core, pill_h_eff, h_prog)
            (0.0, -child_cy_off * (1.0 - clamp(blob_a_h / pill_h_eff, 0.5, 1.0)))
          }
        }
      }),
    )
    overlay_cleanups.push(child_ov_stop)
    bi += 1
  }
  let restored = ui::ref_new(false)
  let restore_trig = fn() -> Unit {
    clear_overlays()
    if restored.v || trig.morph_owner != my_owner {
      return
    }
    restored.v = true
    trig.morph_cancel = None
    match cancel_close_delay.v {
      Some(c) => {
        cancel_close_delay.v = None
        c()
      }
      None => ()
    }
    match cancel_restore.v {
      Some(c) => {
        cancel_restore.v = None
        c()
      }
      None => ()
    }
    let (sp, ly) = trig.fx.untracked()
    if ly == pill_layer || ly < 0 {
      trig.morph_glass.v = None
      trig.morph_shadow.v = None
      trig.fx.set((sp, 0))
    }
  }
  let _ = v.owns(fn() -> Unit {
    if !is_closing.untracked() || superseded.untracked() || !trig.pill.alive() {
      restore_trig()
    }
  })
  let start_close = fn(at_ms : Double) -> Unit {
    if trig.morph_owner != my_owner || superseded.untracked() {
      return
    }
    is_closing.set(true)
    if trig.pill.alive() {
      let (sp, _) = trig.fx.untracked()
      trig.fx.set((sp, pill_layer))
      t_way.go_from(
        trig.pill,
        0.0,
        lm_close_duration_ms / 1000.0,
        motion::tween(lm_close_duration_ms, ease=ui::Ease::Linear),
        at=at_ms,
      )
      cancel_restore.v = Some(
        trig.pill.at_moment(at_ms + lm_close_duration_ms + 1.0, fn() -> Unit { restore_trig() }),
      )
    } else {
      t_way.go_from(
        v,
        0.0,
        lm_close_duration_ms / 1000.0,
        motion::tween(lm_close_duration_ms, ease=ui::Ease::Linear),
        at=at_ms,
      )
    }
  }
  v.reacts(fn() { v.leaving() }, fn(leaving : Bool) -> Unit {
    if trig.morph_owner != my_owner || superseded.untracked() {
      return
    }
    if leaving {
      let cause = v.cause_at()
      let t_open = t_way.value_at(cause)
      let settle_delay_ms = if t_open < 0.23 {
        dmin(180.0, (0.23 - t_open) * 1000.0)
      } else {
        0.0
      }
      layer_leave_end.v = cause + settle_delay_ms + 300.0
      if settle_delay_ms <= 0.0 {
        start_close(cause)
      } else {
        let start_at = cause + settle_delay_ms
        let timer_host = if trig.pill.alive() { trig.pill } else { v }
        cancel_close_delay.v = Some(
          timer_host.at_moment(start_at, fn() -> Unit {
            cancel_close_delay.v = None
            start_close(start_at)
          }),
        )
      }
    } else {
      t_way.go_from(
        v,
        0.0,
        lm_open_duration_ms / 1000.0,
        motion::tween(lm_open_duration_ms, ease=ui::Ease::Linear),
      )
    }
  })
  let eff_offset = match side {
    Bottom => -(ah + trig.pad)
    Top => -(ah + trig.pad)
    Left => -(aw + trig.pad)
    Right => -(aw + trig.pad)
  }
  let eff_along_offset = match along {
    End => trig.pad
    Start => -trig.pad
    Middle => 0.0
  }
  let _ = v.beside(
    op.id(),
    side=side,
    along=along,
    offset=eff_offset,
    along_offset=eff_along_offset,
    padding=ovl_float_pad,
  )
  if width > 0.0 {
    let _ = v.width(view::Live::Is(Some(width)))
  }
  let cur_morph_t = fref(0.0)
  let _ = liquid_popover_surface_decorate(
    v,
    radius=radius,
    morph=fn() -> Option[(Double, Bool, Double, Double, LiquidMorphFrame)] {
      if superseded.get() {
        return Some(
          (
            0.0,
            true,
            1.0,
            1.0,
            LiquidMorphFrame::{
              mx: 0.0,
              my: 0.0,
              cur_w: 1.0,
              cur_h: 1.0,
              radius: 0.0,
              raw_value: 0.0,
              push_dy: 0.0,
              platter_active: false,
              content_opacity: 0.0,
              content_blur: 0.0,
              final_dy: 0.0,
              open_anchor_scale: 0.0,
              blob_a_emerge: 0.0,
            },
          ),
        )
      }
      let t = t_way.shown(v)
      cur_morph_t.v = t
      let closing = is_closing.get()
      let (px_win, py_win, w, h) = v.placed_window_now()
      let f = eval_frame(px_win, py_win, dmax(w, 1.0), dmax(h, 1.0), closing, t)
      Some((t, closing, w, h, f))
    },
    layer=pill_layer,
    break_gap=32.0,
    close_break_gap=24.0,
  )
  let _ = v.morph_overlay(
    ground_drawn_fn=fn(px_win : Double, py_win : Double, w : Double, h : Double) -> view::GroundShape {
      if v.glass_solid() || ui::glass_solid() || ui::reduced_motion() || w <= 0.0 || h <= 0.0 {
        return view::ground_as_laid
      }
      if superseded.untracked() {
        return view::GroundShape::{ dx: 0.0, dy: 0.0, dw: 1.0 - w, dh: 1.0 - h, corners: Some((0.0, 0.0, 0.0, 0.0)) }
      }
      let t = cur_morph_t.v
      let closing = is_closing.untracked()
      if !closing && t >= lm_open_duration_ms / 1000.0 - 0.001 {
        return view::ground_as_laid
      }
      let f = eval_frame(px_win, py_win, w, h, closing, t)
      let r = f.radius
      view::GroundShape::{ dx: f.mx, dy: f.my, dw: f.cur_w - w, dh: f.cur_h - h, corners: Some((r, r, r, r)) }
    },
  )
  let _ = v.box(loc=loc, fn(hold : view::View) -> Unit {
    let _ = hold
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .width(view::Live::Is(Some(0.0)))
    .height(view::Live::Is(Some(0.0)))
    .moved_by(
      fn(_t : Double, _w : Double, _h : Double) -> (Double, Double) { (0.0, 0.0) },
      fn(_w : Double, _h : Double) -> Double {
        if superseded.get() {
          0.0
        } else if layer_leave_end.v > 0.0 {
          layer_leave_end.v
        } else {
          t_way.ends_at()
        }
      },
      holds_leaving=true,
    )
  })
  let _ = v.box(loc=loc, fn(content_box : view::View) -> Unit {
    let _ = content_box
    .padding(view::Live::Is((pad, pad, pad, pad)))
    .lends(surface_context_lent, SurfaceContext::Content)
    .alpha(
      // invar-audit-allow: E007 (placed_window_now reads laid-out bounds; internal lazy settle is batched)
      view::Live::By(fn() {
        if superseded.get() {
          return 0.0
        }
        if ui::reduced_motion() {
          return 1.0
        }
        let t = t_way.shown(content_box)
        let closing = is_closing.get()
        let (px_win, py_win, w, h) = v.placed_window_now()
        let f = eval_frame(px_win, py_win, dmax(w, 1.0), dmax(h, 1.0), closing, t)
        let lens_on = !v.glass_solid() && !ui::glass_solid() && f.content_opacity > 0.01 && f.content_blur > 0.05
        if f.content_opacity <= 0.01 {
          0.0
        } else if lens_on {
          1.0
        } else {
          f.content_opacity
        }
      }),
    )
    .scale(
      // invar-audit-allow: E007 (placed_window_now reads laid-out bounds; internal lazy settle is batched)
      view::Live::By(fn() {
        if ui::reduced_motion() {
          return 1.0
        }
        let t = t_way.shown(content_box)
        let closing = is_closing.get()
        if !closing && t >= lm_open_duration_ms / 1000.0 - 0.001 {
          1.0
        } else {
          let (px_win, py_win, w, h) = v.placed_window_now()
          if w <= 0.0 || h <= 0.0 {
            1.0
          } else {
            let f = eval_frame(px_win, py_win, w, h, closing, t)
            clamp(dmin(f.cur_w / w, f.cur_h / h), 0.20, 1.0)
          }
        }
      }),
      about=view::Pivot::At(0.5, 0.5),
    )
    .offset(
      // invar-audit-allow: E007 (placed_window_now reads laid-out bounds; internal lazy settle is batched)
      view::Live::By(fn() {
        if ui::reduced_motion() {
          return (0.0, 0.0)
        }
        let t = t_way.shown(content_box)
        let closing = is_closing.get()
        if !closing && t >= lm_open_duration_ms / 1000.0 - 0.001 {
          (0.0, 0.0)
        } else {
          let (px_win, py_win, w, h) = v.placed_window_now()
          if w <= 0.0 || h <= 0.0 {
            (0.0, 0.0)
          } else {
            let f = eval_frame(px_win, py_win, w, h, closing, t)
            (f.mx + f.cur_w * 0.5 - w * 0.5, f.my + f.cur_h * 0.5 - h * 0.5)
          }
        }
      }),
    )
    content_look(content_box)
  })
}

pub fn liquid_popover_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  trigger_label : () -> String,
  trigger_look : (view::View, headless::Disclosure) -> Unit,
  content_label : () -> String,
  content_look : (view::View) -> Unit,
  placement~ : headless::Placement = headless::Placement::BelowCenter,
  width~ : Double = 280.0,
  radius~ : Double = ovl_popover_radius,
  pad~ : Double = ovl_popover_pad,
  anchor_size~ : (Double, Double) = (36.0, 36.0),
  trigger_face? : (view::View) -> Unit,
  close_on_outside~ : Bool = true,
  close_on_escape~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let shown_open = ovl_transitioned_bool(parent, open, within=host)
  let set_open_tx = fn(v : Bool) -> Unit { view::transition(within=host, fn() { set_open(v) }) }
  let pop = headless::Popover::new(
    shown_open,
    set_open_tx,
    close_on_escape=close_on_escape,
    close_on_outside=close_on_outside,
  )
  let (side, along) = ovl_beside_of(placement)
  let trigger = pop.trigger(parent, trigger_label, trigger_look, loc=loc)
  let has_pill_trig = match trigger.lent(liquid_pill_trigger_lent) {
    Some(_) => true
    None => false
  }
  let handoff = ovl_setup_trigger_handoff(
    trigger,
    shown_open,
    side,
    anchor_size,
    trigger_face,
    attach_recoil=!has_pill_trig,
  )
  pop.layer(
    host,
    content_label,
    leave=ovl_morph_leave_ms,
    loc=loc,
    fn(v : view::View, opener : Option[view::View]) -> Unit {
      let mut handled_by_pill = false
      match opener {
        Some(op) => {
          if !v.glass_solid() && !ui::glass_solid() && !ui::reduced_motion() {
            match op.lent(liquid_pill_trigger_lent) {
              Some(trig) => {
                let (_, _, aw, ah) = op.placed_window_now()
                if aw >= 16.0 && ah >= 16.0 {
                  handled_by_pill = true
                  popover_attach_pill_trigger_morph(
                    v,
                    op,
                    trig,
                    side,
                    along,
                    width,
                    radius,
                    pad,
                    content_look,
                    loc=loc,
                  )
                }
              }
              None => ()
            }
          }
          if !handled_by_pill {
            let _ = v.beside(op.id(), side=side, along=along, offset=ovl_float_gap, padding=ovl_float_pad)
          }
        }
        None => ()
      }
      if !handled_by_pill {
        if width > 0.0 {
          let _ = v.width(view::Live::Is(Some(width)))
        }
        let _ = ovl_attach_liquid_morph(v, v, side, along, radius, handoff, fn(content_box : view::View) -> Unit {
          let _ = content_box
          .padding(view::Live::Is((pad, pad, pad, pad)))
          .lends(surface_context_lent, SurfaceContext::Content)
          content_look(content_box)
        })
      }
    },
  )
  trigger
}

pub fn liquid_popover_button_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  label : () -> String,
  content_look : (view::View) -> Unit,
  icon? : (view::View, () -> Int64) -> Unit,
  show_label~ : Bool = true,
  flat~ : Bool = false,
  ghost~ : Bool = false,
  active~ : () -> Bool = fn() { false },
  neutral_active~ : Bool = false,
  height~ : Double = button_h,
  pad_x~ : Double = 12.0,
  content_label~ : () -> String = fn() { "Popover" },
  placement~ : headless::Placement = headless::Placement::BelowCenter,
  width~ : Double = 240.0,
  radius~ : Double = ovl_popover_radius,
  pad~ : Double = ovl_popover_pad,
  close_on_outside~ : Bool = true,
  close_on_escape~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let r = height / 2.0
  let label_sz = if height <= 32.0 { 13.0 } else { ovl_type_body }
  let is_circle = match icon {
    Some(_) => !show_label
    None => false
  }
  let eff_tint = fn() -> Int64 {
    if active() && !neutral_active {
      ctrl_chip_selected_tint()
    } else {
      clear
    }
  }
  let face_ink = fn() -> Int64 {
    if eff_tint() != clear {
      white
    } else {
      colors().content
    }
  }
  let draw_face = fn(bx : view::View) -> Unit {
    if show_label {
      let _ = bx
      .padding(view::Live::Is((pad_x, 0.0, pad_x, 0.0)))
      .gap(view::Live::Is(6.0))
      match icon {
        Some(draw_icon) => {
          let _ = bx.box(fn(ic : view::View) -> Unit {
            let _ = ic
            .shrink(view::Live::Is(0.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            draw_icon(ic, face_ink)
          })
        }
        None => ()
      }
      let _ = bx.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(label), look=words_at(label_sz))
        .ink(view::Live::By(face_ink))
      })
    } else {
      match icon {
        Some(draw_icon) => {
          let _ = bx.box(fn(ic : view::View) -> Unit {
            let _ = ic
            .shrink(view::Live::Is(0.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            draw_icon(ic, face_ink)
          })
        }
        None => {
          let _ = bx.padding(view::Live::Is((pad_x, 0.0, pad_x, 0.0)))
          let _ = bx.box(fn(w : view::View) -> Unit {
            let _ = w
            .words(view::Live::By(label), look=words_at(label_sz))
            .ink(view::Live::By(face_ink))
          })
        }
      }
    }
  }
  let press_way = motion::NodeWay::new(0.0)
  let trigger_look = fn(t : view::View, disc : headless::Disclosure) -> Unit {
    t.reacts(at_start=false, fn() { !disc.disabled() && disc.pressed() }, fn(on : Bool) -> Unit {
      press_way.go(t, if on { 1.0 } else { 0.0 }, if flat { motion::backdrop_press_spring } else { motion::snappy_damped })
    })
    let _ = t
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .height(view::Live::Is(Some(height)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(r))
    .scale(
      view::Live::By(fn() {
        if ui::reduced_motion() {
          1.0
        } else {
          lerp(1.0, if flat { 0.97 } else { 0.96 }, clamp(press_way.shown(t), 0.0, 1.0))
        }
      }),
      about=view::Pivot::At(0.5, 0.5),
    )
    if flat && ghost {
      let hover_t = motion::hover_fade(t, fn() { disc.hovered() && !disc.disabled() })
      let press_t = motion::hover_fade(t, fn() { disc.pressed() && !disc.disabled() }, duration_ms=motion::pointer_tap_ms)
      let _ = t.ground(view::Live::By(fn() {
        let et = eff_tint()
        if et != clear {
          et
        } else {
          let base = if open() || (active() && neutral_active) { ovl_action_pill_ground() } else { clear }
          let h = hover_t()
          let p = press_t()
          let with_h = if h > 0.001 { over(base, alpha(ovl_row_hover(), h)) } else { base }
          if p > 0.001 { over(with_h, alpha(ovl_row_press(), p)) } else { with_h }
        }
      }))
    } else if flat {
      let hover_t = motion::hover_fade(t, fn() { disc.hovered() && !disc.disabled() })
      let press_t = motion::hover_fade(t, fn() { disc.pressed() && !disc.disabled() }, duration_ms=motion::pointer_tap_ms)
      let _ = t
      .ground(view::Live::By(fn() {
        let et = eff_tint()
        if et != clear {
          et
        } else {
          let base = if open() || (active() && neutral_active) {
            ovl_action_pill_ground()
          } else if is_dark() {
            0xFFFFFF22L
          } else {
            0x00000012L
          }
          let h = hover_t()
          let p = press_t()
          let with_h = if h > 0.001 { over(base, alpha(ovl_row_hover(), h)) } else { base }
          if p > 0.001 { over(with_h, alpha(ovl_row_press(), p)) } else { with_h }
        }
      }))
      .edge(view::Live::By(fn() {
        if eff_tint() != clear {
          (0.0, clear)
        } else if is_dark() {
          (0.5, 0xFFFFFF24L)
        } else {
          (0.5, 0x0000001AL)
        }
      }))
    } else {
      lg_apply_glass_surface(t, fn() { lg_capsule_glass() })
    }
    if is_circle {
      let _ = t.width(view::Live::Is(Some(height)))
    }
    lg_focus_ring(t, fn() { disc.focus_shown() }, r)
    draw_face(t)
  }
  if flat {
    let trigger = liquid_popover_node(
      parent,
      host,
      open,
      set_open,
      label,
      trigger_look,
      content_label,
      content_look,
      placement=placement,
      width=width,
      radius=radius,
      pad=pad,
      anchor_size=(if show_label { 96.0 } else { height }, height),
      close_on_outside=close_on_outside,
      close_on_escape=close_on_escape,
      loc=loc,
    )
    let _ = trigger.scale(
      view::Live::By(fn() {
        if ui::reduced_motion() {
          1.0
        } else {
          lerp(1.0, 0.97, clamp(press_way.shown(trigger), 0.0, 1.0))
        }
      }),
      about=view::Pivot::At(0.5, 0.5),
    )
    trigger
  } else {
    liquid_popover_node(
      parent,
      host,
      open,
      set_open,
      label,
      trigger_look,
      content_label,
      content_look,
      placement=placement,
      width=width,
      radius=radius,
      pad=pad,
      anchor_size=(if show_label { 96.0 } else { height }, height),
      trigger_face=draw_face,
      close_on_outside=close_on_outside,
      close_on_escape=close_on_escape,
      loc=loc,
    )
  }
}

/// Reusable single-layer Liquid Glass tooltip capsule (`r=12pt`, `points(Is(false))`, `glass_overlay_shadow`,
/// `shadow_outside(Is(true))`, solid-mode 1pt edge fallback, optional concentric shortcut keycap badge)
/// shared by `liquid_tooltip_node` and external global tooltip layers.
pub fn liquid_tooltip_bubble_node(
  parent : view::View,
  text : () -> String,
  shortcut~ : () -> String = fn() { "" },
  solid? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(b : view::View) -> Unit {
    let _ = b
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(8.0))
    .points(view::Live::Is(false))
    .max_width(view::Live::Is(Some(ovl_tooltip_max_w)))
    .padding(view::Live::Is((ovl_tooltip_px, ovl_tooltip_py, ovl_tooltip_px, ovl_tooltip_py)))
    .radius(view::Live::Is(ovl_tooltip_radius))
    .shadow(view::Live::By(glass_overlay_shadow))
    .shadow_outside(view::Live::Is(true))
    .glass(
      view::Live::By(fn() {
        let s = match solid {
          Some(f) => f()
          None => clear
        }
        Some(liquid_capsule_glass(solid=s))
      }),
    )
    .edge(view::Live::By(fn() { if b.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w.shrink(view::Live::Is(1.0)).words(view::Live::By(text), look=words_at(ovl_type_sub, wrap=true)).ink(view::Live::By(fn() { colors().content }))
    })
    b.show(fn() { shortcut() != "" }, fn(kbd : view::View) -> Unit {
      let _ = kbd
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
      .radius(view::Live::Is(ovl_tooltip_radius - ovl_tooltip_py))
      .ground(view::Live::By(ovl_close_ground))
      let _ = kbd.box(fn(kw : view::View) -> Unit {
        let _ = kw.words(view::Live::By(shortcut), look=words_at(ovl_type_meta, weight=weight_medium)).ink(view::Live::By(ovl_muted_ink))
      })
    })
  })
}

pub fn liquid_tooltip_node(
  parent : view::View,
  host : view::View,
  tip : () -> String,
  trigger_look : (view::View) -> Unit,
  placement~ : headless::Placement = headless::Placement::AboveCenter,
  shortcut~ : () -> String = fn() { "" },
  group? : headless::TooltipGroup[Int],
  loc~ : String = "",
) -> view::View {
  lg_tooltip_next_key.v = lg_tooltip_next_key.v + 1
  let key = lg_tooltip_next_key.v
  let grp = match group {
    Some(g) => g
    None => headless::window_tooltip_group(host)
  }
  let (side, along) = ovl_beside_of(placement)
  let anchor_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let trigger = parent.box(loc=loc, fn(t : view::View) -> Unit {
    anchor_ref.v = Some(t)
    let _ = t.points(view::Live::Is(true))
    trigger_look(t)
    grp.trigger(t, key, within=true)
  })
  let tip_open = ovl_transitioned_bool(trigger, fn() { grp.is_open(key) && tip() != "" }, within=host)
  host.show(
    tip_open,
    leave=motion::tip_out_ms,
    lives_with=trigger,
    fn(s : view::View) -> Unit {
      let _ = headless::tooltip_bubble(s, tip, loc=loc, fn(b : view::View) -> Unit {
        let (look, _) = motion::overlay_presence(b, enter=motion::tip_in, exit=motion::tip_out)
        match anchor_ref.v {
          Some(op) => {
            let _ = b.beside(op.id(), side=side, along=along, offset=ovl_float_gap, padding=ovl_float_pad)
          }
          None => ()
        }
        let _ = b
        .points(view::Live::Is(false))
        .alpha(view::Live::By(fn() { look().alpha }))
        .scale(view::Live::By(fn() { look().sx }), about=view::Pivot::FromBeside)
        let _ = liquid_tooltip_bubble_node(b, tip, shortcut=shortcut, loc=loc)
      })
    },
  )
  trigger
}
