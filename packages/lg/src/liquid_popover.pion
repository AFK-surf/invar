// Liquid Glass Popover and Tooltip components over headless::Popover and headless::tooltip_bubble.

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

fn popover_fade_ink(c : Int64, share : Double) -> Int64 {
  alpha(c, share)
}

/// Decorates an existing anchored popover container node `p` in place (zero wrapper nodes) in either:
/// 1. Standard anchored overlay mode (when `morph` is `None` or `p.glass_solid()` is true):
///    binds `liquid_panel_glass(solid=...)`, `shadow`, `shadow_outside(Is(true))`, solid hairline
///    fallback, and optional `alpha` / `scale`.
/// 2. iOS 27.0 liquid-bridge morph mode (when `morph` is `Some(eval)` and `!p.glass_solid()`):
///    encapsulates three-anchor `liquid_menu_morph_glass` optical interpolation, capillary `merge`/`layer`/`break_gap`,
///    `content_lens` blur/refraction (`kind == 8`, zero at rest), `ground_drawn` animated silhouette, `alpha` gating,
///    and smooth shadow ramp. Returns `p` for chaining.
pub fn liquid_popover_surface_decorate(
  p : view::View,
  radius? : Double,
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = fn() { shadow_default },
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
  alpha? : () -> Double,
  scale? : () -> Double,
  scale_about~ : view::Pivot = view::Pivot::FromBeside,
  morph? : () -> Option[(Double, Bool, Double, Double, LiquidMorphFrame)],
  layer~ : Int = 0,
  break_gap~ : Double = 32.0,
  close_break_gap~ : Double = 48.0,
) -> view::View {
  let resolve_solid = fn() -> Int64 {
    match solid {
      Some(f) => f()
      None => clear
    }
  }
  match radius {
    Some(r) => {
      let _ = p.radius(view::Live::Is(r))
    }
    None => ()
  }
  if clips {
    let _ = p.clips(view::Live::Is(true))
  }
  let _ = p
  .edge(view::Live::By(fn() { if p.glass_solid() || ui::glass_solid() { solid_edge() } else { (0.0, clear) } }))
  .shadow_outside(view::Live::Is(true))
  match morph {
    Some(eval_morph) => {
      let _ = p
      .alpha(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() {
            match alpha {
              Some(af) => af()
              None => 1.0
            }
          } else {
            match eval_morph() {
              Some((_, closing, _, _, f)) =>
              if !closing {
                if f.raw_value <= 0.001 { 0.0 } else { 1.0 }
              } else if !f.platter_active {
                0.0
              } else {
                1.0
              }
              None =>
              match alpha {
                Some(af) => af()
                None => 1.0
              }
            }
          }
        }),
      )
      .glass(
        view::Live::By(fn() {
          let s = resolve_solid()
          if p.glass_solid() || ui::glass_solid() {
            return Some(liquid_panel_glass(solid=s))
          }
          match eval_morph() {
            Some((t, closing, _, _, f)) =>
            if !closing {
              if f.raw_value <= 0.001 {
                None
              } else {
                let stage = 0.5 + 0.5 * lm_smoothstep(0.08, 0.20, t)
                if f.open_anchor_scale > 0.15 {
                  Some(
                    liquid_menu_morph_glass(
                      stage,
                      solid=s,
                      merge=14.0 * f.open_anchor_scale,
                      layer=layer,
                      break_gap=break_gap,
                    ),
                  )
                } else {
                  Some(liquid_menu_morph_glass(stage, solid=s))
                }
              }
            } else if !f.platter_active {
              None
            } else {
              let stage = 0.5 * lm_smoothstep(0.0, 0.12, f.raw_value) +
              0.5 * lm_smoothstep(0.35, 0.95, f.raw_value)
              if f.blob_a_emerge > 0.001 {
                Some(
                  liquid_menu_morph_glass(
                    stage,
                    solid=s,
                    merge=lm_close_blend(f.raw_value),
                    layer=layer,
                    break_gap=close_break_gap,
                  ),
                )
              } else {
                Some(liquid_menu_morph_glass(stage, solid=s))
              }
            }
            None => Some(liquid_panel_glass(solid=s))
          }
        }),
      )
      .content_lens(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() {
            return paint::ContentLens::none()
          }
          match eval_morph() {
            Some((_, _, _, _, f)) =>
            if f.content_opacity > 0.01 && f.content_blur > 0.05 {
              paint::ContentLens::{
                blur: f.content_blur,
                refraction: 6.0 * clamp(f.content_blur / 8.0, 0.0, 1.0),
                bezel: 24.0,
                alpha: f.content_opacity,
              }
            } else {
              paint::ContentLens::none()
            }
            None => paint::ContentLens::none()
          }
        }),
      )
      .shadow(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() {
            return shadow()
          }
          match eval_morph() {
            Some((_, closing, _, _, f)) =>
            if closing && !f.platter_active {
              shadow_none
            } else {
              let ga = lm_smoothstep(0.25, 0.78, clamp(f.raw_value, 0.0, 1.0))
              if ga <= 0.001 {
                shadow_none
              } else {
                let (s, dy, ink) = shadow()
                (s, dy, popover_fade_ink(ink, ga))
              }
            }
            None => shadow()
          }
        }),
      )
      .ground_drawn(
        view::Live::By(fn() {
          if p.glass_solid() || ui::glass_solid() {
            return view::ground_as_laid
          }
          match eval_morph() {
            Some((t, closing, w, h, f)) =>
            if w <= 0.0 || h <= 0.0 || (!closing && t >= lm_open_duration_ms / 1000.0 - 0.001) {
              view::ground_as_laid
            } else {
              let r = f.radius
              view::GroundShape::{ dx: f.mx, dy: f.my, dw: f.cur_w - w, dh: f.cur_h - h, corners: Some((r, r, r, r)) }
            }
            None => view::ground_as_laid
          }
        }),
      )
      p
    }
    None => {
      let _ = p.glass(view::Live::By(fn() { Some(liquid_panel_glass(solid=resolve_solid())) })).shadow(view::Live::By(shadow))
      match alpha {
        Some(af) => {
          let _ = p.alpha(view::Live::By(af))
        }
        None => ()
      }
      match scale {
        Some(sf) => {
          let _ = p.scale(view::Live::By(sf), about=scale_about)
        }
        None => ()
      }
      p
    }
  }
}

/// Decorates an existing tooltip node `v` in place (zero wrapper nodes) with `points(Is(false))` click-through,
/// `active` gating (submits `None` glass, zero edge, and zero shadow when inactive), `shadow_outside(Is(true))`,
/// solid hairline fallback, and single-layer liquid glass (`liquid_capsule_glass` by default, or
/// `liquid_panel_glass` when `panel=true`). Returns `v` for chaining.
pub fn liquid_tooltip_surface_decorate(
  v : view::View,
  radius? : Double,
  active~ : () -> Bool = fn() { true },
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = fn() { shadow_default },
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  panel~ : Bool = false,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r))
    }
    None => ()
  }
  let _ = v
  .points(view::Live::Is(false))
  .glass(
    view::Live::By(fn() {
      if !active() {
        return None
      }
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      if panel {
        Some(liquid_panel_glass(solid=s))
      } else {
        Some(liquid_capsule_glass(solid=s))
      }
    }),
  )
  .edge(
    view::Live::By(fn() {
      if active() && (v.glass_solid() || ui::glass_solid()) {
        solid_edge()
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if active() {
        shadow()
      } else {
        shadow_none
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  v
}

struct UnitFnCell {
  mut v : () -> Unit
}

fn opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

pub fn liquid_popover_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  trigger_label : () -> String,
  trigger_look : (view::View, headless::Disclosure) -> Unit,
  content_label : () -> String,
  content_look : (view::View) -> Unit,
  placement~ : headless::Placement = headless::Placement::BelowCenter,
  width~ : Double = 280.0,
  anchor_size~ : (Double, Double) = (36.0, 36.0),
  trigger_face? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let shown_open = ovl_transitioned_bool(host, open)
  let set_open_tx = fn(v : Bool) -> Unit { view::transition(within=host, fn() { set_open(v) }) }
  let pop = headless::Popover::new(shown_open, set_open_tx)
  let (side, along) = ovl_beside_of(placement)
  let trigger = pop.trigger(parent, trigger_label, trigger_look, loc=loc)
  let handoff = ovl_setup_trigger_handoff(trigger, shown_open, side, anchor_size, trigger_face)
  pop.layer(
    host,
    content_label,
    leave=ovl_morph_leave_ms,
    loc=loc,
    fn(v : view::View, opener : Option[view::View]) -> Unit {
      match opener {
        Some(op) => {
          let _ = v.beside(op.id(), side=side, along=along, offset=ovl_float_gap, padding=ovl_float_pad)
        }
        None => ()
      }
      let _ = v.width(view::Live::Is(Some(width)))
      let _ = ovl_attach_liquid_morph(v, v, side, along, ovl_popover_radius, handoff, fn(content_box : view::View) -> Unit {
        let _ = content_box.padding(view::Live::Is((ovl_popover_pad, ovl_popover_pad, ovl_popover_pad, ovl_popover_pad)))
        content_look(content_box)
      })
    },
  )
  trigger
}

/// Reusable single-layer Liquid Glass tooltip capsule (`r=12pt`, `points(Is(false))`, `glass_overlay_shadow`,
/// `shadow_outside(Is(true))`, solid-mode 1pt edge fallback, optional concentric shortcut keycap badge)
/// shared by `liquid_tooltip_node` and external global tooltip layers.
pub fn liquid_tooltip_bubble_node(
  parent : view::View,
  text : () -> String,
  shortcut~ : () -> String = fn() { "" },
  solid? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(b : view::View) -> Unit {
    let _ = b
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .gap(view::Live::Is(8.0))
    .points(view::Live::Is(false))
    .max_width(view::Live::Is(Some(ovl_tooltip_max_w)))
    .padding(view::Live::Is((ovl_tooltip_px, ovl_tooltip_py, ovl_tooltip_px, ovl_tooltip_py)))
    .radius(view::Live::Is(ovl_tooltip_radius))
    .shadow(view::Live::By(glass_overlay_shadow))
    .shadow_outside(view::Live::Is(true))
    .glass(
      view::Live::By(fn() {
        let s = match solid {
          Some(f) => f()
          None => clear
        }
        Some(liquid_capsule_glass(solid=s))
      }),
    )
    .edge(view::Live::By(fn() { if b.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w.shrink(view::Live::Is(1.0)).words(view::Live::By(text), look=words_at(ovl_type_sub, wrap=true)).ink(view::Live::By(fn() { colors().content }))
    })
    b.show(fn() { shortcut() != "" }, fn(kbd : view::View) -> Unit {
      let _ = kbd
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((6.0, 2.0, 6.0, 2.0)))
      .radius(view::Live::Is(ovl_tooltip_radius - ovl_tooltip_py))
      .ground(view::Live::By(ovl_close_ground))
      let _ = kbd.box(fn(kw : view::View) -> Unit {
        let _ = kw.words(view::Live::By(shortcut), look=words_at(ovl_type_meta, weight=weight_medium)).ink(view::Live::By(ovl_muted_ink))
      })
    })
  })
}

pub fn liquid_tooltip_node(
  parent : view::View,
  host : view::View,
  tip : () -> String,
  trigger_look : (view::View) -> Unit,
  placement~ : headless::Placement = headless::Placement::AboveCenter,
  shortcut~ : () -> String = fn() { "" },
  loc~ : String = "",
) -> view::View {
  let shown : signals::Signal[Option[Int]] = signals::signal_by(None, opt_int_eq)
  let group = headless::TooltipGroup::new(fn() { shown.get() }, fn(v : Option[Int]) -> Unit { shown.set(v) })
  let (side, along) = ovl_beside_of(placement)
  let anchor_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
  let trigger = parent.box(loc=loc, fn(t : view::View) -> Unit {
    anchor_ref.v = Some(t)
    let _ = t.points(view::Live::Is(true))
    trigger_look(t)
    group.trigger(t, 0)
    let pending = UnitFnCell::{ v: fn() -> Unit { () } }
    let cancel_pending = fn() -> Unit {
      (pending.v)()
      pending.v = fn() -> Unit { () }
    }
    t.reacts(
      fn() -> Int {
        (if t.pointed_in() { 1 } else { 0 }) |
        (if t.pointed() { 2 } else { 0 }) |
        (if t.focus_shown() { 4 } else { 0 })
      },
      at_start=false,
      fn(mask : Int) -> Unit {
        let in_sub = (mask & 1) != 0
        let direct = (mask & 2) != 0
        let focused = (mask & 4) != 0
        cancel_pending()
        if focused {
          shown.set(Some(0))
        } else if in_sub && !direct {
          let at = t.cause_at()
          pending.v = t.at_moment(at + headless::tooltip_delay_ms, fn() -> Unit {
            pending.v = fn() -> Unit { () }
            if signals::untracked(fn() { t.pointed_in() }) {
              shown.set(Some(0))
            }
          })
        } else if !in_sub && !direct && !focused {
          let is_zero = match shown.untracked() {
            Some(0) => true
            _ => false
          }
          if is_zero {
            shown.set(None)
          }
        }
      },
    )
    let _ = t.owns(cancel_pending)
  })
  let tip_open = ovl_transitioned_bool(host, fn() { group.is_open(0) && tip() != "" })
  host.show(
    tip_open,
    leave=motion::tip_out_ms,
    fn(s : view::View) -> Unit {
      let _ = headless::tooltip_bubble(s, tip, loc=loc, fn(b : view::View) -> Unit {
        let (look, _) = motion::overlay_presence(b, enter=motion::tip_in, exit=motion::tip_out)
        match anchor_ref.v {
          Some(op) => {
            let _ = b.beside(op.id(), side=side, along=along, offset=ovl_float_gap, padding=ovl_float_pad)
          }
          None => ()
        }
        let _ = b
        .points(view::Live::Is(false))
        .alpha(view::Live::By(fn() { look().alpha }))
        .scale(view::Live::By(fn() { look().sx }), about=view::Pivot::FromBeside)
        let _ = liquid_tooltip_bubble_node(b, tip, shortcut=shortcut, loc=loc)
      })
    },
  )
  trigger
}
