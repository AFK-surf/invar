// Unit tests for Apple Two-Layer Content Surface tokens, zero-glass default containers,
// `surface_code_block_node` horizontal scrolling (640pt & 320pt), JSX wrappers, and `audit_glass` / `assert_apple_ui`.

import "signals"
import "ui"
import "view"

test "lg_surface_palette_and_concentric_ladder" {
  set_dark(Some(false))
  let l = surface()
  debug_assert(l.canvas == 0xF5F5F7FFL, "light canvas token")
  debug_assert(l.card == 0xFFFFFFFFL, "light card token")
  debug_assert(l.accent == 0x007AFFFFL, "light accent token")
  debug_assert(l.code_bg == 0xF6F6F9FFL, "light code_bg token")

  set_dark(Some(true))
  let d = surface()
  debug_assert(d.canvas == 0x0B0C0EFFL, "dark canvas token")
  debug_assert(d.card == 0x1C1C1EFFL, "dark card token")
  debug_assert(d.accent == 0x0A84FFFFL, "dark accent token")
  debug_assert(d.code_bg == 0x141519FFL, "dark code_bg token")
  set_dark(None)

  debug_assert((concentric(r_sheet, 14.0) - 20.0).abs() < 0.001, "concentric sheet -> card")
  debug_assert((concentric(r_card, 8.0) - 12.0).abs() < 0.001, "concentric card -> row")
  debug_assert((concentric(8.0, 12.0) - 0.0).abs() < 0.001, "concentric clamps at 0")
}

test "lg_content_containers_default_zero_glass_and_opt_in_floating" {
  let modes = [false, true]
  for dark in modes {
    ui::set_glass_solid(None)
    let disc_open = signals::signal(true)
    let t = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_list_node(
          page,
          fn() { [LiquidListRow::new(title="Wi-Fi", value="Office", chevron=true)] },
          header=fn() { "Network" },
        )
        let _ = liquid_disclosure_node(
          page,
          fn() { "Details" },
          fn() { disc_open.get() },
          fn(v : Bool) -> Unit { disc_open.set(v) },
          fn(b : view::View) -> Unit {
            let _ = b.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Solid content"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
        )
        let _ = liquid_panel_node(
          page,
          fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Default Panel"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
          label=fn() { "Default Panel" },
        )
        let _ = liquid_card_node(
          page,
          200.0,
          72.0,
          fn() { "Default Card" },
          content=fn(c : view::View) -> Unit {
            let _ = c.padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Card Body"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
        )
        let _ = surface_card_node(
          page,
          fn(c : view::View) -> Unit {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Surface Card"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
          label=fn() { "Surface Card" },
        )
        let _ = surface_section_node(
          page,
          fn(c : view::View) -> Unit {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Grouped Row"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
          header=fn() { "SECTION" },
          footer=fn() { "Clean Apple grouped content surface." },
          pad=14.0,
        )
      },
      dark=dark,
      w=720.0,
      h=720.0,
    )
    t.run_shown(springs_out)
    debug_assert(count_liquid_glass(t) == 0, "default content containers must emit 0 Glass::liquid")
    assert_apple_ui(t, label="content_layer_pure_dark_\{dark}")
    t.dispose()

    // Opt-in floating / glass mode emits 4 single-layer Glass::liquid surfaces
    let tg = lg_case(
      fn(page : view::View) -> Unit {
        let _ = liquid_list_node(
          page,
          fn() { [LiquidListRow::new(title="Floating List", value="Glass")] },
          glass=true,
        )
        let _ = liquid_disclosure_node(
          page,
          fn() { "Floating Disclosure" },
          fn() { false },
          fn(_v : Bool) -> Unit { () },
          fn(_b : view::View) -> Unit { () },
          glass=true,
        )
        let _ = liquid_panel_node(
          page,
          fn(p : view::View) -> Unit {
            let _ = p.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Floating Inspector"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
            })
          },
          floating=true,
        )
        let _ = liquid_card_node(
          page,
          160.0,
          64.0,
          fn() { "Floating Tile" },
          floating=true,
        )
      },
      dark=dark,
      w=960.0,
      h=840.0,
    )
    tg.run_shown(springs_out)
    debug_assert(count_liquid_glass(tg) == 4, "opt-in floating/glass containers must emit 4 Glass::liquid")
    assert_no_nested_glass(tg, label="opt_in_floating_glass_dark_\{dark}")
    tg.dispose()
  }
}

test "lg_surface_code_block_wide_and_narrow_320pt_and_jsx" {
  let long_code = "let _ = lg::surface_code_block_node(card, fn() { \"pub fn very_long_apple_two_layer_example(root: view::View, worker: ui::Worker[Cmd, Ev]) -> Unit\" }, lang=fn() { \"pion\" })"
  let widths : Array[Double] = [640.0, 320.0]
  for vw in widths {
    let copies = ui::ref_new(0)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        let _ = root
        .ground(view::Live::By(fn() { surface().canvas }))
        .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
        .gap(view::Live::Is(12.0))
        <SurfaceSection in={root} header="SNIPPET" footer="Scrolls horizontally on narrow viewports." radius={r_card} pad={8.0}>
          <CodeBlock
            code={long_code}
            lang="pion"
            radius={concentric(r_card, 8.0)}
            on_copy={fn() -> Unit { copies.v += 1 }}
          />
        </SurfaceSection>
      },
      width=vw,
      height=420.0,
      scale=2.0,
      theme=ui_theme,
    )
    t.run_shown(springs_out)
    debug_assert(count_liquid_glass(t) == 0, "CodeBlock and SurfaceCard must emit 0 Glass::liquid")
    t.press("Copy")
    t.frame(ms=16.0)
    debug_assert(copies.v == 1, "Copy button must invoke on_copy")
    debug_assert(t.find("Copied").is_some(), "Copy button must update label to Copied")
    assert_apple_ui(t, label="code_block_w_\{vw}")
    t.dispose()
  }
}

test "lg_audit_glass_catches_content_layer_misuse" {
  ui::set_glass_solid(None)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))
      let _ = liquid_panel_node(
        root,
        fn(p : view::View) -> Unit {
          let _ = p.width(view::Live::Is(Some(500.0))).height(view::Live::Is(Some(360.0)))
          let _ = p.box(fn(w : view::View) -> Unit {
            let _ = w.words(view::Live::Is("Oversized Content Glass"), look=words_at(14.0)).ink(view::Live::By(fn() { colors().content }))
          })
        },
        floating=true,
        label=fn() { "Giant Glass" },
      )
    },
    width=600.0,
    height=460.0,
    theme=ui_theme,
  )
  t.run_shown(springs_out)
  let faults = audit_glass(t, label="misuse_check")
  debug_assert(faults.length() > 0, "oversized non-modal Liquid Glass must trigger content-layer misuse fault")
  let ok_override = audit_glass(t, label="modal_override", allow_large_overlay=true)
  debug_assert(ok_override.length() == 0, "allow_large_overlay=true must permit modal overlays")
  t.dispose()
}
