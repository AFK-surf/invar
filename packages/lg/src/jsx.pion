    None =>
    liquid_drawer_node(
      parent,
      open_by,
      on_close,
      ttl,
      children,
      side=side,
      width=width,
      subtitle=sub,
      loc=loc,
    )
  }
}

/// 24. Capsule status toast notification.
pub fn Toast(
  parent : view::View,
  visible_by~ : () -> Bool,
  title~ : String = "",
  title_by? : () -> String,
  subtitle~ : String = "",
  subtitle_by? : () -> String,
  status~ : LiquidStatus = .Info,
  action_label~ : String = "",
  action_label_by? : () -> String,
  on_action? : () -> Unit,
  on_dismiss? : () -> Unit,
  loc~ : String = "",
) -> view::View {
  let ttl = str_live(title, title_by)
  let sub = str_live(subtitle, subtitle_by)
  let act = str_live(action_label, action_label_by)
  match (on_action, on_dismiss) {
    (Some(a), Some(d)) =>
    liquid_toast_node(
      parent,
      visible_by,
      ttl,
      subtitle=sub,
      status=status,
      action_label=act,
      on_action=a,
      on_dismiss=d,
      loc=loc,
    )
    (Some(a), None) =>
    liquid_toast_node(
      parent,
      visible_by,
      ttl,
      subtitle=sub,
      status=status,
      action_label=act,
      on_action=a,
      loc=loc,
    )
    (None, Some(d)) =>
    liquid_toast_node(
      parent,
      visible_by,
      ttl,
      subtitle=sub,
      status=status,
      action_label=act,
      on_dismiss=d,
      loc=loc,
    )
    _ =>
    liquid_toast_node(
      parent,
      visible_by,
      ttl,
      subtitle=sub,
      status=status,
      action_label=act,
      loc=loc,
    )
  }
}

