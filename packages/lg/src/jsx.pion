/// 11. Page navigation bar (`glass=false` by default; host floating islands in leading/trailing).
pub fn NavBar(
  parent : view::View,
  title~ : String = "",
  title_by? : () -> String,
  subtitle~ : String = "",
  subtitle_by? : () -> String,
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  height~ : Double = 46.0,
  glass~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let ttl = str_live(title, title_by)
  let sub = str_live(subtitle, subtitle_by)
  match (leading, trailing) {
    (Some(l), Some(t)) =>
    liquid_nav_bar_node(
      parent,
      ttl,
      subtitle=sub,
      leading=l,
      trailing=t,
      height=height,
      glass=glass,
      loc=loc,
    )
    (Some(l), None) =>
    liquid_nav_bar_node(
      parent,
      ttl,
      subtitle=sub,
      leading=l,
      height=height,
      glass=glass,
      loc=loc,
    )
    (None, Some(t)) =>
    liquid_nav_bar_node(
      parent,
      ttl,
      subtitle=sub,
      trailing=t,
      height=height,
      glass=glass,
      loc=loc,
    )
    _ =>
    liquid_nav_bar_node(
      parent,
      ttl,
      subtitle=sub,
      height=height,
      glass=glass,
      loc=loc,
    )
  }
}

/// 12. Damped-drag Liquid Glass toggle switch.
pub fn Toggle(
  parent : view::View,
  on~ : Bool = false,
  on_by? : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_v : Bool) -> Unit { () },
  label~ : String = "",
  label_by? : () -> String,
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let on_f = bool_live(on, on_by)
  let lbl = str_live(label, label_by)
  let dis = bool_live(disabled, disabled_by)
  match drag {
    Some(d) => liquid_toggle_node(parent, on_f, on_change, lbl, disabled=dis, drag=d, loc=loc)
    None => liquid_toggle_node(parent, on_f, on_change, lbl, disabled=dis, loc=loc)
  }
}

/// 13. Continuous / stepped Liquid Glass slider.
pub fn Slider(
  parent : view::View,
  value~ : Double = 0.0,
  value_by? : () -> Double,
  on_change~ : (Double) -> Unit = fn(_v : Double) -> Unit { () },
  label~ : String = "",
  label_by? : () -> String,
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  step~ : Double = 0.0,
  on_commit? : (Double) -> Unit,
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let val_f = double_live(value, value_by)
  let lbl = str_live(label, label_by)
  let commit = match on_commit {
    Some(f) => f
    None => fn(_v : Double) -> Unit { () }
  }
  match drag {
    Some(d) =>
    liquid_slider_node(
      parent,
      val_f,
      on_change,
      lbl,
      least=min,
      most=max,
      step=step,
      committed=commit,
      drag=d,
      loc=loc,
    )
    None =>
    liquid_slider_node(
      parent,
      val_f,
      on_change,
      lbl,
      least=min,
      most=max,
      step=step,
      committed=commit,
      loc=loc,
    )
  }
}

/// 14. Segmented pill switcher with concentric thumb. `flat=true` swaps the glass track for a solid recessed
/// track and never mounts the drag loupe, for rows inside glass overlays (`Sheet`, `Drawer`, `Dialog`,
/// `Popover`) or solid cards with zero nested glass.
pub fn Segmented(
  parent : view::View,
  labels~ : Array[String] = [],
  labels_by? : () -> Array[String],
  selected~ : Int = 0,
  selected_by? : () -> Int,
  on_select~ : (Int) -> Unit = fn(_i : Int) -> Unit { () },
  width? : Double,
  height~ : Double = 30.0,
  drag? : DampedDrag,
  flat~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let lbs = strings_live(labels, labels_by)
  let sel = int_live(selected, selected_by)
  liquid_segmented_node(parent, lbs, sel, on_select, width?=width, height=height, drag?=drag, flat=flat, loc=loc)
}

