/// 21. Modal centered Liquid Glass confirmation dialog.
pub fn Dialog(
  parent : view::View,
  open_by~ : () -> Bool,
  on_close~ : () -> Unit,
  title~ : String = "",
  title_by? : () -> String,
  text~ : String = "",
  text_by? : () -> String,
  on_action? : () -> Unit,
  cancel~ : String = "Cancel",
  cancel_by? : () -> String,
  action~ : String = "Okay",
  action_by? : () -> String,
  width~ : Double = 480.0,
  loc~ : String = "",
) -> view::View {
  let act_fn = match on_action {
    Some(f) => f
    None => fn() -> Unit { () }
  }
  liquid_dialog_node(
    parent,
    open_by,
    on_close,
    str_live(title, title_by),
    str_live(text, text_by),
    on_action=act_fn,
    cancel=str_live(cancel, cancel_by),
    action=str_live(action, action_by),
    width=width,
    loc=loc,
  )
}

/// 22. Bottom floating Liquid Glass sheet with optional detents & footer.
pub fn Sheet(
  parent : view::View,
  open_by~ : () -> Bool,
  on_close~ : () -> Unit,
  title~ : String = "",
  title_by? : () -> String,
  subtitle~ : String = "",
  subtitle_by? : () -> String,
  footer? : (view::View) -> Unit,
  width~ : Double = 520.0,
  max_height~ : Double = 560.0,
  detents~ : Bool = false,
  expanded_by? : () -> Bool,
  on_expanded? : (Bool) -> Unit,
  children~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  let ttl = str_live(title, title_by)
  let sub = str_live(subtitle, subtitle_by)
  let exp = bool_live(false, expanded_by)
  let on_exp = match on_expanded {
    Some(f) => f
    None => fn(_v : Bool) -> Unit { () }
  }
  match footer {
    Some(ft) =>
    liquid_sheet_node(
      parent,
      open_by,
      on_close,
      ttl,
      children,
      subtitle=sub,
      footer=ft,
      width=width,
      max_height=max_height,
      detents=detents,
      expanded=exp,
      on_expanded=on_exp,
      loc=loc,
    )
    None =>
    liquid_sheet_node(
      parent,
      open_by,
      on_close,
      ttl,
      children,
      subtitle=sub,
      width=width,
      max_height=max_height,
      detents=detents,
      expanded=exp,
      on_expanded=on_exp,
      loc=loc,
    )
  }
}

