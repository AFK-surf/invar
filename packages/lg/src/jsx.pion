/// 6. Adaptive-height panel (solid Apple content card by default; pass `floating` for glass inspector).
pub fn Panel(
  parent : view::View,
  radius~ : Double = ovl_panel_radius,
  pad~ : Double = ovl_panel_pad,
  gap~ : Double = 0.0,
  floating~ : Bool = false,
  label~ : String = "",
  label_by? : () -> String,
  children~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  liquid_panel_node(
    parent,
    children,
    radius=radius,
    pad=pad,
    gap=gap,
    floating=floating,
    label=str_live(label, label_by),
    loc=loc,
  )
}

/// 7. Fixed-size card (solid Apple content card by default; pass `floating` for glass tile).
pub fn Card(
  parent : view::View,
  width~ : Double,
  height~ : Double,
  floating~ : Bool = false,
  label~ : String = "",
  label_by? : () -> String,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = str_live(label, label_by)
  match children {
    Some(c) => liquid_card_node(parent, width, height, lbl, content=c, floating=floating, loc=loc)
    None => liquid_card_node(parent, width, height, lbl, floating=floating, loc=loc)
  }
}

