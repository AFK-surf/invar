/// 10. Floating bar pill action group (`36pt` capsule, `32pt` flat/ghost buttons inside).
pub fn BarPillGroup(
  parent : view::View,
  height~ : Double = 36.0,
  pad~ : Double = 2.0,
  gap~ : Double = 2.0,
  label~ : String = "",
  label_by? : () -> String,
  children~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  liquid_bar_pill_group_node(
