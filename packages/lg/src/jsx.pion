// Pion-JSX PascalCase thin wrappers for `packages/lg` Liquid Glass components.
// 100% delegates to `liquid_*_node` — zero hand-rolled liquid glass surfaces.

import "ui"
import "view"

fn str_live(s : String, by : Option[() -> String]) -> () -> String {
  match by {
    Some(f) => f
    None => fn() -> String { s }
  }
}

fn bool_live(v : Bool, by : Option[() -> Bool]) -> () -> Bool {
  match by {
    Some(f) => f
    None => fn() -> Bool { v }
  }
}

fn int_live(v : Int, by : Option[() -> Int]) -> () -> Int {
  match by {
    Some(f) => f
    None => fn() -> Int { v }
  }
}

fn double_live(v : Double, by : Option[() -> Double]) -> () -> Double {
  match by {
    Some(f) => f
    None => fn() -> Double { v }
  }
}

fn opt_double_live(
  v : Option[Double],
  by : Option[() -> Option[Double]],
) -> () -> Option[Double] {
  match by {
    Some(f) => f
    None => fn() -> Option[Double] { v }
  }
}

fn strings_live(
  xs : Array[String],
  by : Option[() -> Array[String]],
) -> () -> Array[String] {
  match by {
    Some(f) => f
    None => fn() -> Array[String] { xs }
  }
}

/// 1. Liquid Glass capsule button (or flat/ghost inside glass containers).
pub fn Button(
  parent : view::View,
  label~ : String = "",
  label_by? : () -> String,
  on_press~ : () -> Unit = fn() -> Unit { () },
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  flat~ : Bool = false,
  ghost~ : Bool = false,
  interactive~ : Bool = true,
  height~ : Double = button_h,
  pad_x~ : Double = button_px,
  active~ : Bool = false,
  active_by? : () -> Bool,
  neutral_active~ : Bool = false,
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = str_live(label, label_by)
  let act = bool_live(active, active_by)
  let dis = bool_live(disabled, disabled_by)
  match children {
    Some(c) =>
    liquid_button_node(
      parent,
      lbl,
      on_press,
      content=c,
      tint=tint,
      surface=surface,
      flat=flat,
      interactive=interactive,
      disabled=dis,
      ghost=ghost,
      height=height,
      pad_x=pad_x,
      active=act,
      neutral_active=neutral_active,
      loc=loc,
    )
    None =>
    liquid_button_node(
      parent,
      lbl,
      on_press,
      tint=tint,
      surface=surface,
      flat=flat,
      interactive=interactive,
      disabled=dis,
      ghost=ghost,
      height=height,
      pad_x=pad_x,
      active=act,
      neutral_active=neutral_active,
      loc=loc,
    )
  }
}

/// 2. Floating single-layer Liquid Glass circular icon button.
pub fn IconButton(
  parent : view::View,
  icon~ : (view::View, () -> Int64) -> Unit,
  label~ : String = "",
  label_by? : () -> String,
  on_press~ : () -> Unit = fn() -> Unit { () },
  size~ : LiquidButtonSize = .Regular,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  active~ : Bool = false,
  active_by? : () -> Bool,
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  loc~ : String = "",
) -> view::View {
  liquid_icon_button_node(
    parent,
    str_live(label, label_by),
    icon,
    on_press,
    size=size,
    tint=tint,
    surface=surface,
    active=bool_live(active, active_by),
    disabled=bool_live(disabled, disabled_by),
    loc=loc,
  )
}

