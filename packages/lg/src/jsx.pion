/// 6. Adaptive-height high-density Liquid Glass panel.
pub fn Panel(
  parent : view::View,
  radius~ : Double = ovl_panel_radius,
  pad~ : Double = ovl_panel_pad,
  gap~ : Double = 0.0,
  label~ : String = "",
  label_by? : () -> String,
  children~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  liquid_panel_node(
    parent,
    children,
    radius=radius,
    pad=pad,
    gap=gap,
    label=str_live(label, label_by),
    loc=loc,
  )
}

/// 7. Fixed-size single-layer Liquid Glass card.
pub fn Card(
  parent : view::View,
  width~ : Double,
  height~ : Double,
  label~ : String = "",
  label_by? : () -> String,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = str_live(label, label_by)
  match children {
    Some(c) => liquid_card_node(parent, width, height, lbl, content=c, loc=loc)
    None => liquid_card_node(parent, width, height, lbl, loc=loc)
  }
}

