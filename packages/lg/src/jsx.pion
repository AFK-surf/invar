    loc=loc,
  )
}

/// 28. Zero-glass Content Layer code block with header bar, 36pt Copy button, SF Mono runs, and horizontal scroll.
pub fn CodeBlock(
  parent : view::View,
  code~ : String = "",
  code_by? : () -> String,
  lang~ : String = "",
  lang_by? : () -> String,
  runs_by? : () -> Array[text::Run],
  on_copy? : () -> Unit,
  max_height? : Double,
  radius~ : Double = r_row,
  loc~ : String = "",
) -> view::View {
  let code_f = str_live(code, code_by)
  let lang_f = str_live(lang, lang_by)
  surface_code_block_node(
    parent,
    code_f,
    lang=lang_f,
    runs?=runs_by,
    on_copy?=on_copy,
    max_height?=max_height,
    radius=radius,
    loc=loc,
  )
}

/// 29. Pure-vector Apple icon (100% geometric `paint::shape_of`, zero emoji/font dependency).
pub fn Icon(
  parent : view::View,
  kind~ : IconKind,
  size~ : Double = 16.0,
  color? : Int64,
  color_by? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  let ink_opt = match color_by {
    Some(f) => Some(f)
    None =>
    match color {
      Some(c) => Some(fn() -> Int64 { c })
      None => None
    }
  }
  icon_node(parent, kind, size=size, ink?=ink_opt, loc=loc)
}

/// 30. Floating single-layer Liquid Glass back navigation island (`36×36` circle or `< Label` pill).
pub fn BackButton(
  parent : view::View,
  on_press~ : () -> Unit = fn() -> Unit { () },
  label~ : String = "",
  label_by? : () -> String,
  height~ : Double = 36.0,
  loc~ : String = "",
) -> view::View {
  liquid_back_button_node(
    parent,
    on_press,
    label=str_live(label, label_by),
    height=height,
    loc=loc,
  )
}

/// 31. Full-height Apple scroll-under page shell (soft progressive scroll-edge blur only behind bare title text)
/// and floating top/bottom Liquid Glass slots.
pub fn PageShell(
  parent : view::View,
  title~ : String = "",
  title_by? : () -> String,
  subtitle~ : String = "",
  subtitle_by? : () -> String,
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  bottom? : (view::View) -> Unit,
  grouped~ : Bool = false,
  header_height~ : Double = 44.0,
  bottom_height~ : Double = 56.0,
  top_inset? : Double,
  bottom_inset? : Double,
  bottom_inset_by? : () -> Double,
  scroll? : view::Scroll,
  top_edge_blur? : Bool,
  bottom_edge_blur~ : Bool = false,
  moves_window~ : Bool = false,
  children~ : (view::View) -> Unit = fn(_v : view::View) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  page_shell_node(
    parent,
    children,
    title=str_live(title, title_by),
    subtitle=str_live(subtitle, subtitle_by),
    leading?=leading,
    trailing?=trailing,
    bottom?=bottom,
    grouped=grouped,
    header_height=header_height,
    bottom_height=bottom_height,
    top_inset?=top_inset,
    bottom_inset?=bottom_inset,
    bottom_inset_by?=bottom_inset_by,
    scroll?=scroll,
    top_edge_blur?=top_edge_blur,
    bottom_edge_blur=bottom_edge_blur,
    moves_window=moves_window,
    loc=loc,
  )
}

/// 32. Responsive two-column Apple `NavigationSplitView` (`sidebar` + `0.5pt` separator + `detail`).
pub fn SplitShell(
  parent : view::View,
  sidebar~ : (view::View) -> Unit,
  detail~ : (view::View) -> Unit,
  show_detail~ : Bool = true,
  show_detail_by? : () -> Bool,
  breakpoint~ : Double = 760.0,
  sidebar_width~ : Double = 264.0,
  loc~ : String = "",
) -> view::View {
  split_shell_node(
    parent,
    sidebar,
    detail,
    show_detail=bool_live(show_detail, show_detail_by),
    breakpoint=breakpoint,
    sidebar_width=sidebar_width,
    loc=loc,
  )
}

/// 33. Apple Messages-grade single-layer floating adaptive Liquid Glass message composer capsule.
pub fn ComposerBar(
  parent : view::View,
  field~ : ui::Field,
  on_send~ : () -> Unit = fn() -> Unit { () },
  placeholder~ : String = "Message",
  placeholder_by? : () -> String,
  can_send_by? : () -> Bool,
  leading? : (view::View) -> Unit,
  on_plus? : () -> Unit,
  on_attach? : () -> Unit,
  label~ : String = "Message",
  label_by? : () -> String,
  loc~ : String = "",
) -> view::View {
  composer_bar_node(
    parent,
    field,
    on_send,
    placeholder=placeholder,
    placeholder_by?=placeholder_by,
    can_send?=can_send_by,
    leading?=leading,
    on_plus?=on_plus,
    on_attach?=on_attach,
    label=str_live(label, label_by),
    loc=loc,
  )
}
