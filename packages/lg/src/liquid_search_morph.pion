// Apple iOS 26 liquid glass Search Orb <-> Expanded Search Bar + Capillary-Budded Circular `×` Cancel Orb.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

let smorph_h : Double = 32.0
let smorph_r : Double = 18.0
let smorph_gap : Double = 8.0
let smorph_merge_max : Double = 24.0
let smorph_break_gap : Double = 7.5

fn smorph_visual_gap(p : Double) -> Double {
  let u = clamp(p, 0.0, 1.0)
  let raw_gap = lerp(-smorph_h * 0.55, smorph_gap, u)
  raw_gap - merge_contact_gap
}

pub fn liquid_search_morph_node(
  parent : view::View,
  field : ui::Field,
  expanded : () -> Bool,
  set_expanded : (Bool) -> Unit,
  width~ : Double = 360.0,
  placeholder~ : String = "Search",
  label~ : () -> String = fn() { "Search" },
  cancel_label~ : () -> String = fn() { "Cancel Search" },
  submitted? : (String) -> Unit,
  edited? : (String) -> Unit,
  on_clear? : () -> Unit,
  loc~ : String = "",
) -> view::View {
  let total_w = if width < smorph_h * 3.0 { smorph_h * 3.0 } else { width }
  let bar_w = total_w - smorph_h - smorph_gap
  let init_exp = signals::untracked(expanded)
  let morph_way = motion::Way::new(if init_exp { 1.0 } else { 0.0 })
  let bond = motion::LiquidBond::new(
    merged=!init_exp,
    merge_max=smorph_merge_max,
    break_gap=smorph_break_gap,
    contact_gap=0.0,
    merge_spec=motion::tween(40.0, ease=ui::Ease::Out),
  )
  let scheduled : ui::Ref[Option[() -> Unit]] = ui::ref_new(None)
  let cancel_sched = fn() -> Unit {
    match scheduled.v {
      Some(stop) => {
        scheduled.v = None
        stop()
      }
      None => ()
    }
  }
  let tf = headless::TextField::new(label)
  let orb_press = motion::NodeWay::new(0.0)
  let cancel_press = motion::NodeWay::new(0.0)
  let cancel_x_at = fn(t : Double) -> Double {
    let p = clamp(morph_way.value_at(t), 0.0, 1.0)
    let cur_w = lerp(smorph_h, bar_w, p)
    let raw_gap = lerp(-smorph_h * 0.55, smorph_gap, p)
    cur_w + raw_gap
  }
  let cancel_move = fn(_x : Double, _y : Double, t : Double) -> (Double, Double) {
    morph_way.said()
    (cancel_x_at(t), 0.0)
  }
  let cancel_end = fn(_x : Double, _y : Double) -> Double {
    morph_way.said()
    let me = morph_way.end()
    let be = bond.end()
    if me > be { me } else { be }
  }
  parent.box(loc=loc, fn(stage : view::View) -> Unit {
    stage.reacts(at_start=false, expanded, fn(exp : Bool) -> Unit {
      cancel_sched()
      let at = stage.cause_at()
      let target = if exp { 1.0 } else { 0.0 }
      morph_way.go(target, motion::snappy_damped, at=at)
      let threshold = if exp { bond.break_gap() } else { bond.contact_gap() }
      let t_end = morph_way.end()
      let cross = motion::liquid_bond_cross_time(
        at,
        if t_end > at { t_end } else { at },
        fn(t : Double) -> Double { smorph_visual_gap(morph_way.value_at(t)) },
        exp,
        threshold,
      )
      match cross {
        Some(tc) =>
        if tc <= at {
          let _ = bond.update(threshold, at=tc)
        } else {
          let stop = stage.at_moment(tc, fn() -> Unit {
            scheduled.v = None
            let _ = bond.update(threshold, at=tc)
          })
          scheduled.v = Some(stop)
        }
        None => ()
      }
    })
    let _ = stage.width(view::Live::Is(Some(total_w))).height(view::Live::Is(Some(smorph_h))).shrink(view::Live::Is(0.0))
    let bar_shape = fn(node : view::View) -> view::GroundShape {
      let p = clamp(morph_way.shown_on(node), 0.0, 1.0)
      let vw = lerp(smorph_h, bar_w, p)
      let dw = vw - bar_w
      if dw.abs() < 0.01 {
        view::ground_as_laid
      } else {
        view::GroundShape::{ dx: 0.0, dy: 0.0, dw, dh: 0.0, corners: Some((smorph_r, smorph_r, smorph_r, smorph_r)) }
      }
    }
    let _ = stage.box(fn(shadows : view::View) -> Unit {
      let _ = shadows.over(view::Live::Is(true)).points(view::Live::Is(false))
      let _ = shadows.box(fn(bs : view::View) -> Unit {
        let _ = bs
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(bar_w)))
        .height(view::Live::Is(Some(smorph_h)))
        .radius(view::Live::Is(smorph_r))
        .shadow(view::Live::By(glass_control_shadow))
        .shadow_outside(view::Live::Is(true))
        .ground_drawn(view::Live::By(fn() { bar_shape(bs) }))
      })
      let _ = shadows.box(fn(cs : view::View) -> Unit {
        let _ = cs
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(smorph_h)))
        .height(view::Live::Is(Some(smorph_h)))
        .radius(view::Live::Is(smorph_r))
        .shadow(view::Live::By(glass_control_shadow))
        .shadow_outside(view::Live::Is(true))
        .alpha(view::Live::By(fn() {
          let p = clamp(morph_way.shown_on(cs), 0.0, 1.0)
          merge_smoothstep(0.0, smorph_break_gap, smorph_visual_gap(p))
        }))
        let _ = cs.moved_by(cancel_move, cancel_end)
      })
    })
    let _ = stage.box(fn(bg : view::View) -> Unit {
      let _ = bg
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .width(view::Live::Is(Some(bar_w)))
      .height(view::Live::Is(Some(smorph_h)))
      .radius(view::Live::Is(smorph_r))
      .glass(view::Live::By(fn() {
        let p = clamp(morph_way.shown_on(bg), 0.0, 1.0)
        let m = if p <= 0.02 { 0.0 } else { bond.merge_on(bg) }
        Some(merge_glass(m))
      }))
      .ground_drawn(view::Live::By(fn() { bar_shape(bg) }))
    })
    let _ = stage.box(fn(cg : view::View) -> Unit {
      let _ = cg
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .width(view::Live::Is(Some(smorph_h)))
      .height(view::Live::Is(Some(smorph_h)))
      .radius(view::Live::Is(smorph_r))
      .glass(view::Live::By(fn() {
        let p = clamp(morph_way.shown_on(cg), 0.0, 1.0)
        if p <= 0.02 {
          None
        } else {
          let m = bond.merge_on(cg)
          if m > 0.0 {
            Some(merge_glass(m))
          } else {
            Some(merge_glass(0.0).sharing())
          }
        }
      }))
      let _ = cg.moved_by(cancel_move, cancel_end)
    })
    let _ = stage.box(fn(fg : view::View) -> Unit {
      let _ = fg.over(view::Live::Is(true))
      let _ = fg.box(fn(lead_ic : view::View) -> Unit {
        let _ = lead_ic
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(smorph_h)))
        .height(view::Live::Is(Some(smorph_h)))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .scale(view::Live::By(fn() {
          let p = clamp(morph_way.shown_on(lead_ic), 0.0, 1.0)
          lerp(1.0, 16.0 / 18.0, p) * (1.0 - 0.06 * clamp(orb_press.shown(lead_ic), 0.0, 1.0))
        }))
        let _ = lead_ic.box(fn(ic : view::View) -> Unit {
          let _ = ic
          .width(view::Live::Is(Some(16.0)))
          .height(view::Live::Is(Some(16.0)))
          .shrink(view::Live::Is(0.0))
          .shapes(view::Live::By(fn() {
            let p = clamp(morph_way.shown_on(ic), 0.0, 1.0)
            ctrl_search_shapes(16.0, lerp_color(colors().content, ovl_muted_ink(), p))
          }))
        })
      })
      fg.show(
        fn() { !expanded() },
        fn(col_host : view::View) -> Unit {
          let _ = col_host
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(smorph_h)))
          .height(view::Live::Is(Some(smorph_h)))
          .points(view::Live::By(fn() { !expanded() }))
          .alpha(view::Live::By(fn() { 1.0 - ctab_smoothstep(0.0, 0.35, morph_way.shown_on(col_host)) }))
          let _ = headless::button(
            col_host,
            label,
            fn(_e) -> Unit {
              set_expanded(true)
              field.focus()
            },
            fn(b : view::View, btn : headless::Button) -> Unit {
              b.reacts(at_start=false, fn() { btn.pressed() }, fn(p : Bool) -> Unit {
                orb_press.go(b, if p { 1.0 } else { 0.0 }, motion::snappy_damped)
              })
              let _ = b
              .width(view::Live::Is(Some(smorph_h)))
              .height(view::Live::Is(Some(smorph_h)))
              .radius(view::Live::Is(smorph_r))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
                let _ = ring
                .over(view::Live::Is(true))
                .points(view::Live::Is(false))
                .radius(view::Live::Is(smorph_r))
                .edge(view::Live::By(fn() { (2.0, colors().accent) }))
              })
            },
          )
        },
        leave=220.0,
      )
      fg.show(
        fn() { expanded() },
        fn(exp_host : view::View) -> Unit {
          let _ = exp_host.over(view::Live::Is(true)).points(view::Live::By(fn() { expanded() }))
          let _ = exp_host.box(fn(bar_fg : view::View) -> Unit {
            let _ = bar_fg
            .over(view::Live::Is(true))
            .row(view::Live::Is(true))
            .width(view::Live::Is(Some(bar_w)))
            .height(view::Live::Is(Some(smorph_h)))
            .padding(view::Live::Is((36.0, 0.0, 10.0, 0.0)))
            .gap(view::Live::Is(8.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .alpha(view::Live::By(fn() { ctab_smoothstep(0.30, 0.78, morph_way.shown_on(bar_fg)) }))
            bar_fg.reacts(fn() { is_dark() }, fn(_d : Bool) -> Unit {
              field.color = colors().content
              field.ph_color = ovl_muted_ink()
              field.caret_color = colors().accent
            })
            let _ = bar_fg.box(fn(fwrap : view::View) -> Unit {
              let text_dy = dmax(0.0, (smorph_h - type_body * 1.4) / 2.0)
              let _ = fwrap
              .grow(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .shrink(view::Live::Is(1.0))
              .min_width(view::Live::Is(Some(0.0)))
              .min_height(view::Live::Is(Some(text_dy + 36.0)))
              .margin(view::Live::Is((0.0, 0.0, 0.0, -(text_dy + 36.0 - smorph_h))))
              .clips(view::Live::Is(true))
              let typed = ui::field(
                fwrap,
                field,
                placeholder=placeholder,
                font_size=type_body,
                max_lines=1,
                enter_sends=true,
                label=signals::untracked(label),
                submitted=fn(s : String) -> Unit { match submitted { Some(f) => f(s); None => () } },
                edited=fn(s : String) -> Unit { match edited { Some(f) => f(s); None => () } },
                color=colors().content,
                placeholder_color=ovl_muted_ink(),
                caret_color=colors().accent,
              )
              let _ = typed
              .min_height(view::Live::Is(Some(36.0)))
              .drawn_off(view::Live::Is((0.0, text_dy)))
              .ink(view::Live::By(fn() {
                if field.text().length() > 0 || field.composing() {
                  colors().content
                } else {
                  ovl_muted_ink()
                }
              }))
              .presses(view::Live::Is(true))
              .focusable(view::Live::Is(true), keys=0)
              tf.control_node(typed)
            })
            bar_fg.show(
              fn() { field.text() != "" },
              fn(cl : view::View) -> Unit { ctrl_clear_button(loc=loc, cl, field, on_clear) },
              at_once=true,
            )
          })
          let _ = exp_host.box(fn(cancel_host : view::View) -> Unit {
            let _ = cancel_host
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(smorph_h)))
            .height(view::Live::Is(Some(smorph_h)))
            .alpha(view::Live::By(fn() { ctab_smoothstep(0.35, 0.85, morph_way.shown_on(cancel_host)) }))
            let _ = cancel_host.moved_by(cancel_move, cancel_end)
            let _ = headless::button(
              cancel_host,
              cancel_label,
              fn(_e) -> Unit {
                field.set("")
                set_expanded(false)
              },
              fn(b : view::View, btn : headless::Button) -> Unit {
                b.reacts(at_start=false, fn() { btn.pressed() }, fn(p : Bool) -> Unit {
                  cancel_press.go(b, if p { 1.0 } else { 0.0 }, motion::snappy_damped)
                })
                let _ = b
                .width(view::Live::Is(Some(smorph_h)))
                .height(view::Live::Is(Some(smorph_h)))
                .radius(view::Live::Is(smorph_r))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .scale(view::Live::By(fn() { 1.0 - 0.06 * clamp(cancel_press.shown(b), 0.0, 1.0) }))
                let _ = b.box(fn(ic : view::View) -> Unit {
                  let _ = ic
                  .width(view::Live::Is(Some(14.0)))
                  .height(view::Live::Is(Some(14.0)))
                  .shrink(view::Live::Is(0.0))
                  .shapes(view::Live::By(fn() { ctrl_close_shapes(14.0, colors().content) }))
                })
                b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
                  let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .radius(view::Live::Is(smorph_r))
                  .edge(view::Live::By(fn() { (2.0, colors().accent) }))
                })
              },
            )
          })
        },
        leave=220.0,
      )
    })
  })
}
