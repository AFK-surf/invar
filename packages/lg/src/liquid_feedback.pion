// Liquid Glass feedback, navigation and structured container components:
// Toast, ProgressBar, ProgressRing, NavBar, Toolbar, List, and Disclosure.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

/// Semantic status for `liquid_toast_node`.
#derive(Eq)
pub enum LiquidStatus {
  Info
  Success
  Warning
  Error
}

/// Composable single-layer Liquid Glass toast capsule shell (`liquid_toast_glass`, `glass_overlay_shadow`,
/// `shadow_outside(Is(true))`, solid-mode 1pt hairline fallback) for custom toast stacks and swipeable toaster layers.
pub fn liquid_toast_shell_node(
  parent : view::View,
  body : (view::View) -> Unit,
  radius~ : Double = ovl_toast_radius,
  max_width~ : Double = 420.0,
  solid? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(shell : view::View) -> Unit {
    let _ = shell
    .radius(view::Live::Is(radius))
    .max_width(view::Live::Is(Some(max_width)))
    .shadow(view::Live::By(glass_overlay_shadow))
    .shadow_outside(view::Live::Is(true))
    .glass(
      view::Live::By(fn() {
        let s = match solid {
          Some(f) => f()
          None => clear
        }
        Some(liquid_toast_glass(solid=s))
      }),
    )
    .edge(view::Live::By(fn() { if shell.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
    body(shell)
  })
}

pub fn liquid_toast_node(
  parent : view::View,
  visible : () -> Bool,
  title : () -> String,
  subtitle~ : () -> String = fn() { "" },
  status~ : LiquidStatus = LiquidStatus::Info,
  action_label~ : () -> String = fn() { "" },
  on_action? : () -> Unit,
  on_dismiss? : () -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let shown_visible = ovl_transitioned_bool(h, visible)
    h.show(shown_visible, leave=motion::pop_out_ms, fn(s : view::View) -> Unit {
      let (look, _) = motion::overlay_presence(s, enter=motion::pop_in, exit=motion::pop_out)
      let drag_x = motion::NodeWay::new(0.0)
      let drag_start_wx = ui::ref_new(0.0)
      let drag_start_x = ui::ref_new(0.0)
      let _ = s
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      .gap(view::Live::Is(ovl_toast_gap))
      .padding(view::Live::Is((ovl_toast_px, ovl_toast_py, ovl_toast_pr, ovl_toast_py)))
      .radius(view::Live::Is(ovl_toast_radius))
      .shadow(view::Live::By(glass_overlay_shadow))
      .shadow_outside(view::Live::Is(true))
      .glass(view::Live::By(fn() { Some(liquid_toast_glass()) }))
      .edge(view::Live::By(fn() { if s.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
      .alpha(view::Live::By(fn() { look().alpha * clamp(1.0 - drag_x.shown(s).abs() / 240.0, 0.0, 1.0) }))
      .scale(view::Live::By(fn() { look().sx }))
      .offset(view::Live::By(fn() { (drag_x.shown(s), 0.0) }))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Status, label=title(), description=subtitle())) }))
      match on_dismiss {
        Some(dismiss) => {
          let _ = s.gesture(
            ui::touch_slop(),
            press=fn(d : view::Drag) -> Unit {
              drag_start_wx.v = d.wx
              drag_start_x.v = drag_x.value_at(d.at)
            },
            drag=fn(d : view::Drag) -> Unit {
              match d.kind {
                Down | Moved => drag_x.put(drag_start_x.v + (d.wx - drag_start_wx.v))
                Up | Off => {
                  let cur = drag_x.value_at(d.at)
                  let vx = d.vx()
                  let is_up = match d.kind { Up => true; _ => false }
                  let should_dismiss = is_up && (cur.abs() > 72.0 || vx.abs() > 0.45)
                  if should_dismiss {
                    let dir = if cur >= 0.0 { 1.0 } else { -1.0 }
                    drag_x.go(s, dir * 240.0, motion::move_damped, velocity=vx)
                    dismiss()
                  } else {
                    drag_x.go(s, 0.0, motion::move_damped, velocity=vx)
                  }
                }
              }
            },
          )
        }
        None => ()
      }
      let _ = s.box(fn(ic : view::View) -> Unit {
        let _ = ic
        .width(view::Live::Is(Some(ovl_toast_icon_size)))
        .height(view::Live::Is(Some(ovl_toast_icon_size)))
        .margin(view::Live::Is((0.0, ovl_first_line_icon_pt, 0.0, 0.0)))
        .shrink(view::Live::Is(0.0))
        .shapes(view::Live::By(fn() { ovl_status_shapes(status, ovl_toast_icon_size, ovl_status_color(status)) }))
      })
      let _ = s.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(ovl_text_gap))
        let _ = col.box(fn(w : view::View) -> Unit {
          let _ = w
          .words(view::Live::By(title), look=words_at(ovl_type_body, weight=weight_medium, wrap=true))
          .ink(view::Live::By(fn() { colors().content }))
        })
        col.show(fn() { subtitle() != "" }, fn(sub : view::View) -> Unit {
          let _ = sub
          .words(view::Live::By(subtitle), look=words_at(ovl_type_sub, wrap=true))
          .ink(view::Live::By(ovl_muted_ink))
        })
      })
      match on_action {
        Some(act) =>
        s.show(fn() { action_label() != "" }, fn(slot : view::View) -> Unit {
          let _ = headless::button(slot, action_label, fn(_e) -> Unit { act() }, loc=loc, fn(b : view::View, btn : headless::Button) -> Unit {
            let press_scale = motion::NodeWay::new(0.0)
            b.reacts(at_start=false, fn() { btn.pressed() }, fn(on : Bool) -> Unit {
              press_scale.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
            })
            let _ = b
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .height(view::Live::Is(Some(ovl_toast_action_h)))
            .padding(view::Live::Is((ovl_toast_action_px, 0.0, ovl_toast_action_px, 0.0)))
            .radius(view::Live::Is(ovl_toast_action_h / 2.0))
            .scale(view::Live::By(fn() { 1.0 - 0.08 * clamp(press_scale.shown(b), 0.0, 1.0) }))
            let hover_t = motion::hover_fade(b, fn() { btn.hovered() })
            let press_t = motion::hover_fade(b, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
            let _ = b.ground(
              view::Live::By(fn() {
                let base = ovl_action_pill_ground()
                let h_v = hover_t()
                let p_v = press_t()
                let with_h = if h_v > 0.001 { over(base, alpha(ovl_row_hover(), h_v)) } else { base }
                if p_v > 0.001 { over(with_h, alpha(ovl_row_press(), p_v)) } else { with_h }
              }),
            )
            lg_focus_ring(b, fn() { btn.focus_shown() }, ovl_toast_action_h / 2.0)
            let _ = b.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::By(action_label), look=words_at(ovl_type_sub, weight=weight_medium))
              .ink(view::Live::By(fn() { colors().content }))
            })
          })
        })
        None => ()
      }
      match on_dismiss {
        Some(dismiss) => {
          let _ = headless::button(s, fn() { "Dismiss" }, fn(_e) -> Unit { dismiss() }, loc=loc, fn(b : view::View, btn : headless::Button) -> Unit {
            let press_scale = motion::NodeWay::new(0.0)
            b.reacts(at_start=false, fn() { btn.pressed() }, fn(on : Bool) -> Unit {
              press_scale.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
            })
            let _ = b
            .width(view::Live::Is(Some(ovl_toast_close_size)))
            .height(view::Live::Is(Some(ovl_toast_close_size)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(ovl_toast_close_size / 2.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .scale(view::Live::By(fn() { 1.0 - 0.08 * clamp(press_scale.shown(b), 0.0, 1.0) }))
            ovl_attach_row_ground(b, fn() { btn.hovered() }, fn() { btn.pressed() })
            lg_focus_ring(b, fn() { btn.focus_shown() }, ovl_toast_close_size / 2.0)
            let _ = b.box(fn(ic : view::View) -> Unit {
              let _ = ic
              .width(view::Live::Is(Some(ovl_close_icon_size)))
              .height(view::Live::Is(Some(ovl_close_icon_size)))
              .shapes(view::Live::By(fn() { ovl_close_shapes(ovl_close_icon_size, ovl_muted_ink()) }))
            })
          })
        }
        None => ()
      }
    })
  })
}

pub fn liquid_progress_bar_node(
  parent : view::View,
  value : () -> Option[Double],
  label~ : () -> String = fn() { "" },
  show_value~ : Bool = false,
  tint~ : Int64 = clear,
  height~ : Double = 8.0,
  loc~ : String = "",
) -> view::View {
  headless::progress(
    parent,
    value,
    min=0.0,
    max=1.0,
    label=label,
    loc=loc,
    fn(v : view::View, prog : headless::Progress) -> Unit {
      let fill_color = fn() -> Int64 { if tint != clear { tint } else { ovl_accent_ink() } }
      let prog_way = motion::NodeWay::new(signals::untracked(fn() { prog.part() * 100.0 }))
      v.reacts(at_start=false, fn() { if prog.indeterminate() { -1.0 } else { prog.part() * 100.0 } }, fn(pct : Double) -> Unit {
        if pct >= 0.0 {
          prog_way.go(v, pct, value_spring(0.05))
        }
      })
      let _ = v.gap(view::Live::Is(ovl_progress_gap))
      v.show(fn() { label() != "" || (show_value && !prog.indeterminate()) }, fn(hdr : view::View) -> Unit {
        let _ = hdr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = hdr.box(fn(w : view::View) -> Unit {
          let _ = w.words(view::Live::By(label), look=words_at(ovl_type_sub, weight=weight_medium)).ink(view::Live::By(fn() { colors().content }))
        })
        hdr.show(fn() { show_value && !prog.indeterminate() }, fn(val_box : view::View) -> Unit {
          let _ = val_box.row(view::Live::Is(true)).width(view::Live::Is(Some(38.0))).lies_along(view::Live::Is(view::Lies::End)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = val_box.box(fn(w : view::View) -> Unit {
            let _ = w
            .words(
              view::Live::By(fn() {
                let pct = (prog.part() * 100.0).round().to_int()
                "\{pct}%"
              }),
              look=words_at(ovl_type_meta),
            )
            .ink(view::Live::By(ovl_muted_ink))
          })
        })
      })
      let _ = v.box(fn(track : view::View) -> Unit {
        let _ = track
        .height(view::Live::Is(Some(height)))
        .radius(view::Live::Is(height / 2.0))
        .ground(view::Live::By(ovl_track_color))
        .clips(view::Live::Is(true))
        let _ = track.by_room(fn(inner : view::View, room : view::Room) -> Unit {
          let w = fn() -> Double { room.width() }
          let r = height / 2.0
          inner.show(fn() { !prog.indeterminate() }, fn(bar : view::View) -> Unit {
            let _ = bar
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(height)))
            .radius(view::Live::Is(r))
            .ground(view::Live::By(fill_color))
            .ground_drawn(view::Live::By(fn() {
              let tw = w()
              let shown = clamp(prog_way.shown(bar) / 100.0, 0.0, 1.0) * tw
              view::GroundShape::{ dx: 0.0, dy: 0.0, dw: shown - tw, dh: 0.0, corners: None }
            }))
          })
          inner.show(fn() { prog.indeterminate() }, fn(sweep : view::View) -> Unit {
            let _ = sweep
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(height)))
            .radius(view::Live::Is(r))
            .ground(view::Live::By(fill_color))
            .ground_drawn(view::Live::By(fn() {
              let tw = w()
              let c = sweep.cycle(motion::progress_sweep_ms)
              let sw = tw * ovl_progress_sweep_w
              let dx = c * (tw - sw)
              view::GroundShape::{ dx, dy: 0.0, dw: sw - tw, dh: 0.0, corners: None }
            }))
          })
        })
      })
    },
  )
}

pub fn liquid_progress_ring_node(
  parent : view::View,
  value : () -> Option[Double],
  size~ : Double = 36.0,
  stroke~ : Double = 3.5,
  tint~ : Int64 = clear,
  label~ : () -> String = fn() { "Progress" },
  loc~ : String = "",
) -> view::View {
  headless::progress(
    parent,
    value,
    min=0.0,
    max=1.0,
    label=label,
    loc=loc,
    fn(v : view::View, prog : headless::Progress) -> Unit {
      let ring_color = fn() -> Int64 { if tint != clear { tint } else { ovl_accent_ink() } }
      let ring_way = motion::NodeWay::new(signals::untracked(fn() { prog.part() * 100.0 }))
      v.reacts(at_start=false, fn() { if prog.indeterminate() { -1.0 } else { prog.part() * 100.0 } }, fn(pct : Double) -> Unit {
        if pct >= 0.0 {
          ring_way.go(v, pct, value_spring(0.05))
        }
      })
      let _ = v
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .shapes(view::Live::By(fn() {
        if prog.indeterminate() {
          let phase = v.cycle(motion::progress_sweep_ms)
          ovl_ring_shapes(size, stroke, phase, 0.28, ring_color(), ovl_track_color())
        } else {
          ovl_ring_shapes(
            size,
            stroke,
            0.0,
            clamp(ring_way.shown(v) / 100.0, 0.0, 1.0),
            ring_color(),
            ovl_track_color(),
          )
        }
      }))
    },
  )
}

pub fn liquid_nav_bar_node(
  parent : view::View,
  title : () -> String,
  subtitle~ : () -> String = fn() { "" },
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  height~ : Double = 46.0,
  glass~ : Bool = false,
  compact~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Between))
    .height(view::Live::Is(Some(height)))
    .padding(view::Live::By(fn() {
      let px = if compact() { 2.0 } else { ovl_nav_px }
      (px, 0.0, px, 0.0)
    }))
    .gap(view::Live::By(fn() { if compact() { 6.0 } else { ovl_nav_gap } }))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Navigation, label=title())) }))
    if glass {
      let _ = bar.radius(view::Live::Is(height / 2.0))
      lg_apply_glass_surface(bar, fn() { lg_capsule_glass() })
    }
    match leading {
      Some(draw_leading) => {
        let _ = bar.box(fn(slot : view::View) -> Unit {
          let _ = slot
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::By(fn() { if compact() { 6.0 } else { ovl_toolbar_gap } }))
          draw_leading(slot)
        })
      }
      None => ()
    }
    let _ = bar.box(fn(mid : view::View) -> Unit {
      let _ = mid.grow(view::Live::Is(1.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(ovl_text_gap))
      let _ = mid.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(title), look=words_at(ovl_type_heading, weight=ovl_weight_semibold))
        .ink(view::Live::By(fn() { colors().content }))
      })
      mid.show(fn() { subtitle() != "" }, fn(sub : view::View) -> Unit {
        let _ = sub.words(view::Live::By(subtitle), look=words_at(ovl_type_meta)).ink(view::Live::By(ovl_muted_ink))
      })
    })
    match trailing {
      Some(draw_trailing) => {
        let _ = bar.box(fn(slot : view::View) -> Unit {
          let _ = slot
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::By(fn() { if compact() { 6.0 } else { ovl_toolbar_gap } }))
          draw_trailing(slot)
        })
      }
      None => ()
    }
  })
}

pub fn liquid_toolbar_node(
  parent : view::View,
  body : (view::View) -> Unit,
  height~ : Double = 42.0,
  pad_x~ : Double = ovl_toolbar_px,
  pad? : Double,
  gap~ : Double = ovl_toolbar_gap,
  loc~ : String = "",
) -> view::View {
  let eff_pad = match pad {
    Some(p) => p
    None => pad_x
  }
  parent.box(loc=loc, fn(bar : view::View) -> Unit {
    let _ = bar
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(height)))
    .padding(view::Live::Is((eff_pad, 0.0, eff_pad, 0.0)))
    .gap(view::Live::Is(gap))
    .radius(view::Live::Is(height / 2.0))
    .shadow(view::Live::By(glass_overlay_shadow))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(liquid_capsule_glass()) }))
    .edge(view::Live::By(fn() { if bar.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
    .says(view::Live::Is(Some(view::said(view::Role::Toolbar, label="Toolbar"))))
    body(bar)
  })
}

pub fn liquid_toolbar_divider(
  parent : view::View,
  height~ : Double = 20.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(div : view::View) -> Unit {
    let _ = div
    .width(view::Live::Is(Some(ovl_hairline_h)))
    .height(view::Live::Is(Some(height)))
    .shrink(view::Live::Is(0.0))
    .ground(view::Live::By(ovl_hairline))
  })
}

pub fn liquid_panel_node(
  parent : view::View,
  body : (view::View) -> Unit,
  radius~ : Double = ovl_panel_radius,
  pad~ : Double = ovl_panel_pad,
  gap~ : Double = 0.0,
  label~ : () -> String = fn() { "Panel" },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(panel : view::View) -> Unit {
    let _ = panel
    .padding(view::Live::Is((pad, pad, pad, pad)))
    .gap(view::Live::Is(gap))
    .radius(view::Live::Is(radius))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
    lg_apply_glass_surface(panel, fn() { lg_panel_glass() })
    body(panel)
  })
}

pub struct LiquidListRow {
  pub title : String
  pub subtitle : String
  pub value : String
  pub icon : Option[(view::View, () -> Int64) -> Unit]
  pub chevron : Bool
  pub on_press : Option[() -> Unit]
  pub active : Bool
  pub destructive : Bool
  pub disabled : Bool
}

pub fn LiquidListRow::new(
  title~ : String,
  subtitle~ : String = "",
  value~ : String = "",
  icon? : (view::View, () -> Int64) -> Unit,
  chevron~ : Bool = false,
  on_press? : () -> Unit,
  active~ : Bool = false,
  destructive~ : Bool = false,
  disabled~ : Bool = false,
) -> LiquidListRow {
  LiquidListRow::{ title, subtitle, value, icon, chevron, on_press, active, destructive, disabled }
}

struct LiquidListItem {
  key : String
  idx : Int
  has_press : Bool
  has_icon : Bool
  row : LiquidListRow
}

impl signals::Eq for LiquidListItem {
  fn eq(self : LiquidListItem, other : LiquidListItem) -> Bool {
    self.key == other.key &&
    self.idx == other.idx &&
    self.has_press == other.has_press &&
    self.has_icon == other.has_icon &&
    self.row.title == other.row.title &&
    self.row.subtitle == other.row.subtitle &&
    self.row.value == other.row.value &&
    self.row.chevron == other.row.chevron &&
    self.row.active == other.row.active &&
    self.row.destructive == other.row.destructive &&
    self.row.disabled == other.row.disabled
  }
}

fn ovl_list_items(rows : Array[LiquidListRow]) -> Array[LiquidListItem] {
  let seen : Map[String, Int] = Map::new()
  let out : Array[LiquidListItem] = []
  let mut idx = 0
  while idx < rows.length() {
    let row = rows[idx]
    let n = match seen.get(row.title) {
      Some(c) => c
      None => 0
    }
    seen.set(row.title, n + 1)
    let has_press = match row.on_press { Some(_) => true; None => false }
    let has_icon = match row.icon { Some(_) => true; None => false }
    let press_tag = if has_press { "p" } else { "s" }
    let key = if n == 0 { "\{press_tag}:\{row.title}" } else { "\{press_tag}:\{row.title}#\{n}" }
    out.push(LiquidListItem::{ key, idx, has_press, has_icon, row })
    idx += 1
  }
  out
}

fn ovl_list_row_inner(r : view::View, item_sig : signals::Signal[LiquidListItem], loc~ : String = "") -> Unit {
  let row = fn() -> LiquidListRow { item_sig.get().row }
  let title_ink = fn() -> Int64 {
    let cur = row()
    if cur.destructive { ovl_destructive() } else { colors().content }
  }
  r.show(fn() { item_sig.get().has_icon }, fn(ic : view::View) -> Unit {
    let _ = ic
    .width(view::Live::Is(Some(ovl_toast_icon_size)))
    .height(view::Live::Is(Some(ovl_toast_icon_size)))
    .margin(view::Live::Is((0.0, ovl_first_line_icon_pt, 0.0, 0.0)))
    .shrink(view::Live::Is(0.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    match item_sig.untracked().row.icon {
      Some(draw_icon) => draw_icon(ic, title_ink)
      None => ()
    }
  })
  let _ = r.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(ovl_text_gap))
    let _ = col.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::By(fn() { row().title }), look=words_at(ovl_type_body, wrap=true)).ink(view::Live::By(title_ink))
    })
    col.show(fn() { row().subtitle != "" }, fn(sub : view::View) -> Unit {
      let _ = sub.words(view::Live::By(fn() { row().subtitle }), look=words_at(ovl_type_sub, wrap=true)).ink(view::Live::By(ovl_muted_ink))
    })
  })
  r.show(fn() { row().value != "" }, fn(v : view::View) -> Unit {
    let _ = v
    .margin(view::Live::Is((0.0, ovl_first_line_sub_pt, 0.0, 0.0)))
    .words(view::Live::By(fn() { row().value }), look=words_at(ovl_type_sub))
    .ink(view::Live::By(ovl_muted_ink))
  })
  r.show(fn() { row().chevron }, fn(ch : view::View) -> Unit {
    let _ = ch
    .width(view::Live::Is(Some(ovl_list_chevron)))
    .height(view::Live::Is(Some(ovl_list_chevron)))
    .margin(view::Live::Is((0.0, ovl_first_line_chevron_pt, 0.0, 0.0)))
    .shrink(view::Live::Is(0.0))
    .shapes(view::Live::By(fn() { ovl_chevron_right_shapes(ovl_list_chevron, ovl_muted_ink()) }))
  })
}

pub fn liquid_list_node(
  parent : view::View,
  rows : () -> Array[LiquidListRow],
  header~ : () -> String = fn() { "" },
  footer~ : () -> String = fn() { "" },
  dividers~ : Bool = true,
  flat~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(wrap : view::View) -> Unit {
    wrap.show(fn() { header() != "" }, fn(h : view::View) -> Unit {
      let _ = h.padding(view::Live::Is((ovl_list_meta_px, 0.0, ovl_list_meta_px, ovl_list_meta_py)))
      let _ = h.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(header), look=words_at(ovl_type_meta, weight=ovl_weight_semibold))
        .ink(view::Live::By(ovl_muted_ink))
      })
    })
    let _ = wrap.box(fn(card : view::View) -> Unit {
      let _ = card
      .padding(view::Live::Is((ovl_list_pad, ovl_list_pad, ovl_list_pad, ovl_list_pad)))
      .radius(view::Live::Is(ovl_list_radius))
      .says(view::Live::By(fn() {
        let h = header()
        Some(view::said(view::Role::Group, label=if h != "" { h } else { "List" }))
      }))
      if flat {
        let _ = card
        .ground(view::Live::By(fn() { if is_dark() { 0xFFFFFF12L } else { 0x0000000AL } }))
        .edge(view::Live::By(fn() { (0.5, ovl_hairline()) }))
      } else {
        lg_apply_glass_surface(card, fn() { lg_panel_glass() })
      }
      if !dividers {
        let _ = card.gap(view::Live::Is(ovl_list_gap_nodiv))
      }
      card.each(fn() { ovl_list_items(rows()) }, fn(it : LiquidListItem) -> String { it.key }, fn(slot : view::View, item_sig : signals::Signal[LiquidListItem]) -> Unit {
        if dividers {
          slot.show(fn() { item_sig.get().idx > 0 }, at_once=true, fn(sep : view::View) -> Unit {
            let _ = sep.padding(view::Live::Is((ovl_list_sep_inset, ovl_list_sep_py, ovl_list_sep_inset, ovl_list_sep_py)))
            let _ = sep.box(fn(line : view::View) -> Unit {
              let _ = line.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
            })
          })
        }
        let init_press = item_sig.untracked().has_press
        if init_press {
          let _ = headless::button(
            slot,
            fn() { item_sig.get().row.title },
            fn(_e) -> Unit {
              let cur = item_sig.untracked().row
              if !cur.disabled {
                match cur.on_press {
                  Some(press) => press()
                  None => ()
                }
              }
            },
            disabled=fn() { item_sig.get().row.disabled },
            loc=loc,
            fn(r : view::View, btn : headless::Button) -> Unit {
              let _ = r
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Start)))
              .min_height(view::Live::Is(Some(ovl_list_row_min_h)))
              .padding(view::Live::Is((ovl_list_row_px, ovl_list_row_py, ovl_list_row_px, ovl_list_row_py)))
              .gap(view::Live::Is(ovl_list_row_gap))
              .radius(view::Live::Is(ovl_list_row_radius))
              .alpha(view::Live::By(fn() { if btn.disabled() { ovl_disabled_alpha } else { 1.0 } }))
              ovl_attach_row_ground(
                r,
                fn() { btn.hovered() },
                fn() { btn.pressed() },
                selected=fn() { item_sig.get().row.active },
                disabled=fn() { btn.disabled() },
              )
              lg_focus_ring(r, fn() { btn.focus_shown() }, ovl_list_row_radius)
              ovl_list_row_inner(r, item_sig)
            },
          )
        } else {
          let _ = slot.box(fn(r : view::View) -> Unit {
            let _ = r
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .min_height(view::Live::Is(Some(ovl_list_row_min_h)))
            .padding(view::Live::Is((ovl_list_row_px, ovl_list_row_py, ovl_list_row_px, ovl_list_row_py)))
            .gap(view::Live::Is(ovl_list_row_gap))
            .radius(view::Live::Is(ovl_list_row_radius))
            .ground(view::Live::By(fn() { if item_sig.get().row.active { ovl_row_selected() } else { clear } }))
            .alpha(view::Live::By(fn() { if item_sig.get().row.disabled { ovl_disabled_alpha } else { 1.0 } }))
            ovl_list_row_inner(r, item_sig)
          })
        }
      })
    })
    wrap.show(fn() { footer() != "" }, fn(f : view::View) -> Unit {
      let _ = f.padding(view::Live::Is((ovl_list_meta_px, ovl_list_meta_py, ovl_list_meta_px, 0.0)))
      let _ = f.box(fn(w : view::View) -> Unit {
        let _ = w.words(view::Live::By(footer), look=words_at(ovl_type_meta, wrap=true)).ink(view::Live::By(ovl_muted_ink))
      })
    })
  })
}

pub fn liquid_disclosure_node(
  parent : view::View,
  title : () -> String,
  open : () -> Bool,
  on_toggle : (Bool) -> Unit,
  content : (view::View) -> Unit,
  subtitle~ : () -> String = fn() { "" },
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let chev_turn = motion::NodeWay::new(if signals::untracked(open) { ovl_turn_quarter } else { 0.0 })
  let body_way = motion::NodeWay::new(if signals::untracked(open) { 1.0 } else { 0.0 })
  parent.box(loc=loc, fn(card : view::View) -> Unit {
    let _ = card
    .padding(view::Live::Is((ovl_disc_pad, ovl_disc_pad, ovl_disc_pad, ovl_disc_pad)))
    .radius(view::Live::Is(ovl_disc_radius))
    lg_apply_glass_surface(card, fn() { lg_panel_glass() })
    card.reacts(open, at_start=false, fn(is_open : Bool) -> Unit {
      chev_turn.go(card, if is_open { ovl_turn_quarter } else { 0.0 }, motion::snappy_damped)
      body_way.go(card, if is_open { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    let _ = headless::disclosure(
      card,
      title,
      open,
      fn(_e) -> Unit { on_toggle(!signals::untracked(open)) },
      disabled=disabled,
      loc=loc,
      fn(hdr : view::View, d : headless::Disclosure) -> Unit {
        let _ = hdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .padding(view::Live::Is((ovl_disc_hdr_px, ovl_disc_hdr_py, ovl_disc_hdr_px, ovl_disc_hdr_py)))
        .gap(view::Live::Is(ovl_list_row_gap))
        .radius(view::Live::Is(ovl_disc_hdr_radius))
        .alpha(view::Live::By(fn() { if d.disabled() { ovl_disabled_alpha } else { 1.0 } }))
        ovl_attach_row_ground(
          hdr,
          fn() { d.hovered() },
          fn() { d.pressed() },
          disabled=fn() { d.disabled() },
        )
        lg_focus_ring(hdr, fn() { d.focus_shown() }, ovl_disc_hdr_radius)
        let _ = hdr.box(fn(col : view::View) -> Unit {
          let _ = col.grow(view::Live::Is(1.0)).gap(view::Live::Is(ovl_text_gap))
          let _ = col.box(fn(w : view::View) -> Unit {
            let _ = w
            .words(view::Live::By(title), look=words_at(ovl_type_body, weight=weight_medium, wrap=true))
            .ink(view::Live::By(fn() { colors().content }))
          })
          col.show(fn() { subtitle() != "" }, fn(sub : view::View) -> Unit {
            let _ = sub.words(view::Live::By(subtitle), look=words_at(ovl_type_sub, wrap=true)).ink(view::Live::By(ovl_muted_ink))
          })
        })
        let _ = hdr.box(fn(ch : view::View) -> Unit {
          let _ = ch
          .width(view::Live::Is(Some(ovl_disc_chevron)))
          .height(view::Live::Is(Some(ovl_disc_chevron)))
          .margin(view::Live::Is((0.0, ovl_first_line_chevron_pt, 0.0, 0.0)))
          .shrink(view::Live::Is(0.0))
          .turn(view::Live::By(fn() { chev_turn.shown(ch) }))
          .shapes(view::Live::By(fn() { ovl_chevron_right_shapes(ovl_disc_chevron, ovl_muted_ink()) }))
        })
      },
    )
    card.show(open, fn(body : view::View) -> Unit {
      let _ = body
      .alpha(view::Live::By(fn() { clamp(body_way.shown(body), 0.0, 1.0) }))
      .offset(view::Live::By(fn() { (0.0, lerp(-6.0, 0.0, clamp(body_way.shown(body), 0.0, 1.0))) }))
      let _ = body.box(fn(sep : view::View) -> Unit {
        let _ = sep.padding(view::Live::Is((ovl_list_sep_inset, ovl_list_sep_py, ovl_list_sep_inset, ovl_list_sep_py)))
        let _ = sep.box(fn(line : view::View) -> Unit {
          let _ = line.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
        })
      })
      let _ = body.box(fn(inner : view::View) -> Unit {
        let _ = inner.padding(view::Live::Is((ovl_disc_body_px, ovl_disc_body_py, ovl_disc_body_px, ovl_disc_body_py)))
        content(inner)
      })
    })
  })
}
