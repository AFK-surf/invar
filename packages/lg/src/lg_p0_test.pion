// Unit tests for shared pill scope, popover preemption & rest_glass recovery,
// capsule decorator priorities, and segmented control unequal-width / glass_track alignment.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

fn p0_has_edge(t : ui::Tester, expected_w : Double, expected_color : Int64) -> Bool {
  let ch = fn(v : Double) -> Int64 { (v * 255.0).round().to_int64() }
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 15 && a[5] == 0.0 && (a[6] - expected_w).abs() < 0.05 {
      let c = (ch(a[12]) << 24) | (ch(a[13]) << 16) | (ch(a[14]) << 8) | ch(a[15])
      if c == expected_color {
        return true
      }
    }
    i += 1
  }
  false
}

fn p0_has_shadow_color(t : ui::Tester, expected_color : Int64) -> Bool {
  let ch = fn(v : Double) -> Int64 { (v * 255.0).round().to_int64() }
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 11 && a[5] == 2.0 {
      let c = (ch(a[8]) << 24) | (ch(a[9]) << 16) | (ch(a[10]) << 8) | ch(a[11])
      if c == expected_color {
        return true
      }
    }
    i += 1
  }
  false
}

test "lg_pill_scope_exports_adaptive_default_direction_and_press_by" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))
  debug_assert(liquid_pill_hover_ink() == 0x0000001CL, "light hover ink")
  set_dark(Some(true))
  debug_assert(liquid_pill_hover_ink() == 0xFFFFFF29L, "dark hover ink")
  set_dark(Some(false))

  let ext_down = signals::signal(false)
  let show_btn = signals::signal(true)
  let default_pill_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let adapt_pill_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let float_pill_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let vert_pill_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let outside_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let inside_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)

  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(r : view::View) -> Unit {
      let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(12.0))
      let out = r.box(fn(b : view::View) -> Unit {
        let _ = b.width(view::Live::Is(Some(24.0))).height(view::Live::Is(Some(24.0)))
      })
      outside_ref.v = Some(out)

      let g_def = liquid_pill_group_node(r, fn(pg : view::View) -> Unit {
        pg.show(fn() { show_btn.get() }, fn(holder : view::View) -> Unit {
          let b = holder.box(fn(btn : view::View) -> Unit {
            let _ = btn.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
          })
          inside_ref.v = Some(b)
          bind_pill_press_by(b, fn() { ext_down.get() })
        })
      })
      default_pill_ref.v = Some(g_def)

      let g_ad = liquid_pill_group_node(
        r,
        fn(pg : view::View) -> Unit {
          let _ = pg.box(fn(b : view::View) -> Unit {
            let _ = b.width(view::Live::Is(Some(28.0))).height(view::Live::Is(Some(28.0)))
          })
        },
        adaptive=true,
      )
      adapt_pill_ref.v = Some(g_ad)

      let g_flt = liquid_pill_group_node(
        r,
        fn(pg : view::View) -> Unit {
          let _ = pg.box(fn(b : view::View) -> Unit {
            let _ = b.width(view::Live::Is(Some(28.0))).height(view::Live::Is(Some(28.0)))
          })
        },
        floating=true,
        tint=fn() { 0x0088FF66L },
      )
      float_pill_ref.v = Some(g_flt)

      let g_vert = liquid_pill_group_node(
        r,
        fn(pg : view::View) -> Unit {
          let _ = pg.box(fn(b : view::View) -> Unit {
            let _ = b.width(view::Live::Is(Some(30.0))).height(view::Live::Is(Some(30.0)))
          })
          let _ = pg.box(fn(b : view::View) -> Unit {
            let _ = b.width(view::Live::Is(Some(30.0))).height(view::Live::Is(Some(30.0)))
          })
        },
        height=38.0,
        pad=4.0,
        pad_y=6.0,
        gap=4.0,
        direction=PillDirection::Vertical,
      )
      vert_pill_ref.v = Some(g_vert)
    })
  })
  t.run_shown(springs_out)

  let out_v = match outside_ref.v { Some(v) => v; None => { debug_assert(false, "outside view"); t.dispose(); return } }
  let in_v = match inside_ref.v { Some(v) => v; None => { debug_assert(false, "inside view"); t.dispose(); return } }
  let g_def = match default_pill_ref.v { Some(v) => v; None => { debug_assert(false, "default pill"); t.dispose(); return } }
  let g_ad = match adapt_pill_ref.v { Some(v) => v; None => { debug_assert(false, "adaptive pill"); t.dispose(); return } }
  let g_flt = match float_pill_ref.v { Some(v) => v; None => { debug_assert(false, "floating pill"); t.dispose(); return } }
  let g_vert = match vert_pill_ref.v { Some(v) => v; None => { debug_assert(false, "vertical pill"); t.dispose(); return } }

  debug_assert(!in_liquid_pill(out_v), "outside node must not be in_liquid_pill")
  debug_assert(in_liquid_pill(in_v), "child inside pill group must be in_liquid_pill")

  let trig_def = match g_def.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "default pill must lend PillTriggerScope"); t.dispose(); return }
  }
  let trig_ad = match g_ad.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "adaptive pill must lend PillTriggerScope"); t.dispose(); return }
  }
  let trig_flt = match g_flt.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "floating pill must lend PillTriggerScope"); t.dispose(); return }
  }
  let trig_vert = match g_vert.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "vertical pill must lend PillTriggerScope"); t.dispose(); return }
  }

  // Default adaptive=false regression check
  debug_assert(!(trig_def.rest_glass)().adaptive, "default liquid_pill_group_node must keep adaptive=false")
  debug_assert((trig_ad.rest_glass)().adaptive, "adaptive=true must enable adaptive glass")
  debug_assert((trig_flt.rest_glass)().adaptive, "floating=true must use floating glass (adaptive=true)")
  debug_assert((trig_flt.rest_glass)().tint == 0x0088FF66L, "floating tint must apply to rest_glass")
  debug_assert(trig_vert.direction == PillDirection::Vertical, "vertical pill direction")
  let (_, _, vw, vh) = g_vert.placed_window_now()
  debug_assert((vw - 38.0).abs() < 0.5 && vh >= 72.0, "vertical pill uses height as width and stacks children")

  // bind_pill_press_by drives fx spot + scale and cleans up trig.children on unmount
  debug_assert(trig_def.children.length() == 1, "bind_pill_press_by registers child in trig.children")
  ext_down.set(true)
  t.run_for(120.0)
  let has_spot = match trig_def.fx.untracked().0 { Some(_) => true; None => false }
  debug_assert(has_spot, "bind_pill_press_by must set fx spot when down=true")
  debug_assert(g_def.drawn_scale() > 1.01, "bind_pill_press_by must spring-scale outer pill")
  ext_down.set(false)
  t.run_for(springs_out)
  let cleared_spot = match trig_def.fx.untracked().0 { None => true; Some(_) => false }
  debug_assert(cleared_spot, "bind_pill_press_by must clear fx spot on release")

  show_btn.set(false)
  t.run_for(springs_out)
  debug_assert(trig_def.children.length() == 0, "unmounting child must remove it from trig.children")
  t.dispose()
}

test "lg_pill_popover_preemption_and_rest_glass_recovery" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  let open_a = signals::signal(false)
  let open_b = signals::signal(false)
  let pill_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)

  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(host : view::View) -> Unit {
      let _ = host.width(view::Live::Is(Some(480.0))).height(view::Live::Is(Some(320.0)))
      let g = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
        let _ = liquid_popover_node(
          pg,
          host,
          fn() { open_a.get() },
          fn(v : Bool) -> Unit { open_a.set(v) },
          fn() { "Menu A" },
          fn(tr : view::View, _d : headless::Disclosure) -> Unit {
            bind_pill_press(tr)
            let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0)))
          },
          fn() { "Panel A" },
          fn(c : view::View) -> Unit {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Body A"), look=words_at(14.0))
            })
          },
          width=180.0,
        )
        let _ = liquid_popover_node(
          pg,
          host,
          fn() { open_b.get() },
          fn(v : Bool) -> Unit { open_b.set(v) },
          fn() { "Menu B" },
          fn(tr : view::View, _d : headless::Disclosure) -> Unit {
            bind_pill_press(tr)
            let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0)))
          },
          fn() { "Panel B" },
          fn(c : view::View) -> Unit {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Body B"), look=words_at(14.0))
            })
          },
          width=180.0,
        )
      })
      pill_ref.v = Some(g)
    })
  })
  t.run_shown(springs_out)

  let pill = match pill_ref.v { Some(v) => v; None => { debug_assert(false, "pill captured"); t.dispose(); return } }
  let trig = match pill.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "pill trigger scope"); t.dispose(); return }
  }
  let rest_blur = (trig.rest_glass)().blur
  debug_assert(trig.morph_owner == 0 && trig.fx.untracked().1 == 0, "at rest morph_owner=0 and layer=0")

  // Open Popover A
  open_a.set(true)
  t.run_for(120.0)
  let owner_a = trig.morph_owner
  let layer_a = trig.fx.untracked().1
  let has_mg_a = match trig.morph_glass.v { Some(_) => true; None => false }
  debug_assert(owner_a == 1 && layer_a > 0 && has_mg_a, "opening A must claim morph_owner=1 and install morph_glass")

  // Preempt A by opening Popover B on the same pill before closing A
  open_b.set(true)
  t.run_for(60.0)
  debug_assert(trig.morph_owner == 2, "opening B must preempt A and advance morph_owner=2")
  open_a.set(false)
  t.run_for(400.0)
  let still_owned_by_b = trig.morph_owner == 2 && trig.fx.untracked().1 > 0
  let has_mg_b = match trig.morph_glass.v { Some(_) => true; None => false }
  debug_assert(still_owned_by_b && has_mg_b, "closing superseded A must not clear B's morph_glass")

  // Close Popover B -> verify mid-close rest_glass handoff and final restore
  open_b.set(false)
  t.run_for(360.0)
  let mid_close_glass = match trig.morph_glass.v {
    Some(mg) => mg()
    None => Some((trig.rest_glass)())
  }
  let mid_ok = match mid_close_glass {
    Some(g) => (g.blur - rest_blur).abs() < 0.01
    None => false
  }
  debug_assert(mid_ok, "after platter handoff during close, trigger must recover rest_glass")

  t.run_for(500.0)
  let mg_cleared = match trig.morph_glass.v { None => true; Some(_) => false }
  let ms_cleared = match trig.morph_shadow.v { None => true; Some(_) => false }
  debug_assert(mg_cleared && ms_cleared && trig.fx.untracked().1 == 0, "close settle must clear morph overrides and reset layer=0")
  debug_assert((pill.drawn_scale() - 1.0).abs() < 0.002, "pill scale must settle back to 1.0")
  t.dispose()
}

test "lg_capsule_decorate_priorities_glass_extra_blur_edge_shadow_trigger" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  let is_active = signals::signal(false)
  let extra = signals::signal(4.5)
  let cap_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let custom_edge_color = 0xFF3366FFL
  let custom_shadow_color = 0x2244AA88L

  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(v : view::View) -> Unit {
      // Pre-existing edge and shadow bindings that must be preserved when with_edge=false / with_shadow=false
      let _ = v
      .width(view::Live::Is(Some(120.0)))
      .height(view::Live::Is(Some(44.0)))
      .edge(view::Live::Is((2.0, custom_edge_color)))
      .shadow(view::Live::Is((7.0, 3.0, custom_shadow_color)))
      let _ = liquid_capsule_decorate(
        v,
        min_height=Some(44.0),
        radius=Some(22.0),
        glass=fn(_sp : Option[(Double, Double)]) -> paint::Glass {
          liquid_bar_pill_glass(sharing=false)
        },
        extra_blur=fn() { extra.get() },
        active=fn() { is_active.get() },
        with_edge=false,
        with_shadow=false,
        trigger=true,
      )
      cap_ref.v = Some(v)
    })
  })
  t.run_shown(springs_out)

  let cap = match cap_ref.v { Some(v) => v; None => { debug_assert(false, "capsule captured"); t.dispose(); return } }
  let trig = match cap.lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "trigger=true must lend PillTriggerScope"); t.dispose(); return }
  }

  // 1. active=false hides glass even with custom glass + trigger=true, while preserving existing edge & shadow
  debug_assert(count_liquid_glass(t) == 0, "active=false must emit 0 liquid glass")
  debug_assert(p0_has_edge(t, 2.0, custom_edge_color), "with_edge=false must preserve existing edge binding")
  debug_assert(p0_has_shadow_color(t, custom_shadow_color), "with_shadow=false must preserve existing shadow binding")
  debug_assert(!trig.has_press_scale, "capsule trigger scope has_press_scale=false")

  // 2. Custom glass + extra_blur applies (base bar_pill blur=1.2 + extra=4.5 == 5.7)
  let rg = (trig.rest_glass)()
  debug_assert((rg.blur - 5.7).abs() < 0.01, "custom glass must preserve extra_blur logic")

  // 3. active=true shows glass; trigger morph_glass override works when active=true
  is_active.set(true)
  t.frame()
  debug_assert(count_liquid_glass(t) == 1, "active=true must emit 1 liquid glass")

  trig.morph_glass.v = Some(fn() { None })
  trig.fx.set((None, 200))
  t.frame()
  debug_assert(count_liquid_glass(t) == 0, "trigger morph_glass returning None must hide capsule glass")

  // Clear trigger override via fx update -> glass returns; active=false wins over active trigger override
  trig.morph_glass.v = Some(fn() { Some((trig.rest_glass)()) })
  trig.fx.set((None, 201))
  t.frame()
  debug_assert(count_liquid_glass(t) == 1, "trigger morph_glass returning rest_glass restores glass")
  is_active.set(false)
  t.frame()
  debug_assert(count_liquid_glass(t) == 0, "active=false must win over trigger morph_glass")
  // Restoring active=true and resetting fx layer to 0 returns to normal capsule glass
  trig.morph_glass.v = None
  trig.fx.set((None, 0))
  is_active.set(true)
  t.frame()
  debug_assert(count_liquid_glass(t) == 1, "clearing trigger override with active=true restores capsule glass")
  t.dispose()
}

test "lg_segmented_unequal_widths_gap_drag_keyboard_in_node_and_reduced_motion" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  let sel = signals::signal(0)
  let show_a11y = signals::signal(true)
  let seg_host_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t = lg_case(fn(p : view::View) -> Unit {
    let host = p.box(fn(box_v : view::View) -> Unit {
      let _ = liquid_segmented_node(
        box_v,
        fn() { ["S", "MediumWide", "End"] },
        fn() { sel.get() },
        fn(i : Int) -> Unit { sel.set(i) },
        pad=4.0,
        gap=8.0,
        widths=fn() { [56.0, 112.0, 72.0] },
        height_by=fn() { 36.0 },
        text_size=fn() { 13.5 },
        kind=headless::GroupKind::Radio,
        said="Density",
        shown=fn() { show_a11y.get() },
        in_node=true,
      )
    })
    seg_host_ref.v = Some(host)
  })
  t.run_shown(springs_out)

  let seg_host = match seg_host_ref.v { Some(v) => v; None => { debug_assert(false, "host captured"); t.dispose(); return } }
  let (_, _, hw, hh) = seg_host.placed_window_now()
  // Expected width = 2*pad(8) + 56 + 112 + 72 + 2*gap(16) = 264, height = 36
  debug_assert((hw - 264.0).abs() < 1.0 && (hh - 36.0).abs() < 0.5, "in_node segmented must size directly on host (w=264, h=36)")

  let s0 = require_drawn(t, "S", view::Role::Radio)
  let s1 = require_drawn(t, "MediumWide", view::Role::Radio)
  let s2 = require_drawn(t, "End", view::Role::Radio)
  debug_assert((s0.w - 56.0).abs() < 0.5 && (s1.w - 112.0).abs() < 0.5 && (s2.w - 72.0).abs() < 0.5, "unequal item widths must match [56, 112, 72]")
  debug_assert(((s1.x - (s0.x + s0.w)) - 8.0).abs() < 0.5, "gap between item 0 and 1 must be 8pt")
  debug_assert(((s2.x - (s1.x + s1.w)) - 8.0).abs() < 0.5, "gap between item 1 and 2 must be 8pt")

  // Tap middle wide item
  t.tap(s1.x + s1.w * 0.5, s1.y + s1.h * 0.5)
  t.run_for(springs_out)
  debug_assert(sel.get() == 1, "tapping unequal-width item 1 must select index 1")

  // Drag continuously across unequal widths & gaps from item 1 to item 2
  let y_mid = s1.y + s1.h * 0.5
  t.press_at(s1.x + s1.w * 0.5, y_mid)
  t.run_for(120.0)
  t.move_to(s2.x + s2.w * 0.5, y_mid)
  t.run_for(120.0)
  t.release(s2.x + s2.w * 0.5, y_mid)
  t.run_for(springs_out)
  debug_assert(sel.get() == 2, "dragging across unequal widths + gap to item 2 must select index 2")

  // Keyboard navigation: focus via Tab, then ArrowLeft -> 1, Home -> 0, End -> 2
  t.key(ui::key_tab)
  t.run_for(a_frame)
  t.key(ui::key_code_left)
  t.run_for(a_frame)
  debug_assert(sel.get() == 1, "ArrowLeft must move selection to 1")
  t.key(ui::key_code_home)
  t.run_for(a_frame)
  debug_assert(sel.get() == 0, "Home must move selection to 0")
  t.key(ui::key_code_end)
  t.run_for(a_frame)
  debug_assert(sel.get() == 2, "End must move selection to 2")

  // shown=false hides group a11y label
  show_a11y.set(false)
  t.frame()
  let grp_hidden = match t.find("Density") { None => true; Some(_) => false }
  debug_assert(grp_hidden, "shown=false must hide segmented group a11y")
  show_a11y.set(true)
  t.frame()

  // Reduce Motion: drag still updates selection with 0 lens glass (only 1 track glass)
  ui::set_reduced_motion(Some(true))
  t.press_at(s2.x + s2.w * 0.5, y_mid)
  t.run_for(120.0)
  t.move_to(s0.x + s0.w * 0.5, y_mid)
  t.run_for(120.0)
  let rm_glass = count_liquid_glass(t)
  t.release(s0.x + s0.w * 0.5, y_mid)
  t.run_for(springs_out)
  ui::set_reduced_motion(None)
  debug_assert(rm_glass == 1, "reduced motion drag must not mount refraction lens (track glass only == 1)")
  debug_assert(sel.get() == 0, "reduced motion drag to item 0 must select index 0")
  t.dispose()
}

test "lg_segmented_flat_and_glass_track_priority_matrix" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  // 1. All 4 explicit (flat x glass_track) combinations on floating canvas:
  //    glass_track == Some(b) strictly wins over flat.
  let combos : Array[(Bool, Bool, Int)] = [
    (false, true, 1),
    (true, true, 1),
    (false, false, 0),
    (true, false, 0),
  ]
  let mut ci = 0
  while ci < combos.length() {
    let (fl, gt, expected_glass) = combos[ci]
    let sel = signals::signal(0)
    let t = lg_case(fn(p : view::View) -> Unit {
      let _ = liquid_segmented_node(
        p,
        fn() { ["One", "Two"] },
        fn() { sel.get() },
        fn(i : Int) -> Unit { sel.set(i) },
        width=180.0,
        flat=fl,
        glass_track=gt,
      )
    })
    t.run_shown(springs_out)
    let got = count_liquid_glass(t)
    debug_assert(
      got == expected_glass,
      "flat=\{fl} glass_track=\{gt} must emit \{expected_glass} glass instances (got \{got})",
    )
    t.dispose()
    ci += 1
  }

  // 2. Inside a glass parent (liquid_pill_group_node lends SurfaceContext::Content):
  //    glass_track=None inherits is_flat=true (1 glass total = outer pill only, zero nested glass);
  //    glass_track=Some(false) stays flat (1 glass total);
  //    glass_track=Some(true) overrides to glass track (2 glass total).
  let sel_a = signals::signal(0)
  let t_in = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_pill_group_node(p, fn(pg : view::View) -> Unit {
      let _ = liquid_segmented_node(
        pg,
        fn() { ["A", "B"] },
        fn() { sel_a.get() },
        fn(i : Int) -> Unit { sel_a.set(i) },
        width=140.0,
      )
    })
  })
  t_in.run_shown(springs_out)
  assert_no_nested_glass(t_in, label="segmented inside pill inherits flat")
  debug_assert(count_liquid_glass(t_in) == 1, "segmented inside glass pill with default glass_track must emit 0 own glass (total 1)")
  t_in.dispose()

  let sel_b = signals::signal(0)
  let t_force = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_pill_group_node(p, fn(pg : view::View) -> Unit {
      let _ = liquid_segmented_node(
        pg,
        fn() { ["A", "B"] },
        fn() { sel_b.get() },
        fn(i : Int) -> Unit { sel_b.set(i) },
        width=140.0,
        glass_track=true,
      )
    })
  })
  t_force.run_shown(springs_out)
  debug_assert(count_liquid_glass(t_force) == 2, "glass_track=true inside pill must force glass track (total 2)")
  t_force.dispose()
}

fn p0_drawn_alpha(t : ui::Tester, v : view::View) -> Double {
  let id = v.id()
  for d in t.drawn() {
    if d.id == id {
      return d.alpha
    }
  }
  0.0
}

fn p0_seg_thumb_rect(t : ui::Tester) -> (Double, Double, Double, Double) {
  for d in t.drawn() {
    if d.ground == ctrl_seg_thumb_idle() && d.w == 0.0 && d.h > 20.0 && (d.radius - d.h / 2.0).abs() < 0.5 {
      match ui::view_tree() {
        Some(tree) => {
          let shape = tree.ground_drawn_of(d.id)
          if shape.dw > 20.0 {
            return (d.x + shape.dx, d.y + shape.dy, d.w + shape.dw, d.h + shape.dh)
          }
        }
        None => ()
      }
    }
  }
  debug_assert(false, "p0_seg_thumb_rect: resting segmented pill not found in draw list")
  (-1000.0, -1000.0, 0.0, 0.0)
}

test "lg_pill_morph_overlay_preserves_caller_live_bindings_and_capsule_scale" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  // 1. Pill child Live::By alpha remains intact and reactive after popover open/close
  let open_a = signals::signal(false)
  let opacity = signals::signal(0.65)
  let opener_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
      let tr = liquid_popover_node(
        pg,
        host,
        fn() { open_a.get() },
        fn(v : Bool) -> Unit { open_a.set(v) },
        fn() { "Opener" },
        fn(btn : view::View, _d : headless::Disclosure) -> Unit {
          let _ = btn
          .width(view::Live::Is(Some(34.0)))
          .height(view::Live::Is(Some(34.0)))
          .alpha(view::Live::By(fn() { opacity.get() }))
          bind_pill_press(btn)
        },
        fn() { "Opener Panel" },
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(w : view::View) -> Unit {
            let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("Body"))
          })
        },
        width=160.0,
      )
      opener_ref.v = Some(tr)
    })
  })
  t.run_for(300.0)
  let op = match opener_ref.v { Some(v) => v; None => { debug_assert(false, "opener"); t.dispose(); return } }
  debug_assert((p0_drawn_alpha(t, op) - 0.65).abs() < 0.001, "initial Live::By alpha")
  open_a.set(true)
  t.run_for(450.0)
  open_a.set(false)
  t.run_for(1100.0)
  opacity.set(0.35)
  t.frame()
  let after_alpha = p0_drawn_alpha(t, op)
  t.dispose()
  debug_assert((after_alpha - 0.35).abs() < 0.001, "caller Live::By alpha must stay reactive after close, got \{after_alpha}")

  // 2. Capsule trigger=true preserves caller scale binding after popover open/close
  let open_c = signals::signal(false)
  let cap_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t2 = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_popover_node(
      host,
      host,
      fn() { open_c.get() },
      fn(v : Bool) -> Unit { open_c.set(v) },
      fn() { "Cap" },
      fn(tr : view::View, _d : headless::Disclosure) -> Unit {
        let _ = tr.width(view::Live::Is(Some(90.0))).scale(view::Live::Is(0.9), about=view::Pivot::At(0.5, 0.5))
        let _ = liquid_capsule_decorate(tr, min_height=Some(36.0), radius=Some(18.0), trigger=true)
        cap_ref.v = Some(tr)
      },
      fn() { "Cap Panel" },
      fn(c : view::View) -> Unit {
        let _ = c.box(fn(w : view::View) -> Unit {
          let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("Cap body"))
        })
      },
      width=180.0,
    )
  })
  t2.run_shown(springs_out)
  let cap = match cap_ref.v { Some(v) => v; None => { debug_assert(false, "cap"); t2.dispose(); return } }
  let s0 = cap.drawn_scale()
  open_c.set(true)
  t2.run_for(800.0)
  open_c.set(false)
  t2.run_for(1500.0)
  let s1 = cap.drawn_scale()
  t2.dispose()
  debug_assert((s1 - s0).abs() < 0.002, "caller scale on capsule trigger must survive open/close: \{s0} -> \{s1}")
}

test "lg_capsule_settled_preemption_monotonic_layer_actual_glass_and_opener_restore" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  let open_a = signals::signal(false)
  let open_b = signals::signal(false)
  let ops : Array[view::View] = []
  let caps : Array[view::View] = []
  let t = lg_case(fn(host : view::View) -> Unit {
    let cap = liquid_capsule_node(
      host,
      fn(p : view::View) -> Unit {
        let _ = p.row(view::Live::Is(true)).height(view::Live::Is(Some(40.0)))
        ops.push(
          liquid_popover_node(
            p,
            host,
            fn() { open_a.get() },
            fn(v : Bool) -> Unit { open_a.set(v) },
            fn() { "A" },
            fn(tr : view::View, _d : headless::Disclosure) -> Unit {
              let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0)))
            },
            fn() { "PanelA" },
            fn(c : view::View) -> Unit {
              let _ = c.box(fn(w : view::View) -> Unit {
                let _ = w.height(view::Live::Is(Some(92.0))).words(view::Live::Is("BodyA"))
              })
            },
            placement=headless::Placement::BelowStart,
            width=160.0,
          ),
        )
        ops.push(
          liquid_popover_node(
            p,
            host,
            fn() { open_b.get() },
            fn(v : Bool) -> Unit { open_b.set(v) },
            fn() { "B" },
            fn(tr : view::View, _d : headless::Disclosure) -> Unit {
              let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0)))
            },
            fn() { "PanelB" },
            fn(c : view::View) -> Unit {
              let _ = c.box(fn(w : view::View) -> Unit {
                let _ = w.height(view::Live::Is(Some(92.0))).words(view::Live::Is("BodyB"))
              })
            },
            placement=headless::Placement::BelowEnd,
            width=160.0,
          ),
        )
      },
      trigger=true,
      min_height=Some(40.0),
      glass=fn(_sp) { liquid_bar_pill_glass() },
      extra_blur=fn() { 7.0 },
    )
    caps.push(cap)
  })
  t.run_for(400.0)
  let trig = match caps[0].lent(liquid_pill_trigger_lent) {
    Some(s) => s
    None => { debug_assert(false, "capsule trigger scope"); t.dispose(); return }
  }
  // Open A past full settle (>450ms)
  open_a.set(true)
  t.run_for(650.0)
  let layer_a = trig.fx.untracked().1
  debug_assert(trig.morph_owner == 1 && layer_a > 0, "A settled with owner=1 and layer > 0")

  // Preempt A with B -> monotonic layer changes, B's first frame hits morph_glass on drawn capsule, and A's opener restores immediately
  open_b.set(true)
  t.frame(ms=2.0)
  let layer_b = trig.fx.untracked().1
  let tree = match ui::view_tree() { Some(vt) => vt; None => { debug_assert(false, "tree"); t.dispose(); return } }
  let drawn_b0 = match tree.drawn_of(caps[0].id()) { Some(d) => d.glass.is_some(); None => false }
  let alpha_a_after_preempt = p0_drawn_alpha(t, ops[0])
  debug_assert(trig.morph_owner == 2 && layer_b != layer_a && layer_b > 0, "B must allocate fresh monotonic pill_layer")
  debug_assert(drawn_b0, "B first frame must bind active morph_glass on drawn capsule")
  debug_assert(alpha_a_after_preempt > 0.99, "preempted opener A must immediately recover alpha > 0.99, got \{alpha_a_after_preempt}")

  // Close A then close B -> actual drawn glass recovers rest_glass (blur == 8.2) and both openers are visible
  open_a.set(false)
  t.run_for(500.0)
  open_b.set(false)
  t.run_for(375.0)
  let mid_close_glass = match tree.drawn_of(caps[0].id()) { Some(d) => d.glass; None => None }
  let mid_blur_ok = match mid_close_glass { Some(g) => (g.blur - 8.2).abs() < 0.01; None => false }
  debug_assert(mid_blur_ok, "during B close tail, actual drawn capsule must recover rest_glass blur=8.2")
  t.run_for(900.0)
  let final_glass = match tree.drawn_of(caps[0].id()) { Some(d) => d.glass; None => None }
  let final_blur_ok = match final_glass { Some(g) => (g.blur - 8.2).abs() < 0.01; None => false }
  let aa = p0_drawn_alpha(t, ops[0])
  let ba = p0_drawn_alpha(t, ops[1])
  debug_assert(final_blur_ok && trig.fx.untracked().1 == 0 && aa > 0.99 && ba > 0.99, "settled capsule must restore rest_glass and both openers")
  t.dispose()
}

test "lg_segmented_dynamic_grow_shrink_and_short_widths" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  // 1. Dynamic grow 2 -> 3 items: drag to appended 3rd item selects index 2
  let grown = signals::signal(false)
  let sel = signals::signal(0)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_segmented_node(
      p,
      fn() { if grown.get() { ["A", "B", "C"] } else { ["A", "B"] } },
      fn() { sel.get() },
      fn(i : Int) -> Unit { sel.set(i) },
      widths=fn() { if grown.get() { [46.0, 68.0, 80.0] } else { [46.0, 68.0] } },
      pad=6.0,
      gap=9.0,
      height_by=fn() { if grown.get() { 42.0 } else { 32.0 } },
    )
  })
  t.run_for(500.0)
  grown.set(true)
  t.run_for(500.0)
  let a = require_drawn(t, "A", view::Role::Tab)
  let c = require_drawn(t, "C", view::Role::Tab)
  let y = c.y + c.h / 2.0
  t.press_at(a.x + a.w / 2.0, y)
  t.move_to(c.x + c.w / 2.0, y)
  t.run_for(140.0)
  t.release(c.x + c.w / 2.0, y)
  t.run_for(600.0)
  let (tx, _, _, _) = p0_seg_thumb_rect(t)
  t.dispose()
  debug_assert(sel.get() == 2 && (tx - c.x).abs() < 1.0, "drag to appended C must select 2 and align thumb")

  // 2. Dynamic shrink 4 -> 2 while selected at 3: thumb never extends past last tab
  let shrunk = signals::signal(false)
  let t2 = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_segmented_node(
      p,
      fn() { if shrunk.get() { ["A", "B"] } else { ["A", "B", "C", "D"] } },
      fn() { 3 },
      fn(_i : Int) -> Unit { () },
      widths=fn() { if shrunk.get() { [40.0, 72.0] } else { [40.0, 72.0, 80.0, 90.0] } },
      pad=4.0,
      gap=7.0,
    )
  })
  t2.run_for(500.0)
  shrunk.set(true)
  t2.run_for(500.0)
  let b2 = require_drawn(t2, "B", view::Role::Tab)
  let (sx, _, sw, _) = p0_seg_thumb_rect(t2)
  t2.dispose()
  debug_assert(sx + sw <= b2.x + b2.w + 1.0, "shrunk segmented thumb must stay within last tab bounds")

  // 3. Short widths fallback: missing items receive positive clickable width
  let t3 = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_segmented_node(
      p,
      fn() { ["S", "Medium", "End", "Extra"] },
      fn() { 0 },
      fn(_i : Int) -> Unit { () },
      width=300.0,
      widths=fn() { [56.0, 80.0] },
      pad=4.0,
      gap=8.0,
    )
  })
  t3.run_shown(springs_out)
  let ex = require_drawn(t3, "Extra", view::Role::Tab)
  t3.dispose()
  debug_assert(ex.w > 1.0, "missing width item must get positive width, got \{ex.w}")
}

test "lg_popover_solid_no_resurrect_mid_reduced_motion_vertical_origin_hover_ink_and_nested_group" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  // 1. liquid_pill_hover_ink distinguishes solid vs translucent
  debug_assert(liquid_pill_hover_ink(solid=false) != liquid_pill_hover_ink(solid=true), "light hover ink must distinguish solid")
  set_dark(Some(true))
  debug_assert(liquid_pill_hover_ink(solid=false) != liquid_pill_hover_ink(solid=true), "dark hover ink must distinguish solid")
  set_dark(Some(false))

  // 2. Solid mode after preemption keeps superseded panel A hidden
  let open_a = signals::signal(false)
  let open_b = signals::signal(false)
  let t = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
      let _ = liquid_popover_node(
        pg, host, fn() { open_a.get() }, fn(v) { open_a.set(v) }, fn() { "A" },
        fn(tr, _d) { let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0))); bind_pill_press(tr) },
        fn() { "PanelA" },
        fn(c) { let _ = c.box(fn(w) { let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("A")) }) },
        placement=headless::Placement::BelowStart, width=150.0,
      )
      let _ = liquid_popover_node(
        pg, host, fn() { open_b.get() }, fn(v) { open_b.set(v) }, fn() { "B" },
        fn(tr, _d) { let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0))); bind_pill_press(tr) },
        fn() { "PanelB" },
        fn(c) { let _ = c.box(fn(w) { let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("B")) }) },
        placement=headless::Placement::BelowEnd, width=150.0,
      )
    })
  })
  t.run_for(300.0)
  open_a.set(true)
  t.run_for(650.0)
  let da = require_drawn(t, "PanelA", view::Role::Dialog)
  open_b.set(true)
  t.run_for(650.0)
  let tree = match ui::view_tree() { Some(vt) => vt; None => { debug_assert(false, "tree"); t.dispose(); return } }
  ui::set_glass_solid(Some(true))
  t.frame()
  let solid_alpha = match tree.drawn_of(da.id) { Some(d) => d.alpha; None => 0.0 }
  let solid_has_glass = match tree.drawn_of(da.id) { Some(d) => d.glass.is_some(); None => false }
  ui::set_glass_solid(None)
  t.dispose()
  debug_assert(solid_alpha < 0.01 && !solid_has_glass, "superseded panel A must stay hidden in solid mode")

  // 3. Toggling reduced_motion mid-open immediately settles ground_drawn to laid-out bounds
  let open_rm = signals::signal(false)
  let t2 = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
      let _ = liquid_popover_node(
        pg, host, fn() { open_rm.get() }, fn(v) { open_rm.set(v) }, fn() { "RM" },
        fn(tr, _d) { let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0))); bind_pill_press(tr) },
        fn() { "PanelRM" },
        fn(c) { let _ = c.box(fn(w) { let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("RM")) }) },
        width=150.0,
      )
    })
  })
  t2.run_for(300.0)
  open_rm.set(true)
  t2.run_for(24.0)
  ui::set_reduced_motion(Some(true))
  t2.frame(ms=2.0)
  let drm = require_drawn(t2, "PanelRM", view::Role::Dialog)
  let tree2 = match ui::view_tree() { Some(vt) => vt; None => { debug_assert(false, "tree2"); ui::set_reduced_motion(None); t2.dispose(); return } }
  let mid_sh = tree2.ground_drawn_of(drm.id)
  ui::set_reduced_motion(None)
  t2.dispose()
  debug_assert(mid_sh.dw.abs() < 0.01 && mid_sh.dh.abs() < 0.01, "mid-open reduced_motion must settle ground_drawn immediately")

  // 4. Vertical pill bottom button morph originates from bottom button Y center
  let open_v = signals::signal(false)
  let vtr_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t3 = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_pill_group_node(
      host,
      fn(pg : view::View) -> Unit {
        let mut i = 0
        while i < 3 {
          let _ = pg.box(fn(b : view::View) -> Unit {
            let _ = b.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0)))
          })
          i += 1
        }
        vtr_ref.v = Some(
          liquid_popover_node(
            pg, host, fn() { open_v.get() }, fn(v) { open_v.set(v) }, fn() { "Bot" },
            fn(tr, _d) { let _ = tr.width(view::Live::Is(Some(34.0))).height(view::Live::Is(Some(34.0))); bind_pill_press(tr) },
            fn() { "PanelV" },
            fn(c) { let _ = c.box(fn(w) { let _ = w.height(view::Live::Is(Some(92.0))).words(view::Live::Is("V")) }) },
            placement=headless::Placement::RightEnd, width=156.0,
          ),
        )
      },
      height=40.0,
      pad=3.0,
      pad_y=4.0,
      gap=4.0,
      direction=PillDirection::Vertical,
    )
  })
  t3.run_for(400.0)
  let vtr = match vtr_ref.v { Some(v) => v; None => { debug_assert(false, "vtr"); t3.dispose(); return } }
  let (_, vy, _, vh) = vtr.placed_window_now()
  open_v.set(true)
  t3.frame(ms=8.0)
  let dv = require_drawn(t3, "PanelV", view::Role::Dialog)
  let tree3 = match ui::view_tree() { Some(vt) => vt; None => { debug_assert(false, "tree3"); t3.dispose(); return } }
  let shv = tree3.ground_drawn_of(dv.id)
  let cy = dv.y + shv.dy + (dv.h + shv.dh) / 2.0
  t3.dispose()
  debug_assert((cy - (vy + vh / 2.0)).abs() < 18.0, "vertical pill bottom button morph must originate near button Y center: trigger=\{vy + vh / 2.0}, shell=\{cy}")

  // 5. Nested liquid_button_group_node inside liquid_pill_group_node does not pollute outer trig.children
  let outer_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t4 = lg_case(fn(host : view::View) -> Unit {
    let g = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
      let _ = liquid_button_group_node(pg, fn() {
        [
          LiquidGroupAction::new(label=fn() { "Inner1" }, icon=fn(v, ink) { kit_sample_icon(v, 16.0, ink) }, press=fn() -> Unit { () }),
          LiquidGroupAction::new(label=fn() { "Inner2" }, icon=fn(v, ink) { kit_sample_icon(v, 16.0, ink) }, press=fn() -> Unit { () }),
        ]
      })
    })
    outer_ref.v = Some(g)
  })
  t4.run_shown(springs_out)
  let outer = match outer_ref.v { Some(v) => v; None => { debug_assert(false, "outer"); t4.dispose(); return } }
  let outer_trig = match outer.lent(liquid_pill_trigger_lent) { Some(s) => s; None => { debug_assert(false, "outer trig"); t4.dispose(); return } }
  debug_assert(outer_trig.children.length() == 0, "nested button group must not register children into outer pill trigger scope")
  t4.dispose()
}

test "lg_trigger_face_preserves_caller_live_alpha_and_morph_overlay_slots_compose" {
  ui::set_glass_solid(None)
  ui::set_reduced_motion(None)
  set_dark(Some(false))

  // 1. Pill button with Live::By alpha (0.65) + popover with trigger_face:
  //    at rest alpha == 0.65, bridging hides trigger in fallback (or morphs in pill), and after close signal 0.35 -> 0.35.
  let open_tf = signals::signal(false)
  let opacity = signals::signal(0.65)
  let tr_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t = lg_case(fn(host : view::View) -> Unit {
    let _ = liquid_pill_group_node(host, fn(pg : view::View) -> Unit {
      let tr = liquid_popover_node(
        pg,
        host,
        fn() { open_tf.get() },
        fn(v : Bool) -> Unit { open_tf.set(v) },
        fn() { "FaceBtn" },
        fn(btn : view::View, _d : headless::Disclosure) -> Unit {
          let _ = btn
          .width(view::Live::Is(Some(34.0)))
          .height(view::Live::Is(Some(34.0)))
          .alpha(view::Live::By(fn() { opacity.get() }))
          bind_pill_press(btn)
        },
        fn() { "FacePanel" },
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(w : view::View) -> Unit {
            let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("Face body"))
          })
        },
        trigger_face=fn(f : view::View) -> Unit {
          let _ = f.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("F")) })
        },
        width=160.0,
      )
      tr_ref.v = Some(tr)
    })
  })
  t.run_for(300.0)
  let tr = match tr_ref.v { Some(v) => v; None => { debug_assert(false, "tr"); t.dispose(); return } }
  let a_rest = p0_drawn_alpha(t, tr)
  debug_assert((a_rest - 0.65).abs() < 0.001, "trigger_face must preserve initial Live::By alpha 0.65, got \{a_rest}")
  open_tf.set(true)
  t.run_for(450.0)
  open_tf.set(false)
  t.run_for(1100.0)
  opacity.set(0.35)
  t.frame()
  let a_after = p0_drawn_alpha(t, tr)
  t.dispose()
  debug_assert((a_after - 0.35).abs() < 0.001, "trigger_face must keep Live::By alpha reactive (0.35) after close, got \{a_after}")

  // Also verify non-pill trigger_face bridging hides trigger to 0.0 and restores Live::By alpha afterward
  let open_np = signals::signal(false)
  let op_np = signals::signal(0.65)
  let np_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t_np = lg_case(fn(host : view::View) -> Unit {
    let tr = liquid_popover_node(
      host,
      host,
      fn() { open_np.get() },
      fn(v : Bool) -> Unit { open_np.set(v) },
      fn() { "NonPill" },
      fn(btn : view::View, _d : headless::Disclosure) -> Unit {
        let _ = btn
        .width(view::Live::Is(Some(44.0)))
        .height(view::Live::Is(Some(36.0)))
        .alpha(view::Live::By(fn() { op_np.get() }))
      },
      fn() { "NPPanel" },
      fn(c : view::View) -> Unit {
        let _ = c.box(fn(w : view::View) -> Unit {
          let _ = w.height(view::Live::Is(Some(80.0))).words(view::Live::Is("NP"))
        })
      },
      trigger_face=fn(f : view::View) -> Unit {
        let _ = f.box(fn(w : view::View) -> Unit { let _ = w.words(view::Live::Is("NP")) })
      },
      width=160.0,
    )
    np_ref.v = Some(tr)
  })
  t_np.run_for(300.0)
  let np = match np_ref.v { Some(v) => v; None => { debug_assert(false, "np"); t_np.dispose(); return } }
  debug_assert((p0_drawn_alpha(t_np, np) - 0.65).abs() < 0.001, "non-pill trigger_face rest alpha 0.65")
  open_np.set(true)
  t_np.frame(ms=16.0)
  let a_bridge = p0_drawn_alpha(t_np, np)
  debug_assert(a_bridge < 0.01, "non-pill trigger_face bridging must hide trigger (got \{a_bridge})")
  open_np.set(false)
  t_np.run_for(800.0)
  op_np.set(0.35)
  t_np.frame()
  let a_np_after = p0_drawn_alpha(t_np, np)
  t_np.dispose()
  debug_assert((a_np_after - 0.35).abs() < 0.001, "non-pill trigger_face must keep Live::By alpha reactive (0.35), got \{a_np_after}")

  // 2. Composable morph_overlay slots on same View: A (0.6) + B (0.4) -> 0.24; release A -> 0.4; release B -> 1.0
  let node_ref : signals::Ref[Option[view::View]] = ui::ref_new(None)
  let t2 = lg_case(fn(host : view::View) -> Unit {
    let b = host.box(fn(v : view::View) -> Unit {
      let _ = v.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0))).ground(view::Live::Is(0x3366FFFFL))
    })
    node_ref.v = Some(b)
  })
  t2.run_for(100.0)
  let node = match node_ref.v { Some(v) => v; None => { debug_assert(false, "node"); t2.dispose(); return } }
  debug_assert((p0_drawn_alpha(t2, node) - 1.0).abs() < 0.001, "base alpha 1.0")
  let stop_a = node.morph_overlay(alpha=view::Live::Is(0.6))
  t2.frame()
  debug_assert((p0_drawn_alpha(t2, node) - 0.6).abs() < 0.001, "overlay A alpha 0.6")
  let stop_b = node.morph_overlay(alpha=view::Live::Is(0.4))
  t2.frame()
  let a_both = p0_drawn_alpha(t2, node)
  debug_assert((a_both - 0.24).abs() < 0.001, "overlay A*B must compose to 0.24, got \{a_both}")
  stop_a()
  t2.frame()
  let a_only_b = p0_drawn_alpha(t2, node)
  debug_assert((a_only_b - 0.4).abs() < 0.001, "cleaning up A must keep B active at 0.4, got \{a_only_b}")
  stop_b()
  t2.frame()
  let a_restored = p0_drawn_alpha(t2, node)
  t2.dispose()
  debug_assert((a_restored - 1.0).abs() < 0.001, "cleaning up B must restore base alpha 1.0, got \{a_restored}")
}
