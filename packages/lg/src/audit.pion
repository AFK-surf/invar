// Public Liquid Glass and Apple Two-Layer UI audit gates for downstream apps and component tests.
// Enforces Law 1 (Solid Content Layer vs. Floating Liquid Glass Chrome), Law 2 (Hard Zero Glass-on-Glass
// Invariant), scroll hygiene, and UI craft invariants.

import "ui"

/// Count how many `Glass::liquid` (`kind == 6`) rectangles were drawn in the latest frame.
pub fn count_liquid_glass(t : ui::Tester) -> Int {
  let gs = t.drawn_glass()
  let mut n = 0
  for g in gs {
    if g.4 == 6 {
      n += 1
    }
  }
  n
}

/// Audit the latest drawn frame for Liquid Glass invariant violations:
/// 1. Any pair of `kind == 6` (`Glass::liquid`) rectangles that overlap or nest beyond
///    the `0.5 pt` edge tolerance with overlap area `> 1.0 pt^2`.
/// 2. Content-layer Liquid Glass misuse (unless `allow_large_overlay=true`):
///    - total `kind == 6` glass coverage exceeding `max_glass_coverage` of viewport area (default 45%), or
///    - any single glass rectangle wider than 65% and taller than 55% of the viewport.
/// 3. Any `t.unasked_faults()` reported by `ui::Tester`.
///
/// Returns an empty array when all checks pass.
pub fn audit_glass(
  t : ui::Tester,
  label~ : String = "scene",
  max_glass_coverage~ : Double = 0.45,
  allow_large_overlay~ : Bool = false,
) -> Array[String] {
  let faults : Array[String] = []
  let gs = t.drawn_glass()
  let vw = t.fake.width
  let vh = t.fake.height
  let vp_area = vw * vh
  let mut total_glass_area = 0.0
  let mut i = 0
  while i < gs.length() {
    let a = gs[i]
    if a.4 == 6 {
      if !allow_large_overlay && vp_area > 1.0 && a.2 > 0.0 && a.3 > 0.0 {
        let cx0 = if a.0 > 0.0 { a.0 } else { 0.0 }
        let cy0 = if a.1 > 0.0 { a.1 } else { 0.0 }
        let cx1 = if a.0 + a.2 < vw { a.0 + a.2 } else { vw }
        let cy1 = if a.1 + a.3 < vh { a.1 + a.3 } else { vh }
        let cw = cx1 - cx0
        let ch = cy1 - cy0
        if cw > 0.0 && ch > 0.0 {
          total_glass_area += cw * ch
        }
        if a.2 > vw * 0.65 && a.3 > vh * 0.55 {
          faults.push(
            "[\{label}] content-layer misuse of Liquid Glass: use lg::surface_card_node / <lg::SurfaceCard> for content instead of Glass::liquid (glass #\{i} is \{a.2}x\{a.3} in \{vw}x\{vh} viewport)",
          )
        }
      }
      let mut j = i + 1
      while j < gs.length() {
        let b = gs[j]
        if b.4 == 6 {
          let ox0 = if a.0 > b.0 { a.0 } else { b.0 }
          let oy0 = if a.1 > b.1 { a.1 } else { b.1 }
          let ax1 = a.0 + a.2
          let ay1 = a.1 + a.3
          let bx1 = b.0 + b.2
          let by1 = b.1 + b.3
          let ox1 = if ax1 < bx1 { ax1 } else { bx1 }
          let oy1 = if ay1 < by1 { ay1 } else { by1 }
          let ow = ox1 - ox0
          let oh = oy1 - oy0
          if ow > 0.5 && oh > 0.5 && ow * oh > 1.0 {
            let area = ow * oh
            faults.push(
              "[\{label}] overlapping/nested Glass::liquid #\{i} (\{a.0}, \{a.1}, \{a.2}x\{a.3}) and #\{j} (\{b.0}, \{b.1}, \{b.2}x\{b.3}), overlap=\{ow}x\{oh} (\{area} pt^2)",
            )
          }
        }
        j += 1
      }
    }
    i += 1
  }
  if !allow_large_overlay && vp_area > 1.0 {
    let cov = total_glass_area / vp_area
    if cov > max_glass_coverage {
      let pct = (cov * 100.0).round().to_int()
      let max_pct = (max_glass_coverage * 100.0).round().to_int()
      faults.push(
        "[\{label}] content-layer misuse of Liquid Glass: use lg::surface_card_node / <lg::SurfaceCard> for content instead of Glass::liquid (total glass coverage \{pct}% exceeds max \{max_pct}%)",
      )
    }
  }
  let uf = t.unasked_faults()
  for f in uf {
    faults.push("[\{label}] unasked_fault: \{f}")
  }
  faults
}

/// Assert that `audit_glass(t, label~, max_glass_coverage~, allow_large_overlay~)` reports zero faults.
pub fn assert_no_nested_glass(
  t : ui::Tester,
  label~ : String = "scene",
  max_glass_coverage~ : Double = 0.45,
  allow_large_overlay~ : Bool = false,
) -> Unit {
  let faults = audit_glass(
    t,
    label=label,
    max_glass_coverage=max_glass_coverage,
    allow_large_overlay=allow_large_overlay,
  )
  if faults.length() > 0 {
    let mut msg = "glass audit failed in \{label} (\{faults.length()} fault(s)):"
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

/// One-stop Apple Two-Layer UI audit gate:
/// 1. `assert_no_nested_glass` (zero overlapping/nested glass + content-layer coverage guard + zero unasked faults)
/// 2. `t.assert_scrollable` (zero silent-non-scrolling faults)
/// 3. `t.assert_ui_craft` (first-line alignment, concentric corners, contrast, hit-target, and overflow craft gates)
pub fn assert_apple_ui(
  t : ui::Tester,
  label~ : String = "scene",
  max_glass_coverage~ : Double = 0.45,
  allow_large_overlay~ : Bool = false,
) -> Unit {
  assert_no_nested_glass(
    t,
    label=label,
    max_glass_coverage=max_glass_coverage,
    allow_large_overlay=allow_large_overlay,
  )
  t.assert_scrollable(label=label)
  t.assert_ui_craft(label=label)
}
