// Comprehensive tests for Apple Pit-of-Success primitives:
// - `IconKind` (31 pure-vector shapes), `icon_node` / `<lg::Icon>`, `liquid_back_button_node` / `<lg::BackButton>`
// - `page_shell_node` / `<lg::PageShell>`, `split_shell_node` / `<lg::SplitShell>`, `composer_bar_node` / `<lg::ComposerBar>`
// - `surface_code_block_node` SF Mono default runs & custom syntax runs
// - `liquid_toggle_node` & `liquid_slider_node` 36pt vertical hit area (0 `room_faults`)
// - Benchmark Apple iOS 26/27 IM workspace scene passing `lg::assert_apple_ui` across wide/narrow & light/dark.

import "signals"
import "text"
import "ui"
import "view"

fn build_benchmark_im_scene(
  root : view::View,
  show_detail : signals::Signal[Bool],
  field : ui::Field,
  scroll : view::Scroll,
  sent_count : signals::Signal[Int],
) -> Unit {
  ui::set_tree_theme(ui_theme)
  let search_field = ui::Field::new()
  let _ = split_shell_node(
    root,
    fn(sb : view::View) -> Unit {
      let _ = sb.padding(view::Live::Is((12.0, 14.0, 12.0, 12.0))).gap(view::Live::Is(10.0))
      let _ = sb.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .rigid()
        let _ = hdr.box(fn(t : view::View) -> Unit {
          let _ = t
          .words(view::Live::Is("Messages"), look=words_at(18.0, weight=700))
          .ink(view::Live::By(fn() { surface().ink }))
        })
        let _ = liquid_button_node(
          hdr,
          fn() { "Compose" },
          fn() -> Unit { () },
          content=fn(c : view::View) -> Unit {
            let _ = icon_node(c, IconKind::Edit, size=15.0, ink=fn() { surface().ink })
          },
          flat=true,
          ghost=true,
          height=30.0,
          pad_x=10.5,
        )
      })
      let _ = liquid_text_field_node(
        sb,
        search_field,
        placeholder="Search channels",
        flat=true,
      )
      let _ = ui::scroll_box(sb, fn(list : view::View) -> Unit {
        let _ = list.gap(view::Live::Is(4.0))
        let rooms : Array[(String, String, Int, Bool)] = [
          ("#liquid-glass", "2m", 3, true),
          ("#design-review", "14m", 0, false),
          ("#release-eng", "1h", 1, false),
          ("Alex Rivera", "3h", 0, false),
        ]
        for item in rooms {
          let (name, stamp, unread, selected) = item
          let _ = list.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
            .radius(view::Live::Is(20.0))
            .ground(view::Live::By(fn() { if selected { surface().row_selected } else { clear } }))
            let _ = row.box(fn(lhs : view::View) -> Unit {
              let _ = lhs.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
              let _ = lhs.box(fn(av : view::View) -> Unit {
                let _ = av
                .width(view::Live::Is(Some(24.0)))
                .height(view::Live::Is(Some(24.0)))
                .radius(view::Live::Is(12.0))
                .shrink(view::Live::Is(0.0))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .ground(view::Live::By(fn() { if selected { surface().accent } else { surface().card_secondary } }))
                let _ = icon_node(
                  av,
                  IconKind::Hash,
                  size=13.0,
                  ink=fn() { if selected { white } else { surface().ink_secondary } },
                )
              })
              let _ = lhs.box(fn(nm : view::View) -> Unit {
                let _ = nm
                .words(view::Live::Is(name), look=words_at(13.5, weight=if selected { 600 } else { 500 }, lines=1))
                .ink(view::Live::By(fn() { surface().ink }))
              })
            })
            let _ = row.box(fn(rhs : view::View) -> Unit {
              let _ = rhs.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).shrink(view::Live::Is(0.0))
              let _ = rhs.box(fn(tm : view::View) -> Unit {
                let _ = tm
                .words(view::Live::Is(stamp), look=words_at(11.0))
                .ink(view::Live::By(fn() { surface().ink_tertiary }))
              })
              if unread > 0 {
                let _ = liquid_count_badge_node(rhs, fn() { unread }, tone=LiquidTone::Accent)
              }
            })
          })
        }
      })
    },
    fn(dt : view::View) -> Unit {
      let is_narrow = fn() -> Bool {
        let w = dt.window_w()
        w > 0.0 && w < 760.0
      }
      let _ = page_shell_node(
        dt,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(12.0))
          // Outgoing Apple blue bubble near top (scrolls under top glass bar)
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(420.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().accent }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Pushing the scroll-under PageShell and adaptive Liquid Glass chrome update now."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::Is(white))
              })
            })
          })
          // Incoming solid card bubble
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Start))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(460.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().card }))
              .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Looks super clean. Check the SF Mono code block and decision card below."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::By(fn() { surface().ink }))
              })
            })
          })
          // Native SF Mono CodeBlock
          let _ = surface_code_block_node(
            feed,
            fn() { "<lg::PageShell in={root} bottom={fn(b) { <lg::ComposerBar in={b} field={f} /> }} />" },
            lang=fn() { "pion" },
          )
          // Decision card with prominent primary + flat secondary button
          let _ = surface_card_node(
            feed,
            fn(c : view::View) -> Unit {
              let _ = c.box(fn(h : view::View) -> Unit {
                let _ = h
                .words(view::Live::Is("Approve Step 3 Release?"), look=words_at(15.0, weight=600))
                .ink(view::Live::By(fn() { surface().ink }))
              })
              let _ = c.box(fn(s : view::View) -> Unit {
                let _ = s
                .words(
                  view::Live::Is("Verified zero nested glass, 36pt hit targets, and 2x Metal refraction."),
                  look=words_at(13.0, wrap=true),
                )
                .ink(view::Live::By(fn() { surface().ink_secondary }))
              })
              let _ = c.box(fn(acts : view::View) -> Unit {
                let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                let _ = liquid_button_node(acts, fn() { "Approve" }, fn() -> Unit { () }, prominent=true)
                let _ = liquid_button_node(acts, fn() { "Revise" }, fn() -> Unit { () }, flat=true)
              })
            },
            radius=r_panel,
            pad=12.0,
            gap=8.0,
            label=fn() { "Decision" },
          )
          // Outgoing Apple blue bubble near bottom (scrolls under ComposerBar glass)
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(420.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().accent }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Scrolling right behind the floating ComposerBar so the blue bubble refracts cleanly."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::Is(white))
              })
            })
          })
          // Extra trailing spacer message to ensure positive scroll reach
          let _ = feed.box(fn(pad_msg : view::View) -> Unit {
            let _ = pad_msg
            .height(view::Live::Is(Some(240.0)))
            .radius(view::Live::Is(18.0))
            .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
            .ground(view::Live::By(fn() { surface().card }))
            .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
            let _ = pad_msg.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::Is("Follow-up release checklist ready for review."), look=words_at(13.5, wrap=true))
              .ink(view::Live::By(fn() { surface().ink_secondary }))
            })
          })
        },
        leading=fn(l : view::View) -> Unit {
          l.show(
            is_narrow,
            fn(back_slot : view::View) -> Unit {
              let _ = liquid_back_button_node(back_slot, fn() -> Unit { show_detail.set(false) })
            },
            at_once=true,
          )
          let _ = liquid_bar_pill_group_node(
            l,
            fn(p : view::View) -> Unit {
              let _ = p.box(fn(inner : view::View) -> Unit {
                let _ = inner
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                .gap(view::Live::Is(6.0))
                let _ = icon_node(inner, IconKind::Hash, size=14.0, ink=fn() { surface().accent })
                let _ = inner.box(fn(t : view::View) -> Unit {
                  let _ = t
                  .words(view::Live::Is("liquid-glass"), look=words_at(14.0, weight=600, lines=1))
                  .ink(view::Live::By(fn() { surface().ink }))
                })
              })
            },
            height=36.0,
            label=fn() { "Channel" },
          )
        },
        trailing=fn(tr : view::View) -> Unit {
          let _ = liquid_bar_pill_group_node(
            tr,
            fn(p : view::View) -> Unit {
              let _ = liquid_button_node(
                p,
                fn() { "Search" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Search, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              p.show(
                fn() { !is_narrow() },
                fn(extra : view::View) -> Unit {
                  let _ = extra.row(view::Live::Is(true)).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                  let _ = liquid_button_node(
                    extra,
                    fn() { "Pin" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Pin, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                  let _ = liquid_button_node(
                    extra,
                    fn() { "Volume" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Volume, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                },
                at_once=true,
              )
              let _ = liquid_button_node(
                p,
                fn() { "Members" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Users, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              let _ = liquid_button_node(
                p,
                fn() { "Info" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Info, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
            },
            height=36.0,
            label=fn() { "Actions" },
          )
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = composer_bar_node(
            bot,
            field,
            fn() -> Unit { sent_count.set(sent_count.untracked() + 1) },
            placeholder="Message #liquid-glass",
            on_attach=fn() -> Unit { () },
          )
        },
        scroll=scroll,
      )
    },
    show_detail=fn() { show_detail.get() },
  )
}

test "lg_vector_icons_all_31_and_back_button_hit_area" {
  let all : Array[IconKind] = [
    IconKind::ChevronLeft, IconKind::ChevronRight, IconKind::ChevronDown, IconKind::Search,
    IconKind::Plus, IconKind::Paperclip, IconKind::ArrowUp, IconKind::ArrowDown, IconKind::Pin,
    IconKind::Mic, IconKind::MicOff, IconKind::Volume, IconKind::Phone, IconKind::Users,
    IconKind::UserPlus, IconKind::Info, IconKind::Settings, IconKind::Share, IconKind::More,
    IconKind::Close, IconKind::Check, IconKind::Copy, IconKind::Sidebar, IconKind::Sparkles,
    IconKind::Bell, IconKind::Lock, IconKind::Hash, IconKind::Filter, IconKind::Trash,
    IconKind::Edit, IconKind::Refresh,
  ]
  for k in all {
    let shapes = icon_shapes(k, 16.0, 0x1C1C1EFFL)
    debug_assert(shapes.length() > 0, "every IconKind must produce >= 1 vector shape")
  }
  let clicks = signals::signal(0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((20.0, 20.0, 20.0, 20.0))).gap(view::Live::Is(12.0))
      let _ = root.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = liquid_back_button_node(row, fn() { clicks.set(clicks.untracked() + 1) })
        let _ = liquid_back_button_node(row, fn() { clicks.set(clicks.untracked() + 10) }, label=fn() { "Inbox" })
      })
    },
    width=400.0,
    height=160.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="back_buttons")
  let circle = require_drawn(t, "Back", view::Role::Button)
  debug_assert(circle.w >= 36.0 && circle.h >= 36.0, "circular BackButton must meet 36pt hit area")
  t.tap(circle.x + circle.w / 2.0, circle.y + circle.h / 2.0)
  t.frame()
  debug_assert(clicks.get() == 1, "tapping BackButton must fire press callback")
  t.dispose()
}

test "lg_toggle_and_slider_36pt_hit_area_zero_room_faults" {
  let on = signals::signal(true)
  let level = signals::signal(42.0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((20.0, 20.0, 20.0, 20.0))).gap(view::Live::Is(20.0))
      let _ = surface_card_node(
        root,
        fn(card : view::View) -> Unit {
          let _ = card.gap(view::Live::Is(14.0))
          let _ = card.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.words(view::Live::Is("System Controls"), look=words_at(15.0, weight=600)).ink(view::Live::By(fn() { surface().ink }))
          })
          let _ = card.box(fn(row : view::View) -> Unit {
            let _ = row.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = row.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Wi-Fi"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
            let _ = liquid_toggle_node(row, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Wi-Fi" })
          })
          let _ = liquid_slider_node(card, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Brightness" })
          let _ = card.box(fn(ftr : view::View) -> Unit {
            let _ = ftr.words(view::Live::Is("36pt vertical touch targets active."), look=words_at(12.0)).ink(view::Live::By(fn() { surface().ink_secondary }))
          })
        },
        radius=r_card,
        pad=16.0,
      )
    },
    width=420.0,
    height=260.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="toggle_and_slider_36pt_hit_area")
  let sw = require_drawn(t, "Wi-Fi", view::Role::Switch)
  let sl = require_drawn(t, "Brightness", view::Role::Slider)
  debug_assert(sw.h >= 36.0, "Toggle vertical hit area must be >= 36pt")
  debug_assert(sl.h >= 36.0, "Slider vertical hit area must be >= 36pt")
  t.dispose()
}

test "lg_code_block_sf_mono_and_custom_runs" {
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((16.0, 16.0, 16.0, 16.0))).gap(view::Live::Is(12.0))
      let _ = surface_code_block_node(root, fn() { "let x = 42" }, lang=fn() { "pion" })
      let _ = surface_code_block_node(
        root,
        fn() { "pub fn hi() -> Unit" },
        lang=fn() { "pion" },
        runs=fn() {
          [
            text::Run::{ ..text::plain("pub fn "), mono: true, color: surface().accent },
            text::Run::{ ..text::plain("hi() -> Unit"), mono: true },
          ]
        },
      )
    },
    width=480.0,
    height=300.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="code_block_sf_mono")
  t.dispose()
}

test "lg_benchmark_apple_im_wide_and_narrow_light_and_dark" {
  let cases : Array[(String, Bool, Double, Double)] = [
    ("apple_im_wide_light", false, 1280.0, 800.0),
    ("apple_im_wide_dark", true, 1280.0, 800.0),
    ("apple_im_narrow_light", false, 390.0, 844.0),
    ("apple_im_narrow_dark", true, 390.0, 844.0),
  ]
  for item in cases {
    let (tag, dark, w, h) = item
    set_dark(Some(dark))
    let show_detail = signals::signal(true)
    let field = ui::Field::new()
    field.set("Ship Step 3 with 2x Metal shots")
    let scroll = view::Scroll::new()
    let sent = signals::signal(0)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        build_benchmark_im_scene(root, show_detail, field, scroll, sent)
      },
      width=w,
      height=h,
      scale=2.0,
      theme=ui_theme,
    )
    t.frame()
    // Scroll content under the top glass; a programmatic scroll asks for its frame as input would.
    scroll.put(42.0)
    t.fake.frame_requested = true
    t.frame()
    assert_apple_ui(t, label=tag)
    debug_assert(count_liquid_glass(t) >= 3, "benchmark IM scene must render floating top/bottom glass chrome")
    // Verify Send button triggers composer callback
    let send_btn = require_drawn(t, "Send", view::Role::Button)
    t.tap(send_btn.x + send_btn.w / 2.0, send_btn.y + send_btn.h / 2.0)
    t.frame()
    debug_assert(sent.get() == 1, "ComposerBar Send button must trigger on_send")
    t.dispose()
  }
  set_dark(None)
}

fn ps_progressive_bands(t : ui::Tester) -> Array[(Double, Double, Double, Double, Int, Int)] {
  let out : Array[(Double, Double, Double, Double, Int, Int)] = []
  for g in t.drawn_glass() {
    if g.4 == 5 {
      out.push(g)
    }
  }
  out
}

fn ps_island_page(
  root : view::View,
  field : ui::Field,
  title : String,
  top_edge_blur : Option[Bool],
  bottom_edge_blur : Bool,
) -> Unit {
  ui::set_tree_theme(ui_theme)
  let _ = page_shell_node(
    root,
    fn(feed : view::View) -> Unit {
      // Padding set by `body` must not override the shell's automatic insets: with a bare title the
      // card would otherwise sit under the title and fail the `words_over` craft gate below.
      let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(12.0))
      let _ = surface_card_node(
        feed,
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(w : view::View) -> Unit {
            let _ = w.words(view::Live::Is("Content glides under the floating glass islands."), look=words_at(14.0, wrap=true)).ink(view::Live::By(fn() { surface().ink }))
          })
        },
        pad=16.0,
      )
      let _ = feed.box(fn(sp : view::View) -> Unit { let _ = sp.height(view::Live::Is(Some(900.0))) })
    },
    title=fn() { title },
    leading=fn(l : view::View) -> Unit { let _ = liquid_back_button_node(l, fn() -> Unit { () }) },
    trailing=fn(tr : view::View) -> Unit {
      let _ = liquid_bar_pill_group_node(
        tr,
        fn(p : view::View) -> Unit {
          let _ = liquid_button_node(
            p,
            fn() { "Search" },
            fn() -> Unit { () },
            content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Search, size=15.0) },
            flat=true,
            ghost=true,
            height=30.0,
            pad_x=10.5,
          )
        },
        height=36.0,
        label=fn() { "Actions" },
      )
    },
    bottom=fn(bot : view::View) -> Unit {
      let _ = composer_bar_node(bot, field, fn() -> Unit { () })
    },
    top_edge_blur?=top_edge_blur,
    bottom_edge_blur=bottom_edge_blur,
  )
}

test "lg_page_shell_no_bare_text_no_scroll_edge_blur" {
  set_dark(Some(false))
  // Glass islands only (back button, pill group, composer): zero progressive blur bands.
  // Bare title text (or an explicit opt-in): one compact 66pt band at the top, 64pt at the bottom when opted in.
  let cases : Array[(String, String, Option[Bool], Bool, Array[(Double, Double)])] = [
    ("islands_only", "", None, false, []),
    ("bare_title", "Messages", None, false, [(0.0, 66.0)]),
    ("forced_on", "", Some(true), false, [(0.0, 66.0)]),
    ("forced_off", "Messages", Some(false), false, []),
    ("bottom_opt_in", "", None, true, [(780.0, 64.0)]),
  ]
  for item in cases {
    let tag = item.0
    let title = item.1
    let forced = item.2
    let bottom_blur = item.3
    let want = item.4
    let field = ui::Field::new()
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit { ps_island_page(root, field, title, forced, bottom_blur) },
      width=390.0,
      height=844.0,
      scale=2.0,
      theme=ui_theme,
    )
    t.frame()
    let bands = ps_progressive_bands(t)
    debug_assert(bands.length() == want.length(), "\{tag}: expected \{want.length()} progressive scroll-edge bands, got \{bands.length()}")
    let mut i = 0
    while i < want.length() && i < bands.length() {
      let want_y = want[i].0
      let want_h = want[i].1
      let y = bands[i].1
      let bw = bands[i].2
      let bh = bands[i].3
      debug_assert((y - want_y).abs() < 0.01, "\{tag}: blur band y must be \{want_y}, got \{y}")
      debug_assert((bw - 390.0).abs() < 0.01, "\{tag}: the blur band must span the full width")
      debug_assert((bh - want_h).abs() < 0.01, "\{tag}: blur band height must be \{want_h}, got \{bh}")
      i += 1
    }
    assert_apple_ui(t, label="page_shell_\{tag}")
    t.dispose()
  }
  set_dark(None)
}

fn ps_join(xs : Array[String]) -> String {
  let mut out = ""
  for x in xs {
    out = out + x + "; "
  }
  out
}

fn ps_composer_parts(t : ui::Tester) -> (view::Drawn, view::Drawn, view::Drawn) {
  let cap = require_drawn(t, "Message", view::Role::Group)
  let typed = require_drawn(t, "Message", view::Role::TextField)
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => {
      debug_assert(false, "expected a live view tree")
      return (cap, cap, typed)
    }
  }
  let mut wrap = typed
  let mut found = false
  for d in t.drawn() {
    if !found && d.id != cap.id && d.id != typed.id && tree.holds(cap.id, d.id) && tree.holds(d.id, typed.id) {
      wrap = d
      found = true
    }
  }
  debug_assert(found, "expected the field's clipping wrapper inside the composer capsule")
  (cap, wrap, typed)
}

fn ps_composer_wrap_in_glass(tag : String, cap : view::Drawn, wrap : view::Drawn) -> Unit {
  debug_assert(wrap.y >= cap.y - 0.01, "\{tag}: field wrapper top \{wrap.y} must not rise above the capsule glass \{cap.y}")
  debug_assert(
    wrap.y + wrap.h <= cap.y + cap.h + 0.01,
    "\{tag}: field wrapper bottom \{wrap.y + wrap.h} must not reach past the capsule glass bottom \{cap.y + cap.h}",
  )
}

test "lg_composer_bar_scrolled_text_under_glass_passes_words_over" {
  set_dark(Some(false))
  let field = ui::Field::new()
  let scroll = view::Scroll::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = page_shell_node(
        root,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(6.0))
          let mut k = 0
          while k < 60 {
            let line = "Message line \{k} glides under the composer glass."
            let _ = feed.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is(line), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
            k += 1
          }
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = composer_bar_node(bot, field, fn() -> Unit { () })
        },
        scroll=scroll,
      )
    },
    width=390.0,
    height=844.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  let (cap0, wrap0, typed0) = ps_composer_parts(t)
  ps_composer_wrap_in_glass("single_line", cap0, wrap0)
  debug_assert(wrap0.h >= 36.0 - 0.01, "composer field hit area must stay >= 36pt, got \{wrap0.h}")
  // The field's text is drawn from its top at its natural height: its middle is the capsule's.
  let mid0 = typed0.y + typed0.h * 0.5
  let cap_mid0 = cap0.y + cap0.h * 0.5
  debug_assert((mid0 - cap_mid0).abs() <= 1.0, "single-line text middle \{mid0} must sit at the capsule middle \{cap_mid0}")
  // A tap anywhere in the input area (here near its bottom edge) focuses the field.
  debug_assert(!field.focused(), "the composer field must start unfocused")
  t.tap(wrap0.x + wrap0.w * 0.5, wrap0.y + wrap0.h - 4.0)
  t.frame()
  debug_assert(field.focused(), "tapping the composer input area must focus the field")
  // Scroll 1pt at a time so every message line sweeps the capsule's bottom band [cap.y + 40, cap.y + 48].
  let mut off = 0.0
  while off <= 60.0 {
    scroll.put(off)
    t.fake.frame_requested = true
    t.frame()
    let faults = t.words_over_faults()
    debug_assert(faults.length() == 0, "scroll \{off}: text passing under the composer glass must not fault: \{ps_join(faults)}")
    off += 1.0
  }
  assert_apple_ui(t, label="composer_scrolled_single_line")
  // Two lines of input grow the capsule; the field wrapper must still sit inside its glass.
  field.set("First line\nSecond line")
  t.fake.frame_requested = true
  t.frame()
  let (cap1, wrap1, typed1) = ps_composer_parts(t)
  ps_composer_wrap_in_glass("two_lines", cap1, wrap1)
  debug_assert((cap1.h - 44.0).abs() < 0.01, "two lines fit the 44pt capsule, got \{cap1.h}")
  let mid1 = typed1.y + typed1.h * 0.5
  let cap_mid1 = cap1.y + cap1.h * 0.5
  debug_assert((mid1 - cap_mid1).abs() <= 1.0, "two-line text middle \{mid1} must sit at the capsule middle \{cap_mid1}")
  let mut off2 = 0.0
  while off2 <= 60.0 {
    scroll.put(off2)
    t.fake.frame_requested = true
    t.frame()
    let faults = t.words_over_faults()
    debug_assert(faults.length() == 0, "two lines, scroll \{off2}: text passing under the composer glass must not fault: \{ps_join(faults)}")
    off2 += 1.0
  }
  assert_apple_ui(t, label="composer_scrolled_two_lines")
  t.dispose()
  set_dark(None)
}
