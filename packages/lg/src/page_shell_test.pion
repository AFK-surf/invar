// Comprehensive tests for Apple Pit-of-Success primitives:
// - `IconKind` (32 pure-vector shapes), `icon_node` / `<lg::Icon>`, `liquid_back_button_node` / `<lg::BackButton>`
// - `page_shell_node` / `<lg::PageShell>`, `split_shell_node` / `<lg::SplitShell>`, `composer_bar_node` / `<lg::ComposerBar>`
// - `surface_code_block_node` SF Mono default runs & custom syntax runs
// - `liquid_toggle_node` & `liquid_slider_node` 36pt vertical hit area (0 `room_faults`)
// - Benchmark Apple iOS 26/27 IM workspace scene passing `lg::assert_apple_ui` across wide/narrow & light/dark.

import "headless"
import "signals"
import "text"
import "ui"
import "view"

fn build_benchmark_im_scene(
  root : view::View,
  show_detail : signals::Signal[Bool],
  field : ui::Field,
  scroll : view::Scroll,
  sent_count : signals::Signal[Int],
) -> Unit {
  ui::set_tree_theme(ui_theme)
  let search_field = ui::Field::new()
  let _ = split_shell_node(
    root,
    fn(sb : view::View) -> Unit {
      let _ = sb.padding(view::Live::Is((12.0, 14.0, 12.0, 12.0))).gap(view::Live::Is(10.0))
      let _ = sb.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .rigid()
        let _ = hdr.box(fn(t : view::View) -> Unit {
          let _ = t
          .words(view::Live::Is("Messages"), look=words_at(18.0, weight=700))
          .ink(view::Live::By(fn() { surface().ink }))
        })
        let _ = liquid_button_node(
          hdr,
          fn() { "Compose" },
          fn() -> Unit { () },
          content=fn(c : view::View) -> Unit {
            let _ = icon_node(c, IconKind::Edit, size=15.0, ink=fn() { surface().ink })
          },
          flat=true,
          ghost=true,
          height=30.0,
          pad_x=10.5,
        )
      })
      let _ = liquid_text_field_node(
        sb,
        search_field,
        placeholder="Search channels",
        flat=true,
      )
      let _ = ui::scroll_box(sb, fn(list : view::View) -> Unit {
        let _ = list.gap(view::Live::Is(4.0))
        let rooms : Array[(String, String, Int, Bool)] = [
          ("#liquid-glass", "2m", 3, true),
          ("#design-review", "14m", 0, false),
          ("#release-eng", "1h", 1, false),
          ("Alex Rivera", "3h", 0, false),
        ]
        for item in rooms {
          let (name, stamp, unread, selected) = item
          let _ = list.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .padding(view::Live::Is((8.0, 8.0, 8.0, 8.0)))
            .radius(view::Live::Is(20.0))
            .ground(view::Live::By(fn() { if selected { surface().row_selected } else { clear } }))
            let _ = row.box(fn(lhs : view::View) -> Unit {
              let _ = lhs.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
              let _ = lhs.box(fn(av : view::View) -> Unit {
                let _ = av
                .width(view::Live::Is(Some(24.0)))
                .height(view::Live::Is(Some(24.0)))
                .radius(view::Live::Is(12.0))
                .shrink(view::Live::Is(0.0))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .ground(view::Live::By(fn() { if selected { surface().accent } else { surface().card_secondary } }))
                let _ = icon_node(
                  av,
                  IconKind::Hash,
                  size=13.0,
                  ink=fn() { if selected { white } else { surface().ink_secondary } },
                )
              })
              let _ = lhs.box(fn(nm : view::View) -> Unit {
                let _ = nm
                .words(view::Live::Is(name), look=words_at(13.5, weight=if selected { 600 } else { 500 }, lines=1))
                .ink(view::Live::By(fn() { surface().ink }))
              })
            })
            let _ = row.box(fn(rhs : view::View) -> Unit {
              let _ = rhs.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(6.0)).shrink(view::Live::Is(0.0))
              let _ = rhs.box(fn(tm : view::View) -> Unit {
                let _ = tm
                .words(view::Live::Is(stamp), look=words_at(11.0))
                .ink(view::Live::By(fn() { surface().ink_tertiary }))
              })
              if unread > 0 {
                let _ = liquid_count_badge_node(rhs, fn() { unread }, tone=LiquidTone::Accent)
              }
            })
          })
        }
      })
    },
    fn(dt : view::View) -> Unit {
      let is_narrow = fn() -> Bool {
        let w = dt.window_w()
        w > 0.0 && w < 760.0
      }
      let _ = page_shell_node(
        dt,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(12.0))
          // Outgoing Apple blue bubble near top (scrolls under top glass bar)
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(420.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().accent }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Pushing the scroll-under PageShell and adaptive Liquid Glass chrome update now."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::Is(white))
              })
            })
          })
          // Incoming solid card bubble
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Start))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(460.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().card }))
              .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Looks super clean. Check the SF Mono code block and decision card below."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::By(fn() { surface().ink }))
              })
            })
          })
          // Native SF Mono CodeBlock
          let _ = surface_code_block_node(
            feed,
            fn() { "<lg::PageShell in={root} bottom={fn(b) { <lg::ComposerBar in={b} field={f} /> }} />" },
            lang=fn() { "pion" },
          )
          // Decision card with prominent primary + flat secondary button
          let _ = surface_card_node(
            feed,
            fn(c : view::View) -> Unit {
              let _ = c.box(fn(h : view::View) -> Unit {
                let _ = h
                .words(view::Live::Is("Approve Step 3 Release?"), look=words_at(15.0, weight=600))
                .ink(view::Live::By(fn() { surface().ink }))
              })
              let _ = c.box(fn(s : view::View) -> Unit {
                let _ = s
                .words(
                  view::Live::Is("Verified zero nested glass, 36pt hit targets, and 2x Metal refraction."),
                  look=words_at(13.0, wrap=true),
                )
                .ink(view::Live::By(fn() { surface().ink_secondary }))
              })
              let _ = c.box(fn(acts : view::View) -> Unit {
                let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                let _ = liquid_button_node(acts, fn() { "Approve" }, fn() -> Unit { () }, prominent=true)
                let _ = liquid_button_node(acts, fn() { "Revise" }, fn() -> Unit { () }, flat=true)
              })
            },
            radius=r_panel,
            pad=12.0,
            gap=8.0,
            label=fn() { "Decision" },
          )
          // Outgoing Apple blue bubble near bottom (scrolls under ComposerBar glass)
          let _ = feed.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End))
            let _ = r.box(fn(bub : view::View) -> Unit {
              let _ = bub
              .max_width(view::Live::Is(Some(420.0)))
              .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
              .radius(view::Live::Is(18.0))
              .ground(view::Live::By(fn() { surface().accent }))
              let _ = bub.box(fn(w : view::View) -> Unit {
                let _ = w
                .words(
                  view::Live::Is("Scrolling right behind the floating ComposerBar so the blue bubble refracts cleanly."),
                  look=words_at(14.0, wrap=true),
                )
                .ink(view::Live::Is(white))
              })
            })
          })
          // Extra trailing spacer message to ensure positive scroll reach
          let _ = feed.box(fn(pad_msg : view::View) -> Unit {
            let _ = pad_msg
            .height(view::Live::Is(Some(240.0)))
            .radius(view::Live::Is(18.0))
            .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
            .ground(view::Live::By(fn() { surface().card }))
            .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
            let _ = pad_msg.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::Is("Follow-up release checklist ready for review."), look=words_at(13.5, wrap=true))
              .ink(view::Live::By(fn() { surface().ink_secondary }))
            })
          })
        },
        leading=fn(l : view::View) -> Unit {
          l.show(
            is_narrow,
            fn(back_slot : view::View) -> Unit {
              let _ = liquid_back_button_node(back_slot, fn() -> Unit { show_detail.set(false) })
            },
            at_once=true,
          )
          let _ = liquid_bar_pill_group_node(
            l,
            fn(p : view::View) -> Unit {
              let _ = p.box(fn(inner : view::View) -> Unit {
                let _ = inner
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
                .gap(view::Live::Is(6.0))
                let _ = icon_node(inner, IconKind::Hash, size=14.0, ink=fn() { surface().accent })
                let _ = inner.box(fn(t : view::View) -> Unit {
                  let _ = t
                  .words(view::Live::Is("liquid-glass"), look=words_at(14.0, weight=600, lines=1))
                  .ink(view::Live::By(fn() { surface().ink }))
                })
              })
            },
            height=36.0,
            label=fn() { "Channel" },
          )
        },
        trailing=fn(tr : view::View) -> Unit {
          let _ = liquid_bar_pill_group_node(
            tr,
            fn(p : view::View) -> Unit {
              let _ = liquid_button_node(
                p,
                fn() { "Search" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Search, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              p.show(
                fn() { !is_narrow() },
                fn(extra : view::View) -> Unit {
                  let _ = extra.row(view::Live::Is(true)).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                  let _ = liquid_button_node(
                    extra,
                    fn() { "Pin" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Pin, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                  let _ = liquid_button_node(
                    extra,
                    fn() { "Volume" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Volume, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                },
                at_once=true,
              )
              let _ = liquid_button_node(
                p,
                fn() { "Members" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Users, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              let _ = liquid_button_node(
                p,
                fn() { "Info" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Info, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
            },
            height=36.0,
            label=fn() { "Actions" },
          )
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = composer_bar_node(
            bot,
            field,
            fn() -> Unit { sent_count.set(sent_count.untracked() + 1) },
            placeholder="Message #liquid-glass",
            on_attach=fn() -> Unit { () },
          )
        },
        scroll=scroll,
      )
    },
    show_detail=fn() { show_detail.get() },
  )
}

test "lg_vector_icons_all_32_and_back_button_hit_area" {
  let all : Array[IconKind] = [
    IconKind::ChevronLeft, IconKind::ChevronRight, IconKind::ChevronDown, IconKind::Search,
    IconKind::Plus, IconKind::Paperclip, IconKind::ArrowUp, IconKind::ArrowDown, IconKind::Pin,
    IconKind::Mic, IconKind::MicOff, IconKind::Volume, IconKind::Phone, IconKind::Users,
    IconKind::UserPlus, IconKind::Info, IconKind::Settings, IconKind::Share, IconKind::More,
    IconKind::Close, IconKind::Check, IconKind::Copy, IconKind::Sidebar, IconKind::Sparkles,
    IconKind::Bell, IconKind::Lock, IconKind::Hash, IconKind::Filter, IconKind::Trash,
    IconKind::Edit, IconKind::Refresh, IconKind::Minus,
  ]
  for k in all {
    let shapes = icon_shapes(k, 16.0, 0x1C1C1EFFL)
    debug_assert(shapes.length() > 0, "every IconKind must produce >= 1 vector shape")
  }
  let clicks = signals::signal(0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((20.0, 20.0, 20.0, 20.0))).gap(view::Live::Is(12.0))
      let _ = root.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = liquid_back_button_node(row, fn() { clicks.set(clicks.untracked() + 1) })
        let _ = liquid_back_button_node(row, fn() { clicks.set(clicks.untracked() + 10) }, label=fn() { "Inbox" })
      })
    },
    width=400.0,
    height=160.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="back_buttons")
  let circle = require_drawn(t, "Back", view::Role::Button)
  debug_assert(circle.w >= 36.0 && circle.h >= 36.0, "circular BackButton must meet 36pt hit area")
  t.tap(circle.x + circle.w / 2.0, circle.y + circle.h / 2.0)
  t.frame()
  debug_assert(clicks.get() == 1, "tapping BackButton must fire press callback")
  t.dispose()
}

test "lg_toggle_and_slider_36pt_hit_area_zero_room_faults" {
  let on = signals::signal(true)
  let level = signals::signal(42.0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((20.0, 20.0, 20.0, 20.0))).gap(view::Live::Is(20.0))
      let _ = surface_card_node(
        root,
        fn(card : view::View) -> Unit {
          let _ = card.gap(view::Live::Is(14.0))
          let _ = card.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.words(view::Live::Is("System Controls"), look=words_at(15.0, weight=600)).ink(view::Live::By(fn() { surface().ink }))
          })
          let _ = card.box(fn(row : view::View) -> Unit {
            let _ = row.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = row.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is("Wi-Fi"), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
            let _ = liquid_toggle_node(row, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Wi-Fi" })
          })
          let _ = liquid_slider_node(card, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Brightness" })
          let _ = card.box(fn(ftr : view::View) -> Unit {
            let _ = ftr.words(view::Live::Is("36pt vertical touch targets active."), look=words_at(12.0)).ink(view::Live::By(fn() { surface().ink_secondary }))
          })
        },
        radius=r_card,
        pad=16.0,
      )
    },
    width=420.0,
    height=260.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="toggle_and_slider_36pt_hit_area")
  let sw = require_drawn(t, "Wi-Fi", view::Role::Switch)
  let sl = require_drawn(t, "Brightness", view::Role::Slider)
  debug_assert(sw.h >= 36.0, "Toggle vertical hit area must be >= 36pt")
  debug_assert(sl.h >= 36.0, "Slider vertical hit area must be >= 36pt")
  t.dispose()
}

test "lg_code_block_sf_mono_and_custom_runs" {
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = root.ground(view::Live::By(fn() { surface().canvas })).padding(view::Live::Is((16.0, 16.0, 16.0, 16.0))).gap(view::Live::Is(12.0))
      let _ = surface_code_block_node(root, fn() { "let x = 42" }, lang=fn() { "pion" })
      let _ = surface_code_block_node(
        root,
        fn() { "pub fn hi() -> Unit" },
        lang=fn() { "pion" },
        runs=fn() {
          [
            text::Run::{ ..text::plain("pub fn "), mono: true, color: surface().accent },
            text::Run::{ ..text::plain("hi() -> Unit"), mono: true },
          ]
        },
      )
    },
    width=480.0,
    height=300.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="code_block_sf_mono")
  t.dispose()
}

test "lg_benchmark_apple_im_wide_and_narrow_light_and_dark" {
  let cases : Array[(String, Bool, Double, Double)] = [
    ("apple_im_wide_light", false, 1280.0, 800.0),
    ("apple_im_wide_dark", true, 1280.0, 800.0),
    ("apple_im_narrow_light", false, 390.0, 844.0),
    ("apple_im_narrow_dark", true, 390.0, 844.0),
  ]
  for item in cases {
    let (tag, dark, w, h) = item
    set_dark(Some(dark))
    let show_detail = signals::signal(true)
    let field = ui::Field::new()
    field.set("Ship Step 3 with 2x Metal shots")
    let scroll = view::Scroll::new()
    let sent = signals::signal(0)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        build_benchmark_im_scene(root, show_detail, field, scroll, sent)
      },
      width=w,
      height=h,
      scale=2.0,
      theme=ui_theme,
    )
    t.frame()
    // Scroll content under the top glass; a programmatic scroll asks for its frame as input would.
    scroll.put(42.0)
    t.fake.frame_requested = true
    t.frame()
    assert_apple_ui(t, label=tag)
    debug_assert(count_liquid_glass(t) >= 3, "benchmark IM scene must render floating top/bottom glass chrome")
    // Verify Send button triggers composer callback
    let send_btn = require_drawn(t, "Send", view::Role::Button)
    t.tap(send_btn.x + send_btn.w / 2.0, send_btn.y + send_btn.h / 2.0)
    t.frame()
    debug_assert(sent.get() == 1, "ComposerBar Send button must trigger on_send")
    t.dispose()
  }
  set_dark(None)
}

fn ps_progressive_bands(t : ui::Tester) -> Array[(Double, Double, Double, Double, Int, Int)] {
  let out : Array[(Double, Double, Double, Double, Int, Int)] = []
  for g in t.drawn_glass() {
    if g.4 == 5 {
      out.push(g)
    }
  }
  out
}

fn ps_island_page(
  root : view::View,
  field : ui::Field,
  title : String,
  top_edge_blur : Option[Bool],
  bottom_edge_blur : Bool,
) -> Unit {
  ui::set_tree_theme(ui_theme)
  let _ = page_shell_node(
    root,
    fn(feed : view::View) -> Unit {
      // Padding set by `body` must not override the shell's automatic insets: with a bare title the
      // card would otherwise sit under the title and fail the `words_over` craft gate below.
      let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(12.0))
      let _ = surface_card_node(
        feed,
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(w : view::View) -> Unit {
            let _ = w.words(view::Live::Is("Content glides under the floating glass islands."), look=words_at(14.0, wrap=true)).ink(view::Live::By(fn() { surface().ink }))
          })
        },
        pad=16.0,
      )
      let _ = feed.box(fn(sp : view::View) -> Unit { let _ = sp.height(view::Live::Is(Some(900.0))) })
    },
    title=fn() { title },
    leading=fn(l : view::View) -> Unit { let _ = liquid_back_button_node(l, fn() -> Unit { () }) },
    trailing=fn(tr : view::View) -> Unit {
      let _ = liquid_bar_pill_group_node(
        tr,
        fn(p : view::View) -> Unit {
          let _ = liquid_button_node(
            p,
            fn() { "Search" },
            fn() -> Unit { () },
            content=fn(c : view::View) -> Unit { let _ = icon_node(c, IconKind::Search, size=15.0) },
            flat=true,
            ghost=true,
            height=30.0,
            pad_x=10.5,
          )
        },
        height=36.0,
        label=fn() { "Actions" },
      )
    },
    bottom=fn(bot : view::View) -> Unit {
      let _ = composer_bar_node(bot, field, fn() -> Unit { () })
    },
    top_edge_blur?=top_edge_blur,
    bottom_edge_blur=bottom_edge_blur,
  )
}

test "lg_page_shell_no_bare_text_no_scroll_edge_blur" {
  set_dark(Some(false))
  // Glass islands only (back button, pill group, composer): zero progressive blur bands.
  // Bare title text (or an explicit opt-in): one compact 66pt band at the top, 64pt at the bottom when opted in.
  let cases : Array[(String, String, Option[Bool], Bool, Array[(Double, Double)])] = [
    ("islands_only", "", None, false, []),
    ("bare_title", "Messages", None, false, [(0.0, 66.0)]),
    ("forced_on", "", Some(true), false, [(0.0, 66.0)]),
    ("forced_off", "Messages", Some(false), false, []),
    ("bottom_opt_in", "", None, true, [(780.0, 64.0)]),
  ]
  for item in cases {
    let tag = item.0
    let title = item.1
    let forced = item.2
    let bottom_blur = item.3
    let want = item.4
    let field = ui::Field::new()
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit { ps_island_page(root, field, title, forced, bottom_blur) },
      width=390.0,
      height=844.0,
      scale=2.0,
      theme=ui_theme,
    )
    t.frame()
    let bands = ps_progressive_bands(t)
    debug_assert(bands.length() == want.length(), "\{tag}: expected \{want.length()} progressive scroll-edge bands, got \{bands.length()}")
    let mut i = 0
    while i < want.length() && i < bands.length() {
      let want_y = want[i].0
      let want_h = want[i].1
      let y = bands[i].1
      let bw = bands[i].2
      let bh = bands[i].3
      debug_assert((y - want_y).abs() < 0.01, "\{tag}: blur band y must be \{want_y}, got \{y}")
      debug_assert((bw - 390.0).abs() < 0.01, "\{tag}: the blur band must span the full width")
      debug_assert((bh - want_h).abs() < 0.01, "\{tag}: blur band height must be \{want_h}, got \{bh}")
      i += 1
    }
    assert_apple_ui(t, label="page_shell_\{tag}")
    t.dispose()
  }
  set_dark(None)
}

fn ps_join(xs : Array[String]) -> String {
  let mut out = ""
  for x in xs {
    out = out + x + "; "
  }
  out
}

fn ps_composer_parts(t : ui::Tester) -> (view::Drawn, view::Drawn, view::Drawn) {
  let cap = require_drawn(t, "Message", view::Role::Group)
  let typed = require_drawn(t, "Message", view::Role::TextField)
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => {
      debug_assert(false, "expected a live view tree")
      return (cap, cap, typed)
    }
  }
  let mut wrap = typed
  let mut found = false
  for d in t.drawn() {
    if !found && d.id != cap.id && d.id != typed.id && tree.holds(cap.id, d.id) && tree.holds(d.id, typed.id) {
      wrap = d
      found = true
    }
  }
  debug_assert(found, "expected the field's clipping wrapper inside the composer capsule")
  (cap, wrap, typed)
}

fn ps_composer_wrap_in_glass(tag : String, cap : view::Drawn, wrap : view::Drawn) -> Unit {
  debug_assert(wrap.y >= cap.y - 0.01, "\{tag}: field wrapper top \{wrap.y} must not rise above the capsule glass \{cap.y}")
  debug_assert(
    wrap.y + wrap.h <= cap.y + cap.h + 0.01,
    "\{tag}: field wrapper bottom \{wrap.y + wrap.h} must not reach past the capsule glass bottom \{cap.y + cap.h}",
  )
}

test "lg_composer_bar_scrolled_text_under_glass_passes_words_over" {
  set_dark(Some(false))
  let field = ui::Field::new()
  let scroll = view::Scroll::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = page_shell_node(
        root,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(6.0))
          let mut k = 0
          while k < 60 {
            let line = "Message line \{k} glides under the composer glass."
            let _ = feed.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is(line), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
            k += 1
          }
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = composer_bar_node(bot, field, fn() -> Unit { () })
        },
        scroll=scroll,
      )
    },
    width=390.0,
    height=844.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  let (cap0, wrap0, typed0) = ps_composer_parts(t)
  ps_composer_wrap_in_glass("single_line", cap0, wrap0)
  debug_assert(wrap0.h >= 36.0 - 0.01, "composer field hit area must stay >= 36pt, got \{wrap0.h}")
  // The field's text is drawn from its top at its natural height: its middle is the capsule's.
  let mid0 = typed0.y + typed0.h * 0.5
  let cap_mid0 = cap0.y + cap0.h * 0.5
  debug_assert((mid0 - cap_mid0).abs() <= 1.0, "single-line text middle \{mid0} must sit at the capsule middle \{cap_mid0}")
  // A tap anywhere in the input area (here near its bottom edge) focuses the field.
  debug_assert(!field.focused(), "the composer field must start unfocused")
  t.tap(wrap0.x + wrap0.w * 0.5, wrap0.y + wrap0.h - 4.0)
  t.frame()
  debug_assert(field.focused(), "tapping the composer input area must focus the field")
  // Scroll 1pt at a time so every message line sweeps the capsule's bottom band [cap.y + 40, cap.y + 48].
  let mut off = 0.0
  while off <= 60.0 {
    scroll.put(off)
    t.fake.frame_requested = true
    t.frame()
    let faults = t.words_over_faults()
    debug_assert(faults.length() == 0, "scroll \{off}: text passing under the composer glass must not fault: \{ps_join(faults)}")
    off += 1.0
  }
  assert_apple_ui(t, label="composer_scrolled_single_line")
  // Two lines of input grow the capsule; the field wrapper must still sit inside its glass.
  field.set("First line\nSecond line")
  t.fake.frame_requested = true
  t.frame()
  let (cap1, wrap1, typed1) = ps_composer_parts(t)
  ps_composer_wrap_in_glass("two_lines", cap1, wrap1)
  debug_assert((cap1.h - 44.0).abs() < 0.01, "two lines fit the 44pt capsule, got \{cap1.h}")
  let mid1 = typed1.y + typed1.h * 0.5
  let cap_mid1 = cap1.y + cap1.h * 0.5
  debug_assert((mid1 - cap_mid1).abs() <= 1.0, "two-line text middle \{mid1} must sit at the capsule middle \{cap_mid1}")
  let mut off2 = 0.0
  while off2 <= 60.0 {
    scroll.put(off2)
    t.fake.frame_requested = true
    t.frame()
    let faults = t.words_over_faults()
    debug_assert(faults.length() == 0, "two lines, scroll \{off2}: text passing under the composer glass must not fault: \{ps_join(faults)}")
    off2 += 1.0
  }
  assert_apple_ui(t, label="composer_scrolled_two_lines")
  t.dispose()
  set_dark(None)
}

test "lg_page_shell_bottom_seam_occludes_scrolled_button_slivers" {
  set_dark(Some(false))
  let field = ui::Field::new()
  let scroll = view::Scroll::new()
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      ui::set_tree_theme(ui_theme)
      let _ = page_shell_node(
        root,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 8.0, 16.0, 8.0))).gap(view::Live::Is(12.0))
          let mut k = 0
          while k < 24 {
            let line = "Message \{k} with a reply action under it."
            let _ = feed.box(fn(m : view::View) -> Unit {
              let _ = m.gap(view::Live::Is(4.0))
              let _ = m.box(fn(w : view::View) -> Unit {
                let _ = w.words(view::Live::Is(line), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
              })
              let _ = m.box(fn(row : view::View) -> Unit {
                let _ = row.row(view::Live::Is(true))
                let _ = liquid_button_node(row, fn() { "Reply" }, fn() -> Unit { () }, flat=true, ghost=true, height=36.0)
              })
            })
            k += 1
          }
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = composer_bar_node(bot, field, fn() -> Unit { () })
        },
        bottom_edge_blur=false,
        scroll=scroll,
      )
    },
    width=390.0,
    height=844.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  // Scroll 1pt at a time: every "Reply" button sweeps the bottom seam, where only a 15–22pt sliver of it peeks out
  // past the window's bottom edge, behind the seam's solid scrim. That sliver is out of sight, not a short target.
  // (Offsets where a button is cut by the window's top edge, with no chrome over it, are not this seam's case.)
  let mut slivers = 0
  let mut sliver_off = -1.0
  let mut off = 0.0
  while off <= 120.0 {
    scroll.put(off)
    t.fake.frame_requested = true
    t.frame()
    let mut top_cut = false
    let mut sliver = false
    match ui::view_tree() {
      Some(tree) => {
        for e in tree.drawn_held() {
          let d = e.0
          if e.2 && (d.h - 36.0).abs() < 0.5 {
            let peek = 844.0 - d.y
            if peek >= 15.0 - 0.01 && peek <= 22.0 + 0.01 {
              sliver = true
            }
            if d.y < 0.0 && d.y + d.h > 0.0 {
              top_cut = true
            }
          }
        }
      }
      None => debug_assert(false, "expected a live view tree")
    }
    if !top_cut {
      if sliver {
        slivers += 1
        sliver_off = off
      }
      let faults = t.room_faults()
      debug_assert(faults.length() == 0, "scroll \{off}: button slivers under the bottom seam must be occluded: \{ps_join(faults)}")
    }
    off += 1.0
  }
  debug_assert(slivers > 0, "expected a Reply button sliver 15–22pt tall in the bottom seam")
  // The full Apple UI gate, at an offset where a Reply sliver sits in the seam.
  scroll.put(sliver_off)
  t.fake.frame_requested = true
  t.frame()
  assert_apple_ui(t, label="page_shell_bottom_seam_slivers")
  t.dispose()
  set_dark(None)
}

fn ps_button_rows_page(
  root : view::View,
  field : ui::Field,
  scroll : view::Scroll,
  inset : signals::Signal[Double],
) -> Unit {
  ui::set_tree_theme(ui_theme)
  let _ = page_shell_node(
    root,
    fn(feed : view::View) -> Unit {
      let _ = feed.padding(view::Live::Is((16.0, 0.0, 16.0, 0.0))).gap(view::Live::Is(8.0))
      let mut k = 0
      while k < 40 {
        let name = "Row \{k}"
        let _ = headless::button(
          feed,
          fn() { name },
          fn(_e) -> Unit { () },
          fn(b : view::View, _btn : headless::Button) -> Unit {
            let _ = b
            .height(view::Live::Is(Some(44.0)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(10.0))
            .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .ground(view::Live::By(fn() { surface().card }))
            let _ = b.box(fn(w : view::View) -> Unit {
              let _ = w.words(view::Live::Is(name), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
            })
          },
        )
        k += 1
      }
    },
    bottom=fn(bot : view::View) -> Unit {
      let _ = composer_bar_node(bot, field, fn() -> Unit { () })
    },
    top_inset=0.0,
    bottom_inset_by=fn() { inset.get() },
    scroll=scroll,
  )
}

test "lg_page_shell_bottom_inset_by_is_reactive" {
  set_dark(Some(false))
  let field = ui::Field::new()
  let scroll = view::Scroll::new()
  let inset = signals::signal(80.0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { ps_button_rows_page(root, field, scroll, inset) },
    width=390.0,
    height=844.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  let most0 = scroll.most()
  debug_assert(most0 > 0.0, "the rows must overflow the page, got reach \{most0}")
  inset.set(200.0)
  t.fake.frame_requested = true
  t.frame()
  let most1 = scroll.most()
  debug_assert((most1 - most0 - 120.0).abs() < 0.5, "bottom_inset_by 80 -> 200 must grow the reach by 120, got \{most1 - most0}")
  inset.set(40.0)
  t.fake.frame_requested = true
  t.frame()
  let most2 = scroll.most()
  debug_assert((most0 - most2 - 40.0).abs() < 0.5, "bottom_inset_by 80 -> 40 must shrink the reach by 40, got \{most0 - most2}")
  assert_apple_ui(t, label="page_shell_bottom_inset_by")
  t.dispose()
  set_dark(None)
}

test "lg_page_shell_bottom_seam_covers_clipped_rows_and_passes_wheel" {
  set_dark(Some(false))
  let field = ui::Field::new()
  let scroll = view::Scroll::new()
  let inset = signals::signal(80.0)
  let h = 844.0
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { ps_button_rows_page(root, field, scroll, inset) },
    width=390.0,
    height=h,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  // Rows repeat every 52pt (44pt row + 8pt gap). Sweep the offsets where no row is cut at the window top, so the only
  // rows cut short (< 36pt) are those at the window bottom: inside the opaque bottom seam, which covers them.
  let mut checked = 0
  let mut off = 500.0
  while off <= 760.0 {
    let phase = off - (off / 52.0).floor() * 52.0
    if phase == 0.0 || phase >= 44.0 {
      scroll.put(off)
      t.fake.frame_requested = true
      t.frame()
      let faults = t.room_faults()
      debug_assert(faults.length() == 0, "scroll \{off}: rows cut at the bottom seam must not fault: \{ps_join(faults)}")
      checked += 1
    }
    off += 1.0
  }
  debug_assert(checked >= 20, "expected to sweep at least 20 offsets, got \{checked}")
  assert_apple_ui(t, label="page_shell_bottom_seam_sweep")
  // The seam neither takes the pointer nor stops the wheel: a wheel beside the composer still scrolls the rows.
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => {
      debug_assert(false, "expected a live view tree")
      return
    }
  }
  scroll.put(300.0)
  t.fake.frame_requested = true
  t.frame()
  let at0 = scroll.at(tree)
  t.wheel(195.0, h - 4.0, 120.0)
  t.run_shown(springs_out)
  let at1 = scroll.at(tree)
  debug_assert((at1 - at0).abs() > 1.0, "a wheel over the bottom seam must scroll the rows, stayed at \{at0}")
  t.dispose()
  set_dark(None)
}

fn ps_moves_window_rows(t : ui::Tester) -> Array[view::Drawn] {
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => return []
  }
  let out : Array[view::Drawn] = []
  for d in t.drawn() {
    if tree.moves_window(d.id) {
      out.push(d)
    }
  }
  out
}

test "lg_page_shell_moves_window_bar_for_a_window_without_a_system_title_bar" {
  set_dark(Some(true))
  for moves in [false, true] {
    let presses = signals::signal(0)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        <PageShell
          in={root}
          title="Device"
          moves_window={moves}
          trailing={fn(tr : view::View) -> Unit {
            <BarPillGroup in={tr} height={36.0} label="Window">
              <Button flat ghost height={32.0} pad_x={10.5} label="Close" on_press=>{ presses.set(presses.untracked() + 1) }>
                <Icon kind={.Close} size={15.0} />
              </Button>
            </BarPillGroup>
          }}
        >
          <SurfaceCard pad={16.0}>
            <ui::Text text="Body" size={14.0} />
          </SurfaceCard>
        </PageShell>
      },
      width=780.0,
      height=500.0,
      theme=ui_theme,
    )
    t.frame()
    let rows = ps_moves_window_rows(t)
    if moves {
      debug_assert(rows.length() == 1, "moves_window: exactly the header bar moves the window, got \{rows.length()}")
      debug_assert((rows[0].w - (780.0 - 28.0)).abs() < 0.01, "moves_window: the bar spans the header, got w=\{rows[0].w}")
      debug_assert((rows[0].h - 44.0).abs() < 0.01, "moves_window: the bar is header_height tall, got h=\{rows[0].h}")
    } else {
      debug_assert(rows.length() == 0, "no moves_window: nothing moves the window")
    }
    // the island in the bar still takes its press
    t.press("Close")
    t.frame(ms=16.0)
    debug_assert(presses.untracked() == 1, "the bar's island takes its press (moves_window=\{moves})")
    assert_apple_ui(t, label="page_shell_moves_window_\{moves}")
    t.dispose()
  }
  set_dark(None)
}

test "lg_chip_and_stepper_36pt_room_laid_out_at_their_own_size" {
  let v = signals::signal(1600)
  let picked = signals::signal(0)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      <ui::Col in={root} pad={20.0} gap={20.0} fill>
        <ui::Row gap={8.0} align={.Middle} rigid>
          <Chip label="400" selected_by=>{picked.get() == 400} on_press=>{ picked.set(400) } />
          <Chip label="800" selected_by=>{picked.get() == 800} on_press=>{ picked.set(800) } />
        </ui::Row>
        <Stepper value_by=>{v.get()} on_change={fn(x : Int) -> Unit { v.set(x) }} min={200} max={4000} step={50} label="DPI" />
      </ui::Col>
    },
    width=420.0,
    height=260.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_apple_ui(t, label="chip_and_stepper_36pt_room")
  t.press("800")
  t.frame(ms=16.0)
  debug_assert(picked.untracked() == 800, "the chip takes its press")
  t.press("Increase DPI")
  t.frame(ms=16.0)
  debug_assert(v.untracked() == 1650, "the stepper's + takes its press, got \{v.untracked()}")
  t.press("Decrease DPI")
  t.press("Decrease DPI")
  t.frame(ms=16.0)
  debug_assert(v.untracked() == 1550, "the stepper's - takes its press, got \{v.untracked()}")
  match t.get("400") {
    Some(chip) => debug_assert(chip.h >= 36.0, "a chip's press target is >= 36pt tall, got \{chip.h}")
    None => debug_assert(false, "the chip is drawn")
  }
  t.dispose()
}

test "lg_flat_chip_segmented_stepper_draw_no_glass_in_the_content_layer" {
  for dark in [false, true] {
    set_dark(Some(dark))
    for flat in [false, true] {
      let lod = signals::signal(1)
      let v = signals::signal(800)
      let removed = signals::signal(0)
      let t = ui::Tester::tree(
        fn(root : view::View) -> Unit {
          <ui::Col in={root} pad={20.0} gap={20.0} fill>
            <ui::Row gap={8.0} align={.Middle} rigid>
              <Chip flat={flat} label="400" selected_by=>{v.get() == 400} on_press=>{ v.set(400) } />
              <Chip flat={flat} label="800" selected_by=>{v.get() == 800} on_press=>{ v.set(800) } />
              <Chip
                flat={flat}
                label="Custom"
                selected_by=>{v.get() == 1600}
                on_press=>{ v.set(1600) }
                on_remove={fn() -> Unit { removed.set(removed.untracked() + 1) }}
                remove_label="Remove Custom"
              />
            </ui::Row>
            <Segmented flat={flat} labels={["Low", "Mid", "High"]} selected_by=>{lod.get()} on_select={fn(i : Int) -> Unit { lod.set(i) }} width={216.0} />
            <Stepper flat={flat} value_by=>{v.get()} on_change={fn(x : Int) -> Unit { v.set(x) }} min={200} max={4000} step={50} label="DPI" show_value={false} />
          </ui::Col>
        },
        width=480.0,
        height=260.0,
        theme=ui_theme,
      )
      t.frame()
      let n = count_liquid_glass(t)
      if flat {
        debug_assert(n == 0, "flat controls (including removable chip) draw no glass at rest (dark=\{dark}), got \{n}")
      } else {
        debug_assert(n == 5, "floating controls are glass: 2 chips, 1 removable chip, segmented track, stepper (dark=\{dark}), got \{n}")
      }
      // Stepper `-` and `+` hit boxes must be >= 36x36 and strictly non-overlapping horizontally.
      match (t.get("Decrease DPI"), t.get("Increase DPI")) {
        (Some(dec), Some(inc)) => {
          debug_assert(dec.w >= 36.0 && dec.h >= 36.0, "stepper - hit target >= 36x36, got \{dec.w}x\{dec.h}")
          debug_assert(inc.w >= 36.0 && inc.h >= 36.0, "stepper + hit target >= 36x36, got \{inc.w}x\{inc.h}")
          debug_assert(dec.x + dec.w <= inc.x + 0.01, "stepper - and + hit boxes must not overlap: dec_end=\{dec.x + dec.w}, inc_x=\{inc.x}")
        }
        _ => debug_assert(false, "expected Decrease DPI and Increase DPI buttons")
      }
      t.press("400")
      t.press("High")
      t.press("Increase DPI")
      t.press("Remove Custom")
      t.run_shown(springs_out)
      debug_assert(v.untracked() == 450 && lod.untracked() == 2 && removed.untracked() == 1, "flat=\{flat}: all controls take their presses")
      assert_apple_ui(t, label="flat_controls_\{flat}_\{dark}")
      t.dispose()
    }
  }
  set_dark(None)
}

test "lg_context_auto_flat_in_content_and_overlays" {
  for dark in [false, true] {
    set_dark(Some(dark))
    ui::set_glass_solid(None)
    let dpi = signals::signal(1600)
    let lod = signals::signal(1)
    let profile = signals::signal(0)
    let field = ui::Field::new()
    let sheet_open = signals::signal(false)
    let sheet_dpi = signals::signal(800)
    let sheet_lod = signals::signal(0)
    let sheet_prof = signals::signal(1)
    let sheet_field = ui::Field::new()
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        let _ = root.box(fn(stage : view::View) -> Unit {
          let _ = stage.fill()
          let _ = page_shell_node(
            stage,
            fn(body : view::View) -> Unit {
              let _ = body.padding(view::Live::Is((16.0, 16.0, 16.0, 16.0))).gap(view::Live::Is(14.0))
              let _ = surface_card_node(
                body,
                fn(c : view::View) -> Unit {
                  let _ = c.box(fn(row : view::View) -> Unit {
                    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                    <Chip in={row} label="800" selected_by=>{dpi.get() == 800} on_press=>{ dpi.set(800) } />
                    <Chip in={row} label="1600" selected_by=>{dpi.get() == 1600} on_press=>{ dpi.set(1600) } />
                    <Chip in={row} label="Tag" selected={false} on_press=>{ () } on_remove={fn() -> Unit { () }} remove_label="Remove Tag" />
                  })
                  let _ = c.box(fn(row : view::View) -> Unit {
                    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                    <Stepper in={row} value_by=>{dpi.get()} on_change={fn(x : Int) -> Unit { dpi.set(x) }} min={200} max={4000} step={50} label="DPI" />
                    <Segmented in={row} labels={["Low", "Mid", "High"]} selected_by=>{lod.get()} on_select={fn(i : Int) -> Unit { lod.set(i) }} width={216.0} />
                  })
                  let _ = c.box(fn(row : view::View) -> Unit {
                    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                    <Button in={row} label="Reset" on_press=>{ dpi.set(800) } />
                    <Button in={row} label="Save" prominent={true} on_press=>{ () } />
                  })
                  <TextField in={c} field={field} placeholder="Profile name" />
                  let _ = liquid_select_node(
                    c,
                    stage,
                    fn() { [LiquidSelectOption::new(label="Desktop"), LiquidSelectOption::new(label="Gaming")] },
                    fn() { profile.get() },
                    fn(i : Int) -> Unit { profile.set(i) },
                    label=fn() { "Mode" },
                    width=200.0,
                  )
                },
                pad=20.0,
                gap=14.0,
                label=fn() { "DPI Settings" },
              )
              let _ = liquid_list_node(
                body,
                fn() { [LiquidListRow::new(title="Polling Rate", value="1000 Hz")] },
                header=fn() { "HARDWARE" },
              )
            },
            grouped=true,
            leading=fn(l : view::View) -> Unit {
              <BarPillGroup in={l} height={36.0} label="Bar Actions">
                <Button ghost height={30.0} pad_x={10.5} label="Refresh" on_press=>{ () }>
                  <Icon kind={.Refresh} size={15.0} />
                </Button>
              </BarPillGroup>
            },
            trailing=fn(tr : view::View) -> Unit {
              // Standalone button in Floating context: must automatically remain Liquid Glass.
              <Button in={tr} label="Apply" on_press=>{ () } />
            },
          )
          let _ = liquid_sheet_node(
            stage,
            fn() { sheet_open.get() },
            fn() { sheet_open.set(false) },
            fn() { "Quick Tune" },
            fn(sb : view::View) -> Unit {
              let _ = sb.gap(view::Live::Is(14.0))
              let _ = sb.box(fn(row : view::View) -> Unit {
                let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                <Chip in={row} label="400" selected_by=>{sheet_dpi.get() == 400} on_press=>{ sheet_dpi.set(400) } />
                <Chip in={row} label="800" selected_by=>{sheet_dpi.get() == 800} on_press=>{ sheet_dpi.set(800) } />
                <Chip in={row} label="Removable" on_press=>{ () } on_remove={fn() -> Unit { () }} remove_label="Remove Removable" />
              })
              <Stepper in={sb} value_by=>{sheet_dpi.get()} on_change={fn(x : Int) -> Unit { sheet_dpi.set(x) }} min={200} max={4000} step={50} label="Sheet DPI" />
              <Segmented in={sb} labels={["Off", "Balanced", "Pro"]} selected_by=>{sheet_lod.get()} on_select={fn(i : Int) -> Unit { sheet_lod.set(i) }} width={220.0} />
              let _ = sb.box(fn(row : view::View) -> Unit {
                let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                <Button in={row} label="Sheet Cancel" on_press=>{ sheet_open.set(false) } />
                <Button in={row} label="Sheet Done" prominent={true} on_press=>{ sheet_open.set(false) } />
              })
              <TextField in={sb} field={sheet_field} placeholder="Note" />
              let _ = liquid_select_node(
                sb,
                stage,
                fn() { [LiquidSelectOption::new(label="Wired"), LiquidSelectOption::new(label="2.4 GHz")] },
                fn() { sheet_prof.get() },
                fn(i : Int) -> Unit { sheet_prof.set(i) },
                label=fn() { "Link" },
                width=200.0,
              )
              let _ = sb.box(fn(ft : view::View) -> Unit {
                let _ = ft.words(view::Live::Is("Applies immediately."), look=words_at(12.5)).ink(view::Live::By(fn() { surface().ink_secondary }))
              })
            },
            width=460.0,
          )
        })
      },
      width=780.0,
      height=680.0,
      theme=ui_theme,
    )
    t.run_shown(springs_out)
    // Content Layer (PageShell body + SurfaceCard + List) emits 0 glass; top bar BarPillGroup (1) + standalone trailing Button (1) == 2.
    let base_glass = count_liquid_glass(t)
    debug_assert(base_glass == 2, "auto-flat in PageShell body/SurfaceCard/BarPillGroup + floating trailing Button must emit exactly 2 glass (dark=\{dark}), got \{base_glass}")
    assert_apple_ui(t, label="context_auto_flat_page_dark_\{dark}")

    // Open Sheet: adds exactly 1 glass (the Sheet shell itself), zero nested glass for all inner controls!
    sheet_open.set(true)
    t.run_shown(springs_out)
    let with_sheet_glass = count_liquid_glass(t)
    debug_assert(with_sheet_glass == 3, "opening Sheet with auto-flat controls must add only 1 glass (sheet shell), total 3 (dark=\{dark}), got \{with_sheet_glass}")
    assert_apple_ui(t, label="context_auto_flat_sheet_dark_\{dark}", allow_large_overlay=true)
    t.dispose()
  }
  set_dark(None)
}

test "lg_shadow_ladder_light_and_dark_no_legacy_heavy_shadow" {
  // Verify shadow_default matches light glass_control_shadow (no legacy 12pt / 0x1A heavy shadow).
  debug_assert(
    (shadow_default.0 - 5.0).abs() < 0.01 && (shadow_default.1 - 2.0).abs() < 0.01 && shadow_default.2 == 0x00000010L,
    "shadow_default must be calibrated (5.0, 2.0, 0x00000010L)",
  )
  for dark in [false, true] {
    set_dark(Some(dark))
    ui::set_glass_solid(None)
    let exp_ctrl = glass_control_shadow()
    let exp_ovl = glass_overlay_shadow()
    // 1. Floating Button & IconButton -> glass_control_shadow
    let tc = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        <ui::Row in={root} pad={24.0} gap={20.0} align={.Middle}>
          <Button label="FloatBtn" on_press=>{ () } />
          <IconButton label="FloatIcon" icon={fn(v, ink) { let _ = icon_node(v, IconKind::Plus, size=15.0, ink=ink) }} on_press=>{ () } />
        </ui::Row>
      },
      width=420.0,
      height=140.0,
      theme=ui_theme,
    )
    tc.run_shown(springs_out)
    let mut ctrl_hits = 0
    for d in tc.drawn() {
      if d.glass.is_some() {
        debug_assert(
          (d.shadow.0 - exp_ctrl.0).abs() < 0.01 && (d.shadow.1 - exp_ctrl.1).abs() < 0.01 && d.shadow.2 == exp_ctrl.2,
          "floating control must use glass_control_shadow (dark=\{dark}), got (\{d.shadow.0}, \{d.shadow.1}, \{d.shadow.2})",
        )
        debug_assert((d.shadow.0 - 12.0).abs() > 0.5, "no legacy 12pt shadow on controls")
        ctrl_hits += 1
      }
    }
    debug_assert(ctrl_hits == 2, "expected 2 floating control glass surfaces, got \{ctrl_hits}")
    tc.dispose()

    // 2. Floating Panel, Menu Panel, Popover decorator, and Sheet -> glass_overlay_shadow
    let to = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        let _ = root.box(fn(col : view::View) -> Unit {
          let _ = col.fill().padding(view::Live::Is((24.0, 24.0, 24.0, 24.0))).gap(view::Live::Is(20.0))
          <Panel in={col} floating={true} label="FloatPanel">
            <ui::Text text="Panel" size={13.0} />
          </Panel>
          let _ = liquid_menu_panel_node(
            col,
            fn() { [LiquidMenuEntry::item(label="Action", on_select=fn() { () })] },
            fn() { () },
          )
          let _ = col.box(fn(p : view::View) -> Unit {
            let _ = p.width(view::Live::Is(Some(140.0))).height(view::Live::Is(Some(48.0)))
            let _ = liquid_popover_surface_decorate(p, radius=16.0)
          })
          <Sheet in={col} open_by=>{true} on_close=>{ () } title="Overlay Sheet" width={360.0}>
            <ui::Text text="Sheet body" size={13.0} />
          </Sheet>
        })
      },
      width=520.0,
      height=560.0,
      theme=ui_theme,
    )
    to.run_shown(springs_out)
    let mut ovl_hits = 0
    for d in to.drawn() {
      if d.glass.is_some() {
        debug_assert(
          (d.shadow.0 - exp_ovl.0).abs() < 0.01 && (d.shadow.1 - exp_ovl.1).abs() < 0.01 && d.shadow.2 == exp_ovl.2,
          "glass overlay must use glass_overlay_shadow (dark=\{dark}), got (\{d.shadow.0}, \{d.shadow.1}, \{d.shadow.2})",
        )
        ovl_hits += 1
      }
    }
    debug_assert(ovl_hits == 4, "expected 4 glass overlay surfaces (Panel, Menu, Popover, Sheet), got \{ovl_hits}")
    to.dispose()
  }
  set_dark(None)
}

// A popover opened over a page of text: its glass shell (a sibling `over` box beside the popover's content, not an
// ancestor of it) covers the page text under it, so the page text and the popover text are not "overlapping words"
// and the targets under it are not counted. Light and dark, at rest after opening.
test "popover open over page text passes assert_apple_ui (glass shell covers what is under it)" {
  for dark in [false, true] {
    set_dark(Some(dark))
    let open = signals::signal(true)
    let t = ui::Tester::tree(
      fn(root : view::View) -> Unit {
        ui::set_tree_theme(ui_theme)
        let _ = page_shell_node(
          root,
          fn(body : view::View) -> Unit {
            let _ = body.padding(view::Live::Is((24.0, 0.0, 24.0, 24.0))).gap(view::Live::Is(16.0))
            let _ = liquid_popover_node(
              body,
              root,
              fn() { open.get() },
              fn(v : Bool) -> Unit { open.set(v) },
              fn() { "Launch" },
              fn(trig : view::View, _d : headless::Disclosure) -> Unit {
                let _ = liquid_button_node(trig, fn() { "Launch" }, fn() { open.set(!open.untracked()) }, prominent=true, height=36.0)
              },
              fn() { "Before launch" },
              fn(pop : view::View) -> Unit {
                let _ = pop.gap(view::Live::Is(10.0))
                let _ = pop.box(fn(h : view::View) -> Unit {
                  let _ = h.words(view::Live::Is("Two mods are built for an older version"), look=words_at(15.0, weight=700, wrap=true))
                  .ink(view::Live::By(fn() { surface().ink }))
                })
                let _ = liquid_list_node(
                  pop,
                  fn() {
                    [
                      LiquidListRow::new(title="Waypoints", subtitle="Built for 4.0.1, running 4.1.6"),
                      LiquidListRow::new(title="BigBrain", subtitle="Built for 4.0.1, running 4.1.6"),
                    ]
                  },
                  flat=true,
                )
                let _ = pop.box(fn(f : view::View) -> Unit {
                  let _ = f.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lies_along(view::Live::Is(view::Lies::End))
                  let _ = liquid_button_node(f, fn() { "Launch anyway" }, fn() { open.set(false) }, flat=true, height=32.0)
                  let _ = liquid_button_node(f, fn() { "Disable" }, fn() { open.set(false) }, flat=true, prominent=true, height=32.0)
                })
              },
              placement=headless::Placement::BelowStart,
              width=420.0,
              radius=28.0,
              pad=12.0,
            )
            let _ = surface_card_node(
              body,
              fn(c : view::View) -> Unit {
                for line in ["Character", "Compatibility check", "Launch options", "Clean caches before launch", "Minimize after launch"] {
                  let _ = c.box(fn(w : view::View) -> Unit {
                    let _ = w.words(view::Live::Is(line), look=words_at(14.0)).ink(view::Live::By(fn() { surface().ink }))
                  })
                }
              },
              pad=20.0,
              gap=12.0,
            )
          },
          title=fn() { "Play" },
        )
      },
      width=760.0,
      height=560.0,
      theme=ui_theme,
    )
    t.run_for(800.0)
    debug_assert(t.find("Launch anyway").is_some(), "popover open")
    debug_assert(t.find("Compatibility check").is_some(), "page text under the popover drawn")
    assert_apple_ui(t, label="popover over page text \{dark}", allow_large_overlay=true)
    t.dispose()
  }
  set_dark(None)
}
