// Liquid Glass bottom tab bar with unified bar-level gesture, distance-adaptive spring,
// speed-stretch capsule physics, and lifted clear refraction loupe.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

let tab_bar_edge : Double = 8.0
let tab_bar_lens_lift_h : Double = 1.28
let tab_bar_lens_aspect : Double = 1.50
let tab_bar_hold_ms : Double = 200.0
let tab_bar_fling_ms : Double = 100.0
let tab_bar_lean : Double = 0.25
let tab_bar_slot_px : Double = 90.0
let tab_bar_ball_ratio : Double = 0.78
let tab_bar_ball_rest : Double = 0.01
let tab_bar_ball_box_w : Double = 100.0
let tab_bar_ball_box_h : Double = 50.0

fn tab_bar_lens_shadow() -> (Double, Double, Int64) {
  if is_dark() { (10.0, 4.0, 0x0000003CL) } else { (8.0, 4.0, 0x00000018L) }
}

fn tab_bar_selection_fill() -> Int64 {
  if is_dark() { 0xFFFFFF1FL } else { 0x00000012L }
}

fn tab_bar_item_w(w : Double, count : Int) -> Double {
  let n = if count < 1 { 1 } else { count }
  dmax(0.0, w - 2.0 * tab_bar_edge) / n.to_double()
}

fn tab_bar_centre(w : Double, count : Int, idx : Int) -> Double {
  let n = if count < 1 { 1 } else { count }
  let clamped = if idx < 0 { 0 } else if idx >= n { n - 1 } else { idx }
  tab_bar_edge + (clamped.to_double() + 0.5) * tab_bar_item_w(w, n)
}

fn tab_bar_nearest(w : Double, count : Int, px : Double) -> Int {
  let n = if count < 1 { 1 } else { count }
  let mut best = 0
  let mut best_d = (tab_bar_centre(w, n, 0) - px).abs()
  let mut j = 1
  while j < n {
    let d = (tab_bar_centre(w, n, j) - px).abs()
    if d < best_d {
      best = j
      best_d = d
    }
    j += 1
  }
  best
}

fn tab_bar_flung(px : Double, vx : Double, w : Double, count : Int) -> Double {
  let iw = tab_bar_item_w(w, count)
  px + clamp(vx * tab_bar_fling_ms, -iw, iw)
}

fn tab_bar_ball_size(
  w : Double,
  count : Int,
  held : Double,
  stretch : Double,
  lower : Double,
  lens : Bool,
  bar_h~ : Double = tabs_h,
) -> (Double, Double) {
  let iw = tab_bar_item_w(w, count)
  let pw = iw + 2.0 * (tab_bar_edge - tabs_pad)
  let rest_h = dmax(12.0, bar_h - 2.0 * tabs_pad)
  let capped_stretch = dmin(stretch, iw * 0.45)
  let (bw, bh) = if lens {
    let lh = bar_h * tab_bar_lens_lift_h
    let lw = dmin(lh * tab_bar_lens_aspect, iw * tab_bar_lens_aspect)
    let up = clamp(held, 0.0, 1.2)
    (pw + (lw - pw) * up, rest_h + (lh - rest_h) * up)
  } else {
    (pw, rest_h)
  }
  (dmax(8.0, bw + capped_stretch), dmax(8.0, bh - lower))
}

pub fn liquid_bottom_tab_node(
  g : view::View,
  rg : headless::RadioGroup[Int],
  index : Int,
  label : String,
  content : (view::View, () -> Int64) -> Unit,
  lit : (view::View) -> Double,
  scale : (view::View) -> Double,
  height~ : Double = tabs_h,
  press? : (view::Drag) -> Unit,
  tap? : (view::Drag) -> Unit,
  hold? : (Double, (view::Drag) -> Unit),
  drag? : (view::Drag) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lens_h = dmax(12.0, height - 2.0 * tabs_pad)
  rg.item(loc=loc, g, fn() { index }, fn() { label }, fn(t : view::View, it : headless::RadioItem) -> Unit {
    let _ = t
    .grow(view::Live::Is(1.0))
    .basis(view::Live::Is(Some(0.0)))
    .height(view::Live::Is(Some(height)))
    .radius(view::Live::Is(lens_h / 2.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    let _ = t.box(fn(f : view::View) -> Unit {
      let _ = f.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0)).scale(view::Live::By(fn() { scale(f) }))
      content(f, fn() {
        let c = colors()
        lerp_color(c.content, c.accent, clamp(lit(f), 0.0, 1.0))
      })
    })
    let has_g = press.is_some() || tap.is_some() || hold.is_some() || drag.is_some()
    if has_g {
      let _ = t.box(fn(hit : view::View) -> Unit {
        let _ = hit.over(view::Live::Is(true)).gesture(
          ui::touch_slop(),
          press=fn(d : view::Drag) -> Unit { match press { Some(f) => f(d); None => () } },
          tap=fn(d : view::Drag) -> Unit { match tap { Some(f) => f(d); None => () } },
          hold?=hold,
          drag=fn(d : view::Drag) -> Unit { match drag { Some(f) => f(d); None => () } },
        )
      })
    }
    t.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
      let _ = ring.over(view::Live::Is(true)).points(view::Live::Is(false)).radius(view::Live::Is(lens_h / 2.0)).edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  })
}

pub fn tab_face(name : String) -> (view::View, () -> Int64) -> Unit {
  fn(f : view::View, ink : () -> Int64) -> Unit {
    flight_icon(f, 18.0, ink)
    let _ = f.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::Is(name), look=words_at(type_tab)).ink(view::Live::By(ink))
    })
  }
}

pub fn liquid_bottom_tabs_node(
  parent : view::View,
  labels : Array[String],
  selected : () -> Int,
  select : (Int) -> Unit,
  label~ : String = "",
  height~ : Double = tabs_h,
  faces? : Array[(view::View, () -> Int64) -> Unit],
  drag? : DampedDrag,
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let count = labels.length()
  let last = if count > 1 { (count - 1).to_double() } else { 0.0 }
  let first = signals::untracked(selected).to_double()
  let lens_h = dmax(12.0, height - 2.0 * tabs_pad)
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(first, lo=0.0, hi=last, held_scale=height / lens_h)
  }
  let ih = match light {
    Some(l) => l
    None => InteractiveHighlight::new()
  }
  let held_way = motion::NodeWay::new(0.0)
  let ball_x = motion::NodeWay::new(0.0)
  let placed = ui::ref_new(false)
  let last_w = fref(0.0)
  let last_tension = fref(300.0)
  let current = ui::ref_new(signals::untracked(selected))
  let held_flag = ui::ref_new(false)
  let dd_lifted = ui::ref_new(false)
  let drag_x = fref(-1.0)
  let felt_idx = ui::ref_new(signals::untracked(selected))
  let active_under = signals::signal(-1)
  headless::radio_group(loc=loc, parent, fn() { label }, selected, select, kind=headless::GroupKind::Tab, fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
    dd.attach(g)
    ih.attach(g)
    let _ = g.height(view::Live::Is(Some(height)))
    let _ = g.by_room(fn(inner : view::View, room : view::Room) -> Unit {
      let w = fn() -> Double { room.width() }
      let pos_from_x = fn(ww : Double, px : Double) -> Double {
        let iw = tab_bar_item_w(ww, count)
        if iw <= 0.0 {
          0.0
        } else {
          clamp((px - tab_bar_edge) / iw - 0.5, 0.0, last)
        }
      }
      let slide_ball_to = fn(ww : Double, idx : Int) -> Unit {
        if ww <= 0.0 {
          return
        }
        let goal_x = tab_bar_centre(ww, count, idx)
        if !placed.v || ui::reduced_motion() {
          placed.v = true
          last_w.v = ww
          ball_x.put(goal_x)
          return
        }
        let now = g.cause_at()
        let cur_x = ball_x.value_at(now)
        let mut trip = dmax(8.0, (goal_x - cur_x).abs())
        if ball_x.goes_at(now) && last_tension.v > 0.0 {
          trip = dmax(trip, 300.0 * tab_bar_slot_px / last_tension.v)
        }
        let tension = clamp(300.0 * tab_bar_slot_px / trip, 210.0, 620.0)
        last_tension.v = tension
        ball_x.go(g, goal_x, motion::spring(ratio=tab_bar_ball_ratio, stiffness=tension, threshold=tab_bar_ball_rest))
      }
      let sync_drag = fn(ww : Double, px : Double) -> Unit {
        if ww <= 0.0 {
          return
        }
        if !placed.v {
          placed.v = true
          last_w.v = ww
          ball_x.put(tab_bar_centre(ww, count, signals::untracked(selected)))
        }
        let j = tab_bar_nearest(ww, count, px)
        let target_x = tab_bar_centre(ww, count, j)
        let goal_x = target_x + (px - target_x) * tab_bar_lean
        last_tension.v = 300.0
        if ui::reduced_motion() {
          ball_x.put(goal_x)
          held_way.put(1.0)
        } else {
          ball_x.go(g, goal_x, motion::spring(ratio=tab_bar_ball_ratio, stiffness=300.0, threshold=tab_bar_ball_rest))
          held_way.go(g, 1.0, motion::spring(ratio=1.0, stiffness=1000.0, threshold=0.001))
        }
        if !dd_lifted.v {
          dd_lifted.v = true
          dd.press()
        }
        dd.update_value(pos_from_x(ww, px))
      }
      let finish_drag = fn(ww : Double, idx : Int, commit : Bool) -> Unit {
        let clamped_i = if idx < 0 { 0 } else if idx >= count { if count > 0 { count - 1 } else { 0 } } else { idx }
        held_flag.v = false
        drag_x.v = -1.0
        active_under.set(-1)
        if ui::reduced_motion() {
          held_way.put(0.0)
        } else {
          held_way.go(g, 0.0, motion::spring(ratio=1.0, stiffness=1000.0, threshold=0.001))
        }
        let target_i = if commit { clamped_i } else { signals::untracked(selected) }
        current.v = target_i
        slide_ball_to(ww, target_i)
        if dd_lifted.v {
          dd_lifted.v = false
          dd.update_value(target_i.to_double())
          dd.release()
        } else {
          dd.slide_to(target_i.to_double())
        }
        if commit && target_i != signals::untracked(selected) {
          select(target_i)
        }
        ih.up()
      }
      g.reacts(at_start=true, w, fn(ww : Double) -> Unit {
        if ww > 0.0 && (!placed.v || (ww - last_w.v).abs() > 0.5) {
          placed.v = true
          last_w.v = ww
          let idx = if drag_x.v >= 0.0 {
            tab_bar_nearest(ww, count, drag_x.v)
          } else {
            signals::untracked(selected)
          }
          ball_x.put(tab_bar_centre(ww, count, idx))
        }
      })
      g.reacts(at_start=false, selected, fn(i : Int) -> Unit {
        if i != current.v && drag_x.v < 0.0 {
          current.v = i
          slide_ball_to(w(), i)
          dd.slide_to(i.to_double())
        }
      })
      let held_now = fn(n : view::View) -> Double { dmax(held_way.shown(n), dd.pressed(n)) }
      let ball_shape = fn(n : view::View, lens : Bool) -> view::GroundShape {
        let ww = w()
        let (x, xv) = if placed.v {
          ball_x.motion(n)
        } else {
          (tab_bar_centre(ww, count, signals::untracked(selected)), 0.0)
        }
        let v = xv / 60.0
        let (raw_stretch, lower) = motion::speed_stretch(v)
        let iw = tab_bar_item_w(ww, count)
        let stretch = dmin(raw_stretch, iw * 0.45)
        let cx = x + (if v < 0.0 { -stretch } else { stretch }) / 2.0
        let h_val = held_now(n)
        let (sw, sh) = tab_bar_ball_size(ww, count, h_val, stretch, lower, lens, bar_h=height)
        let r = dmin(sw, sh) / 2.0
        view::GroundShape::{
          dx: cx - sw / 2.0,
          dy: (height - sh) / 2.0,
          dw: sw - tab_bar_ball_box_w,
          dh: sh - tab_bar_ball_box_h,
          corners: Some((r, r, r, r)),
        }
      }
      // Layer 1: Bottom bar glass capsule (fixed geometry, never inflates or deforms)
      let _ = inner.box(fn(bar : view::View) -> Unit {
        let _ = bar
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::By(fn() { Some(w()) }))
        .height(view::Live::Is(Some(height)))
        .radius(view::Live::Is(height / 2.0))
        .shadow(view::Live::By(glass_control_shadow))
        .shadow_outside(view::Live::Is(true))
        lg_apply_glass_surface(bar, fn() { liquid_tab_bar_glass() })
      })
      // Layer 2: Resting selection pill (under icons/labels, zero-relayout ground_drawn)
      let _ = inner.box(fn(ball : view::View) -> Unit {
        let _ = ball
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(tab_bar_ball_box_w)))
        .height(view::Live::Is(Some(tab_bar_ball_box_h)))
        .radius(view::Live::Is(lens_h / 2.0))
        .ground(view::Live::By(tab_bar_selection_fill))
        .alpha(view::Live::By(fn() {
          let lensed = if ball.glass_solid() { 0.0 } else { dmin(1.0, held_now(ball)) }
          clamp(1.0 - lensed, 0.0, 1.0)
        }))
        .ground_drawn(view::Live::By(fn() { ball_shape(ball, false) }))
      })
      // Layer 3: Tab icons and labels row (never scales text, highlights selected or hovered-under-finger tab)
      let _ = inner.box(fn(row : view::View) -> Unit {
        let _ = row
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(height)))
        .padding(view::Live::Is((tab_bar_edge, 0.0, tab_bar_edge, 0.0)))
        let mut i = 0
        while i < labels.length() {
          let idx = i
          let name = labels[idx]
          let face = match faces {
            Some(fs) => if idx < fs.length() { fs[idx] } else { tab_face(name) }
            None => tab_face(name)
          }
          let _ = liquid_bottom_tab_node(
            row,
            rg,
            idx,
            name,
            face,
            fn(_n : view::View) -> Double {
              let under = active_under.get()
              let lit_now = if under >= 0 { under == idx } else { selected() == idx }
              if lit_now { 1.0 } else { 0.0 }
            },
            fn(_n : view::View) -> Double { 1.0 },
            height=height,
          )
          i += 1
        }
      })
      // Layer 4: Clear lifted liquid glass loupe over icons/labels (zero-relayout ground_drawn)
      let _ = inner.box(fn(lens : view::View) -> Unit {
        let _ = lens
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(tab_bar_ball_box_w)))
        .height(view::Live::Is(Some(tab_bar_ball_box_h)))
        .radius(view::Live::Is(lens_h / 2.0))
        .glass(view::Live::By(fn() {
          if lens.glass_solid() {
            None
          } else {
            let h = held_now(lens)
            if h > 0.01 {
              Some(liquid_tab_lens_glass(h))
            } else {
              None
            }
          }
        }))
        .shadow(view::Live::By(fn() {
          let h = held_now(lens)
          if h > 0.01 && !lens.glass_solid() {
            let (s, dy, ink) = tab_bar_lens_shadow()
            (s, dy, alpha(ink, dmin(1.0, h)))
          } else {
            (0.0, 0.0, clear)
          }
        }))
        .shadow_outside(view::Live::Is(true))
        .alpha(view::Live::By(fn() {
          if lens.glass_solid() {
            0.0
          } else {
            let h = held_now(lens)
            if h > 0.01 { dmin(1.0, h) } else { 0.0 }
          }
        }))
        .ground_drawn(view::Live::By(fn() { ball_shape(lens, true) }))
      })
      // Unified bar-level gesture overlay
      let _ = inner.box(fn(bar_hit : view::View) -> Unit {
        let _ = bar_hit.over(view::Live::Is(true)).gesture(
          ui::touch_slop(),
          press=fn(d : view::Drag) -> Unit {
            held_flag.v = false
            felt_idx.v = signals::untracked(selected)
            ih.down(d.x, d.y, w(), height)
          },
          hold=(
            tab_bar_hold_ms,
            fn(d : view::Drag) -> Unit {
              let ww = w()
              held_flag.v = true
              drag_x.v = d.x
              let j = tab_bar_nearest(ww, count, d.x)
              felt_idx.v = j
              active_under.set(j)
              ui::haptic(ui::Haptic::LongPress)
              sync_drag(ww, d.x)
            },
          ),
          tap=fn(d : view::Drag) -> Unit {
            let ww = w()
            held_flag.v = false
            drag_x.v = -1.0
            active_under.set(-1)
            let j = tab_bar_nearest(ww, count, d.x)
            current.v = j
            slide_ball_to(ww, j)
            dd.slide_to(j.to_double())
            if j != signals::untracked(selected) {
              ui::haptic(ui::Haptic::TextHandleMove)
              select(j)
            }
            ih.up()
          },
          drag=fn(d : view::Drag) -> Unit {
            let ww = w()
            match d.kind {
              Down | Moved => {
                held_flag.v = false
                drag_x.v = d.x
                let j = tab_bar_nearest(ww, count, d.x)
                if j != felt_idx.v {
                  ui::haptic(ui::Haptic::TextHandleMove)
                  felt_idx.v = j
                }
                active_under.set(j)
                sync_drag(ww, d.x)
              }
              Up => {
                let target_px = if held_flag.v {
                  d.x
                } else {
                  tab_bar_flung(d.x, d.vx(), ww, count)
                }
                let j = tab_bar_nearest(ww, count, target_px)
                finish_drag(ww, j, true)
              }
              Off => finish_drag(ww, signals::untracked(selected), false)
            }
          },
        )
      })
    })
  })
}
