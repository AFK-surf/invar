// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidBottomTabs.kt and LiquidBottomTab.kt. A
// capsule of glass 64 high across what holds it (vivid, blurred by 8, a lens 24 deep bending by up to 24, the
// container's colour over it), its tabs side by side in it 4 in, each a column of what it holds 2 apart in its middle;
// over the chosen one a lens 56 high as wide as a tab. Held, the lens comes up (10 deep, bending by up to 14, the
// colours split, its highlight, shadow and InnerShadow of 8 with it) and grows to 78 / 56 of itself, the tabs to 1.2 of
// theirs and the bar by 16 across its width; dragged, it slides along the tabs (squeezed as it goes: velocity / 10) and
// the bar after it by up to 4 (eased out), and let go it settles on the nearest tab, which is chosen. A finger on it
// lights the bar where the lens is. What the bar is to the keys and a screen reader is mbui's headless radio group's, a
// tab list: a tab pressed is chosen, the arrow keys move among them.

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

/// The bar's glass (iOS 27 regular liquid glass calibrated for 56–64pt controls), lit by a finger at `spot` while
/// `light > 0.01`.
fn tabs_glass(light : Double, spot : Option[(Double, Double)]) -> paint::Glass {
  let d = is_dark()
  let sp = if light > 0.01 { spot } else { None }
  paint::Glass::liquid(
    blur=2.1,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=28.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
    spot?=sp,
  )
}

/// The lens's glass over the chosen tab (iOS 27 clear loupe), held `p`.
fn tab_lens_glass(p : Double) -> paint::Glass {
  let p = clamp(p, 0.0, 1.0)
  let c = colors()
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=alpha(c.container, 1.0 / 0.4),
    saturation=1.0,
    rim=0.6 * p,
    bezel=16.0 * p,
    refraction=24.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
  )
}

/// Compose's EaseOut (CubicBezierEasing(0, 0, 0.58, 1)).
fn ease_out(x : Double) -> Double {
  let f = motion::cubic_bezier(0.0, 0.0, 0.58, 1.0)
  f(x)
}

/// One tab of a LiquidBottomTabs (LiquidBottomTab) in `g`, `rg`'s item `index`, read out a tab named `label`: a column
/// of what `content` makes 2 apart in its middle, as wide as the bar's share of it; `content` given the ink to draw in
/// (the words' colour going to the accent as far as `lit` says the lens is over it). Grown by `scale`. The node.
pub fn liquid_bottom_tab_node(
  g : view::View,
  rg : headless::RadioGroup[Int],
  index : Int,
  label : String,
  content : (view::View, () -> Int64) -> Unit,
  lit : (view::View) -> Double,
  scale : (view::View) -> Double,
  loc~ : String = "",
) -> view::View {
  rg.item(g, fn() { index }, fn() { label }, fn(t, it) {
    let _ = t.grow(view::Live::Is(1.0)).radius(view::Live::Is(tab_lens_h / 2.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = t.box(fn(f) {
      let _ = f.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0)).scale(view::Live::By(fn() { scale(f) }))
      content(f, fn() {
        let c = colors()
        lerp_color(c.content, c.accent, clamp(lit(f), 0.0, 1.0))
      })
    })
    t.show(fn() { it.focus_shown() }, fn(ring) {
      let _ = ring.over(view::Live::Is(true)).radius(view::Live::Is(tab_lens_h / 2.0)).edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  }, made_for=loc)
}

/// What a tab holds by default (BottomTabsContent's): the airplane's icon 28 across over its name in 12 point words.
pub fn tab_face(name : String) -> (view::View, () -> Int64) -> Unit {
  fn(f : view::View, ink : () -> Int64) -> Unit {
    flight_icon(f, 28.0, ink)
    let _ = f.box(fn(w) { let _ = w.words(view::Live::Is(name), look=words_at(type_tab)).ink(view::Live::By(ink)) })
  }
}

/// A LiquidBottomTabs in `parent`: a tab for each of `labels` (what each holds `faces`'s, by default tab_face), the one
/// `selected` says chosen; chosen by a press, the arrow keys, or the lens dragged and let go over it, `select` is told
/// which. Read out a tab list named `label`. As wide as what holds it gives it, 64 high. `drag` and `light`: its lens's
/// way and its light, where its caller holds them (a picture of it held). The node.
pub fn liquid_bottom_tabs_node(
  parent : view::View,
  labels : Array[String],
  selected : () -> Int,
  select : (Int) -> Unit,
  label~ : String = "",
  faces? : Array[(view::View, () -> Int64) -> Unit],
  drag? : DampedDrag,
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let count = labels.length()
  let last = if count > 1 { (count - 1).to_double() } else { 0.0 }
  let first = signals::untracked(selected).to_double()
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(first, lo=0.0, hi=last, held_scale=tab_lens_held_scale)
  }
  let ih = match light {
    Some(l) => l
    None => InteractiveHighlight::new()
  }
  let current = ui::ref_new(signals::untracked(selected))
  let pulled = motion::NodeWay::new(0.0)
  let pulled_by = DoubleCell::{ v: 0.0 }
  let last_x = DoubleCell::{ v: 0.0 }
  headless::radio_group(parent, fn() { label }, selected, select, fn(g, rg) {
    dd.attach(g)
    ih.attach(g)
    let _ = g.height(view::Live::Is(Some(tabs_h))).padding(view::Live::Is((tabs_pad, tabs_pad, tabs_pad, tabs_pad)))
    g.reacts(selected, fn(i) {
      if i != current.v {
        current.v = i
        dd.animate_to(i.to_double())
      }
    }, at_start=false)
    let _ = g.by_room(fn(inner, room) {
      let w = fn() -> Double { room.width() + 2.0 * tabs_pad }
      let tab_w = fn() -> Double { (w() - 2.0 * tabs_pad) / count.to_double() }
      let panel = fn(n : view::View) -> Double {
        let ww = w()
        if ww <= 0.0 {
          return 0.0
        }
        let f = clamp(pulled.shown(n) / ww, -1.0, 1.0)
        let s = if f < 0.0 { -1.0 } else if f > 0.0 { 1.0 } else { 0.0 }
        4.0 * s * ease_out(f.abs())
      }
      let lit = fn(n : view::View, i : Int) -> Double { clamp(1.0 - (dd.value(n) - i.to_double()).abs(), 0.0, 1.0) }
      let grown = fn(n : view::View) -> Double { lerp(1.0, tab_held_scale, dd.pressed(n)) }
      let _ = inner.box(fn(bar) {
        let _ = bar
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(w()) }))
          .height(view::Live::Is(Some(tabs_h)))
          .margin(view::Live::Is((-tabs_pad, -tabs_pad, 0.0, 0.0)))
          .radius(view::Live::Is(tabs_h / 2.0))
          .shadow(view::Live::Is(shadow_default))
          .glass(view::Live::By(fn() {
            let p = ih.pressed(bar)
            let spot = if p > 0.0 {
              Some(((dd.value(bar) + 0.5) * tab_w() + tabs_pad + panel(bar), tabs_h / 2.0))
            } else {
              None
            }
            Some(tabs_glass(p, spot))
          }))
          .ground_drawn(view::Live::By(fn() {
            let ww = w()
            let s = lerp(1.0, 1.0 + 16.0 / ww, dd.pressed(bar))
            stretched(ww, tabs_h, panel(bar), 0.0, s, s)
          }))
      })
      let _ = inner.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).height(view::Live::Is(Some(tab_lens_h))).offset(view::Live::By(fn() { (panel(row), 0.0) }))
        let mut i = 0
        while i < labels.length() {
          let idx = i
          let name = labels[idx]
          let face = match faces {
            Some(fs) if idx < fs.length() => fs[idx]
            _ => tab_face(name)
          }
          let _ = liquid_bottom_tab_node(row, rg, idx, name, face, fn(n) { lit(n, idx) }, grown)
          i += 1
        }
      })
      let _ = inner.box(fn(lens) {
        let size = fn() -> (Double, Double) {
          let (sx, sy) = dd.jelly(lens, 10.0)
          (tab_w() * sx, tab_lens_h * sy)
        }
        let _ = lens
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(size().0) }))
          .height(view::Live::By(fn() { Some(size().1) }))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .offset(view::Live::By(fn() {
            let (lw, lh) = size()
            (dd.value(lens) * tab_w() + panel(lens) + (tab_w() - lw) / 2.0, (tab_lens_h - lh) / 2.0)
          }))
          .shadow(view::Live::By(fn() {
            let (s, dy, ink) = shadow_default
            (s, dy, alpha(ink, dd.pressed(lens)))
          }))
        let _ = lens.box(fn(pill) {
          let _ = pill
            .over(view::Live::Is(true))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .ground(view::Live::By(fn() { colors().lens_idle }))
            .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(pill), 0.0, 1.0) }))
        })
        let _ = lens.box(fn(gl) {
          let _ = gl
            .over(view::Live::Is(true))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .glass(view::Live::By(fn() { Some(tab_lens_glass(dd.pressed(gl))) }))
            .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
        })
        let stopped = fn() -> Unit {
          let to = clamp(dd.target().round(), 0.0, last)
          let i = to.to_int()
          current.v = i
          dd.animate_to(to)
          if i != selected() {
            select(i)
          }
          pulled_by.v = 0.0
          pulled.go(lens, 0.0, motion::spring(ratio=1.0, stiffness=300.0, threshold=0.5))
          ih.up()
        }
        let _ = lens.gesture(
          ui::touch_slop(),
          press=fn(d) {
            last_x.v = d.wx
            ih.down(d.x, d.y, w(), tabs_h)
            dd.press()
          },
          tap=fn(_d) { stopped() },
          drag=fn(d) {
            match d.kind {
              view::DragIs::Down => ()
              view::DragIs::Moved => {
                let dx = d.wx - last_x.v
                last_x.v = d.wx
                let tw = tab_w()
                if tw > 0.0 {
                  dd.update_value(clamp(dd.target() + dx / tw, 0.0, last))
                }
                pulled_by.v = pulled_by.v + dx
                pulled.put(pulled_by.v)
              }
              view::DragIs::Up => stopped()
              view::DragIs::Off => stopped()
            }
          },
        )
      })
    })
  }, kind=headless::GroupKind::Tab, made_for=loc)
}
