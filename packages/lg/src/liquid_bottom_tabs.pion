// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidBottomTabs.kt and LiquidBottomTab.kt.

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

fn tabs_glass() -> paint::Glass {
  let d = is_dark()
  paint::Glass::liquid(
    blur=2.1,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=28.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

fn tab_lens_glass(p_in : Double) -> paint::Glass {
  let p = clamp(p_in, 0.0, 1.0)
  let c = colors()
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=alpha(c.container, 1.0 / 0.4),
    saturation=1.0,
    rim=0.6 * p,
    bezel=10.0 * p,
    refraction=14.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
    zoom=1.0 + 0.10 * p,
  )
}

fn ease_out(x : Double) -> Double {
  let f = motion::cubic_bezier(0.0, 0.0, 0.58, 1.0)
  f(x)
}

pub fn liquid_bottom_tab_node(
  g : view::View,
  rg : headless::RadioGroup[Int],
  index : Int,
  label : String,
  content : (view::View, () -> Int64) -> Unit,
  lit : (view::View) -> Double,
  scale : (view::View) -> Double,
  press? : (view::Drag) -> Unit,
  tap? : (view::Drag) -> Unit,
  drag? : (view::Drag) -> Unit,
  loc~ : String = "",
) -> view::View {
  rg.item(loc=loc, g, fn() { index }, fn() { label }, fn(t : view::View, it : headless::RadioItem) -> Unit {
    let _ = t
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .radius(view::Live::Is(tab_lens_h / 2.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
    let _ = t.box(fn(f : view::View) -> Unit {
      let _ = f.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0)).scale(view::Live::By(fn() { scale(f) }))
      content(f, fn() {
        let c = colors()
        lerp_color(c.content, c.accent, clamp(lit(f), 0.0, 1.0))
      })
    })
    let has_g = match press {
      Some(_) => true
      None => match tap {
        Some(_) => true
        None => match drag {
          Some(_) => true
          None => false
        }
      }
    }
    if has_g {
      let _ = t.box(fn(hit : view::View) -> Unit {
        let _ = hit.over(view::Live::Is(true)).gesture(
          ui::touch_slop(),
          press=fn(d : view::Drag) -> Unit { match press { Some(f) => f(d); None => () } },
          tap=fn(d : view::Drag) -> Unit { match tap { Some(f) => f(d); None => () } },
          drag=fn(d : view::Drag) -> Unit { match drag { Some(f) => f(d); None => () } },
        )
      })
    }
    t.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
      let _ = ring.over(view::Live::Is(true)).radius(view::Live::Is(tab_lens_h / 2.0)).edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  })
}

pub fn tab_face(name : String) -> (view::View, () -> Int64) -> Unit {
  fn(f : view::View, ink : () -> Int64) -> Unit {
    flight_icon(f, 28.0, ink)
    let _ = f.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::Is(name), look=words_at(type_tab)).ink(view::Live::By(ink))
    })
  }
}

pub fn liquid_bottom_tabs_node(
  parent : view::View,
  labels : Array[String],
  selected : () -> Int,
  select : (Int) -> Unit,
  label~ : String = "",
  faces? : Array[(view::View, () -> Int64) -> Unit],
  drag? : DampedDrag,
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let count = labels.length()
  let last = if count > 1 { (count - 1).to_double() } else { 0.0 }
  let first = signals::untracked(selected).to_double()
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(first, lo=0.0, hi=last, held_scale=tab_lens_held_scale)
  }
  let ih = match light {
    Some(l) => l
    None => InteractiveHighlight::new()
  }
  let current = ui::ref_new(signals::untracked(selected))
  let pulled = motion::NodeWay::new(0.0)
  let pulled_by = fref(0.0)
  let last_x = fref(0.0)
  headless::radio_group(loc=loc, parent, fn() { label }, selected, select, kind=headless::GroupKind::Tab, fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
    dd.attach(g)
    ih.attach(g)
    let _ = g.height(view::Live::Is(Some(tabs_h))).padding(view::Live::Is((tabs_pad, tabs_pad, tabs_pad, tabs_pad)))
    g.reacts(at_start=false, selected, fn(i : Int) -> Unit {
      if i != current.v {
        current.v = i
        dd.slide_to(i.to_double())
      }
    })
    let _ = g.by_room(fn(inner : view::View, room : view::Room) -> Unit {
      let w = fn() -> Double { room.width() + 2.0 * tabs_pad }
      let tab_w = fn() -> Double { (w() - 2.0 * tabs_pad) / count.to_double() }
      let panel = fn(n : view::View) -> Double {
        let ww = w()
        if ww <= 0.0 {
          return 0.0
        }
        let f = clamp(pulled.shown(n) / ww, -1.0, 1.0)
        let s = if f < 0.0 { -1.0 } else if f > 0.0 { 1.0 } else { 0.0 }
        4.0 * s * ease_out(f.abs())
      }
      let lit = fn(n : view::View, i : Int) -> Double { clamp(1.0 - (dd.value(n) - i.to_double()).abs(), 0.0, 1.0) }
      let grown = fn(n : view::View) -> Double { lerp(1.0, tab_held_scale, dd.pressed(n)) }
      let _ = inner.box(fn(bar : view::View) -> Unit {
        let _ = bar
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(w()) }))
          .height(view::Live::Is(Some(tabs_h)))
          .margin(view::Live::Is((-tabs_pad, -tabs_pad, 0.0, 0.0)))
          .radius(view::Live::Is(tabs_h / 2.0))
          .shadow(view::Live::Is(shadow_default))
          .shadow_outside(view::Live::Is(true))
          .glass(view::Live::By(fn() { Some(tabs_glass()) }))
          .ground_drawn(view::Live::By(fn() {
            let ww = w()
            let s = lerp(1.0, 1.0 + 16.0 / ww, dd.pressed(bar))
            stretched(ww, tabs_h, panel(bar), 0.0, s, s)
          }))
        let _ = bar.box(fn(ov : view::View) -> Unit {
          let _ = ov
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .radius(view::Live::Is(tabs_h / 2.0))
            .ground(view::Live::Is(white))
            .alpha(view::Live::By(fn() { clamp(ih.pressed(ov), 0.0, 1.0) * 0.14 }))
            .ground_drawn(view::Live::By(fn() {
              let ww = w()
              let s = lerp(1.0, 1.0 + 16.0 / ww, dd.pressed(ov))
              stretched(ww, tabs_h, panel(ov), 0.0, s, s)
            }))
        })
      })
      let stopped = fn() -> Unit {
        let to = clamp(dd.target().round(), 0.0, last)
        let i = to.to_int()
        current.v = i
        dd.animate_to(to)
        if i != selected() {
          select(i)
        }
        pulled_by.v = 0.0
        pulled.go(g, 0.0, motion::spring(ratio=1.0, stiffness=300.0, threshold=0.5))
        ih.up()
      }
      let on_drag = fn(d : view::Drag) -> Unit {
        match d.kind {
          Down => {
            let dx = d.wx - last_x.v
            last_x.v = d.wx
            let tw = tab_w()
            if tw > 0.0 {
              dd.update_value(clamp(dd.target() + dx / tw, 0.0, last))
            }
            pulled_by.v = pulled_by.v + dx
            pulled.put(pulled_by.v)
          }
          Moved => {
            let dx = d.wx - last_x.v
            last_x.v = d.wx
            let tw = tab_w()
            if tw > 0.0 {
              dd.update_value(clamp(dd.target() + dx / tw, 0.0, last))
            }
            pulled_by.v = pulled_by.v + dx
            pulled.put(pulled_by.v)
          }
          Up => stopped()
          Off => stopped()
        }
      }
      let _ = inner.box(fn(row : view::View) -> Unit {
        let _ = row.row(view::Live::Is(true)).height(view::Live::Is(Some(tab_lens_h))).offset(view::Live::By(fn() { (panel(row), 0.0) }))
        let mut i = 0
        while i < labels.length() {
          let idx = i
          let name = labels[idx]
          let face = match faces {
            Some(fs) => if idx < fs.length() { fs[idx] } else { tab_face(name) }
            None => tab_face(name)
          }
          let hit = idx.to_double()
          let _ = liquid_bottom_tab_node(
            row,
            rg,
            idx,
            name,
            face,
            fn(n : view::View) -> Double {
              let l = lit(n, idx)
              if n.glass_solid() {
                l
              } else {
                l * (1.0 - clamp(dd.pressed(n) / 0.25, 0.0, 1.0))
              }
            },
            grown,
            press=fn(d : view::Drag) -> Unit {
              last_x.v = d.wx
              pulled_by.v = 0.0
              ih.down(hit * tab_w() + d.x + tabs_pad, d.y + tabs_pad, w(), tabs_h)
              dd.press()
              if (hit - dd.target()).abs() > 0.001 {
                dd.update_value(hit)
              }
            },
            tap=fn(_d : view::Drag) -> Unit { stopped() },
            drag=on_drag,
          )
          i += 1
        }
      })
      let _ = inner.box(fn(lens : view::View) -> Unit {
        let size = fn() -> (Double, Double) {
          let (sx, sy) = dd.jelly(lens, 10.0)
          (tab_w() * sx, tab_lens_h * sy)
        }
        let _ = lens
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(size().0) }))
          .height(view::Live::By(fn() { Some(size().1) }))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .offset(view::Live::By(fn() {
            let (lw, lh) = size()
            (dd.value(lens) * tab_w() + panel(lens) + (tab_w() - lw) / 2.0, (tab_lens_h - lh) / 2.0)
          }))
          .shadow(view::Live::By(fn() {
            let (s, dy, ink) = shadow_default
            (s, dy, alpha(ink, dd.pressed(lens)))
          }))
          .shadow_outside(view::Live::Is(true))
        let _ = lens.box(fn(pill : view::View) -> Unit {
          let _ = pill
            .over(view::Live::Is(true))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .ground(view::Live::By(fn() { colors().lens_idle }))
            .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(pill), 0.0, 1.0) }))
        })
        let _ = lens.box(fn(accent_clip : view::View) -> Unit {
          let _ = accent_clip
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .clips(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(size().0) }))
            .height(view::Live::By(fn() { Some(size().1) }))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .alpha(view::Live::By(fn() {
              if accent_clip.glass_solid() {
                0.0
              } else {
                let p = dd.pressed(accent_clip)
                if p > 0.01 { clamp(p / 0.25, 0.0, 1.0) } else { 0.0 }
              }
            }))
          let _ = accent_clip.box(fn(accent_row : view::View) -> Unit {
            let _ = accent_row
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .row(view::Live::Is(true))
              .width(view::Live::By(fn() { Some(tab_w() * count.to_double()) }))
              .height(view::Live::Is(Some(tab_lens_h)))
              .offset(view::Live::By(fn() {
                let (lw, lh) = size()
                (-(dd.value(accent_row) * tab_w() + (tab_w() - lw) / 2.0), -(tab_lens_h - lh) / 2.0)
              }))
            let mut j = 0
            while j < labels.length() {
              let idx = j
              let name = labels[idx]
              let face = match faces {
                Some(fs) => if idx < fs.length() { fs[idx] } else { tab_face(name) }
                None => tab_face(name)
              }
              let _ = accent_row.box(fn(atab : view::View) -> Unit {
                let _ = atab
                  .width(view::Live::By(fn() { Some(tab_w()) }))
                  .height(view::Live::Is(Some(tab_lens_h)))
                  .shrink(view::Live::Is(0.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                let _ = atab.box(fn(af : view::View) -> Unit {
                  let _ = af.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0)).scale(view::Live::By(fn() { grown(af) }))
                  face(af, fn() { colors().accent })
                })
              })
              j += 1
            }
          })
        })
        let _ = lens.box(fn(gl : view::View) -> Unit {
          let _ = gl
            .over(view::Live::Is(true))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .glass(view::Live::By(fn() {
              let p = dd.pressed(gl)
              if p > 0.001 { Some(tab_lens_glass(p)) } else { None }
            }))
            .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
        })
      })
    })
  })
}
