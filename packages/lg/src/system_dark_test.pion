// Regression test: when `lg::set_dark(None)` delegates to system appearance and a
// tree is mounted with `theme=ui_theme`, toggling host `dark_mode` must reactively
// recompute mounted `Live::By` paint colors and `is_dark()` without calling `set_dark`.

import "signals"
import "ui"
import "view"

test "lg_ui_theme_reacts_to_host_system_dark_without_set_dark" {
  set_dark(None)
  let observed_paper : signals::Ref[Int64] = signals::ref_new(0L)
  let observed_dark : signals::Ref[Bool] = signals::ref_new(false)
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(page : view::View) -> Unit {
        let _ = page
          .grow(view::Live::Is(1.0))
          .ground(view::Live::By(fn() {
            let c = colors().paper
            observed_paper.v = c
            observed_dark.v = is_dark()
            c
          }))
      })
    },
    width=400.0,
    height=300.0,
    theme=ui_theme,
    dark=false,
  )

  debug_assert(observed_paper.v == light.paper, "initial mounted paper must be light.paper")
  debug_assert(!observed_dark.v, "initial mounted is_dark() must be false")

  // Flip host system_dark to true without calling lg::set_dark.
  t.fake.dark_mode = true
  t.frame(ms=16.0)
  debug_assert(observed_paper.v == dark.paper, "mounted paper must reactively switch to dark.paper")
  debug_assert(observed_dark.v, "mounted is_dark() must reactively switch to true")

  // Flip host system_dark back to false without calling lg::set_dark.
  t.fake.dark_mode = false
  t.frame(ms=16.0)
  debug_assert(observed_paper.v == light.paper, "mounted paper must reactively switch back to light.paper")
  debug_assert(!observed_dark.v, "mounted is_dark() must reactively switch back to false")

  t.dispose()
  set_dark(None)
}
