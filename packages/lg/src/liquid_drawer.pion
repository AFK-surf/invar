// Liquid Glass Floating Island Side Drawer (`liquid_drawer_node`) over `headless::dialog`.
// Follows Apple iPadOS 26 / iOS 26 floating island sidebar geometry: 10pt outer inset from window edges,
// 28pt concentric outer radius (`12pt + 16pt` inner close/row radius), single-layer dense `lg_drawer_glass()`,
// zero glass-on-glass inside, interactive horizontal drag-to-dismiss with asymptotic rubber-band over-pull,
// and velocity-continuous `motion::move_damped` spring settle.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

/// Which edge of the window a `liquid_drawer_node` floats beside.
#derive(Eq)
pub enum DrawerSide {
  Leading
  Trailing
}

impl signals::Eq for DrawerSide {
  fn eq(self : DrawerSide, other : DrawerSide) -> Bool {
    match (self, other) {
      (DrawerSide::Leading, DrawerSide::Leading) => true
      (DrawerSide::Trailing, DrawerSide::Trailing) => true
      _ => false
    }
  }
}

/// Decorates an existing side-drawer container node `v` in place (zero wrapper nodes) with single-layer
/// `liquid_drawer_glass`, `active` gating (zero hidden glass when inactive), `shadow_outside(Is(true))`,
/// solid-mode hairline fallback, and optional `radius` / `clips`. Returns `v` for chaining.
pub fn liquid_drawer_surface_decorate(
  v : view::View,
  radius? : Double,
  active~ : () -> Bool = fn() { true },
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = fn() { shadow_default },
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r))
    }
    None => ()
  }
  if clips {
    let _ = v.clips(view::Live::Is(true))
  }
  let _ = v
  .glass(
    view::Live::By(fn() {
      if !active() {
        return None
      }
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      Some(liquid_drawer_glass(solid=s))
    }),
  )
  .edge(
    view::Live::By(fn() {
      if active() && (v.glass_solid() || ui::glass_solid()) {
        solid_edge()
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if active() {
        shadow()
      } else {
        shadow_none
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  v
}

/// A Liquid Glass floating island side drawer in `parent`, open while `open()` holds.
/// Supports `Leading` and `Trailing` placement, optional headless free-body mode (`show_header=false`),
/// optional scrim (`scrim=false`), custom `solid` fallback, customizable `inset`/`radius`/`body_pad`,
/// responsive width clamping on narrow windows (`min(width, max(0, window_w - 2 * inset))`),
/// interactive horizontal drag with rubber-band over-pull (max 16pt) and velocity-continuous dismiss
/// (> 32% width or > 0.45 pt/ms), Escape / scrim tap dismissal via `headless::dialog`, and `glass_solid()`
/// 1pt edge fallback.
pub fn liquid_drawer_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  body : (view::View) -> Unit,
  side~ : DrawerSide = DrawerSide::Leading,
  width~ : Double = 320.0,
  subtitle~ : () -> String = fn() { "" },
  footer? : (view::View) -> Unit,
  show_header~ : Bool = true,
  scrim~ : Bool = true,
  solid? : () -> Int64,
  inset~ : Double = ovl_drawer_inset,
  radius~ : Double = ovl_drawer_radius,
  body_pad~ : Double = ovl_drawer_pad,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    let shown_open = ovl_transitioned_bool(h, open)
    let sign = match side {
      DrawerSide::Leading => -1.0
      DrawerSide::Trailing => 1.0
    }
    let eff_w = fn(n : view::View) -> Double {
      let ww = n.window_w()
      if ww > 0.0 {
        let avail = ww - 2.0 * inset
        let max_w = if avail > 0.0 { avail } else { 0.0 }
        if width < max_w { width } else { max_w }
      } else {
        width
      }
    }
    let eff_travel = fn(n : view::View) -> Double {
      let t = eff_w(n) + inset * 2.0
      if t > 1.0 { t } else { 1.0 }
    }
    let init_off_x = sign * (width + inset * 2.0)
    h.show(shown_open, leave=ovl_drawer_leave_ms, fn(s : view::View) -> Unit {
      let slide = motion::NodeWay::new(init_off_x)
      slide.go(s, 0.0, motion::move_damped)
      s.reacts(
        open,
        fn(on : Bool) -> Unit {
          if on {
            slide.go(s, 0.0, motion::move_damped)
          } else {
            slide.go(s, sign * eff_travel(s), motion::move_damped)
          }
        },
        at_start=false,
      )
      let vis = fn(n : view::View) -> Double {
        let dismiss_dist = slide.shown(n) * sign
        clamp(1.0 - dismiss_dist / eff_travel(n), 0.0, 1.0)
      }
      let _ = s
      .over(view::Live::Is(true))
      .points(view::Live::By(open))
      .row(view::Live::Is(true))
      .lies_along(view::Live::Is(match side { DrawerSide::Leading => view::Lies::Start; DrawerSide::Trailing => view::Lies::End }))
      .fills_across(view::Live::Is(true))
      // Optional lightweight scrim whose opacity continuously tracks drawer visibility (0..0.18).
      if scrim {
        let _ = s.box(fn(scrim_box : view::View) -> Unit {
          let _ = scrim_box
          .over(view::Live::Is(true))
          .ground(view::Live::By(fn() { alpha(black, ovl_drawer_scrim_alpha * vis(scrim_box)) }))
        })
      }
      let _ = s.box(fn(room : view::View) -> Unit {
        let _ = room
        .width(view::Live::By(fn() { Some(eff_w(room) + 2.0 * inset) }))
        .max_width(view::Live::By(fn() { Some(eff_w(room) + 2.0 * inset) }), within=true)
        .padding(view::Live::Is((inset, inset, inset, inset)))
        let _ = headless::dialog(
          room,
          title,
          open,
          on_close,
          description=subtitle,
          loc=loc,
          fn(card : view::View, dlg : headless::Dialog) -> Unit {
            let drag_start_wx = ui::ref_new(0.0)
            let drag_start_x = ui::ref_new(0.0)
            let _ = card
            .grow(view::Live::Is(1.0))
            .radius(view::Live::Is(radius))
            .shadow(view::Live::By(glass_overlay_shadow))
            .shadow_outside(view::Live::Is(true))
            .glass(
              view::Live::By(fn() {
                let c = match solid {
                  Some(f) => f()
                  None => clear
                }
                Some(liquid_drawer_glass(solid=c))
              }),
            )
            .edge(view::Live::By(fn() { if card.glass_solid() { liquid_overlay_solid_edge() } else { (0.0, clear) } }))
            .clips(view::Live::Is(true))
            .offset(view::Live::By(fn() { (slide.shown(card), 0.0) }))
            // Full-card gesture container inside `headless::dialog` (avoids outer no-op `on_drag`).
            let _ = card.box(fn(pan : view::View) -> Unit {
              let _ = pan
              .grow(view::Live::Is(1.0))
              .min_height(view::Live::Is(Some(0.0)))
              .gesture(
                ui::touch_slop(),
                press=fn(d : view::Drag) -> Unit {
                  drag_start_wx.v = d.wx
                  drag_start_x.v = slide.value_at(d.at)
                },
                drag=fn(d : view::Drag) -> Unit {
                  match d.kind {
                    Down | Moved => {
                      let raw = drag_start_x.v + (d.wx - drag_start_wx.v)
                      let dismiss_raw = raw * sign
                      let mapped = if dismiss_raw >= 0.0 {
                        dismiss_raw
                      } else {
                        let over_d = -dismiss_raw
                        -(over_d * ovl_drawer_overpull_max / (over_d + ovl_drawer_overpull_max * 2.0))
                      }
                      slide.put(mapped * sign)
                    }
                    Up | Off => {
                      let cur = slide.value_at(d.at)
                      let dismiss_dist = cur * sign
                      let dismiss_vel = d.vx() * sign
                      let cur_w = signals::untracked(fn() { eff_w(card) })
                      let is_up = match d.kind { Up => true; _ => false }
                      let should_close = is_up &&
                      (dismiss_dist > cur_w * ovl_drawer_dismiss_ratio || dismiss_vel > ovl_drawer_dismiss_vel) &&
                      dismiss_vel >= -ovl_drawer_dismiss_vel
                      if should_close {
                        let cur_off_x = sign * signals::untracked(fn() { eff_travel(card) })
                        slide.go(card, cur_off_x, motion::move_damped, velocity=d.vx())
                        dlg.close()
                      } else {
                        slide.go(card, 0.0, motion::move_damped, velocity=d.vx())
                      }
                    }
                  }
                },
              )
              if show_header {
                // Header row: title + optional subtitle + concentric circular close button (12pt inset + 16pt r == 28pt)
                let _ = pan.box(fn(hdr : view::View) -> Unit {
                  let _ = hdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Start)))
                  .lies_along(view::Live::Is(view::Lies::Between))
                  .gap(view::Live::Is(ovl_drawer_pad))
                  .padding(view::Live::Is((ovl_drawer_hdr_pl, ovl_drawer_pad, ovl_drawer_pad, ovl_drawer_pad)))
                  let _ = hdr.box(fn(titles : view::View) -> Unit {
                    let _ = titles.grow(view::Live::Is(1.0)).gap(view::Live::Is(ovl_text_gap)).padding(view::Live::Is((0.0, 2.0, 0.0, 0.0)))
                    let _ = titles.box(fn(w : view::View) -> Unit {
                      let _ = w
                      .words(view::Live::By(title), look=words_at(ovl_type_title, weight=ovl_weight_semibold, wrap=true))
                      .ink(view::Live::By(fn() { colors().content }))
                    })
                    titles.show(fn() { subtitle() != "" }, fn(sub : view::View) -> Unit {
                      let _ = sub
                      .words(view::Live::By(subtitle), look=words_at(ovl_type_sub, wrap=true))
                      .ink(view::Live::By(ovl_muted_ink))
                    })
                  })
                  let _ = headless::button(hdr, fn() { "Close" }, fn(_e) -> Unit { dlg.close() }, loc=loc, fn(btn_v : view::View, btn : headless::Button) -> Unit {
                    let _ = btn_v
                    .width(view::Live::Is(Some(ovl_close_btn_size)))
                    .height(view::Live::Is(Some(ovl_close_btn_size)))
                    .shrink(view::Live::Is(0.0))
                    .radius(view::Live::Is(ovl_close_btn_size / 2.0))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    let hover_t = motion::hover_fade(btn_v, fn() { btn.hovered() })
                    let press_t = motion::hover_fade(btn_v, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
                    let _ = btn_v.ground(view::Live::By(fn() {
                      let base = ovl_close_ground()
                      let h_v = hover_t()
                      let p_v = press_t()
                      let with_h = if h_v > 0.001 { over(base, alpha(ovl_row_hover(), h_v)) } else { base }
                      if p_v > 0.001 { over(with_h, alpha(ovl_row_press(), p_v)) } else { with_h }
                    }))
                    lg_focus_ring(btn_v, fn() { btn.focus_shown() }, ovl_close_btn_size / 2.0)
                    let _ = btn_v.box(fn(ic : view::View) -> Unit {
                      let _ = ic
                      .width(view::Live::Is(Some(ovl_close_icon_size)))
                      .height(view::Live::Is(Some(ovl_close_icon_size)))
                      .shapes(view::Live::By(fn() { ovl_close_shapes(ovl_close_icon_size, colors().content) }))
                    })
                  })
                })
                // Hairline separator below header
                let _ = pan.box(fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
                })
              }
              // Body slot (strictly zero glass-on-glass)
              let _ = pan.box(fn(b : view::View) -> Unit {
                let _ = b
                .grow(view::Live::Is(1.0))
                .min_height(view::Live::Is(Some(0.0)))
                .padding(view::Live::Is((body_pad, body_pad, body_pad, body_pad)))
                body(b)
              })
              // Optional footer slot
              match footer {
                Some(draw_footer) => {
                  let _ = pan.box(fn(f : view::View) -> Unit {
                    let _ = f.box(fn(sep : view::View) -> Unit {
                      let _ = sep.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
                    })
                    let _ = f.box(fn(inner : view::View) -> Unit {
                      let _ = inner.padding(view::Live::Is((ovl_drawer_pad, ovl_drawer_pad, ovl_drawer_pad, ovl_drawer_pad)))
                      draw_footer(inner)
                    })
                  })
                }
                None => ()
              }
            })
          },
        )
      })
    })
  })
}
