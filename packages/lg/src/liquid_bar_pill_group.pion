// Single-layer iOS 26 / macOS 26 floating liquid glass pill container for top bar action button groups
// (ported 1:1 from `monoid` PR #8052 `bar_pill_group_node.mbt`).
// Uses `lg_capsule_glass()` via `lg_apply_glass_surface`, tight outside-only `lg_bar_pill_shadow()` so
// 6pt-spaced neighboring pills never bleed heavy halos onto each other, and `glass_solid()` 1pt edge
// degradation. Inner child buttons must always be flat/ghost (`flat=true, ghost=true`, zero nested glass).

import "ui"
import "view"

/// A single-layer liquid glass pill container in `parent` for a group of top bar controls built by `body`:
/// `height` tall (default `34.0`, full capsule radius `r = height / 2.0 = 17.0`), padded `pad` all around
/// (default `2.0`, strictly concentric with 30pt circular icon buttons or flat capsule buttons `r = 15.0`:
/// `17 - 2 = 15`), children `gap` apart (default `2.0`). Never nest inside another glass surface.
pub fn liquid_bar_pill_group_node(
  parent : view::View,
  body : (view::View) -> Unit,
  height~ : Double = 34.0,
  pad~ : Double = 2.0,
  gap~ : Double = 2.0,
  label~ : () -> String = fn() { "" },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(g : view::View) -> Unit {
    let r = height / 2.0
    let _ = g
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(height)))
    .radius(view::Live::Is(r))
    .padding(view::Live::Is((pad, pad, pad, pad)))
    .gap(view::Live::Is(gap))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .shrink(view::Live::Is(0.0))
    .clips(view::Live::Is(true))
    .edge(view::Live::By(fn() { if g.glass_solid() || ui::glass_solid() { lg_solid_edge() } else { (0.0, clear) } }))
    .says(
      view::Live::By(fn() {
        let l = label()
        if l != "" {
          Some(view::said(view::Role::Group, label=l))
        } else {
          None
        }
      }),
    )
    lg_apply_glass_surface(g, fn() { lg_capsule_glass(adaptive=true) }, shadow_by=lg_bar_pill_shadow)
    body(g)
  })
}
