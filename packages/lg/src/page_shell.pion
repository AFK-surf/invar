// Apple iOS 26/27 & macOS Tahoe full-height scroll-under page shell (`page_shell_node`),
// responsive two-column `NavigationSplitView` (`split_shell_node`), and floating single-layer
// adaptive Liquid Glass message composer (`composer_bar_node`).
//
// Core architectural invariant:
// - The Content Layer uses a single full-height `ui::scroll_box` (100% height) over a clean solid
//   Apple canvas (`surface().canvas` or `surface().grouped_bg`) with automatic top/bottom content
//   insets so scrolled content passes directly underneath floating Liquid Glass top/bottom islands,
//   producing authentic optical refraction and soft progressive scroll-edge blur (`UIScrollEdgeEffect.soft`).

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

/// Full-height Apple scroll-under page shell:
/// - Solid Content Layer background (`surface().canvas`, or `surface().grouped_bg` when `grouped=true`).
/// - Single 100%-height `ui::scroll_box` with automatic top/bottom insets so content never hides at rest
///   yet scrolls directly underneath floating top/bottom glass chrome.
/// - Scroll-edge blur only where bare text sits over content: a full-height `smoothstep` progressive blur
///   (`liquid_scroll_edge_node`, `UIScrollEdgeEffect.soft`) is mounted at the top only when the bar shows a
///   bare center `title` / `subtitle` (override with `top_edge_blur`), and at the bottom only when
///   `bottom_edge_blur=true`. Bars made only of self-contained glass islands (back button, channel pill,
///   `BarPillGroup`, `ComposerBar`, `BottomTabs`) get no veil, so crisp content refracts straight through them.
///   Zero solid top-bar backdrop and zero full-width hairline divider either way.
/// - Floating transparent navigation overlay (`leading`, optional center `title`/`subtitle`, `trailing`)
///   and optional floating `bottom` slot (e.g. `composer_bar_node` or `liquid_bottom_tabs_node`).
pub fn page_shell_node(
  parent : view::View,
  body : (view::View) -> Unit,
  title~ : () -> String = fn() { "" },
  subtitle~ : () -> String = fn() { "" },
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  bottom? : (view::View) -> Unit,
  grouped~ : Bool = false,
  header_height~ : Double = 44.0,
  bottom_height~ : Double = 56.0,
  top_inset? : Double,
  bottom_inset? : Double,
  bottom_inset_by? : () -> Double,
  scroll? : view::Scroll,
  top_edge_blur? : Bool,
  bottom_edge_blur~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let has_leading = match leading {
    Some(_) => true
    None => false
  }
  let has_trailing = match trailing {
    Some(_) => true
    None => false
  }
  let has_bottom = match bottom {
    Some(_) => true
    None => false
  }
  let has_header = fn() -> Bool { has_leading || has_trailing || title() != "" || subtitle() != "" }
  let canvas_bg = fn() -> Int64 { if grouped { surface().grouped_bg } else { surface().canvas } }
  let eff_top_inset = fn() -> Double {
    match top_inset {
      Some(v) => v
      None => if has_header() { header_height + 16.0 } else { 0.0 }
    }
  }
  // `bottom_inset_by` (reactive, e.g. a bottom bar whose height changes) wins over `bottom_inset`.
  let eff_bottom_inset = fn() -> Double {
    match bottom_inset_by {
      Some(f) => f()
      None =>
      match bottom_inset {
        Some(v) => v
        None => if has_bottom { bottom_height + 24.0 } else { 0.0 }
      }
    }
  }
  parent.box(loc=loc, fn(shell : view::View) -> Unit {
    let _ = shell
    .fill()
    .clips(view::Live::Is(true))
    .ground(view::Live::By(canvas_bg))

    // Layer 1: Full-height (100%) scroll viewport so content glides beneath floating glass chrome.
    let _ = match scroll {
      Some(sc) =>
      ui::scroll_box(
        shell,
        fn(content : view::View) -> Unit {
          let _ = content.padding(view::Live::By(fn() { (0.0, eff_top_inset(), 0.0, eff_bottom_inset()) }))
          // `body` gets its own box so its padding / gap never overrides the shell's automatic insets.
          let _ = content.box(fn(inner : view::View) -> Unit {
            let _ = inner.width_share(view::Live::Is(1.0))
            body(inner)
          })
        },
        scroll=sc,
        fill=true,
        loc=loc,
      )
      None =>
      ui::scroll_box(
        shell,
        fn(content : view::View) -> Unit {
          let _ = content.padding(view::Live::By(fn() { (0.0, eff_top_inset(), 0.0, eff_bottom_inset()) }))
          // `body` gets its own box so its padding / gap never overrides the shell's automatic insets.
          let _ = content.box(fn(inner : view::View) -> Unit {
            let _ = inner.width_share(view::Live::Is(1.0))
            body(inner)
          })
        },
        fill=true,
        loc=loc,
      )
    }

    // Layer 2: Soft progressive scroll-edge blur veils (`UIScrollEdgeEffect.soft`), zero hard hairlines.
    // No bare text over content, no blur: glass-island-only bars let content refract through them crisply.
    let top_blur_on = fn() -> Bool {
      match top_edge_blur {
        Some(on) => on
        None => title() != "" || subtitle() != ""
      }
    }
    let top_edge_h = fn(_v : view::View) -> Double { if top_blur_on() { header_height + 22.0 } else { 0.0 } }
    let _ = liquid_scroll_edge_node(
      shell,
      top_edge_h,
      top_edge_h,
      side=ScrollEdgeSide::Top,
      bg=canvas_bg,
      loc=loc,
    )
    let bottom_pad = 12.0
    if has_bottom && bottom_edge_blur {
      let bot_edge_h = fn(_v : view::View) -> Double { bottom_height + 8.0 }
      let _ = liquid_scroll_edge_node(
        shell,
        bot_edge_h,
        bot_edge_h,
        side=ScrollEdgeSide::Bottom,
        bg=canvas_bg,
        loc=loc,
      )
    } else if has_bottom {
      let composer_seam_fade = 18.0
      let _ = shell.box(loc=loc, fn(wrap : view::View) -> Unit {
        let _ = wrap
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .lies_along(view::Live::Is(view::Lies::End))
        let _ = wrap.box(fn(scrim : view::View) -> Unit {
          let _ = scrim
          .width_share(view::Live::Is(1.0))
          .height(view::Live::Is(Some(bottom_pad + 6.0 + composer_seam_fade)))
          .points(view::Live::Is(false))
          .fades(view::Live::Is((0.0, composer_seam_fade, 0.0, 0.0)))
          let _ = scrim.box(fn(fill : view::View) -> Unit {
            let _ = fill
            .width_share(view::Live::Is(1.0))
            .height_share(view::Live::Is(1.0))
            .points(view::Live::Is(false))
            .ground(view::Live::By(canvas_bg))
          })
        })
      })
    }

    // Layer 3: Floating transparent top navigation overlay (hosts glass islands in leading/trailing).
    shell.show(
      has_header,
      fn(top_overlay : view::View) -> Unit {
        let _ = top_overlay
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .padding(view::Live::Is((14.0, 10.0, 14.0, 0.0)))
        let _ = top_overlay.box(fn(bar : view::View) -> Unit {
          let _ = bar
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(header_height)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .gap(view::Live::Is(10.0))
          .points(view::Live::Is(false))

          // Leading slot
          let _ = bar.box(fn(l_slot : view::View) -> Unit {
            let _ = l_slot
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            match leading {
              Some(f) => f(l_slot)
              None => ()
            }
          })

          // Optional center title / subtitle
          bar.show(
            fn() { title() != "" || subtitle() != "" },
            fn(mid : view::View) -> Unit {
              let _ = mid
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .min_width(view::Live::Is(Some(0.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .points(view::Live::Is(false))
              mid.show(
                fn() { title() != "" },
                fn(t_box : view::View) -> Unit {
                  let _ = t_box
                  .words(view::Live::By(title), look=words_at(15.0, weight=600, lines=1))
                  .words_centered(view::Live::Is(true))
                  .ink(view::Live::By(fn() { surface().ink }))
                  .points(view::Live::Is(false))
                },
                at_once=true,
              )
              mid.show(
                fn() { subtitle() != "" },
                fn(s_box : view::View) -> Unit {
                  let _ = s_box
                  .words(view::Live::By(subtitle), look=words_at(11.5, weight=400, lines=1))
                  .words_centered(view::Live::Is(true))
                  .ink(view::Live::By(fn() { surface().ink_secondary }))
                  .points(view::Live::Is(false))
                },
                at_once=true,
              )
            },
            at_once=true,
          )

          // Trailing slot
          let _ = bar.box(fn(r_slot : view::View) -> Unit {
            let _ = r_slot
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(6.0))
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            match trailing {
              Some(f) => f(r_slot)
              None => ()
            }
          })
        })
      },
      at_once=true,
    )

    // Layer 4: Optional floating bottom bar overlay (e.g. ComposerBar / BottomTabs).
    match bottom {
      Some(b_fn) => {
        let _ = shell.box(fn(bot_overlay : view::View) -> Unit {
          let _ = bot_overlay
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .lies_along(view::Live::Is(view::Lies::End))
          .padding(view::Live::Is((14.0, 0.0, 14.0, 12.0)))
          b_fn(bot_overlay)
        })
      }
      None => ()
    }
  })
}

/// Responsive Apple iOS 26/27 & macOS Tahoe two-column `NavigationSplitView`:
/// - Wide viewports (`window_w() >= breakpoint`): fixed-width solid `surface().sidebar` + `0.5pt`
///   `surface().separator` hairline + `.fill()` detail pane.
/// - Narrow viewports (`< breakpoint`): switches seamlessly between full-screen sidebar and full-screen
///   detail view based on `show_detail()`, with zero horizontal crowding or clipping.
pub fn split_shell_node(
  parent : view::View,
  sidebar : (view::View) -> Unit,
  detail : (view::View) -> Unit,
  show_detail~ : () -> Bool = fn() { true },
  breakpoint~ : Double = 760.0,
  sidebar_width~ : Double = 264.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(split : view::View) -> Unit {
    let _ = split.fill().clips(view::Live::Is(true))
    let is_wide = fn() -> Bool {
      let w = split.window_w()
      if w <= 0.0 { true } else { w >= breakpoint }
    }
    // Wide layout: fixed sidebar + 0.5pt hairline + fill detail
    split.show(
      is_wide,
      fn(wide : view::View) -> Unit {
        let _ = wide.fill().row(view::Live::Is(true)).clips(view::Live::Is(true))
        let _ = wide.box(fn(sb : view::View) -> Unit {
          let _ = sb
          .width(view::Live::Is(Some(sidebar_width)))
          .height_share(view::Live::Is(1.0))
          .shrink(view::Live::Is(0.0))
          .min_height(view::Live::Is(Some(0.0)))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() { surface().sidebar }))
          sidebar(sb)
        })
        let _ = wide.box(fn(sep : view::View) -> Unit {
          let _ = sep
          .width(view::Live::Is(Some(hairline_w)))
          .height_share(view::Live::Is(1.0))
          .shrink(view::Live::Is(0.0))
          .ground(view::Live::By(fn() { surface().separator }))
        })
        let _ = wide.box(fn(dt : view::View) -> Unit {
          let _ = dt.fill().clips(view::Live::Is(true))
          detail(dt)
        })
      },
      at_once=true,
    )
    // Narrow layout: full-screen sidebar or full-screen detail controlled by `show_detail()`
    split.show(
      fn() { !is_wide() },
      fn(narrow : view::View) -> Unit {
        let _ = narrow.fill().clips(view::Live::Is(true))
        narrow.show(
          fn() { !show_detail() },
          fn(sb : view::View) -> Unit {
            let _ = sb
            .fill()
            .clips(view::Live::Is(true))
            .ground(view::Live::By(fn() { surface().sidebar }))
            sidebar(sb)
          },
          at_once=true,
        )
        narrow.show(
          show_detail,
          fn(dt : view::View) -> Unit {
            let _ = dt.fill().clips(view::Live::Is(true))
            detail(dt)
          },
          at_once=true,
        )
      },
      at_once=true,
    )
  })
}

/// Flat borderless circular icon button for inside `composer_bar_node` (36pt hit area, zero nested glass).
fn composer_flat_icon_btn(
  parent : view::View,
  kind : IconKind,
  label : String,
  press : () -> Unit,
  loc~ : String = "",
) -> Unit {
  let _ = headless::button(
    loc=loc,
    parent,
    fn() { label },
    fn(_e) -> Unit { press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hover_t = motion::hover_fade(b, fn() { btn.hovered() })
      let press_t = motion::hover_fade(b, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
      let _ = b
      .width(view::Live::Is(Some(36.0)))
      .height(view::Live::Is(Some(36.0)))
      .margin(view::Live::Is((-1.0, -1.0, -1.0, -1.0)))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      let _ = b.box(fn(circle : view::View) -> Unit {
        let _ = circle
        .width(view::Live::Is(Some(32.0)))
        .height(view::Live::Is(Some(32.0)))
        .radius(view::Live::Is(16.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .ground(view::Live::By(fn() {
          let h = hover_t()
          let p = press_t()
          let with_h = if h > 0.001 { alpha(ovl_row_hover(), h) } else { clear }
          if p > 0.001 { over(with_h, alpha(ovl_row_press(), p)) } else { with_h }
        }))
        lg_focus_ring(circle, fn() { btn.focus_shown() }, 16.0)
        let _ = icon_node(circle, kind, size=17.0, ink=fn() { surface().ink_secondary })
      })
    },
  )
}

/// Apple Messages-grade single-layer floating adaptive Liquid Glass message composer capsule:
/// - Outer single-layer adaptive Liquid Glass pill (`min_height=44`, `r=22`, `padding=(6,5,6,5)`, `gap=4`).
/// - Optional flat circular `leading` icon slot (defaults to `+`, plus `Paperclip` if `on_attach` is given).
/// - Borderless transparent `ui::field` (`grow=1.0`, zero nested box-in-box).
/// - `34pt` circular `ArrowUp` send button (36pt hit area; prominent accent when `can_send()` is true).
pub fn composer_bar_node(
  parent : view::View,
  field : ui::Field,
  on_send : () -> Unit,
  placeholder~ : String = "Message",
  placeholder_by? : () -> String,
  can_send? : () -> Bool,
  leading? : (view::View) -> Unit,
  on_plus? : () -> Unit,
  on_attach? : () -> Unit,
  label~ : () -> String = fn() { "Message" },
  loc~ : String = "",
) -> view::View {
  let eff_can_send = match can_send {
    Some(f) => f
    None => fn() -> Bool { field.text().length() > 0 }
  }
  let trigger_send = fn() -> Unit {
    if eff_can_send() {
      on_send()
    }
  }
  parent.box(loc=loc, fn(cap : view::View) -> Unit {
    let _ = cap
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .min_height(view::Live::Is(Some(44.0)))
    .radius(view::Live::Is(22.0))
    .padding(view::Live::Is((6.0, 5.0, 6.0, 5.0)))
    .gap(view::Live::Is(4.0))
    .edge(view::Live::By(fn() { if cap.glass_solid() || ui::glass_solid() { lg_solid_edge() } else { (0.0, clear) } }))
    .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
    lg_apply_glass_surface(cap, fn() { liquid_floating_glass(adaptive=true) }, shadow_by=lg_bar_pill_shadow)

    // Leading flat circular icon slot (zero nested glass)
    match leading {
      Some(l_fn) => {
        let _ = cap.box(fn(l_slot : view::View) -> Unit {
          let _ = l_slot
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(2.0))
          .shrink(view::Live::Is(0.0))
          l_fn(l_slot)
        })
      }
      None => {
        let _ = cap.box(fn(l_slot : view::View) -> Unit {
          let _ = l_slot
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(2.0))
          .shrink(view::Live::Is(0.0))
          let plus_cb = match on_plus {
            Some(f) => f
            None => fn() -> Unit { () }
          }
          composer_flat_icon_btn(l_slot, IconKind::Plus, "Add", plus_cb, loc=loc)
          match on_attach {
            Some(f) => composer_flat_icon_btn(l_slot, IconKind::Paperclip, "Attach", f, loc=loc)
            None => ()
          }
        })
      }
    }

    // Center borderless transparent input field (zero box-in-box): the 44pt wrapper inside the glass takes the press
    // and centers the field's natural-height text, so nothing is drawn or pressed past the capsule.
    cap.reacts(fn() { is_dark() }, fn(_d : Bool) -> Unit {
      field.color = surface().ink
      field.ph_color = surface().ink_tertiary
      field.caret_color = surface().accent
    })
    let _ = cap.box(fn(fwrap : view::View) -> Unit {
      let _ = fwrap
      .grow(view::Live::Is(1.0))
      .basis(view::Live::Is(Some(0.0)))
      .shrink(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(0.0)))
      .min_height(view::Live::Is(Some(44.0)))
      .margin(view::Live::Is((0.0, -5.0, 0.0, -5.0)))
      .clips(view::Live::Is(true))
      .padding(view::Live::Is((4.0, 0.0, 4.0, 0.0)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .on_press(fn() -> Unit { field.focus() })
      let typed = ui::field(
        fwrap,
        field,
        placeholder=placeholder,
        placeholder_by?=placeholder_by,
        font_size=14.5,
        max_lines=4,
        enter_sends=true,
        label=signals::untracked(label),
        submitted=fn(_s : String) -> Unit { trigger_send() },
        color=surface().ink,
        placeholder_color=surface().ink_tertiary,
        caret_color=surface().accent,
      )
      let _ = typed
      .presses(view::Live::Is(false))
      .ink(view::Live::By(fn() {
        if field.text().length() > 0 || field.composing() {
          surface().ink
        } else {
          surface().ink_tertiary
        }
      }))
    })

    // Trailing 34pt circular ArrowUp send button (36pt hit area via -1pt margin)
    let _ = headless::button(
      loc=loc,
      cap,
      fn() { "Send" },
      fn(_e) -> Unit { trigger_send() },
      disabled=fn() { !eff_can_send() },
      fn(b : view::View, btn : headless::Button) -> Unit {
        let press_t = motion::hover_fade(b, fn() { btn.pressed() && !btn.disabled() }, duration_ms=motion::pointer_tap_ms)
        let _ = b
        .width(view::Live::Is(Some(36.0)))
        .height(view::Live::Is(Some(36.0)))
        .margin(view::Live::Is((-1.0, -1.0, -1.0, -1.0)))
        .shrink(view::Live::Is(0.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        let _ = b.box(fn(circle : view::View) -> Unit {
          let _ = circle
          .width(view::Live::Is(Some(34.0)))
          .height(view::Live::Is(Some(34.0)))
          .radius(view::Live::Is(17.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .scale(view::Live::By(fn() { lerp(1.0, 0.93, press_t()) }), about=view::Pivot::At(0.5, 0.5))
          .ground(view::Live::By(fn() {
            if eff_can_send() {
              prominent_accent_fill(surface().accent)
            } else if is_dark() {
              0xFFFFFF1AL
            } else {
              0x00000012L
            }
          }))
          lg_focus_ring(circle, fn() { btn.focus_shown() }, 17.0)
          let _ = icon_node(
            circle,
            IconKind::ArrowUp,
            size=16.0,
            ink=fn() { if eff_can_send() { white } else { surface().ink_tertiary } },
          )
        })
      },
    )
  })
}
