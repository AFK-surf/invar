// Color swatch single-select grid over headless::radio_group.
// Zero internal Glass::liquid so it composes safely inside liquid_popover_node and toolbars.

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

/// A single color swatch item for `liquid_swatch_grid_node`.
#derive(Eq)
pub struct LiquidSwatch {
  pub color : Int64
  pub label : String
  pub transparent : Bool
}

pub fn LiquidSwatch::new(
  color : Int64,
  label : String,
  transparent~ : Bool = false,
) -> LiquidSwatch {
  LiquidSwatch::{ color, label, transparent }
}

#derive(Eq)
struct SwatchEntry {
  idx : Int
  swatch : LiquidSwatch
}

impl signals::Eq for SwatchEntry {
  fn eq(self : SwatchEntry, other : SwatchEntry) -> Bool {
    self.idx == other.idx &&
    self.swatch.color == other.swatch.color &&
    self.swatch.label == other.swatch.label &&
    self.swatch.transparent == other.swatch.transparent
  }
}

fn swatch_slash_shapes(size : Double, color : Int64) -> Array[paint::Shape] {
  let pad = size * 0.22
  let pts : Array[Double] = [pad, size - pad, size - pad, pad]
  [paint::shape_of([(pts, false)], stroke=color, width=2.0)]
}

fn swatch_transparent_bg() -> Int64 {
  if is_dark() { 0xFFFFFF1EL } else { 0xF5F5F7FFL }
}

fn swatch_transparent_slash() -> Int64 {
  if is_dark() { 0xFF6961FFL } else { 0xE53935FFL }
}

fn swatch_hairline(transparent : Bool) -> Int64 {
  if transparent {
    if is_dark() { 0xFFFFFF38L } else { 0x00000024L }
  } else if is_dark() {
    0xFFFFFF29L
  } else {
    0x0000001CL
  }
}

/// Circular color swatch single-select grid over `headless::radio_group`.
/// Selected swatch shows a strictly concentric 2pt outer ring with a 2pt inner gap.
/// Transparent swatches render a light base with a crisp red diagonal vector slash.
/// Contains zero `Glass::liquid` so it embeds safely inside popovers and toolbars.
pub fn liquid_swatch_grid_node(
  parent : view::View,
  swatches : () -> Array[LiquidSwatch],
  selected : () -> Int,
  on_select : (Int) -> Unit,
  columns~ : Int = 6,
  swatch_size~ : Double = 24.0,
  gap~ : Double = 8.0,
  label~ : () -> String = fn() { "Color Swatches" },
  loc~ : String = "",
) -> view::View {
  let cols = if columns > 0 { columns } else { 1 }
  let r = swatch_size / 2.0
  let ring_outset = 4.0
  let grid_w = cols.to_double() * swatch_size + (cols - 1).to_double() * gap + ring_outset * 2.0 + 0.5
  headless::radio_group(
    loc=loc,
    parent,
    label,
    selected,
    on_select,
    kind=headless::GroupKind::Radio,
    axis=headless::GroupAxis::Horizontal,
    fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
      let _ = g
      .row(view::Live::Is(true))
      .wraps(view::Live::Is(Some(gap)))
      .gap(view::Live::Is(gap))
      .width(view::Live::Is(Some(grid_w)))
      .padding(view::Live::Is((ring_outset, ring_outset, ring_outset, ring_outset)))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      g.each(
        fn() -> Array[SwatchEntry] {
          let list = swatches()
          let out : Array[SwatchEntry] = []
          let mut i = 0
          while i < list.length() {
            out.push(SwatchEntry::{ idx: i, swatch: list[i] })
            i += 1
          }
          out
        },
        fn(e : SwatchEntry) -> Int { e.idx },
        fn(slot : view::View, entry_sig : signals::Signal[SwatchEntry]) -> Unit {
          let _ = rg.item(
            loc=loc,
            slot,
            fn() { entry_sig.get().idx },
            fn() { entry_sig.get().swatch.label },
            in_node=true,
            fn(cell : view::View, it : headless::RadioItem) -> Unit {
              let hover_way = motion::NodeWay::new(0.0)
              let press_way = motion::NodeWay::new(0.0)
              cell.reacts(at_start=false, fn() { !it.disabled() && it.hovered() }, fn(on : Bool) -> Unit {
                hover_way.go(cell, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
              })
              cell.reacts(at_start=false, fn() { !it.disabled() && it.pressed() }, fn(on : Bool) -> Unit {
                press_way.go(cell, if on { 1.0 } else { 0.0 }, motion::backdrop_press_spring)
              })
              let _ = cell
              .width(view::Live::Is(Some(swatch_size)))
              .height(view::Live::Is(Some(swatch_size)))
              .shrink(view::Live::Is(0.0))
              .radius(view::Live::Is(r))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .ground(view::Live::By(fn() {
                let sw = entry_sig.get().swatch
                if sw.transparent { swatch_transparent_bg() } else { sw.color }
              }))
              .edge(view::Live::By(fn() { (1.0, swatch_hairline(entry_sig.get().swatch.transparent)) }))
              .scale(
                view::Live::By(fn() {
                  if ui::reduced_motion() {
                    1.0
                  } else {
                    let h = clamp(hover_way.shown(cell), 0.0, 1.0)
                    let p = clamp(press_way.shown(cell), 0.0, 1.0)
                    1.0 + 0.06 * h - 0.10 * p
                  }
                }),
                about=view::Pivot::At(0.5, 0.5),
              )
              cell.show(
                fn() { entry_sig.get().swatch.transparent },
                fn(sl : view::View) -> Unit {
                  let _ = sl
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .width(view::Live::Is(Some(swatch_size)))
                  .height(view::Live::Is(Some(swatch_size)))
                  .shapes(view::Live::By(fn() { swatch_slash_shapes(swatch_size, swatch_transparent_slash()) }))
                },
                at_once=true,
              )
              cell.show(
                fn() { it.chosen() },
                fn(ring : view::View) -> Unit {
                  let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .margin(view::Live::Is((-ring_outset, -ring_outset, -ring_outset, -ring_outset)))
                  .radius(view::Live::Is(r + ring_outset))
                  .edge(view::Live::By(fn() { (2.0, colors().accent) }))
                },
                at_once=true,
              )
              lg_focus_ring(cell, fn() { it.focus_shown() }, r + 1.0)
            },
          )
        },
        at_once=true,
      )
    },
  )
}
