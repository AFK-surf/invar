// Tests for calibrated control glass recipes, GPU spot touch highlights, pill/button group press
// forwarding, discrete stops slider with live preview & value bubble, zero-relayout lazy-lens
// toggle, segmented custom render_item, practical input params, and glass_control_shadow.

import "headless"
import "signals"
import "ui"
import "view"

fn kit_has_active_liquid_spot(t : ui::Tester) -> Bool {
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 14 && a[5] == 6.0 && (a[14] > 0.0 || a[14] < -1.0) {
      return true
    }
    i += 1
  }
  false
}

fn kit_has_solid_hairline_edge(t : ui::Tester, expected_edge : (Double, Int64)) -> Bool {
  let ch = fn(v : Double) -> Int64 { (v * 255.0).round().to_int64() }
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 15 && a[5] == 0.0 && (a[6] - expected_edge.0).abs() < 0.01 {
      let c = (ch(a[12]) << 24) | (ch(a[13]) << 16) | (ch(a[14]) << 8) | ch(a[15])
      if c == expected_edge.1 {
        return true
      }
    }
    i += 1
  }
  false
}

fn kit_sample_icon(parent : view::View, side : Double, ink : () -> Int64) -> Unit {
  let _ = parent.box(fn(ic : view::View) -> Unit {
    let _ = ic
    .width(view::Live::Is(Some(side)))
    .height(view::Live::Is(Some(side)))
    .shrink(view::Live::Is(0.0))
    .shapes(view::Live::By(fn() { ctrl_plus_shapes(side, ink()) }))
  })
}

fn kit_spot_matches(a : Option[(Double, Double)], x : Double, y : Double) -> Bool {
  match a {
    Some((ax, ay)) => (ax - x).abs() < 1.0e-9 && (ay - y).abs() < 1.0e-9
    None => false
  }
}

test "lg_glass_control_shadow_light_and_dark" {
  set_dark(Some(false))
  let light_sh = glass_control_shadow()
  debug_assert((light_sh.0 - 5.0).abs() < 1.0e-9, "light glass_control_shadow blur must be 5.0")
  debug_assert((light_sh.1 - 2.0).abs() < 1.0e-9, "light glass_control_shadow dy must be 2.0")
  debug_assert(light_sh.2 == 0x00000010L, "light glass_control_shadow color must be 0x00000010L")

  set_dark(Some(true))
  let dark_sh = glass_control_shadow()
  debug_assert((dark_sh.0 - 6.0).abs() < 1.0e-9, "dark glass_control_shadow blur must be 6.0")
  debug_assert((dark_sh.1 - 2.0).abs() < 1.0e-9, "dark glass_control_shadow dy must be 2.0")
  debug_assert(dark_sh.2 == 0x00000038L, "dark glass_control_shadow color must be 0x00000038L")

  set_dark(Some(false))
}

test "lg_calibrated_optical_recipes_spot_sharing_zoom_press_ink" {
  let near = fn(a : Double, b : Double) -> Bool { (a - b).abs() < 1.0e-9 }
  let modes = [false, true]
  for dark in modes {
    set_dark(Some(dark))
    let sp = (18.0, 20.0)
    let ctrl = liquid_control_glass(spot=sp, sharing=true)
    let pill = liquid_bar_pill_glass(spot=sp)
    let flt = liquid_floating_glass(spot=sp, sharing=true)
    let tab = liquid_tab_bar_glass(spot=sp, merge=12.0)
    let vclr = liquid_viewer_clear_glass(spot=sp)
    let vdrk = liquid_viewer_dark_glass(spot=sp)
    let lens = liquid_tab_lens_glass(1.0)
    let ink = liquid_press_ink()
    let edge = liquid_solid_edge()
    debug_assert(kit_spot_matches(ctrl.spot, 18.0, 20.0) && ctrl.shares_capture && near(ctrl.chroma, 0.06), "control glass spot, sharing, chroma")
    debug_assert(
      kit_spot_matches(pill.spot, 18.0, 20.0) && pill.shares_capture && !pill.adaptive && near(pill.blur, 2.0) && near(pill.bezel, 14.0) && near(pill.chroma, 0.06),
      "bar pill glass recipe",
    )
    debug_assert(
      kit_spot_matches(flt.spot, 18.0, 20.0) && flt.adaptive && flt.shares_capture && near(flt.blur, 2.2) && near(flt.refraction, 28.0) && near(flt.chroma, 0.06),
      "floating glass recipe",
    )
    debug_assert(
      kit_spot_matches(tab.spot, 18.0, 20.0) && !tab.adaptive && near(tab.blur, 2.2) && near(tab.merge, 12.0) && near(tab.refraction, 28.0) && near(tab.chroma, 0.06),
      "tab bar glass recipe",
    )
    debug_assert(
      kit_spot_matches(vclr.spot, 18.0, 20.0) && near(vclr.blur, 4.0) && near(vclr.saturation, 0.55),
      "viewer clear glass recipe",
    )
    debug_assert(
      kit_spot_matches(vdrk.spot, 18.0, 20.0) && near(vdrk.blur, 4.0) && vdrk.solid == 0x161618FFL,
      "viewer dark glass recipe",
    )
    debug_assert(
      near(lens.zoom, 1.0) && near(lens.bezel, 14.0) && near(lens.refraction, 9.0) && near(lens.chroma, 0.0) && near(lens.rim, 1.0),
      "tab lens glass recipe",
    )
    debug_assert(near(edge.0, 0.5), "solid hairline edge width must be 0.5")
    debug_assert(
      if dark { ink == 0xFFFFFF38L } else { ink == 0xFFFFFF4CL },
      "luminous GPU press ink must adapt to theme",
    )
  }
  set_dark(Some(false))
}

test "lg_adaptive_tab_bar_glass_recipe" {
  let near = fn(a : Double, b : Double) -> Bool { (a - b).abs() < 1.0e-9 }
  let modes = [false, true]
  for dark in modes {
    set_dark(Some(dark))
    let sp = (18.0, 20.0)
    let tab_ad = liquid_tab_bar_glass(spot=sp, merge=12.0, adaptive=true)
    debug_assert(kit_spot_matches(tab_ad.spot, 18.0, 20.0) && tab_ad.adaptive && near(tab_ad.chroma, 0.06), "adaptive tab bar glass recipe")
  }
  set_dark(Some(false))
}

test "lg_prominent_glass_recipe" {
  let near = fn(a : Double, b : Double) -> Bool { (a - b).abs() < 1.0e-9 }
  set_dark(Some(false))
  let sp = (18.0, 20.0)
  let prom_l = liquid_prominent_glass(accent=colors().accent, spot=sp, sharing=true)
  debug_assert(
    kit_spot_matches(prom_l.spot, 18.0, 20.0) && prom_l.shares_capture && !prom_l.adaptive && near(prom_l.blur, 2.0) && near(prom_l.saturation, 1.15) && near(prom_l.rim, 0.72) && near(prom_l.bezel, 16.0) && near(prom_l.refraction, 22.0) && near(prom_l.chroma, 0.06),
    "prominent glass light recipe",
  )
  set_dark(Some(true))
  let prom_d = liquid_prominent_glass(accent=colors().accent, spot=sp, sharing=true)
  debug_assert(
    kit_spot_matches(prom_d.spot, 18.0, 20.0) && prom_d.shares_capture && !prom_d.adaptive && near(prom_d.blur, 2.0) && near(prom_d.saturation, 1.15) && near(prom_d.rim, 0.72) && near(prom_d.bezel, 16.0) && near(prom_d.refraction, 22.0) && near(prom_d.chroma, 0.06),
    "prominent glass dark recipe",
  )
  set_dark(Some(false))
}

test "lg_solid_press_ink_recipe" {
  let modes = [false, true]
  for dark in modes {
    set_dark(Some(dark))
    let solid_ink = liquid_press_ink(solid=true)
    debug_assert(
      if dark { solid_ink == 0xFFFFFF38L } else { solid_ink == 0x00000018L },
      "solid fallback press ink must adapt to theme",
    )
  }
  set_dark(Some(false))
}

test "lg_button_and_icon_button_gpu_spot_and_solid_fallback" {
  ui::set_glass_solid(None)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(r : view::View) -> Unit {
      let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = liquid_button_node(r, fn() { "Compact" }, fn() -> Unit { () }, height=32.0, px=12.0, sharing=true)
      let _ = liquid_icon_button_node(
        r,
        fn() { "Orb" },
        fn(v : view::View, ink : () -> Int64) -> Unit { kit_sample_icon(v, 18.0, ink) },
        fn() -> Unit { () },
        side=34.0,
        sharing=true,
      )
    })
  })
  assert_no_nested_glass(t, label="buttons at rest")
  let btn_d = require_drawn(t, "Compact", view::Role::Button)
  let ico_d = require_drawn(t, "Orb", view::Role::Button)
  let rest_spot = kit_has_active_liquid_spot(t)
  // Press button -> GPU spot becomes active
  t.press_at(btn_d.x + 16.0, btn_d.y + btn_d.h / 2.0)
  t.run_for(120.0)
  let btn_spot = kit_has_active_liquid_spot(t)
  t.release(btn_d.x + 16.0, btn_d.y + btn_d.h / 2.0)
  t.run_for(springs_out)
  // Press icon button -> GPU spot becomes active
  t.press_at(ico_d.x + ico_d.w / 2.0, ico_d.y + ico_d.h / 2.0)
  t.run_for(120.0)
  let ico_spot = kit_has_active_liquid_spot(t)
  t.release(ico_d.x + ico_d.w / 2.0, ico_d.y + ico_d.h / 2.0)
  t.run_for(springs_out)
  let released_spot = kit_has_active_liquid_spot(t)
  // Solid-glass fallback shows adaptive hairline edge with 0 liquid glass instances
  ui::set_glass_solid(Some(true))
  t.frame()
  let solid_liquid = count_liquid_glass(t)
  let solid_edge = kit_has_solid_hairline_edge(t, liquid_solid_edge())
  ui::set_glass_solid(None)
  debug_assert((btn_d.h - 36.0).abs() < 0.01, "button hit height must reach 36pt")
  debug_assert((ico_d.w - 36.0).abs() < 0.01 && (ico_d.h - 36.0).abs() < 0.01, "icon button hit target must reach 36x36pt")
  debug_assert(!rest_spot, "rest state must have no active GPU spot")
  debug_assert(btn_spot, "pressed button must activate GPU spot")
  debug_assert(ico_spot, "pressed icon button must activate GPU spot")
  debug_assert(!released_spot, "released controls must clear GPU spot")
  debug_assert(solid_liquid == 0, "solid fallback must emit 0 liquid glass instances")
  debug_assert(solid_edge, "solid fallback must render hairline edge")
  t.dispose()
}

test "lg_pill_group_and_button_group_outer_spot_and_spring_scale" {
  ui::set_glass_solid(None)
  let modes = [false, true]
  for dark in modes {
    let pill_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
    let t = lg_case(
      fn(p : view::View) -> Unit {
        let _ = p.box(fn(r : view::View) -> Unit {
          let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let g = liquid_pill_group_node(r, fn(pg : view::View) -> Unit {
            let _ = headless::button(pg, fn() { "Bell" }, fn(_e) -> Unit { () }, fn(b : view::View, _btn : headless::Button) -> Unit {
              let _ = b
              .width(view::Live::Is(Some(34.0)))
              .height(view::Live::Is(Some(34.0)))
              .radius(view::Live::Is(17.0))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              bind_pill_press(b)
              kit_sample_icon(b, 18.0, fn() { colors().content })
            })
          }, height=40.0, pad=3.0, gap=2.0)
          pill_ref.v = Some(g)
          let _ = liquid_button_group_node(r, fn() {
            [
              LiquidGroupAction::new(label=fn() { "Edit" }, icon=fn(v, ink) { kit_sample_icon(v, 18.0, ink) }, press=fn() -> Unit { () }),
              LiquidGroupAction::new(label=fn() { "Share" }, icon=fn(v, ink) { kit_sample_icon(v, 18.0, ink) }, press=fn() -> Unit { () }),
            ]
          })
        })
      },
      dark=dark,
    )
    assert_no_nested_glass(t, label="pill group and button group")
    let pill = match pill_ref.v {
      Some(v) => v
      None => {
        debug_assert(false, "pill group view must be captured")
        t.dispose()
        return
      }
    }
    let pscope = match pill.lent(pill_press_lent) {
      Some(s) => s
      None => {
        debug_assert(false, "pill group must lend PillPressScope")
        t.dispose()
        return
      }
    }
    let bell_d = require_drawn(t, "Bell", view::Role::Button)
    let bx = bell_d.x + bell_d.w / 2.0
    let by = bell_d.y + bell_d.h / 2.0
    t.press_at(bx, by)
    t.run_for(120.0)
    let has_scope_spot = match pscope.spot.untracked() {
      Some(_) => true
      None => false
    }
    let pill_spot = kit_has_active_liquid_spot(t)
    let pill_scaled = pill.drawn_scale() > 1.01
    t.release(bx, by)
    t.run_for(springs_out)
    let scope_cleared = match pscope.spot.untracked() {
      None => true
      Some(_) => false
    }
    let pill_restored = (pill.drawn_scale() - 1.0).abs() < 0.002
    let edit_d = require_drawn(t, "Edit", view::Role::Button)
    let ex = edit_d.x + edit_d.w / 2.0
    let ey = edit_d.y + edit_d.h / 2.0
    t.press_at(ex, ey)
    t.run_for(120.0)
    let group_spot = kit_has_active_liquid_spot(t)
    t.release(ex, ey)
    t.run_for(springs_out)
    debug_assert(has_scope_spot, "pill group scope spot must be set while child pressed")
    debug_assert(pill_spot, "pill group must emit active GPU spot while child pressed")
    debug_assert(pill_scaled, "pill group must spring-scale > 1.01 while child pressed")
    debug_assert(scope_cleared, "pill group scope spot must clear on release")
    debug_assert(pill_restored, "pill group scale must settle back to 1.0")
    debug_assert(group_spot, "button group must emit active GPU spot while child pressed")
    t.dispose()
  }
}

test "lg_toggle_zero_relayout_lazy_lens_custom_size_and_solid_guard" {
  ui::set_glass_solid(None)
  let on = signals::signal(false)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_toggle_node(
      p,
      fn() { on.get() },
      fn(v : Bool) -> Unit { on.set(v) },
      fn() { "Compact Toggle" },
      width=52.0,
      height=24.0,
      track_color=fn() { 0x60606844L },
      on_color=fn() { 0x0088FFFFL },
    )
  })
  let rest_glass = t.drawn_glass().length()
  let tr = require_drawn(t, "Compact Toggle", view::Role::Switch)
  let tree = match ui::view_tree() {
    Some(vt) => vt
    None => {
      debug_assert(false, "view_tree must be active")
      t.dispose()
      return
    }
  }
  t.press_at(tr.x + 14.0, tr.y + tr.h / 2.0)
  t.run_for(a_frame)
  let short_press_glass = t.drawn_glass().length()
  debug_assert(short_press_glass == 0, "short mouse press on toggle must not pop touch loupe")
  t.run_for(200.0)
  let held_glass = t.drawn_glass().length()
  let laid0 = tree.work().laid
  let mut i = 1
  while i <= 10 {
    t.move_to(tr.x + 14.0 + i.to_double() * 2.0, tr.y + tr.h / 2.0)
    t.run_for(a_frame)
    i += 1
  }
  t.release(tr.x + 34.0, tr.y + tr.h / 2.0)
  let mut j = 0
  while j < 12 {
    t.run_for(a_frame)
    j += 1
  }
  let laid_delta = tree.work().laid - laid0
  t.run_for(springs_out)
  let dragged_on = on.get()
  let settled_glass = t.drawn_glass().length()
  // Solid guard prevents glass lens even while held
  ui::set_glass_solid(Some(true))
  t.press_at(tr.x + 34.0, tr.y + tr.h / 2.0)
  t.run_for(120.0)
  let solid_held_glass = t.drawn_glass().length()
  t.release(tr.x + 34.0, tr.y + tr.h / 2.0)
  ui::set_glass_solid(None)
  t.run_for(springs_out)
  debug_assert((tr.w - 52.0).abs() < 0.01 && tr.h >= 36.0, "custom toggle width must be 52 with >= 36pt hit height")
  debug_assert(rest_glass == 0, "idle toggle must emit 0 glass instances")
  debug_assert(held_glass == 1, "held toggle must mount 1 lens glass instance")
  debug_assert(laid_delta == 0, "toggle drag and settle must trigger 0 Flex layouts")
  debug_assert(dragged_on, "dragging toggle right must turn it on")
  debug_assert(settled_glass == 0, "settled toggle must emit 0 glass instances")
  debug_assert(solid_held_glass == 0, "solid guard must prevent glass lens while held")
  debug_assert(!on.get(), "tapping on toggle must turn it off")
  t.dispose()
}

test "lg_slider_stops_snap_live_preview_thumb_label_value_bubble" {
  ui::set_glass_solid(None)
  let cur = signals::signal(0.0)
  let names = ["Low", "Medium", "High", "Max"]
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(b : view::View) -> Unit {
      let _ = b.width(view::Live::Is(Some(320.0)))
      let _ = liquid_slider_node(
        b,
        fn() { cur.get() },
        fn(v : Double) -> Unit { cur.set(v) },
        fn() { "Effort" },
        least=0.0,
        most=3.0,
        stops=4,
        thumb_label=fn(v : Double) -> String { names[clamp(v.round(), 0.0, 3.0).to_int()] },
        value_bubble=fn(v : Double) -> String { "\{v.round().to_int()}/3" },
      )
    })
  })
  let rest_glass = t.drawn_glass().length()
  assert_no_nested_glass(t, label="stops slider at rest")
  let sr = require_drawn(t, "Effort", view::Role::Slider)
  let sy = sr.y + sr.h / 2.0
  // Drag from stop 0 toward ~68% (near stop 2 = "High") and check live preview BEFORE release
  t.press_at(sr.x + 12.0, sy)
  t.run_for(a_frame)
  t.move_to(sr.x + sr.w * 0.68, sy)
  t.run_for(a_frame)
  let held_glass = t.drawn_glass().length()
  let has_high = match t.find("High") {
    Some(_) => true
    None => false
  }
  let has_bubble = match t.find("2/3") {
    Some(_) => true
    None => false
  }
  let before_release_val = cur.get()
  t.release(sr.x + sr.w * 0.68, sy)
  t.run_for(springs_out)
  let snapped = cur.get()
  let after_glass = t.drawn_glass().length()
  debug_assert(rest_glass == 0, "slider at rest must emit 0 glass instances")
  debug_assert(held_glass == 1, "held slider must mount 1 lens glass instance")
  debug_assert(has_high, "live thumb_label must preview High before release")
  debug_assert(has_bubble, "live value_bubble must preview 2/3 before release")
  debug_assert((before_release_val - 0.0).abs() < 0.01, "stops slider must not commit before release")
  debug_assert((snapped - 2.0).abs() < 0.01, "stops slider must snap to stop 2 on release")
  debug_assert(after_glass == 0, "settled slider must emit 0 glass instances")
  t.dispose()
}

test "lg_segmented_render_item_and_solid_hairline" {
  ui::set_glass_solid(None)
  let sel = signals::signal(0)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_segmented_node(
      p,
      fn() { ["First", "Second", "Third"] },
      fn() { sel.get() },
      fn(i : Int) -> Unit { sel.set(i) },
      width=240.0,
      render_item=fn(slot : view::View, _idx : Int, is_selected : () -> Bool) -> Unit {
        kit_sample_icon(slot, 18.0, fn() { if is_selected() { colors().accent } else { colors().content } })
      },
    )
  })
  assert_no_nested_glass(t, label="custom render_item segmented")
  let third_d = require_drawn(t, "Third", view::Role::Tab)
  t.tap(third_d.x + third_d.w / 2.0, third_d.y + third_d.h / 2.0)
  t.run_for(springs_out)
  ui::set_glass_solid(Some(true))
  t.frame()
  let solid_edge = kit_has_solid_hairline_edge(t, liquid_solid_edge())
  let solid_glass = t.drawn_glass().length()
  ui::set_glass_solid(None)
  debug_assert(sel.get() == 2, "tapping Third tab must select index 2")
  debug_assert(solid_edge, "segmented control solid fallback must render hairline edge")
  debug_assert(solid_glass == 0, "segmented control solid fallback must emit 0 glass")
  t.dispose()
}

test "lg_inputs_placeholder_by_height_by_leading_on_escape_and_solid_edge" {
  ui::set_glass_solid(None)
  let sf = ui::Field::new()
  let tf = ui::Field::new()
  let hint = signals::signal("Find chats")
  let escaped = ui::ref_new(0)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(b : view::View) -> Unit {
      let _ = b.width(view::Live::Is(Some(360.0))).gap(view::Live::Is(12.0))
      let _ = liquid_search_bar_node(
        b,
        sf,
        placeholder_by=fn() { hint.get() },
        height_by=fn() { 36.0 },
        leading=fn(v : view::View, ink : () -> Int64) -> Unit { kit_sample_icon(v, 16.0, ink) },
        on_escape=fn() -> Unit { escaped.v = escaped.v + 1 },
      )
      let _ = liquid_text_field_node(
        b,
        tf,
        placeholder_by=fn() { hint.get() },
        height_by=fn() { 38.0 },
        label=fn() { "Query" },
      )
    })
  })
  assert_no_nested_glass(t, label="inputs with practical params")
  let field_d = require_drawn(t, "Search", view::Role::TextField)
  t.tap(field_d.x + field_d.w / 2.0, field_d.y + field_d.h / 2.0)
  t.run_for(a_frame)
  t.key(ui::key_escape)
  t.run_for(a_frame)
  ui::set_glass_solid(Some(true))
  t.frame()
  let solid_edge = kit_has_solid_hairline_edge(t, liquid_solid_edge())
  let solid_glass = t.drawn_glass().length()
  ui::set_glass_solid(None)
  debug_assert(escaped.v == 1, "Escape in focused search bar must fire on_escape")
  debug_assert(solid_edge, "inputs solid fallback must render hairline edge")
  debug_assert(solid_glass == 0, "inputs solid fallback must emit 0 glass")
  t.dispose()
}

test "lg_prominent_accent_wcag_aa_and_button_prominent_mode" {
  ui::set_glass_solid(None)
  let modes = [false, true]
  for dark in modes {
    set_dark(Some(dark))
    let card = if dark { 0x1C1C1EFFL } else { 0xFFFFFFFFL }
    let samples : Array[Int64] = [0x0088FFFFL, 0x34C759FFL, 0xFF9F0AFFL, 0xA62908FFL, 0x004EA8FFL]
    debug_assert(prominent_accent_fill(0x0088FFFFL) == 0x0088FFFFL, "default prominent_accent_fill preserves vivid native blue")
    let mut si = 0
    while si < samples.length() {
      let safe = prominent_accent_fill(samples[si], high_contrast=true)
      let solid_cr = ui::contrast_ratio(white, safe)
      let glass_cr = ui::contrast_ratio(white, over(card, alpha(safe, 0.85)))
      debug_assert(solid_cr >= 4.6, "high_contrast prominent_accent_fill must reach >= 4.6:1 solid contrast")
      debug_assert(glass_cr >= 4.6, "high_contrast prominent_accent_fill must reach >= 4.6:1 at 85% alpha over card")
      si += 1
    }
    let clicks = ui::ref_new(0)
    let t = lg_case(
      fn(p : view::View) -> Unit {
        let _ = p.box(fn(r : view::View) -> Unit {
          let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = liquid_button_node(r, fn() { "Primary" }, fn() -> Unit { clicks.v = clicks.v + 1 }, prominent=true)
          let _ = Button(r, label="Deploy", on_press=fn() -> Unit { clicks.v = clicks.v + 1 }, prominent=true)
          let _ = liquid_capsule_node(
            r,
            fn(v : view::View) -> Unit {
              let _ = v.width(view::Live::Is(Some(64.0))).height(view::Live::Is(Some(32.0)))
            },
            tone=LiquidCapsuleTone::Prominent,
          )
        })
      },
      dark=dark,
    )
    assert_no_nested_glass(t, label="prominent buttons and capsule")
    t.assert_rooms(label="prominent buttons")
    let primary_d = require_drawn(t, "Primary", view::Role::Button)
    t.tap(primary_d.x + primary_d.w / 2.0, primary_d.y + primary_d.h / 2.0)
    t.run_for(springs_out)
    debug_assert(clicks.v == 1, "tapping prominent button must fire press callback")
    debug_assert(count_liquid_glass(t) == 3, "prominent buttons and capsule must emit 3 liquid glass surfaces")
    t.dispose()
  }
  set_dark(Some(false))
}

test "lg_segmented_ios26_lens_z_order_lifted_pill_and_zero_relayout" {
  ui::set_glass_solid(None)
  debug_assert((ctrl_seg_held_scale - 1.15).abs() < 1.0e-9, "ctrl_seg_held_scale must be 1.15")
  let modes = [false, true]
  for dark in modes {
    let sel = signals::signal(0)
    let drag = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=ctrl_seg_held_scale)
    let t = lg_case(
      fn(p : view::View) -> Unit {
        let _ = liquid_segmented_node(
          p,
          fn() { ["Day", "Week", "Month"] },
          fn() { sel.get() },
          fn(i : Int) -> Unit { sel.set(i) },
          width=320.0,
          drag=drag,
        )
      },
      dark=dark,
    )
    t.run_shown(springs_out)
    t.assert_rooms(label="liquid_segmented 36pt hit area")
    let expected_idle = if dark { 0x5A5A60FFL } else { 0xFFFFFFFFL }
    debug_assert(ctrl_seg_thumb_idle() == expected_idle, "ctrl_seg_thumb_idle must match iOS 26 lifted fill")
    let day_d = require_drawn(t, "Day", view::Role::Tab)
    let week_d = require_drawn(t, "Week", view::Role::Tab)
    debug_assert((day_d.h - 36.0).abs() < 0.01, "segmented item hit height must reach 36pt")
    let tree = match ui::view_tree() {
      Some(vt) => vt
      None => {
        debug_assert(false, "view_tree must be active")
        t.dispose()
        return
      }
    }
    // Drag across to lift the clear refraction lens and verify Z-order (lens glass instance AFTER text instances) & laid == 0.
    let sx = day_d.x + day_d.w / 2.0
    let sy = day_d.y + day_d.h / 2.0
    t.press_at(sx, sy)
    t.run_for(260.0)
    let before_laid = tree.work().laid
    t.move_to(week_d.x + week_d.w / 2.0, sy)
    t.run_for(120.0)
    let after_laid = tree.work().laid
    let insts = t.drawn_instances()
    let mut last_text_idx = -1
    let mut last_glass_idx = -1
    let mut ii = 0
    while ii < insts.length() {
      let a = insts[ii]
      if a.length() > 5 {
        if a[5] == 1.0 || a[5] == 7.0 {
          last_text_idx = ii
        }
        if a[5] == 6.0 {
          last_glass_idx = ii
        }
      }
      ii += 1
    }
    t.release(week_d.x + week_d.w / 2.0, sy)
    t.run_shown(springs_out)
    debug_assert(after_laid == before_laid, "dragging segmented lens must perform zero relayout (laid == 0)")
    debug_assert(last_text_idx >= 0 && last_glass_idx > last_text_idx, "segmented refraction lens must render AFTER segment labels")
    debug_assert(sel.get() == 1, "releasing segmented drag over Week must select index 1")
    t.dispose()
  }
}

test "lg_slider_ios26_elastic_track_thickening_and_zero_relayout" {
  ui::set_glass_solid(None)
  let sval = signals::signal(40.0)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(w : view::View) -> Unit {
      let _ = w.width(view::Live::Is(Some(240.0)))
      let _ = liquid_slider_node(
        w,
        fn() { sval.get() },
        fn(v : Double) -> Unit { sval.set(v) },
        fn() { "Volume" },
        least=0.0,
        most=100.0,
        track_held_grow=2.0,
      )
    })
  })
  t.run_shown(springs_out)
  let tree = match ui::view_tree() {
    Some(vt) => vt
    None => {
      debug_assert(false, "view_tree must be active")
      t.dispose()
      return
    }
  }
  let max_track_h = fn() -> Double {
    let insts = t.drawn_instances()
    let mut best = 0.0
    let mut i = 0
    while i < insts.length() {
      let a = insts[i]
      // Track is a wide rect (kind == 0, width > 180.0, height <= 12.0)
      if a.length() > 5 && a[5] == 0.0 && a[2] > 180.0 && a[3] <= 12.0 && a[3] > best {
        best = a[3]
      }
      i += 1
    }
    best
  }
  let rest_h = max_track_h()
  let sl_d = require_drawn(t, "Volume", view::Role::Slider)
  let sx = sl_d.x + sl_d.w * 0.4
  let sy = sl_d.y + sl_d.h / 2.0
  t.press_at(sx, sy)
  t.move_to(sx + 40.0, sy)
  let before_laid = tree.work().laid
  t.run_for(200.0)
  let held_h = max_track_h()
  t.move_to(sx + 80.0, sy)
  t.run_for(120.0)
  let after_laid = tree.work().laid
  t.release(sx + 80.0, sy)
  t.run_shown(springs_out)
  let settled_h = max_track_h()
  debug_assert((rest_h - 6.0).abs() < 0.2, "slider track at rest must be 6pt tall")
  debug_assert(held_h > 7.2 && held_h <= 8.5, "slider track must elastically thicken toward 8pt while dragged")
  debug_assert((settled_h - 6.0).abs() < 0.2, "slider track must return to 6pt after release")
  debug_assert(after_laid == before_laid, "slider elastic track thickening must perform zero relayout (laid == 0)")
  t.dispose()
}

test "lg_default_buttons_and_icon_buttons_pass_36pt_room_rules" {
  ui::set_glass_solid(None)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(r : view::View) -> Unit {
      let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = liquid_button_node(r, fn() { "Save" }, fn() -> Unit { () })
      let _ = liquid_icon_button_node(
        r,
        fn() { "Small Icon" },
        fn(v : view::View, ink : () -> Int64) -> Unit { kit_sample_icon(v, 14.0, ink) },
        fn() -> Unit { () },
        size=LiquidButtonSize::Small,
      )
      let _ = liquid_icon_button_node(
        r,
        fn() { "Regular Icon" },
        fn(v : view::View, ink : () -> Int64) -> Unit { kit_sample_icon(v, 16.0, ink) },
        fn() -> Unit { () },
        size=LiquidButtonSize::Regular,
      )
    })
  })
  t.run_shown(springs_out)
  let save_d = require_drawn(t, "Save", view::Role::Button)
  let sm_d = require_drawn(t, "Small Icon", view::Role::Button)
  let reg_d = require_drawn(t, "Regular Icon", view::Role::Button)
  debug_assert((save_d.h - 36.0).abs() < 0.01, "default 30pt button must have 36pt hit height")
  debug_assert((sm_d.w - 36.0).abs() < 0.01 && (sm_d.h - 36.0).abs() < 0.01, "Small icon button must have 36x36pt hit area")
  debug_assert((reg_d.w - 36.0).abs() < 0.01 && (reg_d.h - 36.0).abs() < 0.01, "Regular icon button must have 36x36pt hit area")
  t.assert_rooms(label="default lg buttons and icon buttons")
  assert_no_nested_glass(t, label="default lg buttons and icon buttons")
  t.dispose()
}

test "lg_search_bar_centered_caret_theme_ring_and_apple_ui" {
  ui::set_glass_solid(None)
  let sf = ui::Field::new()
  let sf_tall = ui::Field::new()
  let t = lg_case(
    fn(p : view::View) -> Unit {
      let _ = p.box(fn(col : view::View) -> Unit {
        let _ = col.width(view::Live::Is(Some(320.0))).gap(view::Live::Is(16.0))
        let _ = liquid_search_bar_node(
          col,
          sf,
          placeholder="Filter 35 parts...",
          label=fn() { "Filter" },
        )
        let _ = liquid_search_bar_node(
          col,
          sf_tall,
          placeholder="Tall search...",
          height_by=fn() { 40.0 },
          label=fn() { "Tall Filter" },
        )
      })
    },
    dark=true,
  )
  t.run_shown(springs_out)
  assert_apple_ui(t, label="liquid_search_bar_node")

  let fd = require_drawn(t, "Filter", view::Role::TextField)
  debug_assert(fd.h >= 36.0, "search bar text field hit height must be >= 36.0pt")

  // Locate the 32pt default capsule (kind == 6, h == 32) and 40pt tall capsule (kind == 6, h == 40)
  let find_capsule = fn(target_h : Double) -> (Double, Double, Double, Double) {
    let insts = t.drawn_instances()
    let mut i = 0
    while i < insts.length() {
      let a = insts[i]
      if a.length() > 5 && a[5] == 6.0 && (a[3] - target_h).abs() < 0.5 {
        return (a[0], a[1], a[2], a[3])
      }
      i += 1
    }
    (0.0, 0.0, 0.0, 0.0)
  }
  let (cx, cy, cw, ch) = find_capsule(32.0)
  debug_assert(cw > 200.0 && (ch - 32.0).abs() < 0.5, "default search capsule must be 32pt tall")
  let cap_mid = cy + ch / 2.0

  // Verify placeholder text glyphs are vertically centered inside the 32pt capsule (within 1.0pt)
  let first_glyph_in = fn(bx : Double, by : Double, bw : Double, bh : Double) -> (Bool, Double, Double, Int64) {
    let ch_u8 = fn(v : Double) -> Int64 { (v * 255.0).round().to_int64() }
    let insts = t.drawn_instances()
    let mut i = 0
    while i < insts.length() {
      let a = insts[i]
      if a.length() > 11 && a[5] == 1.0 && a[0] >= bx && a[0] <= bx + bw && a[1] >= by - 4.0 && a[1] <= by + bh + 4.0 {
        let col = (ch_u8(a[8]) << 24) | (ch_u8(a[9]) << 16) | (ch_u8(a[10]) << 8) | ch_u8(a[11])
        return (true, a[1], a[3], col)
      }
      i += 1
    }
    (false, 0.0, 0.0, 0L)
  }
  let (has_g, gy, gh, dark_gcol) = first_glyph_in(cx, cy, cw, ch)
  debug_assert(has_g, "search bar must render placeholder glyphs")
  debug_assert(
    ((gy + gh / 2.0) - cap_mid).abs() <= 1.0,
    "placeholder glyph vertical center (\{gy + gh / 2.0}) must align with 32pt capsule center (\{cap_mid}) within 1.0pt",
  )

  // Focus the 32pt search bar and verify caret aligns with text and stays inside capsule
  t.tap(cx + cw / 2.0, cap_mid)
  t.run_shown(200.0)
  let insts_f = t.drawn_instances()
  let mut has_caret = false
  let mut caret_y = 0.0
  let mut caret_h = 0.0
  let mut ci = 0
  while ci < insts_f.length() {
    let a = insts_f[ci]
    if a.length() > 5 && a[5] == 0.0 && a[2] > 0.5 && a[2] <= 2.5 && a[3] >= 12.0 && a[3] <= 24.0 && a[0] >= cx && a[0] <= cx + cw && a[1] >= cy - 4.0 && a[1] <= cy + ch + 4.0 {
      has_caret = true
      caret_y = a[1]
      caret_h = a[3]
      break
    }
    ci += 1
  }
  debug_assert(has_caret, "focused search bar must draw caret")
  debug_assert(caret_y >= cy && caret_y + caret_h <= cy + ch, "focused caret [\{caret_y}, \{caret_y + caret_h}] must stay inside capsule [\{cy}, \{cy + ch}]")
  debug_assert(
    ((caret_y + caret_h / 2.0) - cap_mid).abs() <= 1.0,
    "focused caret center (\{caret_y + caret_h / 2.0}) must align with capsule center (\{cap_mid})",
  )

  // Dark -> Light theme switch must update field colors and rendered placeholder ink
  set_dark(Some(false))
  t.frame()
  let light_expected_ph = ctrl_placeholder_ink()
  debug_assert(sf.color == colors().content, "theme switch must update field.color")
  debug_assert(sf.ph_color == light_expected_ph, "theme switch must update field.ph_color")
  debug_assert(sf.caret_color == colors().accent, "theme switch must update field.caret_color")
  let (has_gl, _, _, light_gcol) = first_glyph_in(cx, cy, cw, ch)
  debug_assert(has_gl && light_gcol != dark_gcol, "theme switch must update rendered placeholder glyph ink")

  // Focus the 40pt height_by search bar via Tab (keyboard focus ring) and verify ring radius == 23.0pt (20.0 + 3.0).
  // The tap above gave the tree focus to the 32pt bar, so one Tab moves it on to the tall one.
  let (tx, ty, tw, th) = find_capsule(40.0)
  debug_assert(tw > 200.0 && (th - 40.0).abs() < 0.5, "tall search capsule must be 40pt tall")
  t.key(ui::key_tab)
  t.run_shown(200.0)
  let insts_t = t.drawn_instances()
  let mut ring_radius_ok = false
  let mut rings_seen = ""
  let mut ti = 0
  while ti < insts_t.length() {
    let a = insts_t[ti]
    if a.length() > 6 && a[5] == 0.0 && a[6] > 0.5 {
      rings_seen = rings_seen + " (y=\{a[1]} h=\{a[3]} r=\{a[4]} bw=\{a[6]})"
      if (a[1] - ty).abs() < 6.0 && (a[3] - 40.0).abs() < 8.0 && (a[4] - 23.0).abs() < 0.5 {
        ring_radius_ok = true
        break
      }
    }
    ti += 1
  }
  debug_assert(ring_radius_ok, "height_by=40.0 search bar focus ring radius must sync to 23.0pt; ty=\{ty} seen=\{rings_seen}")
  set_dark(Some(false))
  t.dispose()
}

test "lg_droplet_role_unscaled_at_strength_and_accessibility_priority" {
  ui::set_glass_solid(None)
  ui::set_glass_frost(0.0)

  // 1. Recipe at_strength(0.5 / 0.8 / 1.0) preserves slot 7 droplet_role (-16/-32/-48/-64)
  //    while scaling slot 21 (refraction); public Glass::liquid(blur=0, tint=0xFFFFFF00) emits slot 7 == 0.0.
  let recipes : Array[(paint::Glass, Double, Double)] = [
    (lg_clear_lens_glass(1.0, bezel=8.0, refraction=3.0, droplet_role=1), -16.0, 3.0),
    (lg_clear_lens_glass(1.0, bezel=9.0, refraction=9.0, droplet_role=2), -32.0, 9.0),
    (lg_clear_lens_glass(1.0, bezel=9.0, refraction=9.0, chroma=0.04, droplet_role=3), -48.0, 9.0),
    (liquid_tab_lens_glass(1.0), -64.0, 9.0),
    (paint::Glass::liquid(blur=0.0, tint=0xFFFFFF00L, refraction=9.0), 0.0, 9.0),
  ]
  for s in [0.5, 0.8, 1.0] {
    let t = lg_case(fn(p : view::View) -> Unit {
      for item in recipes {
        let g = item.0.at_strength(s)
        let _ = p.box(fn(b : view::View) -> Unit {
          let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(40.0))).glass(view::Live::Is(Some(g)))
        })
      }
    })
    t.frame()
    let sc = t.scene()
    let mut found = 0
    let mut k = 0
    while k < sc.ninst {
      let b = k * 60
      if sc.inst[b + 5].to_int() == 6 {
        let exp_slot7 = recipes[found].1
        let exp_refract = recipes[found].2 * s
        debug_assert((sc.inst[b + 7] - exp_slot7).abs() < 0.001, "droplet_role slot 7 must stay unscaled at strength=\{s}")
        debug_assert((sc.inst[b + 21] - exp_refract).abs() < 0.01, "slot 21 refraction must scale proportionally at strength=\{s}")
        found += 1
      }
      k += 1
    }
    debug_assert(found == 5, "expected all 5 glass instances emitted")
    t.dispose()
  }

  // 2. Real Switch accessibility priority:
  //    frost 0.00009 -> 0.00011 -> 0.5 -> 0.00009 keeps slot 7 == -32.0 (exempt from continuous frost);
  //    discrete more_contrast_now() produces positive frosted blur; glass_solid emits 0 glass instances.
  let sw_on = signals::signal(true)
  let dd = DampedDrag::new(1.0, lo=0.0, hi=1.0, held_scale=thumb_held_scale)
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_toggle_node(p, fn() { sw_on.get() }, fn(v) { sw_on.set(v) }, fn() { "Role Switch" }, drag=dd)
    dd.press()
  })
  t.run_shown(springs_out)
  for fr in [0.00009, 0.00011, 0.5, 0.00009] {
    ui::set_glass_frost(fr)
    t.frame()
    let sc = t.scene()
    let mut sw_slots = 0
    let mut k = 0
    while k < sc.ninst {
      let b = k * 60
      if sc.inst[b + 5].to_int() == 6 {
        debug_assert((sc.inst[b + 7] - (-32.0)).abs() < 0.001, "Switch slot 7 must stay -32.0 under frost=\{fr}")
        sw_slots += 1
      }
      k += 1
    }
    debug_assert(sw_slots == 1, "Switch must emit 1 droplet glass under frost=\{fr}")
  }
  ui::set_glass_frost(0.0)

  // Increase Contrast -> exits crystal droplet mode into frosted high-contrast glass (slot 7 > 0)
  t.fake.increase_contrast_flag = true
  t.frame()
  let sc_hc = t.scene()
  let mut hc_glass = 0
  let mut kh = 0
  while kh < sc_hc.ninst {
    let b = kh * 60
    if sc_hc.inst[b + 5].to_int() == 6 {
      debug_assert(sc_hc.inst[b + 7] > 0.0, "more_contrast_now() must exit crystal droplet mode with positive blur")
      hc_glass += 1
    }
    kh += 1
  }
  debug_assert(hc_glass == 1, "more_contrast_now() must emit high-contrast frosted glass")

  // Reduce Transparency (glass_solid) -> highest priority, 0 glass instances
  ui::set_glass_solid(Some(true))
  t.frame()
  debug_assert(count_liquid_glass(t) == 0, "glass_solid must take priority over more_contrast and emit 0 glass")

  t.fake.increase_contrast_flag = false
  ui::set_glass_solid(None)
  ui::set_glass_frost(0.0)
  t.dispose()

  // 3. Real pressed Slider (-16.0, refract=3.0), Segmented (-48.0, refract=9.0),
  //    and Bottom Tabs (-64.0, refract=9.0) emit their exact droplet_role slot 7 & slot 21 in the final drawlist.
  let assert_droplet_slot = fn(sc : ui::Scene, exp_slot7 : Double, exp_slot21 : Double, label : String) -> Unit {
    let mut found = 0
    let mut k = 0
    while k < sc.ninst {
      let b = k * 60
      if sc.inst[b + 5].to_int() == 6 && sc.inst[b + 7] < 0.0 {
        debug_assert(
          (sc.inst[b + 7] - exp_slot7).abs() < 0.001,
          "\{label} pressed lens slot 7 must be \{exp_slot7} (got \{sc.inst[b + 7]})",
        )
        debug_assert(
          (sc.inst[b + 21] - exp_slot21).abs() < 0.05,
          "\{label} pressed lens slot 21 refraction must be \{exp_slot21} (got \{sc.inst[b + 21]})",
        )
        found += 1
      }
      k += 1
    }
    debug_assert(found == 1, "\{label} pressed must emit exactly 1 droplet lens glass (found \{found})")
  }

  let sl_v = signals::signal(50.0)
  let sl_dd = DampedDrag::new(50.0, lo=0.0, hi=100.0, held_scale=slider_thumb_held_scale)
  let t_sl = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(b : view::View) -> Unit {
      let _ = b.width(view::Live::Is(Some(240.0)))
      let _ = liquid_slider_node(b, fn() { sl_v.get() }, fn(v) { sl_v.set(v) }, fn() { "Role Slider" }, drag=sl_dd)
    })
    sl_dd.press()
  })
  t_sl.run_shown(springs_out)
  assert_droplet_slot(t_sl.scene(), -16.0, 3.0, "Slider")
  t_sl.dispose()

  let seg_i = signals::signal(0)
  let seg_dd = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=ctrl_seg_held_scale)
  let t_seg = lg_case(fn(p : view::View) -> Unit {
    let _ = liquid_segmented_node(
      p,
      fn() { ["One", "Two", "Three"] },
      fn() { seg_i.get() },
      fn(i) { seg_i.set(i) },
      width=240.0,
      drag=seg_dd,
    )
    seg_dd.press()
  })
  t_seg.run_shown(springs_out)
  assert_droplet_slot(t_seg.scene(), -48.0, 9.0, "Segmented")
  t_seg.dispose()

  let tab_i = signals::signal(0)
  let tab_dd = DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=1.16)
  let t_tab = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(b : view::View) -> Unit {
      let _ = b.width(view::Live::Is(Some(300.0)))
      let _ = liquid_bottom_tabs_node(
        b,
        ["Home", "Search", "Profile"],
        fn() { tab_i.get() },
        fn(i) { tab_i.set(i) },
        label="Role Tabs",
        drag=tab_dd,
      )
    })
    tab_dd.press()
  })
  t_tab.run_shown(springs_out)
  assert_droplet_slot(t_tab.scene(), -64.0, 9.0, "BottomTabs")
  t_tab.dispose()
}
