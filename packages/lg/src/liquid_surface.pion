// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/ProgressiveBlurContent.kt,
// AdaptiveLuminanceGlassContent.kt and MagnifierContent.kt. Three surfaces of glass over what a page holds: a band that
// blurs and tints what is under it fading out down its lower half (an alpha mask), a card whose glass follows how light
// what is under it is, and a lens over words that a finger drags.

import "paint"
import "signals"
import "ui"
import "view"

/// GLSL's smoothstep(`e0`, `e1`, `x`).
fn smoothstep(e0 : Double, e1 : Double, x : Double) -> Double {
  if e0 == e1 {
    return if x < e0 { 0.0 } else { 1.0 }
  }
  let t = clamp((x - e0) / (e1 - e0), 0.0, 1.0)
  t * t * (3.0 - 2.0 * t)
}

/// How many bands of glass the progressive blur's mask is drawn in: its lower half's fade, a band a slice, each as seen
/// as the mask is at its middle.
let blur_slices : Int = 16

/// A progressive blur in `parent` (ProgressiveBlurContent): a band 128 high across what holds it, what is under it
/// blurred by 4 with the tint over 80% of it (white, or grey in the dark), whole down its upper half and fading out to
/// nothing at its foot (smoothstep(h, h / 2, y), the catalog's AlphaMask shader); `words` in its middle. The node.
pub fn liquid_progressive_blur_node(
  parent : view::View,
  words~ : () -> String = fn() { "alpha-masked progressive blur" },
  height~ : Double = blur_band_h,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(b) {
    let _ = b.height(view::Live::Is(Some(height))).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    let glass = fn() -> paint::Glass {
      let tint = alpha(colors().blur_tint, blur_band_tint)
      paint::Glass::frosted(blur=blur_band_blur, tint=tint, solid=colors().blur_tint, contained=true)
    }
    let _ = b.box(fn(top) {
      let _ = top.over(view::Live::Is(true)).height(view::Live::Is(Some(height / 2.0))).glass(view::Live::By(fn() { Some(glass()) }))
    })
    let slice = height / 2.0 / blur_slices.to_double()
    let mut k = 0
    while k < blur_slices {
      let y = height / 2.0 + k.to_double() * slice
      let _ = b.box(fn(s) {
        let _ = s
          .over(view::Live::Is(true))
          .height(view::Live::Is(Some(slice)))
          .offset(view::Live::Is((0.0, y)))
          .glass(view::Live::By(fn() { Some(glass()) }))
          .alpha(view::Live::Is(smoothstep(height, height / 2.0, y + slice / 2.0)))
      })
      k += 1
    }
    let _ = b.box(fn(w) {
      let _ = w.words(view::Live::By(words), look=words_at(type_body)).ink(view::Live::By(fn() { colors().content }))
    })
  })
}

/// The glass of an adaptive surface over what is `lum` light (0 black, 1 white), `min_side` its shorter side
/// (flutter_liquid_glass size-responsive blur curve + iOS 27 light/dark adaptive color transfer).
pub fn adaptive_glass(lum : Double, min_side : Double) -> paint::Glass {
  let smooth = fn(t : Double) -> Double {
    let u = clamp(t, 0.0, 1.0)
    u * u * (3.0 - 2.0 * u)
  }
  let blur = 2.1 +
    2.4 * smooth((min_side - 63.0) / 31.0) +
    1.1 * smooth((min_side - 94.0) / 24.0) +
    2.4 * clamp((min_side - 118.0) / 32.0, 0.0, 1.0)
  let is_light = lum > 0.5
  paint::Glass::liquid(
    blur=blur,
    tint=if is_light { 0xFDFCFD67L } else { 0x202020FFL },
    solid=if is_light { white } else { black },
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=min_side / 2.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// An adaptive surface in `parent` (AdaptiveLuminanceGlassContent): a card 160 across, its corners 24, its glass as
/// light as what is under it is (`luminance`, 0-1: what the catalog reads off its backdrop five by five, given here by
/// what draws it), its words saying so in black over what is light, white over what is dark. The node.
pub fn liquid_adaptive_surface_node(
  parent : view::View,
  luminance : () -> Double,
  size~ : Double = adaptive_size,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(c) {
    let _ = c
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(adaptive_radius))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .shadow(view::Live::Is(shadow_default))
      .glass(view::Live::By(fn() { Some(adaptive_glass(luminance(), size)) }))
    let _ = c.box(fn(w) {
      let _ = w
        .words(
          view::Live::By(fn() {
            let hundredths = (clamp(luminance(), 0.0, 1.0) * 100.0).round().to_int()
            let whole = hundredths / 100
            let part = hundredths % 100
            let pad = if part < 10 { "0" } else { "" }
            "luminance:\n\{whole}.\{pad}\{part}"
          }),
          look=words_at(type_body, wrap=true),
        )
        .words_centered(view::Live::Is(true))
        .ink(view::Live::By(fn() { if luminance() > 0.5 { black } else { white } }))
    })
  })
}

/// The magnifier's glass (iOS 27 clear loupe).
fn magnifier_glass() -> paint::Glass {
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=colors().paper,
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=24.0,
    chroma=-0.06,
    merge=0.0,
    adaptive=false,
  )
}

/// A magnifier in `parent` (MagnifierContent): `words` on a page (16, 24 in, its corners 32, the page's paper at 90%,
/// 24 round it), a cursor 4 × 24 in the accent at its middle, and over it a capsule lens 128 × 96 80 above the cursor,
/// both dragged by a finger on the lens, read out a group named `label`. The node.
pub fn liquid_magnifier_node(
  parent : view::View,
  words : () -> String,
  label~ : () -> String = fn() { "Magnifier" },
  at~ : (Double, Double) = (0.0, 0.0),
  loc~ : String = "",
) -> view::View {
  let (ax, ay) = at
  let moved = signals::signal_by((ax, ay), pair_d_eq)
  let last = ui::ref_new((0.0, 0.0))
  parent.box(loc=loc, fn(m) {
    let _ = m.padding(view::Live::Is((page_pad, page_pad, page_pad, page_pad))).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = m.box(fn(page) {
      let _ = page
        .radius(view::Live::Is(page_radius))
        .ground(view::Live::By(fn() { colors().paper }))
        .padding(view::Live::Is((page_pad, page_pad, page_pad, page_pad)))
      let _ = page.box(fn(w) {
        let _ = w.words(view::Live::By(words), look=words_at(type_body, wrap=true)).ink(view::Live::By(fn() { colors().content }))
      })
    })
    let _ = m.box(fn(o) {
      let _ = o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = o.box(fn(cursor) {
        let _ = cursor
          .width(view::Live::Is(Some(cursor_w)))
          .height(view::Live::Is(Some(cursor_h)))
          .radius(view::Live::Is(cursor_w / 2.0))
          .ground(view::Live::By(fn() { colors().accent }))
          .offset(view::Live::By(fn() { moved.get() }))
      })
    })
    let _ = m.box(fn(o) {
      let _ = o.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = o.box(fn(lens) {
        let _ = lens
          .width(view::Live::Is(Some(magnifier_w)))
          .height(view::Live::Is(Some(magnifier_h)))
          .radius(view::Live::Is(magnifier_h / 2.0))
          .shadow(view::Live::Is(shadow_default))
          .glass(view::Live::By(fn() { Some(magnifier_glass()) }))
          .offset(view::Live::By(fn() {
            let (x, y) = moved.get()
            (x, y - magnifier_over)
          }))
          .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
          .gesture(ui::touch_slop(), press=fn(d) { last.v = (d.wx, d.wy) }, drag=fn(d) {
            match d.kind {
              view::DragIs::Down => last.v = (d.wx, d.wy)
              view::DragIs::Moved => {
                let (lx, ly) = last.v
                let (x, y) = moved.untracked()
                moved.set((x + d.wx - lx, y + d.wy - ly))
                last.v = (d.wx, d.wy)
              }
              view::DragIs::Up => ()
              view::DragIs::Off => ()
            }
          })
      })
    })
  })
}
