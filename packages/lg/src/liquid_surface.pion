// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/destinations/ProgressiveBlurContent.kt,
// AdaptiveLuminanceGlassContent.kt and MagnifierContent.kt.

import "paint"
import "signals"
import "ui"
import "view"

fn loupe_pos_eq(a : (Int, Int, Double, Double), b : (Int, Int, Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3
}

/// Which edge of a scroll viewport a `liquid_scroll_edge_node` softens.
#derive(Eq)
pub enum ScrollEdgeSide {
  Top
  Bottom
}

impl signals::Eq for ScrollEdgeSide {
  fn eq(self : ScrollEdgeSide, other : ScrollEdgeSide) -> Bool {
    match (self, other) {
      (ScrollEdgeSide::Top, ScrollEdgeSide::Top) => true
      (ScrollEdgeSide::Bottom, ScrollEdgeSide::Bottom) => true
      _ => false
    }
  }
}

/// Native four-platform progressive variable-blur scroll-edge backdrop (`UIScrollEdgeEffect.soft`,
/// `progressive=true`) anchored to the `Top` or `Bottom` edge of `parent`.
///
/// Blurs and veils scrolled content smoothly over `fade_h` within a `base_h`-tall band, emits zero hidden
/// glass instances when `base_h(fill) <= 0.0`, and when `shield=true` (default) blocks click-through onto
/// scrolled content behind floating top/bottom bars without affecting hover.
pub fn liquid_scroll_edge_node(
  parent : view::View,
  base_h : (view::View) -> Double,
  fade_h : (view::View) -> Double,
  side~ : ScrollEdgeSide = ScrollEdgeSide::Top,
  bg? : () -> Int64,
  shield~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let build_scrim = fn(scrim : view::View) -> Unit {
    let _ = scrim
    .width_share(view::Live::Is(1.0))
    .height(view::Live::By(fn() { Some(base_h(scrim)) }))
    .fades(
      view::Live::By(fn() {
        match side {
          ScrollEdgeSide::Top => (0.0, 0.0, 0.0, fade_h(scrim))
          ScrollEdgeSide::Bottom => (0.0, fade_h(scrim), 0.0, 0.0)
        }
      }),
    )
    let _ = scrim.box(fn(fill : view::View) -> Unit {
      // Register fill in inputs_in via pointed() while keeping points=false when shield=true so Tree::target_at
      // visits fill and applies Node::covers to block click-through onto scrolled content without affecting hover.
      let _ = fill
      .width_share(view::Live::Is(1.0))
      .height_share(view::Live::Is(1.0))
      .glass(
        view::Live::By(fn() {
          if base_h(fill) > 0.0 {
            let color = match bg {
              Some(f) => f()
              None => clear
            }
            Some(liquid_scroll_edge_glass(bg=color))
          } else {
            None
          }
        }),
      )
      .points(view::Live::Is(false))
      if shield {
        let _ = signals::untracked(fn() { fill.pointed() })
      }
    })
  }
  match side {
    ScrollEdgeSide::Top =>
    parent.box(loc=loc, fn(scrim : view::View) -> Unit {
      let _ = scrim.over(view::Live::Is(true))
      build_scrim(scrim)
    })
    ScrollEdgeSide::Bottom =>
    parent.box(loc=loc, fn(wrap : view::View) -> Unit {
      let _ = wrap.over(view::Live::Is(true)).points(view::Live::Is(false)).lies_along(view::Live::Is(view::Lies::End))
      let _ = wrap.box(build_scrim)
    })
  }
}

/// A progressive blur in `parent` (ProgressiveBlurContent).
pub fn liquid_progressive_blur_node(
  parent : view::View,
  words~ : () -> String = fn() { "alpha-masked progressive blur" },
  height~ : Double = blur_band_h,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(b : view::View) -> Unit {
    let _ = b.height(view::Live::Is(Some(height))).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    let glass = fn() -> paint::Glass {
      let tint = alpha(colors().blur_tint, blur_band_tint)
      paint::Glass::frosted(blur=blur_band_blur, tint=tint, solid=colors().blur_tint, contained=false, progressive=true)
    }
    let _ = b.box(fn(mask : view::View) -> Unit {
      let _ = mask.over(view::Live::Is(true)).fades(view::Live::Is((0.0, 0.0, 0.0, height)))
      let _ = mask.box(fn(layer : view::View) -> Unit {
        let _ = layer.over(view::Live::Is(true)).glass(view::Live::By(fn() { Some(glass()) }))
      })
    })
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::By(words), look=words_at(type_body)).ink(view::Live::By(fn() { colors().content }))
    })
  })
}

/// The glass of an adaptive surface over what is `lum` light (0 black, 1 white), `min_side` its shorter side.
pub fn adaptive_glass(lum : Double, min_side : Double) -> paint::Glass {
  let smooth = fn(t : Double) -> Double {
    let u = clamp(t, 0.0, 1.0)
    u * u * (3.0 - 2.0 * u)
  }
  let blur = 2.1 +
  2.4 * smooth((min_side - 63.0) / 31.0) +
  1.1 * smooth((min_side - 94.0) / 24.0) +
  2.4 * clamp((min_side - 118.0) / 32.0, 0.0, 1.0)
  let is_light = lum > 0.5
  paint::Glass::liquid(
    blur=blur,
    tint=if is_light { 0xFDFCFD67L } else { 0x20202067L },
    solid=if is_light { white } else { black },
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=min_side / 2.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// An adaptive surface in `parent` (AdaptiveLuminanceGlassContent).
pub fn liquid_adaptive_surface_node(
  parent : view::View,
  luminance : () -> Double,
  size~ : Double = adaptive_size,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(c : view::View) -> Unit {
    let _ = c
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(adaptive_radius))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .shadow(view::Live::Is(shadow_default))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(adaptive_glass(luminance(), size)) }))
    let _ = c.box(fn(w : view::View) -> Unit {
      let _ = w
      .words(
        view::Live::By(fn() {
          let hundredths = (clamp(luminance(), 0.0, 1.0) * 100.0).round().to_int()
          let whole = hundredths / 100
          let part = hundredths % 100
          let pad = if part < 10 { "0" } else { "" }
          "luminance:\n\{whole}.\{pad}\{part}"
        }),
        look=words_at(type_body, wrap=true),
      )
      .words_centered(view::Live::Is(true))
      .ink(view::Live::By(fn() { if luminance() > 0.5 { black } else { white } }))
    })
  })
}

/// The magnifier's glass (iOS 27 clear loupe over 1.5× zoomed text).
fn magnifier_glass() -> paint::Glass {
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=colors().paper,
    saturation=1.0,
    rim=0.6,
    bezel=10.0,
    refraction=10.0,
    chroma=-0.03,
    merge=0.0,
    adaptive=false,
  )
}

/// Split `s` on newlines, preserving empty lines (always at least one line).
fn loupe_split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.slice(i, i + 1) == "\n" {
      out.push(s.slice(start, i))
      start = i + 1
    }
    i += 1
  }
  out.push(s.slice(start, n))
  out
}

/// Matching caret stop X positions at 1× (`look`) and 1.5× (`look_15`) for one line via `ui::glyph_cells`.
fn loupe_line_stops(
  line : String,
  look : view::WordsLook,
  look_15 : view::WordsLook,
) -> (Array[Double], Array[Double]) {
  let c1 = ui::glyph_cells(line, look, 1.0)
  let c2 = ui::glyph_cells(line, look_15, 1.0)
  let s1 : Array[Double] = [0.0]
  let s2 : Array[Double] = [0.0]
  let n = if c1.length() < c2.length() { c1.length() } else { c2.length() }
  let mut i = 0
  while i < n {
    let (cx1, adv1) = c1[i]
    let (cx2, adv2) = c2[i]
    let x0_1 = cx1 - adv1 * 0.5
    let x1_1 = cx1 + adv1 * 0.5
    let x0_2 = cx2 - adv2 * 0.5
    let x1_2 = cx2 + adv2 * 0.5
    if x0_1 - s1[s1.length() - 1] > 1.0 {
      s1.push(x0_1)
      s2.push(x0_2)
    }
    s1.push(x1_1)
    s2.push(x1_2)
    i += 1
  }
  (s1, s2)
}

/// Snap local pointer `(lx, ly)` to the nearest valid `(row, col, caret_x_1x, caret_x_15x)` character gap.
fn loupe_snap(
  lines : Array[String],
  lx : Double,
  ly : Double,
  line_h : Double,
  look : view::WordsLook,
  look_15 : view::WordsLook,
) -> (Int, Int, Double, Double) {
  let last_row = if lines.length() > 0 { lines.length() - 1 } else { 0 }
  let raw_row = (ly / line_h).floor().to_int()
  let row = if raw_row < 0 { 0 } else if raw_row > last_row { last_row } else { raw_row }
  let (s1, s2) = loupe_line_stops(lines[row], look, look_15)
  let mut best_col = 0
  let mut best_dist = (s1[0] - lx).abs()
  let mut i = 1
  while i < s1.length() {
    let d = (s1[i] - lx).abs()
    if d < best_dist {
      best_dist = d
      best_col = i
    }
    i += 1
  }
  (row, best_col, s1[best_col], s2[best_col])
}

/// Render multiline text as fixed-height rows so caret Y and 1.5× loupe Y align to the sub-pixel.
fn loupe_render_lines(
  parent : view::View,
  lines : Array[String],
  row_h : Double,
  look : view::WordsLook,
  loc~ : String = "",
) -> Unit {
  for line in lines {
    let _ = parent.box(loc=loc, fn(r : view::View) -> Unit {
      let _ = r.height(view::Live::Is(Some(row_h))).lies_along(view::Live::Is(view::Lies::Middle))
      let _ = r.box(fn(w : view::View) -> Unit {
        let _ = w.words(view::Live::Is(line), look=look).ink(view::Live::By(fn() { colors().content }))
      })
    })
  }
}

/// A real iOS-style optical text magnifier in `parent`.
pub fn liquid_magnifier_node(
  parent : view::View,
  words : () -> String,
  label~ : () -> String = fn() { "Magnifier" },
  at~ : (Double, Double) = (0.0, 0.0),
  loc~ : String = "",
) -> view::View {
  let line_h = 24.0
  let line_h_15 = 36.0
  let caret_w = 2.5
  let caret_h = 20.0
  let lens_w = 156.0
  let lens_h = 64.0
  let lens_r = 32.0
  let lens_above = 54.0
  let base_look = words_at(type_body)
  let look = view::WordsLook::{
    size: base_look.size,
    weight: base_look.weight,
    line: line_h,
    wrap: base_look.wrap,
    tracking: base_look.tracking,
    balance: base_look.balance,
    max_lines: base_look.max_lines,
  }
  let base_look_15 = words_at(type_body * 1.5)
  let look_15 = view::WordsLook::{
    size: base_look_15.size,
    weight: base_look_15.weight,
    line: line_h_15,
    wrap: base_look_15.wrap,
    tracking: base_look_15.tracking,
    balance: base_look_15.balance,
    max_lines: base_look_15.max_lines,
  }
  let lines = loupe_split_lines(signals::untracked(words))
  let (ax, ay) = at
  let pos = signals::signal_by(loupe_snap(lines, ax, ay, line_h, look, look_15), loupe_pos_eq)
  let lens_anchor = ui::ref_new((0.0, 0.0))
  let lens_start = ui::ref_new((0.0, 0.0))
  let update_at = fn(lx : Double, ly : Double) -> Unit {
    pos.set(loupe_snap(lines, lx, ly, line_h, look, look_15))
  }
  parent.box(loc=loc, fn(m : view::View) -> Unit {
    let _ = m
    .padding(view::Live::Is((page_pad, page_pad + 32.0, page_pad, page_pad)))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    let _ = m.box(fn(page : view::View) -> Unit {
      let _ = page
      .radius(view::Live::Is(page_radius))
      .ground(view::Live::By(fn() { colors().paper }))
      .padding(view::Live::Is((page_pad, page_pad, page_pad, page_pad)))
      let _ = page.box(fn(text_box : view::View) -> Unit {
        let _ = text_box.gesture(
          2.0,
          press=fn(d : view::Drag) -> Unit { update_at(d.x, d.y) },
          drag=fn(d : view::Drag) -> Unit {
            match d.kind {
              Down => update_at(d.x, d.y)
              Moved => update_at(d.x, d.y)
              Up => ()
              Off => ()
            }
          },
        )
        loupe_render_lines(text_box, lines, line_h, look)
        let _ = text_box.box(fn(caret_layer : view::View) -> Unit {
          let _ = caret_layer.over(view::Live::Is(true)).points(view::Live::Is(false))
          let _ = caret_layer.box(fn(cursor : view::View) -> Unit {
            let _ = cursor
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(caret_w)))
            .height(view::Live::Is(Some(caret_h)))
            .radius(view::Live::Is(caret_w / 2.0))
            .ground(view::Live::By(fn() { colors().accent }))
            .offset(view::Live::By(fn() {
              let (row, _, cx, _) = pos.get()
              (cx - caret_w * 0.5, row.to_double() * line_h + (line_h - caret_h) * 0.5)
            }))
          })
        })
        let _ = text_box.box(fn(lens_layer : view::View) -> Unit {
          let _ = lens_layer.over(view::Live::Is(true)).points(view::Live::Is(false))
          let _ = lens_layer.box(fn(lens_wrap : view::View) -> Unit {
            let _ = lens_wrap
            .over(view::Live::Is(true))
            .points(view::Live::Is(true))
            .width(view::Live::Is(Some(lens_w)))
            .height(view::Live::Is(Some(lens_h)))
            .radius(view::Live::Is(lens_r))
            .shadow(view::Live::Is(shadow_default))
            .shadow_outside(view::Live::Is(true))
            .offset(view::Live::By(fn() {
              let (row, _, cx, _) = pos.get()
              let lx = clamp(cx - lens_w * 0.5, -24.0, 440.0)
              let ly = row.to_double() * line_h + line_h * 0.5 - lens_above - lens_h * 0.5
              (lx, ly)
            }))
            .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
            .gesture(
              2.0,
              press=fn(d : view::Drag) -> Unit {
                let (row, _, cx, _) = pos.untracked()
                lens_anchor.v = (d.wx, d.wy)
                lens_start.v = (cx, row.to_double() * line_h + line_h * 0.5)
              },
              drag=fn(d : view::Drag) -> Unit {
                match d.kind {
                  Down => {
                    let (row, _, cx, _) = pos.untracked()
                    lens_anchor.v = (d.wx, d.wy)
                    lens_start.v = (cx, row.to_double() * line_h + line_h * 0.5)
                  }
                  Moved => {
                    let (awx, awy) = lens_anchor.v
                    let (sx, sy) = lens_start.v
                    update_at(sx + (d.wx - awx), sy + (d.wy - awy))
                  }
                  Up => ()
                  Off => ()
                }
              },
            )
            let _ = lens_wrap.box(fn(zoom_clip : view::View) -> Unit {
              let _ = zoom_clip
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(lens_r))
              .clips(view::Live::Is(true))
              .ground(view::Live::By(fn() { colors().paper | 0xFFL }))
              let _ = zoom_clip.scrolls(view::Scroll::across(), fn(vp : view::View) -> Unit {
                let _ = vp.over(view::Live::Is(true)).points(view::Live::Is(false))
                let _ = vp.box(fn(zoom_stage : view::View) -> Unit {
                  let _ = zoom_stage
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .width(view::Live::Is(Some(1600.0)))
                  .height(view::Live::Is(Some(lines.length().to_double() * line_h_15)))
                  .offset(view::Live::By(fn() {
                    let (row, _, _, cx15) = pos.get()
                    (lens_w * 0.5 - cx15, lens_h * 0.5 - (row.to_double() * line_h_15 + line_h_15 * 0.5))
                  }))
                  loupe_render_lines(zoom_stage, lines, line_h_15, look_15, loc=loc)
                  let _ = zoom_stage.box(fn(zcaret : view::View) -> Unit {
                    let _ = zcaret
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .width(view::Live::Is(Some(3.5)))
                    .height(view::Live::Is(Some(30.0)))
                    .radius(view::Live::Is(1.75))
                    .ground(view::Live::By(fn() { colors().accent }))
                    .offset(view::Live::By(fn() {
                      let (row, _, _, cx15) = pos.get()
                      (cx15 - 1.75, row.to_double() * line_h_15 + 3.0)
                    }))
                  })
                })
              })
            })
            let _ = lens_wrap.box(fn(glass_cap : view::View) -> Unit {
              let _ = glass_cap
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(lens_r))
              .glass(view::Live::By(fn() { Some(magnifier_glass()) }))
            })
          })
        })
      })
    })
  })
}
