// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidToggle.kt.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

fn toggle_glass(p_in : Double) -> paint::Glass {
  let p = clamp(p_in, 0.0, 1.0)
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=white,
    saturation=1.0,
    rim=0.6 * p,
    bezel=8.0 * p,
    refraction=12.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
    zoom=1.0 + 0.22 * p,
  )
}

pub fn liquid_toggle_node(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
  disabled~ : () -> Bool = fn() { false },
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let was_on = signals::untracked(on)
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(if was_on { 1.0 } else { 0.0 }, lo=0.0, hi=1.0, held_scale=thumb_held_scale)
  }
  let fraction = fref(if was_on { 1.0 } else { 0.0 })
  let did_drag = ui::ref_new(false)
  let last_x = fref(0.0)
  headless::toggle(loc=loc, parent, headless::ToggleKind::Switch, label, on, turn, disabled=disabled, fn(v : view::View, sw : headless::Toggle) -> Unit {
    dd.attach(v)
    let _ = v
      .width(view::Live::Is(Some(toggle_w)))
      .height(view::Live::Is(Some(toggle_h)))
      .shrink(view::Live::Is(0.0))
      .alpha(view::Live::By(fn() { if sw.disabled() { 0.5 } else { 1.0 } }))
    v.reacts(at_start=false, on, fn(now : Bool) -> Unit {
      let target = if now { 1.0 } else { 0.0 }
      let cur : Double = fraction.v
      if (target > 0.5) != (cur > 0.5) {
        fraction.v = target
        dd.animate_to(target)
      }
    })
    let stopped = fn() -> Unit {
      if did_drag.v {
        fraction.v = if dd.target() >= 0.5 { 1.0 } else { 0.0 }
        did_drag.v = false
      } else {
        fraction.v = if on() { 0.0 } else { 1.0 }
      }
      let cur : Double = fraction.v
      dd.update_value(cur)
      let now = cur >= 0.5
      if now != on() {
        turn(now)
      }
      dd.release()
    }
    let _ = v.gesture(
      toggle_drag * 0.25,
      press=fn(d : view::Drag) -> Unit {
        if sw.disabled() {
          return
        }
        last_x.v = d.wx
        dd.press()
      },
      tap=fn(_d : view::Drag) -> Unit {
        if !sw.disabled() {
          stopped()
        }
      },
      drag=fn(d : view::Drag) -> Unit {
        if sw.disabled() {
          return
        }
        match d.kind {
          Down | Moved => {
            let dx = d.wx - last_x.v
            last_x.v = d.wx
            if dx != 0.0 {
              did_drag.v = true
            }
            fraction.v = clamp(fraction.v + dx / toggle_drag, 0.0, 1.0)
            dd.update_value(fraction.v)
          }
          Up => stopped()
          Off => {
            did_drag.v = false
            dd.release()
          }
        }
      },
    )
    let _ = v.box(fn(track : view::View) -> Unit {
      let _ = track
        .over(view::Live::Is(true))
        .radius(view::Live::Is(toggle_h / 2.0))
        .ground(view::Live::By(fn() {
          let c = colors()
          lerp_color(c.track, c.toggle_on, clamp(dd.value(track), 0.0, 1.0))
        }))
    })
    let _ = v.box(fn(thumb : view::View) -> Unit {
      let size = fn() -> (Double, Double) {
        let (sx, sy) = dd.jelly(thumb, 50.0)
        (thumb_w * sx, thumb_h * sy)
      }
      let _ = thumb
        .over(view::Live::Is(true))
        .width(view::Live::By(fn() { Some(size().0) }))
        .height(view::Live::By(fn() { Some(size().1) }))
        .radius(view::Live::By(fn() { size().1 / 2.0 }))
        .offset(view::Live::By(fn() {
          let (w, h) = size()
          let x = lerp(toggle_pad, toggle_pad + toggle_drag, dd.value(thumb))
          (x + (thumb_w - w) / 2.0, (toggle_h - h) / 2.0)
        }))
        .shadow(view::Live::Is(shadow_thumb))
        .shadow_outside(view::Live::Is(true))
      let _ = thumb.box(fn(solid : view::View) -> Unit {
        let _ = solid
          .over(view::Live::Is(true))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .ground(view::Live::Is(white))
          .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(solid), 0.0, 1.0) }))
      })
      let _ = thumb.box(fn(gl : view::View) -> Unit {
        let _ = gl
          .over(view::Live::Is(true))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .glass(view::Live::By(fn() {
            let p = dd.pressed(gl)
            if p > 0.001 {
              Some(toggle_glass(p))
            } else {
              None
            }
          }))
          .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
      })
    })
    v.show(fn() { sw.focus_shown() }, fn(ring : view::View) -> Unit {
      let _ = ring
        .over(view::Live::Is(true))
        .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
        .radius(view::Live::Is(toggle_h / 2.0 + 3.0))
        .edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  })
}
