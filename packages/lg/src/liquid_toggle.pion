// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidToggle.kt.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

pub fn liquid_toggle_node(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
  disabled~ : () -> Bool = fn() { false },
  width~ : Double = toggle_w,
  height~ : Double = toggle_h,
  track_color? : () -> Int64,
  on_color? : () -> Int64,
  finger_only_lens~ : Bool = false,
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let pad = toggle_pad
  let th = dmax(4.0, height - 2.0 * pad)
  let tw = width * 40.0 / 64.0
  let drag_dist = dmax(1.0, width - 2.0 * pad - tw)
  let was_on = signals::untracked(on)
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(if was_on { 1.0 } else { 0.0 }, lo=0.0, hi=1.0, held_scale=thumb_held_scale)
  }
  let fraction = fref(if was_on { 1.0 } else { 0.0 })
  let did_drag = ui::ref_new(false)
  let holding : signals::Signal[Bool] = signals::signal(false)
  let last_x = fref(0.0)
  headless::toggle(loc=loc, parent, headless::ToggleKind::Switch, label, on, turn, disabled=disabled, fn(v : view::View, sw : headless::Toggle) -> Unit {
    dd.attach(v)
    let no_lens = fn() -> Bool {
      v.glass_solid() || ui::glass_solid() || ui::reduced_motion() || (finger_only_lens && !(ui::pointing() == ui::Pointing::Finger))
    }
    let lens = fn(n : view::View) -> Double { if no_lens() { 0.0 } else { dd.pressed(n) } }
    let _ = v
    .width(view::Live::Is(Some(width)))
    .height(view::Live::Is(Some(height)))
    .shrink(view::Live::Is(0.0))
    .alpha(view::Live::By(fn() { if sw.disabled() { 0.5 } else { 1.0 } }))
    v.reacts(at_start=false, on, fn(now : Bool) -> Unit {
      let target = if now { 1.0 } else { 0.0 }
      let cur : Double = fraction.v
      if (target > 0.5) != (cur > 0.5) {
        fraction.v = target
        if no_lens() {
          dd.slide_to(target)
        } else {
          dd.animate_to(target)
        }
      }
    })
    let stopped = fn() -> Unit {
      holding.set(false)
      if did_drag.v {
        fraction.v = if dd.target() >= 0.5 { 1.0 } else { 0.0 }
        did_drag.v = false
      } else {
        fraction.v = if on() { 0.0 } else { 1.0 }
      }
      let cur : Double = fraction.v
      if no_lens() {
        dd.slide_to(cur)
      } else {
        dd.update_value(cur)
      }
      let now = cur >= 0.5
      if now != on() {
        turn(now)
      }
      dd.release()
    }
    let _ = v.gesture(
      drag_dist * 0.25,
      press=fn(d : view::Drag) -> Unit {
        if sw.disabled() {
          return
        }
        last_x.v = d.wx
        if !no_lens() {
          holding.set(true)
          dd.press()
        }
      },
      tap=fn(_d : view::Drag) -> Unit {
        if !sw.disabled() {
          stopped()
        }
      },
      drag=fn(d : view::Drag) -> Unit {
        if sw.disabled() {
          return
        }
        match d.kind {
          Down | Moved => {
            let dx = d.wx - last_x.v
            last_x.v = d.wx
            if dx != 0.0 {
              did_drag.v = true
            }
            fraction.v = clamp(fraction.v + dx / drag_dist, 0.0, 1.0)
            if no_lens() {
              dd.slide_to(fraction.v)
            } else {
              dd.update_value(fraction.v)
            }
          }
          Up => stopped()
          Off => {
            did_drag.v = false
            holding.set(false)
            dd.release()
          }
        }
      },
    )
    let _ = v.box(fn(track : view::View) -> Unit {
      let _ = track
      .over(view::Live::Is(true))
      .radius(view::Live::Is(height / 2.0))
      .ground(view::Live::By(fn() {
        let off_c = match track_color {
          Some(f) => f()
          None => colors().track
        }
        let on_c = match on_color {
          Some(f) => f()
          None => colors().toggle_on
        }
        lerp_color(off_c, on_c, clamp(dd.value(track), 0.0, 1.0))
      }))
    })
    let _ = v.box(fn(thumb : view::View) -> Unit {
      let thumb_shape = fn(n : view::View, with_velocity : Bool) -> view::GroundShape {
        let p = clamp(lens(n), 0.0, 1.0)
        let (sx, sy) = if no_lens() { (1.0, 1.0) } else { dd.jelly(n, 50.0) }
        let base_w = tw * sx
        let base_h = th * sy
        let x = lerp(pad, pad + drag_dist, dd.value(n))
        let (w, h) = if with_velocity && !ui::reduced_motion() {
          let (_, speed) = dd.value_w.motion(n)
          let calm = 1.0 - p
          let vc = motion::velocity_capsule(base_w, base_h, speed * drag_dist * calm, 0.0)
          (base_w + vc.dw, base_h + vc.dh)
        } else {
          (base_w, base_h)
        }
        let r = h / 2.0
        view::GroundShape::{
          dx: x + (tw - w) / 2.0,
          dy: (height - h) / 2.0,
          dw: w - tw,
          dh: h - th,
          corners: Some((r, r, r, r)),
        }
      }
      let _ = thumb
      .over(view::Live::Is(true))
      .width(view::Live::Is(Some(tw)))
      .height(view::Live::Is(Some(th)))
      .radius(view::Live::Is(th / 2.0))
      .shadow(view::Live::Is(shadow_thumb))
      .shadow_outside(view::Live::Is(true))
      .ground_drawn(view::Live::By(fn() { thumb_shape(thumb, true) }))
      let _ = thumb.box(fn(solid : view::View) -> Unit {
        let _ = solid
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(tw)))
        .height(view::Live::Is(Some(th)))
        .radius(view::Live::Is(th / 2.0))
        .ground(view::Live::Is(white))
        .alpha(view::Live::By(fn() { 1.0 - clamp(lens(solid), 0.0, 1.0) }))
        .ground_drawn(view::Live::By(fn() { thumb_shape(solid, true) }))
      })
      // Lazy-mount the refraction loupe on first press so idle toggles allocate 0 extra nodes and
      // 0 hidden glass instances; keep mounted after release so settling triggers 0 Flex layouts.
      let lens_mounted : signals::Signal[Bool] = signals::signal(false)
      thumb.reacts(fn() { !no_lens() && (holding.get() || dd.pressed(thumb) > 0.001) }, fn(active : Bool) -> Unit {
        if active && !lens_mounted.untracked() {
          lens_mounted.set(true)
        }
      })
      thumb.show(
        fn() { lens_mounted.get() },
        fn(gl : view::View) -> Unit {
          let _ = gl
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .width(view::Live::Is(Some(tw)))
          .height(view::Live::Is(Some(th)))
          .radius(view::Live::Is(th / 2.0))
          .glass(view::Live::By(fn() {
            let p = clamp(lens(gl), 0.0, 1.0)
            if p > 0.001 {
              Some(lg_clear_lens_glass(p, bezel=8.0, refraction=12.0))
            } else {
              None
            }
          }))
          .alpha(view::Live::By(fn() { clamp(lens(gl), 0.0, 1.0) }))
          .ground_drawn(view::Live::By(fn() { thumb_shape(gl, false) }))
        },
        at_once=true,
      )
    })
    lg_focus_ring(v, fn() { sw.focus_shown() }, height / 2.0)
  })
}
