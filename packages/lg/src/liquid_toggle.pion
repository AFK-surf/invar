// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidToggle.kt. A track 64 × 28, a capsule
// going from the track's grey to green as its thumb goes across (Compose's lerp of colours: through Oklab); its thumb a
// white capsule 40 × 24, 2 in, dragged 20 from end to end. Held, the thumb turns to glass: its white and its blur (8)
// recede as its lens comes up (5 deep, bending by up to 10, the colours split), its Ambient highlight and its
// InnerShadow (4) with it, and it grows by half again (springs of 0.6 and 0.7 across and down), squeezed as it goes by
// how fast (DampedDragAnimation's velocity / 50). A tap turns it; a drag past half its way turns it there; Space and
// Enter, and a screen reader's Activate, turn it as mbui's headless switch does.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

/// The thumb's glass, held `p` (iOS 27 clear loupe).
fn toggle_glass(p : Double) -> paint::Glass {
  let p = clamp(p, 0.0, 1.0)
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=white,
    saturation=1.0,
    rim=0.6 * p,
    bezel=8.0 * p,
    refraction=12.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
  )
}

/// A LiquidToggle in `parent`, on while `on` says; turned (a tap, a drag past half its way, Space, Enter, Activate),
/// `turn` is told what it turns to. Read out a switch named `label`, on or off. The node.
pub fn liquid_toggle_node(
  parent : view::View,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  label : () -> String,
  disabled~ : () -> Bool = fn() { false },
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let was_on = signals::untracked(on)
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(if was_on { 1.0 } else { 0.0 }, lo=0.0, hi=1.0, held_scale=thumb_held_scale)
  }
  let fraction = DoubleCell::{ v: if was_on { 1.0 } else { 0.0 } }
  let did_drag = ui::ref_new(false)
  let last_x = DoubleCell::{ v: 0.0 }
  headless::toggle(parent, headless::ToggleKind::Switch, label, on, turn, fn(v, sw) {
    dd.attach(v)
    let _ = v.width(view::Live::Is(Some(toggle_w))).height(view::Live::Is(Some(toggle_h))).shrink(view::Live::Is(0.0)).alpha(view::Live::By(fn() { if sw.disabled() { 0.5 } else { 1.0 } }))
    v.reacts(on, fn(now) {
      let target = if now { 1.0 } else { 0.0 }
      if target != fraction.v {
        fraction.v = target
        dd.animate_to(target)
      }
    }, at_start=false)
    let stopped = fn() -> Unit {
      if did_drag.v {
        fraction.v = if dd.target() >= 0.5 { 1.0 } else { 0.0 }
        did_drag.v = false
      } else {
        fraction.v = if on() { 0.0 } else { 1.0 }
      }
      dd.update_value(fraction.v)
      let now = fraction.v == 1.0
      if now != on() {
        turn(now)
      }
      dd.release()
    }
    let _ = v.gesture(
      ui::touch_slop(),
      press=fn(d) {
        if sw.disabled() {
          return
        }
        last_x.v = d.wx
        dd.press()
      },
      tap=fn(_d) { if !sw.disabled() { stopped() } },
      drag=fn(d) {
        if sw.disabled() {
          return
        }
        match d.kind {
          view::DragIs::Down | view::DragIs::Moved => {
            let dx = d.wx - last_x.v
            last_x.v = d.wx
            if dx != 0.0 {
              did_drag.v = true
            }
            fraction.v = clamp(fraction.v + dx / toggle_drag, 0.0, 1.0)
            dd.update_value(fraction.v)
          }
          view::DragIs::Up => stopped()
          view::DragIs::Off => {
            did_drag.v = false
            dd.release()
          }
        }
      },
    )
    let _ = v.box(fn(track) {
      let _ = track
        .over(view::Live::Is(true))
        .radius(view::Live::Is(toggle_h / 2.0))
        .ground(view::Live::By(fn() {
          let c = colors()
          lerp_color(c.track, c.toggle_on, clamp(dd.value(track), 0.0, 1.0))
        }))
    })
    let _ = v.box(fn(thumb) {
      let size = fn() -> (Double, Double) {
        let (sx, sy) = dd.jelly(thumb, 50.0)
        (thumb_w * sx, thumb_h * sy)
      }
      let _ = thumb
        .over(view::Live::Is(true))
        .width(view::Live::By(fn() { Some(size().0) }))
        .height(view::Live::By(fn() { Some(size().1) }))
        .radius(view::Live::By(fn() { size().1 / 2.0 }))
        .offset(view::Live::By(fn() {
          let (w, h) = size()
          let x = lerp(toggle_pad, toggle_pad + toggle_drag, dd.value(thumb))
          (x + (thumb_w - w) / 2.0, (toggle_h - h) / 2.0)
        }))
        .shadow(view::Live::Is(shadow_thumb))
      let _ = thumb.box(fn(solid) {
        let _ = solid
          .over(view::Live::Is(true))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .ground(view::Live::Is(white))
          .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(solid), 0.0, 1.0) }))
      })
      let _ = thumb.box(fn(gl) {
        let _ = gl
          .over(view::Live::Is(true))
          .radius(view::Live::By(fn() { size().1 / 2.0 }))
          .glass(view::Live::By(fn() { Some(toggle_glass(dd.pressed(gl))) }))
          .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
      })
    })
    v.show(fn() { sw.focus_shown() }, fn(ring) {
      let _ = ring
        .over(view::Live::Is(true))
        .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
        .radius(view::Live::Is(toggle_h / 2.0 + 3.0))
        .edge(view::Live::By(fn() { (2.0, colors().accent) }))
    })
  }, disabled=disabled, made_for=loc)
}
