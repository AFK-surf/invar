// Apple-style pure-vector icon library (`IconKind`, `icon_shapes`, `icon_node`) and floating
// single-layer Liquid Glass back navigation island (`liquid_back_button_node`).
// 100% geometric `paint::shape_of` strokes/fills (1.6-1.8pt stroke weight at 16pt), zero emoji or
// Unicode symbol font dependency.

import "dmath"
import "headless"
import "motion"
import "paint"
import "ui"
import "view"

/// Standard pure-vector App icon set for floating chrome, toolbars, navigation bars, and composers.
#derive(Eq)
pub enum IconKind {
  ChevronLeft
  ChevronRight
  ChevronDown
  Search
  Plus
  Paperclip
  ArrowUp
  ArrowDown
  Pin
  Mic
  MicOff
  Volume
  Phone
  Users
  UserPlus
  Info
  Settings
  Share
  More
  Close
  Check
  Copy
  Sidebar
  Sparkles
  Bell
  Lock
  Hash
  Filter
  Trash
  Edit
  Refresh
}

fn ic_arc_pts(
  cx : Double,
  cy : Double,
  r : Double,
  a0 : Double,
  a1 : Double,
  steps : Int,
) -> Array[Double] {
  let pts : Array[Double] = []
  let n = if steps < 4 { 4 } else { steps }
  let mut i = 0
  while i <= n {
    let a = a0 + (a1 - a0) * i.to_double() / n.to_double()
    pts.push(cx + r * dmath::cos(a))
    pts.push(cy + r * dmath::sin(a))
    i += 1
  }
  pts
}

fn ic_circle_pts(cx : Double, cy : Double, r : Double, steps : Int) -> Array[Double] {
  let pts : Array[Double] = []
  let two_pi = 6.283185307179586
  let n = if steps < 8 { 8 } else { steps }
  let mut i = 0
  while i < n {
    let a = two_pi * i.to_double() / n.to_double()
    pts.push(cx + r * dmath::cos(a))
    pts.push(cy + r * dmath::sin(a))
    i += 1
  }
  pts
}

fn ic_rrect_pts(x : Double, y : Double, rw : Double, rh : Double, rad : Double) -> Array[Double] {
  let r = dmin(rad, dmin(rw * 0.5, rh * 0.5))
  let pi = dmath::pi
  let pts : Array[Double] = []
  let add_arc = fn(cx : Double, cy : Double, a0 : Double, a1 : Double) -> Unit {
    let mut i = 0
    while i <= 4 {
      let a = a0 + (a1 - a0) * i.to_double() / 4.0
      pts.push(cx + r * dmath::cos(a))
      pts.push(cy + r * dmath::sin(a))
      i += 1
    }
  }
  add_arc(x + rw - r, y + r, -pi * 0.5, 0.0)
  add_arc(x + rw - r, y + rh - r, 0.0, pi * 0.5)
  add_arc(x + r, y + rh - r, pi * 0.5, pi)
  add_arc(x + r, y + r, pi, pi * 1.5)
  pts
}

fn ic_stroke(pts : Array[Double], closed : Bool, ink : Int64, w : Double) -> paint::Shape {
  paint::shape_of([(pts, closed)], stroke=ink, width=w)
}

fn ic_fill(pts : Array[Double], ink : Int64) -> paint::Shape {
  paint::shape_of([(pts, true)], fill=ink)
}

/// Build pure geometric vector `paint::Shape` primitives for `kind` inside a `size × size` box.
pub fn icon_shapes(kind : IconKind, size : Double, ink : Int64) -> Array[paint::Shape] {
  let s = size / 24.0
  let w = clamp(size * 0.105, 1.55, 1.85)
  let pi = dmath::pi
  let p = fn(x : Double, y : Double) -> (Double, Double) { (x * s, y * s) }
  let line = fn(x0 : Double, y0 : Double, x1 : Double, y1 : Double) -> paint::Shape {
    ic_stroke([x0 * s, y0 * s, x1 * s, y1 * s], false, ink, w)
  }
  let poly = fn(coords : Array[Double], closed : Bool) -> paint::Shape {
    let scaled : Array[Double] = []
    for c in coords {
      scaled.push(c * s)
    }
    ic_stroke(scaled, closed, ink, w)
  }
  let dot = fn(cx : Double, cy : Double, r : Double) -> paint::Shape {
    ic_fill(ic_circle_pts(cx * s, cy * s, r * s, 12), ink)
  }
  let _ = p
  match kind {
    ChevronLeft => [poly([15.0, 5.5, 8.5, 12.0, 15.0, 18.5], false)]
    ChevronRight => [poly([9.0, 5.5, 15.5, 12.0, 9.0, 18.5], false)]
    ChevronDown => [poly([5.5, 9.0, 12.0, 15.5, 18.5, 9.0], false)]
    Search => [
      ic_stroke(ic_circle_pts(10.5 * s, 10.5 * s, 6.2 * s, 20), true, ink, w),
      line(15.2, 15.2, 20.2, 20.2),
    ]
    Plus => [line(12.0, 5.0, 12.0, 19.0), line(5.0, 12.0, 19.0, 12.0)]
    Paperclip => {
      let pts : Array[Double] = [14.8, 7.6, 8.6, 13.8]
      let a1 = ic_arc_pts(9.9, 15.1, 1.85, pi * 0.75, pi * 1.75, 8)
      for v in a1 {
        pts.push(v)
      }
      pts.push(17.8)
      pts.push(9.6)
      let a2 = ic_arc_pts(15.3, 7.1, 3.5, -pi * 0.25, -pi * 1.25, 10)
      for v in a2 {
        pts.push(v)
      }
      pts.push(6.0)
      pts.push(11.4)
      let a3 = ic_arc_pts(9.6, 15.0, 5.1, pi * 1.25, pi * 0.25, 12)
      for v in a3 {
        pts.push(v)
      }
      pts.push(18.6)
      pts.push(13.2)
      [poly(pts, false)]
    }
    ArrowUp => [
      line(12.0, 18.5, 12.0, 5.5),
      poly([6.5, 11.0, 12.0, 5.5, 17.5, 11.0], false),
    ]
    ArrowDown => [
      line(12.0, 5.5, 12.0, 18.5),
      poly([6.5, 13.0, 12.0, 18.5, 17.5, 13.0], false),
    ]
    Pin => [
      poly([14.5, 4.0, 20.0, 9.5, 18.0, 11.5, 16.5, 10.5, 13.2, 13.8, 14.2, 16.2, 12.5, 17.8, 6.2, 11.5, 7.8, 9.8, 10.2, 10.8, 13.5, 7.5, 12.5, 6.0], true),
      line(9.3, 14.7, 4.5, 19.5),
    ]
    Mic => [
      ic_stroke(ic_rrect_pts(9.0 * s, 3.5 * s, 6.0 * s, 10.5 * s, 3.0 * s), true, ink, w),
      ic_stroke(ic_arc_pts(12.0 * s, 11.0 * s, 6.0 * s, 0.0, pi, 14), false, ink, w),
      line(12.0, 17.0, 12.0, 20.5),
      line(8.8, 20.5, 15.2, 20.5),
    ]
    MicOff => [
      ic_stroke(ic_rrect_pts(9.0 * s, 3.5 * s, 6.0 * s, 10.5 * s, 3.0 * s), true, ink, w),
      ic_stroke(ic_arc_pts(12.0 * s, 11.0 * s, 6.0 * s, 0.12 * pi, 0.88 * pi, 12), false, ink, w),
      line(12.0, 17.0, 12.0, 20.5),
      line(4.5, 4.5, 19.5, 19.5),
    ]
    Volume => [
      poly([4.2, 9.4, 8.2, 9.4, 13.0, 5.4, 13.0, 18.6, 8.2, 14.6, 4.2, 14.6], true),
      ic_stroke(ic_arc_pts(13.5 * s, 12.0 * s, 3.5 * s, -pi * 0.34, pi * 0.34, 10), false, ink, w),
      ic_stroke(ic_arc_pts(13.5 * s, 12.0 * s, 6.4 * s, -pi * 0.34, pi * 0.34, 12), false, ink, w),
    ]
    Phone => [
      poly([6.5, 4.2, 9.6, 4.2, 10.8, 8.2, 8.6, 9.8, 10.2, 12.6, 11.4, 13.8, 14.2, 15.4, 15.8, 13.2, 19.8, 14.4, 19.8, 17.5, 17.8, 19.6, 14.2, 19.2, 9.4, 14.6, 4.8, 9.8, 4.4, 6.2], true),
    ]
    Users => [
      ic_stroke(ic_circle_pts(9.2 * s, 8.2 * s, 3.0 * s, 16), true, ink, w),
      ic_stroke(ic_arc_pts(9.2 * s, 19.2 * s, 5.6 * s, pi * 1.08, pi * 1.92, 12), false, ink, w),
      ic_stroke(ic_circle_pts(16.2 * s, 9.0 * s, 2.3 * s, 14), true, ink, w),
      ic_stroke(ic_arc_pts(16.0 * s, 18.8 * s, 4.4 * s, pi * 1.25, pi * 1.90, 10), false, ink, w),
    ]
    UserPlus => [
      ic_stroke(ic_circle_pts(9.6 * s, 8.2 * s, 3.2 * s, 16), true, ink, w),
      ic_stroke(ic_arc_pts(9.6 * s, 19.4 * s, 5.8 * s, pi * 1.08, pi * 1.92, 12), false, ink, w),
      line(18.0, 8.2, 18.0, 14.2),
      line(15.0, 11.2, 21.0, 11.2),
    ]
    Info => [
      ic_stroke(ic_circle_pts(12.0 * s, 12.0 * s, 8.2 * s, 24), true, ink, w),
      dot(12.0, 8.2, 1.05),
      line(12.0, 11.2, 12.0, 16.4),
    ]
    Settings => {
      let out : Array[paint::Shape] = [
        ic_stroke(ic_circle_pts(12.0 * s, 12.0 * s, 3.1 * s, 16), true, ink, w),
        ic_stroke(ic_circle_pts(12.0 * s, 12.0 * s, 6.2 * s, 20), true, ink, w),
      ]
      let mut i = 0
      while i < 8 {
        let a = pi * 2.0 * i.to_double() / 8.0
        let x0 = 12.0 + 6.4 * dmath::cos(a)
        let y0 = 12.0 + 6.4 * dmath::sin(a)
        let x1 = 12.0 + 8.6 * dmath::cos(a)
        let y1 = 12.0 + 8.6 * dmath::sin(a)
        out.push(line(x0, y0, x1, y1))
        i += 1
      }
      out
    }
    Share => [
      line(12.0, 14.5, 12.0, 4.2),
      poly([8.2, 8.0, 12.0, 4.2, 15.8, 8.0], false),
      poly([6.0, 11.5, 6.0, 19.2, 18.0, 19.2, 18.0, 11.5], false),
    ]
    More => [dot(6.2, 12.0, 1.45), dot(12.0, 12.0, 1.45), dot(17.8, 12.0, 1.45)]
    Close => [line(6.2, 6.2, 17.8, 17.8), line(17.8, 6.2, 6.2, 17.8)]
    Check => [poly([5.0, 12.4, 9.8, 17.2, 19.0, 7.2], false)]
    Copy => [
      ic_stroke(ic_rrect_pts(8.5 * s, 8.5 * s, 10.5 * s, 11.0 * s, 2.2 * s), true, ink, w),
      poly([15.5, 8.5, 15.5, 5.8, 14.8, 5.0, 6.2, 5.0, 5.2, 6.0, 5.2, 14.8, 6.0, 15.5, 8.5, 15.5], false),
    ]
    Sidebar => [
      ic_stroke(ic_rrect_pts(3.8 * s, 4.8 * s, 16.4 * s, 14.4 * s, 2.8 * s), true, ink, w),
      line(9.2, 4.8, 9.2, 19.2),
      line(5.8, 8.6, 7.4, 8.6),
      line(5.8, 11.6, 7.4, 11.6),
    ]
    Sparkles => [
      poly([12.0, 3.8, 13.7, 9.6, 19.5, 11.3, 13.7, 13.0, 12.0, 18.8, 10.3, 13.0, 4.5, 11.3, 10.3, 9.6], true),
      line(18.2, 4.4, 18.2, 7.4),
      line(16.7, 5.9, 19.7, 5.9),
    ]
    Bell => [
      ic_stroke(ic_arc_pts(12.0 * s, 9.4 * s, 4.8 * s, pi, 2.0 * pi, 14), false, ink, w),
      poly([7.2, 9.4, 7.2, 14.2, 5.2, 16.8, 18.8, 16.8, 16.8, 14.2, 16.8, 9.4], false),
      ic_stroke(ic_arc_pts(12.0 * s, 17.4 * s, 2.2 * s, 0.0, pi, 10), false, ink, w),
    ]
    Lock => [
      ic_stroke(ic_rrect_pts(5.5 * s, 10.6 * s, 13.0 * s, 9.2 * s, 2.4 * s), true, ink, w),
      ic_stroke(ic_arc_pts(12.0 * s, 9.8 * s, 3.8 * s, pi, 2.0 * pi, 14), false, ink, w),
      line(8.2, 9.8, 8.2, 10.6),
      line(15.8, 9.8, 15.8, 10.6),
    ]
    Hash => [
      line(5.0, 9.2, 19.0, 9.2),
      line(4.5, 14.8, 18.5, 14.8),
      line(10.0, 4.8, 8.2, 19.2),
      line(15.8, 4.8, 14.0, 19.2),
    ]
    Filter => [
      line(4.2, 6.8, 19.8, 6.8),
      line(6.8, 12.0, 17.2, 12.0),
      line(9.6, 17.2, 14.4, 17.2),
    ]
    Trash => [
      line(4.8, 7.0, 19.2, 7.0),
      poly([9.2, 7.0, 9.8, 4.6, 14.2, 4.6, 14.8, 7.0], false),
      poly([6.6, 7.0, 7.4, 19.4, 16.6, 19.4, 17.4, 7.0], false),
      line(10.2, 10.5, 10.2, 16.2),
      line(13.8, 10.5, 13.8, 16.2),
    ]
    Edit => [
      poly([5.0, 19.0, 6.2, 14.8, 15.8, 5.2, 18.8, 8.2, 9.2, 17.8], true),
      line(13.8, 7.2, 16.8, 10.2),
    ]
    Refresh => [
      ic_stroke(ic_arc_pts(12.0 * s, 12.0 * s, 6.8 * s, -pi * 0.25, pi * 1.48, 18), false, ink, w),
      poly([14.2, 5.2, 18.0, 5.2, 18.0, 9.0], false),
    ]
  }
}

/// Pure-vector Apple icon view node. Automatically follows `lg::surface().ink` when `ink` is omitted.
pub fn icon_node(
  parent : view::View,
  kind : IconKind,
  size~ : Double = 16.0,
  ink? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  let color_fn = match ink {
    Some(f) => f
    None => fn() -> Int64 { surface().ink }
  }
  parent.box(loc=loc, fn(ic : view::View) -> Unit {
    let _ = ic
    .width(view::Live::Is(Some(size)))
    .height(view::Live::Is(Some(size)))
    .shrink(view::Live::Is(0.0))
    .points(view::Live::Is(false))
    .shapes(view::Live::By(fn() { icon_shapes(kind, size, color_fn()) }))
  })
}

/// Floating single-layer Liquid Glass back navigation island (`36×36` circular `<` island when
/// `label == ""`, or `< Label` capsule island when a label is provided; guaranteed >= 36pt hit area).
pub fn liquid_back_button_node(
  parent : view::View,
  press : () -> Unit,
  label~ : () -> String = fn() { "" },
  height~ : Double = 36.0,
  loc~ : String = "",
) -> view::View {
  let hit_h = dmax(height, 36.0)
  let hit_out = (hit_h - height) / 2.0
  let r = height / 2.0
  headless::button(
    loc=loc,
    parent,
    fn() {
      let l = label()
      if l != "" { l } else { "Back" }
    },
    fn(_e) -> Unit { press() },
    fn(b : view::View, btn : headless::Button) -> Unit {
      let hl = InteractiveHighlight::new()
      hl.attach(b)
      let press_way = motion::NodeWay::new(0.0)
      let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(hit_h)))
      .shrink(view::Live::Is(0.0))
      if hit_out > 0.0 {
        let _ = b.margin(view::Live::Is((0.0, -hit_out, 0.0, -hit_out)))
      }
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit {
          hl.down(d.x, d.y, d.w, d.h)
          press_way.go(b, 1.0, motion::backdrop_press_spring)
        },
        tap=fn(_d : view::Drag) -> Unit {
          hl.up()
          press_way.go(b, 0.0, motion::backdrop_press_spring)
          btn.press()
        },
        drag=fn(d : view::Drag) -> Unit {
          match d.kind {
            Down | Moved => hl.moved(d.x, d.y)
            Up => {
              hl.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => {
              hl.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
            }
          }
        },
      )
      let _ = b.box(fn(island : view::View) -> Unit {
        let has_label = fn() -> Bool { label() != "" }
        let _ = island
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .height(view::Live::Is(Some(height)))
        .min_width(view::Live::Is(Some(height)))
        .width(view::Live::By(fn() { if has_label() { None } else { Some(height) } }))
        .padding(view::Live::By(fn() { if has_label() { (9.0, 0.0, 13.0, 0.0) } else { (0.0, 0.0, 0.0, 0.0) } }))
        .gap(view::Live::By(fn() { if has_label() { 3.0 } else { 0.0 } }))
        .radius(view::Live::Is(r))
        .shadow(view::Live::By(lg_bar_pill_shadow))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() {
          let sp = if hl.pressed(island) > 0.001 {
            let (w, h) = hl.size.get()
            if w > 0.0 && h > 0.0 { Some(hl.spot(island, w, h)) } else { None }
          } else {
            None
          }
          Some(liquid_bar_pill_glass(spot?=sp, adaptive=true))
        }))
        .edge(view::Live::By(fn() { if island.glass_solid() || ui::glass_solid() { lg_solid_edge() } else { (0.0, clear) } }))
        .scale(
          view::Live::By(fn() {
            if ui::reduced_motion() { 1.0 } else { lerp(1.0, 0.96, clamp(press_way.shown(island), 0.0, 1.0)) }
          }),
          about=view::Pivot::At(0.5, 0.5),
        )
        lg_focus_ring(island, fn() { btn.focus_shown() }, r)
        let _ = island.box(fn(ov : view::View) -> Unit {
          let _ = ov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(r))
          .ground(view::Live::By(fn() { liquid_press_ink(solid=island.glass_solid() || ui::glass_solid()) }))
          .alpha(view::Live::By(fn() { clamp(press_way.shown(ov), 0.0, 1.0) }))
        })
        let _ = icon_node(island, IconKind::ChevronLeft, size=17.0, ink=fn() { colors().content })
        island.show(
          has_label,
          fn(lbl_slot : view::View) -> Unit {
            let _ = lbl_slot.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::By(label), look=words_at(14.0, weight=500))
              .ink(view::Live::By(fn() { colors().content }))
            })
          },
          at_once=true,
        )
      })
    },
  )
}
