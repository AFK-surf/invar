// Real Pion-JSX + Leading-Dot `.Enum` regression tests covering all 25 `lg` JSX components
// and enforcing zero nested Liquid Glass (`assert_no_nested_glass`).

import "signals"
import "ui"
import "view"

test "jsx: desktop control panel showcase with zero nested glass" {
  let pct = signals::signal(82)
  let synced = signals::signal(0)
  let wifi = signals::signal(true)
  let vol = signals::signal(45.0)
  let tab = signals::signal(1)
  let chip_on = signals::signal(false)

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.pad_all(12.0).gap_px(12.0)
      <NavBar
        in={root}
        title="Device Control"
        subtitle="Invar JSX"
        trailing={fn(tr : view::View) -> Unit {
          <BarPillGroup in={tr} label="Bar Actions">
            <Button label="Sync" flat ghost on_press=>{ synced.set(synced.get() + 1) } />
          </BarPillGroup>
        }}
      />
      <Panel in={root} gap={10.0} label="Controls">
        <Badge label_by=>{ "电量 \{pct.get()}%" } tone={.Success} dot />
        <CountBadge count_by=>{ synced.get() + 3 } tone={.Danger} />
        <Toggle on_by=>{ wifi.get() } on_change={fn(v : Bool) { wifi.set(v) }} label="Wi-Fi" />
        <Slider value_by=>{ vol.get() } on_change={fn(v : Double) { vol.set(v) }} label="Volume" min={0.0} max={100.0} />
        <ProgressBar value={0.65} label="Syncing" show_value />
        <ProgressRing value={0.75} size={32.0} />
      </Panel>
      <Segmented in={root} labels={["Day", "Week", "Month"]} selected_by=>{ tab.get() } on_select={fn(i : Int) { tab.set(i) }} width={260.0} />
      <Chip in={root} label="Metal" selected_by=>{ chip_on.get() } on_press=>{ chip_on.set(!chip_on.get()) } />
    },
    width=720.0,
    height=640.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_no_nested_glass(t, label="jsx_showcase")
  debug_assert(count_liquid_glass(t) >= 2, "expected liquid glass surfaces in showcase")
  pct.set(95)
  t.frame()
  assert_no_nested_glass(t, label="jsx_showcase_after_update")
  t.dispose()
}

test "jsx: remaining controls, containers, inputs, and overlays all compile and mount cleanly" {
  let fav = signals::signal(false)
  let checked = signals::signal(true)
  let qty = signals::signal(4)
  let disc_open = signals::signal(true)
  let dlg_open = signals::signal(false)
  let sheet_open = signals::signal(false)
  let drawer_open = signals::signal(false)
  let toast_on = signals::signal(true)
  let name_field = ui::Field::new(text="Invar")
  let search_field = ui::Field::new(text="")

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.pad_all(12.0).gap_px(10.0)
      <Toolbar in={root}>
        <Button label="Select" flat ghost on_press=>{ () } />
        <ToolbarDivider height={18.0} />
        <Button label="Note" flat ghost on_press=>{ () } />
      </Toolbar>
      <IconButton
        in={root}
        label="Favorite"
        icon={fn(c : view::View, ink : () -> Int64) { flight_icon(c, 16.0, ink) }}
        size={.Regular}
        active_by=>{ fav.get() }
        on_press=>{ fav.set(!fav.get()) }
      />
      <Card in={root} width={220.0} height={80.0} label="Metrics">
        <Badge label="120 fps" tone={.Accent} />
      </Card>
      <Checkbox in={root} checked_by=>{ checked.get() } on_change={fn(v : Bool) { checked.set(v) }} label="Agree" />
      <Stepper in={root} value_by=>{ qty.get() } on_change={fn(v : Int) { qty.set(v) }} min={0} max={10} label="Qty" />
      <TextField in={root} field={name_field} placeholder="Name" label="Project" clearable />
      <SearchBar in={root} field={search_field} placeholder="Search docs" />
      <Disclosure in={root} title="Advanced" open_by=>{ disc_open.get() } on_toggle={fn(v : Bool) { disc_open.set(v) }}>
        <Badge label="Details" tone={.Neutral} />
      </Disclosure>
      <Toast in={root} visible_by=>{ toast_on.get() } title="Saved" status={.Info} />
      <Dialog in={root} open_by=>{ dlg_open.get() } on_close=>{ dlg_open.set(false) } title="Confirm" text="Proceed?" />
      <Sheet in={root} open_by=>{ sheet_open.get() } on_close=>{ sheet_open.set(false) } title="Share">
        <Badge label="Sheet Body" tone={.Neutral} />
      </Sheet>
      <Drawer in={root} open_by=>{ drawer_open.get() } on_close=>{ drawer_open.set(false) } title="Inspector" side={.Trailing}>
        <Badge label="Drawer Body" tone={.Neutral} />
      </Drawer>
    },
    width=800.0,
    height=900.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_no_nested_glass(t, label="jsx_all_components")
  // Open each overlay independently and verify zero nested glass
  dlg_open.set(true)
  t.frame()
  assert_no_nested_glass(t, label="jsx_dialog_open")
  dlg_open.set(false)
  sheet_open.set(true)
  t.frame()
  assert_no_nested_glass(t, label="jsx_sheet_open")
  sheet_open.set(false)
  drawer_open.set(true)
  t.frame()
  assert_no_nested_glass(t, label="jsx_drawer_open")
  t.dispose()
}

test "jsx: single-prop into Live[T] + bare bool + backward-compat *_by" {
  let title = signals::signal("Workspace")
  let title_ro : signals::ReadSignal[String] = title.read()
  let pct = signals::signal(42)
  let active = signals::signal(false)
  let dis = signals::signal(false)
  let wifi = signals::signal(true)
  let vol = signals::signal(60.0)
  let tab = signals::signal(0)
  let qty = signals::signal(2)
  let code = signals::signal("let x = 1")
  let clicks = ui::ref_new(0)
  let locked_clicks = ui::ref_new(0)
  let field = ui::Field::new(text="")

  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit {
      let _ = root.pad_all(12.0).gap_px(10.0)
      <NavBar in={root} title={title_ro} subtitle=>{"Live \{pct.get()}%"} />
      <Panel in={root} gap={8.0} label={title}>
        <Badge label=>{"Done: \{pct.get()}"} tone={.Accent} dot />
        <Badge label={title} tone={.Neutral} />
        <Badge label={.Is("RawBadge")} tone={.Success} />
        <Badge label="ignored" label_by=>{"Legacy: \{pct.get()}"} tone={.Neutral} />
        <CountBadge count={pct} tone={.Danger} />
        <Button
          flat
          label="Run"
          active={active}
          disabled={dis}
          on_press=>{ clicks.v = clicks.v + 1 }
        />
        <Button
          flat
          label="DisabledBtn"
          disabled
          on_press=>{ locked_clicks.v = locked_clicks.v + 1 }
        />
        <Toggle on={wifi} on_change={fn(v : Bool) { wifi.set(v) }} label="Wi-Fi" />
        <Slider value={vol} on_change={fn(v : Double) { vol.set(v) }} label="Volume" min={0.0} max={100.0} />
        <Stepper value={qty} on_change={fn(v : Int) { qty.set(v) }} min={0} max={10} label="Qty" flat />
        <CodeBlock code={code} lang="pion" max_height={80.0} />
        <Icon kind={.Search} size={16.0} color=>{surface().accent} />
      </Panel>
      <Segmented in={root} labels={["A", "B"]} selected={tab} on_select={fn(i : Int) { tab.set(i) }} width={200.0} />
      <ComposerBar in={root} field={field} placeholder={title} label="Compose" />
    },
    width=720.0,
    height=760.0,
    scale=2.0,
    theme=ui_theme,
  )
  t.frame()
  assert_no_nested_glass(t, label="jsx_into_initial")
  debug_assert(t.find("Done: 42").is_some(), "Badge into closure initial")
  debug_assert(t.find("RawBadge").is_some(), "Badge explicit .Is(...)")
  debug_assert(t.find("Legacy: 42").is_some(), "Badge legacy label_by precedence")

  t.press("Run")
  debug_assert(clicks.v == 1, "Button with into disabled=Signal fires when false")
  t.press("DisabledBtn")
  debug_assert(locked_clicks.v == 0, "Button with bare `disabled` ignores press")

  title.set("Updated")
  pct.set(99)
  active.set(true)
  dis.set(true)
  code.set("let x = 2")
  t.frame()
  assert_no_nested_glass(t, label="jsx_into_updated")
  debug_assert(t.find("Done: 99").is_some(), "Badge into closure updated")
  debug_assert(t.find("Legacy: 99").is_some(), "Badge legacy label_by updated")
  t.press("Run")
  debug_assert(clicks.v == 1, "Button with into disabled=Signal blocks press after set(true)")
  t.dispose()
}
