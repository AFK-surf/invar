// Single-layer Liquid Glass floating editing bar (`lg_edit_bar`, `lg_field_edit_bar`, `<lg::EditBar>`).
// Reuses `lg_capsule_glass()` via `lg_apply_glass_surface` (zero nested glass, obeys Law 2).
// Inner action buttons are flat/ghost with 1pt vertical hairline dividers strictly between adjacent items.

import "dmath"
import "headless"
import "headless_core"
import "ui"
import "view"

/// Default floating editing bar height (capsule radius = height / 2.0 = 19.0pt).
pub let edit_bar_height : Double = 38.0

/// One action item inside a floating editing bar.
pub struct EditBarItem {
  pub label : String
  pub on_press : () -> Unit
}

pub fn edit_bar_item(label : String, on_press : () -> Unit) -> EditBarItem {
  EditBarItem::{ label, on_press }
}

/// Compute clamped floating editing bar coordinates `(x, y, flipped_below)` relative to an anchor selection/caret rect.
/// Places the bar centered above the anchor with `gap`, flipping below when top headroom is insufficient.
pub fn lg_edit_bar_placement(
  anchor_x : Double,
  anchor_y : Double,
  anchor_w : Double,
  anchor_h : Double,
  bar_w : Double,
  bar_h : Double,
  viewport_w : Double,
  viewport_h : Double,
  margin~ : Double = 10.0,
  gap~ : Double = 10.0,
) -> (Double, Double, Bool) {
  let anchor = headless_core::Rect::new(anchor_x, anchor_y, anchor_w, anchor_h)
  let viewport = headless_core::Rect::new(0.0, 0.0, viewport_w, viewport_h)
  let (x, y, side) = headless_core::anchor_place(
    anchor,
    bar_w,
    bar_h,
    viewport,
    side=headless_core::AnchorSide::Above,
    align=headless_core::AnchorAlign::Center,
    gap=gap,
    pad=margin,
    flip=true,
  )
  let flipped_below = match side {
    headless_core::AnchorSide::Below => true
    _ => false
  }
  (x, y, flipped_below)
}

/// Mount a single-layer Liquid Glass floating editing bar (`剪切 | 复制 | 粘贴 | 全选` etc.).
/// All inner buttons are flat (zero nested glass), separated by hairline dividers strictly between items.
pub fn lg_edit_bar(
  parent : view::View,
  items : Array[EditBarItem],
  height~ : Double = edit_bar_height,
  pad_x~ : Double = 5.0,
  item_pad_x~ : Double = 12.0,
  font_size~ : Double = 13.0,
  label~ : String = "Edit bar",
  loc~ : String = "",
) -> view::View {
  headless::toolbar(parent, fn() { label }, loc=loc, fn(bar : view::View, tb : headless::Toolbar) -> Unit {
    let r = height * 0.5
    let inner_h = dmath::max(24.0, height - 6.0)
    let inner_r = inner_h * 0.5
    let _ = bar
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(height)))
    .radius(view::Live::Is(r))
    .padding(view::Live::Is((pad_x, 3.0, pad_x, 3.0)))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .shrink(view::Live::Is(0.0))
    .clips(view::Live::Is(true))
    .edge(view::Live::By(fn() { if bar.glass_solid() || ui::glass_solid() { lg_solid_edge() } else { (0.0, clear) } }))
    .lends(surface_context_lent, SurfaceContext::Content)
    lg_apply_glass_surface(bar, fn() { lg_capsule_glass() }, shadow_by=lg_bar_pill_shadow)

    let look = view::WordsLook::of(font_size, weight=500, line=18.0, wrap=false)
    let n = items.length()
    for i in 0..<n {
      if i > 0 {
        // Hairline divider strictly between adjacent buttons (zero leading/trailing/double dividers).
        let _ = bar.box(fn(sep : view::View) {
          let _ = sep
          .width(view::Live::Is(Some(1.0)))
          .height(view::Live::Is(Some(14.0)))
          .ground(view::Live::By(fn() { if is_dark() { 0xFFFFFF26L } else { 0x0000001CL } }))
          .presses(view::Live::Is(false))
        })
      }
      let item = items[i]
      let _ = tb.item(
        bar,
        fn() { item.label },
        fn(_n : view::View) -> Unit { (item.on_press)() },
        loc=loc,
        fn(btn : view::View, b : headless::Button) -> Unit {
          let _ = btn
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(inner_h)))
          .padding(view::Live::Is((item_pad_x, 0.0, item_pad_x, 0.0)))
          .radius(view::Live::Is(inner_r))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .cursor(view::Live::Is(Some(view::Cursor::Hand)))
          .ground(
            view::Live::By(fn() {
              if b.pressed() {
                if is_dark() { 0xFFFFFF28L } else { 0x00000018L }
              } else if b.hovered() {
                if is_dark() { 0xFFFFFF16L } else { 0x0000000CL }
              } else {
                clear
              }
            }),
          )
          lg_focus_ring(btn, fn() { b.focus_shown() }, inner_r)
          let _ = btn.box(fn(lbl : view::View) {
            let _ = lbl
            .words(view::Live::Is(item.label), ink=colors().content, look=look)
            .ink(view::Live::By(fn() { colors().content }))
            .presses(view::Live::Is(false))
          })
        },
      )
    }
  })
}

/// Build a single-layer Liquid Glass editing bar directly bound to `fld : ui::Field`'s available actions.
pub fn lg_field_edit_bar(
  parent : view::View,
  fld : ui::Field,
  zh~ : Bool = true,
  height~ : Double = edit_bar_height,
  loc~ : String = "",
) -> view::View {
  let actions = fld.edit_menu_actions()
  let items : Array[EditBarItem] = []
  for act in actions {
    let lbl = if zh {
      match act {
        ui::EditAction::Cut => "剪切"
        ui::EditAction::Copy => "复制"
        ui::EditAction::Paste => "粘贴"
        ui::EditAction::SelectAll => "全选"
      }
    } else {
      match act {
        ui::EditAction::Cut => "Cut"
        ui::EditAction::Copy => "Copy"
        ui::EditAction::Paste => "Paste"
        ui::EditAction::SelectAll => "Select All"
      }
    }
    items.push(edit_bar_item(lbl, fn() { fld.perform_edit_action(act) }))
  }
  lg_edit_bar(parent, items, height=height, loc=loc)
}

/// Pion-JSX PascalCase wrapper `<lg::EditBar>` delegating to `lg_edit_bar`.
pub fn EditBar(
  parent : view::View,
  items~ : Array[EditBarItem] = [],
  height~ : Double = edit_bar_height,
  pad_x~ : Double = 5.0,
  item_pad_x~ : Double = 12.0,
  font_size~ : Double = 13.0,
  label~ : String = "Edit bar",
  loc~ : String = "",
) -> view::View {
  lg_edit_bar(
    parent,
    items,
    height=height,
    pad_x=pad_x,
    item_pad_x=item_pad_x,
    font_size=font_size,
    label=label,
    loc=loc,
  )
}
