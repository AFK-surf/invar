// Unit tests for `lg_edit_bar`, `lg_field_edit_bar`, `<lg::EditBar>`, placement flip, and zero-nested-glass gate.

import "ui"
import "view"

test "lg_edit_bar: single-layer glass, zero nested glass, and button press dispatch" {
  let clicked = ui::ref_new("")
  let t = lg_case(fn(p : view::View) {
    let _ = EditBar(
      p,
      items=[
        edit_bar_item("剪切", fn() { clicked.v = "cut" }),
        edit_bar_item("复制", fn() { clicked.v = "copy" }),
        edit_bar_item("粘贴", fn() { clicked.v = "paste" }),
        edit_bar_item("全选", fn() { clicked.v = "all" }),
      ],
    )
  })

  // Law 2: exactly 1 Liquid Glass capsule, zero nested glass
  assert_no_nested_glass(t, label="lg_edit_bar")
  debug_assert(count_liquid_glass(t) == 1, "edit bar must emit exactly 1 single-layer liquid glass surface")

  // Tap "Copy" button
  let copy_d = require_drawn(t, "复制", view::Role::Button)
  t.tap(copy_d.x + copy_d.w * 0.5, copy_d.y + copy_d.h * 0.5)
  debug_assert(clicked.v == "copy", "tapping 复制 invoked copy callback")

  // Tap "Select All" button
  let all_d = require_drawn(t, "全选", view::Role::Button)
  t.tap(all_d.x + all_d.w * 0.5, all_d.y + all_d.h * 0.5)
  debug_assert(clicked.v == "all", "tapping 全选 invoked select-all callback")
  t.dispose()
}

test "lg_edit_bar_placement: clamps horizontally and flips below near top edge" {
  // Sufficient headroom -> sits above anchor
  let (x0, y0, flip0) = lg_edit_bar_placement(200.0, 140.0, 100.0, 24.0, 220.0, 38.0, 520.0, 340.0)
  debug_assert(!flip0, "sits above anchor when headroom >= margin")
  debug_assert((x0 - 140.0).abs() < 0.01 && (y0 - 92.0).abs() < 0.01, "centered above anchor")

  // Near top edge -> flips below anchor and clamps left edge to margin
  let (x1, y1, flip1) = lg_edit_bar_placement(10.0, 20.0, 40.0, 24.0, 220.0, 38.0, 520.0, 340.0)
  debug_assert(flip1, "flips below anchor when top headroom insufficient")
  debug_assert((x1 - 10.0).abs() < 0.01 && (y1 - 54.0).abs() < 0.01, "clamped to left margin and placed below anchor")
}

test "lg_field_edit_bar: drives Field copy/cut/paste/select_all with zero nested glass" {
  let fld = ui::Field::new(text="hello world")
  fld.pick(0, 5)
  let t = lg_case(fn(p : view::View) {
    let _ = lg_field_edit_bar(p, fld, zh=true)
  })
  assert_no_nested_glass(t, label="lg_field_edit_bar")
  debug_assert(count_liquid_glass(t) == 1, "field edit bar uses single-layer glass")

  let copy_d = require_drawn(t, "复制", view::Role::Button)
  t.tap(copy_d.x + copy_d.w * 0.5, copy_d.y + copy_d.h * 0.5)
  debug_assert(t.clipboard() == "hello", "lg_field_edit_bar 复制 wrote clipboard")
  t.dispose()
}
