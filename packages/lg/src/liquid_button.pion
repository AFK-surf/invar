// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidButton.kt.

import "headless"
import "motion"
import "ui"
import "view"

/// `top` laid over `base` (source over).
pub fn over(base : Int64, top : Int64) -> Int64 {
  let ta = (top & 0xFFL).to_double() / 255.0
  let ba = (base & 0xFFL).to_double() / 255.0
  let oa = ta + ba * (1.0 - ta)
  if oa <= 0.0 {
    return clear
  }
  let ch = fn(shift : Int) -> Int64 {
    let t = ((top >> shift) & 0xFFL).to_double()
    let b = ((base >> shift) & 0xFFL).to_double()
    let v = ((t * ta + b * ba * (1.0 - ta)) / oa).round().to_int64()
    if v < 0L { 0L } else if v > 255L { 255L } else { v }
  }
  (ch(24) << 24) | (ch(16) << 16) | (ch(8) << 8) | (oa * 255.0).round().to_int64()
}

fn stretched(w : Double, h : Double, dx : Double, dy : Double, sx : Double, sy : Double) -> view::GroundShape {
  if w <= 0.0 || h <= 0.0 || (dx == 0.0 && dy == 0.0 && sx == 1.0 && sy == 1.0) {
    return view::ground_as_laid
  }
  let dw = w * (sx - 1.0)
  let dh = h * (sy - 1.0)
  let r = (h + dh) / 2.0
  view::GroundShape::{ dx: dx - dw / 2.0, dy: dy - dh / 2.0, dw, dh, corners: Some((r, r, r, r)) }
}

pub fn liquid_button_node(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  content? : (view::View) -> Unit,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  flat~ : Bool = false,
  interactive~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  light? : InteractiveHighlight,
  height~ : Double = button_h,
  pad_x~ : Double = button_px,
  active~ : () -> Bool = fn() { false },
  ghost~ : Bool = false,
  neutral_active~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, disabled=disabled, fn(b : view::View, btn : headless::Button) -> Unit {
    let hl = match light {
      Some(l) => l
      None => InteractiveHighlight::new()
    }
    hl.attach(b)
    let r = height / 2.0
    let label_sz = if height <= 32.0 { 13.0 } else if height <= 36.0 { 14.0 } else { 15.0 }
    let is_neutral_active = fn() -> Bool { neutral_active && tint == clear && active() }
    let neutral_active_bg = fn() -> Int64 { if is_dark() { 0xFFFFFF22L } else { 0x00000016L } }
    let eff_tint = fn() -> Int64 {
      if tint != clear {
        tint
      } else if active() && !neutral_active {
        ctrl_chip_selected_tint()
      } else {
        clear
      }
    }
    let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(height)))
      .padding(view::Live::Is((pad_x, 0.0, pad_x, 0.0)))
      .radius(view::Live::Is(r))
      .ground_drawn(view::Live::By(fn() {
        if !interactive {
          return view::ground_as_laid
        }
        let (w, h) = hl.size.get()
        let (dx, dy, sx, sy) = hl.stretch(b)
        stretched(w, h, dx, dy, sx, sy)
      }))
      .alpha(view::Live::By(fn() { if btn.disabled() { 0.5 } else { 1.0 } }))
    if flat && ghost {
      let hover_t = motion::hover_fade(b, fn() { btn.hovered() && !btn.disabled() })
      let press_t = motion::hover_fade(b, fn() { btn.pressed() && !btn.disabled() }, duration_ms=motion::pointer_tap_ms)
      let _ = b.ground(view::Live::By(fn() {
        let t = eff_tint()
        if t != clear {
          t
        } else {
          let base = if is_neutral_active() { neutral_active_bg() } else { clear }
          let h = hover_t()
          let p = press_t()
          let with_h = if h > 0.001 { over(base, alpha(ovl_row_hover(), h)) } else { base }
          if p > 0.001 { over(with_h, alpha(ovl_row_press(), p)) } else { with_h }
        }
      }))
    } else if flat {
      let _ = b
        .ground(view::Live::By(fn() {
          let t = eff_tint()
          if t != clear {
            t
          } else if is_neutral_active() {
            neutral_active_bg()
          } else if surface != clear {
            surface
          } else if is_dark() {
            0xFFFFFF22L
          } else {
            0x00000012L
          }
        }))
        .edge(view::Live::By(fn() {
          if eff_tint() != clear {
            (0.0, clear)
          } else if is_dark() {
            (0.5, 0xFFFFFF24L)
          } else {
            (0.5, 0x0000001AL)
          }
        }))
    } else {
      lg_apply_glass_surface(b, fn() {
        let surf = if is_neutral_active() { neutral_active_bg() } else { surface }
        lg_capsule_glass(tint=eff_tint(), surface=surf)
      })
    }
    lg_focus_ring(b, fn() { btn.focus_shown() }, r)
    if interactive {
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit { hl.down(d.x, d.y, d.w, d.h) },
        tap=fn(_d : view::Drag) -> Unit {
          hl.up()
          btn.press()
        },
        drag=fn(d : view::Drag) -> Unit {
          match d.kind {
            Down => hl.moved(d.x, d.y)
            Moved => hl.moved(d.x, d.y)
            Up => {
              hl.up()
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => hl.up()
          }
        },
      )
      let _ = b.box(fn(ov : view::View) -> Unit {
        let _ = ov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(r))
          .ground(view::Live::Is(white))
          .alpha(view::Live::By(fn() {
            if flat && ghost && eff_tint() == clear {
              0.0
            } else {
              clamp(hl.pressed(ov), 0.0, 1.0) * 0.14
            }
          }))
          .ground_drawn(view::Live::By(fn() {
            let (w, h) = hl.size.get()
            let (dx, dy, sx, sy) = hl.stretch(ov)
            stretched(w, h, dx, dy, sx, sy)
          }))
      })
    }
    let _ = b.box(fn(c : view::View) -> Unit {
      let _ = c
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(button_gap))
        .offset(view::Live::By(fn() {
          if interactive {
            let (dx, dy, _, _) = hl.stretch(b)
            (dx, dy)
          } else {
            (0.0, 0.0)
          }
        }))
        .scale(view::Live::By(fn() {
          if interactive {
            let (_, _, sx, sy) = hl.stretch(b)
            (sx + sy) / 2.0
          } else {
            1.0
          }
        }))
      match content {
        Some(f) => f(c)
        None => {
          let _ = c.box(fn(w : view::View) -> Unit {
            let _ = w
              .words(view::Live::By(label), look=words_at(label_sz))
              .ink(view::Live::By(fn() { if eff_tint() != clear { white } else { colors().content } }))
          })
        }
      }
    })
  })
}
