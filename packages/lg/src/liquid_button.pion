// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidButton.kt. A capsule of glass 48 high,
// 16 in at each side, what it holds 8 apart in its middle: what is under it made vivid (vibrancy, a saturation of 1.5),
// blurred by 2 and bent along its rim by a lens 12 deep moving it by up to 24; its tint laid on by hue first, then at
// 75%; its surface colour over that; Backdrop's default highlight and shadow. Interactive (the catalog's default), a
// finger on it lights it where it is (InteractiveHighlight) and stretches it along the way it drags. What it is to the
// hand, the keys and a screen reader is mbui's headless button's: a press, Enter or Space, Activate.

import "headless"
import "paint"
import "ui"
import "view"

/// The glass of a LiquidButton (iOS 27 liquid glass): `press` how far a finger holds it, at `spot` (points from its top
/// left); `tint` and `surface` its colours (clear: none).
fn button_glass(press : Double, spot : Option[(Double, Double)], tint : Int64, surface : Int64) -> paint::Glass {
  let d = is_dark()
  let tinted = tint != clear
  let glass_tint = if tinted {
    alpha(tint, 0.75)
  } else if d {
    0x202020FFL
  } else {
    0xFDFCFD67L
  }
  let solid = if tinted {
    tint
  } else if surface != clear {
    over(colors().dialog_container, surface)
  } else if d {
    0x1E1F24FFL
  } else {
    0xFAFAFAFFL
  }
  let sp = if press > 0.01 { spot } else { None }
  paint::Glass::liquid(
    blur=2.1,
    tint=glass_tint,
    solid=solid,
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=24.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
    spot?=sp,
  )
}

/// `top` laid over `base` (source over).
pub fn over(base : Int64, top : Int64) -> Int64 {
  let ta = (top & 0xFFL).to_double() / 255.0
  let ba = (base & 0xFFL).to_double() / 255.0
  let oa = ta + ba * (1.0 - ta)
  if oa <= 0.0 {
    return clear
  }
  let ch = fn(shift : Int) -> Int64 {
    let t = ((top >> shift) & 0xFFL).to_double()
    let b = ((base >> shift) & 0xFFL).to_double()
    let v = ((t * ta + b * ba * (1.0 - ta)) / oa).round().to_int64()
    if v < 0L { 0L } else if v > 255L { 255L } else { v }
  }
  (ch(24) << 24) | (ch(16) << 16) | (ch(8) << 8) | (oa * 255.0).round().to_int64()
}

/// A glass ground drawn moved by (`dx`, `dy`) and `sx` × `sy` times as large about its middle, a capsule still, for a
/// box laid out `w` × `h`.
fn stretched(w : Double, h : Double, dx : Double, dy : Double, sx : Double, sy : Double) -> view::GroundShape {
  if w <= 0.0 || h <= 0.0 || (dx == 0.0 && dy == 0.0 && sx == 1.0 && sy == 1.0) {
    return view::ground_as_laid
  }
  let dw = w * (sx - 1.0)
  let dh = h * (sy - 1.0)
  let r = (h + dh) / 2.0
  view::GroundShape::{ dx: dx - dw / 2.0, dy: dy - dh / 2.0, dw, dh, corners: Some((r, r, r, r)) }
}

/// A LiquidButton in `parent`, read out a button named `label`; pressed (by a tap, Enter or Space, a screen reader's
/// Activate), `press` is called. What it holds is `content`'s (by default its `label` in the catalog's 15 point words:
/// white where it is tinted, else the words' colour: the catalog's black, white in the dark). `tint`: its colour laid
/// on by hue and at 75% (clear: none); `surface`: a colour over its glass (clear: none); `interactive`: lit and
/// stretched by a finger on it. The node.
pub fn liquid_button_node(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  content? : (view::View) -> Unit,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  interactive~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  light? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  headless::button(parent, label, fn(_v) { press() }, fn(b, btn) {
    let lh = match light {
      Some(l) => l
      None => InteractiveHighlight::new()
    }
    lh.attach(b)
    let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(button_h)))
      .padding(view::Live::Is((button_px, 0.0, button_px, 0.0)))
      .radius(view::Live::Is(button_h / 2.0))
      .shadow(view::Live::Is(shadow_default))
      .glass(view::Live::By(fn() {
        let p = if interactive { lh.pressed(b) } else { 0.0 }
        let (w, h) = lh.size.get()
        Some(button_glass(p, if p > 0.0 { Some(lh.spot(b, w, h)) } else { None }, tint, surface))
      }))
      .ground_drawn(view::Live::By(fn() {
        if !interactive {
          return view::ground_as_laid
        }
        let (w, h) = lh.size.get()
        let (dx, dy, sx, sy) = lh.stretch(b)
        stretched(w, h, dx, dy, sx, sy)
      }))
      .alpha(view::Live::By(fn() { if btn.disabled() { 0.5 } else { 1.0 } }))
    if interactive {
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d) { lh.down(d.x, d.y, d.w, d.h) },
        tap=fn(_d) {
          lh.up()
          btn.press()
        },
        drag=fn(d) {
          match d.kind {
            view::DragIs::Down => lh.moved(d.x, d.y)
            view::DragIs::Moved => lh.moved(d.x, d.y)
            view::DragIs::Up => {
              lh.up()
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            view::DragIs::Off => lh.up()
          }
        },
      )
    }
    let _ = b.box(fn(c) {
      let _ = c
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(button_gap))
        .offset(view::Live::By(fn() {
          if interactive {
            let (dx, dy, _, _) = lh.stretch(b)
            (dx, dy)
          } else {
            (0.0, 0.0)
          }
        }))
        .scale(view::Live::By(fn() {
          if interactive {
            let (_, _, sx, sy) = lh.stretch(b)
            (sx + sy) / 2.0
          } else {
            1.0
          }
        }))
      match content {
        Some(f) => f(c)
        None => {
          let _ = c.box(fn(w) {
            let _ = w
              .words(view::Live::By(label), look=words_at(15.0))
              .ink(view::Live::By(fn() { if tint != clear { white } else { colors().content } }))
          })
        }
      }
    })
  }, disabled=disabled, made_for=loc)
}
