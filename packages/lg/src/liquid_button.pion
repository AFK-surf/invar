// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidButton.kt.

import "headless"
import "motion"
import "ui"
import "view"

/// `top` laid over `base` (source over).
pub fn over(base : Int64, top : Int64) -> Int64 {
  let ta = (top & 0xFFL).to_double() / 255.0
  let ba = (base & 0xFFL).to_double() / 255.0
  let oa = ta + ba * (1.0 - ta)
  if oa <= 0.0 {
    return clear
  }
  let ch = fn(shift : Int) -> Int64 {
    let t = ((top >> shift) & 0xFFL).to_double()
    let b = ((base >> shift) & 0xFFL).to_double()
    let v = ((t * ta + b * ba * (1.0 - ta)) / oa).round().to_int64()
    if v < 0L { 0L } else if v > 255L { 255L } else { v }
  }
  (ch(24) << 24) | (ch(16) << 16) | (ch(8) << 8) | (oa * 255.0).round().to_int64()
}

fn stretched(w : Double, h : Double, dx : Double, dy : Double, sx : Double, sy : Double) -> view::GroundShape {
  if w <= 0.0 || h <= 0.0 || (dx == 0.0 && dy == 0.0 && sx == 1.0 && sy == 1.0) {
    return view::ground_as_laid
  }
  let dw = w * (sx - 1.0)
  let dh = h * (sy - 1.0)
  let r = (h + dh) / 2.0
  view::GroundShape::{ dx: dx - dw / 2.0, dy: dy - dh / 2.0, dw, dh, corners: Some((r, r, r, r)) }
}

pub fn liquid_button_node(
  parent : view::View,
  label : () -> String,
  press : () -> Unit,
  content? : (view::View) -> Unit,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  flat? : Bool,
  prominent~ : Bool = false,
  interactive~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  light? : InteractiveHighlight,
  height? : Double,
  pad_x~ : Double = button_px,
  px? : Double,
  sharing~ : Bool = false,
  active~ : () -> Bool = fn() { false },
  ghost~ : Bool = false,
  neutral_active~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let is_flat = is_flat_in(parent, flat)
  let height = match height {
    Some(h) => h
    None => if is_flat { button_h } else { 36.0 }
  }
  let eff_px = match px {
    Some(v) => v
    None => pad_x
  }
  let hit_h = dmax(height, 36.0)
  let hit_out = (hit_h - height) / 2.0
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, disabled=disabled, fn(b : view::View, btn : headless::Button) -> Unit {
    let hl = match light {
      Some(l) => l
      None => InteractiveHighlight::new()
    }
    hl.attach(b)
    let press_way = motion::NodeWay::new(0.0)
    let r = height / 2.0
    let label_sz = if height <= 32.0 { 13.0 } else if height <= 36.0 { 15.0 } else { 16.0 }
    let is_neutral_active = fn() -> Bool { neutral_active && !prominent && tint == clear && active() }
    let neutral_active_bg = fn() -> Int64 { if is_dark() { 0xFFFFFF22L } else { 0x00000016L } }
    let eff_tint = fn() -> Int64 {
      if tint != clear {
        tint
      } else if prominent {
        colors().accent
      } else if active() && !neutral_active {
        ctrl_chip_selected_tint()
      } else {
        clear
      }
    }
    let _ = b
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .height(view::Live::Is(Some(hit_h)))
    .alpha(view::Live::By(fn() { if btn.disabled() { 0.5 } else { 1.0 } }))
    if hit_out > 0.0 {
      let _ = b.margin(view::Live::Is((0.0, -hit_out, 0.0, -hit_out)))
    } else {
      let _ = b.radius(view::Live::Is(r))
    }
    if interactive {
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit {
          hl.down(d.x, d.y, d.w, d.h)
          press_way.go(b, 1.0, motion::backdrop_press_spring)
        },
        tap=fn(_d : view::Drag) -> Unit {
          hl.up()
          press_way.go(b, 0.0, motion::backdrop_press_spring)
          btn.press()
        },
        drag=fn(d : view::Drag) -> Unit {
          match d.kind {
            Down => hl.moved(d.x, d.y)
            Moved => hl.moved(d.x, d.y)
            Up => {
              hl.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => {
              hl.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
            }
          }
        },
      )
    }
    let _ = b.box(fn(pill : view::View) -> Unit {
      let _ = pill
      .grow(view::Live::Is(1.0))
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(height)))
      .padding(view::Live::Is((eff_px, 0.0, eff_px, 0.0)))
      .radius(view::Live::Is(r))
      .scale(
        view::Live::By(fn() {
          if !interactive || ui::reduced_motion() {
            1.0
          } else {
            lerp(1.0, 0.97, clamp(press_way.shown(pill), 0.0, 1.0))
          }
        }),
        about=view::Pivot::At(0.5, 0.5),
      )
      if is_flat && ghost {
        let hover_t = motion::hover_fade(b, fn() { btn.hovered() && !btn.disabled() })
        let press_t = motion::hover_fade(b, fn() { btn.pressed() && !btn.disabled() }, duration_ms=motion::pointer_tap_ms)
        let _ = pill.ground(view::Live::By(fn() {
          let h = hover_t()
          let p = press_t()
          let t = eff_tint()
          if prominent {
            let base = if tint != clear { tint } else { ctrl_flat_selected_fill() }
            let with_h = if h > 0.001 { over(base, alpha(0xFFFFFF18L, h)) } else { base }
            if p > 0.001 { over(with_h, alpha(0x00000024L, p)) } else { with_h }
          } else if t != clear {
            let with_h = if h > 0.001 { over(t, alpha(0xFFFFFF18L, h)) } else { t }
            if p > 0.001 { over(with_h, alpha(0x00000024L, p)) } else { with_h }
          } else {
            let base = if is_neutral_active() { neutral_active_bg() } else { clear }
            let with_h = if h > 0.001 { over(base, alpha(ovl_row_hover(), h)) } else { base }
            if p > 0.001 { over(with_h, alpha(ovl_row_press(), p)) } else { with_h }
          }
        }))
      } else if is_flat {
        let hover_t = motion::hover_fade(b, fn() { btn.hovered() && !btn.disabled() })
        let press_t = motion::hover_fade(b, fn() { btn.pressed() && !btn.disabled() }, duration_ms=motion::pointer_tap_ms)
        let _ = pill
        .ground(view::Live::By(fn() {
          let h = hover_t()
          let p = press_t()
          let t = eff_tint()
          if prominent {
            let base = if tint != clear { tint } else { ctrl_flat_selected_fill() }
            let with_h = if h > 0.001 { over(base, alpha(0xFFFFFF18L, h)) } else { base }
            if p > 0.001 { over(with_h, alpha(0x00000024L, p)) } else { with_h }
          } else if t != clear {
            let with_h = if h > 0.001 { over(t, alpha(0xFFFFFF18L, h)) } else { t }
            if p > 0.001 { over(with_h, alpha(0x00000024L, p)) } else { with_h }
          } else {
            let base = if is_neutral_active() {
              neutral_active_bg()
            } else if surface != clear {
              surface
            } else {
              ctrl_flat_fill()
            }
            let with_h = if h > 0.001 { over(base, alpha(ctrl_flat_hover(), h)) } else { base }
            if p > 0.001 { over(with_h, alpha(ctrl_flat_press(), p)) } else { with_h }
          }
        }))
        .edge(view::Live::By(fn() {
          if prominent || eff_tint() != clear {
            (0.0, clear)
          } else {
            ctrl_flat_edge()
          }
        }))
      } else {
        let _ = pill
        .shadow(view::Live::By(glass_control_shadow))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() {
          let surf = if is_neutral_active() { neutral_active_bg() } else { surface }
          let sp = if interactive && hl.pressed(pill) > 0.001 {
            let (w, h) = hl.size.get()
            if w > 0.0 && h > 0.0 {
              Some(hl.spot(pill, w, h))
            } else {
              None
            }
          } else {
            None
          }
          let t = eff_tint()
          if prominent || t != clear {
            let acc = prominent_accent_fill(if t != clear { t } else { colors().accent })
            Some(liquid_prominent_glass(accent=acc, spot?=sp, solid=acc, sharing=sharing))
          } else {
            Some(liquid_control_glass(tint=clear, surface=surf, bezel=14.0, refraction=18.0, spot?=sp, sharing=sharing))
          }
        }))
        .edge(view::Live::By(fn() { if pill.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) } }))
      }
      lg_focus_ring(pill, fn() { btn.focus_shown() }, r)
      if interactive {
        let _ = pill.box(fn(ov : view::View) -> Unit {
          let _ = ov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(r))
          .ground(view::Live::By(fn() { liquid_press_ink(solid=pill.glass_solid() || ui::glass_solid()) }))
          .alpha(view::Live::By(fn() {
            if is_flat {
              0.0
            } else {
              clamp(press_way.shown(ov), 0.0, 1.0)
            }
          }))
        })
      }
      let _ = pill.box(fn(c : view::View) -> Unit {
        let _ = c
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(button_gap))
        match content {
          Some(f) => f(c)
          None => {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::By(label), look=words_at(label_sz))
              .ink(view::Live::By(fn() { if prominent || eff_tint() != clear { white } else { colors().content } }))
            })
          }
        }
      })
    })
  })
}
