// Apple iOS 26 TabBarMinimizeBehavior scroll-collapsing floating liquid glass bottom tab bar.

import "headless"
import "motion"
import "signals"
import "view"

let ctab_h : Double = 50.0
let ctab_r : Double = 25.0
let ctab_gap : Double = 10.0
let ctab_pad : Double = 4.0

fn ctab_smoothstep(lo : Double, hi : Double, x : Double) -> Double {
  if hi <= lo {
    return if x >= hi { 1.0 } else { 0.0 }
  }
  let u = clamp((x - lo) / (hi - lo), 0.0, 1.0)
  u * u * (3.0 - 2.0 * u)
}

fn ctab_active_ink() -> Int64 {
  if is_dark() { 0x40A9FFFFL } else { 0x0066CCFFL }
}

fn ctab_initial(name : String) -> String {
  if name.length() > 0 { name.slice(0, 1) } else { "•" }
}

fn clamp_int(v : Int, lo : Int, hi : Int) -> Int {
  if v < lo { lo } else if v > hi { hi } else { v }
}

pub fn liquid_collapsible_tabs_node(
  parent : view::View,
  tabs : Array[String],
  chosen : () -> Int,
  choose : (Int) -> Unit,
  minimized : () -> Bool,
  on_expand : () -> Unit,
  on_action : () -> Unit,
  action_label~ : () -> String = fn() { "Search" },
  action_icon? : (view::View, () -> Int64) -> Unit,
  faces? : Array[(view::View, () -> Int64) -> Unit],
  compact_icons? : Array[(view::View, () -> Int64) -> Unit],
  label~ : String = "Navigation",
  expanded_width~ : Double = 320.0,
  loc~ : String = "",
) -> view::View {
  let n = tabs.length()
  let bar_w = if expanded_width < ctab_h * 2.0 { ctab_h * 2.0 } else { expanded_width }
  let total_w = bar_w + ctab_gap + ctab_h
  let min_way = motion::NodeWay::new(if signals::untracked(minimized) { 1.0 } else { 0.0 })
  let action_press = motion::NodeWay::new(0.0)
  let compact_press = motion::NodeWay::new(0.0)
  parent.box(loc=loc, fn(wrap : view::View) -> Unit {
    wrap.reacts(at_start=false, minimized, fn(m : Bool) -> Unit {
      min_way.go(wrap, if m { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    let _ = wrap.width(view::Live::Is(Some(total_w))).height(view::Live::Is(Some(ctab_h))).shrink(view::Live::Is(0.0))
    let capsule_shape = fn(node : view::View) -> view::GroundShape {
      let t = clamp(min_way.shown(node), 0.0, 1.0)
      let vw = lerp(bar_w, ctab_h, t)
      let dw = vw - bar_w
      if dw.abs() < 0.01 {
        view::ground_as_laid
      } else {
        view::GroundShape::{ dx: 0.0, dy: 0.0, dw, dh: 0.0, corners: Some((ctab_r, ctab_r, ctab_r, ctab_r)) }
      }
    }
    let _ = wrap.box(fn(shadows : view::View) -> Unit {
      let _ = shadows.over(view::Live::Is(true)).points(view::Live::Is(false))
      let _ = shadows.box(fn(tab_sh : view::View) -> Unit {
        let _ = tab_sh
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(bar_w)))
          .height(view::Live::Is(Some(ctab_h)))
          .radius(view::Live::Is(ctab_r))
          .shadow(view::Live::Is(shadow_default))
          .shadow_outside(view::Live::Is(true))
          .ground_drawn(view::Live::By(fn() { capsule_shape(tab_sh) }))
      })
      let _ = shadows.box(fn(act_sh : view::View) -> Unit {
        let _ = act_sh
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(ctab_h)))
          .height(view::Live::Is(Some(ctab_h)))
          .offset(view::Live::Is((bar_w + ctab_gap, 0.0)))
          .radius(view::Live::Is(ctab_r))
          .shadow(view::Live::Is(shadow_default))
          .shadow_outside(view::Live::Is(true))
      })
    })
    let _ = wrap.box(fn(tab_glass : view::View) -> Unit {
      let _ = tab_glass
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(bar_w)))
        .height(view::Live::Is(Some(ctab_h)))
        .radius(view::Live::Is(ctab_r))
        .glass(view::Live::By(fn() { Some(tabs_glass()) }))
        .ground_drawn(view::Live::By(fn() { capsule_shape(tab_glass) }))
    })
    let _ = wrap.box(fn(act_glass : view::View) -> Unit {
      let _ = act_glass
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(ctab_h)))
        .height(view::Live::Is(Some(ctab_h)))
        .offset(view::Live::Is((bar_w + ctab_gap, 0.0)))
        .radius(view::Live::Is(ctab_r))
        .glass(view::Live::By(fn() { Some(tabs_glass()) }))
        .scale(view::Live::By(fn() { 1.0 - 0.05 * clamp(action_press.shown(act_glass), 0.0, 1.0) }))
    })
    let _ = wrap.box(fn(fg : view::View) -> Unit {
      let _ = fg.over(view::Live::Is(true))
      let tab_indices : Array[Int] = []
      let mut k = 0
      while k < n {
        tab_indices.push(k)
        k += 1
      }
      fg.show(
        fn() { !minimized() },
        fn(exp_host : view::View) -> Unit {
          let _ = exp_host
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(bar_w)))
            .height(view::Live::Is(Some(ctab_h)))
            .padding(view::Live::Is((ctab_pad, ctab_pad, ctab_pad, ctab_pad)))
            .points(view::Live::By(fn() { !minimized() }))
            .alpha(view::Live::By(fn() { 1.0 - ctab_smoothstep(0.0, 0.45, min_way.shown(exp_host)) }))
          let _ = headless::radio_group(
            exp_host,
            fn() { label },
            chosen,
            choose,
            kind=headless::GroupKind::Tab,
            fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
              let _ = g.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).fills_across(view::Live::Is(true))
              g.each_of(fn() { tab_indices }, at_once=true, fn(row_box : view::View, i : Int) -> Unit {
                let _ = row_box.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).fills_across(view::Live::Is(true))
                let name = tabs[i]
                let face = match faces {
                  Some(fs) => if i < fs.length() { Some(fs[i]) } else { None }
                  None => None
                }
                let _ = rg.item(row_box, fn() { i }, fn() { name }, fn(t : view::View, it : headless::RadioItem) -> Unit {
                  let pill_r = (ctab_h - ctab_pad * 2.0) / 2.0
                  let _ = t
                    .grow(view::Live::Is(1.0))
                    .fills_across(view::Live::Is(true))
                    .radius(view::Live::Is(pill_r))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    .ground(view::Live::By(fn() { if it.chosen() { colors().lens_idle } else { clear } }))
                  ovl_attach_row_ground(
                    t,
                    fn() { !it.chosen() && (it.hovered() || it.focus_shown()) },
                    fn() { !it.chosen() && it.pressed() },
                  )
                  let ink = fn() -> Int64 {
                    if it.chosen() { ctab_active_ink() } else { colors().content }
                  }
                  match face {
                    Some(draw) => draw(t, ink)
                    None => {
                      let _ = t.box(fn(w : view::View) -> Unit {
                        let _ = w.words(view::Live::Is(name), look=words_at(type_tab, weight=weight_medium)).ink(view::Live::By(ink))
                      })
                    }
                  }
                  t.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
                    let _ = ring
                      .over(view::Live::Is(true))
                      .points(view::Live::Is(false))
                      .radius(view::Live::Is(pill_r))
                      .edge(view::Live::By(fn() { (2.0, colors().accent) }))
                  })
                })
              })
            },
          )
        },
        leave=220.0,
      )
      fg.show(
        fn() { minimized() },
        fn(min_host : view::View) -> Unit {
          let _ = min_host
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(ctab_h)))
            .height(view::Live::Is(Some(ctab_h)))
            .points(view::Live::By(fn() { minimized() }))
            .alpha(view::Live::By(fn() { ctab_smoothstep(0.45, 0.9, min_way.shown(min_host)) }))
          let _ = headless::button(
            min_host,
            fn() {
              let idx = clamp_int(chosen(), 0, if n > 0 { n - 1 } else { 0 })
              let active = if idx < n { tabs[idx] } else { label }
              "Expand \{active}"
            },
            fn(_e) -> Unit { on_expand() },
            fn(b : view::View, btn : headless::Button) -> Unit {
              b.reacts(at_start=false, fn() { btn.pressed() }, fn(p : Bool) -> Unit {
                compact_press.go(b, if p { 1.0 } else { 0.0 }, motion::snappy_damped)
              })
              let _ = b
                .width(view::Live::Is(Some(ctab_h)))
                .height(view::Live::Is(Some(ctab_h)))
                .radius(view::Live::Is(ctab_r))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .scale(view::Live::By(fn() { 1.0 - 0.06 * clamp(compact_press.shown(b), 0.0, 1.0) }))
              let active_ink = fn() -> Int64 { ctab_active_ink() }
              b.pick(fn() { clamp_int(chosen(), 0, if n > 0 { n - 1 } else { 0 }) }, at_once=true, fn(slot : view::View, idx : Int) -> Unit {
                let _ = slot.lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
                let drew = match compact_icons {
                  Some(icons) =>
                    if idx < icons.length() {
                      icons[idx](slot, active_ink)
                      true
                    } else {
                      false
                    }
                  None => false
                }
                if !drew {
                  let _ = slot.box(fn(w : view::View) -> Unit {
                    let glyph = if idx < n { ctab_initial(tabs[idx]) } else { "•" }
                    let _ = w.words(view::Live::Is(glyph), look=words_at(18.0, weight=weight_medium)).ink(view::Live::By(active_ink))
                  })
                }
              })
              b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
                let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .radius(view::Live::Is(ctab_r))
                  .edge(view::Live::By(fn() { (2.0, colors().accent) }))
              })
            },
          )
        },
        leave=220.0,
      )
      let _ = fg.box(fn(act_host : view::View) -> Unit {
        let _ = act_host
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(ctab_h)))
          .height(view::Live::Is(Some(ctab_h)))
          .offset(view::Live::Is((bar_w + ctab_gap, 0.0)))
        let _ = headless::button(
          act_host,
          action_label,
          fn(_e) -> Unit { on_action() },
          fn(b : view::View, btn : headless::Button) -> Unit {
            b.reacts(at_start=false, fn() { btn.pressed() }, fn(p : Bool) -> Unit {
              action_press.go(b, if p { 1.0 } else { 0.0 }, motion::snappy_damped)
            })
            let _ = b
              .width(view::Live::Is(Some(ctab_h)))
              .height(view::Live::Is(Some(ctab_h)))
              .radius(view::Live::Is(ctab_r))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .scale(view::Live::By(fn() { 1.0 - 0.05 * clamp(action_press.shown(b), 0.0, 1.0) }))
            let ink = fn() -> Int64 { colors().content }
            match action_icon {
              Some(draw) => draw(b, ink)
              None => {
                let _ = b.box(fn(ic : view::View) -> Unit {
                  let _ = ic
                    .width(view::Live::Is(Some(18.0)))
                    .height(view::Live::Is(Some(18.0)))
                    .shrink(view::Live::Is(0.0))
                    .shapes(view::Live::By(fn() { ctrl_search_shapes(18.0, ink()) }))
                })
              }
            }
            b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
              let _ = ring
                .over(view::Live::Is(true))
                .points(view::Live::Is(false))
                .radius(view::Live::Is(ctab_r))
                .edge(view::Live::By(fn() { (2.0, colors().accent) }))
            })
          },
        )
      })
    })
  })
}
