// Selection and metadata controls in Liquid Glass: checkbox, radio group, stepper,
// filter/selection chip, semantic badge, and numeric count badge.

import "headless"
import "motion"
import "signals"
import "view"

/// Semantic tone for `liquid_badge_node` and `liquid_count_badge_node`.
#derive(Eq)
pub enum LiquidTone {
  Neutral
  Accent
  Success
  Warning
  Danger
}

pub fn liquid_checkbox_node(
  parent : view::View,
  checked : () -> Bool,
  on_change : (Bool) -> Unit,
  label : () -> String,
  mixed~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  tint~ : Int64 = clear,
  loc~ : String = "",
) -> view::View {
  headless::toggle(loc=loc, parent, headless::ToggleKind::Checkbox, label, checked, on_change, disabled=disabled, mixed=mixed, fn(row : view::View, cb : headless::Toggle) -> Unit {
    let hover_way = motion::NodeWay::new(0.0)
    let press_way = motion::NodeWay::new(0.0)
    let check_way = motion::NodeWay::new(if signals::untracked(checked) || signals::untracked(mixed) { 1.0 } else { 0.0 })
    row.reacts(at_start=false, fn() { !cb.disabled() && (cb.hovered() || cb.pressed()) }, fn(on : Bool) -> Unit {
      hover_way.go(row, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    row.reacts(at_start=false, fn() { !cb.disabled() && cb.pressed() }, fn(on : Bool) -> Unit {
      press_way.go(row, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    row.reacts(at_start=false, fn() { cb.on() || cb.mixed() }, fn(on : Bool) -> Unit {
      check_way.go(row, if on { 1.0 } else { 0.0 }, motion::tactile_bounce)
    })
    let _ = row
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      .gap(view::Live::Is(ctrl_check_gap))
      .alpha(view::Live::By(fn() { if cb.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
    let _ = row.box(fn(bx : view::View) -> Unit {
      let filled = fn() -> Bool { cb.on() || cb.mixed() }
      let _ = bx
        .width(view::Live::Is(Some(ctrl_check_size)))
        .height(view::Live::Is(Some(ctrl_check_size)))
        .shrink(view::Live::Is(0.0))
        .radius(view::Live::Is(ctrl_check_radius))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .ground(view::Live::By(fn() { ctrl_check_bg(filled(), tint) }))
        .edge(view::Live::By(fn() {
          if filled() {
            (0.0, clear)
          } else {
            (ctrl_hairline_w, ctrl_check_border_ink())
          }
        }))
        .scale(view::Live::By(fn() { 1.0 - 0.10 * clamp(press_way.shown(bx), 0.0, 1.0) }))
      let _ = bx.box(fn(hov : view::View) -> Unit {
        let _ = hov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(ctrl_check_radius))
          .ground(view::Live::By(ctrl_hover_ink))
          .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_hover_alpha }))
      })
      bx.show(
        fn() { cb.on() && !cb.mixed() },
        fn(ic : view::View) -> Unit {
          let _ = ic
            .width(view::Live::Is(Some(ctrl_check_size)))
            .height(view::Live::Is(Some(ctrl_check_size)))
            .scale(view::Live::By(fn() { lerp(0.4, 1.0, check_way.shown(ic)) }))
            .alpha(view::Live::By(fn() { clamp(check_way.shown(ic), 0.0, 1.0) }))
            .shapes(view::Live::Is(ctrl_check_shapes(ctrl_check_size, white)))
        },
        at_once=true,
      )
      bx.show(
        fn() { cb.mixed() },
        fn(ic : view::View) -> Unit {
          let _ = ic
            .width(view::Live::Is(Some(ctrl_check_size)))
            .height(view::Live::Is(Some(ctrl_check_size)))
            .scale(view::Live::By(fn() { lerp(0.4, 1.0, check_way.shown(ic)) }))
            .alpha(view::Live::By(fn() { clamp(check_way.shown(ic), 0.0, 1.0) }))
            .shapes(view::Live::Is(ctrl_minus_shapes(ctrl_check_size, white)))
        },
        at_once=true,
      )
      bx.show(fn() { cb.focus_shown() }, fn(ring : view::View) -> Unit {
        let _ = ring
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .margin(view::Live::Is((-ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset)))
          .radius(view::Live::Is(ctrl_check_radius + ctrl_focus_outset))
          .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
      })
    })
    let _ = row.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::By(label), look=words_at(ctrl_type_body, wrap=true)).ink(view::Live::By(fn() { colors().content }))
    })
  })
}

pub fn liquid_radio_group_node(
  parent : view::View,
  labels : () -> Array[String],
  selected : () -> Int,
  on_select : (Int) -> Unit,
  horizontal~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  tint~ : Int64 = clear,
  loc~ : String = "",
) -> view::View {
  let r = ctrl_radio_size / 2.0
  headless::radio_group(
    loc=loc,
    parent,
    fn() { "Radio Group" },
    selected,
    on_select,
    kind=headless::GroupKind::Radio,
    axis=if horizontal { headless::GroupAxis::Horizontal } else { headless::GroupAxis::Vertical },
    disabled=disabled,
    fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
      let _ = g
        .row(view::Live::Is(horizontal))
        .gap(view::Live::Is(if horizontal { ctrl_radio_row_gap } else { ctrl_radio_col_gap }))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
      g.each(
        fn() -> Array[(Int, String)] {
          let ls = labels()
          let out : Array[(Int, String)] = []
          let mut i = 0
          while i < ls.length() {
            out.push((i, ls[i]))
            i += 1
          }
          out
        },
        fn(p : (Int, String)) -> Int { p.0 },
        fn(slot : view::View, item_sig : signals::Signal[(Int, String)]) -> Unit {
          let _ = rg.item(
            loc=loc,
            slot,
            fn() { item_sig.get().0 },
            fn() { item_sig.get().1 },
            in_node=true,
            fn(row : view::View, it : headless::RadioItem) -> Unit {
              let hover_way = motion::NodeWay::new(0.0)
              let press_way = motion::NodeWay::new(0.0)
              let dot_way = motion::NodeWay::new(if signals::untracked(fn() { it.chosen() }) { 1.0 } else { 0.0 })
              row.reacts(at_start=false, fn() { !it.disabled() && (it.hovered() || it.pressed()) }, fn(on : Bool) -> Unit {
                hover_way.go(row, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
              })
              row.reacts(at_start=false, fn() { !it.disabled() && it.pressed() }, fn(on : Bool) -> Unit {
                press_way.go(row, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
              })
              row.reacts(at_start=false, fn() { it.chosen() }, fn(on : Bool) -> Unit {
                dot_way.go(row, if on { 1.0 } else { 0.0 }, motion::tactile_bounce)
              })
              let _ = row
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Start)))
                .gap(view::Live::Is(ctrl_check_gap))
                .alpha(view::Live::By(fn() { if it.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
              let _ = row.box(fn(circle : view::View) -> Unit {
                let _ = circle
                  .width(view::Live::Is(Some(ctrl_radio_size)))
                  .height(view::Live::Is(Some(ctrl_radio_size)))
                  .shrink(view::Live::Is(0.0))
                  .radius(view::Live::Is(r))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .ground(view::Live::By(fn() { ctrl_check_bg(it.chosen(), tint) }))
                  .edge(view::Live::By(fn() {
                    if it.chosen() {
                      (0.0, clear)
                    } else {
                      (ctrl_hairline_w, ctrl_check_border_ink())
                    }
                  }))
                  .scale(view::Live::By(fn() { 1.0 - 0.08 * clamp(press_way.shown(circle), 0.0, 1.0) }))
                let _ = circle.box(fn(hov : view::View) -> Unit {
                  let _ = hov
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .radius(view::Live::Is(r))
                    .ground(view::Live::By(ctrl_hover_ink))
                    .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_hover_alpha }))
                })
                circle.show(
                  fn() { it.chosen() },
                  fn(dot : view::View) -> Unit {
                    let _ = dot
                      .width(view::Live::Is(Some(ctrl_radio_dot)))
                      .height(view::Live::Is(Some(ctrl_radio_dot)))
                      .shrink(view::Live::Is(0.0))
                      .radius(view::Live::Is(ctrl_radio_dot / 2.0))
                      .ground(view::Live::Is(white))
                      .scale(view::Live::By(fn() {
                        let s = dot_way.shown(dot)
                        if s > 0.0 { s } else { 0.0 }
                      }))
                      .alpha(view::Live::By(fn() { clamp(dot_way.shown(dot), 0.0, 1.0) }))
                  },
                  at_once=true,
                )
                circle.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
                  let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .margin(view::Live::Is((-ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset)))
                    .radius(view::Live::Is(r + ctrl_focus_outset))
                    .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
                })
              })
              let _ = row.box(fn(w : view::View) -> Unit {
                let _ = w
                  .words(view::Live::By(fn() { item_sig.get().1 }), look=words_at(ctrl_type_body, wrap=true))
                  .ink(view::Live::By(fn() { colors().content }))
              })
            },
          )
        },
        at_once=true,
      )
    },
  )
}

pub fn liquid_stepper_node(
  parent : view::View,
  value : () -> Int,
  on_change : (Int) -> Unit,
  min~ : Int = 0,
  max~ : Int = 100,
  step~ : Int = 1,
  label~ : () -> String = fn() { "Stepper" },
  show_value~ : Bool = true,
  format? : (Int) -> String,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let h = ctrl_stepper_h
  let r_outer = h / 2.0
  let inner_h = h - 2.0 * ctrl_group_pad
  let r_inner = inner_h / 2.0
  let div_h = h * ctrl_divider_ratio
  let step_amt = if step > 0 { step } else { 1 }
  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let _ = root
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(ctrl_stepper_gap))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label=label())) }))
    if show_value {
      let _ = root.box(fn(v : view::View) -> Unit {
        let pulse_way = motion::NodeWay::new(0.0)
        v.reacts(at_start=false, value, fn(_x : Int) -> Unit {
          pulse_way.put(1.0)
          pulse_way.go(v, 0.0, motion::snappy_damped)
        })
        let _ = v
          .min_width(view::Live::Is(Some(ctrl_stepper_val_min_w)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .scale(view::Live::By(fn() { 1.0 + 0.10 * clamp(pulse_way.shown(v), 0.0, 1.0) }))
          .words(
            view::Live::By(fn() {
              let cur = value()
              match format {
                Some(f) => f(cur)
                None => "\{cur}"
              }
            }),
            look=words_at(ctrl_type_body, weight=weight_medium),
          )
          .words_centered(view::Live::Is(true))
          .ink(view::Live::By(fn() { colors().content }))
      })
    }
    let _ = root.box(fn(cap : view::View) -> Unit {
      let _ = cap
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .height(view::Live::Is(Some(h)))
        .shrink(view::Live::Is(0.0))
        .padding(view::Live::Is((ctrl_group_pad, ctrl_group_pad, ctrl_group_pad, ctrl_group_pad)))
        .radius(view::Live::Is(r_outer))
        .shadow(view::Live::Is(shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() { Some(ctrl_surface_glass(clear, clear)) }))
        .alpha(view::Live::By(fn() { if disabled() { ctrl_disabled_alpha } else { 1.0 } }))
      let dec_disabled = fn() -> Bool { disabled() || value() <= min }
      let inc_disabled = fn() -> Bool { disabled() || value() >= max }
      let make_btn = fn(
        btn_label : () -> String,
        btn_disabled : () -> Bool,
        on_tap : () -> Unit,
        is_plus : Bool,
      ) -> Unit {
        let _ = headless::button(loc=loc, cap, btn_label, fn(_e) -> Unit { on_tap() }, disabled=btn_disabled, fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_way = motion::NodeWay::new(0.0)
          let press_way = motion::NodeWay::new(0.0)
          b.reacts(
            at_start=false,
            fn() -> Double {
              if btn.disabled() {
                0.0
              } else if btn.pressed() {
                1.0
              } else if btn.hovered() {
                0.5
              } else {
                0.0
              }
            },
            fn(to : Double) -> Unit { hover_way.go(b, to, motion::snappy_damped) },
          )
          b.reacts(at_start=false, fn() { !btn.disabled() && btn.pressed() }, fn(on : Bool) -> Unit {
            press_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          let _ = b
            .width(view::Live::Is(Some(ctrl_stepper_btn_w)))
            .height(view::Live::Is(Some(inner_h)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(r_inner))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .scale(view::Live::By(fn() { 1.0 - 0.08 * clamp(press_way.shown(b), 0.0, 1.0) }))
            .alpha(view::Live::By(fn() { if btn.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
          let _ = b.box(fn(hov : view::View) -> Unit {
            let _ = hov
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(r_inner))
              .ground(view::Live::By(ctrl_hover_ink))
              .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          })
          let _ = b.box(fn(ic : view::View) -> Unit {
            let _ = ic
              .width(view::Live::Is(Some(ctrl_stepper_icon_size)))
              .height(view::Live::Is(Some(ctrl_stepper_icon_size)))
              .shrink(view::Live::Is(0.0))
              .shapes(view::Live::By(fn() {
                if is_plus {
                  ctrl_plus_shapes(ctrl_stepper_icon_size, colors().content)
                } else {
                  ctrl_minus_shapes(ctrl_stepper_icon_size, colors().content)
                }
              }))
          })
          b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
            let _ = ring
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(r_inner))
              .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
          })
        })
      }
      make_btn(
        fn() { "Decrease " + label() },
        dec_disabled,
        fn() -> Unit {
          let next = value() - step_amt
          on_change(if next < min { min } else { next })
        },
        false,
      )
      let _ = cap.box(fn(div : view::View) -> Unit {
        let _ = div
          .width(view::Live::Is(Some(ctrl_hairline_w)))
          .height(view::Live::Is(Some(div_h)))
          .shrink(view::Live::Is(0.0))
          .margin(view::Live::Is((ctrl_group_item_gap, 0.0, ctrl_group_item_gap, 0.0)))
          .ground(view::Live::By(ctrl_divider_ink))
      })
      make_btn(
        fn() { "Increase " + label() },
        inc_disabled,
        fn() -> Unit {
          let next = value() + step_amt
          on_change(if next > max { max } else { next })
        },
        true,
      )
    })
  })
}

pub fn liquid_chip_node(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  selected~ : () -> Bool = fn() { false },
  toggleable~ : Bool = true,
  lead? : (view::View, () -> Int64) -> Unit,
  on_remove? : () -> Unit,
  remove_label~ : () -> String = fn() { "Remove" },
  tint~ : Int64 = clear,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let eff_tint = fn() -> Int64 {
    if selected() {
      if tint != clear { tint } else { ctrl_chip_selected_tint() }
    } else {
      clear
    }
  }
  let fg_ink = fn() -> Int64 { if selected() { white } else { colors().content } }
  let draw_body = fn(c : view::View) -> Unit {
    match lead {
      Some(draw_lead) => {
        let _ = c.box(fn(l : view::View) -> Unit {
          let _ = l.shrink(view::Live::Is(0.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
          draw_lead(l, fg_ink)
        })
      }
      None => ()
    }
    let _ = c.box(fn(w : view::View) -> Unit {
      let _ = w.words(view::Live::By(label), look=words_at(ctrl_type_chip, weight=weight_medium)).ink(view::Live::By(fg_ink))
    })
  }
  match on_remove {
    None => {
      let build_chip = fn(c : view::View, is_disabled : () -> Bool, is_hovered : () -> Bool, is_pressed : () -> Bool, is_focus : () -> Bool) -> Unit {
        let hover_way = motion::NodeWay::new(0.0)
        let press_way = motion::NodeWay::new(0.0)
        let sel_way = motion::NodeWay::new(if signals::untracked(selected) { 1.0 } else { 0.0 })
        c.reacts(
          at_start=false,
          fn() -> Double {
            if is_disabled() {
              0.0
            } else if is_pressed() {
              1.0
            } else if is_hovered() {
              0.5
            } else {
              0.0
            }
          },
          fn(to : Double) -> Unit { hover_way.go(c, to, motion::snappy_damped) },
        )
        c.reacts(at_start=false, fn() { !is_disabled() && is_pressed() }, fn(on : Bool) -> Unit {
          press_way.go(c, if on { 1.0 } else { 0.0 }, motion::tactile_bounce)
        })
        c.reacts(at_start=false, selected, fn(on : Bool) -> Unit {
          sel_way.go(c, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
        })
        let _ = c
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .height(view::Live::Is(Some(ctrl_chip_h)))
          .shrink(view::Live::Is(0.0))
          .padding(view::Live::Is((ctrl_chip_px, 0.0, ctrl_chip_px, 0.0)))
          .gap(view::Live::Is(ctrl_chip_gap))
          .radius(view::Live::Is(ctrl_chip_r))
          .shadow(view::Live::Is(shadow_thumb))
          .shadow_outside(view::Live::Is(true))
          .glass(view::Live::By(fn() { Some(ctrl_surface_glass(eff_tint(), clear, bezel=14.0, refraction=16.0)) }))
          .scale(view::Live::By(fn() {
            let p = clamp(press_way.shown(c), 0.0, 1.0)
            let s = clamp(sel_way.shown(c), 0.0, 1.0)
            (1.0 - 0.05 * p) * (1.0 + 0.02 * s * (1.0 - s))
          }))
          .alpha(view::Live::By(fn() { if is_disabled() { ctrl_disabled_alpha } else { 1.0 } }))
        let _ = c.box(fn(hov : view::View) -> Unit {
          let _ = hov
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .radius(view::Live::Is(ctrl_chip_r))
            .ground(view::Live::By(ctrl_hover_ink))
            .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
        })
        draw_body(c)
        c.show(is_focus, fn(ring : view::View) -> Unit {
          let _ = ring
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .margin(view::Live::Is((-ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset, -ctrl_focus_outset)))
            .radius(view::Live::Is(ctrl_chip_r + ctrl_focus_outset))
            .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
        })
      }
      if toggleable {
        headless::toggle(loc=loc, parent, headless::ToggleKind::Button, label, selected, fn(_b : Bool) -> Unit { on_press() }, disabled=disabled, fn(c : view::View, tg : headless::Toggle) -> Unit {
          build_chip(c, fn() { tg.disabled() }, fn() { tg.hovered() }, fn() { tg.pressed() }, fn() { tg.focus_shown() })
        })
      } else {
        headless::button(loc=loc, parent, label, fn(_e) -> Unit { on_press() }, disabled=disabled, fn(c : view::View, btn : headless::Button) -> Unit {
          build_chip(c, fn() { btn.disabled() }, fn() { btn.hovered() }, fn() { btn.pressed() }, fn() { btn.focus_shown() })
        })
      }
    }
    Some(rm) => {
      let inner_r = ctrl_chip_r - ctrl_chip_pad_rm
      parent.box(loc=loc, fn(cap : view::View) -> Unit {
        let _ = cap
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .height(view::Live::Is(Some(ctrl_chip_h)))
          .shrink(view::Live::Is(0.0))
          .padding(view::Live::Is((ctrl_chip_pad_rm, ctrl_chip_pad_rm, ctrl_chip_pad_rm, ctrl_chip_pad_rm)))
          .gap(view::Live::Is(ctrl_group_item_gap))
          .radius(view::Live::Is(ctrl_chip_r))
          .shadow(view::Live::Is(shadow_thumb))
          .shadow_outside(view::Live::Is(true))
          .glass(view::Live::By(fn() { Some(ctrl_surface_glass(eff_tint(), clear, bezel=14.0, refraction=16.0)) }))
          .alpha(view::Live::By(fn() { if disabled() { ctrl_disabled_alpha } else { 1.0 } }))
        let build_main = fn(m : view::View, is_disabled : () -> Bool, is_hovered : () -> Bool, is_pressed : () -> Bool, is_focus : () -> Bool) -> Unit {
          let hover_way = motion::NodeWay::new(0.0)
          m.reacts(
            at_start=false,
            fn() -> Double {
              if is_disabled() {
                0.0
              } else if is_pressed() {
                1.0
              } else if is_hovered() {
                0.5
              } else {
                0.0
              }
            },
            fn(to : Double) -> Unit { hover_way.go(m, to, motion::snappy_damped) },
          )
          let _ = m
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .height(view::Live::Is(Some(ctrl_chip_rm_size)))
            .padding(view::Live::Is((ctrl_chip_gap, 0.0, ctrl_chip_gap, 0.0)))
            .gap(view::Live::Is(ctrl_chip_gap))
            .radius(view::Live::Is(inner_r))
          let _ = m.box(fn(hov : view::View) -> Unit {
            let _ = hov
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(inner_r))
              .ground(view::Live::By(ctrl_hover_ink))
              .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          })
          draw_body(m)
          m.show(is_focus, fn(ring : view::View) -> Unit {
            let _ = ring
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(inner_r))
              .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
          })
        }
        if toggleable {
          let _ = headless::toggle(loc=loc, cap, headless::ToggleKind::Button, label, selected, fn(_b : Bool) -> Unit { on_press() }, disabled=disabled, fn(m : view::View, tg : headless::Toggle) -> Unit {
            build_main(m, fn() { tg.disabled() }, fn() { tg.hovered() }, fn() { tg.pressed() }, fn() { tg.focus_shown() })
          })
        } else {
          let _ = headless::button(loc=loc, cap, label, fn(_e) -> Unit { on_press() }, disabled=disabled, fn(m : view::View, btn : headless::Button) -> Unit {
            build_main(m, fn() { btn.disabled() }, fn() { btn.hovered() }, fn() { btn.pressed() }, fn() { btn.focus_shown() })
          })
        }
        let _ = headless::button(loc=loc, cap, remove_label, fn(_e) -> Unit { rm() }, disabled=disabled, fn(rb : view::View, btn : headless::Button) -> Unit {
          let hover_way = motion::NodeWay::new(0.0)
          rb.reacts(at_start=false, fn() { !btn.disabled() && (btn.hovered() || btn.pressed()) }, fn(on : Bool) -> Unit {
            hover_way.go(rb, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          let _ = rb
            .width(view::Live::Is(Some(ctrl_chip_rm_size)))
            .height(view::Live::Is(Some(ctrl_chip_rm_size)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(inner_r))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = rb.box(fn(hov : view::View) -> Unit {
            let _ = hov
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(inner_r))
              .ground(view::Live::By(ctrl_hover_ink))
              .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          })
          let _ = rb.box(fn(ic : view::View) -> Unit {
            let _ = ic
              .width(view::Live::Is(Some(ctrl_clear_icon_size)))
              .height(view::Live::Is(Some(ctrl_clear_icon_size)))
              .shrink(view::Live::Is(0.0))
              .shapes(view::Live::By(fn() { ctrl_close_shapes(ctrl_clear_icon_size, fg_ink()) }))
          })
          rb.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
            let _ = ring
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(inner_r))
              .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
          })
        })
      })
    }
  }
}

pub fn liquid_badge_node(
  parent : view::View,
  label : () -> String,
  tone~ : LiquidTone = LiquidTone::Neutral,
  dot~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(b : view::View) -> Unit {
    let _ = b
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(ctrl_badge_h)))
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((ctrl_badge_px, 0.0, ctrl_badge_px, 0.0)))
      .gap(view::Live::Is(ctrl_badge_gap))
      .radius(view::Live::Is(ctrl_badge_r))
      .ground(view::Live::By(fn() { ctrl_badge_palette(tone).0 }))
      .edge(view::Live::By(fn() { (ctrl_badge_edge_w, ctrl_badge_edge_ink()) }))
      .says(view::Live::By(fn() { Some(view::said(view::Role::Status, label=label())) }))
    if dot {
      let _ = b.box(fn(d : view::View) -> Unit {
        let _ = d
          .width(view::Live::Is(Some(ctrl_badge_dot)))
          .height(view::Live::Is(Some(ctrl_badge_dot)))
          .shrink(view::Live::Is(0.0))
          .radius(view::Live::Is(ctrl_badge_dot / 2.0))
          .ground(view::Live::By(fn() { ctrl_badge_palette(tone).3 }))
      })
    }
    let _ = b.box(fn(w : view::View) -> Unit {
      let _ = w
        .words(view::Live::By(label), look=words_at(ctrl_type_badge, weight=weight_medium))
        .ink(view::Live::By(fn() { ctrl_badge_palette(tone).2 }))
    })
  })
}

pub fn liquid_count_badge_node(
  parent : view::View,
  count : () -> Int,
  max_count~ : Int = 99,
  tone~ : LiquidTone = LiquidTone::Danger,
  loc~ : String = "",
) -> view::View {
  let shown_text = fn() -> String {
    let c = count()
    if c > max_count { "\{max_count}+" } else { "\{c}" }
  }
  parent.box(loc=loc, fn(host : view::View) -> Unit {
    host.show(
      fn() { count() > 0 },
      fn(b : view::View) -> Unit {
        let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .min_width(view::Live::Is(Some(ctrl_count_h)))
          .height(view::Live::Is(Some(ctrl_count_h)))
          .shrink(view::Live::Is(0.0))
          .padding(view::Live::Is((ctrl_count_px, 0.0, ctrl_count_px, 0.0)))
          .radius(view::Live::Is(ctrl_count_r))
          .ground(view::Live::By(fn() { ctrl_count_palette(tone).1 }))
          .edge(view::Live::By(fn() { (ctrl_badge_edge_w, ctrl_badge_edge_ink()) }))
          .says(view::Live::By(fn() { Some(view::said(view::Role::Status, label=shown_text())) }))
        let _ = b.box(fn(w : view::View) -> Unit {
          let _ = w
            .words(view::Live::By(shown_text), look=words_at(ctrl_type_count, weight=ctrl_weight_semibold))
            .words_centered(view::Live::Is(true))
            .ink(view::Live::By(fn() { ctrl_count_palette(tone).2 }))
        })
      },
      at_once=true,
    )
  })
}
