// White-box unit tests for 1:1 iOS 27.0 LiquidMorphPhysics (`liquid_morph_physics.pion`) in `lg`:
// verifies open/close springs, mid-open circular bubble aspect ratio, 30ms-lead parallel close trigger recoil
// (~213ms peak, ~-9.5pt catch, ~580ms settle), wide-trigger horizontal splash (~400ms +1.016), delayed close
// width C0 continuity at handoff, top-bar hugging close geometry, gap-gated Blob A emergence, and zero NaN.

test "LiquidMorphPhysics open/close springs, recoil pulse, and horizontal splash match CADisplayLink calibration" {
  // 1. Open spring (omega0=26, zeta=1.0): critically damped monotonic rise (~95% at 180ms, >99.9% at 420ms, no overshoot)
  debug_assert(lm_open_progress(0.0) == 0.0, "open progress at t=0 must be 0.0")
  let open_180 = lm_open_progress(0.18)
  let open_210 = lm_open_progress(0.21)
  debug_assert(open_180 > 0.93 && open_180 < 1.0, "open spring ~95% at 180ms")
  debug_assert(open_210 >= open_180 && open_210 <= 1.0, "open spring monotonic without overshoot")
  let open_end = lm_open_progress(0.42)
  debug_assert(open_end > 0.999 && open_end <= 1.0, "open spring settled by 420ms")
  // Open mid-phase aspect ratio stays balanced on 190x265 menu (w^0.72 vs h^0.84) and corner radius is capped
  let f67 = lm_eval_pill_morph(300.0, 35.0, 74.0, 36.0, 358.0, 184.0, 35.0, 190.0, 265.0, 20.0, 1.0, false, 0.067)
  let aspect67 = f67.cur_w / f67.cur_h
  debug_assert(aspect67 >= 0.70 && aspect67 <= 1.15, "open mid bubble balanced at 67ms")
  debug_assert(f67.radius <= 26.01, "open corner radius capped at target_r + 6pt (no giant white circle)")
  debug_assert(lm_open_size_progress(0.5, lm_scale_delta(36.0, 36.0, 190.0, 265.0)) > 0.65, "large menu open size progress > 0.65")

  // 2. Close spring (omega0=15, zeta=0.88): platter active > 0.045 at 200ms, hands off by ~320ms
  debug_assert(lm_close_progress(0.0) == 1.0, "close progress at t=0 must be 1.0")
  debug_assert(lm_close_platter_active(lm_close_progress(0.20)), "platter active at 200ms")
  debug_assert(!lm_close_platter_active(lm_close_progress(0.32)), "platter handed off by 320ms")

  // 3. Parallel close recoil pulse: 0 for t<=0.03s, peak ~1.0 at t=0.213s, near 0 at 0.58s
  debug_assert(lm_recoil_pulse(0.0) == 0.0, "recoil pulse at 0")
  debug_assert(lm_recoil_pulse(0.03) == 0.0, "recoil pulse at 30ms lead")
  let pulse_peak = lm_recoil_pulse(0.213)
  debug_assert((pulse_peak - 1.0).abs() < 0.02, "recoil pulse peaks ~1.0 at 213ms")
  let pulse_end = lm_recoil_pulse(0.58)
  debug_assert(pulse_end.abs() < 0.06, "recoil pulse settles near 0 by 580ms")

  // 4. Recoil vertical offset: negative (upward) ~-9.5..-10.0pt for Bottom menu
  let dy_phone = lm_recoil_offset_y(0.213, 120.0, 10.0)
  debug_assert(dy_phone < -9.0 && dy_phone > -10.5, "phone recoil peak ~-9.8pt")
  let dy_capped = lm_recoil_offset_y(0.213, 120.0, 5.0)
  debug_assert(dy_capped < -4.8 && dy_capped > -5.2, "capped recoil peak ~-5.0pt")

  // 5. Impact compression scale: ~0.965 at 213ms, 1.0 at t=0
  debug_assert(lm_impact_scale(0.0, 120.0) == 1.0, "impact scale at 0")
  let imp = lm_impact_scale(0.213, 120.0)
  debug_assert(imp > 0.95 && imp < 0.975, "impact scale ~0.965 at 213ms")

  // 6. Close trigger width: crosses 1.0 around 320ms, horizontal splash ~1.016 at 400ms
  let w_400 = lm_close_trigger_width(0.40)
  debug_assert(w_400 > 1.010 && w_400 < 1.025, "horizontal splash ~1.016 at 400ms")
  let diff_handoff = (lm_delayed_close_width(0.283) - lm_close_trigger_width(0.283)).abs()
  debug_assert(diff_handoff < 1.0e-6, "delayed close width C0 at handoff")

  // 7. Three-anchor liquid_menu_morph_glass optical recipe invariants
  let g0 = liquid_menu_morph_glass(0.0, dark=false)
  let g5 = liquid_menu_morph_glass(0.5, dark=false)
  let g1 = liquid_menu_morph_glass(1.0, dark=false)
  debug_assert((g0.tint & 0xFFL) == 0x67L, "stage 0.0 alpha must be 0x67")
  debug_assert((g0.blur - 2.0).abs() < 1.0e-9, "stage 0.0 blur must be 2.0")
  debug_assert((g5.tint & 0xFFL) == 0x88L, "stage 0.5 alpha must be 0x88")
  debug_assert((g5.blur - 4.5).abs() < 1.0e-9, "stage 0.5 blur must be 4.5")
  debug_assert((g1.tint & 0xFFL) == 0xBFL, "stage 1.0 alpha must be 0xBF")

  // 8. No NaN and close hugs top bar (my <= pill_h + 18pt) across 0..600ms sampling
  let mut i = 0
  while i <= 60 {
    let t = i.to_double() * 0.01
    let raw_c = lm_close_progress(t)
    let (mx, my, mw, mh, r) = lm_closing_teardrop_geometry(
      raw_c,
      150.0,
      18.0,
      74.0,
      36.0,
      190.0,
      265.0,
      20.0,
      lm_recoil_offset_y(t, 114.0, 10.0),
      t,
      1.0,
    )
    debug_assert(mx == mx && my == my && mw == mw && mh == mh && r == r, "no NaN")
    debug_assert(mw >= 0.0 && mh >= 0.0 && r >= 0.0, "non-negative close geometry")
    if lm_close_platter_active(raw_c) {
      debug_assert(my <= 36.0 + 18.0, "close hugs top bar without plunging")
    }
    let em = lm_close_blob_a_emergence(mx, my, mw, mh, r, 150.0, 18.0, raw_c)
    debug_assert(em == 0.0 || (em >= 0.45 && em <= 1.0), "blob A emergence valid range")
    let bl = lm_close_blend(raw_c)
    debug_assert(bl >= 0.0 && bl <= 14.0, "close blend in [0, 14]")
    i += 1
  }
  // 9. Soft-capped close corner radius for large panels & upward close drift clamping
  let r_large = lm_close_corner_radius(180.0, 240.0, 190.0, 265.0, 20.0, 0.5)
  debug_assert(r_large <= 26.01, "large panel close corner radius soft-capped")
  let (_, my_up, _, _, _) = lm_closing_teardrop_geometry(0.6, 100.0, 220.0, 40.0, 36.0, 190.0, 265.0, 20.0, 0.0, 0.08, 0.0)
  debug_assert(my_up == my_up, "upward close teardrop valid without NaN")
  // 10. Monotonic horizontal convergence without stall and horizontal_side branch
  let (mx_hi, _, mw_hi, _, _) = lm_closing_teardrop_geometry(0.8, 150.0, 18.0, 74.0, 36.0, 190.0, 265.0, 20.0, 0.0, 0.04, -1.0)
  let (mx_lo, _, mw_lo, _, _) = lm_closing_teardrop_geometry(0.3, 150.0, 18.0, 74.0, 36.0, 190.0, 265.0, 20.0, 0.0, 0.16, -1.0)
  debug_assert(mx_lo >= mx_hi && mw_lo <= mw_hi, "close converges monotonically toward trigger")
  let (hmx, hmy, hmw, hmh, hr) = lm_closing_teardrop_geometry(
    0.5,
    18.0,
    120.0,
    36.0,
    36.0,
    190.0,
    240.0,
    20.0,
    0.0,
    0.10,
    0.0,
    push_dx=-4.0,
    align_y=1.0,
    horizontal_side=true,
  )
  debug_assert(hmx == hmx && hmy == hmy && hmw > 0.0 && hmh > 0.0 && hr > 0.0, "horizontal_side close valid")
  debug_assert((hmy - (120.0 - 0.5 * hmh)).abs() < 1.0e-6, "horizontal_side uses unclamped base_top + recoil_catch_y")
}

test "overlay_surface_decorators_single_layer_and_zero_hidden_glass" {
  ui::set_glass_solid(None)
  let inactive = fn() -> Bool { false }
  let active = fn() -> Bool { true }
  let t = lg_case(fn(p : view::View) -> Unit {
    let _ = p.box(fn(v) {
      let _ = liquid_popover_surface_decorate(v, radius=16.0)
      let _ = v.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(60.0)))
    })
    let _ = p.box(fn(v) {
      let _ = liquid_tooltip_surface_decorate(v, radius=12.0, active=inactive)
      let _ = v.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(28.0)))
    })
    let _ = p.box(fn(v) {
      let _ = liquid_dialog_surface_decorate(v, radius=24.0, tint_light=0xFDFCFDD1L)
      let _ = v.width(view::Live::Is(Some(180.0))).height(view::Live::Is(Some(90.0)))
    })
    let _ = p.box(fn(v) {
      let _ = liquid_drawer_surface_decorate(v, radius=27.0, active=active)
      let _ = v.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(120.0)))
    })
    let _ = p.box(fn(v) {
      let _ = liquid_sheet_surface_decorate(v, radius=27.0, active=inactive)
      let _ = v.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(120.0)))
    })
  })
  t.run_shown(springs_out)
  // popover(1) + tooltip(0, inactive) + dialog(1) + drawer(1) + sheet(0, inactive) == 3
  debug_assert(count_liquid_glass(t) == 3, "active decorators emit 3 glass; inactive emit 0")
  assert_no_nested_glass(t, label="overlay_surface_decorators")
  t.dispose()
}
