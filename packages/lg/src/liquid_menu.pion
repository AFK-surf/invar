// Liquid Glass Menu and Select components over headless::Popover and headless::menu.

import "headless"
import "motion"
import "signals"
import "view"

/// One entry in a `liquid_menu_node`: an action item, a toggleable check item, or a separator.
/// kind: 0 = Item, 1 = Check, 2 = Separator.
pub struct LiquidMenuEntry {
  kind : Int
  label : String
  shortcut : String
  icon : Option[(view::View, () -> Int64) -> Unit]
  destructive : Bool
  disabled : Bool
  on_select : () -> Unit
  checked : () -> Bool
  on_toggle : () -> Unit
}

pub fn LiquidMenuEntry::item(
  label~ : String,
  on_select~ : () -> Unit,
  shortcut~ : String = "",
  icon? : (view::View, () -> Int64) -> Unit,
  destructive~ : Bool = false,
  disabled~ : Bool = false,
) -> LiquidMenuEntry {
  LiquidMenuEntry::{
    kind: 0,
    label,
    shortcut,
    icon,
    destructive,
    disabled,
    on_select,
    checked: fn() { false },
    on_toggle: fn() { () },
  }
}

pub fn LiquidMenuEntry::check(
  label~ : String,
  checked~ : () -> Bool,
  on_toggle~ : () -> Unit,
  shortcut~ : String = "",
  disabled~ : Bool = false,
) -> LiquidMenuEntry {
  LiquidMenuEntry::{
    kind: 1,
    label,
    shortcut,
    icon: None,
    destructive: false,
    disabled,
    on_select: fn() { () },
    checked,
    on_toggle,
  }
}

pub fn LiquidMenuEntry::separator() -> LiquidMenuEntry {
  LiquidMenuEntry::{
    kind: 2,
    label: "",
    shortcut: "",
    icon: None,
    destructive: false,
    disabled: false,
    on_select: fn() { () },
    checked: fn() { false },
    on_toggle: fn() { () },
  }
}

fn ovl_clean_menu_entries(entries : Array[LiquidMenuEntry]) -> Array[LiquidMenuEntry] {
  let out : Array[LiquidMenuEntry] = []
  let mut last_sep = true
  let mut i = 0
  while i < entries.length() {
    let entry = entries[i]
    if entry.kind == 2 {
      if !last_sep {
        out.push(LiquidMenuEntry::separator())
        last_sep = true
      }
    } else {
      out.push(entry)
      last_sep = false
    }
    i += 1
  }
  while out.length() > 0 {
    if out[out.length() - 1].kind == 2 {
      let _ = out.pop()
    } else {
      break
    }
  }
  out
}

fn ovl_menu_has_lead(entries : Array[LiquidMenuEntry]) -> Bool {
  let mut i = 0
  while i < entries.length() {
    let e = entries[i]
    if e.kind == 1 {
      return true
    } else if e.kind == 0 {
      match e.icon {
        Some(_) => return true
        None => ()
      }
    }
    i += 1
  }
  false
}

pub fn liquid_menu_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  trigger_label : () -> String,
  trigger_look : (view::View, headless::Disclosure) -> Unit,
  entries : () -> Array[LiquidMenuEntry],
  menu_label~ : () -> String = fn() { "Menu" },
  placement~ : headless::Placement = headless::Placement::BelowStart,
  min_width~ : Double = 212.0,
  anchor_size~ : (Double, Double) = (40.0, 40.0),
  trigger_face? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let shown_open = ovl_transitioned_bool(host, open)
  let set_open_tx = fn(v : Bool) -> Unit { view::transition(within=host, fn() { set_open(v) }) }
  let pop = headless::Popover::new(shown_open, set_open_tx)
  let cleaned = fn() -> Array[LiquidMenuEntry] { ovl_clean_menu_entries(entries()) }
  let (side, along) = ovl_beside_of(placement)
  let trigger = pop.trigger(parent, trigger_label, trigger_look, loc=loc)
  let handoff = ovl_setup_trigger_handoff(trigger, shown_open, side, anchor_size, trigger_face)
  pop.layer(
    host,
    menu_label,
    leave=ovl_morph_leave_ms,
    loc=loc,
    fn(v : view::View, opener : Option[view::View]) -> Unit {
      let live = fn() -> Bool { !v.leaving() }
      match opener {
        Some(op) => {
          let _ = v.beside(op.id(), side=side, along=along, offset=ovl_float_gap, padding=ovl_float_pad)
        }
        None => ()
      }
      let _ = headless::menu(
        v,
        fn(panel : view::View, menu : headless::Menu) -> Unit {
          let _ = panel.min_width(view::Live::Is(Some(min_width)))
          let _ = ovl_attach_liquid_morph(v, panel, side, along, ovl_menu_radius, handoff, fn(content_box : view::View) -> Unit {
            let _ = content_box
              .padding(view::Live::Is((ovl_menu_pad, ovl_menu_pad, ovl_menu_pad, ovl_menu_pad)))
              .gap(view::Live::Is(ovl_menu_item_gap_y))
            let has_lead = fn() -> Bool { ovl_menu_has_lead(cleaned()) }
            let list = cleaned()
            let mut idx = 0
            while idx < list.length() {
              let d = list[idx]
              if d.kind == 2 {
                let _ = content_box.box(fn(sep : view::View) -> Unit {
                  let _ = sep.padding(view::Live::Is((ovl_menu_sep_px, ovl_menu_sep_py, ovl_menu_sep_px, ovl_menu_sep_py)))
                  let _ = sep.box(fn(line : view::View) -> Unit {
                    let _ = line
                      .height(view::Live::Is(Some(ovl_hairline_h)))
                      .ground(view::Live::By(ovl_hairline))
                      .says(view::Live::Is(Some(view::said(view::Role::Separator))))
                  })
                })
              } else if d.kind == 0 {
                let label = d.label
                let shortcut = d.shortcut
                let icon = d.icon
                let destructive = d.destructive
                let disabled = d.disabled
                let on_select = d.on_select
                let _ = menu.item(
                  content_box,
                  fn() { label },
                  fn(_e) -> Unit {
                    if !disabled {
                      set_open_tx(false)
                      on_select()
                    }
                  },
                  fn(r : view::View, item : headless::MenuItem) -> Unit {
                    let ink = fn() -> Int64 {
                      if destructive { ovl_destructive() } else { colors().content }
                    }
                    let _ = r
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .min_height(view::Live::Is(Some(ovl_menu_item_h)))
                      .padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, ovl_menu_item_py)))
                      .gap(view::Live::Is(ovl_menu_item_gap))
                      .radius(view::Live::Is(ovl_menu_item_radius))
                      .alpha(view::Live::By(fn() { if item.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                    ovl_attach_row_ground(
                      r,
                      fn() { item.hovered() || (item.focused() && item.focus_shown()) },
                      fn() { item.pressed() },
                      disabled=fn() { item.disabled() },
                    )
                    ovl_focus_ring(r, fn() { item.focus_shown() }, ovl_menu_item_radius)
                    r.show(has_lead, fn(col : view::View) -> Unit {
                      let _ = col
                        .width(view::Live::Is(Some(ovl_menu_check_w)))
                        .height(view::Live::Is(Some(ovl_menu_icon_size)))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .lies_along(view::Live::Is(view::Lies::Middle))
                      match icon {
                        Some(draw_icon) => draw_icon(col, ink)
                        None => ()
                      }
                    })
                    let _ = r.box(fn(w : view::View) -> Unit {
                      let _ = w.grow(view::Live::Is(1.0)).words(view::Live::Is(label), look=words_at(ovl_type_body)).ink(view::Live::By(ink))
                    })
                    if shortcut != "" {
                      let _ = r.box(fn(sc : view::View) -> Unit {
                        let _ = sc.words(view::Live::Is(shortcut), look=words_at(ovl_type_meta)).ink(view::Live::By(ovl_muted_ink))
                      })
                    }
                  },
                  disabled=fn() { disabled },
                  loc=loc,
                )
              } else {
                let label = d.label
                let shortcut = d.shortcut
                let checked = d.checked
                let disabled = d.disabled
                let on_toggle = d.on_toggle
                let _ = menu.check_item(
                  content_box,
                  fn() { label },
                  checked,
                  fn(_e) -> Unit {
                    if !disabled {
                      on_toggle()
                    }
                  },
                  fn(r : view::View, item : headless::MenuItem) -> Unit {
                    let _ = r
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .min_height(view::Live::Is(Some(ovl_menu_item_h)))
                      .padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, ovl_menu_item_py)))
                      .gap(view::Live::Is(ovl_menu_item_gap))
                      .radius(view::Live::Is(ovl_menu_item_radius))
                      .alpha(view::Live::By(fn() { if item.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                    ovl_attach_row_ground(
                      r,
                      fn() { item.hovered() || (item.focused() && item.focus_shown()) },
                      fn() { item.pressed() },
                      disabled=fn() { item.disabled() },
                    )
                    ovl_focus_ring(r, fn() { item.focus_shown() }, ovl_menu_item_radius)
                    let _ = r.box(fn(col : view::View) -> Unit {
                      let _ = col
                        .width(view::Live::Is(Some(ovl_menu_check_w)))
                        .height(view::Live::Is(Some(ovl_menu_icon_size)))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .lies_along(view::Live::Is(view::Lies::Middle))
                      col.show(fn() { item.checked() }, fn(chk : view::View) -> Unit {
                        let _ = chk
                          .width(view::Live::Is(Some(ovl_menu_icon_size)))
                          .height(view::Live::Is(Some(ovl_menu_icon_size)))
                          .shapes(view::Live::By(fn() { ovl_check_shapes(ovl_menu_icon_size, colors().content) }))
                      })
                    })
                    let _ = r.box(fn(w : view::View) -> Unit {
                      let _ = w.grow(view::Live::Is(1.0)).words(view::Live::Is(label), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content }))
                    })
                    if shortcut != "" {
                      let _ = r.box(fn(sc : view::View) -> Unit {
                        let _ = sc.words(view::Live::Is(shortcut), look=words_at(ovl_type_meta)).ink(view::Live::By(ovl_muted_ink))
                      })
                    }
                  },
                  disabled=fn() { disabled },
                  loc=loc,
                )
              }
              idx += 1
            }
          })
        },
        label=menu_label,
        on_close=fn() -> Unit {
          if signals::untracked(live) {
            set_open_tx(false)
          }
        },
        takes_focus=true,
        roving=true,
        loc=loc,
      )
    },
  )
  trigger
}

struct OvlMenuRow {
  key : String
  has_icon : Bool
  entry : LiquidMenuEntry
}

impl signals::Eq for OvlMenuRow {
  fn eq(self : OvlMenuRow, other : OvlMenuRow) -> Bool {
    self.key == other.key &&
    self.has_icon == other.has_icon &&
    self.entry.kind == other.entry.kind &&
    self.entry.label == other.entry.label &&
    self.entry.shortcut == other.entry.shortcut &&
    self.entry.destructive == other.entry.destructive &&
    self.entry.disabled == other.entry.disabled
  }
}

fn ovl_menu_rows(entries : Array[LiquidMenuEntry]) -> Array[OvlMenuRow] {
  let cleaned = ovl_clean_menu_entries(entries)
  let seen : Map[String, Int] = Map::new()
  let out : Array[OvlMenuRow] = []
  let mut idx = 0
  while idx < cleaned.length() {
    let e = cleaned[idx]
    let has_icon = match e.icon { Some(_) => true; None => false }
    let base_key = if e.kind == 2 {
      "sep"
    } else if e.kind == 1 {
      "chk:\{e.label}"
    } else {
      "itm:\{e.label}"
    }
    let n = match seen.get(base_key) {
      Some(c) => c
      None => 0
    }
    seen.set(base_key, n + 1)
    let key = if n == 0 { base_key } else { "\{base_key}#\{n}" }
    out.push(OvlMenuRow::{ key, has_icon, entry: e })
    idx += 1
  }
  out
}

pub fn liquid_menu_panel_node(
  parent : view::View,
  entries : () -> Array[LiquidMenuEntry],
  on_close : () -> Unit,
  header~ : () -> String = fn() { "" },
  menu_label~ : () -> String = fn() { "Menu" },
  min_width~ : Double = 212.0,
  loc~ : String = "",
) -> view::View {
  let cleaned = fn() -> Array[LiquidMenuEntry] { ovl_clean_menu_entries(entries()) }
  let has_lead = fn() -> Bool { ovl_menu_has_lead(cleaned()) }
  headless::menu(
    parent,
    fn(panel : view::View, menu : headless::Menu) -> Unit {
      let _ = panel
        .min_width(view::Live::Is(Some(min_width)))
        .padding(view::Live::Is((ovl_menu_pad, ovl_menu_pad, ovl_menu_pad, ovl_menu_pad)))
        .gap(view::Live::Is(ovl_menu_item_gap_y))
        .radius(view::Live::Is(ovl_menu_radius))
        .shadow(view::Live::Is(shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() { Some(ovl_panel_glass()) }))
      panel.show(
        fn() { header() != "" },
        fn(hdr : view::View) -> Unit {
          let _ = hdr.padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, 4.0)))
          let _ = hdr.box(fn(w : view::View) -> Unit {
            let _ = w
              .words(view::Live::By(header), look=words_at(ovl_type_meta, weight=ovl_weight_semibold))
              .ink(view::Live::By(ovl_muted_ink))
          })
        },
        at_once=true,
      )
      panel.each(
        fn() { ovl_menu_rows(entries()) },
        fn(r : OvlMenuRow) -> String { r.key },
        fn(slot : view::View, row_sig : signals::Signal[OvlMenuRow]) -> Unit {
          let init = row_sig.untracked().entry
          if init.kind == 2 {
            let _ = slot.box(fn(sep : view::View) -> Unit {
              let _ = sep.padding(view::Live::Is((ovl_menu_sep_px, ovl_menu_sep_py, ovl_menu_sep_px, ovl_menu_sep_py)))
              let _ = sep.box(fn(line : view::View) -> Unit {
                let _ = line
                  .height(view::Live::Is(Some(ovl_hairline_h)))
                  .ground(view::Live::By(ovl_hairline))
                  .says(view::Live::Is(Some(view::said(view::Role::Separator))))
              })
            })
          } else if init.kind == 0 {
            let _ = menu.item(
              slot,
              fn() { row_sig.get().entry.label },
              fn(_e) -> Unit {
                let cur = row_sig.untracked().entry
                if !cur.disabled {
                  on_close()
                  (cur.on_select)()
                }
              },
              fn(r : view::View, item : headless::MenuItem) -> Unit {
                let ink = fn() -> Int64 {
                  if row_sig.get().entry.destructive { ovl_destructive() } else { colors().content }
                }
                let _ = r
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .min_height(view::Live::Is(Some(ovl_menu_item_h)))
                  .padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, ovl_menu_item_py)))
                  .gap(view::Live::Is(ovl_menu_item_gap))
                  .radius(view::Live::Is(ovl_menu_item_radius))
                  .alpha(view::Live::By(fn() { if item.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                ovl_attach_row_ground(
                  r,
                  fn() { item.hovered() || (item.focused() && item.focus_shown()) },
                  fn() { item.pressed() },
                  disabled=fn() { item.disabled() },
                )
                ovl_focus_ring(r, fn() { item.focus_shown() }, ovl_menu_item_radius)
                r.show(
                  has_lead,
                  fn(col : view::View) -> Unit {
                    let _ = col
                      .width(view::Live::Is(Some(ovl_menu_check_w)))
                      .height(view::Live::Is(Some(ovl_menu_icon_size)))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                    match row_sig.untracked().entry.icon {
                      Some(draw_icon) => draw_icon(col, ink)
                      None => ()
                    }
                  },
                  at_once=true,
                )
                let _ = r.box(fn(w : view::View) -> Unit {
                  let _ = w
                    .grow(view::Live::Is(1.0))
                    .words(view::Live::By(fn() { row_sig.get().entry.label }), look=words_at(ovl_type_body))
                    .ink(view::Live::By(ink))
                })
                r.show(
                  fn() { row_sig.get().entry.shortcut != "" },
                  fn(sc : view::View) -> Unit {
                    let _ = sc
                      .words(view::Live::By(fn() { row_sig.get().entry.shortcut }), look=words_at(ovl_type_meta))
                      .ink(view::Live::By(ovl_muted_ink))
                  },
                  at_once=true,
                )
              },
              disabled=fn() { row_sig.get().entry.disabled },
              loc=loc,
            )
          } else {
            let _ = menu.check_item(
              slot,
              fn() { row_sig.get().entry.label },
              fn() { (row_sig.get().entry.checked)() },
              fn(_e) -> Unit {
                let cur = row_sig.untracked().entry
                if !cur.disabled {
                  (cur.on_toggle)()
                }
              },
              fn(r : view::View, item : headless::MenuItem) -> Unit {
                let _ = r
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .min_height(view::Live::Is(Some(ovl_menu_item_h)))
                  .padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, ovl_menu_item_py)))
                  .gap(view::Live::Is(ovl_menu_item_gap))
                  .radius(view::Live::Is(ovl_menu_item_radius))
                  .alpha(view::Live::By(fn() { if item.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                ovl_attach_row_ground(
                  r,
                  fn() { item.hovered() || (item.focused() && item.focus_shown()) },
                  fn() { item.pressed() },
                  disabled=fn() { item.disabled() },
                )
                ovl_focus_ring(r, fn() { item.focus_shown() }, ovl_menu_item_radius)
                let _ = r.box(fn(col : view::View) -> Unit {
                  let _ = col
                    .width(view::Live::Is(Some(ovl_menu_check_w)))
                    .height(view::Live::Is(Some(ovl_menu_icon_size)))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                  col.show(fn() { item.checked() }, fn(chk : view::View) -> Unit {
                    let _ = chk
                      .width(view::Live::Is(Some(ovl_menu_icon_size)))
                      .height(view::Live::Is(Some(ovl_menu_icon_size)))
                      .shapes(view::Live::By(fn() { ovl_check_shapes(ovl_menu_icon_size, colors().content) }))
                  })
                })
                let _ = r.box(fn(w : view::View) -> Unit {
                  let _ = w
                    .grow(view::Live::Is(1.0))
                    .words(view::Live::By(fn() { row_sig.get().entry.label }), look=words_at(ovl_type_body))
                    .ink(view::Live::By(fn() { colors().content }))
                })
                r.show(
                  fn() { row_sig.get().entry.shortcut != "" },
                  fn(sc : view::View) -> Unit {
                    let _ = sc
                      .words(view::Live::By(fn() { row_sig.get().entry.shortcut }), look=words_at(ovl_type_meta))
                      .ink(view::Live::By(ovl_muted_ink))
                  },
                  at_once=true,
                )
              },
              disabled=fn() { row_sig.get().entry.disabled },
              loc=loc,
            )
          }
        },
        at_once=true,
      )
    },
    label=menu_label,
    on_close=on_close,
    takes_focus=true,
    roving=true,
    loc=loc,
  )
}

pub fn liquid_menu_button_node(
  parent : view::View,
  host : view::View,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  label : () -> String,
  entries : () -> Array[LiquidMenuEntry],
  icon? : (view::View, () -> Int64) -> Unit,
  show_label~ : Bool = true,
  height~ : Double = 44.0,
  pad_x~ : Double = 14.0,
  menu_label~ : () -> String = fn() { "Menu" },
  placement~ : headless::Placement = headless::Placement::BelowStart,
  min_width~ : Double = 212.0,
  loc~ : String = "",
) -> view::View {
  let r = height / 2.0
  let label_sz = if height <= 36.0 { 13.0 } else { ovl_type_body }
  let is_circle = match icon {
    Some(_) => !show_label
    None => false
  }
  let draw_face = fn(bx : view::View) -> Unit {
    if show_label {
      let _ = bx
        .padding(view::Live::Is((pad_x, 0.0, pad_x, 0.0)))
        .gap(view::Live::Is(6.0))
      match icon {
        Some(draw_icon) => {
          let _ = bx.box(fn(ic : view::View) -> Unit {
            let _ = ic
              .shrink(view::Live::Is(0.0))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
            draw_icon(ic, fn() { colors().content })
          })
        }
        None => ()
      }
      let _ = bx.box(fn(w : view::View) -> Unit {
        let _ = w
          .words(view::Live::By(label), look=words_at(label_sz))
          .ink(view::Live::By(fn() { colors().content }))
      })
    } else {
      match icon {
        Some(draw_icon) => {
          let _ = bx.box(fn(ic : view::View) -> Unit {
            let _ = ic
              .shrink(view::Live::Is(0.0))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
            draw_icon(ic, fn() { colors().content })
          })
        }
        None => {
          let _ = bx.padding(view::Live::Is((pad_x, 0.0, pad_x, 0.0)))
          let _ = bx.box(fn(w : view::View) -> Unit {
            let _ = w
              .words(view::Live::By(label), look=words_at(label_sz))
              .ink(view::Live::By(fn() { colors().content }))
          })
        }
      }
    }
  }
  let trigger_look = fn(t : view::View, disc : headless::Disclosure) -> Unit {
    let press_way = motion::NodeWay::new(0.0)
    t.reacts(at_start=false, fn() { !disc.disabled() && disc.pressed() }, fn(on : Bool) -> Unit {
      press_way.go(t, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    let _ = t
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(height)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(r))
      .shadow(view::Live::Is(shadow_default))
      .shadow_outside(view::Live::Is(true))
      .glass(view::Live::By(fn() { Some(ovl_morph_bridge_glass(merge=0.0)) }))
      .scale(view::Live::By(fn() { 1.0 - 0.04 * clamp(press_way.shown(t), 0.0, 1.0) }))
    if is_circle {
      let _ = t.width(view::Live::Is(Some(height)))
    }
    ovl_focus_ring(t, fn() { disc.focus_shown() }, r)
    draw_face(t)
  }
  liquid_menu_node(
    parent,
    host,
    open,
    set_open,
    label,
    trigger_look,
    entries,
    menu_label=menu_label,
    placement=placement,
    min_width=min_width,
    anchor_size=(if show_label { 96.0 } else { height }, height),
    trigger_face=draw_face,
    loc=loc,
  )
}

pub struct LiquidSelectOption {
  pub label : String
  pub detail : String
  pub disabled : Bool
}

pub fn LiquidSelectOption::new(
  label~ : String,
  detail~ : String = "",
  disabled~ : Bool = false,
) -> LiquidSelectOption {
  LiquidSelectOption::{ label, detail, disabled }
}

pub fn liquid_select_node(
  parent : view::View,
  host : view::View,
  options : () -> Array[LiquidSelectOption],
  selected : () -> Int,
  on_select : (Int) -> Unit,
  placeholder~ : String = "Select...",
  label~ : () -> String = fn() { "Select" },
  width~ : Double = 220.0,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let open = signals::signal(false)
  let open_fn = ovl_transitioned_bool(host, fn() { open.get() })
  let set_open_tx = fn(v : Bool) -> Unit { view::transition(within=host, fn() { open.set(v) }) }
  let pop = headless::Popover::new(open_fn, set_open_tx)
  let current_text = fn() -> String {
    let opts = options()
    let i = selected()
    if i >= 0 && i < opts.length() { opts[i].label } else { placeholder }
  }
  let chev_way = motion::NodeWay::new(if signals::untracked(open_fn) { ovl_turn_half } else { 0.0 })
  let draw_select_face = fn(bx : view::View) -> Unit {
    let _ = bx
      .lies_along(view::Live::Is(view::Lies::Between))
      .padding(view::Live::Is((ovl_select_px, 0.0, ovl_select_px, 0.0)))
      .gap(view::Live::Is(ovl_select_gap))
    let _ = bx.box(fn(w : view::View) -> Unit {
      let _ = w
        .grow(view::Live::Is(1.0))
        .words(view::Live::By(current_text), look=words_at(ovl_type_body))
        .ink(view::Live::By(fn() {
          let opts = options()
          let i = selected()
          if i >= 0 && i < opts.length() { colors().content } else { ovl_muted_ink() }
        }))
    })
    let _ = bx.box(fn(chev : view::View) -> Unit {
      let _ = chev
        .width(view::Live::Is(Some(ovl_select_chevron)))
        .height(view::Live::Is(Some(ovl_select_chevron)))
        .turn(view::Live::By(fn() { chev_way.shown(chev) }))
        .shapes(view::Live::By(fn() { ovl_chevron_down_shapes(ovl_select_chevron, ovl_muted_ink()) }))
    })
  }
  let trigger = pop.trigger(
    parent,
    fn() -> String {
      let l = label()
      let cur = current_text()
      if l != "" && l != cur { "\{l}: \{cur}" } else { cur }
    },
    disabled=disabled,
    loc=loc,
    fn(t : view::View, disc : headless::Disclosure) -> Unit {
      let press_way = motion::NodeWay::new(0.0)
      t.reacts(at_start=false, fn() { !disc.disabled() && disc.pressed() }, fn(on : Bool) -> Unit {
        press_way.go(t, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
      })
      t.reacts(at_start=false, open_fn, fn(is_open : Bool) -> Unit {
        chev_way.go(t, if is_open { ovl_turn_half } else { 0.0 }, motion::snappy_damped)
      })
      let _ = t
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .width(view::Live::Is(Some(width)))
        .height(view::Live::Is(Some(ovl_select_h)))
        .radius(view::Live::Is(ovl_select_radius))
        .shadow(view::Live::Is(shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() { Some(ovl_morph_bridge_glass(merge=0.0)) }))
        .scale(view::Live::By(fn() { 1.0 - 0.02 * clamp(press_way.shown(t), 0.0, 1.0) }))
      ovl_focus_ring(t, fn() { disc.focus_shown() }, ovl_select_radius)
      draw_select_face(t)
    },
  )
  let handoff = ovl_setup_trigger_handoff(
    trigger,
    open_fn,
    view::Side::Bottom,
    (width, ovl_select_h),
    Some(draw_select_face),
    attach_recoil=false,
  )
  let _ = trigger.alpha(view::Live::By(fn() {
    if disabled() {
      ovl_disabled_alpha
    } else if handoff.is_bridging(trigger) {
      0.0
    } else {
      1.0
    }
  }))
  pop.layer(
    host,
    label,
    leave=ovl_morph_leave_ms,
    loc=loc,
    fn(v : view::View, opener : Option[view::View]) -> Unit {
      let live = fn() -> Bool { !v.leaving() }
      match opener {
        Some(op) => {
          let _ = v.beside(op.id(), side=view::Side::Bottom, along=view::Along::Start, offset=ovl_float_gap, padding=ovl_float_pad)
        }
        None => ()
      }
      let _ = headless::menu(
        v,
        label=label,
        on_close=fn() -> Unit {
          if signals::untracked(live) {
            set_open_tx(false)
          }
        },
        takes_focus=true,
        roving=true,
        loc=loc,
        fn(panel : view::View, menu : headless::Menu) -> Unit {
          let _ = panel.min_width(view::Live::Is(Some(width)))
          let _ = ovl_attach_liquid_morph(v, panel, view::Side::Bottom, view::Along::Start, ovl_menu_radius, handoff, fn(content_box : view::View) -> Unit {
            let _ = content_box
              .padding(view::Live::Is((ovl_menu_pad, ovl_menu_pad, ovl_menu_pad, ovl_menu_pad)))
              .gap(view::Live::Is(ovl_menu_item_gap_y))
            let opts = options()
            let mut idx = 0
            while idx < opts.length() {
              let opt_idx = idx
              let opt_val = opts[idx]
              let _ = menu.radio_item(
                content_box,
                fn() { opt_val.label },
                fn() { selected() == opt_idx },
                fn(_e) -> Unit {
                  if !opt_val.disabled {
                    on_select(opt_idx)
                    set_open_tx(false)
                  }
                },
                disabled=fn() { opt_val.disabled },
                loc=loc,
                fn(r : view::View, item : headless::MenuItem) -> Unit {
                  let _ = r
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .min_height(view::Live::Is(Some(ovl_menu_item_h)))
                    .padding(view::Live::Is((ovl_menu_item_px, ovl_menu_item_py, ovl_menu_item_px, ovl_menu_item_py)))
                    .gap(view::Live::Is(ovl_menu_item_gap))
                    .radius(view::Live::Is(ovl_menu_item_radius))
                    .alpha(view::Live::By(fn() { if item.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                  ovl_attach_row_ground(
                    r,
                    fn() { item.hovered() || (item.focused() && item.focus_shown()) },
                    fn() { item.pressed() },
                    selected=fn() { item.checked() },
                    disabled=fn() { item.disabled() },
                  )
                  ovl_focus_ring(r, fn() { item.focus_shown() }, ovl_menu_item_radius)
                  let _ = r.box(fn(col : view::View) -> Unit {
                    let _ = col
                      .width(view::Live::Is(Some(ovl_menu_check_w)))
                      .height(view::Live::Is(Some(ovl_menu_icon_size)))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                    col.show(fn() { item.checked() }, fn(chk : view::View) -> Unit {
                      let _ = chk
                        .width(view::Live::Is(Some(ovl_menu_icon_size)))
                        .height(view::Live::Is(Some(ovl_menu_icon_size)))
                        .shapes(view::Live::By(fn() { ovl_check_shapes(ovl_menu_icon_size, ovl_accent_ink()) }))
                    })
                  })
                  let _ = r.box(fn(col : view::View) -> Unit {
                    let _ = col.grow(view::Live::Is(1.0)).gap(view::Live::Is(ovl_text_gap))
                    let _ = col.box(fn(w : view::View) -> Unit {
                      let _ = w.words(view::Live::Is(opt_val.label), look=words_at(ovl_type_body)).ink(view::Live::By(fn() { colors().content }))
                    })
                    if opt_val.detail != "" {
                      let _ = col.box(fn(d : view::View) -> Unit {
                        let _ = d.words(view::Live::Is(opt_val.detail), look=words_at(ovl_type_meta)).ink(view::Live::By(ovl_muted_ink))
                      })
                    }
                  })
                },
              )
              idx += 1
            }
          })
        },
      )
    },
  )
  trigger
}
