// Regression test for `liquid_lift_shell_decorate`: exercises the `solid` override
// branch and `resolved.at_strength(k)` so linking against the canonical
// `paint::Glass::at_strength` symbol is verified in unit tests.

import "signals"
import "view"

test "liquid_lift_shell_decorate_applies_glass_strength_with_solid_override" {
  let target_ref : signals::Ref[Option[view::View]] = signals::ref_new(None)
  let t = lg_case(
    fn(page : view::View) -> Unit {
      let shell = page.box(fn(_ : view::View) -> Unit { () })
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(44.0)))
      liquid_lift_shell_decorate(
        shell,
        fn() { 0.5 },
        solid=fn() { 0x112233FFL },
      )
      target_ref.v = Some(shell)
    },
  )
  let v = match target_ref.v {
    Some(v) => v
    None => panic("missing decorated view")
  }
  let r = v.rect()
  debug_assert((r.2 - 120.0).abs() < 0.01 && (r.3 - 44.0).abs() < 0.01, "decorated view laid out")
  let drawn = t.drawn_glass()
  debug_assert(drawn.length() >= 1, "lifted shell emits glass draw")
  t.dispose()
}
