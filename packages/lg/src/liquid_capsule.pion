// Single-layer iOS 27 Liquid Glass capsule decorators, press-glass decorator,
// and progressive flat-to-lifted glass shell decorator.

import "motion"
import "paint"
import "ui"
import "view"

/// Material tone preset for `liquid_capsule_decorate`, `liquid_capsule_node`, and
/// `liquid_press_glass_decorate`.
#derive(Eq)
pub enum LiquidCapsuleTone {
  Floating
  BarPill
  ViewerClear
  ViewerDark
  Panel
}

fn capsule_tone_glass(
  tone : LiquidCapsuleTone,
  spot : Option[(Double, Double)],
  sol : Int64,
  custom_tint : Option[Int64],
  sharing : Bool,
) -> paint::Glass {
  match tone {
    Floating => liquid_floating_glass(tint?=custom_tint, solid=sol, spot?=spot, sharing=sharing)
    BarPill => {
      let g = liquid_bar_pill_glass(spot?=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        None => g
      }
    }
    ViewerClear => {
      let g = liquid_viewer_clear_glass(spot?=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        None => g
      }
    }
    ViewerDark => {
      let g = liquid_viewer_dark_glass(spot?=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        None => g
      }
    }
    Panel => {
      let base = maybe_sharing(liquid_panel_glass(solid=sol), sharing)
      let with_spot = match spot {
        Some(_) => paint::Glass::{ ..base, spot }
        None => base
      }
      match custom_tint {
        Some(c) => paint::Glass::{ ..with_spot, tint: c }
        None => with_spot
      }
    }
  }
}

/// Decorates an existing `view::View` as a single-layer iOS 27 Liquid Glass capsule or card and
/// returns it. When `active` returns `false`, emits `glass=None` and zero shadow (zero hidden
/// glass). Never nest inside another `Glass::liquid` surface.
pub fn liquid_capsule_decorate(
  v : view::View,
  tone~ : LiquidCapsuleTone = LiquidCapsuleTone::Floating,
  min_height~ : Option[Double] = None,
  radius~ : Option[Double] = None,
  sharing~ : Bool = true,
  interactive~ : Bool = false,
  solid? : () -> Int64,
  tint? : () -> Option[Int64],
  extra_blur? : () -> Double,
  active? : () -> Bool,
  shadow? : () -> (Double, Double, Int64),
  solid_edge? : () -> (Double, Int64),
  clips~ : Bool = true,
) -> view::View {
  match min_height {
    Some(h) => {
      let _ = v.min_height(view::Live::Is(Some(h)))
    }
    None => ()
  }
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r))
    }
    None => ()
  }
  let is_active = fn() -> Bool {
    match active {
      Some(f) => f()
      None => true
    }
  }
  let _ = v
  .glass(
    view::Live::By(fn() {
      if !is_active() {
        return None
      }
      let spot = if interactive && v.pressed() && !v.glass_solid() {
        let (_, _, w, h) = v.placed_window_now()
        if w > 0.0 && h > 0.0 {
          Some((w / 2.0, h / 2.0))
        } else {
          None
        }
      } else {
        None
      }
      let sol = match solid {
        Some(f) => f()
        None => clear
      }
      let custom_tint = match tint {
        Some(f) => f()
        None => None
      }
      let base = capsule_tone_glass(tone, spot, sol, custom_tint, sharing)
      let glass = match extra_blur {
        Some(bf) => {
          let db = bf()
          if db > 0.0 {
            paint::Glass::{ ..base, blur: base.blur + db }
          } else {
            base
          }
        }
        None => base
      }
      Some(glass)
    }),
  )
  .edge(
    view::Live::By(fn() {
      if !is_active() {
        (0.0, clear)
      } else if v.glass_solid() || ui::glass_solid() {
        match solid_edge {
          Some(f) => f()
          None => liquid_solid_edge()
        }
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if !is_active() {
        shadow_none
      } else {
        match shadow {
          Some(f) => f()
          None => shadow_default
        }
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  if clips {
    let _ = v.clips(view::Live::Is(true))
  }
  v
}

/// Creates a child box in `parent`, decorates it with `liquid_capsule_decorate`, and runs `body`.
pub fn liquid_capsule_node(
  parent : view::View,
  body : (view::View) -> Unit,
  tone~ : LiquidCapsuleTone = LiquidCapsuleTone::Floating,
  min_height~ : Option[Double] = None,
  radius~ : Option[Double] = None,
  sharing~ : Bool = true,
  interactive~ : Bool = false,
  solid? : () -> Int64,
  tint? : () -> Option[Int64],
  extra_blur? : () -> Double,
  active? : () -> Bool,
  shadow? : () -> (Double, Double, Int64),
  solid_edge? : () -> (Double, Int64),
  clips~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(v : view::View) -> Unit {
    let _ = liquid_capsule_decorate(
      v,
      tone=tone,
      min_height=min_height,
      radius=radius,
      sharing=sharing,
      interactive=interactive,
      solid?=solid,
      tint?=tint,
      extra_blur?=extra_blur,
      active?=active,
      shadow?=shadow,
      solid_edge?=solid_edge,
      clips=clips,
    )
    body(v)
  })
}

/// Decorates an interactive control `b` with subtle press sink (`0.97x`), touch-tracked GPU `spot`
/// liquid glass, outside-only shadow, and solid-mode hairline edge. Returns the attached
/// `InteractiveHighlight` so the caller's gesture handler drives `down`, `moved`, and `up`.
pub fn liquid_press_glass_decorate(
  b : view::View,
  tone~ : LiquidCapsuleTone = LiquidCapsuleTone::Floating,
  sharing~ : Bool = true,
  solid? : () -> Int64,
  tint? : () -> Option[Int64],
  shadow? : () -> (Double, Double, Int64),
  solid_edge? : () -> (Double, Int64),
  clips~ : Bool = true,
  highlight? : InteractiveHighlight,
) -> InteractiveHighlight {
  let ih = match highlight {
    Some(h) => h
    None => InteractiveHighlight::new()
  }
  ih.attach(b)
  let _ = b
  .scale(
    view::Live::By(fn() {
      if ui::reduced_motion() {
        1.0
      } else {
        lerp(1.0, 0.97, clamp(ih.pressed(b), 0.0, 1.0))
      }
    }),
    about=view::Pivot::At(0.5, 0.5),
  )
  .glass(
    view::Live::By(fn() {
      let spot = if !(b.glass_solid() || ui::glass_solid()) && ih.pressed(b) > 0.001 {
        let (_, _, bw, bh) = b.placed_window_now()
        if bw > 0.0 && bh > 0.0 {
          Some(ih.spot(b, bw, bh))
        } else {
          let (sw, sh) = ih.size.get()
          if sw > 0.0 && sh > 0.0 {
            Some(ih.spot(b, sw, sh))
          } else {
            None
          }
        }
      } else {
        None
      }
      let sol = match solid {
        Some(f) => f()
        None => clear
      }
      let custom_tint = match tint {
        Some(f) => f()
        None => None
      }
      Some(capsule_tone_glass(tone, spot, sol, custom_tint, sharing))
    }),
  )
  .edge(
    view::Live::By(fn() {
      if b.glass_solid() || ui::glass_solid() {
        match solid_edge {
          Some(f) => f()
          None => liquid_solid_edge()
        }
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      match shadow {
        Some(f) => f()
        None => shadow_default
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  if clips {
    let _ = b.clips(view::Live::Is(true))
  }
  ih
}

/// Decorates container shell `v` to transition continuously between an optional flat surface
/// (`flat_ground`) and a lifted liquid glass surface (`glass`) as `lift()` moves across `[0, 1]`.
/// Emits `glass=None` and zero shadow at rest (`lift <= 0.001`) so idle shells have zero hidden glass.
pub fn liquid_lift_shell_decorate(
  v : view::View,
  lift : () -> Double,
  flat_ground~ : Option[() -> Int64] = None,
  glass~ : () -> paint::Glass = fn() { liquid_panel_glass() },
  solid? : () -> Int64,
  radius~ : Option[Double] = None,
  shadow~ : () -> (Double, Double, Int64) = fn() { shadow_default },
  solid_edge? : () -> (Double, Int64),
  loc~ : String = "",
) -> Unit {
  let t = fn() -> Double { clamp(lift(), 0.0, 1.0) }
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r), loc=loc)
    }
    None => ()
  }
  let _ = v
  .glass(
    view::Live::By(fn() {
      let k = t()
      if k <= 0.001 {
        None
      } else {
        let base = glass()
        let resolved = match solid {
          Some(sf) => paint::Glass::{ ..base, solid: sf() }
          None => base
        }
        Some(resolved.at_strength(k))
      }
    }),
    loc=loc,
  )
  .edge(
    view::Live::By(fn() {
      let k = t()
      if k > 0.001 && (v.glass_solid() || ui::glass_solid()) {
        let (w, c) = match solid_edge {
          Some(f) => f()
          None => liquid_solid_edge()
        }
        (w, alpha(c, k))
      } else {
        (0.0, clear)
      }
    }),
    loc=loc,
  )
  .shadow(
    view::Live::By(fn() {
      let k = t()
      if k <= 0.001 {
        shadow_none
      } else {
        let (sigma, dy, color) = shadow()
        (sigma * k, dy * k, alpha(color, k))
      }
    }),
    loc=loc,
  )
  .shadow_outside(view::Live::Is(true), loc=loc)
  match flat_ground {
    Some(fg) => {
      let _ = v.ground(
        view::Live::By(fn() {
          let k = t()
          if k <= 0.001 {
            fg()
          } else {
            alpha(fg(), 1.0 - k)
          }
        }),
        loc=loc,
      )
    }
    None => ()
  }
}
