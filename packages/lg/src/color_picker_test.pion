// Unit & interaction tests for `lg::liquid_color_picker_node`, HSVA/Hex utilities,
// and `liquid_text_field_node` flat/radius/show_label/trail extensions.

import "headless"
import "signals"
import "ui"
import "view"

fn cp_near(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

fn cp_chan_r(c : Int64) -> Int {
  ((c >> 24) & 0xFFL).to_int()
}

fn cp_chan_g(c : Int64) -> Int {
  ((c >> 16) & 0xFFL).to_int()
}

fn cp_chan_b(c : Int64) -> Int {
  ((c >> 8) & 0xFFL).to_int()
}

fn cp_chan_a(c : Int64) -> Int {
  (c & 0xFFL).to_int()
}

fn cp_opt_i64_eq(a : Option[Int64], b : Option[Int64]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

test "color_picker_hsva_hex_roundtrip_and_boundaries" {
  let samples : Array[(Int64, Double, Double, Double, Double)] = [
    (0xFF0000FFL, 0.0, 1.0, 1.0, 1.0),
    (0xFFFF00FFL, 60.0, 1.0, 1.0, 1.0),
    (0x00FF00FFL, 120.0, 1.0, 1.0, 1.0),
    (0x00FFFFFFL, 180.0, 1.0, 1.0, 1.0),
    (0x0000FFFFL, 240.0, 1.0, 1.0, 1.0),
    (0xFF00FFFFL, 300.0, 1.0, 1.0, 1.0),
    (0x808080FFL, 0.0, 0.0, 128.0 / 255.0, 1.0),
    (0xFFFFFFFFL, 0.0, 0.0, 1.0, 1.0),
    (0x000000FFL, 0.0, 0.0, 0.0, 1.0),
    (0x4F46E580L, 243.4, 0.694, 0.898, 128.0 / 255.0),
  ]
  for item in samples {
    let (c, eh, es, ev, ea) = item
    let (h, s, v, a) = rgba_to_hsva(c)
    debug_assert(h >= 0.0 && h < 360.0, "hue must be in [0, 360)")
    debug_assert(cp_near(h, eh, 1.0), "hue mismatch for sample")
    debug_assert(cp_near(s, es, 0.01), "sat mismatch for sample")
    debug_assert(cp_near(v, ev, 0.01), "val mismatch for sample")
    debug_assert(cp_near(a, ea, 0.01), "alpha mismatch for sample")
    let rt = hsva_to_rgba(h, s, v, a)
    debug_assert(rt == c, "rgba -> hsva -> rgba roundtrip must match exact RGBA8888")
  }
  debug_assert(hsva_to_rgba(360.0, 1.0, 1.0, 1.0) == 0xFF0000FFL, "h=360 wraps to red")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#FF0000"), Some(0xFF0000FFL)), "parse #FF0000")
  debug_assert(cp_opt_i64_eq(parse_hex_color("ff0000"), Some(0xFF0000FFL)), "parse ff0000")
  debug_assert(cp_opt_i64_eq(parse_hex_color("  #0F8  "), Some(0x00FF88FFL)), "parse 3-digit #0F8")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#0F8", fallback_alpha=128), Some(0x00FF8880L)), "parse 3-digit with fallback alpha")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#11223380"), Some(0x11223380L)), "parse 8-digit #11223380")
  debug_assert(cp_opt_i64_eq(parse_hex_color(""), None), "reject empty hex")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#12"), None), "reject 2-digit hex")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#12345"), None), "reject 5-digit hex")
  debug_assert(cp_opt_i64_eq(parse_hex_color("#GGGGGG"), None), "reject non-hex")
  debug_assert(format_hex_color(0x4F46E580L) == "#4F46E5", "format uppercase #RRGGBB")
  debug_assert(format_alpha_percent(0x4F46E5FFL) == "100", "format 100% alpha")
  debug_assert(format_alpha_percent(0x4F46E580L) == "50", "format 50% alpha")
  debug_assert(format_alpha_percent(0x4F46E500L) == "0", "format 0% alpha")
}

test "liquid_color_picker_inside_popover_interactions_external_sync_and_gates" {
  ui::set_glass_solid(None)
  let color = signals::signal(0xFF0000FFL)
  let pop_open = signals::signal(true)
  let changes = ui::ref_new(0)
  let build_count = ui::ref_new(0)

  let t = ovl_host_case(
    fn(page : view::View, host : view::View) -> Unit {
      let _ = liquid_popover_node(
        page,
        host,
        fn() { pop_open.get() },
        fn(v : Bool) -> Unit { pop_open.set(v) },
        fn() { "Color" },
        fn(tr : view::View, _d : headless::Disclosure) -> Unit {
          let _ = tr.width(view::Live::Is(Some(36.0))).height(view::Live::Is(Some(36.0)))
        },
        fn() { "Color Picker Popover" },
        fn(body : view::View) -> Unit {
          build_count.v = build_count.v + 1
          let _ = liquid_color_picker_node(
            body,
            fn() { color.get() },
            fn(next_c : Int64) -> Unit {
              changes.v = changes.v + 1
              color.set(next_c)
            },
          )
        },
        width=248.0,
      )
    },
    w=700.0,
    h=540.0,
  )
  t.set_a11y(true)
  t.run_shown(springs_out)

  // Verify all 5 required a11y targets are present and drawn
  let sv = require_drawn(t, "Color Saturation Brightness", view::Role::Slider)
  let hue = require_drawn(t, "Hue", view::Role::Slider)
  let alpha_bar = require_drawn(t, "Alpha", view::Role::Slider)
  let hex_inp = require_drawn(t, "Hex Color", view::Role::TextField)
  let op_inp = require_drawn(t, "Opacity", view::Role::TextField)

  // 1. SV Canvas click & drag (top-right -> pure hue; bottom-left -> dark desaturated)
  t.drag(sv.x + sv.w * 0.25, sv.y + sv.h * 0.75, sv.x + sv.w * 0.5, sv.y + sv.h * 0.5)
  t.run_shown(a_frame)
  let (_, s1, v1, _) = rgba_to_hsva(color.get())
  debug_assert(cp_near(s1, 0.5, 0.08) && cp_near(v1, 0.5, 0.08), "SV drag must update saturation and value near 0.5")

  // 2. Hue Bar drag while on white (S=0): hue must NOT snap back to 0°
  color.set(0xFFFFFFFFL)
  t.run_shown(a_frame)
  t.drag(hue.x + hue.w * 0.1, hue.y + hue.h * 0.5, hue.x + hue.w * (1.0 / 3.0), hue.y + hue.h * 0.5)
  t.run_shown(a_frame)
  // Now pick S=1, V=1 on SV canvas -> should yield green (~120°), proving hue was preserved on white
  t.tap(sv.x + sv.w - 1.0, sv.y + 1.0)
  t.run_shown(a_frame)
  let (h2, s2, v2, _) = rgba_to_hsva(color.get())
  debug_assert(cp_near(h2, 120.0, 12.0), "Hue dragged on white must be preserved (~120 deg green)")
  debug_assert(s2 > 0.9 && v2 > 0.9, "Top-right SV tap must yield high S and V")

  // 3. Alpha Bar click & drag
  t.drag(alpha_bar.x + alpha_bar.w * 0.9, alpha_bar.y + alpha_bar.h * 0.5, alpha_bar.x + alpha_bar.w * 0.5, alpha_bar.y + alpha_bar.h * 0.5)
  t.run_shown(a_frame)
  let a3 = cp_chan_a(color.get())
  debug_assert(a3 >= 115 && a3 <= 140, "Alpha bar drag to midpoint must set alpha near 128")

  // 4. Hex input (#00FF88 then 336699)
  // Click near the right end of the field so pointer-to-caret placement lands after "#RRGGBB".
  t.tap(hex_inp.x + hex_inp.w - 4.0, hex_inp.y + hex_inp.h * 0.5)
  t.run_shown(a_frame)
  let mut bk = 0
  while bk < 12 {
    t.backspace()
    bk += 1
  }
  t.type_text("#00FF88")
  t.run_shown(a_frame)
  debug_assert(
    cp_chan_r(color.get()) == 0 && cp_chan_g(color.get()) == 255 && cp_chan_b(color.get()) == 136,
    "Hex input #00FF88 must update RGB live",
  )

  let mut bk2 = 0
  while bk2 < 12 {
    t.backspace()
    bk2 += 1
  }
  t.type_text("336699")
  t.enter()
  t.run_shown(a_frame)
  debug_assert(
    cp_chan_r(color.get()) == 0x33 && cp_chan_g(color.get()) == 0x66 && cp_chan_b(color.get()) == 0x99,
    "Hex input 336699 must update RGB",
  )

  // 5. Opacity input (50 then 25%)
  t.tap(op_inp.x + op_inp.w * 0.5, op_inp.y + op_inp.h * 0.5)
  t.run_shown(a_frame)
  let mut bk3 = 0
  while bk3 < 6 {
    t.backspace()
    bk3 += 1
  }
  t.type_text("50")
  t.run_shown(a_frame)
  let a50 = cp_chan_a(color.get())
  debug_assert(a50 >= 126 && a50 <= 129, "Opacity input 50 must set alpha near 50%")

  let mut bk4 = 0
  while bk4 < 6 {
    t.backspace()
    bk4 += 1
  }
  t.type_text("25%")
  t.enter()
  t.run_shown(a_frame)
  let a25 = cp_chan_a(color.get())
  debug_assert(a25 >= 62 && a25 <= 66, "Opacity input 25% must set alpha near 25%")

  // Blur inputs before external update by tapping SV or just testing external sync
  let builds_before_ext = build_count.v
  // 6. External color signal update (0x3366CC80L) without rebuilding panel
  color.set(0x3366CC80L)
  t.run_shown(a_frame)
  debug_assert(build_count.v == builds_before_ext, "External color update must not rebuild popover panel")
  // Tap SV at S=1, V=1 to confirm hue synced to ~220° from 0x3366CC80L
  t.tap(sv.x + sv.w - 1.0, sv.y + 1.0)
  t.run_shown(a_frame)
  let (h_ext, _, _, a_ext) = rgba_to_hsva(color.get())
  debug_assert(cp_near(h_ext, 220.0, 5.0), "External color 0x3366CC80L must sync internal hue to ~220 deg")
  debug_assert(cp_near(a_ext, 128.0 / 255.0, 0.02), "External color 0x3366CC80L must sync internal alpha")

  // 7. Glass nesting & tester hygiene gates
  assert_no_nested_glass(t, label="liquid_color_picker inside popover")
  assert_clean_tester(t, "liquid_color_picker")
  t.dispose()
}

test "cp_hex_submit_sanitizes_trailing_symbols" {
  debug_assert(cp_sanitize_hex_for_submit("#fff;") == "fff", "should strip # and ;")
  debug_assert(cp_sanitize_hex_for_submit("fff$") == "fff", "should strip $")
  match parse_hex_color(cp_sanitize_hex_for_submit("fff$"), fallback_alpha=0xFF) {
    Some(c) => {
      debug_assert(c == 0xFFFFFFFFL, "fff$ must parse to white")
      debug_assert(format_hex_color(c) == "#FFFFFF", "white must normalize to #FFFFFF")
    }
    None => debug_assert(false, "sanitized fff$ must parse")
  }
  match parse_hex_color(cp_sanitize_hex_for_submit("#12;"), fallback_alpha=0xFF) {
    Some(_) => debug_assert(false, "invalid 2-digit hex must still fail")
    None => ()
  }
}

test "cp_alpha_edit_sanitizes_digits_and_clamps" {
  let expect_opt = fn(got : Option[Int], want : Int) -> Bool {
    match got {
      Some(v) => v == want
      None => false
    }
  }
  let (s_empty, v_empty) = cp_sanitize_alpha_input("")
  debug_assert(s_empty == "" && v_empty.is_none(), "empty input must stay empty")
  let (s_over, v_over) = cp_sanitize_alpha_input("101")
  debug_assert(s_over == "100" && expect_opt(v_over, 100), "101 must clamp to 100")
  let (s_neg, v_neg) = cp_sanitize_alpha_input("-1")
  debug_assert(s_neg == "1" && expect_opt(v_neg, 1), "-1 must strip minus to 1")
  let (s_lead, v_lead) = cp_sanitize_alpha_input("050")
  debug_assert(s_lead == "50" && expect_opt(v_lead, 50), "050 must strip leading zero to 50")
  let (s_junk, v_junk) = cp_sanitize_alpha_input("abc")
  debug_assert(s_junk == "" && v_junk.is_none(), "non-digit input must strip to empty")
}
