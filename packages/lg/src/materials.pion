// Single source of truth for Liquid Glass optical materials, floating glass surface mounting,
// and concentric keyboard focus rings across `packages/lg`.
// Only specialized physical optics (`liquid_merge.pion`, `liquid_surface.pion`) and continuous
// morph interpolation (`liquid_morph.pion`) may construct `paint::Glass::liquid` directly.

import "paint"
import "view"

/// Unified regular floating capsule / pill / bar / tile Liquid Glass material.
fn lg_capsule_glass(
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  bezel~ : Double = 14.0,
  refraction~ : Double = 18.0,
  blur~ : Double = 2.1,
  merge~ : Double = 0.0,
  adaptive~ : Bool = true,
) -> paint::Glass {
  let d = is_dark()
  let tinted = tint != clear
  let glass_tint = if tinted {
    alpha(tint, 0.78)
  } else if d {
    0x20202067L
  } else {
    0xFDFCFD67L
  }
  let solid = if tinted {
    tint
  } else if surface != clear {
    over(colors().dialog_container, surface)
  } else if d {
    0x1E1F24FFL
  } else {
    0xFAFAFAFFL
  }
  paint::Glass::liquid(
    blur=blur,
    tint=glass_tint,
    solid=solid,
    saturation=1.0,
    rim=0.6,
    bezel=bezel,
    refraction=refraction,
    chroma=0.0,
    merge=merge,
    adaptive=adaptive,
  )
}

/// Progressive scroll-edge frosted glass (aligned with `sf-ui` `glass_scroll_edge()`).
pub fn lg_scroll_edge_glass() -> paint::Glass {
  let bg = (colors().paper & 0xFFFFFF00L) | 0xFFL
  paint::Glass::frosted(
    blur=8.0,
    tint=alpha(bg, 0.36),
    solid=bg,
    saturation=1.25,
    progressive=true,
  )
}

/// Unified high-density floating panel / menu / popover / list / disclosure / dialog Liquid Glass (75% symmetric veil).
fn lg_panel_glass(
  bezel~ : Double = 16.0,
  refraction~ : Double = 22.0,
) -> paint::Glass {
  let d = is_dark()
  paint::Glass::liquid(
    blur=8.0,
    tint=if d { 0x202020BFL } else { 0xFDFCFDBFL },
    solid=if d { 0x1C1C1EFFL } else { 0xF7F7FAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=bezel,
    refraction=refraction,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// Unified detached floating sheet / action sheet Liquid Glass (80% symmetric veil `0xCC`).
fn lg_sheet_glass(
  bezel~ : Double = 22.0,
  refraction~ : Double = 36.0,
) -> paint::Glass {
  let d = is_dark()
  paint::Glass::liquid(
    blur=12.0,
    tint=if d { 0x202020CCL } else { 0xFDFCFDCCL },
    solid=if d { 0x1C1C1EFFL } else { 0xF7F7FAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=bezel,
    refraction=refraction,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// Liquid glass material for floating sheets that morph smoothly from a detached glass island
/// (`detent = 0.0`, 80% symmetric `0xCC`) into a high-readability full-height liquid glass surface
/// (`detent = 1.0`, 86% symmetric `0xDC`) in both light and dark modes.
fn lg_sheet_glass_at(detent : Double) -> paint::Glass {
  let t = clamp(detent, 0.0, 1.0)
  if t <= 0.001 {
    return lg_sheet_glass()
  }
  let d = is_dark()
  let a = lerp(204.0, 220.0, t).round().to_int64() & 0xFFL
  let tint = if d { 0x20202000L | a } else { 0xFDFCFD00L | a }
  paint::Glass::liquid(
    blur=lerp(12.0, 16.0, t),
    tint=tint,
    solid=if d { 0x1C1C1EFFL } else { 0xF7F7FAFFL },
    saturation=1.0,
    rim=lerp(0.6, 0.45, t),
    bezel=lerp(22.0, 14.0, t),
    refraction=lerp(36.0, 18.0, t),
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// Liquid glass material for floating island side drawers (`r=28pt`, 10pt outer margin).
/// Symmetric 80% dense liquid glass (`0xFDFCFDCCL` light / `0x202020CCL` dark).
fn lg_drawer_glass() -> paint::Glass {
  let d = is_dark()
  paint::Glass::liquid(
    blur=12.0,
    tint=if d { 0x202020CCL } else { 0xFDFCFDCCL },
    solid=if d { 0x1C1C1EFFL } else { 0xF7F7FAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=22.0,
    refraction=36.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// 1pt hairline border used when `glass_solid()` degrades a floating glass drawer or sheet to opaque solid.
fn lg_solid_edge() -> (Double, Int64) {
  if is_dark() { (1.0, 0xFFFFFF24L) } else { (1.0, 0x00000018L) }
}

/// Unified clear refractive loupe / lifted thumb Liquid Glass while pressed/dragged (`press` in `0.0..1.0`).
fn lg_clear_lens_glass(
  press : Double,
  bezel~ : Double = 12.0,
  refraction~ : Double = 16.0,
  chroma~ : Double = -0.06,
  zoom_add~ : Double = 0.22,
  solid~ : Int64 = white,
) -> paint::Glass {
  let p = clamp(press, 0.0, 1.0)
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=solid,
    saturation=1.0,
    rim=0.6 * p,
    bezel=bezel * p,
    refraction=refraction * p,
    chroma=chroma * p,
    merge=0.0,
    adaptive=false,
    zoom=1.0 + zoom_add * p,
  )
}

/// Tight outside-only ambient shadow for floating top bar liquid glass pills (PR #8052 `bar_pill_shadow`):
/// avoids drooping halos and inter-pill shadow bleed on 6pt-spaced top bar groups.
fn lg_bar_pill_shadow() -> (Double, Double, Int64) {
  if is_dark() {
    (6.0, 2.0, 0x00000040L)
  } else {
    (4.0, 1.5, 0x00000012L)
  }
}

/// Mount a single-layer floating Liquid Glass surface with outside shadow and zero resting hairline edge.
fn lg_apply_glass_surface(
  v : view::View,
  glass : () -> paint::Glass,
  shadow~ : (Double, Double, Int64) = shadow_default,
  shadow_by? : () -> (Double, Double, Int64),
) -> Unit {
  let sh = match shadow_by {
    Some(f) => view::Live::By(f)
    None => view::Live::Is(shadow)
  }
  let _ = v
    .shadow(sh)
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(glass()) }))
}

/// Continuous flat-to-liquid-glass elevation container binding (ported from `monoid` #8049 `glass_lift_node.mbt`).
/// At rest (`strength <= 0.001`), emits zero glass and zero backdrop captures while keeping any optional
/// `flat_ground`. For `0.001 < strength <= 1.0`, smoothly fades `flat_ground` out while materialising
/// `lg_capsule_glass().at_strength(t)` and an outside-only shadow (compatible with `glass_solid()`).
pub fn lg_glass_lift_surface(
  v : view::View,
  strength : () -> Double,
  radius : Double,
  flat_ground~ : () -> Int64 = fn() { clear },
  shadow~ : (Double, Double, Int64) = shadow_default,
  loc~ : String = "",
) -> view::View {
  let t = fn() { clamp(strength(), 0.0, 1.0) }
  let _ = v
    .glass(
      view::Live::By(fn() {
        let k = t()
        if k <= 0.001 {
          None
        } else {
          Some(lg_capsule_glass().at_strength(k))
        }
      }),
      loc=loc,
    )
    .radius(view::Live::Is(radius), loc=loc)
    .shadow(
      view::Live::By(fn() {
        let k = t()
        if k <= 0.001 {
          (0.0, 0.0, 0L)
        } else {
          (shadow.0 * k, shadow.1 * k, alpha(shadow.2, k))
        }
      }),
      loc=loc,
    )
    .shadow_outside(view::Live::Is(true), loc=loc)
    .ground(
      view::Live::By(fn() {
        let fg = flat_ground()
        if fg == clear {
          clear
        } else {
          let k = t()
          if k <= 0.001 {
            fg
          } else {
            alpha(fg, 1.0 - k)
          }
        }
      }),
      loc=loc,
    )
  v
}

/// Concentric outset keyboard focus ring (`outset = 3pt`, `stroke = 2pt`).
fn lg_focus_ring(
  parent : view::View,
  shown : () -> Bool,
  radius : Double,
  color~ : () -> Int64 = fn() { colors().accent },
) -> Unit {
  parent.show(shown, fn(ring : view::View) -> Unit {
    let _ = ring
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
      .radius(view::Live::Is(radius + 3.0))
      .edge(view::Live::By(fn() { (2.0, color()) }))
  })
}
