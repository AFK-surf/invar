// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidSlider.kt.

import "headless"
import "signals"
import "ui"
import "view"

fn opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn slider_thumb_x_for(w : Double, tw : Double, progress : Double, flush : Bool) -> Double {
  if flush {
    let hi = dmax(0.0, w - tw)
    clamp(w * progress - tw / 2.0, 0.0, hi)
  } else {
    let hi = w - tw * 3.0 / 4.0
    let lo = -tw / 4.0
    if hi < lo {
      lo
    } else {
      clamp(-tw / 2.0 + w * progress, lo, hi)
    }
  }
}

/// Magnetic lean fraction toward the finger while dragging between discrete stops.
let slider_stops_lean : Double = 0.25

/// A slider of `least`..`most`. The thumb follows the hand itself, by how far the hand has gone since it took hold
/// (so past an end and back it meets the hand again where it left), whatever the caller does with what it is told.
/// `change` hears the value as it goes (each `step` it reaches, `step` 0: every move); `committed` hears it once the hand
/// lets go, or at once for a tap on the track or a key's step: what must not happen on every move (a device written to)
/// goes there. While held, a `value` coming back from the caller does not move the thumb.
/// Supports discrete `stops`, adaptive `thumb_label`, and floating `value_bubble` while pressed.
pub fn liquid_slider_node(
  parent : view::View,
  value : () -> Double,
  change : (Double) -> Unit,
  label : () -> String,
  least~ : Double = 0.0,
  most~ : Double = 100.0,
  step~ : Double = 0.0,
  committed~ : (Double) -> Unit = fn(_v : Double) -> Unit { () },
  threshold~ : Double = 0.01,
  disabled~ : () -> Bool = fn() { false },
  track_h~ : Double = slider_track_h,
  track_held_grow~ : Double = 4.0,
  thumb_w_px~ : Double = slider_thumb_w,
  thumb_h_px~ : Double = slider_thumb_h,
  track_color? : () -> Int64,
  fill_color? : () -> Int64,
  stops~ : Int = 0,
  thumb_label? : (Double) -> String,
  value_bubble? : (Double) -> String,
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(signals::untracked(value), lo=least, hi=most, threshold=threshold, held_scale=slider_thumb_held_scale)
  }
  let span = most - least
  let has_stops = stops > 1
  let has_label = match thumb_label {
    Some(_) => true
    None => false
  }
  let stop_step = if has_stops && span > 0.0 { span / (stops - 1).to_double() } else { step }
  let stop_index_of = fn(v : Double) -> Int {
    if !has_stops || span <= 0.0 {
      0
    } else {
      let frac = clamp((v - least) / span, 0.0, 1.0)
      clamp((frac * (stops - 1).to_double()).round(), 0.0, (stops - 1).to_double()).to_int()
    }
  }
  let value_of_stop = fn(i : Int) -> Double {
    if !has_stops {
      least
    } else {
      least + span * (i.to_double() / (stops - 1).to_double())
    }
  }
  let lean_value_for = fn(raw_v : Double) -> (Int, Double) {
    let frac = if span <= 0.0 { 0.0 } else { clamp((raw_v - least) / span, 0.0, 1.0) }
    let fp = frac * (stops - 1).to_double()
    let nearest = clamp(fp.round(), 0.0, (stops - 1).to_double()).to_int()
    let leaned = clamp(
      nearest.to_double() + (fp - nearest.to_double()) * slider_stops_lean,
      0.0,
      (stops - 1).to_double(),
    )
    (nearest, least + span * (leaned / (stops - 1).to_double()))
  }
  let snapped = fn(v : Double) -> Double { headless::slider_snap(v, least, most, step) }
  let on_thumb = ui::ref_new(false)
  let lens_lifted = ui::ref_new(false)
  let holding : signals::Signal[Bool] = signals::signal(false)
  let start_x = fref(0.0)
  let start_v = fref(0.0)
  let last_x = fref(0.0)
  let told = fref(0.0)
  let raw_drag_val = fref(signals::untracked(value))
  let felt_stop = ui::ref_new(stop_index_of(signals::untracked(value)))
  let live_stop : signals::Signal[Option[Int]] = signals::signal_by(None, opt_int_eq)
  let live_val = fn() -> Double {
    if has_stops {
      match live_stop.get() {
        Some(i) => value_of_stop(i)
        None => value()
      }
    } else {
      value()
    }
  }
  let lift_lens = fn() -> Unit {
    if !lens_lifted.v {
      lens_lifted.v = true
      holding.set(true)
      dd.press()
    }
  }
  // (the value as the hand has it, told on only as it reaches another step)
  let follow = fn(raw : Double) -> Unit {
    dd.update_value(raw)
    let s = snapped(raw)
    if s != told.v {
      told.v = s
      change(s)
    }
  }
  let let_go = fn() -> Unit {
    on_thumb.v = false
    let was_lifted = lens_lifted.v
    lens_lifted.v = false
    holding.set(false)
    if has_stops {
      let sn = value_of_stop(felt_stop.v)
      live_stop.set(None)
      dd.update_value(sn)
      if was_lifted {
        dd.release()
      }
      if sn != told.v {
        told.v = sn
        change(sn)
      }
      committed(sn)
    } else {
      let s = snapped(dd.target())
      dd.update_value(s)
      if was_lifted {
        dd.release()
      }
      if s != told.v {
        told.v = s
        change(s)
      }
      committed(s)
    }
  }
  let hand = fn(d : view::Drag) -> Unit {
    if disabled() || d.w <= 0.0 {
      return
    }
    match d.kind {
      Down => {
        let cur_tw = match thumb_label {
          Some(lbl_fn) =>
          dmin(
            d.w,
            dmax(
              thumb_w_px,
              ui::measure_text_width(lbl_fn(signals::untracked(value)), ctrl_type_label, weight=weight_medium) + 20.0,
            ),
          )
          None => thumb_w_px
        }
        let tx = slider_thumb_x_for(d.w, cur_tw, (dd.target() - least) / span, has_label)
        let hit_thumb = d.x >= tx && d.x <= tx + cur_tw
        on_thumb.v = true
        last_x.v = d.wx
        told.v = if has_stops { value_of_stop(stop_index_of(signals::untracked(value))) } else { snapped(dd.target()) }
        if ui::pointing() == ui::Pointing::Finger {
          lift_lens()
        }
        if has_stops {
          let raw = if hit_thumb {
            signals::untracked(value)
          } else {
            clamp(least + span * (d.x / d.w), least, most)
          }
          raw_drag_val.v = raw
          let (nearest, leaned) = lean_value_for(raw)
          felt_stop.v = nearest
          live_stop.set(Some(nearest))
          if !hit_thumb {
            dd.update_value(leaned)
            let sn = value_of_stop(nearest)
            told.v = sn
            change(sn)
          }
        } else if !hit_thumb {
          follow(clamp(least + span * (d.x / d.w), least, most))
        }
        start_x.v = d.wx
        start_v.v = dd.target()
      }
      Moved =>
      if on_thumb.v {
        lift_lens()
        let dx = d.wx - last_x.v
        last_x.v = d.wx
        if has_stops {
          raw_drag_val.v = clamp(raw_drag_val.v + span * (dx / d.w), least, most)
          let (nearest, leaned) = lean_value_for(raw_drag_val.v)
          if nearest != felt_stop.v {
            felt_stop.v = nearest
            live_stop.set(Some(nearest))
            ui::haptic(ui::Haptic::TextHandleMove)
          }
          dd.update_value(leaned)
        } else {
          follow(clamp(start_v.v + span * ((d.wx - start_x.v) / d.w), least, most))
        }
      }
      Up => if on_thumb.v { let_go() }
      Off =>
      if on_thumb.v {
        if has_stops {
          on_thumb.v = false
          let was_lifted = lens_lifted.v
          lens_lifted.v = false
          holding.set(false)
          live_stop.set(None)
          dd.update_value(signals::untracked(value))
          if was_lifted {
            dd.release()
          }
        } else {
          let_go()
        }
      }
    }
  }
  // (a key's step or an assistive set: told and committed at once)
  let keyed = fn(v : Double) -> Unit {
    let s = if has_stops { value_of_stop(stop_index_of(v)) } else { snapped(v) }
    told.v = s
    change(s)
    committed(s)
  }
  headless::slider(
    loc=loc,
    parent,
    label,
    value,
    min=least,
    max=most,
    step=stop_step,
    keyed,
    disabled=disabled,
    drag=hand,
    fn(s : view::View, sl : headless::Slider) -> Unit {
      dd.attach(s)
      let _ = s.height(view::Live::Is(Some(thumb_h_px))).alpha(view::Live::By(fn() { if sl.disabled() { 0.5 } else { 1.0 } }))
      s.reacts(at_start=false, value, fn(v : Double) -> Unit { if !on_thumb.v && dd.target() != v { dd.update_value(v) } })
      let _ = s.by_room(fn(inner : view::View, room : view::Room) -> Unit {
        let w = fn() -> Double { room.width() }
        let no_lens = fn() -> Bool { inner.glass_solid() || ui::glass_solid() || ui::reduced_motion() }
        let lens = fn(n : view::View) -> Double { if no_lens() { 0.0 } else { dd.pressed(n) } }
        let eff_tw = fn() -> Double {
          match thumb_label {
            Some(lbl_fn) => {
              let _ = inner.words_redone()
              let measured = ui::measure_text_width(lbl_fn(live_val()), ctrl_type_label, weight=weight_medium) + 20.0
              dmin(w(), dmax(thumb_w_px, measured))
            }
            None => thumb_w_px
          }
        }
        let _ = inner.box(fn(track : view::View) -> Unit {
          let _ = track
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(w()) }))
          .height(view::Live::Is(Some(track_h)))
          .offset(view::Live::Is((0.0, (thumb_h_px - track_h) / 2.0)))
          .radius(view::Live::Is(track_h / 2.0))
          .ground(view::Live::By(fn() {
            match track_color {
              Some(f) => f()
              None => colors().track
            }
          }))
          .ground_drawn(view::Live::By(fn() {
            let dh = track_held_grow * dmax(0.0, dd.pressed(track))
            if dh.abs() < 0.001 {
              view::ground_as_laid
            } else {
              let rr = (track_h + dh) / 2.0
              view::GroundShape::{ dx: 0.0, dy: -dh / 2.0, dw: 0.0, dh, corners: Some((rr, rr, rr, rr)) }
            }
          }))
        })
        let _ = inner.box(fn(fill : view::View) -> Unit {
          let _ = fill
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(w()) }))
          .height(view::Live::Is(Some(track_h)))
          .offset(view::Live::Is((0.0, (thumb_h_px - track_h) / 2.0)))
          .radius(view::Live::Is(track_h / 2.0))
          .ground(view::Live::By(fn() {
            match fill_color {
              Some(f) => f()
              None => colors().accent
            }
          }))
          .ground_drawn(view::Live::By(fn() {
            let shown = clamp(dd.progress(fill), 0.0, 1.0) * w()
            let dh = track_held_grow * dmax(0.0, dd.pressed(fill))
            if dh.abs() < 0.001 {
              view::GroundShape::{ dx: 0.0, dy: 0.0, dw: shown - w(), dh: 0.0, corners: None }
            } else {
              let rr = (track_h + dh) / 2.0
              view::GroundShape::{ dx: 0.0, dy: -dh / 2.0, dw: shown - w(), dh, corners: Some((rr, rr, rr, rr)) }
            }
          }))
        })
        // Interior detent markers for discrete stops mode
        if has_stops {
          let dot_side = 4.0
          let mut i = 1
          while i < stops - 1 {
            let frac = i.to_double() / (stops - 1).to_double()
            let _ = inner.box(fn(dot : view::View) -> Unit {
              let _ = dot
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .width(view::Live::Is(Some(dot_side)))
              .height(view::Live::Is(Some(dot_side)))
              .radius(view::Live::Is(dot_side / 2.0))
              .offset(view::Live::By(fn() { (w() * frac - dot_side / 2.0, (thumb_h_px - dot_side) / 2.0) }))
              .ground(view::Live::By(fn() { if is_dark() { 0xFFFFFF55L } else { 0x00000038L } }))
            })
            i += 1
          }
        }
        let _ = inner.box(fn(thumb : view::View) -> Unit {
          let thumb_shape = fn(n : view::View) -> view::GroundShape {
            let cur_tw = eff_tw()
            let (sx, sy) = if no_lens() { (1.0, 1.0) } else { dd.jelly(n, 10.0) }
            let tw = cur_tw * sx
            let th = thumb_h_px * sy
            let x = slider_thumb_x_for(w(), cur_tw, dd.progress(n), has_label)
            let r = th / 2.0
            view::GroundShape::{
              dx: x + (cur_tw - tw) / 2.0,
              dy: (thumb_h_px - th) / 2.0,
              dw: tw - thumb_w_px,
              dh: th - thumb_h_px,
              corners: Some((r, r, r, r)),
            }
          }
          let _ = thumb
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(thumb_w_px)))
          .height(view::Live::Is(Some(thumb_h_px)))
          .radius(view::Live::Is(thumb_h_px / 2.0))
          .shadow(view::Live::By(fn() {
            if is_dark() { (4.0, 1.5, 0x00000050L) } else { (4.0, 1.5, 0x00000028L) }
          }))
          .shadow_outside(view::Live::Is(true))
          .ground_drawn(view::Live::By(fn() { thumb_shape(thumb) }))
          let _ = thumb.box(fn(solid : view::View) -> Unit {
            let _ = solid
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(thumb_w_px)))
            .height(view::Live::Is(Some(thumb_h_px)))
            .radius(view::Live::Is(thumb_h_px / 2.0))
            .ground(view::Live::By(fn() {
              if has_label && is_dark() { 0x2C2C2EFFL } else { white }
            }))
            .edge(view::Live::By(fn() {
              if is_dark() { (0.0, clear) } else { (0.5, 0x00000018L) }
            }))
            .alpha(view::Live::By(fn() { 1.0 - clamp(lens(solid), 0.0, 1.0) }))
            .ground_drawn(view::Live::By(fn() { thumb_shape(solid) }))
          })
          // Lazy-mount the refraction loupe on first press (0 hidden glass & 0 extra nodes at rest; laid == 0 on release).
          let lens_mounted : signals::Signal[Bool] = signals::signal(false)
          thumb.reacts(fn() { !no_lens() && (holding.get() || dd.pressed(thumb) > 0.001) }, fn(active : Bool) -> Unit {
            if active && !lens_mounted.untracked() {
              lens_mounted.set(true)
            }
          })
          thumb.show(
            fn() { lens_mounted.get() },
            fn(gl : view::View) -> Unit {
              let _ = gl
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .width(view::Live::Is(Some(thumb_w_px)))
              .height(view::Live::Is(Some(thumb_h_px)))
              .radius(view::Live::Is(thumb_h_px / 2.0))
              .glass(view::Live::By(fn() {
                let p = clamp(lens(gl), 0.0, 1.0)
                if p > 0.001 { Some(lg_clear_lens_glass(p, bezel=11.0, refraction=16.0, chroma=-0.05, zoom_add=0.22, rim_max=1.0)) } else { None }
              }))
              .alpha(view::Live::By(fn() { clamp(lens(gl), 0.0, 1.0) }))
              .ground_drawn(view::Live::By(fn() { thumb_shape(gl) }))
            },
            at_once=true,
          )
          match thumb_label {
            Some(lbl_fn) => {
              let _ = thumb.box(fn(lbl : view::View) -> Unit {
                let _ = lbl
                .over(view::Live::Is(true))
                .points(view::Live::Is(false))
                .width(view::Live::By(fn() { Some(eff_tw()) }))
                .height(view::Live::Is(Some(thumb_h_px)))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .offset(view::Live::By(fn() { (slider_thumb_x_for(w(), eff_tw(), dd.progress(lbl), true), 0.0) }))
                let _ = lbl.box(fn(wt : view::View) -> Unit {
                  let _ = wt
                  .words(view::Live::By(fn() { lbl_fn(live_val()) }), look=words_at(ctrl_type_label, weight=weight_medium))
                  .ink(view::Live::By(fn() { colors().content }))
                })
              })
            }
            None => ()
          }
        })
        // Compact floating value bubble above the thumb while held/dragged
        match value_bubble {
          Some(fmt_fn) => {
            let bub_mounted : signals::Signal[Bool] = signals::signal(false)
            inner.reacts(fn() { holding.get() || dd.pressed(inner) > 0.001 }, fn(active : Bool) -> Unit {
              if active && !bub_mounted.untracked() {
                bub_mounted.set(true)
              }
            })
            inner.show(
              fn() { bub_mounted.get() },
              fn(bub : view::View) -> Unit {
                let _ = bub
                .over(view::Live::Is(true))
                .points(view::Live::Is(false))
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .padding(view::Live::Is((8.0, 3.0, 8.0, 3.0)))
                .radius(view::Live::Is(11.0))
                .ground(view::Live::By(fn() { colors().content }))
                .alpha(view::Live::By(fn() { clamp(dd.pressed(bub), 0.0, 1.0) }))
                .scale(view::Live::By(fn() { lerp(0.92, 1.0, clamp(dd.pressed(bub), 0.0, 1.0)) }), about=view::Pivot::At(0.5, 1.0))
                .moved_by(
                  fn(bw : Double, bh : Double, _at : Double) -> (Double, Double) {
                    let cur_tw = eff_tw()
                    let tx = slider_thumb_x_for(w(), cur_tw, dd.progress(bub), has_label)
                    (tx + cur_tw / 2.0 - bw / 2.0, -bh - 6.0)
                  },
                  fn(_bw : Double, _bh : Double) -> Double { dd.value_w.end() },
                )
                let _ = bub.box(fn(wt : view::View) -> Unit {
                  let _ = wt
                  .words(view::Live::By(fn() { fmt_fn(live_val()) }), look=words_at(ctrl_type_caption, weight=weight_medium))
                  .ink(view::Live::By(fn() { if is_dark() { black } else { white } }))
                })
              },
              at_once=true,
            )
          }
          None => ()
        }
        inner.show(fn() { sl.focus_shown() }, fn(ring : view::View) -> Unit {
          let _ = ring
          .over(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(eff_tw() + 6.0) }))
          .height(view::Live::Is(Some(thumb_h_px + 6.0)))
          .radius(view::Live::Is(thumb_h_px / 2.0 + 3.0))
          .offset(view::Live::By(fn() { (slider_thumb_x_for(w(), eff_tw(), dd.progress(ring), has_label) - 3.0, -3.0) }))
          .edge(view::Live::By(fn() { (2.0, colors().accent) }))
        })
      })
    },
  )
}
