// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidSlider.kt. A track 6 high across all of
// its width, a capsule in the track's grey, filled in the accent up to its value; its thumb a white capsule 40 × 24 over
// it, its middle at the value, held within a quarter of itself of the track's ends. Held, the thumb turns to glass (its
// white and blur of 8 receding as its lens comes up, 10 deep bending by up to 14, the colours split, its Ambient
// highlight and its InnerShadow of 4), grows by half again and is squeezed as it goes by how fast (velocity / 10). The
// thumb is dragged by as much as the finger moves; a tap on the track sends it there as a hand would (pressed, sent,
// let go). Its keys and a screen reader's steps are mbui's headless slider's.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

/// The thumb's glass, held `p` (iOS 27 clear loupe).
fn slider_glass(p : Double) -> paint::Glass {
  let p = clamp(p, 0.0, 1.0)
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=white,
    saturation=1.0,
    rim=0.6 * p,
    bezel=10.0 * p,
    refraction=14.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
  )
}

/// Where the thumb's left is along a track `w` wide at `progress` (0-1) of it: its middle there, held within a quarter
/// of itself of the ends.
fn slider_thumb_x(w : Double, progress : Double) -> Double {
  let hi = w - thumb_w * 3.0 / 4.0
  let lo = -thumb_w / 4.0
  if hi < lo {
    lo
  } else {
    clamp(-thumb_w / 2.0 + w * progress, lo, hi)
  }
}

/// A LiquidSlider in `parent`, at `value` along `least` … `most`; moved (its thumb dragged, its track tapped, a key, a
/// screen reader's step), `change` is told the new value. Read out a slider named `label`. As wide as what holds it
/// gives it, 24 high. The node.
pub fn liquid_slider_node(
  parent : view::View,
  value : () -> Double,
  change : (Double) -> Unit,
  label : () -> String,
  least~ : Double = 0.0,
  most~ : Double = 100.0,
  threshold~ : Double = 0.01,
  disabled~ : () -> Bool = fn() { false },
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(signals::untracked(value), lo=least, hi=most, threshold=threshold, held_scale=thumb_held_scale)
  }
  let span = most - least
  let on_thumb = ui::ref_new(false)
  let did_drag = ui::ref_new(false)
  let last_x = DoubleCell::{ v: 0.0 }
  let down_x = DoubleCell::{ v: 0.0 }
  let hand = fn(d : view::Drag) -> Unit {
    if disabled() || d.w <= 0.0 {
      return
    }
    match d.kind {
      view::DragIs::Down => {
        let tx = slider_thumb_x(d.w, (dd.target() - least) / span)
        on_thumb.v = d.x >= tx && d.x <= tx + thumb_w
        did_drag.v = false
        last_x.v = d.wx
        down_x.v = d.x
        if on_thumb.v {
          dd.press()
        }
      }
      view::DragIs::Moved => {
        if on_thumb.v {
          let dx = d.wx - last_x.v
          last_x.v = d.wx
          if dx != 0.0 {
            did_drag.v = true
          }
          change(clamp(dd.target() + span * (dx / d.w), least, most))
        }
      }
      view::DragIs::Up => {
        if on_thumb.v {
          if did_drag.v {
            change(dd.target())
          }
          on_thumb.v = false
          dd.release()
        } else if (d.x - down_x.v).abs() <= ui::touch_slop() {
          let to = clamp(least + span * (d.x / d.w), least, most)
          dd.animate_to(to)
          change(to)
        }
      }
      view::DragIs::Off => {
        if on_thumb.v {
          on_thumb.v = false
          dd.release()
        }
      }
    }
  }
  headless::slider(
    parent,
    label,
    value,
    min=least,
    max=most,
    step=0.0,
    change,
    fn(s, sl) {
      dd.attach(s)
      let _ = s.height(view::Live::Is(Some(thumb_h))).alpha(view::Live::By(fn() { if sl.disabled() { 0.5 } else { 1.0 } }))
      s.reacts(value, fn(v) { if dd.target() != v { dd.update_value(v) } }, at_start=false)
      let _ = s.by_room(fn(inner, room) {
        let w = fn() -> Double { room.width() }
        let _ = inner.box(fn(track) {
          let _ = track
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(slider_track_h)))
            .offset(view::Live::Is((0.0, (thumb_h - slider_track_h) / 2.0)))
            .radius(view::Live::Is(slider_track_h / 2.0))
            .ground(view::Live::By(fn() { colors().track }))
        })
        let _ = inner.box(fn(fill) {
          let _ = fill
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(slider_track_h)))
            .offset(view::Live::Is((0.0, (thumb_h - slider_track_h) / 2.0)))
            .radius(view::Live::Is(slider_track_h / 2.0))
            .ground(view::Live::By(fn() { colors().accent }))
            .ground_drawn(view::Live::By(fn() {
              let shown = clamp(dd.progress(fill), 0.0, 1.0) * w()
              view::GroundShape::{ dx: 0.0, dy: 0.0, dw: shown - w(), dh: 0.0, corners: None }
            }))
        })
        let _ = inner.box(fn(thumb) {
          let size = fn() -> (Double, Double) {
            let (sx, sy) = dd.jelly(thumb, 10.0)
            (thumb_w * sx, thumb_h * sy)
          }
          let _ = thumb
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(size().0) }))
            .height(view::Live::By(fn() { Some(size().1) }))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .offset(view::Live::By(fn() {
              let (tw, th) = size()
              let x = slider_thumb_x(w(), dd.progress(thumb))
              (x + (thumb_w - tw) / 2.0, (thumb_h - th) / 2.0)
            }))
            .shadow(view::Live::Is(shadow_thumb))
          let _ = thumb.box(fn(solid) {
            let _ = solid
              .over(view::Live::Is(true))
              .radius(view::Live::By(fn() { size().1 / 2.0 }))
              .ground(view::Live::Is(white))
              .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(solid), 0.0, 1.0) }))
          })
          let _ = thumb.box(fn(gl) {
            let _ = gl
              .over(view::Live::Is(true))
              .radius(view::Live::By(fn() { size().1 / 2.0 }))
              .glass(view::Live::By(fn() { Some(slider_glass(dd.pressed(gl))) }))
              .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
          })
        })
        inner.show(fn() { sl.focus_shown() }, fn(ring) {
          let _ = ring
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(thumb_w + 6.0)))
            .height(view::Live::Is(Some(thumb_h + 6.0)))
            .radius(view::Live::Is(thumb_h / 2.0 + 3.0))
            .offset(view::Live::By(fn() { (slider_thumb_x(w(), dd.progress(ring)) - 3.0, -3.0) }))
            .edge(view::Live::By(fn() { (2.0, colors().accent) }))
        })
      })
    },
    disabled=disabled,
    drag=hand,
    made_for=loc,
  )
}
