// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/components/LiquidSlider.kt.

import "headless"
import "paint"
import "signals"
import "ui"
import "view"

fn slider_glass(p_in : Double) -> paint::Glass {
  let p = clamp(p_in, 0.0, 1.0)
  paint::Glass::liquid(
    blur=0.0,
    tint=0xFFFFFF00L,
    solid=white,
    saturation=1.0,
    rim=0.6 * p,
    bezel=8.0 * p,
    refraction=12.0 * p,
    chroma=-0.06 * p,
    merge=0.0,
    adaptive=false,
    zoom=1.0 + 0.22 * p,
  )
}

fn slider_thumb_x(w : Double, progress : Double) -> Double {
  let hi = w - slider_thumb_w * 3.0 / 4.0
  let lo = -slider_thumb_w / 4.0
  if hi < lo {
    lo
  } else {
    clamp(-slider_thumb_w / 2.0 + w * progress, lo, hi)
  }
}

/// A slider of `least`..`most`. The thumb follows the hand itself, by how far the hand has gone since it took hold
/// (so past an end and back it meets the hand again where it left), whatever the caller does with what it is told.
/// `change` hears the value as it goes (each `step` it reaches, `step` 0: every move); `committed` hears it once the hand
/// lets go, or at once for a tap on the track or a key's step: what must not happen on every move (a device written to)
/// goes there. While held, a `value` coming back from the caller does not move the thumb.
pub fn liquid_slider_node(
  parent : view::View,
  value : () -> Double,
  change : (Double) -> Unit,
  label : () -> String,
  least~ : Double = 0.0,
  most~ : Double = 100.0,
  step~ : Double = 0.0,
  committed~ : (Double) -> Unit = fn(_v : Double) -> Unit { () },
  threshold~ : Double = 0.01,
  disabled~ : () -> Bool = fn() { false },
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(signals::untracked(value), lo=least, hi=most, threshold=threshold, held_scale=thumb_held_scale)
  }
  let span = most - least
  let snapped = fn(v : Double) -> Double { headless::slider_snap(v, least, most, step) }
  let on_thumb = ui::ref_new(false)
  let start_x = fref(0.0)
  let start_v = fref(0.0)
  let told = fref(0.0)
  // (the value as the hand has it, told on only as it reaches another step)
  let follow = fn(raw : Double) -> Unit {
    dd.update_value(raw)
    let s = snapped(raw)
    if s != told.v {
      told.v = s
      change(s)
    }
  }
  let let_go = fn() -> Unit {
    on_thumb.v = false
    let s = snapped(dd.target())
    dd.update_value(s)
    dd.release()
    if s != told.v {
      told.v = s
      change(s)
    }
    committed(s)
  }
  let hand = fn(d : view::Drag) -> Unit {
    if disabled() || d.w <= 0.0 {
      return
    }
    match d.kind {
      Down => {
        let tx = slider_thumb_x(d.w, (dd.target() - least) / span)
        let hit_thumb = d.x >= tx && d.x <= tx + slider_thumb_w
        on_thumb.v = true
        told.v = snapped(dd.target())
        dd.press()
        if !hit_thumb {
          follow(clamp(least + span * (d.x / d.w), least, most))
        }
        start_x.v = d.wx
        start_v.v = dd.target()
      }
      Moved =>
        if on_thumb.v {
          follow(clamp(start_v.v + span * ((d.wx - start_x.v) / d.w), least, most))
        }
      Up => if on_thumb.v { let_go() }
      Off => if on_thumb.v { let_go() }
    }
  }
  // (a key's step or an assistive set: told and committed at once)
  let keyed = fn(v : Double) -> Unit {
    let s = snapped(v)
    told.v = s
    change(s)
    committed(s)
  }
  headless::slider(
    loc=loc,
    parent,
    label,
    value,
    min=least,
    max=most,
    step=step,
    keyed,
    disabled=disabled,
    drag=hand,
    fn(s : view::View, sl : headless::Slider) -> Unit {
      dd.attach(s)
      let _ = s.height(view::Live::Is(Some(slider_thumb_h))).alpha(view::Live::By(fn() { if sl.disabled() { 0.5 } else { 1.0 } }))
      s.reacts(at_start=false, value, fn(v : Double) -> Unit { if !on_thumb.v && dd.target() != v { dd.update_value(v) } })
      let _ = s.by_room(fn(inner : view::View, room : view::Room) -> Unit {
        let w = fn() -> Double { room.width() }
        let _ = inner.box(fn(track : view::View) -> Unit {
          let _ = track
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(slider_track_h)))
            .offset(view::Live::Is((0.0, (slider_thumb_h - slider_track_h) / 2.0)))
            .radius(view::Live::Is(slider_track_h / 2.0))
            .ground(view::Live::By(fn() { colors().track }))
        })
        let _ = inner.box(fn(fill : view::View) -> Unit {
          let _ = fill
            .over(view::Live::Is(true))
            .width(view::Live::By(fn() { Some(w()) }))
            .height(view::Live::Is(Some(slider_track_h)))
            .offset(view::Live::Is((0.0, (slider_thumb_h - slider_track_h) / 2.0)))
            .radius(view::Live::Is(slider_track_h / 2.0))
            .ground(view::Live::By(fn() { colors().accent }))
            .ground_drawn(view::Live::By(fn() {
              let shown = clamp(dd.progress(fill), 0.0, 1.0) * w()
              view::GroundShape::{ dx: 0.0, dy: 0.0, dw: shown - w(), dh: 0.0, corners: None }
            }))
        })
        let _ = inner.box(fn(thumb : view::View) -> Unit {
          let thumb_shape = fn(n : view::View) -> view::GroundShape {
            let (sx, sy) = dd.jelly(n, 10.0)
            let tw = slider_thumb_w * sx
            let th = slider_thumb_h * sy
            let x = slider_thumb_x(w(), dd.progress(n))
            let r = th / 2.0
            view::GroundShape::{
              dx: x + (slider_thumb_w - tw) / 2.0,
              dy: (slider_thumb_h - th) / 2.0,
              dw: tw - slider_thumb_w,
              dh: th - slider_thumb_h,
              corners: Some((r, r, r, r)),
            }
          }
          let _ = thumb
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(slider_thumb_w)))
            .height(view::Live::Is(Some(slider_thumb_h)))
            .radius(view::Live::Is(slider_thumb_h / 2.0))
            .shadow(view::Live::Is(shadow_thumb))
            .shadow_outside(view::Live::Is(true))
            .ground_drawn(view::Live::By(fn() { thumb_shape(thumb) }))
          let _ = thumb.box(fn(solid : view::View) -> Unit {
            let _ = solid
              .over(view::Live::Is(true))
              .width(view::Live::Is(Some(slider_thumb_w)))
              .height(view::Live::Is(Some(slider_thumb_h)))
              .radius(view::Live::Is(slider_thumb_h / 2.0))
              .ground(view::Live::Is(white))
              .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(solid), 0.0, 1.0) }))
              .ground_drawn(view::Live::By(fn() { thumb_shape(solid) }))
          })
          let _ = thumb.box(fn(gl : view::View) -> Unit {
            let _ = gl
              .over(view::Live::Is(true))
              .width(view::Live::Is(Some(slider_thumb_w)))
              .height(view::Live::Is(Some(slider_thumb_h)))
              .radius(view::Live::Is(slider_thumb_h / 2.0))
              .glass(view::Live::By(fn() {
                let p = dd.pressed(gl)
                if p > 0.001 { Some(slider_glass(p)) } else { None }
              }))
              .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
              .ground_drawn(view::Live::By(fn() { thumb_shape(gl) }))
          })
        })
        inner.show(fn() { sl.focus_shown() }, fn(ring : view::View) -> Unit {
          let _ = ring
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(slider_thumb_w + 6.0)))
            .height(view::Live::Is(Some(slider_thumb_h + 6.0)))
            .radius(view::Live::Is(slider_thumb_h / 2.0 + 3.0))
            .offset(view::Live::By(fn() { (slider_thumb_x(w(), dd.progress(ring)) - 3.0, -3.0) }))
            .edge(view::Live::By(fn() { (2.0, colors().accent) }))
        })
      })
    },
  )
}
