// iOS 26/27 Liquid Glass segmented control over headless::radio_group and DampedDrag.

import "headless"
import "signals"
import "ui"
import "view"

/// Compute unified per-item `(x0, width, center)` geometry in strip-local coordinates.
/// Shared by item layout, sliding thumb/lens interpolation, tap origin capture, and drag inverse mapping.
fn seg_item_geoms(
  n : Int,
  room_w : Double,
  gap : Double,
  widths : Option[() -> Array[Double]],
) -> Array[(Double, Double, Double)] {
  let count = if n > 0 { n } else { 1 }
  let out : Array[(Double, Double, Double)] = []
  let total_gap = gap * (count - 1).to_double()
  let equal_w = dmax(0.0, (room_w - total_gap) / count.to_double())
  let ws_opt = match widths {
    Some(ws_fn) => Some(ws_fn())
    None => None
  }
  let missing_w = match ws_opt {
    Some(ws) =>
    if ws.length() < count {
      let mut used = 0.0
      let mut j = 0
      while j < ws.length() {
        used = used + dmax(0.0, ws[j])
        j += 1
      }
      let missing = count - ws.length()
      let rem = room_w - used - total_gap
      if rem > 0.0 { rem / missing.to_double() } else { equal_w }
    } else {
      0.0
    }
    None => equal_w
  }
  let mut x = 0.0
  let mut i = 0
  while i < count {
    let w = match ws_opt {
      Some(ws) => if i < ws.length() { dmax(0.0, ws[i]) } else { missing_w }
      None => equal_w
    }
    out.push((x, w, x + w * 0.5))
    x = x + w + gap
    i += 1
  }
  out
}

pub fn liquid_segmented_node(
  parent : view::View,
  labels : () -> Array[String],
  selected : () -> Int,
  on_select : (Int) -> Unit,
  width? : Double,
  height~ : Double = 32.0,
  drag? : DampedDrag,
  glass_track? : Bool,
  pad~ : Double = ctrl_seg_pad,
  gap~ : Double = 0.0,
  widths? : () -> Array[Double],
  height_by? : () -> Double,
  text_size? : () -> Double,
  kind~ : headless::GroupKind = headless::GroupKind::Tab,
  said~ : String = "Segmented Control",
  shown~ : () -> Bool = fn() { true },
  in_node~ : Bool = false,
  render_item? : (view::View, Int, () -> Bool) -> Unit,
  flat? : Bool,
  loc~ : String = "",
) -> view::View {
  let is_flat = match glass_track {
    Some(b) => !b
    None => is_flat_in(parent, flat)
  }
  let total_h = match height_by {
    Some(f) => f
    None => fn() { height }
  }
  let inner_h = fn() -> Double { dmax(0.0, total_h() - 2.0 * pad) }
  let init_count = signals::untracked(labels).length()
  let last_init = if init_count > 1 { (init_count - 1).to_double() } else { 0.0 }
  let first = signals::untracked(selected).to_double()
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(first, lo=0.0, hi=last_init, held_scale=ctrl_seg_held_scale)
  }
  let current = ui::ref_new(signals::untracked(selected))
  let lifted = ui::ref_new(false)
  let pressed_idx = ui::ref_new(signals::untracked(selected))
  let strip_origin_x = fref(0.0)
  headless::radio_group(
    loc=loc,
    parent,
    fn() { said },
    selected,
    on_select,
    kind=kind,
    axis=headless::GroupAxis::Horizontal,
    shown=shown,
    in_node=in_node,
    fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
      dd.attach(g)
      let _ = g
      .height(view::Live::By(fn() { Some(total_h()) }))
      .shrink(view::Live::Is(1.0))
      .min_width(view::Live::Is(Some(0.0)))
      .padding(view::Live::Is((pad, 0.0, pad, 0.0)))
      .radius(view::Live::By(fn() { total_h() / 2.0 }))
      if is_flat {
        // Flat: Native iOS 27 tertiarySystemFill recessed track (zero resting glass).
        let _ = g
        .ground(view::Live::By(ctrl_seg_flat_track_fill))
        .edge(view::Live::By(ctrl_recessed_edge))
      } else {
        let _ = g.edge(view::Live::By(fn() {
          if g.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) }
        }))
        lg_apply_glass_surface(g, fn() { lg_capsule_glass() })
      }
      match width {
        Some(w) => {
          let _ = g.width(view::Live::Is(Some(w))).max_width(view::Live::Is(Some(w)), within=true)
        }
        None =>
        match widths {
          Some(_) => ()
          None =>
          match render_item {
            Some(_) => ()
            None => {
              let auto_w = fn() -> Option[Double] {
                let _ = g.words_redone()
                let ls = labels()
                let n = ls.length()
                if n <= 0 {
                  return None
                }
                let sz = match text_size {
                  Some(f) => f()
                  None => ctrl_type_seg
                }
                let mut max_lbl = 0.0
                let mut i = 0
                while i < n {
                  let w = ui::measure_text_width(ls[i], sz, weight=weight_medium).ceil()
                  if w > max_lbl {
                    max_lbl = w
                  }
                  i += 1
                }
                let slot_w = dmax(36.0, max_lbl + 2.0 * ctrl_seg_px + 2.0)
                Some(2.0 * pad + slot_w * n.to_double() + gap * (if n > 1 { (n - 1).to_double() } else { 0.0 }))
              }
              let _ = g.width(view::Live::By(auto_w)).max_width(view::Live::By(auto_w), within=true)
            }
          }
        }
      }
      g.reacts(fn() { labels().length() }, fn(n : Int) -> Unit {
        let last = if n > 1 { (n - 1).to_double() } else { 0.0 }
        dd.set_hi(last)
      })
      g.reacts(at_start=false, selected, fn(i : Int) -> Unit {
        let n = signals::untracked(labels).length()
        dd.set_hi(if n > 1 { (n - 1).to_double() } else { 0.0 })
        if i != current.v {
          current.v = i
          dd.slide_to(i.to_double())
        }
      })
      let _ = g.by_room(fn(inner : view::View, room : view::Room) -> Unit {
        let no_lens = fn() -> Bool { inner.glass_solid() || ui::glass_solid() || ui::reduced_motion() }
        let lens = fn(n : view::View) -> Double { if no_lens() { 0.0 } else { dd.pressed(n) } }
        let holding : signals::Signal[Bool] = signals::signal(false)
        let count_fn = fn() -> Int {
          let n = labels().length()
          if n > 0 { n } else { 1 }
        }
        let last_fn = fn() -> Double {
          let n = count_fn()
          if n > 1 { (n - 1).to_double() } else { 0.0 }
        }
        let geoms = fn() -> Array[(Double, Double, Double)] {
          seg_item_geoms(count_fn(), room.width(), gap, widths)
        }
        let geom_of = fn(k : Int) -> (Double, Double, Double) {
          let gs = geoms()
          if k >= 0 && k < gs.length() {
            gs[k]
          } else {
            (0.0, 0.0, 0.0)
          }
        }
        let rect_at = fn(p : Double) -> (Double, Double) {
          let gs = geoms()
          let n = gs.length()
          if n <= 1 {
            return (gs[0].0, gs[0].1)
          }
          let cp = clamp(p, 0.0, (n - 1).to_double())
          let i = cp.floor().to_int()
          let a = if i < 0 { 0 } else if i > n - 2 { n - 2 } else { i }
          let f = clamp(cp - a.to_double(), 0.0, 1.0)
          let (x0, w0, _) = gs[a]
          let (x1, w1, _) = gs[a + 1]
          (x0 + (x1 - x0) * f, dmax(0.0, w0 + (w1 - w0) * f))
        }
        let index_at = fn(lx : Double) -> Double {
          let gs = geoms()
          let n = gs.length()
          if n <= 1 {
            return 0.0
          }
          let mut from = gs[0].2
          if lx <= from {
            return 0.0
          }
          let mut k = 1
          while k < n {
            let to = gs[k].2
            if lx < to && to > from {
              return (k - 1).to_double() + clamp((lx - from) / (to - from), 0.0, 1.0)
            }
            from = to
            k += 1
          }
          (n - 1).to_double()
        }
        let thumb_shape = fn(n : view::View) -> view::GroundShape {
          let (rx, rw) = rect_at(dd.value(n))
          let th_tot = total_h()
          let ih = inner_h()
          let (sx, sy) = if no_lens() { (1.0, 1.0) } else { dd.jelly(n, 10.0) }
          let tw = dmax(0.0, rw + dmin(rw * (sx - 1.0), ctrl_seg_max_grow_x))
          let th = ih * sy
          let r = th / 2.0
          view::GroundShape::{
            dx: rx + (rw - tw) / 2.0,
            dy: (th_tot - th) / 2.0,
            dw: tw,
            dh: th - ih,
            corners: Some((r, r, r, r)),
          }
        }
        let _ = inner.box(fn(thumb : view::View) -> Unit {
          let _ = thumb
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .offset(view::Live::Is((0.0, 0.0)))
          .width(view::Live::Is(Some(0.0)))
          .height(view::Live::By(fn() { Some(inner_h()) }))
          .radius(view::Live::By(fn() { inner_h() / 2.0 }))
          .ground_drawn(view::Live::By(fn() { thumb_shape(thumb) }))
          let _ = thumb.box(fn(pill : view::View) -> Unit {
            let _ = pill
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .offset(view::Live::Is((0.0, 0.0)))
            .width(view::Live::Is(Some(0.0)))
            .height(view::Live::By(fn() { Some(inner_h()) }))
            .radius(view::Live::By(fn() { inner_h() / 2.0 }))
            .ground(view::Live::By(ctrl_seg_thumb_idle))
            .shadow(view::Live::By(ctrl_seg_thumb_idle_shadow))
            .shadow_outside(view::Live::Is(true))
            .edge(view::Live::By(fn() {
              if is_dark() { (0.5, 0xFFFFFF18L) } else { (0.5, 0x0000000FL) }
            }))
            .alpha(view::Live::By(fn() { clamp(1.0 - clamp(lens(pill), 0.0, 1.0) * 1.6, 0.0, 1.0) }))
            .ground_drawn(view::Live::By(fn() { thumb_shape(pill) }))
          })
        })
        let pos_at = fn(wx : Double) -> Double {
          clamp(index_at(wx - strip_origin_x.v), 0.0, last_fn())
        }
        let stopped = fn() -> Unit {
          let last = last_fn()
          dd.set_hi(last)
          let to = clamp(dd.target().round(), 0.0, last)
          let i = to.to_int()
          current.v = i
          dd.update_value(to)
          if lifted.v {
            dd.release()
          }
          if i != signals::untracked(selected) {
            on_select(i)
          }
          lifted.v = false
          holding.set(false)
        }
        let on_drag = fn(d : view::Drag) -> Unit {
          dd.set_hi(last_fn())
          match d.kind {
            Down => {
              if !lifted.v && !no_lens() {
                lifted.v = true
                holding.set(true)
                dd.press()
              }
              let p = pos_at(d.wx)
              if no_lens() {
                dd.slide_to(p)
              } else {
                dd.update_value(p)
              }
            }
            Moved => {
              let p = pos_at(d.wx)
              if no_lens() {
                dd.slide_to(p)
              } else {
                dd.update_value(p)
              }
            }
            Up => {
              if lifted.v {
                stopped()
              } else {
                let to = clamp(pos_at(d.wx).round(), 0.0, last_fn())
                let i = to.to_int()
                current.v = i
                dd.slide_to(to)
                if i != signals::untracked(selected) {
                  on_select(i)
                }
              }
            }
            Off => {
              if lifted.v {
                stopped()
              }
            }
          }
        }
        let _ = inner.box(fn(row : view::View) -> Unit {
          let _ = row
          .row(view::Live::Is(true))
          .gap(view::Live::Is(gap))
          .height(view::Live::By(fn() { Some(total_h()) }))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          row.each(
            fn() -> Array[(Int, String)] {
              let ls = labels()
              let out : Array[(Int, String)] = []
              let mut i = 0
              while i < ls.length() {
                out.push((i, ls[i]))
                i += 1
              }
              out
            },
            fn(p : (Int, String)) -> Int { p.0 },
            fn(slot : view::View, item_sig : signals::Signal[(Int, String)]) -> Unit {
              let idx = signals::untracked(fn() { item_sig.get().0 })
              let idx_f = idx.to_double()
              let _ = rg.item(
                loc=loc,
                slot,
                fn() { item_sig.get().0 },
                fn() { item_sig.get().1 },
                in_node=true,
                fn(seg : view::View, it : headless::RadioItem) -> Unit {
                  let seg_hit_h = fn() -> Double { dmax(total_h(), 36.0) }
                  let seg_hit_out = fn() -> Double { (seg_hit_h() - total_h()) / 2.0 }
                  match widths {
                    Some(_) => {
                      let _ = seg.width(view::Live::By(fn() { Some(geom_of(idx).1) }))
                    }
                    None => {
                      let _ = seg
                      .grow(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .padding(view::Live::By(fn() {
                        let sw = geom_of(idx).1
                        let px = if sw > 0.0 && sw < 86.0 { 4.0 } else { ctrl_seg_px }
                        (px, 0.0, px, 0.0)
                      }))
                    }
                  }
                  let _ = seg
                  .height(view::Live::By(fn() { Some(seg_hit_h()) }))
                  .margin(view::Live::By(fn() {
                    let out = seg_hit_out()
                    if out > 0.0 {
                      (0.0, -out, 0.0, -out)
                    } else {
                      (0.0, 0.0, 0.0, 0.0)
                    }
                  }))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  match render_item {
                    Some(draw_item) => draw_item(seg, idx, fn() { it.chosen() })
                    None => {
                      let _ = seg.box(fn(w : view::View) -> Unit {
                        let _ = w
                        .words(view::Live::By(fn() { item_sig.get().1 }))
                        .words_look(view::Live::By(fn() {
                          let sz = match text_size {
                            Some(f) => f()
                            None => ctrl_type_seg
                          }
                          words_at(sz, weight=if it.chosen() { 600 } else { weight_medium })
                        }))
                        .ink(view::Live::By(fn() {
                          let lit = clamp(1.0 - (dd.value(w) - idx_f).abs(), 0.0, 1.0)
                          lerp_color(ctrl_seg_inactive_ink(), colors().content, lit)
                        }))
                      })
                    }
                  }
                  let _ = seg.box(fn(hit : view::View) -> Unit {
                    let _ = hit.over(view::Live::Is(true)).gesture(
                      ui::touch_slop(),
                      press=fn(d : view::Drag) -> Unit {
                        dd.set_hi(last_fn())
                        let (ix0, _, _) = geom_of(idx)
                        strip_origin_x.v = d.wx - (ix0 + d.x)
                        pressed_idx.v = idx
                        if !no_lens() {
                          lifted.v = true
                          holding.set(true)
                          dd.press()
                          dd.update_value(pos_at(d.wx))
                        } else {
                          lifted.v = false
                        }
                      },
                      tap=fn(_d : view::Drag) -> Unit {
                        dd.set_hi(last_fn())
                        let i = pressed_idx.v
                        current.v = i
                        dd.slide_to(i.to_double())
                        if lifted.v {
                          dd.release()
                          lifted.v = false
                          holding.set(false)
                        }
                        if i != signals::untracked(selected) {
                          on_select(i)
                        }
                      },
                      drag=on_drag,
                    )
                  })
                  seg.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
                    let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .margin(view::Live::By(fn() {
                      let out = seg_hit_out()
                      (0.0, out, 0.0, out)
                    }))
                    .radius(view::Live::By(fn() { inner_h() / 2.0 }))
                    .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
                  })
                },
              )
            },
            at_once=true,
          )
        })
        let lens_shape = fn(n : view::View) -> view::GroundShape {
          let (rx, rw) = rect_at(dd.value(n))
          let th_tot = total_h()
          let ih = inner_h()
          let p = clamp(lens(n), 0.0, 1.0)
          let v = if no_lens() { 0.0 } else { dd.velocity(n) / 10.0 }
          let stretch_x = 1.0 / (1.0 - clamp(v * 0.75, -0.2, 0.2))
          let stretch_y = 1.0 - clamp(v * 0.25, -0.2, 0.2)
          let base_lw = rw + lerp(0.0, 20.0, p)
          let base_lh = lerp(ih, th_tot + 13.0, p)
          let tw = dmax(0.0, rw + dmin(base_lw * stretch_x - rw, ctrl_seg_max_grow_x))
          let th = base_lh * stretch_y
          let r = th / 2.0
          view::GroundShape::{
            dx: rx + (rw - tw) / 2.0,
            dy: (th_tot - th) / 2.0,
            dw: tw,
            dh: th - ih,
            corners: Some((r, r, r, r)),
          }
        }
        // Lazy-mount the clear refraction loupe AFTER `row` on first press so dragging magnifies and
        // refracts segment labels underneath (iOS 26/27 optical Z-order) while keeping 0 glass at rest.
        let lens_mounted : signals::Signal[Bool] = signals::signal(false)
        inner.reacts(fn() { !no_lens() && (holding.get() || dd.pressed(inner) > 0.001) }, fn(active : Bool) -> Unit {
          if active && !lens_mounted.untracked() {
            lens_mounted.set(true)
          }
        })
        inner.show(
          fn() { lens_mounted.get() },
          fn(gl : view::View) -> Unit {
            let full = fn() -> Double { clamp(lens(gl), 0.0, 1.0) }
            let _ = gl
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .offset(view::Live::Is((0.0, 0.0)))
            .width(view::Live::Is(Some(0.0)))
            .height(view::Live::By(fn() { Some(inner_h()) }))
            .radius(view::Live::By(fn() { inner_h() / 2.0 }))
            .shadow(view::Live::By(fn() { lg_seg_lens_shadow(full()) }))
            .shadow_outside(view::Live::Is(true))
            .glass(view::Live::By(fn() {
              let p = full()
              if p > 0.001 {
                Some(
                  lg_clear_lens_glass(
                    p,
                    bezel=9.0,
                    refraction=9.0,
                    chroma=0.04,
                    zoom_add=0.0,
                    rim_max=1.0,
                    tint=0xFFFFFF00L,
                    solid=ctrl_seg_thumb_idle(),
                    droplet_role=3,
                  ),
                )
              } else {
                None
              }
            }))
            .alpha(view::Live::By(full))
            .ground_drawn(view::Live::By(fn() { lens_shape(gl) }))
          },
          at_once=true,
        )
      })
    },
  )
}
