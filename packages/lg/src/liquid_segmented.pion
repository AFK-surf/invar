// iOS 26/27 Liquid Glass segmented control over headless::radio_group and DampedDrag.

import "headless"
import "signals"
import "ui"
import "view"

pub fn liquid_segmented_node(
  parent : view::View,
  labels : () -> Array[String],
  selected : () -> Int,
  on_select : (Int) -> Unit,
  width? : Double,
  height~ : Double = 36.0,
  drag? : DampedDrag,
  loc~ : String = "",
) -> view::View {
  let outer_r = height / 2.0
  let inner_h = height - 2.0 * ctrl_seg_pad
  let inner_r = inner_h / 2.0
  let init_count = signals::untracked(labels).length()
  let last_init = if init_count > 1 { (init_count - 1).to_double() } else { 0.0 }
  let first = signals::untracked(selected).to_double()
  let dd = match drag {
    Some(d) => d
    None => DampedDrag::new(first, lo=0.0, hi=last_init, held_scale=ctrl_seg_held_scale)
  }
  let current = ui::ref_new(signals::untracked(selected))
  let last_x = fref(0.0)
  headless::radio_group(
    loc=loc,
    parent,
    fn() { "Segmented Control" },
    selected,
    on_select,
    kind=headless::GroupKind::Tab,
    axis=headless::GroupAxis::Horizontal,
    fn(g : view::View, rg : headless::RadioGroup[Int]) -> Unit {
      dd.attach(g)
      let _ = g
        .height(view::Live::Is(Some(height)))
        .shrink(view::Live::Is(1.0))
        .min_width(view::Live::Is(Some(0.0)))
        .padding(view::Live::Is((ctrl_seg_pad, 0.0, ctrl_seg_pad, 0.0)))
        .radius(view::Live::Is(outer_r))
      lg_apply_glass_surface(g, fn() { lg_capsule_glass() })
      match width {
        Some(w) => {
          let _ = g.width(view::Live::Is(Some(w))).max_width(view::Live::Is(Some(w)), within=true)
        }
        None => ()
      }
      g.reacts(at_start=false, selected, fn(i : Int) -> Unit {
        if i != current.v {
          current.v = i
          dd.slide_to(i.to_double())
        }
      })
      let _ = g.by_room(fn(inner : view::View, room : view::Room) -> Unit {
        let count_fn = fn() -> Int {
          let n = labels().length()
          if n > 0 { n } else { 1 }
        }
        let last_fn = fn() -> Double {
          let n = count_fn()
          if n > 1 { (n - 1).to_double() } else { 0.0 }
        }
        let seg_w = fn() -> Double { room.width() / count_fn().to_double() }
        let _ = inner.box(fn(thumb : view::View) -> Unit {
          let size = fn() -> (Double, Double) {
            let (sx, sy) = dd.jelly(thumb, 10.0)
            (seg_w() * sx, inner_h * sy)
          }
          let _ = thumb
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .width(view::Live::By(fn() { Some(size().0) }))
            .height(view::Live::By(fn() { Some(size().1) }))
            .radius(view::Live::By(fn() { size().1 / 2.0 }))
            .offset(view::Live::By(fn() {
              let (tw, th) = size()
              let sw = seg_w()
              (dd.value(thumb) * sw + (sw - tw) / 2.0, (height - th) / 2.0)
            }))
          let _ = thumb.box(fn(pill : view::View) -> Unit {
            let _ = pill
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::By(fn() { size().1 / 2.0 }))
              .ground(view::Live::By(ctrl_seg_thumb_idle))
              .alpha(view::Live::By(fn() { 1.0 - clamp(dd.pressed(pill), 0.0, 1.0) }))
          })
          let _ = thumb.box(fn(gl : view::View) -> Unit {
            let _ = gl
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::By(fn() { size().1 / 2.0 }))
              .shadow(view::Live::Is(shadow_thumb))
              .shadow_outside(view::Live::Is(true))
              .glass(view::Live::By(fn() {
                let p = dd.pressed(gl)
                if p > 0.001 {
                  Some(lg_clear_lens_glass(p, bezel=12.0, refraction=16.0, chroma=-0.05, solid=alpha(colors().container, 1.0 / 0.4)))
                } else {
                  None
                }
              }))
              .alpha(view::Live::By(fn() { clamp(dd.pressed(gl), 0.0, 1.0) }))
          })
        })
        let stopped = fn() -> Unit {
          let to = clamp(dd.target().round(), 0.0, last_fn())
          let i = to.to_int()
          current.v = i
          dd.animate_to(to)
          if i != signals::untracked(selected) {
            on_select(i)
          }
        }
        let on_drag = fn(d : view::Drag) -> Unit {
          match d.kind {
            Down => {
              let dx = d.wx - last_x.v
              last_x.v = d.wx
              let sw = seg_w()
              if sw > 0.0 {
                dd.update_value(clamp(dd.target() + dx / sw, 0.0, last_fn()))
              }
            }
            Moved => {
              let dx = d.wx - last_x.v
              last_x.v = d.wx
              let sw = seg_w()
              if sw > 0.0 {
                dd.update_value(clamp(dd.target() + dx / sw, 0.0, last_fn()))
              }
            }
            Up => stopped()
            Off => stopped()
          }
        }
        let _ = inner.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).height(view::Live::Is(Some(height)))
          row.each(
            fn() -> Array[(Int, String)] {
              let ls = labels()
              let out : Array[(Int, String)] = []
              let mut i = 0
              while i < ls.length() {
                out.push((i, ls[i]))
                i += 1
              }
              out
            },
            fn(p : (Int, String)) -> Int { p.0 },
            fn(slot : view::View, item_sig : signals::Signal[(Int, String)]) -> Unit {
              let idx = signals::untracked(fn() { item_sig.get().0 })
              let idx_f = idx.to_double()
              let _ = rg.item(
                loc=loc,
                slot,
                fn() { item_sig.get().0 },
                fn() { item_sig.get().1 },
                in_node=true,
                fn(seg : view::View, it : headless::RadioItem) -> Unit {
                  let _ = seg
                    .grow(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .height(view::Live::Is(Some(height)))
                    .padding(view::Live::By(fn() {
                      let sw = seg_w()
                      let px = if sw > 0.0 && sw < 86.0 { 4.0 } else { ctrl_seg_px }
                      (px, 0.0, px, 0.0)
                    }))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                  let _ = seg.box(fn(w : view::View) -> Unit {
                    let _ = w
                      .words(view::Live::By(fn() { item_sig.get().1 }), look=words_at(ctrl_type_seg, weight=weight_medium))
                      .ink(view::Live::By(fn() {
                        let lit = clamp(1.0 - (dd.value(w) - idx_f).abs(), 0.0, 1.0)
                        lerp_color(ctrl_seg_inactive_ink(), colors().content, lit)
                      }))
                  })
                  let _ = seg.box(fn(hit : view::View) -> Unit {
                    let _ = hit.over(view::Live::Is(true)).gesture(
                      ui::touch_slop(),
                      press=fn(d : view::Drag) -> Unit {
                        last_x.v = d.wx
                        dd.press()
                        if (idx_f - dd.target()).abs() > 0.001 {
                          dd.update_value(idx_f)
                        }
                      },
                      tap=fn(_d : view::Drag) -> Unit { stopped() },
                      drag=on_drag,
                    )
                  })
                  seg.show(fn() { it.focus_shown() }, fn(ring : view::View) -> Unit {
                    let _ = ring
                      .over(view::Live::Is(true))
                      .points(view::Live::Is(false))
                      .radius(view::Live::Is(inner_r))
                      .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
                  })
                },
              )
            },
            at_once=true,
          )
        })
      })
    },
  )
}
