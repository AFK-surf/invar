// Circular liquid glass icon button and unified floating capsule button group.
// Single-layer iOS 27 Glass::liquid on the outer capsule; inner group buttons use
// concentric translucent highlights (zero glass-on-glass).

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

/// Size presets for liquid glass icon buttons and button groups (28 / 32 / 40 pt).
#derive(Eq)
pub enum LiquidButtonSize {
  Small
  Regular
  Large
}

fn ctrl_button_size_px(size : LiquidButtonSize) -> Double {
  match size {
    Small => ctrl_btn_sm
    Regular => ctrl_btn_md
    Large => ctrl_btn_lg
  }
}

fn ctrl_button_glass_params(size : LiquidButtonSize) -> (Double, Double) {
  match size {
    Small => (12.0, 16.0)
    Regular => (14.0, 18.0)
    Large => (16.0, 20.0)
  }
}

pub fn liquid_icon_button_node(
  parent : view::View,
  label : () -> String,
  icon : (view::View, () -> Int64) -> Unit,
  press : () -> Unit,
  size~ : LiquidButtonSize = LiquidButtonSize::Regular,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  interactive~ : Bool = true,
  highlight? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let side = ctrl_button_size_px(size)
  let r = side / 2.0
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, disabled=disabled, fn(b : view::View, btn : headless::Button) -> Unit {
    let ih = match highlight {
      Some(l) => l
      None => InteractiveHighlight::new()
    }
    ih.attach(b)
    let hover_way = motion::NodeWay::new(0.0)
    b.reacts(at_start=false, fn() { !btn.disabled() && btn.hovered() }, fn(on : Bool) -> Unit {
      hover_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    let eff_tint = fn() -> Int64 {
      if tint != clear {
        tint
      } else if active() {
        ctrl_chip_selected_tint()
      } else {
        clear
      }
    }
    let _ = b
      .width(view::Live::Is(Some(side)))
      .height(view::Live::Is(Some(side)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(r))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground_drawn(view::Live::By(fn() {
        if !interactive {
          return view::ground_as_laid
        }
        let (w, h) = ih.size.get()
        let (dx, dy, sx, sy) = ih.stretch(b)
        stretched(w, h, dx, dy, sx, sy)
      }))
      .alpha(view::Live::By(fn() { if btn.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
    lg_apply_glass_surface(b, fn() {
      let (bz, rf) = ctrl_button_glass_params(size)
      lg_capsule_glass(tint=eff_tint(), surface=surface, bezel=bz, refraction=rf)
    })
    if interactive {
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit {
          if !btn.disabled() {
            ih.down(d.x, d.y, d.w, d.h)
          }
        },
        tap=fn(_d : view::Drag) -> Unit {
          ih.up()
          if !btn.disabled() {
            btn.press()
          }
        },
        drag=fn(d : view::Drag) -> Unit {
          if btn.disabled() {
            return
          }
          match d.kind {
            Down => ih.moved(d.x, d.y)
            Moved => ih.moved(d.x, d.y)
            Up => {
              ih.up()
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => ih.up()
          }
        },
      )
      let _ = b.box(fn(ov : view::View) -> Unit {
        let _ = ov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(r))
          .ground(view::Live::Is(white))
          .alpha(view::Live::By(fn() { clamp(ih.pressed(ov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          .ground_drawn(view::Live::By(fn() {
            let (w, h) = ih.size.get()
            let (dx, dy, sx, sy) = ih.stretch(ov)
            stretched(w, h, dx, dy, sx, sy)
          }))
      })
    }
    let _ = b.box(fn(hov : view::View) -> Unit {
      let _ = hov
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(r))
        .ground(view::Live::By(ctrl_hover_ink))
        .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_hover_alpha }))
    })
    let _ = b.box(fn(c : view::View) -> Unit {
      let _ = c
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .offset(view::Live::By(fn() {
          if interactive {
            let (dx, dy, _, _) = ih.stretch(b)
            (dx, dy)
          } else {
            (0.0, 0.0)
          }
        }))
        .scale(view::Live::By(fn() {
          if interactive {
            let (_, _, sx, sy) = ih.stretch(b)
            (sx + sy) / 2.0
          } else {
            1.0
          }
        }))
      icon(c, fn() { if eff_tint() != clear { white } else { colors().content } })
    })
    lg_focus_ring(b, fn() { btn.focus_shown() }, r)
  })
}

pub struct LiquidGroupAction {
  pub label : () -> String
  pub icon : (view::View, () -> Int64) -> Unit
  pub press : () -> Unit
  pub active : () -> Bool
  pub disabled : () -> Bool
}

pub fn LiquidGroupAction::new(
  label~ : () -> String,
  icon~ : (view::View, () -> Int64) -> Unit,
  press~ : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
) -> LiquidGroupAction {
  LiquidGroupAction::{ label, icon, press, active, disabled }
}

pub fn liquid_button_group_node(
  parent : view::View,
  actions : () -> Array[LiquidGroupAction],
  size~ : LiquidButtonSize = LiquidButtonSize::Regular,
  surface~ : Int64 = clear,
  loc~ : String = "",
) -> view::View {
  let h = ctrl_button_size_px(size)
  let r_outer = h / 2.0
  let inner_h = h - 2.0 * ctrl_group_pad
  let r_inner = inner_h / 2.0
  let div_h = h * ctrl_divider_ratio
  parent.box(loc=loc, fn(g : view::View) -> Unit {
    let _ = g
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .height(view::Live::Is(Some(h)))
      .shrink(view::Live::Is(0.0))
      .padding(view::Live::Is((ctrl_group_pad, ctrl_group_pad, ctrl_group_pad, ctrl_group_pad)))
      .radius(view::Live::Is(r_outer))
      .says(view::Live::Is(Some(view::said(view::Role::Group, label="Action Group"))))
    lg_apply_glass_surface(g, fn() {
      let (bz, rf) = ctrl_button_glass_params(size)
      lg_capsule_glass(surface=surface, bezel=bz, refraction=rf)
    })
    g.each(
      fn() -> Array[Int] {
        let n = actions().length()
        let ids : Array[Int] = []
        let mut i = 0
        while i < n {
          ids.push(i)
          i += 1
        }
        ids
      },
      fn(i : Int) -> Int { i },
      fn(slot : view::View, idx_sig : signals::Signal[Int]) -> Unit {
        let idx = signals::untracked(fn() { idx_sig.get() })
        let _ = slot.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        if idx > 0 {
          let _ = slot.box(fn(div : view::View) -> Unit {
            let _ = div
              .width(view::Live::Is(Some(ctrl_hairline_w)))
              .height(view::Live::Is(Some(div_h)))
              .shrink(view::Live::Is(0.0))
              .margin(view::Live::Is((ctrl_group_item_gap, 0.0, ctrl_group_item_gap, 0.0)))
              .ground(view::Live::By(ctrl_divider_ink))
          })
        }
        let get_action = fn() -> Option[LiquidGroupAction] {
          let arr = actions()
          let k = idx_sig.get()
          if k >= 0 && k < arr.length() { Some(arr[k]) } else { None }
        }
        let item_label = fn() -> String {
          match get_action() {
            Some(a) => (a.label)()
            None => ""
          }
        }
        let item_disabled = fn() -> Bool {
          match get_action() {
            Some(a) => (a.disabled)()
            None => true
          }
        }
        let item_active = fn() -> Bool {
          match get_action() {
            Some(a) => (a.active)()
            None => false
          }
        }
        let item_press = fn() -> Unit {
          match get_action() {
            Some(a) => (a.press)()
            None => ()
          }
        }
        let _ = headless::button(loc=loc, slot, item_label, fn(_e) -> Unit { item_press() }, disabled=item_disabled, fn(b : view::View, btn : headless::Button) -> Unit {
          let highlight_way = motion::NodeWay::new(0.0)
          let active_way = motion::NodeWay::new(if signals::untracked(item_active) { 1.0 } else { 0.0 })
          let press_way = motion::NodeWay::new(0.0)
          b.reacts(
            at_start=false,
            fn() -> Double {
              if btn.disabled() {
                0.0
              } else if btn.pressed() {
                1.0
              } else if btn.hovered() {
                0.5
              } else {
                0.0
              }
            },
            fn(to : Double) -> Unit { highlight_way.go(b, to, motion::snappy_damped) },
          )
          b.reacts(at_start=false, item_active, fn(on : Bool) -> Unit {
            active_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          b.reacts(at_start=false, fn() { !btn.disabled() && btn.pressed() }, fn(on : Bool) -> Unit {
            press_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          let _ = b
            .width(view::Live::Is(Some(inner_h)))
            .height(view::Live::Is(Some(inner_h)))
            .shrink(view::Live::Is(0.0))
            .radius(view::Live::Is(r_inner))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .scale(view::Live::By(fn() { 1.0 - 0.07 * clamp(press_way.shown(b), 0.0, 1.0) }))
            .alpha(view::Live::By(fn() { if btn.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
          let _ = b.box(fn(act : view::View) -> Unit {
            let _ = act
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(r_inner))
              .ground(view::Live::By(ctrl_chip_selected_tint))
              .scale(view::Live::By(fn() { lerp(0.88, 1.0, clamp(active_way.shown(act), 0.0, 1.0)) }))
              .alpha(view::Live::By(fn() { clamp(active_way.shown(act), 0.0, 1.0) }))
          })
          let _ = b.box(fn(hov : view::View) -> Unit {
            let _ = hov
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(r_inner))
              .ground(view::Live::By(ctrl_hover_ink))
              .alpha(view::Live::By(fn() { clamp(highlight_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          })
          let init_actions = signals::untracked(actions)
          if idx >= 0 && idx < init_actions.length() {
            let a = init_actions[idx]
            (a.icon)(b, fn() { if item_active() { white } else { colors().content } })
          }
          b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
            let _ = ring
              .over(view::Live::Is(true))
              .points(view::Live::Is(false))
              .radius(view::Live::Is(r_inner))
              .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
          })
        })
      },
      at_once=true,
    )
  })
}
