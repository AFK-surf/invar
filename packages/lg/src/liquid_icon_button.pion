// Circular liquid glass icon button and unified floating capsule button group.
// Single-layer iOS 27 Glass::liquid on the outer capsule; inner group buttons use
// concentric translucent highlights (zero glass-on-glass).

import "headless"
import "motion"
import "paint"
import "signals"
import "ui"
import "view"

/// Layout axis for `liquid_pill_group_node` (horizontal top-bar pill vs. vertical floating pill).
#derive(Eq)
pub enum PillDirection {
  Horizontal
  Vertical
}

/// Size presets for liquid glass icon buttons and button groups (28 / 32 / 40 pt).
#derive(Eq)
pub enum LiquidButtonSize {
  Small
  Regular
  Large
}

fn ctrl_button_size_px(size : LiquidButtonSize) -> Double {
  match size {
    Small => ctrl_btn_sm
    Regular => ctrl_btn_md
    Large => ctrl_btn_lg
  }
}

fn ctrl_button_glass_params(size : LiquidButtonSize) -> (Double, Double) {
  match size {
    Small => (12.0, 16.0)
    Regular => (14.0, 18.0)
    Large => (16.0, 20.0)
  }
}

fn opt_pair_d_eq(a : Option[(Double, Double)], b : Option[(Double, Double)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((ax, ay)), Some((bx, by))) => ax == bx && ay == by
    _ => false
  }
}

fn pill_fx_eq(
  a : (Option[(Double, Double)], Int),
  b : (Option[(Double, Double)], Int),
) -> Bool {
  a.1 == b.1 && opt_pair_d_eq(a.0, b.0)
}

/// Shared press-feedback scope lent by `liquid_pill_group_node` and `liquid_button_group_node` to
/// their interactive children (`bind_pill_press` / `bind_pill_press_by`).
struct PillPressScope {
  pill : view::View
  fx : signals::Signal[(Option[(Double, Double)], Int)]
  press_way : motion::NodeWay
  mut count : Int
}

let pill_press_lent : view::Lent[PillPressScope] = view::Lent::new()

/// Trigger scope lent by `liquid_pill_group_node` and `liquid_capsule_decorate(..., trigger=true)`
/// to their children (0 extra signals, 0 cold-start bindings) so an anchored popover can briefly
/// activate a private SDF fusion layer or in-place morph override (`morph_glass` / `morph_shadow`)
/// while keeping adjacent pills isolated and restoring `rest_glass` on close.
pub struct PillTriggerScope {
  pub pill : view::View
  pub fx : signals::Signal[(Option[(Double, Double)], Int)]
  pub press_way : motion::NodeWay
  pub morph_glass : signals::Ref[Option[() -> Option[paint::Glass]]]
  pub morph_shadow : signals::Ref[Option[() -> (Double, Double, Int64)]]
  pub mut morph_owner : Int
  pub mut morph_cancel : Option[() -> Unit]
  pub children : Array[view::View]
  pub height : Double
  pub pad : Double
  pub direction : PillDirection
  pub has_press_scale : Bool
  pub rest_glass : () -> paint::Glass
}

pub let liquid_pill_trigger_lent : view::Lent[PillTriggerScope] = view::Lent::new()

/// Whether `child` sits inside a `liquid_pill_group_node` (or `liquid_button_group_node`).
pub fn in_liquid_pill(child : view::View) -> Bool {
  match child.lent(pill_press_lent) {
    Some(_) => true
    None => false
  }
}

/// Theme-adaptive hover overlay ink for controls inside a liquid glass pill group.
pub fn liquid_pill_hover_ink(solid~ : Bool = false) -> Int64 {
  if !solid {
    if is_dark() { 0xFFFFFF29L } else { 0x0000001CL }
  } else if is_dark() {
    0xFFFFFF24L
  } else {
    0x00000014L
  }
}

/// Theme-adaptive press overlay ink for controls inside a liquid glass pill group.
pub fn liquid_pill_press_ink(solid~ : Bool = false) -> Int64 {
  liquid_press_ink(solid=solid)
}

/// Connects an interactive child control inside `liquid_pill_group_node` (or `liquid_button_group_node`)
/// to its enclosing liquid glass pill's press response: moves the GPU `spot` specular highlight to
/// the child's center and springs the outer pill scale via `motion::backdrop_press_spring`.
/// No-op outside a pill group.
pub fn bind_pill_press(child : view::View) -> Unit {
  bind_pill_press_by(child, fn() { child.pressed() })
}

/// Connects `child` inside a pill group to its enclosing pill's press response using a custom
/// `down` predicate, sharing the pill's press count and `liquid_pill_trigger_lent` child list.
/// No-op outside a pill group.
pub fn bind_pill_press_by(child : view::View, down : () -> Bool) -> Unit {
  let pscope = match child.lent(pill_press_lent) {
    Some(s) => s
    None => return
  }
  let trig_opt = match child.lent(liquid_pill_trigger_lent) {
    Some(trig) if trig.pill.id() == pscope.pill.id() => Some(trig)
    _ => None
  }
  match trig_opt {
    Some(trig) => trig.children.push(child)
    None => ()
  }
  let active = ui::ref_new(false)
  let release = fn() -> Unit {
    if active.v {
      active.v = false
      pscope.count = if pscope.count > 0 { pscope.count - 1 } else { 0 }
      if pscope.count == 0 {
        let (_, ly) = pscope.fx.untracked()
        pscope.fx.set((None, ly))
        pscope.press_way.go(pscope.pill, 0.0, motion::backdrop_press_spring)
      }
    }
  }
  child.reacts(down, fn(is_down : Bool) -> Unit {
    if is_down {
      if !active.v {
        active.v = true
        pscope.count += 1
      }
      if !(pscope.pill.glass_solid() || ui::glass_solid()) {
        let (gx, gy, _, _) = pscope.pill.placed_window_now()
        let (cx, cy, cw, ch) = child.placed_window_now()
        let (_, ly) = pscope.fx.untracked()
        pscope.fx.set((Some((cx - gx + cw / 2.0, cy - gy + ch / 2.0)), ly))
      }
      if !ui::reduced_motion() {
        pscope.press_way.go(pscope.pill, 1.0, motion::backdrop_press_spring)
      }
    } else {
      release()
    }
  })
  let _ = child.owns(fn() -> Unit {
    release()
    match trig_opt {
      Some(trig) => {
        let cid = child.id()
        let n = trig.children.length()
        let mut idx = -1
        let mut i = 0
        while i < n {
          if trig.children[i].id() == cid {
            idx = i
            break
          }
          i += 1
        }
        if idx >= 0 {
          let mut j = idx
          while j + 1 < n {
            trig.children[j] = trig.children[j + 1]
            j += 1
          }
          let _ = trig.children.pop()
        }
      }
      None => ()
    }
  })
}

/// A generic single-layer floating Liquid Glass pill container in `parent` for a group of bar
/// controls built by `body`. Children that call `bind_pill_press` / `bind_pill_press_by`
/// automatically steer the outer capsule's GPU `spot` highlight to their center and spring-scale
/// the capsule (`1.05×`). Also lends `liquid_pill_trigger_lent` for private SDF layer fusion
/// and in-place popover morphing.
pub fn liquid_pill_group_node(
  parent : view::View,
  body : (view::View) -> Unit,
  height~ : Double = 40.0,
  pad~ : Double = 3.0,
  pad_y? : Double,
  gap~ : Double = 2.0,
  direction~ : PillDirection = PillDirection::Horizontal,
  sharing~ : Bool = true,
  solid? : () -> Int64,
  tint? : () -> Int64,
  shadow? : () -> (Double, Double, Int64),
  solid_edge? : () -> (Double, Int64),
  floating~ : Bool = false,
  adaptive~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(g : view::View) -> Unit {
    let r = height / 2.0
    let py = match pad_y {
      Some(v) => v
      None => pad
    }
    let fx_sig : signals::Signal[(Option[(Double, Double)], Int)] = signals::signal_by((None, 0), pill_fx_eq)
    let morph_glass : signals::Ref[Option[() -> Option[paint::Glass]]] = ui::ref_new(None)
    let morph_shadow : signals::Ref[Option[() -> (Double, Double, Int64)]] = ui::ref_new(None)
    let children : Array[view::View] = []
    let press_way = motion::NodeWay::new(0.0)
    let pscope = PillPressScope::{ pill: g, fx: fx_sig, press_way, count: 0 }
    let make_glass = fn(sp : Option[(Double, Double)], ly : Int) -> paint::Glass {
      let eff_sharing = if ly > 0 { false } else { sharing }
      let sol = match solid {
        Some(f) => f()
        None => clear
      }
      let base = if floating {
        match tint {
          Some(tf) => {
            let c = tf()
            let base_sol = if sol != clear {
              sol
            } else if is_dark() {
              0x1E1F24FFL
            } else {
              0xFAFAFAFFL
            }
            liquid_floating_glass(
              tint=c,
              solid=over(base_sol, alpha(c, 0.24)),
              spot?=sp,
              sharing=eff_sharing,
            )
          }
          None => liquid_floating_glass(solid=sol, spot?=sp, sharing=eff_sharing)
        }
      } else {
        match tint {
          Some(tf) => {
            let c = tf()
            let base_sol = if sol != clear {
              sol
            } else if is_dark() {
              0x1E1F24FFL
            } else {
              0xFAFAFAFFL
            }
            let bg = liquid_bar_pill_glass(
              spot?=sp,
              solid=over(base_sol, alpha(c, 0.24)),
              sharing=eff_sharing,
              adaptive=adaptive,
            )
            paint::Glass::{ ..bg, tint: c }
          }
          None => liquid_bar_pill_glass(spot?=sp, solid=sol, sharing=eff_sharing, adaptive=adaptive)
        }
      }
      if ly > 0 {
        paint::Glass::{ ..base, layer: ly, break_gap: 12.0 }
      } else {
        base
      }
    }
    let trig_scope = PillTriggerScope::{
      pill: g,
      fx: fx_sig,
      press_way,
      morph_glass,
      morph_shadow,
      morph_owner: 0,
      morph_cancel: None,
      children,
      height,
      pad,
      direction,
      has_press_scale: true,
      rest_glass: fn() { make_glass(None, 0) },
    }
    let rest_shadow = fn() -> (Double, Double, Int64) {
      match shadow {
        Some(f) => f()
        None => glass_control_shadow()
      }
    }
    match direction {
      Horizontal => {
        let _ = g.row(view::Live::Is(true)).height(view::Live::Is(Some(height)))
      }
      Vertical => {
        let _ = g.width(view::Live::Is(Some(height)))
      }
    }
    let _ = g
    .radius(view::Live::Is(r))
    .padding(view::Live::Is((pad, py, pad, py)))
    .gap(view::Live::Is(gap))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .shrink(view::Live::Is(0.0))
    // invar-audit-allow: E008 (morph_glass Ref is invalidated via fx_sig.get())
    .glass(view::Live::By(fn() {
      let (sp, ly) = fx_sig.get()
      if ly != 0 {
        match morph_glass.v {
          Some(f) => f()
          None => if ly < 0 { None } else { Some(make_glass(sp, ly)) }
        }
      } else {
        Some(make_glass(sp, ly))
      }
    }))
    .scale(view::Live::By(fn() { 1.0 + 0.05 * press_way.shown(g) }), about=view::Pivot::At(0.5, 0.5))
    .edge(view::Live::By(fn() {
      if g.glass_solid() || ui::glass_solid() {
        match solid_edge {
          Some(f) => f()
          None => liquid_solid_edge()
        }
      } else {
        (0.0, clear)
      }
    }))
    // invar-audit-allow: E008 (morph_shadow Ref is invalidated via fx_sig.get())
    .shadow(view::Live::By(fn() {
      let (_, ly) = fx_sig.get()
      if ly != 0 {
        match morph_shadow.v {
          Some(f) => f()
          None => if ly < 0 { shadow_none } else { rest_shadow() }
        }
      } else {
        rest_shadow()
      }
    }))
    .shadow_outside(view::Live::Is(true))
    .clips(view::Live::Is(true))
    .lends(pill_press_lent, pscope)
    .lends(liquid_pill_trigger_lent, trig_scope)
    .lends(surface_context_lent, SurfaceContext::Content)
    body(g)
  })
}

pub fn liquid_icon_button_node(
  parent : view::View,
  label : () -> String,
  icon : (view::View, () -> Int64) -> Unit,
  press : () -> Unit,
  size~ : LiquidButtonSize = LiquidButtonSize::Regular,
  side? : Double,
  tint~ : Int64 = clear,
  surface~ : Int64 = clear,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  interactive~ : Bool = true,
  sharing~ : Bool = false,
  highlight? : InteractiveHighlight,
  loc~ : String = "",
) -> view::View {
  let side_px = match side {
    Some(s) => s
    None => ctrl_button_size_px(size)
  }
  let r = side_px / 2.0
  let hit_side = dmax(side_px, 36.0)
  let hit_out = (hit_side - side_px) / 2.0
  headless::button(loc=loc, parent, label, fn(_e) -> Unit { press() }, disabled=disabled, fn(b : view::View, btn : headless::Button) -> Unit {
    let ih = match highlight {
      Some(l) => l
      None => InteractiveHighlight::new()
    }
    ih.attach(b)
    let hover_way = motion::NodeWay::new(0.0)
    let press_way = motion::NodeWay::new(0.0)
    b.reacts(at_start=false, fn() { !btn.disabled() && btn.hovered() }, fn(on : Bool) -> Unit {
      hover_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
    })
    let eff_tint = fn() -> Int64 {
      if tint != clear {
        tint
      } else if active() {
        ctrl_chip_selected_tint()
      } else {
        clear
      }
    }
    let _ = b
    .width(view::Live::Is(Some(hit_side)))
    .height(view::Live::Is(Some(hit_side)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(hit_side / 2.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .alpha(view::Live::By(fn() { if btn.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
    if hit_out > 0.0 {
      let _ = b.margin(view::Live::Is((-hit_out, -hit_out, -hit_out, -hit_out)))
    }
    if interactive {
      let _ = b.gesture(
        ui::touch_slop(),
        press=fn(d : view::Drag) -> Unit {
          if !btn.disabled() {
            ih.down(d.x, d.y, d.w, d.h)
            press_way.go(b, 1.0, motion::backdrop_press_spring)
          }
        },
        tap=fn(_d : view::Drag) -> Unit {
          ih.up()
          press_way.go(b, 0.0, motion::backdrop_press_spring)
          if !btn.disabled() {
            btn.press()
          }
        },
        drag=fn(d : view::Drag) -> Unit {
          if btn.disabled() {
            return
          }
          match d.kind {
            Down => ih.moved(d.x, d.y)
            Moved => ih.moved(d.x, d.y)
            Up => {
              ih.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
              if d.x >= 0.0 && d.x <= d.w && d.y >= 0.0 && d.y <= d.h {
                btn.press()
              }
            }
            Off => {
              ih.up()
              press_way.go(b, 0.0, motion::backdrop_press_spring)
            }
          }
        },
      )
    }
    let _ = b.box(fn(pill : view::View) -> Unit {
      let _ = pill
      .width(view::Live::Is(Some(side_px)))
      .height(view::Live::Is(Some(side_px)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(r))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .shadow(view::Live::By(glass_control_shadow))
      .shadow_outside(view::Live::Is(true))
      .glass(view::Live::By(fn() {
        let (bz, rf) = ctrl_button_glass_params(size)
        let sp = if interactive && ih.pressed(pill) > 0.001 {
          let (w, h) = ih.size.get()
          if w > 0.0 && h > 0.0 {
            Some(ih.spot(pill, w, h))
          } else {
            None
          }
        } else {
          None
        }
        Some(liquid_control_glass(tint=eff_tint(), surface=surface, bezel=bz, refraction=rf, spot?=sp, sharing=sharing))
      }))
      .edge(view::Live::By(fn() { if pill.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) } }))
      .scale(
        view::Live::By(fn() {
          if !interactive || ui::reduced_motion() {
            1.0
          } else {
            lerp(1.0, 0.97, clamp(press_way.shown(pill), 0.0, 1.0))
          }
        }),
        about=view::Pivot::At(0.5, 0.5),
      )
      if interactive {
        let _ = pill.box(fn(ov : view::View) -> Unit {
          let _ = ov
          .over(view::Live::Is(true))
          .points(view::Live::Is(false))
          .radius(view::Live::Is(r))
          .ground(view::Live::By(fn() { liquid_press_ink(solid=pill.glass_solid() || ui::glass_solid()) }))
          .alpha(view::Live::By(fn() { clamp(press_way.shown(ov), 0.0, 1.0) }))
        })
      }
      let _ = pill.box(fn(hov : view::View) -> Unit {
        let _ = hov
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .radius(view::Live::Is(r))
        .ground(view::Live::By(ctrl_hover_ink))
        .alpha(view::Live::By(fn() { clamp(hover_way.shown(hov), 0.0, 1.0) * ctrl_hover_alpha }))
      })
      let _ = pill.box(fn(c : view::View) -> Unit {
        let _ = c
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        icon(c, fn() { if eff_tint() != clear { white } else { colors().content } })
      })
      lg_focus_ring(pill, fn() { btn.focus_shown() }, r)
    })
  })
}

pub struct LiquidGroupAction {
  pub label : () -> String
  pub icon : (view::View, () -> Int64) -> Unit
  pub press : () -> Unit
  pub active : () -> Bool
  pub disabled : () -> Bool
}

pub fn LiquidGroupAction::new(
  label~ : () -> String,
  icon~ : (view::View, () -> Int64) -> Unit,
  press~ : () -> Unit,
  active~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
) -> LiquidGroupAction {
  LiquidGroupAction::{ label, icon, press, active, disabled }
}

pub fn liquid_button_group_node(
  parent : view::View,
  actions : () -> Array[LiquidGroupAction],
  size~ : LiquidButtonSize = LiquidButtonSize::Regular,
  surface~ : Int64 = clear,
  loc~ : String = "",
) -> view::View {
  let h = ctrl_button_size_px(size)
  let r_outer = h / 2.0
  let inner_h = h - 2.0 * ctrl_group_pad
  let r_inner = inner_h / 2.0
  let div_h = h * ctrl_divider_ratio
  parent.box(loc=loc, fn(g : view::View) -> Unit {
    let fx_sig : signals::Signal[(Option[(Double, Double)], Int)] = signals::signal_by((None, 0), pill_fx_eq)
    let press_way = motion::NodeWay::new(0.0)
    let pscope = PillPressScope::{ pill: g, fx: fx_sig, press_way, count: 0 }
    let _ = g
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .height(view::Live::Is(Some(h)))
    .shrink(view::Live::Is(0.0))
    .padding(view::Live::Is((ctrl_group_pad, ctrl_group_pad, ctrl_group_pad, ctrl_group_pad)))
    .radius(view::Live::Is(r_outer))
    .shadow(view::Live::By(glass_control_shadow))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() {
      let (bz, rf) = ctrl_button_glass_params(size)
      Some(liquid_control_glass(tint=clear, surface=surface, bezel=bz, refraction=rf, spot?=fx_sig.get().0))
    }))
    .scale(view::Live::By(fn() { 1.0 + 0.05 * press_way.shown(g) }), about=view::Pivot::At(0.5, 0.5))
    .edge(view::Live::By(fn() { if g.glass_solid() || ui::glass_solid() { liquid_solid_edge() } else { (0.0, clear) } }))
    .lends(pill_press_lent, pscope)
    .lends(surface_context_lent, SurfaceContext::Content)
    .says(view::Live::Is(Some(view::said(view::Role::Group, label="Action Group"))))
    g.each(
      fn() -> Array[Int] {
        let n = actions().length()
        let ids : Array[Int] = []
        let mut i = 0
        while i < n {
          ids.push(i)
          i += 1
        }
        ids
      },
      fn(i : Int) -> Int { i },
      fn(slot : view::View, idx_sig : signals::Signal[Int]) -> Unit {
        let idx = signals::untracked(fn() { idx_sig.get() })
        let _ = slot.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        if idx > 0 {
          let _ = slot.box(fn(div : view::View) -> Unit {
            let _ = div
            .width(view::Live::Is(Some(ctrl_hairline_w)))
            .height(view::Live::Is(Some(div_h)))
            .shrink(view::Live::Is(0.0))
            .margin(view::Live::Is((ctrl_group_item_gap, 0.0, ctrl_group_item_gap, 0.0)))
            .ground(view::Live::By(ctrl_divider_ink))
          })
        }
        let get_action = fn() -> Option[LiquidGroupAction] {
          let arr = actions()
          let k = idx_sig.get()
          if k >= 0 && k < arr.length() { Some(arr[k]) } else { None }
        }
        let item_label = fn() -> String {
          match get_action() {
            Some(a) => (a.label)()
            None => ""
          }
        }
        let item_disabled = fn() -> Bool {
          match get_action() {
            Some(a) => (a.disabled)()
            None => true
          }
        }
        let item_active = fn() -> Bool {
          match get_action() {
            Some(a) => (a.active)()
            None => false
          }
        }
        let item_press = fn() -> Unit {
          match get_action() {
            Some(a) => (a.press)()
            None => ()
          }
        }
        let _ = headless::button(loc=loc, slot, item_label, fn(_e) -> Unit { item_press() }, disabled=item_disabled, fn(b : view::View, btn : headless::Button) -> Unit {
          bind_pill_press(b)
          let highlight_way = motion::NodeWay::new(0.0)
          let active_way = motion::NodeWay::new(if signals::untracked(item_active) { 1.0 } else { 0.0 })
          let press_way = motion::NodeWay::new(0.0)
          b.reacts(
            at_start=false,
            fn() -> Double {
              if btn.disabled() {
                0.0
              } else if btn.pressed() {
                1.0
              } else if btn.hovered() {
                0.5
              } else {
                0.0
              }
            },
            fn(to : Double) -> Unit { highlight_way.go(b, to, motion::snappy_damped) },
          )
          b.reacts(at_start=false, item_active, fn(on : Bool) -> Unit {
            active_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          b.reacts(at_start=false, fn() { !btn.disabled() && btn.pressed() }, fn(on : Bool) -> Unit {
            press_way.go(b, if on { 1.0 } else { 0.0 }, motion::snappy_damped)
          })
          let _ = b
          .width(view::Live::Is(Some(inner_h)))
          .height(view::Live::Is(Some(inner_h)))
          .shrink(view::Live::Is(0.0))
          .radius(view::Live::Is(r_inner))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .scale(view::Live::By(fn() { 1.0 - 0.07 * clamp(press_way.shown(b), 0.0, 1.0) }))
          .alpha(view::Live::By(fn() { if btn.disabled() { ctrl_disabled_alpha } else { 1.0 } }))
          let _ = b.box(fn(act : view::View) -> Unit {
            let _ = act
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .radius(view::Live::Is(r_inner))
            .ground(view::Live::By(ctrl_chip_selected_tint))
            .scale(view::Live::By(fn() { lerp(0.88, 1.0, clamp(active_way.shown(act), 0.0, 1.0)) }))
            .alpha(view::Live::By(fn() { clamp(active_way.shown(act), 0.0, 1.0) }))
          })
          let _ = b.box(fn(hov : view::View) -> Unit {
            let _ = hov
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .radius(view::Live::Is(r_inner))
            .ground(view::Live::By(ctrl_hover_ink))
            .alpha(view::Live::By(fn() { clamp(highlight_way.shown(hov), 0.0, 1.0) * ctrl_press_glow_alpha }))
          })
          let init_actions = signals::untracked(actions)
          if idx >= 0 && idx < init_actions.length() {
            let a = init_actions[idx]
            (a.icon)(b, fn() { if item_active() { white } else { colors().content } })
          }
          b.show(fn() { btn.focus_shown() }, fn(ring : view::View) -> Unit {
            let _ = ring
            .over(view::Live::Is(true))
            .points(view::Live::Is(false))
            .radius(view::Live::Is(r_inner))
            .edge(view::Live::By(fn() { (ctrl_focus_w, colors().accent) }))
          })
        })
      },
      at_once=true,
    )
  })
}
