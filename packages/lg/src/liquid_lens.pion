// Clear refractive liquid glass lens overlays.
// Zero hidden glass at rest, lazy mount on first interaction, and zero relayout on release.

import "signals"
import "ui"
import "view"

/// Lazy-mounted clear refractive liquid glass lens overlay (`liquid_tab_lens_glass`) above a
/// segmented control, tab strip, or slider knob. Mounts lazily on first press (`lens() > 0.001 ||
/// active()`) so idle controls allocate 0 extra nodes and 0 hidden glass, then stays mounted across
/// settle (`glass=None` when `lens <= 0.001`) so release triggers 0 relayout.
pub fn liquid_lens_overlay_node(
  parent : view::View,
  lens : () -> Double,
  height : () -> Double,
  rect~ : () -> Option[(Double, Double, Double, Double)] = fn() { None },
  ground_drawn? : (view::View) -> view::GroundShape,
  width~ : () -> Double = fn() { 0.0 },
  radius~ : Double = 1.0e6,
  solid? : () -> Int64,
  shadow_color~ : () -> Int64 = fn() { ui::tree_theme().shadow },
  shadow_blur~ : Double = 6.0,
  shadow_y~ : Double = 2.0,
  jelly? : (view::View) -> (Double, Double),
  grow~ : Double = 0.0,
  active~ : () -> Bool = fn() { false },
  droplet_role~ : Int = 4,
  loc~ : String = "",
) -> Unit {
  let mounted : signals::Signal[Bool] = signals::signal(false)
  parent.reacts(fn() { lens() > 0.001 || active() }, fn(on : Bool) -> Unit {
    if on && !mounted.untracked() {
      mounted.set(true)
    }
  })
  parent.show(
    fn() { mounted.get() },
    fn(l : view::View) -> Unit {
      let full = fn() -> Double { clamp(lens(), 0.0, 1.0) }
      let _ = l
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .offset(view::Live::Is((0.0, 0.0)))
      .width(view::Live::By(fn() { Some(width()) }))
      .height(view::Live::By(fn() { Some(height()) }))
      .radius(view::Live::Is(radius))
      .glass(
        view::Live::By(fn() {
          let p = full()
          if p > 0.001 && !(l.glass_solid() || ui::glass_solid()) {
            let sol = match solid {
              Some(f) => f()
              None => clear
            }
            Some(liquid_tab_lens_glass(p, solid=sol, droplet_role=droplet_role))
          } else {
            None
          }
        }),
      )
      .shadow(
        view::Live::By(fn() {
          let p = full()
          if p > 0.001 && !(l.glass_solid() || ui::glass_solid()) {
            (shadow_blur * p, shadow_y * p, shadow_color())
          } else {
            shadow_none
          }
        }),
      )
      .shadow_outside(view::Live::Is(true))
      .alpha(view::Live::By(full))
      .ground_drawn(
        view::Live::By(fn() {
          match ground_drawn {
            Some(f) => f(l)
            None =>
            match rect() {
              Some((rx, ry, rw, _)) => {
                let hh = height()
                let ww = width()
                let (lw, lh) = match jelly {
                  Some(jf) => {
                    let (sx, sy) = jf(l)
                    (dmax(0.0, rw + hh * (sx - 1.0)), dmax(0.0, hh * sy))
                  }
                  None => {
                    let g = grow * full()
                    (dmax(0.0, rw + g * 2.0), dmax(0.0, hh + g * 2.0))
                  }
                }
                let r = dmin(radius, dmin(lw, lh) / 2.0)
                view::GroundShape::{
                  dx: rx + (rw - lw) / 2.0,
                  dy: ry + (hh - lh) / 2.0,
                  dw: lw - ww,
                  dh: lh - hh,
                  corners: Some((r, r, r, r)),
                }
              }
              None => view::ground_as_laid
            }
          }
        }),
        loc=loc,
      )
    },
    at_once=true,
  )
}
