// Generic single-layer Liquid Glass panel / menu / candidate / find-bar surface decorator and shell.
// Enforces zero hidden glass instances when `active()` is false, `shadow_outside(Is(true))`,
// optional smooth-min capillary `merge`, and solid-glass hairline fallback.

import "paint"
import "ui"
import "view"

/// Decorates an existing panel container node `v` in place (zero wrapper nodes) with single-layer
/// `liquid_panel_glass`, optional capillary `merge`, `active` gating (submits `None` glass, zero edge,
/// and zero shadow when inactive), `shadow_outside(Is(true))`, solid-glass hairline fallback,
/// and optional `radius` / `clips`. Returns `v` for chaining.
pub fn liquid_panel_surface_decorate(
  v : view::View,
  radius? : Double,
  solid? : () -> Int64,
  merge? : () -> Double,
  active~ : () -> Bool = fn() { true },
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = v.radius(view::Live::Is(r))
    }
    None => ()
  }
  if clips {
    let _ = v.clips(view::Live::Is(true))
  }
  let _ = v
  .glass(
    view::Live::By(fn() {
      if !active() {
        return None
      }
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      let g = liquid_panel_glass(solid=s)
      match merge {
        Some(mf) => {
          let m = mf()
          if m > 0.0 {
            Some(paint::Glass::{ ..g, merge: m })
          } else {
            Some(g)
          }
        }
        None => Some(g)
      }
    }),
  )
  .edge(
    view::Live::By(fn() {
      if active() && (v.glass_solid() || ui::glass_solid()) {
        solid_edge()
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if active() {
        shadow()
      } else {
        shadow_none
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  v
}

/// Composable single-layer Liquid Glass panel shell (`r=16pt` by default) wrapping `body` with
/// `liquid_panel_surface_decorate`. Suitable for floating panels, menus, candidate lists, and find bars.
pub fn liquid_panel_shell_node(
  parent : view::View,
  body : (view::View) -> Unit,
  radius~ : Double = ovl_popover_radius,
  solid? : () -> Int64,
  merge? : () -> Double,
  active~ : () -> Bool = fn() { true },
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
  clips~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(v : view::View) -> Unit {
    let _ = v.lends(surface_context_lent, SurfaceContext::Content)
    let _ = liquid_panel_surface_decorate(
      v,
      radius?=Some(radius),
      solid?=solid,
      merge?=merge,
      active=active,
      shadow=shadow,
      solid_edge=solid_edge,
      clips=clips,
    )
    body(v)
  })
}
