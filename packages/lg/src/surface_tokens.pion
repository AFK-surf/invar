// Unified Apple iOS 26/27 & macOS Tahoe Content Layer surface palette, concentric corner ladder,
// and zero-glass content components (`surface_card_node`, `surface_section_node`, `surface_code_block_node`).
// Use these for page content, feeds, lists, cards, and code blocks; reserve `Glass::liquid` strictly
// for floating chrome, navigation islands, toolbars, overlays, and refractive interaction lenses.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

/// Semantic Content Layer color palette (0xRRGGBBAA), coordinated with `lg::colors()`.
pub struct SurfacePalette {
  /// Primary page canvas background.
  pub canvas : Int64
  /// Grouped list / settings page background.
  pub grouped_bg : Int64
  /// Desktop sidebar background.
  pub sidebar : Int64
  /// Primary content card solid surface.
  pub card : Int64
  /// Secondary / inset content block solid surface.
  pub card_secondary : Int64
  /// Primary body & heading ink.
  pub ink : Int64
  /// Secondary descriptive ink.
  pub ink_secondary : Int64
  /// Tertiary caption / placeholder ink.
  pub ink_tertiary : Int64
  /// 0.5pt hairline separator / card border.
  pub separator : Int64
  /// Stronger border for focused or distinct containers.
  pub separator_strong : Int64
  /// Subtle hover wash for content rows.
  pub row_hover : Int64
  /// Subtle selection tint for active content rows.
  pub row_selected : Int64
  /// Unified Apple system blue accent.
  pub accent : Int64
  /// Soft accent tint fill.
  pub accent_tint : Int64
  /// Semantic positive ink.
  pub positive : Int64
  /// Semantic positive soft fill.
  pub positive_bg : Int64
  /// Semantic warning ink.
  pub warning : Int64
  /// Semantic warning soft fill.
  pub warning_bg : Int64
  /// Semantic danger / destructive ink.
  pub danger : Int64
  /// Semantic danger soft fill.
  pub danger_bg : Int64
  /// Code block body background.
  pub code_bg : Int64
  /// Code block header bar background.
  pub code_header : Int64
}

/// Light appearance Content Layer palette.
pub let surface_light : SurfacePalette = SurfacePalette::{
  canvas: 0xF5F5F7FFL,
  grouped_bg: 0xF2F2F7FFL,
  sidebar: 0xECECEFFFL,
  card: 0xFFFFFFFFL,
  card_secondary: 0xF4F4F7FFL,
  ink: 0x1C1C1EFFL,
  ink_secondary: 0x636366FFL,
  ink_tertiary: 0x8E8E93FFL,
  separator: 0x00000014L,
  separator_strong: 0x0000001FL,
  row_hover: 0x0000000AL,
  row_selected: 0x007AFF1AL,
  accent: 0x007AFFFFL,
  accent_tint: 0x007AFF14L,
  positive: 0x248A3DFFL,
  positive_bg: 0x34C7591AL,
  warning: 0xB25000FFL,
  warning_bg: 0xFF95001AL,
  danger: 0xD70015FFL,
  danger_bg: 0xFF3B301AL,
  code_bg: 0xF6F6F9FFL,
  code_header: 0xEBEBF0FFL,
}

/// Dark appearance Content Layer palette.
pub let surface_dark : SurfacePalette = SurfacePalette::{
  canvas: 0x0B0C0EFFL,
  grouped_bg: 0x000000FFL,
  sidebar: 0x141518FFL,
  card: 0x1C1C1EFFL,
  card_secondary: 0x262629FFL,
  ink: 0xF5F5F7FFL,
  ink_secondary: 0xAEAEB2FFL,
  ink_tertiary: 0x8E8E93FFL,
  separator: 0xFFFFFF1AL,
  separator_strong: 0xFFFFFF26L,
  row_hover: 0xFFFFFF0FL,
  row_selected: 0x0A84FF29L,
  accent: 0x0A84FFFFL,
  accent_tint: 0x0A84FF24L,
  positive: 0x30D158FFL,
  positive_bg: 0x30D15826L,
  warning: 0xFF9F0AFFL,
  warning_bg: 0xFF9F0A26L,
  danger: 0xFF453AFFL,
  danger_bg: 0xFF453A26L,
  code_bg: 0x141519FFL,
  code_header: 0x1D1E24FFL,
}

/// Active Content Layer palette, automatically tracking `lg::is_dark()`.
pub fn surface() -> SurfacePalette {
  if is_dark() {
    surface_dark
  } else {
    surface_light
  }
}

/// Concentric corner ladder (pt).
pub let r_sheet : Double = 34.0
pub let r_panel : Double = 26.0
pub let r_card : Double = 20.0
pub let r_row : Double = 12.0
pub let r_chip : Double = 8.0
pub let hairline_w : Double = 0.5

/// Exact concentric inner corner radius: `max(0.0, outer - inset)`.
pub fn concentric(outer : Double, inset : Double) -> Double {
  if outer > inset {
    outer - inset
  } else {
    0.0
  }
}

/// Clean solid Content Layer card (`surface().card` or `card_secondary` + `0.5pt` `surface().separator`).
/// Zero `Glass::liquid`, zero heavy outer shadow.
pub fn surface_card_node(
  parent : view::View,
  body : (view::View) -> Unit,
  radius~ : Double = r_card,
  pad~ : Double = 16.0,
  gap~ : Double = 0.0,
  secondary~ : Bool = false,
  label~ : () -> String = fn() { "" },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(card : view::View) -> Unit {
    let _ = card
    .padding(view::Live::Is((pad, pad, pad, pad)))
    .gap(view::Live::Is(gap))
    .radius(view::Live::Is(radius))
    .ground(view::Live::By(fn() {
      let s = surface()
      if secondary { s.card_secondary } else { s.card }
    }))
    .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
    .says(view::Live::By(fn() {
      let l = label()
      if l != "" {
        Some(view::said(view::Role::Group, label=l))
      } else {
        None
      }
    }))
    body(card)
  })
}

/// iOS grouped content section: optional header, solid Content Layer card, optional footer.
pub fn surface_section_node(
  parent : view::View,
  body : (view::View) -> Unit,
  header~ : () -> String = fn() { "" },
  footer~ : () -> String = fn() { "" },
  radius~ : Double = r_card,
  pad~ : Double = 0.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(wrap : view::View) -> Unit {
    wrap.show(fn() { header() != "" }, fn(h : view::View) -> Unit {
      let _ = h.padding(view::Live::Is((16.0, 0.0, 16.0, 6.0)))
      let _ = h.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(header), look=words_at(12.0, weight=600))
        .ink(view::Live::By(fn() { surface().ink_secondary }))
      })
    })
    let _ = surface_card_node(
      wrap,
      body,
      radius=radius,
      pad=pad,
      label=header,
      loc=loc,
    )
    wrap.show(fn() { footer() != "" }, fn(f : view::View) -> Unit {
      let _ = f.padding(view::Live::Is((16.0, 6.0, 16.0, 0.0)))
      let _ = f.box(fn(w : view::View) -> Unit {
        let _ = w
        .words(view::Live::By(footer), look=words_at(12.0, wrap=true))
        .ink(view::Live::By(fn() { surface().ink_secondary }))
      })
    })
  })
}

/// Zero-glass Content Layer code block with a header bar (language + flat Copy button with 36pt hit area)
/// and a horizontally scrollable `ui::scroll_row` body so long lines never clip on wide or 320pt narrow viewports.
pub fn surface_code_block_node(
  parent : view::View,
  code : () -> String,
  lang~ : () -> String = fn() { "" },
  on_copy? : () -> Unit,
  max_height? : Double,
  radius~ : Double = r_row,
  loc~ : String = "",
) -> view::View {
  let copied = signals::signal(false)
  parent.box(loc=loc, fn(block : view::View) -> Unit {
    let _ = block
    .min_width(view::Live::Is(Some(0.0)))
    .radius(view::Live::Is(radius))
    .ground(view::Live::By(fn() { surface().code_bg }))
    .edge(view::Live::By(fn() { (hairline_w, surface().separator) }))
    .clips(view::Live::Is(true))
    .says(view::Live::By(fn() {
      let l = lang()
      Some(view::said(view::Role::Group, label=if l != "" { "\{l} code" } else { "Code block" }))
    }))

    // Header bar: language label + flat ghost Copy button (36pt hit target via liquid_button_node)
    let _ = block.box(fn(hdr : view::View) -> Unit {
      let _ = hdr
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Between))
      .height(view::Live::Is(Some(36.0)))
      .rigid()
      .padding(view::Live::Is((12.0, 0.0, 6.0, 0.0)))
      .ground(view::Live::By(fn() { surface().code_header }))
      let _ = hdr.box(fn(lbl : view::View) -> Unit {
        let _ = lbl
        .words(
          view::Live::By(fn() {
            let l = lang()
            if l != "" { l } else { "code" }
          }),
          look=words_at(11.5, weight=600),
        )
        .ink(view::Live::By(fn() { surface().ink_secondary }))
      })
      let copy_r = concentric(radius, 6.0)
      let _ = headless::button(
        hdr,
        fn() { if copied.get() { "Copied" } else { "Copy" } },
        fn(_e) -> Unit {
          copied.set(true)
          match on_copy {
            Some(cb) => cb()
            None => ()
          }
        },
        loc=loc,
        fn(b : view::View, btn : headless::Button) -> Unit {
          let hover_t = motion::hover_fade(b, fn() { btn.hovered() })
          let press_t = motion::hover_fade(b, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
          let _ = b
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .height(view::Live::Is(Some(36.0)))
          .shrink(view::Live::Is(0.0))
          let _ = b.box(fn(pill : view::View) -> Unit {
            let _ = pill
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .height(view::Live::Is(Some(24.0)))
            .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
            .radius(view::Live::Is(copy_r))
            .ground(view::Live::By(fn() {
              let h = hover_t()
              let p = press_t()
              let with_h = if h > 0.001 { alpha(surface().row_hover, h) } else { clear }
              if p > 0.001 { over(with_h, alpha(surface().row_selected, p)) } else { with_h }
            }))
            lg_focus_ring(pill, fn() { btn.focus_shown() }, copy_r)
            let _ = pill.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(
                view::Live::By(fn() { if copied.get() { "Copied" } else { "Copy" } }),
                look=words_at(12.0, weight=500),
              )
              .ink(view::Live::By(fn() { surface().ink_secondary }))
            })
          })
        },
      )
    })

    // 0.5pt hairline divider between header and code viewport
    let _ = block.box(fn(sep : view::View) -> Unit {
      let _ = sep
      .height(view::Live::Is(Some(hairline_w)))
      .rigid()
      .ground(view::Live::By(fn() { surface().separator }))
    })

    // Horizontally scrollable code body (never clips long lines on narrow viewports)
    let mount_code_row = fn(host : view::View) -> Unit {
      let row_sc = ui::scroll_row(
        host,
        fn(inner : view::View) -> Unit {
          let _ = inner.padding(view::Live::Is((12.0, 10.0, 12.0, 12.0)))
          let _ = inner.box(fn(w : view::View) -> Unit {
            let _ = w
            .words(view::Live::By(code), look=words_at(12.5, weight=400, wrap=false))
            .ink(view::Live::By(fn() { surface().ink }))
          })
        },
        fill=false,
        loc=loc,
      )
      let _ = row_sc.min_width(view::Live::Is(Some(0.0)))
    }
    match max_height {
      Some(mh) => {
        let _ = block.box(fn(vwrap : view::View) -> Unit {
          let _ = vwrap.max_height(view::Live::Is(Some(mh))).min_width(view::Live::Is(Some(0.0)))
          let vsc = ui::scroll_box(vwrap, fn(vbody : view::View) -> Unit {
            mount_code_row(vbody)
          }, fill=false, loc=loc)
          let _ = vsc.max_height(view::Live::Is(Some(mh))).min_width(view::Live::Is(Some(0.0)))
        })
      }
      None => mount_code_row(block)
    }
  })
}
