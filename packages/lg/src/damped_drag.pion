// Ported from Kyant0/AndroidLiquidGlass (Apache-2.0): catalog/utils/DampedDragAnimation.kt.

import "halt"
import "motion"
import "ui"
import "view"
import "signals"

fn value_spring(threshold : Double) -> motion::Spec {
  motion::spring(ratio=1.0, stiffness=1000.0, threshold=threshold)
}

fn speed_spring(threshold : Double) -> motion::Spec {
  motion::spring(ratio=0.5, stiffness=300.0, threshold=threshold * 10.0)
}

pub struct DampedDrag {
  lo : Double
  hi : Double
  threshold : Double
  rest_scale : Double
  held_scale : Double
  value_w : motion::NodeWay
  speed_w : motion::NodeWay
  press_w : motion::NodeWay
  scale_x : motion::NodeWay
  scale_y : motion::NodeWay
  node : signals::Ref[Option[view::View]]
  last : signals::Ref[Option[(Double, Double)]]
  letting_go : signals::Ref[Option[() -> Unit]]
  stilling : signals::Ref[Option[() -> Unit]]
}

pub fn DampedDrag::new(
  initial : Double,
  lo~ : Double,
  hi~ : Double,
  threshold~ : Double = 0.001,
  rest_scale~ : Double = 1.0,
  held_scale~ : Double,
) -> DampedDrag {
  let v = clamp(initial, lo, hi)
  DampedDrag::{
    lo,
    hi,
    threshold,
    rest_scale,
    held_scale,
    value_w: motion::NodeWay::new(v),
    speed_w: motion::NodeWay::new(0.0),
    press_w: motion::NodeWay::new(0.0),
    scale_x: motion::NodeWay::new(rest_scale),
    scale_y: motion::NodeWay::new(rest_scale),
    node: ui::ref_new(None),
    last: ui::ref_new(None),
    letting_go: ui::ref_new(None),
    stilling: ui::ref_new(None),
  }
}

pub fn DampedDrag::attach(self : DampedDrag, n : view::View) -> Unit {
  self.node.v = Some(n)
}

fn DampedDrag::at(self : DampedDrag) -> view::View {
  match self.node.v {
    Some(n) => n
    None => halt::saying("liquid-glass: a DampedDrag moved before it was attached to its node", "lg/damped_drag.pion")
  }
}

pub fn DampedDrag::value(self : DampedDrag, n : view::View) -> Double {
  self.value_w.shown(n)
}

pub fn DampedDrag::progress(self : DampedDrag, n : view::View) -> Double {
  let span = self.hi - self.lo
  if span <= 0.0 {
    0.0
  } else {
    (self.value_w.shown(n) - self.lo) / span
  }
}

pub fn DampedDrag::target(self : DampedDrag) -> Double {
  self.value_w.target()
}

pub fn DampedDrag::pressed(self : DampedDrag, n : view::View) -> Double {
  self.press_w.shown(n)
}

pub fn DampedDrag::velocity(self : DampedDrag, n : view::View) -> Double {
  self.speed_w.shown(n)
}

pub fn DampedDrag::jelly(self : DampedDrag, n : view::View, per : Double) -> (Double, Double) {
  let v = self.speed_w.shown(n) / per
  let sx = self.scale_x.shown(n) / (1.0 - clamp(v * 0.75, -0.2, 0.2))
  let sy = self.scale_y.shown(n) * (1.0 - clamp(v * 0.25, -0.2, 0.2))
  (sx, sy)
}

pub fn DampedDrag::press(self : DampedDrag) -> Unit {
  let n = self.at()
  self.last.v = None
  self.cancel_release()
  self.press_w.go(n, 1.0, motion::backdrop_press_spring)
  self.scale_x.go(n, self.held_scale, motion::backdrop_scale_x_spring)
  self.scale_y.go(n, self.held_scale, motion::backdrop_scale_y_spring)
}

fn DampedDrag::cancel_release(self : DampedDrag) -> Unit {
  match self.letting_go.v {
    Some(f) => {
      self.letting_go.v = None
      f()
    }
    None => ()
  }
}

pub fn DampedDrag::release(self : DampedDrag) -> Unit {
  let n = self.at()
  self.cancel_release()
  let now = n.cause_at()
  let within = (self.hi - self.lo) * 0.025
  let aim = self.value_w.target()
  let near = fn(t : Double) -> Bool { (self.value_w.value_at(t) - aim).abs() < within }
  let down = fn() -> Unit {
    self.press_w.go(n, 0.0, motion::backdrop_press_spring)
    self.scale_x.go(n, self.rest_scale, motion::backdrop_scale_x_spring)
    self.scale_y.go(n, self.rest_scale, motion::backdrop_scale_y_spring)
  }
  if near(now) || !self.value_w.goes_at(now) {
    down()
    return
  }
  let end = self.value_w.end()
  let mut t = now
  while t < end && !near(t) {
    t = t + 1.0
  }
  let stop = n.at_moment(t, fn() -> Unit {
    self.letting_go.v = None
    down()
  })
  self.letting_go.v = Some(stop)
}

pub fn DampedDrag::update_value(self : DampedDrag, v : Double) -> Unit {
  let n = self.at()
  let to = clamp(v, self.lo, self.hi)
  let now = n.cause_at()
  let span = self.hi - self.lo
  match self.last.v {
    Some((was, at)) => {
      if now > at && span > 0.0 {
        let fast = (to - was) / ((now - at) / 1000.0) / span
        self.speed_w.go(n, fast, speed_spring(self.threshold))
      }
    }
    None => ()
  }
  self.last.v = Some((to, now))
  self.value_w.go(n, to, value_spring(self.threshold))
  self.still_at_rest(n)
}

fn DampedDrag::still_at_rest(self : DampedDrag, n : view::View) -> Unit {
  match self.stilling.v {
    Some(f) => f()
    None => ()
  }
  let end = self.value_w.end()
  self.stilling.v = Some(
    n.at_moment(end, fn() -> Unit {
      self.stilling.v = None
      self.last.v = None
      self.speed_w.go(n, 0.0, speed_spring(self.threshold))
    }),
  )
}

pub fn DampedDrag::animate_to(self : DampedDrag, v : Double) -> Unit {
  let n = self.at()
  self.press()
  let to = clamp(v, self.lo, self.hi)
  self.value_w.go(n, to, value_spring(self.threshold))
  self.speed_w.go(n, 0.0, speed_spring(self.threshold))
  self.release()
}

pub fn DampedDrag::slide_to(self : DampedDrag, v : Double) -> Unit {
  let n = self.at()
  let to = clamp(v, self.lo, self.hi)
  self.value_w.go(n, to, value_spring(self.threshold))
  self.speed_w.go(n, 0.0, speed_spring(self.threshold))
}
