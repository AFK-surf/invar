// Liquid Glass Detached Floating Sheet and ActionSheet components over headless::dialog.

import "headless"
import "headless_core"
import "motion"
import "signals"
import "ui"
import "view"

/// Decorates an existing bottom-sheet glass layer node `g` in place (zero wrapper nodes) with single-layer
/// `liquid_sheet_glass`, `active` gating (returns `None` glass, zero edge, and zero shadow when inactive),
/// dynamic `solid` fallback, `shadow_outside(Is(true))`, solid-mode hairline fallback, and optional `radius`.
pub fn liquid_sheet_surface_decorate(
  g : view::View,
  radius? : Double,
  active~ : () -> Bool = fn() { true },
  solid? : () -> Int64,
  shadow~ : () -> (Double, Double, Int64) = glass_overlay_shadow,
  solid_edge~ : () -> (Double, Int64) = liquid_overlay_solid_edge,
) -> view::View {
  match radius {
    Some(r) => {
      let _ = g.radius(view::Live::Is(r))
    }
    None => ()
  }
  let _ = g
  .glass(
    view::Live::By(fn() {
      if !active() {
        return None
      }
      let s = match solid {
        Some(f) => f()
        None => clear
      }
      Some(liquid_sheet_glass(solid=s))
    }),
  )
  .edge(
    view::Live::By(fn() {
      if active() && (g.glass_solid() || ui::glass_solid()) {
        solid_edge()
      } else {
        (0.0, clear)
      }
    }),
  )
  .shadow(
    view::Live::By(fn() {
      if active() {
        shadow()
      } else {
        shadow_none
      }
    }),
  )
  .shadow_outside(view::Live::Is(true))
  g
}

/// A Liquid Glass detached floating sheet in `parent`, open while `open()` holds.
/// Features a `28pt` concentric liquid glass card, interactive vertical drag-to-dismiss with
/// upward rubber-band over-pull, optional two-detent (`detents=true`) morphing between floating
/// half-height glass (`10pt`/`12pt` inset, `r=28pt`) and docked full-height reading surface on
/// narrow viewports (`0pt` inset, top `r=24pt`, bottom `r=0pt`), vector `×` close button,
/// body/footer slots, and `headless::dialog` modal focus trapping + Escape / scrim dismissal.
pub fn liquid_sheet_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title : () -> String,
  body : (view::View) -> Unit,
  subtitle~ : () -> String = fn() { "" },
  footer? : (view::View) -> Unit,
  width~ : Double = 520.0,
  max_height~ : Double = 560.0,
  detents~ : Bool = false,
  expanded~ : () -> Bool = fn() { false },
  on_expanded~ : (Bool) -> Unit = fn(_v : Bool) -> Unit { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    let shown_open = ovl_transitioned_bool(h, open)
    h.show(shown_open, leave=motion::dialog_out_ms, fn(s : view::View) -> Unit {
      let (look, _) = motion::overlay_presence(s, enter=motion::dialog_in, exit=motion::dialog_out)
      let init_exp = if detents { signals::untracked(expanded) } else { false }
      let exp_state = signals::signal(init_exp)
      let detent_way = motion::NodeWay::new(if init_exp { 1.0 } else { 0.0 })
      let drag_y = motion::NodeWay::new(0.0)
      if detents {
        s.reacts(
          expanded,
          fn(on : Bool) -> Unit {
            exp_state.set(on)
            detent_way.go(s, if on { 1.0 } else { 0.0 }, motion::move_damped)
          },
          at_start=false,
        )
      }
      let detent_val = fn(n : view::View) -> Double {
        if detents {
          clamp(detent_way.shown(n), 0.0, 1.0)
        } else {
          0.0
        }
      }
      // Narrow / phone viewports dock flush on left, right and bottom at detent=1.0;
      // wide desktop viewports remain a floating rounded island so we never get flat-bottom floating cards.
      let docks_edges = fn() -> Bool {
        let ww = s.window_w()
        ww <= 0.0 || ww <= width + 2.0 * ovl_sheet_inset + 4.0
      }
      let dock_t = fn(n : view::View) -> Double {
        if docks_edges() {
          detent_val(n)
        } else {
          0.0
        }
      }
      let heights = fn() -> (Double, Double) {
        let wh = s.window_h()
        let half_h = if wh > 0.0 {
          clamp(wh * 0.52, 260.0, max_height)
        } else {
          max_height * 0.72
        }
        let full_h = if wh > 120.0 {
          if docks_edges() { wh - 32.0 } else { wh - 48.0 }
        } else {
          max_height
        }
        let full_clamped = if full_h > half_h + 60.0 { full_h } else { half_h + 60.0 }
        (half_h, full_clamped)
      }
      let card_id_ref : signals::Ref[Option[view::NodeId]] = ui::ref_new(None)
      let floor_tok = ui::push_over_scrim_floor(fn(_w : Double, _h : Double) -> Option[(Double, Double)] {
        match (ui::view_tree(), card_id_ref.v) {
          (Some(tr), Some(cid)) => match tr.drawn_of(cid) {
            Some(d) if d.h > 0.0 => Some((d.y, d.h))
            _ => None
          }
          _ => None
        }
      })
      let _ = s.owns(fn() { ui::remove_over_scrim_floor(floor_tok) })
      let _ = s
      .over(view::Live::Is(true))
      .points(view::Live::By(open))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::End))
      let _ = s.box(fn(scrim : view::View) -> Unit {
        let _ = scrim
        .over(view::Live::Is(true))
        .scrim_under()
        .ground(view::Live::By(fn() { colors().scrim }))
        .alpha(view::Live::By(fn() {
          let drag_fade = 1.0 - clamp(drag_y.shown(scrim) / 260.0, 0.0, 1.0)
          clamp(look().alpha * drag_fade, 0.0, 1.0)
        }))
      })
      let _ = s.box(fn(room : view::View) -> Unit {
        let cur_inset = fn() -> Double {
          if docks_edges() {
            lerp(ovl_sheet_inset, 0.0, detent_val(room))
          } else {
            ovl_sheet_wide_inset
          }
        }
        let _ = room
        .width(view::Live::By(fn() {
          let ww = s.window_w()
          if docks_edges() && ww > 0.0 {
            Some(ww)
          } else {
            Some(width + 2.0 * cur_inset())
          }
        }))
        .max_width(view::Live::By(fn() {
          let ww = s.window_w()
          if docks_edges() && ww > 0.0 {
            Some(ww)
          } else {
            Some(width + 2.0 * ovl_sheet_wide_inset)
          }
        }), within=true)
        .padding(view::Live::By(fn() {
          let ins = cur_inset()
          (ins, ins, ins, ins)
        }))
        let released_by_up = ui::ref_new(false)
        let sheet_snaps : Array[Double] = if detents { [0.52, 1.0] } else { [1.0] }
        let _ = headless::drawer(
          room,
          title,
          open,
          on_close,
          edge=headless::DrawerEdge::Bottom,
          snap_points=sheet_snaps,
          active_snap=fn() -> Int { if detents && exp_state.get() { 1 } else { 0 } },
          on_snap=fn(idx : Int) -> Unit {
            if detents {
              let next = idx >= 1
              exp_state.set(next)
              on_expanded(next)
              detent_way.go(s, if next { 1.0 } else { 0.0 }, motion::move_damped)
            }
          },
          on_release=fn(_off : Double, vel : Double, will_close : Bool) -> Unit {
            released_by_up.v = true
            if will_close {
              drag_y.go(s, 320.0, motion::move_damped, velocity=vel)
            } else {
              drag_y.go(s, 0.0, motion::move_damped, velocity=vel)
            }
          },
          dismiss_threshold=if detents { 1.0 - 0.40 / 0.52 } else { 0.25 },
          velocity_threshold=ovl_sheet_drag_vel,
          overpull_max=ovl_sheet_overpull_max,
          description=subtitle,
          loc=loc,
          fn(card : view::View, dr : headless::Drawer) -> Unit {
            card_id_ref.v = Some(card.id())
            card.reacts(
              at_start=false,
              fn() { (dr.dragging(), dr.drag_offset()) },
              fn(st : (Bool, Double)) -> Unit {
                if st.0 {
                  let raw_off = st.1
                  if !detents {
                    drag_y.put(raw_off)
                  } else {
                    let (half_h, full_h) = heights()
                    let span = full_h - half_h
                    if exp_state.untracked() {
                      if raw_off <= 0.0 {
                        detent_way.put(1.0)
                        drag_y.put(raw_off)
                      } else if raw_off <= span {
                        detent_way.put(1.0 - raw_off / span)
                        drag_y.put(0.0)
                      } else {
                        detent_way.put(0.0)
                        drag_y.put(raw_off - span)
                      }
                    } else if raw_off >= 0.0 {
                      detent_way.put(0.0)
                      drag_y.put(raw_off)
                    } else if -raw_off <= span {
                      detent_way.put(-raw_off / span)
                      drag_y.put(0.0)
                    } else {
                      detent_way.put(1.0)
                      drag_y.put(-headless_core::drawer_rubber_pull(-raw_off - span, ovl_sheet_overpull_max))
                    }
                  }
                } else if released_by_up.v {
                  released_by_up.v = false
                } else if signals::untracked(open) {
                  drag_y.go(card, 0.0, motion::move_damped)
                  if detents {
                    detent_way.go(card, if exp_state.untracked() { 1.0 } else { 0.0 }, motion::move_damped)
                  }
                }
              },
            )
            let toggle_detent = fn() -> Unit {
              if detents {
                let next = !exp_state.untracked()
                exp_state.set(next)
                on_expanded(next)
                detent_way.go(card, if next { 1.0 } else { 0.0 }, motion::move_damped)
              }
            }
            if detents {
              let _ = card.height(view::Live::By(fn() {
                let (half_h, full_h) = heights()
                Some(lerp(half_h, full_h, detent_val(card)))
              }))
            } else {
              let _ = card.max_height(view::Live::Is(Some(max_height)))
            }
            let _ = card
            .radius(view::Live::By(fn() { lerp(ovl_sheet_radius, ovl_sheet_expanded_top_radius, dock_t(card)) }))
            .corners(view::Live::By(fn() {
              let dt = dock_t(card)
              let top_r = lerp(ovl_sheet_radius, ovl_sheet_expanded_top_radius, dt)
              let bot_r = lerp(ovl_sheet_radius, 0.0, dt)
              Some((top_r, top_r, bot_r, bot_r))
            }))
            .edge(view::Live::By(fn() { if card.glass_solid() { lg_solid_edge() } else { (0.0, clear) } }))
            .alpha(view::Live::By(fn() { look().alpha }))
            .offset(view::Live::By(fn() { (0.0, look().dy + drag_y.shown(card)) }))
            .lends(surface_context_lent, SurfaceContext::Content)
            lg_apply_glass_surface(card, fn() { lg_sheet_glass_at(detent_val(card)) }, shadow_by=glass_overlay_shadow)
            // Interactive grabber + header drag handle delegated to `headless::drawer`
            let _ = card.box(
              loc=loc,
              fn(handle : view::View) -> Unit {
                dr.handle(
                  handle,
                  extent_by=fn() -> Double {
                    if detents {
                      let wh = s.window_h()
                      let full = if wh > 0.0 { wh } else { max_height }
                      if exp_state.untracked() { full } else { full * 0.52 }
                    } else {
                      320.0
                    }
                  },
                  slop=ui::touch_slop(),
                )
                // Header row: title + optional subtitle + X/Y symmetric concentric close button
                // (floating r=28pt -> 12pt top & 12pt right; docked r=24pt -> 8pt top & 8pt right; 16pt + pad == top_r).
                let _ = handle.box(fn(hdr : view::View) -> Unit {
                  let _ = hdr
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Start)))
                  .lies_along(view::Live::Is(view::Lies::Between))
                  .gap(view::Live::Is(ovl_sheet_gap))
                  .padding(view::Live::By(fn() {
                    let corner_pad = lerp(ovl_sheet_hdr_pr, ovl_sheet_hdr_pr_expanded, dock_t(hdr))
                    (ovl_sheet_pad, corner_pad, corner_pad, ovl_sheet_gap - 4.0)
                  }))
                  let _ = hdr.box(fn(titles : view::View) -> Unit {
                    // Top clearance keeps the title comfortably below the overlaid top-center grabber capsule.
                    let _ = titles.grow(view::Live::Is(1.0)).gap(view::Live::Is(ovl_text_gap)).padding(view::Live::Is((0.0, 12.0, 0.0, 0.0)))
                    let _ = titles.box(fn(w : view::View) -> Unit {
                      let _ = w
                      .words(view::Live::By(title), look=words_at(ovl_type_title, weight=ovl_weight_semibold, wrap=true))
                      .ink(view::Live::By(fn() { colors().content }))
                    })
                    titles.show(fn() { subtitle() != "" }, fn(sub : view::View) -> Unit {
                      let _ = sub
                      .words(view::Live::By(subtitle), look=words_at(ovl_type_sub, wrap=true))
                      .ink(view::Live::By(ovl_muted_ink))
                    })
                  })
                  let _ = headless::button(hdr, fn() { "Close" }, fn(_e) -> Unit { dr.close() }, loc=loc, fn(btn_v : view::View, btn : headless::Button) -> Unit {
                    let _ = btn_v
                    .width(view::Live::Is(Some(36.0)))
                    .height(view::Live::Is(Some(36.0)))
                    .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
                    .shrink(view::Live::Is(0.0))
                    .radius(view::Live::Is(18.0))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    let hover_t = motion::hover_fade(btn_v, fn() { btn.hovered() })
                    let press_t = motion::hover_fade(btn_v, fn() { btn.pressed() }, duration_ms=motion::pointer_tap_ms)
                    let _ = btn_v.box(fn(pill : view::View) -> Unit {
                      let _ = pill
                      .width(view::Live::Is(Some(ovl_close_btn_size)))
                      .height(view::Live::Is(Some(ovl_close_btn_size)))
                      .radius(view::Live::Is(ovl_close_btn_size / 2.0))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .ground(view::Live::By(fn() {
                        let base = ovl_close_ground()
                        let h_v = hover_t()
                        let p_v = press_t()
                        let with_h = if h_v > 0.001 { over(base, alpha(ovl_row_hover(), h_v)) } else { base }
                        if p_v > 0.001 { over(with_h, alpha(ovl_row_press(), p_v)) } else { with_h }
                      }))
                      lg_focus_ring(pill, fn() { btn.focus_shown() }, ovl_close_btn_size / 2.0)
                      let _ = pill.box(fn(ic : view::View) -> Unit {
                        let _ = ic
                        .width(view::Live::Is(Some(ovl_close_icon_size)))
                        .height(view::Live::Is(Some(ovl_close_icon_size)))
                        .shapes(view::Live::By(fn() { ovl_close_shapes(ovl_close_icon_size, colors().content) }))
                      })
                    })
                  })
                })
                // Top-center drag-indicator capsule overlaid at top edge so it never pushes the close button downward.
                let _ = handle.box(fn(grab_wrap : view::View) -> Unit {
                  let _ = grab_wrap
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .lies_along(view::Live::Is(view::Lies::Start))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  if detents {
                    let _ = headless::button(
                      grab_wrap,
                      fn() { if exp_state.get() { "Collapse Sheet" } else { "Expand Sheet" } },
                      fn(_e) -> Unit { toggle_detent() },
                      loc=loc,
                      fn(gb : view::View, btn : headless::Button) -> Unit {
                        let _ = gb
                        .width(view::Live::Is(Some(64.0)))
                        .height(view::Live::Is(Some(24.0)))
                        .radius(view::Live::Is(12.0))
                        .lines_up(view::Live::Is(Some(view::Along::Middle)))
                        .lies_along(view::Live::Is(view::Lies::Middle))
                        lg_focus_ring(gb, fn() { btn.focus_shown() }, 12.0)
                        let _ = gb.box(fn(grab : view::View) -> Unit {
                          let _ = grab
                          .width(view::Live::Is(Some(ovl_sheet_grabber_w)))
                          .height(view::Live::Is(Some(ovl_sheet_grabber_h)))
                          .radius(view::Live::Is(ovl_sheet_grabber_h / 2.0))
                          .ground(view::Live::By(ovl_grabber_color))
                        })
                      },
                    )
                  } else {
                    let _ = grab_wrap.box(fn(grab_slot : view::View) -> Unit {
                      let _ = grab_slot.padding(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
                      let _ = grab_slot.box(fn(grab : view::View) -> Unit {
                        let _ = grab
                        .width(view::Live::Is(Some(ovl_sheet_grabber_w)))
                        .height(view::Live::Is(Some(ovl_sheet_grabber_h)))
                        .radius(view::Live::Is(ovl_sheet_grabber_h / 2.0))
                        .ground(view::Live::By(ovl_grabber_color))
                      })
                    })
                  }
                })
              },
            )
            // Body slot (grows and clips cleanly when `detents=true` expands/contracts)
            let _ = card.box(fn(b : view::View) -> Unit {
              if detents {
                let _ = b.grow(view::Live::Is(1.0)).min_height(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
              }
              let _ = b
              .padding(view::Live::Is((ovl_sheet_pad, 0.0, ovl_sheet_pad, ovl_sheet_pad)))
              .margin(view::Live::Is((0.0, 4.0, 0.0, 0.0)))
              body(b)
            })
            match footer {
              Some(draw_footer) => {
                let _ = card.box(fn(f : view::View) -> Unit {
                  let _ = f.box(fn(sep : view::View) -> Unit {
                    let _ = sep.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
                  })
                  let _ = f.box(fn(inner : view::View) -> Unit {
                    let _ = inner.padding(view::Live::Is((ovl_sheet_footer_pad, ovl_sheet_footer_pad, ovl_sheet_footer_pad, ovl_sheet_footer_pad)))
                    draw_footer(inner)
                  })
                })
              }
              None => ()
            }
          },
        )
      })
    })
  })
}

pub struct LiquidActionSheetItem {
  pub label : String
  pub destructive : Bool
  pub disabled : Bool
  pub on_select : () -> Unit
}

pub fn LiquidActionSheetItem::new(
  label~ : String,
  on_select~ : () -> Unit,
  destructive~ : Bool = false,
  disabled~ : Bool = false,
) -> LiquidActionSheetItem {
  LiquidActionSheetItem::{ label, destructive, disabled, on_select }
}

#derive(Eq)
struct ActionSheetKey {
  key : String
  idx : Int
  label : String
  destructive : Bool
  disabled : Bool
}

pub fn liquid_action_sheet_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  items : () -> Array[LiquidActionSheetItem],
  title~ : () -> String = fn() { "" },
  message~ : () -> String = fn() { "" },
  cancel_label~ : () -> String = fn() { "Cancel" },
  width~ : Double = 380.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(h : view::View) -> Unit {
    let _ = h.over(view::Live::Is(true))
    let shown_open = ovl_transitioned_bool(h, open)
    h.show(shown_open, leave=motion::dialog_out_ms, fn(s : view::View) -> Unit {
      let (look, _) = motion::overlay_presence(s, enter=motion::dialog_in, exit=motion::dialog_out)
      let stack_id_ref : signals::Ref[Option[view::NodeId]] = ui::ref_new(None)
      let floor_tok = ui::push_over_scrim_floor(fn(_w : Double, _h : Double) -> Option[(Double, Double)] {
        match (ui::view_tree(), stack_id_ref.v) {
          (Some(tr), Some(sid)) => match tr.drawn_of(sid) {
            Some(d) if d.h > 0.0 => Some((d.y, d.h))
            _ => None
          }
          _ => None
        }
      })
      let _ = s.owns(fn() { ui::remove_over_scrim_floor(floor_tok) })
      let _ = s.over(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::End))
      let _ = s.box(fn(scrim : view::View) -> Unit {
        let _ = scrim
        .over(view::Live::Is(true))
        .scrim_under()
        .ground(view::Live::By(fn() { colors().scrim }))
        .alpha(view::Live::By(fn() { look().alpha }))
      })
      let _ = s.box(fn(room : view::View) -> Unit {
        let _ = room
        .width(view::Live::Is(Some(width + 2.0 * ovl_sheet_inset)))
        .max_width(view::Live::Is(Some(width + 2.0 * ovl_sheet_inset)), within=true)
        .padding(view::Live::Is((ovl_sheet_inset, ovl_sheet_inset, ovl_sheet_inset, ovl_sheet_inset)))
        let _ = headless::dialog(
          room,
          fn() {
            let t = title()
            if t != "" { t } else { "Actions" }
          },
          open,
          on_close,
          description=message,
          loc=loc,
          fn(stack : view::View, dlg : headless::Dialog) -> Unit {
            stack_id_ref.v = Some(stack.id())
            let _ = stack
            .gap(view::Live::Is(ovl_action_gap))
            .alpha(view::Live::By(fn() { look().alpha }))
            .offset(view::Live::By(fn() { (0.0, look().dy) }))
            let _ = stack.box(fn(card : view::View) -> Unit {
              let _ = card
              .padding(view::Live::Is((ovl_action_pad, ovl_action_pad, ovl_action_pad, ovl_action_pad)))
              .radius(view::Live::Is(ovl_action_radius))
              .lends(surface_context_lent, SurfaceContext::Content)
              lg_apply_glass_surface(card, fn() { lg_sheet_glass() }, shadow_by=glass_overlay_shadow)
              let has_header = title() != "" || message() != ""
              if has_header {
                let _ = card.box(fn(hdr : view::View) -> Unit {
                  let _ = hdr
                  .padding(view::Live::Is((ovl_action_hdr_px, ovl_action_hdr_py, ovl_action_hdr_px, ovl_action_hdr_py)))
                  .gap(view::Live::Is(ovl_text_gap))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  if title() != "" {
                    let _ = hdr.box(fn(w : view::View) -> Unit {
                      let _ = w
                      .words(view::Live::By(title), look=words_at(ovl_type_sub, weight=ovl_weight_semibold, wrap=true))
                      .words_centered(view::Live::Is(true))
                      .ink(view::Live::By(ovl_muted_ink))
                    })
                  }
                  if message() != "" {
                    let _ = hdr.box(fn(w : view::View) -> Unit {
                      let _ = w
                      .words(view::Live::By(message), look=words_at(ovl_type_meta, wrap=true))
                      .words_centered(view::Live::Is(true))
                      .ink(view::Live::By(ovl_muted_ink))
                    })
                  }
                })
              }
              card.each(
                fn() -> Array[ActionSheetKey] {
                  let arr = items()
                  let out : Array[ActionSheetKey] = []
                  let mut i = 0
                  while i < arr.length() {
                    let it = arr[i]
                    let k = "\{i}:\{it.label}:\{it.destructive}:\{it.disabled}"
                    out.push(ActionSheetKey::{ key: k, idx: i, label: it.label, destructive: it.destructive, disabled: it.disabled })
                    i += 1
                  }
                  out
                },
                fn(k : ActionSheetKey) -> String { k.key },
                fn(slot : view::View, k : signals::Signal[ActionSheetKey]) -> Unit {
                  let info = k.untracked()
                  let idx = info.idx
                  let lbl = info.label
                  let destructive = info.destructive
                  let disabled = info.disabled
                  if idx > 0 || has_header {
                    let _ = slot.box(fn(sep : view::View) -> Unit {
                      let _ = sep.padding(view::Live::Is((ovl_list_sep_inset, 0.0, ovl_list_sep_inset, 0.0)))
                      let _ = sep.box(fn(line : view::View) -> Unit {
                        let _ = line.height(view::Live::Is(Some(ovl_hairline_h))).ground(view::Live::By(ovl_hairline))
                      })
                    })
                  }
                  let _ = headless::button(
                    slot,
                    fn() { lbl },
                    fn(_e) -> Unit {
                      if !disabled {
                        let arr = signals::untracked(items)
                        if idx >= 0 && idx < arr.length() {
                          let it = arr[idx]
                          if !it.disabled {
                            (it.on_select)()
                            dlg.close()
                          }
                        }
                      }
                    },
                    disabled=fn() { disabled },
                    loc=loc,
                    fn(b : view::View, btn : headless::Button) -> Unit {
                      let _ = b
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .min_height(view::Live::Is(Some(ovl_action_item_h)))
                      .padding(view::Live::Is((ovl_action_hdr_px, 0.0, ovl_action_hdr_px, 0.0)))
                      .radius(view::Live::Is(ovl_action_item_radius))
                      .alpha(view::Live::By(fn() { if btn.disabled() { ovl_disabled_alpha } else { 1.0 } }))
                      ovl_attach_row_ground(
                        b,
                        fn() { btn.hovered() },
                        fn() { btn.pressed() },
                        disabled=fn() { btn.disabled() },
                      )
                      lg_focus_ring(b, fn() { btn.focus_shown() }, ovl_action_item_radius)
                      let _ = b.box(fn(w : view::View) -> Unit {
                        let _ = w
                        .words(view::Live::Is(lbl), look=words_at(ovl_type_heading, weight=weight_medium))
                        .ink(view::Live::By(fn() { if destructive { ovl_destructive() } else { colors().content } }))
                      })
                    },
                  )
                },
              )
            })
            let _ = headless::button(
              stack,
              cancel_label,
              fn(_e) -> Unit { dlg.close() },
              loc=loc,
              fn(cancel_v : view::View, btn : headless::Button) -> Unit {
                let _ = cancel_v
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .height(view::Live::Is(Some(ovl_action_item_h)))
                .padding(view::Live::Is((ovl_action_hdr_px, 0.0, ovl_action_hdr_px, 0.0)))
                .radius(view::Live::Is(ovl_action_radius))
                lg_apply_glass_surface(cancel_v, fn() { lg_sheet_glass() }, shadow_by=glass_overlay_shadow)
                lg_focus_ring(cancel_v, fn() { btn.focus_shown() }, ovl_action_radius)
                let _ = cancel_v.box(fn(w : view::View) -> Unit {
                  let _ = w
                  .words(view::Live::By(cancel_label), look=words_at(ovl_type_heading, weight=ovl_weight_semibold))
                  .ink(view::Live::By(fn() { colors().content }))
                })
              },
            )
          },
        )
      })
    })
  })
}
