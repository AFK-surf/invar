// Aggregate workspace verification for Invar Layer 0 (halt, dmath, codec, zip, signals, text).
import "halt"
import "dmath"
import "codec"
import "zip"
import "signals"
import "text"

pub fn layer0_smoke() -> Bool {
  let msg = halt::said("ok", "layer0")
  let s = dmath::sin(2.0)
  let b64 = codec::base64("pion".to_bytes())
  let h = zip::sha256("abc".to_bytes())
  let sig = signals::signal(7)
  let r = text::bold("hello")
  msg.starts_with("ok") &&
    s.to_bits() == (0.9092974268256817).to_bits() &&
    b64 == "cGlvbg==" &&
    h.starts_with("ba7816bf") &&
    sig.get() == 7 &&
    r.weight == 700
}
