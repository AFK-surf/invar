// Platform reference text drawing for differential text testing (apple_text.m).
// Ported 1:1 from libs/mbui/src/host/textref_native.mbt.

extern "C" fn c_ref_begin(w : Double, h : Double, scale : Double, bg : Int) -> Unit = "mb_host_ref_begin"
extern "C" fn c_ref_text(
  text : Ptr,
  text_len : Int64,
  size : Double,
  weight : Int,
  style : Int,
  x : Double,
  base : Double,
  color : Int,
  out : Ptr,
) -> Unit = "pion_host_ref_text"
extern "C" fn c_ref_end(name : Ptr, name_len : Int64) -> Int = "pion_host_ref_end"
extern "C" fn c_ref_frame(name : Ptr, name_len : Int64) -> Int = "pion_host_ref_frame"

fn ref_begin(w : Double, h : Double, scale : Double, bg : Int) -> Unit {
  c_ref_begin(w, h, scale, bg)
}

fn ref_text(
  text : String,
  size : Double,
  weight : Int,
  style : Int,
  x : Double,
  base : Double,
  color : Int,
  out : Array[Double],
) -> Unit {
  c_ref_text(
    str_data_ptr(text),
    text.length().to_int64(),
    size,
    weight,
    style,
    x,
    base,
    color,
    array_data_ptr(out),
  )
}

fn ref_end(name : String) -> Bool {
  c_ref_end(str_data_ptr(name), name.length().to_int64()) != 0
}

fn ref_frame(name : String) -> Bool {
  c_ref_frame(str_data_ptr(name), name.length().to_int64()) != 0
}
