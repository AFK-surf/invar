  h.window_snap_state = window_snap_state
  h.window_opens = window_opens
  h.window_open = window_open
  h.window_front = window_front
  h.windows_in_process = fn() -> Bool { windows(0, 0, "") != 0 }
  h.window_open_id = fn(what : String) -> Int { windows(1, 0, what) }
  h.window_front_id = fn(wid : Int) -> Bool { windows(2, wid, "") != 0 }
  h.window_close_id = fn(wid : Int) -> Unit { let _ = windows(3, wid, "") }
  h.window_current = fn() -> Int { windows(4, 0, "") }
  h.window_set_title = fn(wid : Int, title : String) -> Unit { let _ = windows(5, wid, title) }
  h.set_cursor = set_cursor
  h.set_badge = set_badge
  h.menu_setup = menu_setup
  h.app_said = app_said
  h.app_tell = app_tell
  h.set_site_name = set_site_name
