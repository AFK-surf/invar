/// Installs the native host into `hostapi` as the active global host, and wires the
/// lock-free cross-OS-thread native wake callback (`mb_host_wake_now`).
pub fn install() -> Unit {
  hostapi::set_host(native_host())
  hostapi::set_native_wake(wake_now_ptr())
}

/// Initializes the offscreen Apple Metal render surface (`w` x `h` points at `scale` px/pt)
/// and sets the CoreText glyph scale.
pub fn init_offscreen(w : Double, h : Double, scale : Double) -> Bool {
  c_init_offscreen(w, h, scale) != 0
}

/// Saves the last presented frame as a PNG file at `path`.
pub fn snapshot(path : String) -> Bool {
  c_snapshot(str_data_ptr(path), path.length().to_int64()) != 0
}

/// Pumps the macOS main CFRunLoop once for up to `ms` milliseconds so async host callbacks
/// (such as ImageIO image decodes) complete in headless/offscreen runs.
pub fn pump_main_loop(ms : Double) -> Unit {
  c_pump_main_loop(ms)
}
