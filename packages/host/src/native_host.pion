// Native platform host wired into `hostapi::Host`.
// Ported 1:1 from libs/mbui/src/host/native_host.mbt.

import "hostapi"

struct OnceInt {
  mut cached : Option[Int]
}

fn once_int() -> OnceInt {
  OnceInt::{ cached: None }
}

fn said_once(kept : OnceInt, ask : () -> Int) -> Int {
  match kept.cached {
    Some(v) => v
    None => {
      let v = ask()
      kept.cached = Some(v)
      v
    }
  }
}

let platform_said : OnceInt = once_int()
let keys_said : OnceInt = once_int()
let native_pointing_said : OnceInt = once_int()
let copy_shown_said : OnceInt = once_int()
let h264_said : OnceInt = once_int()
let h265_said : OnceInt = once_int()
let av1_said : OnceInt = once_int()
let feeds_said : OnceInt = once_int()
let layers_said : OnceInt = once_int()

/// Builds a `hostapi::Host` backed by the native Apple Metal / CoreText / ImageIO / AppKit / Film engine.
pub fn native_host() -> hostapi::Host {
  let h = hostapi::Host::noop()
  h.set_window_zoom = set_window_zoom
  h.set_window_key = set_window_key
  h.set_window_close = set_window_close
  h.wheel_kept = wheel_kept
  h.window_setup = window_setup
  h.window_hold = window_hold
  h.window_show = window_show
  h.window_center = window_center
  h.window_hide = window_hide
