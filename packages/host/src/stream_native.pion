// Streams (stream.pion) on a native host (apple_stream.m).
// Ported 1:1 from libs/mbui/src/host/stream_native.mbt.

extern "C" fn c_st_open() -> Int = "mb_host_stream_open"
extern "C" fn c_st_h264(id : Int, avcc : Ptr, avcc_len : Int64, w : Int, h : Int) -> Unit = "pion_host_stream_h264"
extern "C" fn c_st_frame(id : Int, data : Ptr, data_len : Int64, key : Int, ts : Double) -> Unit = "pion_host_stream_frame"
extern "C" fn c_st_jpeg(id : Int, data : Ptr, data_len : Int64, ts : Double) -> Unit = "pion_host_stream_jpeg"
extern "C" fn c_st_next(id : Int) -> Ptr = "pion_host_stream_next"
extern "C" fn c_st_show(id : Int, ts : Double) -> Unit = "mb_host_stream_show"
extern "C" fn c_st_close(id : Int) -> Unit = "mb_host_stream_close"
extern "C" fn c_st_h264_here() -> Int = "mb_host_h264_here"
extern "C" fn c_st_feeds() -> Int = "mb_host_stream_feeds"
extern "C" fn c_st_codec(id : Int, cmd : Ptr, cmd_len : Int64, data : Ptr, data_len : Int64) -> Unit = "pion_host_stream_codec"
extern "C" fn c_st_audio_here() -> Int = "mb_host_stream_audio_here"
extern "C" fn c_st_h265_here() -> Int = "mb_host_h265_here"
extern "C" fn c_st_hevc(id : Int, hvcc : Ptr, hvcc_len : Int64, w : Int, h : Int) -> Unit = "pion_host_stream_hevc"
extern "C" fn c_st_av1_here() -> Int = "mb_host_av1_here"
extern "C" fn c_st_av1(id : Int, av1c : Ptr, av1c_len : Int64, w : Int, h : Int) -> Unit = "pion_host_stream_av1"
extern "C" fn c_st_audio(id : Int, data : Ptr, data_len : Int64) -> Unit = "pion_host_stream_audio"
extern "C" fn c_st_layers() -> Int = "mb_host_stream_layers"
extern "C" fn c_st_pointer(id : Int, png : Ptr, png_len : Int64, w : Double, h : Double, hx : Double, hy : Double) -> Unit = "pion_host_stream_pointer"
extern "C" fn c_st_pointer_at(id : Int, x : Double, y : Double, shown : Int) -> Unit = "mb_host_stream_pointer_at"
extern "C" fn c_st_direct(id : Int, route : Double, after : Double, what : Int) -> Unit = "mb_host_stream_direct"
extern "C" fn c_st_frame_shown(id : Int, data : Ptr, data_len : Int64, key : Int, ts : Double, show : Int) -> Int = "pion_host_stream_frame_shown"
extern "C" fn c_st_flush(id : Int, drain : Int) -> Unit = "mb_host_stream_flush"
extern "C" fn c_st_audio_played(id : Int) -> Double = "mb_host_stream_audio_played"
extern "C" fn c_st_audio_queued(id : Int) -> Double = "mb_host_stream_audio_queued"
extern "C" fn c_st_audio_wanted(id : Int) -> Double = "mb_host_stream_audio_wanted"
extern "C" fn c_st_audio_volume(id : Int, v : Double) -> Unit = "mb_host_stream_audio_volume"

fn st_open() -> Int { c_st_open() }

fn st_h264(id : Int, avcc : Bytes, w : Int, h : Int) -> Unit {
  c_st_h264(id, bytes_data_ptr(avcc), avcc.length().to_int64(), w, h)
}

fn st_frame(id : Int, data : Bytes, key : Int, ts : Double) -> Unit {
  c_st_frame(id, bytes_data_ptr(data), data.length().to_int64(), key, ts)
}

fn st_jpeg(id : Int, data : Bytes, ts : Double) -> Unit {
  c_st_jpeg(id, bytes_data_ptr(data), data.length().to_int64(), ts)
}

fn st_next(id : Int) -> String { take_c_str(c_st_next(id)) }
fn st_show(id : Int, ts : Double) -> Unit { c_st_show(id, ts) }
fn st_close(id : Int) -> Unit { c_st_close(id) }
fn st_h264_here() -> Int { c_st_h264_here() }
fn st_feeds() -> Int { c_st_feeds() }

fn st_codec(id : Int, cmd : String, data : Bytes) -> Unit {
  c_st_codec(
    id,
    str_data_ptr(cmd),
    cmd.length().to_int64(),
    bytes_data_ptr(data),
    data.length().to_int64(),
  )
}

fn st_audio_here() -> Int { c_st_audio_here() }
fn st_h265_here() -> Int { c_st_h265_here() }

fn st_hevc(id : Int, hvcc : Bytes, w : Int, h : Int) -> Unit {
  c_st_hevc(id, bytes_data_ptr(hvcc), hvcc.length().to_int64(), w, h)
}

fn st_av1_here() -> Int { c_st_av1_here() }

fn st_av1(id : Int, av1c : Bytes, w : Int, h : Int) -> Unit {
  c_st_av1(id, bytes_data_ptr(av1c), av1c.length().to_int64(), w, h)
}

fn st_audio(id : Int, data : Bytes) -> Unit {
  c_st_audio(id, bytes_data_ptr(data), data.length().to_int64())
}

fn st_layers() -> Int { c_st_layers() }

fn st_pointer(id : Int, png : Bytes, w : Double, h : Double, hx : Double, hy : Double) -> Unit {
  c_st_pointer(id, bytes_data_ptr(png), png.length().to_int64(), w, h, hx, hy)
}

fn st_pointer_at(id : Int, x : Double, y : Double, shown : Int) -> Unit {
  c_st_pointer_at(id, x, y, shown)
}

fn st_direct(id : Int, route : Double, after : Double, what : Int) -> Unit {
  c_st_direct(id, route, after, what)
}

fn st_frame_shown(id : Int, data : Bytes, key : Int, ts : Double, show : Int) -> Int {
  c_st_frame_shown(id, bytes_data_ptr(data), data.length().to_int64(), key, ts, show)
}

fn st_flush(id : Int, drain : Int) -> Unit { c_st_flush(id, drain) }
fn st_audio_played(id : Int) -> Double { c_st_audio_played(id) }
fn st_audio_queued(id : Int) -> Double { c_st_audio_queued(id) }
fn st_audio_wanted(id : Int) -> Double { c_st_audio_wanted(id) }
fn st_audio_volume(id : Int, v : Double) -> Unit { c_st_audio_volume(id, v) }
