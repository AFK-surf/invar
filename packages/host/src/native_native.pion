// native.pion's calls on a native host (apple_device.h).
// Ported 1:1 from libs/mbui/src/host/native_native.mbt.

extern "C" fn c_ncall_call(name : Ptr, name_len : Int64, params : Ptr, params_len : Int64) -> Int = "pion_host_native_call"
extern "C" fn c_ncall_state(id : Int) -> Int = "mb_host_native_state"
extern "C" fn c_ncall_result(id : Int) -> Ptr = "pion_host_native_result"
extern "C" fn c_ncall_end(id : Int) -> Unit = "mb_host_native_end"

fn ncall_call(name : String, params : String) -> Int {
  c_ncall_call(
    str_data_ptr(name),
    name.length().to_int64(),
    str_data_ptr(params),
    params.length().to_int64(),
  )
}

fn ncall_state(id : Int) -> Int { c_ncall_state(id) }
fn ncall_result(id : Int) -> String { take_c_str(c_ncall_result(id)) }
fn ncall_end(id : Int) -> Unit { c_ncall_end(id) }
