// device.pion's calls on a native host (apple_device.h).
// Ported 1:1 from libs/mbui/src/host/device_native.mbt.

extern "C" fn c_cl_read() -> Int = "mb_host_clip_read"
extern "C" fn c_cl_state(id : Int) -> Int = "mb_host_clip_state"
extern "C" fn c_cl_picture(id : Int) -> Int = "mb_host_clip_picture"
extern "C" fn c_cl_text(id : Int) -> Ptr = "pion_host_clip_text"
extern "C" fn c_cl_png(id : Int) -> Ptr = "pion_host_clip_png"
extern "C" fn c_cl_files(id : Int) -> Int = "mb_host_clip_files"
extern "C" fn c_cl_file_name(id : Int, i : Int) -> Ptr = "pion_host_clip_file_name"
extern "C" fn c_cl_file(id : Int, i : Int) -> Ptr = "pion_host_clip_file"
extern "C" fn c_cl_end(id : Int) -> Unit = "mb_host_clip_end"
extern "C" fn c_cl_set(
  text : Ptr,
  text_len : Int64,
  png : Ptr,
  png_len : Int64,
  label : Ptr,
  label_len : Int64,
) -> Unit = "pion_host_clip_set"

extern "C" fn c_dv_copy_shown() -> Int = "mb_host_copy_shown"
extern "C" fn c_dv_key_catch(on : Int) -> Unit = "mb_host_key_catch"
extern "C" fn c_dv_ime_inset() -> Double = "mb_host_ime_inset"
extern "C" fn c_dv_keep_awake(on : Int) -> Unit = "mb_host_keep_awake"
extern "C" fn c_dv_haptic(kind : Int) -> Unit = "mb_host_haptic"
extern "C" fn c_dv_ime_action(kind : Int) -> Unit = "mb_host_ime_action"

fn cl_read() -> Int { c_cl_read() }
fn cl_state(id : Int) -> Int { c_cl_state(id) }
fn cl_picture(id : Int) -> Int { c_cl_picture(id) }
fn cl_text(id : Int) -> String { take_c_str(c_cl_text(id)) }
fn cl_png(id : Int) -> Bytes { take_mb_bytes(c_cl_png(id)) }
fn cl_files(id : Int) -> Int { c_cl_files(id) }
fn cl_file_name(id : Int, i : Int) -> String { take_c_str(c_cl_file_name(id, i)) }
fn cl_file(id : Int, i : Int) -> Bytes { take_mb_bytes(c_cl_file(id, i)) }
fn cl_end(id : Int) -> Unit { c_cl_end(id) }

fn cl_set(text : String, png : Bytes, label : String) -> Unit {
  c_cl_set(
    str_data_ptr(text),
    text.length().to_int64(),
    bytes_data_ptr(png),
    png.length().to_int64(),
    str_data_ptr(label),
    label.length().to_int64(),
  )
}

fn dv_copy_shown() -> Int { c_dv_copy_shown() }
fn dv_key_catch(on : Int) -> Unit { c_dv_key_catch(on) }
fn dv_ime_inset() -> Double { c_dv_ime_inset() }
fn dv_keep_awake(on : Int) -> Unit { c_dv_keep_awake(on) }
fn dv_haptic(kind : Int) -> Unit { c_dv_haptic(kind) }
fn dv_ime_action(kind : Int) -> Unit { c_dv_ime_action(kind) }
