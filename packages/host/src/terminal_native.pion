// terminal.pion's calls on a native host (term.h).
// Ported 1:1 from libs/mbui/src/host/terminal_native.mbt.

extern "C" fn c_tm_open(cols : Int, rows : Int) -> Int = "mb_host_term_open"
extern "C" fn c_tm_write(id : Int, data : Ptr, data_len : Int64) -> Unit = "pion_host_term_write"
extern "C" fn c_tm_resize(id : Int, cols : Int, rows : Int, cw : Int, ch : Int) -> Unit = "mb_host_term_resize"
extern "C" fn c_tm_frame(id : Int, flags : Int) -> Ptr = "pion_host_term_frame"
extern "C" fn c_tm_modes(id : Int) -> Int = "mb_host_term_modes"
extern "C" fn c_tm_scroll(id : Int, kind : Int, value : Int) -> Unit = "mb_host_term_scroll"
extern "C" fn c_tm_select(id : Int, kind : Int, x0 : Int, y0 : Int, x1 : Int, y1 : Int) -> Int = "mb_host_term_select"
extern "C" fn c_tm_text(id : Int, sel : Int) -> Ptr = "pion_host_term_text"
extern "C" fn c_tm_mouse(
  id : Int,
  action : Int,
  button : Int,
  mods : Int,
  x : Int,
  y : Int,
  w : Int,
  h : Int,
  cw : Int,
  ch : Int,
) -> Ptr = "pion_host_term_mouse"
extern "C" fn c_tm_close(id : Int) -> Unit = "mb_host_term_close"

fn tm_open(cols : Int, rows : Int) -> Int { c_tm_open(cols, rows) }

fn tm_write(id : Int, data : Bytes) -> Unit {
  c_tm_write(id, bytes_data_ptr(data), data.length().to_int64())
}

fn tm_resize(id : Int, cols : Int, rows : Int, cw : Int, ch : Int) -> Unit {
  c_tm_resize(id, cols, rows, cw, ch)
}

fn tm_frame(id : Int, flags : Int) -> Bytes { take_mb_bytes(c_tm_frame(id, flags)) }
fn tm_modes(id : Int) -> Int { c_tm_modes(id) }
fn tm_scroll(id : Int, kind : Int, value : Int) -> Unit { c_tm_scroll(id, kind, value) }

fn tm_select(id : Int, kind : Int, x0 : Int, y0 : Int, x1 : Int, y1 : Int) -> Int {
  c_tm_select(id, kind, x0, y0, x1, y1)
}

fn tm_text(id : Int, sel : Int) -> String { take_c_str(c_tm_text(id, sel)) }

fn tm_mouse(
  id : Int,
  action : Int,
  button : Int,
  mods : Int,
  x : Int,
  y : Int,
  w : Int,
  h : Int,
  cw : Int,
  ch : Int,
) -> Bytes {
  take_mb_bytes(c_tm_mouse(id, action, button, mods, x, y, w, h, cw, ch))
}

fn tm_close(id : Int) -> Unit { c_tm_close(id) }
