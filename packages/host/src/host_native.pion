pub fn layer_render(
  id : Int,
  phys_w : Int,
  phys_h : Int,
  scale : Double,
  inst : FixedArray[Double],
  count : Int,
) -> Bool {
  if count < 0 || (count > 0 && inst.length() < count * 60) {
    return false
  }
  let ptr = if count == 0 { ptr_null() } else { array_data_ptr(inst) }
  c_layer_render(id, phys_w, phys_h, scale, ptr, count) != 0
}

pub fn layer_destroy(id : Int) -> Unit {
  c_layer_destroy(id)
}

