fn run(
  title : String,
  frame : (Double, Double, Double, Double) -> Unit,
  pointer : (Int, Double, Double, Int) -> Unit,
  wheel : (Double, Double, Double, Double, Int) -> Unit,
  key : (Int, Int) -> Unit,
  text : (Int, String, Int, Int) -> Unit,
) -> Unit {
  cb_slots.frame = frame
  cb_slots.pointer = pointer
  cb_slots.wheel = wheel
  cb_slots.key = key
  cb_slots.text = text
  c_run(
    str_data_ptr(title),
    title.length().to_int64(),
    c_fn_ptr(pion_cb_frame),
    c_fn_ptr(pion_cb_pointer),
    c_fn_ptr(pion_cb_wheel),
    c_fn_ptr(pion_cb_key),
    c_fn_ptr(pion_cb_text),
  )
}

