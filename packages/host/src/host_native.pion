struct ReduceCache {
  mut read_at : Double
  mut said : Bool
}

let reduce_cache : ReduceCache = ReduceCache::{ read_at: -1.0, said: false }

fn reduce_motion() -> Bool {
  let t = c_now()
  if t - reduce_cache.read_at > 1000.0 || reduce_cache.read_at < 0.0 {
    reduce_cache.read_at = t
    reduce_cache.said = c_reduce_motion() != 0
  }
  reduce_cache.said
}

