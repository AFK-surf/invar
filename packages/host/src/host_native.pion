/// The most pages the host's glyph atlases may have (each at most 32, at most 128 MiB, at least 2; 0: the host's
/// own): before the first glyph is drawn. MBUI_ATLAS_PAGES says the same where the program is run.
pub fn set_atlas_max_pages(n : Int) -> Unit { c_set_atlas_max_pages(n) }

/// How many pages the renderer's glyph atlas texture has now, once what it was told before is done (pages it was told
/// to give back are no longer held): for tests.
