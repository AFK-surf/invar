fn post_take() -> Int { c_post_take() }

fn post_next() -> Option[(String, String, Bytes)] {
  let channel = take_c_str(c_post_next())
  if channel == "" {
    None
  } else {
    Some((channel, take_c_str(c_post_json()), take_mb_bytes(c_post_bytes())))
  }
}

