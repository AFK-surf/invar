}

fn word_pair(v : Double) -> (Int, Int) {
  if v < 0.0 {
    return (-1, -1)
  }
  let k = 4294967296.0
  let s = (v / k).to_int()
  let rem = (v - (s as Double) * k).to_int()
  (s, rem)
}

fn word_at(text : String, off : Int) -> (Int, Int) {
  word_pair(c_word_at(str_data_ptr(text), text.length().to_int64(), off))
}

