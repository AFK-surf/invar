// Native host FFI declarations, callback trampolines, and wrappers.
// Ported 1:1 from libs/mbui/src/host/host_native.mbt.

// ---- Callback trampolines (Pion closures <-> C function pointers) ----

struct CallbackSlots {
  mut window_key : (Int, Int) -> Int
  mut window_close : () -> Bool
  mut frame : (Double, Double, Double, Double) -> Unit
  mut pointer : (Int, Double, Double, Int) -> Unit
  mut wheel : (Double, Double, Double, Double, Int) -> Unit
  mut key : (Int, Int) -> Unit
  mut text : (Int, String, Int, Int) -> Unit
  mut outside : (Int, Int, Int) -> Unit
  mut back : (Int, Double, Double, Int) -> Unit
  mut app_state : (Int) -> Unit
}

let cb_slots : CallbackSlots = CallbackSlots::{
  window_key: fn(_k : Int, _m : Int) -> Int { 0 },
  window_close: fn() -> Bool { true },
  frame: fn(_w : Double, _h : Double, _s : Double, _t : Double) -> Unit { () },
  pointer: fn(_k : Int, _x : Double, _y : Double, _b : Int) -> Unit { () },
  wheel: fn(_x : Double, _y : Double, _dx : Double, _dy : Double, _p : Int) -> Unit { () },
  key: fn(_k : Int, _m : Int) -> Unit { () },
  text: fn(_k : Int, _s : String, _a : Int, _b : Int) -> Unit { () },
  outside: fn(_k : Int, _id : Int, _st : Int) -> Unit { () },
  back: fn(_k : Int, _x : Double, _p : Double, _e : Int) -> Unit { () },
  app_state: fn(_st : Int) -> Unit { () },
}

extern "C" fn pion_cb_window_key(k : Int, m : Int) -> Int = "pion_host_cb_window_key" {
  (cb_slots.window_key)(k, m)
}

extern "C" fn pion_cb_window_close() -> Int = "pion_host_cb_window_close" {
  if (cb_slots.window_close)() { 1 } else { 0 }
}

extern "C" fn pion_cb_frame(w : Double, h : Double, s : Double, t : Double) -> Unit = "pion_host_cb_frame" {
  (cb_slots.frame)(w, h, s, t)
}

extern "C" fn pion_cb_pointer(k : Int, x : Double, y : Double, b : Int) -> Unit = "pion_host_cb_pointer" {
  (cb_slots.pointer)(k, x, y, b)
}

extern "C" fn pion_cb_wheel(x : Double, y : Double, dx : Double, dy : Double, p : Int) -> Unit = "pion_host_cb_wheel" {
  (cb_slots.wheel)(x, y, dx, dy, p)
}

extern "C" fn pion_cb_key(k : Int, m : Int) -> Unit = "pion_host_cb_key" {
  (cb_slots.key)(k, m)
}

extern "C" fn pion_cb_text(k : Int, cstr : Ptr, a : Int, b : Int) -> Unit = "pion_host_cb_text" {
  (cb_slots.text)(k, cstr_to_str(cstr), a, b)
}

extern "C" fn pion_cb_outside(k : Int, id : Int, st : Int) -> Unit = "pion_host_cb_outside" {
  (cb_slots.outside)(k, id, st)
}

extern "C" fn pion_cb_back(k : Int, x : Double, p : Double, e : Int) -> Unit = "pion_host_cb_back" {
  (cb_slots.back)(k, x, p, e)
}

extern "C" fn pion_cb_app_state(st : Int) -> Unit = "pion_host_cb_app_state" {
  (cb_slots.app_state)(st)
}

// ---- Offscreen & event loop & C-pointer marshalling FFI ----

extern "C" fn c_mb_bytes_len(p : Ptr) -> Int = "pion_mb_bytes_len"
extern "C" fn c_mb_decref(p : Ptr) -> Unit = "moonbit_decref"

fn take_c_str(p : Ptr) -> String {
  let s = cstr_to_str(p)
  ptr_free(p)
  s
}

fn take_mb_bytes(p : Ptr) -> Bytes {
  let n = c_mb_bytes_len(p)
  let b = if n > 0 { bytes_from_ptr(p, n) } else { "".to_bytes() }
  c_mb_decref(p)
  b
}

