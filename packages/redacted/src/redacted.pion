// Layer-0 zero-dependency value-level secret redaction (`Redacted[T]`).
//
// Threat model: prevents accidental secret leakage to logs, Wire/JSON serialization,
// agent snapshots, and diagnostic formatting. Every plaintext read requires an explicit
// `expose` / `expose_map` call so a repository-wide grep for `.expose` audits all reads.
//
// Placeholder string is lowercase `"[redacted]"` to match `agent_bridge` wire protocol.

pub let redacted_placeholder : String = "[redacted]"

/// Opaque wrapper around a sensitive value.
/// External packages cannot read `inner` or pattern-match it out.
pub struct Redacted[T] {
  priv inner : T
}

pub fn Redacted::new[T](value : T) -> Redacted[T] {
  Redacted::{ inner: value }
}

/// Explicitly unwrap the inner secret value. Auditable via grep for `.expose(`.
pub fn Redacted::expose[T](self : Redacted[T]) -> T {
  self.inner
}

/// Transform a redacted value while keeping the result wrapped.
/// Intentionally named `expose_map` (never bare `map`) so `.expose` grep audits catch it.
pub fn Redacted::expose_map[T, U](self : Redacted[T], f : (T) -> U) -> Redacted[U] {
  Redacted::{ inner: f(self.inner) }
}

/// Safe string rendering — always returns `"[redacted]"`, never the inner value.
pub fn Redacted::to_string[T](self : Redacted[T]) -> String {
  let _ = self
  redacted_placeholder
}

/// Safe JSON string literal — always returns `"\"[redacted]\""`.
pub fn Redacted::to_json_string[T](self : Redacted[T]) -> String {
  let _ = self
  "\"[redacted]\""
}

/// Value equality so structs containing `Redacted[T]` support `#derive(Eq)` and `signals::signal`.
/// Note: `==` is standard (non-constant-time) equality for state diffing and containers.
/// For secret verification (tokens, digests, passwords), use `ct_eq_str` or `ct_eq_bytes`.
/// Intentionally does NOT implement `Hash` or ordering (`Compare`).
pub impl[T : Eq] Eq for Redacted[T] {
  fn equal(a : Redacted[T], b : Redacted[T]) -> Bool {
    a.inner == b.inner
  }
}

/// Check whether a redacted string is empty without unwrapping the text.
/// Note: emptiness (presence vs absence) is intentionally disclosed metadata, matching
/// password-field accessibility length semantics.
#verify
pub fn is_empty(r : Redacted[String]) -> Bool {
  r.inner.length() == 0
}

/// Constant-time byte-slice equality (scans full shared length without early exit on mismatch).
/// Suitable for secret token / digest comparison.
#verify
pub fn ct_eq_bytes(a : Bytes, b : Bytes) -> Bool {
  let la = a.length()
  let lb = b.length()
  let mut diff : Int = la ^ lb
  let n = if la < lb { la } else { lb }
  let mut i = 0
  while i < n {
    let ba : Int = a[i].to_int()
    let bb : Int = b[i].to_int()
    diff = diff | (ba ^ bb)
    i += 1
  }
  diff == 0
}

/// Constant-time UTF-8 byte equality for `Redacted[String]` without allocating a copy of the secret.
pub fn ct_eq_str(a : Redacted[String], b : Redacted[String]) -> Bool {
  let sa = a.inner
  let sb = b.inner
  let la = sa.length()
  let lb = sb.length()
  let mut diff : Int = la ^ lb
  let n = if la < lb { la } else { lb }
  let mut i = 0
  while i < n {
    let ba : Int = sa.code_unit_at(i)
    let bb : Int = sb.code_unit_at(i)
    diff = diff | (ba ^ bb)
    i += 1
  }
  diff == 0
}
