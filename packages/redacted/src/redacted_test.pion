#derive(Eq)
struct AuthModel {
  user : String
  token : Redacted[String]
}

test "redacted hides secret in string and json output" {
  let secret = Redacted::new("sk_live_top_secret_12345")
  debug_assert(secret.to_string() == "[redacted]", "to_string always redacted")
  debug_assert(secret.to_json_string() == "\"[redacted]\"", "to_json_string always redacted")
  debug_assert(secret.expose() == "sk_live_top_secret_12345", "explicit expose returns secret")
  debug_assert(!is_empty(secret), "non-empty secret")
  debug_assert(is_empty(Redacted::new("")), "empty secret")
}

test "redacted expose_map transforms without changing placeholder" {
  let raw = Redacted::new("abc")
  let mapped = raw.expose_map(fn(s : String) -> String { s + "_suffix" })
  debug_assert(mapped.to_string() == "[redacted]", "mapped stays redacted")
  debug_assert(mapped.expose() == "abc_suffix", "mapped value transformed")
}

test "redacted implements Eq and works inside #derive(Eq) structs" {
  let m1 = AuthModel::{ user: "alice", token: Redacted::new("tok-1") }
  let m2 = AuthModel::{ user: "alice", token: Redacted::new("tok-1") }
  let m3 = AuthModel::{ user: "alice", token: Redacted::new("tok-2") }
  debug_assert(m1 == m2, "equal redacted fields")
  debug_assert(m1 != m3, "unequal redacted fields")
}

test "constant-time secret comparisons" {
  let a = Redacted::new("secret-token-xyz")
  let b = Redacted::new("secret-token-xyz")
  let c = Redacted::new("secret-token-xyZ")
  let d = Redacted::new("secret-token")
  debug_assert(ct_eq_str(a, b), "ct_eq_str equal")
  debug_assert(!ct_eq_str(a, c), "ct_eq_str same len diff byte")
  debug_assert(!ct_eq_str(a, d), "ct_eq_str diff len")

  let ba = "0123456789".to_bytes()
  let bb = "0123456789".to_bytes()
  let bc = "0123456780".to_bytes()
  debug_assert(ct_eq_bytes(ba, bb), "ct_eq_bytes equal")
  debug_assert(!ct_eq_bytes(ba, bc), "ct_eq_bytes unequal")
}
