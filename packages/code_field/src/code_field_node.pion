// Pure-tree syntax-highlighted code editor view (`code_field` and `<code_field::CodeFieldView>`).
// Renders a monospace gutter with line numbers, active line highlight, syntax-colored runs,
// matching bracket highlight, and focused caret indicator.

import "editor"
import "ui"
import "view"

fn int_to_str(n : Int) -> String {
  if n == 0 {
    return "0"
  }
  let digits : Array[Int] = []
  let mut v = if n < 0 { -n } else { n }
  while v > 0 {
    digits.push(v % 10)
    v = v / 10
  }
  let sb = StringBuilder::new()
  if n < 0 {
    sb.write_byte(45 as Byte)
  }
  let mut i = digits.length() - 1
  while i >= 0 {
    sb.write_byte((48 + digits[i]) as Byte)
    i -= 1
  }
  sb.to_string()
}

/// Mount a pure-tree syntax-highlighted code editor bound to `cf : CodeField`.
pub fn code_field(
  parent : view::View,
  cf : CodeField,
  font_size~ : Double = 13.0,
  line~ : Double = 20.0,
  palette~ : CodePalette = CodePalette::dark(),
  show_gutter~ : Bool = true,
  label~ : String = "Code Editor",
) -> view::View {
  cf.show_gutter = show_gutter
  let line_h = if line > 0.0 { line } else { font_size * 1.55 }
  let look = view::WordsLook::of(font_size, line=line_h, wrap=false)
  let gutter_look = view::WordsLook::of(font_size - 1.0, line=line_h, wrap=false)

  parent.box(fn(root : view::View) {
    let _ = root
    .row(view::Live::Is(true))
    .ground(view::Live::Is(palette.bg))
    .clips(view::Live::Is(true))
    .focusable(view::Live::Is(true), keys=0)
    .cursor(view::Live::Is(Some(view::Cursor::IBeam)))
    .says(view::Live::By(fn() { Some(view::said(view::Role::TextField, label=label, value=cf.text())) }))
    .on_press(fn() {
      cf.field.focus()
    })
    .on_key(fn(k : view::Key) -> Bool {
      cf.handle_key(k.code, k.mods)
    })

    // Line-number gutter + single crisp 1pt divider
    if show_gutter {
      let _ = root.box(fn(gutter : view::View) {
        let _ = gutter
        .width(view::Live::Is(Some(40.0)))
        .ground(view::Live::Is(palette.gutter_bg))
        .padding(view::Live::Is((6.0, 10.0, 10.0, 10.0)))
        gutter.each_of(
          fn() {
            let _ = cf.text()
            let _ = cf.rev_sig.get()
            let n = cf.line_count()
            let idxs : Array[Int] = []
            for i in 0..<n {
              idxs.push(i)
            }
            idxs
          },
          fn(row : view::View, idx : Int) {
            let _ = row
            .height(view::Live::Is(Some(line_h)))
            .lines_up(view::Live::Is(Some(view::Along::End)))
            .words(
              view::Live::Is(int_to_str(idx + 1)),
              ink=palette.gutter_fg,
              look=gutter_look,
            )
            .ink(
              view::Live::By(fn() {
                let _ = cf.field.selection()
                let _ = cf.rev_sig.get()
                if cf.highlight_active_line && cf.active_line() == idx {
                  palette.plain
                } else {
                  palette.gutter_fg
                }
              }),
            )
          },
          at_once=true,
        )
      })
      let _ = root.box(fn(div : view::View) {
        let _ = div
        .width(view::Live::Is(Some(1.0)))
        .ground(view::Live::Is(palette.gutter_divider))
      })
    }

    // Syntax-highlighted code lines column
    let _ = root.box(fn(body : view::View) {
      let _ = body
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
      body.each_of(
        fn() {
          let _ = cf.text()
          let _ = cf.rev_sig.get()
          let n = cf.line_count()
          let idxs : Array[Int] = []
          for i in 0..<n {
            idxs.push(i)
          }
          idxs
        },
        fn(row : view::View, idx : Int) {
          let _ = row
          .height(view::Live::Is(Some(line_h)))
          .radius(view::Live::Is(4.0))
          .ground(
            view::Live::By(fn() {
              let _ = cf.field.selection()
              let _ = cf.rev_sig.get()
              if cf.highlight_active_line && cf.active_line() == idx {
                palette.active_line_bg
              } else {
                0L
              }
            }),
          )
          .words_runs(
            view::Live::By(fn() {
              let src = cf.text()
              let _ = cf.field.selection()
              let _ = cf.rev_sig.get()
              let lines = code_logical_lines(src)
              if idx >= lines.length() {
                return []
              }
              let (ls, _, txt) = lines[idx]
              let (ba, bb) = match cf.matching_bracket() {
                Some((a, b)) => (a, b)
                None => (-1, -1)
              }
              code_runs_for_line(cf.lang, txt, palette, bracket_a=ba, bracket_b=bb, line_byte_start=ls)
            }),
            ink=palette.plain,
            look=look,
          )

          // Focused caret indicator on the active line
          let _ = row.show(
            fn() {
              let _ = cf.text()
              let _ = cf.field.selection()
              let _ = cf.rev_sig.get()
              cf.field.focused() && cf.active_line() == idx
            },
            fn(caret_v : view::View) {
              let _ = caret_v
              .over_at(
                view::Live::By(fn() {
                  let _ = caret_v.words_redone()
                  let src = cf.text()
                  let _ = cf.field.selection()
                  let _ = cf.rev_sig.get()
                  let lines = code_logical_lines(src)
                  let x = if idx < lines.length() {
                    let (ls, _, _) = lines[idx]
                    let c = cf.field.editor.caret
                    let prefix = editor::str_slice(src, ls, if c > ls { c } else { ls })
                    ui::measure_text_width(prefix, font_size, style_bits=2)
                  } else {
                    0.0
                  }
                  (Some(x), Some(2.0), None, None)
                }),
              )
              .width(view::Live::Is(Some(1.5)))
              .height(view::Live::Is(Some(line_h - 4.0)))
              .ground(view::Live::Is(palette.caret))
              .radius(view::Live::Is(0.75))
              .presses(view::Live::Is(false))
            },
            at_once=true,
          )
        },
        at_once=true,
      )
    })
  })
}

/// Pion-JSX PascalCase wrapper `<code_field::CodeFieldView>` delegating to `code_field`.
pub fn CodeFieldView(
  parent : view::View,
  state : CodeField,
  font_size~ : Double = 13.0,
  line~ : Double = 20.0,
  palette~ : CodePalette = CodePalette::dark(),
  show_gutter~ : Bool = true,
  label~ : String = "Code Editor",
) -> view::View {
  code_field(
    parent,
    state,
    font_size=font_size,
    line=line,
    palette=palette,
    show_gutter=show_gutter,
    label=label,
  )
}
