// End-to-end unit tests for packages/code_field:
// multi-language lexer, matching brackets, auto-indent, indent/dedent selection, and Tester::tree rendering.

import "ui"
import "view"

test "code_field 01: lexer tokenizes Pion keywords, types, functions, strings, numbers, and comments" {
  let src = "pub fn add(x : Int) -> Int {\n  // sum\n  let s = \"hi\"\n  x + 42\n}"
  let spans = tokenize_code("pion", src)
  let mut has_kw = false
  let mut has_fn = false
  let mut has_type = false
  let mut has_comment = false
  let mut has_str = false
  let mut has_num = false
  for sp in spans {
    match sp.kind {
      TokenKind::Keyword => has_kw = true
      TokenKind::Function => has_fn = true
      TokenKind::TypeName => has_type = true
      TokenKind::Comment => has_comment = true
      TokenKind::StringLit => has_str = true
      TokenKind::NumberLit => has_num = true
      _ => ()
    }
  }
  debug_assert(has_kw && has_fn && has_type, "keyword, function, and type tokens recognized")
  debug_assert(has_comment && has_str && has_num, "comment, string, and number tokens recognized")
}

test "code_field 02: matching_bracket finds nested () [] {} pairs" {
  let cf = CodeField::new(text="fn f(a : Array[Int]) { (1 + 2) }")
  // Place caret at '(' of `(a : Array[Int])` -> byte 4, matches ')' at byte 19
  cf.field.pick(4, 4)
  match cf.matching_bracket() {
    Some((a, b)) => debug_assert(a == 4 && b == 19, "matched outer parens (4, 19)")
    None => debug_assert(false, "expected matching parens")
  }
  // Place caret right after closing '}' at end -> matches '{' at byte 21
  cf.field.pick(cf.text().length(), cf.text().length())
  match cf.matching_bracket() {
    Some((a, b)) => debug_assert(a == 21 && b == 31, "matched braces (21, 31)")
    None => debug_assert(false, "expected matching braces")
  }
}

test "code_field 03: auto-indent Enter and selection indent/dedent" {
  let cf = CodeField::new(text="if ok {", tab_size=2)
  // Caret is at end right after '{' -> Enter inserts "\n  "
  debug_assert(cf.handle_key(ui::key_enter, 0), "Enter handled")
  debug_assert(cf.text() == "if ok {\n  ", "auto-indent added 2 spaces after '{'")

  // Multi-line selection indent & dedent
  cf.set("a\nb\nc")
  cf.field.pick(0, 3) // covers lines 0 and 1 ("a\nb")
  cf.indent_selection()
  debug_assert(cf.text() == "  a\n  b\nc", "indented selected lines by 2 spaces")
  cf.dedent_selection()
  debug_assert(cf.text() == "a\nb\nc", "dedented selected lines back cleanly")
}

test "code_field 04: Tester::tree mounts CodeField with gutter and handles editing" {
  let cf = CodeField::new(text="let x = 1\nlet y = 2")
  let t = ui::Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(360.0))).height(view::Live::Is(Some(140.0)))
      let _ = CodeFieldView(b, cf, label="EditorPane")
    })
  })
  t.frame(ms=16.0)
  cf.field.focus()
  debug_assert(cf.handle_key(ui::key_enter, 0), "Enter inserts newline")
  debug_assert(cf.line_count() == 3, "line count grew to 3")
  t.frame(ms=16.0)
  t.dispose()
}
