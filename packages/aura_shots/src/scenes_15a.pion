// Aura Wave 1.5A offscreen calibration scenes (6 scenes: Select, ComboBox, Autocomplete in light & dark 2x).

import "aura"
import "film"
import "headless"
import "signals"
import "ui"
import "view"

fn x15a_shot_setup(root : view::View, dark : Bool, corner_circular~ : Bool = true) -> aura::AuraPalette {
  let cfg = signals::signal(
    if dark {
      aura::AuraConfig::dark(corner_circular=corner_circular)
    } else {
      aura::AuraConfig::light(corner_circular=corner_circular)
    },
  )
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))
  pal
}

fn x15a_abs(parent : view::View, x : Double, y : Double, w : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
    body(v)
  })
}

fn x15a_build_ov_select(root : view::View, dark : Bool, corner_circular~ : Bool = true) -> Unit {
  let _ = x15a_shot_setup(root, dark, corner_circular=corner_circular)
  let items = [
    aura::AuraSelectOption::new("ca", "California"),
    aura::AuraSelectOption::new("ny", "New York"),
    aura::AuraSelectOption::new("tx", "Texas"),
    aura::AuraSelectOption::new("wa", "Washington"),
  ]
  let _ = x15a_abs(root, 270.0, 64.0, 260.0, fn(slot : view::View) -> Unit {
    let _ = aura::select_node(
      slot,
      items,
      label=view::Live::Is("State"),
      initial_selected=["ca"],
      default_open=true,
      popover_width=260.0,
      gap=8.0,
      force_active_ring=true,
    )
  })
}

fn x15a_build_ov_combobox(root : view::View, dark : Bool) -> Unit {
  let _ = x15a_shot_setup(root, dark)
  let items = [
    aura::AuraSelectOption::new("cat", "Cat"),
    aura::AuraSelectOption::new("dog", "Dog"),
    aura::AuraSelectOption::new("fox", "Fox"),
    aura::AuraSelectOption::new("owl", "Owl"),
  ]
  let _ = x15a_abs(root, 270.0, 64.0, 260.0, fn(slot : view::View) -> Unit {
    let _ = aura::combo_box_node(
      slot,
      items,
      label=view::Live::Is("Favorite Animal"),
      initial_selected=["cat"],
      default_open=true,
      popover_width=260.0,
      gap=8.0,
      force_focused=true,
    )
  })
}

fn x15a_build_ov_autocomplete(root : view::View, dark : Bool) -> Unit {
  let _ = x15a_shot_setup(root, dark)
  let items = [
    aura::AuraSelectOption::new("cat", "Cat"),
    aura::AuraSelectOption::new("dog", "Dog"),
    aura::AuraSelectOption::new("lion", "Lion"),
  ]
  let _ = x15a_abs(root, 270.0, 64.0, 260.0, fn(slot : view::View) -> Unit {
    let _ = aura::autocomplete_node(
      slot,
      items,
      label=view::Live::Is("Autocomplete"),
      filter_placeholder=view::Live::Is("Filter..."),
      initial_selected=["cat"],
      default_open=true,
      popover_width=260.0,
      gap=8.0,
      force_filter_focused=true,
      force_active_ring=true,
    )
  })
}

/// Calibration scene: Select open overlay in light mode (800x600@2x).
pub fn scene_ov_select_light_2x(root : view::View) -> Unit {
  x15a_build_ov_select(root, false)
}

/// Calibration scene: Select open overlay in dark mode (800x600@2x).
pub fn scene_ov_select_dark_2x(root : view::View) -> Unit {
  x15a_build_ov_select(root, true)
}

/// Calibration scene: ComboBox open overlay in light mode (800x600@2x).
pub fn scene_ov_combobox_light_2x(root : view::View) -> Unit {
  x15a_build_ov_combobox(root, false)
}

/// Calibration scene: ComboBox open overlay in dark mode (800x600@2x).
pub fn scene_ov_combobox_dark_2x(root : view::View) -> Unit {
  x15a_build_ov_combobox(root, true)
}

/// Calibration scene: Autocomplete open overlay in light mode (800x600@2x).
pub fn scene_ov_autocomplete_light_2x(root : view::View) -> Unit {
  x15a_build_ov_autocomplete(root, false)
}

/// Calibration scene: Autocomplete open overlay in dark mode (800x600@2x).
pub fn scene_ov_autocomplete_dark_2x(root : view::View) -> Unit {
  x15a_build_ov_autocomplete(root, true)
}

/// Default smooth-corner showcase scene: Select open overlay in light mode (`AuraConfig::light()`, `corner_circular=false`).
pub fn scene_ov_select_smooth_light_2x(root : view::View) -> Unit {
  x15a_build_ov_select(root, false, corner_circular=false)
}

fn x15a_run_shot(out_dir : String, only : String, name : String, make : (view::View) -> Unit, smooth_only~ : Bool = false) -> Int {
  let match_ok = if smooth_only {
    only == "smooth" || only == name
  } else {
    only == "" || only == "wave15" || only == "wave15a" || only == name
  }
  if !match_ok {
    return 0
  }
  let path = out_dir + "/" + name + ".png"
  let ok = film::picture(make, path=path, w=800.0, h=600.0, scale=2.0, at=0.0)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

/// Render all 6 Wave 1.5A calibration scenes (light & dark 2x) into `out_dir`.
pub fn render_15a_scenes(out_dir : String, only~ : String = "") -> Int {
  let filter = if only != "" { only } else { ui::env("MBUI_LG_ONLY") }
  let mut errs = 0
  errs = errs + x15a_run_shot(out_dir, filter, "ov-select-light-2x", scene_ov_select_light_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-select-dark-2x", scene_ov_select_dark_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-combobox-light-2x", scene_ov_combobox_light_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-combobox-dark-2x", scene_ov_combobox_dark_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-autocomplete-light-2x", scene_ov_autocomplete_light_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-autocomplete-dark-2x", scene_ov_autocomplete_dark_2x)
  errs = errs + x15a_run_shot(out_dir, filter, "ov-select-smooth-light-2x", scene_ov_select_smooth_light_2x, smooth_only=true)
  errs
}
