// Aura Studio Exhibition Scenes (6 desktop 1280x800 @ 2x + 2 mobile 390x844 @ 2x, default smooth corners).
// Run via: `python3 -B scripts/invar shot --pkg packages/aura_shots --only pages --out /tmp/aura_pages_shots --json`

import "aura"
import "aura_pages"
import "film"
import "signals"
import "ui"
import "view"

fn pages_run_shot_sized(
  out_dir : String,
  only : String,
  name : String,
  w : Double,
  h : Double,
  make : (view::View) -> Unit,
) -> Int {
  let match_ok = only == "pages" || only == name
  if !match_ok {
    return 0
  }
  let path = out_dir + "/" + name + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=2.0, at=0.0)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

fn pages_run_shot(
  out_dir : String,
  only : String,
  name : String,
  make : (view::View) -> Unit,
) -> Int {
  pages_run_shot_sized(out_dir, only, name, 1280.0, 800.0, make)
}

/// 1. Full gallery, Light, Overview (1280x800 @ 2x, smooth corners).
pub fn scene_pages_overview_light_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light())
  aura_pages::gallery(root, cfg, chrome=true, initial_cat=0)
}

/// 2. Full gallery, Dark, Overview (1280x800 @ 2x, smooth corners).
pub fn scene_pages_overview_dark_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::dark())
  aura_pages::gallery(root, cfg, chrome=true, initial_cat=0)
}

/// 3. Inputs & Forms category, Light (1280x800 @ 2x, smooth corners).
pub fn scene_pages_forms_light_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light())
  aura_pages::showcase_page(root, 2, cfg)
}

/// 4. Overlays & Navigation category, Dark, with expanded overlay examples (1280x800 @ 2x, smooth corners).
pub fn scene_pages_overlays_dark_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::dark())
  aura_pages::showcase_page_ex(root, 5, cfg, overlays_open=true)
}

/// 5. DateTime, Color & Feedback composite category, Dark (1280x800 @ 2x, smooth corners).
pub fn scene_pages_composite_dark_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::dark())
  aura_pages::showcase_page(root, 7, cfg)
}

/// 6. Full gallery with RTL enabled, Light (1280x800 @ 2x, smooth corners).
pub fn scene_pages_rtl_light_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(), rtl: true })
  aura_pages::gallery(root, cfg, chrome=true, initial_cat=0)
}

/// 7. Full gallery on mobile 390x844, Light, LTR (smooth corners).
pub fn scene_pages_mobile_390_light_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light())
  aura_pages::gallery(root, cfg, chrome=true, initial_cat=0)
}

/// 8. Full gallery on mobile 390x844, Light, RTL (smooth corners).
pub fn scene_pages_mobile_390_rtl_2x(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(), rtl: true })
  aura_pages::gallery(root, cfg, chrome=true, initial_cat=0)
}

/// Render all 8 Aura Studio exhibition scenes when `only == "pages"` or an exact `pages-*` scene id.
pub fn render_pages_scenes(out_dir : String, only~ : String = "") -> Int {
  let filter = if only != "" { only } else { ui::env("MBUI_LG_ONLY") }
  let mut errs = 0
  errs = errs + pages_run_shot(out_dir, filter, "pages-overview-light-2x", scene_pages_overview_light_2x)
  errs = errs + pages_run_shot(out_dir, filter, "pages-overview-dark-2x", scene_pages_overview_dark_2x)
  errs = errs + pages_run_shot(out_dir, filter, "pages-forms-light-2x", scene_pages_forms_light_2x)
  errs = errs + pages_run_shot(out_dir, filter, "pages-overlays-dark-2x", scene_pages_overlays_dark_2x)
  errs = errs + pages_run_shot(out_dir, filter, "pages-composite-dark-2x", scene_pages_composite_dark_2x)
  errs = errs + pages_run_shot(out_dir, filter, "pages-rtl-light-2x", scene_pages_rtl_light_2x)
  errs = errs + pages_run_shot_sized(out_dir, filter, "pages-mobile-390-light-2x", 390.0, 844.0, scene_pages_mobile_390_light_2x)
  errs = errs + pages_run_shot_sized(out_dir, filter, "pages-mobile-390-rtl-2x", 390.0, 844.0, scene_pages_mobile_390_rtl_2x)
  errs
}
