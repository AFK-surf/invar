// Wave 0A offscreen GPU calibration shot runner for `packages/aura`.
// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0) calibration scenes aligned to `ref_w0_manifest.json`.
//
// Environment variables (compatible with `python3 scripts/invar shot --pkg packages/aura_shots --json`):
//   MBUI_LG_OUT=<dir>    output directory (default "target/aura_shots")
//   MBUI_LG_ONLY=<id>    optional substring filter on scene id
//   MBUI_LG_LIST=1       print available scene ids and exit 0

import "aura"
import "film"
import "host"
import "hostapi"
import "paint"
import "signals"
import "ui"
import "view"

fn w0_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn w0_abs_box(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

// ---------------------------------------------------------------------------
// Scene 1-3: w0-card-surface-{light-2x, dark-2x, light-1x} (1200x900)
// ---------------------------------------------------------------------------
fn build_card_surface(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let th = aura::aura_theme_from(cfg.get())
  let pal = th.palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Heading & subtitle (align Pango line-box top with Blink/Chromium half-leading)
  let _ = w0_abs_box(root, 32.0, 31.3, 1136.0, 28.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Wave 0A — Card & Surface Calibration"), look=w0_words(18.0, 600, 28.0))
      .ink(view::Live::Is(pal.foreground))
  })
  let _ = w0_abs_box(root, 32.0, 64.0, 1136.0, 20.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Blank Cards (r=24 / rounded-3xl) + 3-level Surfaces + 3-layer micro-shadows"), look=w0_words(14.0, 400, 20.0))
      .ink(view::Live::Is(pal.muted))
  })

  // Row 1: 4 blank cards (266x176, r=24) at x = 32, 322, 612, 902; y = 108
  let card_specs : Array[(Double, aura::AuraSurfaceVariant)] = [
    (32.0, aura::AuraSurfaceVariant::Default),
    (322.0, aura::AuraSurfaceVariant::Secondary),
    (612.0, aura::AuraSurfaceVariant::Tertiary),
    (902.0, aura::AuraSurfaceVariant::Transparent),
  ]
  for spec in card_specs {
    let (cx, vari) = spec
    let _ = w0_abs_box(root, cx, 108.0, 266.0, 176.0, fn(slot : view::View) -> Unit {
      let s = aura::surface_node(slot, variant=vari, radius=24.0, shadow=true)
      let _ = s.width(view::Live::Is(Some(266.0))).height(view::Live::Is(Some(176.0)))
    })
  }

  // Row 2: 3 labeled Surfaces (r=24, no shadow: HeroUI `.surface`) at y = 316, h = 144; a 3-column `gap-6` grid
  // whose columns Chromium snaps to whole points (measured: 32..395, 419..781, 805..1168)
  let surf_specs : Array[(Double, Double, aura::AuraSurfaceVariant, String)] = [
    (32.0, 363.0, aura::AuraSurfaceVariant::Default, "Surface Default"),
    (419.0, 362.0, aura::AuraSurfaceVariant::Secondary, "Surface Secondary"),
    (805.0, 363.0, aura::AuraSurfaceVariant::Tertiary, "Surface Tertiary"),
  ]
  for spec in surf_specs {
    let (sx, sw, vari, title) = spec
    let _ = w0_abs_box(root, sx, 316.0, sw, 144.0, fn(slot : view::View) -> Unit {
      let s = aura::surface_node(slot, variant=vari, radius=24.0, pad=20.0, content=fn(inner : view::View) -> Unit {
        let _ = inner.box(fn(t : view::View) -> Unit {
          let _ = t
            .margin(view::Live::Is((0.0, 0.8, 0.0, 0.0)))
            .words(view::Live::Is(title), look=w0_words(14.0, 500, 24.0))
            .ink(view::Live::Is(pal.foreground))
        })
      })
      let _ = s.width(view::Live::Is(Some(sw))).height(view::Live::Is(Some(144.0)))
    })
  }

  // Row 3: Nested Surface Hierarchy (Default 32,492,1136,168 -> Secondary 56,516,1088,120 -> Tertiary 76,536,1048,80)
  let _ = w0_abs_box(root, 32.0, 492.0, 1136.0, 168.0, fn(slot : view::View) -> Unit {
    let s1 = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=24.0, shadow=true, content=fn(l1 : view::View) -> Unit {
      let s2 = aura::surface_node(l1, variant=aura::AuraSurfaceVariant::Secondary, radius=16.0, pad=20.0, shadow=false, content=fn(l2 : view::View) -> Unit {
        let s3 = aura::surface_node(l2, variant=aura::AuraSurfaceVariant::Tertiary, radius=12.0, pad=16.0, shadow=false, content=fn(l3 : view::View) -> Unit {
          let _ = l3.box(fn(t : view::View) -> Unit {
            let _ = t
              .margin(view::Live::Is((0.0, 0.8, 0.0, 0.0)))
              .words(view::Live::Is("Nested Surface Hierarchy"), look=w0_words(14.0, 400, 24.0))
              .ink(view::Live::Is(pal.muted))
          })
        })
        let _ = s3.width(view::Live::Is(Some(1048.0))).height(view::Live::Is(Some(80.0)))
      })
      let _ = s2.width(view::Live::Is(Some(1088.0))).height(view::Live::Is(Some(120.0)))
    })
    let _ = s1.width(view::Live::Is(Some(1136.0))).height(view::Live::Is(Some(168.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 4-5: w0-overlay-{light-2x, dark-2x} (800x600)
// ---------------------------------------------------------------------------
fn build_overlay(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let th = aura::aura_theme_from(cfg.get())
  let pal = th.palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Centered trigger button (natural width, y = 64, h = 36), pressed while its popover is open (`data-pressed`:
  // `--button-bg-pressed` fill, `scale(0.97)`: 136 x 36 drawn 131.9 x 34.9 about x = 400, as measured). Widths here as
  // Chromium laid them out: our measure of words is up to 1.5pt wider than their advance (text_render's padding)
  let _ = w0_abs_box(root, 0.0, 64.0, 800.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    let b = aura::button_node(slot, view::Live::Is("Overlay Trigger"), variant=aura::AuraButtonVariant::Secondary, force_pressed=true)
    let _ = b.width(view::Live::Is(Some(136.0)))
  })

  // Centered overlay panel at (230, 116, 340, 176)
  let _ = w0_abs_box(root, 230.0, 116.0, 340.0, 176.0, fn(slot : view::View) -> Unit {
    let p = aura::w0_popover_shell(slot, radius=24.0, pad=20.0, gap=8.0, content=fn(panel : view::View) -> Unit {
      let _ = panel.box(fn(t : view::View) -> Unit {
        let _ = t
          .words(view::Live::Is("Overlay Surface"), look=w0_words(14.0, 500, 20.0))
          .ink(view::Live::Is(pal.overlay_foreground))
      })
      let _ = panel.box(fn(t : view::View) -> Unit {
        let _ = t
          .fills_across(view::Live::Is(true))
          .words(
            view::Live::Is("Light mode renders 3-layer shadow with dy=-6 upward glow; dark mode renders 1px inset rgba(255,255,255,0.3) edge."),
            look=w0_words(14.0, 400, 20.0, wrap=true),
          )
          .ink(view::Live::Is(pal.muted))
      })
      let _ = panel.box(fn(actions : view::View) -> Unit {
        let _ = actions
          .row(view::Live::Is(true))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::End))
          .gap(view::Live::Is(8.0))
          .margin(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
        // (measured 71 and 78 wide)
        let cancel = aura::button_node(actions, view::Live::Is("Cancel"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Sm)
        let _ = cancel.width(view::Live::Is(Some(71.0)))
        let confirm = aura::button_node(actions, view::Live::Is("Confirm"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm)
        let _ = confirm.width(view::Live::Is(Some(78.0)))
      })
    })
    let _ = p.width(view::Live::Is(Some(340.0))).height(view::Live::Is(Some(176.0)))
  })
}

// A horizontal ButtonGroup of three Secondary buttons (First / Middle / Last: measured 62, 77, 60 wide, no gap; ends
// `rounded-s-3xl` / `rounded-e-3xl`) at (x, y), the one at `focused` showing its keyboard focus ring. As HeroUI's
// `.button-group .button[data-focus-visible]` (`z-10`), the focused button is drawn above its neighbours so its outward
// gap + ring lie over them: it is added last.
fn w0_button_group(root : view::View, x : Double, y : Double, focused : Int) -> Unit {
  let items : Array[(String, Double, Double, (Double, Double, Double, Double))] = [
    ("First", 0.0, 62.0, (18.0, 0.0, 0.0, 18.0)),
    ("Middle", 62.0, 77.0, (0.0, 0.0, 0.0, 0.0)),
    ("Last", 139.0, 60.0, (0.0, 18.0, 18.0, 0.0)),
  ]
  let _ = w0_abs_box(root, x, y, 199.0, 36.0, fn(grp : view::View) -> Unit {
    let order : Array[Int] = []
    for i in [0, 1, 2] {
      if i != focused {
        order.push(i)
      }
    }
    order.push(focused)
    for i in order {
      let (lbl, bx, bw, cs) = items[i]
      let _ = w0_abs_box(grp, bx, 0.0, bw, 36.0, fn(slot : view::View) -> Unit {
        let b = aura::button_node(slot, view::Live::Is(lbl), variant=aura::AuraButtonVariant::Secondary, corners=cs, force_focus_visible=i == focused)
        let _ = b.width(view::Live::Is(Some(bw)))
      })
    }
  })
}

// ---------------------------------------------------------------------------
// Scene 6-7: w0-states-focus-disabled-{light-2x, dark-2x} (1200x700)
// ---------------------------------------------------------------------------
fn build_states_focus_disabled(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let th = aura::aura_theme_from(cfg.get())
  let pal = th.palette
  let _ = root.ground(view::Live::Is(pal.background))

  let _ = w0_abs_box(root, 32.0, 31.3, 1136.0, 28.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Wave 0A — Button Variants, Disabled Group Alpha, Focus & Invalid Rings"), look=w0_words(18.0, 600, 28.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Row 1: 7 Button variants (`gap-4`) at y = 84, h = 36. Widths as Chromium laid the reference's `w-fit` buttons out
  // (px-4 + its label's advance, glyph advances rounded to device pixels): measured 84 105 83 72 82 81 111.
  let row1 : Array[(String, Double, aura::AuraButtonVariant)] = [
    ("Primary", 84.0, aura::AuraButtonVariant::Primary),
    ("Secondary", 105.0, aura::AuraButtonVariant::Secondary),
    ("Tertiary", 83.0, aura::AuraButtonVariant::Tertiary),
    ("Ghost", 72.0, aura::AuraButtonVariant::Ghost),
    ("Outline", 82.0, aura::AuraButtonVariant::Outline),
    ("Danger", 81.0, aura::AuraButtonVariant::Danger),
    ("Danger Soft", 111.0, aura::AuraButtonVariant::DangerSoft),
  ]
  let _ = w0_abs_box(root, 32.0, 84.0, 1136.0, 36.0, fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(16.0))
    for item in row1 {
      let (lbl, bw, vari) = item
      let b = aura::button_node(row, view::Live::Is(lbl), variant=vari)
      let _ = b.width(view::Live::Is(Some(bw)))
    }
  })

  // Row 2: Disabled Primary + Keyboard Focus + Secondary Focus (`gap-6`) at y = 152, h = 36 (measured 146 140 149)
  let _ = w0_abs_box(root, 32.0, 152.0, 1136.0, 36.0, fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(24.0))
    let b1 = aura::button_node(row, view::Live::Is("Disabled Primary"), variant=aura::AuraButtonVariant::Primary, disabled=view::Live::Is(true))
    let _ = b1.width(view::Live::Is(Some(146.0)))
    let b2 = aura::button_node(row, view::Live::Is("Keyboard Focus"), variant=aura::AuraButtonVariant::Primary, force_focus_visible=true)
    let _ = b2.width(view::Live::Is(Some(140.0)))
    let b3 = aura::button_node(row, view::Live::Is("Secondary Focus"), variant=aura::AuraButtonVariant::Secondary, force_focus_visible=true)
    let _ = b3.width(view::Live::Is(Some(149.0)))
  })

  // Row 3: 3 Inputs (Focused, Invalid Unfocused, Invalid Focused) at y = 244, h = 36
  let inputs : Array[(Double, Double, String, String, Bool, Bool)] = [
    (32.0, 363.0, "Focused Input (0 offset)", "hello@invar.dev", false, true),
    (419.0, 362.0, "Invalid Unfocused (1px)", "bad-email", true, false),
    (805.0, 363.0, "Invalid Focused (2px)", "bad-email", true, true),
  ]
  for inp in inputs {
    let (ix, iw, lbl, txt, inv, foc) = inp
    let _ = w0_abs_box(root, ix, 222.0, iw, 16.0, fn(v : view::View) -> Unit {
      let _ = v.words(view::Live::Is(lbl), look=w0_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
    })
    let _ = w0_abs_box(root, ix, 244.0, iw, 36.0, fn(slot : view::View) -> Unit {
      let f = aura::w0_field_shell(
        slot,
        invalid=view::Live::Is(inv),
        height=36.0,
        force_focused=foc,
        content=fn(fv : view::View) -> Unit {
          let _ = fv.box(fn(t : view::View) -> Unit {
            let _ = t.words(view::Live::Is(txt), look=w0_words(14.0, 400, 20.0)).ink(view::Live::Is(pal.field_foreground))
          })
        },
      )
      let _ = f.width(view::Live::Is(Some(iw)))
    })
  }

  // Row 4: ButtonGroup First Focused & Last Focused at y = 336, h = 36
  let _ = w0_abs_box(root, 32.0, 314.0, 200.0, 16.0, fn(v : view::View) -> Unit {
    let _ = v.words(view::Live::Is("ButtonGroup — First Focused"), look=w0_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
  })
  w0_button_group(root, 32.0, 336.0, 0)

  let _ = w0_abs_box(root, 271.0, 314.0, 200.0, 16.0, fn(v : view::View) -> Unit {
    let _ = v.words(view::Live::Is("ButtonGroup — Last Focused"), look=w0_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
  })
  w0_button_group(root, 271.0, 336.0, 2)
}

// ---------------------------------------------------------------------------
// Scene 8-9: w0-skeleton-group-{light-2x, dark-2x} (800x400)
// ---------------------------------------------------------------------------
// One channel (0..255) of an 0xRRGGBBAA colour.
fn w0_ch(c : Int64, shift : Int) -> Double {
  ((c >> shift) & 0xFFL).to_double()
}

fn w0_rgb(r : Double, g : Double, b : Double) -> Int64 {
  let q = fn(v : Double) -> Int64 {
    let x = if v < 0.0 { 0.0 } else if v > 255.0 { 255.0 } else { v }
    x.round().to_int64()
  }
  (q(r) << 24) | (q(g) << 16) | (q(b) << 8) | 0xFFL
}

// `over` drawn over `under` with opacity `a`.
fn w0_mix(under : Int64, over : Int64, a : Double) -> Int64 {
  w0_rgb(
    w0_ch(under, 24) + (w0_ch(over, 24) - w0_ch(under, 24)) * a,
    w0_ch(under, 16) + (w0_ch(over, 16) - w0_ch(under, 16)) * a,
    w0_ch(under, 8) + (w0_ch(over, 8) - w0_ch(under, 8)) * a,
  )
}

// White drawn over `under` with `mix-blend-mode: overlay` at opacity `a`: B(cb, 1) = 2 cb (cb <= 0.5), else 1.
fn w0_overlay_white(under : Int64, a : Double) -> Int64 {
  let ch = fn(shift : Int) -> Double {
    let cb = w0_ch(under, shift) / 255.0
    let bl = if cb <= 0.5 { 2.0 * cb } else { 1.0 }
    (cb + (bl - cb) * a) * 255.0
  }
  w0_rgb(ch(24), ch(16), ch(8))
}

// The shimmer's sweep at t = 50% (HeroUI `skeleton` keyframes: `translate: -100%` plus `translateX(0 -> 200%)`, so it
// lies exactly over its box): how strong at `u` (0..1 across the box), a linear `transparent -> peak -> transparent`.
fn w0_sweep(u : Double) -> Double {
  let d = if u > 0.5 { u - 0.5 } else { 0.5 - u }
  let g = 1.0 - 2.0 * d
  if g < 0.0 { 0.0 } else { g }
}

// Device-pixel-wide vertical slices across `w` x `h` (scale 2), driven by real animation `phase` in [0, 1):
// HeroUI `skeleton` keyframes translate the shimmer band from -100% (phase=0.0) across 0% (phase=0.5, exact
// midpoint matching Chromium Ref) to +100% (phase=1.0).
fn w0_slices(
  w : Double,
  h : Double,
  x0 : Double,
  sweep_w : Double,
  phase : Double,
  color_at : (Double) -> Int64,
) -> Array[paint::Rect] {
  let step = 0.5
  let shift = 2.0 * phase - 1.0
  let rects : Array[paint::Rect] = []
  let mut x = 0.0
  while x < w {
    let u = (x0 + x + step * 0.5) / sweep_w - shift
    rects.push(paint::rect(x, 0.0, step, h, color=color_at(u)))
    x = x + step
  }
  rects
}

// A HeroUI `.skeleton` (`rounded-xl` here, `bg-surface-tertiary/70` over the surface it lies on), its slices
// driven live by `node.cycle(2000.0)` and clipped to its circular corners.
fn w0_skeleton_box(
  parent : view::View,
  w : Double,
  h : Double,
  rects_by : (view::View) -> Array[paint::Rect],
) -> Unit {
  let _ = parent.box(fn(bar : view::View) -> Unit {
    let _ = bar
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
      .shrink(view::Live::Is(0.0))
      .radius(view::Live::Is(12.0))
      .corner_circular(view::Live::Is(true))
      .clips(view::Live::Is(true))
    let _ = bar.box(fn(fill : view::View) -> Unit {
      let _ = fill
        .width(view::Live::Is(Some(w)))
        .height(view::Live::Is(Some(h)))
        .rects(view::Live::By(fn() -> Array[paint::Rect] { rects_by(fill) }))
    })
  })
}

fn build_skeleton_group(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let th = aura::aura_theme_from(cfg.get())
  let pal = th.palette
  let _ = root.ground(view::Live::Is(pal.background))
  // `.skeleton`'s own fill: surface-tertiary at 70% over the card's surface
  let base = w0_mix(pal.surface, pal.surface_tertiary, 0.7)
  let skel_period_ms = 2000.0

  let _ = w0_abs_box(root, 32.0, 31.3, 736.0, 28.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Wave 0A — Skeleton Single & Synchronized Group (t=50%)"), look=w0_words(18.0, 600, 28.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left card: Single Skeleton (32, 84, 352, 164): label (`text-xs font-medium text-muted`, 16 high), `gap-6`, then a
  // 304 x 48 skeleton with its own time-driven `::after` sweep (`from-transparent via-surface-tertiary to-transparent`).
  let _ = w0_abs_box(root, 32.0, 84.0, 352.0, 164.0, fn(slot : view::View) -> Unit {
    let s = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=24.0, gap=24.0, shadow=true, content=fn(c : view::View) -> Unit {
      let _ = c.box(fn(t : view::View) -> Unit {
        let _ = t.words(view::Live::Is("Single Skeleton"), look=w0_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      w0_skeleton_box(c, 304.0, 48.0, fn(n : view::View) -> Array[paint::Rect] {
        let phase = n.cycle(skel_period_ms)
        w0_slices(304.0, 48.0, 0.0, 304.0, phase, fn(u : Double) -> Int64 {
          w0_mix(base, pal.surface_tertiary, w0_sweep(u))
        })
      })
    })
    let _ = s.width(view::Live::Is(Some(352.0))).height(view::Live::Is(Some(164.0)))
  })

  // Right card: Parent Group Skeleton (416, 84, 352, 164). The children's own sweeps are off; the group's `::before`
  // (`rgba(255,255,255,0.5)` peak, `mix-blend-mode: overlay`) sweeps its whole 304 x 76 box in lockstep via
  // `node.cycle(2000.0)`, over the children and the surface between and beside them alike.
  let _ = w0_abs_box(root, 416.0, 84.0, 352.0, 164.0, fn(slot : view::View) -> Unit {
    let s = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=24.0, gap=24.0, shadow=true, content=fn(c : view::View) -> Unit {
      let _ = c.box(fn(t : view::View) -> Unit {
        let _ = t.words(view::Live::Is("Parent Group Skeleton (2 Children + Gap)"), look=w0_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      let _ = c.box(fn(grp : view::View) -> Unit {
        let _ = grp
          .width(view::Live::Is(Some(304.0)))
          .height(view::Live::Is(Some(76.0)))
          .gap(view::Live::Is(12.0))
          .rects(view::Live::By(fn() -> Array[paint::Rect] {
            let phase = grp.cycle(skel_period_ms)
            w0_slices(304.0, 76.0, 0.0, 304.0, phase, fn(u : Double) -> Int64 {
              w0_overlay_white(pal.surface, 0.5 * w0_sweep(u))
            })
          }))
        let child = fn(u : Double) -> Int64 { w0_overlay_white(base, 0.5 * w0_sweep(u)) }
        w0_skeleton_box(grp, 304.0, 32.0, fn(n : view::View) -> Array[paint::Rect] {
          w0_slices(304.0, 32.0, 0.0, 304.0, n.cycle(skel_period_ms), child)
        })
        w0_skeleton_box(grp, 228.0, 32.0, fn(n : view::View) -> Array[paint::Rect] {
          w0_slices(228.0, 32.0, 0.0, 304.0, n.cycle(skel_period_ms), child)
        })
      })
    })
    let _ = s.width(view::Live::Is(Some(352.0))).height(view::Live::Is(Some(164.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 10: w0-natural-pending-light-2x (800x520)
// Natural intrinsic Button widths (no pinned widths), Primary/Danger pending Spinner contrast,
// independent 24pt CloseButton, and narrow (<768pt) vs desktop (>=768pt) responsive sizing.
// ---------------------------------------------------------------------------
fn build_natural_pending(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light(corner_circular=true))
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background)).pad(view::Live::Is(32.0)).gap(view::Live::Is(20.0))

  let _ = root.box(fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Wave 0 R2 — Natural Width, Pending Spinner, CloseButton & Responsive Sizes"), look=w0_words(18.0, 600, 28.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Row 1: Natural-width buttons at desktop >=768pt (no pinned width!)
  let _ = root.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
    let _ = aura::button_node(row, view::Live::Is("Primary"), variant=aura::AuraButtonVariant::Primary)
    let _ = aura::button_node(row, view::Live::Is("Secondary"), variant=aura::AuraButtonVariant::Secondary)
    let _ = aura::button_node(row, view::Live::Is("Outline"), variant=aura::AuraButtonVariant::Outline)
    let _ = aura::button_node(row, view::Live::Is("Danger"), variant=aura::AuraButtonVariant::Danger)
    let _ = aura::button_node(row, view::Live::Is("Sm"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Sm)
    let _ = aura::button_node(row, view::Live::Is("Lg"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Lg)
  })

  // Row 2: Pending buttons (Primary / Danger / Secondary) showing contrasting Spinner + CloseButton (24pt default)
  let _ = root.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(16.0))
    let _ = aura::button_node(row, view::Live::Is("Saving..."), variant=aura::AuraButtonVariant::Primary, pending=view::Live::Is(true))
    let _ = aura::button_node(row, view::Live::Is("Deleting..."), variant=aura::AuraButtonVariant::Danger, pending=view::Live::Is(true))
    let _ = aura::button_node(row, view::Live::Is("Loading..."), variant=aura::AuraButtonVariant::Secondary, pending=view::Live::Is(true))
    let _ = aura::close_button_node(row)
    let _ = aura::close_button_node(row, force_focus_visible=true)
    let _ = aura::close_button_node(row, force_pressed=true)
  })

  // Row 3: Narrow (<768pt / Touch) responsive sizing (36/40/44pt) via nested AuraConfig
  let narrow_cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(corner_circular=true), density: aura::AuraDensity::Touch })
  let _ = root.box(fn(row : view::View) -> Unit {
    let _ = aura::aura_provide_config(row, narrow_cfg)
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
    let _ = aura::button_node(row, view::Live::Is("Narrow Sm 36"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm)
    let _ = aura::button_node(row, view::Live::Is("Narrow Md 40"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Md)
    let _ = aura::button_node(row, view::Live::Is("Narrow Lg 44"), variant=aura::AuraButtonVariant::Danger, size=aura::AuraButtonSize::Lg)
  })

  // Row 4: Monochrome @gravity-ui/icons (including Calendar, Eye, EyeSlash) on light surface and accent pill
  let _ = root.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(14.0))
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::Calendar, size=22.0, ink=fn() -> Int64 { pal.foreground })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::Eye, size=22.0, ink=fn() -> Int64 { pal.foreground })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::EyeSlash, size=22.0, ink=fn() -> Int64 { pal.foreground })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::Magnifier, size=22.0, ink=fn() -> Int64 { pal.foreground })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::CircleInfo, size=22.0, ink=fn() -> Int64 { pal.accent })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::CircleCheck, size=22.0, ink=fn() -> Int64 { pal.success })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::TriangleExclamation, size=22.0, ink=fn() -> Int64 { pal.warning })
    let _ = aura::aura_icon_node(row, aura::AuraIconKind::CircleExclamation, size=22.0, ink=fn() -> Int64 { pal.danger })
    let _ = row.box(fn(pill : view::View) -> Unit {
      let _ = pill
        .row(view::Live::Is(true))
        .gap(view::Live::Is(8.0))
        .pad_xy(12.0, 8.0)
        .radius(view::Live::Is(12.0))
        .corner_circular(view::Live::Is(true))
        .ground(view::Live::Is(pal.accent))
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::Calendar, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::Eye, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::EyeSlash, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::CircleInfo, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::CircleCheck, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::TriangleExclamation, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
      let _ = aura::aura_icon_node(pill, aura::AuraIconKind::CircleExclamation, size=18.0, ink=fn() -> Int64 { pal.accent_foreground })
    })
  })

  // Row 5: All 4 HeroUI Spinner sizes (Sm=16, Md=24, Lg=32, Xl=40) with 2-path smooth gradient comet
  let _ = root.box(fn(row : view::View) -> Unit {
    let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(20.0))
    let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Sm, color=aura::AuraSpinnerColor::Accent)
    let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Md, color=aura::AuraSpinnerColor::Accent)
    let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Lg, color=aura::AuraSpinnerColor::Success)
    let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Xl, color=aura::AuraSpinnerColor::Danger)
    let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Xl, color=aura::AuraSpinnerColor::Current)
    let _ = row.box(fn(sw : view::View) -> Unit {
      let _ = sw.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0))).ground(view::Live::Is(0xFFFFFFFFL))
      let _ = aura::spinner_node(sw, size=aura::AuraSpinnerSize::Xl, color=aura::AuraSpinnerColor::Current, ink=view::Live::Is(0x00000080L))
    })
  })
}

fn w0_should_run(only : String, name : String) -> Bool {
  only == "" || only == name
}

fn w0_shot_at(
  out_dir : String,
  file_stem : String,
  w : Double,
  h : Double,
  scale : Double,
  at : Double,
  make : (view::View) -> Unit,
) -> Int {
  let path = out_dir + "/" + file_stem + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=scale, at=at)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

fn w0_shot(out_dir : String, only : String, name : String, w : Double, h : Double, scale : Double, make : (view::View) -> Unit) -> Int {
  if !w0_should_run(only, name) {
    return 0
  }
  w0_shot_at(out_dir, name, w, h, scale, 0.0, make)
}

fn w0_shot_animated(
  out_dir : String,
  only : String,
  name : String,
  w : Double,
  h : Double,
  scale : Double,
  make : (view::View) -> Unit,
) -> Int {
  if !w0_should_run(only, name) {
    return 0
  }
  let mut errs = 0
  errs = errs + w0_shot_at(out_dir, name + "-start", w, h, scale, 0.0, make)
  errs = errs + w0_shot_at(out_dir, name, w, h, scale, 1000.0, make)
  errs = errs + w0_shot_at(out_dir, name + "-end", w, h, scale, 1800.0, make)
  errs
}

fn build_spinner_phase(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light(corner_circular=true))
  let _ = aura::aura_provide_config(root, cfg)
  let _ = root
    .row(view::Live::Is(true))
    .width(view::Live::Is(Some(80.0)))
    .height(view::Live::Is(Some(40.0)))
    .ground(view::Live::Is(0xFFFFFFFFL))
  let _ = aura::spinner_node(root, size=aura::AuraSpinnerSize::Xl, color=aura::AuraSpinnerColor::Current, ink=view::Live::Is(0x000000FFL))
  let _ = aura::spinner_node(root, size=aura::AuraSpinnerSize::Xl, color=aura::AuraSpinnerColor::Current, ink=view::Live::Is(0x00000080L))
}

fn w0_shot_spinner_phases(out_dir : String, only : String) -> Int {
  if !w0_should_run(only, "w0-spinner-phases") {
    return 0
  }
  let mut errs = 0
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-0", 80.0, 40.0, 2.0, 0.0, build_spinner_phase)
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-45", 80.0, 40.0, 2.0, 100.0, build_spinner_phase)
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-67p5", 80.0, 40.0, 2.0, 150.0, build_spinner_phase)
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-90", 80.0, 40.0, 2.0, 200.0, build_spinner_phase)
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-135", 80.0, 40.0, 2.0, 300.0, build_spinner_phase)
  errs = errs + w0_shot_at(out_dir, "w0-spinner-phase-180", 80.0, 40.0, 2.0, 400.0, build_spinner_phase)
  errs
}

pub fn main(_world : World) -> Int {
  host::install()
  if ui::env("MBUI_LG_LIST") == "1" {
    film::say("shots presets: w0-card-surface-light-2x w0-card-surface-dark-2x w0-card-surface-light-1x w0-overlay-light-2x w0-overlay-dark-2x w0-states-focus-disabled-light-2x w0-states-focus-disabled-dark-2x w0-skeleton-group-light-2x w0-skeleton-group-dark-2x w0-natural-pending-light-2x w0-spinner-phases 01-buttons-actions-light-2x 01-buttons-actions-dark-2x 01-buttons-actions-light-1x 02-surfaces-cards-typo-light-2x 02-surfaces-cards-typo-dark-2x narrow-320-light-2x bp-748-light-2x bp-788-light-2x 03-forms-inputs-light-2x 03-forms-inputs-dark-2x 04-controls-selection-light-2x 04-controls-selection-dark-2x w1-controls-start-light-2x w1-controls-mid-light-2x w1-controls-end-light-2x rtl-controls-light-2x 05-navigation-collections-light-2x 05-navigation-collections-dark-2x ov-modal-light-2x ov-modal-dark-2x ov-alert-dialog-light-2x ov-alert-dialog-dark-2x ov-drawer-light-2x ov-drawer-dark-2x ov-sheet-light-2x ov-sheet-dark-2x ov-popover-light-2x ov-popover-dark-2x ov-dropdown-light-2x ov-dropdown-dark-2x ov-tooltip-light-2x ov-tooltip-dark-2x 06-feedback-data-media-light-2x 06-feedback-data-media-dark-2x 07-color-family-light-2x 07-color-family-dark-2x 08-datetime-family-light-2x 08-datetime-family-dark-2x ov-select-light-2x ov-select-dark-2x ov-combobox-light-2x ov-combobox-dark-2x ov-autocomplete-light-2x ov-autocomplete-dark-2x ov-color-picker-light-2x ov-color-picker-dark-2x ov-date-picker-light-2x ov-date-picker-dark-2x ov-date-range-picker-light-2x ov-date-range-picker-dark-2x w15-toast-table-light-2x w15-toast-table-dark-2x wave1 wave1a wave1b wave1c wave1d wave15 wave15a wave15b")
    return 0
  }
  // Register `web/inter.woff2` with weight=0 (variable font) so CoreText applies the `'wght'` variation axis on
  // macOS/iOS rather than rendering at Inter Variable's default 100 weight; Linux Pango ignores `weight` and maps it.
  let _ = ui::face_add(hostapi::face_ui, "web/inter.woff2", 0)
  let out_dir_env = ui::env("MBUI_LG_OUT")
  let out_dir = if out_dir_env != "" { out_dir_env } else { "target/aura_shots" }
  let only = ui::env("MBUI_LG_ONLY")
  let mut errs = 0
  errs = errs + w0_shot(out_dir, only, "w0-card-surface-light-2x", 1200.0, 900.0, 2.0, fn(r) { build_card_surface(r, false) })
  errs = errs + w0_shot(out_dir, only, "w0-card-surface-dark-2x", 1200.0, 900.0, 2.0, fn(r) { build_card_surface(r, true) })
  errs = errs + w0_shot(out_dir, only, "w0-card-surface-light-1x", 1200.0, 900.0, 1.0, fn(r) { build_card_surface(r, false) })
  errs = errs + w0_shot(out_dir, only, "w0-overlay-light-2x", 800.0, 600.0, 2.0, fn(r) { build_overlay(r, false) })
  errs = errs + w0_shot(out_dir, only, "w0-overlay-dark-2x", 800.0, 600.0, 2.0, fn(r) { build_overlay(r, true) })
  errs = errs + w0_shot(out_dir, only, "w0-states-focus-disabled-light-2x", 1200.0, 700.0, 2.0, fn(r) { build_states_focus_disabled(r, false) })
  errs = errs + w0_shot(out_dir, only, "w0-states-focus-disabled-dark-2x", 1200.0, 700.0, 2.0, fn(r) { build_states_focus_disabled(r, true) })
  errs = errs + w0_shot_animated(out_dir, only, "w0-skeleton-group-light-2x", 800.0, 400.0, 2.0, fn(r) { build_skeleton_group(r, false) })
  errs = errs + w0_shot_animated(out_dir, only, "w0-skeleton-group-dark-2x", 800.0, 400.0, 2.0, fn(r) { build_skeleton_group(r, true) })
  errs = errs + w0_shot(out_dir, only, "w0-natural-pending-light-2x", 800.0, 560.0, 2.0, fn(r) { build_natural_pending(r) })
  errs = errs + w0_shot_spinner_phases(out_dir, only)
  errs = errs + render_1a_scenes(out_dir, only=only)
  errs = errs + render_1b_scenes(out_dir, only=only)
  errs = errs + render_1c_scenes(out_dir, only=only)
  errs = errs + render_1d_scenes(out_dir, only=only)
  errs = errs + render_15a_scenes(out_dir, only=only)
  errs = errs + render_15b_scenes(out_dir, only=only)
  errs
}
