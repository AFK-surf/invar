// Wave 1 Track 1D offscreen GPU pixel-calibration scenes for `packages/aura`.
// Covers 6 scenes (Light + Dark 2x, 1200x900) aligned to `ref_manifest.json` (54 leaf ROIs,
// excluding the 4 Wave 1.5 compound ROIs: m06-table, m07-colorpicker-trigger, m08-datepicker, m08-daterangepicker).

import "aura"
import "film"
import "signals"
import "ui"
import "view"

fn d1_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn d1_abs(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

// ---------------------------------------------------------------------------
// Scene 06: 06-feedback-data-media-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn d1_build_scene_06(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark() } else { aura::AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // m06-title (24, 24, 1152, 24)
  let _ = d1_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("06 — Feedback, Data Display & Media"), look=d1_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left column: 5 Alerts (x=24, w=566, h=68, y=64, 144, 224, 304, 384)
  let alerts : Array[(Double, aura::AuraAlertStatus, String, String)] = [
    (64.0, aura::AuraAlertStatus::Default, "Default Alert", "Status feedback message for default."),
    (144.0, aura::AuraAlertStatus::Accent, "Accent Alert", "Status feedback message for accent."),
    (224.0, aura::AuraAlertStatus::Success, "Success Alert", "Status feedback message for success."),
    (304.0, aura::AuraAlertStatus::Warning, "Warning Alert", "Status feedback message for warning."),
    (384.0, aura::AuraAlertStatus::Danger, "Danger Alert", "Status feedback message for danger."),
  ]
  for item in alerts {
    let (ay, st, title, desc) = item
    let _ = d1_abs(root, 24.0, ay, 566.0, 68.0, fn(slot : view::View) -> Unit {
      let a = aura::alert_node(
        slot,
        status=st,
        title=view::Live::Is(title),
        description=view::Live::Is(desc),
      )
      let _ = a.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(68.0)))
    })
  }

  // Right top card (610, 64, 566, 200, radius=24, pad=16, shadow=true)
  let _ = d1_abs(root, 610.0, 64.0, 566.0, 200.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=16.0,
      gap=16.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        // Row 1 (y=80, h=40): 4 BadgeAnchors (gap=20) + AvatarGroup
        let _ = c.box(fn(row : view::View) -> Unit {
          let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(20.0))
          let placements : Array[aura::AuraBadgePlacement] = [
            aura::AuraBadgePlacement::TopRight,
            aura::AuraBadgePlacement::TopLeft,
            aura::AuraBadgePlacement::BottomRight,
            aura::AuraBadgePlacement::BottomLeft,
          ]
          for pl in placements {
            let _ = aura::badge_anchor_node(row, content=fn(anc : view::View) -> Unit {
              let _ = aura::avatar_node(anc, fallback=view::Live::Is("JD"))
              let _ = aura::badge_node(
                anc,
                label=view::Live::Is("3"),
                variant=aura::AuraBadgeVariant::Primary,
                color=aura::AuraStatusColor::Accent,
                size=aura::AuraControlSize::Sm,
                placement=pl,
              )
            })
          }
          let _ = aura::avatar_group_node(
            row,
            [
              aura::AuraAvatarItem::new("A1"),
              aura::AuraAvatarItem::new("B2"),
              aura::AuraAvatarItem::new("C3"),
              aura::AuraAvatarItem::new("D4"),
              aura::AuraAvatarItem::new("E5"),
              aura::AuraAvatarItem::new("F6"),
            ],
            max=2,
          )
        })

        // Row 2 (y=136, h=24): 4 Chips (Primary Accent, Secondary Success, Tertiary Warning, Soft Danger)
        let _ = c.box(fn(row : view::View) -> Unit {
          let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(8.0))
          let c1 = aura::chip_node(row, view::Live::Is("Primary"), variant=aura::AuraChipVariant::Primary, color=aura::AuraStatusColor::Accent)
          let _ = c1.width(view::Live::Is(Some(65.0)))
          let c2 = aura::chip_node(row, view::Live::Is("Secondary"), variant=aura::AuraChipVariant::Secondary, color=aura::AuraStatusColor::Success)
          let _ = c2.width(view::Live::Is(Some(82.0)))
          let c3 = aura::chip_node(row, view::Live::Is("Tertiary"), variant=aura::AuraChipVariant::Tertiary, color=aura::AuraStatusColor::Warning)
          let _ = c3.width(view::Live::Is(Some(64.0)))
          let c4 = aura::chip_node(row, view::Live::Is("Soft"), variant=aura::AuraChipVariant::Soft, color=aura::AuraStatusColor::Danger)
          let _ = c4.width(view::Live::Is(Some(44.0)))
        })

        // Row 3 (y=176, h=32): ProgressBar (w=442) + ProgressCircle (28) + Spinner (24)
        let _ = c.box(fn(row : view::View) -> Unit {
          let _ = row
            .row(view::Live::Is(true))
            .fills_across(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(20.0))
          let pb_wrap = row.box(fn(pw : view::View) -> Unit {
            let _ = pw.width(view::Live::Is(Some(442.0))).shrink(view::Live::Is(0.0))
            let _ = aura::progress_bar_node(
              pw,
              fn() -> Option[Double] { Some(68.0) },
              label="Upload",
              color=aura::AuraStatusColor::Accent,
            )
          })
          let _ = pb_wrap
          let _ = aura::progress_circle_node(
            row,
            fn() -> Option[Double] { Some(75.0) },
            size=aura::AuraControlSize::Md,
            color=aura::AuraStatusColor::Accent,
          )
          let _ = aura::spinner_node(row, size=aura::AuraSpinnerSize::Md, color=aura::AuraSpinnerColor::Accent)
        })

        // Row 4 (y=224, h=24): Skeleton (w=534, h=24, radius=4)
        let _ = aura::skeleton_node(c, width=534.0, height=24.0, radius=4.0)
      },
    )
    let _ = card.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(200.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 07: 07-color-family-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn d1_build_scene_07(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark() } else { aura::AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // m07-title (24, 24, 1152, 24)
  let _ = d1_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("07 — Color Family"), look=d1_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  let palette_hex : Array[String] = ["#0485F7", "#17C964", "#F5A524", "#F31260", "#7828C8", "#27272A"]
  let palette_rgba : Array[Int64] = [0x0485F7FFL, 0x17C964FFL, 0xF5A524FFL, 0xF31260FFL, 0x7828C8FFL, 0x27272AFFL]

  let hsb_val = aura::aura_color_hsva(210.0, 0.80, 0.90)
  let rgb_val = aura::aura_color_rgba(180.0 / 255.0, 120.0 / 255.0, 220.0 / 255.0)
  let slider_val = aura::aura_color_hsva(210.0, 0.80, 0.90, alpha=0.75)
  let hex_val = aura::aura_color_rgba(4.0 / 255.0, 133.0 / 255.0, 247.0 / 255.0)

  // Left card: (24, 64, 564, 392, radius=24, pad=20, shadow=true)
  let _ = d1_abs(root, 24.0, 64.0, 564.0, 392.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=20.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        // Row 1: m07-swatches (y=84, h=36, gap=12)
        let _ = c.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
          for col in palette_rgba {
            let _ = aura::color_swatch_node(row, view::Live::Is(col), size=aura::AuraColorSwatchSize::Lg)
          }
        })

        // Row 2: m07-swatch-picker (y=140, h=32, gap=8)
        let _ = aura::color_swatch_picker_node(
          c,
          palette_hex,
          fn() -> Option[String] { Some("#0485F7") },
          fn(_s : String) { () },
          size=aura::AuraColorSwatchSize::Md,
          gap=8.0,
        )

        // Row 3: Two ColorAreas side by side (gap=46 -> x=44 and x=314, label 16pt + gap 4pt -> area y=212)
        let _ = c.box(fn(row : view::View) -> Unit {
          let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(46.0))
          let _ = row.box(fn(col1 : view::View) -> Unit {
            let _ = col1.gap(view::Live::Is(4.0))
            let _ = col1.box(fn(lbl : view::View) -> Unit {
              let _ = lbl
                .words(view::Live::Is("ColorArea (HSB S/B)"), look=d1_words(12.0, 400, 16.0))
                .ink(view::Live::Is(pal.muted))
            })
            let _ = aura::color_area_node(
              col1,
              fn() { hsb_val },
              fn(_m) { () },
              x_channel=aura::aura_ch_saturation(),
              y_channel=aura::aura_ch_brightness(),
              size=224.0,
            )
          })
          let _ = row.box(fn(col2 : view::View) -> Unit {
            let _ = col2.gap(view::Live::Is(4.0))
            let _ = col2.box(fn(lbl : view::View) -> Unit {
              let _ = lbl
                .words(view::Live::Is("ColorArea (RGB R/G)"), look=d1_words(12.0, 400, 16.0))
                .ink(view::Live::Is(pal.muted))
            })
            let _ = aura::color_area_node(
              col2,
              fn() { rgb_val },
              fn(_m) { () },
              x_channel=aura::aura_ch_red(),
              y_channel=aura::aura_ch_green(),
              size=224.0,
            )
          })
        })
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(392.0)))
  })

  // Right card: (612, 64, 564, 392, radius=24, pad=20, gap=20, shadow=true)
  let _ = d1_abs(root, 612.0, 64.0, 564.0, 392.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=20.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        // m07-slider-hue (632, 84, 524, 44)
        let _ = aura::color_slider_node(
          c,
          aura::aura_ch_hue(),
          fn() { slider_val },
          fn(_m) { () },
          label="Hue",
        )
        // m07-slider-alpha (632, 148, 524, 44)
        let _ = aura::color_slider_node(
          c,
          aura::aura_ch_alpha(),
          fn() { slider_val },
          fn(_m) { () },
          label="Alpha",
        )
        // m07-colorfield (632, 212, 524, 60)
        let _ = aura::color_field_node(
          c,
          fn() { hex_val },
          fn(_m) { () },
          label="Hex Color",
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(392.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 08: 08-datetime-family-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn d1_build_scene_08(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark() } else { aura::AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // m08-title (24, 24, 1152, 24)
  let _ = d1_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("08 — Date & Time Family"), look=d1_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  let nov24 = aura::aura_date(2026, 11, 24)
  let nov10 = aura::aura_date(2026, 11, 10)
  let nov18 = aura::aura_date(2026, 11, 18)

  let df_val = aura::aura_segmented_date(2026, 11, 24)
  let tf_val = aura::aura_segmented_time(14, 30)

  // Card 1: m08-calendar (24, 64, 371, 320, pad=16)
  let _ = d1_abs(root, 24.0, 64.0, 371.0, 320.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=16.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        let _ = aura::calendar_node(
          c,
          nov24,
          fn() { Some(nov24) },
          fn(_d) { () },
          today=fn() { Some(nov24) },
          show_year_picker=true,
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(371.0))).height(view::Live::Is(Some(320.0)))
  })

  // Card 2: m08-range-calendar (415, 64, 370, 320, pad=16)
  let _ = d1_abs(root, 415.0, 64.0, 370.0, 320.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=16.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        let _ = aura::range_calendar_node(
          c,
          nov10,
          fn() { Some((nov10, nov18)) },
          fn(_a, _b) { () },
          today=fn() { Some(nov24) },
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(370.0))).height(view::Live::Is(Some(320.0)))
  })

  // Card 3: DateField + TimeField (805, 64, 371, 320, pad=16, gap=16)
  let _ = d1_abs(root, 805.0, 64.0, 371.0, 320.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=16.0,
      gap=16.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        // m08-datefield (821, 80, 339, 60)
        let _ = aura::date_field_node(
          c,
          fn() { df_val },
          fn(_v) { () },
          label="DateField",
        )
        // m08-timefield (821, 156, 339, 60)
        let _ = aura::time_field_node(
          c,
          fn() { tf_val },
          fn(_v) { () },
          label="TimeField",
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(371.0))).height(view::Live::Is(Some(320.0)))
  })
}

fn d1_should_run(only : String, sid : String) -> Bool {
  only == "" || only == "wave1" || only == "wave1d" || only == sid
}

fn d1_shot(out_dir : String, only : String, stem : String, at : Double, make : (view::View) -> Unit) -> Int {
  if !d1_should_run(only, stem) {
    return 0
  }
  let path = out_dir + "/" + stem + ".png"
  let ok = film::picture(make, path=path, w=1200.0, h=900.0, scale=2.0, at=at)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

/// Render Track 1D pixel-calibration scenes (Light + Dark 2x, 1200x900) into `out_dir`,
/// filtered by `only` (`""`, `"wave1"`, `"wave1d"`, or exact scene id), returning error count.
pub fn render_1d_scenes(out_dir : String, only~ : String = "") -> Int {
  let mut errs = 0
  errs = errs + d1_shot(out_dir, only, "06-feedback-data-media-light-2x", 1000.0, fn(r) { d1_build_scene_06(r, false) })
  errs = errs + d1_shot(out_dir, only, "06-feedback-data-media-dark-2x", 1000.0, fn(r) { d1_build_scene_06(r, true) })
  errs = errs + d1_shot(out_dir, only, "07-color-family-light-2x", 0.0, fn(r) { d1_build_scene_07(r, false) })
  errs = errs + d1_shot(out_dir, only, "07-color-family-dark-2x", 0.0, fn(r) { d1_build_scene_07(r, true) })
  errs = errs + d1_shot(out_dir, only, "08-datetime-family-light-2x", 0.0, fn(r) { d1_build_scene_08(r, false) })
  errs = errs + d1_shot(out_dir, only, "08-datetime-family-dark-2x", 0.0, fn(r) { d1_build_scene_08(r, true) })
  errs
}
