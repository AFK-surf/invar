// Aura Wave 1 Track 1C offscreen calibration scenes (16 scenes: 05-navigation-collections + 7 overlays, light & dark 2x).

import "aura"
import "film"
import "headless"
import "paint"
import "signals"
import "ui"
import "view"

fn c_shot_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn c_abs(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

fn c_shot_setup(root : view::View, dark : Bool) -> aura::AuraPalette {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))
  pal
}

// ---------------------------------------------------------------------------
// Scene 1-2: 05-navigation-collections-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn build_05_navigation_collections(root : view::View, dark : Bool) -> Unit {
  let pal = c_shot_setup(root, dark)

  // Title: m05-title at (24, 24, 1152, 24)
  let _ = c_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("05 — Navigation & Collections"), look=c_shot_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left-top card: Tabs (Primary + Separator + Secondary) at (24, 64, 566, 210)
  let _ = c_abs(root, 24.0, 64.0, 566.0, 210.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=16.0, gap=0.0, shadow=true, content=fn(inner : view::View) -> Unit {
      let tab_sel = signals::signal("overview")
      let p_items = [
        aura::AuraTabItem::new("overview", "Overview", fn(pv : view::View) -> Unit {
          let _ = pv.box(fn(tv : view::View) -> Unit {
            let _ = tv
              .words(view::Live::Is("Overview panel content."), look=c_shot_words(14.0, 400, 20.0))
              .ink(view::Live::Is(pal.muted))
          })
        }),
        aura::AuraTabItem::new("analytics", "Analytics", fn(_pv : view::View) -> Unit { () }),
        aura::AuraTabItem::new("settings", "Settings", fn(_pv : view::View) -> Unit { () }),
      ]
      let _ = aura::tabs_node(
        inner,
        p_items,
        fn() -> String { tab_sel.get() },
        fn(k : String) -> Unit { tab_sel.set(k) },
        variant=aura::AuraTabsVariant::Primary,
        panel_gap=12.0,
      )
      let _ = inner.box(fn(sep_wrap : view::View) -> Unit {
        let _ = sep_wrap.fills_across(view::Live::Is(true)).margin(view::Live::Is((0.0, 28.0, 0.0, 28.0)))
        let _ = aura::separator_node(sep_wrap)
      })
      let sec_sel = signals::signal("code")
      let s_items = [
        aura::AuraTabItem::new("code", "Code", fn(_pv : view::View) -> Unit { () }),
        aura::AuraTabItem::new("preview", "Preview", fn(_pv : view::View) -> Unit { () }),
      ]
      let _ = aura::tabs_node(
        inner,
        s_items,
        fn() -> String { sec_sel.get() },
        fn(k : String) -> Unit { sec_sel.set(k) },
        variant=aura::AuraTabsVariant::Secondary,
        show_panels=false,
      )
    })
    let _ = card.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(210.0)))
  })

  // Left-mid card: Accordion Surface at (24, 290, 566, 140)
  let _ = c_abs(root, 24.0, 290.0, 566.0, 140.0, fn(slot : view::View) -> Unit {
    let acc_open = signals::signal("q1")
    let acc_items = [
      aura::AuraAccordionItem::new("q1", "What is Aura?", fn(pv : view::View) -> Unit {
        let _ = pv
          .words(view::Live::Is("OKLCH tokens + headless compound components."), look=c_shot_words(14.0, 400, 20.0))
          .ink(view::Live::Is(pal.muted))
      }),
      aura::AuraAccordionItem::new("q2", "How are tokens defined?", fn(_pv : view::View) -> Unit { () }),
    ]
    let acc = aura::accordion_node(
      slot,
      acc_items,
      fn() -> Array[String] { [acc_open.get()] },
      fn(k : String) -> Unit { acc_open.set(k) },
      variant=aura::AuraAccordionVariant::Surface,
    )
    let _ = acc.width(view::Live::Is(Some(566.0)))
  })

  // Left-bottom: Disclosure at (24, 446, 566, 100)
  let _ = c_abs(root, 24.0, 446.0, 566.0, 100.0, fn(slot : view::View) -> Unit {
    let d_open = signals::signal(true)
    let _ = aura::disclosure_node(
      slot,
      view::Live::Is("Disclosure Item"),
      fn() -> Bool { d_open.get() },
      fn() -> Unit { d_open.set(!d_open.get()) },
      fn(pv : view::View) -> Unit {
        let _ = pv
          .words(view::Live::Is("Expanded disclosure content."), look=c_shot_words(16.0, 400, 24.0))
          .ink(view::Live::Is(pal.foreground))
      },
    )
  })

  // Right-top card: Breadcrumbs + Pagination + TagGroup at (610, 64, 566, 164)
  let _ = c_abs(root, 610.0, 64.0, 566.0, 164.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=16.0, gap=16.0, shadow=true, content=fn(inner : view::View) -> Unit {
      let bc_items = [
        aura::AuraBreadcrumbItem::new("Home"),
        aura::AuraBreadcrumbItem::new("Packages"),
        aura::AuraBreadcrumbItem::new("Aura"),
      ]
      let _ = aura::breadcrumbs_node(inner, bc_items)

      let cur_page = signals::signal(2)
      let _ = aura::pagination_node(
        inner,
        fn() -> Int { 9 },
        fn() -> Int { cur_page.get() },
        fn(p : Int) -> Unit { cur_page.set(p) },
      )

      let tag_sel = signals::signal("pion")
      let _ = aura::tag_group_node(
        inner,
        fn(lv : view::View, tg : headless::TagGroup[String]) -> Unit {
          let _ = aura::tag_node(lv, tg, "pion", "Pion")
          let _ = aura::tag_node(lv, tg, "invar", "Invar")
          let _ = aura::tag_node(lv, tg, "aura", "Aura")
        },
        label="Tags",
        is_selected=fn(k : String) -> Bool { tag_sel.get() == k },
        on_select=fn(k : String) -> Unit { tag_sel.set(k) },
      )
    })
    let _ = card.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(164.0)))
  })

  // Right-mid card: ListBox inside Surface(p-4) at (610, 244, 566, 138) using public aura::listbox_node
  let _ = c_abs(root, 610.0, 244.0, 566.0, 138.0, fn(slot : view::View) -> Unit {
    let lb_sel = signals::signal("build")
    let card = aura::surface_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, shadow=true, content=fn(inner : view::View) -> Unit {
      let _ = inner.padding(view::Live::Is((16.0, 16.0, 16.0, 14.0)))
      let lb = aura::listbox_node(
        inner,
        fn(k : String) -> Bool { lb_sel.get() == k },
        fn(k : String) -> Unit { lb_sel.set(k) },
        fn(lb_v : view::View, lb : headless::Listbox[String]) -> Unit {
          let _ = aura::listbox_section_node(lb_v, lb, "Commands", fn(sv : view::View) -> Unit {
            let _ = aura::listbox_item_node(sv, lb, "build", "Build")
            let _ = aura::listbox_item_node(sv, lb, "test", "Test")
          })
        },
        label="Commands",
        in_overlay=false,
      )
      let _ = lb.fills_across(view::Live::Is(true)).shadows(view::Live::Is([]))
    })
    let _ = card.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(138.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 3-4: ov-modal-{light,dark}-2x (800x600)
// ---------------------------------------------------------------------------
fn build_ov_modal(root : view::View, dark : Bool) -> Unit {
  let pal = c_shot_setup(root, dark)
  let open = signals::signal(true)
  let _ = aura::modal_node(
    root,
    fn() -> Bool { open.get() },
    fn() -> Unit { open.set(false) },
    heading="Welcome to Aura",
    width=380.0,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(
          view::Live::Is("A cross-platform GPU UI component library for Invar."),
          look=c_shot_words(14.0, 400, 20.0, wrap=true),
        )
        .ink(view::Live::Is(pal.muted))
    },
    footer=fn(fv : view::View) -> Unit {
      let c_btn = aura::button_node(fv, view::Live::Is("Cancel"), variant=aura::AuraButtonVariant::Tertiary)
      let _ = c_btn.width(view::Live::Is(Some(78.0)))
      let ok_btn = aura::button_node(fv, view::Live::Is("Continue"), variant=aura::AuraButtonVariant::Primary)
      let _ = ok_btn.width(view::Live::Is(Some(93.0)))
    },
  )
}

// ---------------------------------------------------------------------------
// Scene 5-6: ov-alert-dialog-{light,dark}-2x (800x600)
// ---------------------------------------------------------------------------
fn build_ov_alert_dialog(root : view::View, dark : Bool) -> Unit {
  let _ = c_shot_setup(root, dark)
  let open = signals::signal(true)
  let _ = aura::alert_dialog_node(
    root,
    fn() -> Bool { open.get() },
    fn() -> Unit { open.set(false) },
    "Delete project permanently?",
    "This action cannot be undone. All artifacts and history will be removed.",
    icon_variant=aura::AuraAlertIconVariant::Danger,
    width=380.0,
    footer=fn(fv : view::View) -> Unit {
      let c_btn = aura::button_node(fv, view::Live::Is("Cancel"), variant=aura::AuraButtonVariant::Tertiary)
      let _ = c_btn.width(view::Live::Is(Some(78.0)))
      let d_btn = aura::button_node(fv, view::Live::Is("Delete"), variant=aura::AuraButtonVariant::Danger)
      let _ = d_btn.width(view::Live::Is(Some(75.0)))
    },
  )
}

// ---------------------------------------------------------------------------
// Scene 7-8: ov-drawer-{light,dark}-2x (800x600)
// ---------------------------------------------------------------------------
fn build_ov_drawer(root : view::View, dark : Bool) -> Unit {
  let pal = c_shot_setup(root, dark)
  // Background trigger button centered behind scrim
  let _ = c_abs(root, 0.0, 282.0, 800.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = aura::button_node(slot, view::Live::Is("Open Drawer"), variant=aura::AuraButtonVariant::Secondary)
  })
  let open = signals::signal(true)
  let _ = aura::drawer_node(
    root,
    fn() -> Bool { open.get() },
    fn() -> Unit { open.set(false) },
    heading="Drawer Panel",
    placement=aura::AuraDrawerPlacement::Right,
    panel_width=384.0,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(view::Live::Is("Slide-over drawer panel anchored to the right edge."), look=c_shot_words(14.0, 400, 20.0, wrap=true))
        .ink(view::Live::Is(pal.muted))
    },
    footer=fn(fv : view::View) -> Unit {
      let c_btn = aura::button_node(fv, view::Live::Is("Close"), variant=aura::AuraButtonVariant::Secondary)
      let _ = c_btn.width(view::Live::Is(Some(70.0)))
      let s_btn = aura::button_node(fv, view::Live::Is("Save"), variant=aura::AuraButtonVariant::Primary)
      let _ = s_btn.width(view::Live::Is(Some(65.0)))
    },
  )
}

// ---------------------------------------------------------------------------
// Scene 9-10: ov-sheet-{light,dark}-2x (800x600)
// ---------------------------------------------------------------------------
fn build_ov_sheet(root : view::View, dark : Bool) -> Unit {
  let pal = c_shot_setup(root, dark)
  let _ = c_abs(root, 0.0, 282.0, 800.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = aura::button_node(slot, view::Live::Is("Open Sheet"), variant=aura::AuraButtonVariant::Secondary)
  })
  let open = signals::signal(true)
  let _ = aura::sheet_node(
    root,
    fn() -> Bool { open.get() },
    fn() -> Unit { open.set(false) },
    heading="Bottom Sheet",
    placement=aura::AuraDrawerPlacement::Bottom,
    show_handle=true,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(view::Live::Is("Interactive sheet overlay with drag handle."), look=c_shot_words(14.0, 400, 20.0, wrap=true))
        .ink(view::Live::Is(pal.muted))
    },
    footer=fn(fv : view::View) -> Unit {
      let b = aura::button_node(fv, view::Live::Is("Done"), variant=aura::AuraButtonVariant::Primary, full_width=true)
      let _ = b.grow(view::Live::Is(1.0))
    },
  )
}

// ---------------------------------------------------------------------------
// Scene 11-12: ov-popover-{light,dark}-2x (800x600) — real public aura::popover_node
// ---------------------------------------------------------------------------
fn build_ov_popover(root : view::View, dark : Bool) -> Unit {
  let pal = c_shot_setup(root, dark)
  let open = signals::signal(true)
  let _ = c_abs(root, 0.0, 80.0, 800.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = aura::popover_node(
      slot,
      "Show Popover",
      fn() -> Bool { open.get() },
      fn(b : Bool) -> Unit { open.set(b) },
      fn(panel : view::View) -> Unit {
        let _ = panel.box(fn(bv : view::View) -> Unit {
          let _ = bv
            .words(view::Live::Is("Set the dimensions for the layer."), look=c_shot_words(14.0, 400, 20.0))
            .ink(view::Live::Is(pal.muted))
        })
      },
      heading="Dimensions",
      trigger_variant=aura::AuraButtonVariant::Secondary,
      placement=headless::Placement::BelowCenter,
      gap=8.0,
      width=280.0,
      show_arrow=true,
    )
  })
}

// ---------------------------------------------------------------------------
// Scene 13-14: ov-dropdown-{light,dark}-2x (800x600) — real public aura::dropdown_node
// ---------------------------------------------------------------------------
fn build_ov_dropdown(root : view::View, dark : Bool) -> Unit {
  let _ = c_shot_setup(root, dark)
  let open = signals::signal(true)
  let _ = c_abs(root, 358.75, 64.0, 440.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true))
    let _ = aura::dropdown_node(
      slot,
      "Actions",
      fn() -> Bool { open.get() },
      fn(b : Bool) -> Unit { open.set(b) },
      fn(mv : view::View, menu : headless::Menu) -> Unit {
        let _ = aura::menu_item_node(mv, menu, "New File")
        let _ = aura::menu_item_node(mv, menu, "Copy Link")
        let _ = aura::menu_item_node(mv, menu, "Edit File")
        let _ = aura::menu_item_node(mv, menu, "Delete", variant=aura::AuraItemVariant::Danger)
      },
      trigger_variant=aura::AuraButtonVariant::Secondary,
      placement=headless::Placement::BelowStart,
      gap=7.0,
      min_width=220.0,
    )
  })
}

// ---------------------------------------------------------------------------
// Scene 15-16: ov-tooltip-{light,dark}-2x (800x600) — real public aura::tooltip_node
// ---------------------------------------------------------------------------
fn build_ov_tooltip(root : view::View, dark : Bool) -> Unit {
  let _ = c_shot_setup(root, dark)
  let _ = c_abs(root, 0.0, 282.0, 800.0, 36.0, fn(slot : view::View) -> Unit {
    let _ = slot.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = aura::tooltip_node(
      slot,
      view::Live::Is("Tooltip preview text"),
      fn(h : view::View) -> view::View {
        aura::button_node(h, view::Live::Is("Hover Target"), variant=aura::AuraButtonVariant::Secondary)
      },
      placement=headless::Placement::AboveCenter,
      gap=3.0,
      show_arrow=true,
      force_open=true,
    )
  })
}

fn c_run_shot(out_dir : String, only : String, name : String, w : Double, h : Double, make : (view::View) -> Unit) -> Int {
  if !(only == "" || only == "wave1" || only == "wave1c" || only == name) {
    return 0
  }
  let path = out_dir + "/" + name + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=2.0, at=0.0)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

/// Render all 16 Track 1C calibration scenes (light & dark 2x) into `out_dir`.
/// Returns the number of failed renders.
pub fn render_1c_scenes(out_dir : String, only~ : String = "") -> Int {
  let filter = if only != "" { only } else { ui::env("MBUI_LG_ONLY") }
  let mut errs = 0
  errs = errs + c_run_shot(out_dir, filter, "05-navigation-collections-light-2x", 1200.0, 900.0, fn(r) { build_05_navigation_collections(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "05-navigation-collections-dark-2x", 1200.0, 900.0, fn(r) { build_05_navigation_collections(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-modal-light-2x", 800.0, 600.0, fn(r) { build_ov_modal(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-modal-dark-2x", 800.0, 600.0, fn(r) { build_ov_modal(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-alert-dialog-light-2x", 800.0, 600.0, fn(r) { build_ov_alert_dialog(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-alert-dialog-dark-2x", 800.0, 600.0, fn(r) { build_ov_alert_dialog(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-drawer-light-2x", 800.0, 600.0, fn(r) { build_ov_drawer(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-drawer-dark-2x", 800.0, 600.0, fn(r) { build_ov_drawer(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-sheet-light-2x", 800.0, 600.0, fn(r) { build_ov_sheet(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-sheet-dark-2x", 800.0, 600.0, fn(r) { build_ov_sheet(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-popover-light-2x", 800.0, 600.0, fn(r) { build_ov_popover(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-popover-dark-2x", 800.0, 600.0, fn(r) { build_ov_popover(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-dropdown-light-2x", 800.0, 600.0, fn(r) { build_ov_dropdown(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-dropdown-dark-2x", 800.0, 600.0, fn(r) { build_ov_dropdown(r, true) })
  errs = errs + c_run_shot(out_dir, filter, "ov-tooltip-light-2x", 800.0, 600.0, fn(r) { build_ov_tooltip(r, false) })
  errs = errs + c_run_shot(out_dir, filter, "ov-tooltip-dark-2x", 800.0, 600.0, fn(r) { build_ov_tooltip(r, true) })
  errs
}
