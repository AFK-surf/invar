// Wave 1 Track 1B offscreen GPU calibration scenes for `packages/aura`.
// Renders the 4 Track 1B scenes (Light + Dark 2x, 1200x900):
//   - 03-forms-inputs-light-2x
//   - 03-forms-inputs-dark-2x
//   - 04-controls-selection-light-2x
//   - 04-controls-selection-dark-2x

import "aura"
import "film"
import "signals"
import "ui"
import "view"

fn b_shot_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn b_shot_abs(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

fn b_shot_at(
  out_dir : String,
  file_stem : String,
  w : Double,
  h : Double,
  scale : Double,
  make : (view::View) -> Unit,
  script~ : String = "",
  at~ : Double = 0.0,
) -> Int {
  let path = out_dir + "/" + file_stem + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=scale, at=at, script=script)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

// ---------------------------------------------------------------------------
// Scene 03: 03-forms-inputs-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn b_build_forms_inputs(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Scene title (16pt / 24pt line height matching ref m03-title ROI y=24 h=24)
  let _ = b_shot_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("03 \u{2014} Forms & Inputs"), look=b_shot_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left column (x=24, w=564)
  // 1. Email (Primary)
  let _ = b_shot_abs(root, 24.0, 64.0, 564.0, 84.0, fn(slot : view::View) -> Unit {
    let _ = aura::text_field_node(
      slot,
      label=view::Live::Is("Email (Primary)"),
      value="alex@invar.dev",
      description=view::Live::Is("We will never share your email."),
      variant=aura::AuraFieldVariant::Primary,
    )
  })

  // 2. Organization (Secondary)
  let _ = b_shot_abs(root, 24.0, 160.0, 564.0, 64.0, fn(slot : view::View) -> Unit {
    let _ = aura::text_field_node(
      slot,
      label=view::Live::Is("Organization (Secondary)"),
      value="AFK-surf",
      variant=aura::AuraFieldVariant::Secondary,
    )
  })

  // 3. Username (Invalid)
  let _ = b_shot_abs(root, 24.0, 236.0, 564.0, 84.0, fn(slot : view::View) -> Unit {
    let _ = aura::text_field_node(
      slot,
      label=view::Live::Is("Username (Invalid)"),
      value="x",
      invalid=view::Live::Is(true),
      error=view::Live::Is("Must be at least 3 characters."),
      variant=aura::AuraFieldVariant::Primary,
    )
  })

  // 4. Bio (TextArea)
  let _ = b_shot_abs(root, 24.0, 332.0, 564.0, 84.0, fn(slot : view::View) -> Unit {
    let _ = aura::text_field_node(
      slot,
      label=view::Live::Is("Bio"),
      value="Cross-platform GPU UI framework.",
      multiline=true,
      rows=2,
      variant=aura::AuraFieldVariant::Primary,
    )
  })

  // 5. Website (InputGroup)
  let _ = b_shot_abs(root, 24.0, 428.0, 564.0, 64.0, fn(slot : view::View) -> Unit {
    let _ = slot.gap(view::Live::Is(4.0))
    let _ = aura::label_node(slot, view::Live::Is("Website (InputGroup)"))
    let _ = aura::input_group_node(
      slot,
      variant=aura::AuraFieldVariant::Primary,
      content=fn(grp : view::View) -> Unit {
        let _ = aura::input_group_prefix_node(grp, text=view::Live::Is("https://"))
        let _ = aura::input_group_input_node(grp, value="invar.dev", has_prefix=true, has_suffix=true)
        let _ = aura::input_group_suffix_node(grp, text=view::Live::Is(".dev"))
      },
    )
  })

  // Right column (x=612, w=564)
  // 6. Search (SearchField)
  let _ = b_shot_abs(root, 612.0, 64.0, 564.0, 64.0, fn(slot : view::View) -> Unit {
    let _ = aura::search_field_node(
      slot,
      label=view::Live::Is("Search"),
      value="button",
      variant=aura::AuraFieldVariant::Primary,
    )
  })

  // 7. Quantity (NumberField)
  let qty = signals::signal(42.0)
  let _ = b_shot_abs(root, 612.0, 140.0, 564.0, 64.0, fn(slot : view::View) -> Unit {
    let _ = aura::number_field_node(
      slot,
      view::Live::By(fn() -> Double { qty.get() }),
      fn(v : Double) -> Unit { qty.set(v) },
      label=view::Live::Is("Quantity"),
      min=0.0,
      max=999.0,
      step=1.0,
      variant=aura::AuraFieldVariant::Primary,
    )
  })

  // 8. Verification Code (InputOTP)
  let _ = b_shot_abs(root, 612.0, 216.0, 564.0, 72.0, fn(slot : view::View) -> Unit {
    let _ = slot.gap(view::Live::Is(8.0))
    let _ = aura::label_node(slot, view::Live::Is("Verification Code (InputOTP)"))
    let _ = aura::input_otp_node(
      slot,
      max_length=6,
      value="4821",
      content=fn(otp_v : view::View, _ctrl) -> Unit {
        let _ = aura::input_otp_group_node(otp_v, content=fn(g : view::View) -> Unit {
          let _ = aura::input_otp_slot_node(g, 0)
          let _ = aura::input_otp_slot_node(g, 1)
          let _ = aura::input_otp_slot_node(g, 2)
        })
        let _ = aura::input_otp_separator_node(otp_v)
        let _ = aura::input_otp_group_node(otp_v, content=fn(g : view::View) -> Unit {
          let _ = aura::input_otp_slot_node(g, 3)
          let _ = aura::input_otp_slot_node(g, 4)
          let _ = aura::input_otp_slot_node(g, 5)
        })
      },
    )
  })

  // 9. Fieldset + Form inside Surface card (x=612, y=300, w=564, h=188)
  let _ = b_shot_abs(root, 612.0, 300.0, 564.0, 188.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=16.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        let _ = aura::form_node(
          inner,
          label=view::Live::Is("Shipping form"),
          gap=20.0,
          content=fn(fv : view::View, _f) -> Unit {
            let _ = aura::fieldset_node(
              fv,
              label=view::Live::Is("Shipping"),
              gap=0.0,
              content=fn(fsv : view::View, _fs) -> Unit {
                let _ = aura::fieldset_legend_node(fsv, view::Live::Is("Shipping"))
                let _ = aura::fieldset_group_node(fsv, gap=12.0, content=fn(fg : view::View) -> Unit {
                  let street = aura::input_node(
                    fg,
                    placeholder=view::Live::Is("Street address"),
                    full_width=false,
                    variant=aura::AuraFieldVariant::Primary,
                  )
                  let _ = street.width(view::Live::Is(Some(243.0)))
                })
                let _ = aura::fieldset_actions_node(fsv, content=fn(act : view::View) -> Unit {
                  let _ = act.margin(view::Live::Is((0.0, 24.0, 0.0, 0.0)))
                  let btn = aura::button_node(
                    act,
                    view::Live::Is("Save"),
                    variant=aura::AuraButtonVariant::Primary,
                    size=aura::AuraButtonSize::Sm,
                  )
                  let _ = btn.width(view::Live::Is(Some(57.0)))
                })
              },
            )
            let _ = fv.box(fn(em : view::View) -> Unit {
              let _ = aura::error_message_node(em, view::Live::Is("Standalone ErrorMessage example"))
            })
          },
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(188.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 04: 04-controls-selection-{light,dark}-2x (1200x900)
// ---------------------------------------------------------------------------
fn b_build_controls_selection(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark(corner_circular=true) } else { aura::AuraConfig::light(corner_circular=true) })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Scene title (16pt / 24pt line height matching ref m04-title ROI y=24 h=24)
  let _ = b_shot_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("04 \u{2014} Controls & Selection"), look=b_shot_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left Card: Checkboxes + Separator + RadioGroup (x=24, y=64, w=564, h=489)
  let _ = b_shot_abs(root, 24.0, 64.0, 564.0, 489.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=20.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        // CheckboxGroup (header y=84..104, first cb at y=120 -> -8pt margin against gap=24; stride=64pt exact)
        let _ = aura::checkbox_group_node(
          inner,
          label=view::Live::Is("Checkboxes"),
          gap=24.0,
          content=fn(cg : view::View) -> Unit {
            let cb1 = aura::checkbox_node(cg, label=view::Live::Is("Unchecked"), checked=view::Live::Is(false), stacked=true)
            let _ = cb1.margin(view::Live::Is((0.0, -8.0, 0.0, 0.0)))
            let _ = aura::checkbox_node(cg, label=view::Live::Is("Checked"), checked=view::Live::Is(true), stacked=true)
            let _ = aura::checkbox_node(cg, label=view::Live::Is("Indeterminate"), indeterminate=view::Live::Is(true), stacked=true)
            let _ = aura::checkbox_node(cg, label=view::Live::Is("Disabled"), disabled=view::Live::Is(true), stacked=true)
          },
        )
        let _ = aura::separator_node(inner)
        // RadioGroup (header y=393..413, first radio at y=429 -> -8pt margin against gap=24; stride=64pt exact)
        let plan = signals::signal("pro")
        let _ = aura::radio_group_node(
          inner,
          view::Live::By(fn() -> String { plan.get() }),
          fn(v : String) -> Unit { plan.set(v) },
          label=view::Live::Is("Plan"),
          gap=16.0,
          content=fn(rg : view::View) -> Unit {
            let _ = rg.gap(view::Live::Is(24.0))
            let _ = aura::radio_node(rg, "free", label=view::Live::Is("Free"), stacked=true)
            let _ = aura::radio_node(rg, "pro", label=view::Live::Is("Pro"), stacked=true)
          },
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(489.0)))
  })

  // Right Card: SwitchGroup + Separator + Sliders + Separator + Meters (x=612, y=64, w=564, h=489)
  let _ = b_shot_abs(root, 612.0, 64.0, 564.0, 489.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=24.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        // SwitchGroup
        let _ = aura::switch_group_node(
          inner,
          label=view::Live::Is("Switches (sm / md / lg)"),
          orientation=aura::AuraOrientation::Horizontal,
          gap=16.0,
          item_gap=19.0,
          content=fn(sg : view::View) -> Unit {
            let _ = aura::switch_node(sg, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("SM On"), size=aura::AuraSwitchSize::Sm, stacked=true)
            let _ = aura::switch_node(sg, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("MD On"), size=aura::AuraSwitchSize::Md, stacked=true)
            let _ = aura::switch_node(sg, view::Live::Is(false), fn(_) { () }, label=view::Live::Is("MD Off"), size=aura::AuraSwitchSize::Md, stacked=true)
            let _ = aura::switch_node(sg, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("LG On"), size=aura::AuraSwitchSize::Lg, stacked=true)
          },
        )
        let _ = aura::separator_node(inner)
        // Sliders
        let vol = signals::signal(65.0)
        let lo = signals::signal(25.0)
        let hi = signals::signal(75.0)
        let _ = inner.box(fn(sbox : view::View) -> Unit {
          let _ = sbox.fills_across(view::Live::Is(true)).gap(view::Live::Is(16.0))
          let _ = aura::slider_node(
            sbox,
            view::Live::By(fn() -> Double { vol.get() }),
            fn(v : Double) -> Unit { vol.set(v) },
            label=view::Live::Is("Volume"),
            min=0.0,
            max=100.0,
            step=1.0,
          )
          let _ = aura::range_slider_node(
            sbox,
            view::Live::By(fn() -> Double { lo.get() }),
            view::Live::By(fn() -> Double { hi.get() }),
            fn(a : Double, b : Double) -> Unit { lo.set(a); hi.set(b) },
            label=view::Live::Is("Price Range"),
            min=0.0,
            max=100.0,
            step=1.0,
          )
        })
        let _ = aura::separator_node(inner)
        // Meters
        let _ = inner.box(fn(mbox : view::View) -> Unit {
          let _ = mbox.fills_across(view::Live::Is(true)).gap(view::Live::Is(12.0))
          let _ = aura::meter_node(
            mbox,
            view::Live::Is(72.0),
            label=view::Live::Is("Storage Used"),
            color=aura::AuraMeterColor::Accent,
          )
          let _ = aura::meter_node(
            mbox,
            view::Live::Is(90.0),
            label=view::Live::Is("Quota Alert"),
            color=aura::AuraMeterColor::Danger,
          )
        })
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(489.0)))
  })
}

// ---------------------------------------------------------------------------
// Real interactive midpoint sequence (same component, same layout, real click + controlled clock):
//   - w1-controls-start-light-2x (440x240 @ 2x, initial state at t=0)
//   - w1-controls-mid-light-2x   (440x240 @ 2x, after clicking Switch + 48ms spring travel)
//   - w1-controls-end-light-2x   (440x240 @ 2x, after clicking Switch + 600ms settled)
// ---------------------------------------------------------------------------
fn b_build_controls_interactive(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light(corner_circular=true))
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  let on = signals::signal(false)
  let vol = signals::signal(35.0)

  let _ = b_shot_abs(root, 24.0, 20.0, 392.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Interactive Controls Motion Sequence"), look=b_shot_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  let _ = b_shot_abs(root, 24.0, 56.0, 392.0, 160.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=20.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        let _ = aura::switch_node(
          inner,
          view::Live::By(fn() -> Bool { on.get() }),
          fn(b : Bool) -> Unit { on.set(b) },
          label=view::Live::Is("Notifications"),
          size=aura::AuraSwitchSize::Md,
          stacked=true,
        )
        let _ = aura::slider_node(
          inner,
          view::Live::By(fn() -> Double { vol.get() }),
          fn(v : Double) -> Unit { vol.set(v) },
          label=view::Live::Is("Volume"),
          min=0.0,
          max=100.0,
          step=1.0,
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(392.0))).height(view::Live::Is(Some(160.0)))
  })
}

// ---------------------------------------------------------------------------
// RTL Controls & Directionality scene: rtl-controls-light-2x (1200x600 @ 2x)
// Mirrors the 9 Wave 1 components via AuraConfig(rtl=true).
// ---------------------------------------------------------------------------
fn b_build_rtl_controls(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(corner_circular=true), rtl: true })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Top-right RTL title (compensate 1.5pt Invar words right-side measure cushion)
  let _ = b_shot_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v.lines_up(view::Live::Is(Some(view::Along::End)))
    let _ = v.box(fn(tv : view::View) -> Unit {
      let _ = tv
        .margin(view::Live::Is((0.0, 0.0, -1.5, 0.0)))
        .words(view::Live::Is("RTL Controls & Directionality"), look=b_shot_words(16.0, 600, 24.0))
        .ink(view::Live::Is(pal.foreground))
    })
  })

  // Left card (24, 64, 564x320): Tabs, Slider, ProgressBar, Skeleton, Alert
  let _ = b_shot_abs(root, 24.0, 64.0, 564.0, 320.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=16.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        let tab_sel = signals::signal("overview")
        let _ = aura::tabs_node(
          inner,
          [
            aura::AuraTabItem::{ key: "overview", label: "Overview", disabled: false, panel: fn(_) { () } },
            aura::AuraTabItem::{ key: "details", label: "Details", disabled: false, panel: fn(_) { () } },
          ],
          fn() -> String { tab_sel.get() },
          fn(k : String) -> Unit { tab_sel.set(k) },
          show_panels=false,
        )
        let _ = aura::slider_node(
          inner,
          view::Live::Is(65.0),
          fn(_) { () },
          label=view::Live::Is("Volume"),
          min=0.0,
          max=100.0,
          step=1.0,
        )
        let _ = aura::progress_bar_node(
          inner,
          fn() -> Option[Double] { Some(60.0) },
          label="Progress",
        )
        let _ = aura::skeleton_node(
          inner,
          width=524.0,
          height=32.0,
          radius=8.0,
        )
        let _ = aura::alert_node(
          inner,
          status=aura::AuraAlertStatus::Accent,
          title=view::Live::Is("RTL Alert"),
          description=view::Live::Is("Logical start/end alignment check."),
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(320.0)))
  })

  // Right card (612, 64, 564x320): Breadcrumbs, ButtonGroup, InputGroup, Switch
  let _ = b_shot_abs(root, 612.0, 64.0, 564.0, 320.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      gap=16.0,
      shadow=true,
      content=fn(inner : view::View) -> Unit {
        let _ = inner.lines_up(view::Live::Is(Some(view::Along::End)))
        let _ = aura::breadcrumbs_node(
          inner,
          [
            aura::AuraBreadcrumbItem::{ label: "Home", disabled: false, on_press: fn() { () } },
            aura::AuraBreadcrumbItem::{ label: "Library", disabled: false, on_press: fn() { () } },
            aura::AuraBreadcrumbItem::{ label: "Aura", disabled: false, on_press: fn() { () } },
          ],
        )
        let _ = inner.box(fn(bg_row : view::View) -> Unit {
          let _ = bg_row
            .row(view::Live::Is(true))
            .fills_across(view::Live::Is(true))
            .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = aura::button_group_node(
            bg_row,
            variant=aura::AuraButtonVariant::Secondary,
            hide_separator=true,
            content=fn(g : view::View) -> Unit {
              let _ = aura::button_group_item_node(g, view::Live::Is("First"), 0, 3)
              let _ = aura::button_group_item_node(g, view::Live::Is("Middle"), 1, 3)
              let _ = aura::button_group_item_node(g, view::Live::Is("Last"), 2, 3)
            },
          )
        })
        let _ = aura::input_group_node(
          inner,
          full_width=true,
          content=fn(ig : view::View) -> Unit {
            let _ = aura::input_group_prefix_node(ig, text=view::Live::Is("https://"))
            let _ = aura::input_group_input_node(ig, value="invar.dev", has_prefix=true, has_suffix=true)
            let _ = aura::input_group_suffix_node(ig, text=view::Live::Is(".org"))
          },
        )
        let _ = aura::switch_node(
          inner,
          view::Live::Is(true),
          fn(_) { () },
          label=view::Live::Is("RTL Switch"),
          stacked=true,
        )
      },
    )
    let _ = card.width(view::Live::Is(Some(564.0))).height(view::Live::Is(Some(320.0)))
  })
}

/// Render Wave 1 Track 1B offscreen calibration scenes into `out_dir`, returning error count.
pub fn render_1b_scenes(out_dir : String, only~ : String = "") -> Int {
  let mut errs = 0
  let run = fn(sid : String, w : Double, h : Double, scale : Double, make : (view::View) -> Unit) -> Unit {
    if only == "" || only == "wave1" || only == "wave1b" || only == sid {
      errs = errs + b_shot_at(out_dir, sid, w, h, scale, make)
    }
  }
  let run_s = fn(sid : String, w : Double, h : Double, scale : Double, make : (view::View) -> Unit, script : String, at : Double) -> Unit {
    if only == "" || only == "wave1" || only == "wave1b" || only == sid {
      errs = errs + b_shot_at(out_dir, sid, w, h, scale, make, script=script, at=at)
    }
  }
  run("03-forms-inputs-light-2x", 1200.0, 900.0, 2.0, fn(r) { b_build_forms_inputs(r, false) })
  run("03-forms-inputs-dark-2x", 1200.0, 900.0, 2.0, fn(r) { b_build_forms_inputs(r, true) })
  run("04-controls-selection-light-2x", 1200.0, 900.0, 2.0, fn(r) { b_build_controls_selection(r, false) })
  run("04-controls-selection-dark-2x", 1200.0, 900.0, 2.0, fn(r) { b_build_controls_selection(r, true) })
  run_s("w1-controls-start-light-2x", 440.0, 240.0, 2.0, fn(r) { b_build_controls_interactive(r) }, "", 0.0)
  run_s("w1-controls-mid-light-2x", 440.0, 240.0, 2.0, fn(r) { b_build_controls_interactive(r) }, "press Notifications\nwait 48", 0.0)
  run_s("w1-controls-end-light-2x", 440.0, 240.0, 2.0, fn(r) { b_build_controls_interactive(r) }, "press Notifications\nwait 600", 0.0)
  run_s("rtl-controls-light-2x", 1200.0, 600.0, 2.0, fn(r) { b_build_rtl_controls(r) }, "", 1000.0)
  errs
}
