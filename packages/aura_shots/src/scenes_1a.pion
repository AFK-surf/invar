// Wave 1 Track 1A offscreen GPU calibration scenes for `packages/aura`.
// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0):
//   - 01-buttons-actions-{light,dark}-2x (1200x900 dpr=2)
//   - 02-surfaces-cards-typo-{light,dark}-2x (1200x900 dpr=2)

import "aura"
import "film"
import "signals"
import "ui"
import "view"

fn a_s_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn a_s_abs(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

// ---------------------------------------------------------------------------
// Scene 01: 01-buttons-actions-{light,dark}-2x (1200x900, dpr=2)
// ---------------------------------------------------------------------------
fn a_build_01_buttons_actions(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark() } else { aura::AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Title (x=24, y=24, w=1152, h=24)
  let _ = a_s_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("01 — Buttons & Actions"), look=a_s_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Card 1: Button Variants (x=24, y=64, w=1152, h=116)
  let _ = a_s_abs(root, 24.0, 64.0, 1152.0, 116.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = a_s_abs(card, 20.0, 20.0, 200.0, 16.0, fn(h : view::View) -> Unit {
        let _ = h.words(view::Live::Is("Button Variants"), look=a_s_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      let row1 : Array[(Double, Double, String, aura::AuraButtonVariant)] = [
        (20.0, 84.0, "Primary", aura::AuraButtonVariant::Primary),
        (116.0, 105.0, "Secondary", aura::AuraButtonVariant::Secondary),
        (233.0, 83.0, "Tertiary", aura::AuraButtonVariant::Tertiary),
        (328.0, 72.0, "Ghost", aura::AuraButtonVariant::Ghost),
        (412.0, 82.0, "Outline", aura::AuraButtonVariant::Outline),
        (506.0, 81.0, "Danger", aura::AuraButtonVariant::Danger),
        (599.0, 111.0, "Danger Soft", aura::AuraButtonVariant::DangerSoft),
      ]
      for item in row1 {
        let (bx, bw, lbl, vari) = item
        let _ = a_s_abs(card, bx, 60.0, bw, 36.0, fn(bslot : view::View) -> Unit {
          let b = aura::button_node(bslot, view::Live::Is(lbl), variant=vari)
          let _ = b.width(view::Live::Is(Some(bw)))
        })
      }
    })
    let _ = c.width(view::Live::Is(Some(1152.0))).height(view::Live::Is(Some(116.0)))
  })

  // Card 2: Sizes & States (x=24, y=200, w=1152, h=120)
  let _ = a_s_abs(root, 24.0, 200.0, 1152.0, 120.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = a_s_abs(card, 20.0, 20.0, 200.0, 16.0, fn(h : view::View) -> Unit {
        let _ = h.words(view::Live::Is("Sizes & States"), look=a_s_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      let _ = a_s_abs(card, 20.0, 64.0, 60.0, 32.0, fn(bslot : view::View) -> Unit {
        let b = aura::button_node(bslot, view::Live::Is("Small"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm)
        let _ = b.width(view::Live::Is(Some(60.0)))
      })
      let _ = a_s_abs(card, 92.0, 62.0, 87.0, 36.0, fn(bslot : view::View) -> Unit {
        let b = aura::button_node(bslot, view::Live::Is("Medium"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Md)
        let _ = b.width(view::Live::Is(Some(87.0)))
      })
      let _ = a_s_abs(card, 191.0, 60.0, 75.0, 40.0, fn(bslot : view::View) -> Unit {
        let b = aura::button_node(bslot, view::Live::Is("Large"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Lg)
        let _ = b.width(view::Live::Is(Some(75.0)))
      })
      let _ = a_s_abs(card, 278.0, 62.0, 90.0, 36.0, fn(bslot : view::View) -> Unit {
        let b = aura::button_node(bslot, view::Live::Is("Disabled"), variant=aura::AuraButtonVariant::Primary, disabled=view::Live::Is(true))
        let _ = b.width(view::Live::Is(Some(90.0)))
      })
      let _ = a_s_abs(card, 380.0, 62.0, 87.0, 36.0, fn(bslot : view::View) -> Unit {
        let b = aura::button_node(bslot, view::Live::Is("Pending"), variant=aura::AuraButtonVariant::Primary, disabled=view::Live::Is(true))
        let _ = b.width(view::Live::Is(Some(87.0)))
      })
      let _ = a_s_abs(card, 479.0, 62.0, 36.0, 36.0, fn(bslot : view::View) -> Unit {
        let _ = aura::button_node(
          bslot,
          view::Live::Is("Add"),
          variant=aura::AuraButtonVariant::Secondary,
          icon_only=true,
          content=fn(inner : view::View) -> Unit {
            let _ = aura::aura_icon_node(inner, aura::AuraIconKind::Plus, size=14.0, ink=fn() -> Int64 { pal.accent_soft_foreground })
          },
        )
      })
      let _ = a_s_abs(card, 527.0, 68.0, 24.0, 24.0, fn(bslot : view::View) -> Unit {
        let _ = aura::close_button_node(bslot)
      })
    })
    let _ = c.width(view::Live::Is(Some(1152.0))).height(view::Live::Is(Some(120.0)))
  })

  // Card 3: ButtonGroup & ToggleButtonGroup (x=24, y=340, w=566, h=164)
  let _ = a_s_abs(root, 24.0, 340.0, 566.0, 164.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = a_s_abs(card, 20.0, 20.0, 300.0, 16.0, fn(h : view::View) -> Unit {
        let _ = h.words(view::Live::Is("ButtonGroup & ToggleButtonGroup"), look=a_s_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      // ButtonGroup centered inside 526pt inner width -> x = 20 + 162 = 182 (global x=206, y=400, w=202, h=36)
      let _ = a_s_abs(card, 182.0, 60.0, 202.0, 36.0, fn(gslot : view::View) -> Unit {
        let _ = aura::button_group_node(gslot, label="Alignment", variant=aura::AuraButtonVariant::Secondary, hide_separator=true, content=fn(g : view::View) -> Unit {
          let b0 = aura::button_group_item_node(g, view::Live::Is("Left"), 0, 3)
          let _ = b0.width(view::Live::Is(Some(58.0)))
          let b1 = aura::button_group_item_node(g, view::Live::Is("Center"), 1, 3)
          let _ = b1.width(view::Live::Is(Some(77.0)))
          let b2 = aura::button_group_item_node(g, view::Live::Is("Right"), 2, 3)
          let _ = b2.width(view::Live::Is(Some(67.0)))
        })
      })
      // ToggleButton "Bold" (selected) at local (20, 108) -> global (44, 448, w=62, h=36)
      let _ = a_s_abs(card, 20.0, 108.0, 62.0, 36.0, fn(tslot : view::View) -> Unit {
        let tb = aura::toggle_button_node(tslot, view::Live::Is("Bold"), fn() { true })
        let _ = tb.width(view::Live::Is(Some(62.0)))
      })
      // ToggleButtonGroup "L | C | R" (L selected) at local (94, 108) -> global (118, 448, w=123, h=36)
      let _ = a_s_abs(card, 94.0, 108.0, 123.0, 36.0, fn(tgslot : view::View) -> Unit {
        let _ = aura::toggle_button_group_node(
          tgslot,
          view::Live::Is("Align"),
          fn(k : String) -> Bool { k == "L" },
          fn(_k : String, _on : Bool) -> Unit { () },
          fn(g : view::View, grp : aura::AuraToggleGroup[String]) -> Unit {
            let t0 = grp.item(g, "L", view::Live::Is("L"), index=0, total=3)
            let _ = t0.width(view::Live::Is(Some(40.0)))
            let t1 = grp.item(g, "C", view::Live::Is("C"), index=1, total=3)
            let _ = t1.width(view::Live::Is(Some(42.0)))
            let t2 = grp.item(g, "R", view::Live::Is("R"), index=2, total=3)
            let _ = t2.width(view::Live::Is(Some(41.0)))
          },
          hide_separator=true,
        )
      })
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(164.0)))
  })

  // Card 4: Toolbar, Link & Kbd (x=610, y=340, w=566, h=164)
  let _ = a_s_abs(root, 610.0, 340.0, 566.0, 164.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = a_s_abs(card, 20.0, 20.0, 200.0, 16.0, fn(h : view::View) -> Unit {
        let _ = h.words(view::Live::Is("Toolbar, Link & Kbd"), look=a_s_words(12.0, 500, 16.0)).ink(view::Live::Is(pal.muted))
      })
      // Toolbar at local (20, 60) -> global (630, 400, w=193, h=32)
      let _ = a_s_abs(card, 20.0, 60.0, 210.0, 32.0, fn(tbslot : view::View) -> Unit {
        let _ = aura::toolbar_node(tbslot, label=view::Live::Is("Edit"), gap=8.0, content=fn(bar : view::View, tb : aura::AuraToolbar) -> Unit {
          let b0 = tb.button(bar, view::Live::Is("Cut"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm)
          let _ = b0.width(view::Live::Is(Some(47.0)))
          let b1 = tb.button(bar, view::Live::Is("Copy"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm)
          let _ = b1.width(view::Live::Is(Some(60.0)))
          let _ = tb.separator(bar, span=16.0)
          let b2 = tb.button(bar, view::Live::Is("Paste"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm)
          let _ = b2.width(view::Live::Is(Some(61.0)))
        })
      })
      // Link & Kbd at local (20, 104) -> row with gap=16 matching HeroUI flex items-center gap-4
      let _ = a_s_abs(card, 20.0, 104.0, 260.0, 24.0, fn(lkrow : view::View) -> Unit {
        let _ = lkrow
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(18.0))
        let _ = aura::link_node(lkrow, view::Live::Is("Aura Docs"), external=true, font_size=16.0, line_height=24.0)
        let _ = aura::kbd_node(lkrow, content=fn(kv : view::View) -> Unit {
          let _ = aura::kbd_abbr_node(kv, aura::AuraKbdKey::Command)
          let _ = aura::kbd_content_node(kv, view::Live::Is("K"))
        })
      })
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(164.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene 02: 02-surfaces-cards-typo-{light,dark}-2x (1200x900, dpr=2)
// ---------------------------------------------------------------------------
fn a_build_02_surfaces_cards_typo(root : view::View, dark : Bool) -> Unit {
  let cfg = signals::signal(if dark { aura::AuraConfig::dark() } else { aura::AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))

  // Title (x=24, y=24, w=1152, h=24)
  let _ = a_s_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("02 — Surfaces, Cards, Typography & Layout"), look=a_s_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left column Row 1: 3 Surfaces (y=64, h=56, radius=16)
  let surfs : Array[(Double, Double, aura::AuraSurfaceVariant, String)] = [
    (24.0, 181.0, aura::AuraSurfaceVariant::Default, "Default"),
    (217.0, 180.0, aura::AuraSurfaceVariant::Secondary, "Secondary"),
    (409.0, 181.0, aura::AuraSurfaceVariant::Tertiary, "Tertiary"),
  ]
  for sp in surfs {
    let (sx, sw, vari, lbl) = sp
    let _ = a_s_abs(root, sx, 64.0, sw, 56.0, fn(slot : view::View) -> Unit {
      let s = aura::surface_node(slot, variant=vari, radius=16.0, pad=16.0, content=fn(inner : view::View) -> Unit {
        let _ = inner.box(fn(t : view::View) -> Unit {
          let _ = t
            .margin(view::Live::Is((0.0, 2.0, 0.0, 0.0)))
            .words(view::Live::Is(lbl), look=a_s_words(12.0, 500, 24.0))
            .ink(view::Live::Is(pal.foreground))
        })
      })
      let _ = s.width(view::Live::Is(Some(sw))).height(view::Live::Is(Some(56.0)))
    })
  }

  // Left column Row 2: Card (x=24, y=136, w=566, h=152)
  let _ = a_s_abs(root, 24.0, 136.0, 566.0, 152.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=16.0, gap=12.0, content=fn(card : view::View) -> Unit {
      let _ = aura::card_header_node(card, content=fn(h : view::View) -> Unit {
        let _ = aura::card_title_node(h, view::Live::Is("Deployment Ready"))
        let _ = aura::card_description_node(h, view::Live::Is("All checks passed on main branch."))
      })
      let _ = aura::card_content_node(card, content=fn(body : view::View) -> Unit {
        let _ = body.words(view::Live::Is("Build artifacts verified in 14.2s."), look=a_s_words(14.0, 400, 20.0)).ink(view::Live::Is(pal.muted))
      })
      let _ = aura::card_footer_node(card, gap=8.0, content=fn(f : view::View) -> Unit {
        let b0 = aura::button_node(f, view::Live::Is("Details"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Sm)
        let _ = b0.width(view::Live::Is(Some(70.0)))
        let b1 = aura::button_node(f, view::Live::Is("Deploy"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm)
        let _ = b1.width(view::Live::Is(Some(70.0)))
      })
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(152.0)))
  })

  // Left column Row 3: Header + Separator + ScrollShadow Card (x=24, y=304, w=566, h=204)
  let sc_state = view::Scroll::new()
  let _ = a_s_abs(root, 24.0, 304.0, 566.0, 204.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=0.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = a_s_abs(card, 16.0, 16.0, 534.0, 26.0, fn(hslot : view::View) -> Unit {
        let _ = aura::header_node(hslot, view::Live::Is("Section Header"))
      })
      let _ = a_s_abs(card, 16.0, 70.0, 534.0, 1.0, fn(sslot : view::View) -> Unit {
        let sep = aura::separator_node(sslot)
        let _ = sep.corner_circular(view::Live::Is(true)).radius(view::Live::Is(0.5))
      })
      let _ = a_s_abs(card, 16.0, 91.0, 534.0, 96.0, fn(shslot : view::View) -> Unit {
        let _ = aura::scroll_shadow_node(shslot, sc_state, vertical=true, shadow_size=16.0, content=fn(sh : view::View) -> Unit {
          let _ = ui::scroll_box(
            sh,
            fn(col : view::View) -> Unit {
              let _ = col.padding(view::Live::Is((8.0, 7.5, 8.0, 8.0))).gap(view::Live::Is(0.0))
              let lines : Array[String] = [
                "Line 1 — Scrollable content inside ScrollShadow container.",
                "Line 2 — Demonstrates top/bottom fade mask when overflowing.",
                "Line 3 — Aura ScrollShadow primitive.",
                "Line 4 — Extra overflow line for bottom fade.",
                "Line 5 — Another overflow line.",
                "Line 6 — End of scroll region.",
              ]
              for ln in lines {
                let _ = col.box(fn(lv : view::View) -> Unit {
                  let _ = lv.words(view::Live::Is(ln), look=a_s_words(12.0, 400, 16.0)).ink(view::Live::Is(pal.muted))
                })
              }
            },
            scroll=sc_state,
          )
        })
      })
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(204.0)))
  })

  // Right column Top: Typography Card (x=610, y=64, w=566, h=352)
  let _ = a_s_abs(root, 610.0, 64.0, 566.0, 352.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=20.0, gap=6.0, content=fn(card : view::View) -> Unit {
      let _ = aura::typography_node(card, view::Live::Is("Heading 1"), kind=aura::AuraTypographyType::H1)
      let h2 = aura::typography_node(card, view::Live::Is("Heading 2"), kind=aura::AuraTypographyType::H2)
      let _ = h2.margin(view::Live::Is((0.0, 0.0, 0.0, -0.5)))
      let _ = aura::typography_node(card, view::Live::Is("Heading 3"), kind=aura::AuraTypographyType::H3)
      let _ = aura::typography_node(card, view::Live::Is("Heading 4"), kind=aura::AuraTypographyType::H4)
      let _ = aura::typography_node(card, view::Live::Is("Heading 5"), kind=aura::AuraTypographyType::H5)
      let _ = aura::typography_node(card, view::Live::Is("Heading 6"), kind=aura::AuraTypographyType::H6)
      let _ = aura::typography_node(card, view::Live::Is("Body text regular 16px"), kind=aura::AuraTypographyType::Body)
      let _ = aura::typography_node(card, view::Live::Is("Body small muted"), kind=aura::AuraTypographyType::Muted)
      let code_v = aura::typography_node(card, view::Live::Is("const aura = \"v3.2.8\";"), kind=aura::AuraTypographyType::Code, mono=false)
      let _ = code_v.fills_across(view::Live::Is(true))
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(352.0)))
  })

  // Right column Bottom: EmptyState Card (x=610, y=432, w=566, h=108)
  let _ = a_s_abs(root, 610.0, 432.0, 566.0, 108.0, fn(slot : view::View) -> Unit {
    let c = aura::card_node(slot, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=20.0, gap=0.0, content=fn(card : view::View) -> Unit {
      let _ = aura::empty_state_node(
        card,
        pad=0.0,
        gap=0.0,
        content=fn(es : view::View) -> Unit {
          let _ = es.padding(view::Live::Is((8.0, 16.0, 8.0, 16.0)))
          let _ = es.box(fn(t : view::View) -> Unit {
            let _ = t.words(view::Live::Is("No items found"), look=a_s_words(14.0, 500, 19.6)).ink(view::Live::Is(pal.muted))
          })
          let _ = es.box(fn(d : view::View) -> Unit {
            let _ = d.words(view::Live::Is("Try adjusting your filters."), look=a_s_words(12.0, 400, 16.0)).ink(view::Live::Is(pal.muted))
          })
        },
      )
    })
    let _ = c.width(view::Live::Is(Some(566.0))).height(view::Live::Is(Some(108.0)))
  })
}

// ---------------------------------------------------------------------------
// Scene narrow-320-light-2x (320x800, dpr=2, Light — 1:1 Chromium calibration)
// ---------------------------------------------------------------------------
fn a_build_narrow_320(root : view::View) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(), density: aura::AuraDensity::Touch })
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root
    .ground(view::Live::Is(pal.background))
    .pad(view::Live::Is(16.0))
    .gap(view::Live::Is(16.0))

  // Title: "Narrow 320px" at (16, 16, 288, 24); 12pt gap to Card (y=52)
  let _ = root.box(fn(v : view::View) -> Unit {
    let _ = v
      .margin(view::Live::Is((0.0, 0.0, 0.0, -4.0)))
      .words(view::Live::Is("Narrow 320px"), look=a_s_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Card: Mobile Card + Continue / Cancel full-width buttons (y=52..260)
  let c = aura::card_node(root, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=16.0, gap=24.0, content=fn(card : view::View) -> Unit {
    let _ = aura::card_header_node(card, content=fn(h : view::View) -> Unit {
      let _ = aura::card_title_node(h, view::Live::Is("Mobile Card"))
      let _ = aura::card_description_node(h, view::Live::Is("Responsive compact layout at 320px width."))
    })
    let _ = card.box(fn(btns : view::View) -> Unit {
      let _ = btns.fills_across(view::Live::Is(true)).gap(view::Live::Is(8.0))
      let _ = aura::button_node(btns, view::Live::Is("Continue"), variant=aura::AuraButtonVariant::Primary, full_width=true)
      let _ = aura::button_node(btns, view::Live::Is("Cancel"), variant=aura::AuraButtonVariant::Secondary, full_width=true)
    })
  })
  let _ = c.fills_across(view::Live::Is(true))

  // TextField: Email + Input "hello@invar.dev"
  let _ = aura::text_field_node(
    root,
    label=view::Live::Is("Email"),
    value="hello@invar.dev",
    variant=aura::AuraFieldVariant::Primary,
    full_width=true,
  )

  // Switch: stacked "Notifications"
  let _ = aura::switch_node(
    root,
    view::Live::Is(true),
    fn(_on : Bool) -> Unit { () },
    label=view::Live::Is("Notifications"),
    stacked=true,
  )

  // Tabs: Feed (selected) / Inbox
  let _ = aura::tabs_node(
    root,
    [
      aura::AuraTabItem::new("feed", "Feed", fn(_v : view::View) -> Unit { () }),
      aura::AuraTabItem::new("inbox", "Inbox", fn(_v : view::View) -> Unit { () }),
    ],
    fn() -> String { "feed" },
    fn(_k : String) -> Unit { () },
    variant=aura::AuraTabsVariant::Primary,
    show_panels=false,
  )

  // Alert: Syncing / All changes saved.
  let _ = aura::alert_node(
    root,
    status=aura::AuraAlertStatus::Accent,
    title=view::Live::Is("Syncing"),
    description=view::Live::Is("All changes saved."),
  )
}

// ---------------------------------------------------------------------------
// Scenes bp-748-light-2x (748x500, < 768 -> Button md = 40pt) &
//        bp-788-light-2x (788x500, >= 768 -> Button md = 36pt)
// ---------------------------------------------------------------------------
fn a_build_bp_responsive(root : view::View, viewport_w : Double) -> Unit {
  let cfg = signals::signal(aura::AuraConfig::light())
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root
    .ground(view::Live::Is(pal.background))
    .pad(view::Live::Is(24.0))
    .gap(view::Live::Is(16.0))

  // Title at (24, 24, W-48, 24)
  let _ = root.box(fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Responsive Breakpoint Calibration (md = 768px)"), look=a_s_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Card at (24, 64, W-48)
  let input_w = (viewport_w - 88.0) / 2.0 - 8.0
  let c = aura::card_node(root, variant=aura::AuraSurfaceVariant::Default, radius=24.0, pad=20.0, gap=20.0, content=fn(card : view::View) -> Unit {
    // Row 1: Small (Secondary Sm), Medium Button (Primary Md), Large (Secondary Lg)
    let _ = card.box(fn(row1 : view::View) -> Unit {
      let _ = row1
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(16.0))
      let _ = aura::button_node(row1, view::Live::Is("Small"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm)
      let _ = aura::button_node(row1, view::Live::Is("Medium Button"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Md)
      let _ = aura::button_node(row1, view::Live::Is("Large"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Lg)
    })
    // Row 2: TextField "Input" ("Breakpoint input") + Checkbox "Checked" (stacked) + Switch "Enabled" (stacked)
    let _ = card.box(fn(row2 : view::View) -> Unit {
      let _ = row2
        .row(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        .gap(view::Live::Is(16.0))
      let _ = row2.box(fn(tf_wrap : view::View) -> Unit {
        let _ = tf_wrap.width(view::Live::Is(Some(input_w))).shrink(view::Live::Is(0.0))
        let _ = aura::text_field_node(
          tf_wrap,
          label=view::Live::Is("Input"),
          value="Breakpoint input",
          variant=aura::AuraFieldVariant::Primary,
          full_width=true,
        )
      })
      let _ = row2.box(fn(cb_wrap : view::View) -> Unit {
        let _ = cb_wrap.margin(view::Live::Is((0.0, 12.0, 0.0, 0.0)))
        let _ = aura::checkbox_node(
          cb_wrap,
          label=view::Live::Is("Checked"),
          checked=view::Live::Is(true),
          stacked=true,
        )
      })
      let _ = row2.box(fn(sw_wrap : view::View) -> Unit {
        let _ = sw_wrap.margin(view::Live::Is((3.0, 8.0, 0.0, 0.0)))
        let _ = aura::switch_node(
          sw_wrap,
          view::Live::Is(true),
          fn(_on : Bool) -> Unit { () },
          label=view::Live::Is("Enabled"),
          stacked=true,
        )
      })
    })
  })
  let _ = c.fills_across(view::Live::Is(true))
}

fn a_should_run(only : String, sid : String) -> Bool {
  only == "" || only == "wave1" || only == "wave1a" || only == sid
}

fn a_shot(
  out_dir : String,
  only : String,
  sid : String,
  w : Double,
  h : Double,
  scale : Double,
  make : (view::View) -> Unit,
) -> Int {
  if !a_should_run(only, sid) {
    return 0
  }
  let path = out_dir + "/" + sid + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=scale, at=0.0)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

/// Render all 8 Wave 1 Track 1A calibration scenes into `out_dir`, filtered by `only`.
/// Returns the number of failed renders (0 on full success).
pub fn render_1a_scenes(out_dir : String, only~ : String = "") -> Int {
  let mut errs = 0
  errs = errs + a_shot(out_dir, only, "01-buttons-actions-light-2x", 1200.0, 900.0, 2.0, fn(r) { a_build_01_buttons_actions(r, false) })
  errs = errs + a_shot(out_dir, only, "01-buttons-actions-dark-2x", 1200.0, 900.0, 2.0, fn(r) { a_build_01_buttons_actions(r, true) })
  errs = errs + a_shot(out_dir, only, "01-buttons-actions-light-1x", 1200.0, 900.0, 1.0, fn(r) { a_build_01_buttons_actions(r, false) })
  errs = errs + a_shot(out_dir, only, "02-surfaces-cards-typo-light-2x", 1200.0, 900.0, 2.0, fn(r) { a_build_02_surfaces_cards_typo(r, false) })
  errs = errs + a_shot(out_dir, only, "02-surfaces-cards-typo-dark-2x", 1200.0, 900.0, 2.0, fn(r) { a_build_02_surfaces_cards_typo(r, true) })
  errs = errs + a_shot(out_dir, only, "narrow-320-light-2x", 320.0, 800.0, 2.0, fn(r) { a_build_narrow_320(r) })
  errs = errs + a_shot(out_dir, only, "bp-748-light-2x", 748.0, 500.0, 2.0, fn(r) { a_build_bp_responsive(r, 748.0) })
  errs = errs + a_shot(out_dir, only, "bp-788-light-2x", 788.0, 500.0, 2.0, fn(r) { a_build_bp_responsive(r, 788.0) })
  errs
}
