// Wave 1.5 Track 1.5B offscreen GPU calibration & expanded-state showcase scenes for `packages/aura`.
// Exports 5 reusable drop-in widget builders (`w15b_*`) for Scenes 06/07/08,
// 6 expanded-state overlay scenes (`scene_ov_{color,date,date_range}_picker_{light,dark}_2x`),
// and 2 Toast+Table combined scenes (`scene_w15_toast_table_{light,dark}_2x`).

import "aura"
import "film"
import "signals"
import "ui"
import "view"

fn x15b_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn x15b_setup_scene(root : view::View, dark : Bool, corner_circular~ : Bool = true) -> aura::AuraPalette {
  let cfg = signals::signal(
    if dark {
      aura::AuraConfig::dark(corner_circular=corner_circular)
    } else {
      aura::AuraConfig::light(corner_circular=corner_circular)
    },
  )
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let pal = aura::aura_theme_from(cfg.get()).palette
  let _ = root.ground(view::Live::Is(pal.background))
  pal
}

fn x15b_abs(parent : view::View, x : Double, y : Double, w : Double, h : Double, body : (view::View) -> Unit) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None))
      .width(view::Live::Is(Some(w)))
      .height(view::Live::Is(Some(h)))
    body(v)
  })
}

// ============================================================================
// Reusable drop-in widget builders for Scenes 06 / 07 / 08
// ============================================================================

/// Reusable Table card matching Scene 06 (`Name | Role | Status` with Ada Lovelace & Alan Turing).
pub fn w15b_table_card(parent : view::View, width~ : Double = 566.0) -> view::View {
  let rows : Array[(String, String, String, String, aura::AuraStatusColor)] = [
    ("ada", "Ada Lovelace", "Architect", "Active", aura::AuraStatusColor::Success),
    ("alan", "Alan Turing", "Verifier", "Review", aura::AuraStatusColor::Accent),
  ]
  let row_keys : Array[String] = ["ada", "alan"]
  let col_keys : Array[String] = ["name", "role", "status"]

  parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.width(view::Live::Is(Some(width))).shrink(view::Live::Is(0.0))
    let _ = aura::table_node(wrap, variant=aura::AuraTableVariant::Primary, content=fn(tbl : view::View) -> Unit {
      let _ = aura::TableContent(
        tbl,
        row_keys=fn() -> Array[String] { row_keys },
        col_keys=fn() -> Array[String] { col_keys },
        label="Team members",
        selection_mode=aura::aura_table_sel_none(),
        children=fn(tc : view::View) -> Unit {
          let _ = aura::table_header_node(tc, content=fn(hdr : view::View) -> Unit {
            let _ = aura::table_column_node(hdr, "name", view::Live::Is("Name"), flex_grow=1.35)
            let _ = aura::table_column_node(hdr, "role", view::Live::Is("Role"), flex_grow=0.97)
            let _ = aura::table_column_node(hdr, "status", view::Live::Is("Status"), is_last=true, flex_grow=0.88)
          })
          let _ = aura::table_body_node(tc, content=fn(tb : view::View) -> Unit {
            let mut i = 0
            while i < rows.length() {
              let (rk, name, role, status, st_col) = rows[i]
              let last = i + 1 == rows.length()
              let _ = aura::table_row_node(tb, rk, is_last=last, content=fn(tr : view::View, _sel : () -> Bool) -> Unit {
                let _ = aura::table_cell_node(tr, "name", text=view::Live::Is(name), flex_grow=1.35)
                let _ = aura::table_cell_node(tr, "role", text=view::Live::Is(role), flex_grow=0.97)
                let _ = aura::table_cell_node(
                  tr,
                  "status",
                  label=status,
                  flex_grow=0.88,
                  content=fn(c : view::View, _foc : () -> Bool) -> Unit {
                    let ch = aura::chip_node(
                      c,
                      view::Live::Is(status),
                      variant=aura::AuraChipVariant::Soft,
                      color=st_col,
                      size=aura::AuraControlSize::Sm,
                    )
                    let _ = ch.height(view::Live::Is(Some(20.0)))
                  },
                )
              })
              i += 1
            }
          })
        },
      )
    })
  })
}

/// Reusable bottom-end Toast overlay matching Scene 06 (`Build succeeded` / `packages/aura passed all checks.`).
pub fn w15b_toast_overlay(parent : view::View, width~ : Double = 460.0) -> view::View {
  aura::toast_node(
    parent,
    variant=aura::AuraToastVariant::Success,
    title=view::Live::Is("Build succeeded"),
    description=view::Live::Is("packages/aura passed all checks."),
    show_indicator=true,
    width=width,
  )
}

/// Reusable ColorPicker trigger row matching Scene 07 (`Pick Accent Color`).
pub fn w15b_color_picker_row(
  parent : view::View,
  default_open~ : Bool = false,
) -> view::View {
  let accent = signals::signal_by(
    aura::aura_color_rgba(4.0 / 255.0, 133.0 / 255.0, 247.0 / 255.0, alpha=1.0),
    fn(a, b) { a == b },
  )
  aura::color_picker_node(
    parent,
    model=fn() { accent.get() },
    on_change=fn(m) { accent.set(m) },
    label="Pick Accent Color",
    default_open=default_open,
  )
}

/// Reusable DatePicker field matching Scene 08 (`DatePicker`, `11 / 24 / 2026`).
pub fn w15b_date_picker_field(
  parent : view::View,
  default_open~ : Bool = false,
) -> view::View {
  let dt = signals::signal_by(
    aura::aura_segmented_date(2026, 11, 24),
    fn(a, b) { a.eq(b) },
  )
  aura::date_picker_node(
    parent,
    value=fn() { dt.get() },
    on_change=fn(v) { dt.set(v) },
    label="DatePicker",
    default_open=default_open,
    today=fn() { Some(aura::aura_date(2026, 11, 24)) },
  )
}

/// Reusable DateRangePicker field matching Scene 08 (`DateRangePicker`, `11 / 10 / 2026 - 11 / 18 / 2026`).
pub fn w15b_date_range_picker_field(
  parent : view::View,
  default_open~ : Bool = false,
) -> view::View {
  let s_sig = signals::signal_by(
    aura::aura_segmented_date(2026, 11, 10),
    fn(a, b) { a.eq(b) },
  )
  let e_sig = signals::signal_by(
    aura::aura_segmented_date(2026, 11, 18),
    fn(a, b) { a.eq(b) },
  )
  aura::date_range_picker_node(
    parent,
    start_value=fn() { s_sig.get() },
    end_value=fn() { e_sig.get() },
    on_change=fn(ns, ne) { s_sig.set(ns); e_sig.set(ne) },
    label="DateRangePicker",
    default_open=default_open,
    today=fn() { Some(aura::aura_date(2026, 11, 24)) },
  )
}

// ============================================================================
// 6 Expanded-State Overlay Showcase Scenes (640x680 @ 2x)
// ============================================================================

fn x15b_build_ov_color_picker(root : view::View, dark : Bool, corner_circular~ : Bool = true) -> Unit {
  let pal = x15b_setup_scene(root, dark, corner_circular=corner_circular)
  let _ = x15b_abs(root, 24.0, 24.0, 592.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("ColorPicker — Expanded Popover"), look=x15b_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })
  let _ = x15b_abs(root, 24.0, 64.0, 592.0, 84.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        let _ = w15b_color_picker_row(c, default_open=true)
      },
    )
    let _ = card.width(view::Live::Is(Some(592.0)))
  })
}

pub fn scene_ov_color_picker_light_2x(root : view::View) -> Unit {
  x15b_build_ov_color_picker(root, false)
}

pub fn scene_ov_color_picker_dark_2x(root : view::View) -> Unit {
  x15b_build_ov_color_picker(root, true)
}

fn x15b_build_ov_date_picker(root : view::View, dark : Bool) -> Unit {
  let pal = x15b_setup_scene(root, dark)
  let _ = x15b_abs(root, 24.0, 24.0, 592.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("DatePicker — Expanded Popover"), look=x15b_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })
  let _ = x15b_abs(root, 24.0, 64.0, 380.0, 108.0, fn(slot : view::View) -> Unit {
    let card = aura::surface_node(
      slot,
      variant=aura::AuraSurfaceVariant::Default,
      radius=24.0,
      pad=20.0,
      shadow=true,
      content=fn(c : view::View) -> Unit {
        let _ = w15b_date_picker_field(c, default_open=true)
      },
    )
    let _ = card.width(view::Live::Is(Some(380.0)))
  })
}

pub fn scene_ov_date_picker_light_2x(root : view::View) -> Unit {
  x15b_build_ov_date_picker(root, false)
}

pub fn scene_ov_date_picker_dark_2x(root : view::View) -> Unit {
