// ============================================================================
// 2 Combined Toast + Table Showcase Scenes (1200x900 @ 2x)
// ============================================================================

fn x15b_build_toast_table(root : view::View, dark : Bool, corner_circular~ : Bool = true) -> Unit {
  let pal = x15b_setup_scene(root, dark, corner_circular=corner_circular)
  let _ = x15b_abs(root, 24.0, 24.0, 1152.0, 24.0, fn(v : view::View) -> Unit {
    let _ = v
      .words(view::Live::Is("Wave 1.5B — Table & Toast Showcase"), look=x15b_words(16.0, 600, 24.0))
      .ink(view::Live::Is(pal.foreground))
  })

  // Left column: 5 Toast semantic variants (Default, Accent, Success, Warning, Danger)
  let _ = x15b_abs(root, 24.0, 64.0, 460.0, 560.0, fn(col : view::View) -> Unit {
    let _ = col.gap(view::Live::Is(14.0))
    let _ = aura::toast_node(
      col,
      variant=aura::AuraToastVariant::Default,
      title=view::Live::Is("Default Toast"),
      description=view::Live::Is("Neutral notification message."),
      width=460.0,
    )
    let _ = aura::toast_node(
      col,
      variant=aura::AuraToastVariant::Accent,
      title=view::Live::Is("Accent Toast"),
      description=view::Live::Is("New release artifacts are ready."),
      action_label=view::Live::Is("Open"),
      width=460.0,
    )
    let _ = aura::toast_node(
      col,
      variant=aura::AuraToastVariant::Success,
      title=view::Live::Is("Build succeeded"),
      description=view::Live::Is("packages/aura passed all checks."),
      progress=fn() -> Option[Double] { Some(0.75) },
      width=460.0,
    )
    let _ = aura::toast_node(
      col,
      variant=aura::AuraToastVariant::Warning,
      title=view::Live::Is("Cache warming"),
      description=view::Live::Is("First frame latency slightly elevated."),
      width=460.0,
    )
    let _ = aura::toast_node(
      col,
      variant=aura::AuraToastVariant::Danger,
      title=view::Live::Is("Deployment halted"),
      description=view::Live::Is("Verification failed on target node."),
      show_close=true,
      width=460.0,
    )
  })

  // Right top: Primary Table card (Scene 06 exact spec)
  let _ = x15b_abs(root, 516.0, 64.0, 660.0, 220.0, fn(slot : view::View) -> Unit {
    let _ = w15b_table_card(slot, width=660.0)
  })

  // Right middle: Secondary Table variant with footer
  let _ = x15b_abs(root, 516.0, 290.0, 660.0, 240.0, fn(slot : view::View) -> Unit {
    let rks : Array[String] = ["s1", "s2"]
    let cks : Array[String] = ["pkg", "suite", "result"]
    let _ = aura::table_node(slot, variant=aura::AuraTableVariant::Secondary, content=fn(tbl : view::View) -> Unit {
      let _ = aura::TableContent(
        tbl,
        row_keys=fn() { rks },
        col_keys=fn() { cks },
        label="Audit checks",
        selection_mode=aura::aura_table_sel_none(),
        children=fn(tc : view::View) -> Unit {
          let _ = aura::table_header_node(tc, content=fn(hdr : view::View) -> Unit {
            let _ = aura::table_column_node(hdr, "pkg", view::Live::Is("Package"), sortable=true, flex_grow=1.2)
            let _ = aura::table_column_node(hdr, "suite", view::Live::Is("Suite"), flex_grow=1.0)
            let _ = aura::table_column_node(hdr, "result", view::Live::Is("Result"), is_last=true, flex_grow=0.8)
          })
          let _ = aura::table_body_node(tc, content=fn(tb : view::View) -> Unit {
            let _ = aura::table_row_node(tb, "s1", content=fn(tr : view::View, _sel : () -> Bool) -> Unit {
              let _ = aura::table_cell_node(tr, "pkg", text=view::Live::Is("packages/aura"), flex_grow=1.2)
              let _ = aura::table_cell_node(tr, "suite", text=view::Live::Is("Unit & A11y"), flex_grow=1.0)
              let _ = aura::table_cell_node(tr, "result", label="Passed", flex_grow=0.8, content=fn(c : view::View, _f : () -> Bool) -> Unit {
                let _ = aura::chip_node(c, view::Live::Is("Passed"), variant=aura::AuraChipVariant::Soft, color=aura::AuraStatusColor::Success)
              })
            })
            let _ = aura::table_row_node(tb, "s2", is_last=true, content=fn(tr : view::View, _sel : () -> Bool) -> Unit {
              let _ = aura::table_cell_node(tr, "pkg", text=view::Live::Is("packages/headless"), flex_grow=1.2)
              let _ = aura::table_cell_node(tr, "suite", text=view::Live::Is("Grid & Focus"), flex_grow=1.0)
              let _ = aura::table_cell_node(tr, "result", label="Verified", flex_grow=0.8, content=fn(c : view::View, _f : () -> Bool) -> Unit {
                let _ = aura::chip_node(c, view::Live::Is("Verified"), variant=aura::AuraChipVariant::Soft, color=aura::AuraStatusColor::Accent)
              })
            })
          })
        },
      )
      let _ = aura::table_footer_node(tbl, content=fn(ftr : view::View) -> Unit {
        let _ = ftr.box(fn(tv : view::View) -> Unit {
          let _ = tv
            .words(view::Live::Is("Showing 2 of 2 suites"), look=x15b_words(12.0, 400, 16.0))
            .ink(view::Live::Is(pal.muted))
        })
      })
    })
  })

  // Bottom-right floating Toast overlay (exact Scene 06 placement)
  let _ = x15b_abs(root, 724.0, 816.0, 460.0, 68.0, fn(slot : view::View) -> Unit {
    let _ = w15b_toast_overlay(slot, width=460.0)
  })
}

pub fn scene_w15_toast_table_light_2x(root : view::View) -> Unit {
  x15b_build_toast_table(root, false)
}

pub fn scene_w15_toast_table_dark_2x(root : view::View) -> Unit {
  x15b_build_toast_table(root, true)
}

/// Default smooth-corner showcase scenes (`corner_circular=false`).
pub fn scene_w15_toast_table_smooth_light_2x(root : view::View) -> Unit {
  x15b_build_toast_table(root, false, corner_circular=false)
}

pub fn scene_ov_color_picker_smooth_dark_2x(root : view::View) -> Unit {
  x15b_build_ov_color_picker(root, true, corner_circular=false)
}

fn x15b_should_run(only : String, sid : String, smooth_only~ : Bool = false) -> Bool {
  if smooth_only {
    only == "smooth" || only == sid
  } else {
    only == "" || only == "wave15" || only == "wave15b" || only == sid
  }
}

fn x15b_shot(out_dir : String, only : String, stem : String, w : Double, h : Double, make : (view::View) -> Unit, smooth_only~ : Bool = false) -> Int {
  if !x15b_should_run(only, stem, smooth_only=smooth_only) {
    return 0
  }
  let path = out_dir + "/" + stem + ".png"
  let ok = film::picture(make, path=path, w=w, h=h, scale=2.0, at=0.0)
  if ok {
    film::say("wrote " + path)
    0
  } else {
    film::say("FAILED " + path)
    1
  }
}

/// Render all 8 Wave 1.5B scenes (6 expanded overlay scenes + 2 Toast/Table combined scenes).
pub fn render_15b_scenes(out_dir : String, only~ : String = "") -> Int {
  let mut errs = 0
  errs = errs + x15b_shot(out_dir, only, "ov-color-picker-light-2x", 640.0, 680.0, scene_ov_color_picker_light_2x)
  errs = errs + x15b_shot(out_dir, only, "ov-color-picker-dark-2x", 640.0, 680.0, scene_ov_color_picker_dark_2x)
  errs = errs + x15b_shot(out_dir, only, "ov-date-picker-light-2x", 640.0, 560.0, scene_ov_date_picker_light_2x)
  errs = errs + x15b_shot(out_dir, only, "ov-date-picker-dark-2x", 640.0, 560.0, scene_ov_date_picker_dark_2x)
  errs = errs + x15b_shot(out_dir, only, "ov-date-range-picker-light-2x", 640.0, 560.0, scene_ov_date_range_picker_light_2x)
  errs = errs + x15b_shot(out_dir, only, "ov-date-range-picker-dark-2x", 640.0, 560.0, scene_ov_date_range_picker_dark_2x)
  errs = errs + x15b_shot(out_dir, only, "w15-toast-table-light-2x", 1200.0, 900.0, scene_w15_toast_table_light_2x)
  errs = errs + x15b_shot(out_dir, only, "w15-toast-table-dark-2x", 1200.0, 900.0, scene_w15_toast_table_dark_2x)
  errs = errs + x15b_shot(out_dir, only, "w15-toast-table-smooth-light-2x", 1200.0, 900.0, scene_w15_toast_table_smooth_light_2x, smooth_only=true)
  errs = errs + x15b_shot(out_dir, only, "ov-color-picker-smooth-dark-2x", 640.0, 680.0, scene_ov_color_picker_smooth_dark_2x, smooth_only=true)
  errs
}
