// Pure inline-edit text normalization.
// Zero view, layout, or renderer dependencies.

/// Normalize an inline-edit draft `raw` against its previous value `was`.
/// Returns `Some(text)` to commit, or `None` when the edit should be treated as cancelled.
pub fn inline_edit_normalize(
  raw : String,
  was : String,
  trim~ : Bool = false,
  cancel_if_empty~ : Bool = false,
  cancel_if_unchanged~ : Bool = false,
) -> Option[String] {
  let next = if trim { str_trim(raw) } else { raw }
  if cancel_if_empty && next.length() == 0 {
    return None
  }
  if cancel_if_unchanged && next == was {
    return None
  }
  Some(next)
}
