// Frame-rate-independent pure timestamp repeat timer state machine.

import "dmath"
import "signals"

/// Pure timestamp-driven hold-to-repeat state machine.
pub struct RepeatTimer {
  delay_ms : Double
  interval_ms : Double
  immediate : Bool
  active_sig : signals::Signal[Bool]
  next_due : Ref[Option[Double]]
}

/// Create a `RepeatTimer` with initial `delay_ms` and repeat `interval_ms`.
pub fn RepeatTimer::new(
  delay_ms~ : Double = 400.0,
  interval_ms~ : Double = 70.0,
  immediate~ : Bool = false,
) -> RepeatTimer {
  let wait = if delay_ms >= 0.0 { delay_ms } else { 0.0 }
  let step = if interval_ms > 1.0 { interval_ms } else { 1.0 }
  RepeatTimer::{
    delay_ms: wait,
    interval_ms: step,
    immediate,
    active_sig: signals::signal(false),
    next_due: ref_new(None),
  }
}

/// Whether the repeat timer is currently active (reactive).
pub fn RepeatTimer::active(self : RepeatTimer) -> Bool {
  self.active_sig.get()
}

/// Next scheduled fire timestamp in milliseconds, if active.
pub fn RepeatTimer::next_due_ms(self : RepeatTimer) -> Option[Double] {
  self.next_due.v
}

/// Begin holding at `now_ms`. Returns 1 if `immediate=true`, else 0.
pub fn RepeatTimer::on_down(self : RepeatTimer, now_ms : Double) -> Int {
  self.active_sig.set(true)
  self.next_due.v = Some(now_ms + self.delay_ms)
  if self.immediate { 1 } else { 0 }
}

/// Advance the timer to `now_ms` and return how many repeat ticks fired.
pub fn RepeatTimer::on_tick(self : RepeatTimer, now_ms : Double) -> Int {
  if !self.active_sig.untracked() {
    return 0
  }
  match self.next_due.v {
    None => 0
    Some(due) => {
      if now_ms < due {
        return 0
      }
      let extra = dmath::floor((now_ms - due) / self.interval_ms).to_int()
      let fires = 1 + (if extra > 0 { extra } else { 0 })
      self.next_due.v = Some(due + fires.to_double() * self.interval_ms)
      fires
    }
  }
}

/// Stop holding and cancel any scheduled repeat.
pub fn RepeatTimer::on_up(self : RepeatTimer) -> Unit {
  self.active_sig.set(false)
  self.next_due.v = None
}
