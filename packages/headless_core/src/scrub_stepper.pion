// 1D sub-pixel scrub stepper accumulator with deadzone, residual preservation, and reactive active state.

import "dmath"
import "signals"

/// 1D sub-pixel step accumulator for precision scrubbing (sliders, numeric scrubbers, timelines).
pub struct ScrubStepper {
  step_px : Double
  deadzone_px : Double
  active_sig : signals::Signal[Bool]
  has_anchor : signals::Ref[Bool]
  last_pos : signals::Ref[Double]
  deadzone_acc : signals::Ref[Double]
  residual_ : signals::Ref[Double]
}

/// Create a `ScrubStepper` emitting 1 integer step per `step_px` after crossing `deadzone_px`.
pub fn ScrubStepper::new(
  step_px~ : Double = 12.0,
  deadzone_px~ : Double = 4.0,
) -> ScrubStepper {
  ScrubStepper::{
    step_px: if step_px > 1.0e-6 { step_px } else { 1.0 },
    deadzone_px: if deadzone_px >= 0.0 { deadzone_px } else { 0.0 },
    active_sig: signals::signal(false),
    has_anchor: ref_new(false),
    last_pos: ref_new(0.0),
    deadzone_acc: ref_new(0.0),
    residual_: ref_new(0.0),
  }
}

/// Whether scrubbing has crossed the deadzone and is actively emitting steps (reactive).
pub fn ScrubStepper::active(self : ScrubStepper) -> Bool {
  self.active_sig.get()
}

/// Sub-pixel residual not yet converted into a full integer step.
pub fn ScrubStepper::residual(self : ScrubStepper) -> Double {
  self.residual_.v
}

/// Start a scrub gesture at 1D coordinate `pos`.
pub fn ScrubStepper::on_down(self : ScrubStepper, pos : Double) -> Unit {
  self.has_anchor.v = true
  self.last_pos.v = pos
  self.deadzone_acc.v = 0.0
  self.residual_.v = 0.0
  self.active_sig.set(false)
}

/// Feed a relative 1D displacement `dx` and return the integer step delta (positive or negative).
/// Preserves sub-pixel residual across ticks and direction reversals.
pub fn ScrubStepper::on_delta(self : ScrubStepper, dx : Double) -> Int {
  if !self.active_sig.untracked() {
    let next_dz = self.deadzone_acc.v + dx
    if dmath::abs(next_dz) < self.deadzone_px {
      self.deadzone_acc.v = next_dz
      return 0
    }
    self.active_sig.set(true)
    self.deadzone_acc.v = 0.0
    self.residual_.v = if next_dz >= 0.0 {
      next_dz - self.deadzone_px
    } else {
      next_dz + self.deadzone_px
    }
  } else {
    self.residual_.v = self.residual_.v + dx
  }
  let mut steps = 0
  let step = self.step_px
  while self.residual_.v >= step {
    self.residual_.v = self.residual_.v - step
    steps += 1
  }
  while self.residual_.v <= -step {
    self.residual_.v = self.residual_.v + step
    steps -= 1
  }
  steps
}

/// Feed an absolute 1D position `pos` and return the integer step delta since the previous position.
pub fn ScrubStepper::on_move(self : ScrubStepper, pos : Double) -> Int {
  if !self.has_anchor.v {
    self.on_down(pos)
    return 0
  }
  let dx = pos - self.last_pos.v
  self.last_pos.v = pos
  self.on_delta(dx)
}

/// End the scrub gesture and clear residual/active state.
pub fn ScrubStepper::on_up(self : ScrubStepper) -> Unit {
  self.reset()
}

/// Reset all internal state to inactive.
pub fn ScrubStepper::reset(self : ScrubStepper) -> Unit {
  self.has_anchor.v = false
  self.last_pos.v = 0.0
  self.deadzone_acc.v = 0.0
  self.residual_.v = 0.0
  self.active_sig.set(false)
}
