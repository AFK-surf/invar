// The host's key codes and modifier bits, the same numbers `ui` gives them (packages/ui/src/keys.pion):
// one place for every headless controller to read them from, so a key is never read by a private number
// of its own (13 is Copy, never Delete). `packages/aura/src/wave0_r2a_integration_test.pion` holds the two lists equal.

pub let key_backspace : Int = 1
pub let key_delete : Int = 2
pub let key_left : Int = 3
pub let key_right : Int = 4
pub let key_up : Int = 5
pub let key_down : Int = 6
pub let key_enter : Int = 7
pub let key_home : Int = 8
pub let key_end : Int = 9
pub let key_select_all : Int = 12
pub let key_copy : Int = 13
pub let key_cut : Int = 14
pub let key_page_up : Int = 15
pub let key_page_down : Int = 16
pub let key_escape : Int = 17
pub let key_tab : Int = 18

/// A printable key: `key_char_base` + its lowercase code point (`ui::key_of_char`).
pub let key_char_base : Int = 1000
pub let key_space : Int = 1032

pub let mod_shift : Int = 1
pub let mod_ctrl : Int = 2
pub let mod_alt : Int = 4
pub let mod_cmd : Int = 8
