// Pure 2D triangle containment and submenu aiming-corridor geometry.
// Zero view, layout, or renderer dependencies.

fn tri_sign(px : Double, py : Double, ax : Double, ay : Double, bx : Double, by : Double) -> Double {
  (px - bx) * (ay - by) - (ax - bx) * (py - by)
}

/// Whether 2D point `(px, py)` lies inside or on the boundary of triangle `(a, b, c)`.
/// Returns `false` for degenerate (zero-area) triangles.
pub fn point_in_triangle(
  px : Double,
  py : Double,
  ax : Double,
  ay : Double,
  bx : Double,
  by : Double,
  cx : Double,
  cy : Double,
) -> Bool {
  let area2 = (bx - ax) * (cy - ay) - (cx - ax) * (by - ay)
  if area2 == 0.0 {
    return false
  }
  let d1 = tri_sign(px, py, ax, ay, bx, by)
  let d2 = tri_sign(px, py, bx, by, cx, cy)
  let d3 = tri_sign(px, py, cx, cy, ax, ay)
  let has_neg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0
  let has_pos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0
  !(has_neg && has_pos)
}

/// Whether pointer `(px, py)` lies within the aiming corridor from trigger leave point `(lx, ly)`
/// toward submenu rectangle `(mx, my, mw, mh)` (or already inside the submenu rectangle).
pub fn submenu_in_aim_corridor(
  px : Double,
  py : Double,
  lx : Double,
  ly : Double,
  mx : Double,
  my : Double,
  mw : Double,
  mh : Double,
) -> Bool {
  if mw <= 0.0 || mh <= 0.0 {
    return false
  }
  let mx2 = mx + mw
  let my2 = my + mh
  if px >= mx && px <= mx2 && py >= my && py <= my2 {
    return true
  }
  if lx < mx && point_in_triangle(px, py, lx, ly, mx, my, mx, my2) {
    return true
  }
  if lx > mx2 && point_in_triangle(px, py, lx, ly, mx2, my, mx2, my2) {
    return true
  }
  if ly < my && point_in_triangle(px, py, lx, ly, mx, my, mx2, my) {
    return true
  }
  if ly > my2 && point_in_triangle(px, py, lx, ly, mx, my2, mx2, my2) {
    return true
  }
  false
}
