// Shared tooltip warmup/cooldown hover state machine with reactive `active_id` signal.

import "signals"

/// Hover warmup/cooldown state machine shared by a group of tooltip triggers.
pub struct TooltipWarmup {
  open_delay_ms : Double
  warmup_ms : Double
  pub active_id : signals::Signal[Option[Int]]
  pending : signals::Ref[Option[(Int, Double)]]
  closed_at : signals::Ref[Option[Double]]
}

/// Create a `TooltipWarmup` controller with cold open delay and post-close warmup window.
pub fn TooltipWarmup::new(
  open_delay_ms~ : Double = 400.0,
  warmup_ms~ : Double = 300.0,
) -> TooltipWarmup {
  TooltipWarmup::{
    open_delay_ms: if open_delay_ms >= 0.0 { open_delay_ms } else { 0.0 },
    warmup_ms: if warmup_ms >= 0.0 { warmup_ms } else { 0.0 },
    active_id: signals::signal_by(None, opt_int_eq),
    pending: ref_new(None),
    closed_at: ref_new(None),
  }
}

/// Whether the group is currently warm (either a tooltip is open or one closed within `warmup_ms`).
pub fn TooltipWarmup::is_warm(self : TooltipWarmup, now_ms : Double) -> Bool {
  if self.active_id.untracked() is Some(_) {
    return true
  }
  match self.closed_at.v {
    Some(at) => now_ms - at <= self.warmup_ms
    None => false
  }
}

/// Currently active tooltip trigger ID (reactive).
pub fn TooltipWarmup::active(self : TooltipWarmup) -> Option[Int] {
  self.active_id.get()
}

/// Next scheduled open timestamp if waiting for `open_delay_ms`.
pub fn TooltipWarmup::next_due_ms(self : TooltipWarmup) -> Option[Double] {
  match self.pending.v {
    Some((_, due)) => Some(due)
    None => None
  }
}

/// Pointer entered trigger `id` at `now_ms`. Opens immediately if warm, otherwise schedules open.
pub fn TooltipWarmup::on_enter(self : TooltipWarmup, id : Int, now_ms : Double) -> Option[Int] {
  if self.is_warm(now_ms) {
    self.pending.v = None
    self.active_id.set(Some(id))
  } else {
    self.pending.v = Some((id, now_ms + self.open_delay_ms))
  }
  self.active_id.untracked()
}

/// Pointer left trigger `id` at `now_ms`. Cancels pending open or closes active tooltip and starts cooldown.
pub fn TooltipWarmup::on_leave(self : TooltipWarmup, id : Int, now_ms : Double) -> Unit {
  match self.pending.v {
    Some((pid, _)) => if pid == id { self.pending.v = None }
    None => ()
  }
  match self.active_id.untracked() {
    Some(aid) =>
      if aid == id {
        self.closed_at.v = Some(now_ms)
        self.active_id.set(None)
      }
    None => ()
  }
}

/// Advance clock to `now_ms`, opening a pending tooltip if its delay has elapsed.
pub fn TooltipWarmup::on_tick(self : TooltipWarmup, now_ms : Double) -> Option[Int] {
  match self.pending.v {
    Some((pid, due)) =>
      if now_ms >= due {
        self.pending.v = None
        self.active_id.set(Some(pid))
      }
    None => ()
  }
  self.active_id.untracked()
}

/// Force-close any open or pending tooltip at `now_ms`.
pub fn TooltipWarmup::close(self : TooltipWarmup, now_ms : Double) -> Unit {
  self.pending.v = None
  if self.active_id.untracked() is Some(_) {
    self.closed_at.v = Some(now_ms)
    self.active_id.set(None)
  }
}
