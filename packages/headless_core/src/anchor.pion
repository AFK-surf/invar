// Pure scalar anchor placement (flip + viewport clamping) and drag edge-scroll speed.

/// Side of the anchor on which a floating popup is placed.
#derive(Eq)
pub enum AnchorSide {
  Below
  Above
  Right
  Left
}

/// Alignment along the chosen anchor side.
#derive(Eq)
pub enum AnchorAlign {
  Start
  Center
  End
}

/// Full placement result including flip state and available room on the chosen side.
#derive(Eq)
pub struct AnchorPlaced {
  pub x : Double
  pub y : Double
  pub side : AnchorSide
  pub flipped : Bool
  pub room : Double
}

/// Key code pointing back toward the anchor from a popup on `side` (Left 3, Right 4, Up 5, Down 6).
pub fn anchor_side_back_key(side : AnchorSide) -> Int {
  match side {
    Below => 5
    Above => 6
    Right => 3
    Left => 4
  }
}

fn align_factor(align : AnchorAlign) -> Double {
  match align {
    Start => 0.0
    Center => 0.5
    End => 1.0
  }
}

/// Compute full anchor placement with explicit viewport safe-area insets `(top, right, bottom, left)`.
pub fn anchor_place_insets(
  anchor : Rect,
  popup_w : Double,
  popup_h : Double,
  viewport : Rect,
  side~ : AnchorSide = AnchorSide::Below,
  align~ : AnchorAlign = AnchorAlign::Start,
  gap~ : Double = 0.0,
  insets~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
  flip~ : Bool = true,
) -> AnchorPlaced {
  let (it, ir, ib, il) = insets
  let left = viewport.x + il
  let top = viewport.y + it
  let right = viewport.x + viewport.w - ir
  let bottom = viewport.y + viewport.h - ib
  let max0 = fn(v : Double) -> Double { if v > 0.0 { v } else { 0.0 } }
  let below = max0(bottom - (anchor.y + anchor.h) - gap)
  let above = max0(anchor.y - gap - top)
  let after = max0(right - (anchor.x + anchor.w) - gap)
  let before = max0(anchor.x - gap - left)
  let (here, there, need, other) = match side {
    Below => (below, above, popup_h, AnchorSide::Above)
    Above => (above, below, popup_h, AnchorSide::Below)
    Right => (after, before, popup_w, AnchorSide::Left)
    Left => (before, after, popup_w, AnchorSide::Right)
  }
  let flipped = flip && need > here && there > here
  let chosen = if flipped { other } else { side }
  let room = if flipped { there } else { here }
  let k = align_factor(align)
  let (raw_x, raw_y) = match chosen {
    Below => (anchor.x + (anchor.w - popup_w) * k, anchor.y + anchor.h + gap)
    Above => (anchor.x + (anchor.w - popup_w) * k, anchor.y - gap - popup_h)
    Right => (anchor.x + anchor.w + gap, anchor.y + (anchor.h - popup_h) * k)
    Left => (anchor.x - gap - popup_w, anchor.y + (anchor.h - popup_h) * k)
  }
  AnchorPlaced::{
    x: clamp_double(raw_x, left, right - popup_w),
    y: clamp_double(raw_y, top, bottom - popup_h),
    side: chosen,
    flipped,
    room,
  }
}

/// Place a popup `(popup_w, popup_h)` beside `anchor` inside `viewport` (with uniform `pad`),
/// returning `(x, y, resolved_side)`. Pure scalar `Rect` only.
pub fn anchor_place(
  anchor : Rect,
  popup_w : Double,
  popup_h : Double,
  viewport : Rect,
  side~ : AnchorSide = AnchorSide::Below,
  align~ : AnchorAlign = AnchorAlign::Start,
  gap~ : Double = 0.0,
  pad~ : Double = 0.0,
  flip~ : Bool = true,
) -> (Double, Double, AnchorSide) {
  let placed = anchor_place_insets(
    anchor,
    popup_w,
    popup_h,
    viewport,
    side=side,
    align=align,
    gap=gap,
    insets=(pad, pad, pad, pad),
    flip=flip,
  )
  (placed.x, placed.y, placed.side)
}

/// Compute auto-scroll velocity while a drag is held at `pos` along `[start, end]`.
pub fn edge_scroll_speed(
  pos : Double,
  start : Double,
  end : Double,
  zone~ : Double,
  max_speed~ : Double,
) -> Double {
  let span = end - start
  if span <= 0.0 || zone <= 0.0 || max_speed <= 0.0 {
    return 0.0
  }
  let z = if zone * 2.0 > span { span / 2.0 } else { zone }
  let into = fn(d : Double) -> Double {
    let f = if d >= z { 1.0 } else { d / z }
    max_speed * f * f
  }
  if pos < start + z {
    -into(start + z - pos)
  } else if pos > end - z {
    into(pos - (end - z))
  } else {
    0.0
  }
}
