// Pure ID-based overlay stack with escape/outside dismiss policy and reactive open_count signal.

import "signals"

/// Reason for dismissing the topmost eligible overlay.
#derive(Eq)
pub enum OverlayDismissReason {
  Escape
  Outside
  Back
}

/// One layer entry in `OverlayStackCore`.
pub struct OverlayLayer {
  pub id : Int
  pub close_on_escape : Bool
  pub close_on_outside : Bool
}

/// Pure ID stack for dialogs, popovers, sheets, and menus.
pub struct OverlayStackCore {
  entries : Array[OverlayLayer]
  pub open_count : signals::Signal[Int]
  version : signals::Signal[Int]
}

pub fn OverlayStackCore::new() -> OverlayStackCore {
  OverlayStackCore::{
    entries: [],
    open_count: signals::signal(0),
    version: signals::signal(0),
  }
}

fn OverlayStackCore::sync_signals(self : OverlayStackCore) -> Unit {
  self.open_count.set(self.entries.length())
  self.version.set(self.version.untracked() + 1)
}

/// Push layer `id` onto the top of the stack (if already present, moves it to the top with updated flags).
pub fn OverlayStackCore::push(
  self : OverlayStackCore,
  id : Int,
  close_on_escape~ : Bool = true,
  close_on_outside~ : Bool = true,
) -> Unit {
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].id == id {
      let _ = array_remove(self.entries, i)
      break
    }
    i += 1
  }
  self.entries.push(OverlayLayer::{ id, close_on_escape, close_on_outside })
  self.sync_signals()
}

/// Remove layer `id` from the stack. Returns `true` if it was present.
pub fn OverlayStackCore::remove(self : OverlayStackCore, id : Int) -> Bool {
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].id == id {
      let _ = array_remove(self.entries, i)
      self.sync_signals()
      return true
    }
    i += 1
  }
  false
}

/// Move an existing layer `id` to the top of the stack.
pub fn OverlayStackCore::bring_to_top(self : OverlayStackCore, id : Int) -> Bool {
  let n = self.entries.length()
  let mut i = 0
  while i < n {
    if self.entries[i].id == id {
      if i < n - 1 {
        let entry = array_remove(self.entries, i)
        self.entries.push(entry)
        self.sync_signals()
      }
      return true
    }
    i += 1
  }
  false
}

/// Topmost layer ID, if any (reactive).
pub fn OverlayStackCore::top(self : OverlayStackCore) -> Option[Int] {
  let _ = self.version.get()
  let n = self.entries.length()
  if n > 0 {
    Some(self.entries[n - 1].id)
  } else {
    None
  }
}

/// Whether `id` is currently the topmost layer (reactive).
pub fn OverlayStackCore::is_top(self : OverlayStackCore, id : Int) -> Bool {
  match self.top() {
    Some(tid) => tid == id
    None => false
  }
}

/// Stack depth of `id` (0 = lowest; -1 = absent, reactive).
pub fn OverlayStackCore::depth(self : OverlayStackCore, id : Int) -> Int {
  let _ = self.version.get()
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].id == id {
      return i
    }
    i += 1
  }
  -1
}

/// Number of layers currently in the stack (reactive).
pub fn OverlayStackCore::count(self : OverlayStackCore) -> Int {
  self.open_count.get()
}

/// Dismiss and remove the topmost layer eligible for `reason`. Returns its ID if dismissed.
pub fn OverlayStackCore::dismiss_top(
  self : OverlayStackCore,
  reason : OverlayDismissReason,
) -> Option[Int] {
  let mut i = self.entries.length() - 1
  while i >= 0 {
    let e = self.entries[i]
    let ok = match reason {
      Escape | Back => e.close_on_escape
      Outside => e.close_on_outside
    }
    if ok {
      let _ = array_remove(self.entries, i)
      self.sync_signals()
      return Some(e.id)
    }
    i -= 1
  }
  None
}
