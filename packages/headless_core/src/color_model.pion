// Headless color model reusing Layer-0 `packages/color`:
// HSVA / HSLA / RGBA / OKLCH conversions, channel read/write/step, and hex formatting/parsing.

import "color"
import "dmath"

/// Color channel selector for `ColorArea` and `ColorSlider`.
#derive(Eq)
pub enum ColorChannel {
  Hue
  Saturation
  Brightness
  HslSaturation
  Lightness
  Red
  Green
  Blue
  Alpha
}

/// Canonical color model preserving hue across zero-saturation / zero-brightness edits.
#derive(Eq)
pub struct ColorModel {
  /// Hue in `[0.0, 360.0)`
  pub h : Double
  /// HSV saturation in `[0.0, 1.0]`
  pub s : Double
  /// HSV value / brightness in `[0.0, 1.0]`
  pub v : Double
  /// Alpha in `[0.0, 1.0]`
  pub alpha : Double
}

fn wrap_hue(h : Double) -> Double {
  let m = h - (h / 360.0).floor() * 360.0
  if m < 0.0 {
    m + 360.0
  } else if m >= 360.0 {
    m - 360.0
  } else {
    m
  }
}

/// Construct a `ColorModel` from HSVA (`h` in `[0, 360)`, `s`/`v`/`alpha` in `[0, 1]`).
pub fn ColorModel::from_hsva(h : Double, s : Double, v : Double, alpha~ : Double = 1.0) -> ColorModel {
  ColorModel::{
    h: wrap_hue(h),
    s: dmath::clamp(s, 0.0, 1.0),
    v: dmath::clamp(v, 0.0, 1.0),
    alpha: dmath::clamp(alpha, 0.0, 1.0),
  }
}

/// Construct a `ColorModel` from `color::Srgba` (`r, g, b, alpha` in `[0, 1]`).
pub fn ColorModel::from_srgba(c : color::Srgba, fallback_hue~ : Double = 0.0) -> ColorModel {
  let r = dmath::clamp(c.r, 0.0, 1.0)
  let g = dmath::clamp(c.g, 0.0, 1.0)
  let b = dmath::clamp(c.b, 0.0, 1.0)
  let max_c = dmath::max(r, dmath::max(g, b))
  let min_c = dmath::min(r, dmath::min(g, b))
  let delta = max_c - min_c
  let h = if delta < 1.0e-7 {
    wrap_hue(fallback_hue)
  } else if max_c == r {
    wrap_hue(60.0 * ((g - b) / delta))
  } else if max_c == g {
    wrap_hue(60.0 * ((b - r) / delta + 2.0))
  } else {
    wrap_hue(60.0 * ((r - g) / delta + 4.0))
  }
  let s = if max_c < 1.0e-7 { 0.0 } else { delta / max_c }
  ColorModel::{ h, s, v: max_c, alpha: dmath::clamp(c.alpha, 0.0, 1.0) }
}

/// Construct a `ColorModel` from RGBA (`r, g, b, alpha` in `[0, 1]`).
pub fn ColorModel::from_rgba(r : Double, g : Double, b : Double, alpha~ : Double = 1.0) -> ColorModel {
  ColorModel::from_srgba(color::Srgba::new(r, g, b, alpha=alpha))
}

/// Construct a `ColorModel` from HSLA (`h` in `[0, 360)`, `s`/`l`/`alpha` in `[0, 1]`).
pub fn ColorModel::from_hsla(h : Double, s : Double, l : Double, alpha~ : Double = 1.0) -> ColorModel {
  let sc = dmath::clamp(s, 0.0, 1.0)
  let lc = dmath::clamp(l, 0.0, 1.0)
  let v = lc + sc * dmath::min(lc, 1.0 - lc)
  let sv = if v < 1.0e-7 { 0.0 } else { 2.0 * (1.0 - lc / v) }
  ColorModel::from_hsva(h, sv, v, alpha=alpha)
}

/// Convert to `color::Srgba`.
pub fn ColorModel::to_srgba(self : ColorModel) -> color::Srgba {
  let c = self.v * self.s
  let h6 = self.h / 60.0
  let x = c * (1.0 - dmath::abs(h6 - (h6 / 2.0).floor() * 2.0 - 1.0))
  let m = self.v - c
  let (r1, g1, b1) = if h6 < 1.0 {
    (c, x, 0.0)
  } else if h6 < 2.0 {
    (x, c, 0.0)
  } else if h6 < 3.0 {
    (0.0, c, x)
  } else if h6 < 4.0 {
    (0.0, x, c)
  } else if h6 < 5.0 {
    (x, 0.0, c)
  } else {
    (c, 0.0, x)
  }
  color::Srgba::new(
    dmath::clamp(r1 + m, 0.0, 1.0),
    dmath::clamp(g1 + m, 0.0, 1.0),
    dmath::clamp(b1 + m, 0.0, 1.0),
    alpha=self.alpha,
  )
}

/// Convert to HSVA tuple `(h, s, v, alpha)`.
pub fn ColorModel::to_hsva(self : ColorModel) -> (Double, Double, Double, Double) {
  (self.h, self.s, self.v, self.alpha)
}

/// Convert to HSLA tuple `(h, s, l, alpha)`.
pub fn ColorModel::to_hsla(self : ColorModel) -> (Double, Double, Double, Double) {
  let l = self.v * (1.0 - self.s * 0.5)
  let denom = dmath::min(l, 1.0 - l)
  let sl = if denom < 1.0e-7 { 0.0 } else { (self.v - l) / denom }
  (self.h, dmath::clamp(sl, 0.0, 1.0), dmath::clamp(l, 0.0, 1.0), self.alpha)
}

/// Convert to `color::Oklch` via Layer-0 `packages/color`.
pub fn ColorModel::to_oklch(self : ColorModel) -> color::Oklch {
  color::oklab_to_oklch(color::srgb_to_oklab(self.to_srgba()))
}

/// Pack as `0xRRGGBBAA` `Int64` via Layer-0 `packages/color`.
pub fn ColorModel::to_rgba8(self : ColorModel) -> Int64 {
  color::pack_rgba8(self.to_srgba())
}

/// Range `(min, max, step)` for `channel`.
pub fn color_channel_range(channel : ColorChannel) -> (Double, Double, Double) {
  match channel {
    ColorChannel::Hue => (0.0, 360.0, 1.0)
    ColorChannel::Saturation => (0.0, 1.0, 0.01)
    ColorChannel::Brightness => (0.0, 1.0, 0.01)
    ColorChannel::HslSaturation => (0.0, 1.0, 0.01)
    ColorChannel::Lightness => (0.0, 1.0, 0.01)
    ColorChannel::Red => (0.0, 255.0, 1.0)
    ColorChannel::Green => (0.0, 255.0, 1.0)
    ColorChannel::Blue => (0.0, 255.0, 1.0)
    ColorChannel::Alpha => (0.0, 1.0, 0.01)
  }
}

/// Read the value of `channel` in its native range.
pub fn ColorModel::channel(self : ColorModel, channel : ColorChannel) -> Double {
  match channel {
    ColorChannel::Hue => self.h
    ColorChannel::Saturation => self.s
    ColorChannel::Brightness => self.v
    ColorChannel::HslSaturation => self.to_hsla().1
    ColorChannel::Lightness => self.to_hsla().2
    ColorChannel::Red => (self.to_srgba().r * 255.0).round()
    ColorChannel::Green => (self.to_srgba().g * 255.0).round()
    ColorChannel::Blue => (self.to_srgba().b * 255.0).round()
    ColorChannel::Alpha => self.alpha
  }
}

/// Return a new `ColorModel` with `channel` updated to `value` (clamped/wrapped to its range).
pub fn ColorModel::with_channel(self : ColorModel, channel : ColorChannel, value : Double) -> ColorModel {
  match channel {
    ColorChannel::Hue => ColorModel::{ h: wrap_hue(value), s: self.s, v: self.v, alpha: self.alpha }
    ColorChannel::Saturation => ColorModel::{ h: self.h, s: dmath::clamp(value, 0.0, 1.0), v: self.v, alpha: self.alpha }
    ColorChannel::Brightness => ColorModel::{ h: self.h, s: self.s, v: dmath::clamp(value, 0.0, 1.0), alpha: self.alpha }
    ColorChannel::HslSaturation => {
      let (_, _, l, a) = self.to_hsla()
      ColorModel::from_hsla(self.h, dmath::clamp(value, 0.0, 1.0), l, alpha=a)
    }
    ColorChannel::Lightness => {
      let (_, sl, _, a) = self.to_hsla()
      ColorModel::from_hsla(self.h, sl, dmath::clamp(value, 0.0, 1.0), alpha=a)
    }
    ColorChannel::Red => {
      let c = self.to_srgba()
      ColorModel::from_srgba(color::Srgba::new(dmath::clamp(value / 255.0, 0.0, 1.0), c.g, c.b, alpha=c.alpha), fallback_hue=self.h)
    }
    ColorChannel::Green => {
      let c = self.to_srgba()
      ColorModel::from_srgba(color::Srgba::new(c.r, dmath::clamp(value / 255.0, 0.0, 1.0), c.b, alpha=c.alpha), fallback_hue=self.h)
    }
    ColorChannel::Blue => {
      let c = self.to_srgba()
      ColorModel::from_srgba(color::Srgba::new(c.r, c.g, dmath::clamp(value / 255.0, 0.0, 1.0), alpha=c.alpha), fallback_hue=self.h)
    }
    ColorChannel::Alpha => ColorModel::{ h: self.h, s: self.s, v: self.v, alpha: dmath::clamp(value, 0.0, 1.0) }
  }
}

/// Read normalized `[0.0, 1.0]` fraction of `channel`.
pub fn ColorModel::channel_norm(self : ColorModel, channel : ColorChannel) -> Double {
  let (lo, hi, _) = color_channel_range(channel)
  if hi <= lo {
    0.0
  } else {
    dmath::clamp((self.channel(channel) - lo) / (hi - lo), 0.0, 1.0)
  }
}

/// Set `channel` from normalized `[0.0, 1.0]` fraction.
pub fn ColorModel::with_channel_norm(self : ColorModel, channel : ColorChannel, t : Double) -> ColorModel {
  let (lo, hi, _) = color_channel_range(channel)
  let tc = dmath::clamp(t, 0.0, 1.0)
  let v = if channel == ColorChannel::Hue {
    if tc >= 1.0 { 359.999 } else { lo + tc * (hi - lo) }
  } else {
    lo + tc * (hi - lo)
  }
  self.with_channel(channel, v)
}

/// Step `channel` by `dir` (`+1` / `-1`) times its default step (or `10x` when `large=true`).
pub fn ColorModel::step_channel(self : ColorModel, channel : ColorChannel, dir : Int, large~ : Bool = false) -> ColorModel {
  let (_, _, st) = color_channel_range(channel)
  let mult = if large { 10.0 } else { 1.0 }
  let delta = dir.to_double() * st * mult
  self.with_channel(channel, self.channel(channel) + delta)
}

fn hex_nibble(n : Int) -> Char {
  let v = n & 15
  if v < 10 { (48 + v).unsafe_to_char() } else { (65 + v - 10).unsafe_to_char() }
}

fn parse_hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else {
    -1
  }
}

/// Format as `#RRGGBB` (or `#RRGGBBAA` when `include_alpha=true`).
pub fn ColorModel::to_hex(self : ColorModel, include_alpha~ : Bool = false) -> String {
  let c = self.to_srgba()
  let r = dmath::clamp((c.r * 255.0).round(), 0.0, 255.0).to_int()
  let g = dmath::clamp((c.g * 255.0).round(), 0.0, 255.0).to_int()
  let b = dmath::clamp((c.b * 255.0).round(), 0.0, 255.0).to_int()
  let a = dmath::clamp((c.alpha * 255.0).round(), 0.0, 255.0).to_int()
  let sb = StringBuilder::new()
  sb.write_char('#')
  sb.write_char(hex_nibble(r >> 4))
  sb.write_char(hex_nibble(r))
  sb.write_char(hex_nibble(g >> 4))
  sb.write_char(hex_nibble(g))
  sb.write_char(hex_nibble(b >> 4))
  sb.write_char(hex_nibble(b))
  if include_alpha {
    sb.write_char(hex_nibble(a >> 4))
    sb.write_char(hex_nibble(a))
  }
  sb.to_string()
}

/// Parse `#RGB`, `#RRGGBB`, or `#RRGGBBAA` (leading `#` optional).
pub fn color_parse_hex(raw : String) -> Option[ColorModel] {
  let n = raw.length()
  let start = if n > 0 && raw.code_unit_at(0) == 35 { 1 } else { 0 }
  let len = n - start
  if len == 3 {
    let r = parse_hex_digit(raw.code_unit_at(start))
    let g = parse_hex_digit(raw.code_unit_at(start + 1))
    let b = parse_hex_digit(raw.code_unit_at(start + 2))
    if r < 0 || g < 0 || b < 0 { return None }
    return Some(ColorModel::from_rgba(((r << 4) | r).to_double() / 255.0, ((g << 4) | g).to_double() / 255.0, ((b << 4) | b).to_double() / 255.0))
  }
  if len == 6 || len == 8 {
    let r0 = parse_hex_digit(raw.code_unit_at(start))
    let r1 = parse_hex_digit(raw.code_unit_at(start + 1))
    let g0 = parse_hex_digit(raw.code_unit_at(start + 2))
    let g1 = parse_hex_digit(raw.code_unit_at(start + 3))
    let b0 = parse_hex_digit(raw.code_unit_at(start + 4))
    let b1 = parse_hex_digit(raw.code_unit_at(start + 5))
    if r0 < 0 || r1 < 0 || g0 < 0 || g1 < 0 || b0 < 0 || b1 < 0 { return None }
    let r = ((r0 << 4) | r1).to_double() / 255.0
    let g = ((g0 << 4) | g1).to_double() / 255.0
    let b = ((b0 << 4) | b1).to_double() / 255.0
    if len == 8 {
      let a0 = parse_hex_digit(raw.code_unit_at(start + 6))
      let a1 = parse_hex_digit(raw.code_unit_at(start + 7))
      if a0 < 0 || a1 < 0 { return None }
      let a = ((a0 << 4) | a1).to_double() / 255.0
      return Some(ColorModel::from_rgba(r, g, b, alpha=a))
    }
    return Some(ColorModel::from_rgba(r, g, b))
  }
  None
}
