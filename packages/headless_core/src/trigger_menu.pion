// Input trigger menu detection and replacement (`@`, `/`, `#`, etc.), UTF-16 & CJK safe.

import "signals"

/// Configuration for one trigger prefix (e.g. `@`, `/`, `#`).
pub struct TriggerRule {
  pub trigger : String
  pub allow_spaces : Bool
  pub min_query_len : Int
  pub max_query_len : Int
  pub require_boundary : Bool
}

/// Create a `TriggerRule` with sensible defaults.
pub fn TriggerRule::new(
  trigger : String,
  allow_spaces~ : Bool = false,
  min_query_len~ : Int = 0,
  max_query_len~ : Int = 64,
  require_boundary~ : Bool = true,
) -> TriggerRule {
  TriggerRule::{ trigger, allow_spaces, min_query_len, max_query_len, require_boundary }
}

/// A detected trigger match in UTF-16 code unit coordinates `[start, end)`.
#derive(Eq)
pub struct TriggerMatch {
  pub trigger : String
  pub query : String
  pub start : Int
  pub end : Int
}

fn is_ascii_word_cu(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_line_break_cu(c : Int) -> Bool {
  c == 0x0A || c == 0x0D
}

fn is_space_cu(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x3000
}

/// Detect the nearest active trigger before UTF-16 `cursor` in `text`.
/// Boundary check rejects ASCII word characters before the trigger (preventing `foo@bar`),
/// while permitting whitespace and CJK characters.
pub fn detect_trigger(
  text : String,
  cursor : Int,
  rules : Array[TriggerRule],
) -> Option[TriggerMatch] {
  let end = clamp_utf16_cursor(text, cursor)
  if rules.length() == 0 {
    return None
  }
  let mut best : Option[TriggerMatch] = None
  for rule in rules {
    let tlen = rule.trigger.length()
    if tlen == 0 || tlen > end {
      continue
    }
    let mut pos = end - tlen
    let min_pos = if end - tlen - rule.max_query_len > 0 { end - tlen - rule.max_query_len } else { 0 }
    while pos >= min_pos {
      if str_match_at(text, pos, rule.trigger) {
        let boundary_ok = !rule.require_boundary || pos == 0 || !is_ascii_word_cu(text.code_unit_at(pos - 1))
        if boundary_ok {
          let q_start = pos + tlen
          let q_len = end - q_start
          let mut valid = q_len >= rule.min_query_len && q_len <= rule.max_query_len
          if valid {
            let mut j = q_start
            while j < end {
              let cu = text.code_unit_at(j)
              if is_line_break_cu(cu) || (!rule.allow_spaces && is_space_cu(cu)) {
                valid = false
                break
              }
              j += 1
            }
          }
          if valid {
            let query = str_slice_to(str_slice_from(text, q_start), q_len)
            let cand = TriggerMatch::{ trigger: rule.trigger, query, start: pos, end }
            match best {
              Some(prev) => if cand.start > prev.start { best = Some(cand) }
              None => best = Some(cand)
            }
            break
          }
        }
      }
      if pos == 0 {
        break
      }
      let prev_cu = text.code_unit_at(pos - 1)
      if is_line_break_cu(prev_cu) || (!rule.allow_spaces && is_space_cu(prev_cu)) {
        if pos <= end - tlen {
          break
        }
      }
      pos -= 1
    }
  }
  best
}

/// Replace `[m.start, m.end)` in `text` with `replacement + suffix`, returning `(new_text, new_cursor)`.
pub fn apply_trigger(
  text : String,
  m : TriggerMatch,
  replacement : String,
  suffix~ : String = " ",
) -> (String, Int) {
  let n = text.length()
  let s = if m.start < 0 { 0 } else if m.start > n { n } else { m.start }
  let e = if m.end < s { s } else if m.end > n { n } else { m.end }
  let before = str_slice_to(text, s)
  let after = str_slice_from(text, e)
  let inserted = replacement + suffix
  let next_text = before + inserted + after
  (next_text, s + inserted.length())
}

fn opt_trigger_match_eq(a : Option[TriggerMatch], b : Option[TriggerMatch]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

let trigger_key_escape : Int = key_escape
let trigger_key_enter : Int = key_enter
let trigger_key_tab : Int = key_tab

/// Reactive state machine for an input-triggered autocomplete menu (`@mention`, `/command`, `#tag`).
pub struct TriggerMenu[K] {
  rules : Array[TriggerRule]
  on_apply : (String, Int, K) -> Unit
  suffix : String
  match_sig : signals::Signal[Option[TriggerMatch]]
  active_sig : signals::Signal[Int]
  dismissed_at : signals::Ref[Option[(Int, String)]]
}

/// Create a `TriggerMenu[K]` controller.
pub fn TriggerMenu::new[K](
  rules : Array[TriggerRule],
  on_apply : (String, Int, K) -> Unit,
  suffix~ : String = " ",
) -> TriggerMenu[K] {
  TriggerMenu::{
    rules,
    on_apply,
    suffix,
    match_sig: signals::signal_by(None, opt_trigger_match_eq),
    active_sig: signals::signal(0),
    dismissed_at: ref_new(None),
  }
}

/// Re-evaluate active trigger from `text` and UTF-16 `cursor`.
pub fn TriggerMenu::update[K](self : TriggerMenu[K], text : String, cursor : Int) -> Option[TriggerMatch] {
  let found = detect_trigger(text, cursor, self.rules)
  match found {
    Some(m) => {
      match self.dismissed_at.v {
        Some((ds, dt)) =>
          if ds == m.start && dt == m.trigger {
            self.match_sig.set(None)
            return None
          }
        None => ()
      }
      self.dismissed_at.v = None
      match self.match_sig.untracked() {
        Some(prev) =>
          if prev.start != m.start || prev.trigger != m.trigger || prev.query != m.query {
            self.active_sig.set(0)
          }
        None => self.active_sig.set(0)
      }
      self.match_sig.set(Some(m))
      Some(m)
    }
    None => {
      self.dismissed_at.v = None
      self.match_sig.set(None)
      None
    }
  }
}

pub fn TriggerMenu::active_match[K](self : TriggerMenu[K]) -> Option[TriggerMatch] {
  self.match_sig.get()
}

pub fn TriggerMenu::open[K](self : TriggerMenu[K]) -> Bool {
  self.match_sig.get() is Some(_)
}

pub fn TriggerMenu::active_index[K](self : TriggerMenu[K]) -> Int {
  self.active_sig.get()
}

pub fn TriggerMenu::set_active_index[K](self : TriggerMenu[K], index : Int) -> Unit {
  self.active_sig.set(if index < 0 { 0 } else { index })
}

/// Dismiss the current trigger menu until the cursor leaves this trigger token.
pub fn TriggerMenu::dismiss[K](self : TriggerMenu[K]) -> Unit {
  match self.match_sig.untracked() {
    Some(m) => self.dismissed_at.v = Some((m.start, m.trigger))
    None => ()
  }
  self.match_sig.set(None)
}

/// Accept `(key, replacement)` against `text`, invoking `on_apply(new_text, new_cursor, key)`.
pub fn TriggerMenu::accept[K](
  self : TriggerMenu[K],
  text : String,
  key : K,
  replacement : String,
) -> Bool {
  match self.match_sig.untracked() {
    Some(m) => {
      let (next_text, next_cursor) = apply_trigger(text, m, replacement, suffix=self.suffix)
      self.dismissed_at.v = None
      self.match_sig.set(None)
      self.active_sig.set(0)
      (self.on_apply)(next_text, next_cursor, key)
      true
    }
    None => false
  }
}

/// Handle Down/Up/Enter/Tab/Escape while the trigger menu is open.
pub fn TriggerMenu::handle_key[K](
  self : TriggerMenu[K],
  code : Int,
  items : Array[(K, String)],
  text : String,
) -> Bool {
  if self.match_sig.untracked() is None {
    return false
  }
  if code == trigger_key_escape {
    self.dismiss()
    return true
  }
  let n = items.length()
  if n == 0 {
    return false
  }
  let cur = self.active_sig.untracked()
  let clamped = if cur < 0 { 0 } else if cur >= n { n - 1 } else { cur }
  if code == key_down {
    self.active_sig.set((clamped + 1) % n)
    return true
  }
  if code == key_up {
    self.active_sig.set((clamped + n - 1) % n)
    return true
  }
  if code == trigger_key_enter || code == trigger_key_tab {
    let (k, rep) = items[clamped]
    return self.accept(text, k, rep)
  }
  false
}
