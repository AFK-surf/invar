// Pure single-list reorder (`ReorderCore[K]`) and cross-container transfer (`TransferCore[C, K]`)
// state machines with reactive draft signals.

import "signals"

/// Return a new array with the item at `from` moved to `to` (safe no-op if out of bounds).
pub fn reorder_apply[T](items : Array[T], from : Int, to : Int) -> Array[T] {
  let n = items.length()
  let out : Array[T] = []
  for x in items {
    out.push(x)
  }
  if n <= 1 || from < 0 || from >= n {
    return out
  }
  let dst = if to < 0 { 0 } else if to >= n { n - 1 } else { to }
  if from == dst {
    return out
  }
  let moved = array_remove(out, from)
  let res : Array[T] = []
  let mut i = 0
  while i <= out.length() {
    if i == dst {
      res.push(moved)
    }
    if i < out.length() {
      res.push(out[i])
    }
    i += 1
  }
  res
}

/// Active reorder draft while an item is grabbed.
pub struct ReorderDraft[K] {
  pub key : K
  pub from : Int
  pub to : Int
}

/// Pure reactive single-list reorder state machine.
pub struct ReorderCore[K] {
  draft_sig : signals::Signal[Option[ReorderDraft[K]]]
}

pub fn ReorderCore::new[K]() -> ReorderCore[K] {
  ReorderCore::{
    draft_sig: signals::signal_by(None, fn(_a : Option[ReorderDraft[K]], _b : Option[ReorderDraft[K]]) -> Bool { false }),
  }
}

pub fn ReorderCore::draft[K](self : ReorderCore[K]) -> Option[ReorderDraft[K]] {
  self.draft_sig.get()
}

pub fn ReorderCore::draft_untracked[K](self : ReorderCore[K]) -> Option[ReorderDraft[K]] {
  self.draft_sig.untracked()
}

pub fn ReorderCore::grabbed[K](self : ReorderCore[K]) -> Bool {
  self.draft_sig.get() is Some(_)
}

pub fn ReorderCore::grabbed_key[K](self : ReorderCore[K]) -> Option[K] {
  match self.draft_sig.get() {
    Some(d) => Some(d.key)
    None => None
  }
}

pub fn ReorderCore::grab_by[K](
  self : ReorderCore[K],
  order : Array[K],
  key : K,
  eq : (K, K) -> Bool,
) -> Bool {
  match array_search_fn(order, key, eq) {
    Some(idx) => {
      self.draft_sig.set(Some(ReorderDraft::{ key, from: idx, to: idx }))
      true
    }
    None => false
  }
}

pub fn ReorderCore::grab[K : CoreEq](self : ReorderCore[K], order : Array[K], key : K) -> Bool {
  self.grab_by(order, key, fn(a : K, b : K) -> Bool { a.eq(b) })
}

pub fn ReorderCore::move_to[K](self : ReorderCore[K], index : Int, count : Int) -> Bool {
  match self.draft_sig.untracked() {
    Some(d) => {
      if count <= 0 {
        return false
      }
      let next = if index < 0 { 0 } else if index >= count { count - 1 } else { index }
      if next != d.to {
        self.draft_sig.set(Some(ReorderDraft::{ key: d.key, from: d.from, to: next }))
      }
      true
    }
    None => false
  }
}

pub fn ReorderCore::move_by[K](self : ReorderCore[K], delta : Int, count : Int) -> Bool {
  match self.draft_sig.untracked() {
    Some(d) => self.move_to(d.to + delta, count)
    None => false
  }
}

/// Commit the active draft, returning `Some((from, to))` if a draft was active.
pub fn ReorderCore::commit[K](self : ReorderCore[K]) -> Option[(Int, Int)] {
  match self.draft_sig.untracked() {
    Some(d) => {
      self.draft_sig.set(None)
      Some((d.from, d.to))
    }
    None => None
  }
}

/// Cancel the active draft. Returns `true` if a draft was active.
pub fn ReorderCore::cancel[K](self : ReorderCore[K]) -> Bool {
  match self.draft_sig.untracked() {
    Some(_) => {
      self.draft_sig.set(None)
      true
    }
    None => false
  }
}

// ---------------------------------------------------------------------------
// Cross-container TransferCore[C, K]
// ---------------------------------------------------------------------------

/// Active cross-container transfer draft.
pub struct TransferDraft[C, K] {
  pub key : K
  pub from_col : C
  pub from_idx : Int
  pub to_col : C
  pub to_idx : Int
}

/// Pure reactive cross-container transfer state machine.
pub struct TransferCore[C, K] {
  draft_sig : signals::Signal[Option[TransferDraft[C, K]]]
}

pub fn TransferCore::new[C, K]() -> TransferCore[C, K] {
  TransferCore::{
    draft_sig: signals::signal_by(None, fn(_a : Option[TransferDraft[C, K]], _b : Option[TransferDraft[C, K]]) -> Bool { false }),
  }
}

pub fn TransferCore::draft[C, K](self : TransferCore[C, K]) -> Option[TransferDraft[C, K]] {
  self.draft_sig.get()
}

pub fn TransferCore::draft_untracked[C, K](self : TransferCore[C, K]) -> Option[TransferDraft[C, K]] {
  self.draft_sig.untracked()
}

pub fn TransferCore::grabbed[C, K](self : TransferCore[C, K]) -> Bool {
  self.draft_sig.get() is Some(_)
}

pub fn TransferCore::grab_by[C, K](
  self : TransferCore[C, K],
  col : C,
  items_in_col : Array[K],
  key : K,
  eq_k : (K, K) -> Bool,
) -> Bool {
  match array_search_fn(items_in_col, key, eq_k) {
    Some(idx) => {
      self.draft_sig.set(Some(TransferDraft::{ key, from_col: col, from_idx: idx, to_col: col, to_idx: idx }))
      true
    }
    None => false
  }
}

pub fn TransferCore::grab[C, K : CoreEq](
  self : TransferCore[C, K],
  col : C,
  items_in_col : Array[K],
  key : K,
) -> Bool {
  self.grab_by(col, items_in_col, key, fn(a : K, b : K) -> Bool { a.eq(b) })
}

pub fn TransferCore::move_to_by[C, K](
  self : TransferCore[C, K],
  col : C,
  index : Int,
  target_col_len : Int,
  eq_c : (C, C) -> Bool,
) -> Bool {
  match self.draft_sig.untracked() {
    Some(d) => {
      let max_idx = if eq_c(col, d.from_col) {
        if target_col_len > 0 { target_col_len - 1 } else { 0 }
      } else {
        target_col_len
      }
      let clamped = if index < 0 { 0 } else if index > max_idx { max_idx } else { index }
      self.draft_sig.set(Some(TransferDraft::{
        key: d.key,
        from_col: d.from_col,
        from_idx: d.from_idx,
        to_col: col,
        to_idx: clamped,
      }))
      true
    }
    None => false
  }
}

pub fn TransferCore::move_to[C : CoreEq, K](
  self : TransferCore[C, K],
  col : C,
  index : Int,
  target_col_len : Int,
) -> Bool {
  self.move_to_by(col, index, target_col_len, fn(a : C, b : C) -> Bool { a.eq(b) })
}

pub fn TransferCore::move_within_by[C, K](
  self : TransferCore[C, K],
  delta : Int,
  col_len : (C) -> Int,
  eq_c : (C, C) -> Bool,
) -> Bool {
  match self.draft_sig.untracked() {
    Some(d) => self.move_to_by(d.to_col, d.to_idx + delta, col_len(d.to_col), eq_c)
    None => false
  }
}

pub fn TransferCore::move_within[C : CoreEq, K](
  self : TransferCore[C, K],
  delta : Int,
  col_len : (C) -> Int,
) -> Bool {
  self.move_within_by(delta, col_len, fn(a : C, b : C) -> Bool { a.eq(b) })
}

pub fn TransferCore::move_to_column_by[C, K](
  self : TransferCore[C, K],
  col_delta : Int,
  columns : Array[C],
  col_len : (C) -> Int,
  eq_c : (C, C) -> Bool,
) -> Bool {
  match self.draft_sig.untracked() {
    Some(d) =>
      match array_search_fn(columns, d.to_col, eq_c) {
        Some(ci) => {
          let next_ci = ci + col_delta
          if next_ci < 0 || next_ci >= columns.length() {
            return false
          }
          let next_col = columns[next_ci]
          self.move_to_by(next_col, d.to_idx, col_len(next_col), eq_c)
        }
        None => false
      }
    None => false
  }
}

pub fn TransferCore::move_to_column[C : CoreEq, K](
  self : TransferCore[C, K],
  col_delta : Int,
  columns : Array[C],
  col_len : (C) -> Int,
) -> Bool {
  self.move_to_column_by(col_delta, columns, col_len, fn(a : C, b : C) -> Bool { a.eq(b) })
}

/// Commit the active transfer draft, returning the committed draft if one was active.
pub fn TransferCore::commit[C, K](self : TransferCore[C, K]) -> Option[TransferDraft[C, K]] {
  match self.draft_sig.untracked() {
    Some(d) => {
      self.draft_sig.set(None)
      Some(d)
    }
    None => None
  }
}

/// Cancel the active transfer draft. Returns `true` if one was active.
pub fn TransferCore::cancel[C, K](self : TransferCore[C, K]) -> Bool {
  match self.draft_sig.untracked() {
    Some(_) => {
      self.draft_sig.set(None)
      true
    }
    None => false
  }
}
