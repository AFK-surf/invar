// Pure pagination token model with boundary/sibling ellipsis collapsing.

/// One item in a pagination bar: either a 1-based page number or an ellipsis gap.
#derive(Eq)
pub enum PageToken {
  Page(Int)
  Ellipsis
}

/// Compute the ordered list of pagination tokens for `total` pages (1-based) and `current` page,
/// keeping `boundaries` pages at each end and `siblings` pages on each side of `current`.
pub fn pagination_items(
  total : Int,
  current : Int,
  siblings~ : Int = 1,
  boundaries~ : Int = 1,
) -> Array[PageToken] {
  let out : Array[PageToken] = []
  if total <= 0 {
    return out
  }
  let cur = if current < 1 { 1 } else if current > total { total } else { current }
  let sib = if siblings < 0 { 0 } else { siblings }
  let bnd = if boundaries < 0 { 0 } else { boundaries }

  // Total slots that fit without needing any ellipsis
  let total_slots = bnd * 2 + sib * 2 + 3
  if total <= total_slots {
    let mut p = 1
    while p <= total {
      out.push(PageToken::Page(p))
      p += 1
    }
    return out
  }

  let left_sib = if cur - sib > bnd + 2 { cur - sib } else { bnd + 2 }
  let right_sib = if cur + sib < total - bnd - 1 { cur + sib } else { total - bnd - 1 }

  let show_left_dots = left_sib > bnd + 2
  let show_right_dots = right_sib < total - bnd - 1

  if !show_left_dots && show_right_dots {
    let left_count = bnd + sib * 2 + 2
    let mut p = 1
    while p <= left_count && p <= total {
      out.push(PageToken::Page(p))
      p += 1
    }
    out.push(PageToken::Ellipsis)
    let mut r = total - bnd + 1
    while r <= total {
      out.push(PageToken::Page(r))
      r += 1
    }
    return out
  }

  if show_left_dots && !show_right_dots {
    let mut p = 1
    while p <= bnd {
      out.push(PageToken::Page(p))
      p += 1
    }
    out.push(PageToken::Ellipsis)
    let right_start = total - (bnd + sib * 2 + 1)
    let mut r = if right_start < 1 { 1 } else { right_start }
    while r <= total {
      out.push(PageToken::Page(r))
      r += 1
    }
    return out
  }

  // Both ellipses shown
  let mut p = 1
  while p <= bnd {
    out.push(PageToken::Page(p))
    p += 1
  }
  out.push(PageToken::Ellipsis)
  let mut m = left_sib
  while m <= right_sib {
    out.push(PageToken::Page(m))
    m += 1
  }
  out.push(PageToken::Ellipsis)
  let mut r = total - bnd + 1
  while r <= total {
    out.push(PageToken::Page(r))
    r += 1
  }
  out
}
