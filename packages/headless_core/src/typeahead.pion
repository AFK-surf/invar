// Pure timestamp-window prefix accumulation and cyclic matching for keyboard typeahead.

/// Incremental prefix-search state machine with configurable expiration window.
import "signals"

pub struct TypeaheadMatcher {
  window_ms : Double
  typed : signals::Ref[(String, Double)]
}

/// Create a `TypeaheadMatcher` whose accumulated prefix resets after `window_ms` ms.
pub fn TypeaheadMatcher::new(window_ms~ : Double = 500.0) -> TypeaheadMatcher {
  TypeaheadMatcher::{ window_ms, typed: ref_new(("", 0.0)) }
}

/// Clear any accumulated prefix.
pub fn TypeaheadMatcher::reset(self : TypeaheadMatcher) -> Unit {
  self.typed.v = ("", 0.0)
}

/// Currently accumulated lowercase prefix buffer.
pub fn TypeaheadMatcher::buffer(self : TypeaheadMatcher) -> String {
  self.typed.v.0
}

/// Feed character `c` at timestamp `at` and find the next matching index among `0..<count`.
/// Repeating the same letter cycles forward from `current`; multi-character prefixes match from `current`.
pub fn TypeaheadMatcher::match_next(
  self : TypeaheadMatcher,
  c : Char,
  at : Double,
  count : Int,
  current : Option[Int],
  text_of : (Int) -> String,
) -> Option[Int] {
  let small = ascii_lower(c.to_string())
  let (was, last) = self.typed.v
  let now = if was != "" && at - last <= self.window_ms { was + small } else { small }
  self.typed.v = (now, at)
  if count <= 0 {
    return None
  }
  let first_code = if small.length() > 0 { small.code_unit_at(0) } else { 32 }
  let (find, from_next) = if str_all_code(now, first_code) { (small, true) } else { (now, false) }
  let start = match current {
    Some(i) => if from_next { i + 1 } else { i }
    None => 0
  }
  let mut d = 0
  while d < count {
    let i = (start + d) % count
    if str_has_prefix(ascii_lower(text_of(i)), find) {
      return Some(i)
    }
    d += 1
  }
  None
}

/// Convenience wrapper matching directly against `labels : Array[String]`.
pub fn TypeaheadMatcher::match_at(
  self : TypeaheadMatcher,
  c : Char,
  now_ms : Double,
  labels : Array[String],
  current : Option[Int],
) -> Option[Int] {
  self.match_next(c, now_ms, labels.length(), current, fn(i : Int) -> String { labels[i] })
}
