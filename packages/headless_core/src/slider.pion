// Pure numeric range, snapping, normalization, rounding, formatting, and parsing helpers.

import "dmath"

/// Clamp `x` to `[lo, hi]`.
pub fn slider_clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

/// Hold `x` within `[min, max]`, snapping to the nearest `step` from `min` when `step > 0`.
pub fn slider_snap(x : Double, min : Double, max : Double, step : Double) -> Double {
  let clamped = slider_clamp(x, min, max)
  if step > 0.0 {
    let k = dmath::round((clamped - min) / step)
    slider_clamp(min + k * step, min, max)
  } else {
    clamped
  }
}

/// Normalized fraction in `[0.0, 1.0]` of `value` along `[min, max]`.
pub fn slider_part(value : Double, min : Double, max : Double) -> Double {
  let span = max - min
  if span <= 0.0 {
    0.0
  } else {
    slider_clamp((value - min) / span, 0.0, 1.0)
  }
}

/// Normalize `(lo_in, hi_in)` within `[min, max]` while enforcing `min_gap` anti-crossing bounds.
pub fn range_norm_pair(
  lo_in : Double,
  hi_in : Double,
  min : Double,
  max : Double,
  min_gap : Double,
) -> (Double, Double) {
  let gap = slider_clamp(min_gap, 0.0, max - min)
  let lo = slider_clamp(lo_in, min, max - gap)
  let hi = slider_clamp(hi_in, lo + gap, max)
  (lo, hi)
}

fn pow10_double(p : Int) -> Double {
  let mut r = 1.0
  let mut i = 0
  while i < p {
    r = r * 10.0
    i += 1
  }
  r
}

/// Round `x` to `precision` decimal places (`precision <= 0` rounds to nearest integer).
pub fn number_round(x : Double, precision : Int) -> Double {
  if precision <= 0 {
    dmath::round(x)
  } else {
    let scale = pow10_double(if precision > 9 { 9 } else { precision })
    dmath::round(x * scale) / scale
  }
}

/// Format `x` with fixed `precision` decimal places.
pub fn number_format(x : Double, precision : Int) -> String {
  let p = if precision < 0 { 0 } else if precision > 9 { 9 } else { precision }
  let rounded = number_round(x, p)
  if p == 0 {
    let iv = dmath::round(rounded).to_int()
    return iv.to_string()
  }
  let neg = rounded < 0.0
  let abs_v = if neg { -rounded } else { rounded }
  let scale = pow10_double(p)
  let total_units = dmath::round(abs_v * scale).to_int64()
  let scale_i = scale.to_int64()
  let int_part = total_units / scale_i
  let frac_part = total_units % scale_i
  let sb = StringBuilder::new()
  if neg && total_units != 0.to_int64() {
    sb.write_char('-')
  }
  sb.write_string(int_part.to_string())
  sb.write_char('.')
  let frac_str = frac_part.to_string()
  let mut pad = p - frac_str.length()
  while pad > 0 {
    sb.write_char('0')
    pad -= 1
  }
  sb.write_string(frac_str)
  sb.to_string()
}

/// Parse a decimal number from `raw` (trimming ASCII whitespace, supporting leading `+`/`-`).
pub fn number_parse(raw : String) -> Option[Double] {
  let s = str_trim(raw)
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let c0 = s.code_unit_at(0)
  if c0 == 45 {
    neg = true
    i = 1
  } else if c0 == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc = 0.0
  let mut saw_digit = false
  let mut saw_dot = false
  let mut frac = 0.1
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      saw_digit = true
      let d = (c - 48).to_double()
      if saw_dot {
        acc = acc + d * frac
        frac = frac * 0.1
      } else {
        acc = acc * 10.0 + d
      }
    } else if c == 46 && !saw_dot {
      saw_dot = true
    } else {
      return None
    }
    i += 1
  }
  if !saw_digit {
    return None
  }
  Some(if neg { -acc } else { acc })
}
