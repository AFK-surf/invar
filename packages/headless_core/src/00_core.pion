// Pure Layer-0 foundations for headless_core: CoreEq, Ref, pure scalar geometry, and array/string helpers.
// Zero view, layout, or renderer dependencies.

/// Value equality trait for generic keys in headless_core state machines.
pub trait CoreEq {
  fn eq(self : Self, other : Self) -> Bool
}

impl CoreEq for Int {
  fn eq(self : Int, other : Int) -> Bool { self == other }
}

impl CoreEq for Int64 {
  fn eq(self : Int64, other : Int64) -> Bool { self == other }
}

impl CoreEq for Double {
  fn eq(self : Double, other : Double) -> Bool { self == other }
}

impl CoreEq for Bool {
  fn eq(self : Bool, other : Bool) -> Bool { self == other }
}

impl CoreEq for String {
  fn eq(self : String, other : String) -> Bool { self == other }
}

impl CoreEq for Unit {
  fn eq(self : Unit, other : Unit) -> Bool { true }
}

/// Lightweight mutable cell without any view-tree dependency.
pub struct Ref[T] {
  pub mut v : T
}

/// Construct a new mutable `Ref[T]`.
pub fn ref_new[T](v : T) -> Ref[T] {
  Ref::{ v }
}

/// Pure scalar axis-aligned rectangle (independent of `view::Rect`).
#derive(Eq)
pub struct Rect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
}

pub fn Rect::new(x : Double, y : Double, w : Double, h : Double) -> Rect {
  Rect::{ x, y, w, h }
}

pub fn Rect::contains(self : Rect, px : Double, py : Double) -> Bool {
  px >= self.x && px <= self.x + self.w && py >= self.y && py <= self.y + self.h
}

/// Pure scalar 2D point.
#derive(Eq)
pub struct Point {
  pub x : Double
  pub y : Double
}

pub fn Point::new(x : Double, y : Double) -> Point {
  Point::{ x, y }
}

/// Clamp `x` to `[lo, hi]`. Returns `lo` if `hi < lo`.
pub fn clamp_double(x : Double, lo : Double, hi : Double) -> Double {
  if hi < lo || x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

/// Remove and return the element at `idx` from `arr`, shifting subsequent elements left.
pub fn array_remove[T](arr : Array[T], idx : Int) -> T {
  let v = arr[idx]
  let last = arr.length() - 1
  let mut i = idx
  while i < last {
    arr[i] = arr[i + 1]
    i += 1
  }
  let _ = arr.pop()
  v
}

/// Retain only elements in `arr` satisfying `pred`, preserving order.
pub fn array_retain[T](arr : Array[T], pred : (T) -> Bool) -> Unit {
  let mut w = 0
  let mut r = 0
  let n = arr.length()
  while r < n {
    if pred(arr[r]) {
      if w != r {
        arr[w] = arr[r]
      }
      w += 1
    }
    r += 1
  }
  while arr.length() > w {
    let _ = arr.pop()
  }
}

/// Return a new array containing elements of `arr` satisfying `pred`.
pub fn array_filter[T](arr : Array[T], pred : (T) -> Bool) -> Array[T] {
  let out : Array[T] = []
  for x in arr {
    if pred(x) {
      out.push(x)
    }
  }
  out
}

/// Map each element of `arr` through `f`.
pub fn array_map[T, U](arr : Array[T], f : (T) -> U) -> Array[U] {
  let out : Array[U] = []
  for x in arr {
    out.push(f(x))
  }
  out
}

/// Map and filter elements of `arr`.
pub fn array_filter_map[T, U](arr : Array[T], f : (T) -> Option[U]) -> Array[U] {
  let out : Array[U] = []
  for x in arr {
    match f(x) {
      Some(y) => out.push(y)
      None => ()
    }
  }
  out
}

/// Whether any element in `arr` satisfies `pred`.
pub fn array_any[T](arr : Array[T], pred : (T) -> Bool) -> Bool {
  for x in arr {
    if pred(x) {
      return true
    }
  }
  false
}

/// Find the first element in `arr` satisfying `pred`.
pub fn array_find_first[T](arr : Array[T], pred : (T) -> Bool) -> Option[T] {
  for x in arr {
    if pred(x) {
      return Some(x)
    }
  }
  None
}

/// Find the index of the first element in `arr` satisfying `pred`.
pub fn array_search_by[T](arr : Array[T], pred : (T) -> Bool) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if pred(arr[i]) {
      return Some(i)
    }
    i += 1
  }
  None
}

/// Find the index of the first element equal to `target` using `CoreEq`.
pub fn array_search_eq[T : CoreEq](arr : Array[T], target : T) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if arr[i].eq(target) {
      return Some(i)
    }
    i += 1
  }
  None
}

/// Find the index of the first element equal to `target` using a custom comparator `eq`.
pub fn array_search_fn[T](arr : Array[T], target : T, eq : (T, T) -> Bool) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if eq(arr[i], target) {
      return Some(i)
    }
    i += 1
  }
  None
}

/// Stable in-place sort of `arr` by `cmp`.
pub fn array_sort_by[T](arr : Array[T], cmp : (T, T) -> Int) -> Unit {
  let n = arr.length()
  if n <= 1 {
    return
  }
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && cmp(arr[j], key) > 0 {
      arr[j + 1] = arr[j]
      j -= 1
    }
    arr[j + 1] = key
    i += 1
  }
}

/// Append all elements of `src` to `dst`.
pub fn array_append[T](dst : Array[T], src : Array[T]) -> Unit {
  for x in src {
    dst.push(x)
  }
}

/// Check whether `arr` contains `x`.
pub fn int_array_contains(arr : Array[Int], x : Int) -> Bool {
  for v in arr {
    if v == x {
      return true
    }
  }
  false
}

/// Check whether `arr` contains `x`.
pub fn str_array_contains(arr : Array[String], x : String) -> Bool {
  for v in arr {
    if v == x {
      return true
    }
  }
  false
}

/// Slice `s` from index 0 to `end` (clamped to `[0, s.length()]`).
pub fn str_slice_to(s : String, end : Int) -> String {
  let e = if end < 0 { 0 } else if end > s.length() { s.length() } else { end }
  s.slice(0, e)
}

/// Slice `s` from `start` to the end (clamped to `[0, s.length()]`).
pub fn str_slice_from(s : String, start : Int) -> String {
  let st = if start < 0 { 0 } else if start > s.length() { s.length() } else { start }
  s.slice(st, s.length())
}

/// Trim ASCII whitespace from both ends of `s`.
pub fn str_trim(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let c = s.code_unit_at(start)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D {
      start += 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D {
      end -= 1
    } else {
      break
    }
  }
  if start == 0 && end == n {
    s
  } else {
    s.slice(start, end)
  }
}

/// Lowercase ASCII A..Z in `s`.
pub fn ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i += 1
  }
  sb.to_string()
}

/// Whether `s` starts with `prefix`.
pub fn str_has_prefix(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

/// Whether every UTF-16 code unit in `s` equals `ch`.
pub fn str_all_code(s : String, ch : Int) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) != ch {
      return false
    }
    i += 1
  }
  true
}

/// Clamp UTF-16 `cursor` to `[0, text.length()]` without splitting a surrogate pair.
pub fn clamp_utf16_cursor(text : String, cursor : Int) -> Int {
  let n = text.length()
  let mut c = if cursor < 0 { 0 } else if cursor > n { n } else { cursor }
  if c > 0 && c < n {
    let prev = text.code_unit_at(c - 1)
    let cur = text.code_unit_at(c)
    if prev >= 0xD800 && prev <= 0xDBFF && cur >= 0xDC00 && cur <= 0xDFFF {
      c -= 1
    }
  }
  c
}

/// Whether `text` matches `pat` starting at UTF-16 code-unit offset `pos`.
pub fn str_match_at(text : String, pos : Int, pat : String) -> Bool {
  let pn = pat.length()
  if pn == 0 || pos < 0 || pos + pn > text.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if text.code_unit_at(pos + i) != pat.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

/// Decode `s` into Unicode scalar code points (joining UTF-16 surrogate pairs).
pub fn str_to_codes(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu >= 0xD800 && cu <= 0xDBFF && i + 1 < n {
      let lo = s.code_unit_at(i + 1)
      if lo >= 0xDC00 && lo <= 0xDFFF {
        out.push(0x10000 + ((cu - 0xD800) << 10) + (lo - 0xDC00))
        i += 2
        continue
      }
    }
    out.push(cu)
    i += 1
  }
  out
}

fn opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}
