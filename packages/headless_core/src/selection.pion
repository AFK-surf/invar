// Pure reactive selection state machine supporting single-select, multi-select, range-select, and anchor signal.

import "signals"

/// Anchor-aware selection controller with a reactive `anchor` signal.
pub struct SelectionCore[K] {
  multiple : Bool
  anchor_sig : signals::Signal[Option[K]]
}

/// Create a `SelectionCore[K]` in single (`multiple=false`) or multi-select (`multiple=true`) mode.
pub fn SelectionCore::new[K](multiple~ : Bool = false) -> SelectionCore[K] {
  SelectionCore::{
    multiple,
    anchor_sig: signals::signal_by(None, same=fn(_a : Option[K], _b : Option[K]) -> Bool { false }),
  }
}

/// Whether multiple items may be selected at once.
pub fn SelectionCore::multiple[K](self : SelectionCore[K]) -> Bool {
  self.multiple
}

/// Current range-selection anchor key (reactive signal read).
pub fn SelectionCore::anchor[K](self : SelectionCore[K]) -> Option[K] {
  self.anchor_sig.get()
}

/// Set or clear the range-selection anchor key.
pub fn SelectionCore::set_anchor[K](self : SelectionCore[K], key : Option[K]) -> Unit {
  self.anchor_sig.set(key)
}

/// Toggle `key` against `current` using custom equality `eq` and update anchor to `Some(key)`.
pub fn SelectionCore::toggle_by[K](
  self : SelectionCore[K],
  current : Array[K],
  key : K,
  eq : (K, K) -> Bool,
) -> Array[K] {
  self.anchor_sig.set(Some(key))
  if !self.multiple {
    return [key]
  }
  let mut found = false
  let next : Array[K] = []
  for k in current {
    if eq(k, key) {
      found = true
    } else {
      next.push(k)
    }
  }
  if !found {
    next.push(key)
  }
  next
}

/// Toggle `key` against `current` using `CoreEq` and update anchor to `Some(key)`.
pub fn SelectionCore::toggle[K : CoreEq](
  self : SelectionCore[K],
  current : Array[K],
  key : K,
) -> Array[K] {
  self.toggle_by(current, key, fn(a : K, b : K) -> Bool { a.eq(b) })
}

/// Select the contiguous range in `order` from the current anchor to `target` (inclusive) using `eq`.
pub fn SelectionCore::select_range_by[K](
  self : SelectionCore[K],
  order : Array[K],
  target : K,
  eq : (K, K) -> Bool,
) -> Array[K] {
  if !self.multiple {
    self.anchor_sig.set(Some(target))
    return [target]
  }
  let target_idx = match array_search_fn(order, target, eq) {
    Some(i) => i
    None => return []
  }
  let anchor_idx = match self.anchor_sig.untracked() {
    Some(a) =>
      match array_search_fn(order, a, eq) {
        Some(ai) => ai
        None => {
          self.anchor_sig.set(Some(target))
          target_idx
        }
      }
    None => {
      self.anchor_sig.set(Some(target))
      target_idx
    }
  }
  let lo = if anchor_idx <= target_idx { anchor_idx } else { target_idx }
  let hi = if anchor_idx >= target_idx { anchor_idx } else { target_idx }
  let out : Array[K] = []
  let mut i = lo
  while i <= hi {
    out.push(order[i])
    i += 1
  }
  out
}

/// Select the contiguous range in `order` from the current anchor to `target` (inclusive).
pub fn SelectionCore::select_range[K : CoreEq](
  self : SelectionCore[K],
  order : Array[K],
  target : K,
) -> Array[K] {
  self.select_range_by(order, target, fn(a : K, b : K) -> Bool { a.eq(b) })
}

/// Select all keys in `order` (or the first key in single-select mode).
pub fn SelectionCore::select_all[K](self : SelectionCore[K], order : Array[K]) -> Array[K] {
  if !self.multiple {
    if order.length() > 0 {
      return [order[0]]
    }
    return []
  }
  let out : Array[K] = []
  for k in order {
    out.push(k)
  }
  out
}

/// Clear selection and reset the anchor.
pub fn SelectionCore::clear[K](self : SelectionCore[K]) -> Array[K] {
  self.anchor_sig.set(None)
  []
}
