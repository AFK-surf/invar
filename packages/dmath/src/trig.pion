// Ported from libs/mbui/src/dmath/trig.mbt (FreeBSD msun / SunPro).

pub fn tan(x : Double) -> Double {
  if is_inf(x) || is_nan(x) {
    return nan()
  }
  let y = [0.0, 0.0]
  if x.abs() <= pi_over_4_const {
    kernel_tan(x, 0.0, 1)
  } else {
    let n = rem_pio2(x, y)
    kernel_tan(y[0], y[1], 1 - ((n & 1) << 1))
  }
}

pub fn asin(x : Double) -> Double {
  let huge = 1.0e+300
  let pio4_hi = 7.85398163397448278999e-01
  let pio2_hi = 1.57079632679489655800
  let pio2_lo = 6.12323399573676603587e-17
  let ps0 = 1.66666666666666657415e-01
  let ps1 = -3.25565818622400915405e-01
  let ps2 = 2.01212532134862925881e-01
  let ps3 = -4.00555345006794114027e-02
  let ps4 = 7.91534994289814532176e-04
  let ps5 = 3.47933107596021167570e-05
  let qs1 = -2.40339491173441421878e+00
  let qs2 = 2.02094576023350569471e+00
  let qs3 = -6.88283971605453293030e-01
  let qs4 = 7.70381505559019352791e-02
  let ix = get_high_i32(x) & 0x7FFFFFFF
  let absx = x.abs()
  if absx >= 1.0 {
    if absx == 1.0 {
      return x * pio2_hi + x * pio2_lo
    } else {
      return nan()
    }
  } else if absx < 0.5 {
    if ix < 0x3E400000 {
      if huge + x > 1.0 {
        return x
      }
    } else {
      let t = x * x
      let p = t * (ps0 + t * (ps1 + t * (ps2 + t * (ps3 + t * (ps4 + t * ps5)))))
      let q = 1.0 + t * (qs1 + t * (qs2 + t * (qs3 + t * qs4)))
      let w = p / q
      return x + x * w
    }
  }
  let w = 1.0 - absx
  let t = w * 0.5
  let p = t * (ps0 + t * (ps1 + t * (ps2 + t * (ps3 + t * (ps4 + t * ps5)))))
  let q = 1.0 + t * (qs1 + t * (qs2 + t * (qs3 + t * qs4)))
  let s = t.sqrt()
  if ix >= 0x3FEF3333 {
    let w2 = p / q
    let t2 = pio2_hi - (2.0 * (s + s * w2) - pio2_lo)
    return if x > 0.0 { t2 } else { -t2 }
  } else {
    let mut w2 = s
    w2 = set_low_word(w2, 0.to_int64())
    let c = (t - w2 * w2) / (s + w2)
    let r = p / q
    let p2 = 2.0 * s * r - (pio2_lo - 2.0 * c)
    let q2 = pio4_hi - 2.0 * w2
    let t2 = pio4_hi - (p2 - q2)
    return if x > 0.0 { t2 } else { -t2 }
  }
}

pub fn acos(x : Double) -> Double {
  let one : Double = 1.0
  let pi_v : Double = 3.14159265358979311600
  let pio2_hi : Double = 1.57079632679489655800
  let pio2_lo : Double = 6.12323399573676603587e-17
  let ps0 : Double = 1.66666666666666657415e-01
  let ps1 : Double = -3.25565818622400915405e-01
  let ps2 : Double = 2.01212532134862925881e-01
  let ps3 : Double = -4.00555345006794114027e-02
  let ps4 : Double = 7.91534994289814532176e-04
  let ps5 : Double = 3.47933107596021167570e-05
  let qs1 : Double = -2.40339491173441421878e+00
  let qs2 : Double = 2.02094576023350569471e+00
  let qs3 : Double = -6.88283971605453293030e-01
  let qs4 : Double = 7.70381505559019352791e-02
  let ix = get_high_i32(x) & 0x7FFFFFFF
  let absx = x.abs()
  if absx >= 1.0 {
    if absx == 1.0 {
      if x > 0.0 {
        return 0.0
      } else {
        return pi_v + 2.0 * pio2_lo
      }
    }
    return nan()
  }
  if absx < 0.5 {
    if ix <= 0x3C600000 {
      return pio2_hi + pio2_lo
    }
    let z = x * x
    let p = z * (ps0 + z * (ps1 + z * (ps2 + z * (ps3 + z * (ps4 + z * ps5)))))
    let q = one + z * (qs1 + z * (qs2 + z * (qs3 + z * qs4)))
    let r = p / q
    pio2_hi - (x - (pio2_lo - x * r))
  } else if x < 0.0 {
    let z = (one + x) * 0.5
    let p = z * (ps0 + z * (ps1 + z * (ps2 + z * (ps3 + z * (ps4 + z * ps5)))))
    let q = one + z * (qs1 + z * (qs2 + z * (qs3 + z * qs4)))
    let s = z.sqrt()
    let r = p / q
    let w = r * s - pio2_lo
    pi_v - 2.0 * (s + w)
  } else {
    let z = (one - x) * 0.5
    let s = z.sqrt()
    let df = s
    let c = (z - df * df) / (s + df)
    let p = z * (ps0 + z * (ps1 + z * (ps2 + z * (ps3 + z * (ps4 + z * ps5)))))
    let q = one + z * (qs1 + z * (qs2 + z * (qs3 + z * qs4)))
    let r = p / q
    let w = r * s + c
    2.0 * (df + w)
  }
}

pub fn atan(x : Double) -> Double {
  if is_nan(x) || x == 0.0 {
    return x
  }
  let atan_hi = [
    4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01,
    1.57079632679489655800e+00,
  ]
  let atan_lo = [
    2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17,
    6.12323399573676603587e-17,
  ]
  let a_t = [
    3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01,
    -1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02,
    6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02,
    -3.65315727442169155270e-02, 1.62858201153657823623e-02,
  ]
  let one = 1.0
  let huge = 1.0e300
  let ix = get_high_i32(x) & 0x7FFFFFFF
  let mut id = 0
  let mut x = x
  let x_is_neg = x < 0.0
  if ix >= 0x44100000 {
    if x > 0.0 {
      return atan_hi[3] + atan_lo[3]
    } else {
      return -atan_hi[3] - atan_lo[3]
    }
  }
  if ix < 0x3FDC0000 {
    if ix < 0x3E200000 {
      if huge + x > one {
        return x
      }
    }
    id = -1
  } else {
    x = x.abs()
    if ix < 0x3FF30000 {
      if ix < 0x3FE60000 {
        id = 0
        x = (2.0 * x - one) / (2.0 + x)
      } else {
        id = 1
        x = (x - one) / (x + one)
      }
    } else if ix < 0x40038000 {
      id = 2
      x = (x - 1.5) / (one + 1.5 * x)
    } else {
      id = 3
      x = -1.0 / x
    }
  }
  let z = x * x
  let w = z * z
  let s1 = z * (a_t[0] + w * (a_t[2] + w * (a_t[4] + w * (a_t[6] + w * (a_t[8] + w * a_t[10])))))
  let s2 = w * (a_t[1] + w * (a_t[3] + w * (a_t[5] + w * (a_t[7] + w * a_t[9]))))
  if id < 0 {
    x - x * (s1 + s2)
  } else {
    let z2 = atan_hi[id] - (x * (s1 + s2) - atan_lo[id] - x)
    if x_is_neg { -z2 } else { z2 }
  }
}

pub fn atan2(y : Double, x : Double) -> Double {
  if is_nan(x) || is_nan(y) {
    return nan()
  }
  let tiny = 1.0e-300
  let zero = 0.0
  let pi_o_4 = 7.8539816339744827900e-01
  let pi_o_2 = 1.5707963267948965580e+00
  let pi_v = 3.1415926535897931160e+00
  let pi_lo = 1.2246467991473531772e-16
  let hx = get_high_i32(x)
  let hy = get_high_i32(y)
  let ix = hx & 0x7FFFFFFF
  let iy = hy & 0x7FFFFFFF
  if x == 1.0 {
    return atan(y)
  }
  let m = ((hy >> 31) & 1) | ((hx >> 30) & 2)
  if y == 0.0 {
    if m == 0 || m == 1 {
      return y
    } else if m == 2 {
      return pi_v + tiny
    } else {
      return -pi_v - tiny
    }
  }
  if x == 0.0 {
    return if hy < 0 { -pi_o_2 - tiny } else { pi_o_2 + tiny }
  }
  if is_inf(x) {
    if is_inf(y) {
      if m == 0 {
        return pi_o_4 + tiny
      } else if m == 1 {
        return -pi_o_4 - tiny
      } else if m == 2 {
        return 3.0 * pi_o_4 + tiny
      } else {
        return -3.0 * pi_o_4 - tiny
      }
    } else {
      if m == 0 {
        return zero
      } else if m == 1 {
        return -zero
      } else if m == 2 {
        return pi_v + tiny
      } else {
        return -pi_v - tiny
      }
    }
  }
  if is_inf(y) {
    return if hy < 0 { -pi_o_2 - tiny } else { pi_o_2 + tiny }
  }
  let k = (iy - ix) >> 20
  let z = if k > 60 {
    pi_o_2 + 0.5 * pi_lo
  } else if hx < 0 && k < -60 {
    0.0
  } else {
    atan((y / x).abs())
  }
  if m == 0 {
    z
  } else if m == 1 {
    -z
  } else if m == 2 {
    pi_v - (z - pi_lo)
  } else {
    z - pi_lo - pi_v
  }
}

fn rem_pio2(x : Double, y : Array[Double]) -> Int {
  let hx = get_high_i32(x)
  let ix : Int = hx & 0x7FFFFFFF
  let mut z = 0.0
  if ix <= 0x3FE921FB {
    y[0] = x
    y[1] = 0.0
    return 0
  }
  if ix < 0x4002D97C {
    if hx > 0 {
      z = x - pio2_1
      if ix != 0x3FF921FB {
        y[0] = z - pio2_1t
        y[1] = z - y[0] - pio2_1t
      } else {
        z = z - pio2_2
        y[0] = z - pio2_2t
        y[1] = z - y[0] - pio2_2t
      }
      return 1
    } else {
      z = x + pio2_1
      if ix != 0x3FF921FB {
        y[0] = z + pio2_1t
        y[1] = z - y[0] + pio2_1t
      } else {
        let z2 = z + pio2_2
        y[0] = z2 + pio2_2t
        y[1] = z2 - y[0] + pio2_2t
      }
      return -1
    }
  }
  if ix <= 0x413921FB {
    let npio2_hw = npio2_hw_table()
    let t = x.abs()
    let n = (t * inv_pio2 + half_const).to_int()
    let fn_v = n.to_double()
    let mut r = t - fn_v * pio2_1
    let mut w = fn_v * pio2_1t
    if n < 32 && ix != npio2_hw[n - 1] {
      y[0] = r - w
    } else {
      let j = ix >> 20
      y[0] = r - w
      let i = j - ((get_high_u32(y[0]) >> 20).to_int() & 0x7FF)
      if i > 16 {
        let t2 = r
        w = fn_v * pio2_2
        r = t2 - w
        w = fn_v * pio2_2t - (t2 - r - w)
        y[0] = r - w
        let i2 = j - ((get_high_u32(y[0]) >> 20).to_int() & 0x7FF)
        if i2 > 49 {
          let t3 = r
          w = fn_v * pio2_3
          r = t3 - w
          w = fn_v * pio2_3t - (t3 - r - w)
          y[0] = r - w
        }
      }
    }
    y[1] = r - y[0] - w
    if hx > 0 {
      return n
    } else {
      y[0] = -y[0]
      y[1] = -y[1]
      return -n
    }
  }
  if ix >= 0x7FF00000 {
    y[0] = x - x
    y[1] = y[0]
    return 0
  }
  z = set_low_word(z, get_low_u32(x))
  let e0 = (ix >> 20) - 1046
  z = set_high_word(z, (ix - (e0 << 20)).to_int64() & u32_mask())
  let tx = [0.0, 0.0, 0.0]
  for i in 0..<2 {
    tx[i] = z.to_int().to_double()
    z = (z - tx[i]) * two24_const
  }
  tx[2] = z
  let mut nx = 3
  while tx[nx - 1] == 0.0 {
    nx -= 1
  }
  let n = kernel_rem_pio2(tx, y, e0, nx, 2)
  if hx > 0 {
    n
  } else {
    y[0] = -y[0]
    y[1] = -y[1]
    -n
  }
}

fn kernel_rem_pio2(
  x : Array[Double],
  y : Array[Double],
  e0 : Int,
  nx : Int,
  prec : Int,
) -> Int {
  let two_over_pi = two_over_pi_table()
  let pi_over_2 = pi_over_2_table()
  let init_jk = [2, 3, 4, 6]
  let two24 : Double = 16777216.0
  let twon24 : Double = 5.96046447753906250000e-08

  let mut jz : Int = 0
  let mut jx : Int = 0
  let mut jv : Int = 0
  let mut jp : Int = 0
  let mut jk : Int = 0
  let mut carry : Int = 0
  let mut n : Int = 0
  let iq = make_ints(20, 0)
  let mut i : Int = 0
  let mut j : Int = 0
  let mut k : Int = 0
  let mut m : Int = 0
  let mut q0 : Int = 0
  let mut ih : Int = 0
  let mut z : Double = 0.0
  let mut fw : Double = 0.0
  let f = make_doubles(20, 0.0)
  let fq = make_doubles(20, 0.0)
  let q = make_doubles(20, 0.0)

  jk = init_jk[prec]
  jp = jk
  jx = nx - 1
  jv = (e0 - 3) / 24
  if jv < 0 {
    jv = 0
  }
  q0 = e0 - 24 * (jv + 1)

  j = jv - jx
  m = jx + jk
  i = 0
  while i <= m {
    f[i] = if j < 0 { 0.0 } else { two_over_pi[j].to_double() }
    i += 1
    j += 1
  }

  i = 0
  while i <= jk {
    j = 0
    fw = 0.0
    while j <= jx {
      fw += x[j] * f[jx + i - j]
      j += 1
    }
    q[i] = fw
    i += 1
  }
  jz = jk

  let mut recompute = true
  while recompute {
    recompute = false
    i = 0
    j = jz
    z = q[jz]
    while j > 0 {
      fw = (twon24 * z).floor()
      iq[i] = (z - two24 * fw).to_int()
      z = q[j - 1] + fw
      i += 1
      j -= 1
    }

    z = scalbn(z, q0)
    z -= 8.0 * (z * 0.125).floor()
    n = z.to_int()
    z -= n.to_double()
    ih = 0
    if q0 > 0 {
      i = iq[jz - 1] >> (24 - q0)
      n += i
      iq[jz - 1] -= i << (24 - q0)
      ih = iq[jz - 1] >> (23 - q0)
    } else if q0 == 0 {
      ih = iq[jz - 1] >> 23
    } else if z >= 0.5 {
      ih = 2
    }
    if ih > 0 {
      n += 1
      carry = 0
      i = 0
      while i < jz {
        j = iq[i]
        if carry == 0 {
          if j != 0 {
            carry = 1
            iq[i] = 0x1000000 - j
          }
        } else {
          iq[i] = 0xFFFFFF - j
        }
        i += 1
      }
      if q0 > 0 {
        if q0 == 1 {
          iq[jz - 1] = iq[jz - 1] & 0x7FFFFF
        } else if q0 == 2 {
          iq[jz - 1] = iq[jz - 1] & 0x3FFFFF
        }
      }
      if ih == 2 {
        z = 1.0 - z
        if carry != 0 {
          z -= scalbn(1.0, q0)
        }
      }
    }

    if z == 0.0 {
      j = 0
      i = jz - 1
      while i >= jk {
        j = j | iq[i]
        i -= 1
      }
      if j == 0 {
        k = 1
        while iq[jk - k] == 0 {
          k += 1
        }
        i = jz + 1
        while i <= jz + k {
          f[jx + i] = two_over_pi[jv + i].to_double()
          j = 0
          fw = 0.0
          while j <= jx {
            fw += x[j] * f[jx + i - j]
            j += 1
          }
          q[i] = fw
          i += 1
        }
        jz += k
        recompute = true
        continue
      }
    }

    if z == 0.0 {
      jz -= 1
      q0 -= 24
      while iq[jz] == 0 {
        jz -= 1
        q0 -= 24
      }
    } else {
      z = scalbn(z, -q0)
      if z >= two24 {
        fw = (twon24 * z).floor()
        iq[jz] = (z - two24 * fw).to_int()
        jz += 1
        q0 += 24
        iq[jz] = fw.to_int()
      } else {
        iq[jz] = z.to_int()
      }
    }

    fw = scalbn(1.0, q0)
    i = jz
    while i >= 0 {
      q[i] = fw * iq[i].to_double()
      fw *= twon24
      i -= 1
    }

    i = jz
    while i >= 0 {
      fw = 0.0
      k = 0
      while k <= jp && k <= jz - i {
        fw += pi_over_2[k] * q[i + k]
        k += 1
      }
      fq[jz - i] = fw
      i -= 1
    }

    if prec == 0 {
      fw = 0.0
      i = jz
      while i >= 0 {
        fw += fq[i]
        i -= 1
      }
      y[0] = if ih == 0 { fw } else { -fw }
    } else if prec == 1 || prec == 2 {
      fw = 0.0
      i = jz
      while i >= 0 {
        fw += fq[i]
        i -= 1
      }
      y[0] = if ih == 0 { fw } else { -fw }
      fw = fq[0] - fw
      i = 1
      while i <= jz {
        fw += fq[i]
        i += 1
      }
      y[1] = if ih == 0 { fw } else { -fw }
    } else if prec == 3 {
      i = jz
      while i > 0 {
        fw = fq[i - 1] + fq[i]
        fq[i] += fq[i - 1] - fw
        fq[i - 1] = fw
        i -= 1
      }
      i = jz
      while i > 1 {
        fw = fq[i - 1] + fq[i]
        fq[i] += fq[i - 1] - fw
        fq[i - 1] = fw
        i -= 1
      }
      fw = 0.0
      i = jz
      while i >= 2 {
        fw += fq[i]
        i -= 1
      }
      if ih == 0 {
        y[0] = fq[0]
        y[1] = fq[1]
        y[2] = fw
      } else {
        y[0] = -fq[0]
        y[1] = -fq[1]
        y[2] = -fw
      }
    }
  }
  n & 7
}

fn kernel_sin(x : Double, y : Double, iy : Int) -> Double {
  let s1 = -1.66666666666666324348e-01
  let s2 = 8.33333333332248946124e-03
  let s3 = -1.98412698298579493134e-04
  let s4 = 2.75573137070700676789e-06
  let s5 = -2.50507602534068634195e-08
  let s6 = 1.58969099521155010221e-10
  let ix = get_high_u32(x) & 0x7FFFFFFF.to_int64()
  if ix < 0x3E400000.to_int64() {
    if x.to_int() == 0 {
      return x
    }
  }
  let z = x * x
  let v = z * x
  let r = s2 + z * (s3 + z * (s4 + z * (s5 + z * s6)))
  if iy == 0 {
    x + v * (s1 + z * r)
  } else {
    x - (z * (0.5 * y - v * r) - y - v * s1)
  }
}

fn kernel_cos(x : Double, y : Double) -> Double {
  let one = 1.0
  let c1 = 4.16666666666666019037e-02
  let c2 = -1.38888888888741095749e-03
  let c3 = 2.48015872894767294178e-05
  let c4 = -2.75573143513906633035e-07
  let c5 = 2.08757232129817482790e-09
  let c6 = -1.13596475577881948265e-11
  let ix = get_high_u32(x) & 0x7FFFFFFF.to_int64()
  if ix < 0x3E400000.to_int64() {
    if x.to_int() == 0 {
      return one
    }
  }
  let z = x * x
  let r = z * (c1 + z * (c2 + z * (c3 + z * (c4 + z * (c5 + z * c6)))))
  if ix < 0x3FD33333.to_int64() {
    return one - (0.5 * z - (z * r - x * y))
  } else {
    let qx = if ix > 0x3FE90000.to_int64() {
      0.28125
    } else {
      Double::from_bits((ix - 0x00200000.to_int64()) << 32)
    }
    let hz = 0.5 * z - qx
    let a = one - qx
    return a - (hz - (z * r - x * y))
  }
}

fn kernel_tan(x : Double, y : Double, iy : Int) -> Double {
  let one = 1.0
  let pio4 = 7.85398163397448278999e-01
  let pio4lo = 3.06161699786838301793e-17
  let mut x = x
  let mut y = y
  let t = [
    3.33333333333334091986e-01,
    1.33333333333201242699e-01,
    5.39682539762260521377e-02,
    2.18694882948595424599e-02,
    8.86323982359930005737e-03,
    3.59207910759131235356e-03,
    1.45620945432529025516e-03,
    5.88041240820264096874e-04,
    2.46463134818469906812e-04,
    7.81794442939557092300e-05,
    7.14072491382608190305e-05,
    -1.85586374855275456654e-05,
    2.59073051863633712884e-05,
    1.00000000000000000000e+00,
    7.85398163397448278999e-01,
    3.06161699786838301793e-17,
  ]
  let hx = get_high_i32(x)
  let ix = hx & 0x7FFFFFFF
  if ix < 0x3E300000 {
    if x.to_int() == 0 {
      if (ix | get_low_i32(x) | (iy + 1)) == 0 {
        return one / x.abs()
      } else if iy == 1 {
        return x
      } else {
        let w = x + y
        let mut z = w
        z = set_low_word(z, 0.to_int64())
        let v = y - (z - x)
        let a = -one / w
        let mut t2 = a
        t2 = set_low_word(t2, 0.to_int64())
        let s = one + t2 * z
        return t2 + a * (s + t2 * v)
      }
    }
  }
  if ix >= 0x3FE59428 {
    if hx < 0 {
      x = -x
      y = -y
    }
    let z = pio4 - x
    let w = pio4lo - y
    x = z + w
    y = 0.0
  }
  let z = x * x
  let w = z * z
  let mut r = t[1] + w * (t[3] + w * (t[5] + w * (t[7] + w * (t[9] + w * t[11]))))
  let v = z * (t[2] + w * (t[4] + w * (t[6] + w * (t[8] + w * (t[10] + w * t[12])))))
  let s = z * x
  r = y + z * (s * (r + v) + y)
  r += t[0] * s
  let w2 = x + r
  if ix >= 0x3FE59428 {
    let v2 = iy.to_double()
    return (1 - ((hx >> 30) & 2)).to_double() * (v2 - 2.0 * (x - (w2 * w2 / (w2 + v2) - r)))
  }
  if iy == 1 {
    w2
  } else {
    let mut z2 = w2
    z2 = set_low_word(z2, 0.to_int64())
    let v2 = r - (z2 - x)
    let a = -1.0 / w2
    let mut t2 = a
    t2 = set_low_word(t2, 0.to_int64())
    let s2 = 1.0 + t2 * z2
    t2 + a * (s2 + t2 * v2)
  }
}
