// Ported from libs/mbui/src/dmath/exp.mbt (FreeBSD msun / SunPro).

pub fn exp(x : Double) -> Double {
  let ori_x = x
  let mut x = x
  let one = 1.0
  let hal_f = [0.5, -0.5]
  let o_threshold = 7.09782712893383973096e+02
  let u_threshold = -7.45133219101941108420e+02
  let ln2_hi_arr = [6.93147180369123816490e-01, -6.93147180369123816490e-01]
  let ln2_lo_arr = [1.90821492927058770002e-10, -1.90821492927058770002e-10]
  let invln2 = 1.44269504088896338700e+00
  let p1 = 1.66666666666666019037e-01
  let p2 = -2.77777777770155933842e-03
  let p3 = 6.61375632143793436117e-05
  let p4 = -1.65339022054652515390e-06
  let p5 = 4.13813679705723846039e-08
  let e = 2.718281828459045
  let mut hi = 0.0
  let mut lo = 0.0
  let huge = 1.0e+300
  let twom1000 = 9.33263618503218878990e-302
  let two1023 = 8.988465674311579539e307
  let mut k : Int = 0
  let mut hx : Int64 = get_high_u32(ori_x)
  let xsb : Int = ((hx >> 31) & 1.to_int64()).to_int()
  hx = hx & 0x7FFFFFFF.to_int64()
  if hx >= 0x40862E42.to_int64() {
    if hx >= 0x7FF00000.to_int64() {
      let lx : Int64 = get_low_u32(ori_x)
      if ((hx & 0xFFFFF.to_int64()) | lx) != 0.to_int64() {
        return ori_x + ori_x
      } else if xsb == 0 {
        return ori_x
      } else {
        return 0.0
      }
    }
    if ori_x > o_threshold {
      return huge * huge
    }
    if ori_x < u_threshold {
      return twom1000 * twom1000
    }
  }
  if hx > 0x3FD62E42.to_int64() {
    if hx < 0x3FF0A2B2.to_int64() {
      if ori_x == 1.0 {
        return e
      }
      hi = ori_x - ln2_hi_arr[xsb]
      lo = ln2_lo_arr[xsb]
      k = 1 - xsb - xsb
    } else {
      k = (invln2 * ori_x + hal_f[xsb]).to_int()
      let t = k.to_double()
      hi = ori_x - t * ln2_hi_arr[0]
      lo = t * ln2_lo_arr[0]
    }
    x = hi - lo
  } else if hx < 0x3E300000.to_int64() {
    if huge + x > one {
      return one + x
    }
  } else {
    k = 0
  }
  let t = x * x
  let twopk = if k >= -1021 {
    insert_words((0x3FF00000 + (k << 20)).to_int64() & u32_mask(), 0.to_int64())
  } else {
    insert_words((0x3FF00000.to_int64() + (((k + 1000).to_int64() & u32_mask()) << 20)) & u32_mask(), 0.to_int64())
  }
  let c = x - t * (p1 + t * (p2 + t * (p3 + t * (p4 + t * p5))))
  if k == 0 {
    return one - (x * c / (c - 2.0) - x)
  }
  let y = one - (lo - x * c / (2.0 - c) - hi)
  if k >= -1021 {
    if k == 1024 {
      return y * 2.0 * two1023
    } else {
      return y * twopk
    }
  } else {
    return y * twopk * twom1000
  }
}

pub fn expm1(x : Double) -> Double {
  if is_nan(x) {
    return nan()
  }
  let o_threshold = 7.09782712893383973096e+02
  if x > o_threshold {
    return inf()
  }
  if is_inf(x) {
    return -1.0
  }
  let huge = 1.0e+300
  let tiny = 1.0e-300
  let invln2 = 1.44269504088896338700e+00
  let q1 = -3.33333333333331316428e-02
  let q2 = 1.58730158725481460165e-03
  let q3 = -7.93650757867487942473e-05
  let q4 = 4.00821782732936239552e-06
  let q5 = -2.01099218183624371326e-07
  let mut x = x
  let mut hx = get_high_u32(x)
  let xsb = (hx >> 31) & 1.to_int64()
  let mut y : Double = if xsb == 0.to_int64() { x } else { -x }
  hx = hx & 0x7FFFFFFF.to_int64()
  if hx >= 0x4043687A.to_int64() {
    if xsb != 0.to_int64() {
      if x + tiny < 0.0 {
        return tiny - 1.0
      }
    }
  }
  let mut hi = 0.0
  let mut lo = 0.0
  let mut k = 0
  let mut c = 0.0
  let mut t = 0.0
  if hx > 0x3FD62E42.to_int64() {
    if hx < 0x3FF0A2B2.to_int64() {
      hi = if xsb == 0.to_int64() { x - ln2_hi } else { x + ln2_hi }
      lo = if xsb == 0.to_int64() { ln2_lo } else { -ln2_lo }
      k = if xsb == 0.to_int64() { 1 } else { -1 }
    } else {
      k = (invln2 * x + (if xsb == 0.to_int64() { 0.5 } else { -0.5 })).to_int()
      t = k.to_double()
      hi = x - t * ln2_hi
      lo = t * ln2_lo
    }
    x = hi - lo
    c = hi - x - lo
  } else if hx < 0x3C900000.to_int64() {
    t = huge + x
    return x - (t - (huge + x))
  } else {
    k = 0
  }
  let hfx : Double = 0.5 * x
  let hxs : Double = x * hfx
  let r1 : Double = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))))
  let t2 : Double = 3.0 - r1 * hfx
  let e : Double = hxs * ((r1 - t2) / (6.0 - x * t2))
  if k == 0 {
    return x - (x * e - hxs)
  } else {
    let e2 : Double = x * (e - c) - c - hxs
    if k == -1 {
      return 0.5 * (x - e2) - 0.5
    }
    if k == 1 {
      return if x < -0.25 {
        -2.0 * (e2 - (x + 0.5))
      } else {
        1.0 + 2.0 * (x - e2)
      }
    }
    if k <= -2 || k > 56 {
      y = 1.0 - (e2 - x)
      y = set_high_word(y, (get_high_u32(y) + (k.to_int64() << 20)) & u32_mask())
      return y - 1.0
    }
    if k < 20 {
      let tk = set_high_word(0.0, (0x3FF00000 - (0x200000 >> k)).to_int64() & u32_mask())
      y = tk - (e2 - x)
      y = set_high_word(y, (get_high_u32(y) + (k.to_int64() << 20)) & u32_mask())
    } else {
      let tk = set_high_word(0.0, ((0x3FF - k) << 20).to_int64() & u32_mask())
      y = x - (e2 + tk) + 1.0
      y = set_high_word(y, (get_high_u32(y) + (k.to_int64() << 20)) & u32_mask())
    }
  }
  y
}
