// Thin Invar Layer-2 compatibility helpers (do NOT edit m2p-generated files).

pub fn inf() -> Double {
  1.0 / 0.0
}

pub fn neg_inf() -> Double {
  -1.0 / 0.0
}

pub fn nan() -> Double {
  0.0 / 0.0
}

pub fn is_nan(x : Double) -> Bool {
  x != x
}

pub fn is_inf(x : Double) -> Bool {
  x == inf() || x == neg_inf()
}

pub fn sqrt(x : Double) -> Double {
  x.sqrt()
}

pub fn floor(x : Double) -> Double {
  x.floor()
}

pub fn ceil(x : Double) -> Double {
  x.ceil()
}

pub fn round(x : Double) -> Double {
  x.round()
}

pub fn min(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

pub fn max(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

pub fn clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub let pi_over_2_const : Double = 1.5707963267948966
