let pi : Double = 3.141592653589793
let pi_over_4_const : Double = 0.7853981633974483

fn approx_bits(a : Double, b : Double) -> Bool {
  a.to_bits() == b.to_bits()
}

fn approx_eps(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

test "dmath deterministic fdlibm bit-exact reference vectors" {
  // Exact IEEE-754 results matching reference fdlibm test vectors
  debug_assert(approx_bits(sin(2.0), 0.9092974268256817), "sin(2.0)")
  debug_assert(approx_bits(sin(-5.0), 0.9589242746631385), "sin(-5.0)")
  debug_assert(approx_bits(cos(2.5), -0.8011436155469337), "cos(2.5)")
  debug_assert(approx_bits(cos(-5.0), 0.28366218546322625), "cos(-5.0)")
  debug_assert(approx_bits(sin(31415926535897.9323846), 0.0012091232715481885), "sin(large)")
  debug_assert(approx_bits(cos(31415926535897.9323846), 0.9999992690101899), "cos(large)")
  debug_assert(approx_bits(tan(4.0), 1.1578212823495777), "tan(4.0)")
  debug_assert(approx_bits(exp(1.0), 2.718281828459045), "exp(1.0)")
  debug_assert(approx_bits(ln(10.0), 2.302585092994046), "ln(10.0)")
  debug_assert(approx_bits(pow(2.0, 0.5), 1.4142135623730951), "pow(2, 0.5)")
  debug_assert(approx_bits(atan2(1.0, 1.0), 0.7853981633974483), "atan2(1, 1)")
}

test "dmath trig inverse and special values" {
  debug_assert(approx_eps(asin(0.0), 0.0, 1.0e-15), "asin(0)")
  debug_assert(approx_eps(asin(0.5), 0.5235987755982989, 1.0e-15), "asin(0.5)")
  debug_assert(approx_eps(asin(1.0), pi_over_2_const, 1.0e-15), "asin(1)")
  debug_assert(approx_eps(asin(-1.0), -pi_over_2_const, 1.0e-15), "asin(-1)")
  debug_assert(is_nan(asin(1.5)), "asin(1.5) is NaN")

  debug_assert(approx_eps(acos(1.0), 0.0, 1.0e-15), "acos(1)")
  debug_assert(approx_eps(acos(0.0), pi_over_2_const, 1.0e-15), "acos(0)")
  debug_assert(approx_eps(acos(-1.0), pi, 1.0e-15), "acos(-1)")
  debug_assert(is_nan(acos(-1.5)), "acos(-1.5) is NaN")

  debug_assert(approx_eps(atan(0.0), 0.0, 1.0e-15), "atan(0)")
  debug_assert(approx_eps(atan(1.0), pi_over_4_const, 1.0e-15), "atan(1)")
  debug_assert(approx_eps(atan(-1.0), -pi_over_4_const, 1.0e-15), "atan(-1)")
  debug_assert(approx_eps(atan2(0.0, -1.0), pi, 1.0e-14), "atan2(0, -1)")
  debug_assert(approx_eps(atan2(-1.0, 0.0), -pi_over_2_const, 1.0e-14), "atan2(-1, 0)")
  debug_assert(is_nan(sin(inf())), "sin(inf) is NaN")
  debug_assert(is_nan(cos(nan())), "cos(nan) is NaN")
  debug_assert(is_nan(tan(inf())), "tan(inf) is NaN")
}

test "dmath exp, expm1, ln, ln_1p, log2, log10, pow, scalbn" {
  debug_assert(exp(0.0) == 1.0, "exp(0)")
  debug_assert(exp(-1000.0) == 0.0, "exp(-1000)")
  debug_assert(is_inf(exp(1000.0)), "exp(1000)")
  debug_assert(is_nan(exp(nan())), "exp(nan)")

  debug_assert(approx_eps(expm1(0.0), 0.0, 1.0e-15), "expm1(0)")
  debug_assert(approx_eps(expm1(1.0e-10), 1.00000000005e-10, 1.0e-20), "expm1(1e-10)")
  debug_assert(approx_eps(expm1(1.0), 1.718281828459045, 1.0e-15), "expm1(1)")
  debug_assert(expm1(neg_inf()) == -1.0, "expm1(-inf)")

  debug_assert(ln(1.0) == 0.0, "ln(1)")
  debug_assert(is_inf(ln(0.0)) && ln(0.0) < 0.0, "ln(0) == -inf")
  debug_assert(is_nan(ln(-1.0)), "ln(-1) is NaN")
  debug_assert(approx_eps(ln_1p(0.0), 0.0, 1.0e-15), "ln_1p(0)")
  debug_assert(approx_eps(ln_1p(1.0e-10), 9.9999999995e-11, 1.0e-20), "ln_1p(1e-10)")
  debug_assert(approx_eps(log2(8.0), 3.0, 1.0e-15), "log2(8)")
  debug_assert(approx_eps(log2(0.25), -2.0, 1.0e-15), "log2(0.25)")
  debug_assert(approx_eps(log10(1000.0), 3.0, 1.0e-15), "log10(1000)")

  debug_assert(pow(2.0, 10.0) == 1024.0, "pow(2, 10)")
  debug_assert(pow(-2.0, 3.0) == -8.0, "pow(-2, 3)")
  debug_assert(pow(-2.0, 4.0) == 16.0, "pow(-2, 4)")
  debug_assert(is_nan(pow(-2.0, 0.5)), "pow(-2, 0.5) is NaN")
  debug_assert(pow(5.0, 0.0) == 1.0, "pow(5, 0)")
  debug_assert(pow(2.0, -3.0) == 0.125, "pow(2, -3)")

  debug_assert(scalbn(1.5, 3) == 12.0, "scalbn(1.5, 3)")
  debug_assert(scalbn(1.0, -2) == 0.25, "scalbn(1, -2)")
  debug_assert(scalbn(1.0, 10) == 1024.0, "scalbn(1, 10)")
}

test "dmath helpers sqrt, floor, ceil, round, trunc, abs, min, max, clamp" {
  debug_assert(sqrt(9.0) == 3.0, "sqrt")
  debug_assert(floor(2.7) == 2.0 && floor(-2.3) == -3.0, "floor")
  debug_assert(ceil(2.1) == 3.0 && ceil(-2.7) == -2.0, "ceil")
  debug_assert(round(2.5) == 3.0 && round(2.4) == 2.0, "round")
  debug_assert((-2.9).trunc() == -2.0 && (2.9).trunc() == 2.0, "trunc")
  debug_assert((-42.5).abs() == 42.5, "abs")
  debug_assert(min(3.0, 5.0) == 3.0 && max(3.0, 5.0) == 5.0, "min/max")
  debug_assert(clamp(10.0, 0.0, 5.0) == 5.0 && clamp(-1.0, 0.0, 5.0) == 0.0 && clamp(3.0, 0.0, 5.0) == 3.0, "clamp")
}

test "dmath compat: nan bit pattern, min/max NaN propagation, signed zero, reversed clamp" {
  let q = nan()
  debug_assert(is_nan(q), "nan() is NaN")
  debug_assert(q.to_bits() == 0x7ff8000000000000L, "nan() canonical quiet NaN bits 0x7ff8000000000000")
  debug_assert(is_nan(min(q, 1.0)), "min(nan, 1.0) is NaN")
  debug_assert(is_nan(min(1.0, q)), "min(1.0, nan) is NaN")
  debug_assert(is_nan(max(q, 1.0)), "max(nan, 1.0) is NaN")
  debug_assert(is_nan(max(1.0, q)), "max(1.0, nan) is NaN")
  debug_assert(min(-0.0, 0.0) == 0.0 && max(-0.0, 0.0) == 0.0, "signed zero min/max")
  debug_assert(clamp(5.0, 10.0, 2.0) == 10.0, "reversed clamp checks lo first")
}
