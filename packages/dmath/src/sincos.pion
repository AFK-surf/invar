///|
pub fn sin(x : Double) -> Double {
  if mbt_compat::double_is_inf(x) || mbt_compat::double_is_nan(x) {
    return mbt_compat::double_nan()
  }
  let y = [0.0, 0.0]
  let z = 0.0
  if x.abs() <= PI_OVER_4 {
    return __kernel_sin(x, z, 0)
  } else {
    let n = rem_pio2(x, y)
    match n & 3 {
      0 => __kernel_sin(y[0], y[1], 1)
      1 => __kernel_cos(y[0], y[1])
      2 => -__kernel_sin(y[0], y[1], 1)
      _ => -__kernel_cos(y[0], y[1])
    }
  }
}

///|
pub fn cos(x : Double) -> Double {
  if mbt_compat::double_is_inf(x) || mbt_compat::double_is_nan(x) {
    return mbt_compat::double_nan()
  }
  let y = [0.0, 0.0]
  let z = 0.0
  if x.abs() <= PI_OVER_4 {
    return __kernel_cos(x, z)
  } else {
    let n = rem_pio2(x, y)
    match n & 3 {
      0 => __kernel_cos(y[0], y[1])
      1 => -__kernel_sin(y[0], y[1], 1)
      2 => -__kernel_cos(y[0], y[1])
      _ => __kernel_sin(y[0], y[1], 1)
    }
  }
}
