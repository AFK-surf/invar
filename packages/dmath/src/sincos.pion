// Ported from libs/mbui/src/dmath/sincos.mbt (FreeBSD msun / SunPro).

pub fn sin(x : Double) -> Double {
  if is_inf(x) || is_nan(x) {
    return nan()
  }
  let y = [0.0, 0.0]
  if x.abs() <= pi_over_4_const {
    return kernel_sin(x, 0.0, 0)
  } else {
    let n = rem_pio2(x, y)
    let q = n & 3
    if q == 0 {
      kernel_sin(y[0], y[1], 1)
    } else if q == 1 {
      kernel_cos(y[0], y[1])
    } else if q == 2 {
      -kernel_sin(y[0], y[1], 1)
    } else {
      -kernel_cos(y[0], y[1])
    }
  }
}

pub fn cos(x : Double) -> Double {
  if is_inf(x) || is_nan(x) {
    return nan()
  }
  let y = [0.0, 0.0]
  if x.abs() <= pi_over_4_const {
    return kernel_cos(x, 0.0)
  } else {
    let n = rem_pio2(x, y)
    let q = n & 3
    if q == 0 {
      kernel_cos(y[0], y[1])
    } else if q == 1 {
      -kernel_sin(y[0], y[1], 1)
    } else if q == 2 {
      -kernel_cos(y[0], y[1])
    } else {
      kernel_sin(y[0], y[1], 1)
    }
  }
}
