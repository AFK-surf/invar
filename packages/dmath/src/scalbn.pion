///|
pub fn scalbn(x : Double, exp : Int) -> Double {
  let mut n = exp
  let mut y : Double = x
  if n > 1023 {
    y *= Double::from_bits(9214364837600034816L)
    n -= 1023
    if n > 1023 {
      y *= Double::from_bits(9214364837600034816L)
      n -= 1023
      if n > 1023 {
        n = 1023
      }
    }
  } else if n < -1022 {
    // make sure final n < -53 to avoid double
    // rounding in the subnormal range
    y *= Double::from_bits(4503599627370496L) * Double::from_bits(4845873199050653696L)
    n += 1022 - 53
    if n < -1022 {
      y *= Double::from_bits(4503599627370496L) * Double::from_bits(4845873199050653696L)
      n += 1022 - 53
      if n < -1022 {
        n = -1022
      }
    }
  }
  let ui = mbt_compat::int_to_uint64((0x3ff + n)) << 52
  return y * ui.reinterpret_as_double()
}
