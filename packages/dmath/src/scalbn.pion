// Ported from libs/mbui/src/dmath/scalbn.mbt (FreeBSD msun / SunPro).

pub fn scalbn(x : Double, exp : Int) -> Double {
  let mut n = exp
  let mut y : Double = x
  let two1023 = Double::from_bits(0x7FE00000.to_int64() << 32)
  let twom1022_53 = Double::from_bits(0x00100000.to_int64() << 32) * Double::from_bits(0x43400000.to_int64() << 32)
  if n > 1023 {
    y *= two1023
    n -= 1023
    if n > 1023 {
      y *= two1023
      n -= 1023
      if n > 1023 {
        n = 1023
      }
    }
  } else if n < -1022 {
    y *= twom1022_53
    n += 1022 - 53
    if n < -1022 {
      y *= twom1022_53
      n += 1022 - 53
      if n < -1022 {
        n = -1022
      }
    }
  }
  let ui = (0x3ff + n).to_int64() << 52
  y * Double::from_bits(ui)
}
