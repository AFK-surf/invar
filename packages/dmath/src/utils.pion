// Cross-platform deterministic IEEE-754 double math (FreeBSD msun / SunPro fdlibm port).
// Ported from libs/mbui/src/dmath/utils.mbt.

pub let pi : Double = 3.14159265358979323846
pub let tau : Double = 6.28318530717958647692
pub let pi_over_2_const : Double = 1.57079632679489661923
pub let pi_over_4_const : Double = 0.785398163397448309616
pub let sqrt2_const : Double = 1.41421356237309504880168872420969807856967187537694807317667974
pub let ln2_const : Double = 0.693147180559945309417232121458176568075500134360255254120680009

let pio2_1 : Double = 1.5707963267341256e+00
let pio2_1t : Double = 6.0771005065061922e-11
let pio2_2 : Double = 6.0771005063039660e-11
let pio2_2t : Double = 2.0222662487959506e-21
let pio2_3 : Double = 2.0222662487111665e-21
let pio2_3t : Double = 8.4784276603688996e-32
let inv_pio2 : Double = 6.3661977236758138e-01
let half_const : Double = 0.5
let two24_const : Double = 16777216.0
let ln2_hi : Double = 6.93147180369123816490e-01
let ln2_lo : Double = 1.90821492927058770002e-10

pub fn nan() -> Double {
  Double::from_bits(0x7FF80000.to_int64() << 32)
}

pub fn inf() -> Double {
  Double::from_bits(0x7FF00000.to_int64() << 32)
}

pub fn neg_inf() -> Double {
  -inf()
}

pub fn min_positive() -> Double {
  Double::from_bits(0x00100000.to_int64() << 32)
}

pub fn is_nan(x : Double) -> Bool {
  x != x
}

pub fn is_inf(x : Double) -> Bool {
  let mask : Int64 = (0x7FFFFFFF.to_int64() << 32) | ((1.to_int64() << 32) - 1.to_int64())
  (x.to_bits() & mask) == (0x7FF00000.to_int64() << 32)
}

pub fn abs(x : Double) -> Double {
  x.abs()
}

pub fn sqrt(x : Double) -> Double {
  x.sqrt()
}

pub fn floor(x : Double) -> Double {
  x.floor()
}

pub fn ceil(x : Double) -> Double {
  x.ceil()
}

pub fn round(x : Double) -> Double {
  x.round()
}

pub fn trunc(x : Double) -> Double {
  x.trunc()
}

pub fn min(a : Double, b : Double) -> Double {
  if is_nan(a) || is_nan(b) {
    return nan()
  }
  if a < b { a } else { b }
}

pub fn max(a : Double, b : Double) -> Double {
  if is_nan(a) || is_nan(b) {
    return nan()
  }
  if a > b { a } else { b }
}

pub fn clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

fn u32_mask() -> Int64 {
  (1.to_int64() << 32) - 1.to_int64()
}

/// Unsigned 32-bit high word of IEEE-754 Double, returned in Int64 [0, 0xFFFFFFFF].
fn get_high_u32(x : Double) -> Int64 {
  (x.to_bits() >> 32) & u32_mask()
}

/// Unsigned 32-bit low word of IEEE-754 Double, returned in Int64 [0, 0xFFFFFFFF].
fn get_low_u32(x : Double) -> Int64 {
  x.to_bits() & u32_mask()
}

/// Signed 32-bit high word of IEEE-754 Double.
fn get_high_i32(x : Double) -> Int {
  get_high_u32(x).to_int()
}

/// Signed 32-bit low word of IEEE-754 Double.
fn get_low_i32(x : Double) -> Int {
  get_low_u32(x).to_int()
}

fn set_low_word(d : Double, v : Int64) -> Double {
  let mask_lo = u32_mask()
  let mask_hi = mask_lo << 32
  let bits = (d.to_bits() & mask_hi) | (v & mask_lo)
  Double::from_bits(bits)
}

fn set_high_word(d : Double, v : Int64) -> Double {
  let mask_lo = u32_mask()
  let bits = (d.to_bits() & mask_lo) | ((v & mask_lo) << 32)
  Double::from_bits(bits)
}

fn insert_words(ix0 : Int64, ix1 : Int64) -> Double {
  let mask_lo = u32_mask()
  Double::from_bits(((ix0 & mask_lo) << 32) | (ix1 & mask_lo))
}

fn make_ints(n : Int, v : Int) -> Array[Int] {
  let a : Array[Int] = []
  for _ in 0..<n {
    a.push(v)
  }
  a
}

fn make_doubles(n : Int, v : Double) -> Array[Double] {
  let a : Array[Double] = []
  for _ in 0..<n {
    a.push(v)
  }
  a
}

fn normalize(f : Double) -> (Double, Int) {
  if f.abs() < min_positive() {
    let scale = Double::from_bits(0x43300000.to_int64() << 32) // 2^52
    return (f * scale, -52)
  }
  (f, 0)
}

fn frexp(f : Double) -> (Double, Int) {
  if f == 0.0 || is_inf(f) || is_nan(f) {
    return (f, 0)
  }
  let (norm_f, exp0) = normalize(f)
  let u = norm_f.to_bits()
  let ebits = ((u >> 52) & 0x7FF.to_int64()).to_int()
  let exp = exp0 + ebits - 1022
  let exp_mask : Int64 = 0x7FF.to_int64() << 52
  let clear_mask : Int64 = exp_mask ^ (-1).to_int64()
  let frac = Double::from_bits((u & clear_mask) | (1022.to_int64() << 52))
  (frac, exp)
}

