///|
fn normalize(f : Double) -> (Double, Int) {
  if f.abs() < mbt_compat::double_min_positive() {
    return (f * (1L << 52).to_double(), -52)
  }
  (f, 0)
}

///|
fn frexp(f : Double) -> (Double, Int) {
  if f == 0.0 || mbt_compat::double_is_inf(f) || mbt_compat::double_is_nan(f) {
    return (f, 0)
  }
  let (norm_f, exp) = normalize(f)
  let u = norm_f.reinterpret_as_uint64()
  let exp = exp + ((u >> 52) & 0x7FF).to_int() - 1022
  let frac = ((u & mbt_compat::uint64_lnot((0x7FFUL << 52))) | (1022UL << 52)).reinterpret_as_double()
  return (frac, exp)
}
