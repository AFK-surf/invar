// Ported from libs/mbui/src/dmath/pow.mbt (FreeBSD msun / SunPro).

pub fn pow(x : Double, y : Double) -> Double {
  let pow_bp = [1.0, 1.5]
  let pow_dp_h = [0.0, 5.84962487220764160156e-01]
  let pow_dp_l = [0.0, 1.35003920212974897128e-08]
  let zero = 0.0
  let one = 1.0
  let two = 2.0
  let pow_two53 = 9007199254740992.0
  let pow_huge = 1.0e300
  let pow_tiny = 1.0e-300
  let pow_l1 = 5.99999999999994648725e-01
  let pow_l2 = 4.28571428578550184252e-01
  let pow_l3 = 3.33333329818377432918e-01
  let pow_l4 = 2.72728123808534006489e-01
  let pow_l5 = 2.30660745775561754067e-01
  let pow_l6 = 2.06975017800338417784e-01
  let pow_p1 = 1.66666666666666019037e-01
  let pow_p2 = -2.77777777770155933842e-03
  let pow_p3 = 6.61375632143793436117e-05
  let pow_p4 = -1.65339022054652515390e-06
  let pow_p5 = 4.13813679705723846039e-08
  let pow_lg2 = 6.93147180559945286227e-01
  let pow_lg2_h = 6.93147182464599609375e-01
  let pow_lg2_l = -1.90465429995776804525e-09
  let pow_ovt = 8.0085662595372944372e-17
  let pow_cp = 9.61796693925975554329e-01
  let pow_cp_h = 9.61796700954437255859e-01
  let pow_cp_l = -7.02846165095275826516e-09
  let pow_ivln2 = 1.44269504088896338700e+00
  let pow_ivln2_h = 1.44269502162933349609e+00
  let pow_ivln2_l = 1.92596299112661746887e-08

  let mut z : Double = 0.0
  let mut ax : Double = 0.0
  let mut z_h : Double = 0.0
  let mut z_l : Double = 0.0
  let mut p_h : Double = 0.0
  let mut p_l : Double = 0.0
  let mut y1 : Double = 0.0
  let mut t1 : Double = 0.0
  let mut t2 : Double = 0.0
  let mut r : Double = 0.0
  let mut s : Double = 0.0
  let mut t : Double = 0.0
  let mut u : Double = 0.0
  let mut v : Double = 0.0
  let mut w : Double = 0.0
  let mut i : Int = 0
  let mut j : Int = 0
  let mut k : Int = 0
  let mut yisint : Int = 0
  let mut n : Int = 0

  let hx : Int = get_high_i32(x)
  let lx : Int64 = get_low_u32(x)
  let hy : Int = get_high_i32(y)
  let ly : Int64 = get_low_u32(y)
  let mut ix : Int = hx & 0x7FFFFFFF
  let iy : Int = hy & 0x7FFFFFFF

  if (iy.to_int64() | ly) == 0.to_int64() {
    return one
  }
  if ix > 0x7FF00000 ||
    (ix == 0x7FF00000 && lx != 0.to_int64()) ||
    iy > 0x7FF00000 ||
    (iy == 0x7FF00000 && ly != 0.to_int64()) {
    return x + y
  }

  if hx < 0 {
    if iy >= 0x43400000 {
      yisint = 2
    } else if iy >= 0x3FF00000 {
      k = (iy >> 20) - 0x3FF
      if k > 20 {
        j = (ly >> (52 - k)).to_int()
        if ((j << (52 - k)).to_int64() & u32_mask()) == ly {
          yisint = 2 - (j & 1)
        }
      } else if ly == 0.to_int64() {
        j = iy >> (20 - k)
        if (j << (20 - k)) == iy {
          yisint = 2 - (j & 1)
        }
      }
    }
  }

  if ly == 0.to_int64() {
    if iy == 0x7FF00000 {
      if ((((ix - 0x3FF00000).to_int64() & u32_mask()) | lx)) == 0.to_int64() {
        return y - y
      } else if ix >= 0x3FF00000 {
        return if hy >= 0 { y } else { zero }
      } else {
        return if hy < 0 { -y } else { zero }
      }
    }
    if iy == 0x3FF00000 {
      if hy < 0 {
        return one / x
      } else {
        return x
      }
    }
    if hy == 0x40000000 {
      return x * x
    }
    if hy == 0x3FE00000 {
      if hx >= 0 {
        return x.sqrt()
      }
    }
  }

  ax = x.abs()
  if lx == 0.to_int64() {
    if ix == 0x7FF00000 || ix == 0 || ix == 0x3FF00000 {
      z = ax
      if hy < 0 {
        z = one / z
      }
      if hx < 0 {
        if ((ix - 0x3FF00000) | yisint) == 0 {
          z = nan()
        } else if yisint == 1 {
          z = -z
        }
      }
      return z
    }
  }

  n = (hx >> 31) + 1
  if (n | yisint) == 0 {
    return nan()
  }
  s = one
  if (n | (yisint - 1)) == 0 {
    s = -one
  }

  if iy > 0x41E00000 {
    if iy > 0x43F00000 {
      if ix <= 0x3FEFFFFF {
        return if hy < 0 { pow_huge * pow_huge } else { pow_tiny * pow_tiny }
      }
      if ix >= 0x3FF00000 {
        return if hy > 0 { pow_huge * pow_huge } else { pow_tiny * pow_tiny }
      }
    }
    if ix < 0x3FEFFFFF {
      return if hy < 0 { s * pow_huge * pow_huge } else { s * pow_tiny * pow_tiny }
    }
    if ix > 0x3FF00000 {
      return if hy > 0 { s * pow_huge * pow_huge } else { s * pow_tiny * pow_tiny }
    }
    t = ax - one
    w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25))
    u = pow_ivln2_h * t
    v = t * pow_ivln2_l - w * pow_ivln2
    t1 = u + v
    t1 = set_low_word(t1, 0.to_int64())
    t2 = v - (t1 - u)
  } else {
    n = 0
    if ix < 0x00100000 {
      ax *= pow_two53
      n -= 53
      ix = get_high_i32(ax)
    }
    n += (ix >> 20) - 0x3FF
    j = ix & 0x000FFFFF
    ix = j | 0x3FF00000
    if j <= 0x3988E {
      k = 0
    } else if j < 0xBB67A {
      k = 1
    } else {
      k = 0
      n += 1
      ix -= 0x00100000
    }
    ax = set_high_word(ax, ix.to_int64() & u32_mask())
    u = ax - pow_bp[k]
    v = one / (ax + pow_bp[k])
    let ss : Double = u * v
    let mut s_h : Double = ss
    s_h = set_low_word(s_h, 0.to_int64())
    let mut t_h : Double = zero
    let th_hi = (((ix.to_int64() & u32_mask()) >> 1) | 0x20000000.to_int64()) +
      0x00080000.to_int64() +
      (k.to_int64() << 18)
    t_h = set_high_word(t_h, th_hi & u32_mask())
    let mut t_l : Double = ax - (t_h - pow_bp[k])
    let s_l : Double = v * (u - s_h * t_h - s_h * t_l)
    let mut s2 : Double = ss * ss
    r = s2 * s2 * (pow_l1 + s2 * (pow_l2 + s2 * (pow_l3 + s2 * (pow_l4 + s2 * (pow_l5 + s2 * pow_l6)))))
    r += s_l * (s_h + ss)
    s2 = s_h * s_h
    t_h = 3.0 + s2 + r
    t_h = set_low_word(t_h, 0.to_int64())
    t_l = r - (t_h - 3.0 - s2)
    u = s_h * t_h
    v = s_l * t_h + t_l * ss
    p_h = u + v
    p_h = set_low_word(p_h, 0.to_int64())
    p_l = v - (p_h - u)
    z_h = pow_cp_h * p_h
    z_l = pow_cp_l * p_h + p_l * pow_cp + pow_dp_l[k]
    t = n.to_double()
    t1 = z_h + z_l + pow_dp_h[k] + t
    t1 = set_low_word(t1, 0.to_int64())
    t2 = z_l - (t1 - t - pow_dp_h[k] - z_h)
  }

  y1 = y
  y1 = set_low_word(y1, 0.to_int64())
  p_l = (y - y1) * t1 + y * t2
  p_h = y1 * t1
  z = p_l + p_h
  j = get_high_i32(z)
  i = get_low_i32(z)
  if j >= 0x40900000 {
    if ((j - 0x40900000) | i) != 0 {
      return s * pow_huge * pow_huge
    } else if p_l + pow_ovt > z - p_h {
      return s * pow_huge * pow_huge
    }
  } else if (j & 0x7FFFFFFF) >= 0x4090CC00 {
    // 0xc090cc00 as signed i32 == -1064252416
    if ((j - (-1064252416)) | i) != 0 {
      return s * pow_tiny * pow_tiny
    } else if p_l <= z - p_h {
      return s * pow_tiny * pow_tiny
    }
  }

  i = j & 0x7FFFFFFF
  k = (i >> 20) - 0x3FF
  n = 0
  if i > 0x3FE00000 {
    n = j + (0x00100000 >> (k + 1))
    k = ((n & 0x7FFFFFFF) >> 20) - 0x3FF
    t = zero
    let mask_not = (0x000FFFFF >> k) ^ (-1)
    t = set_high_word(t, (n & mask_not).to_int64() & u32_mask())
    n = ((n & 0x000FFFFF) | 0x00100000) >> (20 - k)
    if j < 0 {
      n = -n
    }
    p_h -= t
  }
  t = p_l + p_h
  t = set_low_word(t, 0.to_int64())
  u = t * pow_lg2_h
  v = (p_l - (t - p_h)) * pow_lg2 + t * pow_lg2_l
  z = u + v
  w = v - (z - u)
  t = z * z
  t1 = z - t * (pow_p1 + t * (pow_p2 + t * (pow_p3 + t * (pow_p4 + t * pow_p5))))
  r = z * t1 / (t1 - two - (w + z * w))
  z = one - (r - z)
  j = get_high_i32(z)
  j = j + (n << 20)
  if (j >> 20) <= 0 {
    z = scalbn(z, n)
  } else {
    let tmp = get_high_i32(z)
    z = set_high_word(z, (tmp + (n << 20)).to_int64() & u32_mask())
  }
  s * z
}
