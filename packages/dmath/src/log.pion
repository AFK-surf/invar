// Ported from libs/mbui/src/dmath/log.mbt (FreeBSD msun / SunPro).

pub fn ln(x : Double) -> Double {
  let l1 = 6.666666666666735130e-01
  let l2 = 3.999999999940941908e-01
  let l3 = 2.857142874366239149e-01
  let l4 = 2.222219843214978396e-01
  let l5 = 1.818357216161805012e-01
  let l6 = 1.531383769920937332e-01
  let l7 = 1.479819860511658591e-01
  if x < 0.0 {
    return nan()
  } else if is_nan(x) || is_inf(x) {
    return x
  } else if x == 0.0 {
    return neg_inf()
  }
  let (f1, ki) = frexp(x)
  let (f, k) = if f1 < sqrt2_const / 2.0 {
    (f1 * 2.0 - 1.0, (ki - 1).to_double())
  } else {
    (f1 - 1.0, ki.to_double())
  }
  let s = f / (2.0 + f)
  let s2 = s * s
  let s4 = s2 * s2
  let t1 = s2 * (l1 + s4 * (l3 + s4 * (l5 + s4 * l7)))
  let t2 = s4 * (l2 + s4 * (l4 + s4 * l6))
  let r = t1 + t2
  let hfsq = 0.5 * f * f
  k * ln2_hi - (hfsq - (s * (hfsq + r) + k * ln2_lo) - f)
}

pub fn log2(x : Double) -> Double {
  let (f, e) = frexp(x)
  if f == 0.5 {
    return e.to_double() - 1.0
  }
  ln(f) / ln2_const + e.to_double()
}

pub fn log10(x : Double) -> Double {
  if x < 0.0 {
    return nan()
  } else if is_nan(x) || is_inf(x) {
    return x
  } else if x == 0.0 {
    return neg_inf()
  }
  let ivln10 = 4.34294481903251816668e-01
  let log10_2hi = 3.01029995663611771306e-01
  let log10_2lo = 3.69423907715893078616e-13
  let (f0, e0) = frexp(x)
  let (f, e) = if e0 >= 1 {
    (f0 * 2.0, (e0 - 1).to_double())
  } else {
    (f0, e0.to_double())
  }
  let z = e * log10_2lo + ivln10 * ln(f)
  z + e * log10_2hi
}

pub fn ln_1p(x : Double) -> Double {
  if x < -1.0 || is_nan(x) {
    return nan()
  }
  if x == -1.0 {
    return neg_inf()
  }
  if is_inf(x) {
    return inf()
  }
  let two54 = 1.80143985094819840000e+16
  let lp1 = 6.666666666666735130e-01
  let lp2 = 3.999999999940941908e-01
  let lp3 = 2.857142874366239149e-01
  let lp4 = 2.222219843214978396e-01
  let lp5 = 1.818357216161805012e-01
  let lp6 = 1.531383769920937332e-01
  let zero = 0.0
  let lp7 = 1.479819860511658591e-01
  let hx = get_high_i32(x)
  let ax = hx & 0x7FFFFFFF
  let mut f = 0.0
  let mut c = 0.0
  let mut s = 0.0
  let mut z = 0.0
  let mut r = 0.0
  let mut u = 0.0
  let mut hu = 0
  let mut k = 1
  if hx < 0x3FDA827A {
    if ax < 0x3E200000 {
      if two54 + x > zero && ax < 0x3C900000 {
        return x
      } else {
        return x - x * x * 0.5
      }
    }
    // 0xbfd2bec3 as signed i32 == -1076707645
    if hx > 0 || hx <= -1076707645 {
      k = 0
      f = x
      hu = 1
    }
  }
  if k != 0 {
    if hx < 0x43400000 {
      u = 1.0 + x
      hu = get_high_i32(u)
      k = (hu >> 20) - 1023
      c = if k > 0 { 1.0 - (u - x) } else { x - (u - 1.0) }
      c /= u
    } else {
      u = x
      hu = get_high_i32(u)
      k = (hu >> 20) - 1023
      c = 0.0
    }
    hu = hu & 0x000FFFFF
    if hu < 0x6A09E {
      u = set_high_word(u, (hu | 0x3FF00000).to_int64() & u32_mask())
    } else {
      k += 1
      u = set_high_word(u, (hu | 0x3FE00000).to_int64() & u32_mask())
      hu = (0x00100000 - hu) >> 2
    }
    f = u - 1.0
  }
  let hfsq = 0.5 * f * f
  if hu == 0 {
    if f == zero {
      if k == 0 {
        return zero
      } else {
        c += k.to_double() * ln2_lo
        return k.to_double() * ln2_hi + c
      }
    }
    r = hfsq * (1.0 - 0.66666666666666666 * f)
    if k == 0 {
      return f - r
    } else {
      return k.to_double() * ln2_hi - (r - (k.to_double() * ln2_lo + c) - f)
    }
  }
  s = f / (2.0 + f)
  z = s * s
  r = z * (lp1 + z * (lp2 + z * (lp3 + z * (lp4 + z * (lp5 + z * (lp6 + z * lp7))))))
  if k == 0 {
    return f - (hfsq - s * (hfsq + r))
  } else {
    return k.to_double() * ln2_hi - (hfsq - (s * (hfsq + r) + (k.to_double() * ln2_lo + c)) - f)
  }
}
