/// Native iOS 27.0 Controls Parity scene (`390×844` @ 2x) matching Column 1 reference layout.
fn ios27_parity_scene(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let seg_idx = signals::signal(0)
  let sw_on = signals::signal(true)
  let sw_off = signals::signal(false)
  let sl1 = signals::signal(50.0)
  let sl2 = signals::signal(75.0)
  let tab_idx = signals::signal(0)
  let dd_seg = lg::DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=1.18)
  let dd_sw_on = lg::DampedDrag::new(1.0, lo=0.0, hi=1.0, held_scale=lg::thumb_held_scale)
  let dd_sw_off = lg::DampedDrag::new(0.0, lo=0.0, hi=1.0, held_scale=lg::thumb_held_scale)
  let dd_sl1 = lg::DampedDrag::new(50.0, lo=0.0, hi=100.0, held_scale=lg::slider_thumb_held_scale)
  let dd_sl2 = lg::DampedDrag::new(75.0, lo=0.0, hi=100.0, held_scale=lg::slider_thumb_held_scale)
  let dd_tab = lg::DampedDrag::new(0.0, lo=0.0, hi=3.0, held_scale=1.16)
  let sec_hdr = fn(p : view::View, text : String) -> Unit {
    let _ = p.box(fn(h : view::View) -> Unit {
      let _ = h
      .padding(view::Live::Is((12.0, 0.0, 0.0, 0.0)))
      .words(
        view::Live::Is(text),
        look=view::WordsLook::{ ..lg::words_at(13.5, weight=600), tracking: view::Spacing::Points(0.35) },
      )
      .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
    })
  }
  let _ = root.box(fn(stage : view::View) -> Unit {
    let _ = stage
    .grow(view::Live::Is(1.0))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { if lg::is_dark() { 0x000000FFL } else { 0xF2F2F7FFL } }))
    let _ = stage.box(fn(col : view::View) -> Unit {
      let _ = col
      .grow(view::Live::Is(1.0))
      .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
      .gap(view::Live::Is(12.0))
      // Top navigation bar
      let _ = col.box(fn(top : view::View) -> Unit {
        let _ = top
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(40.0)))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        let _ = top.box(fn(eye_btn : view::View) -> Unit {
          let _ = eye_btn
          .width(view::Live::Is(Some(36.0)))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(18.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .glass(view::Live::By(fn() { Some(lg::liquid_bar_pill_glass(sharing=false)) }))
          .shadow(view::Live::By(lg::glass_control_shadow))
          .shadow_outside(view::Live::Is(true))
          let _ = lg::icon_node(eye_btn, lg::IconKind::Eye, size=18.0, ink=fn() { lg::colors().content })
        })
        let _ = top.box(fn(title : view::View) -> Unit {
          let _ = title
          .words(view::Live::Is("Controls Parity"), look=lg::words_at(17.0, weight=600))
          .ink(view::Live::By(fn() { lg::colors().content }))
        })
        let _ = top.box(fn(pill : view::View) -> Unit {
          let _ = pill
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(18.0))
          .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
          .gap(view::Live::Is(6.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .glass(view::Live::By(fn() { Some(lg::liquid_bar_pill_glass(sharing=false)) }))
          .shadow(view::Live::By(lg::glass_control_shadow))
          .shadow_outside(view::Live::Is(true))
          let _ = pill.box(fn(lbl : view::View) -> Unit {
            let _ = lbl
            .words(view::Live::Is("Solid"), look=lg::words_at(14.5, weight=500))
            .ink(view::Live::By(fn() { lg::colors().content }))
          })
          let mode_icon = if lg::is_dark() { lg::IconKind::SunFilled } else { lg::IconKind::MoonFilled }
          let _ = lg::icon_node(
            pill,
            mode_icon,
            size=16.0,
            ink=fn() { if lg::is_dark() { 0xFFD60AFFL } else { 0x5E5CE6FFL } },
          )
        })
      })
      // Search bar (40pt, 17pt font)
      let _ = col.box(fn(sb : view::View) -> Unit {
        let _ = sb
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(40.0)))
        .radius(view::Live::Is(20.0))
        .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
        .gap(view::Live::Is(8.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C20FFL } else { 0xE5E5EBFFL } }))
        let _ = lg::icon_node(sb, lg::IconKind::Search, size=16.0, ink=fn() { lg::surface().ink_secondary })
        let _ = sb.box(fn(ph : view::View) -> Unit {
          let _ = ph
          .words(view::Live::Is("Search controls"), look=lg::words_at(17.0))
          .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
        })
      })
      // 1. Segmented Control
      let _ = col.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(5.0))
        sec_hdr(sec, "SEGMENTED CONTROL")
        let _ = sec.box(fn(card : view::View) -> Unit {
          let _ = card
          .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
          .radius(view::Live::Is(20.0))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL } }))
          let _ = lg::liquid_segmented_node(
            card,
            fn() { ["Day", "Week", "Month"] },
            fn() { seg_idx.get() },
            fn(i : Int) -> Unit { seg_idx.set(i) },
            width=326.0,
            height=32.0,
            drag=dd_seg,
            flat=true,
          )
          dd_seg.press()
        })
      })
      // 2. Switches (UISwitch)
      let _ = col.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(5.0))
        sec_hdr(sec, "SWITCHES (UISWITCH)")
        let _ = sec.box(fn(card : view::View) -> Unit {
          let _ = card
          .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
          .gap(view::Live::Is(11.0))
          .radius(view::Live::Is(20.0))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL } }))
          let _ = card.box(fn(r1 : view::View) -> Unit {
            let _ = r1
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            let _ = r1.box(fn(lbl : view::View) -> Unit {
              let _ = lbl
              .grow(view::Live::Is(1.0))
              .words(view::Live::Is("Notifications (On)"), look=lg::words_at(16.0))
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = lg::liquid_toggle_node(
              r1,
              fn() { sw_on.get() },
              fn(v : Bool) -> Unit { sw_on.set(v) },
              fn() { "Notifications (On)" },
              drag=dd_sw_on,
            )
            dd_sw_on.press()
          })
          let _ = card.box(fn(div : view::View) -> Unit {
            let _ = div
            .height(view::Live::Is(Some(0.5)))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF1AL } else { 0x00000014L } }))
          })
          let _ = card.box(fn(r2 : view::View) -> Unit {
            let _ = r2
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Between))
            let _ = r2.box(fn(lbl : view::View) -> Unit {
              let _ = lbl
              .grow(view::Live::Is(1.0))
              .words(view::Live::Is("Low Power Mode (Off)"), look=lg::words_at(16.0))
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = lg::liquid_toggle_node(
              r2,
              fn() { sw_off.get() },
              fn(v : Bool) -> Unit { sw_off.set(v) },
              fn() { "Low Power Mode (Off)" },
              drag=dd_sw_off,
            )
            dd_sw_off.press()
          })
        })
      })
      // 3. Sliders (UISlider) — both held in pressed glass lens state
      let _ = col.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(5.0))
        sec_hdr(sec, "SLIDERS (UISLIDER)")
        let _ = sec.box(fn(card : view::View) -> Unit {
          let _ = card
          .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .radius(view::Live::Is(20.0))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL } }))
          let _ = card.box(fn(r1 : view::View) -> Unit {
            let _ = r1.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
            let _ = r1.box(fn(l : view::View) -> Unit {
              let _ = l.words(view::Live::Is("Continuous"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = r1.box(fn(v : view::View) -> Unit {
              let _ = v.words(view::Live::Is("50%"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          })
          let _ = lg::liquid_slider_node(
            card,
            fn() { sl1.get() },
            fn(v : Double) -> Unit { sl1.set(v) },
            fn() { "Continuous" },
            thumb_w_px=38.0,
            thumb_h_px=24.0,
            drag=dd_sl1,
          )
          dd_sl1.press()
          let _ = card.box(fn(r2 : view::View) -> Unit {
            let _ = r2.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
            let _ = r2.box(fn(l : view::View) -> Unit {
              let _ = l.words(view::Live::Is("Stepped (25%)"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = r2.box(fn(v : view::View) -> Unit {
              let _ = v.words(view::Live::Is("75%"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          })
          let _ = lg::liquid_slider_node(
            card,
            fn() { sl2.get() },
            fn(v : Double) -> Unit { sl2.set(v) },
            fn() { "Stepped (25%)" },
            thumb_w_px=38.0,
            thumb_h_px=24.0,
            stops=5,
            drag=dd_sl2,
          )
          dd_sl2.press()
        })
      })
      // 4. Glass Buttons (36pt height, 16pt labels)
      let _ = col.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(5.0))
        sec_hdr(sec, "GLASS BUTTONS")
        let _ = sec.box(fn(card : view::View) -> Unit {
          let _ = card
          .row(view::Live::Is(true))
          .padding(view::Live::Is((16.0, 12.0, 16.0, 12.0)))
          .gap(view::Live::Is(10.0))
          .radius(view::Live::Is(20.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL } }))
          let _ = lg::liquid_button_node(
            card,
            fn() { "Regular Glass" },
            fn() -> Unit { () },
            content=fn(c : view::View) -> Unit {
              let _ = c.box(fn(w : view::View) -> Unit {
                let _ = w.words(view::Live::Is("Regular Glass"), look=lg::words_at(16.0, weight=400)).ink(view::Live::By(fn() { lg::colors().content }))
              })
            },
            flat=false,
            height=36.0,
          )
          let _ = lg::liquid_button_node(
            card,
            fn() { "Favorite" },
            fn() -> Unit { () },
            content=fn(c : view::View) -> Unit {
              let _ = lg::icon_node(c, lg::IconKind::HeartFilled, size=17.0, ink=fn() { lg::colors().content })
            },
            flat=false,
            height=36.0,
            pad_x=9.5,
          )
          let _ = lg::liquid_button_node(
            card,
            fn() { "Prominent" },
            fn() -> Unit { () },
            content=fn(c : view::View) -> Unit {
              let _ = c.box(fn(w : view::View) -> Unit {
                let _ = w.words(view::Live::Is("Prominent"), look=lg::words_at(16.0, weight=400)).ink(view::Live::Is(lg::white))
              })
            },
            prominent=true,
            flat=false,
            height=36.0,
          )
        })
      })
      // 5. Background section passing behind the floating Bottom Tab Bar to showcase real refraction
      let _ = col.box(fn(sec : view::View) -> Unit {
        let _ = sec.gap(view::Live::Is(6.0))
        sec_hdr(sec, "MENUS (UIMENU & .CONTEXTMENU)")
        let _ = sec.box(fn(card : view::View) -> Unit {
          let _ = card
          .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
          .gap(view::Live::Is(10.0))
          .radius(view::Live::Is(20.0))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x1C1C1EFFL } else { 0xFFFFFFFFL } }))
          let _ = card.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Pull-Down Menu"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Sort by Date"), look=lg::words_at(15.0)).ink(view::Live::By(fn() { lg::colors().accent }))
            })
          })
          let _ = card.box(fn(div : view::View) -> Unit {
            let _ = div
            .height(view::Live::Is(Some(0.5)))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF1AL } else { 0x00000014L } }))
          })
          let _ = card.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Context Menu Preview"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Hold Item"), look=lg::words_at(15.0)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          })
          let _ = card.box(fn(div : view::View) -> Unit {
            let _ = div
            .height(view::Live::Is(Some(0.5)))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF1AL } else { 0x00000014L } }))
          })
          let _ = card.box(fn(r : view::View) -> Unit {
            let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Quick Actions"), look=lg::words_at(16.0)).ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = r.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Share · Copy"), look=lg::words_at(15.0)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          })
        })
      })
    })
    // Floating Bottom Tab Bar (60pt, 1.16x lifted lens over background content)
    let _ = stage.box(fn(dock : view::View) -> Unit {
      let _ = dock
      .over(view::Live::Is(true))
      .lies_along(view::Live::Is(view::Lies::End))
      .padding(view::Live::Is((16.0, 0.0, 16.0, 20.0)))
      let _ = lg::liquid_bottom_tabs_node(
        dock,
        ["Controls", "Surfaces", "Lenses", "Settings"],
        fn() { tab_idx.get() },
        fn(i : Int) -> Unit { tab_idx.set(i) },
        faces=[
          lg::icon_tab_face(lg::IconKind::Sliders, "Controls"),
          lg::icon_tab_face(lg::IconKind::Layers, "Surfaces"),
          lg::icon_tab_face(lg::IconKind::Sparkles, "Lenses"),
          lg::icon_tab_face(lg::IconKind::Settings, "Settings"),
        ],
        drag=dd_tab,
      )
      dd_tab.press()
    })
  })
}

let all_shot_presets : String =
  "overview, dialog, interactive, film, merge, gallery, stage, stage-merge, sync-loupe, " +
  "drawer-sheet, library, library-film, ios26, content-layer, apple-chat, apple-titled, " +
  "segmented-flat, segmented-glass, content-controls, pressed-lens, pressed-lens-film, " +
  "apple-parity, tab-lens-film, ios27-parity"

fn main() -> Int {
  host::install()
  if ui::env("MBUI_LG_LIST") != "" {
    film::say("shots presets: \{all_shot_presets}")
    return 0
  }
  let dir_out = ui::env("MBUI_LG_OUT")
  let dir_shots = ui::env("MBUI_LG_SHOTS")
  let dir = if dir_out != "" {
    dir_out
  } else if dir_shots != "" {
    dir_shots
  } else {
    "shots_out_latest"
  }
  let font = ui::env("MBUI_LG_FONT")
  if font != "" {
    let _ = ui::face_add(hostapi::face_ui, font, 400)
  }
  let only = ui::env("MBUI_LG_ONLY")
  let page_w = env_double("MBUI_LG_W", 1280.0)
  let page_h = env_double("MBUI_LG_H", 1040.0)
  let page_scale = env_double("MBUI_LG_SCALE", 3.0)
  let failed = ui::ref_new(0)
  let matched = ui::ref_new(0)
  let record = fn(path : String, ok : Bool) -> Unit {
    matched.v = matched.v + 1
    let st = if ok { "ok" } else { "failed" }
    film::say("shots: \{path} \{st}")
    if !ok {
      failed.v = failed.v + 1
    }
  }

  for pg in ["overview", "dialog", "interactive", "film", "merge"] {
    if only != "" && only != pg {
      continue
    }
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let path = "\{dir}/\{pg}-\{mode}.png"
      let (w, h, scale) = if pg == "film" {
        (600.0, 400.0, 3.0)
      } else if pg == "merge" {
        (560.0, 360.0, 3.0)
      } else {
        (page_w, page_h, page_scale)
      }
      let ok = film::picture(
        fn(root) { lg_pages::page(root, pg) },
        path=path,
        w=w,
        h=h,
        scale=scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
  }

  if only == "" || only == "gallery" {
    let gallery_h = 1040.0 + lg_pages::bar_top + lg_pages::bar_h
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      for shot in gallery_shots {
        let (name, first, script) = shot
        lg::set_dark(Some(dark))
        let path = "\{dir}/gallery-\{name}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::gallery(root, first) },
          path=path,
          w=1280.0,
          h=gallery_h,
          scale=3.0,
          dark=dark,
          script=script,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if only == "" || only == "film" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/film-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "film") },
        script=film_script,
        out=out,
        w=600.0,
        h=400.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      record(out, ok)
    }
  }

  if only == "stage" {
    lg::set_dark(Some(true))
    let out = "\{dir}/stage-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script=stage_script,
      out=out,
      w=1120.0,
      h=690.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    record(out, ok)
  }

  if only == "stage-merge" {
    let sizes : Array[(String, Double, Double, Int)] = [
      ("1120x637", 1120.0, 637.0, 587),
      ("1120x690", 1120.0, 690.0, 640),
    ]
    for sz in sizes {
      let (tag, w, h, dock_y) = sz
      for dark in [false, true] {
        lg::set_dark(Some(dark))
        let mode = if dark { "dark" } else { "light" }
        let path = "\{dir}/stage-merge-\{tag}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::page(root, "overview") },
          path=path,
          w=w,
          h=h,
          scale=3.0,
          dark=dark,
          script="tapxy 735 \{dock_y}\nwait 1000",
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
    lg::set_dark(Some(true))
    let out = "\{dir}/stage-merge-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script=stage_merge_script,
      out=out,
      w=1120.0,
      h=690.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    record(out, ok)
  }

  if only == "sync-loupe" {
    let merge_frames : Array[(String, String)] = [
      ("merge-sync-1-pre-split", "tapxy 735 587\nwait 400\ndrag 472 305 18 0 300"),
      ("merge-sync-2-post-split", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 350\nwait 600"),
      ("merge-sync-3-near-hover", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 300\nwait 600\ndrag 528 305 -45 0 400\nwait 300"),
      ("merge-sync-4-contact-fuse", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 300\nwait 600\ndrag 528 305 -48 0 400\nwait 500"),
    ]
    lg::set_dark(Some(true))
    for frame in merge_frames {
      let (fname, script) = frame
      let path = "\{dir}/\{fname}.png"
      let ok = film::picture(
        fn(root) { lg_pages::page(root, "overview") },
        path=path,
        w=1120.0,
        h=637.0,
        scale=3.0,
        dark=true,
        script=script,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let path = "\{dir}/loupe-1120x637-\{mode}.png"
      let ok = film::picture(
        fn(root) { lg_pages::page(root, "overview") },
        path=path,
        w=1120.0,
        h=637.0,
        scale=3.0,
        dark=dark,
        script="tapxy 618 587\nwait 600",
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
    lg::set_dark(Some(true))
    let clip_out = "\{dir}/merge-sync-demo.mp4"
    let clip_ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script="tapxy 735 587\nwait 350\ndrag 472 305 26 0 800\nwait 500\ndrag 528 305 -45 0 400\nwait 400\ndrag 483 305 -10 0 300\nwait 450",
      out=clip_out,
      w=1120.0,
      h=637.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    record(clip_out, clip_ok)
  }

  if only == "" || only == "merge" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/merge-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "merge") },
        script=merge_script,
        out=out,
        w=560.0,
        h=360.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      record(out, ok)
    }
  }

  if only == "drawer-sheet" {
    let lib_scale = env_double("MBUI_LG_SCALE", 2.0)
    let ds_shots : Array[(String, Bool, String)] = [
      ("drawer-dark", true, "tap Overlays\nwait 500\ntap Open Drawer\nwait 700"),
      ("drawer-light", false, "tap Overlays\nwait 500\ntap Open Drawer\nwait 700"),
      ("sheet-dark", true, "tap Overlays\nwait 500\ntap Open Sheet\nwait 700"),
      ("sheet-light", false, "tap Overlays\nwait 500\ntap Open Sheet\nwait 700"),
    ]
    for item in ds_shots {
      let (name, dark, script) = item
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root) { lg_pages::gallery(root, "library", chrome=true) },
        path=path,
        w=1280.0,
        h=800.0,
        scale=lib_scale,
        dark=dark,
        script=script,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
  }

  if only == "library" {
    let lib_scale = env_double("MBUI_LG_SCALE", 2.0)
    let lib_shots : Array[(String, Bool, Double, Double, String)] = [
      ("lib-controls-dark", true, 1280.0, 800.0, "tap Controls\nwait 500"),
      ("lib-controls-light", false, 1280.0, 800.0, "tap Controls\nwait 500"),
      ("lib-inputs-dark", true, 1280.0, 800.0, "tap Inputs\nwait 500"),
      ("lib-nav-dark", true, 1280.0, 800.0, "tap Navigation\nwait 500"),
      ("lib-nav-light", false, 1280.0, 800.0, "tap Navigation\nwait 500"),
      ("lib-overlays-dark", true, 1280.0, 800.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("lib-overlays-light", false, 1280.0, 800.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("lib-optics-dark", true, 1280.0, 800.0, "tap Optics\nwait 500"),
      ("lib-physics-dark", true, 1280.0, 800.0, "tap Physics\nwait 500"),
      ("web-lg-hero-dark", true, 1120.0, 690.0, ""),
      ("web-lg-hero-light", false, 1120.0, 690.0, ""),
      ("web-lg-overlays-dark", true, 1120.0, 690.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("web-lg-inputs-light", false, 1120.0, 690.0, "tap Inputs\nwait 500"),
      ("web-lg-physics-dark", true, 1120.0, 690.0, "tap Physics\nwait 500\ntapxy 512 105\nwait 500"),
    ]
    for item in lib_shots {
      let (name, dark, w, h, script) = item
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root) { lg_pages::gallery(root, "library", chrome=true) },
        path=path,
        w=w,
        h=h,
        scale=lib_scale,
        dark=dark,
        script=script,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
  }

  if only == "library-film" {
    lg::set_dark(Some(true))
    let out = "\{dir}/lg-library-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::gallery(root, "library", chrome=true) },
      script=library_film_script,
      out=out,
      w=1280.0,
      h=800.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    record(out, ok)
  }

  if only == "ios26" {
    let collapsible_script = "wait 350\ntap Browse\nwait 350\ntap Minimize\nwait 750\ntap Expand Browse\nwait 750"
    let search_script = "wait 350\ntap Search\nwait 850\ntap Cancel Search\nwait 850"
    for dark in [false, true] {
      let tag = if dark { "dark" } else { "light" }
      lg::set_dark(Some(dark))
      let out1 = "\{dir}/ios26-collapsible-\{tag}.mp4"
      let ok1 = film::film(
        ios26_collapsible_stage,
        script=collapsible_script,
        out=out1,
        w=560.0,
        h=240.0,
        scale=3.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      record(out1, ok1)
      let out2 = "\{dir}/ios26-search-morph-\{tag}.mp4"
      let ok2 = film::film(
        ios26_search_morph_stage,
        script=search_script,
        out=out2,
        w=560.0,
        h=200.0,
        scale=3.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      record(out2, ok2)
    }
  }

  if only == "content-layer" {
    let cl_scale = env_double("MBUI_LG_SCALE", 2.0)
    let sample_code = "let _ = lg::surface_code_block_node(card, fn() { \"pub fn build_two_layer_apple_view(root : view::View, worker : ui::Worker[Cmd, Ev]) -> Unit\" }, lang=fn() { \"pion\" })"
    let cases : Array[(String, Bool, Double, Double)] = [
      ("content-layer-desktop-light", false, 640.0, 440.0),
      ("content-layer-desktop-dark", true, 640.0, 440.0),
      ("content-layer-narrow320-light", false, 320.0, 440.0),
    ]
    for item in cases {
      let (name, dark, w, h) = item
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root : view::View) -> Unit {
          ui::set_tree_theme(lg::ui_theme)
          let _ = root
          .ground(view::Live::By(fn() { lg::surface().canvas }))
          .padding(view::Live::Is((16.0, 14.0, 16.0, 16.0)))
          .gap(view::Live::Is(12.0))
          let _ = lg::liquid_nav_bar_node(
            root,
            fn() { "Invar Two-Layer" },
            subtitle=fn() { "Solid Content + Floating Glass" },
            trailing=fn(tr : view::View) -> Unit {
              let _ = lg::liquid_bar_pill_group_node(tr, fn(p : view::View) -> Unit {
                let _ = lg::liquid_button_node(p, fn() { "Run" }, fn() -> Unit { () }, flat=true, ghost=true, pad_x=10.0)
              })
            },
          )
          let _ = lg::surface_section_node(
            root,
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(10.0))
              let _ = sec.box(fn(hdr : view::View) -> Unit {
                let _ = hdr.words(view::Live::Is("Clean Apple Content Surface"), look=lg::words_at(15.0, weight=600)).ink(view::Live::By(fn() { lg::surface().ink }))
              })
              let _ = sec.box(fn(sub : view::View) -> Unit {
                let _ = sub.words(view::Live::Is("Zero liquid glass on content cards; horizontal scroll keeps long code intact even at 320pt."), look=lg::words_at(13.0, wrap=true)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
              })
              let _ = lg::surface_code_block_node(sec, fn() { sample_code }, lang=fn() { "pion" })
              let _ = sec.box(fn(row : view::View) -> Unit {
                let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                let _ = lg::liquid_button_node(row, fn() { "Deploy" }, fn() -> Unit { () }, prominent=true)
                let _ = lg::liquid_badge_node(row, fn() { "0 glass on content" }, tone=lg::LiquidTone::Success, dot=true)
              })
            },
            header=fn() { "SURFACE CODE BLOCK" },
            footer=fn() { "Verified with lg::assert_apple_ui" },
            pad=14.0,
          )
        },
        path=path,
        w=w,
        h=h,
        scale=cl_scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
  }

  let apple_chat_cases : Array[(String, Bool, Double, Double, Double)] = [
    ("apple-chat-wide-light", false, 1280.0, 800.0, 76.0),
    ("apple-chat-wide-dark", true, 1280.0, 800.0, 76.0),
    ("apple-chat-narrow-light", false, 390.0, 844.0, 80.0),
    ("apple-chat-narrow-dark", true, 390.0, 844.0, 80.0),
  ]
  for item in apple_chat_cases {
    let (name, dark, w, h, pre_scroll) = item
    if only == "apple-chat" || only == name {
      let ac_scale = env_double("MBUI_LG_SCALE", 2.0)
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root : view::View) -> Unit { apple_chat_scene(root, pre_scroll) },
        path=path,
        w=w,
        h=h,
        scale=ac_scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      record(path, ok)
    }
  }

  if only == "apple-titled" || only == "apple-titled-light" {
    let at_scale = env_double("MBUI_LG_SCALE", 2.0)
    lg::set_dark(Some(false))
    let path = "\{dir}/apple-titled-light.png"
    let ok = film::picture(
      fn(root : view::View) -> Unit { apple_titled_scene(root, 56.0) },
      path=path,
      w=390.0,
      h=844.0,
      scale=at_scale,
      dark=false,
      at=1000.0,
      theme=lg::ui_theme,
    )
    record(path, ok)
  }

  for flat in [true, false] {
    let kind = if flat { "segmented-flat" } else { "segmented-glass" }
    if only == "segmented-flat" || only == kind {
      for dark in [false, true] {
        lg::set_dark(Some(dark))
        let mode = if dark { "dark" } else { "light" }
        let path = "\{dir}/\{kind}-in-sheet-\{mode}.png"
        let ok = film::picture(
          fn(root : view::View) -> Unit { segmented_sheet_scene(root, flat) },
          path=path,
          w=600.0,
          h=560.0,
          scale=env_double("MBUI_LG_SCALE", 2.0),
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if only == "content-controls" || only == "content-controls-light" || only == "content-controls-dark" {
    let cc_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "content-controls-\{mode}"
      if only == "content-controls" || only == name {
        lg::set_dark(Some(dark))
        let path = "\{dir}/\{name}.png"
        let ok = film::picture(
          fn(root : view::View) -> Unit { content_controls_scene(root) },
          path=path,
          w=820.0,
          h=560.0,
          scale=cc_scale,
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if only == "pressed-lens" || only == "pressed-lens-light" || only == "pressed-lens-dark" {
    let pl_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "pressed-lens-\{mode}"
      if only == "pressed-lens" || only == name {
        lg::set_dark(Some(dark))
        let path = "\{dir}/\{name}.png"
        let ok = film::picture(
          fn(root : view::View) -> Unit { pressed_lens_scene(root) },
          path=path,
          w=480.0,
          h=520.0,
          scale=pl_scale,
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if only == "pressed-lens-film" || only == "pressed-lens-film-light" || only == "pressed-lens-film-dark" {
    let pf_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "pressed-lens-film-\{mode}"
      if only == "pressed-lens-film" || only == name {
        lg::set_dark(Some(dark))
        let out = "\{dir}/\{name}.mp4"
        let ok = film::film(
          fn(root : view::View) -> Unit { pressed_lens_film_scene(root) },
          script=pressed_lens_film_script,
          out=out,
          w=440.0,
          h=292.0,
          scale=pf_scale,
          dark=dark,
          fps=60,
          theme=lg::ui_theme,
        )
        record(out, ok)
      }
    }
  }

  if only == "apple-parity" || only == "apple-parity-light" || only == "apple-parity-dark" {
    let ap_w = env_double("MBUI_LG_W", 420.0)
    let ap_h = env_double("MBUI_LG_H", 640.0)
    let ap_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "apple-parity-\{mode}"
      if only == "apple-parity" || only == name {
        lg::set_dark(Some(dark))
        let path = "\{dir}/\{name}.png"
        let ok = film::picture(
          fn(root : view::View) -> Unit { apple_parity_scene(root) },
          path=path,
          w=ap_w,
          h=ap_h,
          scale=ap_scale,
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if only == "tab-lens-film" || only == "tab-lens-film-light" || only == "tab-lens-film-dark" {
    let tf_w = env_double("MBUI_LG_W", 420.0)
    let tf_h = env_double("MBUI_LG_H", 140.0)
    let tf_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "tab-lens-film-\{mode}"
      if only == "tab-lens-film" || only == name {
        lg::set_dark(Some(dark))
        let out = "\{dir}/\{name}.mp4"
        let ok = film::film(
          fn(root : view::View) -> Unit { tab_lens_film_scene(root) },
          script=tab_lens_film_script,
          out=out,
          w=tf_w,
          h=tf_h,
          scale=tf_scale,
          dark=dark,
          fps=60,
          theme=lg::ui_theme,
        )
        record(out, ok)
      }
    }
  }

  if only == "ios27-parity" || only == "ios27-parity-light" || only == "ios27-parity-dark" {
    let p_w = env_double("MBUI_LG_W", 390.0)
    let p_h = env_double("MBUI_LG_H", 844.0)
    let p_scale = env_double("MBUI_LG_SCALE", 2.0)
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      let name = "ios27-parity-\{mode}"
      if only == "ios27-parity" || only == name {
        lg::set_dark(Some(dark))
        let path = "\{dir}/\{name}.png"
        let ok = film::picture(
          fn(root : view::View) -> Unit { ios27_parity_scene(root) },
          path=path,
          w=p_w,
          h=p_h,
          scale=p_scale,
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        record(path, ok)
      }
    }
  }

  if matched.v == 0 {
    film::say("shots: unknown MBUI_LG_ONLY='\{only}' (presets: \{all_shot_presets})")
    return 1
  }
  if failed.v > 0 {
    film::say("shots: \{failed.v} failed")
    return 1
  }
  0
}
