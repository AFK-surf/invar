// The gallery's pictures and film, drawn offscreen by invar's Apple Metal renderer (`film::picture`, `film::film`).
// Ported from upstream libs/liquid-glass/src/shots/main.mbt (see NOTICE).
//
//   MBUI_LG_OUT=<dir> (or MBUI_LG_SHOTS=<dir>, default "shots_out_latest")
//   MBUI_LG_ONLY=<library|library-film|stage|stage-merge|sync-loupe|ios26|gallery|film|merge|overview|dialog|interactive|apple-chat|apple-titled|segmented-flat>
//   MBUI_LG_W / MBUI_LG_H / MBUI_LG_SCALE  optional override for page picture size & scale
//   MBUI_LG_FONT                           optional font file path registered via ui::face_add(hostapi::face_ui, ...)

import "film"
