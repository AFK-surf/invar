fn pressed_lens_film_scene(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let dpi = signals::signal(1600.0)
  let natural = signals::signal(true)
  let mode = signals::signal(0)
  let _ = root.box(fn(stage : view::View) -> Unit {
    let _ = stage
    .grow(view::Live::Is(1.0))
    .ground(view::Live::By(fn() { lg::surface().canvas }))
    .padding(view::Live::Is((20.0, 20.0, 20.0, 20.0)))
    let _ = lg::surface_card_node(
      stage,
      fn(c : view::View) -> Unit {
        // Row 1: Slider (height 62pt, slider center y = 86)
        let _ = c.box(fn(r1 : view::View) -> Unit {
          let _ = r1.height(view::Live::Is(Some(62.0))).gap(view::Live::Is(10.0))
          let _ = r1.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.row(view::Live::Is(true)).height(view::Live::Is(Some(20.0))).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = hdr.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Pointer Speed"), look=lg::words_at(13.5, weight=600)).ink(view::Live::By(fn() { lg::surface().ink }))
            })
            let _ = hdr.box(fn(v : view::View) -> Unit {
              let _ = v.words(view::Live::By(fn() { "\{dpi.get().round().to_int()} DPI" }), look=lg::words_at(13.0, weight=500)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          })
          let _ = r1.box(fn(sl_box : view::View) -> Unit {
            let _ = sl_box.height(view::Live::Is(Some(32.0))).lies_along(view::Live::Is(view::Lies::Middle))
            let _ = lg::liquid_slider_node(
              sl_box,
              fn() { dpi.get() },
              fn(v : Double) -> Unit { dpi.set(v) },
              fn() { "Pointer Speed" },
              least=400.0,
              most=3200.0,
            )
          })
        })
        // Row 2: Switch (height 40pt, center y = 142)
        let _ = c.box(fn(r2 : view::View) -> Unit {
          let _ = r2.row(view::Live::Is(true)).height(view::Live::Is(Some(40.0))).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = r2.box(fn(t : view::View) -> Unit {
            let _ = t.words(view::Live::Is("Natural Scrolling"), look=lg::words_at(13.5, weight=600)).ink(view::Live::By(fn() { lg::surface().ink }))
          })
          let _ = lg::liquid_toggle_node(r2, fn() { natural.get() }, fn(v : Bool) -> Unit { natural.set(v) }, fn() { "Natural Scrolling" })
        })
        // Row 3: Segmented (height 62pt, segmented center y = 227)
        let _ = c.box(fn(r3 : view::View) -> Unit {
          let _ = r3.height(view::Live::Is(Some(62.0))).gap(view::Live::Is(10.0))
          let _ = r3.box(fn(hdr : view::View) -> Unit {
            let _ = hdr.height(view::Live::Is(Some(20.0))).lies_along(view::Live::Is(view::Lies::Middle))
            let _ = hdr.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("Tracking Mode"), look=lg::words_at(13.5, weight=600)).ink(view::Live::By(fn() { lg::surface().ink }))
            })
          })
          let _ = lg::liquid_segmented_node(
            r3,
            fn() { ["低", "中", "高"] },
            fn() { mode.get() },
            fn(i : Int) -> Unit { mode.set(i) },
            width=360.0,
          )
        })
      },
      pad=20.0,
      gap=20.0,
      label=fn() { "Pressed Lens Interactive" },
    )
  })
}

fn apple_parity_scene(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let tab_rest = signals::signal(2)
  let tab_peak = signals::signal(2)
  let dd_tab_peak = lg::DampedDrag::new(2.0, lo=0.0, hi=3.0, held_scale=1.28)
  let _ = root.box(fn(stage : view::View) -> Unit {
    let _ = stage
    .grow(view::Live::Is(1.0))
    .ground(view::Live::By(fn() { lg::surface().canvas }))
    .padding(view::Live::Is((18.0, 16.0, 18.0, 16.0)))
    .gap(view::Live::Is(14.0))
    let cap = fn(p : view::View, txt : String) -> Unit {
      let _ = p.box(fn(t : view::View) -> Unit {
        let _ = t
        .words(view::Live::Is(txt), look=lg::words_at(11.0, weight=600))
        .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
      })
    }
    // 1. Top Bar Glass Pills (left over clean surface, right spanning #0088FF blue bubble)
    let _ = stage.box(fn(sec : view::View) -> Unit {
      let _ = sec.gap(view::Live::Is(6.0))
      cap(sec, "TOP BAR GLASS PILLS · OVER #0088FF BUBBLE")
      let _ = sec.box(fn(card : view::View) -> Unit {
        let _ = card
        .height(view::Live::Is(Some(78.0)))
        .radius(view::Live::Is(16.0))
        .clips(view::Live::Is(true))
        .ground(view::Live::By(fn() { lg::surface().card }))
        let _ = card.box(fn(bub : view::View) -> Unit {
          let _ = bub
          .over(view::Live::Is(true))
          .offset(view::Live::Is((132.0, 22.0)))
          .width(view::Live::Is(Some(236.0)))
          .height(view::Live::Is(Some(42.0)))
          .radius(view::Live::Is(18.0))
          .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .ground(view::Live::Is(0x0088FFFFL))
          let _ = bub.box(fn(t : view::View) -> Unit {
            let _ = t
            .words(view::Live::Is("Liquid Glass over vivid blue"), look=lg::words_at(12.5, weight=500))
            .ink(view::Live::Is(lg::white))
          })
        })
        let _ = card.box(fn(row : view::View) -> Unit {
          let _ = row
          .over(view::Live::Is(true))
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(78.0)))
          .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Between))
          let _ = row.box(fn(left_btn : view::View) -> Unit {
            let _ = left_btn
            .width(view::Live::Is(Some(36.0)))
            .height(view::Live::Is(Some(36.0)))
            .radius(view::Live::Is(18.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .glass(view::Live::By(fn() { Some(lg::liquid_bar_pill_glass(sharing=false)) }))
            .shadow(view::Live::By(lg::glass_control_shadow))
            .shadow_outside(view::Live::Is(true))
            let _ = lg::icon_node(left_btn, lg::IconKind::ChevronLeft, size=15.0, ink=fn() { lg::colors().content })
          })
          let _ = row.box(fn(p : view::View) -> Unit {
            let _ = p
            .row(view::Live::Is(true))
            .height(view::Live::Is(Some(36.0)))
            .radius(view::Live::Is(18.0))
            .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
            .gap(view::Live::Is(6.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .glass(view::Live::By(fn() { Some(lg::liquid_bar_pill_glass(sharing=false)) }))
            .shadow(view::Live::By(lg::glass_control_shadow))
            .shadow_outside(view::Live::Is(true))
            let _ = lg::icon_node(p, lg::IconKind::Hash, size=13.5, ink=fn() { lg::colors().content })
            let _ = p.box(fn(t : view::View) -> Unit {
              let _ = t
              .words(view::Live::Is("liquid-glass"), look=lg::words_at(13.5, weight=600))
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = lg::icon_node(p, lg::IconKind::More, size=14.0, ink=fn() { lg::colors().content })
          })
        })
      })
    })
    // 2. Glass Buttons Row (Regular Glass, Icon Circle, Prominent)
    let _ = stage.box(fn(sec : view::View) -> Unit {
      let _ = sec.gap(view::Live::Is(6.0))
      cap(sec, "GLASS BUTTONS · REGULAR / CIRCLE / PROMINENT")
      let _ = sec.box(fn(card : view::View) -> Unit {
        let _ = card
        .row(view::Live::Is(true))
        .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
        .gap(view::Live::Is(12.0))
        .radius(view::Live::Is(16.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .ground(view::Live::By(fn() { lg::surface().card }))
        let _ = lg::liquid_button_node(card, fn() { "Regular Glass" }, fn() -> Unit { () }, flat=false)
        let _ = lg::liquid_button_node(
          card,
          fn() { "Favorite" },
          fn() -> Unit { () },
          content=fn(c : view::View) -> Unit {
            let _ = lg::icon_node(c, lg::IconKind::Sparkles, size=15.0, ink=fn() { lg::colors().content })
          },
          flat=false,
          height=36.0,
          pad_x=10.5,
        )
        let _ = lg::liquid_button_node(card, fn() { "Prominent" }, fn() -> Unit { () }, prominent=true, flat=false)
      })
    })
    // 3. Bottom Tab Bar (Resting + Pressed Peak Controls Lens)
    let _ = stage.box(fn(sec : view::View) -> Unit {
      let _ = sec.gap(view::Live::Is(12.0))
      cap(sec, "BOTTOM TAB BAR · REST & PRESSED CONTROLS LENS")
      let _ = lg::liquid_bottom_tabs_node(
        sec,
        ["Home", "Search", "Controls", "Profile"],
        fn() { tab_rest.get() },
        fn(i : Int) -> Unit { tab_rest.set(i) },
      )
      let _ = sec.box(fn(pad_wrap : view::View) -> Unit {
        let _ = pad_wrap.padding(view::Live::Is((0.0, 8.0, 0.0, 8.0)))
        let _ = lg::liquid_bottom_tabs_node(
          pad_wrap,
          ["Home", "Search", "Controls", "Profile"],
          fn() { tab_peak.get() },
          fn(i : Int) -> Unit { tab_peak.set(i) },
          drag=dd_tab_peak,
        )
        dd_tab_peak.press()
      })
    })
    // 4. Floating Composer Capsule spanning #0088FF blue bubble
    let _ = stage.box(fn(sec : view::View) -> Unit {
      let _ = sec.gap(view::Live::Is(6.0))
      cap(sec, "FLOATING COMPOSER CAPSULE · OVER #0088FF BUBBLE")
      let _ = sec.box(fn(card : view::View) -> Unit {
        let _ = card
        .height(view::Live::Is(Some(84.0)))
        .radius(view::Live::Is(16.0))
        .clips(view::Live::Is(true))
        .ground(view::Live::By(fn() { lg::surface().card }))
        let _ = card.box(fn(bub : view::View) -> Unit {
          let _ = bub
          .over(view::Live::Is(true))
          .offset(view::Live::Is((72.0, 26.0)))
          .width(view::Live::Is(Some(244.0)))
          .height(view::Live::Is(Some(44.0)))
          .radius(view::Live::Is(18.0))
          .padding(view::Live::Is((14.0, 0.0, 14.0, 0.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .ground(view::Live::Is(0x0088FFFFL))
          let _ = bub.box(fn(t : view::View) -> Unit {
            let _ = t
            .words(view::Live::Is("Scrolling chat bubble underneath"), look=lg::words_at(12.5, weight=500))
            .ink(view::Live::Is(lg::white))
          })
        })
        let _ = card.box(fn(wrap : view::View) -> Unit {
          let _ = wrap
          .over(view::Live::Is(true))
          .height(view::Live::Is(Some(84.0)))
          .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          let _ = wrap.box(fn(capsule : view::View) -> Unit {
            let _ = capsule
            .row(view::Live::Is(true))
            .height(view::Live::Is(Some(44.0)))
            .radius(view::Live::Is(22.0))
            .padding(view::Live::Is((10.0, 0.0, 6.0, 0.0)))
            .gap(view::Live::Is(10.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .glass(view::Live::By(fn() { Some(lg::liquid_floating_glass(adaptive=false)) }))
            .shadow(view::Live::By(lg::glass_control_shadow))
            .shadow_outside(view::Live::Is(true))
            let _ = lg::icon_node(capsule, lg::IconKind::Plus, size=16.0, ink=fn() { lg::surface().ink_secondary })
            let _ = capsule.box(fn(ph : view::View) -> Unit {
              let _ = ph
              .grow(view::Live::Is(1.0))
              .words(view::Live::Is("Message #liquid-glass..."), look=lg::words_at(14.0))
              .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
            let _ = capsule.box(fn(send : view::View) -> Unit {
              let _ = send
              .width(view::Live::Is(Some(32.0)))
              .height(view::Live::Is(Some(32.0)))
              .radius(view::Live::Is(16.0))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .ground(view::Live::Is(0x0088FFFFL))
              let _ = lg::icon_node(send, lg::IconKind::ArrowUp, size=15.0, ink=fn() { lg::white })
            })
          })
        })
      })
    })
  })
}

