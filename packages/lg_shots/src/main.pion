// Offscreen Apple Metal PNG and 60fps H.264 MP4 renderer for Liquid Glass (packages/lg + packages/lg_pages).
// Ported 1:1 from libs/liquid-glass/src/shots/main.mbt.
//
//   MBUI_LG_SHOTS=<dir> lg_shots      <dir>/gallery-{overview,interactive,dialog}-{light,dark}.png
//                                     <dir>/film-{light,dark}.mp4
//   MBUI_LG_ONLY=<gallery|film|all|overview|dialog|interactive>
//   MBUI_LG_SCALE=<2|3>               PNG scale factor (default 2.0)

import "film"
import "host"
import "lg"
import "lg_pages"
import "ui"

/// What the film does, step by step (film drive script; where each part is: lg_pages film_page):
/// the button held, pulled and let go; the toggle's thumb dragged on and tapped off;
/// the slider's thumb dragged along; the tabs' lens dragged across to the third tab.
let film_script : String =
  "wait 400\n" +
  "holdon 300 90 18 500 @70,64\n" +
  "wait 700\n" +
  "drag 62 142 30 0 400\n" +
  "wait 900\n" +
  "tapxy 62 142\n" +
  "wait 900\n" +
  "drag 196 208 220 0 700\n" +
  "wait 900\n" +
  "drag 108 292 270 0 800\n" +
  "wait 1200"

let gallery_core_shots : Array[(String, String, String)] = [
  ("overview", "overview", ""),
  ("interactive", "interactive", ""),
  ("dialog", "dialog", ""),
]

let gallery_extra_shots : Array[(String, String, String)] = [
  ("hover", "overview", "hover Interactive"),
  ("focus", "overview", "key shift+tab"),
]

fn parse_scale(s : String) -> Double {
  if s == "3" || s == "3.0" {
    3.0
  } else if s == "1" || s == "1.0" {
    1.0
  } else {
    2.0
  }
}

fn main() -> Unit {
  host::install()
  let dir = ui::env("MBUI_LG_SHOTS")
  if dir == "" {
    film::say("shots: MBUI_LG_SHOTS=<dir> says where the pictures go")
    return
  }
  let only = ui::env("MBUI_LG_ONLY")
  let png_scale = parse_scale(ui::env("MBUI_LG_SCALE"))
  let mut failed = 0

  // Standalone pages (when MBUI_LG_ONLY is "all" or a specific page name)
  if only == "all" || only == "overview" || only == "dialog" || only == "interactive" {
    for pg in ["overview", "dialog", "interactive", "film"] {
      if only != "all" && only != pg {
        continue
      }
      for dark in [false, true] {
        lg::set_dark(Some(dark))
        let mode = if dark { "dark" } else { "light" }
        let path = "\{dir}/\{pg}-\{mode}.png"
        let (w, h) = if pg == "film" { (600.0, 400.0) } else { (1280.0, 1040.0) }
        let ok = film::picture(
          fn(root) { lg_pages::page(root, pg) },
          path=path,
          w=w,
          h=h,
          scale=png_scale,
          dark=dark,
          at=1000.0,
          theme=lg::ui_theme,
        )
        let status = if ok { "ok" } else { "failed" }
        film::say("shots: \{path} \{status}")
        if !ok {
          failed += 1
        }
      }
    }
  }

  // Gallery shots: 1280 x 1096 (1040 + bar_top + bar_h)
  if only == "" || only == "gallery" || only == "all" {
    let gallery_h = 1040.0 + lg_pages::bar_top + lg_pages::bar_h
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      for shot in gallery_core_shots {
        let (name, first, script) = shot
        lg::set_dark(Some(dark))
        let path = "\{dir}/gallery-\{name}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::gallery(root, first) },
          path=path,
          w=1280.0,
          h=gallery_h,
          scale=png_scale,
          dark=dark,
          script=script,
          at=1000.0,
          theme=lg::ui_theme,
        )
        let status = if ok { "ok" } else { "failed" }
        film::say("shots: \{path} \{status}")
        if !ok {
          failed += 1
        }
      }
      if only == "all" {
        for shot in gallery_extra_shots {
          let (name, first, script) = shot
          lg::set_dark(Some(dark))
          let path = "\{dir}/gallery-\{name}-\{mode}.png"
          let ok = film::picture(
            fn(root) { lg_pages::gallery(root, first) },
            path=path,
            w=1280.0,
            h=gallery_h,
            scale=png_scale,
            dark=dark,
            script=script,
            at=1000.0,
            theme=lg::ui_theme,
          )
          let status = if ok { "ok" } else { "failed" }
          film::say("shots: \{path} \{status}")
          if !ok {
            failed += 1
          }
        }
      }
    }
  }

  // 60fps H.264 MP4 interactive films (600 x 400 @ 2x)
  if only == "" || only == "film" || only == "all" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/film-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "film") },
        script=film_script,
        out=out,
        w=600.0,
        h=400.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let status = if ok { "ok" } else { "failed" }
      film::say("shots: \{out} \{status}")
      if !ok {
        failed += 1
      }
    }
  }

  if failed > 0 {
    film::say("shots: \{failed} failed")
  } else {
    film::say("shots: all succeeded")
  }
}
