/// High-contrast non-glass optical backdrop for standalone iOS 26 component offscreen demos.
fn ios26_backdrop(w : view::View) -> Unit {
  let _ = w.box(fn(bg) {
    let _ = bg
      .over(view::Live::Is(true))
      .clips(view::Live::Is(true))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0EFFL } else { 0xF4F1EAFFL } }))
    let _ = bg.box(fn(orb) {
      let _ = orb
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(156.0)))
        .height(view::Live::Is(Some(156.0)))
        .radius(view::Live::Is(78.0))
        .offset(view::Live::Is((52.0, 26.0)))
        .ground(view::Live::Is(0xEF6334FFL))
    })
    let _ = bg.box(fn(plate) {
      let _ = plate
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(240.0)))
        .height(view::Live::Is(Some(96.0)))
        .radius(view::Live::Is(24.0))
        .offset(view::Live::Is((220.0, 74.0)))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0xF5F2EBFFL } else { 0x151720FFL } }))
    })
    let _ = bg.box(fn(ribbon) {
      let _ = ribbon
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(900.0)))
        .height(view::Live::Is(Some(3.0)))
        .offset(view::Live::Is((-120.0, 148.0)))
        .turn(view::Live::Is(-0.22))
        .ground(view::Live::Is(0xEF633455L))
    })
  })
}

fn ios26_collapsible_stage(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let tab = signals::signal(0)
  let minimized = signals::signal(false)
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between)).padding(view::Live::Is((24.0, 24.0, 24.0, 28.0)))
    ios26_backdrop(w)
    let _ = w.box(fn(top_row) {
      let _ = top_row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = lg::liquid_button_node(
        top_row,
        fn() { if minimized.get() { "Expand" } else { "Minimize" } },
        fn() { minimized.set(!minimized.untracked()) },
        flat=true,
      )
    })
    let _ = lg::liquid_collapsible_tabs_node(
      w,
      ["Home", "Browse", "Radio"],
      fn() { tab.get() },
      fn(i) { tab.set(i) },
      fn() { minimized.get() },
      fn() { minimized.set(false) },
      fn() { () },
      label="iOS 26 Tabs",
      expanded_width=320.0,
    )
  })
}

fn ios26_search_morph_stage(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let field = ui::Field::new()
  let expanded = signals::signal(false)
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)).padding(view::Live::Is((24.0, 24.0, 24.0, 24.0)))
    ios26_backdrop(w)
    let _ = lg::liquid_search_morph_node(
      w,
      field,
      fn() { expanded.get() },
      fn(v) { expanded.set(v) },
      width=380.0,
      placeholder="Search Liquid Glass...",
    )
  })
}

fn main() -> Unit {
  host::install()
  let dir_out = ui::env("MBUI_LG_OUT")
  let dir_shots = ui::env("MBUI_LG_SHOTS")
  let dir = if dir_out != "" {
    dir_out
  } else if dir_shots != "" {
    dir_shots
  } else {
    "shots_out_latest"
  }
  let font = ui::env("MBUI_LG_FONT")
  if font != "" {
    let _ = ui::face_add(hostapi::face_ui, font, 400)
  }
  let only = ui::env("MBUI_LG_ONLY")
  let page_w = env_double("MBUI_LG_W", 1280.0)
  let page_h = env_double("MBUI_LG_H", 1040.0)
  let page_scale = env_double("MBUI_LG_SCALE", 3.0)
  let mut failed = 0

  for pg in ["overview", "dialog", "interactive", "film", "merge"] {
    if only != "" && only != pg {
      continue
    }
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let path = "\{dir}/\{pg}-\{mode}.png"
      let (w, h, scale) = if pg == "film" {
        (600.0, 400.0, 3.0)
      } else if pg == "merge" {
        (560.0, 360.0, 3.0)
      } else {
        (page_w, page_h, page_scale)
      }
      let ok = film::picture(
        fn(root) { lg_pages::page(root, pg) },
        path=path,
        w=w,
        h=h,
        scale=scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "" || only == "gallery" {
    let gallery_h = 1040.0 + lg_pages::bar_top + lg_pages::bar_h
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      for shot in gallery_shots {
        let (name, first, script) = shot
        lg::set_dark(Some(dark))
        let path = "\{dir}/gallery-\{name}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::gallery(root, first) },
          path=path,
          w=1280.0,
          h=gallery_h,
          scale=3.0,
          dark=dark,
          script=script,
          at=1000.0,
          theme=lg::ui_theme,
        )
        let st = if ok { "ok" } else { "failed" }
        film::say("shots: \{path} \{st}")
        if !ok {
          failed += 1
        }
      }
    }
  }

  if only == "" || only == "film" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/film-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "film") },
        script=film_script,
        out=out,
        w=600.0,
        h=400.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{out} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "stage" {
    lg::set_dark(Some(true))
    let out = "\{dir}/stage-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script=stage_script,
      out=out,
      w=1120.0,
      h=690.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    let st = if ok { "ok" } else { "failed" }
    film::say("shots: \{out} \{st}")
    if !ok {
      failed += 1
    }
  }

  if only == "stage-merge" {
    let sizes : Array[(String, Double, Double, Int)] = [
      ("1120x637", 1120.0, 637.0, 587),
      ("1120x690", 1120.0, 690.0, 640),
    ]
    for sz in sizes {
      let (tag, w, h, dock_y) = sz
      for dark in [false, true] {
        lg::set_dark(Some(dark))
        let mode = if dark { "dark" } else { "light" }
        let path = "\{dir}/stage-merge-\{tag}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::page(root, "overview") },
          path=path,
          w=w,
          h=h,
          scale=3.0,
          dark=dark,
          script="tapxy 735 \{dock_y}\nwait 1000",
          at=1000.0,
          theme=lg::ui_theme,
        )
        let st = if ok { "ok" } else { "failed" }
        film::say("shots: \{path} \{st}")
        if !ok {
          failed += 1
        }
      }
    }
    lg::set_dark(Some(true))
    let out = "\{dir}/stage-merge-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script=stage_merge_script,
      out=out,
      w=1120.0,
      h=690.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    let st = if ok { "ok" } else { "failed" }
    film::say("shots: \{out} \{st}")
    if !ok {
      failed += 1
    }
  }

  if only == "sync-loupe" {
    let merge_frames : Array[(String, String)] = [
      ("merge-sync-1-pre-split", "tapxy 735 587\nwait 400\ndrag 472 305 18 0 300"),
      ("merge-sync-2-post-split", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 350\nwait 600"),
      ("merge-sync-3-near-hover", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 300\nwait 600\ndrag 528 305 -45 0 400\nwait 300"),
      ("merge-sync-4-contact-fuse", "tapxy 735 587\nwait 400\ndrag 472 305 26 0 300\nwait 600\ndrag 528 305 -48 0 400\nwait 500"),
    ]
    lg::set_dark(Some(true))
    for frame in merge_frames {
      let (fname, script) = frame
      let path = "\{dir}/\{fname}.png"
      let ok = film::picture(
        fn(root) { lg_pages::page(root, "overview") },
        path=path,
        w=1120.0,
        h=637.0,
        scale=3.0,
        dark=true,
        script=script,
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let path = "\{dir}/loupe-1120x637-\{mode}.png"
      let ok = film::picture(
        fn(root) { lg_pages::page(root, "overview") },
        path=path,
        w=1120.0,
        h=637.0,
        scale=3.0,
        dark=dark,
        script="tapxy 618 587\nwait 600",
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
    lg::set_dark(Some(true))
    let clip_out = "\{dir}/merge-sync-demo.mp4"
    let clip_ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script="tapxy 735 587\nwait 350\ndrag 472 305 26 0 800\nwait 500\ndrag 528 305 -45 0 400\nwait 400\ndrag 483 305 -10 0 300\nwait 450",
      out=clip_out,
      w=1120.0,
      h=637.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    let clip_st = if clip_ok { "ok" } else { "failed" }
    film::say("shots: \{clip_out} \{clip_st}")
    if !clip_ok {
      failed += 1
    }
  }

  if only == "" || only == "merge" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/merge-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "merge") },
        script=merge_script,
        out=out,
        w=560.0,
        h=360.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{out} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "library" {
    let lib_scale = env_double("MBUI_LG_SCALE", 2.0)
    let lib_shots : Array[(String, Bool, Double, Double, String)] = [
      ("lib-controls-dark", true, 1280.0, 800.0, ""),
      ("lib-controls-light", false, 1280.0, 800.0, ""),
      ("lib-inputs-dark", true, 1280.0, 800.0, "tap Inputs\nwait 500"),
      ("lib-nav-dark", true, 1280.0, 800.0, "tap Navigation\nwait 500"),
      ("lib-nav-light", false, 1280.0, 800.0, "tap Navigation\nwait 500"),
      ("lib-overlays-dark", true, 1280.0, 800.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("lib-overlays-light", false, 1280.0, 800.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("lib-optics-dark", true, 1280.0, 800.0, "tap Optics\nwait 500"),
      ("lib-physics-dark", true, 1280.0, 800.0, "tap Physics\nwait 500"),
      ("web-lg-hero-dark", true, 1120.0, 690.0, ""),
      ("web-lg-hero-light", false, 1120.0, 690.0, ""),
      ("web-lg-overlays-dark", true, 1120.0, 690.0, "tap Overlays\nwait 500\ntap Open Menu\nwait 500"),
      ("web-lg-inputs-light", false, 1120.0, 690.0, "tap Inputs\nwait 500"),
      ("web-lg-physics-dark", true, 1120.0, 690.0, "tap Physics\nwait 500\ntapxy 512 105\nwait 500"),
    ]
    for item in lib_shots {
      let (name, dark, w, h, script) = item
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root) { lg_pages::gallery(root, "library", chrome=true) },
        path=path,
        w=w,
        h=h,
        scale=lib_scale,
        dark=dark,
        script=script,
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "library-film" {
    lg::set_dark(Some(true))
    let out = "\{dir}/lg-library-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::gallery(root, "library", chrome=true) },
      script=library_film_script,
      out=out,
      w=1280.0,
      h=800.0,
      scale=2.0,
      dark=true,
      fps=60,
      theme=lg::ui_theme,
    )
    let st = if ok { "ok" } else { "failed" }
    film::say("shots: \{out} \{st}")
    if !ok {
      failed += 1
    }
  }

  if only == "ios26" {
    let collapsible_script = "wait 350\ntap Browse\nwait 350\ntap Minimize\nwait 750\ntap Expand Browse\nwait 750"
    let search_script = "wait 350\ntap Search\nwait 850\ntap Cancel Search\nwait 850"
    for dark in [false, true] {
      let tag = if dark { "dark" } else { "light" }
      lg::set_dark(Some(dark))
      let out1 = "\{dir}/ios26-collapsible-\{tag}.mp4"
      let ok1 = film::film(
        ios26_collapsible_stage,
        script=collapsible_script,
        out=out1,
        w=560.0,
        h=240.0,
        scale=3.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let st1 = if ok1 { "ok" } else { "failed" }
      film::say("shots: \{out1} \{st1}")
      if !ok1 {
        failed += 1
      }
      let out2 = "\{dir}/ios26-search-morph-\{tag}.mp4"
      let ok2 = film::film(
        ios26_search_morph_stage,
        script=search_script,
        out=out2,
        w=560.0,
        h=200.0,
        scale=3.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let st2 = if ok2 { "ok" } else { "failed" }
      film::say("shots: \{out2} \{st2}")
      if !ok2 {
        failed += 1
      }
    }
  }

  if failed > 0 {
    film::say("shots: \{failed} failed")
  }
}
