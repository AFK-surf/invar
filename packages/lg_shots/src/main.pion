/// High-contrast non-glass optical backdrop for standalone iOS 26 component offscreen demos.
fn ios26_backdrop(w : view::View) -> Unit {
  let _ = w.box(fn(bg) {
    let _ = bg
    .over(view::Live::Is(true))
    .clips(view::Live::Is(true))
    .points(view::Live::Is(false))
    .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0EFFL } else { 0xF4F1EAFFL } }))
    let _ = bg.box(fn(orb) {
      let _ = orb
      .over(view::Live::Is(true))
      .width(view::Live::Is(Some(156.0)))
      .height(view::Live::Is(Some(156.0)))
      .radius(view::Live::Is(78.0))
      .offset(view::Live::Is((52.0, 26.0)))
      .ground(view::Live::Is(0xEF6334FFL))
    })
    let _ = bg.box(fn(plate) {
      let _ = plate
      .over(view::Live::Is(true))
      .width(view::Live::Is(Some(240.0)))
      .height(view::Live::Is(Some(96.0)))
      .radius(view::Live::Is(24.0))
      .offset(view::Live::Is((220.0, 74.0)))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0xF5F2EBFFL } else { 0x151720FFL } }))
    })
    let _ = bg.box(fn(ribbon) {
      let _ = ribbon
      .over(view::Live::Is(true))
      .width(view::Live::Is(Some(900.0)))
      .height(view::Live::Is(Some(3.0)))
      .offset(view::Live::Is((-120.0, 148.0)))
      .turn(view::Live::Is(-0.22))
      .ground(view::Live::Is(0xEF633455L))
    })
  })
}

fn ios26_collapsible_stage(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let tab = signals::signal(0)
  let minimized = signals::signal(false)
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Between)).padding(view::Live::Is((24.0, 24.0, 24.0, 28.0)))
    ios26_backdrop(w)
    let _ = w.box(fn(top_row) {
      let _ = top_row.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = lg::liquid_button_node(
        top_row,
        fn() { if minimized.get() { "Expand" } else { "Minimize" } },
        fn() { minimized.set(!minimized.untracked()) },
        flat=true,
      )
    })
    let _ = lg::liquid_collapsible_tabs_node(
      w,
      ["Home", "Browse", "Radio"],
      fn() { tab.get() },
      fn(i) { tab.set(i) },
      fn() { minimized.get() },
      fn() { minimized.set(false) },
      fn() { () },
      label="iOS 26 Tabs",
      expanded_width=320.0,
    )
  })
}

fn ios26_search_morph_stage(root : view::View) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let field = ui::Field::new()
  let expanded = signals::signal(false)
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle)).padding(view::Live::Is((24.0, 24.0, 24.0, 24.0)))
    ios26_backdrop(w)
    let _ = lg::liquid_search_morph_node(
      w,
      field,
      fn() { expanded.get() },
      fn(v) { expanded.set(v) },
      width=380.0,
      placeholder="Search Liquid Glass...",
    )
  })
}

fn apple_chat_scene(root : view::View, pre_scroll : Double) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let show_detail = signals::signal(true)
  let search_field = ui::Field::new()
  let msg_field = ui::Field::new()
  msg_field.set("Looks crisp on 2x Metal!")
  let scroll = view::Scroll::new()
  scroll.put(pre_scroll)
  let _ = lg::split_shell_node(
    root,
    fn(sb : view::View) -> Unit {
      let _ = sb.padding(view::Live::Is((12.0, 14.0, 12.0, 12.0))).gap(view::Live::Is(10.0))
      let _ = sb.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .rigid()
        let _ = hdr.box(fn(t : view::View) -> Unit {
          let _ = t
          .words(view::Live::Is("Messages"), look=lg::words_at(19.0, weight=700))
          .ink(view::Live::By(fn() { lg::surface().ink }))
        })
        let _ = lg::liquid_button_node(
          hdr,
          fn() { "New Message" },
          fn() -> Unit { () },
          content=fn(c : view::View) -> Unit {
            let _ = lg::icon_node(c, lg::IconKind::Edit, size=15.0, ink=fn() { lg::surface().ink })
          },
          flat=true,
          ghost=true,
          height=30.0,
          pad_x=7.0,
        )
      })
      let _ = lg::liquid_text_field_node(
        sb,
        search_field,
        placeholder="Search",
        flat=true,
      )
      let _ = ui::scroll_box(sb, fn(list : view::View) -> Unit {
        let _ = list.gap(view::Live::Is(4.0))
        let channels : Array[(String, String, String, Int, Bool)] = [
          ("#liquid-glass", "Scroll-under refraction live", "10:44", 2, true),
          ("#design-review", "SF Mono code blocks ready", "10:18", 0, false),
          ("#release-eng", "2x Metal shots verified", "09:52", 1, false),
          ("Alex Rivera", "Approved the PageShell PR", "Yesterday", 0, false),
          ("Maya Lin", "36pt hit area audit green", "Mon", 0, false),
        ]
        for ch in channels {
          let (name, preview, stamp, unread, selected) = ch
          let _ = list.box(fn(row : view::View) -> Unit {
            let _ = row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Start)))
            .padding(view::Live::Is((10.0, 9.0, 10.0, 9.0)))
            .gap(view::Live::Is(10.0))
            .radius(view::Live::Is(lg::r_row))
            .ground(view::Live::By(fn() { if selected { lg::surface().row_selected } else { lg::clear } }))
            let _ = row.box(fn(av : view::View) -> Unit {
              let _ = av
              .width(view::Live::Is(Some(32.0)))
              .height(view::Live::Is(Some(32.0)))
              .radius(view::Live::Is(16.0))
              .shrink(view::Live::Is(0.0))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .ground(view::Live::By(fn() { if selected { lg::surface().accent } else { lg::surface().card_secondary } }))
              let _ = lg::icon_node(
                av,
                if name.slice(0, 1) == "#" { lg::IconKind::Hash } else { lg::IconKind::Users },
                size=14.0,
                ink=fn() { if selected { lg::white } else { lg::surface().ink_secondary } },
              )
            })
            let _ = row.box(fn(col : view::View) -> Unit {
              let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(2.0))
              let _ = col.box(fn(top_r : view::View) -> Unit {
                let _ = top_r
                .row(view::Live::Is(true))
                .lies_along(view::Live::Is(view::Lies::Between))
                .lines_up(view::Live::Is(Some(view::Along::Start)))
                .gap(view::Live::Is(6.0))
                let _ = top_r.box(fn(nm : view::View) -> Unit {
                  let _ = nm
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .words(view::Live::Is(name), look=lg::words_at(13.5, weight=600, lines=1))
                  .ink(view::Live::By(fn() { lg::surface().ink }))
                })
                let _ = top_r.box(fn(tm : view::View) -> Unit {
                  let _ = tm
                  .shrink(view::Live::Is(0.0))
                  .padding(view::Live::Is((0.0, 2.0, 0.0, 0.0)))
                  .words(view::Live::Is(stamp), look=lg::words_at(11.0, lines=1))
                  .ink(view::Live::By(fn() { lg::surface().ink_tertiary }))
                })
              })
              let _ = col.box(fn(bot_r : view::View) -> Unit {
                let _ = bot_r
                .row(view::Live::Is(true))
                .lies_along(view::Live::Is(view::Lies::Between))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(6.0))
                let _ = bot_r.box(fn(pv : view::View) -> Unit {
                  let _ = pv
                  .grow(view::Live::Is(1.0))
                  .shrink(view::Live::Is(1.0))
                  .min_width(view::Live::Is(Some(0.0)))
                  .words(view::Live::Is(preview), look=lg::words_at(12.0, lines=1))
                  .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
                })
                if unread > 0 {
                  let _ = lg::liquid_count_badge_node(bot_r, fn() { unread }, tone=lg::LiquidTone::Accent)
                }
              })
            })
          })
        }
      })
    },
    fn(dt : view::View) -> Unit {
      let is_narrow = fn() -> Bool {
        let w = dt.window_w()
        w > 0.0 && w < 760.0
      }
      let blue_bubble = fn(feed : view::View, msg : String) -> Unit {
        let _ = feed.box(fn(r : view::View) -> Unit {
          let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End))
          let _ = r.box(fn(bub : view::View) -> Unit {
            let _ = bub
            .max_width(view::Live::By(fn() { Some(if is_narrow() { 290.0 } else { 460.0 }) }))
            .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
            .radius(view::Live::Is(18.0))
            .ground(view::Live::By(fn() { lg::surface().accent }))
            let _ = bub.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::Is(msg), look=lg::words_at(14.0, wrap=true))
              .ink(view::Live::Is(lg::white))
            })
          })
        })
      }
      let peer_bubble = fn(feed : view::View, sender : String, msg : String) -> Unit {
        let _ = feed.box(fn(r : view::View) -> Unit {
          let _ = r.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Start))
          let _ = r.box(fn(bub : view::View) -> Unit {
            let _ = bub
            .max_width(view::Live::By(fn() { Some(if is_narrow() { 300.0 } else { 480.0 }) }))
            .padding(view::Live::Is((14.0, 10.0, 14.0, 10.0)))
            .gap(view::Live::Is(4.0))
            .radius(view::Live::Is(18.0))
            .ground(view::Live::By(fn() { lg::surface().card }))
            .edge(view::Live::By(fn() { (lg::hairline_w, lg::surface().separator) }))
            let _ = bub.box(fn(s : view::View) -> Unit {
              let _ = s
              .words(view::Live::Is(sender), look=lg::words_at(11.5, weight=600))
              .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
            let _ = bub.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(view::Live::Is(msg), look=lg::words_at(14.0, wrap=true))
              .ink(view::Live::By(fn() { lg::surface().ink }))
            })
          })
        })
      }
      let _ = lg::page_shell_node(
        dt,
        fn(feed : view::View) -> Unit {
          let _ = feed.padding(view::Live::Is((16.0, 6.0, 16.0, 12.0))).gap(view::Live::Is(12.0))
          // Vivid Apple blue bubble positioned right behind the floating top glass islands after pre-scroll
          blue_bubble(
            feed,
            "Scroll-under PageShell is live: content glides directly beneath the floating Liquid Glass header and progressive blur edge.",
          )
          peer_bubble(
            feed,
            "Alex Rivera",
            "Verified on wide and narrow viewports. Notice how the top glass islands refract the blue bubble cleanly with zero hard divider.",
          )
          blue_bubble(
            feed,
            "Here is the one-call Pit-of-Success layout snippet with SF Mono code blocks and adaptive ComposerBar:",
          )
          // Native SF Mono CodeBlock
          let _ = lg::surface_code_block_node(
            feed,
            fn() {
              "<lg::PageShell in={root} bottom={fn(b) {\n" +
              "  <lg::ComposerBar in={b} field={msg} on_send={send} />\n" +
              "}} />"
            },
            lang=fn() { "pion" },
          )
          // Clean GFM-style comparison table card
          let _ = lg::surface_card_node(
            feed,
            fn(tbl : view::View) -> Unit {
              let _ = tbl.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                .row(view::Live::Is(true))
                .padding(view::Live::Is((12.0, 9.0, 12.0, 9.0)))
                .ground(view::Live::By(fn() { lg::surface().card_secondary }))
                for col_name in ["Primitive", "Layer", "Audit"] {
                  let _ = hdr.box(fn(cell : view::View) -> Unit {
                    let _ = cell
                    .grow(view::Live::Is(1.0))
                    .shrink(view::Live::Is(1.0))
                    .basis(view::Live::Is(Some(0.0)))
                    .min_width(view::Live::Is(Some(0.0)))
                    .words(view::Live::Is(col_name), look=lg::words_at(12.0, weight=600, lines=1))
                    .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
                  })
                }
              })
              let rows : Array[(String, String, String)] = [
                ("PageShell", "Scroll-Under", "0 faults"),
                ("ComposerBar", "Adaptive Glass", "36pt hit"),
                ("CodeBlock", "SF Mono Solid", "Scroll-X"),
              ]
              for row_item in rows {
                let (c0, c1, c2) = row_item
                let _ = tbl.box(fn(sep : view::View) -> Unit {
                  let _ = sep.height(view::Live::Is(Some(lg::hairline_w))).ground(view::Live::By(fn() { lg::surface().separator }))
                })
                let _ = tbl.box(fn(tr : view::View) -> Unit {
                  let _ = tr.row(view::Live::Is(true)).padding(view::Live::Is((12.0, 8.0, 12.0, 8.0)))
                  for cell_val in [c0, c1, c2] {
                    let _ = tr.box(fn(cell : view::View) -> Unit {
                      let _ = cell
                      .grow(view::Live::Is(1.0))
                      .shrink(view::Live::Is(1.0))
                      .basis(view::Live::Is(Some(0.0)))
                      .min_width(view::Live::Is(Some(0.0)))
                      .words(view::Live::Is(cell_val), look=lg::words_at(12.5, lines=1))
                      .ink(view::Live::By(fn() { lg::surface().ink }))
                    })
                  }
                })
              }
            },
            radius=lg::r_row,
            pad=0.0,
            label=fn() { "Component Audit Summary" },
          )
          // Decision card with prominent primary + flat secondary buttons
          let _ = lg::surface_card_node(
            feed,
            fn(card : view::View) -> Unit {
              let _ = card.box(fn(t : view::View) -> Unit {
                let _ = t
                .words(view::Live::Is("Approve Step 3 Liquid Glass Release?"), look=lg::words_at(15.0, weight=600))
                .ink(view::Live::By(fn() { lg::surface().ink }))
              })
              let _ = card.box(fn(sub : view::View) -> Unit {
                let _ = sub
                .words(
                  view::Live::Is("All 47 packages pass check, test, and lg::assert_apple_ui across 60/120/24/7 fps."),
                  look=lg::words_at(13.0, wrap=true),
                )
                .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
              })
              let _ = card.box(fn(acts : view::View) -> Unit {
                let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                let _ = lg::liquid_button_node(acts, fn() { "Approve" }, fn() -> Unit { () }, prominent=true)
                let _ = lg::liquid_button_node(acts, fn() { "Revise" }, fn() -> Unit { () }, flat=true)
              })
            },
            radius=lg::r_panel,
            pad=12.0,
            gap=8.0,
            label=fn() { "Release Decision" },
          )
          // Vivid Apple blue bubble positioned right behind the floating ComposerBar glass capsule!
          blue_bubble(
            feed,
            "And this vibrant blue bubble glides directly behind the floating ComposerBar capsule so the adaptive Liquid Glass refracts it in real time!",
          )
          blue_bubble(
            feed,
            "Ready for 2x Apple Metal offscreen verification across both Light and Dark appearances.",
          )
          peer_bubble(
            feed,
            "Maya Lin",
            "All four viewports look sharp — zero clipping, zero glass nesting, and smooth scroll-edge blur.",
          )
        },
        leading=fn(l : view::View) -> Unit {
          l.show(
            is_narrow,
            fn(back_slot : view::View) -> Unit {
              let _ = lg::liquid_back_button_node(back_slot, fn() -> Unit { show_detail.set(false) })
            },
            at_once=true,
          )
          let _ = lg::liquid_bar_pill_group_node(
            l,
            fn(p : view::View) -> Unit {
              let _ = p.box(fn(inner : view::View) -> Unit {
                let _ = inner
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .padding(view::Live::Is((10.0, 0.0, 12.0, 0.0)))
                .gap(view::Live::Is(6.0))
                let _ = lg::icon_node(inner, lg::IconKind::Hash, size=14.0, ink=fn() { lg::surface().accent })
                let _ = inner.box(fn(t : view::View) -> Unit {
                  let _ = t
                  .words(view::Live::Is("liquid-glass"), look=lg::words_at(14.0, weight=600, lines=1))
                  .ink(view::Live::By(fn() { lg::surface().ink }))
                })
              })
            },
            height=36.0,
            label=fn() { "Channel" },
          )
        },
        trailing=fn(tr : view::View) -> Unit {
          let _ = lg::liquid_bar_pill_group_node(
            tr,
            fn(p : view::View) -> Unit {
              let _ = lg::liquid_button_node(
                p,
                fn() { "Search" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = lg::icon_node(c, lg::IconKind::Search, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              p.show(
                fn() { !is_narrow() },
                fn(extra : view::View) -> Unit {
                  let _ = extra.row(view::Live::Is(true)).gap(view::Live::Is(2.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                  let _ = lg::liquid_button_node(
                    extra,
                    fn() { "Pin" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = lg::icon_node(c, lg::IconKind::Pin, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                  let _ = lg::liquid_button_node(
                    extra,
                    fn() { "Volume" },
                    fn() -> Unit { () },
                    content=fn(c : view::View) -> Unit { let _ = lg::icon_node(c, lg::IconKind::Volume, size=15.0) },
                    flat=true,
                    ghost=true,
                    height=30.0,
                    pad_x=10.5,
                  )
                },
                at_once=true,
              )
              let _ = lg::liquid_button_node(
                p,
                fn() { "Users" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = lg::icon_node(c, lg::IconKind::Users, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
              let _ = lg::liquid_button_node(
                p,
                fn() { "Info" },
                fn() -> Unit { () },
                content=fn(c : view::View) -> Unit { let _ = lg::icon_node(c, lg::IconKind::Info, size=15.0) },
                flat=true,
                ghost=true,
                height=30.0,
                pad_x=10.5,
              )
            },
            height=36.0,
            label=fn() { "Actions" },
          )
        },
        bottom=fn(bot : view::View) -> Unit {
          let _ = lg::composer_bar_node(
            bot,
            msg_field,
            fn() -> Unit { () },
            placeholder="Message #liquid-glass",
            on_attach=fn() -> Unit { () },
          )
        },
        scroll=scroll,
      )
    },
    show_detail=fn() { show_detail.get() },
  )
}

/// A page whose top bar carries bare title text over the scrolled content: `<lg::PageShell title subtitle>`
/// mounts its compact 66pt full-height `smoothstep` fade behind the title, while vivid blocks scroll beneath it.
fn apple_titled_scene(root : view::View, pre_scroll : Double) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let scroll = view::Scroll::new()
  scroll.put(pre_scroll)
  let block = fn(feed : view::View, ground : Int64, msg : String) -> Unit {
    let _ = feed.box(fn(b : view::View) -> Unit {
      let _ = b
      .padding(view::Live::Is((16.0, 14.0, 16.0, 14.0)))
      .radius(view::Live::Is(18.0))
      .ground(view::Live::Is(ground))
      let _ = b.box(fn(w : view::View) -> Unit {
        let _ = w.words(view::Live::Is(msg), look=lg::words_at(15.0, weight=600, wrap=true)).ink(view::Live::Is(lg::white))
      })
    })
  }
  let _ = lg::page_shell_node(
    root,
    fn(content : view::View) -> Unit {
      let _ = content.box(fn(feed : view::View) -> Unit {
        let _ = feed.padding(view::Live::Is((16.0, 6.0, 16.0, 16.0))).gap(view::Live::Is(12.0))
        block(feed, lg::surface().accent, "Bright blue content scrolls straight under the bare title text.")
        block(feed, 0xFF9500FFL, "The soft fade keeps the title readable without a hard edge.")
        block(feed, 0x34C759FFL, "Only the top 66pt is faded; everything below stays crisp.")
        let _ = lg::surface_card_node(
          feed,
          fn(c : view::View) -> Unit {
            let _ = c.box(fn(w : view::View) -> Unit {
              let _ = w
              .words(
                view::Live::Is("Bars made only of glass islands get no blur at all: content refracts through the islands themselves."),
                look=lg::words_at(14.0, wrap=true),
              )
              .ink(view::Live::By(fn() { lg::surface().ink_secondary }))
            })
          },
          pad=16.0,
        )
        block(feed, 0xAF52DEFFL, "Purple content below the fade.")
        block(feed, 0xFF2D55FFL, "Pink content, fully sharp.")
        block(feed, 0x5AC8FAFFL, "Teal content, fully sharp.")
        block(feed, lg::surface().accent, "Another blue block.")
        let _ = feed.box(fn(sp : view::View) -> Unit { let _ = sp.height(view::Live::Is(Some(240.0))) })
      })
    },
    title=fn() { "Liquid Glass" },
    subtitle=fn() { "Scroll-under soft fade" },
    scroll=scroll,
  )
}

fn main() -> Unit {
  host::install()
  let dir_out = ui::env("MBUI_LG_OUT")
  let dir_shots = ui::env("MBUI_LG_SHOTS")
  let dir = if dir_out != "" {
    dir_out
  } else if dir_shots != "" {
    dir_shots
  } else {
    "shots_out_latest"
  }
  let font = ui::env("MBUI_LG_FONT")
  if font != "" {
    let _ = ui::face_add(hostapi::face_ui, font, 400)
  }
  let only = ui::env("MBUI_LG_ONLY")
  let page_w = env_double("MBUI_LG_W", 1280.0)
  let page_h = env_double("MBUI_LG_H", 1040.0)
  let page_scale = env_double("MBUI_LG_SCALE", 3.0)
  let mut failed = 0

  for pg in ["overview", "dialog", "interactive", "film", "merge"] {
    if only != "" && only != pg {
      continue
    }
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let path = "\{dir}/\{pg}-\{mode}.png"
      let (w, h, scale) = if pg == "film" {
        (600.0, 400.0, 3.0)
      } else if pg == "merge" {
        (560.0, 360.0, 3.0)
      } else {
        (page_w, page_h, page_scale)
      }
      let ok = film::picture(
        fn(root) { lg_pages::page(root, pg) },
        path=path,
        w=w,
        h=h,
        scale=scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "" || only == "gallery" {
    let gallery_h = 1040.0 + lg_pages::bar_top + lg_pages::bar_h
    for dark in [false, true] {
      let mode = if dark { "dark" } else { "light" }
      for shot in gallery_shots {
        let (name, first, script) = shot
        lg::set_dark(Some(dark))
        let path = "\{dir}/gallery-\{name}-\{mode}.png"
        let ok = film::picture(
          fn(root) { lg_pages::gallery(root, first) },
          path=path,
          w=1280.0,
          h=gallery_h,
          scale=3.0,
          dark=dark,
          script=script,
          at=1000.0,
          theme=lg::ui_theme,
        )
        let st = if ok { "ok" } else { "failed" }
        film::say("shots: \{path} \{st}")
        if !ok {
          failed += 1
        }
      }
    }
  }

  if only == "" || only == "film" {
    for dark in [false, true] {
      lg::set_dark(Some(dark))
      let mode = if dark { "dark" } else { "light" }
      let out = "\{dir}/film-\{mode}.mp4"
      let ok = film::film(
        fn(root) { lg_pages::page(root, "film") },
        script=film_script,
        out=out,
        w=600.0,
        h=400.0,
        scale=2.0,
        dark=dark,
        fps=60,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{out} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if only == "stage" {
    lg::set_dark(Some(true))
    let out = "\{dir}/stage-demo-dark.mp4"
    let ok = film::film(
      fn(root) { lg_pages::page(root, "overview") },
      script=stage_script,
      out=out,
      w=1120.0,
      h=690.0,
      scale=2.0,
