      ("content-layer-narrow320-light", false, 320.0, 440.0),
    ]
    for item in cases {
      let (name, dark, w, h) = item
      lg::set_dark(Some(dark))
      let path = "\{dir}/\{name}.png"
      let ok = film::picture(
        fn(root : view::View) -> Unit {
          ui::set_tree_theme(lg::ui_theme)
          let _ = root
          .ground(view::Live::By(fn() { lg::surface().canvas }))
          .padding(view::Live::Is((16.0, 14.0, 16.0, 16.0)))
          .gap(view::Live::Is(12.0))
          let _ = lg::liquid_nav_bar_node(
            root,
            fn() { "Invar Two-Layer" },
            subtitle=fn() { "Solid Content + Floating Glass" },
            trailing=fn(tr : view::View) -> Unit {
              let _ = lg::liquid_bar_pill_group_node(tr, fn(p : view::View) -> Unit {
                let _ = lg::liquid_button_node(p, fn() { "Run" }, fn() -> Unit { () }, flat=true, ghost=true, pad_x=10.0)
              })
            },
          )
          let _ = lg::surface_section_node(
            root,
            fn(sec : view::View) -> Unit {
              let _ = sec.gap(view::Live::Is(10.0))
              let _ = sec.box(fn(hdr : view::View) -> Unit {
                let _ = hdr.words(view::Live::Is("Clean Apple Content Surface"), look=lg::words_at(15.0, weight=600)).ink(view::Live::By(fn() { lg::surface().ink }))
              })
              let _ = sec.box(fn(sub : view::View) -> Unit {
                let _ = sub.words(view::Live::Is("Zero liquid glass on content cards; horizontal scroll keeps long code intact even at 320pt."), look=lg::words_at(13.0, wrap=true)).ink(view::Live::By(fn() { lg::surface().ink_secondary }))
              })
              let _ = lg::surface_code_block_node(sec, fn() { sample_code }, lang=fn() { "pion" })
              let _ = sec.box(fn(row : view::View) -> Unit {
                let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
                let _ = lg::liquid_button_node(row, fn() { "Deploy" }, fn() -> Unit { () }, prominent=true)
                let _ = lg::liquid_badge_node(row, fn() { "0 glass on content" }, tone=lg::LiquidTone::Success, dot=true)
              })
            },
            header=fn() { "SURFACE CODE BLOCK" },
            footer=fn() { "Verified with lg::assert_apple_ui" },
            pad=14.0,
          )
        },
        path=path,
        w=w,
        h=h,
        scale=cl_scale,
        dark=dark,
        at=1000.0,
        theme=lg::ui_theme,
      )
      let st = if ok { "ok" } else { "failed" }
      film::say("shots: \{path} \{st}")
      if !ok {
        failed += 1
      }
    }
  }

  if failed > 0 {
    film::say("shots: \{failed} failed")
  }
}
