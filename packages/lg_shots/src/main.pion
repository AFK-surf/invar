// The gallery's pictures and film, drawn offscreen by invar's Apple Metal renderer (`film::picture`, `film::film`).
// Ported 1:1 from libs/liquid-glass/src/shots/main.mbt (monoid@1eec0cd3ce).
//
//   MBUI_LG_OUT=<dir> (or MBUI_LG_SHOTS=<dir>, default "shots_out_latest")
//   MBUI_LG_ONLY=<library|library-film|stage|stage-merge|sync-loupe|ios26|gallery|film|merge|overview|dialog|interactive|apple-chat|apple-titled>
//   MBUI_LG_W / MBUI_LG_H / MBUI_LG_SCALE  optional override for page picture size & scale
//   MBUI_LG_FONT                           optional font file path registered via ui::face_add(hostapi::face_ui, ...)

import "film"
import "host"
import "hostapi"
import "lg"
import "lg_pages"
import "signals"
import "ui"
import "view"

/// Parse a positive decimal string (e.g. "1120", "2.0") or return `fallback` when empty/invalid.
fn env_double(name : String, fallback : Double) -> Double {
  let s = ui::env(name)
  if s == "" {
    return fallback
  }
  let mut acc = 0.0
  let mut frac = 0.0
  let mut div = 1.0
  let mut in_frac = false
  let mut seen = false
  let n = s.length()
  let mut i = 0
  while i < n {
    let ch = s.code_unit_at(i)
    if ch == 46 && !in_frac {
      in_frac = true
    } else if ch >= 48 && ch <= 57 {
      seen = true
      let d = (ch - 48).to_double()
      if in_frac {
        div = div * 10.0
        frac = frac + d / div
      } else {
        acc = acc * 10.0 + d
      }
    } else {
      return fallback
    }
    i += 1
  }
  if seen && acc + frac > 0.0 { acc + frac } else { fallback }
}

