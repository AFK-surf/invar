// The states of a control as one reading (ControlState + StateStyle).
// Ported 1:1 from libs/mbui/src/headless/state_set.mbt.

/// A control's states as its look reads them at once.
#derive(Eq)
pub struct ControlState {
  pub hovered : Bool
  pub pressed : Bool
  pub focused : Bool
  pub focus_shown : Bool
  pub disabled : Bool
  pub selected : Bool
  pub open : Bool
  pub busy : Bool
}

/// The button's states now; `selected` and `busy` as its look says (or `pending()`).
pub fn Button::state(self : Button, selected~ : Bool = false, busy~ : Bool = false) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.node.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected,
    open: false,
    busy: busy || self.pending(),
  }
}

/// The toggle's states now: selected while it is on (or mixed); `busy` as its look says.
pub fn Toggle::state(self : Toggle, busy~ : Bool = false) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.node.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected: self.on() || self.mixed(),
    open: false,
    busy,
  }
}

/// The choice's states now: selected while it is the one chosen; `busy` as its look says.
pub fn Choice::state(self : Choice, busy~ : Bool = false) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.node.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected: self.chosen(),
    open: false,
    busy,
  }
}

/// The disclosure's states now: open while what it opens is; `busy` as its look says.
pub fn Disclosure::state(self : Disclosure, busy~ : Bool = false) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.node.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected: false,
    open: self.open(),
    busy,
  }
}

/// A menu item's states now: selected while it is checked, open while the submenu it opens is.
pub fn MenuItem::state(self : MenuItem) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected: self.checked(),
    open: self.open(),
    busy: false,
  }
}

/// A radio item's (a tab's) states now: selected while it is the one chosen.
pub fn RadioItem::state(self : RadioItem) -> ControlState {
  ControlState::{
    hovered: self.hovered(),
    pressed: self.pressed(),
    focused: self.node.focused(),
    focus_shown: self.focus_shown(),
    disabled: self.disabled(),
    selected: self.chosen(),
    open: false,
    busy: false,
  }
}

/// What one property of a look is in each state, the first said that holds winning:
/// disabled > busy > pressed > selected and hovered > selected > open > hovered > focused > base.
pub struct StateStyle[T] {
  base : T
  disabled : Option[T]
  busy : Option[T]
  pressed : Option[T]
  selected_hovered : Option[T]
  selected : Option[T]
  open : Option[T]
  hovered : Option[T]
  focused : Option[T]
}

/// A property `base` where no state said here holds, each said one in its state.
pub fn StateStyle::new[T](
  base~ : T,
  disabled? : T,
  busy? : T,
  pressed? : T,
  selected_hovered? : T,
  selected? : T,
  hovered? : T,
  focused? : T,
  open? : T,
) -> StateStyle[T] {
  StateStyle::{ base, disabled, busy, pressed, selected_hovered, selected, open, hovered, focused }
}

/// What it is in states `s`: the first said that holds.
pub fn StateStyle::resolve[T](self : StateStyle[T], s : ControlState) -> T {
  if s.disabled {
    match self.disabled {
      Some(v) => return v
      None => ()
    }
  }
  if s.busy {
    match self.busy {
      Some(v) => return v
      None => ()
    }
  }
  if s.pressed {
    match self.pressed {
      Some(v) => return v
      None => ()
    }
  }
  if s.selected && s.hovered {
    match self.selected_hovered {
      Some(v) => return v
      None => ()
    }
  }
  if s.selected {
    match self.selected {
      Some(v) => return v
      None => ()
    }
  }
  if s.open {
    match self.open {
      Some(v) => return v
      None => ()
    }
  }
  if s.hovered {
    match self.hovered {
      Some(v) => return v
      None => ()
    }
  }
  if s.focus_shown {
    match self.focused {
      Some(v) => return v
      None => ()
    }
  }
  self.base
}
