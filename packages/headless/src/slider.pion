// The slider: a value along a range (min .. max, stepped by step).
// Ported 1:1 from libs/mbui/src/headless/slider.mbt.

import "dmath"
import "headless_core"
import "view"

/// A slider as its look reads it.
pub struct Slider {
  node : view::View
  now : () -> Double
  min : Double
  max : Double
  off : () -> Bool
  hand : view::Ref[Bool]
}

pub fn Slider::value(self : Slider) -> Double {
  slider_clamp((self.now)(), self.min, self.max)
}

pub fn Slider::part(self : Slider) -> Double {
  headless_core::slider_part((self.now)(), self.min, self.max)
}

pub fn Slider::disabled(self : Slider) -> Bool {
  (self.off)()
}

pub fn Slider::pressed(self : Slider) -> Bool {
  self.node.pressed()
}

pub fn Slider::in_hand(self : Slider) -> Bool {
  self.hand.v
}

pub fn Slider::hovered(self : Slider) -> Bool {
  self.node.pointed()
}

pub fn Slider::focus_shown(self : Slider) -> Bool {
  self.node.focus_shown()
}

fn slider_clamp(x : Double, lo : Double, hi : Double) -> Double {
  headless_core::slider_clamp(x, lo, hi)
}

/// `x` held between `min` and `max`, on the nearest step from `min` (`step > 0`; else only held).
pub fn slider_snap(x : Double, min : Double, max : Double, step : Double) -> Double {
  headless_core::slider_snap(x, min, max, step)
}

/// A slider in `parent`, called `label`, at `value()` along `min` .. `max` in steps of `step`.
pub fn slider(
  parent : view::View,
  label : () -> String,
  value : () -> Double,
  min~ : Double,
  max~ : Double,
  step~ : Double,
  change : (Double) -> Unit,
  look : (view::View, Slider) -> Unit,
  thumb_room~ : Double = 0.0,
  disabled~ : () -> Bool = fn() { false },
  value_text? : (Double) -> String,
  drag? : (view::Drag) -> Unit,
  on_commit? : (Double) -> Unit,
  focus_on_press~ : Bool = true,
  vertical~ : Bool = false,
  rtl~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let step_by = if step > 0.0 { step } else { (max - min) / 100.0 }
  let whole = step >= 1.0 && step == dmath::round(step) && min == dmath::round(min)
  let text_of : (Double) -> String = match value_text {
    Some(f) => f
    None =>
      fn(v : Double) -> String {
        if whole {
          dmath::round(v).to_int().to_string()
        } else {
          v.to_string()
        }
      }
  }
  let go = fn(target : Double) -> Double {
    let next = slider_snap(target, min, max, step)
    let cur = slider_snap(value(), min, max, step)
    if next != cur {
      change(next)
    }
    next
  }
  let commit = fn(next : Double) {
    match on_commit {
      Some(f) => f(next)
      None => ()
    }
  }
  let hand = view::ref_new(false)
  parent.box(fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    look(v, Slider::{ node: v, now: value, min, max, off: disabled, hand })
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space)
      .says(view::Live::By(fn() -> Option[view::Said] {
        let now = slider_snap(value(), min, max, step)
        let acts : Array[view::Action] = if disabled() {
          let empty : Array[view::Action] = []
          empty
        } else {
          [view::Action::Increment, view::Action::Decrement]
        }
        Some(view::said(view::Role::Slider, label=label(), value=text_of(now), range=(min, now, max), actions=acts))
      }))
      .on_step(fn(by : Int) {
        if !disabled() {
          hand.v = false
          let next = go(value() + by.to_double() * step_by)
          commit(next)
        }
      })
      .on_drag(fn(d : view::Drag) {
        hand.v = true
        if !disabled() {
          match d.kind {
            Down => if focus_on_press { let _ = v.ask_focus() }
            _ => ()
          }
          match drag {
            Some(f) => f(d)
            None =>
              match d.kind {
                Down | Moved => {
                  if !vertical && d.w > thumb_room {
                    let raw = slider_clamp((d.x - thumb_room / 2.0) / (d.w - thumb_room), 0.0, 1.0)
                    let frac = if rtl { 1.0 - raw } else { raw }
                    let _ = go(min + frac * (max - min))
                  } else if vertical && d.h > thumb_room {
                    let frac = slider_clamp(1.0 - (d.y - thumb_room / 2.0) / (d.h - thumb_room), 0.0, 1.0)
                    let _ = go(min + frac * (max - min))
                  }
                }
                _ => ()
              }
          }
          match d.kind {
            Up | Off => commit(slider_snap(value(), min, max, step))
            _ => ()
          }
        }
      }, captures=true)
      .on_key(fn(k : view::Key) -> Bool {
        if disabled() || !v.focused() || k.mods != 0 {
          return false
        }
        let cur = value()
        let dec_h = if !vertical && rtl { 4 } else { 3 }
        let inc_h = if !vertical && rtl { 3 } else { 4 }
        let to : Option[Double] = if k.code == dec_h || k.code == 6 {
          Some(cur - step_by)
        } else if k.code == inc_h || k.code == 5 {
          Some(cur + step_by)
        } else if k.code == 15 {
          Some(cur + step_by * 10.0)
        } else if k.code == 16 {
          Some(cur - step_by * 10.0)
        } else if k.code == 8 {
          Some(min)
        } else if k.code == 9 {
          Some(max)
        } else {
          None
        }
        match to {
          Some(t) => {
            hand.v = false
            let next = go(t)
            commit(next)
            true
          }
          None => false
        }
      })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
