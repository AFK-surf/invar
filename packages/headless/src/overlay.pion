// The overlay: one layer of a window's stack of what floats over the rest.
// Shared stack for overlay, dialog, and popover (Escape, Back, Outside press, focus return, modal).

import "signals"
import "view"

/// What would close an overlay: Escape, Outside press, or system Back.
#derive(Eq)
pub enum OverlayDismiss {
  Escape
  Outside
  Back
}

struct OverlayEntry {
  id : view::NodeId
  node : view::View
  dismiss : (OverlayDismiss) -> Unit
  before_dismiss : Option[(OverlayDismiss) -> Bool]
  inert : () -> Bool
  escape : Bool
  outside : Bool
  anchor : () -> Option[view::View]
  keeps : Option[() -> Array[view::View]]
}

struct OverlayStack {
  entries : Array[OverlayEntry]
  changed : signals::Signal[Int]
  mut down : Int
}

let overlay_stack_key : view::Lent[OverlayStack] = view::Lent::new()

fn overlay_stack_for(v : view::View) -> OverlayStack {
  let root = view_root(v)
  match root.lent(overlay_stack_key) {
    Some(s) => s
    None => {
      let s = OverlayStack::{
        entries: [],
        changed: signals::signal(0),
        down: -1,
      }
      let _ = root.lends(overlay_stack_key, s)
      s
    }
  }
}

fn OverlayStack::drop(self : OverlayStack, id : view::NodeId) -> Unit {
  let mut i = 0
  while i < self.entries.length() {
    if self.entries[i].id == id {
      let _ = view::array_remove(self.entries, i)
      break
    }
    i += 1
  }
  self.changed.set(self.changed.untracked() + 1)
}

fn OverlayStack::bring_to_top(self : OverlayStack, id : view::NodeId) -> Unit {
  let n = self.entries.length()
  if n <= 1 {
    return
  }
  let mut i = 0
  while i < n {
    if self.entries[i].id == id {
      if i < n - 1 {
        let e = self.entries[i]
        let _ = view::array_remove(self.entries, i)
        self.entries.push(e)
        self.changed.set(self.changed.untracked() + 1)
      }
      return
    }
    i += 1
  }
}

fn OverlayStack::top_where(self : OverlayStack, takes : (OverlayEntry) -> Bool) -> Int {
  let mut i = self.entries.length() - 1
  while i >= 0 {
    let e = self.entries[i]
    if takes(e) && !(e.inert)() {
      return i
    }
    i -= 1
  }
  -1
}

fn OverlayStack::escape(self : OverlayStack, how : OverlayDismiss) -> Bool {
  let i = self.top_where(fn(e : OverlayEntry) -> Bool { e.escape })
  if i < 0 {
    return false
  }
  let e = self.entries[i]
  match e.before_dismiss {
    Some(f) => if f(how) { return true }
    None => ()
  }
  (e.dismiss)(how)
  true
}

fn press_hits_keep(k : view::View, x : Double, y : Double) -> Bool {
  if !k.alive() || k.leaving() {
    return false
  }
  if press_on(k, x, y) {
    return true
  }
  let (kx, ky, kw, kh) = k.placed_window_now()
  kw > 0.0 && kh > 0.0 && x >= kx && x <= kx + kw && y >= ky && y <= ky + kh
}

fn OverlayStack::press(self : OverlayStack, count : Int, x : Double, y : Double) -> Unit {
  if self.down == count {
    return
  }
  self.down = count
  let i = self.top_where(fn(e : OverlayEntry) -> Bool { e.outside })
  if i < 0 {
    return
  }
  let top = self.entries[i]
  let mut j = i
  while j < self.entries.length() {
    if !(self.entries[j].inert)() && press_on(self.entries[j].node, x, y) {
      return
    }
    j += 1
  }
  match (top.anchor)() {
    Some(a) => if press_on(a, x, y) { return }
    None => ()
  }
  match top.keeps {
    Some(ks) => {
      for k in ks() {
        if press_hits_keep(k, x, y) {
          return
        }
      }
    }
    None => ()
  }
  match top.before_dismiss {
    Some(f) => if f(OverlayDismiss::Outside) { return }
    None => ()
  }
  (top.dismiss)(OverlayDismiss::Outside)
}

/// An overlay as its look reads it.
pub struct Overlay {
  stack : OverlayStack
  entry : OverlayEntry
}

/// Where it is in its stack (0 the lowest; -1 once let go).
pub fn Overlay::depth(self : Overlay) -> Int {
  let _ = self.stack.changed.get()
  let mut i = 0
  while i < self.stack.entries.length() {
    if self.stack.entries[i].id == self.entry.id {
      return i
    }
    i += 1
  }
  -1
}

/// Whether it is the topmost of its stack that is not inert.
pub fn Overlay::is_top(self : Overlay) -> Bool {
  let at = self.depth()
  if at < 0 || (self.entry.inert)() {
    return false
  }
  let mut j = at + 1
  while j < self.stack.entries.length() {
    if !(self.stack.entries[j].inert)() {
      return false
    }
    j += 1
  }
  true
}

/// Closed as `how` would close it.
pub fn Overlay::dismiss(self : Overlay, how : OverlayDismiss) -> Unit {
  if !signals::untracked(self.entry.inert) {
    (self.entry.dismiss)(how)
  }
}

/// Its node.
pub fn Overlay::node(self : Overlay) -> view::View {
  self.entry.node
}

/// How many active (non-inert) overlays `tree`'s stack holds now.
pub fn overlays_open(tree : view::Tree) -> Int {
  match tree.root().lent(overlay_stack_key) {
    Some(s) => {
      let mut count = 0
      for e in s.entries {
        if !signals::untracked(e.inert) {
          count += 1
        }
      }
      count
    }
    None => 0
  }
}

/// Join `v` to the tree's overlay stack (called before `look` so `look` receives `Overlay`).
fn join_overlay(
  v : view::View,
  on_dismiss : (OverlayDismiss) -> Unit,
  dismiss_on_escape : Bool,
  dismiss_on_outside : Bool,
  inert : () -> Bool,
  anchor : () -> Option[view::View],
  before_dismiss? : (OverlayDismiss) -> Bool,
  keeps? : () -> Array[view::View],
) -> (Overlay, () -> Bool, () -> Bool) {
  let stack = overlay_stack_for(v)
  let off = fn() -> Bool { inert() || v.leaving() }
  let live = fn() -> Bool { !off() }
  let entry = OverlayEntry::{
    id: v.id(),
    node: v,
    dismiss: fn(how : OverlayDismiss) { if !signals::untracked(off) { on_dismiss(how) } },
    before_dismiss,
    inert: off,
    escape: dismiss_on_escape,
    outside: dismiss_on_outside,
    anchor,
    keeps,
  }
  stack.entries.push(entry)
  stack.changed.set(stack.changed.untracked() + 1)
  v.reacts(live, fn(on : Bool) {
    if on {
      stack.bring_to_top(entry.id)
    } else {
      stack.changed.set(stack.changed.untracked() + 1)
    }
  }, at_start=false)
  let _ = v.owns(fn() { stack.drop(entry.id) })
  (Overlay::{ stack, entry }, off, live)
}

/// Wire headless overlay behaviors onto `v` (must be called AFTER `look` so `look` cannot overwrite headless props).
fn wire_overlay(
  ov : Overlay,
  off : () -> Bool,
  live : () -> Bool,
  modal : Bool,
  dismiss_on_escape : Bool,
  dismiss_on_outside : Bool,
  anchor : () -> Option[view::View],
  return_to : Option[view::View],
  do_auto_focus : Bool,
  first_takes : Option[((view::Said) -> Bool)],
  return_focus : Bool,
  escape_gate : Option[(() -> Bool)],
  leaves_typing~ : Bool = false,
  initial_focus? : view::View,
) -> Unit {
  let v = ov.entry.node
  let stack = ov.stack
  if do_auto_focus {
    match initial_focus {
      Some(target) => {
        let _ = v.focus_opens(target).focusable(view::Live::By(live), keys=0, tab=false)
      }
      None => {
        let _ = v.focus_opens_first(takes?=first_takes).focusable(view::Live::By(live), keys=0, tab=false)
      }
    }
  } else {
    let _ = v.focus_returns()
  }
  if return_focus {
    let opener = match return_to {
      Some(r) => Some(r)
      None => anchor()
    }
    match opener {
      Some(a) => { let _ = v.opened_by(view::Opener::ByNode(a.id())) }
      None => ()
    }
  }
  if modal {
    if leaves_typing {
      let _ = v.leaves_typing()
    }
    let _ = v.modal(view::Live::By(live))
  }
  let _ = v
    .hides(view::Live::By(off))
    .presses(view::Live::By(live))
    .on_drag(fn(_d : view::Drag) { () })
  if dismiss_on_escape {
    let _ = v
      .on_key(fn(k : view::Key) -> Bool {
        if k.code != menu_key_escape || k.mods != 0 {
          return false
        }
        let ok = match escape_gate {
          Some(g) => g()
          None => true
        }
        ok && stack.escape(OverlayDismiss::Escape)
      })
      .takes_back(fn() { let _ = stack.escape(OverlayDismiss::Back) })
  }
  if dismiss_on_outside {
    window_downs_while(v, live, fn(x : Double, y : Double) {
      stack.press(signals::untracked(fn() -> Int { v.window_downs() }), x, y)
    })
  }
}

/// Shared overlay stack wiring for `dialog` and `popover` (called after `look`).
fn attach_overlay(
  v : view::View,
  on_dismiss : (OverlayDismiss) -> Unit,
  modal : Bool,
  dismiss_on_escape : Bool,
  dismiss_on_outside : Bool,
  inert : () -> Bool,
  anchor : () -> Option[view::View],
  return_to : Option[view::View],
  do_auto_focus : Bool,
  first_takes : Option[((view::Said) -> Bool)],
  return_focus : Bool,
  escape_gate : Option[(() -> Bool)],
  before_dismiss? : (OverlayDismiss) -> Bool,
  keeps? : () -> Array[view::View],
  leaves_typing~ : Bool = false,
  initial_focus? : view::View,
) -> Overlay {
  let (ov, off, live) = join_overlay(
    v,
    on_dismiss,
    dismiss_on_escape,
    dismiss_on_outside,
    inert,
    anchor,
    before_dismiss?=before_dismiss,
    keeps?=keeps,
  )
  wire_overlay(
    ov,
    off,
    live,
    modal,
    dismiss_on_escape,
    dismiss_on_outside,
    anchor,
    return_to,
    do_auto_focus,
    first_takes,
    return_focus,
    escape_gate,
    leaves_typing=leaves_typing,
    initial_focus?=initial_focus,
  )
  ov
}

/// An overlay in `parent` (`parent` itself when `in_node=true`), joining its tree's stack above all there.
pub fn overlay(
  parent : view::View,
  on_dismiss : (OverlayDismiss) -> Unit,
  look : (view::View, Overlay) -> Unit,
  modal~ : Bool = false,
  dismiss_on_escape~ : Bool = true,
  dismiss_on_outside~ : Bool = true,
  before_dismiss? : (OverlayDismiss) -> Bool,
  inert~ : () -> Bool = fn() { false },
  anchor? : view::View,
  keeps? : () -> Array[view::View],
  leaves_typing~ : Bool = false,
  auto_focus? : Bool,
  first_takes? : (view::Said) -> Bool,
  initial_focus? : view::View,
  return_focus~ : Bool = true,
  in_node~ : Bool = false,
  label? : () -> String,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let do_auto_focus = match auto_focus {
    Some(b) => b
    None => modal
  }
  let setup = fn(v : view::View) {
    let anchor_fn = fn() -> Option[view::View] { anchor }
    let (ov, off, live) = join_overlay(
      v,
      on_dismiss,
      dismiss_on_escape,
      dismiss_on_outside,
      inert,
      anchor_fn,
      before_dismiss?=before_dismiss,
      keeps?=keeps,
    )
    look(v, ov)
    wire_overlay(
      ov,
      off,
      live,
      modal,
      dismiss_on_escape,
      dismiss_on_outside,
      anchor_fn,
      None,
      do_auto_focus,
      first_takes,
      return_focus,
      None,
      leaves_typing=leaves_typing,
      initial_focus?=initial_focus,
    )
    match label {
      Some(name) => {
        let _ = v.says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Dialog, label=name())) }))
      }
      None => ()
    }
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
