// Tabs: a tab list and the panel of each tab, one tab chosen at a time.
// Ported 1:1 from libs/mbui/src/headless/tabs.mbt.

import "view"

/// Tabs made once by their caller, its list and panels made by it (`Tabs::list`, `Tabs::panel`).
pub struct Tabs[K] {
  chosen : () -> K
  choose : (K) -> Unit
  manual : Bool
  axis : GroupAxis
  rtl_fn : () -> Bool
  off : () -> Bool
}

pub fn Tabs::new[K](
  chosen : () -> K,
  choose : (K) -> Unit,
  manual~ : Bool = false,
  axis~ : GroupAxis = GroupAxis::Horizontal,
  rtl~ : Bool = false,
  rtl_by? : () -> Bool,
  disabled~ : () -> Bool = fn() { false },
) -> Tabs[K] {
  let rtl_fn : () -> Bool = match rtl_by {
    Some(f) => f
    None => fn() { rtl }
  }
  Tabs::{ chosen, choose, manual, axis, rtl_fn, off: disabled }
}

pub fn Tabs::chosen[K](self : Tabs[K]) -> K {
  (self.chosen)()
}

/// Its tab list in `parent`, called `label`.
pub fn Tabs::list[K : view::ViewEq](
  self : Tabs[K],
  parent : view::View,
  label : () -> String,
  look : (view::View, RadioGroup[K]) -> Unit,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  radio_group(
    parent,
    label,
    self.chosen,
    self.choose,
    look,
    kind=GroupKind::Tab,
    axis=self.axis,
    rtl_by=self.rtl_fn,
    disabled=self.off,
    manual=self.manual,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
}

/// A tab's panel as its look reads it.
pub struct TabPanel {
  on : () -> Bool
}

pub fn TabPanel::selected(self : TabPanel) -> Bool {
  (self.on)()
}

/// The panel of the tab of `key` in `parent`.
pub fn Tabs::panel[K : view::ViewEq](
  self : Tabs[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View, TabPanel) -> Unit,
  content : (view::View) -> Unit,
  keep_mounted~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let on = fn() -> Bool { (self.chosen)().eq(key) }
    look(v, TabPanel::{ on })
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] {
        if on() {
          Some(view::said(view::Role::TabPanel, label=label(), selected=true))
        } else {
          None
        }
      }))
      .hides(view::Live::By(fn() -> Bool { !on() }))
      .presses(view::Live::By(on))
    if keep_mounted {
      content(v)
    } else {
      v.show(on, content, at_once=true)
    }
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
