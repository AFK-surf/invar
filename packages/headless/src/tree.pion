  self.node.pointed()
}

///|
/// Whether visual press feedback is shown on this item now (`View::press_shown`, delayed in scrollers); read `node.pressed()` for immediate input logic.
pub fn TreeItem::pressed(self : TreeItem) -> Bool {
  self.node.press_shown()
}

///|
/// Map a list of item NodeIds back to their caller keys in order.
fn Tree::keys_of[K](self : Tree[K], ids : Array[view::NodeId]) -> Array[K] {
  let out : Array[K] = []
  for id in ids {
    for let mut i = 0; i < self.entries.length(); i = i + 1 {
      let e = self.entries[i]
      if e.node.id() == id {
        out.push(e.key)
        break
      }
    }
  }
  out
}

///|
/// All living item NodeIds in registration order, currently selected IDs, and a disabled predicate on NodeId.
fn Tree::selection_inputs[K](self : Tree[K]) -> (Array[view::NodeId], Array[view::NodeId], (view::NodeId) -> Bool) {
  let all_ids : Array[view::NodeId] = []
  let cur_ids : Array[view::NodeId] = []
  for e in self.entries {
    if e.node.alive() {
      let id = e.node.id()
      all_ids.push(id)
      if signals::untracked(fn() { (self.is_selected)(e.key) }) {
        cur_ids.push(id)
      }
    }
  }
  let is_off = fn(id : view::NodeId) -> Bool {
    for let mut i = 0; i < self.entries.length(); i = i + 1 {
      let e = self.entries[i]
      if e.node.id() == id {
        return !e.node.takes_input() || signals::untracked(e.off)
      }
    }
    true
  }
  (all_ids, cur_ids, is_off)
}

///|
/// Find the nearest living enabled ancestor node of `start_parent` by walking `parent_key` links.
fn Tree::living_ancestor[K : Eq](self : Tree[K], start_parent : Option[K], exclude_id : view::NodeId) -> Option[view::View] {
  let visited : Array[K] = []
  let mut cur = start_parent
  while cur is Some(pk) {
    if visited.contains(pk) {
      break
    }
    visited.push(pk)
    let mut found : Option[TreeEntry[K]] = Option::None
    for let mut i = 0; i < self.entries.length(); i = i + 1 {
      let e = self.entries[i]
      if e.key == pk {
        found = Some(e)
        break
      }
    }
    match found {
      Some(e) =>
      if e.node.id() != exclude_id &&
      e.node.alive() &&
      signals::untracked(fn() { e.node.takes_input() && !(e.off)() }) {
        return Some(e.node)
      } else {
        cur = e.parent_key
      }
      Option::None => break
    }
  }
  Option::None
}

///|
/// Convert `TreeCheckState?` to `@view.Check?` for screen-reader `Said`.
fn tree_check_to_said(state : Option[TreeCheckState]) -> Option[view::Check] {
  match state {
    Some(TreeCheckState::Unchecked) => Some(view::Check::Off)
    Some(TreeCheckState::Checked) => Some(view::Check::On)
    Some(TreeCheckState::Indeterminate) => Some(view::Check::Mixed)
    Option::None => Option::None
  }
}

///|
/// A hierarchical tree in `parent` (`parent` itself where `in_node`), called `label`, with selection (`is_selected`,
/// `pick`, optional `multiple` + `on_select_many`) and expansion (`is_expanded`, `set_expanded`). Implements WAI-ARIA
/// Tree keyboard navigation (`↓`/`↑`/`Home`/`End`, `→`/`←` expand/collapse/descend/ascend respecting `rtl`,
/// typeahead, `Enter`/`Space` activate) and parent-first focus recovery when collapsing unmounts a focused descendant.

pub fn tree[K : Eq](parent : view::View, label : () -> String, is_selected : (K) -> Bool, pick : (K) -> Unit, is_expanded : (K) -> Bool, set_expanded : (K, Bool) -> Unit, look : (view::View, Tree[K]) -> Unit, rtl? : Bool, multiple? : Bool, on_select_many? : (Array[K]) -> Unit, typeahead_ms? : Double, disabled? : () -> Bool, in_node? : Bool, made_for? : String, loc~ : String = "") -> view::View {
  let rtl = match rtl { Some(__mbt_v) => __mbt_v, None => false }
  let multiple = match multiple { Some(__mbt_v) => __mbt_v, None => false }
  let typeahead_ms = match typeahead_ms { Some(__mbt_v) => __mbt_v, None => 500.0 }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let in_node = match in_node { Some(__mbt_v) => __mbt_v, None => false }

  let tr : Tree[K] = Tree::{
    is_selected: is_selected,
    pick: pick,
    is_expanded: is_expanded,
    set_expanded: set_expanded,
    multiple: multiple,
    off: disabled,
    rove: RovingFocus::new(axis=GroupAxis::Vertical, roving=true, wraps=false),
    recovery: FocusRecovery::new(),
    entries: [],
    typeahead: Typeahead::new(window_ms=typeahead_ms),
    selection: SelectionModel::new(multiple=multiple),
  }
  let expand_key = if rtl { group_key_left } else { group_key_right }
  let collapse_key = if rtl { group_key_right } else { group_key_left }
  let setup = fn(v : view::View) {
    look(v, tr)
    v
    .says(.By(fn() { Some(view::said(.Listbox, label=label())) }))
    .on_key(fn(k) {
      if disabled() || !focus_in(v, false) {
        return false
      }
      if multiple && on_select_many is Some(many) {
        let is_select_all = (k.code == listbox_key_select_all && (k.mods == 0 || k.mods == mod_ctrl || k.mods == mod_cmd)) ||
        ((k.mods == mod_ctrl || k.mods == mod_cmd) &&
          (k.code == typeahead_key_char + 'a'.to_int() || k.code == typeahead_key_char + 'A'.to_int()))
        if is_select_all {
          let (all_ids, _, is_off) = tr.selection_inputs()
          let next_ids = tr.selection.select_all(all_ids, disabled=is_off)
          many(tr.keys_of(next_ids))
          return true
        }
        if k.mods == mod_shift &&
        (k.code == group_key_down || k.code == group_key_up || k.code == group_key_home || k.code == group_key_end) {
          if tr.selection.anchor() is Option::None {
            if v.tree.focused_now().0 is Some(f) {
              tr.selection.set_anchor(Some(f))
            }
          }
          if tr.rove.step(k.code) is Some(target) {
            let (all_ids, cur_ids, is_off) = tr.selection_inputs()
            let next_ids = tr.selection.select_range(all_ids, cur_ids, target.id(), disabled=is_off)
            many(tr.keys_of(next_ids))
            return true
          }
        }
      }
      if k.mods == 0 {
        if k.code == expand_key {
          if v.tree.focused_now().0 is Some(fid) {
            let mut focused_entry : Option[TreeEntry[K]] = Option::None
            for let mut i = 0; i < tr.entries.length(); i = i + 1 {
              if tr.entries[i].node.id() == fid {
                focused_entry = Some(tr.entries[i])
                break
              }
            }
            match focused_entry {
              Some(e) =>
              if (e.has_children)() {
                if !(tr.is_expanded)(e.key) {
                  (tr.set_expanded)(e.key, true)
                  return true
                } else {
                  for let mut i = 0; i < tr.entries.length(); i = i + 1 {
                    let c = tr.entries[i]
                    if c.parent_key == Some(e.key) && c.node.takes_input() && !(c.off)() {
                      c.node.ask_focus(visible=true) |> ignore
                      return true
                    }
                  }
                  return true
                }
              }
              Option::None => ()
            }
          }
          return false
        }
        if k.code == collapse_key {
          if v.tree.focused_now().0 is Some(fid) {
            let mut focused_entry : Option[TreeEntry[K]] = Option::None
            for let mut i = 0; i < tr.entries.length(); i = i + 1 {
              if tr.entries[i].node.id() == fid {
                focused_entry = Some(tr.entries[i])
                break
              }
            }
            match focused_entry {
              Some(e) =>
              if (e.has_children)() && (tr.is_expanded)(e.key) {
                (tr.set_expanded)(e.key, false)
                return true
              } else {
                match tr.living_ancestor(e.parent_key, fid) {
                  Some(anc) => {
                    anc.ask_focus(visible=true) |> ignore
                    return true
                  }
                  Option::None => ()
                }
              }
              Option::None => ()
            }
          }
          return false
        }
        if tr.rove.step(k.code) is Some(_) {
          return true
        }
      }
      let live = tr.rove.live()
      tr.typeahead.handle_key(k, live, fn(i) {
        let id = live[i].id()
        for let mut j = 0; j < tr.entries.length(); j = j + 1 {
          let x = tr.entries[j]
          if x.node.id() == id {
            return (x.text)()
          }
        }
        ""
      })
    })
    |> ignore
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(loc=loc, made_for=made_for.unwrap_or(loc), setup)
  }
}

///|
/// Register a visible tree item of `key` in `parent` (`parent` itself where `in_node`), with `label`, optional
/// `parent_key` (used for `←` parent navigation and collapse focus recovery), `has_children`, 1-based `level`,
/// optional tri-state `check`, optional typeahead `text`, and `disabled`. Its node.

pub fn Tree::item[K : Eq](self : Tree[K], parent : view::View, key : K, label : () -> String, look : (view::View, TreeItem) -> Unit, parent_key? : K, has_children? : () -> Bool, level? : Int, check? : () -> Option[TreeCheckState], text? : () -> String, disabled? : () -> Bool, in_node? : Bool, made_for? : String, loc~ : String = "") -> view::View {
  let has_children = match has_children { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let level = match level { Some(__mbt_v) => __mbt_v, None => 1 }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let in_node = match in_node { Some(__mbt_v) => __mbt_v, None => false }

  let setup = fn(v : view::View) {
    let off = fn() { (self.off)() || disabled() }
    let able = fn() { !off() }
    let on = fn() { (self.is_selected)(key) }
    let exp = fn() { (self.is_expanded)(key) }
    let chk = match check {
      Some(f) => f
      Option::None => fn() { None }
    }
    let removed_pos : mbt_compat::Ref[Option[Int]] = mbt_compat::ref_new(Option::None)
    self.entries.push(TreeEntry::{ node: v, key: key, parent_key: parent_key, has_children: has_children, off: off, text: text.unwrap_or(label) })
    let ancestor_fallback = fn() -> Option[view::View] {
      if self.living_ancestor(parent_key, v.id()) is Some(anc) {
        return Some(anc)
      }
      let n = self.entries.length()
      if n == 0 {
        return Option::None
      }
      let mut found_idx : Option[Int] = Option::None
      for let mut i = 0; i < n; i = i + 1 {
        if self.entries[i].node.id() == v.id() {
          found_idx = Some(i)
          break
        }
      }
      let (start_fwd, start_bwd) = match found_idx {
        Some(idx) => (idx + 1, idx - 1)
        Option::None => {
          let p = removed_pos.v.unwrap_or(0)
          (p, p - 1)
        }
      }
      for i in start_fwd..<n {
        let e = self.entries[i]
        if e.node.id() != v.id() && e.node.alive() && e.node.takes_input() && !(e.off)() {
          return Some(e.node)
        }
      }
      let mut i = if start_bwd < n { start_bwd } else { n - 1 }
      while i >= 0 {
        let e = self.entries[i]
        if e.node.id() != v.id() && e.node.alive() && e.node.takes_input() && !(e.off)() {
          return Some(e.node)
        }
        i = i - 1
      }
      Option::None
    }
    look(v, TreeItem::{ node: v, on: on, exp: exp, has_kids: has_children, lvl: level, chk: chk, off: off })
    v
    .presses(.By(able))
    .focusable(.By(able), tab=false)
    .says(.By(fn() {
      let expanded : Option[Bool] = if has_children() { Some(exp()) } else { Option::None }
      let check_said = tree_check_to_said(chk())
      Some(view::said(view::Role::Option, label=label(), description="level \{level}", selected=on(), expanded?=expanded, check?=check_said),)
    }))
    .on_press(fn() {
      if off() {
        return
      }
      self.selection.set_anchor(Some(v.id()))
      if self.multiple || !on() {
        (self.pick)(key)
      }
    })
    |> ignore
    // Register ancestor-first focus recovery before `rove.add` so parent collapse returns focus to the parent node
    // rather than jumping to the next sibling.
    self.recovery.track_with(v, ancestor_fallback, false)
    v.owns(fn() {
      let mut pos : Option[Int] = Option::None
      for let mut i = 0; i < self.entries.length(); i = i + 1 {
        if self.entries[i].node.id() == v.id() {
          pos = Some(i)
          break
        }
      }
      removed_pos.v = pos
      mbt_compat::arr_retain(self.entries, fn(e) { e.node.id() != v.id() })
      if self.entries.is_empty() {
        self.entries = []
      }
    })
    |> ignore
    self.rove.add(v, disabled=off, preferred=on)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(loc=loc, made_for=made_for.unwrap_or(loc), setup)
  }
}
