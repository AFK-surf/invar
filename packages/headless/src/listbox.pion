// The list box: a list of options to choose one (or multiple) of, with typeahead and range selection.

import "signals"
import "view"

struct ListboxEntry[K] {
  node : view::View
  key : K
  text : () -> String
  off : () -> Bool
}

/// A list box handed to its look to make its options by (`Listbox::option`).
pub struct Listbox[K] {
  is_selected : (K) -> Bool
  pick : (K) -> Unit
  on_select_many : Option[((Array[K]) -> Unit)]
  shift_held : () -> Bool
  multiple : Bool
  off : () -> Bool
  options : RovingFocus
  entries : Array[ListboxEntry[K]]
  anchor_id : view::Ref[Option[view::NodeId]]
  ta : Typeahead
}

pub fn Listbox::disabled[K](self : Listbox[K]) -> Bool {
  (self.off)()
}

pub fn Listbox::multiple[K](self : Listbox[K]) -> Bool {
  self.multiple
}

pub fn Listbox::focus_stop[K](self : Listbox[K], visible~ : Bool = true) -> Bool {
  self.options.focus_stop(visible=visible)
}

fn Listbox::live_entries[K](self : Listbox[K]) -> Array[ListboxEntry[K]] {
  view::array_filter(self.entries, fn(e : ListboxEntry[K]) -> Bool {
    e.node.alive() && !e.node.leaving() && e.node.takes_input() && !(e.off)()
  })
}

fn Listbox::emit_many[K](self : Listbox[K], keys : Array[K]) -> Unit {
  match self.on_select_many {
    Some(f) => f(keys)
    None => {
      for k in keys {
        if !(self.is_selected)(k) {
          (self.pick)(k)
        }
      }
    }
  }
}

fn Listbox::select_range_to_id[K](self : Listbox[K], target_id : view::NodeId) -> Bool {
  if !self.multiple {
    return false
  }
  let live = self.live_entries()
  let target_idx = match view::array_search_by(live, fn(e : ListboxEntry[K]) -> Bool { e.node.id() == target_id }) {
    Some(i) => i
    None => return false
  }
  let anchor_idx = match self.anchor_id.v {
    Some(aid) =>
      match view::array_search_by(live, fn(e : ListboxEntry[K]) -> Bool { e.node.id() == aid }) {
        Some(ai) => ai
        None => {
          self.anchor_id.v = Some(target_id)
          target_idx
        }
      }
    None => {
      self.anchor_id.v = Some(target_id)
      target_idx
    }
  }
  let lo = if anchor_idx <= target_idx { anchor_idx } else { target_idx }
  let hi = if anchor_idx >= target_idx { anchor_idx } else { target_idx }
  let keys : Array[K] = []
  let mut i = lo
  while i <= hi {
    keys.push(live[i].key)
    i += 1
  }
  self.emit_many(keys)
  true
}

/// Programmatically select the range from the current anchor to `target_node` in multi-select mode.
pub fn Listbox::select_range_to[K](self : Listbox[K], target_node : view::View) -> Bool {
  self.select_range_to_id(target_node.id())
}

/// Programmatically select all live enabled options in multi-select mode.
pub fn Listbox::select_all[K](self : Listbox[K]) -> Bool {
  if !self.multiple || (self.off)() {
    return false
  }
  let live = self.live_entries()
  if live.length() == 0 {
    return false
  }
  let keys : Array[K] = view::array_map(live, fn(e : ListboxEntry[K]) -> K { e.key })
  self.emit_many(keys)
  true
}

/// An option of a list box as its look reads it.
pub struct ListOption {
  node : view::View
  on : () -> Bool
  off : () -> Bool
}

pub fn ListOption::selected(self : ListOption) -> Bool {
  (self.on)()
}

pub fn ListOption::disabled(self : ListOption) -> Bool {
  (self.off)()
}

pub fn ListOption::focused(self : ListOption) -> Bool {
  self.node.focused()
}

pub fn ListOption::focus_shown(self : ListOption) -> Bool {
  self.node.focus_shown()
}

pub fn ListOption::hovered(self : ListOption) -> Bool {
  self.node.pointed()
}

pub fn ListOption::pressed(self : ListOption) -> Bool {
  self.node.pressed()
}

let listbox_key_char : Int = 1000
let listbox_key_space : Int = 1032
let listbox_key_enter : Int = 7
let listbox_key_select_all : Int = 12
let shift_mod : Int = 1
let ctrl_mod : Int = 2
let cmd_mod : Int = 8

/// A list box in `parent`, called `label`.
pub fn listbox[K](
  parent : view::View,
  label : () -> String,
  is_selected : (K) -> Bool,
  pick : (K) -> Unit,
  look : (view::View, Listbox[K]) -> Unit,
  multiple~ : Bool = false,
  wraps~ : Bool = false,
  typeahead_ms~ : Double = 500.0,
  disabled~ : () -> Bool = fn() { false },
  on_select_many? : (Array[K]) -> Unit,
  shift_held~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let lb : Listbox[K] = Listbox::{
    is_selected,
    pick,
    on_select_many,
    shift_held,
    multiple,
    off: disabled,
    options: RovingFocus::new(axis=GroupAxis::Vertical, roving=true, wraps=wraps),
    entries: [],
    anchor_id: view::ref_new(None),
    ta: Typeahead::new(window_ms=typeahead_ms),
  }
  parent.box(fn(v : view::View) {
    look(v, lb)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Listbox, label=label())) }))
      .on_key(fn(k : view::Key) -> Bool {
        if disabled() || !focus_in(v, false) {
          return false
        }
        // Ctrl/Cmd+A or SelectAll key selects all live options in multi-select mode.
        let is_select_all = k.code == listbox_key_select_all ||
          ((k.code == listbox_key_char + 97 || k.code == listbox_key_char + 65) &&
            (k.mods == ctrl_mod || k.mods == cmd_mod))
        if multiple && is_select_all {
          return lb.select_all()
        }
        // Shift+Arrow / Shift+Home / Shift+End extends contiguous selection in multi-select mode.
        if multiple &&
          k.mods == shift_mod &&
          (k.code == group_key_up || k.code == group_key_down || k.code == group_key_home || k.code == group_key_end) {
          if lb.anchor_id.v is None {
            match view::array_find_first(lb.live_entries(), fn(e : ListboxEntry[K]) -> Bool { e.node.focused() }) {
              Some(cur) => lb.anchor_id.v = Some(cur.node.id())
              None => ()
            }
          }
          match lb.options.step(k.code) {
            Some(next_node) => {
              let _ = lb.select_range_to_id(next_node.id())
              return true
            }
            None => return false
          }
        }
        // Shift+Space / Shift+Enter selects range from anchor to focused option.
        if multiple && k.mods == shift_mod && (k.code == listbox_key_space || k.code == listbox_key_enter) {
          match view::array_find_first(lb.live_entries(), fn(e : ListboxEntry[K]) -> Bool { e.node.focused() }) {
            Some(cur) => return lb.select_range_to_id(cur.node.id())
            None => return false
          }
        }
        if k.mods == 0 && lb.options.step(k.code) is Some(_) {
          return true
        }
        let live = lb.options.live()
        let nodes : Array[view::View] = view::array_map(live, fn(e : RovingEntry) -> view::View { e.node })
        lb.ta.handle_key(k, nodes, fn(i : Int) -> String {
          let id = live[i].node.id()
          match view::array_find_first(lb.entries, fn(x : ListboxEntry[K]) -> Bool { x.node.id() == id }) {
            Some(x) => (x.text)()
            None => ""
          }
        })
      })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}

/// An option of `key` in `parent`.
pub fn Listbox::option[K](
  self : Listbox[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View, ListOption) -> Unit,
  text? : () -> String,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { (self.off)() || disabled() }
    let able = fn() -> Bool { !off() }
    let on = fn() -> Bool { (self.is_selected)(key) }
    let text_fn : () -> String = match text {
      Some(t) => t
      None => label
    }
    self.entries.push(ListboxEntry::{ node: v, key, text: text_fn, off })
    let _ = v.owns(fn() {
      view::array_retain(self.entries, fn(e : ListboxEntry[K]) -> Bool { e.node.id() != v.id() })
      match self.anchor_id.v {
        Some(aid) => if aid == v.id() { self.anchor_id.v = None }
        None => ()
      }
    })
    look(v, ListOption::{ node: v, on, off })
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::Option, label=label(), selected=on()))
      }))
      .on_press(fn() {
        if !off() {
          if self.multiple && (self.shift_held)() {
            let _ = self.select_range_to_id(v.id())
          } else if self.multiple || !on() {
            self.anchor_id.v = Some(v.id())
            (self.pick)(key)
          }
        }
      })
    self.options.add(v, off=off, first=on)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
