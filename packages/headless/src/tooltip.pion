///|
/// A group of triggers whose tips show one at a time, warm for a while after one closed: made once by its caller and
/// handed to each trigger (`TooltipGroup::trigger`).
pub struct TooltipGroup[K] {
  priv shown : () -> Option[K]
  priv show : (Option[K]) -> Unit
  priv open_delay_ms : Double
  priv warmup_ms : Double
  priv closed_at : mbt_compat::Ref[Option[Double]]
  priv last : mbt_compat::Ref[Option[view::NodeId]]
  priv glided : mbt_compat::Ref[Option[(view::NodeId, Double)]]
  // INVAR-EXT: generation counter for TooltipGroup::dismiss
  priv gen : mbt_compat::Ref[Int]
}

///|
/// A group whose tip shown now is the one `shown` says (the caller's to keep: what its looks read), `show` told the one
/// to show (none: none); a tip opening `open_delay_ms` after the pointer came to rest on its trigger, at once within
/// `warmup_ms` of one closing.
pub fn TooltipGroup::new[K](shown : () -> Option[K], show : (Option[K]) -> Unit, open_delay_ms? : Double, warmup_ms? : Double) -> TooltipGroup[K] {
  let open_delay_ms = match open_delay_ms { Some(__mbt_v) => __mbt_v, None => 400.0 }
  let warmup_ms = match warmup_ms { Some(__mbt_v) => __mbt_v, None => 300.0 }

  TooltipGroup::{ shown: shown, show: show, open_delay_ms: open_delay_ms, warmup_ms: warmup_ms, closed_at: mbt_compat::ref_new(Option::None), last: mbt_compat::ref_new(Option::None), glided: mbt_compat::ref_new(Option::None), gen: mbt_compat::ref_new(0) }
}

// INVAR-EXT: dismiss any shown or pending tooltip and reset warmup/glide state.
pub fn TooltipGroup::dismiss[K](self : TooltipGroup[K]) -> Unit {
  self.gen.v = self.gen.v + 1
  self.closed_at.v = Option::None
  self.last.v = Option::None
  self.glided.v = Option::None
  if (self.shown)() is Some(_) {
    (self.show)(Option::None)
  }
}

///|
/// The tip shown now (as its caller says). Followed where a binding reads it.
pub fn TooltipGroup::shown[K](self : TooltipGroup[K]) -> Option[K] {
  (self.shown)()
}

///|
/// Whether the tip of `key` shows now. Followed where a binding reads it.
pub fn TooltipGroup::is_open[K : Eq](self : TooltipGroup[K], key : K) -> Bool {
  (self.shown)() == Some(key)
}

///|
/// Where the tip shown now came from: the trigger whose tip showed before it and the moment it opened, where it opened
/// at once as the group was warm (the pointer or the focus gone on to it from that one's, or come to it within
/// `warmup_ms` of that one's closing) and that trigger is another; none where it opened cold, came back to the same
/// trigger, or none shows. A look reads it with `shown` as the tip opens: a bubble glided from beside that trigger to
/// beside this one (its node found by its id), from that moment. Followed as `shown` is, where a binding reads both.
pub fn TooltipGroup::glided_from[K](self : TooltipGroup[K]) -> Option[(view::NodeId, Double)] {
  match (self.shown)() {
    Some(_) => self.glided.v
    Option::None => Option::None
  }
}

///|
/// The tip of `key` (its trigger `node`) shown, opened at `now`: warm (`warm`, as the group was before it) from another
/// trigger's, it came from that one (`glided_from`); else from nowhere.
fn TooltipGroup::open[K](self : TooltipGroup[K], node : view::View, key : K, now : Double, warm : Bool) -> Unit {
  let id = node.id()
  { let __mbt_r = self.glided; __mbt_r.v = (match self.last.v {
    Some(from) if warm && from != id => Some((from, now))
    _ => Option::None
  }) }
  self.last.v = Some(id)
  (self.show)(Some(key))
}

///|
/// Whether a tip opening at `now` opens at once: another shows (the pointer gone on from it to here), or one closed no
/// more than `warmup_ms` before.
fn TooltipGroup::warm[K](self : TooltipGroup[K], now : Double) -> Bool {
  if (self.shown)() is Some(_) {
    return true
  }
  match self.closed_at.v {
    Some(at) => now - at <= self.warmup_ms
    Option::None => false
  }
}

///|
/// The tip of `key` closed at `now`, where it is the one shown (another's is left as it is), the group warm from then.
fn TooltipGroup::close[K : Eq](self : TooltipGroup[K], key : K, now : Double) -> Unit {
  if (self.shown)() == Some(key) {
    self.closed_at.v = Some(now)
    (self.show)(Option::None)
  }
}

///|
/// `node` made a trigger of the group, its tip `key`'s; `disabled` while it opens none (one showing closed as that
/// comes); `within`: read `node.pointed_in()` instead of `node.pointed()`; `repeats`: only open when
/// `node.words_cut_now()` is true; `says`: the words its tip says, which repeat what it shows wherever `node` shows
/// them itself (View::shows_words_now), opened then only as `repeats` is; `touch_hold`: long-press opens the tip and keeps it for `tooltip_lifted_ms` after
/// release (or until the next press anywhere). Nothing is said of the node that is drawn, laid out or read out (its
/// look and its component say those): the group follows its pointer, its press, its focus, and `takes_input()`
/// (View::reacts), and does `tooltip_close` for it (View::on_action); all of it let go with the node, its tip closed
/// then.
// INVAR-EXT: per-trigger `open_delay_ms?` and custom `hovered?` predicate for kit tip_node.
pub fn TooltipGroup::trigger[K : Eq](self : TooltipGroup[K], node : view::View, key : K, disabled? : () -> Bool, within? : Bool, repeats? : Bool, says? : () -> String, touch_hold? : Bool, open_delay_ms? : Double, hovered? : () -> Bool) -> Unit {
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let within = match within { Some(__mbt_v) => __mbt_v, None => false }
  let repeats = match repeats { Some(__mbt_v) => __mbt_v, None => false }
  let says = match says { Some(__mbt_v) => __mbt_v, None => fn() { "" } }
  let touch_hold = match touch_hold { Some(__mbt_v) => __mbt_v, None => false }
  let delay = match open_delay_ms { Some(__mbt_v) => __mbt_v, None => self.open_delay_ms }
  if within {
    node.points(view::Live::Is(true)) |> ignore
  }

  // (what is waited for: the tip's opening, called off by whatever closes it)
  let waiting : mbt_compat::Ref[() -> Unit] = mbt_compat::ref_new(fn() { })
  let call_off = fn() {
    (waiting.v)()
    waiting.v = fn() { }
  }
  let touch_held = mbt_compat::ref_new(false)
  let touch_lifted = signals::signal(false)
  let lifted_cancel : mbt_compat::Ref[() -> Unit] = mbt_compat::ref_new(fn() { })
  let stop_lifted = fn() {
    (lifted_cancel.v)()
    lifted_cancel.v = fn() { }
    touch_lifted.set(false)
  }
  let close = fn() {
    call_off()
    touch_held.v = false
    stop_lifted()
    self.close(key, node.cause_at())
  }
  let may_open = fn() {
    !disabled() &&
    signals::untracked(fn() { node.takes_input() }) &&
    (!(repeats || node.shows_words_now(says())) || node.words_cut_now())
  }
  let open_now = fn() {
    call_off()
    if may_open() {
      let now = node.cause_at()
      self.open(node, key, now, self.warm(now))
    }
  }
  let hover_sig = match hovered {
    Some(h) => h
    None => fn() { if within { node.pointed_in() } else { node.pointed() } }
  }
  node.reacts(hover_sig, at_start=false, fn(over) {
    if !over {
      if !touch_held.v && !touch_lifted.untracked() {
        close()
      }
    } else if !disabled() && signals::untracked(fn() { node.takes_input() }) {
      let now = node.cause_at()
      if self.warm(now) {
        open_now()
      } else {
        call_off()
        let g = self.gen.v
        waiting.v = node.at_moment(now + delay, fn() {
          waiting.v = fn() { }
          if self.gen.v == g && may_open() {
            self.open(node, key, now + delay, false)
          }
        })
      }
    }
  })
  node.reacts(fn() { node.pressed() }, at_start=false, fn(down) { if down { close() } })
  node.reacts(fn() { node.focus_shown() }, at_start=false, fn(on) {
    if on {
      open_now()
    } else {
      close()
    }
  })
  node.reacts(fn() { node.takes_input() }, at_start=false, fn(takes) { if !takes { close() } })
  node.reacts(disabled, at_start=false, fn(off) { if off { close() } })
  if touch_hold {
    node
    .gesture(8.0, hold=(500.0, fn(_) {
      if may_open() {
        stop_lifted()
        touch_held.v = true
        open_now()
      }
    }), drag=fn(d) {
      if touch_held.v && (d.kind == .Up || d.kind == .Off) {
        touch_held.v = false
        if d.kind == .Up {
          touch_lifted.set(true)
          lifted_cancel.v = node.at_moment(node.cause_at() + tooltip_lifted_ms, fn() {
            lifted_cancel.v = fn() { }
            touch_lifted.set(false)
            self.close(key, node.cause_at())
          })
        } else {
          close()
        }
      }
    })
    |> ignore
    window_downs_while(node, fn() { touch_lifted.get() }, fn(_, _) { close() })
  }
  node
  .on_action(tooltip_close, fn(_ : view::ActionAt) {
    close()
    true
  }, can=fn() { self.is_open(key) })
  .owns(fn() {
    call_off()
    stop_lifted()
    self.close(key, node.cause_at())
    // (a trigger let go is where no tip comes from)
    if self.last.v == Some(node.id()) {
      self.last.v = Option::None
    }
  })
  |> ignore
}

///|
/// A tip's node in `parent`, read out a `Tooltip` called `label`, taking no press (the pointer passes through it to
/// what is under it). `look` is given its node once as it is made: all that is drawn of it and where it goes (beside
/// its trigger by `anchor_place`). Its caller makes it while the group says its key is shown (View::show). Its node.

pub fn tooltip_bubble(parent : view::View, label : () -> String, look : (view::View) -> Unit, made_for? : String, loc~ : String = "") -> view::View {
  parent.box(loc=loc, made_for=made_for.unwrap_or(loc), fn(v) {
    look(v)
    v.presses(.Is(false)).says(.By(fn() { Some(view::said(.Tooltip, label=label())) })) |> ignore
  })
}

///|
/// How long a mouse rests on a tooltip's trigger before it shows (ms), and how soon after another tooltip closed one
/// shows at once: the legacy controls' (`kit`'s `tooltip`) defaults, which invar's tips go by.
// moved to 00_init_order.pion: tooltip_delay_ms

///|
// moved to 00_init_order.pion: tooltip_skip_ms

///|
/// How long a tooltip a finger held open stays once it is lifted (Android's: 1500 ms).
// moved to 00_init_order.pion: tooltip_lifted_ms

///|
/// A tooltip in a legacy view (`kit`'s, by what builds it) or at a node of the window's tree. Both share the window's
/// one visible slot: the last tooltip to show keeps it, also while leaving.

#derive(Eq)
pub enum TipOwner {
  Built(Int)
  Node(Int)
}

///|
/// The window's tooltip slot, made anew when a Tester starts (tip_slot_reset).
struct TipSlot {
  owner : signals::Signal[Option[TipOwner]]
  mut next : Int
}

///|
fn TipSlot::new() -> TipSlot {
  TipSlot::{ owner: signals::signal(Option::None, same=fn(a, b) { a == b }), next: 0 }
}

///|
// moved to 00_init_order.pion: tip_slot

///|
/// The window's tooltip slot forgotten: its owner none, its identities from the start. Told by what a Tester's new run
/// resets (`@ui.on_reset`, from the packages over ui that use the slot: legacy kit's and the look libraries' tips), as
/// headless knows no ui.
pub fn tip_slot_reset() -> Unit {
  tip_slot.v = TipSlot::new()
}

///|
/// A fresh identity for a tooltip made with a node. Two tips may name the same anchor.
pub fn tip_node_owner() -> TipOwner {
  tip_slot.v.next = tip_slot.v.next + 1
  TipOwner::Node(tip_slot.v.next)
}

///|
/// Give the window's tooltip slot to `owner` as it is newly shown. The views and nodes that read it follow the signal.
pub fn tip_claim(owner : TipOwner) -> Unit {
  if tip_slot.v.owner.untracked() != Some(owner) {
    tip_slot.v.owner.set(Some(owner))
  }
}

///|
/// Whether `owner` holds the window's tooltip slot (followed by a node drawing its tooltip).
pub fn tip_owns(owner : TipOwner) -> Bool {
  tip_slot.v.owner.get() == Some(owner)
}
