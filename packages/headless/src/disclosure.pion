// The disclosure: a button that opens or closes something.
// Ported 1:1 from libs/mbui/src/headless/disclosure.mbt.

import "view"

/// A disclosure as its look reads it.
pub struct Disclosure {
  node : view::View
  now : () -> Bool
  off : () -> Bool
}

pub fn Disclosure::open(self : Disclosure) -> Bool {
  (self.now)()
}

pub fn Disclosure::disabled(self : Disclosure) -> Bool {
  (self.off)()
}

pub fn Disclosure::pressed(self : Disclosure) -> Bool {
  self.node.pressed()
}

pub fn Disclosure::hovered(self : Disclosure) -> Bool {
  self.node.pointed()
}

pub fn Disclosure::focus_shown(self : Disclosure) -> Bool {
  self.node.focus_shown()
}

pub fn Disclosure::press(self : Disclosure) -> Unit {
  let _ = self.node.press()
}

/// A disclosure in `parent`, called `label`, expanded while `open` says so.
pub fn disclosure(
  parent : view::View,
  label : () -> String,
  open : () -> Bool,
  press : (view::View) -> Unit,
  look : (view::View, Disclosure) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    look(v, Disclosure::{ node: v, now: open, off: disabled })
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space)
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::Button, label=label(), expanded=open()))
      }))
      .on_press(fn() {
        if !disabled() {
          press(v)
        }
      })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
