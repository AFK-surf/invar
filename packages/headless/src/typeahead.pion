// Typeahead prefix search behavior shared by menu, listbox, and custom composite controls.

import "view"

/// Incremental prefix-search state for keyboard typeahead navigation.
pub struct Typeahead {
  window_ms : Double
  typed : view::Ref[(String, Double)]
}

/// Create a `Typeahead` buffer whose typed prefix resets after `window_ms` milliseconds.
pub fn Typeahead::new(window_ms~ : Double = 500.0) -> Typeahead {
  Typeahead::{ window_ms, typed: view::ref_new(("", 0.0)) }
}

/// Clear any accumulated typeahead prefix.
pub fn Typeahead::reset(self : Typeahead) -> Unit {
  self.typed.v = ("", 0.0)
}

/// Feed character `c` at timestamp `at` and find the next matching index among `0..<count`.
/// Repeating the same letter cycles forward from `current`; multi-character prefixes match from `current`.
pub fn Typeahead::match_next(
  self : Typeahead,
  c : Char,
  at : Double,
  count : Int,
  current : Option[Int],
  text_of : (Int) -> String,
) -> Option[Int] {
  let small = ascii_lower(c.to_string())
  let (was, last) = self.typed.v
  let now = if was != "" && at - last <= self.window_ms { was + small } else { small }
  self.typed.v = (now, at)
  if count <= 0 {
    return None
  }
  let first_code = if small.length() > 0 { small.code_unit_at(0) } else { 32 }
  let (find, from_next) = if str_all_code(now, first_code) { (small, true) } else { (now, false) }
  let start = match current {
    Some(i) => if from_next { i + 1 } else { i }
    None => 0
  }
  let mut d = 0
  while d < count {
    let i = (start + d) % count
    if str_has_prefix(ascii_lower(text_of(i)), find) {
      return Some(i)
    }
    d += 1
  }
  None
}

/// Handle a printable character key event against `nodes`, focusing the matched node if found.
pub fn Typeahead::handle_key(
  self : Typeahead,
  k : view::Key,
  nodes : Array[view::View],
  text_of : (Int) -> String,
) -> Bool {
  if !(k.code > listbox_key_char && k.code != listbox_key_space && (k.mods == 0 || k.mods == shift_mod)) {
    return false
  }
  let c = (k.code - listbox_key_char).unsafe_to_char()
  let cur = view::array_search_by(nodes, fn(v : view::View) -> Bool { v.focused() })
  match self.match_next(c, k.at, nodes.length(), cur, text_of) {
    Some(i) => {
      let _ = nodes[i].ask_focus(visible=true)
      true
    }
    None => false
  }
}
