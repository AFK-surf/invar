// Wave 0B comprehensive headless contract tests covering all 10 new/extended modules + Button Said.busy.

import "dmath"
import "headless_core"
import "signals"
import "view"

fn w0b_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

fn w0b_opt_str_is(o : Option[String], want : String) -> Bool {
  match o {
    Some(s) => s == want
    None => false
  }
}

fn w0b_opt_double_is(o : Option[Double], want : Double) -> Bool {
  match o {
    Some(v) => dmath::abs(v - want) < 0.0001
    None => false
  }
}

fn w0b_opt_int_is(o : Option[Int], want : Int) -> Bool {
  match o {
    Some(v) => v == want
    None => false
  }
}

fn w0b_make_tree(make : (view::View) -> Unit) -> view::Tree {
  view::Tree::new(
    make,
    measure=view::words_measure,
    measure_runs=view::runs_measure,
    measure_runs_least=view::runs_least_measure,
  )
}

fn w0b_said_of(tree : view::Tree, id : view::NodeId) -> Option[view::Said] {
  for sn in tree.said_order() {
    if sn.id == id {
      return sn.said
    }
  }
  None
}

test "w0b-01 Button pending wires Said.busy reactively" {
  let busy = signals::signal(false)
  let btn_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tree = w0b_make_tree(fn(root : view::View) {
    let b = button(
      root,
      fn() -> String { "Save" },
      fn(_v : view::View) { () },
      fn(v : view::View, _h : Button) {
        let _ = v.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(32.0)))
      },
      pending=fn() -> Bool { busy.get() },
    )
    btn_ref.v = Some(b)
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  let b = match btn_ref.v { Some(v) => v; None => panic("missing button") }
  match w0b_said_of(tree, b.id()) {
    Some(s) => w0b_assert(!s.busy, "initially Said.busy == false")
    None => panic("missing button said")
  }
  busy.set(true)
  let _ = tree.frame(200.0, 100.0, now=16.0)
  match w0b_said_of(tree, b.id()) {
    Some(s) => w0b_assert(s.busy, "pending sets Said.busy == true")
    None => panic("missing button said")
  }
  tree.dispose()
}

test "w0b-02 Tooltip cancellable close_delay_ms: 499ms open, 500ms closed, re-enter cancel, group switch, unmount" {
  let shown : signals::Signal[Option[String]] = signals::signal_by(None, fn(a : Option[String], b : Option[String]) -> Bool {
    match (a, b) {
      (None, None) => true
      (Some(x), Some(y)) => x == y
      _ => false
    }
  })
  let show_t1 = signals::signal(true)
  let group = TooltipGroup::new(
    fn() -> Option[String] { shown.get() },
    fn(k : Option[String]) { shown.set(k) },
    open_delay_ms=100.0,
    close_delay_ms=500.0,
    warmup_ms=300.0,
  )
  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = root.show(
      fn() -> Bool { show_t1.get() },
      fn(h : view::View) {
        let t1 = h.box(fn(v : view::View) {
          let _ = v.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(30.0))).presses(view::Live::Is(true))
        })
        group.trigger(t1, "tip1")
      },
      at_once=true,
    )
    let t2 = root.box(fn(v : view::View) {
      let _ = v.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(30.0))).presses(view::Live::Is(true))
    })
    group.trigger(t2, "tip2")
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)

  // Hover t1 at (20, 15) -> opens after 100ms
  tree.point_at(20.0, 15.0)
  let _ = tree.frame(300.0, 200.0, now=50.0)
  w0b_assert(!group.is_open("tip1"), "not open at 50ms")
  let _ = tree.frame(300.0, 200.0, now=100.0)
  w0b_assert(group.is_open("tip1"), "open at 100ms")

  // Leave t1 at t=200ms -> still open at 699ms (499ms elapsed), closes at 700ms (500ms elapsed)
  let _ = tree.frame(300.0, 200.0, now=200.0)
  tree.point_at(250.0, 150.0)
  let _ = tree.frame(300.0, 200.0, now=699.0)
  w0b_assert(group.is_open("tip1"), "still open at 499ms close delay")
  let _ = tree.frame(300.0, 200.0, now=700.0)
  w0b_assert(!group.is_open("tip1"), "closed at 500ms close delay")

  // Re-open (warm within 300ms at t=750ms) -> leave at t=800ms -> re-enter at t=1100ms cancels close!
  let _ = tree.frame(300.0, 200.0, now=750.0)
  tree.point_at(20.0, 15.0)
  let _ = tree.frame(300.0, 200.0, now=750.0)
  w0b_assert(group.is_open("tip1"), "warm open immediately")
  let _ = tree.frame(300.0, 200.0, now=800.0)
  tree.point_at(250.0, 150.0)
  let _ = tree.frame(300.0, 200.0, now=1000.0)
  w0b_assert(group.is_open("tip1"), "pending close at +200ms")
  let _ = tree.frame(300.0, 200.0, now=1100.0)
  tree.point_at(20.0, 15.0)
  let _ = tree.frame(300.0, 200.0, now=1400.0)
  w0b_assert(group.is_open("tip1"), "re-entering cancelled close timer past 800+500ms")

  // Group switch to t2 at (20, 45) -> immediately switches to tip2
  let _ = tree.frame(300.0, 200.0, now=1450.0)
  tree.point_at(20.0, 45.0)
  let _ = tree.frame(300.0, 200.0, now=1450.0)
  w0b_assert(group.is_open("tip2"), "group switch opens tip2 immediately")

  // Switch back to tip1 then unmount t1 -> cleans up and closes tip1
  let _ = tree.frame(300.0, 200.0, now=1500.0)
  tree.point_at(20.0, 15.0)
  let _ = tree.frame(300.0, 200.0, now=1500.0)
  w0b_assert(group.is_open("tip1"), "back on tip1")
  show_t1.set(false)
  let _ = tree.frame(300.0, 200.0, now=1520.0)
  w0b_assert(!group.is_open("tip1"), "unmounting t1 closes tip1 immediately")
  tree.dispose()
}

test "w0b-03 Link Role::Link, click and Enter activation, Space ignored, disabled guard" {
  let clicks = view::ref_new(0)
  let off = signals::signal(false)
  let link_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tree = w0b_make_tree(fn(root : view::View) {
    let l = link(
      root,
      fn() -> String { "Docs" },
      fn(_v : view::View) { clicks.v = clicks.v + 1 },
      fn(v : view::View, _h : Link) {
        let _ = v.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(24.0)))
      },
      href=fn() -> String { "https://example.com/docs" },
      disabled=fn() -> Bool { off.get() },
    )
    link_ref.v = Some(l)
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  let l = match link_ref.v { Some(v) => v; None => panic("missing link") }
  match w0b_said_of(tree, l.id()) {
    Some(s) => w0b_assert(s.role == view::Role::Link && s.label == "Docs", "Role::Link and label")
    None => panic("missing link said")
  }
  let _ = l.press()
  w0b_assert(clicks.v == 1, "mouse press activates link")
  let _ = l.ask_focus(visible=true)
  let _ = tree.frame(200.0, 100.0, now=16.0)
  let _ = tree.key_at(7, 0, 16.0) // Enter
  w0b_assert(clicks.v == 2, "Enter activates focused link")
  let _ = tree.key_at(1032, 0, 20.0) // Space
  w0b_assert(clicks.v == 2, "Space does NOT activate link")

  off.set(true)
  let _ = tree.frame(200.0, 100.0, now=32.0)
  let _ = l.press()
  w0b_assert(clicks.v == 2, "disabled blocks activation")
  tree.dispose()
}

test "w0b-04 Form & Fieldset registration, cross-field error routing to FieldError, and disabled inheritance" {
  let email = signals::signal("alice@example.com")
  let pwd = signals::signal("secret123")
  let confirm = signals::signal("mismatch")
  let form_off = signals::signal(false)
  let fs_off = signals::signal(false)
  let submitted = view::ref_new(0)
  let form_ref : signals::Ref[Option[Form]] = view::ref_new(None)
  let fs_ref : signals::Ref[Option[Fieldset]] = view::ref_new(None)
  let nested_disabled = view::ref_new(false)
  let err_node_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = form(
      root,
      fn() -> String { "Signup" },
      fn(_vals : Map[String, String]) { submitted.v = submitted.v + 1 },
      fn(fv : view::View, f : Form) {
        form_ref.v = Some(f)
        f.register_field("email", fn() -> String { email.get() })
        f.register_field("password", fn() -> String { pwd.get() })
        f.register_field("confirm", fn() -> String { confirm.get() })
        let en = f.field_error(fv, "confirm", fn(v : view::View, _e : () -> String) {
          let _ = v.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(20.0)))
        })
        err_node_ref.v = Some(en)
        let _ = fieldset(
          fv,
          fn() -> String { "Account" },
          fn(fsv : view::View, fs : Fieldset) {
            fs_ref.v = Some(fs)
            let _ = fsv.box(fn(child : view::View) {
              child.reacts(fn() -> Bool { form_disabled_inherited(child) }, fn(d : Bool) {
                nested_disabled.v = d
              })
            })
          },
          disabled=fn() -> Bool { fs_off.get() },
        )
      },
      validate_form=fn(vals : Map[String, String]) -> Map[String, String] {
        let errs : Map[String, String] = Map::new()
        let p = match vals.get("password") { Some(s) => s; None => "" }
        let c = match vals.get("confirm") { Some(s) => s; None => "" }
        if p != c {
          errs["confirm"] = "Passwords must match"
        }
        errs
      },
      disabled=fn() -> Bool { form_off.get() },
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let f = match form_ref.v { Some(x) => x; None => panic("missing form") }
  let fs = match fs_ref.v { Some(x) => x; None => panic("missing fieldset") }
  let en = match err_node_ref.v { Some(x) => x; None => panic("missing field error") }

  // Cross-field validation blocks submit and routes error to nested FieldError
  w0b_assert(!f.submit(), "submit rejected when passwords mismatch")
  w0b_assert(submitted.v == 0, "on_submit not called on error")
  w0b_assert(f.error_of("confirm") == "Passwords must match", "cross-field error routed to confirm")
  let _ = tree.frame(300.0, 200.0, now=16.0)
  match w0b_said_of(tree, en.id()) {
    Some(s) => w0b_assert(s.role == view::Role::Status && s.label == "Passwords must match", "FieldError exposes error status")
    None => panic("missing field error said")
  }

  // Fix mismatch -> submits cleanly
  confirm.set("secret123")
  w0b_assert(f.submit(), "submit succeeds once valid")
  w0b_assert(submitted.v == 1 && f.error_of("confirm") == "", "on_submit called and error cleared")

  // Group-level disabled inheritance
  w0b_assert(!fs.disabled() && !nested_disabled.v, "initially enabled")
  fs_off.set(true)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  w0b_assert(fs.disabled() && nested_disabled.v, "fieldset disabled inherited")
  fs_off.set(false)
  form_off.set(true)
  let _ = tree.frame(300.0, 200.0, now=48.0)
  w0b_assert(fs.disabled() && nested_disabled.v, "form disabled inherited by fieldset and child")
  tree.dispose()
}

test "w0b-05 Select/Autocomplete hard invariant: multi-select A,B -> filter C -> select C -> clear filter keeps A,B,C" {
  let all = ["A", "B", "C"]
  let sel_ref : signals::Ref[Option[Selector[String]]] = view::ref_new(None)
  let trig_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let lb_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = selector(
      root,
      fn() -> String { "Tags" },
      fn() -> Array[String] { all },
      fn() -> Array[String] {
        match sel_ref.v {
          Some(s) => {
            let q = ascii_lower(s.query())
            if q == "" { all } else { view::array_filter(all, fn(k : String) -> Bool { ascii_lower(k).contains(q) }) }
          }
          None => all
        }
      },
      fn(k : String) -> String { k },
      fn(v : view::View, s : Selector[String]) {
        sel_ref.v = Some(s)
        let tr = s.trigger(v, fn(tv : view::View, _s : Selector[String]) {
          let _ = tv.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(32.0)))
        })
        trig_ref.v = Some(tr)
        let _ = v.show(
          fn() -> Bool { s.is_open() },
          fn(host : view::View) {
            let lb = s.listbox(host, fn(lv : view::View) {
              let _ = lv.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(96.0)))
              for k in all {
                let _ = lv.show(
                  fn() -> Bool {
                    let q = ascii_lower(s.query())
                    q == "" || ascii_lower(k).contains(q)
                  },
                  fn(oh : view::View) {
                    let _ = s.option(oh, k, fn() -> String { k }, fn(ov : view::View, _a : () -> Bool, _sel : () -> Bool) {
                      let _ = ov.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(28.0)))
                    })
                  },
                  at_once=true,
                )
              }
            })
            lb_ref.v = Some(lb)
          },
          at_once=true,
        )
      },
      multiple=true,
      filterable=true,
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let s = match sel_ref.v { Some(x) => x; None => panic("missing selector") }
  let tr = match trig_ref.v { Some(x) => x; None => panic("missing trigger") }

  // Focus trigger & open
  let _ = tr.ask_focus(visible=true)
  s.set_open(true)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  w0b_assert(tr.focused(), "trigger keeps focus when opened")
  match w0b_said_of(tree, tr.id()) {
    Some(sd) => {
      w0b_assert(sd.controls.is_some(), "controls points to listbox")
      w0b_assert(sd.active_descendant.is_some(), "active_descendant points to active option")
    }
    None => panic("missing trigger said")
  }

  // Multi-select A and B
  s.choose("A")
  s.choose("B")
  w0b_assert(s.is_selected("A") && s.is_selected("B") && s.selected_keys().length() == 2, "A and B selected")

  // Filter so only C remains -> select C -> clear filter -> A, B, C ALL preserved!
  s.set_query("c")
  let _ = tree.frame(300.0, 200.0, now=32.0)
  w0b_assert(w0b_opt_str_is(s.active_key(), "C"), "active_key reconciled to C")
  s.choose("C")
  s.set_query("")
  let _ = tree.frame(300.0, 200.0, now=48.0)
  w0b_assert(s.is_selected("A") && s.is_selected("B") && s.is_selected("C") && s.selected_keys().length() == 3, "A, B, C all preserved after clearing filter")

  // Close then clear -> must NOT reopen popup!
  s.set_open(false)
  let _ = tree.frame(300.0, 200.0, now=64.0)
  s.clear()
  w0b_assert(!s.is_open() && s.selected_keys().length() == 0, "clear never opens closed popup")
  tree.dispose()
}

fn w0b_str_arr_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

test "w0b-06 DataGrid 2D focus, sort aria-sort, and stable row_key selection & focus after sort" {
  let row_order = signals::signal_by(["r1", "r2", "r3"], w0b_str_arr_eq)
  let cols = ["name", "score"]
  let dg_ref : signals::Ref[Option[DataGrid]] = view::ref_new(None)
  let hdr_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let loaded = view::ref_new(0)

  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = data_grid(
      root,
      fn() -> String { "Scores" },
      fn() -> Array[String] { row_order.get() },
      fn() -> Array[String] { cols },
      fn(v : view::View, dg : DataGrid) {
        dg_ref.v = Some(dg)
        let h = dg.column_header(v, "score", fn() -> String { "Score" }, fn(hv : view::View, _s : () -> headless_core::SortDir) {
          let _ = hv.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(28.0)))
        })
        hdr_ref.v = Some(h)
      },
      has_more=true,
      on_load_more=fn() { loaded.v = loaded.v + 1 },
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let dg = match dg_ref.v { Some(x) => x; None => panic("missing grid") }
  let hdr = match hdr_ref.v { Some(x) => x; None => panic("missing header") }

  dg.state.set_focus("r2", "score")
  let _ = dg.select_row("r2")
  let _ = dg.toggle_sort("score")
  row_order.set(["r3", "r1", "r2"])
  dg.reconcile()
  let _ = tree.frame(300.0, 200.0, now=16.0)

  w0b_assert(dg.is_selected("r2") && !dg.is_selected("r1"), "selected row_key r2 preserved after sort")
  w0b_assert(w0b_opt_str_is(dg.focus_row(), "r2") && w0b_opt_str_is(dg.focus_col(), "score"), "focus stays on r2/score after sort")
  match w0b_said_of(tree, hdr.id()) {
    Some(s) => w0b_assert(w0b_opt_str_is(s.sort, "ascending"), "column header emits aria-sort ascending")
    None => panic("missing header said")
  }
  dg.load_more()
  w0b_assert(loaded.v == 1, "load_more callback invoked")
  tree.dispose()
}

test "w0b-07 ListBox & Menu Section headings and separators excluded from roving focus" {
  let lb_ref : signals::Ref[Option[Listbox[String]]] = view::ref_new(None)
  let opt1_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let opt2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let m_ref : signals::Ref[Option[Menu]] = view::ref_new(None)
  let m1_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let m2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = listbox(
      root,
      fn() -> String { "Items" },
      fn(_k : String) -> Bool { false },
      fn(_k : String) { () },
      fn(v : view::View, lb : Listbox[String]) {
        lb_ref.v = Some(lb)
        let _ = lb.section(
          v,
          fn() -> String { "Group A" },
          fn(sv : view::View) {
            opt1_ref.v = Some(lb.option(sv, "a1", fn() -> String { "A1" }, fn(ov : view::View, _o : ListOption) {
              let _ = ov.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(24.0)))
            }))
          },
          heading_look=fn(hv : view::View) { let _ = hv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(20.0))) },
        )
        let _ = lb.separator(v, fn(sv : view::View) { let _ = sv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(1.0))) })
        let _ = lb.section(
          v,
          fn() -> String { "Group B" },
          fn(sv : view::View) {
            opt2_ref.v = Some(lb.option(sv, "b1", fn() -> String { "B1" }, fn(ov : view::View, _o : ListOption) {
              let _ = ov.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(24.0)))
            }))
          },
          heading_look=fn(hv : view::View) { let _ = hv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(20.0))) },
        )
      },
    )
    let _ = menu(
      root,
      fn(v : view::View, m : Menu) {
        m_ref.v = Some(m)
        let _ = m.section(
          v,
          fn() -> String { "File" },
          fn(sv : view::View) {
            m1_ref.v = Some(m.item(sv, fn() -> String { "New" }, fn(_n : view::View) { () }, fn(iv : view::View, _mi : MenuItem) {
              let _ = iv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(24.0)))
            }))
          },
          heading_look=fn(hv : view::View) { let _ = hv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(20.0))) },
        )
        let _ = m.separator(v, fn(sv : view::View) { let _ = sv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(1.0))) })
        m2_ref.v = Some(m.item(v, fn() -> String { "Quit" }, fn(_n : view::View) { () }, fn(iv : view::View, _mi : MenuItem) {
          let _ = iv.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(24.0)))
        }))
      },
      roving=true,
    )
  })
  let _ = tree.frame(300.0, 300.0, now=0.0)
  let o1 = match opt1_ref.v { Some(v) => v; None => panic("missing o1") }
  let o2 = match opt2_ref.v { Some(v) => v; None => panic("missing o2") }
  let _ = o1.ask_focus(visible=true)
  let _ = tree.frame(300.0, 300.0, now=16.0)
  let _ = tree.key_at(6, 0, 16.0) // Down
  w0b_assert(o2.focused(), "Listbox Down skips section heading and separator to B1")

  let m1 = match m1_ref.v { Some(v) => v; None => panic("missing m1") }
  let m2 = match m2_ref.v { Some(v) => v; None => panic("missing m2") }
  let _ = m1.ask_focus(visible=true)
  let _ = tree.frame(300.0, 300.0, now=32.0)
  let _ = tree.key_at(6, 0, 32.0) // Down
  w0b_assert(m2.focused(), "Menu Down skips section heading and separator to Quit")
  tree.dispose()
}

test "w0b-08 NumberField injectable format/parse presets (grouped, percent, currency) and scrub_handle" {
  w0b_assert(number_format_grouped(1234567.5, 2) == "1,234,567.50", "grouped format")
  w0b_assert(w0b_opt_double_is(number_parse_grouped("1,234,567.50"), 1234567.5), "grouped parse")
  w0b_assert(number_format_percent(0.255, 1) == "25.5%", "percent format")
  w0b_assert(w0b_opt_double_is(number_parse_percent("25.5%"), 0.255), "percent parse")
  w0b_assert(number_format_currency(1234.5, "$", 2) == "$1,234.50", "currency format")
  w0b_assert(w0b_opt_double_is(number_parse_currency("$1,234.50", "$"), 1234.5), "currency parse")

  let amount = signals::signal(1000.0)
  let ni_ref : signals::Ref[Option[NumberInput]] = view::ref_new(None)
  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = number_input(
      root,
      fn() -> String { "Price" },
      fn() -> Double { amount.get() },
      fn(v : Double) { amount.set(v) },
      fn(v : view::View, ni : NumberInput) {
        ni_ref.v = Some(ni)
        let _ = ni.scrub_handle(v, fn(sv : view::View, _st : headless_core::ScrubStepper) {
          let _ = sv.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(24.0)))
        }, step_px=10.0, deadzone_px=4.0)
      },
      min=0.0,
      max=10000.0,
      step=50.0,
      precision=2,
      format=fn(x : Double) -> String { number_format_currency(x, "$", 2) },
      parse=fn(s : String) -> Option[Double] { number_parse_currency(s, "$") },
    )
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  let ni = match ni_ref.v { Some(x) => x; None => panic("missing ni") }
  w0b_assert(ni.formatted() == "$1,000.00", "currency formatter wired")
  w0b_assert(ni.commit_text("$2,500.50"), "currency parser wired")
  w0b_assert(amount.get() == 2500.5, "committed currency value")
  tree.dispose()
}

test "w0b-09 Pagination, Breadcrumbs, TagGroup focus-on-delete, and Meter" {
  // Pagination + current="page"
  let page = signals::signal(2)
  let p2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let bc_last_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tags = signals::signal_by(["t1", "t2", "t3"], w0b_str_arr_eq)
  let t2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let t3_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let meter_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let m_handle : signals::Ref[Option[Meter]] = view::ref_new(None)

  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = pagination(
      root,
      fn() -> Int { 10 },
      fn() -> Int { page.get() },
      fn(p : Int) { page.set(p) },
      fn(v : view::View, pg : Pagination) {
        p2_ref.v = Some(pg.page_button(v, 2, fn(bv : view::View, _a : () -> Bool) {
          let _ = bv.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
        }))
      },
    )
    let _ = breadcrumbs(
      root,
      fn() -> Int { 5 },
      fn(v : view::View, bc : Breadcrumbs) {
        w0b_assert(bc.slots().length() == 4, "5 items with max_items=3 collapses to 4 slots (1 + ellipsis + 2)")
        bc_last_ref.v = Some(bc.item(v, 4, fn() -> String { "Current" }, fn(_n : view::View) { () }, fn(iv : view::View, _cur : () -> Bool) {
          let _ = iv.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(24.0)))
        }))
      },
      max_items=3,
    )
    let _ = tag_group(
      root,
      fn() -> String { "Skills" },
      fn(v : view::View, tg : TagGroup[String]) {
        for k in ["t1", "t2", "t3"] {
          let _ = v.show(
            fn() -> Bool { str_array_contains(tags.get(), k) },
            fn(h : view::View) {
              let tv = tg.tag(h, k, fn() -> String { k }, fn(n : view::View, _s : () -> Bool, _o : () -> Bool) {
                let _ = n.width(view::Live::Is(Some(48.0))).height(view::Live::Is(Some(24.0)))
              })
              if k == "t2" { t2_ref.v = Some(tv) }
              if k == "t3" { t3_ref.v = Some(tv) }
            },
            at_once=true,
          )
        }
      },
      on_remove=fn(k : String) {
        tags.set(view::array_filter(tags.untracked(), fn(x : String) -> Bool { x != k }))
      },
      multiple=true,
    )
    meter_ref.v = Some(meter(
      root,
      fn() -> String { "Disk" },
      fn() -> Double { 75.0 },
      fn(v : view::View, mh : Meter) {
        m_handle.v = Some(mh)
        let _ = v.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(12.0)))
      },
      min=0.0,
      max=100.0,
    ))
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  let p2 = match p2_ref.v { Some(v) => v; None => panic("missing p2") }
  match w0b_said_of(tree, p2.id()) {
    Some(s) => w0b_assert(w0b_opt_str_is(s.current, "page"), "active pagination button has current=Some(page)")
    None => panic("missing p2 said")
  }
  let bc_last = match bc_last_ref.v { Some(v) => v; None => panic("missing bc_last") }
  match w0b_said_of(tree, bc_last.id()) {
    Some(s) => w0b_assert(w0b_opt_str_is(s.current, "page"), "last breadcrumb has current=Some(page)")
    None => panic("missing bc_last said")
  }
  // Delete t2 via Backspace -> focus MUST move to adjacent surviving tag t3!
  let t2 = match t2_ref.v { Some(v) => v; None => panic("missing t2") }
  let t3 = match t3_ref.v { Some(v) => v; None => panic("missing t3") }
  let _ = t2.ask_focus(visible=true)
  let _ = tree.frame(400.0, 300.0, now=16.0)
  let _ = tree.key_at(headless_core::key_backspace, 0, 16.0) // Backspace
  let _ = tree.frame(400.0, 300.0, now=32.0)
  w0b_assert(!str_array_contains(tags.get(), "t2"), "t2 removed")
  w0b_assert(t3.focused(), "focus landed on adjacent tag t3 after deleting t2")

  let mv = match meter_ref.v { Some(v) => v; None => panic("missing meter") }
  let mh = match m_handle.v { Some(x) => x; None => panic("missing meter handle") }
  w0b_assert(dmath::abs(mh.ratio() - 0.75) < 0.001 && mh.value_text() == "75%", "Meter ratio and value_text")
  match w0b_said_of(tree, mv.id()) {
    Some(s) => w0b_assert(s.role == view::Role::Meter && s.value == "75%", "Role::Meter semantics")
    None => panic("missing meter said")
  }
  tree.dispose()
}

test "w0b-10 ColorArea 2D arrows (Shift 10x), ColorSlider, ColorSwatchPicker 2D roving" {
  let color_sig : signals::Signal[headless_core::ColorModel] = signals::signal_by(
    headless_core::ColorModel::from_hsva(180.0, 0.5, 0.5),
    fn(a : headless_core::ColorModel, b : headless_core::ColorModel) -> Bool { a == b },
  )
  let area_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let slider_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let sw0_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let sw2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let picked_sw = view::ref_new("")

  let tree = w0b_make_tree(fn(root : view::View) {
    area_ref.v = Some(color_area(
      root,
      fn() -> String { "Sat/Val" },
      headless_core::ColorChannel::Saturation,
      headless_core::ColorChannel::Brightness,
      fn() -> headless_core::ColorModel { color_sig.get() },
      fn(m : headless_core::ColorModel) { color_sig.set(m) },
      fn(v : view::View, _ca : ColorArea) { let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0))) },
    ))
    slider_ref.v = Some(color_slider(
      root,
      fn() -> String { "Hue" },
      headless_core::ColorChannel::Hue,
      fn() -> headless_core::ColorModel { color_sig.get() },
      fn(m : headless_core::ColorModel) { color_sig.set(m) },
      fn(v : view::View, _cs : ColorSlider) { let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(20.0))) },
    ))
    let _ = color_swatch_picker(
      root,
      fn() -> String { "Swatches" },
      fn() -> Option[String] { None },
      fn(h : String) { picked_sw.v = h },
      fn(v : view::View, sp : ColorSwatchPicker) {
        sw0_ref.v = Some(sp.swatch(v, "#FF0000", fn() -> String { "Red" }, fn(n : view::View, _s : () -> Bool) { let _ = n.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(20.0))) }))
        let _ = sp.swatch(v, "#00FF00", fn() -> String { "Green" }, fn(n : view::View, _s : () -> Bool) { let _ = n.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(20.0))) })
        sw2_ref.v = Some(sp.swatch(v, "#0000FF", fn() -> String { "Blue" }, fn(n : view::View, _s : () -> Bool) { let _ = n.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(20.0))) }))
      },
      columns=2,
    )
  })
  let _ = tree.frame(300.0, 300.0, now=0.0)
  let area = match area_ref.v { Some(v) => v; None => panic("missing area") }
  let _ = area.ask_focus(visible=true)
  let _ = tree.frame(300.0, 300.0, now=16.0)
  // Shift+Right steps Saturation by +0.10 (10x 0.01)
  let _ = tree.key_at(4, 1, 16.0)
  w0b_assert(dmath::abs(color_sig.get().s - 0.6) < 0.001, "ColorArea Shift+Right stepped S by 10x")
  // Up steps Brightness by +0.01
  let _ = tree.key_at(5, 0, 20.0)
  w0b_assert(dmath::abs(color_sig.get().v - 0.51) < 0.001, "ColorArea Up stepped V by 1x")

  // ColorSlider Shift+Right steps Hue by +10
  let sl = match slider_ref.v { Some(v) => v; None => panic("missing slider") }
  let _ = sl.ask_focus(visible=true)
  let _ = tree.frame(300.0, 300.0, now=32.0)
  let _ = tree.key_at(4, 1, 32.0)
  w0b_assert(dmath::abs(color_sig.get().h - 190.0) < 0.01, "ColorSlider Shift+Right stepped Hue by 10")

  // ColorSwatchPicker Down in 2-col grid moves index 0 -> index 2
  let sw0 = match sw0_ref.v { Some(v) => v; None => panic("missing sw0") }
  let sw2 = match sw2_ref.v { Some(v) => v; None => panic("missing sw2") }
  let _ = sw0.ask_focus(visible=true)
  let _ = tree.frame(300.0, 300.0, now=48.0)
  let _ = tree.key_at(6, 0, 48.0) // Down
  w0b_assert(sw2.focused(), "ColorSwatchPicker Down moved 0 -> 2 in 2-column grid")
  tree.dispose()
}

test "w0b-11 Calendar, RangeCalendar, CalendarYearPicker, DateField & TimeField" {
  let picked_date : signals::Signal[Option[headless_core::IsoDate]] = signals::signal_by(None, fn(a : Option[headless_core::IsoDate], b : Option[headless_core::IsoDate]) -> Bool {
    match (a, b) {
      (None, None) => true
      (Some(x), Some(y)) => x == y
      _ => false
    }
  })
  let picked_range : signals::Signal[Option[(headless_core::IsoDate, headless_core::IsoDate)]] = signals::signal_by(None, fn(a : Option[(headless_core::IsoDate, headless_core::IsoDate)], b : Option[(headless_core::IsoDate, headless_core::IsoDate)]) -> Bool {
    match (a, b) {
      (None, None) => true
      (Some(x), Some(y)) => x.0 == y.0 && x.1 == y.1
      _ => false
    }
  })
  let picked_year = signals::signal(2026)
  let seg_val : signals::Signal[headless_core::SegmentedDateTime] = signals::signal_by(
    headless_core::SegmentedDateTime::empty(),
    fn(a : headless_core::SegmentedDateTime, b : headless_core::SegmentedDateTime) -> Bool { a.eq(b) },
  )
  let cal_ref : signals::Ref[Option[Calendar]] = view::ref_new(None)
  let rc_ref : signals::Ref[Option[RangeCalendar]] = view::ref_new(None)
  let rc_node_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let yp_ref : signals::Ref[Option[CalendarYearPicker]] = view::ref_new(None)
  let yr_seg_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let mo_seg_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let today = headless_core::IsoDate::new(2026, 11, 24)
  let blocked = headless_core::IsoDate::new(2026, 11, 25)
  let tree = w0b_make_tree(fn(root : view::View) {
    let _ = calendar(
      root,
      fn() -> String { "Date" },
      today,
      fn() -> Option[headless_core::IsoDate] { picked_date.get() },
      fn(d : headless_core::IsoDate) { picked_date.set(Some(d)) },
      fn(_v : view::View, c : Calendar) { cal_ref.v = Some(c) },
      today=fn() -> Option[headless_core::IsoDate] { Some(today) },
      is_unavailable=fn(d : headless_core::IsoDate) -> Bool { d == blocked },
    )
    rc_node_ref.v = Some(range_calendar(
      root,
      fn() -> String { "Trip" },
      today,
      fn() -> Option[(headless_core::IsoDate, headless_core::IsoDate)] { picked_range.get() },
      fn(s : headless_core::IsoDate, e : headless_core::IsoDate) { picked_range.set(Some((s, e))) },
      fn(_v : view::View, rc : RangeCalendar) { rc_ref.v = Some(rc) },
    ))
    let _ = calendar_year_picker(
      root,
      fn() -> String { "Year" },
      fn() -> Int { picked_year.get() },
      fn(y : Int) { picked_year.set(y) },
      fn(_v : view::View, yp : CalendarYearPicker) { yp_ref.v = Some(yp) },
    )
    let _ = date_field(
      root,
      fn() -> String { "Start Date" },
      fn() -> headless_core::SegmentedDateTime { seg_val.get() },
      fn(next : headless_core::SegmentedDateTime) { seg_val.set(next) },
      fn(v : view::View, df : DateField) {
        yr_seg_ref.v = Some(df.segment(v, headless_core::DateSegmentKind::Year, fn(sv : view::View, _t : () -> String) {
          let _ = sv.width(view::Live::Is(Some(48.0))).height(view::Live::Is(Some(24.0)))
        }))
        mo_seg_ref.v = Some(df.segment(v, headless_core::DateSegmentKind::Month, fn(sv : view::View, _t : () -> String) {
          let _ = sv.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(24.0)))
        }))
      },
      granularity=headless_core::DateGranularity::Minute,
      hour_cycle_12=true,
    )
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  let cal = match cal_ref.v { Some(x) => x; None => panic("missing cal") }
  // Moving +1 day from 24 skips blocked 25 -> lands on 26
  let moved = cal.move_days(1)
  w0b_assert(moved == headless_core::IsoDate::new(2026, 11, 26), "Calendar move_days skips unavailable 25 -> 26")
  w0b_assert(!cal.select(blocked), "blocked date cannot be selected")
  w0b_assert(cal.select(moved), "valid date selected")
  match picked_date.get() {
    Some(d) => w0b_assert(d == moved, "picked_date matches moved")
    None => panic("expected picked_date")
  }

  // RangeCalendar: reverse click normalizes start <= end and exposes multiselectable Grid
  let rc = match rc_ref.v { Some(x) => x; None => panic("missing rc") }
  let rcn = match rc_node_ref.v { Some(v) => v; None => panic("missing rc node") }
  match w0b_said_of(tree, rcn.id()) {
    Some(s) => w0b_assert(s.role == view::Role::Grid && s.multiselectable, "RangeCalendar Role::Grid multiselectable")
    None => panic("missing rc said")
  }
  let _ = rc.select(headless_core::IsoDate::new(2026, 11, 28))
  rc.set_hover(Some(headless_core::IsoDate::new(2026, 11, 20)))
  w0b_assert(rc.is_in_range(headless_core::IsoDate::new(2026, 11, 24)), "hover preview highlights 20..28")
  let _ = rc.select(headless_core::IsoDate::new(2026, 11, 20))
  match picked_range.get() {
    Some((s, e)) => w0b_assert(s == headless_core::IsoDate::new(2026, 11, 20) && e == headless_core::IsoDate::new(2026, 11, 28), "reverse range normalized")
    None => panic("expected picked_range")
  }

  // CalendarYearPicker paging
  let yp = match yp_ref.v { Some(x) => x; None => panic("missing yp") }
  w0b_assert(yp.years()[0] == 2016, "initial year page starts 2016")
  yp.next_page()
  w0b_assert(yp.years()[0] == 2028, "next year page starts 2028")

  // DateField segments: Role::SpinButton, Up steps empty placeholder, Right switches segment
  let ys = match yr_seg_ref.v { Some(v) => v; None => panic("missing year seg") }
  let ms = match mo_seg_ref.v { Some(v) => v; None => panic("missing month seg") }
  match w0b_said_of(tree, ys.id()) {
    Some(s) => w0b_assert(s.role == view::Role::SpinButton && s.value == "yyyy", "SpinButton empty placeholder yyyy")
    None => panic("missing year seg said")
  }
  let _ = ys.ask_focus(visible=true)
  let _ = tree.frame(400.0, 300.0, now=16.0)
  let _ = tree.key_at(5, 0, 16.0) // Up -> year 2026
  w0b_assert(w0b_opt_int_is(seg_val.get().year, 2026), "Up steps empty year to 2026")
  let _ = tree.key_at(4, 0, 20.0) // Right -> focuses month segment
  w0b_assert(ms.focused(), "Right switches focus to Month segment")
  let _ = tree.key_at(5, 0, 24.0) // Up -> month 1
  w0b_assert(w0b_opt_int_is(seg_val.get().month, 1), "Up steps empty month to 1")
  tree.dispose()
}
