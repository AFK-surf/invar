///|
/// A radio group or tab list in `parent`, called `label` (what a screen reader says), `chosen` saying which key `K` is
/// chosen now and `choose` told the key chosen by a press or an arrow key; `kind` whether it is a `Radio` group or a
/// `Tab` list; `axis` which arrow keys step along it; `disabled` while the whole group takes no press and no focus;
/// `manual`: the arrow keys and Home and End move the focus alone, what has it chosen by Space or Enter (WAI-ARIA's
/// tabs with manual activation, kit's tabs' `manual`: a tab whose panel is slow to show).
/// `look` is given the group's node and the `RadioGroup[K]` with which its items are made (`RadioGroup::item`, directly
/// or inside `View::each`). The group's node.

pub fn radio_group[K : Eq](parent : view::View, label : () -> String, chosen : () -> K, choose : (K) -> Unit, look : (view::View, RadioGroup[K]) -> Unit, kind? : GroupKind, axis? : GroupAxis, rtl? : Bool, shown? : () -> Bool, selected? : Bool, in_node? : Bool, disabled? : () -> Bool, manual? : Bool, made_for? : String, loc~ : String = "") -> view::View {
  let kind = match kind { Some(__mbt_v) => __mbt_v, None => GroupKind::Radio }
  let axis = match axis { Some(__mbt_v) => __mbt_v, None => GroupAxis::Horizontal }
  let rtl = match rtl { Some(__mbt_v) => __mbt_v, None => false }
  let shown = match shown { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let selected = match selected { Some(__mbt_v) => __mbt_v, None => false }
  let in_node = match in_node { Some(__mbt_v) => __mbt_v, None => false }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let manual = match manual { Some(__mbt_v) => __mbt_v, None => false }

  let setup = fn(v : view::View) {
    let items : Array[GroupEntry[K]] = []
    let rove = RovingFocus::new(axis=axis, roving=false, wraps=true, rtl=rtl)
    let building = mbt_compat::ref_new(true)
    let stops : Array[(view::View, () -> Unit)] = []
    let refocus : mbt_compat::Ref[Option[(view::View, K)]] = mbt_compat::ref_new(Option::None)
    let rg : RadioGroup[K] = RadioGroup::{ kind: kind, selected: selected, now: chosen, choose: choose, off: disabled, items: items, rove: rove, building: building, stops: stops, refocus: refocus }
    look(v, rg)
    // (the keyboard handed on as the tab chosen after a close comes: its node made by then)
    if kind is GroupKind::Tab {
      v.reacts(chosen, fn(_) { rg.hand_on() }, at_start=false) |> ignore
    }
    building.v = false
    for s in stops {
      if s.0.alive() {
        (s.1)()
      }
    }
    v
    .says(.By(fn() {
      if !shown() {
        Option::None
      } else {
        Some(match kind {
          GroupKind::Radio => view::said(.RadioGroup, label=label())
          GroupKind::Tab => view::said(.TabList, label=label())
        },)
      }
    }))
    .on_key(fn(k) {
      if disabled() || k.mods != 0 {
        return false
      }
      match rove.step(k.code) {
        Some(target_node) => {
          if !manual {
            for let mut i = 0; i < items.length(); i = i + 1 {
              let target = items[i]
              if target.node.id() == target_node.id() {
                let next_key = (target.key)()
                if next_key != chosen() {
                  choose(next_key)
                }
                break
              }
            }
          }
          true
        }
        Option::None => false
      }
    })
    |> ignore
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(loc=loc, made_for=made_for.unwrap_or(loc), setup)
  }
}

///|
/// The keyboard handed on after the tab it was on closed (`RadioGroup::refocus`): to the enabled item chosen now, the
/// closed one aside; where what is chosen is another key that no enabled item has, to the first enabled one. While the
/// closed one's key is still the one chosen (its caller has not said what comes in front yet), it waits.
fn RadioGroup::hand_on[K : Eq](self : RadioGroup[K]) -> Unit {
  guard self.refocus.v is Some((gone, gone_key)) else { return }
  let cur = signals::untracked(self.now)
  let live = mbt_compat::arr_filter(self.items, fn(e) { e.node.alive() && e.node.id() != gone.id() && !signals::untracked(e.off) })
  let mut matched : Option[GroupEntry[K]] = Option::None
  for let mut i = 0; i < live.length(); i = i + 1 {
    let e = live[i]
    if signals::untracked(e.key) == cur {
      matched = Some(e)
      break
    }
  }
  let to = match matched {
    Some(e) => Option::Some(e)
    Option::None => if cur != gone_key { mbt_compat::arr_get(live, 0) } else { Option::None }
  }
  if to is Some(e) {
    self.refocus.v = Option::None
    e.node.ask_focus(visible=true) |> ignore
  }
}

///|
/// An item of `self` in `parent` (which may be the group's node or a slot/container inside it), identified by `key`
/// and read out as `label`. `look` is given the item's node and its `RadioItem` state. `disabled` disables this item
/// alone; `space_only` limits keyboard activation on the focused item to Space (leaving Enter to a surrounding form);
/// `slop` attaches a pointer gesture of that touch slop whose tap or release on the item presses it (for sliding-thumb
/// strips where a finger moved off and back onto an item still chooses it on release). For `slide`, give a hold time
/// and a function that previews the option at a touch point and returns its key. A horizontal drag keeps sending points
/// after it leaves the group. On release, the group presses the final item and sends None to clear the preview.
/// `on_close` (a `Tab` list's item alone): the tab closes, `closes` saying while it may; Delete or Backspace on it
/// closes it, as `RadioItem::close` does, the keyboard handed on to the tab then chosen where it was on this one.
/// `in_node`: the item is `parent` itself (the slot a structure made for it: a row of `View::each`), said to be what it
/// is and no node more, as `radio_group`'s and a menu's items are. Its node.

pub fn RadioGroup::item[K : Eq](self : RadioGroup[K], parent : view::View, key : () -> K, label : () -> String, look : (view::View, RadioItem) -> Unit, disabled? : () -> Bool, space_only? : Bool, slop? : Double, slide? : (Double, (Option[view::Drag]) -> Option[K]), on_close? : () -> Unit, closes? : () -> Bool, in_node? : Bool, made_for? : String, loc~ : String = "") -> view::View {
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let space_only = match space_only { Some(__mbt_v) => __mbt_v, None => false }
  let closes = match closes { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let in_node = match in_node { Some(__mbt_v) => __mbt_v, None => false }

  let setup = fn(v : view::View) {
    let off = fn() { (self.off)() || disabled() }
    let able = fn() { !off() }
    let on = fn() { (self.now)() == key() }
    self.items.push(GroupEntry::{ node: v, key: key, off: disabled })
    self.rove.add(v, disabled=off)
    v.owns(fn() {
      mbt_compat::arr_retain(self.items, fn(e) { e.node.id() != v.id() })
      mbt_compat::arr_retain(self.stops, fn(s) { s.0.id() != v.id() })
    })
    |> ignore
    let close = match on_close {
      Some(f) if self.kind is GroupKind::Tab =>
      fn() {
        if !off() && closes() {
          // (the keyboard handed on only where it was on this tab)
          if v.focused() {
            self.refocus.v = Some((v, key()))
          }
          f()
          self.hand_on()
        }
      }
      _ => fn() { }
    }
    look(v, RadioItem::{ node: v, now: on, off: off, close_: close })
    if on_close is Some(_) && self.kind is GroupKind::Tab {
      v.on_key(fn(e) {
        if e.mods == 0 && (e.code == group_key_delete || e.code == group_key_backspace) && v.focused() && !off() && closes() {
          close()
          true
        } else {
          false
        }
      })
      |> ignore
    }
    if slop is Some(s) {
      let on_it = fn(d : view::Drag) { v.finger_target(d.wx, d.wy) }
      match slide {
        Option::None =>
        v.gesture(s, tap=fn(d) { if on_it(d) { v.press() |> ignore } }, drag=fn(d) { if d.kind == view::DragIs::Up && on_it(d) { v.press() |> ignore } })
        |> ignore
        Some((hold_ms, preview)) => {
          let horizontal : mbt_compat::Ref[Option[Bool]] = mbt_compat::ref_new(Option::None)
          let across = fn(d : view::Drag) { (d.x - d.ox).abs() > (d.y - d.oy).abs() }
          let tap = fn(d : view::Drag) {
            if on_it(d) {
              v.press() |> ignore
            }
            preview(None) |> ignore
          }
          v.gesture(s, press=fn(_) { horizontal.v = Option::None }, tap=tap, hold=(hold_ms, fn(d) { preview(Some(d)) |> ignore }), hold_yields=true, drag=fn(d) {
            match d.kind {
              .Down | view::DragIs::Moved => {
                if d.kind == view::DragIs::Down {
                  horizontal.v = Some(across(d))
                }
                preview(if horizontal.v == Some(true) { Some(d) } else { None }) |> ignore
              }
              .Up if horizontal.v.unwrap_or(across(d)) => {
                match preview(Some(d)) {
                  Some(k) =>
                  { for let mut i = 0; i < self.items.length(); i = i + 1 {
                    let item = self.items[i]
                    if item.node.alive() && !(item.off)() && (item.key)() == k {
                      item.node.press() |> ignore
                      break
                    }
                  } }
                  None => if on_it(d) { v.press() |> ignore }
                }
                preview(None) |> ignore
              }
              .Up => tap(d)
              view::DragIs::Off => preview(None) |> ignore
            }
          })
          |> ignore
        }
      }
    }
    let stop = fn() {
      let cur = (self.now)()
      let mut any_on = false
      let mut first_id : Option[view::NodeId] = Option::None
      for e in self.items {
        if e.node.alive() {
          let e_off = (e.off)()
          let e_key = (e.key)()
          if !e_off {
            if first_id is Option::None {
              first_id = Some(e.node.id())
            }
            if e_key == cur {
              any_on = true
            }
          }
        }
      }
      if off() {
        false
      } else if on() {
        true
      } else if any_on {
        false
      } else {
        first_id == Some(v.id())
      }
    }
    let keys = if space_only { view::focus_space } else { view::focus_enter | view::focus_space }
    v
    .presses(.By(able))
    .focusable(.By(able), keys=keys)
    .says(.By(fn() {
      let now = on()
      Some(match self.kind {
        GroupKind::Radio =>
        if self.selected {
          view::said(view::Role::Radio, label=label(), selected=now)
        } else {
          view::said(view::Role::Radio, label=label(), check=if now { .On } else { .Off })
        }
        GroupKind::Tab => view::said(view::Role::Tab, label=label(), selected=now)
      },)
    }))
    .on_press(fn() {
      if !off() {
        let k = key()
        if (self.now)() != k {
          (self.choose)(k)
        }
      }
    })
    |> ignore
    let bind_stop = fn() { v.tab_stop(.By(stop)) |> ignore }
    self.stops.push((v, bind_stop))
    if !self.building.v {
      for s in self.stops {
        if s.0.alive() {
          (s.1)()
        }
      }
    }
    // (the tab chosen after a close made only now: the keyboard handed on to it)
    if self.refocus.v is Some(_) && !self.building.v {
      self.hand_on()
    }
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(loc=loc, made_for=made_for.unwrap_or(loc), setup)
  }
}
