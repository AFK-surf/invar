// The choice: an option among choices (Button or Radio).
// Ported 1:1 from libs/mbui/src/headless/choice.mbt.

import "view"

/// What a choice is to a screen reader: a choice button or a radio option.
#derive(Eq)
pub enum ChoiceKind {
  Button
  Radio
}

/// A choice as its look reads it.
pub struct Choice {
  node : view::View
  now : () -> Bool
  off : () -> Bool
}

pub fn Choice::chosen(self : Choice) -> Bool {
  (self.now)()
}

pub fn Choice::disabled(self : Choice) -> Bool {
  (self.off)()
}

pub fn Choice::pressed(self : Choice) -> Bool {
  self.node.pressed()
}

pub fn Choice::hovered(self : Choice) -> Bool {
  self.node.pointed()
}

pub fn Choice::focus_shown(self : Choice) -> Bool {
  self.node.focus_shown()
}

pub fn Choice::press(self : Choice) -> Unit {
  let _ = self.node.press()
}

/// A choice of `kind` in `parent`, called `label`, selected while `chosen` says so.
pub fn choice(
  parent : view::View,
  kind : ChoiceKind,
  label : () -> String,
  chosen : () -> Bool,
  choose : (view::View) -> Unit,
  look : (view::View, Choice) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  focusable~ : Bool = true,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    look(v, Choice::{ node: v, now: chosen, off: disabled })
    let role : view::Role = match kind {
      Button => view::Role::Button
      Radio => view::Role::Radio
    }
    let _ = v
      .presses(view::Live::By(able))
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(role, label=label(), selected=chosen()))
      }))
      .on_press(fn() {
        if !disabled() {
          choose(v)
        }
      })
    if focusable {
      let _ = v.focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space)
    }
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
