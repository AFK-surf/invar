// The toggle group: a row or column of toggle buttons (Single or Multiple).
// Ported 1:1 from libs/mbui/src/headless/toggle_group.mbt.

import "view"

/// Whether at most one item of a toggle group is on at a time (`Single`) or each is its own (`Multiple`).
#derive(Eq)
pub enum ToggleGroupKind {
  Single
  Multiple
}

/// A toggle group handed to its look to make its items by (`ToggleGroup::item`).
pub struct ToggleGroup[K] {
  kind : ToggleGroupKind
  is_on : (K) -> Bool
  turn : (K, Bool) -> Unit
  off : () -> Bool
  items : RovingFocus
}

pub fn ToggleGroup::disabled[K](self : ToggleGroup[K]) -> Bool {
  (self.off)()
}

pub fn ToggleGroup::single[K](self : ToggleGroup[K]) -> Bool {
  self.kind == ToggleGroupKind::Single
}

/// A toggle group in `parent`, called `label`, its items on as `is_on` says, `turn` told the key pressed.
pub fn toggle_group[K](
  parent : view::View,
  label : () -> String,
  is_on : (K) -> Bool,
  turn : (K, Bool) -> Unit,
  look : (view::View, ToggleGroup[K]) -> Unit,
  kind~ : ToggleGroupKind = ToggleGroupKind::Multiple,
  axis~ : GroupAxis = GroupAxis::Horizontal,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let items = RovingFocus::new(axis=axis, roving=true, wraps=wraps, rtl=rtl)
  let g : ToggleGroup[K] = ToggleGroup::{ kind, is_on, turn, off: disabled, items }
  parent.box(fn(v : view::View) {
    look(v, g)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Group, label=label())) }))
      .on_key(fn(k : view::Key) -> Bool {
        if k.mods != 0 || disabled() {
          return false
        }
        items.step(k.code) is Some(_)
      })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}

/// An item of `key` in `parent`, called `label`: a toggle button.
pub fn ToggleGroup::item[K](
  self : ToggleGroup[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View, Toggle) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off = fn() -> Bool { (self.off)() || disabled() }
  let on = fn() -> Bool { (self.is_on)(key) }
  let v = toggle(
    parent,
    ToggleKind::Button,
    label,
    on,
    fn(to : Bool) { (self.turn)(key, to) },
    look,
    disabled=off,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
  self.items.add(v, off=off, first=on)
  v
}
