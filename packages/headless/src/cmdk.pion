// A command palette's scoring, filtering, grouping, and navigation (cmdk + command-score).
// Ported 1:1 from libs/mbui/src/headless/cmdk.mbt.

import "view"

let score_continue_match : Double = 1.0
let score_space_word_jump : Double = 0.9
let score_non_space_word_jump : Double = 0.8
let score_character_jump : Double = 0.17
let score_transposition : Double = 0.1
let penalty_skipped : Double = 0.999
let penalty_case_mismatch : Double = 0.9999
let penalty_not_complete : Double = 0.99

fn score_pow(b : Double, n : Int) -> Double {
  let mut r = 1.0
  let mut i = 0
  while i < n {
    r = r * b
    i += 1
  }
  r
}

fn score_gap(c : Int) -> Bool {
  c == 92 ||  // '\\'
  c == 47 ||  // '/'
  c == 95 ||  // '_'
  c == 43 ||  // '+'
  c == 46 ||  // '.'
  c == 35 ||  // '#'
  c == 34 ||  // '"'
  c == 64 ||  // '@'
  c == 91 ||  // '['
  c == 40 ||  // '('
  c == 123 || // '{'
  c == 38     // '&'
}

fn score_space(c : Int) -> Bool {
  (c >= 0x09 && c <= 0x0D) ||
  c == 0x20 ||
  c == 45 || // '-'
  c == 0xA0 ||
  c == 0x1680 ||
  (c >= 0x2000 && c <= 0x200A) ||
  c == 0x2028 ||
  c == 0x2029 ||
  c == 0x202F ||
  c == 0x205F ||
  c == 0x3000 ||
  c == 0xFEFF
}

fn str_to_codes(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu >= 0xD800 && cu <= 0xDBFF && i + 1 < n {
      let lo = s.code_unit_at(i + 1)
      if lo >= 0xDC00 && lo <= 0xDFFF {
        out.push(0x10000 + ((cu - 0xD800) << 10) + (lo - 0xDC00))
        i += 2
        continue
      }
    }
    out.push(cu)
    i += 1
  }
  out
}

fn score_folded(s : Array[Int]) -> Array[Int] {
  view::array_map(s, fn(c : Int) -> Int {
    if c >= 65 && c <= 90 {
      c + 32
    } else if score_space(c) {
      0x20
    } else {
      c
    }
  })
}

fn score_at(s : Array[Int], at : Int) -> Int {
  if at >= 0 && at < s.length() {
    s[at]
  } else {
    -1
  }
}

fn score_index_of(s : Array[Int], c : Int, from : Int) -> Int {
  let mut i = from
  while i < s.length() {
    if s[i] == c {
      return i
    }
    i += 1
  }
  -1
}

fn score_count(s : Array[Int], start : Int, end : Int, such : (Int) -> Bool) -> Int {
  let mut n = 0
  let mut i = start
  while i < end {
    if such(s[i]) {
      n += 1
    }
    i += 1
  }
  n
}

fn score_inner(
  s : Array[Int],
  a : Array[Int],
  ls : Array[Int],
  la : Array[Int],
  si : Int,
  ai : Int,
  memo : Array[Double],
) -> Double {
  if ai >= a.length() {
    return if si == s.length() { score_continue_match } else { penalty_not_complete }
  }
  let key = si * (a.length() + 1) + ai
  if memo[key] >= 0.0 {
    return memo[key]
  }
  let c = la[ai]
  let mut index = score_index_of(ls, c, si)
  let mut high = 0.0
  while index >= 0 {
    let mut score = score_inner(s, a, ls, la, index + 1, ai + 1, memo)
    if score > high {
      if index == si {
        score = score * score_continue_match
      } else if score_gap(score_at(s, index - 1)) {
        score = score * score_non_space_word_jump
        let breaks = score_count(s, si, index - 1, score_gap)
        if breaks > 0 && si > 0 {
          score = score * score_pow(penalty_skipped, breaks)
        }
      } else if score_space(score_at(s, index - 1)) {
        score = score * score_space_word_jump
        let breaks = score_count(s, si, index - 1, score_space)
        if breaks > 0 && si > 0 {
          score = score * score_pow(penalty_skipped, breaks)
        }
      } else {
        score = score * score_character_jump
        if si > 0 {
          score = score * score_pow(penalty_skipped, index - si)
        }
      }
      if s[index] != a[ai] {
        score = score * penalty_case_mismatch
      }
    }
    if (score < score_transposition && score_at(ls, index - 1) == score_at(la, ai + 1)) ||
      (score_at(la, ai + 1) == score_at(la, ai) && score_at(ls, index - 1) != score_at(la, ai)) {
      let transposed = score_inner(s, a, ls, la, index + 1, ai + 2, memo)
      if transposed * score_transposition > score {
        score = transposed * score_transposition
      }
    }
    if score > high {
      high = score
    }
    index = score_index_of(ls, c, index + 1)
  }
  memo[key] = high
  high
}

/// How well `query` matches `words`, from 0 (not at all) to 1 (exact).
pub fn command_score(words : String, query : String, aliases~ : Array[String] = []) -> Double {
  let whole = StringBuilder::new()
  whole.write_string(words)
  for one in aliases {
    whole.write_char(' ')
    whole.write_string(one)
  }
  let s = str_to_codes(whole.to_string())
  let a = str_to_codes(query)
  let memo = Array::make((s.length() + 1) * (a.length() + 1), -1.0)
  score_inner(s, a, score_folded(s), score_folded(a), 0, 0, memo)
}

/// How well `query` matches a choice of these words and keywords.
pub fn cmdk_score(words : String, query : String, keywords~ : Array[String] = []) -> Double {
  if words == "" {
    return 0.0
  }
  let mut best = command_score(words, query)
  for k in keywords {
    let score = command_score(k, query)
    if score > best {
      best = score
    }
  }
  best
}

/// A choice of a palette.
pub struct CmdkItem[K] {
  pub key : K
  pub label : String
  pub keywords : Array[String]
  pub group : String
  pub disabled : Bool
}

pub fn cmdk_item[K](
  key : K,
  label : String,
  keywords~ : Array[String] = [],
  group~ : String = "",
  disabled~ : Bool = false,
) -> CmdkItem[K] {
  CmdkItem::{ key, label, keywords, group, disabled }
}

/// A row of a palette's list, in order.
pub enum CmdkEntry[K] {
  Heading(String)
  Separator(String)
  Item(CmdkItem[K], Double)
}

fn cmp_double_desc(a : Double, b : Double) -> Int {
  if b > a {
    1
  } else if b < a {
    -1
  } else {
    0
  }
}

fn cmp_int_asc(a : Int, b : Int) -> Int {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

/// The rows a palette of `items` shows with `query` written.
pub fn cmdk_filter[K](
  items : Array[CmdkItem[K]],
  query : String,
  score~ : (String, String, Array[String]) -> Double = fn(w : String, q : String, k : Array[String]) -> Double {
    cmdk_score(w, q, keywords=k)
  },
) -> Array[CmdkEntry[K]] {
  let searching = str_trim(query) != ""
  let scores : Array[Double] = view::array_map(items, fn(it : CmdkItem[K]) -> Double {
    if searching { score(it.label, query, it.keywords) } else { 0.0 }
  })
  let shown = fn(i : Int) -> Bool { !searching || scores[i] > 0.0 }
  let by_score = fn(xs : Array[Int]) -> Array[Int] {
    let out : Array[Int] = []
    for x in xs {
      out.push(x)
    }
    if searching {
      view::array_sort_by(out, fn(x : Int, y : Int) -> Int {
        let c = cmp_double_desc(scores[x], scores[y])
        if c != 0 { c } else { cmp_int_asc(x, y) }
      })
    }
    out
  }
  let all : Array[Int] = []
  let mut idx = 0
  while idx < items.length() {
    all.push(idx)
    idx += 1
  }
  let order : Array[Int] = by_score(view::array_filter(all, fn(i : Int) -> Bool { items[i].group == "" && shown(i) }))
  let names : Array[String] = []
  for it in items {
    if it.group != "" && !str_array_contains(names, it.group) {
      names.push(it.group)
    }
  }
  let lit : Array[(Int, Double)] = []
  let mut ni = 0
  while ni < names.length() {
    let name = names[ni]
    let mut best = 0.0
    let mut any = false
    let mut i = 0
    while i < items.length() {
      if items[i].group == name && shown(i) {
        any = true
        if scores[i] > best {
          best = scores[i]
        }
      }
      i += 1
    }
    if any {
      lit.push((ni, best))
    }
    ni += 1
  }
  if searching {
    view::array_sort_by(lit, fn(x : (Int, Double), y : (Int, Double)) -> Int {
      let c = cmp_double_desc(x.1, y.1)
      if c != 0 { c } else { cmp_int_asc(x.0, y.0) }
    })
  }
  for g in lit {
    let name = names[g.0]
    let group_idxs = by_score(view::array_filter(all, fn(i : Int) -> Bool { items[i].group == name && shown(i) }))
    view::array_append(order, group_idxs)
  }
  let rows : Array[CmdkEntry[K]] = []
  let mut before : Option[String] = None
  for i in order {
    let g = items[i].group
    let new_group = match before {
      None => true
      Some(b) => b != g
    }
    if new_group {
      if before is Some(_) {
        rows.push(CmdkEntry::Separator(g))
      }
      if g != "" {
        rows.push(CmdkEntry::Heading(g))
      }
    }
    rows.push(CmdkEntry::Item(items[i], scores[i]))
    before = Some(g)
  }
  rows
}

/// The choices of `rows`, in order.
pub fn cmdk_keys[K](rows : Array[CmdkEntry[K]]) -> Array[K] {
  view::array_filter_map(rows, fn(r : CmdkEntry[K]) -> Option[K] {
    match r {
      Item(it, _) => Some(it.key)
      _ => None
    }
  })
}

fn cmdk_valid[K](rows : Array[CmdkEntry[K]]) -> Array[CmdkItem[K]] {
  view::array_filter_map(rows, fn(r : CmdkEntry[K]) -> Option[CmdkItem[K]] {
    match r {
      Item(it, _) => if !it.disabled { Some(it) } else { None }
      _ => None
    }
  })
}

/// The first choice of `rows` that can be chosen.
pub fn cmdk_first[K](rows : Array[CmdkEntry[K]]) -> Option[K] {
  let valid = cmdk_valid(rows)
  if valid.length() > 0 {
    Some(valid[0].key)
  } else {
    None
  }
}

/// Where the keys are once the rows changed.
pub fn cmdk_keep[K : view::ViewEq](rows : Array[CmdkEntry[K]], selected : Option[K]) -> Option[K] {
  match selected {
    Some(k) => {
      if view::array_any(cmdk_valid(rows), fn(it : CmdkItem[K]) -> Bool { it.key.eq(k) }) {
        return Some(k)
      }
    }
    None => ()
  }
  cmdk_first(rows)
}

/// Where a key moves the keys.
#derive(Eq)
pub enum CmdkMove {
  NextItem
  PrevItem
  FirstItem
  LastItem
  NextGroup
  PrevGroup
}

/// Where the keys are after `by` from `selected`.
pub fn cmdk_move[K : view::ViewEq](
  rows : Array[CmdkEntry[K]],
  selected : Option[K],
  by : CmdkMove,
  wraps~ : Bool = false,
) -> Option[K] {
  let valid = cmdk_valid(rows)
  let n = valid.length()
  if n == 0 {
    return selected
  }
  let at : Option[Int] = match selected {
    Some(k) => view::array_search_by(valid, fn(it : CmdkItem[K]) -> Bool { it.key.eq(k) })
    None => None
  }
  let key = fn(i : Int) -> Option[K] { Some(valid[i].key) }
  let by_one = fn(change : Int) -> Option[K] {
    match at {
      None => if change > 0 { key(0) } else { key(n - 1) }
      Some(i) =>
        if i + change < 0 {
          if wraps { key(n - 1) } else { selected }
        } else if i + change >= n {
          if wraps { key(0) } else { selected }
        } else {
          key(i + change)
        }
    }
  }
  match by {
    NextItem => by_one(1)
    PrevItem => by_one(-1)
    FirstItem => key(0)
    LastItem => key(n - 1)
    NextGroup | PrevGroup => {
      let change = if by == CmdkMove::NextGroup { 1 } else { -1 }
      let runs : Array[(String, Array[CmdkItem[K]])] = []
      for r in rows {
        match r {
          Item(it, _) => {
            let rl = runs.length()
            if rl > 0 && runs[rl - 1].0 == it.group {
              runs[rl - 1].1.push(it)
            } else {
              runs.push((it.group, [it]))
            }
          }
          _ => ()
        }
      }
      let mine : Option[Int] = match selected {
        Some(k) => view::array_search_by(runs, fn(r : (String, Array[CmdkItem[K]])) -> Bool {
          r.0 != "" && view::array_any(r.1, fn(it : CmdkItem[K]) -> Bool { it.key.eq(k) })
        })
        None => None
      }
      let m = match mine {
        Some(idx) => idx
        None => return by_one(change)
      }
      let mut r = m + change
      while r >= 0 && r < runs.length() {
        let (g, xs) = runs[r]
        if g != "" {
          match view::array_find_first(xs, fn(it : CmdkItem[K]) -> Bool { !it.disabled }) {
            Some(it) => return Some(it.key)
            None => ()
          }
        }
        r += change
      }
      by_one(change)
    }
  }
}
