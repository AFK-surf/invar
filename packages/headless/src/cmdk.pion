// A command palette's scoring, filtering, grouping, and navigation (cmdk + command-score).
// Pure scoring, filtering, and movement delegated to `headless_core`.

import "headless_core"
import "view"

/// How well `query` matches `words`, from 0 (not at all) to 1 (exact).
pub fn command_score(words : String, query : String, aliases~ : Array[String] = []) -> Double {
  headless_core::command_score(words, query, aliases=aliases)
}

/// How well `query` matches a choice of these words and keywords.
pub fn cmdk_score(words : String, query : String, keywords~ : Array[String] = []) -> Double {
  headless_core::cmdk_score(words, query, keywords=keywords)
}

/// A choice of a palette.
pub struct CmdkItem[K] {
  pub key : K
  pub label : String
  pub keywords : Array[String]
  pub group : String
  pub disabled : Bool
}

pub fn cmdk_item[K](
  key : K,
  label : String,
  keywords~ : Array[String] = [],
  group~ : String = "",
  disabled~ : Bool = false,
) -> CmdkItem[K] {
  CmdkItem::{ key, label, keywords, group, disabled }
}

/// A row of a palette's list, in order.
pub enum CmdkEntry[K] {
  Heading(String)
  Separator(String)
  Item(CmdkItem[K], Double)
}

fn to_core_cmdk_item[K](it : CmdkItem[K]) -> headless_core::CmdkItem[K] {
  headless_core::CmdkItem::{
    key: it.key,
    label: it.label,
    keywords: it.keywords,
    group: it.group,
    disabled: it.disabled,
  }
}

fn from_core_cmdk_item[K](it : headless_core::CmdkItem[K]) -> CmdkItem[K] {
  CmdkItem::{
    key: it.key,
    label: it.label,
    keywords: it.keywords,
    group: it.group,
    disabled: it.disabled,
  }
}

fn to_core_cmdk_entries[K](rows : Array[CmdkEntry[K]]) -> Array[headless_core::CmdkEntry[K]] {
  view::array_map(rows, fn(r : CmdkEntry[K]) -> headless_core::CmdkEntry[K] {
    match r {
      Heading(h) => headless_core::CmdkEntry::Heading(h)
      Separator(s) => headless_core::CmdkEntry::Separator(s)
      Item(it, sc) => headless_core::CmdkEntry::Item(to_core_cmdk_item(it), sc)
    }
  })
}

fn from_core_cmdk_entries[K](rows : Array[headless_core::CmdkEntry[K]]) -> Array[CmdkEntry[K]] {
  view::array_map(rows, fn(r : headless_core::CmdkEntry[K]) -> CmdkEntry[K] {
    match r {
      Heading(h) => CmdkEntry::Heading(h)
      Separator(s) => CmdkEntry::Separator(s)
      Item(it, sc) => CmdkEntry::Item(from_core_cmdk_item(it), sc)
    }
  })
}

/// The rows a palette of `items` shows with `query` written.
pub fn cmdk_filter[K](
  items : Array[CmdkItem[K]],
  query : String,
  score~ : (String, String, Array[String]) -> Double = fn(w : String, q : String, k : Array[String]) -> Double {
    cmdk_score(w, q, keywords=k)
  },
) -> Array[CmdkEntry[K]] {
  let core_items = view::array_map(items, fn(it : CmdkItem[K]) -> headless_core::CmdkItem[K] {
    to_core_cmdk_item(it)
  })
  from_core_cmdk_entries(headless_core::cmdk_filter(core_items, query, score=score))
}

/// The choices of `rows`, in order.
pub fn cmdk_keys[K](rows : Array[CmdkEntry[K]]) -> Array[K] {
  headless_core::cmdk_keys(to_core_cmdk_entries(rows))
}

/// The first choice of `rows` that can be chosen.
pub fn cmdk_first[K](rows : Array[CmdkEntry[K]]) -> Option[K] {
  headless_core::cmdk_first(to_core_cmdk_entries(rows))
}

/// Where the keys are once the rows changed.
pub fn cmdk_keep[K : view::ViewEq](rows : Array[CmdkEntry[K]], selected : Option[K]) -> Option[K] {
  headless_core::cmdk_keep_by(to_core_cmdk_entries(rows), selected, fn(a : K, b : K) -> Bool { a.eq(b) })
}

/// Where a key moves the keys.
#derive(Eq)
pub enum CmdkMove {
  NextItem
  PrevItem
  FirstItem
  LastItem
  NextGroup
  PrevGroup
}

fn to_core_cmdk_move(by : CmdkMove) -> headless_core::CmdkMove {
  match by {
    NextItem => headless_core::CmdkMove::NextItem
    PrevItem => headless_core::CmdkMove::PrevItem
    FirstItem => headless_core::CmdkMove::FirstItem
    LastItem => headless_core::CmdkMove::LastItem
    NextGroup => headless_core::CmdkMove::NextGroup
    PrevGroup => headless_core::CmdkMove::PrevGroup
  }
}

/// Where the keys are after `by` from `selected`.
pub fn cmdk_move[K : view::ViewEq](
  rows : Array[CmdkEntry[K]],
  selected : Option[K],
  by : CmdkMove,
  wraps~ : Bool = false,
) -> Option[K] {
  headless_core::cmdk_move_by(
    to_core_cmdk_entries(rows),
    selected,
    to_core_cmdk_move(by),
    fn(a : K, b : K) -> Bool { a.eq(b) },
    wraps=wraps,
  )
}
