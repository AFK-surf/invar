// Comprehensive pure-Pion unit tests for Wave 2 headless primitives (10 modules)
// plus FocusRecovery whole-container unmount hardening and zero-draw invariants.

import "dmath"
import "mbt_compat"
import "signals"
import "view"

fn opt_str_is(o : Option[String], expected : String) -> Bool {
  match o {
    Some(s) => s == expected
    None => false
  }
}

fn opt_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn str_arr_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

test "p1-00 FocusRecovery whole-container unmount does not steal focus, single-item unmount still recovers" {
  let show_menu = signals::signal(true)
  let show_item2 = signals::signal(true)
  let outer_btn : signals::Ref[Option[view::View]] = view::ref_new(None)
  let item1 : signals::Ref[Option[view::View]] = view::ref_new(None)
  let item2 : signals::Ref[Option[view::View]] = view::ref_new(None)
  let item3 : signals::Ref[Option[view::View]] = view::ref_new(None)
  let rf = RovingFocus::new(axis=GroupAxis::Vertical, roving=true, wraps=true)

  let tree = make_tree(fn(root : view::View) {
    outer_btn.v = Some(root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
    }))
    root.show(fn() -> Bool { show_menu.get() }, fn(container : view::View) {
      let n1 = container.box(fn(v : view::View) {
        let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      })
      rf.add(n1)
      item1.v = Some(n1)
      container.show(fn() -> Bool { show_item2.get() }, fn(s : view::View) {
        let n2 = s.box(fn(v : view::View) {
          let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
        })
        rf.add(n2)
        item2.v = Some(n2)
      }, at_once=true)
      let n3 = container.box(fn(v : view::View) {
        let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      })
      rf.add(n3)
      item3.v = Some(n3)
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let n2 = match item2.v { Some(x) => x; None => panic("n2") }
  let n3 = match item3.v { Some(x) => x; None => panic("n3") }
  let outer = match outer_btn.v { Some(x) => x; None => panic("outer") }

  // 1) Single-item unmount hands focus to surviving neighbor n3.
  assert(n2.ask_focus(visible=true) && n2.focused(), "focus n2")
  show_item2.set(false)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  assert(n3.focused(), "single-item removal hands focus to n3")

  // 2) Whole-container unmount must NOT let sibling n1 steal focus during teardown.
  show_menu.set(false)
  let _ = outer.ask_focus(visible=true)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  assert(outer.focused(), "whole-container unmount preserves outer focus without stealing")
  let n1 = match item1.v { Some(x) => x; None => panic("n1") }
  assert(!n1.alive() && !n1.focused(), "unmounted sibling n1 is not focused")
  tree.dispose()
}

test "p1-01 Reorder keyboard/drag, reorder_apply, edge_scroll_speed, and Transfer RTL" {
  // Pure helpers
  let moved = reorder_apply(["a", "b", "c", "d"], 1, 3)
  assert(moved.length() == 4 && moved[0] == "a" && moved[1] == "c" && moved[2] == "d" && moved[3] == "b", "reorder_apply forward")
  let moved_back = reorder_apply(["a", "b", "c", "d"], 3, 0)
  assert(moved_back[0] == "d" && moved_back[1] == "a", "reorder_apply backward")
  assert(edge_scroll_speed(10.0, 0.0, 300.0, zone=50.0, max_speed=500.0) < 0.0, "edge_scroll_speed near start negative")
  assert(edge_scroll_speed(150.0, 0.0, 300.0, zone=50.0, max_speed=500.0) == 0.0, "edge_scroll_speed interior zero")
  assert(edge_scroll_speed(290.0, 0.0, 300.0, zone=50.0, max_speed=500.0) > 0.0, "edge_scroll_speed near end positive")

  // Keyboard Reorder
  let items = signals::signal_by(["a", "b", "c"], same=str_arr_eq)
  let r = Reorder::new(
    fn() -> Array[String] { items.get() },
    fn(_key : String, from : Int, to : Int) { items.set(reorder_apply(items.untracked(), from, to)) },
  )
  let na : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tree = make_tree(fn(root : view::View) {
    let a = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      r.item(v, "a")
    })
    na.v = Some(a)
    let _ = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      r.item(v, "b")
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      r.item(v, "c")
    })
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let a_node = match na.v { Some(x) => x; None => panic("na") }

  assert(a_node.ask_focus(visible=true), "focus a")
  // Space grabs, Down twice moves to 2, Space commits -> ["b", "c", "a"]
  assert(tree.key_at(1032, 0, 16.0) && r.is_dragging("a"), "Space grabs a")
  assert(tree.key_at(6, 0, 24.0) && tree.key_at(6, 0, 32.0), "Down moves draft to end")
  match r.active() {
    Some(d) => assert(d.from_index == 0 && d.to_index == 2, "draft at 0 -> 2")
    None => panic("missing draft")
  }
  assert(tree.key_at(1032, 0, 48.0) && r.active() is None, "Space commits")
  let cur = items.get()
  assert(cur[0] == "b" && cur[1] == "c" && cur[2] == "a", "reordered to b, c, a")

  // Grab + Escape cancels without mutating
  assert(tree.key_at(1032, 0, 64.0) && r.active() is Some(_), "re-grab")
  assert(tree.key_at(17, 0, 80.0) && r.active() is None, "Escape cancels reorder")
  tree.dispose()

  // Cross-column Transfer (RTL: Left moves to next column)
  let commits : Array[(String, String, Int, String, Int)] = []
  let board = Transfer::new(
    fn() -> Array[String] { ["todo", "doing", "done"] },
    fn(col : String) -> Array[String] {
      if col == "todo" { ["t1", "t2"] } else if col == "doing" { ["t3"] } else { [] }
    },
    fn(k : String, fc : String, fi : Int, tc : String, ti : Int) { commits.push((k, fc, fi, tc, ti)) },
  )
  let t1_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tree2 = make_tree(fn(root : view::View) {
    let t1 = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      board.item(v, "todo", "t1", rtl=true)
    })
    t1_node.v = Some(t1)
    let _ = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      board.item(v, "todo", "t2", rtl=true)
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true), keys=view::focus_enter)
      board.item(v, "doing", "t3", rtl=true)
    })
  })
  let _ = tree2.frame(400.0, 200.0, now=0.0)
  let tn = match t1_node.v { Some(x) => x; None => panic("t1") }
  assert(tn.ask_focus(visible=true), "focus t1")
  assert(tree2.key_at(1032, 0, 16.0) && board.is_transferring("t1"), "Space grabs t1")
  assert(tree2.key_at(3, 0, 32.0), "RTL Left moves todo -> doing")
  assert(tree2.key_at(7, 0, 48.0) && board.active() is None, "Enter commits cross-column transfer")
  assert(commits.length() == 1 && commits[0].1 == "todo" && commits[0].3 == "doing", "transfer committed todo -> doing")
  tree2.dispose()
}

test "p1-02 Tree tri-state cascade checks, RTL expand/collapse, collapse focus recovery, and typeahead" {
  let specs = [
    TreeCheckNode::{ key: "root", children: ["a", "b"], disabled: false },
    TreeCheckNode::{ key: "a", children: [], disabled: false },
    TreeCheckNode::{ key: "b", children: [], disabled: false },
  ]
  let checked1 = toggle_tree_check(specs, [], "a", strategy=TreeCheckStrategy::Cascade)
  let states1 = tree_checked_states(specs, checked1, strategy=TreeCheckStrategy::Cascade)
  assert(states1[0].1 == TreeCheckState::Indeterminate, "parent indeterminate when 1/2 children checked")
  assert(states1[1].1 == TreeCheckState::Checked && states1[2].1 == TreeCheckState::Unchecked, "a checked, b unchecked")

  let checked2 = toggle_tree_check(specs, checked1, "b", strategy=TreeCheckStrategy::Cascade)
  let states2 = tree_checked_states(specs, checked2, strategy=TreeCheckStrategy::Cascade)
  assert(states2[0].1 == TreeCheckState::Checked, "parent checked when all children checked")

  let checked3 = toggle_tree_check(specs, checked2, "root", strategy=TreeCheckStrategy::Cascade)
  let states3 = tree_checked_states(specs, checked3, strategy=TreeCheckStrategy::Cascade)
  assert(states3[0].1 == TreeCheckState::Unchecked && states3[1].1 == TreeCheckState::Unchecked && states3[2].1 == TreeCheckState::Unchecked, "toggling checked parent unchecks subtree")

  // Disabled leaf must NOT trap parent in permanent Indeterminate state
  let specs_dis = [
    TreeCheckNode::{ key: "root", children: ["a", "b"], disabled: false },
    TreeCheckNode::{ key: "a", children: [], disabled: false },
    TreeCheckNode::{ key: "b", children: [], disabled: true },
  ]
  let dc1 = toggle_tree_check(specs_dis, [], "a", strategy=TreeCheckStrategy::Cascade)
  let ds1 = tree_checked_states(specs_dis, dc1, strategy=TreeCheckStrategy::Cascade)
  assert(ds1[0].1 == TreeCheckState::Checked && ds1[1].1 == TreeCheckState::Checked && ds1[2].1 == TreeCheckState::Unchecked, "parent Checked when all enabled children checked")
  let dc2 = toggle_tree_check(specs_dis, dc1, "root", strategy=TreeCheckStrategy::Cascade)
  let ds2 = tree_checked_states(specs_dis, dc2, strategy=TreeCheckStrategy::Cascade)
  assert(ds2[0].1 == TreeCheckState::Unchecked && ds2[1].1 == TreeCheckState::Unchecked && ds2[2].1 == TreeCheckState::Unchecked, "toggling parent unchecks enabled children cleanly")

  // Interactive Tree with expand/collapse + collapse focus recovery
  let expanded = signals::signal(false)
  let selected = signals::signal_by(["root"], same=str_arr_eq)
  let root_item : signals::Ref[Option[view::View]] = view::ref_new(None)
  let child_item : signals::Ref[Option[view::View]] = view::ref_new(None)
  let tbox_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    tbox_ref.v = Some(tree(
      root,
      fn() -> String { "Files" },
      fn(k : String) -> Bool { str_array_contains(selected.get(), k) },
      fn(k : String) { selected.set([k]) },
      fn(k : String) -> Bool { k == "root" && expanded.get() },
      fn(k : String, open : Bool) { if k == "root" { expanded.set(open) } },
      fn(v : view::View, tr : Tree[String]) {
        root_item.v = Some(tr.item(
          v,
          "root",
          fn() -> String { "src" },
          fn(_n : view::View, _it : TreeItem) { () },
          has_children=fn() -> Bool { true },
        ))
        v.show(fn() -> Bool { expanded.get() }, fn(s : view::View) {
          child_item.v = Some(tr.item(
            s,
            "child",
            fn() -> String { "main.pion" },
            fn(_n : view::View, _it : TreeItem) { () },
            parent_key="root",
            level=2,
          ))
        }, at_once=true)
      },
      on_select_many=fn(next : Array[String]) { selected.set(next) },
    ))
  })
  let _ = t.frame(300.0, 200.0, now=0.0)
  let tb = match tbox_ref.v { Some(x) => x; None => panic("tb") }
  let ri = match root_item.v { Some(x) => x; None => panic("ri") }

  match said_of(t, tb.id()) {
    Some(s) => assert(s.role == view::Role::Listbox, "tree container Role::Listbox")
    None => panic("missing tree said")
  }
  match said_of(t, ri.id()) {
    Some(s) => assert(s.role == view::Role::Option && opt_bool_is(s.expanded, false), "tree item Role::Option collapsed")
    None => panic("missing item said")
  }

  assert(ri.ask_focus(visible=true), "focus root item")
  // Right expands root
  assert(t.key_at(4, 0, 16.0) && expanded.get(), "Right expands root")
  let _ = t.frame(300.0, 200.0, now=16.0)
  // Right again enters first child
  assert(t.key_at(4, 0, 32.0), "Right moves to first child")
  let ci = match child_item.v { Some(x) => x; None => panic("ci") }
  assert(ci.focused(), "child focused")

  // Collapsing root while child is focused recovers focus back onto root
  expanded.set(false)
  let _ = t.frame(300.0, 200.0, now=48.0)
  assert(ri.focused(), "collapse recovers focus back to parent")
  t.dispose()
}

test "p1-03 Menubar Role::MenuBar, Down/Enter open, Left/Right & hover hot-switch, Escape focus return" {
  let open_menu : signals::Signal[Option[String]] = signals::signal_by(None, same=opt_str_eq)
  let mb_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let file_trig : signals::Ref[Option[view::View]] = view::ref_new(None)
  let edit_trig : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    mb_node.v = Some(menubar(
      root,
      fn() -> String { "App Menu" },
      fn() -> Option[String] { open_menu.get() },
      fn(k : Option[String]) { open_menu.set(k) },
      fn(v : view::View, mb : Menubar[String]) {
        file_trig.v = Some(mb.trigger(v, "file", fn() -> String { "File" }, fn(n : view::View, _tr : MenubarTrigger) {
          let _ = n.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(28.0)))
        }))
        edit_trig.v = Some(mb.trigger(v, "edit", fn() -> String { "Edit" }, fn(n : view::View, _tr : MenubarTrigger) {
          let _ = n.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(28.0)))
        }))
      },
    ))
  })
  let _ = t.frame(400.0, 200.0, now=0.0)
  let mbn = match mb_node.v { Some(x) => x; None => panic("mbn") }
  let ft = match file_trig.v { Some(x) => x; None => panic("ft") }
  let et = match edit_trig.v { Some(x) => x; None => panic("et") }

  match said_of(t, mbn.id()) {
    Some(s) => assert(s.role == view::Role::MenuBar, "Role::MenuBar")
    None => panic("missing menubar said")
  }
  assert(ft.ask_focus(visible=true), "focus File trigger")
  assert(t.key_at(6, 0, 16.0) && opt_str_is(open_menu.get(), "file"), "Down opens File menu")
  let _ = t.frame(400.0, 200.0, now=16.0)

  // Right hot-switches to Edit while open
  assert(t.key_at(4, 0, 32.0) && opt_str_is(open_menu.get(), "edit"), "Right hot-switches to Edit")
  let _ = t.frame(400.0, 200.0, now=32.0)
  assert(et.focused(), "Right focused Edit trigger")

  // Escape closes Edit and leaves focus on Edit trigger
  assert(t.key_at(17, 0, 48.0) && open_menu.get() is None, "Escape closes menu")
  assert(et.focused(), "Escape keeps focus on Edit trigger")
  t.dispose()
}

test "p1-04 TriggerMenu UTF-16 & Chinese detection, boundary check, apply_trigger, and keyboard nav" {
  let rules = [
    TriggerRule::{ trigger: "@", allow_spaces: false, start_only: false },
    TriggerRule::{ trigger: "/", allow_spaces: false, start_only: false },
    TriggerRule::{ trigger: "#", allow_spaces: false, start_only: false },
  ]

  // Email must NOT trigger @
  assert(detect_trigger("user@example.com", 16, rules) is None, "email does not trigger @")

  // Chinese preceding space + @ MUST trigger safely with UTF-16 offsets
  let cn = "你好 @张三"
  let cn_u16 = mbt_compat::utf16_len(cn)
  let prefix_u16 = mbt_compat::utf16_len("你好 ")
  match detect_trigger(cn, cn_u16, rules) {
    Some(m) => {
      assert(m.trigger == "@" && m.query == "张三" && m.start == prefix_u16 && m.end == cn_u16, "Chinese trigger match")
      let (next_text, next_cur) = apply_trigger(cn, m, "@ZhangSan")
      assert(next_text == "你好 @ZhangSan " && next_cur == mbt_compat::utf16_len(next_text), "apply_trigger replaces Chinese query")
    }
    None => panic("expected Chinese @ trigger match")
  }

  // Slash command & TriggerMenu keyboard navigation
  let tm : TriggerMenu[(String, String)] = TriggerMenu::new(rules)
  let items = [("deploy", "/deploy"), ("debug", "/debug")]
  let m = tm.update("/de", 3, items)
  assert(m is Some(_) && tm.is_open(), "slash trigger opened")
  assert(tm.move_next() is Some(_) && tm.active_index() == 1, "move_next selects second item")
  match (tm.matched(), tm.choose()) {
    (Some(tm_m), Some(chosen)) => {
      let (nt, _) = apply_trigger("/de", tm_m, chosen.1)
      assert(!tm.is_open() && nt == "/debug " && chosen.0 == "debug", "choose + apply_trigger replaces slash query")
    }
    _ => panic("expected chosen trigger item")
  }
}

test "p1-05 InputHistory push dedup/cap, prev draft preservation, next draft restore, and reset_cursor" {
  let h = InputHistory::new(max_entries=3)
  h.push("first")
  h.push("first")
  assert(h.entries().length() == 1, "consecutive duplicate skipped")
  h.push("second")
  h.push("third")
  h.push("fourth")
  assert(h.entries().length() == 3 && h.entries()[0] == "second", "max_entries cap drops oldest")

  assert(opt_str_is(h.prev("wip draft"), "fourth"), "prev 1 -> fourth")
  assert(opt_str_is(h.prev("ignored"), "third"), "prev 2 -> third")
  assert(opt_str_is(h.prev("ignored"), "second"), "prev 3 -> second")
  assert(h.prev("ignored") is None, "prev at oldest -> None")
  assert(opt_str_is(h.next(), "third"), "next -> third")
  assert(opt_str_is(h.next(), "fourth"), "next -> fourth")
  assert(opt_str_is(h.next(), "wip draft"), "next past newest restores saved draft")
  assert(!h.at_history() && h.next() is None, "back at live draft")
}

test "p1-06 InlineEdit preview/edit toggle, Enter commit, Escape cancel, and submit_on_blur" {
  let title = signals::signal("Initial")
  let cancels = view::ref_new(0)
  let ie = InlineEdit::new(
    fn() -> String { title.get() },
    fn(next : String) { title.set(next) },
    on_cancel=fn() { cancels.v = cancels.v + 1 },
    submit_on_blur=true,
  )
  let prev_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let inp_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let other_node : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    let pn = root.box(fn(v : view::View) {
      let _ = v.hides(view::Live::By(fn() { ie.editing() }))
      ie.preview(v)
    })
    prev_node.v = Some(pn)
    root.show(fn() -> Bool { ie.editing() }, fn(s : view::View) {
      let ed = s.box(fn(v : view::View) { ie.editor(v) })
      inp_node.v = Some(ed)
    }, at_once=true)
    other_node.v = Some(root.box(fn(v : view::View) {
      let _ = v.presses(view::Live::Is(true)).focusable(view::Live::Is(true))
    }))
  })
  let _ = t.frame(300.0, 200.0, now=0.0)
  let pn = match prev_node.v { Some(x) => x; None => panic("pn") }
  let other = match other_node.v { Some(x) => x; None => panic("other") }

  // Press preview -> enters edit mode & focuses input
  assert(pn.press() && ie.editing(), "press preview starts editing")
  let _ = t.frame(300.0, 200.0, now=16.0)
  let inp1 = match inp_node.v { Some(x) => x; None => panic("inp1") }
  assert(inp1.focused(), "input focused on edit start")

  // Edit draft + Escape cancels, restores draft, and returns focus to preview
  ie.set_draft("Discarded")
  assert(t.key_at(17, 0, 32.0) && !ie.editing() && cancels.v == 1 && title.get() == "Initial", "Escape cancels")
  let _ = t.frame(300.0, 200.0, now=32.0)
  let pn2 = match prev_node.v { Some(x) => x; None => panic("pn2") }
  assert(pn2.focused(), "Escape returns focus to preview")

  // Re-enter edit, modify draft, Enter commits
  ie.start()
  let _ = t.frame(300.0, 200.0, now=48.0)
  ie.set_draft("Committed")
  assert(t.key_at(7, 0, 64.0) && !ie.editing() && title.get() == "Committed", "Enter commits")
  let _ = t.frame(300.0, 200.0, now=64.0)

  // Blur commits when submit_on_blur=true WITHOUT stealing focus back from `other`
  ie.start()
  let _ = t.frame(300.0, 200.0, now=80.0)
  ie.set_draft("Via Blur")
  assert(other.ask_focus(visible=true), "focus other node to blur input")
  let _ = t.frame(300.0, 200.0, now=96.0)
  assert(!ie.editing() && title.get() == "Via Blur", "submit_on_blur commits on blur")
  assert(other.focused(), "submit_on_blur does not steal focus back to preview")
  t.dispose()
}

test "p1-07 SwipeActions axis lock slop, rubber-band damping, and snap open/close" {
  let sa = SwipeActions::new(
    left_width=80.0,
    right_width=100.0,
    slop=8.0,
    threshold=0.4,
  )
  let sa_node_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let t = make_tree(fn(root : view::View) {
    sa_node_ref.v = Some(root.box(fn(v : view::View) {
      let _ = v.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(60.0)))
      sa.bind(v)
    }))
  })
  let _ = t.frame(300.0, 100.0, now=0.0)
  let sn = match sa_node_ref.v { Some(x) => x; None => panic("sn") }

  // Vertical gesture locks to vertical -> offset remains 0
  let _ = t.drag_at(sn.id(), view::DragIs::Down, 150.0, 30.0, 10.0)
  let _ = t.drag_at(sn.id(), view::DragIs::Moved, 152.0, 50.0, 26.0)
  let _ = t.drag_at(sn.id(), view::DragIs::Moved, 220.0, 50.0, 42.0)
  assert(!sa.dragging() && sa.offset() == 0.0, "vertical lock ignores horizontal motion")
  let _ = t.drag_at(sn.id(), view::DragIs::Up, 220.0, 50.0, 58.0)

  // Horizontal drag right past left_width (80) applies rubber-band damping
  let _ = t.drag_at(sn.id(), view::DragIs::Down, 50.0, 30.0, 100.0)
  let _ = t.drag_at(sn.id(), view::DragIs::Moved, 170.0, 30.0, 200.0)
  assert(sa.dragging() && sa.offset() > 80.0 && sa.offset() < 120.0, "rubber-band damped offset > 80 and < 120")
  let _ = t.drag_at(sn.id(), view::DragIs::Up, 170.0, 30.0, 260.0)
  assert(!sa.dragging() && sa.open_side() == Some(SwipeSide::Left) && sa.offset() == 80.0, "snapped open to Left")

  sa.close()
  assert(sa.open_side() is None && sa.offset() == 0.0, "programmatic close resets offset")
  t.dispose()
}

test "p1-08 NumberInput stepping, commit_text clamping, and repeat_hold buttons across time" {
  let num_sig = signals::signal(10.0)
  let ni = NumberInput::new(
    fn() -> Double { num_sig.get() },
    fn(next : Double) { num_sig.set(next) },
    min=0.0,
    max=25.0,
    step=0.5,
    large_step=5.0,
    precision=1,
  )
  let inp_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let inc_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    inp_ref.v = Some(root.box(fn(n : view::View) {
      let _ = n.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(30.0)))
      ni.field(n, fn() -> String { "Quantity" })
    }))
    inc_ref.v = Some(ni.increment_button(
      root,
      fn() -> String { "Increase" },
      fn(n : view::View, _b : Button) {
        let _ = n.width(view::Live::Is(Some(30.0))).height(view::Live::Is(Some(30.0)))
      },
      delay_ms=200.0,
      interval_ms=50.0,
    ))
    let _ = ni.decrement_button(
      root,
      fn() -> String { "Decrease" },
      fn(n : view::View, _b : Button) {
        let _ = n.width(view::Live::Is(Some(30.0))).height(view::Live::Is(Some(30.0)))
      },
    )
  })
  let _ = t.frame(300.0, 100.0, now=0.0)
  let inp = match inp_ref.v { Some(x) => x; None => panic("inp") }
  let inc_btn = match inc_ref.v { Some(x) => x; None => panic("inc") }

  assert(ni.formatted() == "10.0", "precision 1 formatting")
  assert(ni.commit_text(" 12.34 ") && (num_sig.get() - 12.3).abs() < 0.001, "commit_text parses & rounds")
  assert(ni.commit_text("999") && num_sig.get() == 25.0, "commit_text clamps to max")
  assert(!ni.commit_text("abc"), "invalid text returns false")
  num_sig.set(10.0)
  let _ = t.frame(300.0, 100.0, now=10.0)

  // Keyboard Up (+0.5), PageUp (+5.0), Home (0.0)
  assert(inp.ask_focus(visible=true), "focus input")
  assert(t.key_at(5, 0, 20.0) && (num_sig.get() - 10.5).abs() < 0.001, "Up adds step")
  assert(t.key_at(15, 0, 30.0) && (num_sig.get() - 15.5).abs() < 0.001, "PageUp adds large_step")
  assert(t.key_at(8, 0, 40.0) && num_sig.get() == 0.0, "Home sets min")

  // Hold increment_button: fires repeat_hold after 200ms + every 50ms, and release press does NOT double-step
  let _ = t.frame(300.0, 100.0, now=100.0)
  t.hold_press(inc_btn.id())
  let _ = t.frame(300.0, 100.0, now=100.0)
  let _ = t.frame(300.0, 100.0, now=350.0) // 100+200=300 (fire 1 -> 0.5), 350 (fire 2 -> 1.0)
  assert((num_sig.get() - 1.0).abs() < 0.001, "repeat_hold fired exactly twice -> 1.0")
  let _ = t.press_held(inc_btn.id())
  let _ = inc_btn.press() // release-triggered on_press must be swallowed after repeat_hold
  assert((num_sig.get() - 1.0).abs() < 0.001, "release after repeat_hold does not extra-increment")
  // Subsequent normal click increments once -> 1.5
  let _ = inc_btn.press()
  assert((num_sig.get() - 1.5).abs() < 0.001, "normal click after hold increments once")
  t.dispose()
}

test "p1-09 RangeSlider dual Role::Slider thumbs, min_gap anti-crossing, and RTL keyboard" {
  let lo_sig = signals::signal(20.0)
  let hi_sig = signals::signal(60.0)
  let lo_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let hi_node : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    let _ = range_slider(
      root,
      fn() -> String { "Price" },
      fn() -> (Double, Double) { (lo_sig.get(), hi_sig.get()) },
      min=0.0,
      max=100.0,
      step=10.0,
      fn(a : Double, b : Double) {
        lo_sig.set(a)
        hi_sig.set(b)
      },
      fn(v : view::View, rs : RangeSlider) {
        let _ = v.width(view::Live::Is(Some(200.0))).height(view::Live::Is(Some(30.0)))
        lo_node.v = Some(rs.thumb(v, RangeThumb::Low, fn() -> String { "Min Price" }, fn(_n : view::View, _s : RangeThumbState) { () }))
        hi_node.v = Some(rs.thumb(v, RangeThumb::High, fn() -> String { "Max Price" }, fn(_n : view::View, _s : RangeThumbState) { () }))
      },
      min_gap=20.0,
      rtl=true,
    )
  })
  let _ = t.frame(300.0, 100.0, now=0.0)
  let ln = match lo_node.v { Some(x) => x; None => panic("ln") }
  let hn = match hi_node.v { Some(x) => x; None => panic("hn") }

  match (said_of(t, ln.id()), said_of(t, hn.id())) {
    (Some(s1), Some(s2)) => assert(s1.role == view::Role::Slider && s2.role == view::Role::Slider, "both thumbs Role::Slider")
    _ => panic("missing thumb said")
  }

  // RTL: Left (3) increments Low; End (9) clamps to high - min_gap = 40
  assert(ln.ask_focus(visible=true), "focus Low thumb")
  assert(t.key_at(3, 0, 16.0) && lo_sig.get() == 30.0, "RTL Left increments Low thumb")
  assert(t.key_at(9, 0, 32.0) && lo_sig.get() == 40.0, "Low thumb clamped to high - min_gap = 40")

  // High thumb Home (8) clamps to low + min_gap = 60
  assert(hn.ask_focus(visible=true), "focus High thumb")
  assert(t.key_at(8, 0, 48.0) && hi_sig.get() == 60.0, "High thumb cannot cross below low + min_gap")
  t.dispose()
}

test "p1-10 Drawer overlay stack, snap_points, velocity dismiss, can_drag guard, and zero-draw check" {
  let open = signals::signal(true)
  let snap_idx = signals::signal(1)
  let allow_drag = signals::signal(false)
  let dr_ref : signals::Ref[Option[Drawer]] = view::ref_new(None)
  let dr_node : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = make_tree(fn(root : view::View) {
    dr_node.v = Some(drawer(
      root,
      fn() -> String { "Details Sheet" },
      fn() -> Bool { open.get() },
      fn() { open.set(false) },
      fn(v : view::View, d : Drawer) {
        dr_ref.v = Some(d)
        let _ = v.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(300.0)))
        d.handle(v)
      },
      edge=DrawerEdge::Bottom,
      snap_points=[0.5, 1.0],
      active_snap=fn() -> Int { snap_idx.get() },
      on_snap=fn(i : Int) { snap_idx.set(i) },
      dismiss_threshold=0.25,
      velocity_threshold=500.0,
      can_drag=fn() -> Bool { allow_drag.get() },
    ))
  })
  let _ = t.frame(300.0, 300.0, now=0.0)
  let dr = match dr_ref.v { Some(x) => x; None => panic("dr") }
  let dn = match dr_node.v { Some(x) => x; None => panic("dn") }
  assert(overlays_open(t) == 1, "Drawer joined unified overlay stack")

  // Zero-draw invariant: headless drawer draws no painted ground or words of its own.
  for d in t.drawn() {
    assert(d.ground == 0.to_int64() && d.words == "", "headless drawer draws nothing")
  }

  // can_drag = false blocks drag
  let _ = t.drag_at(dn.id(), view::DragIs::Down, 150.0, 50.0, 10.0)
  let _ = t.drag_at(dn.id(), view::DragIs::Moved, 150.0, 200.0, 60.0)
  assert(!dr.dragging() && dr.drag_offset() == 0.0, "can_drag=false guards scroll handoff")
  let _ = t.drag_at(dn.id(), view::DragIs::Up, 150.0, 200.0, 80.0)

  // can_drag = true: slow drag down by 150px (0.5 of 300px) snaps from 1.0 -> 0.5 (index 0)
  allow_drag.set(true)
  let _ = t.drag_at(dn.id(), view::DragIs::Down, 150.0, 50.0, 100.0)
  let _ = t.drag_at(dn.id(), view::DragIs::Moved, 150.0, 200.0, 600.0)
  assert(dr.dragging() && (dr.drag_offset() - 150.0).abs() < 0.01, "drag_offset tracks downward drag")
  let _ = t.drag_at(dn.id(), view::DragIs::Up, 150.0, 200.0, 700.0)
  assert(open.get() && snap_idx.get() == 0, "slow drag snapped to 0.5 snap point")

  // Fast downward fling closes drawer by velocity threshold
  let _ = t.drag_at(dn.id(), view::DragIs::Down, 150.0, 100.0, 800.0)
  let _ = t.drag_at(dn.id(), view::DragIs::Moved, 150.0, 130.0, 816.0)
  let _ = t.drag_at(dn.id(), view::DragIs::Moved, 150.0, 170.0, 832.0)
  let _ = t.drag_at(dn.id(), view::DragIs::Up, 150.0, 170.0, 836.0)
  assert(!open.get(), "fast downward fling closed drawer")
  let _ = t.frame(300.0, 300.0, now=850.0)
  assert(overlays_open(t) == 0, "overlay stack empty after drawer close")
  t.dispose()
}
