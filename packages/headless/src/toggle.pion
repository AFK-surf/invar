// The toggle: Checkbox, Switch, or toggle Button.
// Ported 1:1 from libs/mbui/src/headless/toggle.mbt.

import "view"

/// What a toggle is to a screen reader: a checkbox, a switch, or a toggle button.
#derive(Eq)
pub enum ToggleKind {
  Checkbox
  Switch
  Button
}

/// A toggle as its look reads it.
pub struct Toggle {
  node : view::View
  now : () -> Bool
  some : () -> Bool
  off : () -> Bool
}

pub fn Toggle::on(self : Toggle) -> Bool {
  (self.now)()
}

pub fn Toggle::mixed(self : Toggle) -> Bool {
  (self.some)()
}

pub fn Toggle::disabled(self : Toggle) -> Bool {
  (self.off)()
}

pub fn Toggle::pressed(self : Toggle) -> Bool {
  self.node.pressed()
}

pub fn Toggle::hovered(self : Toggle) -> Bool {
  self.node.pointed()
}

pub fn Toggle::focus_shown(self : Toggle) -> Bool {
  self.node.focus_shown()
}

pub fn Toggle::press(self : Toggle) -> Unit {
  let _ = self.node.press()
}

/// A toggle of `kind` in `parent`, called `label`, on or off as `on` says.
pub fn toggle(
  parent : view::View,
  kind : ToggleKind,
  label : () -> String,
  on : () -> Bool,
  turn : (Bool) -> Unit,
  look : (view::View, Toggle) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  mixed~ : () -> Bool = fn() { false },
  hold? : Hold,
  hold_press? : (Double, Double),
  focusable~ : Bool = true,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    let some = fn() -> Bool { kind == ToggleKind::Checkbox && mixed() }
    look(v, Toggle::{ node: v, now: on, some, off: disabled })
    match hold {
      Some(h) => attach_hold(v, h)
      None =>
        match hold_press {
          Some((slop, ms)) => {
            let on_it = fn(d : view::Drag) -> Bool { v.finger_target(d.wx, d.wy) }
            let _ = v.gesture(
              slop,
              tap=fn(d : view::Drag) { if on_it(d) { let _ = v.press() } },
              hold=(ms, fn(_d : view::Drag) { () }),
              drag=fn(d : view::Drag) { if d.kind == view::DragIs::Up && on_it(d) { let _ = v.press() } },
            )
          }
          None => ()
        }
    }
    let keys = match kind {
      Checkbox => view::focus_space
      Switch | Button => view::focus_enter | view::focus_space
    }
    let _ = v
      .presses(view::Live::By(able))
      .says(view::Live::By(fn() -> Option[view::Said] {
        let now = on()
        Some(
          match kind {
            Checkbox => {
              let chk = if some() { view::Check::Mixed } else if now { view::Check::On } else { view::Check::Off }
              view::said(view::Role::Checkbox, label=label(), check=chk)
            }
            Switch => {
              let chk = if now { view::Check::On } else { view::Check::Off }
              view::said(view::Role::Switch, label=label(), check=chk)
            }
            Button => view::said(view::Role::Button, label=label(), pressed=now)
          },
        )
      }))
      .on_press(fn() {
        if !disabled() {
          turn(some() || !on())
        }
      })
    if focusable {
      let _ = v.focusable(view::Live::By(able), keys=keys)
    }
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
