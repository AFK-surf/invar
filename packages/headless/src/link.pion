// The link: an interactive navigation element (`Role::Link`), activated by pointer press or Enter key.

import "view"

/// A link as its look reads it.
pub struct Link {
  node : view::View
  off : () -> Bool
  href_ : () -> String
}

pub fn Link::node(self : Link) -> view::View {
  self.node
}

pub fn Link::disabled(self : Link) -> Bool {
  (self.off)()
}

pub fn Link::href(self : Link) -> String {
  (self.href_)()
}

pub fn Link::pressed(self : Link) -> Bool {
  self.node.pressed()
}

pub fn Link::hovered(self : Link) -> Bool {
  self.node.pointed()
}

pub fn Link::focused(self : Link) -> Bool {
  self.node.focused()
}

pub fn Link::focus_shown(self : Link) -> Bool {
  self.node.focus_shown()
}

pub fn Link::press(self : Link) -> Unit {
  if !(self.off)() {
    let _ = self.node.press()
  }
}

/// A headless link in `parent` (`Role::Link`): mouse click & keyboard Enter activate;
/// Space does NOT activate (per ARIA Link pattern); disabled blocks focus and activation.
pub fn link(
  parent : view::View,
  label : () -> String,
  on_press : (view::View) -> Unit,
  look : (view::View, Link) -> Unit,
  href~ : () -> String = fn() { "" },
  disabled~ : () -> Bool = fn() { false },
  focusable~ : Bool = true,
  current~ : () -> Option[String] = fn() { None },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    look(v, Link::{ node: v, off: disabled, href_: href })
    let _ = v
      .presses(view::Live::By(able))
      .says(view::Live::By(fn() -> Option[view::Said] {
        let h = href()
        Some(view::said(
          view::Role::Link,
          label=label(),
          description=h,
          current=current(),
          actions=if disabled() { [] } else { [view::Action::Activate] },
        ))
      }))
      .on_press(fn() {
        if !disabled() {
          on_press(v)
        }
      })
      .on_key(fn(k : view::Key) -> Bool {
        if !disabled() && v.focused() && k.mods == 0 && k.code == combo_key_enter {
          on_press(v)
          true
        } else {
          false
        }
      })
    if focusable {
      // ARIA Link: Enter activates, Space does not.
      let _ = v.focusable(view::Live::By(able), keys=view::focus_enter)
    }
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
