// Chat / command-line input history navigation with draft preservation and cap/dedup.
// Delegated to `headless_core::InputHistory`.

import "headless_core"

/// History navigation controller for chat composers and command prompts.
pub struct InputHistory {
  core : headless_core::InputHistory
}

/// Create a new `InputHistory` keeping up to `max_entries` items.
pub fn InputHistory::new(
  max_entries~ : Int = 100,
  dedup_consecutive~ : Bool = true,
) -> InputHistory {
  InputHistory::{
    core: headless_core::InputHistory::new(
      max_entries=max_entries,
      dedup_consecutive=dedup_consecutive,
    ),
  }
}

/// Push a submitted entry, deduplicating consecutive identical entries and trimming to `max_entries`.
pub fn InputHistory::push(self : InputHistory, entry : String) -> Unit {
  self.core.push(entry)
}

/// Navigate backward to an older entry, saving `draft` when entering history from the live composer.
pub fn InputHistory::prev(self : InputHistory, draft : String) -> Option[String] {
  self.core.prev(draft)
}

/// Navigate forward to a newer entry, restoring the saved draft when stepping past the newest entry.
pub fn InputHistory::next(self : InputHistory) -> Option[String] {
  self.core.next()
}

/// Exit history browsing mode and clear the saved draft.
pub fn InputHistory::reset_cursor(self : InputHistory) -> Unit {
  self.core.reset_cursor()
}

/// Whether the cursor is currently browsing historical entries.
pub fn InputHistory::is_browsing(self : InputHistory) -> Bool {
  self.core.is_browsing()
}

/// Current history index (`None` when on the live draft).
pub fn InputHistory::cursor(self : InputHistory) -> Option[Int] {
  self.core.cursor()
}

/// Copy of all stored history entries, oldest first.
pub fn InputHistory::entries(self : InputHistory) -> Array[String] {
  self.core.entries()
}

/// Number of stored history entries.
pub fn InputHistory::len(self : InputHistory) -> Int {
  self.core.len()
}

/// Remove all history entries and reset cursor.
pub fn InputHistory::clear(self : InputHistory) -> Unit {
  self.core.clear()
}
