// The text field's parts as a form has them: label, description, error, and control.
// Ported 1:1 from libs/mbui/src/headless/text_field.mbt.

import "signals"
import "view"

/// A form's text field: its label, description, error and states, and its control once made.
pub struct TextField {
  label_ : () -> String
  description_ : () -> String
  error_ : () -> String
  invalid_ : () -> Bool
  required_ : () -> Bool
  disabled_ : () -> Bool
  read_only_ : () -> Bool
  control_ : signals::Signal[Option[view::View]]
}

pub fn TextField::new(
  label : () -> String,
  description~ : () -> String = fn() { "" },
  error~ : () -> String = fn() { "" },
  invalid~ : () -> Bool = fn() { false },
  required~ : () -> Bool = fn() { false },
  disabled~ : () -> Bool = fn() { false },
  read_only~ : () -> Bool = fn() { false },
) -> TextField {
  TextField::{
    label_: label,
    description_: description,
    error_: error,
    invalid_: invalid,
    required_: required,
    disabled_: disabled,
    read_only_: read_only,
    control_: signals::signal_by(None, same_node),
  }
}

pub fn TextField::label_text(self : TextField) -> String {
  (self.label_)()
}

pub fn TextField::description_text(self : TextField) -> String {
  (self.description_)()
}

pub fn TextField::error_text(self : TextField) -> String {
  if (self.invalid_)() {
    (self.error_)()
  } else {
    ""
  }
}

pub fn TextField::said_description(self : TextField) -> String {
  let e = self.error_text()
  if e == "" {
    self.description_text()
  } else {
    e
  }
}

pub fn TextField::invalid(self : TextField) -> Bool {
  (self.invalid_)()
}

pub fn TextField::required(self : TextField) -> Bool {
  (self.required_)()
}

pub fn TextField::disabled(self : TextField) -> Bool {
  (self.disabled_)()
}

pub fn TextField::read_only(self : TextField) -> Bool {
  (self.read_only_)()
}

pub fn TextField::focused(self : TextField) -> Bool {
  match self.control_.get() {
    Some(c) => c.focused()
    None => false
  }
}

pub fn TextField::focus(self : TextField) -> Bool {
  if signals::untracked(self.disabled_) {
    return false
  }
  match self.control_.untracked() {
    Some(c) => if c.alive() { c.ask_focus(visible=true) } else { false }
    None => false
  }
}

pub fn TextField::control_node(self : TextField, node : view::View) -> Unit {
  self.control_.set(Some(node))
  let _ = node.owns(fn() {
    if same_node(self.control_.untracked(), Some(node)) {
      self.control_.set(None)
    }
  })
}

pub fn TextField::control(
  self : TextField,
  parent : view::View,
  look : (view::View, TextField) -> Unit,
  value~ : () -> String = fn() { "" },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    self.control_node(v)
    look(v, self)
    let able = fn() -> Bool { !(self.disabled_)() }
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=0)
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::TextField, label=self.label_text(), description=self.said_description(), value=value()))
      }))
      .on_press(fn() { if able() { let _ = v.ask_focus() } })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

pub fn TextField::label(
  self : TextField,
  parent : view::View,
  look : (view::View) -> Unit,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    look(v)
    let able = fn() -> Bool { !(self.disabled_)() && self.control_.get() is Some(_) }
    let _ = v
      .presses(view::Live::By(able))
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Text, label=self.label_text())) }))
      .on_press(fn() { let _ = self.focus() })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}

pub fn TextField::description(
  self : TextField,
  parent : view::View,
  look : (view::View) -> Unit,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    look(v)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Text, label=self.description_text())) }))
      .hides(view::Live::By(fn() -> Bool { self.description_text() == "" }))
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}

pub fn TextField::error(
  self : TextField,
  parent : view::View,
  look : (view::View) -> Unit,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    look(v)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Status, label=self.error_text())) }))
      .hides(view::Live::By(fn() -> Bool { self.error_text() == "" }))
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
