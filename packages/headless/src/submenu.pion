// The submenu: an item of a menu (`Menu::sub_trigger`) that opens a submenu (`Submenu::menu`).
// Ported 1:1 from libs/mbui/src/headless/submenu.mbt.

import "headless_core"
import "signals"
import "view"

/// A submenu's trigger and menu.
pub struct Submenu {
  now : () -> Bool
  set : (Bool) -> Unit
  open_delay_ms : Double
  close_delay_ms : Double
  corridor_ms : Double
  waiting : view::Ref[() -> Unit]
  opener : signals::Signal[Option[view::View]]
  shown : signals::Signal[Option[view::View]]
  inner : view::Ref[Option[Menu]]
  enter : view::Ref[Bool]
  leave_pt : view::Ref[Option[(Double, Double)]]
}

pub fn Submenu::new(
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  open_delay_ms~ : Double = 180.0,
  close_delay_ms~ : Double = 150.0,
  corridor_ms~ : Double = 300.0,
) -> Submenu {
  Submenu::{
    now: open,
    set: set_open,
    open_delay_ms,
    close_delay_ms,
    corridor_ms,
    waiting: view::ref_new(fn() { () }),
    opener: signals::signal_by(None, same_node),
    shown: signals::signal_by(None, same_node),
    inner: view::ref_new(None),
    enter: view::ref_new(false),
    leave_pt: view::ref_new(None),
  }
}

pub fn Submenu::open(self : Submenu) -> Bool {
  (self.now)()
}

pub fn Submenu::close(self : Submenu) -> Unit {
  self.leave_pt.v = None
  self.now_to(false)
}

/// Open the submenu immediately for a touch interaction (no keyboard auto-focus).
pub fn Submenu::open_touch(self : Submenu) -> Unit {
  self.leave_pt.v = None
  self.open_now(false)
}

/// Whether the pointer currently lies inside the aiming corridor from the trigger leave point
/// toward the open submenu panel.
pub fn Submenu::in_corridor(self : Submenu) -> Bool {
  if !signals::untracked(self.now) {
    return false
  }
  let (lx, ly) = match self.leave_pt.v {
    Some(pt) => pt
    None => return false
  }
  let m = match self.shown.untracked() {
    Some(n) => if n.alive() { n } else { return false }
    None => return false
  }
  let (px, py) = match view_root(m).pointer_here() {
    Some(pt) => pt
    None => return false
  }
  let (mx, my, mw, mh) = m.placed_window_now()
  headless_core::submenu_in_aim_corridor(px, py, lx, ly, mx, my, mw, mh)
}

fn Submenu::call_off(self : Submenu) -> Unit {
  (self.waiting.v)()
  self.waiting.v = fn() { () }
}

fn Submenu::now_to(self : Submenu, on : Bool) -> Unit {
  self.call_off()
  if !on {
    self.enter.v = false
  }
  if signals::untracked(self.now) != on {
    (self.set)(on)
  }
}

fn Submenu::later_to(self : Submenu, node : view::View, on : Bool, ms : Double) -> Unit {
  self.call_off()
  if signals::untracked(self.now) == on {
    return
  }
  self.waiting.v = node.at_moment(node.cause_at() + ms, fn() {
    self.waiting.v = fn() { () }
    if signals::untracked(self.now) != on {
      (self.set)(on)
    }
  })
}

fn Submenu::open_now(self : Submenu, keys : Bool) -> Unit {
  self.now_to(true)
  if !keys {
    return
  }
  match self.inner.v {
    Some(m) => {
      if m.node.alive() {
        self.enter.v = false
        let _ = m.focus_first()
      } else {
        self.enter.v = true
      }
    }
    None => self.enter.v = true
  }
}

fn Submenu::hovered(self : Submenu) -> Bool {
  let on = fn(v : Option[view::View]) -> Bool {
    match v {
      Some(n) => n.pointed_in()
      None => false
    }
  }
  on(self.opener.get()) || on(self.shown.get())
}

fn Submenu::focus_inside(self : Submenu) -> Bool {
  match self.shown.untracked() {
    Some(n) => view_holds_focused(n)
    None => false
  }
}

/// An item of `self` in `parent` that opens `sub`.
pub fn Menu::sub_trigger(
  self : Menu,
  parent : view::View,
  sub : Submenu,
  label : () -> String,
  look : (view::View, MenuItem) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  open_key~ : Int = group_key_right,
  rtl~ : Bool = false,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let eff_open_key = if rtl && open_key == group_key_right {
    group_key_left
  } else if rtl && open_key == group_key_left {
    group_key_right
  } else {
    open_key
  }
  let off = fn() -> Bool { (self.off)() || disabled() }
  let node = self.part(
    parent,
    view::Role::MenuItem,
    label,
    None,
    Some(sub.now),
    fn(v : view::View) { sub.open_now(v.focus_shown()) },
    look,
    disabled,
    in_node,
    made_for,
    loc,
  )
  sub.opener.set(Some(node))
  let last_on_trigger : view::Ref[Option[(Double, Double)]] = view::ref_new(None)
  let _ = node.on_pointer_moved(fn() {
    last_on_trigger.v = view_root(node).pointer_here()
  })
  let _ = node.on_key(fn(k : view::Key) -> Bool {
    if k.mods == 0 && k.code == eff_open_key && !off() && node.focused() {
      sub.open_now(true)
      true
    } else {
      false
    }
  })
  node.reacts(fn() -> Bool { sub.hovered() }, fn(over : Bool) {
    if over {
      sub.leave_pt.v = None
      if node.pointed_in() {
        last_on_trigger.v = view_root(node).pointer_here()
      }
      if !off() {
        sub.later_to(node, true, sub.open_delay_ms)
      }
    } else if !sub.focus_inside() {
      sub.leave_pt.v = match last_on_trigger.v {
        Some(pt) => Some(pt)
        None => {
          let (tx, ty, tw, th) = node.placed_window_now()
          if tw > 0.0 && th > 0.0 {
            Some((tx + tw * 0.5, ty + th * 0.5))
          } else {
            view_root(node).pointer_here()
          }
        }
      }
      let delay = if sub.in_corridor() { sub.corridor_ms } else { sub.close_delay_ms }
      sub.later_to(node, false, delay)
    }
  }, at_start=false)
  node.reacts(fn() -> Bool { node.focused() }, fn(on : Bool) {
    if !on && !sub.focus_inside() && !signals::untracked(fn() -> Bool { sub.hovered() }) && signals::untracked(sub.now) {
      sub.now_to(false)
    }
  }, at_start=false)
  node.reacts(off, fn(o : Bool) { if o { sub.now_to(false) } }, at_start=false)
  let _ = node.owns(fn() {
    sub.call_off()
    if same_node(sub.opener.untracked(), Some(node)) {
      sub.opener.set(None)
    }
  })
  node
}

/// Its menu in `parent`.
pub fn Submenu::menu(
  self : Submenu,
  parent : view::View,
  look : (view::View, Menu) -> Unit,
  label? : () -> String,
  close_key~ : Int = group_key_left,
  rtl~ : Bool = false,
  wraps~ : Bool = true,
  typeahead~ : Bool = true,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let eff_close_key = if rtl && close_key == group_key_left {
    group_key_right
  } else if rtl && close_key == group_key_right {
    group_key_left
  } else {
    close_key
  }
  let v = menu(
    parent,
    fn(v : view::View, m : Menu) {
      self.inner.v = Some(m)
      self.shown.set(Some(v))
      let _ = v.owns(fn() {
        if same_node(self.shown.untracked(), Some(v)) {
          self.shown.set(None)
          self.inner.v = None
        }
      })
      look(v, m)
    },
    label?=label,
    on_close=fn() {
      self.now_to(false)
      match self.opener.untracked() {
        Some(o) => { let _ = o.ask_focus(visible=true) }
        None => ()
      }
    },
    close_key=eff_close_key,
    wraps=wraps,
    typeahead=typeahead,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
  if self.enter.v {
    let _ = v.at_moment(v.cause_at(), fn() {
      if self.enter.v {
        self.enter.v = false
        match self.inner.v {
          Some(m) => { let _ = m.focus_first() }
          None => ()
        }
      }
    })
  }
  v
}
