// Tests for headless `TableRow::sort_header` and `TableSortDir` reactive ColumnHeader semantics.

import "signals"
import "view"

fn sort_table_make_tree(make : (view::View) -> Unit) -> view::Tree {
  let t = view::Tree::new(
    make,
    measure=view::words_measure,
    measure_runs=view::runs_measure,
    measure_runs_least=view::runs_least_measure,
  )
  let _ = t.frame(300.0, 200.0, now=0.0)
  t
}

fn sort_table_has_header(tree : view::Tree, expected_label : String) -> Bool {
  for sn in tree.said_order() {
    match sn.said {
      Some(s) if s.role == view::Role::ColumnHeader && s.label == expected_label => return true
      _ => ()
    }
  }
  false
}

test "a sortable column header reflects sort direction reactively in ColumnHeader semantics" {
  let dir : signals::Signal[Option[TableSortDir]] = signals::signal_by(
    None,
    same=fn(a : Option[TableSortDir], b : Option[TableSortDir]) -> Bool {
      match (a, b) {
        (None, None) => true
        (Some(TableSortDir::Asc), Some(TableSortDir::Asc)) => true
        (Some(TableSortDir::Desc), Some(TableSortDir::Desc)) => true
        _ => false
      }
    },
  )
  let price_dir : signals::Signal[Option[TableSortDir]] = signals::signal_by(
    None,
    same=fn(a : Option[TableSortDir], b : Option[TableSortDir]) -> Bool {
      match (a, b) {
        (None, None) => true
        (Some(TableSortDir::Asc), Some(TableSortDir::Asc)) => true
        (Some(TableSortDir::Desc), Some(TableSortDir::Desc)) => true
        _ => false
      }
    },
  )
  let t = sort_table_make_tree(fn(root : view::View) {
    let _ = table(root, fn(v : view::View, tb : Table) {
      let _ = v.width(view::Live::Is(Some(160.0)))
      let _ = tb.row(v, fn(line : view::View, tr : TableRow) {
        let _ = line.row(view::Live::Is(true))
        let _ = tr.sort_header(
          line,
          fn() { "Name" },
          fn() { dir.get() },
          fn(c : view::View) {
            let _ = c.width(view::Live::Is(Some(80.0)))
            let _ = c.box(fn(w : view::View) {
              let _ = w.words(view::Live::Is("Name"))
            })
          },
        )
        let _ = tr.sort_header(
          line,
          fn() { "Price" },
          fn() { price_dir.get() },
          fn(c : view::View) {
            let _ = c.width(view::Live::Is(Some(80.0)))
            let _ = c.box(fn(w : view::View) {
              let _ = w.words(view::Live::Is("Price"))
            })
          },
          sort_label=fn(d : TableSortDir) -> String {
            match d {
              TableSortDir::Asc => "low to high"
              TableSortDir::Desc => "high to low"
            }
          },
        )
      })
    })
  })

  debug_assert(sort_table_has_header(t, "Name"), "unsorted Name header has plain label")
  debug_assert(sort_table_has_header(t, "Price"), "unsorted Price header has plain label")

  dir.set(Some(TableSortDir::Asc))
  let _ = t.frame(300.0, 200.0, now=16.0)
  debug_assert(sort_table_has_header(t, "Name, ascending"), "Name header updates to ascending")

  dir.set(Some(TableSortDir::Desc))
  let _ = t.frame(300.0, 200.0, now=32.0)
  debug_assert(sort_table_has_header(t, "Name, descending"), "Name header updates to descending")

  price_dir.set(Some(TableSortDir::Asc))
  let _ = t.frame(300.0, 200.0, now=48.0)
  debug_assert(sort_table_has_header(t, "Price, low to high"), "custom sort_label Asc reflected")

  price_dir.set(Some(TableSortDir::Desc))
  let _ = t.frame(300.0, 200.0, now=64.0)
  debug_assert(sort_table_has_header(t, "Price, high to low"), "custom sort_label Desc reflected")

  dir.set(None)
  let _ = t.frame(300.0, 200.0, now=80.0)
  debug_assert(sort_table_has_header(t, "Name"), "clearing sort restores plain Name label")
  t.dispose()
}
