// Headless Pagination: page ellipsis via `headless_core::pagination_items`,
// horizontal roving focus, `Role::Navigation`, and `current=Some("page")` on the active page.

import "headless_core"
import "view"

/// Pagination controller passed to its look to build page/prev/next buttons.
pub struct Pagination {
  node : view::View
  total_ : () -> Int
  current_ : () -> Int
  on_change : (Int) -> Unit
  siblings : Int
  boundaries : Int
  off : () -> Bool
  roving : RovingFocus
}

pub fn Pagination::node(self : Pagination) -> view::View {
  self.node
}

pub fn Pagination::total(self : Pagination) -> Int {
  (self.total_)()
}

pub fn Pagination::current(self : Pagination) -> Int {
  (self.current_)()
}

pub fn Pagination::can_prev(self : Pagination) -> Bool {
  !(self.off)() && (self.current_)() > 1
}

pub fn Pagination::can_next(self : Pagination) -> Bool {
  !(self.off)() && (self.current_)() < (self.total_)()
}

pub fn Pagination::tokens(self : Pagination) -> Array[headless_core::PageToken] {
  headless_core::pagination_items((self.total_)(), (self.current_)(), siblings=self.siblings, boundaries=self.boundaries)
}

pub fn Pagination::go_to(self : Pagination, page : Int) -> Unit {
  if (self.off)() {
    return
  }
  let t = (self.total_)()
  if t <= 0 {
    return
  }
  let p = if page < 1 { 1 } else if page > t { t } else { page }
  if p != (self.current_)() {
    (self.on_change)(p)
  }
}

pub fn Pagination::prev(self : Pagination) -> Unit {
  self.go_to((self.current_)() - 1)
}

pub fn Pagination::next(self : Pagination) -> Unit {
  self.go_to((self.current_)() + 1)
}

/// Mount a headless `Pagination` container (`Role::Navigation`) in `parent`.
pub fn pagination(
  parent : view::View,
  total : () -> Int,
  current : () -> Int,
  on_change : (Int) -> Unit,
  look : (view::View, Pagination) -> Unit,
  label~ : () -> String = fn() { "Pagination" },
  siblings~ : Int = 1,
  boundaries~ : Int = 1,
  disabled~ : () -> Bool = fn() { false },
  rtl~ : Bool = false,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let pg = Pagination::{
      node: v,
      total_: total,
      current_: current,
      on_change,
      siblings,
      boundaries,
      off: disabled,
      roving: RovingFocus::new(axis=GroupAxis::Horizontal, roving=true, wraps=false, rtl=rtl),
    }
    look(v, pg)
    let _ = v
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Navigation, label=label()))
    }))
    .on_key(fn(k : view::Key) -> Bool {
      if disabled() || k.mods != 0 || !focus_in(v, false) {
        return false
      }
      pg.roving.step(k.code) is Some(_)
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount a numbered page button (`Role::Button`, `current=Some("page")` when active).
pub fn Pagination::page_button(
  self : Pagination,
  parent : view::View,
  page : Int,
  look : (view::View, () -> Bool) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let active = fn() -> Bool { (self.current_)() == page }
    let able = fn() -> Bool { !(self.off)() }
    look(v, active)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
    .says(view::Live::By(fn() -> Option[view::Said] {
      let cur = if active() { Some("page") } else { None }
      Some(view::said(view::Role::Button, label="Page \{page}", current=cur))
    }))
    .on_press(fn() { self.go_to(page) })
    self.roving.add(v, off=self.off, first=active)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount a previous-page button (`Role::Button`, disabled on page 1).
pub fn Pagination::prev_button(
  self : Pagination,
  parent : view::View,
  look : (view::View, Button) -> Unit,
  label~ : () -> String = fn() { "Previous page" },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off = fn() -> Bool { !self.can_prev() }
  let v = button(parent, label, fn(_n : view::View) { self.prev() }, look, disabled=off, in_node=in_node, made_for=resolve_made_for(made_for, loc), loc=loc)
  self.roving.add(v, off=off)
  v
}

/// Mount a next-page button (`Role::Button`, disabled on last page).
pub fn Pagination::next_button(
  self : Pagination,
  parent : view::View,
  look : (view::View, Button) -> Unit,
  label~ : () -> String = fn() { "Next page" },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off = fn() -> Bool { !self.can_next() }
  let v = button(parent, label, fn(_n : view::View) { self.next() }, look, disabled=off, in_node=in_node, made_for=resolve_made_for(made_for, loc), loc=loc)
  self.roving.add(v, off=off)
  v
}
