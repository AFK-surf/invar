// Headless Meter: `Role::Meter`, clamped range normalization `[0.0, 1.0]`, and semantic value text.

import "dmath"
import "view"

/// Headless meter handle passed to its look.
pub struct Meter {
  node : view::View
  min : Double
  max : Double
  val_ : () -> Double
  text_ : Option[(Double, Double) -> String]
}

pub fn Meter::node(self : Meter) -> view::View {
  self.node
}

/// Clamped numeric value within `[min, max]`.
pub fn Meter::value(self : Meter) -> Double {
  dmath::clamp((self.val_)(), self.min, self.max)
}

/// Normalized fraction in `[0.0, 1.0]`.
pub fn Meter::ratio(self : Meter) -> Double {
  let span = self.max - self.min
  if span <= 0.0 {
    0.0
  } else {
    dmath::clamp((self.value() - self.min) / span, 0.0, 1.0)
  }
}

/// Semantic value text (defaults to rounded integer percent like `"75%"`).
pub fn Meter::value_text(self : Meter) -> String {
  let v = self.value()
  let r = self.ratio()
  match self.text_ {
    Some(f) => f(v, r)
    None => "\{(r * 100.0).round().to_int()}%"
  }
}

/// Mount a headless `Meter` (`Role::Meter`) in `parent`.
pub fn meter(
  parent : view::View,
  label : () -> String,
  value : () -> Double,
  look : (view::View, Meter) -> Unit,
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  value_text? : (Double, Double) -> String,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let lo = if min <= max { min } else { max }
  let hi = if min <= max { max } else { min }
  let setup = fn(v : view::View) {
    let m = Meter::{ node: v, min: lo, max: hi, val_: value, text_: value_text }
    look(v, m)
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(
        view::Role::Meter,
        label=label(),
        value=m.value_text(),
        range=(lo, m.value(), hi),
      ))
    }))
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
