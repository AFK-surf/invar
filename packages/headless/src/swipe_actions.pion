import "mbt_compat"
import "signals"
import "view"

// Swipe actions: horizontal swipe-to-reveal gesture state machine for list rows.
// Distinguishes horizontal swipes from vertical list scrolling via axis locking past `slop`, applies rubber-band
// resistance past the revealed action width, and snaps open or closed on release based on displacement ratio or
// horizontal fling velocity (points/sec). Draws nothing and lays out nothing.

///|
/// Which side's swipe actions are revealed (`Left` when dragged right, `Right` when dragged left).

#derive(Eq)
pub enum SwipeSide {
  Left
  Right
}
pub fn SwipeSide::__mbt_debug_repr(self : SwipeSide) -> mbt_compat::MbtDebugRepr {
  match self {
    SwipeSide::Left => mbt_compat::mbt_debug_enum("Left", [])
    SwipeSide::Right => mbt_compat::mbt_debug_enum("Right", [])
  }
}

///|
/// Headless swipe-actions controller bound to a row node via `SwipeActions::bind`.
pub struct SwipeActions {
  priv left_width : Double
  priv right_width : Double
  priv threshold : Double
  priv velocity_threshold : Double
  priv slop : Double
  priv disabled_ : () -> Bool
  priv on_open_ : (Option[SwipeSide]) -> Unit
  priv offset_ : signals::Signal[Double]
  priv open_side_ : signals::Signal[Option[SwipeSide]]
  priv dragging_ : signals::Signal[Bool]
}

///|
/// Create a `SwipeActions` controller.
/// `left_width` / `right_width`: revealed widths (points) for left and right action trays.
/// `threshold`: fraction of tray width required to snap open on a slow release (default `0.4`).
/// `velocity_threshold`: horizontal release velocity (points/second) that triggers a flick open/close (default `400.0`).
/// `slop`: movement (points) before locking onto the horizontal or vertical axis (default `6.0`).
pub fn SwipeActions::new(left_width? : Double, right_width? : Double, threshold? : Double, velocity_threshold? : Double, slop? : Double, disabled? : () -> Bool, on_open? : (Option[SwipeSide]) -> Unit) -> SwipeActions {
  let left_width = match left_width { Some(__mbt_v) => __mbt_v, None => 0.0 }
  let right_width = match right_width { Some(__mbt_v) => __mbt_v, None => 0.0 }
  let threshold = match threshold { Some(__mbt_v) => __mbt_v, None => 0.4 }
  let velocity_threshold = match velocity_threshold { Some(__mbt_v) => __mbt_v, None => 400.0 }
  let slop = match slop { Some(__mbt_v) => __mbt_v, None => 6.0 }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let on_open = match on_open { Some(__mbt_v) => __mbt_v, None => fn(_) { } }

  SwipeActions::{
    left_width: if left_width > 0.0 { left_width } else { 0.0 },
    right_width: if right_width > 0.0 { right_width } else { 0.0 },
    threshold: threshold,
    velocity_threshold: velocity_threshold,
    slop: if slop > 0.0 { slop } else { 0.0 },
    disabled_: disabled,
    on_open_: on_open,
    offset_: signals::signal(0.0),
    open_side_: signals::signal(Option::None),
    dragging_: signals::signal(false),
  }
}

///|
/// Current horizontal offset in points: positive exposes left actions, negative exposes right actions. Followed.
pub fn SwipeActions::offset(self : SwipeActions) -> Double {
  self.offset_.get()
}

///|
/// Currently snapped-open side, or `None` when closed. Followed.
pub fn SwipeActions::open_side(self : SwipeActions) -> Option[SwipeSide] {
  self.open_side_.get()
}

///|
/// Whether the user is actively dragging horizontally right now. Followed.
pub fn SwipeActions::dragging(self : SwipeActions) -> Bool {
  self.dragging_.get()
}

///|
fn SwipeActions::set_snapped(self : SwipeActions, side : Option[SwipeSide]) -> Unit {
  let target = match side {
    Some(SwipeSide::Left) => self.left_width
    Some(SwipeSide::Right) => -self.right_width
    Option::None => 0.0
  }
  self.offset_.set(target)
  let prev = self.open_side_.untracked()
  if prev != side {
    self.open_side_.set(side)
    (self.on_open_)(side)
  }
}

///|
/// Programmatically open `side` (no-op when that side has zero width or the control is disabled).
pub fn SwipeActions::open(self : SwipeActions, side : SwipeSide) -> Unit {
  if signals::untracked(self.disabled_) {
    return
  }
  match side {
    SwipeSide::Left if self.left_width > 0.0 => self.set_snapped(Some(SwipeSide::Left))
    SwipeSide::Right if self.right_width > 0.0 => self.set_snapped(Some(SwipeSide::Right))
    _ => ()
  }
}

///|
/// Programmatically close any open action tray back to offset `0.0`.
pub fn SwipeActions::close(self : SwipeActions) -> Unit {
  self.set_snapped(Option::None)
}

///|
fn swipe_rubber_band(over : Double) -> Double {
  if over <= 0.0 {
    0.0
  } else {
    over * 0.35 / (1.0 + over / 120.0)
  }
}

///|
fn SwipeActions::apply_offset(self : SwipeActions, raw : Double) -> Double {
  if raw > self.left_width {
    if self.left_width > 0.0 {
      self.left_width + swipe_rubber_band(raw - self.left_width)
    } else {
      0.0
    }
  } else if raw < -self.right_width {
    if self.right_width > 0.0 {
      -(self.right_width + swipe_rubber_band(-raw - self.right_width))
    } else {
      0.0
    }
  } else {
    raw
  }
}

///|
/// Attach horizontal swipe gesture handling (`View::claims` + `on_drag`) to `v`.
/// Claims the drag only when `|dx| > slop` and `|dx| > 2 * |dy|` (matching chat row swipe disambiguation) toward a
/// direction that has actions or closes an already-open tray, leaving vertical and diagonal drags free for an outer
/// `View::scrolls` list to scroll. Subtracts the signed `slop` threshold on claim so movement starts continuously from
/// 0 with no jump and identical results across frame rates (slow open requires `threshold * width + slop` total travel
/// from touch-down; velocity flick thresholds are unaffected).
pub fn SwipeActions::bind(self : SwipeActions, v : view::View) -> Unit {
  let start_wx = mbt_compat::ref_new(0.0)
  let start_offset = mbt_compat::ref_new(0.0)
  let claimed = mbt_compat::ref_new(false)
  let slop_shifted = mbt_compat::ref_new(false)
  let swipes_on = fn(dx : Double, dy : Double) -> Bool {
    if signals::untracked(self.disabled_) || (self.left_width <= 0.0 && self.right_width <= 0.0) {
      return false
    }
    let ax = dx.abs()
    let ay = dy.abs()
    if !(ax > self.slop && ax > 2.0 * ay) {
      return false
    }
    let cur = self.offset_.untracked()
    cur != 0.0 || (dx > 0.0 && self.left_width > 0.0) || (dx < 0.0 && self.right_width > 0.0)
  }
  v
  .claims(swipes_on)
  .on_drag(fn(d) {
    if (self.disabled_)() || (self.left_width <= 0.0 && self.right_width <= 0.0) {
      if claimed.v {
        claimed.v = false
        slop_shifted.v = false
        self.dragging_.set(false)
        self.set_snapped(self.open_side_.untracked())
      }
      return
    }
    match d.kind {
      .Down => {
        start_wx.v = d.wx
        start_offset.v = self.offset_.untracked()
        claimed.v = true
        slop_shifted.v = false
        self.dragging_.set(true)
      }
      view::DragIs::Moved => {
        guard claimed.v else { return }
        if !slop_shifted.v {
          let raw_dx = d.wx - start_wx.v
          if raw_dx != 0.0 {
            start_wx.v = start_wx.v + (if raw_dx > 0.0 { self.slop } else { -self.slop })
            slop_shifted.v = true
          }
        }
        let eff_dx = d.wx - start_wx.v
        self.offset_.set(self.apply_offset(start_offset.v + eff_dx))
      }
      .Up => {
        if claimed.v {
          claimed.v = false
          slop_shifted.v = false
          self.dragging_.set(false)
          let cur = self.offset_.untracked()
          let vx_ps = d.vx() * 1000.0
          let target : Option[SwipeSide] = if vx_ps >= self.velocity_threshold {
            if start_offset.v < 0.0 && cur <= 0.0 {
              Option::None
            } else if self.left_width > 0.0 {
              Some(SwipeSide::Left)
            } else {
              Option::None
            }
          } else if vx_ps <= -self.velocity_threshold {
            if start_offset.v > 0.0 && cur >= 0.0 {
              Option::None
            } else if self.right_width > 0.0 {
              Some(SwipeSide::Right)
            } else {
              Option::None
            }
          } else if self.left_width > 0.0 && cur >= self.left_width * self.threshold {
            Some(SwipeSide::Left)
          } else if self.right_width > 0.0 && cur <= -(self.right_width * self.threshold) {
            Some(SwipeSide::Right)
          } else {
            Option::None
          }
          self.set_snapped(target)
        }
      }
      view::DragIs::Off => {
        if claimed.v {
          claimed.v = false
          slop_shifted.v = false
          self.dragging_.set(false)
          self.set_snapped(self.open_side_.untracked())
        }
      }
    }
  })
  |> ignore
}
