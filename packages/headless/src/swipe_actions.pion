  let right_width = match right_width { Some(__mbt_v) => __mbt_v, None => 0.0 }
  let threshold = match threshold { Some(__mbt_v) => __mbt_v, None => 0.4 }
  let velocity_threshold = match velocity_threshold { Some(__mbt_v) => __mbt_v, None => 400.0 }
  let slop = match slop { Some(__mbt_v) => __mbt_v, None => 6.0 }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let on_open = match on_open { Some(__mbt_v) => __mbt_v, None => fn(_) { } }

  SwipeActions::{
    left_width: if left_width > 0.0 { left_width } else { 0.0 },
    right_width: if right_width > 0.0 { right_width } else { 0.0 },
