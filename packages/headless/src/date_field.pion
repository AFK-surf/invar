// Headless segmented `DateField` and `TimeField` editors:
// `Granularity::Day/Hour/Minute/Second`, 12h/24h hour cycle, empty segment placeholders,
// Up/Down stepping, Left/Right segment switching, Backspace/Delete clear, and `Role::SpinButton`.

import "headless_core"
import "signals"
import "view"

/// Shared segmented date/time field controller.
pub struct DateField {
  node : view::View
  granularity : headless_core::DateGranularity
  hour_cycle_12 : Bool
  time_only : Bool
  val_ : () -> headless_core::SegmentedDateTime
  on_change : (headless_core::SegmentedDateTime) -> Unit
  off : () -> Bool
  ro : () -> Bool
  roving : RovingFocus
}

pub fn DateField::node(self : DateField) -> view::View {
  self.node
}

pub fn DateField::value(self : DateField) -> headless_core::SegmentedDateTime {
  (self.val_)()
}

pub fn DateField::segments(self : DateField) -> Array[headless_core::DateSegmentKind] {
  if self.time_only {
    headless_core::time_field_segments(self.granularity, hour_cycle_12=self.hour_cycle_12)
  } else {
    headless_core::date_field_segments(self.granularity, hour_cycle_12=self.hour_cycle_12)
  }
}

pub fn DateField::segment_text(self : DateField, kind : headless_core::DateSegmentKind) -> String {
  (self.val_)().segment_text(kind, hour_cycle_12=self.hour_cycle_12)
}

pub fn DateField::step_segment(self : DateField, kind : headless_core::DateSegmentKind, delta : Int) -> Unit {
  if signals::untracked(self.off) || signals::untracked(self.ro) {
    return
  }
  let cur = signals::untracked(self.val_)
  let next = cur.step_segment(kind, delta, hour_cycle_12=self.hour_cycle_12)
  if !next.eq(cur) {
    (self.on_change)(next)
  }
}

pub fn DateField::clear_segment(self : DateField, kind : headless_core::DateSegmentKind) -> Unit {
  if signals::untracked(self.off) || signals::untracked(self.ro) {
    return
  }
  let cur = signals::untracked(self.val_)
  let next = cur.clear_segment(kind)
  if !next.eq(cur) {
    (self.on_change)(next)
  }
}

fn segment_kind_label(kind : headless_core::DateSegmentKind) -> String {
  match kind {
    headless_core::DateSegmentKind::Year => "Year"
    headless_core::DateSegmentKind::Month => "Month"
    headless_core::DateSegmentKind::Day => "Day"
    headless_core::DateSegmentKind::Hour => "Hour"
    headless_core::DateSegmentKind::Minute => "Minute"
    headless_core::DateSegmentKind::Second => "Second"
    headless_core::DateSegmentKind::DayPeriod => "AM/PM"
  }
}

fn make_segmented_field(
  parent : view::View,
  label : () -> String,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  look : (view::View, DateField) -> Unit,
  granularity : headless_core::DateGranularity,
  hour_cycle_12 : Bool,
  time_only : Bool,
  disabled : () -> Bool,
  read_only : () -> Bool,
  in_node : Bool,
  made_for : Option[String],
  loc : String,
) -> view::View {
  let setup = fn(v : view::View) {
    let df = DateField::{
      node: v,
      granularity,
      hour_cycle_12,
      time_only,
      val_: value,
      on_change,
      off: disabled,
      ro: read_only,
      roving: RovingFocus::new(axis=GroupAxis::Horizontal, roving=true, wraps=false),
    }
    look(v, df)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::Group, label=label()))
      }))
      .on_key(fn(k : view::Key) -> Bool {
        if disabled() || k.mods != 0 || !focus_in(v, false) {
          return false
        }
        if k.code == grid_key_left || k.code == grid_key_right || k.code == group_key_home || k.code == group_key_end {
          return df.roving.step(k.code) is Some(_)
        }
        false
      })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount a headless segmented `DateField` (`Role::Group` holding `Role::SpinButton` segments).
pub fn date_field(
  parent : view::View,
  label : () -> String,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  look : (view::View, DateField) -> Unit,
  granularity~ : headless_core::DateGranularity = headless_core::DateGranularity::Day,
  hour_cycle_12~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  read_only~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  make_segmented_field(
    parent,
    label,
    value,
    on_change,
    look,
    granularity,
    hour_cycle_12,
    false,
    disabled,
    read_only,
    in_node,
    made_for,
    loc,
  )
}

/// Mount a headless segmented `TimeField` (`Role::Group` holding `Role::SpinButton` segments).
pub fn time_field(
  parent : view::View,
  label : () -> String,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  look : (view::View, DateField) -> Unit,
  granularity~ : headless_core::DateGranularity = headless_core::DateGranularity::Minute,
  hour_cycle_12~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  read_only~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  make_segmented_field(
    parent,
    label,
    value,
    on_change,
    look,
    granularity,
    hour_cycle_12,
    true,
    disabled,
    read_only,
    in_node,
    made_for,
    loc,
  )
}

/// Mount one editable segment (`Role::SpinButton`) inside `DateField` or `TimeField`.
pub fn DateField::segment(
  self : DateField,
  parent : view::View,
  kind : headless_core::DateSegmentKind,
  look : (view::View, () -> String) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let able = fn() -> Bool { !(self.off)() }
    let text_fn = fn() -> String { self.segment_text(kind) }
    look(v, text_fn)
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=0, tab=false)
      .says(view::Live::By(fn() -> Option[view::Said] {
        let cur = (self.val_)()
        let rng = cur.segment_range(kind, hour_cycle_12=self.hour_cycle_12)
        let acts : Array[view::Action] = if (self.off)() || (self.ro)() {
          []
        } else {
          [view::Action::Increment, view::Action::Decrement]
        }
        Some(view::said(
          view::Role::SpinButton,
          label=segment_kind_label(kind),
          value=text_fn(),
          range=rng,
          actions=acts,
        ))
      }))
      .on_press(fn() {
        if able() {
          let _ = v.ask_focus(visible=false)
        }
      })
      .on_step(fn(by : Int) { self.step_segment(kind, by) })
      .on_key(fn(k : view::Key) -> Bool {
        if (self.off)() || (self.ro)() || !v.focused() || k.mods != 0 {
          return false
        }
        if k.code == group_key_up {
          self.step_segment(kind, 1)
          true
        } else if k.code == group_key_down {
          self.step_segment(kind, -1)
          true
        } else if k.code == headless_core::key_backspace || k.code == headless_core::key_delete {
          self.clear_segment(kind)
          true
        } else {
          false
        }
      })
    self.roving.add(v, off=self.off)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
