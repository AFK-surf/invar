// Focus recovery: hands focus to a fallback node when a tracked node leaves or loses input capability.

import "signals"
import "view"

/// Tracks focusable nodes and automatically hands focus to a fallback when a focused node
/// unmounts, begins leaving, or loses input capability.
pub struct FocusRecovery {
  active : view::Ref[Bool]
}

/// Create a new `FocusRecovery` tracker.
pub fn FocusRecovery::new() -> FocusRecovery {
  FocusRecovery::{ active: view::ref_new(true) }
}

/// Track `v`: if `v` holds focus when it leaves, unmounts, or loses input capability (`!takes_input()` or `off()`),
/// automatically move focus to the node returned by `fallback()`.
pub fn FocusRecovery::track(
  self : FocusRecovery,
  v : view::View,
  fallback : () -> Option[view::View],
  off~ : () -> Bool = fn() { false },
) -> Unit {
  let held = view::ref_new(signals::untracked(fn() -> Bool { v.focused() }))
  let shown = view::ref_new(signals::untracked(fn() -> Bool { v.focus_shown() }))
  let recover = fn() {
    if !self.active.v || !held.v {
      return
    }
    held.v = false
    let vis = shown.v
    match signals::untracked(fallback) {
      Some(target) => {
        if target.id() != v.id() && target.alive() && !target.leaving() && target.takes_input() {
          let _ = target.ask_focus(visible=vis)
        }
      }
      None => ()
    }
  }
  v.reacts(fn() -> Bool { v.focused() }, fn(f : Bool) {
    if f {
      held.v = true
      shown.v = signals::untracked(fn() -> Bool { v.focus_shown() })
    } else if held.v {
      let gone = !v.alive() || v.leaving() || !v.takes_input() || signals::untracked(off)
      if gone {
        recover()
      } else {
        held.v = false
      }
    }
  })
  v.reacts(fn() -> Bool { v.focus_shown() }, fn(s : Bool) {
    if held.v {
      shown.v = s
    }
  })
  v.reacts(fn() -> Bool { !v.takes_input() || v.leaving() || off() }, fn(gone : Bool) {
    if gone && held.v {
      recover()
    }
  }, at_start=false)
  let _ = v.owns(fn() {
    if held.v {
      recover()
    }
  })
}
