// The toolbar: a composite bar of controls with Role::Toolbar and roving focus.

import "view"

/// A toolbar handed to its look to register items via `Toolbar::item`.
pub struct Toolbar {
  node : view::View
  off : () -> Bool
  items : RovingFocus
}

/// The toolbar's container node.
pub fn Toolbar::node(self : Toolbar) -> view::View {
  self.node
}

/// Whether the entire toolbar is disabled.
pub fn Toolbar::disabled(self : Toolbar) -> Bool {
  (self.off)()
}

/// Focus the toolbar's current roving tab stop.
pub fn Toolbar::focus_stop(self : Toolbar, visible~ : Bool = true) -> Bool {
  if (self.off)() {
    return false
  }
  self.items.focus_stop(visible=visible)
}

/// A toolbar in `parent` (`parent` itself where `in_node`), called `label`,
/// with roving focus along `axis` (default Horizontal) and optional `rtl`.
pub fn toolbar(
  parent : view::View,
  label : () -> String,
  look : (view::View, Toolbar) -> Unit,
  axis~ : GroupAxis = GroupAxis::Horizontal,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let items = RovingFocus::new(axis=axis, roving=true, wraps=wraps, rtl=rtl)
  let setup = fn(v : view::View) {
    let tb = Toolbar::{ node: v, off: disabled, items }
    look(v, tb)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Toolbar, label=label())) }))
      .on_key(fn(k : view::Key) -> Bool {
        if k.mods != 0 || disabled() || !focus_in(v, false) {
          return false
        }
        items.step(k.code) is Some(_)
      })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Register any focusable control (`toggle`, `disclosure`, `popover.trigger`, etc.)
/// into this toolbar's roving focus group.
pub fn Toolbar::join(
  self : Toolbar,
  v : view::View,
  disabled~ : () -> Bool = fn() { false },
  preferred~ : () -> Bool = fn() { false },
) -> Unit {
  let off = fn() -> Bool { (self.off)() || disabled() }
  self.items.add(v, off=off, first=preferred)
}

/// A button item of `self` in `parent`, participating in the toolbar's roving focus.
pub fn Toolbar::item(
  self : Toolbar,
  parent : view::View,
  label : () -> String,
  press : (view::View) -> Unit,
  look : (view::View, Button) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off = fn() -> Bool { (self.off)() || disabled() }
  let v = button(
    parent,
    label,
    press,
    look,
    disabled=off,
    in_node=in_node,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
  self.join(v, disabled=disabled)
  v
}
