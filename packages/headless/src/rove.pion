// Roving focus helper for multi-part controls (accordion, toggle group, listbox).
// Ported 1:1 from libs/mbui/src/headless/rove.mbt.

import "signals"
import "view"

struct RoveEntry {
  node : view::View
  off : () -> Bool
  first : () -> Bool
}

struct Rove {
  items : Array[RoveEntry]
  roving : Bool
  last : signals::Signal[Option[view::NodeId]]
  made : signals::Signal[Int]
}

fn Rove::new(roving : Bool) -> Rove {
  Rove::{
    items: [],
    roving,
    last: signals::signal_by(None, same_node_id_opt),
    made: signals::signal(0),
  }
}

fn Rove::add(self : Rove, v : view::View, off : () -> Bool, first : () -> Bool) -> Unit {
  self.items.push(RoveEntry::{ node: v, off, first })
  self.made.set(self.made.untracked() + 1)
  let _ = v.owns(fn() {
    view::array_retain(self.items, fn(e : RoveEntry) -> Bool { e.node.id() != v.id() })
    self.made.set(self.made.untracked() + 1)
  })
  if self.roving {
    let _ = v.tab_stop(view::Live::By(fn() -> Bool {
      match self.stop_at() {
        Some(id) => id == v.id()
        None => false
      }
    }))
    v.reacts(fn() -> Bool { v.focused() }, fn(f : Bool) {
      if f {
        self.last.set(Some(v.id()))
      }
    })
  }
}

fn Rove::live(self : Rove) -> Array[RoveEntry] {
  view::array_filter(self.items, fn(e : RoveEntry) -> Bool { e.node.takes_input() && !(e.off)() })
}

fn Rove::stop_at(self : Rove) -> Option[view::NodeId] {
  let _ = self.made.get()
  let live = self.live()
  match self.last.get() {
    Some(id) => {
      if view::array_any(live, fn(e : RoveEntry) -> Bool { e.node.id() == id }) {
        return Some(id)
      }
    }
    None => ()
  }
  match view::array_find_first(live, fn(e : RoveEntry) -> Bool { (e.first)() }) {
    Some(e) => Some(e.node.id())
    None => {
      if live.length() > 0 {
        Some(live[0].node.id())
      } else {
        None
      }
    }
  }
}

fn rove_at(live : Array[RoveEntry]) -> Option[Int] {
  view::array_search_by(live, fn(e : RoveEntry) -> Bool { e.node.focused() })
}

fn Rove::step(self : Rove, code : Int, prev : Array[Int], next : Array[Int], wraps : Bool) -> Option[RoveEntry] {
  let live = self.live()
  let n = live.length()
  if n == 0 {
    return None
  }
  let i = match rove_at(live) {
    Some(idx) => idx
    None => return None
  }
  let to : Option[Int] = if int_array_contains(prev, code) {
    Some(if i > 0 { i - 1 } else if wraps { n - 1 } else { 0 })
  } else if int_array_contains(next, code) {
    Some(if i + 1 < n { i + 1 } else if wraps { 0 } else { n - 1 })
  } else if code == group_key_home {
    Some(0)
  } else if code == group_key_end {
    Some(n - 1)
  } else {
    None
  }
  match to {
    Some(j) => {
      let _ = live[j].node.ask_focus(visible=true)
      Some(live[j])
    }
    None => None
  }
}

fn axis_keys(axis : GroupAxis) -> (Array[Int], Array[Int]) {
  match axis {
    Horizontal => ([group_key_left], [group_key_right])
    Vertical => ([group_key_up], [group_key_down])
    Both => ([group_key_left, group_key_up], [group_key_right, group_key_down])
  }
}
