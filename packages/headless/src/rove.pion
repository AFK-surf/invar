// Roving focus behavior for composite controls (accordion, toggle group, listbox, menu, toolbar).

import "headless_core"
import "signals"
import "view"

/// One registered item in a `RovingFocus` group.
pub struct RovingEntry {
  pub node : view::View
  off : () -> Bool
  first : () -> Bool
}

/// Roving tabindex and directional keyboard navigation with automatic focus recovery.
pub struct RovingFocus {
  items : Array[RovingEntry]
  axis : GroupAxis
  roving : Bool
  wraps : Bool
  rtl : Bool
  last : signals::Signal[Option[view::NodeId]]
  made : signals::Signal[Int]
  recovery : FocusRecovery
}

/// Create a `RovingFocus` controller along `axis`, with optional roving tabindex, wrap-around, and RTL support.
pub fn RovingFocus::new(
  axis~ : GroupAxis = GroupAxis::Horizontal,
  roving~ : Bool = true,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
) -> RovingFocus {
  RovingFocus::{
    items: [],
    axis,
    roving,
    wraps,
    rtl,
    last: signals::signal_by(None, same_node_id_opt),
    made: signals::signal(0),
    recovery: FocusRecovery::new(),
  }
}

fn RovingFocus::neighbor_of_index(self : RovingFocus, id : view::NodeId, pos : Int) -> Option[view::View] {
  let n = self.items.length()
  let ok = fn(e : RovingEntry) -> Bool {
    e.node.id() != id && e.node.alive() && !e.node.leaving() && e.node.takes_input() && !signals::untracked(e.off)
  }
  // Prefer the next surviving enabled item after `pos`.
  let mut fwd = pos + 1
  if fwd < 0 {
    fwd = 0
  }
  while fwd < n {
    if ok(self.items[fwd]) {
      return Some(self.items[fwd].node)
    }
    fwd += 1
  }
  // Otherwise fall back to the nearest preceding surviving enabled item.
  let mut bwd = pos - 1
  if bwd >= n {
    bwd = n - 1
  }
  while bwd >= 0 {
    if ok(self.items[bwd]) {
      return Some(self.items[bwd].node)
    }
    bwd -= 1
  }
  None
}

fn RovingFocus::index_of(self : RovingFocus, id : view::NodeId) -> Int {
  let mut i = 0
  while i < self.items.length() {
    if self.items[i].node.id() == id {
      return i
    }
    i += 1
  }
  -1
}

/// Register `v` in this roving focus group.
pub fn RovingFocus::add(
  self : RovingFocus,
  v : view::View,
  off~ : () -> Bool = fn() { false },
  first~ : () -> Bool = fn() { false },
) -> Unit {
  self.items.push(RovingEntry::{ node: v, off, first })
  self.made.set(self.made.untracked() + 1)
  let precomputed_neighbor : view::Ref[Option[view::View]] = view::ref_new(None)
  self.recovery.track(
    v,
    fn() -> Option[view::View] {
      let pos = self.index_of(v.id())
      if pos >= 0 {
        self.neighbor_of_index(v.id(), pos)
      } else {
        precomputed_neighbor.v
      }
    },
    off=off,
  )
  let _ = v.owns(fn() {
    let pos = self.index_of(v.id())
    if pos >= 0 {
      precomputed_neighbor.v = self.neighbor_of_index(v.id(), pos)
    }
    view::array_retain(self.items, fn(e : RovingEntry) -> Bool { e.node.id() != v.id() })
    self.made.set(self.made.untracked() + 1)
  })
  if self.roving {
    let _ = v.tab_stop(view::Live::By(fn() -> Bool {
      match self.stop_at() {
        Some(id) => id == v.id()
        None => false
      }
    }))
    v.reacts(fn() -> Bool { v.focused() }, fn(f : Bool) {
      if f {
        self.last.set(Some(v.id()))
      }
    })
  }
}

/// Live, enabled entries currently eligible for focus.
pub fn RovingFocus::live(self : RovingFocus) -> Array[RovingEntry] {
  view::array_filter(self.items, fn(e : RovingEntry) -> Bool {
    e.node.alive() && !e.node.leaving() && e.node.takes_input() && !(e.off)()
  })
}

/// The `NodeId` that currently holds the roving tab stop.
pub fn RovingFocus::stop_at(self : RovingFocus) -> Option[view::NodeId] {
  let _ = self.made.get()
  let live = self.live()
  match self.last.get() {
    Some(id) => {
      if view::array_any(live, fn(e : RovingEntry) -> Bool { e.node.id() == id }) {
        return Some(id)
      }
    }
    None => ()
  }
  match view::array_find_first(live, fn(e : RovingEntry) -> Bool { (e.first)() }) {
    Some(e) => Some(e.node.id())
    None => {
      if live.length() > 0 {
        Some(live[0].node.id())
      } else {
        None
      }
    }
  }
}

/// Focus the current tab stop node.
pub fn RovingFocus::focus_stop(self : RovingFocus, visible~ : Bool = true) -> Bool {
  match signals::untracked(fn() -> Option[view::NodeId] { self.stop_at() }) {
    Some(id) =>
      match view::array_find_first(self.items, fn(e : RovingEntry) -> Bool { e.node.id() == id }) {
        Some(e) => e.node.ask_focus(visible=visible)
        None => false
      }
    None => false
  }
}

/// Focus the first live enabled entry.
pub fn RovingFocus::focus_first(self : RovingFocus, visible~ : Bool = true) -> Bool {
  let live = self.live()
  if live.length() > 0 {
    live[0].node.ask_focus(visible=visible)
  } else {
    false
  }
}

/// Focus the last live enabled entry.
pub fn RovingFocus::focus_last(self : RovingFocus, visible~ : Bool = true) -> Bool {
  let live = self.live()
  let n = live.length()
  if n > 0 {
    live[n - 1].node.ask_focus(visible=visible)
  } else {
    false
  }
}

fn rove_at(live : Array[RovingEntry]) -> Option[Int] {
  view::array_search_by(live, fn(e : RovingEntry) -> Bool { e.node.focused() })
}

fn core_axis(axis : GroupAxis) -> headless_core::GroupAxis {
  match axis {
    Horizontal => headless_core::GroupAxis::Horizontal
    Vertical => headless_core::GroupAxis::Vertical
    Both => headless_core::GroupAxis::Both
  }
}

/// Step focus along the configured axis (flipping Left/Right when `rtl=true`), plus Home/End.
/// When `from_none=true`, arrow keys can enter the group even when no item currently has focus.
pub fn RovingFocus::step(self : RovingFocus, code : Int, from_none~ : Bool = false) -> Option[view::View] {
  let live = self.live()
  let n = live.length()
  if n == 0 {
    return None
  }
  let dir = match headless_core::roving_key_dir(core_axis(self.axis), self.rtl, code) {
    Some(d) => d
    None => return None
  }
  let at = rove_at(live)
  match headless_core::roving_step_in_enabled(at, n, dir, self.wraps, from_none) {
    Some(j) => {
      let _ = live[j].node.ask_focus(visible=true)
      Some(live[j].node)
    }
    None => None
  }
}
