// INVAR-EXT: Invar-specific headless extensions kept out of generated files.

import "signals"
import "view"

fn view_root(v : view::View) -> view::View {
  let mut cur = v
  while true {
    match cur.parent() {
      Some(p) => cur = p
      None => return cur
    }
  }
  cur
}

let window_tooltip_group_key : view::Lent[TooltipGroup[Int]] = view::Lent::new()

/// Shared window-level default `TooltipGroup[Int]` lent on `view_root(v)` so standalone
/// tooltips across the same window automatically share warmup / skip-delay timing.
pub fn window_tooltip_group(v : view::View) -> TooltipGroup[Int] {
  let root = view_root(v)
  match root.lent(window_tooltip_group_key) {
    Some(g) => g
    None => {
      let shown : signals::Signal[Option[Int]] = signals::signal_by(
        None,
        same=fn(a : Option[Int], b : Option[Int]) -> Bool {
          match (a, b) {
            (None, None) => true
            (Some(x), Some(y)) => x == y
            _ => false
          }
        },
      )
      let g = TooltipGroup::new(
        fn() -> Option[Int] { shown.get() },
        fn(k : Option[Int]) { shown.set(k) },
      )
      let _ = root.lends(window_tooltip_group_key, g)
      g
    }
  }
}
