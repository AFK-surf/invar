// The progress bar: how far some work has come.
// Ported 1:1 from libs/mbui/src/headless/progress.mbt.

import "dmath"
import "view"

/// A progress bar as its look reads it.
pub struct Progress {
  now : () -> Option[Double]
  min : Double
  max : Double
  ending : () -> Bool
}

/// Its value now, held within its range; none while indeterminate (and not finishing).
pub fn Progress::value(self : Progress) -> Option[Double] {
  if (self.ending)() {
    return Some(self.max)
  }
  match (self.now)() {
    Some(v) => Some(slider_clamp(v, self.min, self.max))
    None => None
  }
}

/// How far along its range it is now (0.0 .. 1.0); 0.0 while indeterminate, 1.0 while finishing.
pub fn Progress::part(self : Progress) -> Double {
  let span = self.max - self.min
  match self.value() {
    Some(v) => if span > 0.0 { slider_clamp((v - self.min) / span, 0.0, 1.0) } else { 1.0 }
    None => 0.0
  }
}

/// Whether how far it has come is not known now.
pub fn Progress::indeterminate(self : Progress) -> Bool {
  self.value() is None
}

/// Whether the work is done and the bar runs to its end.
pub fn Progress::finishing(self : Progress) -> Bool {
  (self.ending)()
}

fn progress_percent(v : Double, min : Double, max : Double) -> String {
  let span = max - min
  let share = if span > 0.0 { slider_clamp((v - min) / span, 0.0, 1.0) } else { 1.0 }
  dmath::round(share * 100.0).to_int().to_string() + "%"
}

/// A progress bar in `parent` (`parent` itself where `in_node`).
pub fn progress(
  parent : view::View,
  value : () -> Option[Double],
  look : (view::View, Progress) -> Unit,
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  value_text? : (Double) -> String,
  label~ : () -> String = fn() { "" },
  finishing~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let p = Progress::{ now: value, min, max, ending: finishing }
  let text_of : (Double) -> String = match value_text {
    Some(f) => f
    None => fn(v : Double) -> String { progress_percent(v, min, max) }
  }
  let setup = fn(v : view::View) {
    look(v, p)
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      match p.value() {
        Some(at) => Some(view::said(view::Role::ProgressBar, label=label(), value=text_of(at), range=(min, at, max)))
        None => Some(view::said(view::Role::ProgressBar, label=label()))
      }
    }))
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
