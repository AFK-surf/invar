// The context menu's trigger: a part of the window whose menu opens where it was asked for.
// Ported 1:1 from libs/mbui/src/headless/context_menu.mbt.

import "view"

/// `parent` (or a node made in it) made what asks for a context menu.
pub fn context_menu(
  parent : view::View,
  on_open : (view::Menu) -> Unit,
  look : (view::View) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    look(v)
    let _ = v.on_menu(fn(m : view::Menu) { if !disabled() { on_open(m) } })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
