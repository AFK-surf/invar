// Headless Wave P0-1B tests: `held_back_goes_on` positive and negative controls across dialog, overlay, drawer, and popover.

import "signals"
import "view"

test "headless p0-1b: held_back_goes_on=true preserves in-flight back gesture across dialog, overlay, drawer, and popover" {
  let dlg_open = signals::signal(false)
  let ov_open = signals::signal(false)
  let dr_open = signals::signal(false)
  let pop_open = signals::signal(false)
  let steps : Array[String] = []
  let tree = view::Tree::new(fn(root : view::View) {
    let _ = root.box(fn(a : view::View) {
      let _ = a.width(view::Live::Is(Some(200.0))).height(view::Live::Is(Some(200.0)))
      let _ = a.follows_back(fn(step : view::BackStep) {
        let sb = StringBuilder::new()
        view::backstep_output(step, sb)
        steps.push(sb.to_string())
      })
    })
    let _ = dialog(
      root,
      fn() { "KeepDlg" },
      fn() { dlg_open.get() },
      fn() { dlg_open.set(false) },
      fn(v : view::View, _d : Dialog) {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
      },
      modal=true,
      close_on_escape=false,
      held_back_goes_on=true,
    )
    let _ = overlay(
      root,
      fn(_how : OverlayDismiss) { ov_open.set(false) },
      fn(v : view::View, _o : Overlay) {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
      },
      modal=true,
      dismiss_on_escape=false,
      inert=fn() { !ov_open.get() },
      held_back_goes_on=true,
    )
    let _ = drawer(
      root,
      fn() { "KeepDrawer" },
      fn() { dr_open.get() },
      fn() { dr_open.set(false) },
      fn(v : view::View, _dr : Drawer) {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
      },
      modal=true,
      close_on_escape=false,
      held_back_goes_on=true,
    )
    let pop = Popover::new(fn() { pop_open.get() }, fn(v) { pop_open.set(v) })
    let _ = pop.content(
      root,
      fn() { "KeepPop" },
      fn(v : view::View) {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
        let _ = v.modal(view::Live::By(fn() { pop_open.get() }))
      },
      held_back_goes_on=true,
    )
  })
  let _ = tree.frame(400.0, 300.0, now=10.0)
  let taker = match tree.back_taker() {
    Some(id) => id
    None => {
      debug_assert(false, "base taker must exist")
      return
    }
  }
  debug_assert(tree.back_step(taker, view::BackStep::Began(10.0, 20.0), 20.0), "Began must succeed")
  dlg_open.set(true)
  ov_open.set(true)
  dr_open.set(true)
  pop_open.set(true)
  let _ = tree.frame(400.0, 300.0, now=30.0)
  debug_assert(tree.modal_top_lets_back(), "topmost modal with held_back_goes_on=true must report modal_top_lets_back=true")
  debug_assert(tree.back_step(taker, view::BackStep::Moved(40.0, 40.0), 40.0), "Moved must continue under held_back_goes_on=true modals")
  debug_assert(tree.back_done(taker, 50.0), "back_done must succeed")
  debug_assert(steps.length() == 3 && steps[2] == "Back", "must deliver Began, Moved, Back without CalledOff")
  tree.dispose()
}

test "headless p0-1b: held_back_goes_on=false cancels in-flight back gesture for dialog, overlay, drawer, and modal popover" {
  let check_cancels = fn(kind : Int) {
    let open = signals::signal(false)
    let steps : Array[String] = []
    let tree = view::Tree::new(fn(root : view::View) {
      let _ = root.box(fn(a : view::View) {
        let _ = a.width(view::Live::Is(Some(200.0))).height(view::Live::Is(Some(200.0)))
        let _ = a.follows_back(fn(step : view::BackStep) {
          let sb = StringBuilder::new()
          view::backstep_output(step, sb)
          steps.push(sb.to_string())
        })
      })
      if kind == 0 {
        let _ = dialog(
          root,
          fn() { "StopDlg" },
          fn() { open.get() },
          fn() { open.set(false) },
          fn(v : view::View, _d : Dialog) {
            let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
          },
          modal=true,
          close_on_escape=false,
          held_back_goes_on=false,
        )
      } else if kind == 1 {
        let _ = overlay(
          root,
          fn(_how : OverlayDismiss) { open.set(false) },
          fn(v : view::View, _o : Overlay) {
            let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
          },
          modal=true,
          dismiss_on_escape=false,
          inert=fn() { !open.get() },
          held_back_goes_on=false,
        )
      } else if kind == 2 {
        let _ = drawer(
          root,
          fn() { "StopDrawer" },
          fn() { open.get() },
          fn() { open.set(false) },
          fn(v : view::View, _dr : Drawer) {
            let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
          },
          modal=true,
          close_on_escape=false,
          held_back_goes_on=false,
        )
      } else {
        let pop = Popover::new(fn() { open.get() }, fn(v) { open.set(v) })
        let _ = pop.content(
          root,
          fn() { "StopPop" },
          fn(v : view::View) {
            let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
            let _ = v.modal(view::Live::By(fn() { open.get() }))
          },
          held_back_goes_on=false,
        )
      }
    })
    let _ = tree.frame(400.0, 300.0, now=10.0)
    let taker = match tree.back_taker() {
      Some(id) => id
      None => {
        debug_assert(false, "base taker must exist")
        return
      }
    }
    debug_assert(tree.back_step(taker, view::BackStep::Began(10.0, 20.0), 20.0), "Began must succeed")
    open.set(true)
    let _ = tree.frame(400.0, 300.0, now=30.0)
    debug_assert(!tree.modal_top_lets_back(), "held_back_goes_on=false modal must report modal_top_lets_back=false")
    debug_assert(!tree.back_step(taker, view::BackStep::Moved(40.0, 40.0), 40.0), "Moved must fail after cancellation")
    debug_assert(steps.length() == 2 && steps[1] == "CalledOff", "kind=\{kind} must deliver single CalledOff")
    tree.dispose()
  }
  check_cancels(0)
  check_cancels(1)
  check_cancels(2)
  check_cancels(3)
}
