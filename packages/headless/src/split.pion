///|
/// A movable split handle in `parent`, called `label` (what a screen reader says), at `value` in `[min, max]` stepped
/// by `step` on arrow keys and screen-reader actions, `change` told the new value as it is dragged or stepped. `axis`
/// chooses whether dragging and arrow keys move horizontally (`d.wx`, ←/→) or vertically (`d.wy`, ↑/↓). `span` gives
/// the pixel span corresponding to `max - min` when `value` is normalized (default: `max - min`, 1 point per unit).
/// `reset` runs on a double click or double tap without dragging. `look` is given the handle's node and its `Split`
/// state. The handle's node.

pub fn split(parent : view::View, label : () -> String, value : () -> Double, min~ : Double, max~ : Double, step~ : Double, change : (Double) -> Unit, look : (view::View, Split) -> Unit, axis? : SplitAxis, span? : () -> Double, reset? : () -> Unit, said_value? : (Double) -> String, disabled? : () -> Bool, made_for? : String, loc~ : String = "") -> view::View {
  let axis = match axis { Some(__mbt_v) => __mbt_v, None => SplitAxis::Horizontal }
  let said_value = match said_value { Some(__mbt_v) => __mbt_v, None => fn(x) { mbt_compat::double_to_string(x) } }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }

  let lo = if min <= max { min } else { max }
  let hi = if min <= max { max } else { min }
  let step_by = if step > 0.0 { step } else { (hi - lo) / 20.0 }
  parent.box(loc=loc, made_for=made_for.unwrap_or(loc), fn(v) {
    let able = fn() { !disabled() }
    look(v, Split::{ node: v, now: value, lo: lo, hi: hi, off: disabled })
    let tell = fn(target : Double, snap : Bool) {
      if !disabled() {
        let next = if snap { split_snap(target, lo, hi, step) } else { split_clamp(target, lo, hi) }
        let cur = split_clamp(value(), lo, hi)
        if next != cur {
          change(next)
        }
      }
    }
    let start_pos = mbt_compat::ref_new(0.0)
    let start_val = mbt_compat::ref_new(0.0)
    let moved = mbt_compat::ref_new(false)
    let pos_of = fn(d : view::Drag) {
      match axis {
        SplitAxis::Horizontal => d.wx
        SplitAxis::Vertical => d.wy
      }
    }
    v
    .presses(.By(able))
    .focusable(.By(able))
    .says(.By(fn() {
      let now = split_clamp(value(), lo, hi)
      let actions : Array[view::Action] = if disabled() { [] } else { [.Increment, .Decrement] }
      Some(view::said(view::Role::Separator, label=label(), value=said_value(now), range=(lo, now, hi), actions=actions))
    }))
    .on_drag(fn(d) {
      if disabled() {
        return
      }
      match d.kind {
        .Down => {
          start_pos.v = pos_of(d)
          start_val.v = split_clamp(value(), lo, hi)
          moved.v = false
        }
        view::DragIs::Moved => {
          let delta_px = pos_of(d) - start_pos.v
          if delta_px.abs() > 0.5 {
            moved.v = true
          }
          let px_span = match span {
            Some(f) => f()
            Option::None => hi - lo
          }
          if px_span > 0.0 {
            let delta_val = delta_px / px_span * (hi - lo)
            tell(start_val.v + delta_val, step > 0.0)
          }
        }
        .Up =>
        if moved.v {
          v.twice_forgot()
        } else if v.twice(d) && reset is Some(r) {
          r()
        }
        _ => ()
      }
    }, captures=true)
    .on_step(fn(by) {
      if !disabled() && step_by > 0.0 {
        let cur = split_clamp(value(), lo, hi)
        tell(cur + by.to_double() * step_by, true)
      }
    })
    .on_key(fn(k) {
      if disabled() || k.mods != 0 {
        return false
      }
      let cur = split_clamp(value(), lo, hi)
      let dec = match axis {
        SplitAxis::Horizontal => k.code == split_key_left
        SplitAxis::Vertical => k.code == split_key_up
      }
      let inc = match axis {
        SplitAxis::Horizontal => k.code == split_key_right
        SplitAxis::Vertical => k.code == split_key_down
      }
      if dec {
        tell(cur - step_by, true)
        true
      } else if inc {
        tell(cur + step_by, true)
        true
      } else if k.code == split_key_home {
        tell(lo, false)
        true
      } else if k.code == split_key_end {
        tell(hi, false)
        true
      } else {
        false
      }
    })
    |> ignore
  })
}
