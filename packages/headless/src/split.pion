// The split handle: a movable separator between two panes.
// Ported 1:1 from libs/mbui/src/headless/split.mbt.

import "dmath"
import "headless_core"
import "view"

/// Which way the splitter moves: `Horizontal` or `Vertical`.
#derive(Eq)
pub enum SplitAxis {
  Horizontal
  Vertical
}

/// A split handle as its look reads it.
pub struct Split {
  node : view::View
  now : () -> Double
  lo : Double
  hi : Double
  off : () -> Bool
}

pub fn Split::value(self : Split) -> Double {
  split_clamp((self.now)(), self.lo, self.hi)
}

pub fn Split::part(self : Split) -> Double {
  let span = self.hi - self.lo
  if span <= 0.0 {
    0.0
  } else {
    split_clamp(((self.now)() - self.lo) / span, 0.0, 1.0)
  }
}

pub fn Split::disabled(self : Split) -> Bool {
  (self.off)()
}

pub fn Split::dragging(self : Split) -> Bool {
  self.node.pressed()
}

pub fn Split::hovered(self : Split) -> Bool {
  self.node.pointed()
}

pub fn Split::focus_shown(self : Split) -> Bool {
  self.node.focus_shown()
}

fn split_clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo {
    lo
  } else if x > hi {
    hi
  } else {
    x
  }
}

fn split_snap(x : Double, lo : Double, hi : Double, step : Double) -> Double {
  let c = split_clamp(x, lo, hi)
  if step <= 0.0 {
    c
  } else {
    let steps = dmath::round((c - lo) / step)
    split_clamp(lo + steps * step, lo, hi)
  }
}

let split_key_left : Int = headless_core::key_left
let split_key_right : Int = headless_core::key_right
let split_key_up : Int = headless_core::key_up
let split_key_down : Int = headless_core::key_down
let split_key_home : Int = headless_core::key_home
let split_key_end : Int = headless_core::key_end

/// A movable split handle in `parent`, called `label`, at `value` in `[min, max]`.
pub fn split(
  parent : view::View,
  label : () -> String,
  value : () -> Double,
  min~ : Double,
  max~ : Double,
  step~ : Double,
  change : (Double) -> Unit,
  look : (view::View, Split) -> Unit,
  axis~ : SplitAxis = Horizontal,
  span? : () -> Double,
  reset? : () -> Unit,
  said_value~ : (Double) -> String = fn(x : Double) -> String { x.to_string() },
  disabled~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let lo = if min <= max { min } else { max }
  let hi = if min <= max { max } else { min }
  let step_by = if step > 0.0 { step } else { (hi - lo) / 20.0 }
  parent.box(fn(v : view::View) {
    let able = fn() -> Bool { !disabled() }
    look(v, Split::{ node: v, now: value, lo, hi, off: disabled })
    let tell = fn(target : Double, snap : Bool) {
      if !disabled() {
        let next = if snap { split_snap(target, lo, hi, step) } else { split_clamp(target, lo, hi) }
        let cur = split_clamp(value(), lo, hi)
        if next != cur {
          change(next)
        }
      }
    }
    let start_pos = view::ref_new(0.0)
    let start_val = view::ref_new(0.0)
    let moved = view::ref_new(false)
    let pos_of = fn(d : view::Drag) -> Double {
      match axis {
        Horizontal => d.wx
        Vertical => d.wy
      }
    }
    let _ = v
      .presses(view::Live::By(able))
      .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space)
      .says(view::Live::By(fn() -> Option[view::Said] {
        let now = split_clamp(value(), lo, hi)
        let actions : Array[view::Action] = if disabled() {
          let empty : Array[view::Action] = []
          empty
        } else {
          [view::Action::Increment, view::Action::Decrement]
        }
        Some(view::said(view::Role::Separator, label=label(), value=said_value(now), range=(lo, now, hi), actions=actions))
      }))
      .on_drag(fn(d : view::Drag) {
        if disabled() {
          return
        }
        match d.kind {
          Down => {
            start_pos.v = pos_of(d)
            start_val.v = split_clamp(value(), lo, hi)
            moved.v = false
          }
          Moved => {
            let delta_px = pos_of(d) - start_pos.v
            if dmath::abs(delta_px) > 0.5 {
              moved.v = true
            }
            let px_span = match span {
              Some(f) => f()
              None => hi - lo
            }
            if px_span > 0.0 {
              let delta_val = delta_px / px_span * (hi - lo)
              tell(start_val.v + delta_val, step > 0.0)
            }
          }
          Up =>
            if moved.v {
              v.twice_forgot()
            } else if v.twice(d) {
              match reset {
                Some(r) => r()
                None => ()
              }
            }
          _ => ()
        }
      }, captures=true)
      .on_step(fn(by : Int) {
        if !disabled() && step_by > 0.0 {
          let cur = split_clamp(value(), lo, hi)
          tell(cur + by.to_double() * step_by, true)
        }
      })
      .on_key(fn(k : view::Key) -> Bool {
        if disabled() || k.mods != 0 {
          return false
        }
        let cur = split_clamp(value(), lo, hi)
        let dec = match axis {
          Horizontal => k.code == split_key_left
          Vertical => k.code == split_key_up
        }
        let inc = match axis {
          Horizontal => k.code == split_key_right
          Vertical => k.code == split_key_down
        }
        if dec {
          tell(cur - step_by, true)
          true
        } else if inc {
          tell(cur + step_by, true)
          true
        } else if k.code == split_key_home {
          tell(lo, false)
          true
        } else if k.code == split_key_end {
          tell(hi, false)
          true
        } else {
          false
        }
      })
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
