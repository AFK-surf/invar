// A shortcut as a person reads it, in their system's own words (⇧⌘K on Mac, Ctrl+Shift+K elsewhere).
// Ported 1:1 from libs/mbui/src/headless/shortcut.mbt.

import "view"

let mod_shift : Int = 1
let mod_ctrl : Int = 2
let mod_alt : Int = 4
let mod_cmd : Int = 8

/// `stroke` with its Command held as the system's own command key.
pub fn platform_stroke(stroke : view::Stroke, apple~ : Bool) -> view::Stroke {
  if apple || (stroke.mods & mod_cmd) == 0 || (stroke.mods & mod_ctrl) != 0 {
    return stroke
  }
  view::Stroke::{ code: stroke.code, mods: (stroke.mods & view::bit_not(mod_cmd)) | mod_ctrl }
}

fn key_cap(code : Int, apple : Bool) -> String {
  match code {
    1 => if apple { "⌫" } else { "Backspace" }
    2 => if apple { "⌦" } else { "Delete" }
    3 => "←"
    4 => "→"
    5 => "↑"
    6 => "↓"
    7 => if apple { "↩" } else { "Enter" }
    8 => if apple { "↖" } else { "Home" }
    9 => if apple { "↘" } else { "End" }
    15 => if apple { "⇞" } else { "PgUp" }
    16 => if apple { "⇟" } else { "PgDn" }
    17 => if apple { "⎋" } else { "Esc" }
    18 => if apple { "⇥" } else { "Tab" }
    1032 => "Space"
    c => {
      let cp = c - 1000
      if cp >= 97 && cp <= 122 {
        (cp - 32).unsafe_to_char().to_string()
      } else if c > 1032 && cp != 0x7f && cp <= 0x10FFFF {
        cp.unsafe_to_char().to_string()
      } else {
        "#" + c.to_string()
      }
    }
  }
}

/// The keycaps of `stroke` as a person reads them, one for each modifier held and then its key.
pub fn stroke_caps(stroke : view::Stroke, apple~ : Bool) -> Array[String] {
  let caps : Array[String] = []
  let held = fn(bit : Int) -> Bool { (stroke.mods & bit) != 0 }
  let order : Array[(Int, String)] = if apple {
    [(mod_ctrl, "⌃"), (mod_alt, "⌥"), (mod_shift, "⇧"), (mod_cmd, "⌘")]
  } else {
    [(mod_ctrl, "Ctrl"), (mod_alt, "Alt"), (mod_shift, "Shift"), (mod_cmd, "Win")]
  }
  for m in order {
    if held(m.0) {
      caps.push(m.1)
    }
  }
  caps.push(key_cap(stroke.code, apple))
  caps
}

/// `stroke` as one shortcut a person reads.
pub fn format_stroke(stroke : view::Stroke, apple~ : Bool) -> String {
  let caps = stroke_caps(stroke, apple=apple)
  if !apple {
    return str_join(caps, "+")
  }
  let n = caps.length()
  let key = caps[n - 1]
  let mod_parts = view::array_slice_to(caps, n - 1)
  let mods = str_join(mod_parts, "")
  if mods != "" && key.length() > 1 {
    mods + " " + key
  } else {
    mods + key
  }
}

/// Keys one after another (a chord) as a person reads them.
pub fn format_chord(strokes : Array[view::Stroke], apple~ : Bool) -> String {
  let parts : Array[String] = view::array_map(strokes, fn(s : view::Stroke) -> String {
    format_stroke(s, apple=apple)
  })
  str_join(parts, " ")
}
