// The accordion: a stack of sections, each a header that opens or closes its panel.
// Ported 1:1 from libs/mbui/src/headless/accordion.mbt.

import "view"

/// Whether one section is open at a time (`Single`) or each its own (`Multiple`).
#derive(Eq)
pub enum AccordionKind {
  Single(Bool)
  Multiple
}

/// An accordion handed to its look to make its headers and panels by (`Accordion::trigger`, `Accordion::panel`).
pub struct Accordion[K] {
  kind : AccordionKind
  is_open : (K) -> Bool
  on_toggle : (K) -> Unit
  off : () -> Bool
  heads : RovingFocus
}

pub fn Accordion::disabled[K](self : Accordion[K]) -> Bool {
  (self.off)()
}

pub fn Accordion::is_open[K](self : Accordion[K], key : K) -> Bool {
  (self.is_open)(key)
}

pub fn Accordion::focus_first[K](self : Accordion[K], visible~ : Bool = true) -> Bool {
  self.heads.focus_first(visible=visible)
}

/// An accordion in `parent` (`parent` itself where `in_node`).
pub fn accordion[K](
  parent : view::View,
  is_open : (K) -> Bool,
  on_toggle : (K) -> Unit,
  look : (view::View, Accordion[K]) -> Unit,
  kind~ : AccordionKind = AccordionKind::Single(true),
  vertical~ : Bool = true,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let axis = if vertical { GroupAxis::Vertical } else { GroupAxis::Horizontal }
  let heads = RovingFocus::new(axis=axis, roving=false, wraps=wraps, rtl=rtl)
  let a : Accordion[K] = Accordion::{ kind, is_open, on_toggle, off: disabled, heads }
  let setup = fn(v : view::View) {
    look(v, a)
    let _ = v.on_key(fn(k : view::Key) -> Bool {
      if k.mods != 0 || disabled() {
        return false
      }
      heads.step(k.code) is Some(_)
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// The header of the section of `key` in `parent`, called `label`.
pub fn Accordion::trigger[K](
  self : Accordion[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View, Disclosure) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off = fn() -> Bool { (self.off)() || disabled() }
  let press = fn(_v : view::View) {
    let open = (self.is_open)(key)
    match self.kind {
      Single(collapsible) => if !open || collapsible { (self.on_toggle)(key) }
      Multiple => (self.on_toggle)(key)
    }
  }
  disclosure(
    parent,
    label,
    fn() -> Bool { (self.is_open)(key) },
    press,
    fn(v : view::View, d : Disclosure) {
      self.heads.add(v, off=off)
      look(v, d)
    },
    disabled=off,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
}

/// The panel of the section of `key` in `parent`, read out a `Region` called `label`.
pub fn Accordion::panel[K](
  self : Accordion[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View) -> Unit,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let open = fn() -> Bool { (self.is_open)(key) }
    look(v)
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] { Some(view::said(view::Role::Region, label=label())) }))
      .hides(view::Live::By(fn() -> Bool { !open() }))
      .presses(view::Live::By(open))
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
