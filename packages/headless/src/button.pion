// The button: what is pressed to do one thing.
// Ported 1:1 from libs/mbui/src/headless/button.mbt.

import "view"

/// A finger's long press beside a control's press, and what a press's look hears of the pointer.
pub struct Hold {
  pub slop : Double
  pub ms : Double
  pub finger : () -> Bool
  pub on_hold : () -> Unit
  pub on_lift : () -> Unit
  pub on_cancel : () -> Unit
  pub down : Option[((view::Drag) -> Unit)]
  pub tapped : Option[((view::Drag) -> Unit)]
  pub taps : () -> Bool
}

/// A `Hold` of `slop`, `ms` and `finger`, with callbacks.
pub fn Hold::new(
  slop : Double,
  ms : Double,
  finger : () -> Bool,
  on_hold~ : () -> Unit = fn() { () },
  on_lift~ : () -> Unit = fn() { () },
  on_cancel~ : () -> Unit = fn() { () },
  down? : (view::Drag) -> Unit,
  tapped? : (view::Drag) -> Unit,
  taps~ : () -> Bool = fn() { true },
) -> Hold {
  Hold::{ slop, ms, finger, on_hold, on_lift, on_cancel, down, tapped, taps }
}

/// Attach `hold` to `v`: its gesture ending in `v.press()` where a press counts, and calling `hold`'s callbacks.
fn attach_hold(v : view::View, hold : Hold, pending~ : () -> Bool = fn() { false }) -> Unit {
  let held = view::ref_new(false)
  let tap_on = view::ref_new(true)
  let on_it = fn(d : view::Drag) -> Bool { tap_on.v && v.finger_target(d.wx, d.wy) }
  let _ = v.gesture(
    hold.slop,
    press=fn(d : view::Drag) {
      tap_on.v = (hold.taps)()
      match hold.down {
        Some(f) => f(d)
        None => ()
      }
    },
    tap=fn(d : view::Drag) {
      match hold.tapped {
        Some(f) => f(d)
        None => ()
      }
      if on_it(d) {
        let _ = v.press()
      }
    },
    hold=(
      hold.ms,
      fn(_d : view::Drag) {
        if pending() {
          return
        }
        held.v = true
        if (hold.finger)() {
          (hold.on_hold)()
        }
      },
    ),
    drag=fn(d : view::Drag) {
      if !held.v {
        if d.kind == view::DragIs::Up && !(hold.finger)() && on_it(d) {
          let _ = v.press()
        }
      } else if d.kind == view::DragIs::Up || d.kind == view::DragIs::Off {
        held.v = false
        match d.kind {
          Off => (hold.on_cancel)()
          Up => {
            if (hold.finger)() {
              (hold.on_lift)()
            } else if on_it(d) {
              let _ = v.press()
            }
          }
          _ => ()
        }
      }
    },
  )
}

/// A button as its look reads it: each a reading, followed where a binding reads it.
pub struct Button {
  node : view::View
  off : () -> Bool
  pending_ : () -> Bool
}

/// Whether it is disabled: it takes no press and no focus.
pub fn Button::disabled(self : Button) -> Bool {
  (self.off)()
}

/// Whether it is pending (busy): it blocks click and keyboard re-entry while remaining mounted.
pub fn Button::pending(self : Button) -> Bool {
  (self.pending_)()
}

/// Whether a finger or the pointer is held on it now.
pub fn Button::pressed(self : Button) -> Bool {
  self.node.pressed()
}

/// Whether a pointer rests over it now.
pub fn Button::hovered(self : Button) -> Bool {
  self.node.pointed()
}

/// Whether it has the keyboard's focus and that shows.
pub fn Button::focus_shown(self : Button) -> Bool {
  self.node.focus_shown()
}

/// Pressed now, for what a look adds that ends in a press.
pub fn Button::press(self : Button) -> Unit {
  let _ = self.node.press()
}

/// A button in `parent`, called `label`, `press` done as it is pressed.
pub fn button(
  parent : view::View,
  label : () -> String,
  press : (view::View) -> Unit,
  look : (view::View, Button) -> Unit,
  disabled? : () -> Bool,
  pending~ : () -> Bool = fn() { false },
  default_on? : () -> Bool,
  hold? : Hold,
  focusable~ : Bool = true,
  value? : () -> String,
  range? : () -> Option[(Double, Double, Double)],
  label_is? : String,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let off : () -> Bool = match disabled {
    Some(f) => f
    None => fn() -> Bool { false }
  }
  let active = fn() -> Bool { !off() && !pending() }
  let made = fn(v : view::View) {
    look(v, Button::{ node: v, off, pending_: pending })
    match hold {
      Some(h) => attach_hold(v, h, pending=pending)
      None => ()
    }
    match (label_is, disabled, value, range) {
      (Some(name), None, None, None) => {
        let _ = v
          .presses(view::Live::Is(true))
          .says(view::Live::By(fn() -> Option[view::Said] {
            Some(view::said(view::Role::Button, label=name, busy=pending()))
          }))
        if focusable {
          let _ = v.focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
        }
      }
      _ => {
        let able = fn() -> Bool { !off() }
        let _ = v.presses(view::Live::By(able)).says(view::Live::By(fn() -> Option[view::Said] {
          let words = match value {
            Some(f) => f()
            None => ""
          }
          let is_busy = pending()
          match range {
            Some(r) =>
              match r() {
                Some(at) => Some(view::said(view::Role::Button, label=label(), value=words, range=at, busy=is_busy))
                None => Some(view::said(view::Role::Button, label=label(), value=words, busy=is_busy))
              }
            None => Some(view::said(view::Role::Button, label=label(), value=words, busy=is_busy))
          }
        }))
        if focusable {
          let _ = v.focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space)
        }
      }
    }
    let _ = v.on_press(fn() {
      if active() {
        press(v)
      }
    })
    match default_on {
      Some(f) => { let _ = v.default_press(view::Live::By(f)) }
      None => ()
    }
  }
  if in_node {
    made(parent)
    parent
  } else {
    parent.box(made, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
