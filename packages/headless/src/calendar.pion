// Headless Calendar, RangeCalendar, and CalendarYearPicker backed by deterministic ISO Gregorian math.
// Uses `Role::Grid` / `Role::GridCell`, `multiselectable`, `current=Some("date")` for today,
// `min`/`max`/unavailable dates, hover preview, range normalization, and paged year selection.

import "headless_core"
import "signals"
import "view"

fn iso_date_eq(a : headless_core::IsoDate, b : headless_core::IsoDate) -> Bool {
  a == b
}

fn opt_iso_date_eq(a : Option[headless_core::IsoDate], b : Option[headless_core::IsoDate]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

/// Headless single-date Calendar controller.
pub struct Calendar {
  node : view::View
  focused_sig : signals::Signal[headless_core::IsoDate]
  selected_ : () -> Option[headless_core::IsoDate]
  on_select : (headless_core::IsoDate) -> Unit
  today_ : () -> Option[headless_core::IsoDate]
  min : Option[headless_core::IsoDate]
  max : Option[headless_core::IsoDate]
  is_unavailable : (headless_core::IsoDate) -> Bool
  first_day_of_week : Int
  off : () -> Bool
  day_nodes : Array[(headless_core::IsoDate, view::View)]
  pending_focus : signals::Ref[Bool]
}

fn cal_resolve_available(
  target : headless_core::IsoDate,
  step : Int,
  min : Option[headless_core::IsoDate],
  max : Option[headless_core::IsoDate],
  is_unavailable : (headless_core::IsoDate) -> Bool,
) -> Option[headless_core::IsoDate] {
  let dir = if step >= 0 { 1 } else { -1 }
  let mut cur = target
  let mut tries = 0
  while tries < 60 {
    match min {
      Some(mn) if dir < 0 && headless_core::iso_compare(cur, mn) < 0 => return None
      _ => ()
    }
    match max {
      Some(mx) if dir > 0 && headless_core::iso_compare(cur, mx) > 0 => return None
      _ => ()
    }
    if !headless_core::calendar_is_unavailable(cur, min, max, is_unavailable) {
      return Some(cur)
    }
    cur = headless_core::iso_add_days(cur, dir)
    tries += 1
  }
  None
}

fn cal_focus_day_node(day_nodes : Array[(headless_core::IsoDate, view::View)], d : headless_core::IsoDate) -> Bool {
  for entry in day_nodes {
    if entry.0 == d && entry.1.alive() && entry.1.ask_focus(visible=true) {
      return true
    }
  }
  false
}

fn Calendar::focus_day_node(self : Calendar, d : headless_core::IsoDate) -> Bool {
  cal_focus_day_node(self.day_nodes, d)
}

fn Calendar::move_to(self : Calendar, target : headless_core::IsoDate, step : Int, keep_focus : Bool) -> Bool {
  match cal_resolve_available(target, step, self.min, self.max, self.is_unavailable) {
    Some(next) => {
      self.focused_sig.set(next)
      if keep_focus {
        if self.focus_day_node(next) {
          self.pending_focus.v = false
        } else {
          self.pending_focus.v = true
        }
      }
      true
    }
    None => false
  }
}

pub fn Calendar::node(self : Calendar) -> view::View {
  self.node
}

pub fn Calendar::focused_date(self : Calendar) -> headless_core::IsoDate {
  self.focused_sig.get()
}

pub fn Calendar::visible_year(self : Calendar) -> Int {
  self.focused_sig.get().year
}

pub fn Calendar::visible_month(self : Calendar) -> Int {
  self.focused_sig.get().month
}

pub fn Calendar::cells(self : Calendar) -> Array[headless_core::CalendarCell] {
  let d = self.focused_sig.get()
  headless_core::calendar_month_grid(d.year, d.month, first_day_of_week=self.first_day_of_week)
}

pub fn Calendar::is_disabled_date(self : Calendar, d : headless_core::IsoDate) -> Bool {
  (self.off)() || headless_core::calendar_is_unavailable(d, self.min, self.max, self.is_unavailable)
}

pub fn Calendar::is_selected(self : Calendar, d : headless_core::IsoDate) -> Bool {
  match (self.selected_)() {
    Some(s) => s == d
    None => false
  }
}

pub fn Calendar::is_today(self : Calendar, d : headless_core::IsoDate) -> Bool {
  match (self.today_)() {
    Some(t) => t == d
    None => false
  }
}

pub fn Calendar::set_focused_date(self : Calendar, d : headless_core::IsoDate) -> Unit {
  self.focused_sig.set(d)
}

pub fn Calendar::prev_month(self : Calendar) -> Unit {
  let target = headless_core::iso_add_months(self.focused_sig.untracked(), -1)
  let _ = self.move_to(target, -1, focus_in(self.node, true))
}

pub fn Calendar::next_month(self : Calendar) -> Unit {
  let target = headless_core::iso_add_months(self.focused_sig.untracked(), 1)
  let _ = self.move_to(target, 1, focus_in(self.node, true))
}

pub fn Calendar::select(self : Calendar, d : headless_core::IsoDate) -> Bool {
  if self.is_disabled_date(d) {
    return false
  }
  self.focused_sig.set(d)
  (self.on_select)(d)
  true
}

/// Move focused date by `delta` days, skipping unavailable dates (up to 60 steps).
pub fn Calendar::move_days(self : Calendar, delta : Int) -> headless_core::IsoDate {
  let step = if delta >= 0 { 1 } else { -1 }
  let target = headless_core::iso_add_days(self.focused_sig.untracked(), delta)
  let _ = self.move_to(target, step, focus_in(self.node, true))
  self.focused_sig.untracked()
}

let cal_key_page_up : Int = headless_core::key_page_up
let cal_key_page_down : Int = headless_core::key_page_down

/// Mount a headless single-date `Calendar` (`Role::Grid`).
pub fn calendar(
  parent : view::View,
  label : () -> String,
  initial_focus : headless_core::IsoDate,
  selected : () -> Option[headless_core::IsoDate],
  on_select : (headless_core::IsoDate) -> Unit,
  look : (view::View, Calendar) -> Unit,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let cal = Calendar::{
      node: v,
      focused_sig: signals::signal_by(initial_focus, iso_date_eq),
      selected_: selected,
      on_select,
      today_: today,
      min,
      max,
      is_unavailable,
      first_day_of_week,
      off: disabled,
      day_nodes: [],
      pending_focus: view::ref_new(false),
    }
    look(v, cal)
    let _ = v
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Grid, label=label()))
    }))
    .on_key(fn(k : view::Key) -> Bool {
      if disabled() || !focus_in(v, true) {
        return false
      }
      if k.mods == 0 {
        if k.code == grid_key_left {
          let _ = cal.move_days(-1)
          return true
        } else if k.code == grid_key_right {
          let _ = cal.move_days(1)
          return true
        } else if k.code == group_key_up {
          let _ = cal.move_days(-7)
          return true
        } else if k.code == group_key_down {
          let _ = cal.move_days(7)
          return true
        } else if k.code == cal_key_page_up {
          cal.prev_month()
          return true
        } else if k.code == cal_key_page_down {
          cal.next_month()
          return true
        } else if k.code == combo_key_enter || k.code == combo_key_space {
          return cal.select(cal.focused_sig.untracked())
        }
      } else if k.mods == shift_mod {
        if k.code == cal_key_page_up {
          let target = headless_core::iso_add_years(cal.focused_sig.untracked(), -1)
          let _ = cal.move_to(target, -1, true)
          return true
        } else if k.code == cal_key_page_down {
          let target = headless_core::iso_add_years(cal.focused_sig.untracked(), 1)
          let _ = cal.move_to(target, 1, true)
          return true
        }
      }
      false
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount one day cell (`Role::GridCell`) inside `Calendar`.
pub fn Calendar::day_cell(
  self : Calendar,
  parent : view::View,
  date : headless_core::IsoDate,
  look : (view::View, () -> Bool, () -> Bool) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { self.is_disabled_date(date) }
    let able = fn() -> Bool { !off() }
    let sel = fn() -> Bool { self.is_selected(date) }
    let today = fn() -> Bool { self.is_today(date) }
    self.day_nodes.push((date, v))
    let _ = v.owns(fn() {
      view::array_retain(self.day_nodes, fn(e : (headless_core::IsoDate, view::View)) -> Bool { e.1.id() != v.id() })
    })
    look(v, sel, off)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
    .tab_stop(view::Live::By(fn() -> Bool { self.focused_date() == date }))
    .says(view::Live::By(fn() -> Option[view::Said] {
      let cur = if today() { Some("date") } else { None }
      Some(view::said(
        view::Role::GridCell,
        label=headless_core::iso_format(date),
        selected=sel(),
        current=cur,
      ))
    }))
    .on_press(fn() {
      let _ = self.select(date)
    })
    if self.pending_focus.v && self.focused_sig.untracked() == date && !self.is_disabled_date(date) {
      if v.ask_focus(visible=true) {
        self.pending_focus.v = false
      }
    }
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Headless RangeCalendar controller: start/end selection with automatic normalization,
/// hover preview range, Escape cancellation of partial selection, and `multiselectable=true`.
pub struct RangeCalendar {
  node : view::View
  focused_sig : signals::Signal[headless_core::IsoDate]
  anchor_sig : signals::Signal[Option[headless_core::IsoDate]]
  hover_sig : signals::Signal[Option[headless_core::IsoDate]]
  range_ : () -> Option[(headless_core::IsoDate, headless_core::IsoDate)]
  on_change : (headless_core::IsoDate, headless_core::IsoDate) -> Unit
  today_ : () -> Option[headless_core::IsoDate]
  min : Option[headless_core::IsoDate]
  max : Option[headless_core::IsoDate]
  is_unavailable : (headless_core::IsoDate) -> Bool
  first_day_of_week : Int
  off : () -> Bool
  day_nodes : Array[(headless_core::IsoDate, view::View)]
  pending_focus : signals::Ref[Bool]
}

fn RangeCalendar::focus_day_node(self : RangeCalendar, d : headless_core::IsoDate) -> Bool {
  cal_focus_day_node(self.day_nodes, d)
}

fn RangeCalendar::move_to(self : RangeCalendar, target : headless_core::IsoDate, step : Int, keep_focus : Bool) -> Bool {
  match cal_resolve_available(target, step, self.min, self.max, self.is_unavailable) {
    Some(next) => {
      self.focused_sig.set(next)
      if keep_focus {
        if self.focus_day_node(next) {
          self.pending_focus.v = false
        } else {
          self.pending_focus.v = true
        }
      }
      if self.anchor_sig.untracked() is Some(_) {
        self.hover_sig.set(Some(next))
      }
      true
    }
    None => false
  }
}

pub fn RangeCalendar::node(self : RangeCalendar) -> view::View {
  self.node
}

pub fn RangeCalendar::focused_date(self : RangeCalendar) -> headless_core::IsoDate {
  self.focused_sig.get()
}

pub fn RangeCalendar::cells(self : RangeCalendar) -> Array[headless_core::CalendarCell] {
  let d = self.focused_sig.get()
  headless_core::calendar_month_grid(d.year, d.month, first_day_of_week=self.first_day_of_week)
}

pub fn RangeCalendar::is_disabled_date(self : RangeCalendar, d : headless_core::IsoDate) -> Bool {
  (self.off)() || headless_core::calendar_is_unavailable(d, self.min, self.max, self.is_unavailable)
}

/// Active preview range `(start, end)` (normalized `start <= end`) while hovering after first click,
/// or the committed range otherwise.
pub fn RangeCalendar::highlighted_range(self : RangeCalendar) -> Option[(headless_core::IsoDate, headless_core::IsoDate)] {
  match self.anchor_sig.get() {
    Some(a) =>
    match self.hover_sig.get() {
      Some(h) => Some(headless_core::calendar_normalize_range(a, h))
      None => Some((a, a))
    }
    None => (self.range_)()
  }
}

pub fn RangeCalendar::is_in_range(self : RangeCalendar, d : headless_core::IsoDate) -> Bool {
  match self.highlighted_range() {
    Some((s, e)) => headless_core::iso_compare(d, s) >= 0 && headless_core::iso_compare(d, e) <= 0
    None => false
  }
}

pub fn RangeCalendar::set_hover(self : RangeCalendar, d : Option[headless_core::IsoDate]) -> Unit {
  self.hover_sig.set(d)
}

pub fn RangeCalendar::cancel_partial(self : RangeCalendar) -> Unit {
  self.anchor_sig.set(None)
  self.hover_sig.set(None)
}

/// Click/activate `d`: first click sets anchor; second click normalizes `(start, end)` and emits `on_change`.
pub fn RangeCalendar::select(self : RangeCalendar, d : headless_core::IsoDate) -> Bool {
  if self.is_disabled_date(d) {
    return false
  }
  self.focused_sig.set(d)
  match self.anchor_sig.untracked() {
    None => {
      self.anchor_sig.set(Some(d))
      self.hover_sig.set(Some(d))
      true
    }
    Some(a) => {
      let (start, end) = headless_core::calendar_normalize_range(a, d)
      self.anchor_sig.set(None)
      self.hover_sig.set(None)
      (self.on_change)(start, end)
      true
    }
  }
}

/// Mount a headless `RangeCalendar` (`Role::Grid` with `multiselectable=true`).
pub fn range_calendar(
  parent : view::View,
  label : () -> String,
  initial_focus : headless_core::IsoDate,
  range : () -> Option[(headless_core::IsoDate, headless_core::IsoDate)],
  on_change : (headless_core::IsoDate, headless_core::IsoDate) -> Unit,
  look : (view::View, RangeCalendar) -> Unit,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let rc = RangeCalendar::{
      node: v,
      focused_sig: signals::signal_by(initial_focus, iso_date_eq),
      anchor_sig: signals::signal_by(None, opt_iso_date_eq),
      hover_sig: signals::signal_by(None, opt_iso_date_eq),
      range_: range,
      on_change,
      today_: today,
      min,
      max,
      is_unavailable,
      first_day_of_week,
      off: disabled,
      day_nodes: [],
      pending_focus: view::ref_new(false),
    }
    look(v, rc)
    let _ = v
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Grid, label=label(), multiselectable=true))
    }))
    .on_key(fn(k : view::Key) -> Bool {
      if disabled() || !focus_in(v, true) {
        return false
      }
      if k.mods == 0 {
        if k.code == menu_key_escape && rc.anchor_sig.untracked() is Some(_) {
          rc.cancel_partial()
          return true
        }
        let delta = if k.code == grid_key_left { -1 }
        else if k.code == grid_key_right { 1 }
        else if k.code == group_key_up { -7 }
        else if k.code == group_key_down { 7 }
        else { 0 }
        if delta != 0 {
          let step = if delta >= 0 { 1 } else { -1 }
          let next = headless_core::iso_add_days(rc.focused_sig.untracked(), delta)
          let _ = rc.move_to(next, step, true)
          return true
        }
        if k.code == cal_key_page_up {
          let target = headless_core::iso_add_months(rc.focused_sig.untracked(), -1)
          let _ = rc.move_to(target, -1, true)
          return true
        }
        if k.code == cal_key_page_down {
          let target = headless_core::iso_add_months(rc.focused_sig.untracked(), 1)
          let _ = rc.move_to(target, 1, true)
          return true
        }
        if k.code == combo_key_enter || k.code == combo_key_space {
          return rc.select(rc.focused_sig.untracked())
        }
      } else if k.mods == shift_mod {
        if k.code == cal_key_page_up {
          let target = headless_core::iso_add_years(rc.focused_sig.untracked(), -1)
          let _ = rc.move_to(target, -1, true)
          return true
        } else if k.code == cal_key_page_down {
          let target = headless_core::iso_add_years(rc.focused_sig.untracked(), 1)
          let _ = rc.move_to(target, 1, true)
          return true
        }
      }
      false
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount one day cell (`Role::GridCell`) inside `RangeCalendar`.
pub fn RangeCalendar::day_cell(
  self : RangeCalendar,
  parent : view::View,
  date : headless_core::IsoDate,
  look : (view::View, () -> Bool, () -> Bool) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { self.is_disabled_date(date) }
    let able = fn() -> Bool { !off() }
    let in_r = fn() -> Bool { self.is_in_range(date) }
    let is_today = fn() -> Bool {
      match (self.today_)() {
        Some(t) => t == date
        None => false
      }
    }
    self.day_nodes.push((date, v))
    let _ = v.owns(fn() {
      view::array_retain(self.day_nodes, fn(e : (headless_core::IsoDate, view::View)) -> Bool { e.1.id() != v.id() })
    })
    look(v, in_r, off)
    v.reacts(fn() -> Bool { v.pointed() }, fn(over : Bool) {
      if over && self.anchor_sig.untracked() is Some(_) {
        self.hover_sig.set(Some(date))
      }
    }, at_start=false)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
    .tab_stop(view::Live::By(fn() -> Bool { self.focused_date() == date }))
    .says(view::Live::By(fn() -> Option[view::Said] {
      let cur = if is_today() { Some("date") } else { None }
      Some(view::said(view::Role::GridCell, label=headless_core::iso_format(date), selected=in_r(), current=cur))
    }))
    .on_press(fn() { let _ = self.select(date) })
    if self.pending_focus.v && self.focused_sig.untracked() == date && !self.is_disabled_date(date) {
      if v.ask_focus(visible=true) {
        self.pending_focus.v = false
      }
    }
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Paged `CalendarYearPicker` controller (`Role::Grid`).
pub struct CalendarYearPicker {
  node : view::View
  anchor_sig : signals::Signal[Int]
  page_size : Int
  selected_ : () -> Int
  on_select : (Int) -> Unit
  min_year : Option[Int]
  max_year : Option[Int]
  off : () -> Bool
  roving : RovingFocus
}

pub fn CalendarYearPicker::node(self : CalendarYearPicker) -> view::View {
  self.node
}

pub fn CalendarYearPicker::years(self : CalendarYearPicker) -> Array[Int] {
  headless_core::calendar_year_page(self.anchor_sig.get(), page_size=self.page_size)
}

pub fn CalendarYearPicker::prev_page(self : CalendarYearPicker) -> Unit {
  self.anchor_sig.set(self.anchor_sig.untracked() - self.page_size)
}

pub fn CalendarYearPicker::next_page(self : CalendarYearPicker) -> Unit {
  self.anchor_sig.set(self.anchor_sig.untracked() + self.page_size)
}

pub fn CalendarYearPicker::is_disabled_year(self : CalendarYearPicker, year : Int) -> Bool {
  if (self.off)() { return true }
  match self.min_year {
    Some(lo) => if year < lo { return true }
    None => ()
  }
  match self.max_year {
    Some(hi) => if year > hi { return true }
    None => ()
  }
  false
}

/// Mount a headless paged `CalendarYearPicker` (`Role::Grid`).
pub fn calendar_year_picker(
  parent : view::View,
  label : () -> String,
  selected_year : () -> Int,
  on_select : (Int) -> Unit,
  look : (view::View, CalendarYearPicker) -> Unit,
  page_size~ : Int = 12,
  min_year? : Int,
  max_year? : Int,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let sz = if page_size < 1 { 12 } else { page_size }
  let setup = fn(v : view::View) {
    let yp = CalendarYearPicker::{
      node: v,
      anchor_sig: signals::signal(signals::untracked(selected_year)),
      page_size: sz,
      selected_: selected_year,
      on_select,
      min_year,
      max_year,
      off: disabled,
      roving: RovingFocus::new(axis=GroupAxis::Both, roving=true, wraps=false),
    }
    look(v, yp)
    let _ = v
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Grid, label=label()))
    }))
    .on_key(fn(k : view::Key) -> Bool {
      if disabled() || k.mods != 0 || !focus_in(v, false) {
        return false
      }
      if k.code == cal_key_page_up {
        yp.prev_page()
        return true
      }
      if k.code == cal_key_page_down {
        yp.next_page()
        return true
      }
      yp.roving.step(k.code) is Some(_)
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount one year cell (`Role::GridCell`) inside `CalendarYearPicker`.
pub fn CalendarYearPicker::year_cell(
  self : CalendarYearPicker,
  parent : view::View,
  year : Int,
  look : (view::View, () -> Bool, () -> Bool) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { self.is_disabled_year(year) }
    let able = fn() -> Bool { !off() }
    let sel = fn() -> Bool { (self.selected_)() == year }
    look(v, sel, off)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::GridCell, label="\{year}", selected=sel()))
    }))
    .on_press(fn() {
      if able() {
        (self.on_select)(year)
      }
    })
    self.roving.add(v, off=off, first=sel)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
