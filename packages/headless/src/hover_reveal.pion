// What shows on hover: secondary actions seen only while pointer is over host or focus is shown.
// Ported 1:1 from libs/mbui/src/headless/hover_reveal.mbt.

import "view"

/// What a look reads of an action shown on hover (`hover_reveal`).
pub struct HoverReveal {
  shown : () -> Bool
}

/// Whether the action shows now.
pub fn HoverReveal::shown(self : HoverReveal) -> Bool {
  (self.shown)()
}

/// `action` shown while the pointer is over `host`, taken by the hand only while it shows.
pub fn hover_reveal(
  host : view::View,
  action : view::View,
  also~ : Array[view::View] = [],
  always~ : () -> Bool = fn() { false },
) -> HoverReveal {
  let targets : Array[view::View] = [action]
  for a in also {
    targets.push(a)
  }
  let shown = fn() -> Bool {
    always() ||
    host.pointed() ||
    host.pointed_in() ||
    action.pointed() ||
    action.pointed_in() ||
    view::array_any(targets, fn(t : view::View) -> Bool { t.focus_shown() })
  }
  for t in targets {
    let _ = t.takes(fn(w : Double, h : Double, _at : Double) -> Array[(Double, Double, Double, Double)] {
      if shown() {
        [(0.0, 0.0, w, h)]
      } else {
        let empty : Array[(Double, Double, Double, Double)] = []
        empty
      }
    })
  }
  HoverReveal::{ shown }
}
