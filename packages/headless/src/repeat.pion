// Frame-rate-independent hold-to-repeat primitive built on `View::at_moment`.

import "signals"
import "view"

/// Attach hold-to-repeat behavior to `v`: while `v.pressed()` holds and `!disabled()`,
/// waits `delay_ms` (default 400ms) and then repeatedly invokes `fire()` every `interval_ms` (default 70ms).
/// Automatically cancels on release, disable, or unmount. Returns a manual cancel function.
pub fn repeat_hold(
  v : view::View,
  fire : () -> Unit,
  delay_ms~ : Double = 400.0,
  interval_ms~ : Double = 70.0,
  disabled~ : () -> Bool = fn() { false },
  immediate~ : Bool = false,
) -> () -> Unit {
  let step_ms = if interval_ms > 1.0 { interval_ms } else { 1.0 }
  let wait_ms = if delay_ms >= 0.0 { delay_ms } else { 0.0 }
  let running = view::ref_new(false)
  let cancel_timer : view::Ref[() -> Unit] = view::ref_new(fn() { () })
  let stop = fn() {
    running.v = false
    (cancel_timer.v)()
    cancel_timer.v = fn() { () }
  }
  let schedule_ref : view::Ref[(Double) -> Unit] = view::ref_new(fn(_at : Double) { () })
  schedule_ref.v = fn(at : Double) {
    cancel_timer.v = v.at_moment(at, fn() {
      cancel_timer.v = fn() { () }
      if !running.v || !v.alive() || v.leaving() || !signals::untracked(fn() -> Bool { v.pressed() }) || signals::untracked(disabled) {
        stop()
        return
      }
      fire()
      if running.v && v.alive() && !v.leaving() && signals::untracked(fn() -> Bool { v.pressed() }) && !signals::untracked(disabled) {
        let next_at = at + step_ms
        (schedule_ref.v)(next_at)
      } else {
        stop()
      }
    })
  }
  v.reacts(fn() -> Bool { v.pressed() }, fn(down : Bool) {
    if down {
      if signals::untracked(disabled) || !v.alive() || v.leaving() {
        stop()
        return
      }
      stop()
      running.v = true
      if immediate {
        fire()
      }
      if running.v && v.alive() && !v.leaving() && !signals::untracked(disabled) {
        (schedule_ref.v)(v.cause_at() + wait_ms)
      }
    } else {
      stop()
    }
  })
  v.reacts(disabled, fn(off : Bool) {
    if off {
      stop()
    }
  }, at_start=false)
  let _ = v.owns(fn() {
    stop()
    schedule_ref.v = fn(_at : Double) { () }
  })
  stop
}
