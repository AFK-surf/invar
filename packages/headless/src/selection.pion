// Selection model for single-select and multi-select (toggle, range, select-all, clear).
// Pure reactive selection state delegated to `headless_core::SelectionCore`.

import "headless_core"
import "view"

/// Anchor-aware selection model supporting single and multiple selection modes.
pub struct SelectionModel[K] {
  core : headless_core::SelectionCore[K]
}

/// Create a `SelectionModel[K]` in single (`multiple=false`) or multi-select (`multiple=true`) mode.
pub fn SelectionModel::new[K](multiple~ : Bool = false) -> SelectionModel[K] {
  SelectionModel::{ core: headless_core::SelectionCore::new(multiple=multiple) }
}

/// Whether multiple items may be selected at once.
pub fn SelectionModel::multiple[K](self : SelectionModel[K]) -> Bool {
  self.core.multiple()
}

/// Current range-selection anchor key, if any.
pub fn SelectionModel::anchor[K](self : SelectionModel[K]) -> Option[K] {
  self.core.anchor()
}

/// Set or clear the range-selection anchor key.
pub fn SelectionModel::set_anchor[K](self : SelectionModel[K], key : Option[K]) -> Unit {
  self.core.set_anchor(key)
}

/// Toggle `key` against `current` selection and update the anchor to `Some(key)`.
pub fn SelectionModel::toggle[K : Eq](
  self : SelectionModel[K],
  current : Array[K],
  key : K,
) -> Array[K] {
  self.core.toggle_by(current, key, fn(a : K, b : K) -> Bool { (a == b) })
}

/// Select the contiguous range in `order` from the current anchor to `target` (inclusive).
/// If no valid anchor exists in `order`, sets the anchor to `target` and selects `[target]`.
pub fn SelectionModel::select_range[K : Eq](
  self : SelectionModel[K],
  order : Array[K],
  target : K,
) -> Array[K] {
  self.core.select_range_by(order, target, fn(a : K, b : K) -> Bool { (a == b) })
}

/// Select all keys in `order` (or the first key in single-select mode).
pub fn SelectionModel::select_all[K](self : SelectionModel[K], order : Array[K]) -> Array[K] {
  self.core.select_all(order)
}

/// Clear selection and reset the anchor.
pub fn SelectionModel::clear[K](self : SelectionModel[K]) -> Array[K] {
  self.core.clear()
}
