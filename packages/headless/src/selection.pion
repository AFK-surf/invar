import "mbt_compat"

// Selection model: pure headless state transitions for single and multiple selection with anchor memory (toggle,
// contiguous range selection skipping disabled items, select all, clear). Nothing here is drawn, laid out or read out.

///|
/// Headless selection state calculator with anchor tracking for range selection.
pub struct SelectionModel[K] {
  priv multiple : Bool
  priv anchor_ref : mbt_compat::Ref[Option[K]]
}

///|
/// A new selection model (`multiple=false` for single-select, `multiple=true` for multi-select with range/select-all).
pub fn SelectionModel::new[K](multiple? : Bool) -> SelectionModel[K] {
  let multiple = match multiple { Some(__mbt_v) => __mbt_v, None => false }

  SelectionModel::{ multiple: multiple, anchor_ref: mbt_compat::ref_new(None) }
}

///|
/// The current anchor key for range selection, if any.
pub fn SelectionModel::anchor[K](self : SelectionModel[K]) -> Option[K] {
  self.anchor_ref.v
}

///|
/// Set or clear the anchor key used as the start of range selection.
pub fn SelectionModel::set_anchor[K](self : SelectionModel[K], key : Option[K]) -> Unit {
  self.anchor_ref.v = key
}

///|
/// Toggle `key` against `current` and update the anchor to `Some(key)`. In single-select mode, returns `[key]`; in
/// multi-select mode, removes `key` if present or appends it otherwise.
pub fn SelectionModel::toggle[K : Eq](self : SelectionModel[K], current : Array[K], key : K) -> Array[K] {
  self.anchor_ref.v = Some(key)
  if !self.multiple {
    return [key]
  }
  if current.contains(key) {
    mbt_compat::arr_filter(current, fn(x) { x != key })
  } else {
    mbt_compat::arr_concat(current, [key])
  }
}

///|
/// Select the contiguous range of non-disabled keys in `keys` from the current `anchor` to `to`. When `multiple` is
/// false or no anchor is present in `keys`, sets the anchor to `to` and selects `[to]` (unless disabled). Preserves
/// the existing anchor when extending or shrinking a multi-select range.
pub fn SelectionModel::select_range[K : Eq](self : SelectionModel[K], keys : Array[K], current : Array[K], to : K, disabled? : (K) -> Bool) -> Array[K] {
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn(_) { false } }

  if !self.multiple {
    self.anchor_ref.v = Some(to)
    return if disabled(to) { current } else { [to] }
  }
  guard mbt_compat::arr_search(keys, to) is Option::Some(to_idx) else { return current }
  let anchor_idx = match self.anchor_ref.v {
    Some(a) => mbt_compat::arr_search(keys, a)
    Option::None => Option::None
  }
  match anchor_idx {
    Option::None => {
      self.anchor_ref.v = Some(to)
      if disabled(to) {
        current
      } else {
        [to]
      }
    }
    Option::Some(from_idx) => {
      let (lo, hi) = if from_idx <= to_idx { (from_idx, to_idx) } else { (to_idx, from_idx) }
      let out : Array[K] = []
      for i in lo..=hi {
        let k = keys[i]
        if !disabled(k) {
          out.push(k)
        }
      }
      out
    }
  }
}

///|
/// Select all non-disabled keys in `keys` (returns empty in single-select mode).
pub fn SelectionModel::select_all[K](self : SelectionModel[K], keys : Array[K], disabled? : (K) -> Bool) -> Array[K] {
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn(_) { false } }

  if !self.multiple {
    return []
  }
  mbt_compat::arr_filter(keys, fn(k) { !disabled(k) })
}

///|
/// Clear selection and reset the anchor.
pub fn SelectionModel::clear[K](self : SelectionModel[K]) -> Array[K] {
  self.anchor_ref.v = None
  []
}
