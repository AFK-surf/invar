// Headless Breadcrumbs: `Role::Navigation`, last item `current=Some("page")`,
// and optional middle-item collapsing when `max_items` is exceeded.

import "signals"
import "view"

/// One visible entry in a collapsed or expanded breadcrumbs trail.
#derive(Eq)
pub enum BreadcrumbSlot {
  Item(Int)
  Ellipsis
}

/// Compute which item indices (0-based) are visible for `count` items under `max_items`
/// (keeping `items_before_collapse` at start and `items_after_collapse` at end).
pub fn breadcrumbs_collapse(
  count : Int,
  max_items : Int,
  items_before_collapse~ : Int = 1,
  items_after_collapse~ : Int = 2,
) -> Array[BreadcrumbSlot] {
  let out : Array[BreadcrumbSlot] = []
  if count <= 0 {
    return out
  }
  if max_items <= 0 || count <= max_items {
    let mut i = 0
    while i < count {
      out.push(BreadcrumbSlot::Item(i))
      i += 1
    }
    return out
  }
  let before = if items_before_collapse < 1 { 1 } else { items_before_collapse }
  let after = if items_after_collapse < 1 { 1 } else { items_after_collapse }
  if before + after >= count {
    let mut i = 0
    while i < count {
      out.push(BreadcrumbSlot::Item(i))
      i += 1
    }
    return out
  }
  let mut i = 0
  while i < before {
    out.push(BreadcrumbSlot::Item(i))
    i += 1
  }
  out.push(BreadcrumbSlot::Ellipsis)
  let mut j = count - after
  while j < count {
    out.push(BreadcrumbSlot::Item(j))
    j += 1
  }
  out
}

/// Headless breadcrumbs controller.
pub struct Breadcrumbs {
  node : view::View
  count_ : () -> Int
  max_items : Int
  items_before : Int
  items_after : Int
  expanded_sig : signals::Signal[Bool]
}

pub fn Breadcrumbs::node(self : Breadcrumbs) -> view::View {
  self.node
}

pub fn Breadcrumbs::expanded(self : Breadcrumbs) -> Bool {
  self.expanded_sig.get()
}

pub fn Breadcrumbs::expand(self : Breadcrumbs) -> Unit {
  self.expanded_sig.set(true)
}

pub fn Breadcrumbs::slots(self : Breadcrumbs) -> Array[BreadcrumbSlot] {
  let n = (self.count_)()
  if self.expanded_sig.get() {
    breadcrumbs_collapse(n, 0)
  } else {
    breadcrumbs_collapse(n, self.max_items, items_before_collapse=self.items_before, items_after_collapse=self.items_after)
  }
}

/// Mount a headless `Breadcrumbs` navigation landmark (`Role::Navigation`).
pub fn breadcrumbs(
  parent : view::View,
  count : () -> Int,
  look : (view::View, Breadcrumbs) -> Unit,
  label~ : () -> String = fn() { "Breadcrumb" },
  max_items~ : Int = 0,
  items_before_collapse~ : Int = 1,
  items_after_collapse~ : Int = 2,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let bc = Breadcrumbs::{
      node: v,
      count_: count,
      max_items,
      items_before: items_before_collapse,
      items_after: items_after_collapse,
      expanded_sig: signals::signal(false),
    }
    look(v, bc)
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Navigation, label=label()))
    }))
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount one breadcrumb item: non-last items are interactive `Role::Link`; the last item is
/// marked `current=Some("page")` and non-interactive by default.
pub fn Breadcrumbs::item(
  self : Breadcrumbs,
  parent : view::View,
  index : Int,
  label : () -> String,
  on_press : (view::View) -> Unit,
  look : (view::View, () -> Bool) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let is_current = fn() -> Bool {
    let n = (self.count_)()
    n > 0 && index == n - 1
  }
  let setup = fn(v : view::View) {
    let able = fn() -> Bool { !disabled() && !is_current() }
    look(v, is_current)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter)
    .says(view::Live::By(fn() -> Option[view::Said] {
      let cur = if is_current() { Some("page") } else { None }
      Some(view::said(view::Role::Link, label=label(), current=cur))
    }))
    .on_press(fn() {
      if able() {
        on_press(v)
      }
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
