  priv submit_on_blur_ : Bool
  priv trim_ : Bool
  priv cancel_if_empty_ : Bool
  priv cancel_if_unchanged_ : Bool
  priv commit_on_outside_press_ : Bool
  priv editing_ : signals::Signal[Bool]
  priv draft_ : signals::Signal[String]
