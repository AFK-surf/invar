  let trim = match trim { Some(__mbt_v) => __mbt_v, None => false }
  let cancel_if_empty = match cancel_if_empty { Some(__mbt_v) => __mbt_v, None => false }
  let cancel_if_unchanged = match cancel_if_unchanged { Some(__mbt_v) => __mbt_v, None => false }
  let start_editing = match start_editing { Some(__mbt_v) => __mbt_v, None => false }
