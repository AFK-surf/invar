// The dialog: modal dialog, alert dialog, or non-modal sheet.
// Ported 1:1 from libs/mbui/src/headless/dialog.mbt.

import "signals"
import "view"

/// What a dialog is to a screen reader: a `Dialog`, or an `AlertDialog`.
#derive(Eq)
pub enum DialogKind {
  Dialog
  AlertDialog
}

/// A dialog as its look reads it.
pub struct Dialog {
  node : view::View
  now : () -> Bool
  close : () -> Unit
}

pub fn Dialog::open(self : Dialog) -> Bool {
  (self.now)()
}

pub fn Dialog::focus_shown(self : Dialog) -> Bool {
  self.node.focus_shown()
}

pub fn Dialog::close(self : Dialog) -> Unit {
  (self.close)()
}

/// A dialog of `kind` in `parent`, called `label`, open while `open` says so.
pub fn dialog(
  parent : view::View,
  label : () -> String,
  open : () -> Bool,
  on_close : () -> Unit,
  look : (view::View, Dialog) -> Unit,
  kind~ : DialogKind = Dialog,
  description~ : () -> String = fn() { "" },
  modal~ : Bool = true,
  close_on_escape~ : Bool = true,
  close_on_outside~ : Bool = true,
  first_takes? : (view::Said) -> Bool,
  return_focus? : view::View,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let close = fn() {
      if signals::untracked(open) {
        on_close()
      }
    }
    look(v, Dialog::{ node: v, now: open, close })
    let _ = v.focus_opens_first(takes?=first_takes)
    match return_focus {
      Some(r) => { let _ = v.opened_by(view::Opener::ByNode(r.id())) }
      None => ()
    }
    if modal {
      let _ = v.modal(view::Live::By(open))
    }
    let _ = v
      .says(view::Live::By(fn() -> Option[view::Said] {
        let role : view::Role = match kind {
          Dialog => view::Role::Dialog
          AlertDialog => view::Role::AlertDialog
        }
        Some(view::said(role, label=label(), description=description()))
      }))
      .hides(view::Live::By(fn() -> Bool { !open() }))
      .presses(view::Live::By(open))
      .focusable(view::Live::By(open), keys=0, tab=false)
      .on_drag(fn(_d : view::Drag) { () })
      .on_key(fn(k : view::Key) -> Bool {
        if k.code == menu_key_escape && k.mods == 0 && close_on_escape && open() && focus_in(v, true) {
          close()
          true
        } else {
          false
        }
      })
      .takes_back(fn() {
        if close_on_escape {
          close()
        }
      })
    if close_on_outside {
      window_downs_while(v, open, fn(x : Double, y : Double) {
        if !press_on(v, x, y) {
          close()
        }
      })
    }
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
