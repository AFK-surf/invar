// The dialog: modal dialog, alert dialog, or non-modal sheet, unified onto `overlay_stack`.

import "signals"
import "view"

/// What a dialog is to a screen reader: a `Dialog`, or an `AlertDialog`.
#derive(Eq)
pub enum DialogKind {
  Dialog
  AlertDialog
}

/// A dialog as its look reads it.
pub struct Dialog {
  node : view::View
  now : () -> Bool
  close : () -> Unit
}

pub fn Dialog::open(self : Dialog) -> Bool {
  (self.now)()
}

pub fn Dialog::focus_shown(self : Dialog) -> Bool {
  self.node.focus_shown()
}

pub fn Dialog::close(self : Dialog) -> Unit {
  (self.close)()
}

/// A dialog of `kind` in `parent`, called `label`, open while `open` says so.
pub fn dialog(
  parent : view::View,
  label : () -> String,
  open : () -> Bool,
  on_close : () -> Unit,
  look : (view::View, Dialog) -> Unit,
  kind~ : DialogKind = Dialog,
  description~ : () -> String = fn() { "" },
  modal~ : Bool = true,
  close_on_escape~ : Bool = true,
  close_on_outside~ : Bool = true,
  before_dismiss? : (OverlayDismiss) -> Bool,
  first_takes? : (view::Said) -> Bool,
  return_focus? : view::View,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let close = fn() {
      if signals::untracked(open) {
        on_close()
      }
    }
    look(v, Dialog::{ node: v, now: open, close })
    let _ = attach_overlay(
      v,
      fn(_how : OverlayDismiss) { close() },
      modal,
      close_on_escape,
      close_on_outside,
      fn() -> Bool { !open() },
      fn() -> Option[view::View] { None },
      return_focus,
      true,
      first_takes,
      return_focus is Some(_),
      Some(fn() -> Bool { open() && focus_in(v, true) }),
      before_dismiss?=before_dismiss,
    )
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      let role : view::Role = match kind {
        Dialog => view::Role::Dialog
        AlertDialog => view::Role::AlertDialog
      }
      Some(view::said(role, label=label(), description=description()))
    }))
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
