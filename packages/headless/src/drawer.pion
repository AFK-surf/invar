// Headless Drawer / Sheet gesture state machine: unified onto `overlay` stack (`join_overlay` / `wire_overlay`),
// `DrawerEdge`, multi-point `snap_points`, velocity-threshold dismiss, and `can_drag` scroll-handoff guard.
// Pure drag/snap state machine delegated to `headless_core::DrawerSnapCore`.

import "headless_core"
import "signals"
import "view"

/// Which edge of the viewport the drawer slides in from.
#derive(Eq)
pub enum DrawerEdge {
  Bottom
  Top
  Left
  Right
}

fn to_core_drawer_edge(edge : DrawerEdge) -> headless_core::DrawerEdge {
  match edge {
    Bottom => headless_core::DrawerEdge::Bottom
    Top => headless_core::DrawerEdge::Top
    Left => headless_core::DrawerEdge::Left
    Right => headless_core::DrawerEdge::Right
  }
}

/// Drawer / Sheet handle passed to its look.
pub struct Drawer {
  node : view::View
  ov : Overlay
  edge_ : DrawerEdge
  now : () -> Bool
  close_fn : () -> Unit
  active_snap : () -> Int
  on_snap : Option[(Int) -> Unit]
  on_release : Option[(Double, Double, Bool) -> Unit]
  core : headless_core::DrawerSnapCore
}

pub fn Drawer::open(self : Drawer) -> Bool {
  (self.now)()
}

pub fn Drawer::edge(self : Drawer) -> DrawerEdge {
  self.edge_
}

pub fn Drawer::overlay(self : Drawer) -> Overlay {
  self.ov
}

pub fn Drawer::dragging(self : Drawer) -> Bool {
  self.core.dragging()
}

pub fn Drawer::drag_offset(self : Drawer) -> Double {
  self.core.drag_offset()
}

pub fn Drawer::last_velocity(self : Drawer) -> Double {
  self.core.last_velocity()
}

pub fn Drawer::last_offset(self : Drawer) -> Double {
  self.core.last_offset()
}

pub fn Drawer::snap_index(self : Drawer) -> Int {
  self.core.clamp_snap_index((self.active_snap)())
}

pub fn Drawer::snap_fraction(self : Drawer) -> Double {
  self.core.snap_fraction((self.active_snap)())
}

pub fn Drawer::snap_to(self : Drawer, idx : Int) -> Unit {
  let clamped = self.core.clamp_snap_index(idx)
  self.core.reset_drag()
  match self.on_snap {
    Some(f) => f(clamped)
    None => ()
  }
}

pub fn Drawer::close(self : Drawer) -> Unit {
  self.core.reset_drag()
  (self.close_fn)()
}

fn Drawer::resolve_extent(self : Drawer, d : view::Drag, extent_by : Option[() -> Double]) -> Double {
  match extent_by {
    Some(f) => {
      let e = f()
      if e > 0.0 {
        return e
      }
    }
    None => ()
  }
  let (_, _, rw, rh) = self.node.rect()
  match self.edge_ {
    Bottom | Top => if rh > 0.0 { rh } else if d.h > 0.0 { d.h } else { 300.0 }
    Left | Right => if rw > 0.0 { rw } else if d.w > 0.0 { d.w } else { 300.0 }
  }
}

fn Drawer::handle_release(self : Drawer, d : view::Drag, extent_by : Option[() -> Double]) -> Unit {
  let extent = self.resolve_extent(d, extent_by)
  match self.core.on_up(d.vx(), d.vy(), extent, self.snap_index()) {
    Some(headless_core::DrawerResolution::Close) => {
      match self.on_release {
        Some(f) => f(self.core.last_offset(), self.core.last_velocity(), true)
        None => ()
      }
      self.close()
    }
    Some(headless_core::DrawerResolution::Snap(idx)) => {
      match self.on_release {
        Some(f) => f(self.core.last_offset(), self.core.last_velocity(), false)
        None => ()
      }
      self.snap_to(idx)
    }
    None => ()
  }
}

fn Drawer::attach_drag(
  self : Drawer,
  target : view::View,
  extent_by~ : Option[() -> Double] = None,
  slop~ : Double = 0.0,
) -> Unit {
  let at_max = fn() -> Bool { self.core.is_at_max(self.snap_index()) }
  if slop > 0.0 {
    let down_pt : view::Ref[Option[(Double, Double)]] = view::ref_new(None)
    let _ = target.gesture(
      slop,
      press=fn(d : view::Drag) {
        if signals::untracked(self.now) {
          down_pt.v = Some((d.wx, d.wy))
        }
      },
      drag=fn(d : view::Drag) {
        if !signals::untracked(self.now) {
          down_pt.v = None
          return
        }
        match d.kind {
          Down => {
            let (sx, sy) = match down_pt.v {
              Some(pt) => pt
              None => (d.wx, d.wy)
            }
            let _ = self.core.on_down(sx, sy)
            let _ = self.core.on_move(d.wx, d.wy, at_max=at_max())
          }
          Moved => {
            if !self.core.dragging() {
              let (sx, sy) = match down_pt.v {
                Some(pt) => pt
                None => (d.wx, d.wy)
              }
              let _ = self.core.on_down(sx, sy)
            }
            let _ = self.core.on_move(d.wx, d.wy, at_max=at_max())
          }
          Up => {
            down_pt.v = None
            self.handle_release(d, extent_by)
          }
          Off => {
            down_pt.v = None
            self.core.on_cancel()
          }
        }
      },
    )
    return
  }
  let _ = target.on_drag(fn(d : view::Drag) {
    if !signals::untracked(self.now) {
      return
    }
    match d.kind {
      Down => {
        let _ = self.core.on_down(d.wx, d.wy)
      }
      Moved => {
        let _ = self.core.on_move(d.wx, d.wy, at_max=at_max())
      }
      Up => self.handle_release(d, extent_by)
      Off => self.core.on_cancel()
    }
  }, captures=true)
}

/// Optional dedicated drag handle inside a `Drawer` (e.g. top grabber bar of a bottom sheet).
pub fn Drawer::handle(
  self : Drawer,
  parent : view::View,
  look : (view::View, Drawer) -> Unit,
  extent_by? : () -> Double,
  slop~ : Double = 0.0,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    look(v, self)
    let _ = v.presses(view::Live::By(self.now))
    self.attach_drag(v, extent_by=extent_by, slop=slop)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount a headless Drawer / Sheet in `parent`, unified onto the window's overlay stack.
pub fn drawer(
  parent : view::View,
  label : () -> String,
  open : () -> Bool,
  on_close : () -> Unit,
  look : (view::View, Drawer) -> Unit,
  edge~ : DrawerEdge = DrawerEdge::Bottom,
  snap_points~ : Array[Double] = [1.0],
  active_snap~ : () -> Int = fn() { 0 },
  on_snap? : (Int) -> Unit,
  on_release? : (Double, Double, Bool) -> Unit,
  modal~ : Bool = true,
  close_on_escape~ : Bool = true,
  close_on_outside~ : Bool = true,
  close_threshold~ : Double = 0.35,
  velocity_threshold~ : Double = 0.5,
  overpull_max~ : Double = 0.0,
  drag_surface~ : Bool = true,
  can_drag~ : () -> Bool = fn() { true },
  first_takes? : (view::Said) -> Bool,
  return_focus? : view::View,
  description~ : () -> String = fn() { "" },
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let core = headless_core::DrawerSnapCore::new(
    edge=to_core_drawer_edge(edge),
    snap_points=snap_points,
    close_threshold=close_threshold,
    velocity_threshold=velocity_threshold,
    overpull_max=overpull_max,
    can_drag=can_drag,
  )
  parent.box(fn(v : view::View) {
    let close = fn() {
      if signals::untracked(open) {
        on_close()
      }
    }
    let anchor_fn = fn() -> Option[view::View] { None }
    let (ov, off, live) = join_overlay(
      v,
      fn(_how : OverlayDismiss) { close() },
      close_on_escape,
      close_on_outside,
      fn() -> Bool { !open() },
      anchor_fn,
      modal=modal,
    )
    let dr = Drawer::{
      node: v,
      ov,
      edge_: edge,
      now: open,
      close_fn: close,
      active_snap,
      on_snap,
      on_release,
      core,
    }
    look(v, dr)
    wire_overlay(
      ov,
      off,
      live,
      modal,
      close_on_escape,
      close_on_outside,
      anchor_fn,
      return_focus,
      true,
      first_takes,
      return_focus is Some(_),
      Some(fn() -> Bool { open() && focus_in(v, true) }),
    )
    if drag_surface {
      dr.attach_drag(v)
    }
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Dialog, label=label(), description=description()))
    }))
  }, made_for=resolve_made_for(made_for, loc), loc=loc)
}
