// Input trigger menu detection and replacement (`@`, `/`, `#`, etc.), UTF-16 & CJK safe.
// Pure trigger detection, replacement, and menu state machine delegated to `headless_core`.

import "headless_core"
import "view"

/// Configuration for one trigger prefix (e.g. `@`, `/`, `#`).
pub struct TriggerRule {
  pub trigger : String
  pub allow_spaces : Bool
  pub min_query_len : Int
  pub max_query_len : Int
  pub require_boundary : Bool
}

/// Create a `TriggerRule` with sensible defaults.
pub fn TriggerRule::new(
  trigger : String,
  allow_spaces~ : Bool = false,
  min_query_len~ : Int = 0,
  max_query_len~ : Int = 64,
  require_boundary~ : Bool = true,
) -> TriggerRule {
  TriggerRule::{ trigger, allow_spaces, min_query_len, max_query_len, require_boundary }
}

/// A detected trigger match in UTF-16 code unit coordinates `[start, end)`.
#derive(Eq)
pub struct TriggerMatch {
  pub trigger : String
  pub query : String
  pub start : Int
  pub end : Int
}

fn to_core_rule(r : TriggerRule) -> headless_core::TriggerRule {
  headless_core::TriggerRule::{
    trigger: r.trigger,
    allow_spaces: r.allow_spaces,
    min_query_len: r.min_query_len,
    max_query_len: r.max_query_len,
    require_boundary: r.require_boundary,
  }
}

fn to_core_match(m : TriggerMatch) -> headless_core::TriggerMatch {
  headless_core::TriggerMatch::{ trigger: m.trigger, query: m.query, start: m.start, end: m.end }
}

fn from_core_match(m : headless_core::TriggerMatch) -> TriggerMatch {
  TriggerMatch::{ trigger: m.trigger, query: m.query, start: m.start, end: m.end }
}

fn from_core_match_opt(o : Option[headless_core::TriggerMatch]) -> Option[TriggerMatch] {
  match o {
    Some(m) => Some(from_core_match(m))
    None => None
  }
}

/// Detect the nearest active trigger before UTF-16 `cursor` in `text`.
/// Boundary check rejects ASCII word characters before the trigger (preventing `foo@bar`),
/// while permitting whitespace and CJK characters.
pub fn detect_trigger(
  text : String,
  cursor : Int,
  rules : Array[TriggerRule],
) -> Option[TriggerMatch] {
  let core_rules = view::array_map(rules, to_core_rule)
  from_core_match_opt(headless_core::detect_trigger(text, cursor, core_rules))
}

/// Replace `[m.start, m.end)` in `text` with `replacement + suffix`, returning `(new_text, new_cursor)`.
pub fn apply_trigger(
  text : String,
  m : TriggerMatch,
  replacement : String,
  suffix~ : String = " ",
) -> (String, Int) {
  headless_core::apply_trigger(text, to_core_match(m), replacement, suffix=suffix)
}

/// Reactive state machine for an input-triggered autocomplete menu (`@mention`, `/command`, `#tag`).
pub struct TriggerMenu[K] {
  core : headless_core::TriggerMenu[K]
}

/// Create a `TriggerMenu[K]` controller.
pub fn TriggerMenu::new[K](
  rules : Array[TriggerRule],
  on_apply : (String, Int, K) -> Unit,
  suffix~ : String = " ",
) -> TriggerMenu[K] {
  let core_rules = view::array_map(rules, to_core_rule)
  TriggerMenu::{
    core: headless_core::TriggerMenu::new(core_rules, on_apply, suffix=suffix),
  }
}

/// Re-evaluate active trigger from `text` and UTF-16 `cursor`.
pub fn TriggerMenu::update[K](self : TriggerMenu[K], text : String, cursor : Int) -> Option[TriggerMatch] {
  from_core_match_opt(self.core.update(text, cursor))
}

pub fn TriggerMenu::active_match[K](self : TriggerMenu[K]) -> Option[TriggerMatch] {
  from_core_match_opt(self.core.active_match())
}

pub fn TriggerMenu::open[K](self : TriggerMenu[K]) -> Bool {
  self.core.open()
}

pub fn TriggerMenu::active_index[K](self : TriggerMenu[K]) -> Int {
  self.core.active_index()
}

pub fn TriggerMenu::set_active_index[K](self : TriggerMenu[K], index : Int) -> Unit {
  self.core.set_active_index(index)
}

/// Dismiss the current trigger menu until the cursor leaves this trigger token.
pub fn TriggerMenu::dismiss[K](self : TriggerMenu[K]) -> Unit {
  self.core.dismiss()
}

/// Accept `(key, replacement)` against `text`, invoking `on_apply(new_text, new_cursor, key)`.
pub fn TriggerMenu::accept[K](
  self : TriggerMenu[K],
  text : String,
  key : K,
  replacement : String,
) -> Bool {
  self.core.accept(text, key, replacement)
}

/// Handle Down/Up/Enter/Tab/Escape while the trigger menu is open.
pub fn TriggerMenu::handle_key[K](
  self : TriggerMenu[K],
  code : Int,
  items : Array[(K, String)],
  text : String,
) -> Bool {
  self.core.handle_key(code, items, text)
}
