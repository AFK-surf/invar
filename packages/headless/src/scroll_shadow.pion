// Reactive scroll-edge shadow indicator primitive.
// Strictly subscribes to tracked `Scroll::drawn` (via `Scroll::drawn_now`) and `Scroll::reach`
// so edge visibility updates on scroll, fling, and layout/reflow without reading untracked `at`/`most`.

import "halt"
import "view"

/// Reactive scroll-edge shadow state for a `view::Scroll`.
pub struct ScrollShadow {
  scroll_ : view::Scroll
  threshold_ : Double
}

/// Construct a reactive `ScrollShadow` tracking `scroll`.
/// Axis is derived from `!scroll.is_across()`; if `vertical` is explicitly supplied, it must match `scroll`.
pub fn scroll_shadow(
  scroll : view::Scroll,
  vertical? : Bool,
  threshold~ : Double = 1.0,
) -> ScrollShadow {
  let scroll_vertical = !scroll.is_across()
  match vertical {
    Some(v) =>
    if v != scroll_vertical {
      halt::saying("scroll_shadow: vertical argument does not match scroll axis", "")
    }
    None => ()
  }
  let t = if threshold < 0.0 { 0.0 } else { threshold }
  ScrollShadow::{ scroll_: scroll, threshold_: t }
}

/// The underlying `view::Scroll`.
pub fn ScrollShadow::scroll(self : ScrollShadow) -> view::Scroll {
  self.scroll_
}

/// Whether this shadow tracks vertical scrolling (`true`) or horizontal scrolling (`false`).
pub fn ScrollShadow::vertical(self : ScrollShadow) -> Bool {
  !self.scroll_.is_across()
}

/// Minimum scroll offset / remaining distance (in points) before an edge shadow appears.
pub fn ScrollShadow::threshold(self : ScrollShadow) -> Double {
  self.threshold_
}

/// Whether content extends before the current viewport start (top for vertical, start for horizontal).
/// Reactive: subscribes to tracked `Scroll::reach` and `Scroll::drawn`.
pub fn ScrollShadow::has_start(self : ScrollShadow) -> Bool {
  let reach = self.scroll_.reach()
  if reach <= self.threshold_ {
    return false
  }
  self.scroll_.drawn_now() > self.threshold_
}

/// Whether content extends past the current viewport end (bottom for vertical, end for horizontal).
/// Reactive: subscribes to tracked `Scroll::reach` and `Scroll::drawn`.
pub fn ScrollShadow::has_end(self : ScrollShadow) -> Bool {
  let reach = self.scroll_.reach()
  if reach <= self.threshold_ {
    return false
  }
  self.scroll_.drawn_now() < reach - self.threshold_
}

/// Whether both start and end shadows are active.
pub fn ScrollShadow::has_both(self : ScrollShadow) -> Bool {
  self.has_start() && self.has_end()
}
