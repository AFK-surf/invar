// Shared helpers for packages/headless.

import "signals"
import "view"

/// Walk up parent links to the root View of `v`'s tree.
fn view_root(v : view::View) -> view::View {
  let mut cur = v
  while true {
    match cur.parent() {
      Some(p) => cur = p
      None => return cur
    }
  }
  cur
}

/// Whether `v` or any descendant of `v` has NodeId `target`.
fn view_holds_id(v : view::View, target : view::NodeId) -> Bool {
  if !v.alive() {
    return false
  }
  if v.id() == target {
    return true
  }
  for k in v.kids() {
    if view_holds_id(k, target) {
      return true
    }
  }
  false
}

/// Whether `v` or any descendant of `v` currently has keyboard focus.
fn view_holds_focused(v : view::View) -> Bool {
  if !v.alive() {
    return false
  }
  if v.focused() {
    return true
  }
  for k in v.kids() {
    if view_holds_focused(k) {
      return true
    }
  }
  false
}

/// Whether two optional views refer to the same node id.
fn same_node(a : Option[view::View], b : Option[view::View]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.id() == y.id()
    _ => false
  }
}

/// Whether two optional NodeIds are equal.
fn same_node_id_opt(a : Option[view::NodeId], b : Option[view::NodeId]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

/// Whether the keyboard's focus is in `v` (itself or what it holds), or, where `or_none`, nowhere in its tree.
fn focus_in(v : view::View, or_none : Bool) -> Bool {
  if view_holds_focused(v) {
    return true
  }
  if or_none {
    return !view_holds_focused(view_root(v))
  }
  false
}

/// Whether a press that went down at (`x`, `y`) of the window is on `v` or what it holds.
fn press_on(v : view::View, x : Double, y : Double) -> Bool {
  if !v.alive() {
    return false
  }
  match v.finger_target_id(x, y) {
    Some(id) => view_holds_id(v, id)
    None => false
  }
}

/// `v` told `f` as a press goes down anywhere in the window while `on` says so (View::window_downs),
/// given where it went down; a press already down as `on` came to hold is none of these.
fn window_downs_while(v : view::View, on : () -> Bool, f : (Double, Double) -> Unit) -> Unit {
  let was : view::Ref[Option[Int]] = view::ref_new(None)
  v.reacts_by(
    fn() -> Option[Int] {
      if on() { Some(v.window_downs()) } else { None }
    },
    fn(a : Option[Int], b : Option[Int]) -> Bool {
      match (a, b) {
        (None, None) => true
        (Some(x), Some(y)) => x == y
        _ => false
      }
    },
    fn(now : Option[Int]) {
      let before = was.v
      was.v = now
      match (before, now) {
        (Some(_), Some(_)) => {
          let (x, y) = v.window_down_point()
          f(x, y)
        }
        _ => ()
      }
    },
  )
}

/// Resolve `made_for` falling back to `loc`.
fn resolve_made_for(made_for : Option[String], loc : String) -> String {
  match made_for {
    Some(m) => m
    None => loc
  }
}

/// Check if an Int array contains `x`.
fn int_array_contains(arr : Array[Int], x : Int) -> Bool {
  for v in arr {
    if v == x {
      return true
    }
  }
  false
}

/// Check if a String array contains `x`.
fn str_array_contains(arr : Array[String], x : String) -> Bool {
  for v in arr {
    if v == x {
      return true
    }
  }
  false
}

/// Join strings with separator `sep`.
fn str_join(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(parts[i])
    i += 1
  }
  sb.to_string()
}

/// Trim ASCII whitespace from both ends of `s`.
fn str_trim(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n {
    let c = s.code_unit_at(start)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D {
      start += 1
    } else {
      break
    }
  }
  let mut end = n
  while end > start {
    let c = s.code_unit_at(end - 1)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D {
      end -= 1
    } else {
      break
    }
  }
  if start == 0 && end == n {
    s
  } else {
    view::str_slice_to(view::str_slice_from(s, start), end - start)
  }
}

/// Lowercase ASCII A..Z in `s`.
fn ascii_lower(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i += 1
  }
  sb.to_string()
}

/// Check if `s` starts with `prefix`.
fn str_has_prefix(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if pn > s.length() {
    return false
  }
  let mut i = 0
  while i < pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

/// Check if every code unit in `s` equals `ch`.
fn str_all_code(s : String, ch : Int) -> Bool {
  let n = s.length()
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) != ch {
      return false
    }
    i += 1
  }
  true
}
