// Wave 0-Prep narrow headless contract tests:
// 1. Button `pending` (click & keyboard re-entry guard + reactive state)
// 2. ScrollShadow (tracked Scroll::drawn & Scroll::reach across vertical, horizontal, reflow, endpoints, zero reach)
// 3. InputOtp (IME commit -> mid-segment replacement -> full paste -> predicate filter -> on_complete)

import "headless_core"
import "signals"
import "view"

fn w0_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

fn w0_make_tree(make : (view::View) -> Unit) -> view::Tree {
  view::Tree::new(
    make,
    measure=view::words_measure,
    measure_runs=view::runs_measure,
    measure_runs_least=view::runs_least_measure,
  )
}

fn w0_said_of(tree : view::Tree, id : view::NodeId) -> Option[view::Said] {
  for sn in tree.said_order() {
    if sn.id == id {
      return sn.said
    }
  }
  None
}

test "w0-prep 01 Button pending blocks pointer and keyboard re-entry while preserving focus" {
  let clicks = view::ref_new(0)
  let busy = signals::signal(false)
  let btn_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let handle_ref : signals::Ref[Option[Button]] = view::ref_new(None)

  let tree = w0_make_tree(fn(root : view::View) {
    let b = button(
      root,
      fn() -> String { "Submit" },
      fn(_v : view::View) { clicks.v = clicks.v + 1 },
      fn(v : view::View, h : Button) {
        let _ = v.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(36.0)))
        handle_ref.v = Some(h)
      },
      pending=fn() -> Bool { busy.get() },
    )
    btn_ref.v = Some(b)
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  let b = match btn_ref.v { Some(v) => v; None => panic("missing button") }
  let h = match handle_ref.v { Some(v) => v; None => panic("missing handle") }

  w0_assert(!h.pending(), "initially not pending")
  w0_assert(!h.state().busy, "initially state not busy")
  h.press()
  w0_assert(clicks.v == 1, "press works when not pending")

  // Focus button and activate via keyboard focus press (Enter/Space)
  let _ = b.ask_focus(visible=true)
  let _ = tree.frame(200.0, 100.0, now=16.0)
  let _ = tree.press_focused_at(b.id(), 16.0)
  w0_assert(clicks.v == 2, "keyboard focus press activates button when not pending")

  // Enter pending state
  busy.set(true)
  let _ = tree.frame(200.0, 100.0, now=32.0)
  w0_assert(h.pending(), "button reports pending")
  w0_assert(h.state().busy, "button state reflects busy while pending")
  w0_assert(b.focused(), "focus stays on button while pending")

  // Direct press and keyboard focus press must both be blocked while pending
  h.press()
  let _ = tree.press_focused_at(b.id(), 48.0)
  w0_assert(clicks.v == 2, "pending blocks pointer and keyboard re-entry")

  // Clear pending -> interactive again
  busy.set(false)
  let _ = tree.frame(200.0, 100.0, now=80.0)
  w0_assert(!h.pending(), "pending cleared")
  let _ = tree.press_focused_at(b.id(), 96.0)
  w0_assert(clicks.v == 3, "keyboard focus press activates again once pending clears")
  tree.dispose()
}

test "w0-prep 02 ScrollShadow vertical, horizontal, reflow, endpoints, and zero reach" {
  // Vertical scroll with dynamic content height
  let v_scroll = view::Scroll::plain()
  let v_shadow = scroll_shadow(v_scroll, vertical=true, threshold=1.0)
  let v_content_h = signals::signal(400.0)
  let v_start_seen = view::ref_new(false)
  let v_end_seen = view::ref_new(false)

  // Horizontal scroll with dynamic content width
  let h_scroll = view::Scroll::across()
  let h_shadow = scroll_shadow(h_scroll, vertical=false, threshold=1.0)
  let h_content_w = signals::signal(500.0)
  let h_start_seen = view::ref_new(false)
  let h_end_seen = view::ref_new(false)

  let tree = w0_make_tree(fn(root : view::View) {
    let _ = root.box(fn(vp : view::View) {
      let _ = vp
      .width(view::Live::Is(Some(200.0)))
      .height(view::Live::Is(Some(100.0)))
      .scrolls(v_scroll, fn(inner : view::View) {
        let _ = inner
        .width(view::Live::Is(Some(200.0)))
        .height(view::Live::By(fn() -> Option[Double] { Some(v_content_h.get()) }))
      })
      vp.reacts(fn() -> Bool { v_shadow.has_start() }, fn(v : Bool) { v_start_seen.v = v })
      vp.reacts(fn() -> Bool { v_shadow.has_end() }, fn(v : Bool) { v_end_seen.v = v })
    })
    let _ = root.box(fn(hp : view::View) {
      let _ = hp
      .width(view::Live::Is(Some(200.0)))
      .height(view::Live::Is(Some(60.0)))
      .scrolls(h_scroll, fn(inner : view::View) {
        let _ = inner
        .width(view::Live::By(fn() -> Option[Double] { Some(h_content_w.get()) }))
        .height(view::Live::Is(Some(60.0)))
      })
      hp.reacts(fn() -> Bool { h_shadow.has_start() }, fn(v : Bool) { h_start_seen.v = v })
      hp.reacts(fn() -> Bool { h_shadow.has_end() }, fn(v : Bool) { h_end_seen.v = v })
    })
  })

  // Initial layout: vertical reach=300, horizontal reach=300; both at 0
  let _ = tree.frame(200.0, 200.0, now=0.0)
  w0_assert(v_shadow.vertical(), "vertical flag true")
  w0_assert(!h_shadow.vertical(), "horizontal flag false")
  w0_assert(!v_start_seen.v && v_end_seen.v, "vertical at top: no start, has end")
  w0_assert(!h_start_seen.v && h_end_seen.v, "horizontal at start: no start, has end")

  // Scroll both to middle -> both shadows active
  v_scroll.put(150.0)
  h_scroll.put(150.0)
  let _ = tree.frame(200.0, 200.0, now=16.0)
  w0_assert(v_start_seen.v && v_end_seen.v, "vertical mid: both shadows")
  w0_assert(h_start_seen.v && h_end_seen.v, "horizontal mid: both shadows")
  w0_assert(v_shadow.has_both() && h_shadow.has_both(), "has_both true in middle")

  // Scroll both to end -> start active, end inactive
  v_scroll.put(300.0)
  h_scroll.put(300.0)
  let _ = tree.frame(200.0, 200.0, now=32.0)
  w0_assert(v_start_seen.v && !v_end_seen.v, "vertical end: start only")
  w0_assert(h_start_seen.v && !h_end_seen.v, "horizontal end: start only")

  // Reflow content so it fits within viewport -> reach == 0, both shadows turn off reactively
  v_content_h.set(80.0)
  h_content_w.set(160.0)
  let _ = tree.frame(200.0, 200.0, now=48.0)
  w0_assert(!v_start_seen.v && !v_end_seen.v, "vertical reflow to zero reach clears shadows")
  w0_assert(!h_start_seen.v && !h_end_seen.v, "horizontal reflow to zero reach clears shadows")

  // Grow again -> end shadow re-appears
  v_content_h.set(300.0)
  let _ = tree.frame(200.0, 200.0, now=64.0)
  w0_assert(!v_start_seen.v && v_end_seen.v, "vertical reflow back to overflow restores end shadow")
  tree.dispose()
}

test "w0-prep 03 InputOtp IME commit, mid-segment replace, full paste, filter, and on_complete" {
  let changes : Array[String] = []
  let completed : Array[String] = []
  let off = signals::signal(false)
  let root_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let slot1_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let otp = InputOtp::new(
    6,
    label=fn() -> String { "Verification code" },
    description=fn() -> String { "Enter 6 digits" },
    disabled=fn() -> Bool { off.get() },
    on_change=fn(v : String) { changes.push(v) },
    on_complete=fn(v : String) { completed.push(v) },
  )

  let tree = w0_make_tree(fn(root : view::View) {
    let r = otp.root(root, fn(v : view::View, ctrl : InputOtp) {
      let _ = v.width(view::Live::Is(Some(240.0))).height(view::Live::Is(Some(44.0)))
      let s1 = ctrl.slot_node(v, 1, fn(sv : view::View, _slot : () -> headless_core::OtpSlot) {
        let _ = sv.width(view::Live::Is(Some(36.0))).height(view::Live::Is(Some(44.0)))
      })
      slot1_ref.v = Some(s1)
    })
    root_ref.v = Some(r)
  })
  let _ = tree.frame(300.0, 100.0, now=0.0)
  let r = match root_ref.v { Some(v) => v; None => panic("missing otp root") }
  let s1 = match slot1_ref.v { Some(v) => v; None => panic("missing slot 1") }

  // 1. IME pre-edit committed text (with non-digit noise filtered out)
  let _ = r.ask_focus(visible=true)
  let _ = tree.frame(300.0, 100.0, now=16.0)
  w0_assert(otp.focused(), "otp root focus updates controller")
  otp.commit_text("12-3")
  w0_assert(otp.value() == "123", "IME commit normalizes to 123")
  w0_assert(otp.active_index() == 3, "active slot is 3")
  w0_assert(completed.length() == 0, "not complete yet")

  // 2. Press slot 1 -> moves active slot to 1, then mid-segment replace [1, 2) -> "193"
  let _ = s1.press()
  w0_assert(otp.active_index() == 1, "clicking slot 1 selects slot 1")
  otp.replace_range(1, 2, "a9b")
  w0_assert(otp.value() == "193", "mid-segment replace filters non-digits and yields 193")

  // 3. Full-string paste with invalid characters & overflow -> truncates to 6 and fires on_complete
  otp.paste("98-76-54-321")
  w0_assert(otp.value() == "987654", "paste filters and truncates to 6 digits")
  w0_assert(otp.is_complete(), "otp is complete")
  w0_assert(completed.length() == 1 && completed[0] == "987654", "on_complete fired once with 987654")

  let _ = tree.frame(300.0, 100.0, now=32.0)
  match w0_said_of(tree, r.id()) {
    Some(s) => {
      w0_assert(s.role == view::Role::TextField, "otp a11y role is TextField")
      w0_assert(s.label == "Verification code", "otp a11y label")
      w0_assert(s.value == "987654", "otp a11y value synced")
    }
    None => panic("missing otp said")
  }

  // 4. Disabled ignores mutations
  off.set(true)
  let _ = tree.frame(300.0, 100.0, now=48.0)
  otp.backspace()
  otp.paste("111111")
  w0_assert(otp.value() == "987654", "disabled otp ignores edits")
  tree.dispose()
}

test "w0-prep 04 ScrollShadow pre-mount binding, switch_by unmount/remount reflow, and fling settle" {
  let sc = view::Scroll::plain()
  let sh = scroll_shadow(sc, threshold=1.0)
  let mounted = signals::signal(true)
  let content_h = signals::signal(400.0)
  let pre_start = view::ref_new(false)
  let pre_end = view::ref_new(false)
  let vp_id : signals::Ref[Option[view::NodeId]] = view::ref_new(None)

  let tree = w0_make_tree(fn(root : view::View) {
    // Overlay binding created BEFORE the scroll host mounts (common in stacked ScrollShadow wrappers)
    root.reacts(fn() -> Bool { sh.has_start() }, fn(v : Bool) { pre_start.v = v })
    root.reacts(fn() -> Bool { sh.has_end() }, fn(v : Bool) { pre_end.v = v })

    let _ = root.switch_by(
      fn() -> Bool { mounted.get() },
      fn(slot : view::View, on : Bool) {
        if on {
          let _ = slot.box(fn(vp : view::View) {
            vp_id.v = Some(vp.id())
            let _ = vp
            .width(view::Live::Is(Some(200.0)))
            .height(view::Live::Is(Some(100.0)))
            .scrolls(sc, fn(inner : view::View) {
              let _ = inner
              .width(view::Live::Is(Some(200.0)))
              .height(view::Live::By(fn() -> Option[Double] { Some(content_h.get()) }))
            })
          })
        }
      },
    )
  })

  // 1. Pre-mount binding receives initial overflow after mount & layout
  let _ = tree.frame(200.0, 120.0, now=0.0)
  w0_assert(!pre_start.v && pre_end.v, "pre-mount binding sees initial end shadow")

  // 2. Unmount via switch_by -> binding reactively clears shadows
  mounted.set(false)
  let _ = tree.frame(200.0, 120.0, now=16.0)
  w0_assert(!pre_start.v && !pre_end.v, "unmount clears shadow binding")

  // 3. Remount -> binding re-subscribes to new reach signal and updates on reflow to zero reach
  mounted.set(true)
  let _ = tree.frame(200.0, 120.0, now=32.0)
  w0_assert(!pre_start.v && pre_end.v, "remount restores end shadow")

  content_h.set(80.0)
  let _ = tree.frame(200.0, 120.0, now=48.0)
  w0_assert(!pre_start.v && !pre_end.v, "remounted scroll reflow to reach=0 clears shadow")

  // 4. Grow back and fling from top toward bottom: shadows update as fling advances and settles
  content_h.set(400.0)
  let _ = tree.frame(200.0, 120.0, now=64.0)
  w0_assert(!pre_start.v && pre_end.v, "back to overflow before fling")

  let hid = match vp_id.v { Some(id) => id; None => panic("missing scroll host id") }
  let _ = tree.drag_at(hid, view::DragIs::Down, 50.0, 90.0, 100.0, finger=0)
  let _ = tree.drag_at(hid, view::DragIs::Moved, 50.0, 60.0, 108.0, finger=0)
  let _ = tree.drag_at(hid, view::DragIs::Moved, 50.0, 20.0, 116.0, finger=0)
  let _ = tree.drag_at(hid, view::DragIs::Up, 50.0, 20.0, 116.0, finger=0)
  let _ = tree.frame(200.0, 120.0, now=140.0)
  w0_assert(pre_start.v, "start shadow turns on during fling")

  // Advance clock past fling end -> settles at foot (start=true, end=false)
  tree.advance(5000.0)
  let _ = tree.frame(200.0, 120.0, now=5000.0)
  w0_assert(pre_start.v && !pre_end.v, "after fling settles at foot, start=true and end=false")
  tree.dispose()
}

test "w0-prep 05 InputOtp owns_focus=false delegates focus to outer field without nested TextField" {
  let root_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let field_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let slot2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let otp = InputOtp::new(4, value="12")
  let tree = w0_make_tree(fn(root : view::View) {
    let r = otp.root(
      root,
      fn(v : view::View, ctrl : InputOtp) {
        let _ = v.width(view::Live::Is(Some(200.0))).height(view::Live::Is(Some(44.0)))
        // Simulated outer ui::Field inside root
        let f = v.box(fn(fv : view::View) {
          let _ = fv
          .width(view::Live::Is(Some(1.0)))
          .height(view::Live::Is(Some(1.0)))
          .focusable(view::Live::Is(true), keys=0)
          .says(view::Live::Is(Some(view::said(view::Role::TextField, label="Outer field"))))
          fv.reacts(fn() -> Bool { fv.focused() }, fn(now : Bool) { ctrl.set_focused(now) })
        })
        field_ref.v = Some(f)
        ctrl.set_focus_target(fn() -> Bool { f.ask_focus(visible=true) })
        let s2 = ctrl.slot_node(v, 2, fn(sv : view::View, _slot : () -> headless_core::OtpSlot) {
          let _ = sv.width(view::Live::Is(Some(36.0))).height(view::Live::Is(Some(44.0)))
        })
        slot2_ref.v = Some(s2)
      },
      owns_focus=false,
    )
    root_ref.v = Some(r)
  })
  let _ = tree.frame(240.0, 100.0, now=0.0)
  let r = match root_ref.v { Some(v) => v; None => panic("missing otp root") }
  let f = match field_ref.v { Some(v) => v; None => panic("missing outer field") }
  let s2 = match slot2_ref.v { Some(v) => v; None => panic("missing slot 2") }

  // Root is NOT focusable and emits NO Role::TextField
  w0_assert(!r.ask_focus(visible=true), "owns_focus=false root cannot receive focus")
  w0_assert(w0_said_of(tree, r.id()).is_none(), "owns_focus=false root emits no TextField a11y node")
  w0_assert(!otp.focused(), "initially unfocused")

  // Pressing slot 2 delegates focus to the outer field and lights up active slot / fake caret
  let _ = s2.press()
  let _ = tree.frame(240.0, 100.0, now=16.0)
  w0_assert(f.focused(), "clicking slot focuses outer field")
  w0_assert(otp.focused(), "mirrored focus lights up controller")
  let snap = otp.slot(2)
  w0_assert(snap.is_active && snap.has_fake_caret, "slot 2 is active with fake caret")
  tree.dispose()
}
