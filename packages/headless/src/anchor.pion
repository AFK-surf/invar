// Where what floats beside what opened it goes (a menu under its button, a submenu beside its item,
// a combobox's list under its field), and how fast a list scrolls by itself as a drag is held near its edge.
// Pure placement and edge-scroll math delegated to `headless_core`.

import "headless_core"

/// A side of what opened it that something floating goes on.
#derive(Eq)
pub enum AnchorSide {
  Below
  Above
  Right
  Left
}

fn to_core_anchor_side(side : AnchorSide) -> headless_core::AnchorSide {
  match side {
    Below => headless_core::AnchorSide::Below
    Above => headless_core::AnchorSide::Above
    Right => headless_core::AnchorSide::Right
    Left => headless_core::AnchorSide::Left
  }
}

fn from_core_anchor_side(side : headless_core::AnchorSide) -> AnchorSide {
  match side {
    Below => AnchorSide::Below
    Above => AnchorSide::Above
    Right => AnchorSide::Right
    Left => AnchorSide::Left
  }
}

/// The key that goes back toward what opened something floating on `self`'s side
/// (← 3, → 4, ↑ 5, ↓ 6): a submenu opened on the right is closed by ←.
pub fn anchor_side_back_key(side : AnchorSide) -> Int {
  headless_core::anchor_side_back_key(to_core_anchor_side(side))
}

/// Where something floating is asked to go beside what opened it.
#derive(Eq)
pub enum Placement {
  BelowStart
  BelowCenter
  BelowEnd
  AboveStart
  AboveCenter
  AboveEnd
  RightStart
  RightCenter
  RightEnd
  LeftStart
  LeftCenter
  LeftEnd
}

/// The side `placement` asks for.
pub fn placement_side(placement : Placement) -> AnchorSide {
  match placement {
    BelowStart | BelowCenter | BelowEnd => AnchorSide::Below
    AboveStart | AboveCenter | AboveEnd => AnchorSide::Above
    RightStart | RightCenter | RightEnd => AnchorSide::Right
    LeftStart | LeftCenter | LeftEnd => AnchorSide::Left
  }
}

fn placement_align(placement : Placement) -> headless_core::AnchorAlign {
  match placement {
    BelowStart | AboveStart | RightStart | LeftStart => headless_core::AnchorAlign::Start
    BelowCenter | AboveCenter | RightCenter | LeftCenter => headless_core::AnchorAlign::Center
    _ => headless_core::AnchorAlign::End
  }
}

/// Where something floating goes: its top left (`x`, `y`), the side it went on (`side`),
/// whether it `flipped`, and the `room` it has on that side.
#derive(Eq)
pub struct AnchorPlaced {
  pub x : Double
  pub y : Double
  pub side : AnchorSide
  pub flipped : Bool
  pub room : Double
}

/// Something `size` (width, height) floating beside `anchor` (x, y, width, height), in a window
/// `view` (width, height) whose safe area is it less `insets` (top, right, bottom, left),
/// `gap` off it, on the side `placement` asks.
pub fn anchor_place(
  anchor : (Double, Double, Double, Double),
  size : (Double, Double),
  view : (Double, Double),
  placement~ : Placement = BelowStart,
  gap~ : Double = 0.0,
  insets~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
) -> AnchorPlaced {
  let (ax, ay, aw, ah) = anchor
  let (pw, ph) = size
  let (vw, vh) = view
  let placed = headless_core::anchor_place_insets(
    headless_core::Rect::new(ax, ay, aw, ah),
    pw,
    ph,
    headless_core::Rect::new(0.0, 0.0, vw, vh),
    side=to_core_anchor_side(placement_side(placement)),
    align=placement_align(placement),
    gap=gap,
    insets=insets,
    flip=true,
  )
  AnchorPlaced::{
    x: placed.x,
    y: placed.y,
    side: from_core_anchor_side(placed.side),
    flipped: placed.flipped,
    room: placed.room,
  }
}

/// How fast a list scrolls by itself while a drag is held at `pos` along its axis,
/// its part that shows from `start` to `end`.
pub fn edge_scroll_speed(pos : Double, start : Double, end : Double, zone~ : Double, max_speed~ : Double) -> Double {
  headless_core::edge_scroll_speed(pos, start, end, zone=zone, max_speed=max_speed)
}
