// Where what floats beside what opened it goes (a menu under its button, a submenu beside its item,
// a combobox's list under its field), and how fast a list scrolls by itself as a drag is held near its edge.
// Ported 1:1 from libs/mbui/src/headless/anchor.mbt.

/// A side of what opened it that something floating goes on.
#derive(Eq)
pub enum AnchorSide {
  Below
  Above
  Right
  Left
}

/// The key that goes back toward what opened something floating on `self`'s side
/// (← 3, → 4, ↑ 5, ↓ 6): a submenu opened on the right is closed by ←.
pub fn anchor_side_back_key(side : AnchorSide) -> Int {
  match side {
    Below => 5
    Above => 6
    Right => 3
    Left => 4
  }
}

/// Where something floating is asked to go beside what opened it.
#derive(Eq)
pub enum Placement {
  BelowStart
  BelowCenter
  BelowEnd
  AboveStart
  AboveCenter
  AboveEnd
  RightStart
  RightCenter
  RightEnd
  LeftStart
  LeftCenter
  LeftEnd
}

/// The side `placement` asks for.
pub fn placement_side(placement : Placement) -> AnchorSide {
  match placement {
    BelowStart | BelowCenter | BelowEnd => AnchorSide::Below
    AboveStart | AboveCenter | AboveEnd => AnchorSide::Above
    RightStart | RightCenter | RightEnd => AnchorSide::Right
    LeftStart | LeftCenter | LeftEnd => AnchorSide::Left
  }
}

/// How far along its side `placement` lines up: 0 its start, 0.5 its middle, 1 its end.
fn placement_along(placement : Placement) -> Double {
  match placement {
    BelowStart | AboveStart | RightStart | LeftStart => 0.0
    BelowCenter | AboveCenter | RightCenter | LeftCenter => 0.5
    _ => 1.0
  }
}

/// Where something floating goes: its top left (`x`, `y`), the side it went on (`side`),
/// whether it `flipped`, and the `room` it has on that side.
#derive(Eq)
pub struct AnchorPlaced {
  pub x : Double
  pub y : Double
  pub side : AnchorSide
  pub flipped : Bool
  pub room : Double
}

/// `v` within `lo` and `hi`, at `lo` where they cross.
fn clamp_in(v : Double, lo : Double, hi : Double) -> Double {
  if hi < lo || v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

/// Something `size` (width, height) floating beside `anchor` (x, y, width, height), in a window
/// `view` (width, height) whose safe area is it less `insets` (top, right, bottom, left),
/// `gap` off it, on the side `placement` asks.
pub fn anchor_place(
  anchor : (Double, Double, Double, Double),
  size : (Double, Double),
  view : (Double, Double),
  placement~ : Placement = BelowStart,
  gap~ : Double = 0.0,
  insets~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
) -> AnchorPlaced {
  let (ax, ay, aw, ah) = anchor
  let (pw, ph) = size
  let (vw, vh) = view
  let (it, ir, ib, il) = insets
  let left = il
  let top = it
  let right = vw - ir
  let bottom = vh - ib
  let max0 = fn(v : Double) -> Double { if v > 0.0 { v } else { 0.0 } }
  let below = max0(bottom - (ay + ah) - gap)
  let above = max0(ay - gap - top)
  let after = max0(right - (ax + aw) - gap)
  let before = max0(ax - gap - left)
  let asked = placement_side(placement)
  let (here, there, need, other) = match asked {
    Below => (below, above, ph, AnchorSide::Above)
    Above => (above, below, ph, AnchorSide::Below)
    Right => (after, before, pw, AnchorSide::Left)
    Left => (before, after, pw, AnchorSide::Right)
  }
  let flipped = need > here && there > here
  let side = if flipped { other } else { asked }
  let room = if flipped { there } else { here }
  let k = placement_along(placement)
  let (x, y) = match side {
    Below => (ax + (aw - pw) * k, ay + ah + gap)
    Above => (ax + (aw - pw) * k, ay - gap - ph)
    Right => (ax + aw + gap, ay + (ah - ph) * k)
    Left => (ax - gap - pw, ay + (ah - ph) * k)
  }
  AnchorPlaced::{
    x: clamp_in(x, left, right - pw),
    y: clamp_in(y, top, bottom - ph),
    side,
    flipped,
    room,
  }
}

/// How fast a list scrolls by itself while a drag is held at `pos` along its axis,
/// its part that shows from `start` to `end`.
pub fn edge_scroll_speed(pos : Double, start : Double, end : Double, zone~ : Double, max_speed~ : Double) -> Double {
  let span = end - start
  if span <= 0.0 || zone <= 0.0 || max_speed <= 0.0 {
    return 0.0
  }
  let z = if zone * 2.0 > span { span / 2.0 } else { zone }
  let into = fn(d : Double) -> Double {
    let f = if d >= z { 1.0 } else { d / z }
    max_speed * f * f
  }
  if pos < start + z {
    -into(start + z - pos)
  } else if pos > end - z {
    into(pos - (end - z))
  } else {
    0.0
  }
}
