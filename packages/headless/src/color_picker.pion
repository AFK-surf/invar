// Headless ColorPicker primitives:
// - `color_area`: arbitrary 2-channel 2D drag & 4-way Arrow keys (Shift = 10x)
// - `color_slider`: single-channel 1D slider
// - `color_swatch_picker`: 2D grid roving swatch picker

import "dmath"
import "headless_core"
import "signals"
import "view"

/// Handle for a 2D `ColorArea` editing `(x_channel, y_channel)`.
pub struct ColorArea {
  node : view::View
  x_channel : headless_core::ColorChannel
  y_channel : headless_core::ColorChannel
  model_ : () -> headless_core::ColorModel
  on_change : (headless_core::ColorModel) -> Unit
  off : () -> Bool
}

pub fn ColorArea::node(self : ColorArea) -> view::View {
  self.node
}

pub fn ColorArea::x_norm(self : ColorArea) -> Double {
  (self.model_)().channel_norm(self.x_channel)
}

pub fn ColorArea::y_norm(self : ColorArea) -> Double {
  (self.model_)().channel_norm(self.y_channel)
}

pub fn ColorArea::disabled(self : ColorArea) -> Bool {
  (self.off)()
}

/// Set both channels from normalized `(tx, ty)` in `[0, 1]` (`ty=0` at bottom, `ty=1` at top).
pub fn ColorArea::set_norm(self : ColorArea, tx : Double, ty : Double) -> Unit {
  if signals::untracked(self.off) {
    return
  }
  let cur = signals::untracked(self.model_)
  let next = cur.with_channel_norm(self.x_channel, tx).with_channel_norm(self.y_channel, ty)
  if next != cur {
    (self.on_change)(next)
  }
}

/// Mount a headless 2D `ColorArea` supporting arbitrary channel pairs (S/V, R/G, B/G, etc.),
/// pointer 2D drag, and 4-way Arrow keys (with Shift = 10x step).
pub fn color_area(
  parent : view::View,
  label : () -> String,
  x_channel : headless_core::ColorChannel,
  y_channel : headless_core::ColorChannel,
  model : () -> headless_core::ColorModel,
  on_change : (headless_core::ColorModel) -> Unit,
  look : (view::View, ColorArea) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let ca = ColorArea::{ node: v, x_channel, y_channel, model_: model, on_change, off: disabled }
    let able = fn() -> Bool { !disabled() }
    let update_from_point = fn(wx : Double, wy : Double) {
      let (rx, ry, rw, rh) = v.rect()
      if rw <= 0.0 || rh <= 0.0 {
        return
      }
      let tx = dmath::clamp((wx - rx) / rw, 0.0, 1.0)
      // Y-axis: top of area = 1.0, bottom = 0.0
      let ty = dmath::clamp(1.0 - (wy - ry) / rh, 0.0, 1.0)
      ca.set_norm(tx, ty)
    }
    look(v, ca)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=0)
    .says(view::Live::By(fn() -> Option[view::Said] {
      let m = model()
      let xv = (m.channel_norm(x_channel) * 100.0).round().to_int()
      let yv = (m.channel_norm(y_channel) * 100.0).round().to_int()
      Some(view::said(
        view::Role::Slider,
        label=label(),
        value="\{xv}%, \{yv}%",
        range=(0.0, xv.to_double(), 100.0),
      ))
    }))
    .gesture(
      0.0,
      press=fn(d : view::Drag) {
        if able() {
          let _ = v.ask_focus(visible=false)
          update_from_point(d.wx, d.wy)
        }
      },
      drag=fn(d : view::Drag) {
        if able() && d.kind == view::DragIs::Moved {
          update_from_point(d.wx, d.wy)
        }
      },
    )
    .on_key(fn(k : view::Key) -> Bool {
      if !able() || !v.focused() || (k.mods != 0 && k.mods != shift_mod) {
        return false
      }
      let large = k.mods == shift_mod
      let cur = signals::untracked(model)
      let next = if k.code == grid_key_right {
        cur.step_channel(x_channel, 1, large=large)
      } else if k.code == grid_key_left {
        cur.step_channel(x_channel, -1, large=large)
      } else if k.code == group_key_up {
        cur.step_channel(y_channel, 1, large=large)
      } else if k.code == group_key_down {
        cur.step_channel(y_channel, -1, large=large)
      } else {
        return false
      }
      if next != cur {
        on_change(next)
      }
      true
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Handle for a 1D `ColorSlider` editing a single `ColorChannel`.
pub struct ColorSlider {
  node : view::View
  channel : headless_core::ColorChannel
  model_ : () -> headless_core::ColorModel
  on_change : (headless_core::ColorModel) -> Unit
  vertical : Bool
  off : () -> Bool
}

pub fn ColorSlider::node(self : ColorSlider) -> view::View {
  self.node
}

pub fn ColorSlider::norm(self : ColorSlider) -> Double {
  (self.model_)().channel_norm(self.channel)
}

pub fn ColorSlider::value(self : ColorSlider) -> Double {
  (self.model_)().channel(self.channel)
}

pub fn ColorSlider::disabled(self : ColorSlider) -> Bool {
  (self.off)()
}

/// Mount a single-channel headless `ColorSlider` (`Role::Slider`).
pub fn color_slider(
  parent : view::View,
  label : () -> String,
  channel : headless_core::ColorChannel,
  model : () -> headless_core::ColorModel,
  on_change : (headless_core::ColorModel) -> Unit,
  look : (view::View, ColorSlider) -> Unit,
  vertical~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let cs = ColorSlider::{ node: v, channel, model_: model, on_change, vertical, off: disabled }
    let able = fn() -> Bool { !disabled() }
    let update_from_point = fn(wx : Double, wy : Double) {
      let (rx, ry, rw, rh) = v.rect()
      let t = if vertical {
        if rh <= 0.0 { return }
        dmath::clamp(1.0 - (wy - ry) / rh, 0.0, 1.0)
      } else {
        if rw <= 0.0 { return }
        dmath::clamp((wx - rx) / rw, 0.0, 1.0)
      }
      let cur = signals::untracked(model)
      let next = cur.with_channel_norm(channel, t)
      if next != cur {
        on_change(next)
      }
    }
    look(v, cs)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=0)
    .says(view::Live::By(fn() -> Option[view::Said] {
      let (lo, hi, _) = headless_core::color_channel_range(channel)
      let cur = model().channel(channel)
      Some(view::said(
        view::Role::Slider,
        label=label(),
        value="\{cur.round().to_int()}",
        range=(lo, cur, hi),
        actions=if disabled() { [] } else { [view::Action::Increment, view::Action::Decrement] },
      ))
    }))
    .on_step(fn(by : Int) {
      if able() {
        let cur = signals::untracked(model)
        let next = cur.step_channel(channel, by)
        if next != cur {
          on_change(next)
        }
      }
    })
    .gesture(
      0.0,
      press=fn(d : view::Drag) {
        if able() {
          let _ = v.ask_focus(visible=false)
          update_from_point(d.wx, d.wy)
        }
      },
      drag=fn(d : view::Drag) {
        if able() && d.kind == view::DragIs::Moved {
          update_from_point(d.wx, d.wy)
        }
      },
    )
    .on_key(fn(k : view::Key) -> Bool {
      if !able() || !v.focused() || (k.mods != 0 && k.mods != shift_mod) {
        return false
      }
      let large = k.mods == shift_mod
      let cur = signals::untracked(model)
      let (lo, hi, _) = headless_core::color_channel_range(channel)
      let next = if k.code == grid_key_right || k.code == group_key_up {
        cur.step_channel(channel, 1, large=large)
      } else if k.code == grid_key_left || k.code == group_key_down {
        cur.step_channel(channel, -1, large=large)
      } else if k.code == group_key_home {
        cur.with_channel(channel, lo)
      } else if k.code == group_key_end {
        cur.with_channel(channel, hi)
      } else {
        return false
      }
      if next != cur {
        on_change(next)
      }
      true
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

struct ColorSwatchEntry {
  hex : String
  node : view::View
  off : () -> Bool
  has_alpha : Bool
  rgba8 : Option[Int64]
  rgb_hex : Option[String]
}

/// 2D grid roving color swatch picker controller.
pub struct ColorSwatchPicker {
  node : view::View
  columns : Int
  off : () -> Bool
  selected_ : () -> Option[String]
  on_select : (String) -> Unit
  swatches_sig : signals::Signal[Array[ColorSwatchEntry]]
  matched_id : signals::Computed[Option[view::NodeId]]
  mounting : signals::Signal[Bool]
  init_buf : Array[ColorSwatchEntry]
  mount_sel_hex : signals::Ref[Option[String]]
  mount_sel_rgba : signals::Ref[Option[Int64]]
  mount_sel_rgb : signals::Ref[Option[String]]
  mount_exact_id : signals::Ref[Option[view::NodeId]]
  mount_fallback_id : signals::Ref[Option[view::NodeId]]
  focus_idx : signals::Signal[Int]
}

fn option_str_eq(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn ColorSwatchPicker::recompute_mount_match(self : ColorSwatchPicker) -> Unit {
  match self.mount_sel_hex.v {
    None => {
      self.mount_exact_id.v = None
      self.mount_fallback_id.v = None
    }
    Some(s) => {
      let sel_rgba = self.mount_sel_rgba.v
      let sel_rgb = self.mount_sel_rgb.v
      let mut exact_id : Option[view::NodeId] = None
      let mut fallback_id : Option[view::NodeId] = None
      for e in self.init_buf {
        let exact = if e.hex == s {
          true
        } else {
          match (sel_rgba, e.rgba8) {
            (Some(a), Some(b)) => a == b
            _ => false
          }
        }
        if exact {
          exact_id = Some(e.node.id())
          break
        }
        if fallback_id is None && !e.has_alpha {
          match (sel_rgb, e.rgb_hex) {
            (Some(ra), Some(rb)) =>
              if ra == rb {
                fallback_id = Some(e.node.id())
              }
            _ => ()
          }
        }
      }
      self.mount_exact_id.v = exact_id
      self.mount_fallback_id.v = fallback_id
    }
  }
}

fn ColorSwatchPicker::sync_mount_cache(self : ColorSwatchPicker) -> Bool {
  let cur = signals::untracked(self.selected_)
  if option_str_eq(cur, self.mount_sel_hex.v) {
    return false
  }
  self.mount_sel_hex.v = cur
  match cur {
    None => {
      self.mount_sel_rgba.v = None
      self.mount_sel_rgb.v = None
    }
    Some(s) => {
      let parsed = headless_core::color_parse_hex(s)
      self.mount_sel_rgba.v = match parsed {
        Some(c) => Some(c.to_rgba8())
        None => None
      }
      self.mount_sel_rgb.v = match parsed {
        Some(c) => Some(c.to_hex())
        None => None
      }
    }
  }
  self.recompute_mount_match()
  true
}

pub fn ColorSwatchPicker::node(self : ColorSwatchPicker) -> view::View {
  self.node
}

/// Mount a headless 2D grid `ColorSwatchPicker` (`Role::Listbox` with 2D arrow roving).
pub fn color_swatch_picker(
  parent : view::View,
  label : () -> String,
  selected : () -> Option[String],
  on_select : (String) -> Unit,
  look : (view::View, ColorSwatchPicker) -> Unit,
  columns~ : Int = 6,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let cols = if columns < 1 { 1 } else { columns }
  let setup = fn(v : view::View) {
    let swatches_sig : signals::Signal[Array[ColorSwatchEntry]] = signals::signal_by(
      [],
      fn(_a : Array[ColorSwatchEntry], _b : Array[ColorSwatchEntry]) -> Bool { false },
    )
    let matched_id = signals::computed_by(
      fn(_prev : Option[Option[view::NodeId]]) -> Option[view::NodeId] {
        let cur_swatches = swatches_sig.get()
        match selected() {
          Some(s) => color_swatch_matched_id(cur_swatches, s)
          None => None
        }
      },
      fn(a : Option[view::NodeId], b : Option[view::NodeId]) -> Bool {
        match (a, b) {
          (None, None) => true
          (Some(x), Some(y)) => x == y
          _ => false
        }
      },
    )
    let _ = v.owns(fn() {
      matched_id.dispose()
      swatches_sig.set([])
    })
    let mounting : signals::Signal[Bool] = signals::signal(true)
    let init_buf : Array[ColorSwatchEntry] = []
    let mount_sel_hex_init = signals::untracked(selected)
    let mount_parsed = match mount_sel_hex_init {
      Some(s) => headless_core::color_parse_hex(s)
      None => None
    }
    let mount_sel_rgba_init = match mount_parsed {
      Some(c) => Some(c.to_rgba8())
      None => None
    }
    let mount_sel_rgb_init = match mount_parsed {
      Some(c) => Some(c.to_hex())
      None => None
    }
    let sp = ColorSwatchPicker::{
      node: v,
      columns: cols,
      off: disabled,
      selected_: selected,
      on_select,
      swatches_sig,
      matched_id,
      mounting,
      init_buf,
      mount_sel_hex: view::ref_new(mount_sel_hex_init),
      mount_sel_rgba: view::ref_new(mount_sel_rgba_init),
      mount_sel_rgb: view::ref_new(mount_sel_rgb_init),
      mount_exact_id: view::ref_new(None),
      mount_fallback_id: view::ref_new(None),
      focus_idx: signals::signal(0),
    }
    look(v, sp)
    signals::batch(fn() {
      if init_buf.length() > 0 {
        let committed = init_buf.copy()
        init_buf.clear()
        swatches_sig.set(committed)
      }
      mounting.set(false)
    })
    let _ = v
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Listbox, label=label()))
    }))
    .on_key(fn(k : view::Key) -> Bool {
      if disabled() || k.mods != 0 || !focus_in(v, false) {
        return false
      }
      let cur_swatches = sp.swatches_sig.untracked()
      let n = cur_swatches.length()
      if n == 0 {
        return false
      }
      let mut cur = -1
      let mut i = 0
      while i < n {
        if cur_swatches[i].node.focused() {
          cur = i
          break
        }
        i += 1
      }
      if cur < 0 {
        return false
      }
      let next = if k.code == grid_key_right {
        if cur + 1 < n { cur + 1 } else { cur }
      } else if k.code == grid_key_left {
        if cur > 0 { cur - 1 } else { cur }
      } else if k.code == group_key_down {
        if cur + cols < n { cur + cols } else { cur }
      } else if k.code == group_key_up {
        if cur - cols >= 0 { cur - cols } else { cur }
      } else if k.code == group_key_home {
        0
      } else if k.code == group_key_end {
        n - 1
      } else {
        return false
      }
      if next != cur && !(cur_swatches[next].off)() && cur_swatches[next].node.alive() {
        sp.focus_idx.set(next)
        let _ = cur_swatches[next].node.ask_focus(visible=true)
      }
      true
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

fn color_hex_has_alpha(raw : String) -> Bool {
  let s = raw.trim()
  let n = s.length()
  let digits = if n > 0 && s.code_unit_at(0) == 35 { n - 1 } else { n }
  digits == 4 || digits == 8
}

/// Resolve the single winning swatch `NodeId` for `selected_hex` in O(N) with a single parse:
/// 1) exact RGBA8 match across the whole group first (so `#AABBCC` and `#AABBCC80` never double-select);
/// 2) 6-digit RGB fallback only when no swatch in the group matched exact RGBA8.
fn color_swatch_matched_id(
  swatches : Array[ColorSwatchEntry],
  selected_hex : String,
) -> Option[view::NodeId] {
  let parsed = headless_core::color_parse_hex(selected_hex)
  let sel_rgba = match parsed {
    Some(c) => Some(c.to_rgba8())
    None => None
  }
  let sel_rgb = match parsed {
    Some(c) => Some(c.to_hex())
    None => None
  }
  let mut rgb_fallback : Option[view::NodeId] = None
  for e in swatches {
    if e.hex == selected_hex {
      return Some(e.node.id())
    }
    match (sel_rgba, e.rgba8) {
      (Some(a), Some(b)) =>
        if a == b {
          return Some(e.node.id())
        }
      _ => ()
    }
    if rgb_fallback is None && !e.has_alpha {
      match (sel_rgb, e.rgb_hex) {
        (Some(ra), Some(rb)) =>
          if ra == rb {
            rgb_fallback = Some(e.node.id())
          }
        _ => ()
      }
    }
  }
  rgb_fallback
}

/// Mount one swatch (`Role::Option`) in `ColorSwatchPicker`.
pub fn ColorSwatchPicker::swatch(
  self : ColorSwatchPicker,
  parent : view::View,
  hex : String,
  label : () -> String,
  look : (view::View, () -> Bool) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { (self.off)() || disabled() }
    let able = fn() -> Bool { !off() }
    let is_sel = fn() -> Bool {
      let win = if self.mounting.get() {
        let _ = self.matched_id.get()
        let _ = self.sync_mount_cache()
        match self.mount_exact_id.v {
          Some(id) => Some(id)
          None => self.mount_fallback_id.v
        }
      } else {
        self.matched_id.get()
      }
      match win {
        Some(win_id) => win_id == v.id()
        None => false
      }
    }
    let parsed_sw = headless_core::color_parse_hex(hex)
    let entry = ColorSwatchEntry::{
      hex,
      node: v,
      off,
      has_alpha: color_hex_has_alpha(hex),
      rgba8: match parsed_sw { Some(c) => Some(c.to_rgba8()); None => None },
      rgb_hex: match parsed_sw { Some(c) => Some(c.to_hex()); None => None },
    }
    let idx = if self.mounting.untracked() {
      let i = self.init_buf.length()
      self.init_buf.push(entry)
      if !self.sync_mount_cache() && self.mount_exact_id.v is None {
        let exact = match self.mount_sel_hex.v {
          Some(s) if s == entry.hex => true
          _ =>
            match (self.mount_sel_rgba.v, entry.rgba8) {
              (Some(a), Some(b)) => a == b
              _ => false
            }
        }
        if exact {
          self.mount_exact_id.v = Some(v.id())
        } else if self.mount_fallback_id.v is None && !entry.has_alpha {
          match (self.mount_sel_rgb.v, entry.rgb_hex) {
            (Some(ra), Some(rb)) =>
              if ra == rb {
                self.mount_fallback_id.v = Some(v.id())
              }
            _ => ()
          }
        }
      }
      i
    } else {
      let prev_sw = self.swatches_sig.untracked()
      let i = prev_sw.length()
      let next_sw = prev_sw.copy()
      next_sw.push(entry)
      self.swatches_sig.set(next_sw)
      i
    }
    let _ = v.owns(fn() {
      if self.node.letting_go() {
        return
      }
      if self.mounting.untracked() {
        view::array_retain(self.init_buf, fn(e : ColorSwatchEntry) -> Bool { e.node.id() != v.id() })
        self.recompute_mount_match()
        return
      }
      let cur_sw = self.swatches_sig.untracked().copy()
      view::array_retain(cur_sw, fn(e : ColorSwatchEntry) -> Bool { e.node.id() != v.id() })
      self.swatches_sig.set(cur_sw)
    })
    look(v, is_sel)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=view::focus_enter | view::focus_space, tab=false)
    .tab_stop(view::Live::By(fn() -> Bool { self.focus_idx.get() == idx }))
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Option, label=label(), selected=is_sel()))
    }))
    .on_press(fn() {
      if able() {
        self.focus_idx.set(idx)
        (self.on_select)(hex)
      }
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
