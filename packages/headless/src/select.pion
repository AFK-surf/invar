// Unified headless Select / ComboBox / Autocomplete selector:
// Strictly separates `query`, `active_key`, `selected_keys` (single + multi), and `open`;
// supports closed-state trigger typeahead, clear action (never accidentally opens popup),
// virtual focus (`controls` + `active_descendant`), Esc/Tab/IME guard, and filter-safe multi-select.
//
// Keys are taken only while the keyboard's focus is in the selector's own scope (its trigger/input or its popup):
// a sibling selector, grid or list never answers a key meant for another. The popup closes as the focus leaves
// that scope (Tab / Shift+Tab, a press elsewhere). Arrays cross the API boundary as copies, both ways.

import "headless_core"
import "signals"
import "view"

struct SelectOptionNode[K] {
  key : K
  label : () -> String
  off : () -> Bool
  node : view::View
  active_cell : signals::Signal[Bool]
  mut idx : Int
}

fn opt_key_eq[K : view::ViewEq](a : Option[K], b : Option[K]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.eq(y)
    _ => false
  }
}

fn key_array_eq[K : view::ViewEq](a : Array[K], b : Array[K]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !a[i].eq(b[i]) {
      return false
    }
    i += 1
  }
  true
}

/// Unified selector controller for `Select`, `ComboBox`, and `Autocomplete`.
pub struct Selector[K] {
  node : view::View
  label_ : () -> String
  multiple : Bool
  filterable : Bool
  wraps : Bool
  off : () -> Bool
  composing : () -> Bool
  open_by : Option[() -> Bool]
  selected_by : Option[() -> Array[K]]
  open_sig : signals::Signal[Bool]
  query_sig : signals::Signal[String]
  active_sig : signals::Signal[Option[K]]
  selected_sig : signals::Signal[Array[K]]
  all_keys : () -> Array[K]
  visible_keys : () -> Array[K]
  key_label : (K) -> String
  key_disabled : (K) -> Bool
  on_open_change : Option[(Bool) -> Unit]
  on_selection_change : Option[(Array[K]) -> Unit]
  on_query_change : Option[(String) -> Unit]
  listbox_id : signals::Signal[Option[view::NodeId]]
  option_nodes : Array[SelectOptionNode[K]]
  options_rev : signals::Signal[Int]
  scope_nodes : Array[view::View]
  scope_rev : signals::Signal[Int]
  press_count : signals::Signal[Int]
  ta_buf : signals::Ref[String]
  ta_at : signals::Ref[Double]
  ta_window_ms : Double
}

pub fn Selector::node[K](self : Selector[K]) -> view::View {
  self.node
}

pub fn Selector::disabled[K](self : Selector[K]) -> Bool {
  (self.off)()
}

pub fn Selector::multiple[K](self : Selector[K]) -> Bool {
  self.multiple
}

pub fn Selector::is_open[K](self : Selector[K]) -> Bool {
  match self.open_by {
    Some(f) => f()
    None => self.open_sig.get()
  }
}

fn Selector::is_open_now[K](self : Selector[K]) -> Bool {
  match self.open_by {
    Some(f) => signals::untracked(f)
    None => self.open_sig.untracked()
  }
}

pub fn Selector::query[K](self : Selector[K]) -> String {
  self.query_sig.get()
}

pub fn Selector::active_key[K](self : Selector[K]) -> Option[K] {
  self.active_sig.get()
}

fn Selector::set_active[K : view::ViewEq](self : Selector[K], next : Option[K]) -> Unit {
  let prev = self.active_sig.untracked()
  if opt_key_eq(prev, next) {
    return
  }
  self.active_sig.set(next)
  for e in self.option_nodes {
    let was = match prev { Some(pk) => e.key.eq(pk); None => false }
    let now = match next { Some(nk) => e.key.eq(nk); None => false }
    if was != now {
      e.active_cell.set(now)
    }
  }
}

/// The chosen keys (a copy: changing it never changes the selector's own).
pub fn Selector::selected_keys[K](self : Selector[K]) -> Array[K] {
  match self.selected_by {
    Some(f) => f().copy()
    None => self.selected_sig.get().copy()
  }
}

fn Selector::selected_now[K](self : Selector[K]) -> Array[K] {
  match self.selected_by {
    Some(f) => signals::untracked(f)
    None => self.selected_sig.untracked()
  }
}

/// The visible, enabled keys in their order (tracked: reading it follows the filter and the items).
fn Selector::live_visible[K](self : Selector[K]) -> Array[K] {
  view::array_filter((self.visible_keys)(), fn(k : K) -> Bool { !(self.key_disabled)(k) })
}

fn Selector::live_visible_now[K](self : Selector[K]) -> Array[K] {
  signals::untracked(fn() -> Array[K] { self.live_visible() })
}

/// Whether `key` is visible and enabled now: what Enter / Space may still choose.
pub fn Selector::can_choose[K : view::ViewEq](self : Selector[K], key : K) -> Bool {
  view::array_any(self.live_visible_now(), fn(k : K) -> Bool { k.eq(key) })
}

/// Whether the keyboard's focus is in this selector's scope (its trigger/input or popup), tracked.
pub fn Selector::focus_in_scope[K](self : Selector[K]) -> Bool {
  let _ = self.scope_rev.get()
  view::array_any(self.scope_nodes, fn(n : view::View) -> Bool { n.alive() && n.focus_within() })
}

/// Whether the keyboard's focus is in this selector's scope now (untracked): its key handlers take keys only so.
pub fn Selector::owns_focus[K](self : Selector[K]) -> Bool {
  signals::untracked(fn() -> Bool { self.focus_in_scope() })
}

/// Register an additional view node (e.g., ComboBox input group or Autocomplete trigger/filter)
/// into this selector's focus scope.
pub fn Selector::add_scope[K](self : Selector[K], v : view::View) -> Unit {
  if view::array_any(self.scope_nodes, fn(n : view::View) -> Bool { n.id() == v.id() }) {
    return
  }
  self.scope_nodes.push(v)
  self.scope_rev.set(self.scope_rev.untracked() + 1)
  let _ = v.owns(fn() {
    view::array_retain(self.scope_nodes, fn(n : view::View) -> Bool { n.id() != v.id() })
    self.scope_rev.set(self.scope_rev.untracked() + 1)
  })
}

/// Guard a pressable node inside this selector's scope so pointer-down on it does not
/// prematurely close the popup when a sibling Field blurs before pointer-up delivers `on_press`.
pub fn Selector::guard_press[K](self : Selector[K], v : view::View) -> Unit {
  let held = view::ref_new(false)
  v.reacts(
    fn() -> Bool { v.pressed() },
    fn(p : Bool) -> Unit {
      if p && !held.v {
        held.v = true
        self.press_count.set(self.press_count.untracked() + 1)
      } else if !p && held.v {
        held.v = false
        let cur = self.press_count.untracked()
        self.press_count.set(if cur > 0 { cur - 1 } else { 0 })
      }
    },
    at_start=false,
  )
  let _ = v.owns(fn() {
    if held.v {
      held.v = false
      let cur = self.press_count.untracked()
      self.press_count.set(if cur > 0 { cur - 1 } else { 0 })
    }
  })
}

/// Whether a pointer press is currently held on any guarded node inside this selector's scope (tracked, O(1)).
pub fn Selector::press_in_scope[K](self : Selector[K]) -> Bool {
  self.press_count.get() > 0
}

pub fn Selector::is_selected[K : view::ViewEq](self : Selector[K], key : K) -> Bool {
  let cur = match self.selected_by {
    Some(f) => f()
    None => self.selected_sig.get()
  }
  view::array_any(cur, fn(k : K) -> Bool { k.eq(key) })
}

pub fn Selector::controls_id[K](self : Selector[K]) -> Option[view::NodeId] {
  if self.is_open() { self.listbox_id.get() } else { None }
}

/// Return the live `view::View` for the currently active option, if mounted.
pub fn Selector::active_option_view[K : view::ViewEq](self : Selector[K]) -> Option[view::View] {
  match self.active_sig.untracked() {
    Some(ak) => {
      for e in self.option_nodes {
        if e.node.alive() && !e.node.leaving() && e.key.eq(ak) {
          return Some(e.node)
        }
      }
      None
    }
    None => None
  }
}

pub fn Selector::active_descendant_id[K : view::ViewEq](self : Selector[K]) -> Option[view::NodeId] {
  let _ = self.options_rev.get()
  if !self.is_open() {
    return None
  }
  match self.active_sig.get() {
    Some(ak) => {
      for e in self.option_nodes {
        if e.node.alive() && !e.node.leaving() && e.key.eq(ak) {
          return Some(e.node.id())
        }
      }
      None
    }
    None => None
  }
}

/// Set open state; when opening, ensures `active_key` points to a live visible enabled option.
/// In controlled mode (`open_by` set), only emits `on_open_change(next)` without mutating internal state.
pub fn Selector::set_open[K : view::ViewEq](self : Selector[K], next : Bool) -> Unit {
  if next && signals::untracked(self.off) {
    return
  }
  let prev = self.is_open_now()
  if prev == next {
    return
  }
  match self.open_by {
    Some(_) =>
      match self.on_open_change {
        Some(f) => f(next)
        None => ()
      }
    None => {
      self.open_sig.set(next)
      if next {
        self.land_active()
      }
      match self.on_open_change {
        Some(f) => f(next)
        None => ()
      }
    }
  }
}

/// Update the filter query without touching `selected_keys`. `on_query_change` is told first (it may filter the
/// items itself), then `active_key` is reconciled against the visible options that result; a later change of the
/// visible options (whatever caused it) reconciles it again (`selector`).
pub fn Selector::set_query[K : view::ViewEq](self : Selector[K], next : String, open_if_closed~ : Bool = false) -> Unit {
  self.query_sig.set(next)
  match self.on_query_change {
    Some(f) => f(next)
    None => ()
  }
  if open_if_closed && !self.is_open_now() && !signals::untracked(self.off) {
    self.set_open(true)
  }
  self.reconcile_active()
}

/// As the popup opens: `active_key` on the first visible, enabled chosen key where there is one, else reconciled.
fn Selector::land_active[K : view::ViewEq](self : Selector[K]) -> Unit {
  let vis = self.live_visible_now()
  let chosen = self.selected_now()
  match view::array_find_first(vis, fn(k : K) -> Bool { view::array_any(chosen, fn(c : K) -> Bool { c.eq(k) }) }) {
    Some(k) => self.set_active(Some(k))
    None => self.reconcile_active()
  }
}

/// Ensure `active_key` is either still in `visible_keys` and enabled, or falls back to the first enabled visible key.
pub fn Selector::reconcile_active[K : view::ViewEq](self : Selector[K]) -> Unit {
  let vis = self.live_visible_now()
  match self.active_sig.untracked() {
    Some(ak) => {
      if view::array_any(vis, fn(k : K) -> Bool { k.eq(ak) }) {
        return
      }
    }
    None => ()
  }
  if vis.length() > 0 {
    self.set_active(Some(vis[0]))
  } else {
    self.set_active(None)
  }
}

/// Choose `key`: in single-select replaces `selected_keys` and closes; in multi-select toggles `key`
/// in `selected_keys` WITHOUT discarding any previously selected keys (even if filtered out!).
pub fn Selector::choose[K : view::ViewEq](self : Selector[K], key : K) -> Unit {
  if signals::untracked(self.off) || (self.key_disabled)(key) {
    return
  }
  let cur = self.selected_now()
  let next : Array[K] = []
  if self.multiple {
    let mut found = false
    for k in cur {
      if k.eq(key) {
        found = true
      } else {
        next.push(k)
      }
    }
    if !found {
      next.push(key)
    }
  } else {
    next.push(key)
  }
  if self.selected_by is None {
    self.selected_sig.set(next)
  }
  self.set_active(Some(key))
  match self.on_selection_change {
    Some(f) => f(next.copy())
    None => ()
  }
  if !self.multiple {
    self.set_open(false)
  }
}

/// Clear selection (and query when `clear_query=true`). NEVER opens the popup!
pub fn Selector::clear[K : view::ViewEq](self : Selector[K], clear_query~ : Bool = true) -> Unit {
  if signals::untracked(self.off) {
    return
  }
  let empty : Array[K] = []
  if self.selected_by is None {
    self.selected_sig.set(empty)
  }
  if clear_query {
    self.query_sig.set("")
    match self.on_query_change {
      Some(f) => f("")
      None => ()
    }
    if self.is_open_now() {
      self.reconcile_active()
    }
  }
  match self.on_selection_change {
    Some(f) => f([])
    None => ()
  }
}

/// Move `active_key` by `delta` (`+1` / `-1`) within live enabled `visible_keys`.
pub fn Selector::step_active[K : view::ViewEq](self : Selector[K], delta : Int) -> Option[K] {
  let vis = self.live_visible_now()
  let n = vis.length()
  if n == 0 {
    self.set_active(None)
    return None
  }
  let at = match self.active_sig.untracked() {
    Some(ak) => view::array_search_eq(vis, ak)
    None => None
  }
  let j = match at {
    None => if delta >= 0 { 0 } else { n - 1 }
    Some(i) => {
      let raw = i + delta
      if raw < 0 {
        if self.wraps { n - 1 } else { 0 }
      } else if raw >= n {
        if self.wraps { 0 } else { n - 1 }
      } else {
        raw
      }
    }
  }
  let k = vis[j]
  self.set_active(Some(k))
  Some(k)
}

/// Move `active_key` to the first (`to_end=false`) or last live enabled visible key (Home / End).
pub fn Selector::edge_active[K : view::ViewEq](self : Selector[K], to_end : Bool) -> Option[K] {
  let vis = self.live_visible_now()
  if vis.length() == 0 {
    self.set_active(None)
    return None
  }
  let k = if to_end { vis[vis.length() - 1] } else { vis[0] }
  self.set_active(Some(k))
  Some(k)
}

/// Move `active_key` by `delta` keys, held at the ends rather than wrapping (PageUp / PageDown).
pub fn Selector::page_active[K : view::ViewEq](self : Selector[K], delta : Int) -> Option[K] {
  let vis = self.live_visible_now()
  let n = vis.length()
  if n == 0 {
    self.set_active(None)
    return None
  }
  let at = match self.active_sig.untracked() {
    Some(ak) => view::array_search_eq(vis, ak)
    None => None
  }
  let raw = match at {
    Some(i) => i + delta
    None => if delta >= 0 { delta - 1 } else { n + delta }
  }
  let j = if raw < 0 { 0 } else if raw >= n { n - 1 } else { raw }
  let k = vis[j]
  self.set_active(Some(k))
  Some(k)
}

/// Choose the active key from the keyboard, only while it is still visible and enabled: an active key the filter
/// just took away is reconciled instead, never chosen.
fn Selector::choose_active[K : view::ViewEq](self : Selector[K]) -> Bool {
  match self.active_sig.untracked() {
    Some(ak) if self.can_choose(ak) => {
      self.choose(ak)
      true
    }
    Some(_) => {
      self.reconcile_active()
      true
    }
    None => false
  }
}

fn Selector::closed_typeahead[K : view::ViewEq](self : Selector[K], k : view::Key, now : Double) -> Bool {
  if self.filterable || self.multiple {
    return false
  }
  if k.code <= listbox_key_char || k.code == listbox_key_space || (k.mods != 0 && k.mods != shift_mod) {
    return false
  }
  let ch = (k.code - listbox_key_char).unsafe_to_char()
  let sb = StringBuilder::new()
  sb.write_char(ch)
  let piece = ascii_lower(sb.to_string())
  let next_buf = if now - self.ta_at.v <= self.ta_window_ms { self.ta_buf.v + piece } else { piece }
  self.ta_buf.v = next_buf
  self.ta_at.v = now
  let live = view::array_filter(signals::untracked(self.all_keys), fn(x : K) -> Bool { !(self.key_disabled)(x) })
  for item in live {
    let lbl = ascii_lower((self.key_label)(item))
    if str_has_prefix(lbl, next_buf) {
      self.choose(item)
      return true
    }
  }
  false
}


/// Selector keys go a page at a time by this many options (PageUp / PageDown).
let select_page_step : Int = 10

/// Handle keyboard events on the trigger/input node (preserving keyboard focus on trigger/input). The trigger's own
/// handler calls it only while the focus is in this selector's scope (`Selector::owns_focus`).
pub fn Selector::handle_key[K : view::ViewEq](self : Selector[K], k : view::Key, now : Double) -> Bool {
  if signals::untracked(self.off) || (self.composing)() {
    return false
  }
  let open = self.is_open_now()
  if k.code == headless_core::key_escape && k.mods == 0 {
    if open {
      self.set_open(false)
      return true
    }
    return false
  }
  if k.code == headless_core::key_tab {
    // (the host moves the focus on Tab itself, and the popup closes as the focus leaves the scope; where a Tab
    // reaches here it closes the popup and lets the focus go on, never trapping it)
    if open {
      self.set_open(false)
    }
    return false
  }
  if !open && !self.filterable && k.mods == 0 && (k.code == headless_core::key_delete || k.code == headless_core::key_backspace) {
    // Delete/Backspace on closed non-text Select clears selection without opening popup
    self.clear(clear_query=false)
    return true
  }
  if k.mods == 0 && (k.code == headless_core::key_down || k.code == headless_core::key_up) {
    if !open {
      self.set_open(true)
      return true
    }
    let _ = self.step_active(if k.code == headless_core::key_down { 1 } else { -1 })
    return true
  }
  if open && k.mods == 0 && (k.code == headless_core::key_home || k.code == headless_core::key_end) {
    let _ = self.edge_active(k.code == headless_core::key_end)
    return true
  }
  if open && k.mods == 0 && (k.code == headless_core::key_page_up || k.code == headless_core::key_page_down) {
    let _ = self.page_active(if k.code == headless_core::key_page_down { select_page_step } else { -select_page_step })
    return true
  }
  if k.mods == 0 && k.code == headless_core::key_enter {
    if !open {
      self.set_open(true)
      return true
    }
    return self.choose_active()
  }
  if k.mods == 0 && k.code == headless_core::key_space && !self.filterable {
    if !open {
      self.set_open(true)
      return true
    }
    return self.choose_active()
  }
  if !open {
    return self.closed_typeahead(k, now)
  }
  false
}

/// Mount a unified headless `Selector` (`Select` / `ComboBox` / `Autocomplete`) in `parent`.
pub fn selector[K : view::ViewEq](
  parent : view::View,
  label : () -> String,
  all_keys : () -> Array[K],
  visible_keys : () -> Array[K],
  key_label : (K) -> String,
  look : (view::View, Selector[K]) -> Unit,
  initial_selected~ : Array[K] = [],
  multiple~ : Bool = false,
  filterable~ : Bool = false,
  wraps~ : Bool = true,
  key_disabled? : (K) -> Bool,
  disabled~ : () -> Bool = fn() { false },
  composing~ : () -> Bool = fn() { false },
  open_by? : () -> Bool,
  selected_by? : () -> Array[K],
  on_open_change? : (Bool) -> Unit,
  on_selection_change? : (Array[K]) -> Unit,
  on_query_change? : (String) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let key_off_fn : (K) -> Bool = match key_disabled {
    Some(f) => f
    None => fn(_k : K) -> Bool { false }
  }
  let init_sel : Array[K] = if !multiple && initial_selected.length() > 0 {
    let all = signals::untracked(all_keys)
    if all.length() > 0 {
      match view::array_find_first(initial_selected, fn(k : K) -> Bool {
        view::array_any(all, fn(ak : K) -> Bool { ak.eq(k) })
      }) {
        Some(k) => [k]
        None => []
      }
    } else {
      [initial_selected[0]]
    }
  } else {
    initial_selected.copy()
  }
  let setup = fn(v : view::View) {
    let sel = Selector::{
      node: v,
      label_: label,
      multiple,
      filterable,
      wraps,
      off: disabled,
      composing,
      open_by,
      selected_by,
      open_sig: signals::signal(false),
      query_sig: signals::signal(""),
      active_sig: signals::signal_by(None, fn(a : Option[K], b : Option[K]) -> Bool { opt_key_eq(a, b) }),
      selected_sig: signals::signal_by(init_sel, fn(a : Array[K], b : Array[K]) -> Bool { key_array_eq(a, b) }),
      all_keys,
      visible_keys,
      key_label,
      key_disabled: key_off_fn,
      on_open_change,
      on_selection_change,
      on_query_change,
      listbox_id: signals::signal_by(None, same_node_id_opt),
      option_nodes: [],
      options_rev: signals::signal(0),
      scope_nodes: [],
      scope_rev: signals::signal(0),
      press_count: signals::signal(0),
      ta_buf: view::ref_new(""),
      ta_at: view::ref_new(-10000.0),
      ta_window_ms: 500.0,
    }
    look(v, sel)
    // Controlled open_by: land active_key whenever the parent opens the popup.
    match open_by {
      Some(og) => {
        if signals::untracked(og) {
          sel.land_active()
        }
        v.reacts(og, fn(now_open : Bool) -> Unit {
          if now_open {
            sel.land_active()
          }
        }, at_start=false)
      }
      None => ()
    }
    // (the visible options changing while open, by the filter or by the items themselves: `active_key` follows,
    // reading the list as it is now, never an older one)
    v.reacts_by(
      fn() -> Array[K] { sel.live_visible() },
      fn(a : Array[K], b : Array[K]) -> Bool { key_array_eq(a, b) },
      fn(_vis : Array[K]) {
        if sel.is_open_now() {
          sel.reconcile_active()
        }
      },
      at_start=false,
    )
    // Unified blur-close watcher: closes the popup when focus leaves the selector's scope,
    // while keeping it alive across pointer-down -> pointer-up on any guarded node inside scope.
    let had_focus = view::ref_new(false)
    let was_pressing = view::ref_new(false)
    v.reacts(
      fn() -> Int {
        (if sel.focus_in_scope() { 2 } else { 0 }) + (if sel.press_in_scope() { 1 } else { 0 })
      },
      fn(bits : Int) -> Unit {
        let f = bits >= 2
        let p = (bits % 2) == 1
        if p {
          was_pressing.v = true
        }
        if f {
          had_focus.v = true
          if !p {
            was_pressing.v = false
          }
          return
        }
        if p {
          return
        }
        if !had_focus.v {
          was_pressing.v = false
          return
        }
        had_focus.v = false
        if was_pressing.v {
          was_pressing.v = false
          if sel.is_open_now() {
            let _ = v.at_moment(v.cause_at() + 0.001, fn() -> Unit {
              if !sel.owns_focus() && sel.press_count.untracked() == 0 && sel.is_open_now() {
                sel.set_open(false)
              }
            }, later=true)
          }
        } else if sel.is_open_now() {
          sel.set_open(false)
        }
      },
      at_start=false,
    )
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount the focusable trigger / combobox input (`Role::Combobox`) with virtual focus (`controls` + `active_descendant`).
pub fn Selector::trigger[K : view::ViewEq](
  self : Selector[K],
  parent : view::View,
  look : (view::View, Selector[K]) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let able = fn() -> Bool { !(self.off)() }
    look(v, self)
    let _ = v
    .presses(view::Live::By(able))
    .focusable(view::Live::By(able), keys=0)
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(
        view::Role::Combobox,
        label=(self.label_)(),
        expanded=self.is_open(),
        controls=self.controls_id(),
        active_descendant=self.active_descendant_id(),
      ))
    }))
    .on_press(fn() {
      if able() {
        let _ = v.ask_focus(visible=false)
        self.set_open(!self.is_open_now())
      }
    })
    .on_key(fn(k : view::Key) -> Bool {
      // (a key is this selector's only while the focus is in its scope: never a sibling's)
      if !self.owns_focus() {
        return false
      }
      self.handle_key(k, v.cause_at())
    })
    self.add_scope(v)
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount the clear button (`Role::Button`) that clears selection/query without ever opening the popup.
pub fn Selector::clear_button[K : view::ViewEq](
  self : Selector[K],
  parent : view::View,
  look : (view::View, Button) -> Unit,
  label~ : () -> String = fn() { "Clear" },
  clear_query~ : Bool = true,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  button(
    parent,
    label,
    fn(_v : view::View) { self.clear(clear_query=clear_query) },
    look,
    disabled=self.off,
    in_node=in_node,
    made_for=resolve_made_for(made_for, loc),
    loc=loc,
  )
}

/// Mount the popup listbox (`Role::Listbox` with `multiselectable`) tracked by `Selector::controls_id`.
pub fn Selector::listbox[K](
  self : Selector[K],
  parent : view::View,
  look : (view::View) -> Unit,
  label? : () -> String,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    self.listbox_id.set(Some(v.id()))
    self.add_scope(v)
    let _ = v.owns(fn() {
      if same_node_id_opt(self.listbox_id.untracked(), Some(v.id())) {
        self.listbox_id.set(None)
      }
    })
    look(v)
    let lbl = match label {
      Some(f) => f
      None => self.label_
    }
    let _ = v.says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Listbox, label=lbl(), multiselectable=self.multiple))
    }))
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}

/// Mount one option (`Role::Option`) tracked by `Selector::active_descendant_id`.
pub fn Selector::option[K : view::ViewEq](
  self : Selector[K],
  parent : view::View,
  key : K,
  label : () -> String,
  look : (view::View, () -> Bool, () -> Bool) -> Unit,
  in_node~ : Bool = false,
  made_for? : String,
  loc~ : String = "",
) -> view::View {
  let setup = fn(v : view::View) {
    let off = fn() -> Bool { (self.off)() || (self.key_disabled)(key) }
    let able = fn() -> Bool { !off() }
    let active_cell = signals::signal(match self.active_sig.untracked() {
      Some(ak) => ak.eq(key)
      None => false
    })
    let is_active = fn() -> Bool { active_cell.get() }
    let is_sel = fn() -> Bool { self.is_selected(key) }
    let entry = SelectOptionNode::{ key, label, off, node: v, active_cell, idx: self.option_nodes.length() }
    self.option_nodes.push(entry)
    self.options_rev.set(self.options_rev.untracked() + 1)
    let _ = v.owns(fn() {
      let i = entry.idx
      let n = self.option_nodes.length()
      if i >= 0 && i < n && self.option_nodes[i].node.id() == v.id() {
        let last_idx = n - 1
        if i != last_idx {
          let last = self.option_nodes[last_idx]
          last.idx = i
          self.option_nodes[i] = last
        }
        let _ = self.option_nodes.pop()
        entry.idx = -1
        self.options_rev.set(self.options_rev.untracked() + 1)
      }
    })
    self.guard_press(v)
    look(v, is_active, is_sel)
    // (the pointer coming onto an option makes it the active one, as the keys would)
    v.reacts(fn() -> Bool { v.pointed() }, fn(over : Bool) {
      if over && signals::untracked(able) {
        self.set_active(Some(key))
      }
    }, at_start=false)
    let _ = v
    .presses(view::Live::By(able))
    .says(view::Live::By(fn() -> Option[view::Said] {
      Some(view::said(view::Role::Option, label=label(), selected=is_sel()))
    }))
    .on_press(fn() {
      if able() {
        self.choose(key)
      }
    })
  }
  if in_node {
    setup(parent)
    parent
  } else {
    parent.box(setup, made_for=resolve_made_for(made_for, loc), loc=loc)
  }
}
