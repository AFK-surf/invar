// Invar Official Website — 100% Pure Pion Static Site Generator (Zero React/Vite/npm).
// Usage: site [out_dir]   (defaults to "site_dist")

pub fn render_site_css() -> String {
  let sb = StringBuilder::new()
  sb.write_string(":root {\n")
  sb.write_string("  --bg: #0A0B0F;\n")
  sb.write_string("  --surface: #12141B;\n")
  sb.write_string("  --surface-2: #171A23;\n")
  sb.write_string("  --ink: #F2F4F8;\n")
  sb.write_string("  --muted: #98A0B3;\n")
  sb.write_string("  --accent: #FF6B3D;\n")
  sb.write_string("  --accent-ink: #0A0B0F;\n")
  sb.write_string("  --accent-soft: rgba(255, 107, 61, 0.14);\n")
  sb.write_string("  --border: rgba(255, 255, 255, 0.09);\n")
  sb.write_string("  --border-strong: rgba(255, 255, 255, 0.16);\n")
  sb.write_string("  --nav-bg: rgba(10, 11, 15, 0.76);\n")
  sb.write_string("  --code-bg: #0E1016;\n")
  sb.write_string("  --shadow: 0 24px 64px rgba(0, 0, 0, 0.45);\n")
  sb.write_string("  --btn-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);\n")
  sb.write_string("  --r-card: 22px;\n")
  sb.write_string("  --r-inner: 14px;\n")
  sb.write_string("  --r-btn: 10px;\n")
  sb.write_string("  --r-pill: 999px;\n")
  sb.write_string("  color-scheme: dark;\n")
  sb.write_string("}\n")
  sb.write_string("[data-theme=\"light\"] {\n")
  sb.write_string("  --bg: #F5F6FA;\n")
  sb.write_string("  --surface: #FFFFFF;\n")
  sb.write_string("  --surface-2: #EDF0F7;\n")
  sb.write_string("  --ink: #111318;\n")
  sb.write_string("  --muted: #5A6275;\n")
  sb.write_string("  --accent: #D9481E;\n")
  sb.write_string("  --accent-ink: #FFFFFF;\n")
  sb.write_string("  --accent-soft: rgba(217, 72, 30, 0.10);\n")
  sb.write_string("  --border: rgba(15, 23, 42, 0.09);\n")
  sb.write_string("  --border-strong: rgba(15, 23, 42, 0.16);\n")
  sb.write_string("  --nav-bg: rgba(245, 246, 250, 0.80);\n")
  sb.write_string("  --code-bg: #F0F2F8;\n")
  sb.write_string("  --shadow: 0 20px 48px rgba(15, 23, 42, 0.08);\n")
  sb.write_string("  --btn-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);\n")
  sb.write_string("  color-scheme: light;\n")
  sb.write_string("}\n")
  sb.write_string("*, *::before, *::after { box-sizing: border-box; }\n")
  sb.write_string("html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }\n")
  sb.write_string("body {\n")
  sb.write_string("  margin: 0;\n")
  sb.write_string("  background: var(--bg);\n")
  sb.write_string("  color: var(--ink);\n")
  sb.write_string("  font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Inter\", system-ui, sans-serif;\n")
  sb.write_string("  font-size: 16px;\n")
  sb.write_string("  line-height: 1.55;\n")
  sb.write_string("  -webkit-font-smoothing: antialiased;\n")
  sb.write_string("  overflow-x: clip;\n")
  sb.write_string("}\n")
  sb.write_string("a { color: inherit; text-decoration: none; }\n")
  sb.write_string("img { display: block; max-width: 100%; height: auto; }\n")
  sb.write_string("code, pre {\n")
  sb.write_string("  font-family: \"SF Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n")
  sb.write_string("}\n")
  sb.write_string(".wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }\n")
  sb.write_string("\n")
  // Sticky frosted glass top nav
  sb.write_string(".nav {\n")
  sb.write_string("  position: sticky; top: 0; z-index: 40;\n")
  sb.write_string("  background: var(--nav-bg);\n")
  sb.write_string("  backdrop-filter: saturate(180%) blur(20px);\n")
  sb.write_string("  -webkit-backdrop-filter: saturate(180%) blur(20px);\n")
  sb.write_string("  border-bottom: 1px solid var(--border);\n")
  sb.write_string("}\n")
  sb.write_string(".nav-in {\n")
  sb.write_string("  display: flex; align-items: center; justify-content: space-between;\n")
  sb.write_string("  gap: 16px; height: 60px;\n")
  sb.write_string("}\n")
  sb.write_string(".brand {\n")
  sb.write_string("  display: inline-flex; align-items: center; gap: 10px;\n")
  sb.write_string("  font-weight: 600; font-size: 16px; letter-spacing: -0.02em; flex-shrink: 0;\n")
  sb.write_string("}\n")
  sb.write_string(".brand-mark {\n")
  sb.write_string("  width: 24px; height: 24px; border-radius: 7px; display: inline-flex;\n")
  sb.write_string("  align-items: center; justify-content: center;\n")
  sb.write_string("  background: linear-gradient(135deg, #FF6B3D, #3B82F6);\n")
  sb.write_string("  color: #FFFFFF;\n")
  sb.write_string("}\n")
  sb.write_string(".nav-links {\n")
  sb.write_string("  display: flex; align-items: center; gap: 24px; color: var(--muted); font-size: 14px; font-weight: 500;\n")
  sb.write_string("}\n")
  sb.write_string(".nav-links a { transition: color 140ms ease; }\n")
  sb.write_string(".nav-links a:hover { color: var(--ink); }\n")
  sb.write_string(".nav-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }\n")
  sb.write_string(".btn {\n")
  sb.write_string("  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n")
  sb.write_string("  height: 36px; padding: 0 14px; border-radius: var(--r-btn);\n")
  sb.write_string("  font-size: 14px; font-weight: 500; cursor: pointer; white-space: nowrap;\n")
  sb.write_string("  border: 1px solid transparent; transition: background 140ms ease, border-color 140ms ease, transform 100ms ease;\n")
  sb.write_string("}\n")
  sb.write_string(".btn:active { transform: scale(0.98); }\n")
  sb.write_string(".btn-lg { height: 44px; padding: 0 20px; font-size: 15px; }\n")
  sb.write_string(".btn-primary { background: var(--ink); color: var(--bg); }\n")
  sb.write_string(".btn-primary:hover { opacity: 0.9; }\n")
  sb.write_string(".btn-ghost {\n")
  sb.write_string("  background: var(--surface); color: var(--ink); border-color: var(--border);\n")
  sb.write_string("  box-shadow: var(--btn-shadow);\n")
  sb.write_string("}\n")
  sb.write_string(".btn-ghost:hover { border-color: var(--border-strong); background: var(--surface-2); }\n")
  sb.write_string(".theme-btn {\n")
  sb.write_string("  height: 36px; padding: 0 12px; border-radius: var(--r-btn);\n")
  sb.write_string("  border: 1px solid var(--border); background: var(--surface); color: var(--ink);\n")
  sb.write_string("  font: 500 13px/1 inherit; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;\n")
  sb.write_string("  box-shadow: var(--btn-shadow);\n")
  sb.write_string("}\n")
  sb.write_string(".theme-btn:hover { border-color: var(--border-strong); background: var(--surface-2); }\n")
  sb.write_string("\n")
  // Hero
  sb.write_string(".hero { padding: 72px 0 56px; }\n")
  sb.write_string(".hero-head { max-width: 780px; margin: 0 auto 40px; text-align: center; }\n")
  sb.write_string(".eyebrow-row { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 20px; }\n")
  sb.write_string(".pill {\n")
  sb.write_string("  display: inline-flex; align-items: center; height: 26px; padding: 0 12px;\n")
  sb.write_string("  border-radius: var(--r-pill); font-size: 12px; font-weight: 500;\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border); color: var(--muted);\n")
  sb.write_string("}\n")
  sb.write_string(".pill-accent { background: var(--accent-soft); border-color: transparent; color: var(--accent); }\n")
  sb.write_string(".hero h1 {\n")
  sb.write_string("  margin: 0 0 18px; font-size: clamp(34px, 5vw, 56px); line-height: 1.08;\n")
  sb.write_string("  font-weight: 600; letter-spacing: -0.03em; text-wrap: balance;\n")
  sb.write_string("}\n")
  sb.write_string(".hero-sub {\n")
  sb.write_string("  margin: 0 auto 28px; max-width: 640px; font-size: 17px; line-height: 1.6;\n")
  sb.write_string("  color: var(--muted); text-wrap: pretty;\n")
  sb.write_string("}\n")
  sb.write_string(".hero-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }\n")
  sb.write_string(".frame {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); padding: 8px; box-shadow: var(--shadow);\n")
  sb.write_string("}\n")
  sb.write_string(".frame-inner {\n")
  sb.write_string("  border-radius: var(--r-inner); overflow: hidden; background: #090A0E;\n")
  sb.write_string("  aspect-ratio: 16 / 10;\n")
  sb.write_string("}\n")
  sb.write_string("[data-theme=\"light\"] .frame-inner { background: #EAEDF4; }\n")
  sb.write_string(".hero-img { width: 100%; height: 100%; object-fit: cover; }\n")
  sb.write_string(".hero-img-light { display: none; }\n")
  sb.write_string("[data-theme=\"light\"] .hero-img-dark { display: none; }\n")
  sb.write_string("[data-theme=\"light\"] .hero-img-light { display: block; }\n")
  sb.write_string("\n")
  // Sections
  sb.write_string(".sec { padding: 56px 0; }\n")
  sb.write_string(".sec-head { max-width: 660px; margin-bottom: 28px; }\n")
  sb.write_string(".sec-kicker { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }\n")
  sb.write_string(".sec h2 { margin: 0 0 10px; font-size: clamp(24px, 3vw, 32px); line-height: 1.18; font-weight: 600; letter-spacing: -0.025em; }\n")
  sb.write_string(".sec-lead { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.6; }\n")
  sb.write_string("\n")
  // Benchmarks KPI + Table
  sb.write_string(".kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 20px; }\n")
  sb.write_string(".kpi {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); padding: 20px;\n")
  sb.write_string("}\n")
  sb.write_string(".kpi-val {\n")
  sb.write_string("  font-size: 30px; line-height: 1.1; font-weight: 600; letter-spacing: -0.03em;\n")
  sb.write_string("  font-variant-numeric: tabular-nums; margin-bottom: 8px;\n")
  sb.write_string("}\n")
  sb.write_string(".kpi-label { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }\n")
  sb.write_string(".kpi-note { font-size: 13px; color: var(--muted); line-height: 1.45; }\n")
  sb.write_string(".table-card {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); overflow: hidden;\n")
  sb.write_string("}\n")
  sb.write_string(".table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }\n")
  sb.write_string(".cmp-table { width: 100%; border-collapse: collapse; min-width: 620px; font-size: 14px; }\n")
  sb.write_string(".cmp-table th, .cmp-table td { text-align: left; padding: 14px 18px; vertical-align: top; }\n")
  sb.write_string(".cmp-table th { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); background: var(--surface-2); }\n")
  sb.write_string(".cmp-table tbody tr + tr td { border-top: 1px solid var(--border); }\n")
  sb.write_string(".cmp-table td:first-child { font-weight: 500; color: var(--ink); }\n")
  sb.write_string(".cmp-table td.hi { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }\n")
  sb.write_string(".cmp-table td.dim { color: var(--muted); font-variant-numeric: tabular-nums; }\n")
  sb.write_string("\n")
  // Showcase 2x2
  sb.write_string(".shot-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }\n")
  sb.write_string(".shot-card {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); padding: 8px; display: flex; flex-direction: column;\n")
  sb.write_string("}\n")
  sb.write_string(".shot-media { border-radius: var(--r-inner); overflow: hidden; background: #090A0E; aspect-ratio: 16 / 10; }\n")
  sb.write_string("[data-theme=\"light\"] .shot-media { background: #EAEDF4; }\n")
  sb.write_string(".shot-media img { width: 100%; height: 100%; object-fit: cover; }\n")
  sb.write_string(".shot-body { padding: 16px 12px 10px; display: flex; flex-direction: column; gap: 6px; flex: 1; }\n")
  sb.write_string(".shot-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }\n")
  sb.write_string(".shot-title { font-size: 16px; font-weight: 600; letter-spacing: -0.015em; margin: 0; }\n")
  sb.write_string(".shot-desc { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.5; }\n")
  sb.write_string(".shot-link { font-size: 13px; font-weight: 500; color: var(--accent); margin-top: 6px; display: inline-flex; align-items: center; gap: 4px; width: fit-content; }\n")
  sb.write_string(".shot-link:hover { text-decoration: underline; }\n")
  sb.write_string("\n")
  // Architecture 3-col Bento
  sb.write_string(".bento-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\n")
  sb.write_string(".bento-card {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); padding: 22px; display: flex; flex-direction: column; gap: 12px;\n")
  sb.write_string("}\n")
  sb.write_string(".bento-step { font-size: 12px; font-weight: 600; color: var(--accent); font-variant-numeric: tabular-nums; }\n")
  sb.write_string(".bento-card h3 { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }\n")
  sb.write_string(".bento-card p { margin: 0; font-size: 14px; color: var(--muted); line-height: 1.55; }\n")
  sb.write_string(".pkg-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 4px; }\n")
  sb.write_string(".pkg-tag {\n")
  sb.write_string("  font-family: \"SF Mono\", ui-monospace, monospace; font-size: 12px;\n")
  sb.write_string("  padding: 3px 9px; border-radius: var(--r-pill);\n")
  sb.write_string("  background: var(--surface-2); border: 1px solid var(--border); color: var(--ink);\n")
  sb.write_string("}\n")
  sb.write_string("\n")
  // Quick Start
  sb.write_string(".qs-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 16px; }\n")
  sb.write_string(".code-card {\n")
  sb.write_string("  background: var(--surface); border: 1px solid var(--border);\n")
  sb.write_string("  border-radius: var(--r-card); padding: 8px; display: flex; flex-direction: column; min-width: 0;\n")
  sb.write_string("}\n")
  sb.write_string(".code-head { padding: 10px 14px; font-size: 12px; font-weight: 600; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }\n")
  sb.write_string(".code-pre {\n")
  sb.write_string("  margin: 0; padding: 16px; border-radius: var(--r-inner); background: var(--code-bg);\n")
  sb.write_string("  font-size: 13px; line-height: 1.6; overflow-x: auto; flex: 1; color: var(--ink);\n")
  sb.write_string("}\n")
  sb.write_string("\n")
  // Footer
  sb.write_string(".foot { border-top: 1px solid var(--border); padding: 28px 0 40px; margin-top: 32px; }\n")
  sb.write_string(".foot-in {\n")
  sb.write_string("  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;\n")
  sb.write_string("  gap: 12px 24px; font-size: 13px; color: var(--muted);\n")
  sb.write_string("}\n")
  sb.write_string(".foot-link { color: var(--ink); font-weight: 500; }\n")
  sb.write_string(".foot-link:hover { color: var(--accent); }\n")
  sb.write_string("\n")
  // Responsive
  sb.write_string("@media (max-width: 960px) {\n")
  sb.write_string("  .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n")
  sb.write_string("  .bento-grid { grid-template-columns: 1fr; }\n")
  sb.write_string("  .qs-grid { grid-template-columns: 1fr; }\n")
  sb.write_string("}\n")
  sb.write_string("@media (max-width: 720px) {\n")
  sb.write_string("  .wrap { padding: 0 16px; }\n")
  sb.write_string("  .nav-links { display: none; }\n")
  sb.write_string("  .hero { padding: 48px 0 36px; }\n")
  sb.write_string("  .sec { padding: 40px 0; }\n")
  sb.write_string("  .shot-grid { grid-template-columns: 1fr; }\n")
  sb.write_string("  .kpi-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n")
  sb.write_string("  .kpi { padding: 16px; }\n")
  sb.write_string("  .kpi-val { font-size: 24px; }\n")
  sb.write_string("  .btn-nav-cta { padding: 0 12px; font-size: 13px; }\n")
  sb.write_string("}\n")
  sb.to_string()
}

pub fn render_index_html() -> String {
  let sb = StringBuilder::new()
  sb.write_string("<!doctype html>\n")
  sb.write_string("<html lang=\"en\">\n")
  sb.write_string("<head>\n")
  sb.write_string("<meta charset=\"utf-8\">\n")
  sb.write_string("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n")
  sb.write_string("<link rel=\"icon\" href=\"data:,\">\n")
  sb.write_string("<title>Invar — GPU-First UI &amp; Liquid Glass in 100% Pure Pion</title>\n")
  sb.write_string("<meta name=\"description\" content=\"GPU-first reactive UI engine and 34-component iOS 27 Liquid Glass library written in 100% Pure Pion, compiling to Apple Metal and 505 KB brotli WebGL2 wasm32.\">\n")
  sb.write_string("<script>(function(){var s=localStorage.getItem(\"invar-theme\");if(!s)s=matchMedia(\"(prefers-color-scheme: light)\").matches?\"light\":\"dark\";document.documentElement.dataset.theme=s;})();</script>\n")
  sb.write_string("<link rel=\"stylesheet\" href=\"./site.css\">\n")
  sb.write_string("</head>\n")
  sb.write_string("<body>\n")

  // Top Nav
  sb.write_string("<header class=\"nav\">\n")
  sb.write_string("  <div class=\"wrap nav-in\">\n")
  sb.write_string("    <a class=\"brand\" href=\"#top\">\n")
  sb.write_string("      <span class=\"brand-mark\" aria-hidden=\"true\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><rect x=\"1.5\" y=\"1.5\" width=\"11\" height=\"11\" rx=\"3.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/><circle cx=\"7\" cy=\"7\" r=\"2\" fill=\"currentColor\"/></svg></span>\n")
  sb.write_string("      <span>Invar</span>\n")
  sb.write_string("    </a>\n")
  sb.write_string("    <nav class=\"nav-links\" aria-label=\"Primary\">\n")
  sb.write_string("      <a href=\"#showcase\">Showcase</a>\n")
  sb.write_string("      <a href=\"#benchmarks\">Benchmarks</a>\n")
  sb.write_string("      <a href=\"#architecture\">Architecture</a>\n")
  sb.write_string("      <a href=\"#quick-start\">Quick Start</a>\n")
  sb.write_string("    </nav>\n")
  sb.write_string("    <div class=\"nav-actions\">\n")
  sb.write_string("      <button type=\"button\" class=\"theme-btn\" id=\"theme-toggle\" aria-label=\"Toggle color theme\">Light</button>\n")
  sb.write_string("      <a class=\"btn btn-primary btn-nav-cta\" href=\"./studio/\">Launch Studio &rarr;</a>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </div>\n")
  sb.write_string("</header>\n")

  sb.write_string("<main id=\"top\">\n")

  // Hero
  sb.write_string("  <section class=\"hero\">\n")
  sb.write_string("    <div class=\"wrap\">\n")
  sb.write_string("      <div class=\"hero-head\">\n")
  sb.write_string("        <div class=\"eyebrow-row\">\n")
  sb.write_string("          <span class=\"pill pill-accent\">100% Pure Pion</span>\n")
  sb.write_string("          <span class=\"pill\">Apple Metal &amp; WebGL2</span>\n")
  sb.write_string("          <span class=\"pill\">34 Liquid Glass Components</span>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <h1>GPU-First UI &amp; Liquid Glass, in 100% Pure Pion</h1>\n")
  sb.write_string("        <p class=\"hero-sub\">Pixel-identical Apple Metal and browser WebGL2 rendering from one pure Pion codebase. 34 iOS 27 optical Liquid Glass components, zero DOM widgets, zero GC pauses.</p>\n")
  sb.write_string("        <div class=\"hero-cta\">\n")
  sb.write_string("          <a class=\"btn btn-primary btn-lg\" href=\"./studio/\">Open Live WebGL2 Studio &rarr;</a>\n")
  sb.write_string("          <a class=\"btn btn-ghost btn-lg\" href=\"#quick-start\">Quick Start</a>\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"frame\">\n")
  sb.write_string("        <div class=\"frame-inner\">\n")
  sb.write_string("          <img class=\"hero-img hero-img-dark\" src=\"./assets/lib-controls-dark.webp\" width=\"2560\" height=\"1600\" alt=\"Invar 34-component Liquid Glass Studio rendered in dark mode\">\n")
  sb.write_string("          <img class=\"hero-img hero-img-light\" src=\"./assets/lib-controls-light.webp\" width=\"2560\" height=\"1600\" alt=\"Invar 34-component Liquid Glass Studio rendered in light mode\">\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </section>\n")

  // Real Benchmarks
  sb.write_string("  <section class=\"sec\" id=\"benchmarks\">\n")
  sb.write_string("    <div class=\"wrap\">\n")
  sb.write_string("      <div class=\"sec-head\">\n")
  sb.write_string("        <div class=\"sec-kicker\">Measured Benchmarks</div>\n")
  sb.write_string("        <h2>Real wasm32 footprint and Chromium WebGL2 numbers</h2>\n")
  sb.write_string("        <p class=\"sec-lead\">Every figure below is measured on the full 34-component Liquid Glass Studio compiled with pionc2 --release --target wasm32 and wasm-opt -Oz.</p>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"kpi-grid\">\n")
  sb.write_string("        <div class=\"kpi\">\n")
  sb.write_string("          <div class=\"kpi-val\">505 KB</div>\n")
  sb.write_string("          <div class=\"kpi-label\">Brotli-11 Total Transfer</div>\n")
  sb.write_string("          <div class=\"kpi-note\">719.4 KB gzip including WebGL2 host, 12.8% smaller than MoonBit JS (825.4 KB gzip).</div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"kpi\">\n")
  sb.write_string("          <div class=\"kpi-val\">8.4 ms</div>\n")
  sb.write_string("          <div class=\"kpi-label\">Wasm Instantiate Cold Start</div>\n")
  sb.write_string("          <div class=\"kpi-note\">WebAssembly.instantiate of 2.43 MB lg_web.oz.wasm in Chromium 1228.</div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"kpi\">\n")
  sb.write_string("          <div class=\"kpi-val\">3.84 s</div>\n")
  sb.write_string("          <div class=\"kpi-label\">Full Release Compile</div>\n")
  sb.write_string("          <div class=\"kpi-note\">Zero-LLVM self-hosted pionc2 compiling 16 packages directly to wasm32.</div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"kpi\">\n")
  sb.write_string("          <div class=\"kpi-val\">13.25 MB</div>\n")
  sb.write_string("          <div class=\"kpi-label\">Linear Memory, 0 GC Pauses</div>\n")
  sb.write_string("          <div class=\"kpi-note\">Biased reference counting in Wasm linear memory with zero JS garbage collection stalls.</div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"table-card\">\n")
  sb.write_string("        <div class=\"table-scroll\">\n")
  sb.write_string("          <table class=\"cmp-table\">\n")
  sb.write_string("            <thead>\n")
  sb.write_string("              <tr>\n")
  sb.write_string("                <th>Metric</th>\n")
  sb.write_string("                <th>Invar (Pure Pion wasm32)</th>\n")
  sb.write_string("                <th>MoonBit JS (ui.monoid.build)</th>\n")
  sb.write_string("                <th>Traditional React / Web</th>\n")
  sb.write_string("              </tr>\n")
  sb.write_string("            </thead>\n")
  sb.write_string("            <tbody>\n")
  sb.write_string("              <tr>\n")
  sb.write_string("                <td>Total Transfer (Studio)</td>\n")
  sb.write_string("                <td class=\"hi\">719.4 KB gzip / 505.0 KB brotli</td>\n")
  sb.write_string("                <td class=\"dim\">825.4 KB gzip</td>\n")
  sb.write_string("                <td class=\"dim\">1.5 - 4.0 MB+ gzip</td>\n")
  sb.write_string("              </tr>\n")
  sb.write_string("              <tr>\n")
  sb.write_string("                <td>Rendering Pipeline</td>\n")
  sb.write_string("                <td class=\"hi\">Single-pass WebGL2 &amp; Metal SDF</td>\n")
  sb.write_string("                <td class=\"dim\">Single-pass WebGL2 &amp; Metal SDF</td>\n")
  sb.write_string("                <td class=\"dim\">DOM + CSS + Layout Thrash</td>\n")
  sb.write_string("              </tr>\n")
  sb.write_string("              <tr>\n")
  sb.write_string("                <td>Memory &amp; GC</td>\n")
  sb.write_string("                <td class=\"hi\">13.25 MB linear / 0 GC pauses</td>\n")
  sb.write_string("                <td class=\"dim\">V8 JS Heap / GC</td>\n")
  sb.write_string("                <td class=\"dim\">60 - 150 MB+ / GC</td>\n")
  sb.write_string("              </tr>\n")
  sb.write_string("              <tr>\n")
  sb.write_string("                <td>Toolchain</td>\n")
  sb.write_string("                <td class=\"hi\">Zero-LLVM pionc2 (3.84 s)</td>\n")
  sb.write_string("                <td class=\"dim\">moon + Vite</td>\n")
  sb.write_string("                <td class=\"dim\">Node + Bundler + TypeScript</td>\n")
  sb.write_string("              </tr>\n")
  sb.write_string("            </tbody>\n")
  sb.write_string("          </table>\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </section>\n")

  // Liquid Glass Showcase
  sb.write_string("  <section class=\"sec\" id=\"showcase\">\n")
  sb.write_string("    <div class=\"wrap\">\n")
  sb.write_string("      <div class=\"sec-head\">\n")
  sb.write_string("        <div class=\"sec-kicker\">Liquid Glass Showcase</div>\n")
  sb.write_string("        <h2>Optical refraction, capillary merge, and clear lenses</h2>\n")
  sb.write_string("        <p class=\"sec-lead\">Retina Apple Metal captures from the same pure Pion scene encoder that runs live in WebGL2 Studio.</p>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"shot-grid\">\n")

  sb.write_string("        <article class=\"shot-card\">\n")
  sb.write_string("          <div class=\"shot-media\"><img loading=\"lazy\" src=\"./assets/lib-controls-dark.webp\" width=\"2560\" height=\"1600\" alt=\"34-component Liquid Glass Controls in dark mode\"></div>\n")
  sb.write_string("          <div class=\"shot-body\">\n")
  sb.write_string("            <div class=\"shot-top\"><h3 class=\"shot-title\">34-Component Controls (Dark)</h3><span class=\"pill\">Dark</span></div>\n")
  sb.write_string("            <p class=\"shot-desc\">Refractive buttons, segmented lenses, toggles, steppers, and sliders composited directly over optical wallpaper.</p>\n")
  sb.write_string("            <a class=\"shot-link\" href=\"./studio/\">Try Live in Studio &rarr;</a>\n")
  sb.write_string("          </div>\n")
  sb.write_string("        </article>\n")

  sb.write_string("        <article class=\"shot-card\">\n")
  sb.write_string("          <div class=\"shot-media\"><img loading=\"lazy\" src=\"./assets/lib-controls-light.webp\" width=\"2560\" height=\"1600\" alt=\"34-component Liquid Glass Controls in light mode\"></div>\n")
  sb.write_string("          <div class=\"shot-body\">\n")
  sb.write_string("            <div class=\"shot-top\"><h3 class=\"shot-title\">34-Component Controls (Light)</h3><span class=\"pill\">Light</span></div>\n")
  sb.write_string("            <p class=\"shot-desc\">Adaptive light-mode glass dispersion, specular rim highlights, and high-contrast ink tokens.</p>\n")
  sb.write_string("            <a class=\"shot-link\" href=\"./studio/?dark=0\">Try Live in Studio &rarr;</a>\n")
  sb.write_string("          </div>\n")
  sb.write_string("        </article>\n")

  sb.write_string("        <article class=\"shot-card\">\n")
  sb.write_string("          <div class=\"shot-media\"><img loading=\"lazy\" src=\"./assets/stage-merge-1120x690-dark.webp\" width=\"3360\" height=\"2070\" alt=\"360-degree capillary liquid glass merge\"></div>\n")
  sb.write_string("          <div class=\"shot-body\">\n")
  sb.write_string("            <div class=\"shot-top\"><h3 class=\"shot-title\">360&deg; Capillary Liquid Merge</h3><span class=\"pill\">Smooth-Min SDF</span></div>\n")
  sb.write_string("            <p class=\"shot-desc\">Adjacent liquid droplets fuse across a continuous capillary bridge evaluated per pixel in the glass shader.</p>\n")
  sb.write_string("            <a class=\"shot-link\" href=\"./studio/\">Try Live in Studio &rarr;</a>\n")
  sb.write_string("          </div>\n")
  sb.write_string("        </article>\n")

  sb.write_string("        <article class=\"shot-card\">\n")
  sb.write_string("          <div class=\"shot-media\"><img loading=\"lazy\" src=\"./assets/loupe-1120x637-dark.webp\" width=\"3360\" height=\"1911\" alt=\"1.5x clear lens optical loupe\"></div>\n")
  sb.write_string("          <div class=\"shot-body\">\n")
  sb.write_string("            <div class=\"shot-top\"><h3 class=\"shot-title\">1.5&times; Clear Lens Optical Loupe</h3><span class=\"pill\">Refraction</span></div>\n")
  sb.write_string("            <p class=\"shot-desc\">Interactive magnifying loupe with bezel refraction, edge chromatic dispersion, and live cursor tracking.</p>\n")
  sb.write_string("            <a class=\"shot-link\" href=\"./studio/\">Try Live in Studio &rarr;</a>\n")
  sb.write_string("          </div>\n")
  sb.write_string("        </article>\n")

  sb.write_string("      </div>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </section>\n")

  // Architecture
  sb.write_string("  <section class=\"sec\" id=\"architecture\">\n")
  sb.write_string("    <div class=\"wrap\">\n")
  sb.write_string("      <div class=\"sec-head\">\n")
  sb.write_string("        <div class=\"sec-kicker\">Architecture</div>\n")
  sb.write_string("        <h2>Three clean layers from signals to GPU shaders</h2>\n")
  sb.write_string("        <p class=\"sec-lead\">Zero virtual DOM diffing. Each view node is created once and bound directly to fine-grained signals.</p>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"bento-grid\">\n")
  sb.write_string("        <div class=\"bento-card\">\n")
  sb.write_string("          <div class=\"bento-step\">01 / REACTIVE &amp; LAYOUT</div>\n")
  sb.write_string("          <h3>Core Reactive &amp; Layout</h3>\n")
  sb.write_string("          <p>Alien-signals reactive graph, deterministic one-way flexbox layout, spring motion as data, and per-frame damage rect tracking.</p>\n")
  sb.write_string("          <div class=\"pkg-row\"><span class=\"pkg-tag\">signals</span><span class=\"pkg-tag\">flex</span><span class=\"pkg-tag\">view</span><span class=\"pkg-tag\">motion</span><span class=\"pkg-tag\">damage</span></div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"bento-card\">\n")
  sb.write_string("          <div class=\"bento-step\">02 / SCENE &amp; VECTOR</div>\n")
  sb.write_string("          <h3>GPU Scene &amp; Vector Engine</h3>\n")
  sb.write_string("          <p>Flat 60-Double instanced GPU scene buffer, analytical SDF rounded corners and vector paths, glyph atlas packing, and offscreen film capture.</p>\n")
  sb.write_string("          <div class=\"pkg-row\"><span class=\"pkg-tag\">paint</span><span class=\"pkg-tag\">ui</span><span class=\"pkg-tag\">skia</span><span class=\"pkg-tag\">film</span></div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"bento-card\">\n")
  sb.write_string("          <div class=\"bento-step\">03 / HOSTS &amp; GLASS</div>\n")
  sb.write_string("          <h3>Native &amp; WebGL2 Hosts</h3>\n")
  sb.write_string("          <p>Shared shader math across Apple Metal and zero-copy browser WebGL2 wasm32, powering 34 iOS 27 Liquid Glass components.</p>\n")
  sb.write_string("          <div class=\"pkg-row\"><span class=\"pkg-tag\">host (Metal)</span><span class=\"pkg-tag\">host_web (WebGL2)</span><span class=\"pkg-tag\">lg (34)</span></div>\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </section>\n")

  // Quick Start
  sb.write_string("  <section class=\"sec\" id=\"quick-start\">\n")
  sb.write_string("    <div class=\"wrap\">\n")
  sb.write_string("      <div class=\"sec-head\">\n")
  sb.write_string("        <div class=\"sec-kicker\">Quick Start</div>\n")
  sb.write_string("        <h2>Compile a Liquid Glass app to WebGL2 in seconds</h2>\n")
  sb.write_string("        <p class=\"sec-lead\">Write once in pure Pion, compile straight to wasm32 without LLVM, and ship a single static folder.</p>\n")
  sb.write_string("      </div>\n")
  sb.write_string("      <div class=\"qs-grid\">\n")
  sb.write_string("        <div class=\"code-card\">\n")
  sb.write_string("          <div class=\"code-head\"><span>packages/lg_web/src/main.pion</span><span>Pion</span></div>\n")
  sb.write_string("          <pre class=\"code-pre\"><code>import \"host_web\"\nimport \"lg\"\nimport \"lg_pages\"\nimport \"ui\"\n\nfn main() -&gt; Unit {\n  host_web::install()\n  lg::set_dark(Some(true))\n  ui::run(\n    \"Liquid Glass Studio\",\n    fn(root) {\n      lg_pages::gallery(root, \"library\", chrome=true)\n    },\n    theme=lg::ui_theme,\n  )\n}</code></pre>\n")
  sb.write_string("        </div>\n")
  sb.write_string("        <div class=\"code-card\">\n")
  sb.write_string("          <div class=\"code-head\"><span>Build &amp; Generate Static Site</span><span>Shell</span></div>\n")
  sb.write_string("          <pre class=\"code-pre\"><code># 1. Compile 34-component Studio to wasm32\npionc2 build --release --target wasm32 \\\n  -o web/lg_web.wasm packages/lg_web\n\n# 2. Shrink binary with wasm-opt -Oz\nwasm-opt -Oz --enable-bulk-memory \\\n  web/lg_web.wasm -o web/lg_web.oz.wasm\n\n# 3. Build &amp; run Pure Pion SSG (&lt; 10 ms)\npionc2 build -o out/site packages/site\n./out/site site_dist</code></pre>\n")
  sb.write_string("        </div>\n")
  sb.write_string("      </div>\n")
  sb.write_string("    </div>\n")
  sb.write_string("  </section>\n")

  sb.write_string("</main>\n")

  // Footer
  sb.write_string("<footer class=\"foot\">\n")
  sb.write_string("  <div class=\"wrap foot-in\">\n")
  sb.write_string("    <span>Invar — Built with 100% Pure Pion SSG and WebGL2 wasm32</span>\n")
  sb.write_string("    <a class=\"foot-link\" href=\"./studio/\">Open Live Studio &rarr;</a>\n")
  sb.write_string("  </div>\n")
  sb.write_string("</footer>\n")

  // Minimal < 1 KB theme toggle script
  sb.write_string("<script>\n")
  sb.write_string("(function(){\n")
  sb.write_string("  var btn=document.getElementById(\"theme-toggle\");\n")
  sb.write_string("  function sync(){btn.textContent=document.documentElement.dataset.theme===\"light\"?\"Dark\":\"Light\";}\n")
  sb.write_string("  sync();\n")
  sb.write_string("  btn.addEventListener(\"click\",function(){\n")
  sb.write_string("    var next=document.documentElement.dataset.theme===\"light\"?\"dark\":\"light\";\n")
  sb.write_string("    document.documentElement.dataset.theme=next;\n")
  sb.write_string("    try{localStorage.setItem(\"invar-theme\",next);}catch(e){}\n")
  sb.write_string("    sync();\n")
  sb.write_string("  });\n")
  sb.write_string("})();\n")
  sb.write_string("</script>\n")
  sb.write_string("</body>\n")
  sb.write_string("</html>\n")
  sb.to_string()
}

pub fn render_studio_html() -> String {
  let sb = StringBuilder::new()
  sb.write_string("<!doctype html>\n")
  sb.write_string("<html lang=\"en\">\n")
  sb.write_string("<head>\n")
  sb.write_string("<meta charset=\"utf-8\">\n")
  sb.write_string("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n")
  sb.write_string("<link rel=\"icon\" href=\"data:,\">\n")
  sb.write_string("<title>Invar — Live WebGL2 Liquid Glass Studio</title>\n")
  sb.write_string("<style>\n")
  sb.write_string("  html, body { margin: 0; height: 100%; overflow: hidden; background: #090A0E; overscroll-behavior: none; -webkit-tap-highlight-color: transparent; }\n")
  sb.write_string("  #c { position: fixed; inset: 0; width: 100%; height: 100%; touch-action: none; display: block; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }\n")
  sb.write_string("  #ime { position: fixed; left: 0; top: 0; width: 2px; height: 20px; opacity: 0; padding: 0; border: 0; resize: none; overflow: hidden; font-size: 16px; caret-color: transparent; color: transparent; background: transparent; outline: none; }\n")
  sb.write_string("</style>\n")
  sb.write_string("</head>\n")
  sb.write_string("<body>\n")
  sb.write_string("<canvas id=\"c\"></canvas>\n")
  sb.write_string("<textarea id=\"ime\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\"></textarea>\n")
  sb.write_string("<script src=\"./host.js\"></script>\n")
  sb.write_string("<script type=\"module\">\n")
  sb.write_string("import { createPionRuntime } from \"./pion_wasm_rt_web.min.mjs\";\n")
  sb.write_string("import { attachHostBridge } from \"./pion_host_bridge.mjs\";\n")
  sb.write_string("const params = new URLSearchParams(location.search);\n")
  sb.write_string("const wasmUrl = params.get(\"wasm\") || \"./lg_web.oz.wasm\";\n")
  sb.write_string("const perf = { wasmUrl, wasmFetchMs: 0, compileInstantiateMs: 0, firstFrameMs: 0, wasmBytes: 0, memoryMB: 0, frameCount: 0, frameTimesMs: [] };\n")
  sb.write_string("window.__perf = perf;\n")
  sb.write_string("window.__invarReady = false;\n")
  sb.write_string("const rt = createPionRuntime({ print: (s) => console.log(s), println: (s) => console.log(s), eprintln: (s) => console.error(s) });\n")
  sb.write_string("const { frameTimes } = attachHostBridge(rt, {\n")
  sb.write_string("  onFirstFrame(dt) {\n")
  sb.write_string("    perf.firstFrameMs = dt;\n")
  sb.write_string("    const mem = rt.getMemory();\n")
  sb.write_string("    perf.memoryMB = mem ? Number((mem.buffer.byteLength / (1024 * 1024)).toFixed(2)) : 0;\n")
  sb.write_string("    window.__invarReady = true;\n")
  sb.write_string("  },\n")
  sb.write_string("  onFrame() {\n")
  sb.write_string("    perf.frameCount++;\n")
  sb.write_string("    perf.frameTimesMs = frameTimes;\n")
  sb.write_string("    const mem = rt.getMemory();\n")
  sb.write_string("    if (mem) perf.memoryMB = Number((mem.buffer.byteLength / (1024 * 1024)).toFixed(2));\n")
  sb.write_string("  },\n")
  sb.write_string("});\n")
  sb.write_string("async function boot() {\n")
  sb.write_string("  const t0 = performance.now();\n")
  sb.write_string("  const resp = await fetch(wasmUrl);\n")
  sb.write_string("  if (!resp.ok) throw new Error(\"Failed to fetch \" + wasmUrl + \": \" + resp.status);\n")
  sb.write_string("  const bytes = await resp.arrayBuffer();\n")
  sb.write_string("  perf.wasmFetchMs = Number((performance.now() - t0).toFixed(2));\n")
  sb.write_string("  perf.wasmBytes = bytes.byteLength;\n")
  sb.write_string("  const t1 = performance.now();\n")
  sb.write_string("  const { instance } = await WebAssembly.instantiate(bytes, rt.imports);\n")
  sb.write_string("  perf.compileInstantiateMs = Number((performance.now() - t1).toFixed(2));\n")
  sb.write_string("  rt.bindExports(instance.exports);\n")
  sb.write_string("  const mem = rt.getMemory();\n")
  sb.write_string("  perf.memoryMB = mem ? Number((mem.buffer.byteLength / (1024 * 1024)).toFixed(2)) : 0;\n")
  sb.write_string("  window.__pionInstance = instance;\n")
  sb.write_string("  if (instance.exports.main) instance.exports.main(0, 0n);\n")
  sb.write_string("  else if (instance.exports._start) instance.exports._start();\n")
  sb.write_string("}\n")
  sb.write_string("boot().catch((err) => {\n")
  sb.write_string("  console.error(\"invar studio boot error:\", err);\n")
  sb.write_string("  window.__bootError = String(err && err.stack ? err.stack : err);\n")
  sb.write_string("});\n")
  sb.write_string("</script>\n")
  sb.write_string("</body>\n")
  sb.write_string("</html>\n")
  sb.to_string()
}

fn copy_file(world : World, src : String, dst : String) -> Bool {
  if !fs_exists(world, src) {
    io_eprintln(world, "site: missing source file: " + src)
    return false
  }
  match fs_read_bytes(world, src) {
    Ok(data) => {
      match fs_write_bytes(world, dst, data) {
        Ok(_) => true
        Err(e) => {
          io_eprintln(world, "site: write failed " + dst + ": " + e)
          false
        }
      }
    }
    Err(e) => {
      io_eprintln(world, "site: read failed " + src + ": " + e)
      false
    }
  }
}

fn write_text(world : World, dst : String, content : String) -> Bool {
  match fs_write(world, dst, content) {
    Ok(_) => true
    Err(e) => {
      io_eprintln(world, "site: write failed " + dst + ": " + e)
      false
    }
  }
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  let out_dir = if args.length() >= 2 && args[1].length() > 0 { args[1] } else { "site_dist" }
  let studio_dir = out_dir + "/studio"
  let assets_dir = out_dir + "/assets"
  let _ = fs_mkdir_p(world, out_dir)
  let _ = fs_mkdir_p(world, studio_dir)
  let _ = fs_mkdir_p(world, assets_dir)

  let mut ok = true
  if !write_text(world, out_dir + "/index.html", render_index_html()) { ok = false }
  if !write_text(world, out_dir + "/site.css", render_site_css()) { ok = false }
  if !write_text(world, studio_dir + "/index.html", render_studio_html()) { ok = false }

  let web_files : Array[String] = [
    "host.js",
    "pion_wasm_rt_web.min.mjs",
    "pion_host_bridge.mjs",
    "lg_web.oz.wasm",
  ]
  for wf in web_files {
    if !copy_file(world, "web/" + wf, studio_dir + "/" + wf) {
      ok = false
    }
  }

  let asset_files : Array[String] = [
    "lib-controls-dark.webp",
    "lib-controls-light.webp",
    "stage-merge-1120x690-dark.webp",
    "loupe-1120x637-dark.webp",
  ]
  for af in asset_files {
    if !copy_file(world, "packages/site/assets/" + af, assets_dir + "/" + af) {
      ok = false
    }
  }

  if !ok {
    return 1
  }
  io_println(world, "site: generated " + out_dir + " (index.html, site.css, studio/, assets/)")
  0
}
