// Invar Minimal WebAssembly Shell Generator (100% Pure Pion, zero external CSS/JS bundlers).
// Generates a < 2.5 KB root index.html that boots Pion WebGL2 WASM directly, plus Cloudflare _redirects.
// Usage: site [out_dir]   (defaults to "site_dist")

pub fn render_index_html() -> String {
  let sb = StringBuilder::new()
  sb.write_string("<!doctype html>\n")
  sb.write_string("<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><link rel=\"icon\" href=\"data:,\"><title>Invar — Pure Pion GPU UI</title><meta name=\"description\" content=\"Invar GPU UI\"><link rel=\"preload\" href=\"./lg_web.wasm\" as=\"fetch\" crossorigin><link rel=\"preload\" href=\"./inter.woff2\" as=\"fetch\" crossorigin><link rel=\"modulepreload\" href=\"./pion_wasm_rt_web.min.mjs\"><style>:root{--b:#090A0E;--f:#fff8}@media(prefers-color-scheme:light){:root:not(.d){--b:#F2F2F7;--f:#0007}}:root.l{--b:#F2F2F7;--f:#0007}html,body{margin:0;height:100%;overflow:hidden;background:var(--b)}#c,#boot,#ime{position:fixed}#c,#boot{inset:0}#boot{display:grid;place-items:center;font:14px system-ui;color:var(--f);pointer-events:none}#c{width:100%;height:100%;touch-action:none;user-select:none;-webkit-user-select:none}#ime{left:0;top:0;width:2px;height:20px;opacity:0;padding:0;border:0;resize:none;overflow:hidden;font-size:16px;color:#0000;background:0;outline:0;pointer-events:none}</style></head><body><canvas id=\"c\"></canvas><textarea id=\"ime\"></textarea><div id=\"boot\">Invar</div><noscript>Invar requires JavaScript and WebGL2.</noscript><script src=\"./host.js\"></script><script type=\"module\">\n")
  sb.write_string("import{createPionRuntime as R}from\"./pion_wasm_rt_web.min.mjs\";import{attachHostBridge as B}from\"./pion_host_bridge.mjs\";\n")
  sb.write_string("let D=document,W=WebAssembly,q=new URLSearchParams(location.search),dk=q.get(\"dark\"),b=D.getElementById(\"boot\"),N=()=>performance.now(),ms=t=>+(N()-t).toFixed(2),L=console.log;\n")
  sb.write_string("if(dk===\"0\"||dk===\"1\")D.documentElement.className=dk<\"1\"?\"l\":\"d\";\n")
  sb.write_string("let w=q.get(\"wasm\"),u=w&&/^\\.\\/(?!.*\\.\\.)[A-Za-z0-9._-]+\\.wasm$/.test(w)?w:\"./lg_web.wasm\",p=window.__perf={wasmUrl:u,wasmFetchMs:0,compileInstantiateMs:0,firstFrameMs:0,navToFirstFrameMs:0,wasmBytes:0,memoryMB:0,frameCount:0,frameTimesMs:[]};\n")
  sb.write_string("window.__invarReady=false;\n")
  sb.write_string("let rt=window.__pionRt=R({print:L,println:L,eprintln:console.error}),mb=()=>+(rt.getMemory()?.buffer.byteLength/(1<<20)||0).toFixed(2);\n")
  sb.write_string("let hb=window.__hostBridge=B(rt,{onFirstFrame(d){p.firstFrameMs=d;p.navToFirstFrameMs=ms(0);p.memoryMB=mb();window.__invarReady=true;b?.remove()},onFrame(){p.frameCount++;p.frameTimesMs=hb.frameTimes;p.memoryMB=mb()}});\n")
  sb.write_string("(async()=>{let t=N(),fp=fetch(\"./inter.woff2\").then(r=>r.ok?r.arrayBuffer():0).then(a=>a&&window.__mbhost?.faceAddAsync?.(1,a,0)).catch(()=>0),r=await fetch(u),i;if(!r.ok)throw Error(r.status);p.wasmFetchMs=ms(t);p.wasmBytes=+r.headers.get(\"content-length\")||0;try{t=N();i=(await W.instantiateStreaming(r.clone(),rt.imports)).instance;p.compileInstantiateMs=ms(t)}catch{let a=await r.arrayBuffer();p.wasmBytes=a.byteLength;t=N();i=(await W.instantiate(a,rt.imports)).instance;p.compileInstantiateMs=ms(t)}await fp;let x=i.exports;rt.bindExports(x);p.memoryMB=mb();window.__pionInstance=i;x.main?x.main(0,0n):x._start?.()})().catch(e=>{window.__bootError=\"\"+(e?.stack||e);b&&(b.textContent=\"Err: \"+(e?.message||e))});\n")
  sb.write_string("</script></body></html>\n")
  sb.to_string()
}

/// Generate Cloudflare Workers Static Assets `_headers` with strict CSP and security headers.
pub fn render_headers() -> String {
  "/*\n  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: strict-origin-when-cross-origin\n"
}

/// Generate Cloudflare Workers Static Assets `_redirects` forwarding legacy `/studio` paths to `/`.
pub fn render_redirects() -> String {
  "/studio / 301\n/studio/* / 301\n"
}

fn copy_file(world : World, src : String, dst : String) -> Bool {
  if !fs_exists(world, src) {
    io_eprintln(world, "site: missing source file: " + src)
    return false
  }
  match fs_read_bytes(world, src) {
    Ok(data) =>
    match fs_write_bytes(world, dst, data) {
      Ok(_) => true
      Err(e) => {
        io_eprintln(world, "site: write failed " + dst + ": " + e)
        false
      }
    }
    Err(e) => {
      io_eprintln(world, "site: read failed " + src + ": " + e)
      false
    }
  }
}

fn write_text(world : World, dst : String, content : String) -> Bool {
  match fs_write(world, dst, content) {
    Ok(_) => true
    Err(e) => {
      io_eprintln(world, "site: write failed " + dst + ": " + e)
      false
    }
  }
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  let out_dir = if args.length() >= 2 && args[1].length() > 0 { args[1] } else { "site_dist" }
  let _ = fs_mkdir_p(world, out_dir)

  let mut ok = true
  if !write_text(world, out_dir + "/index.html", render_index_html()) {
    ok = false
  }
  if !write_text(world, out_dir + "/_headers", render_headers()) {
    ok = false
  }
  if !write_text(world, out_dir + "/_redirects", render_redirects()) {
    ok = false
  }

  let web_files : Array[String] = [
    "host.js",
    "inter.woff2",
    "pion_wasm_rt_web.min.mjs",
    "pion_host_bridge.mjs",
  ]
  for wf in web_files {
    if !copy_file(world, "web/" + wf, out_dir + "/" + wf) {
      ok = false
    }
  }
  if fs_exists(world, "web/lg_web.wasm") {
    if !copy_file(world, "web/lg_web.wasm", out_dir + "/lg_web.wasm") {
      ok = false
    }
  }

  if !ok {
    return 1
  }
  io_println(world, "site: generated " + out_dir + " (index.html, _redirects, WebGL2 wasm runtime)")
  0
}
