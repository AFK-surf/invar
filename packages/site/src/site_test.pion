// Unit tests for Invar minimal root WASM shell generator (`packages/site`).

test "index.html is a minimal < 3000B root WASM shell with streaming instantiate and zero marketing assets" {
  let html = render_index_html()
  debug_assert(html.starts_with("<!doctype html>"), "doctype")
  debug_assert(html.contains("</html>"), "closing html")
  debug_assert(html.length() < 3000, "html stays under 3000 bytes")
  debug_assert(html.contains("<canvas id=\"c\"></canvas>"), "fullscreen canvas")
  debug_assert(html.contains("<textarea id=\"ime\""), "hidden ime proxy")
  debug_assert(html.contains("id=\"boot\""), "minimal boot label")
  debug_assert(html.contains("rel=\"preload\" href=\"./lg_web.wasm\""), "wasm preload")
  debug_assert(html.contains("rel=\"preload\" href=\"./inter.woff2\""), "inter font preload")
  debug_assert(html.contains("rel=\"modulepreload\" href=\"./pion_wasm_rt_web.min.mjs\""), "rt modulepreload")
  debug_assert(html.contains("faceAddAsync"), "inter font async register")
  debug_assert(html.contains("instantiateStreaming"), "streaming wasm instantiate")
  debug_assert(html.contains("pion_wasm_rt_web.min.mjs"), "minified runtime")
  debug_assert(html.contains("./pion_host_bridge.mjs"), "host bridge")
  debug_assert(html.contains("lg_web.wasm"), "default wasm url")
  debug_assert(html.contains("window.__perf"), "perf hook")
  debug_assert(html.contains("window.__invarReady"), "ready flag")
  debug_assert(html.contains("window.__bootError"), "boot error hook")
  debug_assert(html.contains("window.__hostBridge"), "host bridge hook")
  debug_assert(html.contains("window.__pionRt"), "pion rt hook")
  debug_assert(html.contains("window.__pionInstance"), "pion instance hook")
  debug_assert(!html.contains(".webp"), "zero legacy webp marketing screenshots")
  debug_assert(!html.contains("site.css"), "zero external site.css")
  debug_assert(html.contains("<noscript>Invar requires JavaScript and WebGL2.</noscript>"), "noscript fallback")
  debug_assert(html.contains("navToFirstFrameMs"), "navToFirstFrameMs perf metric")
  debug_assert(html.contains("content-length"), "streaming wasmBytes metric")
  debug_assert(html.contains("/^\\.\\/(?!.*\\.\\.)[A-Za-z0-9._-]+\\.wasm$/"), "strict same-origin wasm query validation")
}

test "headers enforce CSP and nosniff security policy" {
  let headers = render_headers()
  debug_assert(headers.contains("Content-Security-Policy:"), "CSP header")
  debug_assert(headers.contains("'wasm-unsafe-eval'"), "wasm-unsafe-eval in CSP")
  debug_assert(headers.contains("frame-ancestors 'none'"), "frame-ancestors none")
  debug_assert(headers.contains("X-Content-Type-Options: nosniff"), "nosniff header")
  debug_assert(headers.contains("Referrer-Policy: strict-origin-when-cross-origin"), "referrer policy")
}

test "redirects map legacy /studio routes to root / with 301" {
  let redirects = render_redirects()
  debug_assert(redirects.contains("/studio / 301"), "/studio 301 redirect")
  debug_assert(redirects.contains("/studio/* / 301"), "/studio/* 301 redirect")
}

test "site CLI rejects missing WASM unless --shell-only is passed" {
  let (out1, wasm1, shell1) = parse_site_args(["site"])
  debug_assert(out1 == "site_dist", "default out_dir")
  debug_assert(wasm1 == "web/lg_web.wasm", "default wasm_path")
  debug_assert(!shell1, "shell_only defaults false")

  let (out2, wasm2, shell2) = parse_site_args(["site", "custom_dist", "--wasm", "build/app.wasm"])
  debug_assert(out2 == "custom_dist", "custom out_dir")
  debug_assert(wasm2 == "build/app.wasm", "custom wasm_path")
  debug_assert(!shell2, "shell_only false with --wasm")

  let (out3, _wasm3, shell3) = parse_site_args(["site", "--shell-only", "shell_dist"])
  debug_assert(out3 == "shell_dist", "out_dir with --shell-only")
  debug_assert(shell3, "shell_only true")

  debug_assert(!validate_wasm_ready(false, false), "missing wasm must fail by default")
  debug_assert(validate_wasm_ready(true, false), "present wasm succeeds")
  debug_assert(validate_wasm_ready(false, true), "--shell-only allows missing wasm")
}
