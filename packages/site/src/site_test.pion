// Unit tests for Invar pure-Pion SSG (`packages/site`).

test "index.html has valid document structure and all 6 sections" {
  let html = render_index_html()
  debug_assert(html.starts_with("<!doctype html>"), "doctype")
  debug_assert(html.contains("</html>"), "closing html")
  debug_assert(html.contains("<header class=\"nav\">"), "top nav")
  debug_assert(html.contains("GPU-First UI &amp; Liquid Glass, in 100% Pure Pion"), "hero h1")
  debug_assert(html.contains("id=\"benchmarks\""), "benchmarks section")
  debug_assert(html.contains("id=\"showcase\""), "showcase section")
  debug_assert(html.contains("id=\"architecture\""), "architecture section")
  debug_assert(html.contains("id=\"quick-start\""), "quick start section")
  debug_assert(html.contains("<footer class=\"foot\">"), "footer")
}

test "index.html contains real measured benchmark numbers and valid links" {
  let html = render_index_html()
  debug_assert(html.contains("47 Pure Pion Packages"), "47 packages pill")
  debug_assert(html.contains("6 Hosts: Metal"), "6 hosts pill")
  debug_assert(html.contains("388 KB"), "brotli metric")
  debug_assert(html.contains("518.7 KB"), "gzip metric")
  debug_assert(html.contains("-63.1%"), "native binary slimming metric")
  debug_assert(html.contains("4.09 s"), "incremental compile metric")
  debug_assert(html.contains("0 GC Pauses"), "zero GC metric")
  debug_assert(!html.contains("505 KB") && !html.contains("719.4 KB"), "stale metrics removed")
  debug_assert(html.contains("href=\"./studio/\""), "studio link")
  debug_assert(html.contains("href=\"./site.css\""), "css link")
  debug_assert(html.contains("./assets/lib-controls-dark.webp"), "dark hero asset")
  debug_assert(html.contains("./assets/lib-controls-light.webp"), "light hero asset")
  debug_assert(html.contains("./assets/stage-merge-1120x690-dark.webp"), "merge asset")
  debug_assert(html.contains("./assets/loupe-1120x637-dark.webp"), "loupe asset")
  debug_assert(html.contains("id=\"theme-toggle\""), "theme toggle")
}

test "site.css defines dual theme, concentric radii, and responsive rules under 15 KB raw" {
  let css = render_site_css()
  debug_assert(css.contains("--bg: #0A0B0F"), "dark bg")
  debug_assert(css.contains("[data-theme=\"light\"]"), "light theme")
  debug_assert(css.contains("--bg: #F5F6FA"), "light bg")
  debug_assert(css.contains("--r-card: 22px"), "outer radius")
  debug_assert(css.contains("--r-inner: 14px"), "inner radius")
  debug_assert(css.contains("tabular-nums"), "tabular numerals")
  debug_assert(css.contains("@media (max-width: 720px)"), "mobile responsive")
  debug_assert(css.length() < 15000, "css stays compact")
}

test "studio index.html boots lg_web.oz.wasm with minified runtime" {
  let studio = render_studio_html()
  debug_assert(studio.contains("./host.js"), "host.js")
  debug_assert(studio.contains("./pion_wasm_rt_web.min.mjs"), "minified runtime")
  debug_assert(studio.contains("./pion_host_bridge.mjs"), "host bridge")
  debug_assert(studio.contains("./lg_web.oz.wasm"), "oz wasm default")
  debug_assert(studio.contains("window.__invarReady"), "ready flag")
}
