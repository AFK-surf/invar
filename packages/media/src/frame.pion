// Reusable picture and film frame container primitives in layout points.

import "view"

/// Visual style for a rounded clipped `frame` container.
pub struct FrameStyle {
  pub fill : Int64
  pub edge : Int64
  pub edge_width : Double
  pub radius : Double
  pub inset : Double
}

/// Build a fixed-size rounded frame box with clipped content, inset padding, fill, and border stroke.
pub fn frame(
  parent : view::View,
  w : Double,
  h : Double,
  style : FrameStyle,
  body : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v
    .width(view::Live::Is(Some(w)), loc=loc)
    .height(view::Live::Is(Some(h)), loc=loc)
    .pad(view::Live::Is(style.inset), loc=loc)
    .ground(view::Live::Is(style.fill), loc=loc)
    .radius(view::Live::Is(style.radius), loc=loc)
    .clip(loc=loc)
    if style.edge_width > 0.0 && (style.edge & 0xFFL) != 0L {
      let _ = v.edge(view::Live::Is((style.edge_width, style.edge)), loc=loc)
    }
    body(v)
  })
}
