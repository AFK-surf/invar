// Unit tests for `packages/media`: device geometry/screen ratios, safe areas, and Tester::tree layout accuracy.

import "ui"
import "view"

fn m_approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

test "device_screen_and_geometry_metrics" {
  let phone_s = device_screen(Device::IPhone11Pro)
  let phone_g = device_geometry(Device::IPhone11Pro)
  debug_assert(phone_s.width == 375.0 && phone_s.height == 812.0 && phone_s.scale == 3.0, "iPhone screen")
  debug_assert(phone_s.top == 44.0 && phone_s.bottom == 34.0 && phone_s.platform == 1, "iPhone safe areas")
  debug_assert(
    m_approx(phone_g.screen_width / phone_g.screen_height, phone_s.width / phone_s.height, 0.002),
    "iPhone screen aperture aspect matches logical screen",
  )
  debug_assert(device_art_key(Device::IPhone11Pro) == "mem:invar-media/iphone-11-pro", "iPhone art key")

  let pad_s = device_screen(Device::IPadPro11)
  let pad_g = device_geometry(Device::IPadPro11)
  debug_assert(pad_s.width == 834.0 && pad_s.height == 1194.0 && pad_s.top == 24.0 && pad_s.bottom == 20.0, "iPad screen")
  debug_assert(
    m_approx(pad_g.screen_width / pad_g.screen_height, pad_s.width / pad_s.height, 0.005),
    "iPad screen aperture aspect matches logical screen",
  )

  let mac_s = device_screen(Device::MacBookPro16)
  let mac_g = device_geometry(Device::MacBookPro16)
  debug_assert(mac_s.width == 1536.0 && mac_s.height == 960.0 && mac_s.platform == 0, "MacBook screen")
  debug_assert(mac_s.top == 0.0 && mac_s.bottom == 0.0, "MacBook safe areas 0")
  debug_assert(
    m_approx(mac_g.screen_width / mac_g.screen_height, mac_s.width / mac_s.height, 0.001),
    "MacBook screen aperture aspect matches 16:10",
  )
}

test "frame_and_device_frame_render_exact_dimensions" {
  let g = device_geometry(Device::MacBookPro16)
  let target_w = 782.0
  let scale = target_w / g.width
  let expected_sx = g.screen_x * scale
  let expected_sy = g.screen_y * scale
  let expected_sw = g.screen_width * scale
  let expected_sh = g.screen_height * scale

  let t = ui::Tester::tree(
    fn(root : view::View) {
      let _ = device_frame(root, Device::MacBookPro16, target_w, fn(scr : view::View) {
        let style = FrameStyle::{
          fill: ui::rgba(24, 26, 32, 255),
          edge: ui::rgba(90, 96, 110, 255),
          edge_width: 1.0,
          radius: 10.0,
          inset: 12.0,
        }
        let _ = frame(scr, expected_sw, expected_sh, style, fn(inner : view::View) {
          let _ = inner.box(fn(child : view::View) {
            let _ = child.words(view::Live::Is("ScreenContent"), look=view::words_plain)
          })
        })
      })
    },
    width=900.0,
    height=600.0,
  )

  let mut found_content = false
  for d in t.drawn() {
    if d.words == "ScreenContent" {
      found_content = true
      debug_assert(m_approx(d.x, expected_sx + 12.0, 1.0), "content x matches aperture + inset")
      debug_assert(m_approx(d.y, expected_sy + 12.0, 1.0), "content y matches aperture + inset")
    }
  }
  debug_assert(found_content, "ScreenContent rendered inside MacBookPro16 aperture")
  t.dispose()
}
