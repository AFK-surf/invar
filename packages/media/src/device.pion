// Front-on hardware device frames and screen apertures for deterministic cross-platform offscreen renders.

import "view"

/// Supported front-on hardware device frame models.
#derive(Eq)
pub enum Device {
  IPhone11Pro
  IPadPro11
  MacBookPro16
}

/// Hardware artwork dimensions and the screen aperture rectangle within it, in artwork units.
pub struct DeviceGeometry {
  pub width : Double
  pub height : Double
  pub screen_x : Double
  pub screen_y : Double
  pub screen_width : Double
  pub screen_height : Double
}

/// Logical screen size, pixel scale, safe-area insets, and host platform id (0 = macOS, 1 = iOS).
pub struct DeviceScreen {
  pub width : Double
  pub height : Double
  pub scale : Double
  pub top : Double
  pub bottom : Double
  pub left : Double
  pub right : Double
  pub platform : Int
}

/// Logical screen metrics and safe-area insets for `model`.
pub fn device_screen(model : Device) -> DeviceScreen {
  match model {
    Device::IPhone11Pro =>
    DeviceScreen::{
      width: 375.0,
      height: 812.0,
      scale: 3.0,
      top: 44.0,
      bottom: 34.0,
      left: 0.0,
      right: 0.0,
      platform: 1,
    }
    Device::IPadPro11 =>
    DeviceScreen::{
      width: 834.0,
      height: 1194.0,
      scale: 2.0,
      top: 24.0,
      bottom: 20.0,
      left: 0.0,
      right: 0.0,
      platform: 1,
    }
    Device::MacBookPro16 =>
    DeviceScreen::{
      width: 1536.0,
      height: 960.0,
      scale: 2.0,
      top: 0.0,
      bottom: 0.0,
      left: 0.0,
      right: 0.0,
      platform: 0,
    }
  }
}

/// Logical screen metrics and safe-area insets for `self`.
pub fn Device::screen(self : Device) -> DeviceScreen {
  device_screen(self)
}

/// Hardware bezel artwork dimensions and inner screen aperture coordinates for `model`.
pub fn device_geometry(model : Device) -> DeviceGeometry {
  match model {
    Device::IPhone11Pro =>
    DeviceGeometry::{
      width: 1296.0,
      height: 2592.0,
      screen_x: 86.0,
      screen_y: 78.035606,
      screen_width: 1125.0,
      screen_height: 2436.0,
    }
    Device::IPadPro11 =>
    DeviceGeometry::{
      width: 1861.0,
      height: 2581.0,
      screen_x: 93.0,
      screen_y: 100.0,
      screen_width: 1668.0,
      screen_height: 2388.0,
    }
    Device::MacBookPro16 =>
    DeviceGeometry::{
      width: 3910.0,
      height: 2236.0,
      screen_x: 419.0,
      screen_y: 95.0,
      screen_width: 3072.0,
      screen_height: 1920.0,
    }
  }
}

/// Hardware bezel artwork dimensions and inner screen aperture coordinates for `self`.
pub fn Device::geometry(self : Device) -> DeviceGeometry {
  device_geometry(self)
}

/// In-memory artwork identifier for `model`.
pub fn device_art_key(model : Device) -> String {
  match model {
    Device::IPhone11Pro => "mem:invar-media/iphone-11-pro"
    Device::IPadPro11 => "mem:invar-media/ipad-pro-11"
    Device::MacBookPro16 => "mem:invar-media/macbook-pro-16"
  }
}

/// In-memory artwork identifier for `self`.
pub fn Device::art_key(self : Device) -> String {
  device_art_key(self)
}

fn device_outer_radius(model : Device, scale : Double) -> Double {
  match model {
    Device::IPhone11Pro => 190.0 * scale
    Device::IPadPro11 => 112.0 * scale
    Device::MacBookPro16 => 64.0 * scale
  }
}

fn device_screen_radius(model : Device, scale : Double) -> Double {
  match model {
    Device::IPhone11Pro => 118.0 * scale
    Device::IPadPro11 => 46.0 * scale
    Device::MacBookPro16 => 18.0 * scale
  }
}

/// Render a hardware device frame scaled to `width` points with `body` mounted cleanly inside
/// the clipped, unstretched screen aperture using pure retained nodes (zero external asset deps).
pub fn device_frame(
  parent : view::View,
  model : Device,
  width : Double,
  body : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let g = device_geometry(model)
  let scale = width / g.width
  let total_h = g.height * scale
  let sx = g.screen_x * scale
  let sy = g.screen_y * scale
  let sw = g.screen_width * scale
  let sh = g.screen_height * scale
  let outer_r = device_outer_radius(model, scale)
  let inner_r = device_screen_radius(model, scale)

  parent.box(fn(root : view::View) {
    let _ = root
    .width(view::Live::Is(Some(width)), loc=loc)
    .height(view::Live::Is(Some(total_h)), loc=loc)
    .clip(loc=loc)

    match model {
      Device::MacBookPro16 => {
        // Display lid housing behind the screen aperture
        let lid_x = sx - 48.0 * scale
        let lid_w = sw + 96.0 * scale
        let lid_h = sy + sh + 64.0 * scale
        let _ = root.box(fn(lid : view::View) {
          let _ = lid
          .over(view::Live::Is(true), edges=(Some(lid_x), Some(0.0), None, None), loc=loc)
          .width(view::Live::Is(Some(lid_w)), loc=loc)
          .height(view::Live::Is(Some(lid_h)), loc=loc)
          .radius(view::Live::Is(outer_r), loc=loc)
          .ground(view::Live::Is(0x16171AFFL), loc=loc)
          .edge(view::Live::Is((2.0, 0x6E727AFFL)), loc=loc)
        })
        // Aluminum base deck
        let base_h = total_h - lid_h
        if base_h > 1.0 {
          let _ = root.box(fn(base : view::View) {
            let _ = base
            .over(view::Live::Is(true), edges=(Some(0.0), Some(lid_h), None, None), loc=loc)
            .width(view::Live::Is(Some(width)), loc=loc)
            .height(view::Live::Is(Some(base_h)), loc=loc)
            .radius(view::Live::Is(base_h * 0.35), loc=loc)
            .ground(view::Live::Is(0xC8CCD4FFL), loc=loc)
            .edge(view::Live::Is((1.0, 0x8A8F99FFL)), loc=loc)
          })
        }
      }
      _ => {
        // Handheld / tablet unibody chassis
        let _ = root.box(fn(chassis : view::View) {
          let _ = chassis
          .over(view::Live::Is(true), loc=loc)
          .radius(view::Live::Is(outer_r), loc=loc)
          .ground(view::Live::Is(0x141518FFL), loc=loc)
          .edge(view::Live::Is((2.0, 0x5A5E66FFL)), loc=loc)
        })
      }
    }

    // Clipped screen aperture hosting the live application view tree
    let _ = root.box(fn(screen_v : view::View) {
      let _ = screen_v
      .over(view::Live::Is(true), edges=(Some(sx), Some(sy), None, None), loc=loc)
      .width(view::Live::Is(Some(sw)), loc=loc)
      .height(view::Live::Is(Some(sh)), loc=loc)
      .radius(view::Live::Is(inner_r), loc=loc)
      .ground(view::Live::Is(0x000000FFL), loc=loc)
      .clip(loc=loc)
      body(screen_v)
      // Subtle top speaker/camera housing for IPhone11Pro
      if model == Device::IPhone11Pro {
        let notch_w = sw * 0.52
        let notch_h = 84.0 * scale
        let notch_x = (sw - notch_w) * 0.5
        let _ = screen_v.box(fn(notch : view::View) {
          let _ = notch
          .over(view::Live::Is(true), edges=(Some(notch_x), Some(0.0), None, None), loc=loc)
          .width(view::Live::Is(Some(notch_w)), loc=loc)
          .height(view::Live::Is(Some(notch_h)), loc=loc)
          .radius(view::Live::Is(notch_h * 0.45), loc=loc)
          .ground(view::Live::Is(0x141518FFL), loc=loc)
          .presses(view::Live::Is(false))
        })
      }
    })
  })
}
