struct TestBox[T] {
  mut item : Option[T]
}

test "diamond dependency and glitch-free computed propagation" {
  let a = signal(1)
  let b = computed(fn(_p : Option[Int]) -> Int { a.get() * 2 })
  let c = computed(fn(_p : Option[Int]) -> Int { a.get() * 10 })
  let sum_runs = [0]
  let sum = computed(fn(_p : Option[Int]) -> Int {
    sum_runs[0] += 1
    b.get() + c.get()
  })
  let seen : Array[Int] = []
  let stop = effect(fn() -> Unit {
    seen.push(sum.get())
  })
  debug_assert(seen.length() == 1 && seen[0] == 12, "initial diamond value")
  debug_assert(sum_runs[0] == 1, "initial sum runs")
  a.set(2)
  debug_assert(seen.length() == 2 && seen[1] == 24, "glitch-free update")
  debug_assert(sum_runs[0] == 2, "sum ran exactly once on diamond update")
  // Same value is a no-op
  a.set(2)
  debug_assert(seen.length() == 2 && sum_runs[0] == 2, "same value no-op")
  stop()
  a.set(3)
  debug_assert(seen.length() == 2, "stopped effect not triggered")
}

test "batch coalescing and nested batches" {
  let x = signal(1)
  let y = signal(10)
  let runs = [0]
  let last = [0]
  let stop = effect(fn() -> Unit {
    runs[0] += 1
    last[0] = x.get() + y.get()
  })
  debug_assert(runs[0] == 1 && last[0] == 11, "initial")
  start_batch()
  x.set(2)
  start_batch()
  y.set(20)
  debug_assert(runs[0] == 1, "still inside batch")
  end_batch()
  debug_assert(runs[0] == 1, "still inside outer batch")
  x.set(3)
  end_batch()
  debug_assert(runs[0] == 2 && last[0] == 23, "flushed once after outer batch")
  stop()
}

test "dynamic dependency switching and unwatched cleanup" {
  let cond = signal(true)
  let a = signal(10)
  let b = signal(20)
  let a_unwatched = [0]
  a.on_unwatched(fn() -> Unit { a_unwatched[0] += 1 })
  let runs = [0]
  let cur = [0]
  let stop = effect(fn() -> Unit {
    runs[0] += 1
    cur[0] = if cond.get() { a.get() } else { b.get() }
  })
  debug_assert(cur[0] == 10 && runs[0] == 1 && a.watched() && !b.watched(), "branch A")
  cond.set(false)
  debug_assert(cur[0] == 20 && runs[0] == 2 && !a.watched() && b.watched(), "branch B")
  debug_assert(a_unwatched[0] == 1, "a unwatched callback fired")
  a.set(99)
  debug_assert(runs[0] == 2, "changing inactive dep does not re-run")
  stop()
  debug_assert(!b.watched() && !cond.watched(), "all unwatched after stop")
}

test "effect_cleanup and nested effect_scope disposal" {
  let s = signal(1)
  let log : Array[String] = []
  let stop_outer = effect_scope(fn() -> Unit {
    let _ = effect_scope(fn() -> Unit {
      let _ = effect_cleanup(fn() -> () -> Unit {
        let v = s.get()
        log.push("run:" + v.to_string())
        fn() -> Unit { log.push("clean:" + v.to_string()) }
      })
    })
  })
  debug_assert(log.length() == 1 && log[0] == "run:1", "initial run")
  s.set(2)
  debug_assert(log.length() == 3 && log[1] == "clean:1" && log[2] == "run:2", "cleanup before rerun")
  stop_outer()
  debug_assert(log.length() == 4 && log[3] == "clean:2", "cleanup on outer scope stop")
  s.set(3)
  debug_assert(log.length() == 4, "no run after scope stop")
}

test "watch, rest hibernation and wake re-subscription" {
  let s = signal(1)
  let notified = [0]
  let w_box : TestBox[Watch] = TestBox::{ item: None }
  let scope_box : TestBox[ReactiveNode] = TestBox::{ item: None }
  let stop_scope = effect_scope(fn() -> Unit {
    scope_box.item = active_sub()
    let w = watch(fn() -> Unit { notified[0] += 1 })
    w_box.item = Some(w)
  })
  let w = match w_box.item {
    Some(x) => x
    None => panic("missing watch")
  }
  let snode = match scope_box.item {
    Some(x) => x
    None => panic("missing scope")
  }
  debug_assert(w.is_stale(), "watch starts stale")
  let v1 = w.read(fn() -> Int { s.get() })
  debug_assert(v1 == 1 && !w.is_stale() && notified[0] == 0, "fresh after read")
  s.set(2)
  debug_assert(w.is_stale() && notified[0] == 1, "notified on change")
  let v2 = w.read(fn() -> Int { s.get() })
  debug_assert(v2 == 2 && !w.is_stale(), "fresh again")

  // Put scope to rest: changes while resting do NOT notify until wake
  let wake = rest(snode)
  debug_assert(w.resting(), "watch is resting")
  s.set(3)
  debug_assert(notified[0] == 1 && w.is_stale(), "resting watch marks stale without notifying")
  wake()
  debug_assert(!w.resting() && notified[0] == 2, "waking stale watch notifies once")
  stop_scope()
  debug_assert(w.gone(), "watch gone after scope stop")
}

test "untracked read and strict untracked detector" {
  let s = signal(42)
  let untracked_hits = [0]
  set_on_untracked_read(Some(fn(_n : ReactiveNode) -> Unit { untracked_hits[0] += 1 }))
  let v1 = s.get()
  debug_assert(v1 == 42 && untracked_hits[0] == 1, "bare read detected")
  let v2 = s.untracked()
  debug_assert(v2 == 42 && untracked_hits[0] == 1, "explicit untracked ignored")
  let v3 = untracked(fn() -> Int { s.get() })
  debug_assert(v3 == 42 && untracked_hits[0] == 1, "untracked block ignored")
  set_on_untracked_read(None)
}

test "DerivedSignal and Optimistic" {
  let base = signal(10)
  let d = derived_signal(fn(_p : Option[Int]) -> Int { base.get() * 2 })
  debug_assert(d.get() == 20, "derived initial")
  d.set(99)
  debug_assert(d.get() == 99, "derived local override")
  base.set(15)
  debug_assert(d.get() == 30, "upstream change resets derived override")

  let auth = signal(100)
  let opt = optimistic(fn() -> Int { auth.get() })
  debug_assert(opt.get() == 100 && !opt.is_pending(), "opt initial")
  let undo1 = opt.push(fn(x : Int) -> Int { x + 5 })
  let undo2 = opt.push(fn(x : Int) -> Int { x * 2 })
  debug_assert(opt.is_pending() && opt.get() == 210, "opt stacked edits")
  undo1()
  debug_assert(opt.is_pending() && opt.get() == 200, "opt after undo1")
  undo1() // idempotent
  debug_assert(opt.get() == 200, "undo1 idempotent")
  undo2()
  debug_assert(!opt.is_pending() && opt.get() == 100, "opt back to authority")
}

test "Keyed and KeyedList per-key granularity" {
  let k = keyed()
  let a_runs = [0]
  let b_runs = [0]
  let stop_a = effect(fn() -> Unit { let _ = k.has("a"); a_runs[0] += 1 })
  let stop_b = effect(fn() -> Unit { let _ = k.has("b"); b_runs[0] += 1 })
  debug_assert(a_runs[0] == 1 && b_runs[0] == 1, "initial")
  k.add("a")
  debug_assert(a_runs[0] == 2 && b_runs[0] == 1, "only a notified")
  k.set(["b"])
  debug_assert(a_runs[0] == 3 && b_runs[0] == 2, "a left, b came")
  stop_a()
  stop_b()

  let kl : KeyedList[Int] = keyed_list(fn(a : Int, b : Int) -> Bool { a == b })
  let order_runs = [0]
  let x_runs = [0]
  let y_runs = [0]
  let stop_o = effect(fn() -> Unit { let _ = kl.keys(); order_runs[0] += 1 })
  let stop_x = effect(fn() -> Unit { let _ = kl.get("x"); x_runs[0] += 1 })
  let stop_y = effect(fn() -> Unit { let _ = kl.get("y"); y_runs[0] += 1 })
  kl.put("x", 1, None)
  kl.put("y", 2, None)
  debug_assert(order_runs[0] == 3 && x_runs[0] == 2 && y_runs[0] == 2, "put x, y")
  kl.put("x", 10, None)
  debug_assert(order_runs[0] == 3 && x_runs[0] == 3 && y_runs[0] == 2, "patch x only notifies x")
  kl.drop("x")
  debug_assert(order_runs[0] == 4 && x_runs[0] == 4 && y_runs[0] == 2 && kl.count() == 1, "drop x")
  stop_o()
  stop_x()
  stop_y()
}

test "Keyed and KeyedList count reactivity in computed" {
  let k = keyed()
  let k_runs = [0]
  let k_cnt = computed(fn(_last : Option[Int]) -> Int {
    k_runs[0] += 1
    k.count()
  })
  debug_assert(k_cnt.get() == 0 && k_runs[0] == 1, "initial keyed count 0")
  k.add("a")
  debug_assert(k_cnt.get() == 1 && k_runs[0] == 2, "add increments keyed count")
  k.add("a")
  debug_assert(k_cnt.get() == 1 && k_runs[0] == 2, "duplicate add does not recompute")
  k.set(["a", "b", "c"])
  debug_assert(k_cnt.get() == 3 && k_runs[0] == 3, "set updates keyed count")
  k.remove("b")
  debug_assert(k_cnt.get() == 2 && k_runs[0] == 4, "remove decrements keyed count")
  k.set([])
  debug_assert(k_cnt.get() == 0 && k_runs[0] == 5, "empty set clears keyed count")

  let kl : KeyedList[Int] = keyed_list(fn(a : Int, b : Int) -> Bool { a == b })
  let kl_runs = [0]
  let kl_cnt = computed(fn(_last : Option[Int]) -> Int {
    kl_runs[0] += 1
    kl.count()
  })
  debug_assert(kl_cnt.get() == 0 && kl_runs[0] == 1, "initial keyed_list count 0")
  kl.put("x", 1, None)
  debug_assert(kl_cnt.get() == 1 && kl_runs[0] == 2, "put x increments keyed_list count")
  kl.put("y", 2, None)
  debug_assert(kl_cnt.get() == 2 && kl_runs[0] == 3, "put y increments keyed_list count")
  kl.put("x", 99, None)
  debug_assert(kl_cnt.get() == 2 && kl_runs[0] == 3, "update existing key does not recompute count")
  kl.drop("x")
  debug_assert(kl_cnt.get() == 1 && kl_runs[0] == 4, "drop x decrements keyed_list count")
}

test "after_flush, after_computing, trigger, memo and inner write" {
  let s = signal(1)
  let order : Array[String] = []
  let stop = effect(fn() -> Unit {
    let v = s.get()
    order.push("eff:" + v.to_string())
    after_flush(fn() -> Unit { order.push("after:" + v.to_string()) })
  })
  order.clear()
  s.set(2)
  debug_assert(order.length() == 2 && order[0] == "eff:2" && order[1] == "after:2", "after_flush order")

  let m_runs = [0]
  let m = memo(fn() -> Int { s.get() % 2 }, fn(parity : Int) -> Int {
    m_runs[0] += 1
    parity * 100
  })
  debug_assert(m.get() == 0 && m_runs[0] == 1, "memo initial")
  s.set(4) // same parity 0
  debug_assert(m.get() == 0 && m_runs[0] == 1, "memo skipped on same input")
  s.set(5) // parity 1
  debug_assert(m.get() == 100 && m_runs[0] == 2, "memo recomputed")
  stop()

  // Inner write inside effect
  let a = signal(0)
  let b = signal(0)
  let b_seen = [0]
  let s1 = effect(fn() -> Unit {
    let v = a.get()
    if v > 0 {
      b.set(v * 10)
    }
  })
  let s2 = effect(fn() -> Unit {
    b_seen[0] = b.get()
  })
  a.set(3)
  debug_assert(b_seen[0] == 30, "inner write propagated")
  s1()
  s2()
}

test "stress create and destroy 2000 scopes/effects/watches with zero leaked links or nodes" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let root = signal(0)
  let c1 = computed(fn(_p : Option[Int]) -> Int { root.get() + 1 })
  let acc = [0]
  for i in 0..<2000 {
    let stop = effect_scope(fn() -> Unit {
      let _ = effect(fn() -> Unit {
        acc[0] += c1.get()
      })
      let w = watch(fn() -> Unit { acc[0] += 1 })
      let _ = w.read(fn() -> Int { c1.get() })
    })
    if i % 100 == 0 {
      root.set(i)
    }
    stop()
  }
  c1.dispose()
  debug_assert(acc[0] > 0, "stress ran")
  // All temporary effects, scopes, watches, and links must be recycled
  debug_assert(live_link_count() == base_links, "zero leaked links")
  // Only root signal + c1 computed remain (+2)
  debug_assert(live_node_count() == base_nodes + 2, "zero leaked nodes")
}

test "scope-owned signals and computeds recycle on scope stop while external signals stay live" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let shared = signal(10)
  let escaped : TestBox[Signal[Int]] = TestBox::{ item: None }
  let seen = [0]
  for i in 0..<200 {
    let stop = effect_scope(fn() -> Unit {
      let local_sig = signal(i)
      let local_comp = computed(fn(_p : Option[Int]) -> Int { local_sig.get() + shared.get() })
      let _ = effect(fn() -> Unit {
        seen[0] = local_comp.get()
      })
      if i == 0 {
        escaped.item = Some(local_sig)
      }
      local_sig.set(i + 1)
    })
    stop()
  }
  debug_assert(seen[0] == 210, "effects ran")
  debug_assert(live_link_count() == base_links, "zero leaked links after 200 scopes")
  // Only `shared` remains live (+1); all 200 local_sig + 200 local_comp + 200 effects recycled!
  debug_assert(live_node_count() == base_nodes + 1, "zero leaked scope-owned signals/computeds, got delta=\{live_node_count() - base_nodes}")
  // Escaped signal from stopped scope still works reactively if subscribed again later
  match escaped.item {
    Some(es) => {
      let re_seen = [0]
      let stop2 = effect_scope(fn() -> Unit {
        let _ = effect(fn() -> Unit { re_seen[0] = es.get() })
      })
      debug_assert(re_seen[0] == 1, "escaped signal kept its last value")
      es.set(99)
      debug_assert(re_seen[0] == 99, "escaped signal re-attaches reactively")
      stop2()
    }
    None => debug_assert(false, "missing escaped signal")
  }
  shared.dispose()
  debug_assert(live_node_count() == base_nodes, "manual Signal::dispose frees shared signal")
  debug_assert(live_link_count() == base_links, "zero links after cleanup")
}

test "escaped computed preserves previous value after producer scope stops" {
  let source = signal(10)
  let out : Array[Computed[Int]] = []
  let stop = effect_scope(fn() -> Unit {
    let high = computed(fn(prev : Option[Int]) -> Int {
      let n = source.get()
      match prev {
        Some(p) => if p > n { p } else { n }
        None => n
      }
    })
    out.push(high)
    let _ = high.get()
  })
  stop()
  source.set(5)
  let result = out[0].get()
  debug_assert(result == 10, "escaped cumulative maximum expected 10, got \{result}")
}

test "producer scope ending during first external observation keeps external subscriber" {
  let input = signal(10)
  let end_scope : TestBox[() -> Unit] = TestBox::{ item: None }
  let saved : Array[Computed[Int]] = []
  let stop = effect_scope(fn() -> Unit {
    let c = computed(fn(_ : Option[Int]) -> Int {
      let n = input.get()
      match end_scope.item {
        Some(f) => {
          end_scope.item = None
          f()
        }
        None => ()
      }
      n
    })
    saved.push(c)
  })
  end_scope.item = Some(stop)
  let last = [0]
  let end_observer = effect(fn() -> Unit { last[0] = saved[0].get() })
  let initial = last[0]
  input.set(20)
  let updated = last[0]
  end_observer()
  debug_assert(initial == 10 && updated == 20, "external computed subscriber: initial=\{initial}, updated=\{updated}")
}

test "long lived effect bounds temporary signal allocations across 400 reruns" {
  let ticks = signal(0)
  let prior = live_node_count()
  let observed = [0]
  let stop = effect(fn() -> Unit {
    let v = ticks.get()
    let tmp = signal(v)
    observed[0] = tmp.get()
  })
  let baseline = live_node_count()
  for i in 1..<401 {
    ticks.set(i)
  }
  let delta = live_node_count() - baseline
  let links = live_link_count()
  stop()
  let residual = live_node_count() - prior
  debug_assert(observed[0] == 400 && delta == 0 && residual == 0, "400 effect reruns: delta=\{delta}, links=\{links}, residual=\{residual}")
}

test "explicit signal dispose compacts owner ledger in O(1)" {
  let owner_entries = [0]
  let stop = effect_scope(fn() -> Unit {
    for i in 0..<1000 {
      let temporary = signal(i)
      temporary.dispose()
    }
    owner_entries[0] = g.nodes[g.owner].owned_nodes.length()
  })
  stop()
  debug_assert(owner_entries[0] == 0, "1,000 disposed slots should leave 0 entries, got \{owner_entries[0]}")
}

test "reading inside an unrelated effect releases the stopped producer computed" {
  let source = signal(1)
  let base_nodes = live_node_count()
  let base_edges = live_link_count()
  for i in 0..<100 {
    let saved : Array[Computed[Int]] = []
    let stop = effect_scope(fn() -> Unit {
      saved.push(computed(fn(_ : Option[Int]) -> Int { i }))
    })
    let stop_reader = effect(fn() -> Unit {
      saved[0].reading(fn() -> Unit {
        let _ = source.get()
        stop()
      })
    })
    stop_reader()
  }
  let nodes = live_node_count() - base_nodes
  let edges = live_link_count() - base_edges
  let watched = source.watched()
  debug_assert(nodes == 0 && edges == 0 && !watched, "after both scopes ended: nodes +\{nodes}, links +\{edges}, source watched=\{watched}")
}

test "deferred producer teardown via after_computing preserves first outside subscriber" {
  let source = signal(10)
  let base_nodes = live_node_count()
  let base_edges = live_link_count()
  let pending : Array[() -> Unit] = []
  let exposed : Array[Computed[Int]] = []
  let stop = effect_scope(fn() -> Unit {
    exposed.push(computed(fn(_ : Option[Int]) -> Int {
      let value = source.get()
      match pending.pop() { Some(f) => after_computing(f); None => () }
      value
    }))
  })
  pending.push(stop)
  let seen = [0]
  let stop_observer = effect(fn() -> Unit { seen[0] = exposed[0].get() })
  let first = seen[0]
  source.set(20)
  let next = seen[0]
  stop_observer()
  let nodes = live_node_count() - base_nodes
  let edges = live_link_count() - base_edges
  debug_assert(first == 10 && next == 20, "deferred producer stop: first=\{first}, after source.set(20)=\{next}")
  debug_assert(nodes == 0 && edges == 0 && !source.watched(), "deferred producer stop leak: nodes +\{nodes}, links +\{edges}")
}

test "deferred producer teardown after cached read and invalidate preserves outside subscriber" {
  let source = signal(10)
  let base_nodes = live_node_count()
  let base_edges = live_link_count()
  let pending : Array[() -> Unit] = []
  let exposed : Array[Computed[Int]] = []
  let stop = effect_scope(fn() -> Unit {
    exposed.push(computed(fn(_ : Option[Int]) -> Int {
      let value = source.get()
      match pending.pop() { Some(f) => after_computing(f); None => () }
      value
    }))
  })
  let warm = exposed[0].get()
  debug_assert(warm == 10, "warm cache")
  exposed[0].invalidate()
  pending.push(stop)
  let seen = [0]
  let stop_observer = effect(fn() -> Unit { seen[0] = exposed[0].get() })
  let first = seen[0]
  source.set(20)
  let next = seen[0]
  stop_observer()
  let nodes = live_node_count() - base_nodes
  let edges = live_link_count() - base_edges
  debug_assert(first == 10 && next == 20, "deferred producer stop after invalidate: first=\{first}, after source.set(20)=\{next}")
  debug_assert(nodes == 0 && edges == 0 && !source.watched(), "deferred producer stop after invalidate leak: nodes +\{nodes}, links +\{edges}")
}

test "producer scope ending synchronously during pending dependency check preserves outside subscriber" {
  let source = signal(10)
  let base_nodes = live_node_count()
  let base_edges = live_link_count()
  let stops : Array[() -> Unit] = []
  let out : Array[Computed[Int]] = []
  let producer = effect_scope(fn() -> Unit {
    let mid = computed(fn(_ : Option[Int]) -> Int {
      let v = source.get()
      match stops.pop() { Some(f) => f(); None => () }
      v
    })
    out.push(computed(fn(_ : Option[Int]) -> Int { mid.get() + 1 }))
  })
  debug_assert(out[0].get() == 11, "warm chain")
  source.set(20)
  stops.push(producer)
  let seen = [0]
  let stop_reader = effect(fn() -> Unit { seen[0] = out[0].get() })
  let first = seen[0]
  source.set(30)
  let next = seen[0]
  stop_reader()
  let nodes = live_node_count() - base_nodes
  let edges = live_link_count() - base_edges
  debug_assert(first == 21 && next == 31, "pending path: first=\{first}, next=\{next}")
  debug_assert(nodes == 0 && edges == 0 && !source.watched(), "pending path leak: nodes +\{nodes}, links +\{edges}")
}

test "producer scope ending during untracked and unchanged pending dependency checks does not panic or leak" {
  // 1) Untracked pending check where mid changes and stops producer
  let source1 = signal(10)
  let b1_n = live_node_count()
  let b1_e = live_link_count()
  let stops1 : Array[() -> Unit] = []
  let out1 : Array[Computed[Int]] = []
  let p1 = effect_scope(fn() -> Unit {
    let mid = computed(fn(_ : Option[Int]) -> Int {
      let v = source1.get()
      match stops1.pop() { Some(f) => f(); None => () }
      v
    })
    out1.push(computed(fn(_ : Option[Int]) -> Int { mid.get() + 1 }))
  })
  debug_assert(out1[0].get() == 11, "warm untracked chain")
  source1.set(20)
  stops1.push(p1)
  debug_assert(out1[0].get() == 21, "untracked pending check returns updated value without panic")
  debug_assert(live_node_count() == b1_n && live_link_count() == b1_e && !source1.watched(), "untracked pending check leaves zero leaked nodes/links")

  // 2) Tracked pending check where mid returns the SAME value (not dirty) and stops producer
  let source2 = signal(2)
  let b2_n = live_node_count()
  let b2_e = live_link_count()
  let stops2 : Array[() -> Unit] = []
  let out2 : Array[Computed[Int]] = []
  let p2 = effect_scope(fn() -> Unit {
    let mid = computed(fn(_ : Option[Int]) -> Int {
      let v = source2.get() % 2
      match stops2.pop() { Some(f) => f(); None => () }
      v
    })
    out2.push(computed(fn(_ : Option[Int]) -> Int { mid.get() * 10 }))
  })
  debug_assert(out2[0].get() == 0, "warm clean-mid chain")
  source2.set(4) // same parity 0 -> check_dirty returns false!
  stops2.push(p2)
  let seen = [-1]
  let stop_reader = effect(fn() -> Unit { seen[0] = out2[0].get() })
  let first = seen[0]
  source2.set(5) // parity changes to 1 -> must still notify!
  let next = seen[0]
  stop_reader()
  debug_assert(first == 0 && next == 10, "unchanged-mid pending check stays reactive: first=\{first}, next=\{next}")
  debug_assert(live_node_count() == b2_n && live_link_count() == b2_e && !source2.watched(), "unchanged-mid pending check leaves zero leaked nodes/links")
}

test "first read of computed_following after prerequisite stops producer scope evaluates and recycles cleanly" {
  let source = signal(10)
  let baseline_nodes = live_node_count()
  let baseline_links = live_link_count()
  let to_stop : Array[() -> Unit] = []
  let result : Array[Computed[Int]] = []
  let producer = effect_scope(fn() -> Unit {
    let prerequisite = held_while_read(fn() -> Unit {
      match to_stop.pop() {
        Some(stop) => after_computing(stop)
        None => ()
      }
    })
    result.push(computed_following(fn(_ : Option[Int]) -> Int { source.get() }, prerequisite))
  })
  to_stop.push(producer)
  let seen = [0]
  let stop_reader = effect(fn() -> Unit { seen[0] = result[0].get() })
  let first = seen[0]
  source.set(20)
  let second = seen[0]
  stop_reader()
  debug_assert(first == 10 && second == 20, "first=\{first}, second=\{second}")
  debug_assert(!source.watched() && live_node_count() == baseline_nodes && live_link_count() == baseline_links, "all subscriber and producer resources released")
}
