struct TestBox[T] {
  mut item : Option[T]
}

test "diamond dependency and glitch-free computed propagation" {
  let a = signal(1)
  let b = computed(fn(_p : Option[Int]) -> Int { a.get() * 2 })
  let c = computed(fn(_p : Option[Int]) -> Int { a.get() * 10 })
  let sum_runs = [0]
  let sum = computed(fn(_p : Option[Int]) -> Int {
    sum_runs[0] += 1
    b.get() + c.get()
  })
  let seen : Array[Int] = []
  let stop = effect(fn() -> Unit {
    seen.push(sum.get())
  })
  debug_assert(seen.length() == 1 && seen[0] == 12, "initial diamond value")
  debug_assert(sum_runs[0] == 1, "initial sum runs")
  a.set(2)
  debug_assert(seen.length() == 2 && seen[1] == 24, "glitch-free update")
  debug_assert(sum_runs[0] == 2, "sum ran exactly once on diamond update")
  // Same value is a no-op
  a.set(2)
  debug_assert(seen.length() == 2 && sum_runs[0] == 2, "same value no-op")
  stop()
  a.set(3)
  debug_assert(seen.length() == 2, "stopped effect not triggered")
}

test "batch coalescing and nested batches" {
  let x = signal(1)
  let y = signal(10)
  let runs = [0]
  let last = [0]
  let stop = effect(fn() -> Unit {
    runs[0] += 1
    last[0] = x.get() + y.get()
  })
  debug_assert(runs[0] == 1 && last[0] == 11, "initial")
  start_batch()
  x.set(2)
  start_batch()
  y.set(20)
  debug_assert(runs[0] == 1, "still inside batch")
  end_batch()
  debug_assert(runs[0] == 1, "still inside outer batch")
  x.set(3)
  end_batch()
  debug_assert(runs[0] == 2 && last[0] == 23, "flushed once after outer batch")
  stop()
}

test "dynamic dependency switching and unwatched cleanup" {
  let cond = signal(true)
  let a = signal(10)
  let b = signal(20)
  let a_unwatched = [0]
  a.on_unwatched(fn() -> Unit { a_unwatched[0] += 1 })
  let runs = [0]
  let cur = [0]
  let stop = effect(fn() -> Unit {
    runs[0] += 1
    cur[0] = if cond.get() { a.get() } else { b.get() }
  })
  debug_assert(cur[0] == 10 && runs[0] == 1 && a.watched() && !b.watched(), "branch A")
  cond.set(false)
  debug_assert(cur[0] == 20 && runs[0] == 2 && !a.watched() && b.watched(), "branch B")
  debug_assert(a_unwatched[0] == 1, "a unwatched callback fired")
  a.set(99)
  debug_assert(runs[0] == 2, "changing inactive dep does not re-run")
  stop()
  debug_assert(!b.watched() && !cond.watched(), "all unwatched after stop")
}

test "effect_cleanup and nested effect_scope disposal" {
  let s = signal(1)
  let log : Array[String] = []
  let stop_outer = effect_scope(fn() -> Unit {
    let _ = effect_scope(fn() -> Unit {
      let _ = effect_cleanup(fn() -> () -> Unit {
        let v = s.get()
        log.push("run:" + v.to_string())
        fn() -> Unit { log.push("clean:" + v.to_string()) }
      })
    })
  })
  debug_assert(log.length() == 1 && log[0] == "run:1", "initial run")
  s.set(2)
  debug_assert(log.length() == 3 && log[1] == "clean:1" && log[2] == "run:2", "cleanup before rerun")
  stop_outer()
  debug_assert(log.length() == 4 && log[3] == "clean:2", "cleanup on outer scope stop")
  s.set(3)
  debug_assert(log.length() == 4, "no run after scope stop")
}

test "watch, rest hibernation and wake re-subscription" {
  let s = signal(1)
  let notified = [0]
  let w_box : TestBox[Watch] = TestBox::{ item: None }
  let scope_box : TestBox[ReactiveNode] = TestBox::{ item: None }
  let stop_scope = effect_scope(fn() -> Unit {
    scope_box.item = active_sub()
    let w = watch(fn() -> Unit { notified[0] += 1 })
    w_box.item = Some(w)
  })
  let w = match w_box.item {
    Some(x) => x
    None => panic("missing watch")
  }
  let snode = match scope_box.item {
    Some(x) => x
    None => panic("missing scope")
  }
  debug_assert(w.is_stale(), "watch starts stale")
  let v1 = w.read(fn() -> Int { s.get() })
  debug_assert(v1 == 1 && !w.is_stale() && notified[0] == 0, "fresh after read")
  s.set(2)
  debug_assert(w.is_stale() && notified[0] == 1, "notified on change")
  let v2 = w.read(fn() -> Int { s.get() })
  debug_assert(v2 == 2 && !w.is_stale(), "fresh again")

  // Put scope to rest: changes while resting do NOT notify until wake
  let wake = rest(snode)
  debug_assert(w.resting(), "watch is resting")
  s.set(3)
  debug_assert(notified[0] == 1 && w.is_stale(), "resting watch marks stale without notifying")
  wake()
  debug_assert(!w.resting() && notified[0] == 2, "waking stale watch notifies once")
  stop_scope()
  debug_assert(w.gone(), "watch gone after scope stop")
}

test "untracked read and strict untracked detector" {
  let s = signal(42)
  let untracked_hits = [0]
  set_on_untracked_read(Some(fn(_n : ReactiveNode) -> Unit { untracked_hits[0] += 1 }))
  let v1 = s.get()
  debug_assert(v1 == 42 && untracked_hits[0] == 1, "bare read detected")
  let v2 = s.untracked()
  debug_assert(v2 == 42 && untracked_hits[0] == 1, "explicit untracked ignored")
  let v3 = untracked(fn() -> Int { s.get() })
  debug_assert(v3 == 42 && untracked_hits[0] == 1, "untracked block ignored")
  set_on_untracked_read(None)
}

test "DerivedSignal and Optimistic" {
  let base = signal(10)
  let d = derived_signal(fn(_p : Option[Int]) -> Int { base.get() * 2 })
  debug_assert(d.get() == 20, "derived initial")
  d.set(99)
  debug_assert(d.get() == 99, "derived local override")
  base.set(15)
  debug_assert(d.get() == 30, "upstream change resets derived override")

  let auth = signal(100)
  let opt = optimistic(fn() -> Int { auth.get() })
  debug_assert(opt.get() == 100 && !opt.is_pending(), "opt initial")
  let undo1 = opt.push(fn(x : Int) -> Int { x + 5 })
  let undo2 = opt.push(fn(x : Int) -> Int { x * 2 })
  debug_assert(opt.is_pending() && opt.get() == 210, "opt stacked edits")
  undo1()
  debug_assert(opt.is_pending() && opt.get() == 200, "opt after undo1")
  undo1() // idempotent
  debug_assert(opt.get() == 200, "undo1 idempotent")
  undo2()
  debug_assert(!opt.is_pending() && opt.get() == 100, "opt back to authority")
}

test "Keyed and KeyedList per-key granularity" {
  let k = keyed()
  let a_runs = [0]
  let b_runs = [0]
  let stop_a = effect(fn() -> Unit { let _ = k.has("a"); a_runs[0] += 1 })
  let stop_b = effect(fn() -> Unit { let _ = k.has("b"); b_runs[0] += 1 })
  debug_assert(a_runs[0] == 1 && b_runs[0] == 1, "initial")
  k.add("a")
  debug_assert(a_runs[0] == 2 && b_runs[0] == 1, "only a notified")
  k.set(["b"])
  debug_assert(a_runs[0] == 3 && b_runs[0] == 2, "a left, b came")
  stop_a()
  stop_b()

  let kl : KeyedList[Int] = keyed_list(fn(a : Int, b : Int) -> Bool { a == b })
  let order_runs = [0]
  let x_runs = [0]
  let y_runs = [0]
  let stop_o = effect(fn() -> Unit { let _ = kl.keys(); order_runs[0] += 1 })
  let stop_x = effect(fn() -> Unit { let _ = kl.get("x"); x_runs[0] += 1 })
  let stop_y = effect(fn() -> Unit { let _ = kl.get("y"); y_runs[0] += 1 })
  kl.put("x", 1, None)
  kl.put("y", 2, None)
  debug_assert(order_runs[0] == 3 && x_runs[0] == 2 && y_runs[0] == 2, "put x, y")
  kl.put("x", 10, None)
  debug_assert(order_runs[0] == 3 && x_runs[0] == 3 && y_runs[0] == 2, "patch x only notifies x")
  kl.drop("x")
  debug_assert(order_runs[0] == 4 && x_runs[0] == 4 && y_runs[0] == 2 && kl.count() == 1, "drop x")
  stop_o()
  stop_x()
  stop_y()
}

test "Keyed and KeyedList count reactivity in computed" {
  let k = keyed()
  let k_runs = [0]
  let k_cnt = computed(fn(_last : Option[Int]) -> Int {
    k_runs[0] += 1
    k.count()
  })
  debug_assert(k_cnt.get() == 0 && k_runs[0] == 1, "initial keyed count 0")
  k.add("a")
  debug_assert(k_cnt.get() == 1 && k_runs[0] == 2, "add increments keyed count")
  k.add("a")
  debug_assert(k_cnt.get() == 1 && k_runs[0] == 2, "duplicate add does not recompute")
  k.set(["a", "b", "c"])
  debug_assert(k_cnt.get() == 3 && k_runs[0] == 3, "set updates keyed count")
  k.remove("b")
  debug_assert(k_cnt.get() == 2 && k_runs[0] == 4, "remove decrements keyed count")
  k.set([])
  debug_assert(k_cnt.get() == 0 && k_runs[0] == 5, "empty set clears keyed count")

  let kl : KeyedList[Int] = keyed_list(fn(a : Int, b : Int) -> Bool { a == b })
  let kl_runs = [0]
  let kl_cnt = computed(fn(_last : Option[Int]) -> Int {
    kl_runs[0] += 1
    kl.count()
  })
  debug_assert(kl_cnt.get() == 0 && kl_runs[0] == 1, "initial keyed_list count 0")
  kl.put("x", 1, None)
  debug_assert(kl_cnt.get() == 1 && kl_runs[0] == 2, "put x increments keyed_list count")
  kl.put("y", 2, None)
  debug_assert(kl_cnt.get() == 2 && kl_runs[0] == 3, "put y increments keyed_list count")
  kl.put("x", 99, None)
  debug_assert(kl_cnt.get() == 2 && kl_runs[0] == 3, "update existing key does not recompute count")
  kl.drop("x")
  debug_assert(kl_cnt.get() == 1 && kl_runs[0] == 4, "drop x decrements keyed_list count")
}

test "after_flush, after_computing, trigger, memo and inner write" {
  let s = signal(1)
  let order : Array[String] = []
  let stop = effect(fn() -> Unit {
    let v = s.get()
    order.push("eff:" + v.to_string())
    after_flush(fn() -> Unit { order.push("after:" + v.to_string()) })
  })
  order.clear()
  s.set(2)
  debug_assert(order.length() == 2 && order[0] == "eff:2" && order[1] == "after:2", "after_flush order")

  let m_runs = [0]
  let m = memo(fn() -> Int { s.get() % 2 }, fn(parity : Int) -> Int {
    m_runs[0] += 1
    parity * 100
  })
  debug_assert(m.get() == 0 && m_runs[0] == 1, "memo initial")
  s.set(4) // same parity 0
  debug_assert(m.get() == 0 && m_runs[0] == 1, "memo skipped on same input")
  s.set(5) // parity 1
  debug_assert(m.get() == 100 && m_runs[0] == 2, "memo recomputed")
  stop()

  // Inner write inside effect
  let a = signal(0)
  let b = signal(0)
  let b_seen = [0]
  let s1 = effect(fn() -> Unit {
    let v = a.get()
    if v > 0 {
      b.set(v * 10)
    }
  })
  let s2 = effect(fn() -> Unit {
    b_seen[0] = b.get()
  })
  a.set(3)
  debug_assert(b_seen[0] == 30, "inner write propagated")
  s1()
  s2()
}

test "stress create and destroy 2000 scopes/effects/watches with zero leaked links or nodes" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let root = signal(0)
  let c1 = computed(fn(_p : Option[Int]) -> Int { root.get() + 1 })
  let acc = [0]
  for i in 0..<2000 {
    let stop = effect_scope(fn() -> Unit {
      let _ = effect(fn() -> Unit {
        acc[0] += c1.get()
      })
      let w = watch(fn() -> Unit { acc[0] += 1 })
      let _ = w.read(fn() -> Int { c1.get() })
    })
    if i % 100 == 0 {
      root.set(i)
    }
    stop()
  }
  c1.dispose()
  debug_assert(acc[0] > 0, "stress ran")
  // All temporary effects, scopes, watches, signals, computeds, and links must be recycled
  debug_assert(live_link_count() == base_links, "zero leaked links")
  debug_assert(live_node_count() == base_nodes, "zero leaked nodes")
}

test "on-demand slot allocation and zero leak across Signal, Computed, DerivedSignal, Watch, effect_scope" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let base_watches = g.watches.length()

  // Creating idle Signals, Computeds, and DerivedSignals allocates zero graph slots
  let idle_s = signal(10)
  let idle_c = computed(fn(_p : Option[Int]) -> Int { idle_s.get() + 1 })
  let idle_d = derived_signal(fn(_p : Option[Int]) -> Int { idle_s.get() * 2 })
  debug_assert(live_node_count() == base_nodes, "idle creation allocates 0 slots")
  idle_s.set(20)
  debug_assert(idle_s.untracked() == 20, "unwatched set/get works without slot")
  debug_assert(live_node_count() == base_nodes, "unwatched set/get still 0 slots")
  let _ = (idle_c, idle_d)

  // Multi-round subscribe/update/unsubscribe loop
  let acc = [0]
  for i in 0..<200 {
    let s = signal(i)
    let c = computed(fn(_p : Option[Int]) -> Int { s.get() * 3 })
    let c_const = computed(fn(_p : Option[Int]) -> Int { 7 })
    let d = derived_signal(fn(_p : Option[Int]) -> Int { s.get() + 5 })
    let stop = effect_scope(fn() -> Unit {
      let _ = effect(fn() -> Unit {
        acc[0] += c.get() + c_const.get() + d.get()
      })
      let w = watch(fn() -> Unit { acc[0] += 1 })
      let _ = w.read(fn() -> Int { c.get() + d.get() })
    })
    s.set(i + 1)
    d.set(i + 100)
    stop()
    d.dispose()
    debug_assert(live_link_count() == base_links, "round links back to baseline")
    debug_assert(live_node_count() == base_nodes, "round nodes back to baseline")
  }
  debug_assert(acc[0] > 0, "multi-round loop ran")
  // Watch slots must be reused via free_watches rather than growing linearly with 200 rounds
  debug_assert(g.watches.length() <= base_watches + 4, "watch slots reused without unbounded growth")

  // Stale Watch handle after watch_id reuse must stay gone and must not corrupt the new Watch
  let w1 = watch(fn() -> Unit { () })
  let s_reuse = signal(1)
  let _ = w1.read(fn() -> Int { s_reuse.get() })
  w1.stop()
  debug_assert(w1.gone() && w1.is_stale(), "w1 gone after stop")
  let w2 = watch(fn() -> Unit { () })
  let _ = w2.read(fn() -> Int { s_reuse.get() })
  debug_assert(!w2.gone() && !w2.is_stale(), "w2 fresh after reusing watch slot")
  debug_assert(w1.gone() && w1.is_stale(), "w1 still gone after slot reuse")
  w1.touch()
  w1.stop()
  debug_assert(!w2.gone() && !w2.is_stale(), "stale w1 operations must not affect w2")
  w2.stop()
  debug_assert(live_link_count() == base_links, "links clean after watch reuse check")
  debug_assert(live_node_count() == base_nodes, "nodes clean after watch reuse check")
}

test "edge cases: batch set then unwatch, re-subscribe, on_unwatched, computed_scoped, reentrant dispose, on_untracked_read" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()

  // 1. Batch set followed by immediate unwatch before flush must preserve new value
  let bs = signal(1)
  let b_seen = [0]
  let b_stop = effect(fn() -> Unit { b_seen[0] = bs.get() })
  debug_assert(b_seen[0] == 1 && bs.watched(), "batch signal watched")
  batch(fn() -> Unit {
    bs.set(42)
    b_stop()
  })
  debug_assert(!bs.watched(), "batch signal unwatched")
  debug_assert(bs.untracked() == 42, "batch set preserved after unwatch")
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "batch unwatch clean")

  // 2. Re-subscribing previously unwatched Signal and Computed restores full reactivity
  let rs = signal(10)
  let rc = computed(fn(_p : Option[Int]) -> Int { rs.get() * 2 })
  let r_seen : Array[Int] = []
  let stop1 = effect(fn() -> Unit { r_seen.push(rc.get()) })
  debug_assert(r_seen.length() == 1 && r_seen[0] == 20, "first sub initial")
  stop1()
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "released after first stop")
  rs.set(15)
  debug_assert(live_node_count() == base_nodes, "unwatched set keeps 0 nodes")
  let stop2 = effect(fn() -> Unit { r_seen.push(rc.get()) })
  debug_assert(r_seen.length() == 2 && r_seen[1] == 30, "resubscribe sees updated value")
  rs.set(25)
  debug_assert(r_seen.length() == 3 && r_seen[2] == 50, "resubscribe reacts to subsequent sets")
  stop2()
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "released after second stop")

  // 3. on_unwatched registered before any subscription fires on every unwatch cycle
  let us = signal(0)
  let unwatched_hits = [0]
  us.on_unwatched(fn() -> Unit { unwatched_hits[0] += 1 })
  debug_assert(live_node_count() == base_nodes, "on_unwatched does not allocate slot eagerly")
  let u1 = effect(fn() -> Unit { let _ = us.get() })
  u1()
  debug_assert(unwatched_hits[0] == 1, "on_unwatched fired cycle 1")
  debug_assert(live_node_count() == base_nodes, "slot freed after on_unwatched cycle 1")
  let u2 = effect(fn() -> Unit { let _ = us.get() })
  u2()
  debug_assert(unwatched_hits[0] == 2, "on_unwatched fired cycle 2")
  debug_assert(live_node_count() == base_nodes, "slot freed after on_unwatched cycle 2")

  // 4. computed_scoped untracked read releases slot immediately
  let ss = signal(5)
  let sc = computed_scoped(fn(_p : Option[Int]) -> Int { ss.get() + 1 }, None)
  debug_assert(sc.untracked() == 6, "computed_scoped untracked read")
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "computed_scoped released after untracked read")

  // 5. Re-entrant Computed::dispose inside its own getter releases slot cleanly
  let re_s = signal(7)
  let re_box : TestBox[Computed[Int]] = TestBox::{ item: None }
  let re_c = computed(fn(_p : Option[Int]) -> Int {
    let v = re_s.get()
    match re_box.item {
      Some(c) => c.dispose()
      None => ()
    }
    v * 10
  })
  re_box.item = Some(re_c)
  debug_assert(re_c.untracked() == 70, "reentrant dispose returns value")
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "reentrant dispose releases slot")

  // 6. on_untracked_read fires for unallocated Signal without allocating a node slot
  let ut_s = signal(99)
  let ut_hits = [0]
  let ut_ids : Array[Int] = []
  set_on_untracked_read(Some(fn(n : ReactiveNode) -> Unit {
    ut_hits[0] += 1
    ut_ids.push(n.id)
  }))
  let v = ut_s.get()
  set_on_untracked_read(None)
  debug_assert(v == 99 && ut_hits[0] == 1 && ut_ids[0] == -1, "on_untracked_read fires for unallocated signal")
  debug_assert(live_node_count() == base_nodes, "untracked read did not allocate slot")
}

test "adversarial: reentrant on_unwatched slot reuse must not kill newly allocated Watch (P1)" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let base_watches = g.watches.length()

  let us = signal(1)
  let nested_done = [false]
  let w1_box : TestBox[Watch] = TestBox::{ item: None }
  let w2_box : TestBox[Watch] = TestBox::{ item: None }
  us.on_unwatched(fn() -> Unit {
    if !nested_done[0] {
      nested_done[0] = true
      // Nested subscribe + stop frees `us`'s node_id inside the outer on_unwatched callback
      let stop_inner = effect(fn() -> Unit { let _ = us.get() })
      stop_inner()
      // Allocate two watches so one reuses the freed node_id of `us`
      let w1 = watch(fn() -> Unit { () })
      let w2 = watch(fn() -> Unit { () })
      w1_box.item = Some(w1)
      w2_box.item = Some(w2)
    }
  })

  let stop_outer = effect(fn() -> Unit { let _ = us.get() })
  stop_outer()

  let w1 = match w1_box.item {
    Some(w) => w
    None => panic("missing w1")
  }
  let w2 = match w2_box.item {
    Some(w) => w
    None => panic("missing w2")
  }
  debug_assert(!w1.gone(), "w1 must stay alive after outer unwatched_node returns")
  debug_assert(!w2.gone(), "w2 must stay alive after outer unwatched_node returns")
  w1.stop()
  w2.stop()
  debug_assert(live_node_count() == base_nodes, "nodes back to baseline after stopping w1/w2")
  debug_assert(live_link_count() == base_links, "links back to baseline after stopping w1/w2")

  // Verify watch slots are reused cleanly
  let w3 = watch(fn() -> Unit { () })
  w3.stop()
  debug_assert(g.watches.length() <= base_watches + 2, "free_watches reused after P1 probe")
}

test "adversarial: zero-dep Computed stays cached across unwatch/resubscribe until invalidated (P2-1)" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()
  let runs = [0]
  let c = computed(fn(_p : Option[Int]) -> Int {
    runs[0] += 1
    100 + runs[0]
  })
  let seen : Array[Int] = []
  let stop1 = effect(fn() -> Unit { seen.push(c.get()) })
  debug_assert(runs[0] == 1 && seen.length() == 1 && seen[0] == 101, "initial zero-dep compute")
  stop1()
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "zero-dep computed slot released")

  // Re-subscribing without invalidation must NOT re-run getter
  let stop2 = effect(fn() -> Unit { seen.push(c.get()) })
  debug_assert(runs[0] == 1 && seen.length() == 2 && seen[1] == 101, "zero-dep computed cached across resubscribe")
  stop2()
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "released again")

  // Explicit invalidate while unwatched forces recomputation on next subscribe
  c.invalidate()
  let stop3 = effect(fn() -> Unit { seen.push(c.get()) })
  debug_assert(runs[0] == 2 && seen.length() == 3 && seen[2] == 102, "invalidate triggers recompute on resubscribe")
  stop3()
  debug_assert(live_node_count() == base_nodes && live_link_count() == base_links, "clean after invalidate cycle")
}

test "adversarial: Watch/effect self-stop before reading unallocated Signal must not self-loop (P2-2)" {
  let base_nodes = live_node_count()
  let base_links = live_link_count()

  // Case A: Watch::read stops itself then reads an unallocated Signal
  let s1 = signal(7)
  let w = watch(fn() -> Unit { () })
  let got1 = w.read(fn() -> Int {
    w.stop()
    s1.get()
  })
  debug_assert(got1 == 7 && w.gone(), "self-stopped watch read returns value")
  debug_assert(live_node_count() == base_nodes, "no self-loop node leak in Watch::read")
  debug_assert(live_link_count() == base_links, "no self-loop link leak in Watch::read")

  // Case B: effect stops itself during re-run then reads an unallocated Signal
  let trigger_s = signal(0)
  let s2 = signal(99)
  let stop_box : TestBox[() -> Unit] = TestBox::{ item: None }
  let seen = [0]
  let stop_eff = effect(fn() -> Unit {
    let v = trigger_s.get()
    if v > 0 {
      match stop_box.item {
        Some(stop) => stop()
        None => ()
      }
      seen[0] = s2.get()
    }
  })
  stop_box.item = Some(stop_eff)
  trigger_s.set(1)
  debug_assert(seen[0] == 99, "self-stopped effect read returns value")
  debug_assert(live_node_count() == base_nodes, "no self-loop node leak in effect")
  debug_assert(live_link_count() == base_links, "no self-loop link leak in effect")
}

struct EqPair {
  id : Int
  tag : String
}

pub impl Eq for EqPair {
  fn equal(self : EqPair, other : EqPair) -> Bool {
    self.id == other.id && self.tag == other.tag
  }
}

test "builtin Eq Option tuple, Option custom Eq struct, and custom same= override" {
  // 1. Option[(String, String, String)] with built-in Eq
  let tuple_sig : Signal[Option[(String, String, String)]] = signal(None)
  let tuple_runs = [0]
  let stop_t = effect(fn() -> Unit {
    let _ = tuple_sig.get()
    tuple_runs[0] = tuple_runs[0] + 1
  })
  debug_assert(tuple_runs[0] == 1, "tuple signal initial run")
  tuple_sig.set(None)
  debug_assert(tuple_runs[0] == 1, "tuple signal equal None does not re-run")
  tuple_sig.set(Some(("a", "b", "c")))
  debug_assert(tuple_runs[0] == 2, "tuple signal Some triggers run")
  tuple_sig.set(Some(("a", "b", "c")))
  debug_assert(tuple_runs[0] == 2, "tuple signal equal Some does not re-run")
  tuple_sig.set(Some(("a", "b", "d")))
  debug_assert(tuple_runs[0] == 3, "tuple signal distinct Some triggers run")
  stop_t()

  // 2. Option[EqPair] with custom pub impl Eq
  let struct_sig : Signal[Option[EqPair]] = signal(None)
  let struct_runs = [0]
  let stop_s = effect(fn() -> Unit {
    let _ = struct_sig.get()
    struct_runs[0] = struct_runs[0] + 1
  })
  debug_assert(struct_runs[0] == 1, "struct signal initial run")
  struct_sig.set(Some(EqPair::{ id: 1, tag: "ok" }))
  debug_assert(struct_runs[0] == 2, "struct signal Some triggers run")
  struct_sig.set(Some(EqPair::{ id: 1, tag: "ok" }))
  debug_assert(struct_runs[0] == 2, "struct signal equal Some does not re-run")
  struct_sig.set(Some(EqPair::{ id: 2, tag: "ok" }))
  debug_assert(struct_runs[0] == 3, "struct signal distinct Some triggers run")
  stop_s()

  // 3. Custom same= override (always-notify even when == would be true)
  let custom_sig = signal(false, same=fn(_a : Bool, _b : Bool) -> Bool { false })
  let custom_runs = [0]
  let stop_c = effect(fn() -> Unit {
    let _ = custom_sig.get()
    custom_runs[0] = custom_runs[0] + 1
  })
  debug_assert(custom_runs[0] == 1, "custom same initial run")
  custom_sig.set(false)
  debug_assert(custom_runs[0] == 2, "custom same=false overrides default == and re-runs")
  stop_c()

  // 4. computed(..., same=...) custom comparator suppresses downstream effect when parity unchanged
  let num = signal(2)
  let parity_comp = computed(
    fn(_prev : Option[Int]) -> Int { num.get() },
    same=fn(a : Int, b : Int) -> Bool { a % 2 == b % 2 },
  )
  let comp_runs = [0]
  let stop_comp = effect(fn() -> Unit {
    let _ = parity_comp.get()
    comp_runs[0] = comp_runs[0] + 1
  })
  debug_assert(comp_runs[0] == 1, "computed same= initial run")
  num.set(4)
  debug_assert(comp_runs[0] == 1, "computed same= equal parity suppresses re-run")
  num.set(5)
  debug_assert(comp_runs[0] == 2, "computed same= changed parity triggers re-run")
  stop_comp()

  // 5. memo(..., same_in=..., same=...) verifies both input and output comparators
  let m_in = signal(10)
  let m_evals = [0]
  let m_out = memo(
    fn() -> Int { m_in.get() },
    fn(x : Int) -> Int {
      m_evals[0] = m_evals[0] + 1
      x / 10
    },
    same_in=fn(a : Int, b : Int) -> Bool { a / 2 == b / 2 },
    same=fn(a : Int, b : Int) -> Bool { a % 2 == b % 2 },
  )
  let m_runs = [0]
  let stop_m = effect(fn() -> Unit {
    let _ = m_out.get()
    m_runs[0] = m_runs[0] + 1
  })
  debug_assert(m_evals[0] == 1 && m_runs[0] == 1, "memo initial eval & effect")
  // 10 -> 11: same_in(10/2 == 11/2) is true -> memo does not re-evaluate
  m_in.set(11)
  debug_assert(m_evals[0] == 1 && m_runs[0] == 1, "memo same_in= skips re-evaluation")
  // 11 -> 30: same_in false -> re-evaluates (30/10 = 3), same(1 % 2 == 3 % 2) is true -> suppresses downstream effect
  m_in.set(30)
  debug_assert(m_evals[0] == 2 && m_runs[0] == 1, "memo same= suppresses downstream effect")
  // 30 -> 20: same_in false -> re-evaluates (20/10 = 2), same(1 % 2 == 2 % 2) is false -> triggers downstream effect
  m_in.set(20)
  debug_assert(m_evals[0] == 3 && m_runs[0] == 2, "memo same= triggers downstream effect when false")
  stop_m()
}
