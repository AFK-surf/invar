// Read-only reactive signal view (`ReadSignal[T]`).
// Exposes reactive reads without leaking write capabilities (`set`, `update`).
// Wraps a private enum inside a struct so both method dispatch and opacity
// (preventing pattern-matching out the underlying `Signal[T]`) are enforced.

enum ReadSignalInner[T] {
  Sig(Signal[T])
  Comp(Computed[T])
}

pub struct ReadSignal[T] {
  inner : ReadSignalInner[T]
}

pub fn ReadSignal::get[T](self : ReadSignal[T]) -> T {
  match self.inner {
    ReadSignalInner::Sig(s) => s.get()
    ReadSignalInner::Comp(c) => c.get()
  }
}

pub fn ReadSignal::untracked[T](self : ReadSignal[T]) -> T {
  match self.inner {
    ReadSignalInner::Sig(s) => s.untracked()
    ReadSignalInner::Comp(c) => c.untracked()
  }
}

pub fn ReadSignal::watched[T](self : ReadSignal[T]) -> Bool {
  match self.inner {
    ReadSignalInner::Sig(s) => s.watched()
    ReadSignalInner::Comp(c) => c.watched()
  }
}

pub fn ReadSignal::map[T, U : Eq](self : ReadSignal[T], f : (T) -> U) -> Computed[U] {
  self.map_by(f, fn(a : U, b : U) -> Bool { a == b })
}

pub fn ReadSignal::map_by[T, U](
  self : ReadSignal[T],
  f : (T) -> U,
  same : (U, U) -> Bool,
) -> Computed[U] {
  computed_by(fn(_prev : Option[U]) -> U { f(self.get()) }, same)
}
