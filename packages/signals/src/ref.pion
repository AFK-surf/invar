// Canonical mutable reference cell with unique monotonic physical identity.
// Intentionally does NOT implement `signals::Eq`.

struct RefPhysCounter {
  mut next : Int
}

let ref_phys_counter : RefPhysCounter = RefPhysCounter::{ next: 1 }

fn next_ref_phys_id() -> Int {
  let id = ref_phys_counter.next
  ref_phys_counter.next = id + 1
  id
}

/// Mutable cell with a unique monotonically increasing physical identity (`phys_id`).
/// Intentionally does not implement `signals::Eq`; wrap in `signals::signal_ref` or
/// `signals::signal_by` when storing a `Ref[T]` in a reactive signal.
pub struct Ref[T] {
  pub phys_id : Int
  pub mut v : T
}

/// Construct a new `Ref[T]` with a fresh unique `phys_id`.
pub fn ref_new[T](v : T) -> Ref[T] {
  Ref::{ phys_id: next_ref_phys_id(), v }
}
