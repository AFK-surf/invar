}

///|
fn SubPixmap::offset_at(self : SubPixmap, dx : Int, dy : Int) -> Int {
  self.offset + self.real_width * dy + dx
}

///|

#derive(Eq)
pub enum MaskType {
  Alpha
  Luminance
}

///|

pub struct Mask {
  pub data : FixedArray[Byte]
  pub width : Int
  pub height : Int
}
pub fn __mbt_eq_mask(a : Mask, b : Mask) -> Bool {
  (a.data == b.data) && (a.width == b.width) && (a.height == b.height)
}

///|
pub fn Mask::new(width : Int, height : Int) -> Option[Mask] {
  if width <= 0 || height <= 0 || width.to_int64() * height.to_int64() > 2147483647L {
    Option::None
  } else {
    Option::Some({ data: FixedArray::make(width * height, 0.to_byte()), width: width, height: height })
  }
}

///|
pub fn Mask::from_pixmap(pixmap : Pixmap, mask_type : MaskType) -> Mask {
  let n = pixmap.width * pixmap.height
  let data = FixedArray::make(n, 0.to_byte())
  match mask_type {
    MaskType::Alpha => { for i in 0..<n { data[i] = pixmap.data[i * 4 + 3] } }
    MaskType::Luminance =>
    { for i in 0..<n {
      let pa = pixmap.data[i * 4 + 3].to_int()
      let mut r = fi(pixmap.data[i * 4].to_int()) / 255.0
      let mut g = fi(pixmap.data[i * 4 + 1].to_int()) / 255.0
      let mut b = fi(pixmap.data[i * 4 + 2].to_int()) / 255.0
      let a = fi(pa) / 255.0
      if pa != 0 {
        r = r / a
        g = g / a
        b = b / a
      }
      let luma = r * 0.2126 + g * 0.7152 + b * 0.0722
      let v = luma * a * 255.0
      let v : Float = if v < 0.0 { 0.0 } else if v > 255.0 { 255.0 } else { v }
      data[i] = f2u8(v.ceil()).to_byte()
    } }
  }
  Mask::{ data: data, width: pixmap.width, height: pixmap.height }
}

