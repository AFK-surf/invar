///|

#derive(Eq)
pub enum BlendMode {
  Clear
  Source
  Destination
  SourceOver
  DestinationOver
  SourceIn
  DestinationIn
  SourceOut
  DestinationOut
  SourceAtop
  DestinationAtop
  Xor
  Plus
  Modulate
  Screen
  Overlay
  Darken
  Lighten
  ColorDodge
  ColorBurn
  HardLight
  SoftLight
  Difference
  Exclusion
  Multiply
  Hue
  Saturation
  Color
  Luminosity
}

///|
fn BlendMode::should_pre_scale_coverage(self : BlendMode) -> Bool {
  match self {
    BlendMode::Destination | BlendMode::DestinationOver | BlendMode::Plus | BlendMode::DestinationOut | BlendMode::SourceAtop | BlendMode::SourceOver | BlendMode::Xor => true
    _ => false
  }
}

///|
fn BlendMode::to_stage(self : BlendMode) -> Option[Stage] {
  match self {
    BlendMode::Clear => Option::Some(StClear)
    BlendMode::Source => Option::None
    BlendMode::Destination => Option::Some(MoveDestinationToSource)
    BlendMode::SourceOver => Option::Some(StSourceOver)
    BlendMode::DestinationOver => Option::Some(StDestinationOver)
    BlendMode::SourceIn => Option::Some(StSourceIn)
    BlendMode::DestinationIn => Option::Some(StDestinationIn)
    BlendMode::SourceOut => Option::Some(StSourceOut)
    BlendMode::DestinationOut => Option::Some(StDestinationOut)
    BlendMode::SourceAtop => Option::Some(StSourceAtop)
    BlendMode::DestinationAtop => Option::Some(StDestinationAtop)
    BlendMode::Xor => Option::Some(StXor)
    BlendMode::Plus => Option::Some(StPlus)
    BlendMode::Modulate => Option::Some(StModulate)
    BlendMode::Screen => Option::Some(StScreen)
    BlendMode::Overlay => Option::Some(StOverlay)
    BlendMode::Darken => Option::Some(StDarken)
    BlendMode::Lighten => Option::Some(StLighten)
    BlendMode::ColorDodge => Option::Some(StColorDodge)
    BlendMode::ColorBurn => Option::Some(StColorBurn)
    BlendMode::HardLight => Option::Some(StHardLight)
    BlendMode::SoftLight => Option::Some(StSoftLight)
    BlendMode::Difference => Option::Some(StDifference)
    BlendMode::Exclusion => Option::Some(StExclusion)
    BlendMode::Multiply => Option::Some(StMultiply)
    BlendMode::Hue => Option::Some(StHue)
    BlendMode::Saturation => Option::Some(StSaturation)
    BlendMode::Color => Option::Some(StColor)
    BlendMode::Luminosity => Option::Some(StLuminosity)
  }
}
