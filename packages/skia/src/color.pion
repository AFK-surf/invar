///|
pub fn PremultipliedColorU8::demultiply(self : PremultipliedColorU8) -> ColorU8 {
  if self.a == 255 {
    ColorU8::{ r: self.r, g: self.g, b: self.b, a: self.a }
  } else {
    let a = self.a.to_double() / 255.0
    let c = fn(v : Int) { d2u8(v.to_double() / a + 0.5) }
    ColorU8::{ r: c(self.r), g: c(self.g), b: c(self.b), a: self.a }
  }
}

///|
/// Rust's `x as u8` of a f64: saturating to 0..=255, NaN to 0.
fn d2u8(x : Double) -> Int {
  if x.is_nan() || x <= 0.0 {
    0
  } else if x >= 255.0 {
    255
  } else {
    x.to_int()
  }
}

///|
/// Rust's `x as u8` of a f32.
fn f2u8(x : Float) -> Int {
  if x.is_nan() || x <= 0.0 {
    0
  } else if x >= 255.0 {
    255
  } else {
    x.to_int()
  }
}

///|
/// An RGBA colour of channels in 0..=1, straight alpha.

#derive(Eq)
pub struct Color {
  pub r : Float
  pub g : Float
  pub b : Float
  pub a : Float
}

