///|
/// NormalizedF32::new: within 0..=1 and finite.
fn norm_ok(n : Float) -> Bool {
  fin(n) && n >= 0.0 && n <= 1.0
}

///|
pub fn Color::from_rgba(r : Float, g : Float, b : Float, a : Float) -> Option[Color] {
  if norm_ok(r) && norm_ok(g) && norm_ok(b) && norm_ok(a) {
    Option::Some({ r: r, g: g, b: b, a: a })
  } else {
    Option::None
  }
}

///|
pub fn Color::from_rgba8(r : Int, g : Int, b : Int, a : Int) -> Color {
  Color::{ r: fi(r) / 255.0, g: fi(g) / 255.0, b: fi(b) / 255.0, a: fi(a) / 255.0 }
}

///|
pub fn Color::with_alpha(self : Color, a : Float) -> Color {
  Color::{ ..self, a: norm_clamped(a) }
}

///|
/// The colour with its alpha times `opacity` (Color::apply_opacity).
pub fn Color::with_opacity(self : Color, opacity : Float) -> Color {
  Color::{ ..self, a: norm_clamped(self.a * bound(opacity, 0.0, 1.0)) }
}

///|
pub fn Color::is_opaque(self : Color) -> Bool {
  self.a == 1.0
}

///|
pub fn Color::premultiply(self : Color) -> PremultipliedColor {
  if self.is_opaque() {
    PremultipliedColor::{ r: self.r, g: self.g, b: self.b, a: self.a }
  } else {
    PremultipliedColor::{
      r: norm_clamped(self.r * self.a),
      g: norm_clamped(self.g * self.a),
      b: norm_clamped(self.b * self.a),
      a: self.a,
    }
  }
}

///|
pub fn Color::to_color_u8(self : Color) -> ColorU8 {
  ColorU8::{ r: f2u8(self.r * 255.0 + 0.5), g: f2u8(self.g * 255.0 + 0.5), b: f2u8(self.b * 255.0 + 0.5), a: f2u8(self.a * 255.0 + 0.5) }
}

///|

#derive(Eq)
pub struct PremultipliedColor {
  pub r : Float
  pub g : Float
  pub b : Float
  pub a : Float
}

///|
pub fn PremultipliedColor::demultiply(self : PremultipliedColor) -> Color {
  let a = self.a
  if a == 0.0 {
    color_transparent
  } else {
    Color::{ r: norm_clamped(self.r / a), g: norm_clamped(self.g / a), b: norm_clamped(self.b / a), a: a }
  }
}

///|
pub fn PremultipliedColor::to_color_u8(self : PremultipliedColor) -> PremultipliedColorU8 {
  PremultipliedColorU8::{ r: f2u8(self.r * 255.0 + 0.5), g: f2u8(self.g * 255.0 + 0.5), b: f2u8(self.b * 255.0 + 0.5), a: f2u8(self.a * 255.0 + 0.5) }
}

///|
pub fn premultiply_u8(c : Int, a : Int) -> Int {
  let prod = c * a + 128
  ((prod + (prod >> 8)) >> 8) & 0xFF
}

///|

#derive(Eq)
pub enum ColorSpace {
  Linear
  Gamma2
  SimpleSRGB
  FullSRGBGamma
}

///|
fn ColorSpace::expand_channel(self : ColorSpace, x : Float) -> Float {
  match self {
    ColorSpace::Linear => x
    ColorSpace::Gamma2 => x * x
    ColorSpace::SimpleSRGB => norm_clamped(approx_powf(x, 2.2))
    ColorSpace::FullSRGBGamma => {
      let x = if x <= 0.04045 { x / 12.92 } else { approx_powf((x + 0.055) / 1.055, 2.4) }
      norm_clamped(x)
    }
  }
}

///|
fn ColorSpace::expand_color(self : ColorSpace, c : Color) -> Color {
  Color::{ r: self.expand_channel(c.r), g: self.expand_channel(c.g), b: self.expand_channel(c.b), a: c.a }
}

///|
fn ColorSpace::expand_stage(self : ColorSpace) -> Option[Stage] {
  match self {
    ColorSpace::Linear => Option::None
    ColorSpace::Gamma2 => Option::Some(GammaExpand2)
    ColorSpace::SimpleSRGB => Option::Some(GammaExpand22)
    ColorSpace::FullSRGBGamma => Option::Some(GammaExpandSrgb)
  }
}

///|
fn ColorSpace::expand_dest_stage(self : ColorSpace) -> Option[Stage] {
  match self {
    ColorSpace::Linear => Option::None
    ColorSpace::Gamma2 => Option::Some(GammaExpandDestination2)
    ColorSpace::SimpleSRGB => Option::Some(GammaExpandDestination22)
    ColorSpace::FullSRGBGamma => Option::Some(GammaExpandDestinationSrgb)
  }
}

///|
fn ColorSpace::compress_stage(self : ColorSpace) -> Option[Stage] {
  match self {
    ColorSpace::Linear => Option::None
    ColorSpace::Gamma2 => Option::Some(GammaCompress2)
    ColorSpace::SimpleSRGB => Option::Some(GammaCompress22)
    ColorSpace::FullSRGBGamma => Option::Some(GammaCompressSrgb)
  }
}

///|
/// math.rs approx_powf: a fast x^y (Skia's approx_powf), bit for bit as tiny-skia's.
fn approx_powf(x : Float, y : Float) -> Float {
  if x == 0.0 || x == 1.0 {
    return x
  }
  let bits = x.reinterpret_as_uint()
  let e = mbt_compat::float_from_uint(bits) * (1.0 / 8388608.0)
  let m = mbt_compat::float_reinterpret_from_uint((bits & 0x007fffffU) | 0x3f000000U)
  let log2_x = e - 124.225514990 - 1.498030302 * m - 1.725879990 / (0.3520887068 + m)
  let x = log2_x * y
  let f = x - x.floor()
  let mut a = x + 121.274057500
  a = a - f * 1.490129070
  a = a + 27.728023300 / (4.84252568 - f)
  a = a * 8388608.0
  let inf_bits = mbt_compat::float_from_uint(0x7f800000U)
  if a < inf_bits {
    if a > 0.0 {
      mbt_compat::float_reinterpret_from_uint(f2u32(fround(a)))
    } else {
      0.0
    }
  } else {
    Float::from_double(1.0) / 0.0
  }
}

///|
/// Rust's `x as u32` of a f32, in a UInt.
fn f2u32(x : Float) -> UInt {
  if x.is_nan() || x <= 0.0 {
    0U
  } else if x >= 4294967296.0 {
    0xFFFFFFFFU
  } else {
    mbt_compat::double_to_uint(x.to_double())
  }
}

// ── screen rects ──────────────────────────────────────────────────────

///|
/// A rect of whole pixels on a screen: at 0 or past it, never empty, its right and bottom within i32.

#derive(Eq)
pub struct ScreenIntRect {
  pub x : Int
  pub y : Int
  pub width : Int
  pub height : Int
}

///|
pub fn ScreenIntRect::from_xywh(x : Int, y : Int, width : Int, height : Int) -> Option[ScreenIntRect] {
  if x < 0 || y < 0 || width <= 0 || height <= 0 {
    return Option::None
  }
  if x.to_int64() + width.to_int64() > 4294967295L || y.to_int64() + height.to_int64() > 4294967295L {
    return Option::None
  }
  Option::Some({ x: x, y: y, width: width, height: height })
}

///|
pub fn ScreenIntRect::right(self : ScreenIntRect) -> Int {
  self.x + self.width
}

///|
pub fn ScreenIntRect::bottom(self : ScreenIntRect) -> Int {
  self.y + self.height
}

///|
pub fn ScreenIntRect::size(self : ScreenIntRect) -> IntSize {
  IntSize::{ width: self.width, height: self.height }
}

///|
pub fn ScreenIntRect::contains(self : ScreenIntRect, other : ScreenIntRect) -> Bool {
  self.x <= other.x && self.y <= other.y && self.right() >= other.right() && self.bottom() >= other.bottom()
}

///|
pub fn ScreenIntRect::to_int_rect(self : ScreenIntRect) -> IntRect {
  mbt_compat::opt_unwrap(IntRect::from_xywh(self.x, self.y, self.width, self.height))
}

///|
pub fn ScreenIntRect::to_rect(self : ScreenIntRect) -> Rect {
  mbt_compat::opt_unwrap(Rect::from_ltrb(fi(self.x), fi(self.y), fi(self.x) + fi(self.width), fi(self.y) + fi(self.height)))
}

///|
fn IntSize::to_screen_int_rect(self : IntSize, x : Int, y : Int) -> ScreenIntRect {
  mbt_compat::opt_unwrap(ScreenIntRect::from_xywh(x, y, self.width, self.height))
}

///|
fn IntRect::to_screen_int_rect(self : IntRect) -> Option[ScreenIntRect] {
  ScreenIntRect::from_xywh(self.x, self.y, self.width, self.height)
}

