///|
pub fn ColorU8::premultiply(self : ColorU8) -> PremultipliedColorU8 {
  if self.a != 255 {
    PremultipliedColorU8::{ r: premultiply_u8(self.r, self.a), g: premultiply_u8(self.g, self.a), b: premultiply_u8(self.b, self.a), a: self.a }
