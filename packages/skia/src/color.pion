// tiny-skia's colours, screen rects and blend modes.

/// RGBA in bytes, straight alpha.
#derive(Eq)
pub struct ColorU8 {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Int
}

pub fn ColorU8::from_rgba(r : Int, g : Int, b : Int, a : Int) -> ColorU8 {
  ColorU8::{ r, g, b, a }
}

pub fn ColorU8::premultiply(self : ColorU8) -> PremultipliedColorU8 {
  if self.a != 255 {
    PremultipliedColorU8::{
      r: premultiply_u8(self.r, self.a),
      g: premultiply_u8(self.g, self.a),
      b: premultiply_u8(self.b, self.a),
      a: self.a,
    }
  } else {
    PremultipliedColorU8::{ r: self.r, g: self.g, b: self.b, a: self.a }
  }
}

/// RGBA in bytes, colour premultiplied by alpha.
#derive(Eq)
pub struct PremultipliedColorU8 {
  pub r : Int
  pub g : Int
  pub b : Int
  pub a : Int
}

pub fn PremultipliedColorU8::from_rgba(r : Int, g : Int, b : Int, a : Int) -> Option[PremultipliedColorU8] {
  if r <= a && g <= a && b <= a {
    Some(PremultipliedColorU8::{ r, g, b, a })
  } else {
    None
  }
}

pub fn PremultipliedColorU8::demultiply(self : PremultipliedColorU8) -> ColorU8 {
  if self.a == 255 {
    ColorU8::{ r: self.r, g: self.g, b: self.b, a: self.a }
  } else {
    let a = self.a.to_double() / 255.0
    let c = fn(v : Int) -> Int { d2u8(v.to_double() / a + 0.5) }
    ColorU8::{ r: c(self.r), g: c(self.g), b: c(self.b), a: self.a }
  }
}

/// Rust's `x as u8` of a f64: saturating to 0..=255, NaN to 0.
fn d2u8(x : Double) -> Int {
  if d_is_nan(x) || x <= 0.0 {
    0
  } else if x >= 255.0 {
    255
  } else {
    x.to_int()
  }
}

/// Rust's `x as u8` of a f32.
fn f2u8(x : Float) -> Int {
  if f_is_nan(x) || x <= 0.0f {
    0
  } else if x >= 255.0f {
    255
  } else {
    x.to_int()
  }
}

/// An RGBA colour of channels in 0..=1, straight alpha.
#derive(Eq)
pub struct Color {
  pub r : Float
  pub g : Float
  pub b : Float
  pub a : Float
}

pub fn color_transparent() -> Color {
  Color::{ r: 0.0f, g: 0.0f, b: 0.0f, a: 0.0f }
}

pub fn color_black() -> Color {
  Color::{ r: 0.0f, g: 0.0f, b: 0.0f, a: 1.0f }
}

pub fn color_white() -> Color {
  Color::{ r: 1.0f, g: 1.0f, b: 1.0f, a: 1.0f }
}

/// NormalizedF32::new: within 0..=1 and finite.
fn norm_ok(n : Float) -> Bool {
  fin(n) && n >= 0.0f && n <= 1.0f
}

pub fn Color::from_rgba(r : Float, g : Float, b : Float, a : Float) -> Option[Color] {
  if norm_ok(r) && norm_ok(g) && norm_ok(b) && norm_ok(a) {
    Some(Color::{ r, g, b, a })
  } else {
    None
  }
}

pub fn Color::from_rgba8(r : Int, g : Int, b : Int, a : Int) -> Color {
  Color::{ r: fi(r) / 255.0f, g: fi(g) / 255.0f, b: fi(b) / 255.0f, a: fi(a) / 255.0f }
}

pub fn Color::with_alpha(self : Color, a : Float) -> Color {
  Color::{ r: self.r, g: self.g, b: self.b, a: norm_clamped(a) }
}

/// The colour with its alpha times `opacity` (Color::apply_opacity).
pub fn Color::with_opacity(self : Color, opacity : Float) -> Color {
  Color::{ r: self.r, g: self.g, b: self.b, a: norm_clamped(self.a * bound(opacity, 0.0f, 1.0f)) }
}

pub fn Color::is_opaque(self : Color) -> Bool {
  self.a == 1.0f
}

pub fn Color::premultiply(self : Color) -> PremultipliedColor {
  if self.is_opaque() {
    PremultipliedColor::{ r: self.r, g: self.g, b: self.b, a: self.a }
  } else {
    PremultipliedColor::{
      r: norm_clamped(self.r * self.a),
      g: norm_clamped(self.g * self.a),
      b: norm_clamped(self.b * self.a),
      a: self.a,
    }
  }
}

pub fn Color::to_color_u8(self : Color) -> ColorU8 {
  ColorU8::{
    r: f2u8(self.r * 255.0f + 0.5f),
    g: f2u8(self.g * 255.0f + 0.5f),
    b: f2u8(self.b * 255.0f + 0.5f),
    a: f2u8(self.a * 255.0f + 0.5f),
  }
}

#derive(Eq)
pub struct PremultipliedColor {
  pub r : Float
  pub g : Float
  pub b : Float
  pub a : Float
}

pub fn PremultipliedColor::demultiply(self : PremultipliedColor) -> Color {
  let a = self.a
  if a == 0.0f {
    color_transparent()
  } else {
    Color::{ r: norm_clamped(self.r / a), g: norm_clamped(self.g / a), b: norm_clamped(self.b / a), a }
  }
}

pub fn PremultipliedColor::to_color_u8(self : PremultipliedColor) -> PremultipliedColorU8 {
  PremultipliedColorU8::{
    r: f2u8(self.r * 255.0f + 0.5f),
    g: f2u8(self.g * 255.0f + 0.5f),
    b: f2u8(self.b * 255.0f + 0.5f),
    a: f2u8(self.a * 255.0f + 0.5f),
  }
}

pub fn premultiply_u8(c : Int, a : Int) -> Int {
  let prod = c * a + 128
  ((prod + (prod >> 8)) >> 8) & 0xFF
}

#derive(Eq)
pub enum ColorSpace {
  Linear
  Gamma2
  SimpleSRGB
  FullSRGBGamma
}

fn color_space_expand_channel(cs : ColorSpace, x : Float) -> Float {
  match cs {
    ColorSpace::Linear => x
    ColorSpace::Gamma2 => x * x
    ColorSpace::SimpleSRGB => norm_clamped(approx_powf(x, 2.2f))
    ColorSpace::FullSRGBGamma => {
      let v = if x <= 0.04045f { x / 12.92f } else { approx_powf((x + 0.055f) / 1.055f, 2.4f) }
      norm_clamped(v)
    }
  }
}

fn color_space_expand_color(cs : ColorSpace, c : Color) -> Color {
  Color::{
    r: color_space_expand_channel(cs, c.r),
    g: color_space_expand_channel(cs, c.g),
    b: color_space_expand_channel(cs, c.b),
    a: c.a,
  }
}

fn color_space_expand_stage(cs : ColorSpace) -> Option[Stage] {
  match cs {
    ColorSpace::Linear => None
    ColorSpace::Gamma2 => Some(Stage::GammaExpand2)
    ColorSpace::SimpleSRGB => Some(Stage::GammaExpand22)
    ColorSpace::FullSRGBGamma => Some(Stage::GammaExpandSrgb)
  }
}

fn color_space_expand_dest_stage(cs : ColorSpace) -> Option[Stage] {
  match cs {
    ColorSpace::Linear => None
    ColorSpace::Gamma2 => Some(Stage::GammaExpandDestination2)
    ColorSpace::SimpleSRGB => Some(Stage::GammaExpandDestination22)
    ColorSpace::FullSRGBGamma => Some(Stage::GammaExpandDestinationSrgb)
  }
}

fn color_space_compress_stage(cs : ColorSpace) -> Option[Stage] {
  match cs {
    ColorSpace::Linear => None
    ColorSpace::Gamma2 => Some(Stage::GammaCompress2)
    ColorSpace::SimpleSRGB => Some(Stage::GammaCompress22)
    ColorSpace::FullSRGBGamma => Some(Stage::GammaCompressSrgb)
  }
}

/// math.rs approx_powf: a fast x^y (Skia's approx_powf), bit for bit as tiny-skia's.
fn approx_powf(x : Float, y : Float) -> Float {
  if x == 0.0f || x == 1.0f {
    return x
  }
  let bits = x.reinterpret_as_uint()
  let e = bits.to_float() * (1.0f / 8388608.0f)
  let m = ((bits & 0x007fffffU) | 0x3f000000U).reinterpret_as_float()
  let log2_x = e - 124.225514990f - 1.498030302f * m - 1.725879990f / (0.3520887068f + m)
  let x2 = log2_x * y
  let f = x2 - x2.floor()
  let mut a = x2 + 121.274057500f
  a = a - f * 1.490129070f
  a = a + 27.728023300f / (4.84252568f - f)
  a = a * 8388608.0f
  let inf_bits = (0x7f800000U).to_float()
  if a < inf_bits {
    if a > 0.0f {
      f2u32(fround(a)).reinterpret_as_float()
    } else {
      0.0f
    }
  } else {
    1.0f / 0.0f
  }
}

/// Rust's `x as u32` of a f32, in a UInt.
fn f2u32(x : Float) -> UInt {
  if f_is_nan(x) || x <= 0.0f {
    0U
  } else if x >= 4294967296.0f {
    0xFFFFFFFFU
  } else {
    x.to_double().to_int64().to_uint64().to_uint()
  }
}

// ── screen rects ──────────────────────────────────────────────────────

/// A rect of whole pixels on a screen: at 0 or past it, never empty, its right and bottom within i32.
#derive(Eq)
pub struct ScreenIntRect {
  pub x : Int
  pub y : Int
  pub width : Int
  pub height : Int
}

pub fn ScreenIntRect::from_xywh(x : Int, y : Int, width : Int, height : Int) -> Option[ScreenIntRect] {
  if x < 0 || y < 0 || width <= 0 || height <= 0 {
    return None
  }
  if x.to_int64() + width.to_int64() > 4294967295L || y.to_int64() + height.to_int64() > 4294967295L {
    return None
  }
  Some(ScreenIntRect::{ x, y, width, height })
}

pub fn ScreenIntRect::right(self : ScreenIntRect) -> Int {
  self.x + self.width
}

pub fn ScreenIntRect::bottom(self : ScreenIntRect) -> Int {
  self.y + self.height
}

pub fn ScreenIntRect::size(self : ScreenIntRect) -> IntSize {
  IntSize::{ width: self.width, height: self.height }
}

pub fn ScreenIntRect::contains(self : ScreenIntRect, other : ScreenIntRect) -> Bool {
  self.x <= other.x && self.y <= other.y && self.right() >= other.right() && self.bottom() >= other.bottom()
}

pub fn ScreenIntRect::to_int_rect(self : ScreenIntRect) -> IntRect {
  unwrap_opt(IntRect::from_xywh(self.x, self.y, self.width, self.height), "ScreenIntRect::to_int_rect")
}

pub fn ScreenIntRect::to_rect(self : ScreenIntRect) -> Rect {
  unwrap_opt(
    Rect::from_ltrb(fi(self.x), fi(self.y), fi(self.x) + fi(self.width), fi(self.y) + fi(self.height)),
    "ScreenIntRect::to_rect",
  )
}

fn IntSize::to_screen_int_rect(self : IntSize, x : Int, y : Int) -> ScreenIntRect {
  unwrap_opt(ScreenIntRect::from_xywh(x, y, self.width, self.height), "IntSize::to_screen_int_rect")
}

fn IntRect::to_screen_int_rect(self : IntRect) -> Option[ScreenIntRect] {
  ScreenIntRect::from_xywh(self.x, self.y, self.width, self.height)
}

// ── blend modes ───────────────────────────────────────────────────────

#derive(Eq)
pub enum BlendMode {
  Clear
  Source
  Destination
  SourceOver
  DestinationOver
  SourceIn
  DestinationIn
  SourceOut
  DestinationOut
  SourceAtop
  DestinationAtop
  Xor
  Plus
  Modulate
  Screen
  Overlay
  Darken
  Lighten
  ColorDodge
  ColorBurn
  HardLight
  SoftLight
  Difference
  Exclusion
  Multiply
  Hue
  Saturation
  Color
  Luminosity
}

fn blend_mode_should_pre_scale_coverage(bm : BlendMode) -> Bool {
  match bm {
    BlendMode::Destination
    | BlendMode::DestinationOver
    | BlendMode::Plus
    | BlendMode::DestinationOut
    | BlendMode::SourceAtop
    | BlendMode::SourceOver
    | BlendMode::Xor => true
    _ => false
  }
}

fn blend_mode_to_stage(bm : BlendMode) -> Option[Stage] {
  match bm {
    BlendMode::Clear => Some(Stage::StClear)
    BlendMode::Source => None
    BlendMode::Destination => Some(Stage::MoveDestinationToSource)
    BlendMode::SourceOver => Some(Stage::StSourceOver)
    BlendMode::DestinationOver => Some(Stage::StDestinationOver)
    BlendMode::SourceIn => Some(Stage::StSourceIn)
    BlendMode::DestinationIn => Some(Stage::StDestinationIn)
    BlendMode::SourceOut => Some(Stage::StSourceOut)
    BlendMode::DestinationOut => Some(Stage::StDestinationOut)
    BlendMode::SourceAtop => Some(Stage::StSourceAtop)
    BlendMode::DestinationAtop => Some(Stage::StDestinationAtop)
    BlendMode::Xor => Some(Stage::StXor)
    BlendMode::Plus => Some(Stage::StPlus)
    BlendMode::Modulate => Some(Stage::StModulate)
    BlendMode::Screen => Some(Stage::StScreen)
    BlendMode::Overlay => Some(Stage::StOverlay)
    BlendMode::Darken => Some(Stage::StDarken)
    BlendMode::Lighten => Some(Stage::StLighten)
    BlendMode::ColorDodge => Some(Stage::StColorDodge)
    BlendMode::ColorBurn => Some(Stage::StColorBurn)
    BlendMode::HardLight => Some(Stage::StHardLight)
    BlendMode::SoftLight => Some(Stage::StSoftLight)
    BlendMode::Difference => Some(Stage::StDifference)
    BlendMode::Exclusion => Some(Stage::StExclusion)
    BlendMode::Multiply => Some(Stage::StMultiply)
    BlendMode::Hue => Some(Stage::StHue)
    BlendMode::Saturation => Some(Stage::StSaturation)
    BlendMode::Color => Some(Stage::StColor)
    BlendMode::Luminosity => Some(Stage::StLuminosity)
  }
}
