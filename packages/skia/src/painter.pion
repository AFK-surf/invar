// tiny-skia's painting: paints, the blitter that runs a paint's pipeline
// over spans, and filling, stroking and drawing into a pixmap.

pub struct Paint {
  pub mut shader : Shader
  pub mut blend_mode : BlendMode
  pub mut anti_alias : Bool
  pub mut colorspace : ColorSpace
  pub mut force_hq_pipeline : Bool
}

pub fn Paint::default() -> Paint {
  Paint::{
    shader: Shader::SolidColor(color_black()),
    blend_mode: BlendMode::SourceOver,
    anti_alias: true,
    colorspace: ColorSpace::Linear,
    force_hq_pipeline: false,
  }
}

pub fn Paint::set_color(self : Paint, color : Color) -> Unit {
  self.shader = Shader::SolidColor(color)
}

pub fn Paint::set_color_rgba8(self : Paint, r : Int, g : Int, b : Int, a : Int) -> Unit {
  self.set_color(Color::from_rgba8(r, g, b, a))
}

pub fn Paint::is_solid_color(self : Paint) -> Bool {
  match self.shader {
    Shader::SolidColor(_) => true
    _ => false
  }
}

fn paint_with_shader(paint : Paint, shader : Shader) -> Paint {
  Paint::{
    shader,
    blend_mode: paint.blend_mode,
    anti_alias: paint.anti_alias,
    colorspace: paint.colorspace,
    force_hq_pipeline: paint.force_hq_pipeline,
  }
}

struct RasterPipelineBlitter {
  mask : Option[MaskCtx]
  pixmap_src : Pixmap
  pixmap : SubPixmap
  memset2d_color : Option[PremultipliedColorU8]
  blit_anti_h_rp : RasterPipeline
  blit_rect_rp : RasterPipeline
  blit_mask_rp : RasterPipeline
  is_mask : Bool
}

fn empty_src() -> Pixmap {
  Pixmap::{ data: FixedArray::make(4, 0 as Byte), width: 1, height: 1 }
}

fn push_opt_stage(p : RasterPipelineBuilder, s : Option[Stage]) -> Unit {
  match s {
    Some(st) => p.push(st)
    None => ()
  }
}

fn RasterPipelineBlitter::new(paint : Paint, mask : Option[MaskCtx], pixmap : SubPixmap) -> Option[RasterPipelineBlitter] {
  match paint.blend_mode {
    BlendMode::Destination => return None
    BlendMode::DestinationIn =>
      if shader_is_opaque(paint.shader) && paint.is_solid_color() {
        return None
      }
    _ => ()
  }
  let mut blend_mode = paint.blend_mode
  if shader_is_opaque(paint.shader) && blend_mode == BlendMode::SourceOver && mask.is_none() {
    blend_mode = BlendMode::Source
  }
  let mut memset2d_color : Option[PremultipliedColorU8] = None
  if paint.is_solid_color() && blend_mode == BlendMode::Source && mask.is_none() {
    match paint.shader {
      Shader::SolidColor(color) => memset2d_color = Some(color.premultiply().to_color_u8())
      _ => ()
    }
  }
  if blend_mode == BlendMode::Clear && !paint.anti_alias && mask.is_none() {
    blend_mode = BlendMode::Source
    memset2d_color = Some(PremultipliedColorU8::{ r: 0, g: 0, b: 0, a: 0 })
  }
  let cs = paint.colorspace

  let p1 = RasterPipelineBuilder::new()
  p1.force_hq_pipeline = paint.force_hq_pipeline
  if !shader_push_stages(paint.shader, cs, p1) {
    return None
  }
  if mask.is_some() {
    p1.push(Stage::MaskU8)
  }
  if blend_mode_should_pre_scale_coverage(blend_mode) {
    p1.push(Stage::Scale1Float)
    p1.push(Stage::LoadDestination)
    push_opt_stage(p1, color_space_expand_dest_stage(cs))
    push_opt_stage(p1, blend_mode_to_stage(blend_mode))
  } else {
    p1.push(Stage::LoadDestination)
    push_opt_stage(p1, color_space_expand_dest_stage(cs))
    push_opt_stage(p1, blend_mode_to_stage(blend_mode))
    p1.push(Stage::Lerp1Float)
  }
  push_opt_stage(p1, color_space_compress_stage(cs))
  p1.push(Stage::Store)
  let blit_anti_h_rp = p1.compile()

  let p2 = RasterPipelineBuilder::new()
  p2.force_hq_pipeline = paint.force_hq_pipeline
  if !shader_push_stages(paint.shader, cs, p2) {
    return None
  }
  if mask.is_some() {
    p2.push(Stage::MaskU8)
  }
  if blend_mode == BlendMode::SourceOver && mask.is_none() {
    push_opt_stage(p2, color_space_compress_stage(cs))
    p2.push(Stage::SourceOverRgba)
  } else {
    if blend_mode != BlendMode::Source {
      p2.push(Stage::LoadDestination)
      match blend_mode_to_stage(blend_mode) {
        Some(bs) => {
          push_opt_stage(p2, color_space_expand_dest_stage(cs))
          p2.push(bs)
        }
        None => ()
      }
    }
    push_opt_stage(p2, color_space_compress_stage(cs))
    p2.push(Stage::Store)
  }
  let blit_rect_rp = p2.compile()

  let p3 = RasterPipelineBuilder::new()
  p3.force_hq_pipeline = paint.force_hq_pipeline
  if !shader_push_stages(paint.shader, cs, p3) {
    return None
  }
  if mask.is_some() {
    p3.push(Stage::MaskU8)
  }
  if blend_mode_should_pre_scale_coverage(blend_mode) {
    p3.push(Stage::ScaleU8)
    p3.push(Stage::LoadDestination)
    push_opt_stage(p3, color_space_expand_dest_stage(cs))
    push_opt_stage(p3, blend_mode_to_stage(blend_mode))
  } else {
    p3.push(Stage::LoadDestination)
    push_opt_stage(p3, color_space_expand_dest_stage(cs))
    push_opt_stage(p3, blend_mode_to_stage(blend_mode))
    p3.push(Stage::LerpU8)
  }
  push_opt_stage(p3, color_space_compress_stage(cs))
  p3.push(Stage::Store)
  let blit_mask_rp = p3.compile()

  let pixmap_src = match paint.shader {
    Shader::PatternShader(patt) => patt.pixmap
    _ => empty_src()
  }
  Some(RasterPipelineBlitter::{
    mask,
    pixmap_src,
    pixmap,
    memset2d_color,
    blit_anti_h_rp,
    blit_rect_rp,
    blit_mask_rp,
    is_mask: false,
  })
}

fn RasterPipelineBlitter::new_mask(pixmap : SubPixmap) -> RasterPipelineBlitter {
  let color = color_white().premultiply()
  let p1 = RasterPipelineBuilder::new()
  p1.push_uniform_color(color)
  p1.push(Stage::LoadDestinationU8)
  p1.push(Stage::Lerp1Float)
  p1.push(Stage::StoreU8)
  let blit_anti_h_rp = p1.compile()
  let p2 = RasterPipelineBuilder::new()
  p2.push_uniform_color(color)
  p2.push(Stage::StoreU8)
  let blit_rect_rp = p2.compile()
  let p3 = RasterPipelineBuilder::new()
  p3.push_uniform_color(color)
  p3.push(Stage::LoadDestinationU8)
  p3.push(Stage::LerpU8)
  p3.push(Stage::StoreU8)
  let blit_mask_rp = p3.compile()
  RasterPipelineBlitter::{
    mask: None,
    pixmap_src: empty_src(),
    pixmap,
    memset2d_color: Some(color.to_color_u8()),
    blit_anti_h_rp,
    blit_rect_rp,
    blit_mask_rp,
    is_mask: true,
  }
}

fn RasterPipelineBlitter::mask_ctx(self : RasterPipelineBlitter) -> MaskCtx {
  match self.mask {
    Some(m) => m
    None => mask_none()
  }
}

fn RasterPipelineBlitter::blit_mask(
  self : RasterPipelineBlitter,
  image : (Int, Int),
  bounds : ScreenIntRect,
  row_bytes : Int,
  clip : ScreenIntRect,
) -> Unit {
  let aa = AAMaskCtx::{ p0: image.0, p1: image.1, stride: row_bytes, shift: bounds.x + bounds.y * row_bytes }
  self.blit_mask_rp.run(clip, aa, self.mask_ctx(), self.pixmap_src, self.pixmap)
}

fn RasterPipelineBlitter::blit_h(self : RasterPipelineBlitter, x : Int, y : Int, width : Int) -> Unit {
  self.blit_rect(ScreenIntRect::{ x, y, width, height: 1 })
}

fn RasterPipelineBlitter::blit_anti_h(
  self : RasterPipelineBlitter,
  x_in : Int,
  y : Int,
  aa : FixedArray[Int],
  runs : FixedArray[Int],
) -> Unit {
  let mask_ctx = self.mask_ctx()
  let mut x = x_in
  let mut offset = 0
  let mut run = runs[0]
  while run != 0 {
    let width = run
    let alpha = aa[offset]
    if alpha == 0 {
      ()
    } else if alpha == 255 {
      self.blit_h(x, y, width)
    } else {
      self.blit_anti_h_rp.ctx.current_coverage = fi(alpha) * (1.0f / 255.0f)
      self.blit_anti_h_rp.run(ScreenIntRect::{ x, y, width, height: 1 }, aa_mask_none(), mask_ctx, self.pixmap_src, self.pixmap)
    }
    x += width
    offset += run
    run = runs[offset]
  }
}

fn RasterPipelineBlitter::blit_v(self : RasterPipelineBlitter, x : Int, y : Int, height : Int, alpha : Int) -> Unit {
  let bounds = ScreenIntRect::{ x, y, width: 1, height }
  self.blit_mask((alpha, alpha), bounds, 0, bounds)
}

fn RasterPipelineBlitter::blit_anti_h2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds = ScreenIntRect::{ x, y, width: 2, height: 1 }
  self.blit_mask((alpha0, alpha1), bounds, 2, bounds)
}

fn RasterPipelineBlitter::blit_anti_v2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds = ScreenIntRect::{ x, y, width: 1, height: 2 }
  self.blit_mask((alpha0, alpha1), bounds, 1, bounds)
}

fn RasterPipelineBlitter::blit_rect(self : RasterPipelineBlitter, rect : ScreenIntRect) -> Unit {
  match self.memset2d_color {
    Some(c) => {
      let d = self.pixmap.data
      let rb = c.r.to_byte()
      let gb = c.g.to_byte()
      let bb = c.b.to_byte()
      let ab = c.a.to_byte()
      for y in 0..<rect.height {
        let start = self.pixmap.offset_at(rect.x, rect.y + y)
        if self.is_mask {
          for i in start..<(start + rect.width) {
            d[i] = ab
          }
        } else {
          for i in start..<(start + rect.width) {
            d[i * 4] = rb
            d[i * 4 + 1] = gb
            d[i * 4 + 2] = bb
            d[i * 4 + 3] = ab
          }
        }
      }
    }
    None => self.blit_rect_rp.run(rect, aa_mask_none(), self.mask_ctx(), self.pixmap_src, self.pixmap)
  }
}

// ── painting ──────────────────────────────────────────────────────────

/// Tiles of at most 8191 pixels a side where a pixmap is larger (DrawTiler), None where it needs none.
fn draw_tiles(w : Int, h : Int) -> Option[Array[ScreenIntRect]] {
  let max = 8192 - 1
  if w <= max && h <= max {
    return None
  }
  let tiles : Array[ScreenIntRect] = []
  let mut x = 0
  let mut y = 0
  while x < w && y < h {
    let th = if h - y < max { h - y } else { max }
    let tw = if w - x < max { w - x } else { max }
    match ScreenIntRect::from_xywh(x, y, tw, th) {
      Some(r) => tiles.push(r)
      None => ()
    }
    x += max
    if x >= w {
      x = 0
      y += max
    }
  }
  Some(tiles)
}

fn is_too_big_for_math(path : Path) -> Bool {
  let max = scalar_max * 0.25f
  let b = path.bounds
  !(b.left >= -max && b.top >= -max && b.right <= max && b.bottom <= max)
}

pub fn Pixmap::fill_rect(self : Pixmap, rect : Rect, paint : Paint, transform : Transform, mask : Option[Mask]) -> Unit {
  if transform.is_identity() && draw_tiles(self.width, self.height).is_none() {
    let clip = self.size().to_screen_int_rect(0, 0)
    let mctx = match mask {
      Some(m) => Some(m.mask_ctx())
      None => None
    }
    match RasterPipelineBlitter::new(paint, mctx, self.as_subpixmap()) {
      Some(b) => {
        let bl = Blitter::Raster(b)
        if paint.anti_alias {
          fill_rect_aa(rect, clip, bl)
        } else {
          fill_rect_nonaa(rect, clip, bl)
        }
      }
      None => ()
    }
  } else {
    self.fill_path(PathBuilder::from_rect(rect), paint, FillRule::Winding, transform, mask)
  }
}

pub fn Pixmap::fill_path(
  self : Pixmap,
  path : Path,
  paint : Paint,
  fill_rule : FillRule,
  transform : Transform,
  mask : Option[Mask],
) -> Unit {
  if !transform.is_identity() {
    match path.transform(transform) {
      Some(p) => self.fill_path(p, paint_with_shader(paint, shader_transformed(paint.shader, transform)), fill_rule, Transform::identity(), mask)
      None => ()
    }
    return
  }
  let b = path.bounds
  if is_nearly_zero(b.width()) || is_nearly_zero(b.height()) {
    return
  }
  if is_too_big_for_math(path) {
    return
  }
  match draw_tiles(self.width, self.height) {
    Some(tiles) => {
      let mut cur_path = path
      let mut cur_paint = paint
      for tile in tiles {
        let ts = Transform::from_translate(-fi(tile.x), -fi(tile.y))
        cur_path = match cur_path.transform(ts) {
          Some(v) => v
          None => return
        }
        cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, ts))
        let clip_rect = tile.size().to_screen_int_rect(0, 0)
        match self.subpixmap(tile.to_int_rect()) {
          Some(sub) => {
            let submask = match mask {
              Some(m) => m.submask_ctx(tile.to_int_rect())
              None => None
            }
            match RasterPipelineBlitter::new(cur_paint, submask, sub) {
              Some(bl0) => {
                let bl = Blitter::Raster(bl0)
                if cur_paint.anti_alias {
                  fill_path_aa(cur_path, fill_rule, clip_rect, bl)
                } else {
                  fill_path_nonaa(cur_path, fill_rule, clip_rect, bl)
                }
              }
              None => ()
            }
          }
          None => ()
        }
        let ts2 = Transform::from_translate(fi(tile.x), fi(tile.y))
        cur_path = match cur_path.transform(ts2) {
          Some(v) => v
          None => return
        }
        cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, ts2))
      }
    }
    None => {
      let clip_rect = self.size().to_screen_int_rect(0, 0)
      let mctx = match mask {
        Some(m) => Some(m.mask_ctx())
        None => None
      }
      match RasterPipelineBlitter::new(paint, mctx, self.as_subpixmap()) {
        Some(bl0) => {
          let bl = Blitter::Raster(bl0)
          if paint.anti_alias {
            fill_path_aa(path, fill_rule, clip_rect, bl)
          } else {
            fill_path_nonaa(path, fill_rule, clip_rect, bl)
          }
        }
        None => ()
      }
    }
  }
}

pub fn Pixmap::stroke_path(
  self : Pixmap,
  path_in : Path,
  paint : Paint,
  stroke : Stroke,
  transform : Transform,
  mask : Option[Mask],
) -> Unit {
  if stroke.width < 0.0f {
    return
  }
  let res_scale = PathStroker::compute_resolution_scale(transform)
  let path = match stroke.dash {
    Some(dash) =>
      match path_in.dash(dash, res_scale) {
        Some(p) => p
        None => return
      }
    None => path_in
  }
  match treat_as_hairline(paint, stroke, transform) {
    Some(coverage) => {
      let mut cur_paint = paint
      if coverage == 1.0f {
        ()
      } else if blend_mode_should_pre_scale_coverage(cur_paint.blend_mode) {
        let scale = f2i(coverage * 256.0f)
        let new_alpha = (255 * scale) >> 8
        cur_paint = paint_with_shader(cur_paint, shader_with_opacity(cur_paint.shader, fi(new_alpha) / 255.0f))
      }
      match draw_tiles(self.width, self.height) {
        Some(tiles) => {
          let mut cur_path = path
          if !transform.is_identity() {
            cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, transform))
            cur_path = match cur_path.transform(transform) {
              Some(v) => v
              None => return
            }
          }
          for tile in tiles {
            let ts = Transform::from_translate(-fi(tile.x), -fi(tile.y))
            cur_path = match cur_path.transform(ts) {
              Some(v) => v
              None => return
            }
            cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, ts))
            match self.subpixmap(tile.to_int_rect()) {
              Some(sub) => {
                let submask = match mask {
                  Some(m) => m.submask_ctx(tile.to_int_rect())
                  None => None
                }
                stroke_hairline_into(cur_path, cur_paint, stroke.line_cap, submask, sub)
              }
              None => ()
            }
            let ts2 = Transform::from_translate(fi(tile.x), fi(tile.y))
            cur_path = match cur_path.transform(ts2) {
              Some(v) => v
              None => return
            }
            cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, ts2))
          }
        }
        None => {
          let mctx = match mask {
            Some(m) => Some(m.mask_ctx())
            None => None
          }
          if !transform.is_identity() {
            cur_paint = paint_with_shader(cur_paint, shader_transformed(cur_paint.shader, transform))
            match path.transform(transform) {
              Some(p) => stroke_hairline_into(p, cur_paint, stroke.line_cap, mctx, self.as_subpixmap())
              None => ()
            }
          } else {
            stroke_hairline_into(path, cur_paint, stroke.line_cap, mctx, self.as_subpixmap())
          }
        }
      }
    }
    None =>
      match path.stroke(stroke, res_scale) {
        Some(p) => self.fill_path(p, paint, FillRule::Winding, transform, mask)
        None => ()
      }
  }
}

fn stroke_hairline_into(path : Path, paint : Paint, line_cap : LineCap, mask : Option[MaskCtx], pixmap : SubPixmap) -> Unit {
  let clip = ScreenIntRect::{ x: 0, y: 0, width: pixmap.width, height: pixmap.height }
  match RasterPipelineBlitter::new(paint, mask, pixmap) {
    Some(b) => {
      let bl = Blitter::Raster(b)
      if paint.anti_alias {
        hairline_aa_stroke_path(path, line_cap, clip, bl)
      } else {
        hairline_stroke_path(path, line_cap, clip, bl)
      }
    }
    None => ()
  }
}

/// The coverage a stroke this thin is drawn as a hairline with, None where it is not one.
fn treat_as_hairline(paint : Paint, stroke : Stroke, ts_in : Transform) -> Option[Float] {
  let fast_len = fn(p : Point) -> Float {
    let mut x = p.x.abs()
    let mut y = p.y.abs()
    if x < y {
      let t = x
      x = y
      y = t
    }
    x + half(y)
  }
  if stroke.width == 0.0f {
    return Some(1.0f)
  }
  if !paint.anti_alias {
    return None
  }
  let ts = Transform::{ sx: ts_in.sx, kx: ts_in.kx, ky: ts_in.ky, sy: ts_in.sy, tx: 0.0f, ty: 0.0f }
  let p0 = ts.map_point(Point::from_xy(stroke.width, 0.0f))
  let p1 = ts.map_point(Point::from_xy(0.0f, stroke.width))
  let len0 = fast_len(p0)
  let len1 = fast_len(p1)
  if len0 <= 1.0f && len1 <= 1.0f {
    return Some(ave(len0, len1))
  }
  None
}

/// How a pixmap is drawn into another (PixmapPaint).
pub struct PixmapPaint {
  pub mut opacity : Float
  pub mut blend_mode : BlendMode
  pub mut quality : FilterQuality
}

pub fn PixmapPaint::default() -> PixmapPaint {
  PixmapPaint::{ opacity: 1.0f, blend_mode: BlendMode::SourceOver, quality: FilterQuality::Nearest }
}

/// Draws `pixmap` at (x, y) under `transform` (Pixmap::draw_pixmap).
pub fn Pixmap::draw_pixmap(
  self : Pixmap,
  x : Int,
  y : Int,
  pixmap : Pixmap,
  paint : PixmapPaint,
  transform : Transform,
  mask : Option[Mask],
) -> Unit {
  let rect = pixmap.size().to_int_rect(x, y).to_rect()
  let patt_transform = Transform::from_translate(fi(x), fi(y))
  let p = Paint::{
    shader: Pattern::new(pixmap, SpreadMode::Pad, paint.quality, paint.opacity, patt_transform),
    blend_mode: paint.blend_mode,
    anti_alias: false,
    force_hq_pipeline: false,
    colorspace: ColorSpace::Linear,
  }
  self.fill_rect(rect, p, transform, mask)
}

/// The pixmap times `mask` (Pixmap::apply_mask).
pub fn Pixmap::apply_mask(self : Pixmap, mask : Mask) -> Unit {
  if self.width != mask.width || self.height != mask.height {
    return
  }
  let p = RasterPipelineBuilder::new()
  p.push(Stage::LoadMaskU8)
  p.push(Stage::LoadDestination)
  p.push(Stage::StDestinationIn)
  p.push(Stage::Store)
  let rp = p.compile()
  let rect = self.size().to_screen_int_rect(0, 0)
  rp.run(rect, aa_mask_none(), mask.mask_ctx(), empty_src(), self.as_subpixmap())
}
