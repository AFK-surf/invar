///|
fn RasterPipelineBlitter::new(paint : Paint, mask : Option[MaskCtx], pixmap : SubPixmap) -> Option[RasterPipelineBlitter] {
  match paint.blend_mode {
    BlendMode::Destination => return Option::None
    BlendMode::DestinationIn if paint.shader.is_opaque() && paint.is_solid_color() => return Option::None
    _ => ()
  }
  if !paint.shader.is_valid() {
    return Option::None
  }
  let mut blend_mode = paint.blend_mode
  if paint.shader.is_opaque() && blend_mode == BlendMode::SourceOver && mask is Option::None {
    blend_mode = BlendMode::Source
  }
  let mut memset2d_color : Option[PremultipliedColorU8] = Option::None
  if paint.is_solid_color() && blend_mode == BlendMode::Source && mask is Option::None {
    match paint.shader {
      Shader::SolidColor(color) => memset2d_color = Some(color.premultiply().to_color_u8())
      _ => ()
    }
  }
  if blend_mode == BlendMode::Clear && !paint.anti_alias && mask is Option::None {
    blend_mode = BlendMode::Source
    memset2d_color = Some(PremultipliedColorU8::{ r: 0, g: 0, b: 0, a: 0 })
  }
  let pixmap_src = match paint.shader {
    Shader::PatternShader(patt) => patt.pixmap
    _ => empty_src
  }
  Some(RasterPipelineBlitter::{
    paint: paint,
    blend_mode: blend_mode,
    mask: mask,
    pixmap_src: pixmap_src,
    pixmap: pixmap,
    memset2d_color: memset2d_color,
    blit_anti_h_rp: Option::None,
    blit_rect_rp: Option::None,
    blit_mask_rp: Option::None,
    scratch: Option::None,
    is_mask: false,
  })
}

///|
fn RasterPipelineBlitter::new_mask(pixmap : SubPixmap) -> RasterPipelineBlitter {
  let color = color_white.premultiply()
  RasterPipelineBlitter::{
    paint: Paint::default(),
    blend_mode: BlendMode::Source,
    mask: Option::None,
    pixmap_src: empty_src,
    pixmap: pixmap,
    memset2d_color: Some(color.to_color_u8()),
    blit_anti_h_rp: Option::None,
    blit_rect_rp: Option::None,
    blit_mask_rp: Option::None,
    scratch: Option::None,
    is_mask: true,
  }
}

///|
fn RasterPipelineBlitter::get_scratch(self : RasterPipelineBlitter) -> PipelineScratch {
  match self.scratch {
    Some(s) => s
    Option::None => {
      let s = PipelineScratch::new()
      self.scratch = Some(s)
      s
    }
  }
}

///|
fn RasterPipelineBlitter::mask_ctx(self : RasterPipelineBlitter) -> MaskCtx {
  match self.mask {
    Some(m) => m
    Option::None => mask_none
  }
}

///|
fn RasterPipelineBlitter::blit_mask(self : RasterPipelineBlitter, image : (Int, Int), bounds : ScreenIntRect, row_bytes : Int, clip : ScreenIntRect) -> Unit {
  let aa : AAMaskCtx = AAMaskCtx::{ p0: image.0, p1: image.1, stride: row_bytes, shift: bounds.x + bounds.y * row_bytes }
  self.get_mask_rp().run(clip, aa, self.mask_ctx(), self.pixmap_src, self.pixmap, self.get_scratch())
}

///|
fn RasterPipelineBlitter::blit_h(self : RasterPipelineBlitter, x : Int, y : Int, width : Int) -> Unit {
  self.blit_rect(ScreenIntRect::{ x: x, y: y, width: width, height: 1 })
}

///|
fn RasterPipelineBlitter::blit_anti_h(self : RasterPipelineBlitter, x : Int, y : Int, aa : FixedArray[Int], runs : FixedArray[Int]) -> Unit {
  let mask_ctx = self.mask_ctx()
  let mut x = x
  let mut offset = 0
  let mut run = runs[0]
  while run != 0 {
    let width = run
    match aa[offset] {
      0 => ()
      255 => self.blit_h(x, y, width)
      alpha => {
        let rp = self.get_anti_h_rp()
        rp.ctx.current_coverage = fi(alpha) * (1.0 / 255.0)
        rp.run(ScreenIntRect::{ x: x, y: y, width: width, height: 1 }, aa_mask_none, mask_ctx, self.pixmap_src, self.pixmap, self.get_scratch())
      }
    }
    x += width
    offset += run
    run = runs[offset]
  }
}

///|
fn RasterPipelineBlitter::blit_v(self : RasterPipelineBlitter, x : Int, y : Int, height : Int, alpha : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 1, height: height }
  self.blit_mask((alpha, alpha), bounds, 0, bounds)
}

///|
fn RasterPipelineBlitter::blit_anti_h2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 2, height: 1 }
  self.blit_mask((alpha0, alpha1), bounds, 2, bounds)
}

///|
fn RasterPipelineBlitter::blit_anti_v2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 1, height: 2 }
  self.blit_mask((alpha0, alpha1), bounds, 1, bounds)
}

///|
fn RasterPipelineBlitter::blit_rect(self : RasterPipelineBlitter, rect : ScreenIntRect) -> Unit {
  match self.memset2d_color {
    Some(c) => {
      let d = self.pixmap.data
      let rb = c.r.to_byte()
      let gb = c.g.to_byte()
      let bb = c.b.to_byte()
      let ab = c.a.to_byte()
      for y in 0..<rect.height {
        let start = self.pixmap.offset_at(rect.x, rect.y + y)
        if self.is_mask {
          for i in start..<(start + rect.width) {
            d[i] = ab
          }
        } else {
          let mut o = start * 4
          let end_o = o + rect.width * 4
          while o < end_o {
            d[o] = rb
            d[o + 1] = gb
            d[o + 2] = bb
            d[o + 3] = ab
            o += 4
          }
        }
      }
    }
    Option::None => self.get_rect_rp().run(rect, aa_mask_none, self.mask_ctx(), self.pixmap_src, self.pixmap, self.get_scratch())
  }
}

