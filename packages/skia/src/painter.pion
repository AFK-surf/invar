// tiny-skia's painting: paints, the blitter that runs a paint's pipeline
// over spans, and filling, stroking and drawing into a pixmap.

///|
pub struct Paint {
  pub mut shader : Shader
  pub mut blend_mode : BlendMode
  pub mut anti_alias : Bool
  pub mut colorspace : ColorSpace
  pub mut force_hq_pipeline : Bool
}

///|
pub fn Paint::default() -> Paint {
  Paint::{ shader: Shader::SolidColor(color_black), blend_mode: BlendMode::SourceOver, anti_alias: true, colorspace: ColorSpace::Linear, force_hq_pipeline: false }
}

///|
pub fn Paint::set_color(self : Paint, color : Color) -> Unit {
  self.shader = Shader::SolidColor(color)
}

///|
pub fn Paint::set_color_rgba8(self : Paint, r : Int, g : Int, b : Int, a : Int) -> Unit {
  self.set_color(Color::from_rgba8(r, g, b, a))
}

///|
pub fn Paint::is_solid_color(self : Paint) -> Bool {
  self.shader is Shader::SolidColor(_)
}

///|
struct RasterPipelineBlitter {
  mask : Option[MaskCtx]
  pixmap_src : Pixmap
  pixmap : SubPixmap
  memset2d_color : Option[PremultipliedColorU8]
  blit_anti_h_rp : RasterPipeline
  blit_rect_rp : RasterPipeline
  blit_mask_rp : RasterPipeline
  is_mask : Bool
}

///|
// moved to 00_init_order.pion: empty_src

///|
fn RasterPipelineBlitter::new(paint : Paint, mask : Option[MaskCtx], pixmap : SubPixmap) -> Option[RasterPipelineBlitter] {
  match paint.blend_mode {
    BlendMode::Destination => return Option::None
    BlendMode::DestinationIn if paint.shader.is_opaque() && paint.is_solid_color() => return Option::None
    _ => ()
  }
  let mut blend_mode = paint.blend_mode
  if paint.shader.is_opaque() && blend_mode == SourceOver && mask is Option::None {
    blend_mode = Source
  }
  let mut memset2d_color : Option[PremultipliedColorU8] = Option::None
  if paint.is_solid_color() && blend_mode == Source && mask is Option::None {
    match paint.shader {
      Shader::SolidColor(color) => memset2d_color = Option::Some(color.premultiply().to_color_u8())
      _ => ()
    }
  }
  if blend_mode == Clear && !paint.anti_alias && mask is Option::None {
    blend_mode = Source
    memset2d_color = Option::Some({ r: 0, g: 0, b: 0, a: 0 })
  }
  let cs = paint.colorspace
  let push_opt = fn(p : RasterPipelineBuilder, s : Option[Stage]) {
    match s {
      Some(s) => p.push(s)
      Option::None => ()
    }
  }
  let new_builder = fn() {
    let p = RasterPipelineBuilder::new()
    p.force_hq_pipeline = paint.force_hq_pipeline
    p
  }
  let p = new_builder()
  if !paint.shader.push_stages(cs, p) {
    return Option::None
  }
  if mask is Some(_) {
    p.push(.MaskU8)
  }
  if blend_mode.should_pre_scale_coverage() {
    p.push(.Scale1Float)
    p.push(.LoadDestination)
    push_opt(p, cs.expand_dest_stage())
    push_opt(p, blend_mode.to_stage())
  } else {
    p.push(.LoadDestination)
    push_opt(p, cs.expand_dest_stage())
    push_opt(p, blend_mode.to_stage())
    p.push(.Lerp1Float)
  }
  push_opt(p, cs.compress_stage())
  p.push(.Store)
  let blit_anti_h_rp = p.compile()
  let p = new_builder()
  if !paint.shader.push_stages(cs, p) {
    return Option::None
  }
  if mask is Some(_) {
    p.push(.MaskU8)
  }
  if blend_mode == SourceOver && mask is Option::None {
    push_opt(p, cs.compress_stage())
    p.push(.SourceOverRgba)
  } else {
    if blend_mode != Source {
      p.push(.LoadDestination)
      match blend_mode.to_stage() {
        Some(bs) => {
          push_opt(p, cs.expand_dest_stage())
          p.push(bs)
        }
        None => ()
      }
    }
    push_opt(p, cs.compress_stage())
    p.push(.Store)
  }
  let blit_rect_rp = p.compile()
  let p = new_builder()
  if !paint.shader.push_stages(cs, p) {
    return Option::None
  }
  if mask is Some(_) {
    p.push(.MaskU8)
  }
  if blend_mode.should_pre_scale_coverage() {
    p.push(.ScaleU8)
    p.push(.LoadDestination)
    push_opt(p, cs.expand_dest_stage())
    push_opt(p, blend_mode.to_stage())
  } else {
    p.push(.LoadDestination)
    push_opt(p, cs.expand_dest_stage())
    push_opt(p, blend_mode.to_stage())
    p.push(.LerpU8)
  }
  push_opt(p, cs.compress_stage())
  p.push(.Store)
  let blit_mask_rp = p.compile()
  let pixmap_src = match paint.shader {
    Shader::PatternShader(patt) => patt.pixmap
    _ => empty_src
  }
  Option::Some(RasterPipelineBlitter::{ mask: mask, pixmap_src: pixmap_src, pixmap: pixmap, memset2d_color: memset2d_color, blit_anti_h_rp: blit_anti_h_rp, blit_rect_rp: blit_rect_rp, blit_mask_rp: blit_mask_rp, is_mask: false })
}

///|
fn RasterPipelineBlitter::new_mask(pixmap : SubPixmap) -> RasterPipelineBlitter {
  let color = color_white.premultiply()
  let p = RasterPipelineBuilder::new()
  p.push_uniform_color(color)
  p.push(.LoadDestinationU8)
  p.push(.Lerp1Float)
  p.push(.StoreU8)
  let blit_anti_h_rp = p.compile()
  let p = RasterPipelineBuilder::new()
  p.push_uniform_color(color)
  p.push(.StoreU8)
  let blit_rect_rp = p.compile()
  let p = RasterPipelineBuilder::new()
  p.push_uniform_color(color)
  p.push(.LoadDestinationU8)
  p.push(.LerpU8)
  p.push(.StoreU8)
  let blit_mask_rp = p.compile()
  RasterPipelineBlitter::{
    mask: Option::None,
    pixmap_src: empty_src,
    pixmap: pixmap,
    memset2d_color: Option::Some(color.to_color_u8()),
    blit_anti_h_rp: blit_anti_h_rp,
    blit_rect_rp: blit_rect_rp,
    blit_mask_rp: blit_mask_rp,
    is_mask: true,
  }
}

///|
fn RasterPipelineBlitter::mask_ctx(self : RasterPipelineBlitter) -> MaskCtx {
  match self.mask {
    Some(m) => m
    Option::None => mask_none
  }
}

///|
fn RasterPipelineBlitter::blit_mask(self : RasterPipelineBlitter, image : (Int, Int), bounds : ScreenIntRect, row_bytes : Int, clip : ScreenIntRect) -> Unit {
  let aa : AAMaskCtx = AAMaskCtx::{ p0: image.0, p1: image.1, stride: row_bytes, shift: bounds.x + bounds.y * row_bytes }
  self.blit_mask_rp.run(clip, aa, self.mask_ctx(), self.pixmap_src, self.pixmap)
}

///|
fn RasterPipelineBlitter::blit_h(self : RasterPipelineBlitter, x : Int, y : Int, width : Int) -> Unit {
  self.blit_rect(ScreenIntRect::{ x: x, y: y, width: width, height: 1 })
}

///|
fn RasterPipelineBlitter::blit_anti_h(self : RasterPipelineBlitter, x : Int, y : Int, aa : FixedArray[Int], runs : FixedArray[Int]) -> Unit {
  let mask_ctx = self.mask_ctx()
  let mut x = x
  let mut offset = 0
  let mut run = runs[0]
  while run != 0 {
    let width = run
    match aa[offset] {
      0 => ()
      255 => self.blit_h(x, y, width)
      alpha => {
        self.blit_anti_h_rp.ctx.current_coverage = fi(alpha) * (1.0 / 255.0)
        self.blit_anti_h_rp.run({ x: x, y: y, width: width, height: 1 }, aa_mask_none, mask_ctx, self.pixmap_src, self.pixmap)
      }
    }
    x += width
    offset += run
    run = runs[offset]
  }
}

///|
fn RasterPipelineBlitter::blit_v(self : RasterPipelineBlitter, x : Int, y : Int, height : Int, alpha : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 1, height: height }
  self.blit_mask((alpha, alpha), bounds, 0, bounds)
}

///|
fn RasterPipelineBlitter::blit_anti_h2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 2, height: 1 }
  self.blit_mask((alpha0, alpha1), bounds, 2, bounds)
}

///|
fn RasterPipelineBlitter::blit_anti_v2(self : RasterPipelineBlitter, x : Int, y : Int, alpha0 : Int, alpha1 : Int) -> Unit {
  let bounds : ScreenIntRect = ScreenIntRect::{ x: x, y: y, width: 1, height: 2 }
  self.blit_mask((alpha0, alpha1), bounds, 1, bounds)
}

///|
fn RasterPipelineBlitter::blit_rect(self : RasterPipelineBlitter, rect : ScreenIntRect) -> Unit {
  match self.memset2d_color {
    Some(c) => {
      let d = self.pixmap.data
      for y in 0..<rect.height {
        let start = self.pixmap.offset_at(rect.x, rect.y + y)
        if self.is_mask {
          for i in start..<(start + rect.width) {
            d[i] = c.a.to_byte()
          }
        } else {
          for i in start..<(start + rect.width) {
            d[i * 4] = c.r.to_byte()
            d[i * 4 + 1] = c.g.to_byte()
            d[i * 4 + 2] = c.b.to_byte()
            d[i * 4 + 3] = c.a.to_byte()
          }
        }
      }
    }
    Option::None => self.blit_rect_rp.run(rect, aa_mask_none, self.mask_ctx(), self.pixmap_src, self.pixmap)
  }
}

// ── painting ──────────────────────────────────────────────────────────

///|
/// Tiles of at most 8191 pixels a side where a pixmap is larger (DrawTiler), None where it needs none.
fn draw_tiles(w : Int, h : Int) -> Option[Array[ScreenIntRect]] {
  let max = 8192 - 1
  if w <= max && h <= max {
    return Option::None
  }
  let tiles : Array[ScreenIntRect] = []
  let mut x = 0
  let mut y = 0
  while x < w && y < h {
    let th = if h - y < max { h - y } else { max }
    let tw = if w - x < max { w - x } else { max }
    match ScreenIntRect::from_xywh(x, y, tw, th) {
      Some(r) => tiles.push(r)
      None => ()
    }
    x += max
    if x >= w {
      x = 0
      y += max
    }
  }
  Option::Some(tiles)
}

///|
fn is_too_big_for_math(path : Path) -> Bool {
  let max = scalar_max * 0.25
  let b = path.bounds
  !(b.left >= -max && b.top >= -max && b.right <= max && b.bottom <= max)
}

///|
pub fn Pixmap::fill_rect(self : Pixmap, rect : Rect, paint : Paint, transform : Transform, mask : Option[Mask]) -> Unit {
  if transform.is_identity() && draw_tiles(self.width, self.height) is Option::None {
    let clip = self.size().to_screen_int_rect(0, 0)
    let mctx = match mask {
      Some(m) => Some(m.mask_ctx())
      Option::None => None
    }
    match RasterPipelineBlitter::new(paint, mctx, self.as_subpixmap()) {
      Some(b) =>
      if paint.anti_alias {
        fill_rect_aa(rect, clip, .Raster(b))
      } else {
        fill_rect_nonaa(rect, clip, .Raster(b))
      }
      None => ()
    }
  } else {
    self.fill_path(PathBuilder::from_rect(rect), paint, FillRule::Winding, transform, mask)
  }
}

///|
pub fn Pixmap::fill_path(self : Pixmap, path : Path, paint : Paint, fill_rule : FillRule, transform : Transform, mask : Option[Mask]) -> Unit {
  if !transform.is_identity() {
    match path.transform(transform) {
      Some(p) => self.fill_path(p, Paint::{ ..paint, shader: paint.shader.transformed(transform) }, fill_rule, Transform::identity(), mask)
      None => ()
    }
    return
  }
  let b = path.bounds
  if is_nearly_zero(b.width()) || is_nearly_zero(b.height()) {
    return
  }
  if is_too_big_for_math(path) {
    return
  }
  match draw_tiles(self.width, self.height) {
    Some(tiles) => {
      let mut path = path
      let mut paint = paint
      for tile in tiles {
        let ts = Transform::from_translate(-fi(tile.x), -fi(tile.y))
        path = match path.transform(ts) {
          Some(v) => v
          None => return
        }
        paint = Paint::{ ..paint, shader: paint.shader.transformed(ts) }
        let clip_rect = tile.size().to_screen_int_rect(0, 0)
        match self.subpixmap(tile.to_int_rect()) {
          Some(sub) => {
            let submask = match mask {
              Some(m) => m.submask_ctx(tile.to_int_rect())
              Option::None => None
            }
            match RasterPipelineBlitter::new(paint, submask, sub) {
              Some(bl) =>
              if paint.anti_alias {
                fill_path_aa(path, fill_rule, clip_rect, .Raster(bl))
              } else {
                fill_path_nonaa(path, fill_rule, clip_rect, .Raster(bl))
              }
              None => ()
            }
          }
          None => ()
        }
        let ts = Transform::from_translate(fi(tile.x), fi(tile.y))
        path = match path.transform(ts) {
          Some(v) => v
          None => return
        }
        paint = Paint::{ ..paint, shader: paint.shader.transformed(ts) }
      }
    }
    Option::None => {
      let clip_rect = self.size().to_screen_int_rect(0, 0)
      let mctx = match mask {
        Some(m) => Some(m.mask_ctx())
        Option::None => None
      }
      match RasterPipelineBlitter::new(paint, mctx, self.as_subpixmap()) {
        Some(bl) =>
        if paint.anti_alias {
          fill_path_aa(path, fill_rule, clip_rect, .Raster(bl))
        } else {
          fill_path_nonaa(path, fill_rule, clip_rect, .Raster(bl))
        }
        None => ()
      }
    }
  }
}

///|
pub fn Pixmap::stroke_path(self : Pixmap, path : Path, paint : Paint, stroke : Stroke, transform : Transform, mask : Option[Mask]) -> Unit {
  if stroke.width < 0.0 {
    return
  }
  let res_scale = PathStroker::compute_resolution_scale(transform)
  let path = match stroke.dash {
    Some(dash) =>
    match path.dash(dash, res_scale) {
      Some(p) => p
      None => return
    }
    Option::None => path
  }
  match treat_as_hairline(paint, stroke, transform) {
    Some(coverage) => {
      let mut paint = paint
      if coverage == 1.0 {
        ()
      } else if paint.blend_mode.should_pre_scale_coverage() {
        let scale = f2i(coverage * 256.0)
        let new_alpha = (255 * scale) >> 8
        paint = Paint::{ ..paint, shader: paint.shader.with_opacity(fi(new_alpha) / 255.0) }
      }
      match draw_tiles(self.width, self.height) {
        Some(tiles) => {
          let mut path = path
          if !transform.is_identity() {
            paint = Paint::{ ..paint, shader: paint.shader.transformed(transform) }
            path = match path.transform(transform) {
              Some(v) => v
              None => return
            }
          }
          for tile in tiles {
            let ts = Transform::from_translate(-fi(tile.x), -fi(tile.y))
            path = match path.transform(ts) {
              Some(v) => v
              None => return
            }
            paint = Paint::{ ..paint, shader: paint.shader.transformed(ts) }
            match self.subpixmap(tile.to_int_rect()) {
              Some(sub) => {
                let submask = match mask {
                  Some(m) => m.submask_ctx(tile.to_int_rect())
                  Option::None => None
                }
                stroke_hairline_into(path, paint, stroke.line_cap, submask, sub)
              }
              None => ()
            }
            let ts = Transform::from_translate(fi(tile.x), fi(tile.y))
            path = match path.transform(ts) {
              Some(v) => v
              None => return
            }
            paint = Paint::{ ..paint, shader: paint.shader.transformed(ts) }
          }
        }
        Option::None => {
          let mctx = match mask {
            Some(m) => Some(m.mask_ctx())
            Option::None => None
          }
          if !transform.is_identity() {
            paint = Paint::{ ..paint, shader: paint.shader.transformed(transform) }
            match path.transform(transform) {
              Some(p) => stroke_hairline_into(p, paint, stroke.line_cap, mctx, self.as_subpixmap())
              None => ()
            }
          } else {
            stroke_hairline_into(path, paint, stroke.line_cap, mctx, self.as_subpixmap())
          }
        }
      }
    }
    Option::None =>
    match path.stroke(stroke, res_scale) {
      Some(p) => self.fill_path(p, paint, FillRule::Winding, transform, mask)
      None => ()
    }
  }
}

///|
fn stroke_hairline_into(path : Path, paint : Paint, line_cap : LineCap, mask : Option[MaskCtx], pixmap : SubPixmap) -> Unit {
  let clip : ScreenIntRect = ScreenIntRect::{ x: 0, y: 0, width: pixmap.width, height: pixmap.height }
  match RasterPipelineBlitter::new(paint, mask, pixmap) {
    Some(b) =>
    if paint.anti_alias {
      hairline_aa_stroke_path(path, line_cap, clip, .Raster(b))
    } else {
      hairline_stroke_path(path, line_cap, clip, .Raster(b))
    }
    None => ()
  }
}

///|
/// The coverage a stroke this thin is drawn as a hairline with, None where it is not one.
fn treat_as_hairline(paint : Paint, stroke : Stroke, ts : Transform) -> Option[Float] {
  let fast_len = fn(p : Point) -> Float {
    let mut x = p.x.abs()
    let mut y = p.y.abs()
    if x < y {
      let t = x
      x = y
      y = t
    }
    x + half(y)
  }
  if stroke.width == 0.0 {
    return Option::Some(1.0)
  }
  if !paint.anti_alias {
    return Option::None
  }
  let ts = Transform::{ ..ts, tx: 0.0, ty: 0.0 }
  let p0 = ts.map_point(Point::from_xy(stroke.width, 0.0))
  let p1 = ts.map_point(Point::from_xy(0.0, stroke.width))
  let len0 = fast_len(p0)
  let len1 = fast_len(p1)
  if len0 <= 1.0 && len1 <= 1.0 {
    return Option::Some(ave(len0, len1))
  }
  Option::None
}

///|
/// How a pixmap is drawn into another (PixmapPaint).
pub struct PixmapPaint {
  pub mut opacity : Float
  pub mut blend_mode : BlendMode
  pub mut quality : FilterQuality
}

///|
pub fn PixmapPaint::default() -> PixmapPaint {
  PixmapPaint::{ opacity: 1.0, blend_mode: BlendMode::SourceOver, quality: FilterQuality::Nearest }
}

///|
/// Draws `pixmap` at (x, y) under `transform` (Pixmap::draw_pixmap).
pub fn Pixmap::draw_pixmap(self : Pixmap, x : Int, y : Int, pixmap : Pixmap, paint : PixmapPaint, transform : Transform, mask : Option[Mask]) -> Unit {
  let rect = pixmap.size().to_int_rect(x, y).to_rect()
  let patt_transform = Transform::from_translate(fi(x), fi(y))
  let p : Paint = Paint::{
    shader: Pattern::new(pixmap, SpreadMode::Pad, paint.quality, paint.opacity, patt_transform),
    blend_mode: paint.blend_mode,
    anti_alias: false,
    force_hq_pipeline: false,
    colorspace: ColorSpace::Linear,
  }
  self.fill_rect(rect, p, transform, mask)
}

///|
/// The pixmap times `mask` (Pixmap::apply_mask).
pub fn Pixmap::apply_mask(self : Pixmap, mask : Mask) -> Unit {
  if self.width != mask.width || self.height != mask.height {
    return
  }
  let p = RasterPipelineBuilder::new()
  p.push(.LoadMaskU8)
  p.push(.LoadDestination)
  p.push(.StDestinationIn)
  p.push(.Store)
  let rp = p.compile()
  let rect = self.size().to_screen_int_rect(0, 0)
  rp.run(rect, aa_mask_none, mask.mask_ctx(), empty_src, self.as_subpixmap())
}
