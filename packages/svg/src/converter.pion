  let a = fi(c.alpha) / 255.0
  let p = new_simple_path(path)
  p.fill = Some({ let __mbt_su_b_2 : Fill = Fill::default(); Fill::{ paint: .PColor(Rgb::{ r: c.red, g: c.green, b: c.blue }), opacity: a, rule: __mbt_su_b_2.rule, context: __mbt_su_b_2.context } })
  Some(p)
