import "mbt_compat"

// svgtypes 0.16 (what usvg parses attribute values with): a stream over a value's text and its numbers, lengths,
// angles, view boxes, aspect ratios, IRIs and points. Rust's errors are None here.

///|
struct Stream {
  text : String
  mut pos : Int
}

///|
fn Stream::new(text : String) -> Stream {
  Stream::{ text: text, pos: 0 }
}

///|
fn Stream::at_end(self : Stream) -> Bool {
  self.pos >= mbt_compat::utf16_len(self.text)
}

///|
fn Stream::cur(self : Stream) -> Int {
  if self.pos < mbt_compat::utf16_len(self.text) {
    mbt_compat::utf16_code_unit_at(self.text, self.pos).to_int()
  } else {
    -1
  }
}

///|
fn Stream::next_byte(self : Stream) -> Int {
  if self.pos + 1 < mbt_compat::utf16_len(self.text) {
    mbt_compat::utf16_code_unit_at(self.text, self.pos + 1).to_int()
  } else {
    -1
  }
}

///|
fn is_space_b(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D
}

///|
fn is_digit_b(c : Int) -> Bool {
  c >= 0x30 && c <= 0x39
}

///|
fn is_hex_b(c : Int) -> Bool {
  is_digit_b(c) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
}

///|
fn is_ascii_ident_b(c : Int) -> Bool {
  is_digit_b(c) || (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A) || c == 0x2D || c == 0x5F
}

///|
fn Stream::skip_spaces(self : Stream) -> Unit {
  while !self.at_end() && is_space_b(self.cur()) {
    self.pos += 1
  }
}

///|
fn Stream::starts_with(self : Stream, t : String) -> Bool {
  if self.pos + mbt_compat::utf16_len(t) > mbt_compat::utf16_len(self.text) {
    return false
  }
  for i in 0..<mbt_compat::utf16_len(t) {
    if mbt_compat::utf16_code_unit_at(self.text, self.pos + i).to_int() != mbt_compat::utf16_code_unit_at(t, i).to_int() {
      return false
    }
  }
  true
}

///|
fn Stream::is_curr(self : Stream, c : Int) -> Bool {
  !self.at_end() && self.cur() == c
}

///|
fn Stream::consume_byte(self : Stream, c : Int) -> Bool {
  if self.at_end() || self.cur() != c {
    return false
  }
  self.pos += 1
  true
}

///|
fn Stream::consume_string(self : Stream, t : String) -> Bool {
  if self.at_end() || !self.starts_with(t) {
    return false
  }
  self.pos += mbt_compat::utf16_len(t)
  true
}

///|
fn Stream::slice_back(self : Stream, start : Int) -> String {
  mbt_compat::str_to_owned(mbt_compat::str_exact_view(self.text, start=start, end=self.pos))
}

///|
fn Stream::slice_tail(self : Stream) -> String {
  mbt_compat::str_to_owned(mbt_compat::str_exact_view(self.text, start=self.pos))
}

///|
fn Stream::consume_bytes(self : Stream, f : (Int) -> Bool) -> String {
  let start = self.pos
  while !self.at_end() && f(self.cur()) {
    self.pos += 1
  }
  self.slice_back(start)
}

///|
fn Stream::consume_ascii_ident(self : Stream) -> String {
  self.consume_bytes(is_ascii_ident_b)
}

///|
fn is_name_start_c(c : Int) -> Bool {
  c == 0x5F || (c >= 0x61 && c <= 0x7A) || (c >= 0x41 && c <= 0x5A) || is_non_ascii_ident(c)
}

///|
fn is_name_char_c(c : Int) -> Bool {
  is_name_start_c(c) || is_digit_b(c) || c == 0x2D
}

///|
fn is_non_ascii_ident(c : Int) -> Bool {
  c == 0xB7 ||
  (c >= 0xC0 && c <= 0xD6) ||
  (c >= 0xD8 && c <= 0xF6) ||
  (c >= 0xF8 && c <= 0x37D) ||
  (c >= 0x37F && c <= 0x1FFF) ||
  c == 0x200C ||
  c == 0x200D ||
  c == 0x203F ||
  c == 0x2040 ||
  (c >= 0x2070 && c <= 0x218F) ||
  (c >= 0x2C00 && c <= 0x2FEF) ||
  (c >= 0x3001 && c <= 0xD7FF) ||
  (c >= 0xF900 && c <= 0xFDCF) ||
  (c >= 0xFDF0 && c <= 0xFFFD) ||
  // (a surrogate: a code point past U+FFFF)
  (c >= 0xD800 && c <= 0xDFFF)
}

///|
fn Stream::parse_ident(self : Stream) -> Option[String] {
  let start = self.pos
  if self.cur() == 0x2D {
    self.pos += 1
  }
  if !self.at_end() {
    if is_name_start_c(self.cur()) {
      self.pos += 1
    } else {
      return Option::None
    }
  }
  while !self.at_end() && is_name_char_c(self.cur()) {
    self.pos += 1
  }
  if start == self.pos {
    return Option::None
  }
  Some(self.slice_back(start))
}

///|
fn Stream::parse_quoted_string(self : Stream) -> Option[String] {
  let quote = self.cur()
  if quote != 0x27 && quote != 0x22 {
    return Option::None
  }
  let mut prev = quote
  self.pos += 1
  let start = self.pos
  while !self.at_end() {
    let c = self.cur()
    if c == quote && prev != 0x5C {
      break
    }
    prev = c
    self.pos += 1
  }
  let value = self.slice_back(start)
  if !self.consume_byte(quote) {
    return Option::None
  }
  Some(value)
}

///|
fn Stream::parse_list_separator(self : Stream) -> Unit {
  if self.is_curr(0x2C) {
    self.pos += 1
  }
}

///|
fn Stream::skip_digits(self : Stream) -> Unit {
  while !self.at_end() && is_digit_b(self.cur()) {
    self.pos += 1
  }
}

///|
fn Stream::parse_number(self : Stream) -> Option[Double] {
  self.skip_spaces()
  if self.at_end() {
    return Option::None
  }
  let start = self.pos
  let mut c = self.cur()
  if c == 0x2B || c == 0x2D {
    self.pos += 1
    c = self.cur()
  }
  if is_digit_b(c) {
    self.skip_digits()
  } else if c != 0x2E {
    return Option::None
  }
  if self.cur() == 0x2E {
    self.pos += 1
    self.skip_digits()
  }
  let c = self.cur()
  if c == 0x65 || c == 0x45 {
    let c2 = self.next_byte()
    if c2 == -1 {
      return Option::None
    }
    if c2 != 0x6D && c2 != 0x78 {
      self.pos += 1
      let c3 = self.cur()
      if c3 == 0x2B || c3 == 0x2D {
        self.pos += 1
        self.skip_digits()
      } else if is_digit_b(c3) {
        self.skip_digits()
      } else {
        return Option::None
      }
    }
  }
  let s = self.slice_back(start)
  match parse_f64(s) {
    Some(n) => if n.is_nan() || n.is_inf() { Option::None } else { Some(n) }
    Option::None => Option::None
  }
}

///|
/// f64::from_str of what parse_number took: [+-]digits[.digits][e[+-]digits], correctly rounded.
fn parse_f64(s : String) -> Option[Double] {
  if s == "" || s == "+" || s == "-" || s == "." || s == "+." || s == "-." {
    return Option::None
  }
  match mbt_compat::str_try_parse_double(s) { Ok(__mbt_ok_3) => Some(__mbt_ok_3), Err(_) => Option::None }
}

///|
fn Stream::parse_list_number(self : Stream) -> Option[Double] {
  if self.at_end() {
    return Option::None
  }
  let n = self.parse_number()
  if n is Option::None {
    return Option::None
  }
  self.skip_spaces()
  self.parse_list_separator()
  n
}

///|
fn Stream::parse_number_or_percent(self : Stream) -> Option[Double] {
  self.skip_spaces()
  match self.parse_number() {
    Some(n) =>
    if self.starts_with("%") {
      self.pos += 1
      Some(n / 100.0)
    } else {
      Some(n)
    }
    Option::None => Option::None
  }
}

///|
fn Stream::parse_list_number_or_percent(self : Stream) -> Option[Double] {
  if self.at_end() {
    return Option::None
  }
  let l = self.parse_number_or_percent()
  if l is Option::None {
    return Option::None
  }
  self.skip_spaces()
  self.parse_list_separator()
  l
}

///|
/// A whole value as a number (Number::from_str).
fn parse_number_str(text : String) -> Option[Double] {
  let s = Stream::new(text)
  let n = s.parse_number()
  s.skip_spaces()
  if !s.at_end() {
    return Option::None
  }
  n
}

///|
/// The numbers of a list (NumberListParser), stopping at the first that is not one (it is the list's end).
fn parse_number_list(text : String) -> Array[Option[Double]] {
  let s = Stream::new(text)
  let out : Array[Option[Double]] = []
  while !s.at_end() {
    let v = s.parse_list_number()
    out.push(v)
    if v is Option::None {
      s.pos = mbt_compat::utf16_len(s.text)
    }
  }
  out
}

// ── lengths ───────────────────────────────────────────────────────────

///|

#derive(Eq)
pub enum LengthUnit {
  LNone
  Em
  Ex
  Px
  In
  Cm
  Mm
  Pt
  Pc
  Percent
}

///|

#derive(Eq)
pub struct Length {
  pub number : Double
  pub unit : LengthUnit
}

///|
fn Length::zero() -> Length {
  Length::{ number: 0.0, unit: LengthUnit::LNone }
}

///|
fn Stream::parse_length(self : Stream) -> Option[Length] {
  self.skip_spaces()
  let n = match self.parse_number() {
    Some(n) => n
    Option::None => return Option::None
  }
  if self.at_end() {
    return Some(Length::{ number: n, unit: LengthUnit::LNone })
  }
  let u = if self.starts_with("%") {
    Percent
  } else if self.starts_with("em") {
    Em
  } else if self.starts_with("ex") {
    Ex
  } else if self.starts_with("px") {
    Px
  } else if self.starts_with("in") {
    In
  } else if self.starts_with("cm") {
    Cm
  } else if self.starts_with("mm") {
    Mm
  } else if self.starts_with("pt") {
    Pt
  } else if self.starts_with("pc") {
    Pc
  } else {
    LNone
  }
  match u {
    LengthUnit::Percent => self.pos += 1
    LengthUnit::LNone => ()
    _ => self.pos += 2
  }
  Some(Length::{ number: n, unit: u })
}

///|
fn Stream::parse_list_length(self : Stream) -> Option[Length] {
  if self.at_end() {
    return Option::None
  }
  let l = self.parse_length()
  if l is Option::None {
    return Option::None
  }
  self.skip_spaces()
  self.parse_list_separator()
  l
}

///|
fn parse_length_str(text : String) -> Option[Length] {
  let s = Stream::new(text)
  let l = s.parse_length()
  if !s.at_end() {
    return Option::None
  }
  l
}

///|
fn parse_length_list(text : String) -> Array[Option[Length]] {
  let s = Stream::new(text)
  let out : Array[Option[Length]] = []
  while !s.at_end() {
    let v = s.parse_list_length()
    out.push(v)
    if v is Option::None {
      s.pos = mbt_compat::utf16_len(s.text)
    }
  }
  out
}

// ── angles ────────────────────────────────────────────────────────────

///|
fn Stream::parse_angle_degrees(self : Stream) -> Option[Double] {
  self.skip_spaces()
  let n = match self.parse_number() {
    Some(n) => n
    Option::None => return Option::None
  }
  if self.at_end() {
    return Some(n)
  }
  if self.starts_with("deg") {
    self.pos += 3
    Some(n)
  } else if self.starts_with("grad") {
    self.pos += 4
    Some(n * 180.0 / 200.0)
  } else if self.starts_with("rad") {
    self.pos += 3
    Some(n * (180.0 / 3.141592653589793))
  } else if self.starts_with("turn") {
    self.pos += 4
    Some(n * 360.0)
  } else {
    Some(n)
  }
}

///|
fn parse_angle_str(text : String) -> Option[Double] {
  let s = Stream::new(text)
  let a = s.parse_angle_degrees()
  if !s.at_end() {
    return Option::None
  }
  a
}

// ── view boxes and aspect ratios ──────────────────────────────────────

///|
struct ViewBox {
  x : Double
  y : Double
  w : Double
  h : Double
}

///|
fn parse_view_box(text : String) -> Option[ViewBox] {
  let s = Stream::new(text)
  let x = s.parse_list_number()
  let y = s.parse_list_number()
  let w = s.parse_list_number()
  let h = s.parse_list_number()
  match (x, y, w, h) {
    (Some(x), Some(y), Some(w), Some(h)) => if w <= 0.0 || h <= 0.0 { Option::None } else { Some(ViewBox::{ x: x, y: y, w: w, h: h }) }
    _ => Option::None
  }
}

///|

#derive(Eq)
pub enum Align {
  AlignNone
  XMinYMin
  XMidYMin
  XMaxYMin
  XMinYMid
  XMidYMid
  XMaxYMid
  XMinYMax
  XMidYMax
  XMaxYMax
}

///|

#derive(Eq)
pub struct AspectRatio {
  pub deferred : Bool
  pub align : Align
  pub slice : Bool
}

///|
pub fn AspectRatio::default() -> AspectRatio {
  AspectRatio::{ deferred: false, align: Align::XMidYMid, slice: false }
}

///|
fn parse_aspect_ratio(text : String) -> Option[AspectRatio] {
  let s = Stream::new(text)
  s.skip_spaces()
  let deferred = s.starts_with("defer")
  if deferred {
    s.pos += 5
    if !s.consume_byte(0x20) {
      return Option::None
    }
    s.skip_spaces()
  }
  let align = match s.consume_ascii_ident() {
    "none" => AlignNone
    "xMinYMin" => XMinYMin
    "xMidYMin" => XMidYMin
    "xMaxYMin" => XMaxYMin
    "xMinYMid" => XMinYMid
    "xMidYMid" => XMidYMid
    "xMaxYMid" => XMaxYMid
    "xMinYMax" => XMinYMax
    "xMidYMax" => XMidYMax
    "xMaxYMax" => XMaxYMax
    _ => return Option::None
  }
  s.skip_spaces()
  let mut slice = false
  if !s.at_end() {
    match s.consume_ascii_ident() {
      "meet" | "" => ()
      "slice" => slice = true
      _ => return Option::None
    }
  }
  Some(AspectRatio::{ deferred: deferred, align: align, slice: slice })
}

// ── IRIs ──────────────────────────────────────────────────────────────

///|
fn Stream::parse_iri(self : Stream) -> Option[String] {
  self.skip_spaces()
  if !self.consume_byte(0x23) {
    return Option::None
  }
  let link = self.consume_bytes(fn(c) { c != 0x20 })
  if link == "" {
    Option::None
  } else {
    Some(link)
  }
}

///|
fn parse_iri_str(text : String) -> Option[String] {
  let s = Stream::new(text)
  let l = s.parse_iri()
  s.skip_spaces()
  if !s.at_end() {
    return Option::None
  }
  l
}

///|
fn Stream::parse_func_iri(self : Stream) -> Option[String] {
  self.skip_spaces()
  if !self.consume_string("url(") {
    return Option::None
  }
  self.skip_spaces()
  let c = self.cur()
  let quote = if c == 0x27 || c == 0x22 { Some(c) } else { None }
  if quote is Some(_) {
    self.pos += 1
    self.skip_spaces()
  }
  if !self.consume_byte(0x23) {
    return Option::None
  }
  let link = match quote {
    Some(q) => mbt_compat::str_to_owned(mbt_compat::str_trim_end(self.consume_bytes(fn(c) { c != q }), chars=" \t\n\r"))
    Option::None => self.consume_bytes(fn(c) { c != 0x20 && c != 0x29 })
  }
  if link == "" || link.contains("'") || link.contains("\"") {
    return Option::None
  }
  self.skip_spaces()
  match quote {
    Some(q) => {
      if !self.consume_byte(q) {
        return Option::None
      }
      self.skip_spaces()
    }
    Option::None => ()
  }
  if !self.consume_byte(0x29) {
    return Option::None
  }
  Some(link)
}

///|
fn parse_func_iri_str(text : String) -> Option[String] {
  let s = Stream::new(text)
  let l = s.parse_func_iri()
  s.skip_spaces()
  if !s.at_end() {
    return Option::None
  }
  l
}

///|
/// The points of a `points` list (PointsParser), up to the first that is not whole.
fn parse_points(text : String) -> Array[(Double, Double)] {
  let s = Stream::new(text)
  let out : Array[(Double, Double)] = []
  while !s.at_end() {
    let x = match s.parse_list_number() {
      Some(v) => v
      Option::None => break
    }
    let y = match s.parse_list_number() {
      Some(v) => v
      Option::None => break
    }
    out.push((x, y))
  }
  out
}
