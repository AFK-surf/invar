// Shared low-level helpers for packages/svg (UTF-8, IEEE-754 parsing, float/double utils, sorting).

import "dmath"
import "halt"

fn opt_unwrap[T](o : Option[T]) -> T {
  match o {
    Some(v) => v
    None => halt::halt("unwrap None")
  }
}

fn opt_unwrap_or[T](o : Option[T], def : T) -> T {
  match o {
    Some(v) => v
    None => def
  }
}

fn opt_map[T, U](o : Option[T], f : (T) -> U) -> Option[U] {
  match o {
    Some(v) => Some(f(v))
    None => None
  }
}

fn arr_get[T](a : Array[T], i : Int) -> Option[T] {
  if i >= 0 && i < a.length() {
    Some(a[i])
  } else {
    None
  }
}

fn arr_map[T, U](a : Array[T], f : (T) -> U) -> Array[U] {
  let out : Array[U] = []
  for i in 0..<a.length() {
    out.push(f(a[i]))
  }
  out
}

fn arr_makei[T](n : Int, f : (Int) -> T) -> Array[T] {
  let out : Array[T] = []
  for i in 0..<n {
    out.push(f(i))
  }
  out
}

fn arr_append[T](dst : Array[T], src : Array[T]) -> Unit {
  for i in 0..<src.length() {
    dst.push(src[i])
  }
}

fn arr_remove[T](a : Array[T], idx : Int) -> T {
  let v = a[idx]
  let n = a.length()
  let mut i = idx
  while i + 1 < n {
    a[i] = a[i + 1]
    i = i + 1
  }
  let _ = a.pop()
  v
}

fn arr_insert[T](a : Array[T], idx : Int, val_item : T) -> Unit {
  a.push(val_item)
  let mut i = a.length() - 1
  while i > idx {
    a[i] = a[i - 1]
    i = i - 1
  }
  a[idx] = val_item
}

fn arr_filter[T](a : Array[T], pred : (T) -> Bool) -> Array[T] {
  let out : Array[T] = []
  for i in 0..<a.length() {
    if pred(a[i]) {
      out.push(a[i])
    }
  }
  out
}

fn arr_any[T](a : Array[T], pred : (T) -> Bool) -> Bool {
  for i in 0..<a.length() {
    if pred(a[i]) {
      return true
    }
  }
  false
}

fn arr_contains_str(a : Array[String], s : String) -> Bool {
  for i in 0..<a.length() {
    if a[i] == s {
      return true
    }
  }
  false
}

fn arr_contains_int(a : Array[Int], v : Int) -> Bool {
  for i in 0..<a.length() {
    if a[i] == v {
      return true
    }
  }
  false
}

fn f_is_inf(x : Float) -> Bool {
  (x.reinterpret_as_uint() & 0x7FFFFFFFU) == 0x7F800000U
}

fn f32_from_double(d : Double) -> Float {
  d.to_float()
}

fn f32_from_int(i : Int) -> Float {
  i.to_float()
}

fn d_from_int(i : Int) -> Double {
  i.to_double()
}

fn utf8_encode_str(s : String) -> Bytes {
  s.to_bytes()
}

fn d_pos_inf() -> Double {
  dmath::inf()
}

fn d_neg_inf() -> Double {
  dmath::neg_inf()
}

fn f_pos_inf() -> Float {
  dmath::inf().to_float()
}

fn f_neg_inf() -> Float {
  dmath::neg_inf().to_float()
}

fn f_is_nan(x : Float) -> Bool {
  x != x
}

fn f_is_finite(x : Float) -> Bool {
  (x.reinterpret_as_uint() & 0x7F800000U) != 0x7F800000U
}

fn d_is_nan(x : Double) -> Bool {
  x != x
}

fn d_is_inf(x : Double) -> Bool {
  dmath::is_inf(x)
}

fn d_is_finite(x : Double) -> Bool {
  !d_is_nan(x) && !d_is_inf(x)
}

fn f_min(a : Float, b : Float) -> Float {
  if f_is_nan(a) { b } else if f_is_nan(b) { a } else if a < b { a } else { b }
}

fn f_max(a : Float, b : Float) -> Float {
  if f_is_nan(a) { b } else if f_is_nan(b) { a } else if a > b { a } else { b }
}

fn d_min(a : Double, b : Double) -> Double {
  dmath::min(a, b)
}

fn d_max(a : Double, b : Double) -> Double {
  dmath::max(a, b)
}

fn i_min(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

fn i_max(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

fn f_floor(x : Float) -> Float {
  dmath::floor(x.to_double()).to_float()
}

fn f_ceil(x : Float) -> Float {
  dmath::ceil(x.to_double()).to_float()
}

fn f_round(x : Float) -> Float {
  dmath::round(x.to_double()).to_float()
}

fn f_sqrt(x : Float) -> Float {
  dmath::sqrt(x.to_double()).to_float()
}

fn f_abs(x : Float) -> Float {
  x.abs()
}

fn d_floor(x : Double) -> Double {
  dmath::floor(x)
}

fn d_ceil(x : Double) -> Double {
  dmath::ceil(x)
}

fn d_round(x : Double) -> Double {
  dmath::round(x)
}

fn d_sqrt(x : Double) -> Double {
  dmath::sqrt(x)
}

fn d_abs(x : Double) -> Double {
  x.abs()
}

/// Validate UTF-8 bytes and decode to a Pion String (which is UTF-8).
fn utf8_decode(data : Bytes) -> Option[String] {
  let n = data.length()
  let mut i = 0
  while i < n {
    let b0 = data[i].to_int()
    if b0 < 0x80 {
      i = i + 1
    } else if (b0 & 0xE0) == 0xC0 {
      if i + 1 >= n {
        return None
      }
      let b1 = data[i + 1].to_int()
      if (b1 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F)
      if cp < 0x80 {
        return None
      }
      i = i + 2
    } else if (b0 & 0xF0) == 0xE0 {
      if i + 2 >= n {
        return None
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
      if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
        return None
      }
      i = i + 3
    } else if (b0 & 0xF8) == 0xF0 {
      if i + 3 >= n {
        return None
      }
      let b1 = data[i + 1].to_int()
      let b2 = data[i + 2].to_int()
      let b3 = data[i + 3].to_int()
      if (b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80 {
        return None
      }
      let cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
      if cp < 0x10000 || cp > 0x10FFFF {
        return None
      }
      i = i + 4
    } else {
      return None
    }
  }
  let sb = StringBuilder::new()
  let mut j = 0
  while j < n {
    sb.write_byte(data[j])
    j = j + 1
  }
  Some(sb.to_string())
}

/// Write a Unicode code point as UTF-8 into a StringBuilder.
fn sb_write_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp < 0x80 {
    sb.write_byte(cp.to_byte())
  } else if cp < 0x800 {
    sb.write_byte((0xC0 | (cp >> 6)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else if cp < 0x10000 {
    sb.write_byte((0xE0 | (cp >> 12)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  } else {
    sb.write_byte((0xF0 | (cp >> 18)).to_byte())
    sb.write_byte((0x80 | ((cp >> 12) & 0x3F)).to_byte())
    sb.write_byte((0x80 | ((cp >> 6) & 0x3F)).to_byte())
    sb.write_byte((0x80 | (cp & 0x3F)).to_byte())
  }
}

/// Decode one UTF-8 code point at byte index `i` in `s`, returning (cp, next_index).
fn utf8_next_cp(s : String, i : Int) -> (Int, Int) {
  let n = s.length()
  let b0 = s.code_unit_at(i)
  if b0 < 0x80 {
    (b0, i + 1)
  } else if (b0 & 0xE0) == 0xC0 && i + 1 < n {
    let b1 = s.code_unit_at(i + 1)
    (((b0 & 0x1F) << 6) | (b1 & 0x3F), i + 2)
  } else if (b0 & 0xF0) == 0xE0 && i + 2 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), i + 3)
  } else if (b0 & 0xF8) == 0xF0 && i + 3 < n {
    let b1 = s.code_unit_at(i + 1)
    let b2 = s.code_unit_at(i + 2)
    let b3 = s.code_unit_at(i + 3)
    (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), i + 4)
  } else {
    (0xFFFD, i + 1)
  }
}

/// Decode all Unicode code points of a UTF-8 String.
fn string_to_codepoints(s : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    let (cp, next) = utf8_next_cp(s, i)
    out.push(cp)
    i = next
  }
  out
}

/// Parse a decimal floating-point number (matching SVG / CSS / Strtod syntax).
fn parse_double_opt(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  let c0 = s.code_unit_at(i)
  if c0 == 45 { // '-'
    neg = true
    i = i + 1
  } else if c0 == 43 { // '+'
    i = i + 1
  }
  if i >= n {
    return None
  }
  let mut mantissa = 0.0
  let mut digits = 0
  let mut frac_digits = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 48 && c <= 57 {
      mantissa = mantissa * 10.0 + (c - 48).to_double()
      digits = digits + 1
      i = i + 1
    } else {
      break
    }
  }
  if i < n && s.code_unit_at(i) == 46 { // '.'
    i = i + 1
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        mantissa = mantissa * 10.0 + (c - 48).to_double()
        digits = digits + 1
        frac_digits = frac_digits + 1
        i = i + 1
      } else {
        break
      }
    }
  }
  if digits == 0 {
    return None
  }
  let mut exp = 0
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) { // 'e' or 'E'
    i = i + 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i = i + 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i = i + 1
    }
    let mut exp_digits = 0
    while i < n {
      let c = s.code_unit_at(i)
      if c >= 48 && c <= 57 {
        if exp < 10000 {
          exp = exp * 10 + (c - 48)
        }
        exp_digits = exp_digits + 1
        i = i + 1
      } else {
        break
      }
    }
    if exp_digits == 0 {
      return None
    }
    if exp_neg {
      exp = -exp
    }
  }
  if i != n {
    return None
  }
  let total_exp = exp - frac_digits
  let num_val = if total_exp == 0 {
    mantissa
  } else if total_exp > 0 {
    if total_exp > 308 {
      dmath::inf()
    } else {
      mantissa * dmath::pow(10.0, total_exp.to_double())
    }
  } else {
    let pe = -total_exp
    if pe > 325 {
      0.0
    } else if pe > 300 {
      mantissa / dmath::pow(10.0, 300.0) / dmath::pow(10.0, (pe - 300).to_double())
    } else {
      mantissa / dmath::pow(10.0, pe.to_double())
    }
  }
  Some(if neg { -num_val } else { num_val })
}

/// Convert Bytes to FixedArray[Byte].
fn bytes_to_fixed(b : Bytes) -> FixedArray[Byte] {
  let n = b.length()
  let out = FixedArray::make(n, 0 as Byte)
  for i in 0..<n {
    out[i] = b[i]
  }
  out
}

/// Convert Array[Byte] to Bytes.
fn byte_array_to_bytes(arr : Array[Byte]) -> Bytes {
  let sb = StringBuilder::new()
  for i in 0..<arr.length() {
    sb.write_byte(arr[i])
  }
  sb.to_string().to_bytes()
}

/// String substring [start, end).
fn str_sub(s : String, start : Int, end : Int) -> String {
  s.slice(start, end)
}

/// Check if string `s` starts with `prefix`.
fn str_starts_with(s : String, prefix : String) -> Bool {
  let pn = prefix.length()
  if pn > s.length() {
    return false
  }
  for i in 0..<pn {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
  }
  true
}

/// Check if string `s` ends with `suffix`.
fn str_ends_with(s : String, suffix : String) -> Bool {
  let sn = suffix.length()
  let n = s.length()
  if sn > n {
    return false
  }
  let off = n - sn
  for i in 0..<sn {
    if s.code_unit_at(off + i) != suffix.code_unit_at(i) {
      return false
    }
  }
  true
}

/// Check if string `s` contains `sub`.
fn str_contains(s : String, sub : String) -> Bool {
  let sn = sub.length()
  let n = s.length()
  if sn == 0 {
    return true
  }
  if sn > n {
    return false
  }
  let limit = n - sn + 1
  for i in 0..<limit {
    let mut ok = true
    for j in 0..<sn {
      if s.code_unit_at(i + j) != sub.code_unit_at(j) {
        ok = false
        break
      }
    }
    if ok {
      return true
    }
  }
  false
}

/// ASCII lowercase.
fn str_to_ascii_lower(s : String) -> String {
  let n = s.length()
  let sb = StringBuilder::new()
  for i in 0..<n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32).to_byte())
    } else {
      sb.write_byte(c.to_byte())
    }
  }
  sb.to_string()
}

/// Stable insertion/merge sort for Array[T] by comparator returning < 0, 0, > 0.
fn sort_by[T](arr : Array[T], cmp : (T, T) -> Int) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && cmp(arr[j], key) > 0 {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

/// Build a String Set (Map[String, Bool]) from an array of strings.
fn str_set_from(items : Array[String]) -> Map[String, Bool] {
  let m : Map[String, Bool] = Map::new()
  for i in 0..<items.length() {
    m.set(items[i], true)
  }
  m
}

fn str_set_contains(m : Map[String, Bool], k : String) -> Bool {
  match m.get(k) {
    Some(_) => true
    None => false
  }
}

fn opt_eq_str(a : Option[String], b : Option[String]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y
    (None, None) => true
    _ => false
  }
}

fn opt_eq_str_val(a : Option[String], b : String) -> Bool {
  match a {
    Some(x) => x == b
    None => false
  }
}

fn str_find(s : String, sub : String) -> Option[Int] {
  let sn = sub.length()
  let n = s.length()
  if sn == 0 {
    return Some(0)
  }
  if sn > n {
    return None
  }
  let limit = n - sn + 1
  for i in 0..<limit {
    let mut ok = true
    for j in 0..<sn {
      if s.code_unit_at(i + j) != sub.code_unit_at(j) {
        ok = false
        break
      }
    }
    if ok {
      return Some(i)
    }
  }
  None
}

fn str_rev_find(s : String, sub : String) -> Option[Int] {
  let sn = sub.length()
  let n = s.length()
  if sn == 0 {
    return Some(n)
  }
  if sn > n {
    return None
  }
  let mut i = n - sn
  while i >= 0 {
    let mut ok = true
    for j in 0..<sn {
      if s.code_unit_at(i + j) != sub.code_unit_at(j) {
        ok = false
        break
      }
    }
    if ok {
      return Some(i)
    }
    i = i - 1
  }
  None
}

fn str_is_space_char(c : Int, chars : String) -> Bool {
  for i in 0..<chars.length() {
    if chars.code_unit_at(i) == c {
      return true
    }
  }
  false
}

fn str_trim_chars(s : String, chars : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n && str_is_space_char(s.code_unit_at(a), chars) {
    a = a + 1
  }
  let mut b = n
  while b > a && str_is_space_char(s.code_unit_at(b - 1), chars) {
    b = b - 1
  }
  s.slice(a, b)
}

fn str_trim_end_chars(s : String, chars : String) -> String {
  let mut b = s.length()
  while b > 0 && str_is_space_char(s.code_unit_at(b - 1), chars) {
    b = b - 1
  }
  s.slice(0, b)
}

fn str_trim_css_ws(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n {
    let c = s.code_unit_at(a)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = n
  while b > a {
    let c = s.code_unit_at(b - 1)
    if c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D || c == 0x0C {
      b = b - 1
    } else {
      break
    }
  }
  s.slice(a, b)
}

fn str_split_sep(s : String, sep : String) -> Array[String] {
  let out : Array[String] = []
  let sn = sep.length()
  let n = s.length()
  if sn == 0 {
    out.push(s)
    return out
  }
  let mut start = 0
  let mut i = 0
  while i + sn <= n {
    let mut matched = true
    for j in 0..<sn {
      if s.code_unit_at(i + j) != sep.code_unit_at(j) {
        matched = false
        break
      }
    }
    if matched {
      out.push(s.slice(start, i))
      i = i + sn
      start = i
    } else {
      i = i + 1
    }
  }
  out.push(s.slice(start, n))
  out
}

fn str_replace_all(s : String, old : String, rep : String) -> String {
  let parts = str_split_sep(s, old)
  let sb = StringBuilder::new()
  for i in 0..<parts.length() {
    if i > 0 {
      sb.write_string(rep)
    }
    sb.write_string(parts[i])
  }
  sb.to_string()
}
