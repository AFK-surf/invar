      FontFamily::FSerif => logger.write_string("FSerif")
      FontFamily::FSansSerif => logger.write_string("FSansSerif")
      FontFamily::FCursive => logger.write_string("FCursive")
      FontFamily::FFantasy => logger.write_string("FFantasy")
      FontFamily::FMonospace => logger.write_string("FMonospace")
