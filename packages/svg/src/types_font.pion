// svgtypes' font families and the `font` shorthand.

#derive(Eq)
pub enum FontFamily {
  FSerif
  FSansSerif
  FCursive
  FFantasy
  FMonospace
  FNamed(String)
}

/// As a font's key says it (SFont::key): what `derive(Show)` wrote, a name as its text.
pub fn font_family_to_string(f : FontFamily) -> String {
  match f {
    FontFamily::FSerif => "FSerif"
    FontFamily::FSansSerif => "FSansSerif"
    FontFamily::FCursive => "FCursive"
    FontFamily::FFantasy => "FFantasy"
    FontFamily::FMonospace => "FMonospace"
    FontFamily::FNamed(name) => "FNamed(" + name + ")"
  }
}

fn Stream::parse_font_families(self : Stream) -> Option[Array[FontFamily]] {
  let families : Array[FontFamily] = []
  while !self.at_end() {
    self.skip_spaces()
    if self.at_end() {
      return None
    }
    let ch = self.cur()
    let family = if ch == 0x27 || ch == 0x22 {
      match self.parse_quoted_string() {
        Some(r) => FontFamily::FNamed(r)
        None => return None
      }
    } else {
      let idents : Array[String] = []
      while !self.at_end() && self.cur() != 0x2C {
        match self.parse_ident() {
          Some(i) => idents.push(i)
          None => return None
        }
        self.skip_spaces()
      }
      let joined = idents.join(" ")
      match joined {
        "serif" => FontFamily::FSerif
        "sans-serif" => FontFamily::FSansSerif
        "cursive" => FontFamily::FCursive
        "fantasy" => FontFamily::FFantasy
        "monospace" => FontFamily::FMonospace
        _ => FontFamily::FNamed(joined)
      }
    }
    families.push(family)
    if !self.at_end() {
      if self.cur() == 0x2C {
        self.pos += 1
      } else {
        break
      }
    }
  }
  Some(
    arr_filter(families, fn(f : FontFamily) -> Bool {
      match f {
        FontFamily::FNamed(s) => s != ""
        _ => true
      }
    }),
  )
}

fn parse_font_families(text : String) -> Option[Array[FontFamily]] {
  let s = Stream::new(text)
  let r = s.parse_font_families()
  s.skip_spaces()
  if !s.at_end() {
    return None
  }
  r
}

struct FontShorthand {
  font_style : Option[String]
  font_variant : Option[String]
  font_weight : Option[String]
  font_stretch : Option[String]
  font_size : String
  font_family : String
}

fn parse_font_shorthand(text : String) -> Option[FontShorthand] {
  let s = Stream::new(text)
  s.skip_spaces()
  let mut prev_pos = s.pos
  let mut font_style : Option[String] = None
  let mut font_variant : Option[String] = None
  let mut font_weight : Option[String] = None
  let mut font_stretch : Option[String] = None
  for _ in 0..<4 {
    let ident = s.consume_ascii_ident()
    let mut stop = false
    match ident {
      "normal" => ()
      "small-caps" => font_variant = Some(ident)
      "italic" | "oblique" => font_style = Some(ident)
      "bold" | "bolder" | "lighter" | "100" | "200" | "300" | "400" | "500" | "600" | "700" | "800" | "900" =>
        font_weight = Some(ident)
      "ultra-condensed" | "extra-condensed" | "condensed" | "semi-condensed" | "semi-expanded" | "expanded"
      | "extra-expanded" | "ultra-expanded" => font_stretch = Some(ident)
      _ => {
        s.pos = prev_pos
        stop = true
      }
    }
    if stop {
      break
    }
    s.skip_spaces()
    prev_pos = s.pos
  }
  prev_pos = s.pos
  if s.at_end() {
    return None
  }
  if is_digit_b(s.cur()) {
    if (match s.parse_length() { None => true, _ => false }) {
      return None
    }
  } else {
    match s.consume_ascii_ident() {
      "xx-small" | "x-small" | "small" | "medium" | "large" | "x-large" | "xx-large" | "larger" | "smaller" => ()
      _ => return None
    }
  }
  let font_size = s.slice_back(prev_pos)
  s.skip_spaces()
  if s.at_end() {
    return None
  }
  if s.cur() == 0x2F {
    s.pos += 1
    s.skip_spaces()
    if (match s.parse_length() { None => true, _ => false }) {
      return None
    }
    s.skip_spaces()
  }
  if s.at_end() {
    return None
  }
  Some(FontShorthand::{ font_style, font_variant, font_weight, font_stretch, font_size, font_family: s.slice_tail() })
}
