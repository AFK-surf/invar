///|
/// Rust's `x as u8` of a f64 (saturating, NaN 0).
fn d2u8(x : Double) -> Int {
  if x.is_nan() || x <= 0.0 {
    0
  } else if x >= 255.0 {
    255
  } else {
    x.to_int()
  }
}

///|
/// f64::round: half away from zero.
fn dround(x : Double) -> Double {
  if x.is_nan() || x.is_inf() {
    return x
  }
  let t = x.trunc()
  if (x - t).abs() >= 0.5 {
    if x > 0.0 {
      t + 1.0
    } else {
      t - 1.0
    }
  } else {
    t
  }
}

///|
/// f32::round
fn fround32(x : Float) -> Float {
  let t = x.trunc()
  if (x - t).abs() >= 0.5 {
    if x > 0.0 {
      t + 1.0
    } else {
      t - 1.0
    }
  } else {
    t
  }
}

///|
fn f2u8_32(x : Float) -> Int {
  if x.is_nan() || x <= 0.0 {
    0
  } else if x >= 255.0 {
    255
  } else {
    x.to_int()
  }
}

///|
fn rgb_f32(r : Float, g : Float, b : Float) -> SColor {
  SColor::{ red: f2u8_32(fround32(r * 255.0)), green: f2u8_32(fround32(g * 255.0)), blue: f2u8_32(fround32(b * 255.0)), alpha: 255 }
