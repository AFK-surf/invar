import "skia"

// usvg's paint servers: gradients and patterns, and their units made user space once the
// tree (and so every bounding box) is known.

enum ServerOrColor {
  Server(Paint)
  ServerColor(Rgb, Float)
}

fn convert_paint_server(doc : SDoc, node : Int, state : State, cache : Cache) -> Option[ServerOrColor] {
  match cache.paint.get(doc.element_id(node)) {
    Some(p) => return Some(ServerOrColor::Server(p))
    None => ()
  }
  let paint = match doc.tag(node) {
    "linearGradient" => convert_linear(doc, node, state)
    "radialGradient" => convert_radial(doc, node, state)
    "pattern" => convert_pattern(doc, node, state, cache)
    _ => None
  }
  match paint {
    Some(ServerOrColor::Server(p)) => cache.paint.set(doc.element_id(node), p)
    _ => ()
  }
  paint
}

fn non_empty_id(s : String) -> Option[String] {
  if str_trim_chars(s, " \t\n\r") == "" {
    None
  } else {
    Some(s)
  }
}

fn convert_linear(doc : SDoc, node : Int, state : State) -> Option[ServerOrColor] {
  let _ = match non_empty_id(doc.element_id(node)) {
    Some(v) => v
    None => { return None }
  }
  let stops = match find_gradient_with_stops(doc, node) {
    Some(g) => convert_stops(doc, g)
    None => return None
  }
  if stops.length() < 2 {
    return stops_to_color(stops)
  }
  let units = convert_units(doc, node, "gradientUnits", Units::ObjectBoundingBox)
  let transform = doc.resolve_transform(resolve_attr(doc, node, "gradientTransform"), "gradientTransform", state)
  Some(
    ServerOrColor::Server(
      Paint::PLinear(LinearGradient::{
        x1: resolve_number(doc, node, "x1", units, state, Length::zero()),
        y1: resolve_number(doc, node, "y1", units, state, Length::zero()),
        x2: resolve_number(doc, node, "x2", units, state, Length::{ number: 100.0, unit: LengthUnit::Percent }),
        y2: resolve_number(doc, node, "y2", units, state, Length::zero()),
        base: BaseGradient::{ units, transform, spread: convert_spread_method(doc, node), stops },
      }),
    ),
  )
}

fn convert_radial(doc : SDoc, node : Int, state : State) -> Option[ServerOrColor] {
  let _ = match non_empty_id(doc.element_id(node)) {
    Some(v) => v
    None => { return None }
  }
  let stops = match find_gradient_with_stops(doc, node) {
    Some(g) => convert_stops(doc, g)
    None => return None
  }
  if stops.length() < 2 {
    return stops_to_color(stops)
  }
  let units = convert_units(doc, node, "gradientUnits", Units::ObjectBoundingBox)
  let r = resolve_number(doc, node, "r", units, state, Length::{ number: 50.0, unit: LengthUnit::Percent })
  let fr = resolve_number(doc, node, "fr", units, state, Length::zero())
  if !is_valid_length(r) {
    let stop = stops[stops.length() - 1]
    return Some(ServerOrColor::ServerColor(stop.color, stop.opacity))
  }
  let spread = convert_spread_method(doc, node)
  let cx = resolve_number(doc, node, "cx", units, state, Length::{ number: 50.0, unit: LengthUnit::Percent })
  let cy = resolve_number(doc, node, "cy", units, state, Length::{ number: 50.0, unit: LengthUnit::Percent })
  let fx = resolve_number(doc, node, "fx", units, state, Length::{ number: cx.to_double(), unit: LengthUnit::LNone })
  let fy = resolve_number(doc, node, "fy", units, state, Length::{ number: cy.to_double(), unit: LengthUnit::LNone })
  let transform = doc.resolve_transform(resolve_attr(doc, node, "gradientTransform"), "gradientTransform", state)
  Some(
    ServerOrColor::Server(
      Paint::PRadial(RadialGradient::{
        cx,
        cy,
        r,
        fx,
        fy,
        // PositiveF32::new(fr).unwrap_or(ZERO): a negative, NaN or infinite fr is 0
        fr: if fr >= 0.0f && ffin(fr) { fr } else { 0.0f },
        base: BaseGradient::{ units, transform, spread, stops },
      }),
    ),
  )
}

fn convert_pattern(doc : SDoc, node : Int, state : State, cache : Cache) -> Option[ServerOrColor] {
  let with_children = match find_pattern_with_children(doc, node) {
    Some(n) => n
    None => return None
  }
  let _ = match non_empty_id(doc.element_id(node)) {
    Some(v) => v
    None => { return None }
  }
  let view_box = {
    let n1 = resolve_attr(doc, node, "viewBox")
    let n2 = resolve_attr(doc, node, "preserveAspectRatio")
    match doc.parse_viewbox(n1) {
      Some(vb) => Some(SViewBox::{ rect: vb, aspect: doc.attr_aspect(n2).unwrap_or(AspectRatio::default()) })
      None => None
    }
  }
  let units = convert_units(doc, node, "patternUnits", Units::ObjectBoundingBox)
  let content_units = convert_units(doc, node, "patternContentUnits", Units::UserSpaceOnUse)
  let transform = doc.resolve_transform(resolve_attr(doc, node, "patternTransform"), "patternTransform", state)
  let rect = match
    skia::NonZeroRect::from_xywh(
      resolve_number(doc, node, "x", units, state, Length::zero()),
      resolve_number(doc, node, "y", units, state, Length::zero()),
      resolve_number(doc, node, "width", units, state, Length::zero()),
      resolve_number(doc, node, "height", units, state, Length::zero()),
    ) {
    Some(r) => r
    None => return None
  }
  let root = Group::empty()
  match view_box {
    Some(vb) =>
      if units == Units::UserSpaceOnUse && content_units == Units::UserSpaceOnUse {
        let g = Group::empty()
        g.transform = vb.to_transform(rect.size())
        g.abs_transform = g.transform
        convert_children(doc, with_children, state, cache, g)
        if g.children.length() == 0 {
          return None
        }
        root.children.push(Node::NGroup(g))
      } else {
        convert_children(doc, with_children, state, cache, root)
        if root.children.length() == 0 {
          return None
        }
      }
    None => {
      convert_children(doc, with_children, state, cache, root)
      if root.children.length() == 0 {
        return None
      }
    }
  }
  update_paint_servers(root, skia::Transform::default(), None, None, cache)
  Some(ServerOrColor::Server(Paint::PPattern(SPattern::{ units, content_units, transform, rect, view_box, root })))
}

fn convert_spread_method(doc : SDoc, node : Int) -> skia::SpreadMode {
  match doc.attr(resolve_attr(doc, node, "spreadMethod"), "spreadMethod") {
    Some("reflect") => skia::SpreadMode::Reflect
    Some("repeat") => skia::SpreadMode::Repeat
    _ => skia::SpreadMode::Pad
  }
}

fn convert_units(doc : SDoc, node : Int, name : String, def : Units) -> Units {
  doc.attr_units(resolve_attr(doc, node, name), name).unwrap_or(def)
}

fn find_gradient_with_stops(doc : SDoc, node : Int) -> Option[Int] {
  for link in doc.href_chain(node) {
    if !is_gradient_element(doc.tag(link)) {
      return None
    }
    if arr_any(doc.children(link), fn(n : Int) -> Bool { doc.tag(n) == "stop" }) {
      return Some(link)
    }
  }
  None
}

fn find_pattern_with_children(doc : SDoc, node : Int) -> Option[Int] {
  for link in doc.href_chain(node) {
    if doc.tag(link) != "pattern" {
      return None
    }
    if doc.has_children(link) {
      return Some(link)
    }
  }
  None
}

fn convert_stops(doc : SDoc, grad : Int) -> Array[Stop] {
  let stops : Array[Stop] = []
  let mut prev_offset = Length::zero()
  for stop in doc.children(grad) {
    if doc.tag(stop) != "stop" {
      continue
    }
    let offset = doc.attr_length(stop, "offset").unwrap_or(prev_offset)
    let offset = match offset.unit {
      LengthUnit::LNone => offset.number
      LengthUnit::Percent => offset.number / 100.0
      _ => prev_offset.number
    }
    prev_offset = Length::{ number: offset, unit: LengthUnit::LNone }
    let o = fd(offset)
    let offset : Float = if o > 1.0f { 1.0f } else if o >= 0.0f { o } else { 0.0f }
    let c = match doc.attr(stop, "stop-color") {
      Some("currentColor") => doc.find_color(stop)
      Some(v) => parse_color_str(v).unwrap_or(SColor::black())
      None => SColor::black()
    }
    let (color, opacity) = split_alpha(c)
    let stop_opacity = doc.attr_opacity(stop, "stop-opacity").unwrap_or(1.0f)
    stops.push(Stop::{ offset: opacity_clamped(offset), color, opacity: opacity_clamped(opacity * stop_opacity) })
  }
  if stops.length() >= 3 {
    let mut i = 0
    while i < stops.length() - 2 {
      let o1 = stops[i].offset
      let o2 = stops[i + 1].offset
      let o3 = stops[i + 2].offset
      if approx_eq_ulps(o1, o2, 4) && approx_eq_ulps(o2, o3, 4) {
        ignore(arr_remove(stops, i + 1))
      } else {
        i += 1
      }
    }
  }
  if stops.length() >= 2 {
    let mut i = 0
    while i < stops.length() - 1 {
      let o1 = stops[i].offset
      let o2 = stops[i + 1].offset
      if approx_zero(o1) && approx_zero(o2) {
        stops[i + 1] = Stop::{ offset: opacity_clamped(o1 + f32_epsilon), color: stops[i + 1].color, opacity: stops[i + 1].opacity }
      }
      i += 1
    }
  }
  let mut i = 1
  while i < stops.length() {
    let o1 = stops[i - 1].offset
    let o2 = stops[i].offset
    if o1 > o2 || approx_eq_ulps(o1, o2, 4) {
      stops[i - 1] = Stop::{ offset: opacity_clamped(o1 - f32_epsilon), color: stops[i - 1].color, opacity: stops[i - 1].opacity }
      stops[i] = Stop::{ offset: opacity_clamped(o1), color: stops[i].color, opacity: stops[i].opacity }
    }
    i += 1
  }
  stops
}

fn resolve_number(doc : SDoc, node : Int, name : String, units : Units, state : State, def : Length) -> Float {
  doc.convert_length(resolve_attr(doc, node, name), name, units, state, def)
}

fn resolve_attr(doc : SDoc, node : Int, name : String) -> Int {
  if doc.has_attr(node, name) {
    return node
  }
  match doc.tag(node) {
    "linearGradient" | "radialGradient" => {
      let own = doc.tag(node)
      let coords = if own == "linearGradient" {
        ["x1", "y1", "x2", "y2"]
      } else {
        ["cx", "cy", "r", "fx", "fy", "fr"]
      }
      for link in doc.href_chain(node) {
        let tag = doc.tag(link)
        if tag == "" {
          return node
        }
        let ok = (arr_contains_str(coords, name) && tag == own) ||
          ((name == "gradientUnits" || name == "spreadMethod" || name == "gradientTransform") &&
          is_gradient_element(tag))
        if !ok {
          break
        }
        if doc.has_attr(link, name) {
          return link
        }
      }
      node
    }
    "pattern" | "filter" => {
      let own = doc.tag(node)
      for link in doc.href_chain(node) {
        let tag = doc.tag(link)
        if tag == "" {
          return node
        }
        if tag != own {
          break
        }
        if doc.has_attr(link, name) {
          return link
        }
      }
      node
    }
    _ => node
  }
}

fn stops_to_color(stops : Array[Stop]) -> Option[ServerOrColor] {
  if stops.length() == 0 {
    None
  } else {
    Some(ServerOrColor::ServerColor(stops[0].color, stops[0].opacity))
  }
}

// ── to user space ─────────────────────────────────────────────────────

fn update_paint_servers(
  group : Group,
  context_transform : skia::Transform,
  context_bbox : Option[skia::Rect],
  text_bbox : Option[skia::Rect],
  cache : Cache,
) -> Unit {
  let (cts, cbbox) = if group.is_context_element {
    let bbox = if uses_context_bbox(group) { group.bounding_box() } else { None }
    (group.abs_transform, bbox)
  } else {
    (context_transform, context_bbox)
  }
  for child in group.children {
    node_to_user_coordinates(child, cts, cbbox, text_bbox, cache)
  }
}

fn is_ctx_use_node(ce : Option[ContextElement]) -> Bool {
  match ce {
    Some(ContextElement::UseNode) => true
    _ => false
  }
}

fn uses_context_bbox(group : Group) -> Bool {
  let uses = fn(paint : Paint, ce : Option[ContextElement]) -> Bool { is_ctx_use_node(ce) && uses_object_bounding_box(paint) }
  let fill_uses = fn(f : Option[Fill]) -> Bool {
    match f {
      Some(f) => uses(f.paint, f.context)
      None => false
    }
  }
  let stroke_uses = fn(s : Option[SStroke]) -> Bool {
    match s {
      Some(s) => uses(s.paint, s.context)
      None => false
    }
  }
  arr_any(group.children, fn(n : Node) -> Bool {
    match n {
      Node::NGroup(g) => !g.is_context_element && uses_context_bbox(g)
      Node::NPath(p) => fill_uses(p.fill) || stroke_uses(p.stroke)
      Node::NImage(i) =>
        match i.kind {
          ImageData::Nested(t) => uses_context_bbox(t.root)
          _ => false
        }
      Node::NText(t) => text_uses_context_bbox(t)
    }
  })
}

fn node_to_user_coordinates(
  node : Node,
  cts : skia::Transform,
  cbbox : Option[skia::Rect],
  text_bbox : Option[skia::Rect],
  cache : Cache,
) -> Unit {
  match node {
    Node::NGroup(g) => update_paint_servers(g, cts, cbbox, text_bbox, cache)
    Node::NPath(path) => {
      let uses_bbox = fn(paint : Paint, ce : Option[ContextElement]) -> Bool {
        !is_ctx_use_node(ce) && uses_object_bounding_box(paint)
      }
      let fill_uses = match path.fill {
        Some(f) => uses_bbox(f.paint, f.context)
        None => false
      }
      let stroke_uses = match path.stroke {
        Some(s) => uses_bbox(s.paint, s.context)
        None => false
      }
      let bbox = if fill_uses || stroke_uses {
        match text_bbox {
          Some(b) => Some(b)
          None => path.bounding_box()
        }
      } else {
        None
      }
      path.fill = process_fill(path.fill, path.abs_transform, cts, cbbox, bbox, cache)
      path.stroke = process_stroke(path.stroke, path.abs_transform, cts, cbbox, bbox, cache)
    }
    Node::NImage(i) =>
      match i.kind {
        ImageData::Nested(t) => update_paint_servers(t.root, cts, cbbox, None, cache)
        _ => ()
      }
    Node::NText(t) => update_text_paint_servers(t, cts, cbbox, cache)
  }
}

fn process_fill(
  fill : Option[Fill],
  path_transform : skia::Transform,
  cts : skia::Transform,
  cbbox : Option[skia::Rect],
  bbox : Option[skia::Rect],
  cache : Cache,
) -> Option[Fill] {
  match fill {
    Some(f) =>
      match process_paint(f.paint, is_ctx_use_node(f.context), cts, cbbox, path_transform, bbox, cache) {
        Some(p) => Some(Fill::{ paint: p, opacity: f.opacity, rule: f.rule, context: f.context })
        None => None
      }
    None => None
  }
}

fn process_stroke(
  stroke : Option[SStroke],
  path_transform : skia::Transform,
  cts : skia::Transform,
  cbbox : Option[skia::Rect],
  bbox : Option[skia::Rect],
  cache : Cache,
) -> Option[SStroke] {
  match stroke {
    Some(s) =>
      match process_paint(s.paint, is_ctx_use_node(s.context), cts, cbbox, path_transform, bbox, cache) {
        Some(p) => Some(SStroke::{ paint: p, dasharray: s.dasharray, dashoffset: s.dashoffset, miterlimit: s.miterlimit, opacity: s.opacity, width: s.width, linecap: s.linecap, linejoin: s.linejoin, context: s.context })
        None => None
      }
    None => None
  }
}

fn process_context_paint(paint : Paint, cts : skia::Transform, path_transform : skia::Transform, cache : Cache) -> Paint {
  let rev = match cts.invert() {
    Some(i) =>
      match i.pre_concat(path_transform).invert() {
        Some(r) => r
        None => return paint
      }
    None => return paint
  }
  match paint {
    Paint::PColor(_) => paint
    Paint::PLinear(lg) => {
      cache.gen_linear_gradient_id() |> ignore
      Paint::PLinear(LinearGradient::{ base: BaseGradient::{ units: lg.base.units, transform: lg.base.transform.post_concat(rev), spread: lg.base.spread, stops: lg.base.stops }, x1: lg.x1, y1: lg.y1, x2: lg.x2, y2: lg.y2 })
    }
    Paint::PRadial(rg) => {
      cache.gen_radial_gradient_id() |> ignore
      Paint::PRadial(RadialGradient::{ base: BaseGradient::{ units: rg.base.units, transform: rg.base.transform.post_concat(rev), spread: rg.base.spread, stops: rg.base.stops }, cx: rg.cx, cy: rg.cy, r: rg.r, fx: rg.fx, fy: rg.fy, fr: rg.fr })
    }
    Paint::PPattern(p) => {
      cache.gen_pattern_id() |> ignore
      Paint::PPattern(SPattern::{ units: p.units, content_units: p.content_units, transform: p.transform.post_concat(rev), rect: p.rect, view_box: p.view_box, root: p.root.deep_copy() })
    }
  }
}

/// The paint as drawn, None where it cannot be (process_paint's false).
fn process_paint(
  paint : Paint,
  has_context : Bool,
  cts : skia::Transform,
  cbbox : Option[skia::Rect],
  path_transform : skia::Transform,
  bbox : Option[skia::Rect],
  cache : Cache,
) -> Option[Paint] {
  let mut paint = paint
  if uses_object_bounding_box(paint) {
    let b = if has_context { cbbox } else { bbox }
    let b = match b {
      Some(b) => b
      None => return None
    }
    match paint_to_user_coordinates(paint, b) {
      Some(p) => paint = p
      None => return None
    }
  }
  if has_context {
    paint = process_context_paint(paint, cts, path_transform, cache)
  }
  Some(paint)
}

fn uses_object_bounding_box(paint : Paint) -> Bool {
  paint_units(paint) == Units::ObjectBoundingBox || paint_content_units(paint) == Units::ObjectBoundingBox
}

fn paint_to_user_coordinates(self : Paint, bbox : skia::Rect) -> Option[Paint] {
  let bbox = match bbox.to_non_zero_rect() {
    Some(b) => b
    None => return None
  }
  match self {
    Paint::PColor(_) => Some(self)
    Paint::PLinear(lg) =>
      Some(
        Paint::PLinear(LinearGradient::{
          x1: lg.x1,
          y1: lg.y1,
          x2: lg.x2,
          y2: lg.y2,
          base: BaseGradient::{
            units: Units::UserSpaceOnUse,
            transform: lg.base.transform.post_concat(skia::Transform::from_bbox(bbox)),
            spread: lg.base.spread,
            stops: lg.base.stops,
          },
        }),
      )
    Paint::PRadial(rg) =>
      Some(
        Paint::PRadial(RadialGradient::{
          cx: rg.cx,
          cy: rg.cy,
          r: rg.r,
          fx: rg.fx,
          fy: rg.fy,
          fr: rg.fr,
          base: BaseGradient::{
            units: Units::UserSpaceOnUse,
            transform: rg.base.transform.post_concat(skia::Transform::from_bbox(bbox)),
            spread: rg.base.spread,
            stops: rg.base.stops,
          },
        }),
      )
    Paint::PPattern(p) => {
      let rect = if p.units == Units::ObjectBoundingBox { p.rect.bbox_transform(bbox) } else { p.rect }
      let mut root = p.root
      if p.content_units == Units::ObjectBoundingBox && (match p.view_box { None => true, _ => false }) {
        root = push_pattern_transform(root, skia::Transform::from_scale(bbox.width(), bbox.height()))
      }
      match p.view_box {
        Some(vb) => root = push_pattern_transform(root, vb.to_transform(rect.size()))
        None => ()
      }
      Some(Paint::PPattern(SPattern::{ units: Units::UserSpaceOnUse, content_units: Units::UserSpaceOnUse, transform: p.transform, rect: rect, view_box: p.view_box, root: root }))
    }
  }
}

/// The root wrapped in a group with the transform (the root itself is left as it was).
fn push_pattern_transform(root : Group, transform : skia::Transform) -> Group {
  let g = Group::{ id: root.id, transform: transform, abs_transform: transform, opacity: root.opacity, blend_mode: root.blend_mode, isolate: root.isolate, clip_path: root.clip_path, is_context_element: root.is_context_element, mask: root.mask, filters: root.filters, children: root.children, fixed_bbox: root.fixed_bbox, fixed_abs_bbox: root.fixed_abs_bbox }
  { let _g = Group::empty(); Group::{ id: _g.id, transform: _g.transform, abs_transform: _g.abs_transform, opacity: _g.opacity, blend_mode: _g.blend_mode, isolate: _g.isolate, clip_path: _g.clip_path, is_context_element: _g.is_context_element, mask: _g.mask, filters: _g.filters, children: [Node::NGroup(g)], fixed_bbox: _g.fixed_bbox, fixed_abs_bbox: _g.fixed_abs_bbox } }
}
