    Some(.Server(p)) => cache.paint.set(doc.element_id(node), p)
    _ => ()
  }
  paint
}

///|
fn non_empty_id(s : String) -> Option[String] {
  if mbt_compat::str_to_owned(s.trim(chars=" \t\n\r")) == "" {
    Option::None
  } else {
    Some(s)
