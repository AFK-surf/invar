  match paint {
    .PColor(_) => paint
    .PLinear(lg) => {
      cache.gen_linear_gradient_id() |> ignore
      .PLinear({ let __mbt_su_b_9 : LinearGradient = lg; LinearGradient::{ base: { let __mbt_su_b_10 : BaseGradient = lg.base; BaseGradient::{ units: __mbt_su_b_10.units, transform: lg.base.transform.post_concat(rev), spread: __mbt_su_b_10.spread, stops: __mbt_su_b_10.stops } }, x1: __mbt_su_b_9.x1, y1: __mbt_su_b_9.y1, x2: __mbt_su_b_9.x2, y2: __mbt_su_b_9.y2 } })
    }
    .PRadial(rg) => {
      cache.gen_radial_gradient_id() |> ignore
      .PRadial({ let __mbt_su_b_11 : RadialGradient = rg; RadialGradient::{ base: { let __mbt_su_b_12 : BaseGradient = rg.base; BaseGradient::{ units: __mbt_su_b_12.units, transform: rg.base.transform.post_concat(rev), spread: __mbt_su_b_12.spread, stops: __mbt_su_b_12.stops } }, cx: __mbt_su_b_11.cx, cy: __mbt_su_b_11.cy, r: __mbt_su_b_11.r, fx: __mbt_su_b_11.fx, fy: __mbt_su_b_11.fy, fr: __mbt_su_b_11.fr } })
    }
    .PPattern(p) => {
      cache.gen_pattern_id() |> ignore
      .PPattern({ let __mbt_su_b_13 : SPattern = p; SPattern::{ units: __mbt_su_b_13.units, content_units: __mbt_su_b_13.content_units, transform: p.transform.post_concat(rev), rect: __mbt_su_b_13.rect, view_box: __mbt_su_b_13.view_box, root: p.root.deep_copy() } })
    }
  }
}

///|
/// The paint as drawn, None where it cannot be (process_paint's false).
fn process_paint(paint : Paint, has_context : Bool, cts : skia::Transform, cbbox : Option[skia::Rect], path_transform : skia::Transform, bbox : Option[skia::Rect], cache : Cache) -> Option[Paint] {
  let mut paint = paint
  if uses_object_bounding_box(paint) {
    let b = if has_context { cbbox } else { bbox }
    let b = match b {
      Some(b) => b
      Option::None => return Option::None
    }
    match paint.to_user_coordinates(b) {
      Some(p) => paint = p
      Option::None => return Option::None
    }
  }
  if has_context {
    paint = process_context_paint(paint, cts, path_transform, cache)
  }
  Some(paint)
}

///|
fn uses_object_bounding_box(paint : Paint) -> Bool {
  paint.units() == ObjectBoundingBox || paint.content_units() == ObjectBoundingBox
}

///|
fn Paint::to_user_coordinates(self : Paint, bbox : skia::Rect) -> Option[Paint] {
  let bbox = match bbox.to_non_zero_rect() {
    Some(b) => b
    Option::None => return Option::None
  }
  match self {
    .PColor(_) => Some(self)
    .PLinear(lg) =>
    Some(.PLinear({ let __mbt_su_b_14 : LinearGradient = lg; LinearGradient::{ base: { let __mbt_su_b_15 : BaseGradient = lg.base; BaseGradient::{ units: .UserSpaceOnUse, transform: lg.base.transform.post_concat(skia::Transform::from_bbox(bbox)), spread: __mbt_su_b_15.spread, stops: __mbt_su_b_15.stops } }, x1: __mbt_su_b_14.x1, y1: __mbt_su_b_14.y1, x2: __mbt_su_b_14.x2, y2: __mbt_su_b_14.y2 } }),)
    .PRadial(rg) =>
    Some(.PRadial({ let __mbt_su_b_16 : RadialGradient = rg; RadialGradient::{ base: { let __mbt_su_b_17 : BaseGradient = rg.base; BaseGradient::{ units: .UserSpaceOnUse, transform: rg.base.transform.post_concat(skia::Transform::from_bbox(bbox)), spread: __mbt_su_b_17.spread, stops: __mbt_su_b_17.stops } }, cx: __mbt_su_b_16.cx, cy: __mbt_su_b_16.cy, r: __mbt_su_b_16.r, fx: __mbt_su_b_16.fx, fy: __mbt_su_b_16.fy, fr: __mbt_su_b_16.fr } }),)
    .PPattern(p) => {
      let rect = if p.units == .ObjectBoundingBox { p.rect.bbox_transform(bbox) } else { p.rect }
      let mut root = p.root
      if p.content_units == .ObjectBoundingBox && p.view_box is Option::None {
        root = push_pattern_transform(root, skia::Transform::from_scale(bbox.width(), bbox.height()))
      }
      match p.view_box {
        Some(vb) => root = push_pattern_transform(root, vb.to_transform(rect.size()))
        Option::None => ()
      }
      Some(.PPattern(SPattern::{ ..p, units: .UserSpaceOnUse, content_units: .UserSpaceOnUse, rect, root }))
    }
  }
}

///|
