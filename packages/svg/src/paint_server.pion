///|
fn convert_paint_server(doc : SDoc, node : Int, state : State, cache : Cache) -> Option[ServerOrColor] {
  match cache.paint.get(doc.element_id(node)) {
    Some(p) => return Some(.Server(p))
    Option::None => ()
