import "mbt_compat"

// svgtypes' paints, paint order, transform origins (transform_origin.rs,
// directional_position.rs) and enable-background.

///|
enum PaintFallback {
  FbNone
  FbCurrentColor
  FbColor(SColor)
}

///|
enum SPaint {
  PaintNone
  PaintInherit
  PaintCurrentColor
  PaintColor(SColor)
  PaintFuncIRI(String, Option[PaintFallback])
  PaintContextFill
  PaintContextStroke
}

///|
fn parse_paint(text : String) -> Option[SPaint] {
  let text = mbt_compat::str_to_owned(text.trim(chars=" \t\n\r"))
  match text {
    "none" => Some(.PaintNone)
    "inherit" => Some(.PaintInherit)
    "currentColor" => Some(.PaintCurrentColor)
    "context-fill" => Some(.PaintContextFill)
    "context-stroke" => Some(.PaintContextStroke)
    _ => {
      let s = Stream::new(text)
      if s.starts_with("url(") {
        match s.parse_func_iri() {
          Some(link) => {
            s.skip_spaces()
            if !s.at_end() {
              match s.slice_tail() {
                "none" => Some(.PaintFuncIRI(link, Some(.FbNone)))
                "currentColor" => Some(.PaintFuncIRI(link, Some(.FbCurrentColor)))
                fallback =>
                match parse_color_str(fallback) {
                  Some(c) => Some(.PaintFuncIRI(link, Some(.FbColor(c))))
                  Option::None => Option::None
                }
              }
            } else {
              Some(.PaintFuncIRI(link, Option::None))
            }
          }
          Option::None => Option::None
        }
      } else {
        match parse_color_str(text) {
          Some(c) => Some(.PaintColor(c))
          Option::None => Option::None
        }
      }
    }
}}

///|

#derive(Eq)
pub enum PaintOrderKind {
  OFill
  OStroke
  OMarkers
}

///|
fn default_paint_order() -> Array[PaintOrderKind] {
  [PaintOrderKind::OFill, PaintOrderKind::OStroke, PaintOrderKind::OMarkers]}

///|
fn parse_paint_order(text : String) -> Array[PaintOrderKind] {
  let order = default_paint_order()
  let s = Stream::new(text)
  let mut count = 0
  while !s.at_end() && count < 3 {
    s.skip_spaces()
    let name = s.consume_ascii_ident()
    s.skip_spaces()
    let kind = match name {
      "fill" => PaintOrderKind::OFill
      "stroke" => PaintOrderKind::OStroke
      "markers" => PaintOrderKind::OMarkers
      _ => return default_paint_order()
    }
    let mut index = -1
    for i in count..<3 {
      if order[i] == kind {
        index = i - count
        break
      }
    }
    if index < 0 {
      return default_paint_order()
    }
    // rotate order[count..=count+index] right by one
    let last = order[count + index]
    let mut k = count + index
    while k > count {
      order[k] = order[k - 1]
      k -= 1
    }
    order[count] = last
    count += 1
  }
  s.skip_spaces()
  if !s.at_end() {
    return default_paint_order()
  }
  order}

///|

#derive(Eq)
enum DirPos {
  DTop
  DCenter
  DBottom
  DRight
  DLeft
}

///|
fn Stream::parse_directional_position(self : Stream) -> Option[DirPos] {
  self.skip_spaces()
  if self.starts_with("left") {
    self.pos += 4
    Some(.DLeft)
  } else if self.starts_with("right") {
    self.pos += 5
    Some(.DRight)
  } else if self.starts_with("top") {
    self.pos += 3
    Some(.DTop)
  } else if self.starts_with("bottom") {
    self.pos += 6
    Some(.DBottom)
  } else if self.starts_with("center") {
    self.pos += 6
    Some(.DCenter)
  } else {
    Option::None
}}

///|
fn dir_length(d : DirPos) -> Length {
  match d {
    .DLeft | .DTop => Length::{ number: 0.0, unit: LengthUnit::Percent }
    .DRight | .DBottom => Length::{ number: 100.0, unit: LengthUnit::Percent }
    .DCenter => Length::{ number: 50.0, unit: LengthUnit::Percent }
}}

///|
enum OriginPos {
  OLength(Length)
  ODir(DirPos)
}

///|
fn OriginPos::is_vertical(self : OriginPos) -> Bool {
  match self {
    .OLength(_) => true
    .ODir(d) => d == .DCenter || d == .DTop || d == .DBottom
}}

///|
fn OriginPos::is_horizontal(self : OriginPos) -> Bool {
  match self {
    .OLength(_) => true
    .ODir(d) => d == .DCenter || d == .DLeft || d == .DRight
}}

///|
fn OriginPos::length(self : OriginPos) -> Length {
  match self {
    .OLength(l) => l
    .ODir(d) => dir_length(d)
}}

///|
/// A transform-origin's x and y (the z is not kept).
fn parse_transform_origin(text : String) -> Option[(Length, Length)] {
  let s = Stream::new(text)
  s.skip_spaces()
  if s.at_end() {
    return Option::None
  }
  let part = fn() -> Option[OriginPos] {
    let save = s.pos
    match s.parse_directional_position() {
      Some(d) => Some(.ODir(d))
      Option::None => {
        s.pos = save
        match s.parse_length() {
          Some(l) => Some(.OLength(l))
          Option::None => Option::None
        }
      }
    }
  }
  let p1 = match part() {
    Some(p) => p
    Option::None => return Option::None
  }
  let mut second : Option[OriginPos] = Option::None
  let mut third : Option[Length] = Option::None
  if !s.at_end() {
    s.skip_spaces()
    s.parse_list_separator()
    second = match part() {
      Some(p) => Some(p)
      Option::None => return Option::None
    }
  }
  if !s.at_end() {
    s.skip_spaces()
    s.parse_list_separator()
    third = match s.parse_length() {
      Some(l) => Some(l)
      Option::None => return Option::None
    }
  }
  s.skip_spaces()
  if !s.at_end() {
    return Option::None
  }
  match second {
    Option::None =>
    if p1.is_horizontal() {
      Some((p1.length(), dir_length(.DCenter)))
    } else {
      Some((dir_length(.DCenter), p1.length()))
    }
    Some(p2) => {
      match third {
        Some(l) => if l.unit == LengthUnit::Percent { return Option::None }
        Option::None => ()
      }
      let check = fn(p : OriginPos) {
        match p {
          .OLength(_) => true
          .ODir(d) => d == DirPos::DCenter
        }
      }
      if check(p1) && check(p2) {
        Some((p1.length(), p2.length()))
      } else if p1.is_horizontal() && p2.is_vertical() {
        Some((p1.length(), p2.length()))
      } else if p1.is_vertical() && p2.is_horizontal() {
        Some((p2.length(), p1.length()))
      } else {
        Option::None
      }
    }
}}
