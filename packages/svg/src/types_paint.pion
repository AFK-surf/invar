// svgtypes' paints, paint order, transform origins (transform_origin.rs,
// directional_position.rs) and enable-background.

enum PaintFallback {
  FbNone
  FbCurrentColor
  FbColor(SColor)
}

enum SPaint {
  PaintNone
  PaintInherit
  PaintCurrentColor
  PaintColor(SColor)
  PaintFuncIRI(String, Option[PaintFallback])
  PaintContextFill
  PaintContextStroke
}

fn parse_paint(text : String) -> Option[SPaint] {
  let text =str_trim_chars(text, " \t\n\r")
  match text {
    "none" => Some(SPaint::PaintNone)
    "inherit" => Some(SPaint::PaintInherit)
    "currentColor" => Some(SPaint::PaintCurrentColor)
    "context-fill" => Some(SPaint::PaintContextFill)
    "context-stroke" => Some(SPaint::PaintContextStroke)
    _ => {
      let s = Stream::new(text)
      if s.starts_with("url(") {
        match s.parse_func_iri() {
          Some(link) => {
            s.skip_spaces()
            if !s.at_end() {
              match s.slice_tail() {
                "none" => Some(SPaint::PaintFuncIRI(link, Some(PaintFallback::FbNone)))
                "currentColor" => Some(SPaint::PaintFuncIRI(link, Some(PaintFallback::FbCurrentColor)))
                fallback =>
                  match parse_color_str(fallback) {
                    Some(c) => Some(SPaint::PaintFuncIRI(link, Some(PaintFallback::FbColor(c))))
                    None => None
                  }
              }
            } else {
              Some(SPaint::PaintFuncIRI(link, None))
            }
          }
          None => None
        }
      } else {
        match parse_color_str(text) {
          Some(c) => Some(SPaint::PaintColor(c))
          None => None
        }
      }
    }
  }
}

#derive(Eq)
pub enum PaintOrderKind {
  OFill
  OStroke
  OMarkers
}

fn default_paint_order() -> Array[PaintOrderKind] {
  [PaintOrderKind::OFill, PaintOrderKind::OStroke, PaintOrderKind::OMarkers]
}

fn parse_paint_order(text : String) -> Array[PaintOrderKind] {
  let order = default_paint_order()
  let s = Stream::new(text)
  let mut count = 0
  while !s.at_end() && count < 3 {
    s.skip_spaces()
    let name = s.consume_ascii_ident()
    s.skip_spaces()
    let kind = match name {
      "fill" => PaintOrderKind::OFill
      "stroke" => PaintOrderKind::OStroke
      "markers" => PaintOrderKind::OMarkers
      _ => return default_paint_order()
    }
    let mut index = -1
    for i in count..<3 {
      if order[i] == kind {
        index = i - count
        break
      }
    }
    if index < 0 {
      return default_paint_order()
    }
    // rotate order[count..=count+index] right by one
    let last = order[count + index]
    let mut k = count + index
    while k > count {
      order[k] = order[k - 1]
      k -= 1
    }
    order[count] = last
    count += 1
  }
  s.skip_spaces()
  if !s.at_end() {
    return default_paint_order()
  }
  order
}

#derive(Eq)
enum DirPos {
  DTop
  DCenter
  DBottom
  DRight
  DLeft
}

fn Stream::parse_directional_position(self : Stream) -> Option[DirPos] {
  self.skip_spaces()
  if self.starts_with("left") {
    self.pos += 4
    Some(DirPos::DLeft)
  } else if self.starts_with("right") {
    self.pos += 5
    Some(DirPos::DRight)
  } else if self.starts_with("top") {
    self.pos += 3
    Some(DirPos::DTop)
  } else if self.starts_with("bottom") {
    self.pos += 6
    Some(DirPos::DBottom)
  } else if self.starts_with("center") {
    self.pos += 6
    Some(DirPos::DCenter)
  } else {
    None
  }
}

fn dir_length(d : DirPos) -> Length {
  match d {
    DirPos::DLeft | DirPos::DTop => Length::{ number: 0.0, unit: LengthUnit::Percent }
    DirPos::DRight | DirPos::DBottom => Length::{ number: 100.0, unit: LengthUnit::Percent }
    DirPos::DCenter => Length::{ number: 50.0, unit: LengthUnit::Percent }
  }
}

enum OriginPos {
  OLength(Length)
  ODir(DirPos)
}

fn origin_pos_is_vertical(self : OriginPos) -> Bool {
  match self {
    OriginPos::OLength(_) => true
    OriginPos::ODir(d) => d == DirPos::DCenter || d == DirPos::DTop || d == DirPos::DBottom
  }
}

fn origin_pos_is_horizontal(self : OriginPos) -> Bool {
  match self {
    OriginPos::OLength(_) => true
    OriginPos::ODir(d) => d == DirPos::DCenter || d == DirPos::DLeft || d == DirPos::DRight
  }
}

fn origin_pos_length(self : OriginPos) -> Length {
  match self {
    OriginPos::OLength(l) => l
    OriginPos::ODir(d) => dir_length(d)
  }
}

/// A transform-origin's x and y (the z is not kept).
fn parse_transform_origin(text : String) -> Option[(Length, Length)] {
  let s = Stream::new(text)
  s.skip_spaces()
  if s.at_end() {
    return None
  }
  let part = fn() -> Option[OriginPos] {
    let save = s.pos
    match s.parse_directional_position() {
      Some(d) => Some(OriginPos::ODir(d))
      None => {
        s.pos = save
        match s.parse_length() {
          Some(l) => Some(OriginPos::OLength(l))
          None => None
        }
      }
    }
  }
  let p1 = match part() {
    Some(p) => p
    None => return None
  }
  let mut second : Option[OriginPos] = None
  let mut third : Option[Length] = None
  if !s.at_end() {
    s.skip_spaces()
    s.parse_list_separator()
    second = match part() {
      Some(p) => Some(p)
      None => return None
    }
  }
  if !s.at_end() {
    s.skip_spaces()
    s.parse_list_separator()
    third = match s.parse_length() {
      Some(l) => Some(l)
      None => return None
    }
  }
  s.skip_spaces()
  if !s.at_end() {
    return None
  }
  match second {
    None =>
      if origin_pos_is_horizontal(p1) {
        Some((origin_pos_length(p1), dir_length(DirPos::DCenter)))
      } else {
        Some((dir_length(DirPos::DCenter), origin_pos_length(p1)))
      }
    Some(p2) => {
      match third {
        Some(l) => if l.unit == LengthUnit::Percent { return None }
        None => ()
      }
      let check = fn(p : OriginPos) -> Bool {
        match p {
          OriginPos::OLength(_) => true
          OriginPos::ODir(d) => d == DirPos::DCenter
        }
      }
      if check(p1) && check(p2) {
        Some((origin_pos_length(p1), origin_pos_length(p2)))
      } else if origin_pos_is_horizontal(p1) && origin_pos_is_vertical(p2) {
        Some((origin_pos_length(p1), origin_pos_length(p2)))
      } else if origin_pos_is_vertical(p1) && origin_pos_is_horizontal(p2) {
        Some((origin_pos_length(p2), origin_pos_length(p1)))
      } else {
        None
      }
    }
  }
}
