// An XML document as roxmltree reads one (roxmltree 0.21: what usvg reads SVG with): elements with their namespaces
// resolved, attributes normalized, text with its references and the DTD's internal entities expanded (an entity's
// value read as markup in place of its reference), CDATA as text, line ends made \n. A document it would refuse
// (unclosed, unknown entity or prefix, duplicated attribute, no (match root) { None => true, _ => false }).

let ns_xml : String = "http://www.w3.org/XML/1998/namespace"

#derive(Eq)
enum XKind {
  XRoot
  XElement
  XText
  XComment
  XPI
}

struct XAttr {
  ns : String
  name : String
  value : String
}

struct XNode {
  kind : XKind
  ns : String
  name : String
  attrs : Array[XAttr]
  mut text : String
  parent : Int
  children : Array[Int]
  /// (prefix, uri) declared here and in ns_scope
  ns_scope : Array[(String, String)]
}

struct XDoc {
  nodes : Array[XNode]
}

fn XDoc::attr(self : XDoc, id : Int, name : String) -> Option[String] {
  for a in self.nodes[id].attrs {
    if a.ns == "" && a.name == name {
      return Some(a.value)
    }
  }
  None
}

/// The text of an element's text children joined (roxmltree's node.text() is the first; usvg reads them all).
fn XDoc::descendants(self : XDoc, id : Int, out : Array[Int]) -> Unit {
  out.push(id)
  for c in self.nodes[id].children {
    self.descendants(c, out)
  }
}

struct XParser {
  s : String
  mut pos : Int
  doc : XDoc
  entities : Map[String, String]
  mut parent : Int
  /// texts appended since the last node (merged into the last text node)
  mut after_text : Array[String]
  mut depth : Int
  mut references : Int
  mut ok : Bool
}

fn parse_xml(text : String) -> Option[XDoc] {
  let root : XNode = XNode::{
    kind: XKind::XRoot,
    ns: "",
    name: "",
    attrs: [],
    text: "",
    parent: -1,
    children: [],
    ns_scope: [("xml", ns_xml)],
  }
  let p : XParser = XParser::{
    s: text,
    pos: 0,
    doc: XDoc::{ nodes: [root] },
    entities: Map::new(),
    parent: 0,
    after_text: [],
    depth: 0,
    references: 0,
    ok: true,
  }
  // a BOM
  if text.length() > 0 && text.code_unit_at(0).to_int() == 0xFEFF {
    p.pos = 1
  }
  p.content(true)
  p.reset_after_text()
  if !p.ok || p.parent != 0 {
    return None
  }
  if !arr_any(p.doc.nodes[0].children, fn(c : Int) -> Bool { p.doc.nodes[c].kind == XKind::XElement }) {
    return None
  }
  Some(p.doc)
}

fn XParser::fail(self : XParser) -> Unit {
  self.ok = false
}

fn XParser::at_end(self : XParser) -> Bool {
  self.pos >= self.s.length()
}

fn XParser::cur(self : XParser) -> Int {
  if self.pos < self.s.length() {
    self.s.code_unit_at(self.pos).to_int()
  } else {
    -1
  }
}

fn XParser::starts(self : XParser, t : String) -> Bool {
  if self.pos + t.length() > self.s.length() {
    return false
  }
  for i in 0..<t.length() {
    if self.s.code_unit_at(self.pos + i).to_int() != t.code_unit_at(i).to_int() {
      return false
    }
  }
  true
}

fn XParser::skip_spaces(self : XParser) -> Unit {
  while !self.at_end() && is_xml_space(self.cur()) {
    self.pos += 1
  }
}

fn is_xml_space(c : Int) -> Bool {
  c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D
}

fn is_name_char(c : Int) -> Bool {
  (c >= 97.to_int() && c <= 122.to_int()) ||
  (c >= 65.to_int() && c <= 90.to_int()) ||
  (c >= 48.to_int() && c <= 57.to_int()) ||
  c == 95.to_int() ||
  c == 45.to_int() ||
  c == 46.to_int() ||
  c == 58.to_int() ||
  c >= 0x80
}

fn XParser::name(self : XParser) -> String {
  let start = self.pos
  while !self.at_end() && is_name_char(self.cur()) {
    self.pos += 1
  }
  self.s.slice(start, self.pos)
}

fn XParser::until(self : XParser, t : String) -> Option[String] {
  let start = self.pos
  while !self.at_end() {
    if self.starts(t) {
      let r = self.s.slice(start, self.pos)
      self.pos += t.length()
      return Some(r)
    }
    self.pos += 1
  }
  None
}

fn XParser::reset_after_text(self : XParser) -> Unit {
  if self.after_text.length() > 1 {
    let last = self.doc.nodes[self.doc.nodes.length() - 1]
    last.text = self.after_text.join("")
  }
  self.after_text = []
}

fn XParser::append_node(self : XParser, node : XNode) -> Int {
  let id = self.doc.nodes.length()
  self.doc.nodes.push(node)
  self.doc.nodes[node.parent].children.push(id)
  id
}

fn XParser::append_text(self : XParser, text : String) -> Unit {
  if text == "" {
    return
  }
  if self.after_text.length() == 0 {
    ignore(
      self.append_node(XNode::{
        kind: XKind::XText,
        ns: "",
        name: "",
        attrs: [],
        text,
        parent: self.parent,
        children: [],
        ns_scope: [],
      }),
    )
  }
  self.after_text.push(text)
}

/// Content until the end (`top`: the document's; else an entity's) or a close tag of the current parent.
fn XParser::content(self : XParser, top : Bool) -> Unit {
  while self.ok && !self.at_end() {
    if self.starts("<!--") {
      self.reset_after_text()
      self.pos += 4
      match self.until("-->") {
        Some(t) =>
          ignore(
            self.append_node(XNode::{
              kind: XKind::XComment,
              ns: "",
              name: "",
              attrs: [],
              text: t,
              parent: self.parent,
              children: [],
              ns_scope: [],
            }),
          )
        None => return self.fail()
      }
    } else if self.starts("<![CDATA[") {
      self.pos += 9
      match self.until("]]>") {
        Some(t) => self.append_text(normalize_text_newlines(t))
        None => return self.fail()
      }
    } else if self.starts("<!DOCTYPE") {
      if !top {
        return self.fail()
      }
      self.doctype()
    } else if self.starts("<?") {
      self.reset_after_text()
      self.pos += 2
      let target = self.name()
      match self.until("?>") {
        Some(v) =>
          if target != "xml" {
            ignore(
              self.append_node(XNode::{
                kind: XKind::XPI,
                ns: "",
                name: target,
                attrs: [],
                text:str_trim_chars(v, " \t\r\n"),
                parent: self.parent,
                children: [],
                ns_scope: [],
              }),
            )
          }
        None => return self.fail()
      }
    } else if self.starts("</") {
      self.reset_after_text()
      self.pos += 2
      let qname = self.name()
      self.skip_spaces()
      if self.cur() != 62.to_int() {
        return self.fail()
      }
      self.pos += 1
      let parent = self.doc.nodes[self.parent]
      if parent.kind != XKind::XElement || qname_of(parent) != qname {
        return self.fail()
      }
      self.parent = parent.parent
    } else if self.cur() == 60.to_int() {
      self.reset_after_text()
      self.element()
    } else {
      self.text()
    }
  }
}

/// The element's name as written (its prefix kept in the node for the close tag).
fn qname_of(n : XNode) -> String {
  n.text
}

fn XParser::element(self : XParser) -> Unit {
  self.pos += 1
  let qname = self.name()
  if qname == "" {
    return self.fail()
  }
  let raw : Array[(String, String)] = []
  let ns_scope : Array[(String, String)] = []
  while true {
    self.skip_spaces()
    let c = self.cur()
    if c == 62.to_int() || c == 47.to_int() || c == -1 {
      break
    }
    let an = self.name()
    if an == "" {
      return self.fail()
    }
    self.skip_spaces()
    if self.cur() != 61.to_int() {
      return self.fail()
    }
    self.pos += 1
    self.skip_spaces()
    let q = self.cur()
    if q != 34.to_int() && q != 39.to_int() {
      return self.fail()
    }
    self.pos += 1
    let start = self.pos
    while !self.at_end() && self.cur() != q {
      self.pos += 1
    }
    if self.at_end() {
      return self.fail()
    }
    let value = self.normalize_attribute(self.s.slice(start, self.pos))
    self.pos += 1
    if an == "xmlns" {
      ns_scope.push(("", value))
    } else if str_starts_with(an, "xmlns:") {
      ns_scope.push((an.slice(6, an.length()), value))
    } else {
      raw.push((an, value))
    }
  }
  let empty = self.starts("/>")
  if empty {
    self.pos += 2
  } else if self.cur() == 62.to_int() {
    self.pos += 1
  } else {
    return self.fail()
  }
  // the ns_scope: what is declared here over the parent's
  let parent_scope = self.doc.nodes[self.parent].ns_scope
  let full : Array[(String, String)] = ns_scope.copy()
  for p in parent_scope {
    if !arr_any(full, fn(d : (String, String)) -> Bool { d.0 == p.0 }) {
      full.push(p)
    }
  }
  let resolve = fn(prefix : String) -> Option[String] {
    for d in full {
      if d.0 == prefix {
        return Some(d.1)
      }
    }
    None
  }
  let (prefix, local_name) = split_qname(qname)
  let ns = match resolve(prefix) {
    Some(u) => u
    None => if prefix == "" { "" } else { return self.fail() }
  }
  let attrs : Array[XAttr] = []
  for r in raw {
    let (ap, al) = split_qname(r.0)
    let ans = if ap == "" {
      ""
    } else {
      match resolve(ap) {
        Some(u) => u
        None => return self.fail()
      }
    }
    if arr_any(attrs, fn(a : XAttr) -> Bool { a.ns == ans && a.name == al }) {
      return self.fail()
    }
    attrs.push(XAttr::{ ns: ans, name: al, value: r.1 })
  }
  let id = self.append_node(XNode::{
    kind: XKind::XElement,
    ns,
    name: local_name,
    attrs,
    text: qname,
    parent: self.parent,
    children: [],
    ns_scope: full,
  })
  if !empty {
    self.parent = id
  }
}

fn split_qname(q : String) -> (String, String) {
  match str_find(q, ":") {
    Some(i) => (q.slice(0, i), q.slice(i + 1, q.length()))
    None => ("", q)
  }
}

/// A reference at the parser (after its `&`): a character, or an entity's name.
enum XRef {
  RChar(Int)
  REntity(String)
}

fn XParser::reference(self : XParser) -> Option[XRef] {
  // at '&'
  self.pos += 1
  if self.cur() == 35.to_int() {
    self.pos += 1
    let hex = self.cur() == 120.to_int()
    if hex {
      self.pos += 1
    }
    let start = self.pos
    while !self.at_end() {
      let c = self.cur()
      let ok = if hex {
        (c >= 48.to_int() && c <= 57.to_int()) ||
        (c >= 97.to_int() && c <= 102.to_int()) ||
        (c >= 65.to_int() && c <= 70.to_int())
      } else {
        c >= 48.to_int() && c <= 57.to_int()
      }
      if !ok {
        break
      }
      self.pos += 1
    }
    let digits = self.s.slice(start, self.pos)
    if digits == "" || self.cur() != 59.to_int() {
      return None
    }
    self.pos += 1
    let mut n = 0
    for di in 0..<digits.length() {
      let v = digits.code_unit_at(di)
      let d = if v <= 57.to_int() {
        v - 48.to_int()
      } else if v <= 70.to_int() {
        v - 65.to_int() + 10
      } else {
        v - 97.to_int() + 10
      }
      n = n * (if hex { 16 } else { 10 }) + d
      if n > 0x10FFFF {
        return None
      }
    }
    if n == 0 {
      return None
    }
    Some(XRef::RChar(n))
  } else {
    let name = self.name()
    if name == "" || self.cur() != 59.to_int() {
      return None
    }
    self.pos += 1
    match name {
      "quot" => Some(XRef::RChar(34.to_int()))
      "amp" => Some(XRef::RChar(38.to_int()))
      "apos" => Some(XRef::RChar(39.to_int()))
      "lt" => Some(XRef::RChar(60.to_int()))
      "gt" => Some(XRef::RChar(62.to_int()))
      _ => Some(XRef::REntity(name))
    }
  }
}

fn char_string(c : Int) -> String {
  let sb = StringBuilder::new()
  sb_write_cp(sb, c)
  sb.to_string()
}

/// Text until the next '<' (process_text): references resolved, an entity's value read as content in place.
fn XParser::text(self : XParser) -> Unit {
  let buf = StringBuilder::new()
  let flush = fn() -> Unit {
    let t = normalize_text_newlines(buf.to_string())
    buf.reset()
    self.append_text(t)
  }
  while !self.at_end() && self.cur() != 60.to_int() {
    if self.cur() == 38.to_int() {
      match self.reference() {
        Some(XRef::RChar(c)) => buf.write_string(char_string(c))
        Some(XRef::REntity(name)) =>
          match self.entities.get(name) {
            Some(value) => {
              flush()
              self.references += 1
              self.depth += 1
              if self.depth > 10 || self.references > 255 {
                return self.fail()
              }
              let saved = (self.s, self.pos)
              let sub : XParser = XParser::{ s: value, pos: 0, doc: self.doc, entities: self.entities, parent: self.parent, after_text: self.after_text, depth: self.depth, references: self.references, ok: self.ok }
              let parent_before = self.parent
              sub.content(false)
              if !sub.ok || sub.parent != parent_before {
                return self.fail()
              }
              self.after_text = sub.after_text
              self.depth -= 1
              ignore(saved)
            }
            None => return self.fail()
          }
        None => return self.fail()
      }
    } else {
      let start = self.pos
      while !self.at_end() && self.cur() != 60.to_int() && self.cur() != 38.to_int() {
        self.pos += 1
      }
      buf.write_string(self.s.slice(start, self.pos))
    }
  }
  flush()
}

/// \r\n and a lone \r as \n (TextBuffer::push_from_text).
fn normalize_text_newlines(t : String) -> String {
  if !str_contains(t, "\r") {
    return t
  }
  str_replace_all(str_replace_all(t, "\r\n", "\n"), "\r", "\n")
}

/// An attribute's value as XML normalizes it: references resolved, \t \n \r (and \r\n) as a space.
fn XParser::normalize_attribute(self : XParser, raw : String) -> String {
  if !str_contains(raw, "&") && !str_contains(raw, "\t") && !str_contains(raw, "\n") && !str_contains(raw, "\r") {
    return raw
  }
  let out = StringBuilder::new()
  self.normalize_attr_into(raw, out)
  out.to_string()
}

fn XParser::normalize_attr_into(self : XParser, raw : String, out : StringBuilder) -> Unit {
  let sub : XParser = XParser::{ s: raw, pos: 0, doc: self.doc, entities: self.entities, parent: self.parent, after_text: self.after_text, depth: self.depth, references: self.references, ok: self.ok }
  while !sub.at_end() {
    let c = sub.cur()
    if c == 38.to_int() {
      match sub.reference() {
        Some(XRef::RChar(ch)) => out.write_string(char_string(ch))
        Some(XRef::REntity(name)) =>
          match self.entities.get(name) {
            Some(v) => {
              self.references += 1
              if self.references > 255 {
                return self.fail()
              }
              self.normalize_attr_into(v, out)
            }
            None => return self.fail()
          }
        None => return self.fail()
      }
    } else {
      sub.pos += 1
      if c == 13.to_int() && sub.cur() == 10.to_int() {
        continue
      }
      if c == 10 || c == 13 || c == 9 {
        sb_write_cp(out, 32)
      } else {
        sb_write_cp(out, c)
      }
    }
  }
}

/// <!DOCTYPE …>: its internal subset's general entities kept (the first of a name wins), the rest skipped.
fn XParser::doctype(self : XParser) -> Unit {
  self.pos += 9
  while !self.at_end() {
    let c = self.cur()
    if c == 91.to_int() {
      self.pos += 1
      self.internal_subset()
      if !self.ok {
        return
      }
    } else if c == 62.to_int() {
      self.pos += 1
      return
    } else if c == 34.to_int() || c == 39.to_int() {
      self.pos += 1
      while !self.at_end() && self.cur() != c {
        self.pos += 1
      }
      self.pos += 1
    } else {
      self.pos += 1
    }
  }
  self.fail()
}

fn XParser::internal_subset(self : XParser) -> Unit {
  while !self.at_end() {
    self.skip_spaces()
    if self.cur() == 93.to_int() {
      self.pos += 1
      return
    }
    if self.starts("<!ENTITY") {
      self.pos += 8
      self.skip_spaces()
      let parameter = self.cur() == 37.to_int()
      if parameter {
        self.pos += 1
        self.skip_spaces()
      }
      let name = self.name()
      self.skip_spaces()
      let q = self.cur()
      if q == 34.to_int() || q == 39.to_int() {
        self.pos += 1
        let start = self.pos
        while !self.at_end() && self.cur() != q {
          self.pos += 1
        }
        let value = self.s.slice(start, self.pos)
        self.pos += 1
        if !parameter && !self.entities.contains(name) {
          self.entities[name] = value
        }
      }
      ignore(self.until(">"))
    } else if self.starts("<!--") {
      self.pos += 4
      ignore(self.until("-->"))
    } else if self.starts("<?") {
      ignore(self.until("?>"))
    } else if self.starts("<!") {
      ignore(self.until(">"))
    } else if self.cur() == 37.to_int() {
      ignore(self.until(";"))
    } else {
      return self.fail()
    }
  }
  self.fail()
}
