// Comprehensive unit tests for packages/svg: parsing, CSS selectors, shapes, paths,
// gradients, clipPath, mask, marker, <use>, filters, and pixel-verified rendering.

import "skia"

fn px_rgba(rgba : FixedArray[Byte], w : Int, x : Int, y : Int) -> (Int, Int, Int, Int) {
  let i = (y * w + x) * 4
  (rgba[i].to_int(), rgba[i + 1].to_int(), rgba[i + 2].to_int(), rgba[i + 3].to_int())
}

test "svg: rasterize basic rect and aspect ratio (longer side)" {
  let svg_bytes = "<svg xmlns='http://www.w3.org/2000/svg' width='40' height='20'><rect width='20' height='20' fill='#ff0000'/></svg>".to_bytes()
  let (w, h, rgba) = match rasterize(svg_bytes, 80) {
    Some(v) => v
    None => {
      debug_assert(false, "rasterize failed")
      (0, 0, FixedArray::make(0, 0 as Byte))
    }
  }
  debug_assert(w == 80 && h == 40, "expected 80x40")
  let (r0, g0, b0, a0) = px_rgba(rgba, w, 10, 10)
  debug_assert(r0 == 255 && g0 == 0 && b0 == 0 && a0 == 255, "left half must be red")
  let (_, _, _, a1) = px_rgba(rgba, w, 70, 10)
  debug_assert(a1 == 0, "right half must be transparent")

  // Tall SVG: height is the longer side
  let tall = "<svg xmlns='http://www.w3.org/2000/svg' width='10' height='30'/>".to_bytes()
  match rasterize(tall, 90) {
    Some((tw, th, _)) => debug_assert(tw == 30 && th == 90, "expected 30x90")
    None => debug_assert(false, "tall svg failed")
  }

  // Invalid SVG returns None
  let bad = match rasterize("not svg".to_bytes(), 50) {
    None => true
    Some(_) => false
  }
  debug_assert(bad, "invalid svg must return None")
}

test "svg: CSS attribute selectors ^=, $=, *= (mermaid markers)" {
  let svg_str = "<svg xmlns='http://www.w3.org/2000/svg' width='30' height='10'><style>" +
    "rect{fill:#ff0000}" +
    "[id^=\"a-\"],.none{fill:#00ff00}" +
    "[id$=\"-b\"],.none{fill:#0000ff}" +
    "[id*=\"mid\"],.none{fill:#ffffff}" +
    "</style><rect id='a-1' width='10' height='10'/><rect id='x-b' x='10' width='10' height='10'/>" +
    "<rect id='xmidx' x='20' width='10' height='10'/></svg>"
  let (w, h, rgba) = match rasterize(svg_str.to_bytes(), 30) {
    Some(v) => v
    None => {
      debug_assert(false, "css selector svg failed")
      (0, 0, FixedArray::make(0, 0 as Byte))
    }
  }
  debug_assert(w == 30 && h == 10, "expected 30x10")
  let (r1, g1, b1, a1) = px_rgba(rgba, w, 5, 5)
  let (r2, g2, b2, a2) = px_rgba(rgba, w, 15, 5)
  let (r3, g3, b3, a3) = px_rgba(rgba, w, 25, 5)
  debug_assert(r1 == 0 && g1 == 255 && b1 == 0, "a-1 must be green")
  debug_assert(r2 == 0 && g2 == 0 && b2 == 255, "x-b must be blue, got=" + r2.to_string() + "," + g2.to_string() + "," + b2.to_string() + "," + a2.to_string())
  debug_assert(r3 == 255 && g3 == 255 && b3 == 255, "xmidx must be white, got=" + r3.to_string() + "," + g3.to_string() + "," + b3.to_string() + "," + a3.to_string())
}

test "svg: svg_size and render_svg_to_width with circle and path" {
  let src = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' width='100' height='100'>" +
    "<circle cx='50' cy='50' r='40' fill='#00aa00'/>" +
    "<path d='M 10 10 L 30 10 L 30 30 L 10 30 Z' fill='#0000ff'/>" +
    "</svg>"
  let opt = Options::default()
  match svg_size(src, opt) {
    Some((sw, sh)) => debug_assert((sw - 100.0f).abs() < 0.01f && (sh - 100.0f).abs() < 0.01f, "size 100x100")
    None => debug_assert(false, "svg_size returned None")
  }
  let pm = match render_svg_to_width(src, 100, opt) {
    Some(p) => p
    None => {
      debug_assert(false, "render_svg_to_width failed")
      opt_unwrap(skia::Pixmap::new(1, 1))
    }
  }
  debug_assert(pm.width == 100 && pm.height == 100, "pixmap 100x100")
  // Center of circle (50, 50) -> green
  match pm.pixel(50, 50) {
    Some(c) => debug_assert(c.r == 0 && c.g > 150 && c.b == 0 && c.a == 255, "circle center green")
    None => debug_assert(false, "missing pixel")
  }
  // Inside path square (20, 20) -> blue
  match pm.pixel(20, 20) {
    Some(c) => debug_assert(c.r == 0 && c.g == 0 && c.b == 255 && c.a == 255, "path square blue")
    None => debug_assert(false, "missing pixel")
  }
}

test "svg: linearGradient and radialGradient rendering" {
  let src = "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='20'>" +
    "<defs>" +
    "<linearGradient id='g1' x1='0%' y1='0%' x2='100%' y2='0%'>" +
    "<stop offset='0%' stop-color='#ff0000'/>" +
    "<stop offset='100%' stop-color='#0000ff'/>" +
    "</linearGradient>" +
    "</defs>" +
    "<rect width='60' height='20' fill='url(#g1)'/>" +
    "</svg>"
  let pm = match render_svg_to_width(src, 60, Options::default()) {
    Some(p) => p
    None => {
      debug_assert(false, "gradient render failed")
      opt_unwrap(skia::Pixmap::new(1, 1))
    }
  }
  let left = opt_unwrap(pm.pixel(2, 10))
  let mid = opt_unwrap(pm.pixel(30, 10))
  let right = opt_unwrap(pm.pixel(58, 10))
  debug_assert(left.r > 200 && left.b < 40 && left.a == 255, "left red, got=" + left.r.to_string() + "," + left.g.to_string() + "," + left.b.to_string() + "," + left.a.to_string())
  debug_assert(mid.r > 80 && mid.b > 80 && mid.a == 255, "mid purple, got=" + mid.r.to_string() + "," + mid.g.to_string() + "," + mid.b.to_string() + "," + mid.a.to_string())
  debug_assert(right.b > 200 && right.r < 40 && right.a == 255, "right blue, got=" + right.r.to_string() + "," + right.g.to_string() + "," + right.b.to_string() + "," + right.a.to_string())
}

test "svg: clipPath, use node, and marker rendering" {
  let src = "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40'>" +
    "<defs>" +
    "<clipPath id='c1'><rect x='0' y='0' width='20' height='40'/></clipPath>" +
    "<rect id='box' width='10' height='10' fill='#00ff00'/>" +
    "<marker id='dot' viewBox='0 0 10 10' refX='5' refY='5' markerWidth='8' markerHeight='8'>" +
    "<circle cx='5' cy='5' r='5' fill='#0000ff'/>" +
    "</marker>" +
    "</defs>" +
    "<rect x='0' y='0' width='40' height='40' fill='#ff0000' clip-path='url(#c1)'/>" +
    "<use href='#box' x='25' y='5'/>" +
    "<line x1='45' y1='20' x2='55' y2='20' stroke='#000000' stroke-width='2' marker-end='url(#dot)'/>" +
    "</svg>"
  let pm = match render_svg_to_width(src, 60, Options::default()) {
    Some(p) => p
    None => {
      debug_assert(false, "clip/use/marker render failed")
      opt_unwrap(skia::Pixmap::new(1, 1))
    }
  }
  // Inside clipPath (10, 20): red
  let p_in = opt_unwrap(pm.pixel(10, 20))
  debug_assert(p_in.r == 255 && p_in.g == 0 && p_in.b == 0 && p_in.a == 255, "inside clipPath red")
  // Outside clipPath (30, 30): transparent
  let p_out = opt_unwrap(pm.pixel(30, 30))
  debug_assert(p_out.a == 0, "outside clipPath transparent")
  // Inside <use> at (30, 10): green
  let p_use = opt_unwrap(pm.pixel(30, 10))
  debug_assert(p_use.r == 0 && p_use.g == 255 && p_use.b == 0 && p_use.a == 255, "use node green")
  // Marker dot at (55, 20): blue
  let p_mk = opt_unwrap(pm.pixel(55, 20))
  debug_assert(p_mk.b > 200 && p_mk.a == 255, "marker dot blue")
}

test "svg: filter feOffset and feColorMatrix" {
  let src = "<svg xmlns='http://www.w3.org/2000/svg' width='60' height='40'>" +
    "<defs>" +
    "<filter id='f1' x='0' y='0' width='200%' height='200%'>" +
    "<feOffset in='SourceGraphic' dx='20' dy='0'/>" +
    "</filter>" +
    "</defs>" +
    "<rect x='5' y='10' width='15' height='20' fill='#ff0000' filter='url(#f1)'/>" +
    "</svg>"
  let pm = match render_svg_to_width(src, 60, Options::default()) {
    Some(p) => p
    None => {
      debug_assert(false, "filter render failed")
      opt_unwrap(skia::Pixmap::new(1, 1))
    }
  }
  // Original pos (10, 20) should now be empty due to feOffset dx=20
  let p_orig = opt_unwrap(pm.pixel(10, 20))
  debug_assert(p_orig.a == 0, "original position should be empty after feOffset")
  // Shifted pos (30, 20) should be red
  let p_shift = opt_unwrap(pm.pixel(30, 20))
  debug_assert(p_shift.r == 255 && p_shift.g == 0 && p_shift.b == 0 && p_shift.a == 255, "shifted position must be red")
}

test "svg: react.dev atom logo (negative viewBox + rotated ellipses, with and without xmlns)" {
  let react_ns = "<svg width=\"100%\" height=\"100%\" viewBox=\"-10.5 -9.45 21 18.9\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"0\" cy=\"0\" r=\"2\" fill=\"#087ea4\"/><g stroke=\"#087ea4\" stroke-width=\"1\" fill=\"none\"><ellipse rx=\"10\" ry=\"4.5\"/><ellipse rx=\"10\" ry=\"4.5\" transform=\"rotate(60)\"/><ellipse rx=\"10\" ry=\"4.5\" transform=\"rotate(120)\"/></g></svg>"
  let react_no_ns = "<svg width=\"100%\" height=\"100%\" viewBox=\"-10.5 -9.45 21 18.9\" fill=\"none\"><circle cx=\"0\" cy=\"0\" r=\"2\" fill=\"#087ea4\"/><g stroke=\"#087ea4\" stroke-width=\"1\" fill=\"none\"><ellipse rx=\"10\" ry=\"4.5\"/><ellipse rx=\"10\" ry=\"4.5\" transform=\"rotate(60)\"/><ellipse rx=\"10\" ry=\"4.5\" transform=\"rotate(120)\"/></g></svg>"
  let opt = Options::default()
  match svg_size(react_ns, opt) {
    Some((sw, sh)) => debug_assert((sw - 21.0f).abs() < 0.01f && (sh - 18.9f).abs() < 0.01f, "react_ns size 21x18.9")
    None => debug_assert(false, "react_ns svg_size returned None")
  }
  match svg_size(react_no_ns, opt) {
    Some((sw, sh)) => debug_assert((sw - 21.0f).abs() < 0.01f && (sh - 18.9f).abs() < 0.01f, "react_no_ns size 21x18.9")
    None => debug_assert(false, "react_no_ns svg_size returned None")
  }
  let (w, h, rgba) = opt_unwrap(rasterize(react_ns.to_bytes(), 128))
  let (w2, h2, rgba2) = opt_unwrap(rasterize(react_no_ns.to_bytes(), 128))
  debug_assert(w == 128 && h >= 114 && h <= 116, "react rasterize 128x115..116")
  debug_assert(w == w2 && h == h2 && rgba.length() == rgba2.length(), "with/without xmlns same size")
  for i in 0..<rgba.length() {
    debug_assert(rgba[i] == rgba2[i], "with/without xmlns byte identical")
  }
  // Center dot must be #087ea4 opaque
  let (cr, cg, cb, ca) = px_rgba(rgba, w, w / 2, h / 2)
  debug_assert(cr == 8 && cg == 126 && cb == 164 && ca == 255, "center dot #087ea4 opaque")
  // Bounding box must be centered and fill nearly the full canvas (not clipped or offset)
  let mut nz = 0
  let mut minx = w
  let mut maxx = -1
  let mut miny = h
  let mut maxy = -1
  for y in 0..<h {
    for x in 0..<w {
      if rgba[(y * w + x) * 4 + 3].to_int() > 0 {
        nz += 1
        if x < minx { minx = x }
        if x > maxx { maxx = x }
        if y < miny { miny = y }
        if y > maxy { maxy = y }
      }
    }
  }
  debug_assert(nz > 2500, "react atom has substantial rendered pixels")
  debug_assert(minx <= 3 && maxx >= w - 4, "react atom horizontally spans canvas")
  debug_assert(miny <= 3 && maxy >= h - 4, "react atom vertically spans canvas")
  // Check left/right and top/bottom symmetry of alpha distribution
  let mut asym_x = 0
  let mut asym_y = 0
  for y in 0..<h {
    for x in 0..<w {
      let a = rgba[(y * w + x) * 4 + 3].to_int()
      let ax = rgba[(y * w + (w - 1 - x)) * 4 + 3].to_int()
      let ay = rgba[((h - 1 - y) * w + x) * 4 + 3].to_int()
      let dx = a - ax
      let dy = a - ay
      if dx > 48 || dx < -48 { asym_x += 1 }
      if dy > 48 || dy < -48 { asym_y += 1 }
    }
  }
  debug_assert(asym_x < 40 && asym_y < 40, "react atom symmetric horizontally and vertically")
}

test "svg: rust-lang.org gear logo (no viewBox, width/height=144, compact arcs)" {
  let rust_simple = "<svg height=\"144\" width=\"144\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"72\" cy=\"72\" r=\"50\" fill=\"#000\"/></svg>"
  let rust_full = "<svg height=\"144\" width=\"144\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"m71.05 23.68c-26.06 0-47.27 21.22-47.27 47.27s21.22 47.27 47.27 47.27 47.27-21.22 47.27-47.27-21.22-47.27-47.27-47.27zm-.07 4.2a3.1 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm7.12 5.12a38.27 38.27 0 0 1 26.2 18.66l-3.67 8.28c-.63 1.43.02 3.11 1.44 3.75l7.06 3.13a38.27 38.27 0 0 1 .08 6.64h-3.93c-.39 0-.55.26-.55.64v1.8c0 4.24-2.39 5.17-4.49 5.4-2 .23-4.21-.84-4.49-2.06-1.18-6.63-3.14-8.04-6.24-10.49 3.85-2.44 7.85-6.05 7.85-10.87 0-5.21-3.57-8.49-6-10.1-3.42-2.25-7.2-2.7-8.22-2.7h-40.6a38.27 38.27 0 0 1 21.41-12.08l4.79 5.02c1.08 1.13 2.87 1.18 4 .09zm-44.2 23.02a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm74.15.14a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm-68.29.5h5.42v24.44h-10.94a38.27 38.27 0 0 1 -1.24-14.61l6.7-2.98c1.43-.64 2.08-2.31 1.44-3.74zm22.62.26h12.91c.67 0 4.71.77 4.71 3.8 0 2.51-3.1 3.41-5.65 3.41h-11.98zm0 17.56h9.89c.9 0 4.83.26 6.08 5.28.39 1.54 1.26 6.56 1.85 8.17.59 1.8 2.98 5.4 5.53 5.4h16.14a38.27 38.27 0 0 1 -3.54 4.1l-6.57-1.41c-1.53-.33-3.04.65-3.37 2.18l-1.56 7.28a38.27 38.27 0 0 1 -31.91-.15l-1.56-7.28c-.33-1.53-1.83-2.51-3.36-2.18l-6.43 1.38a38.27 38.27 0 0 1 -3.32-3.92h31.27c.35 0 .59-.06.59-.39v-11.06c0-.32-.24-.39-.59-.39h-9.15zm-14.43 25.33a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm46.05.14a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11z\"/><path d=\"m115.68 70.95a44.63 44.63 0 0 1 -44.63 44.63 44.63 44.63 0 0 1 -44.63-44.63 44.63 44.63 0 0 1 44.63-44.63 44.63 44.63 0 0 1 44.63 44.63zm-.84-4.31 6.96 4.31-6.96 4.31 5.98 5.59-7.66 2.87 4.78 6.65-8.09 1.32 3.4 7.46-8.19-.29 1.88 7.98-7.98-1.88.29 8.19-7.46-3.4-1.32 8.09-6.65-4.78-2.87 7.66-5.59-5.98-4.31 6.96-4.31-6.96-5.59 5.98-2.87-7.66-6.65 4.78-1.32-8.09-7.46 3.4.29-8.19-7.98 1.88 1.88-7.98-8.19.29 3.4-7.46-8.09-1.32 4.78-6.65-7.66-2.87 5.98-5.59-6.96-4.31 6.96-4.31-5.98-5.59 7.66-2.87-4.78-6.65 8.09-1.32-3.4-7.46 8.19.29-1.88-7.98 7.98 1.88-.29-8.19 7.46 3.4 1.32-8.09 6.65 4.78 2.87-7.66 5.59 5.98 4.31-6.96 4.31 6.96 5.59-5.98 2.87 7.66 6.65-4.78 1.32 8.09 7.46-3.4-.29 8.19 7.98-1.88-1.88 7.98 8.19-.29-3.4 7.46 8.09 1.32-4.78 6.65 7.66 2.87z\" fill-rule=\"evenodd\" stroke=\"#000\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\"/></svg>"
  let opt = Options::default()
  match svg_size(rust_simple, opt) {
    Some((sw, sh)) => debug_assert((sw - 144.0f).abs() < 0.01f && (sh - 144.0f).abs() < 0.01f, "rust_simple 144x144")
    None => debug_assert(false, "rust_simple svg_size returned None")
  }
  match svg_size(rust_full, opt) {
    Some((sw, sh)) => debug_assert((sw - 144.0f).abs() < 0.01f && (sh - 144.0f).abs() < 0.01f, "rust_full 144x144")
    None => debug_assert(false, "rust_full svg_size returned None")
  }
  let (w, h, rgba) = opt_unwrap(rasterize(rust_full.to_bytes(), 144))
  debug_assert(w == 144 && h == 144, "rust gear 144x144")
  let mut nz = 0
  let mut minx = w
  let mut maxx = -1
  let mut miny = h
  let mut maxy = -1
  for y in 0..<h {
    for x in 0..<w {
      if rgba[(y * w + x) * 4 + 3].to_int() > 0 {
        nz += 1
        if x < minx { minx = x }
        if x > maxx { maxx = x }
        if y < miny { miny = y }
        if y > maxy { maxy = y }
      }
    }
  }
  debug_assert(nz > 5000, "rust gear non-empty")
  // Gear outer teeth span roughly x in [18..124], y in [18..124]
  debug_assert(minx >= 14 && minx <= 24 && maxx >= 120 && maxx <= 130, "rust gear x bounds centered")
  debug_assert(miny >= 14 && miny <= 24 && maxy >= 120 && maxy <= 130, "rust gear y bounds centered")
  // Top hole of the gear (around 71, 31) should be transparent (not filled solid by broken arc)
  let (_, _, _, hole_a) = px_rgba(rgba, w, 71, 31)
  debug_assert(hole_a == 0, "rust gear top rivet hole is open")
}
