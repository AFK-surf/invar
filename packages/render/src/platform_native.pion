// Native platform bridge for packages/render (reuses packages/host Apple Metal offscreen engine).
// Ported 1:1 from libs/mbui/src/render/platform_native.mbt.

import "host"

extern "C" fn c_render_read_text(path : Ptr, path_len : Int64) -> Ptr = "pion_render_read_text"
extern "C" fn c_render_read_bytes(path : Ptr, path_len : Int64, out_len : Ptr) -> Ptr = "pion_render_read_bytes"
extern "C" fn c_render_arg(name : Ptr, name_len : Int64) -> Ptr = "pion_render_arg"
extern "C" fn c_render_say(s : Ptr, len : Int64) -> Unit = "pion_render_say"
extern "C" fn c_render_spin(ms : Double) -> Unit = "pion_render_spin"
extern "C" fn c_render_draw_timed(
  inst : Ptr,
  count : Int,
  r : Double,
  g : Double,
  b : Double,
  out : Ptr,
) -> Unit = "pion_render_draw_timed"
extern "C" fn c_render_snapshot_drawn(path : Ptr, path_len : Int64) -> Int = "pion_render_snapshot_drawn"

pub let supported : Bool = true

fn take_cstr(p : Ptr) -> String {
  let s = cstr_to_str(p)
  ptr_free(p)
  s
}

pub fn arg(name : String) -> String {
  take_cstr(c_render_arg(str_data_ptr(name), name.length().to_int64()))
}

pub fn init_offscreen(w : Double, h : Double, scale : Double) -> Unit {
  host::install()
  host::init_offscreen(w, h, scale)
}

pub fn draw(inst : Array[Double], count : Int, r : Double, g : Double, b : Double) -> Unit {
  let out = Array::make(2, 0.0)
  c_render_draw_timed(array_data_ptr(inst), count, r, g, b, array_data_ptr(out))
}

pub fn draw_gpu(inst : Array[Double], count : Int, r : Double, g : Double, b : Double) -> Double {
  let out = Array::make(2, 0.0)
  c_render_draw_timed(array_data_ptr(inst), count, r, g, b, array_data_ptr(out))
  out[1]
}

pub fn read_text(path : String) -> String {
  take_cstr(c_render_read_text(str_data_ptr(path), path.length().to_int64()))
}

pub fn read_bytes(path : String) -> Bytes {
  let len_box = Array::make(1, 0 as Int64)
  let p = c_render_read_bytes(str_data_ptr(path), path.length().to_int64(), array_data_ptr(len_box))
  let n = len_box[0].to_int()
  if n <= 0 {
    return "".to_bytes()
  }
  let b = bytes_from_ptr(p, n)
  ptr_free(p)
  b
}

pub fn say(s : String) -> Unit {
  c_render_say(str_data_ptr(s), s.length().to_int64())
}

pub fn spin(ms : Double) -> Unit {
  c_render_spin(ms)
}

pub fn snapshot(path : String) -> Bool {
  host::snapshot(path)
}

pub fn snapshot_drawn(path : String) -> Bool {
  c_render_snapshot_drawn(str_data_ptr(path), path.length().to_int64()) != 0
}
