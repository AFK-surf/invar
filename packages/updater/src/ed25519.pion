// Pure-Pion FIPS 180-4 SHA-512, SHA-256 helper, key_id, and RFC 8032 Ed25519 signature verification.
// Zero external BigInt dependencies: uses fixed 16-limb Int64 GF(2^255-19) arithmetic and extended Edwards coordinates.

import "codec"
import "zip"

// --- 64-bit unsigned helpers for SHA-512 ---

fn u64(hi : Int64, lo : Int64) -> Int64 {
  ((hi & 0xFFFFFFFFL) << 32) | (lo & 0xFFFFFFFFL)
}

fn ushr64(x : Int64, n : Int) -> Int64 {
  if n == 0 {
    x
  } else {
    let mask = (1L << (64 - n)) - 1L
    (x >> n) & mask
  }
}

fn rotr64(x : Int64, n : Int) -> Int64 {
  ushr64(x, n) | (x << (64 - n))
}

fn sha512_k() -> FixedArray[Int64] {
  let k = FixedArray::make(80, 0L)
  k[0] = u64(0x428a2f98L, 0xd728ae22L)
  k[1] = u64(0x71374491L, 0x23ef65cdL)
  k[2] = u64(0xb5c0fbcfL, 0xec4d3b2fL)
  k[3] = u64(0xe9b5dba5L, 0x8189dbbcL)
  k[4] = u64(0x3956c25bL, 0xf348b538L)
  k[5] = u64(0x59f111f1L, 0xb605d019L)
  k[6] = u64(0x923f82a4L, 0xaf194f9bL)
  k[7] = u64(0xab1c5ed5L, 0xda6d8118L)
  k[8] = u64(0xd807aa98L, 0xa3030242L)
  k[9] = u64(0x12835b01L, 0x45706fbeL)
  k[10] = u64(0x243185beL, 0x4ee4b28cL)
  k[11] = u64(0x550c7dc3L, 0xd5ffb4e2L)
  k[12] = u64(0x72be5d74L, 0xf27b896fL)
  k[13] = u64(0x80deb1feL, 0x3b1696b1L)
  k[14] = u64(0x9bdc06a7L, 0x25c71235L)
  k[15] = u64(0xc19bf174L, 0xcf692694L)
  k[16] = u64(0xe49b69c1L, 0x9ef14ad2L)
  k[17] = u64(0xefbe4786L, 0x384f25e3L)
  k[18] = u64(0x0fc19dc6L, 0x8b8cd5b5L)
  k[19] = u64(0x240ca1ccL, 0x77ac9c65L)
  k[20] = u64(0x2de92c6fL, 0x592b0275L)
  k[21] = u64(0x4a7484aaL, 0x6ea6e483L)
  k[22] = u64(0x5cb0a9dcL, 0xbd41fbd4L)
  k[23] = u64(0x76f988daL, 0x831153b5L)
  k[24] = u64(0x983e5152L, 0xee66dfabL)
  k[25] = u64(0xa831c66dL, 0x2db43210L)
  k[26] = u64(0xb00327c8L, 0x98fb213fL)
  k[27] = u64(0xbf597fc7L, 0xbeef0ee4L)
  k[28] = u64(0xc6e00bf3L, 0x3da88fc2L)
  k[29] = u64(0xd5a79147L, 0x930aa725L)
  k[30] = u64(0x06ca6351L, 0xe003826fL)
  k[31] = u64(0x14292967L, 0x0a0e6e70L)
  k[32] = u64(0x27b70a85L, 0x46d22ffcL)
  k[33] = u64(0x2e1b2138L, 0x5c26c926L)
  k[34] = u64(0x4d2c6dfcL, 0x5ac42aedL)
  k[35] = u64(0x53380d13L, 0x9d95b3dfL)
  k[36] = u64(0x650a7354L, 0x8baf63deL)
  k[37] = u64(0x766a0abbL, 0x3c77b2a8L)
  k[38] = u64(0x81c2c92eL, 0x47edaee6L)
  k[39] = u64(0x92722c85L, 0x1482353bL)
  k[40] = u64(0xa2bfe8a1L, 0x4cf10364L)
  k[41] = u64(0xa81a664bL, 0xbc423001L)
  k[42] = u64(0xc24b8b70L, 0xd0f89791L)
  k[43] = u64(0xc76c51a3L, 0x0654be30L)
  k[44] = u64(0xd192e819L, 0xd6ef5218L)
  k[45] = u64(0xd6990624L, 0x5565a910L)
  k[46] = u64(0xf40e3585L, 0x5771202aL)
  k[47] = u64(0x106aa070L, 0x32bbd1b8L)
  k[48] = u64(0x19a4c116L, 0xb8d2d0c8L)
  k[49] = u64(0x1e376c08L, 0x5141ab53L)
  k[50] = u64(0x2748774cL, 0xdf8eeb99L)
  k[51] = u64(0x34b0bcb5L, 0xe19b48a8L)
  k[52] = u64(0x391c0cb3L, 0xc5c95a63L)
  k[53] = u64(0x4ed8aa4aL, 0xe3418acbL)
  k[54] = u64(0x5b9cca4fL, 0x7763e373L)
  k[55] = u64(0x682e6ff3L, 0xd6b2b8a3L)
  k[56] = u64(0x748f82eeL, 0x5defb2fcL)
  k[57] = u64(0x78a5636fL, 0x43172f60L)
  k[58] = u64(0x84c87814L, 0xa1f0ab72L)
  k[59] = u64(0x8cc70208L, 0x1a6439ecL)
  k[60] = u64(0x90befffaL, 0x23631e28L)
  k[61] = u64(0xa4506cebL, 0xde82bde9L)
  k[62] = u64(0xbef9a3f7L, 0xb2c67915L)
  k[63] = u64(0xc67178f2L, 0xe372532bL)
  k[64] = u64(0xca273eceL, 0xea26619cL)
  k[65] = u64(0xd186b8c7L, 0x21c0c207L)
  k[66] = u64(0xeada7dd6L, 0xcde0eb1eL)
  k[67] = u64(0xf57d4f7fL, 0xee6ed178L)
  k[68] = u64(0x06f067aaL, 0x72176fbaL)
  k[69] = u64(0x0a637dc5L, 0xa2c898a6L)
  k[70] = u64(0x113f9804L, 0xbef90daeL)
  k[71] = u64(0x1b710b35L, 0x131c471bL)
  k[72] = u64(0x28db77f5L, 0x23047d84L)
  k[73] = u64(0x32caab7bL, 0x40c72493L)
  k[74] = u64(0x3c9ebe0aL, 0x15c9bebcL)
  k[75] = u64(0x431d67c4L, 0x9c100d4cL)
  k[76] = u64(0x4cc5d4beL, 0xcb3e42b6L)
  k[77] = u64(0x597f299cL, 0xfc657e2aL)
  k[78] = u64(0x5fcb6fabL, 0x3ad6faecL)
  k[79] = u64(0x6c44198cL, 0x4a475817L)
  k
}

/// Compute FIPS 180-4 SHA-512 digest (64 bytes) of `data`.
pub fn sha512(data : Bytes) -> Bytes {
  let k = sha512_k()
  let mut h0 = u64(0x6a09e667L, 0xf3bcc908L)
  let mut h1 = u64(0xbb67ae85L, 0x84caa73bL)
  let mut h2 = u64(0x3c6ef372L, 0xfe94f82bL)
  let mut h3 = u64(0xa54ff53aL, 0x5f1d36f1L)
  let mut h4 = u64(0x510e527fL, 0xade682d1L)
  let mut h5 = u64(0x9b05688cL, 0x2b3e6c1fL)
  let mut h6 = u64(0x1f83d9abL, 0xfb41bd6bL)
  let mut h7 = u64(0x5be0cd19L, 0x137e2179L)

  let n = data.length()
  let rem = (n + 17) % 128
  let pad_zero = if rem == 0 { 0 } else { 128 - rem }
  let total = n + 1 + pad_zero + 16
  let buf = FixedArray::make(total, 0)
  let mut i = 0
  while i < n {
    buf[i] = data[i].to_int()
    i += 1
  }
  buf[n] = 0x80
  let bit_len = n.to_int64() * 8L
  // Store 128-bit big-endian bit length (high 64 bits are 0 for in-memory buffers)
  let mut bi = 0
  while bi < 8 {
    buf[total - 1 - bi] = ((ushr64(bit_len, bi * 8)) & 0xFFL).to_int()
    bi += 1
  }

  let w = FixedArray::make(80, 0L)
  let mut off = 0
  while off < total {
    let mut j = 0
    while j < 16 {
      let p = off + j * 8
      w[j] = (buf[p].to_int64() << 56) |
      (buf[p + 1].to_int64() << 48) |
      (buf[p + 2].to_int64() << 40) |
      (buf[p + 3].to_int64() << 32) |
      (buf[p + 4].to_int64() << 24) |
      (buf[p + 5].to_int64() << 16) |
      (buf[p + 6].to_int64() << 8) |
      buf[p + 7].to_int64()
      j += 1
    }
    while j < 80 {
      let s0 = rotr64(w[j - 15], 1) ^ rotr64(w[j - 15], 8) ^ ushr64(w[j - 15], 7)
      let s1 = rotr64(w[j - 2], 19) ^ rotr64(w[j - 2], 61) ^ ushr64(w[j - 2], 6)
      w[j] = w[j - 16] + s0 + w[j - 7] + s1
      j += 1
    }
    let mut a = h0
    let mut b = h1
    let mut c = h2
    let mut d = h3
    let mut e = h4
    let mut f = h5
    let mut g = h6
    let mut h = h7
    let mut r = 0
    while r < 80 {
      let sig1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
      let ch = (e & f) ^ ((e ^ -1L) & g)
      let t1 = h + sig1 + ch + k[r] + w[r]
      let sig0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = sig0 + maj
      h = g
      g = f
      f = e
      e = d + t1
      d = c
      c = b
      b = a
      a = t1 + t2
      r += 1
    }
    h0 = h0 + a
    h1 = h1 + b
    h2 = h2 + c
    h3 = h3 + d
    h4 = h4 + e
    h5 = h5 + f
    h6 = h6 + g
    h7 = h7 + h
    off += 128
  }

  let words = [h0, h1, h2, h3, h4, h5, h6, h7]
  let sb = StringBuilder::new()
  for wd in words {
    let mut s = 56
    while s >= 0 {
      sb.write_byte(((ushr64(wd, s)) & 0xFFL).to_int() as Byte)
      s -= 8
    }
  }
  sb.to_string().to_bytes()
}

/// Compute lowercase hex SHA-512 digest of `data`.
pub fn sha512_hex(data : Bytes) -> String {
  codec::hex(sha512(data))
}

/// Compute lowercase hex SHA-256 digest of `data`.
pub fn sha256_hex(data : Bytes) -> String {
  zip::sha256(data)
}

/// Compute the 16-hex-char key fingerprint (`sha256(pk)[0..16]`) identifying an Ed25519 public key.
pub fn key_id(public_key : Bytes) -> String {
  zip::sha256(public_key).slice(0, 16)
}

// --- GF(2^255 - 19) arithmetic (16 limbs x 16 bits in Int64) ---

fn fe_zero() -> FixedArray[Int64] {
  FixedArray::make(16, 0L)
}

fn fe_one() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 1L
  r
}

fn fe_copy(a : FixedArray[Int64]) -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  let mut i = 0
  while i < 16 {
    r[i] = a[i]
    i += 1
  }
  r
}

fn fe_d() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 0x78a3L
  r[1] = 0x1359L
  r[2] = 0x4dcaL
  r[3] = 0x75ebL
  r[4] = 0xd8abL
  r[5] = 0x4141L
  r[6] = 0x0a4dL
  r[7] = 0x0070L
  r[8] = 0xe898L
  r[9] = 0x7779L
  r[10] = 0x4079L
  r[11] = 0x8cc7L
  r[12] = 0xfe73L
  r[13] = 0x2b6fL
  r[14] = 0x6ceeL
  r[15] = 0x5203L
  r
}

fn fe_d2() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 0xf159L
  r[1] = 0x26b2L
  r[2] = 0x9b94L
  r[3] = 0xebd6L
  r[4] = 0xb156L
  r[5] = 0x8283L
  r[6] = 0x149aL
  r[7] = 0x00e0L
  r[8] = 0xd130L
  r[9] = 0xeef3L
  r[10] = 0x80f2L
  r[11] = 0x198eL
  r[12] = 0xfce7L
  r[13] = 0x56dfL
  r[14] = 0xd9dcL
  r[15] = 0x2406L
  r
}

fn fe_bx() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 0xd51aL
  r[1] = 0x8f25L
  r[2] = 0x2d60L
  r[3] = 0xc956L
  r[4] = 0xa7b2L
  r[5] = 0x9525L
  r[6] = 0xc760L
  r[7] = 0x692cL
  r[8] = 0xdc5cL
  r[9] = 0xfdd6L
  r[10] = 0xe231L
  r[11] = 0xc0a4L
  r[12] = 0x53feL
  r[13] = 0xcd6eL
  r[14] = 0x36d3L
  r[15] = 0x2169L
  r
}

fn fe_by() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 0x6658L
  r[1] = 0x6666L
  r[2] = 0x6666L
  r[3] = 0x6666L
  r[4] = 0x6666L
  r[5] = 0x6666L
  r[6] = 0x6666L
  r[7] = 0x6666L
  r[8] = 0x6666L
  r[9] = 0x6666L
  r[10] = 0x6666L
  r[11] = 0x6666L
  r[12] = 0x6666L
  r[13] = 0x6666L
  r[14] = 0x6666L
  r[15] = 0x6666L
  r
}

fn fe_sqrtm1() -> FixedArray[Int64] {
  let r = FixedArray::make(16, 0L)
  r[0] = 0xa0b0L
  r[1] = 0x4a0eL
  r[2] = 0x1b27L
  r[3] = 0xc4eeL
  r[4] = 0xe478L
  r[5] = 0xad2fL
  r[6] = 0x1806L
  r[7] = 0x2f43L
  r[8] = 0xd7a7L
  r[9] = 0x3dfbL
  r[10] = 0x0099L
  r[11] = 0x2b4dL
  r[12] = 0xdf0bL
  r[13] = 0x4fc1L
  r[14] = 0x2480L
  r[15] = 0x2b83L
  r
}

fn fe_car(o : FixedArray[Int64]) -> Unit {
  let mut i = 0
  while i < 16 {
    o[i] = o[i] + 65536L
    let c = o[i] >> 16
    if i < 15 {
      o[i + 1] = o[i + 1] + c - 1L
    } else {
      o[0] = o[0] + 38L * (c - 1L)
    }
    o[i] = o[i] - (c << 16)
    i += 1
  }
}

fn fe_add(a : FixedArray[Int64], b : FixedArray[Int64]) -> FixedArray[Int64] {
  let o = FixedArray::make(16, 0L)
  let mut i = 0
  while i < 16 {
    o[i] = a[i] + b[i]
    i += 1
  }
  o
}

fn fe_sub(a : FixedArray[Int64], b : FixedArray[Int64]) -> FixedArray[Int64] {
  let o = FixedArray::make(16, 0L)
  let mut i = 0
  while i < 16 {
    o[i] = a[i] - b[i]
    i += 1
  }
  o
}

fn fe_mul(a : FixedArray[Int64], b : FixedArray[Int64]) -> FixedArray[Int64] {
  let t = FixedArray::make(31, 0L)
  let mut i = 0
  while i < 16 {
    let mut j = 0
    while j < 16 {
      t[i + j] = t[i + j] + a[i] * b[j]
      j += 1
    }
    i += 1
  }
  let o = FixedArray::make(16, 0L)
  i = 0
  while i < 15 {
    o[i] = t[i] + 38L * t[i + 16]
    i += 1
  }
  o[15] = t[15]
  fe_car(o)
  fe_car(o)
  o
}

fn fe_sq(a : FixedArray[Int64]) -> FixedArray[Int64] {
  fe_mul(a, a)
}

fn fe_sel(p : FixedArray[Int64], q : FixedArray[Int64], b : Int64) -> Unit {
  let c = -b
  let mut i = 0
  while i < 16 {
    let t = c & (p[i] ^ q[i])
    p[i] = p[i] ^ t
    q[i] = q[i] ^ t
    i += 1
  }
}

fn fe_to_bytes(n : FixedArray[Int64]) -> FixedArray[Int] {
  let t = fe_copy(n)
  fe_car(t)
  fe_car(t)
  fe_car(t)
  let m = FixedArray::make(16, 0L)
  let mut j = 0
  while j < 2 {
    m[0] = t[0] - 0xffedL
    let mut i = 1
    while i < 15 {
      m[i] = t[i] - 0xffffL - ((m[i - 1] >> 16) & 1L)
      m[i - 1] = m[i - 1] & 0xffffL
      i += 1
    }
    m[15] = t[15] - 0x7fffL - ((m[14] >> 16) & 1L)
    let b = (m[15] >> 16) & 1L
    m[14] = m[14] & 0xffffL
    fe_sel(t, m, 1L - b)
    j += 1
  }
  let out = FixedArray::make(32, 0)
  let mut i = 0
  while i < 16 {
    out[2 * i] = (t[i] & 0xffL).to_int()
    out[2 * i + 1] = ((t[i] >> 8) & 0xffL).to_int()
    i += 1
  }
  out
}

fn fe_from_bytes(b : Bytes) -> FixedArray[Int64] {
  let o = FixedArray::make(16, 0L)
  let mut i = 0
  while i < 16 {
    o[i] = b[2 * i].to_int().to_int64() + (b[2 * i + 1].to_int().to_int64() << 8)
    i += 1
  }
  o[15] = o[15] & 0x7fffL
  o
}

fn fe_neq(a : FixedArray[Int64], b : FixedArray[Int64]) -> Bool {
  let c = fe_to_bytes(a)
  let d = fe_to_bytes(b)
  let mut diff = 0
  let mut i = 0
  while i < 32 {
    diff = diff | (c[i] ^ d[i])
    i += 1
  }
  diff != 0
}

fn fe_par(a : FixedArray[Int64]) -> Int {
  let d = fe_to_bytes(a)
  d[0] & 1
}

/// Compute `a^(p - 2) = a^(2^255 - 21)` in GF(2^255 - 19).
fn fe_inv(a : FixedArray[Int64]) -> FixedArray[Int64] {
  let mut c = fe_copy(a)
  let mut i = 253
  while i >= 0 {
    c = fe_sq(c)
    if i != 2 && i != 4 {
      c = fe_mul(c, a)
    }
    i -= 1
  }
  c
}

/// Compute `a^((p - 5) / 8) = a^(2^252 - 3)` in GF(2^255 - 19).
fn fe_pow2523(a : FixedArray[Int64]) -> FixedArray[Int64] {
  let mut c = fe_copy(a)
  let mut i = 250
  while i >= 0 {
    c = fe_sq(c)
    if i != 1 {
      c = fe_mul(c, a)
    }
    i -= 1
  }
  c
}

// --- Extended Twisted Edwards Point (X, Y, Z, T) ---

struct EdPoint {
  x : FixedArray[Int64]
  y : FixedArray[Int64]
  z : FixedArray[Int64]
  t : FixedArray[Int64]
}

fn ed_neutral() -> EdPoint {
  EdPoint::{ x: fe_zero(), y: fe_one(), z: fe_one(), t: fe_zero() }
}

fn ed_base() -> EdPoint {
  let bx = fe_bx()
  let by = fe_by()
  EdPoint::{ x: bx, y: by, z: fe_one(), t: fe_mul(bx, by) }
}

fn ed_add(p : EdPoint, q : EdPoint) -> EdPoint {
  let a = fe_mul(fe_sub(p.y, p.x), fe_sub(q.y, q.x))
  let b = fe_mul(fe_add(p.y, p.x), fe_add(q.y, q.x))
  let c = fe_mul(fe_mul(p.t, q.t), fe_d2())
  let d = fe_mul(p.z, q.z)
  let d2 = fe_add(d, d)
  let e = fe_sub(b, a)
  let f = fe_sub(d2, c)
  let g = fe_add(d2, c)
  let h = fe_add(b, a)
  EdPoint::{
    x: fe_mul(e, f),
    y: fe_mul(g, h),
    z: fe_mul(f, g),
    t: fe_mul(e, h),
  }
}

fn ed_cswap(p : EdPoint, q : EdPoint, b : Int64) -> Unit {
  fe_sel(p.x, q.x, b)
  fe_sel(p.y, q.y, b)
  fe_sel(p.z, q.z, b)
  fe_sel(p.t, q.t, b)
}

fn ed_scalarmult(q_in : EdPoint, s : FixedArray[Int]) -> EdPoint {
  let mut p = ed_neutral()
  let mut q = EdPoint::{
    x: fe_copy(q_in.x),
    y: fe_copy(q_in.y),
    z: fe_copy(q_in.z),
    t: fe_copy(q_in.t),
  }
  let mut i = 255
  while i >= 0 {
    let b = ((s[i / 8] >> (i & 7)) & 1).to_int64()
    ed_cswap(p, q, b)
    q = ed_add(q, p)
    p = ed_add(p, p)
    ed_cswap(p, q, b)
    i -= 1
  }
  p
}

fn ed_pack(p : EdPoint) -> FixedArray[Int] {
  let zi = fe_inv(p.z)
  let tx = fe_mul(p.x, zi)
  let ty = fe_mul(p.y, zi)
  let out = fe_to_bytes(ty)
  out[31] = out[31] ^ (fe_par(tx) << 7)
  out
}

/// Unpack a 32-byte compressed Ed25519 point and negate X (returning `-A` for `R = [S]B + [h](-A)`).
fn ed_unpack_neg(pk : Bytes) -> Option[EdPoint] {
  let y = fe_from_bytes(pk)
  let y2 = fe_sq(y)
  let num = fe_sub(y2, fe_one())
  let den = fe_add(fe_mul(y2, fe_d()), fe_one())
  let den2 = fe_sq(den)
  let den3 = fe_mul(den2, den)
  let den7 = fe_mul(fe_sq(den3), den)
  let mut x = fe_mul(fe_mul(num, den3), fe_pow2523(fe_mul(num, den7)))
  let chk = fe_mul(fe_sq(x), den)
  if fe_neq(chk, num) {
    x = fe_mul(x, fe_sqrtm1())
  }
  let chk2 = fe_mul(fe_sq(x), den)
  if fe_neq(chk2, num) {
    return None
  }
  let sign_bit = (pk[31].to_int() >> 7) & 1
  if fe_par(x) == sign_bit {
    x = fe_sub(fe_zero(), x)
  }
  let t = fe_mul(x, y)
  Some(EdPoint::{ x, y, z: fe_one(), t })
}

// --- Scalar mod L reduction & canonical S check ---

fn ed_order_l() -> FixedArray[Int64] {
  let l = FixedArray::make(32, 0L)
  l[0] = 0xedL
  l[1] = 0xd3L
  l[2] = 0xf5L
  l[3] = 0x5cL
  l[4] = 0x1aL
  l[5] = 0x63L
  l[6] = 0x12L
  l[7] = 0x58L
  l[8] = 0xd6L
  l[9] = 0x9cL
  l[10] = 0xf7L
  l[11] = 0xa2L
  l[12] = 0xdeL
  l[13] = 0xf9L
  l[14] = 0xdeL
  l[15] = 0x14L
  l[31] = 0x10L
  l
}

fn scalar_is_canonical(sig : Bytes) -> Bool {
  let l = ed_order_l()
  let mut i = 31
  while i >= 0 {
    let sb = sig[32 + i].to_int().to_int64()
    let lb = l[i]
    if sb < lb {
      return true
    }
    if sb > lb {
      return false
    }
    i -= 1
  }
  false
}

fn reduce_mod_l(digest : Bytes) -> FixedArray[Int] {
  let l = ed_order_l()
  let x = FixedArray::make(64, 0L)
  let mut i = 0
  while i < 64 {
    x[i] = digest[i].to_int().to_int64()
    i += 1
  }
  i = 63
  while i >= 32 {
    let mut carry = 0L
    let mut j = i - 32
    let mut k = i - 12
    while j < k {
      x[j] = x[j] + carry - 16L * x[i] * l[j - (i - 32)]
      carry = (x[j] + 128L) >> 8
      x[j] = x[j] - (carry << 8)
      j += 1
    }
    x[j] = x[j] + carry
    x[i] = 0L
    i -= 1
  }
  let mut carry = 0L
  let mut j = 0
  while j < 32 {
    x[j] = x[j] + carry - (x[31] >> 4) * l[j]
    carry = x[j] >> 8
    x[j] = x[j] & 255L
    j += 1
  }
  j = 0
  while j < 32 {
    x[j] = x[j] - carry * l[j]
    j += 1
  }
  let r = FixedArray::make(32, 0)
  i = 0
  while i < 32 {
    if i + 1 < 32 {
      x[i + 1] = x[i + 1] + (x[i] >> 8)
    }
    r[i] = (x[i] & 255L).to_int()
    i += 1
  }
  r
}

/// Verify an RFC 8032 Ed25519 signature (`64` bytes) over `message` under `public_key` (`32` bytes).
pub fn verify_ed25519(public_key : Bytes, message : Bytes, signature : Bytes) -> Bool {
  if public_key.length() != 32 || signature.length() != 64 {
    return false
  }
  if !scalar_is_canonical(signature) {
    return false
  }
  let neg_a = match ed_unpack_neg(public_key) {
    Some(pt) => pt
    None => return false
  }
  // Compute h = SHA-512(R || A || M) mod L
  let msg_len = message.length()
  let h_sb = StringBuilder::new()
  let mut i = 0
  while i < 32 {
    h_sb.write_byte(signature[i])
    i += 1
  }
  i = 0
  while i < 32 {
    h_sb.write_byte(public_key[i])
    i += 1
  }
  i = 0
  while i < msg_len {
    h_sb.write_byte(message[i])
    i += 1
  }
  let h = reduce_mod_l(sha512(h_sb.to_string().to_bytes()))

  let s = FixedArray::make(32, 0)
  i = 0
  while i < 32 {
    s[i] = signature[32 + i].to_int()
    i += 1
  }

  let sb = ed_scalarmult(ed_base(), s)
  let ha = ed_scalarmult(neg_a, h)
  let r_calc = ed_pack(ed_add(sb, ha))

  let mut diff = 0
  i = 0
  while i < 32 {
    diff = diff | (r_calc[i] ^ signature[i].to_int())
    i += 1
  }
  diff == 0
}
