///|
pub fn modified_combining_class(c : Int) -> Int {
  if c == 0x1A60 || c == 0x0FC6 {
    return 254
  }
  if c == 0x0F39 {
    return 127
  }
  modified_ccc[combining_class(c)]
}

///|
pub fn is_emoji_extended_pictographic(u : Int) -> Bool {
  if u < 0 || u >= 131070 {
    return false
  }
  let b4 = fn(i : Int) { (emoji_u8[i >> 1] >> ((i & 1) << 2)) & 15 }
  let i = (emoji_u8[64 + ((b4(u >> 6 >> 4) << 4) + ((u >> 6) & 15))] << 6) + (u & 63)
  ((emoji_u8[224 + (i >> 3)] >> (i & 7)) & 1) != 0
}

///|
pub fn is_default_ignorable(ch : Int) -> Bool {
  let plane = ch >> 16
  if plane == 0 {
    match ch >> 8 {
      0x00 => ch == 0x00AD
      0x03 => ch == 0x034F
      0x06 => ch == 0x061C
      0x17 => ch >= 0x17B4 && ch <= 0x17B5
      0x18 => ch >= 0x180B && ch <= 0x180F
      0x20 => (ch >= 0x200B && ch <= 0x200F) || (ch >= 0x202A && ch <= 0x202E) || (ch >= 0x2060 && ch <= 0x206F)
      0xFE => (ch >= 0xFE00 && ch <= 0xFE0F) || ch == 0xFEFF
      0xFF => ch >= 0xFFF0 && ch <= 0xFFF8
      _ => false
    }
  } else {
    match plane {
      0x01 => ch >= 0x1D173 && ch <= 0x1D17A
      0x0E => ch >= 0xE0000 && ch <= 0xE0FFF
      _ => false
    }
  }
}

///|
pub fn is_variation_selector(c : Int) -> Bool {
  (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xE0100 && c <= 0xE01EF)
}

///|
/// The space a character is when the font has no glyph for it (space_fallback::SpaceCode).
fn space_fallback(c : Int) -> Int {
  match c {
    0x0020 | 0x00A0 => 18
    0x2000 | 0x2002 => 2
    0x2001 | 0x2003 | 0x3000 => 1
    0x2004 => 3
    0x2005 => 4
    0x2006 => 6
    0x2007 => 19
    0x2008 => 20
    0x2009 => 5
    0x200A => 16
    0x202F => 21
    0x205F => 17
    _ => 0
  }
}

///|
fn hangul_compose(a : Int, b : Int) -> Option[Int] {
  let s_base = 0xAC00
  let l_base = 0x1100
  let v_base = 0x1161
  let t_base = 0x11A7
  let t_count = 28
  let n_count = 21 * 28
  let s_count = 19 * n_count
  if l_base <= a && a < l_base + 19 && v_base <= b && b < v_base + 21 {
    Option::Some(s_base + (a - l_base) * n_count + (b - v_base) * t_count)
  } else if s_base <= a && a <= s_base + s_count - t_count && t_base < b && b < t_base + t_count &&
  mbt_compat::mod_checked_i32((a - s_base), t_count) == 0 {
    Option::Some(a + (b - t_base))
  } else {
    Option::None
  }
}

///|
fn hangul_decompose(ab : Int) -> Option[(Int, Int)] {
  let s_base = 0xAC00
  let t_count = 28
  let n_count = 21 * 28
  let s_count = 19 * n_count
  let si = ab - s_base
  if si < 0 || si >= s_count {
    return Option::None
  }
  if mbt_compat::mod_checked_i32(si, t_count) != 0 {
    Option::Some((s_base + mbt_compat::div_checked_i32(si, t_count) * t_count, 0x11A7 + mbt_compat::mod_checked_i32(si, t_count)))
  } else {
    Option::Some((0x1100 + mbt_compat::div_checked_i32(si, n_count), 0x1161 + mbt_compat::div_checked_i32(mbt_compat::mod_checked_i32(si, n_count), t_count)))
  }
}

///|
pub fn compose(a : Int, b : Int) -> Option[Int] {
  match hangul_compose(a, b) {
    Option::Some(r) => return Option::Some(r)
    Option::None => ()
  }
  let u = if a >= 0 && a < 0x800 && b >= 0x300 && b < 0x380 {
    let k = (((a & 0x7FF).to_int64() << 21) | ((b & 0x7F).to_int64() << 14))
    let mask = (0x7FFL << 21) | (0x7FL << 14)
    let mut lo = 0
    let mut hi = ucd_dm2_u32_map.length() - 1
    let mut found = 0
    while lo <= hi {
      let mid = (lo + hi) / 2
      let key = ucd_dm2_u32_map[mid] & mask
      if key < k {
        lo = mid + 1
      } else if key > k {
        hi = mid - 1
      } else {
        found = (ucd_dm2_u32_map[mid] & 0x3FFFL).to_int()
        break
      }
    }
    found
  } else {
    let k = (a.to_int64() << 42) | (b.to_int64() << 21)
    let mask = (0x1FFFFFL << 42) | (0x1FFFFFL << 21)
    let mut lo = 0
    let mut hi = ucd_dm2_u64_map.length() - 1
    let mut found = 0
    while lo <= hi {
      let mid = (lo + hi) / 2
      let key = ucd_dm2_u64_map[mid] & mask
      if key < k {
        lo = mid + 1
      } else if key > k {
        hi = mid - 1
      } else {
        found = (ucd_dm2_u64_map[mid] & 0x1FFFFFL).to_int()
        break
      }
    }
    found
  }
  if u == 0 {
    Option::None
  } else {
    Option::Some(u)
  }
}

///|
/// A character's canonical decomposition: (a, 0) for a singleton, (a, b) for a pair.
pub fn decompose(ab : Int) -> Option[(Int, Int)] {
  match hangul_decompose(ab) {
    Option::Some(r) => return Option::Some(r)
    Option::None => ()
  }
  let mut i = ucd_dm(ab)
  if i == 0 {
    return Option::None
  }
  i -= 1
  let p0 = ucd_dm1_p0_map.length()
  let p2 = ucd_dm1_p2_map.length()
  if i < p0 + p2 {
    let a = if i < p0 { ucd_dm1_p0_map[i] } else { 0x20000 | ucd_dm1_p2_map[i - p0] }
    return Option::Some((a, 0))
  }
  i -= p0 + p2
  if i < ucd_dm2_u32_map.length() {
    let v = ucd_dm2_u32_map[i]
    return Option::Some(((v >> 21).to_int(), (((v >> 14) & 0x7FL) | 0x300L).to_int()))
  }
  i -= ucd_dm2_u32_map.length()
  let v = ucd_dm2_u64_map[i]
  Option::Some(((v >> 42).to_int(), ((v >> 21) & 0x1FFFFFL).to_int()))
}

///|
/// A four-letter tag as an Int.
pub fn tag(s : String) -> Int {
  let mut v = 0
  for i in 0..<4 {
    let c = if i < mbt_compat::utf16_len(s) { s.code_unit_at(i).to_int() } else { 0x20 }
    v = (v << 8) | (c & 0xFF)
  }
  v
}
