// Tables written as text rather than array literals: text is data read once. Each number zigzagged
// (0, -1, 1, -2 ... as 0, 1, 2, 3 ...) and written five bits at a time, lowest first, as characters from '0': 32 and up
// for a group with more after it, below 32 for its last. Characters outside '0' to 'o' (a line's end) are skipped.
// Ported from libs/mbui/src/shape/packed.mbt.

/// The numbers of a table written as text, 64-bit.
pub fn packed_int64s(s : String) -> FixedArray[Int64] {
  let out : Array[Int64] = []
  let z64 = 0.to_int64()
  let o64 = 1.to_int64()
  let mask63 = (o64 << 63) - o64
  let mut acc = z64
  let mut shift = 0
  let n = s.length()
  for i in 0..<n {
    let d = s.code_unit_at(i) - 48
    if d < 0 || d > 63 {
      continue
    }
    acc = acc | ((d & 31).to_int64() << shift)
    shift += 5
    if d < 32 {
      let half = (acc >> 1) & mask63
      let sign = z64 - (acc & o64)
      out.push(half ^ sign)
      acc = z64
      shift = 0
    }
  }
  let res = FixedArray::make(out.length(), z64)
  for i in 0..<out.length() {
    res[i] = out[i]
  }
  res
}

/// The numbers of a table written as text.
pub fn packed_ints(s : String) -> FixedArray[Int] {
  let wide = packed_int64s(s)
  let res = FixedArray::make(wide.length(), 0)
  for i in 0..<wide.length() {
    res[i] = wide[i].to_int()
  }
  res
}

fn i32_popcnt(x0 : Int) -> Int {
  let mut x = x0
  let mut c = 0
  for _ in 0..<32 {
    c += x & 1
    x = x >> 1
  }
  c
}

fn i32_ctz(x0 : Int) -> Int {
  if x0 == 0 {
    return 32
  }
  let mut x = x0
  let mut c = 0
  while (x & 1) == 0 {
    c += 1
    x = x >> 1
  }
  c
}

fn i32_clz(x0 : Int) -> Int {
  if x0 == 0 {
    return 32
  }
  let mut c = 0
  let mut bit = 31
  while bit >= 0 {
    if ((x0 >> bit) & 1) != 0 {
      break
    }
    c += 1
    bit -= 1
  }
  c
}

fn u32_of_i32(x : Int) -> Int64 {
  x.to_int64() & ((1.to_int64() << 32) - 1.to_int64())
}

fn u32_cmp(a : Int, b : Int) -> Int {
  let ua = u32_of_i32(a)
  let ub = u32_of_i32(b)
  if ua < ub { -1 } else if ua > ub { 1 } else { 0 }
}

fn u32_shr(x : Int, shift : Int) -> Int {
  (u32_of_i32(x) >> shift).to_int()
}
