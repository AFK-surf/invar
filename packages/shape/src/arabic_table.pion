// harfrust's Arabic joining types (ArabicShaping-18.0.0), packed.
// Ported from libs/mbui/src/shape/arabic_table.mbt.

let arabic_joining_u8_str : String = "0P14000608000000000000000000000000000000000:00000000000000000000000P6^8B00000000000000000000000000000000000000000000000000000D00000000@P1`1P2`2P30`30P4`4P50000`5P6`600000P7`70000000P8000000000`800P900000`9000000P:`:P;`;P<00`<P=00000000`=P>00000000@B00DFH22J000LN224482222P1R1T160V10X10Z1\\1^12`1000b12d12f1h180j1222l10n1P2:R2T2V2X244Z2\\2<02^2`2:2>00b2000d2f20022222222222>h22222j2000l2000n2000000P3<00222222R30T3V3X3Z3\\3^300`3b3d300f300h3222j3000l300n3P4R400000000T42V40X4000Z42\\400000^4`4b4d4000000000000060600000022222222f4h4000000^7^7^7^7V3V3V3V3T2T2T2T2^7^7>^7T2V3V3V3V2V3V3V30^7^7^7V7^7^7^7000^7P7>^7^76T2T2V2V2V3V3V2T2T3V3V3T3V7^7^7^7^7^7V3^2T2P2T2T3V2T2T2T2T2V2V2V3T2^2^7^7^7^7T2^7V3V7^3^7^7^7^6X7V3V5Z2T2V3V3T3T3Z3T3V5^7^7^2V3V2T2V3V3V3V2T3V3V2V2T3V3^7V3V3V3V3V7^7^7^7V7^7^7T3V3V3T2V3V3T3T2T7^7^7^76V3V3P2V2T7^7^7T2T3V36P3V3V3T3V3T24T3V2T3V3V3^7P7^7^7^7^7^7P3^7V7^7P700P6\\3V7V7^7^7^7^7P3^7^7^7^7>^7^7^70V32^7^7V3V3V2P2P24P1T2T2T3V3V1V3V3V2V3V20T7^7^7^3V3V2V2V2T2V3V2V3T3T2V2^7^7^7^2T2T36R3V3V3V3V3T3^7^7^7T3V7V3^1R1R1R1R1R1R1R1R1R1R1R7V3V2V3V3V3V36^7^3V3T7^7V3V3T2V3V3^7^7^76V3T24V2T3V2V3P3T260P2V1^7^7V3V3^7^7^7^6^7^7"

struct ArabicTables {
  mut arabic_joining_u8 : Option[FixedArray[Int]]
}

let arabic_tables : ArabicTables = ArabicTables::{ arabic_joining_u8: None }

fn get_arabic_joining_u8() -> FixedArray[Int] {
  match arabic_tables.arabic_joining_u8 {
    Some(t) => t
    None => {
      let t = packed_ints(arabic_joining_u8_str)
      arabic_tables.arabic_joining_u8 = Some(t)
      t
    }
  }
}

fn arabic_joining_b4(base : Int, i : Int) -> Int {
  let u8t = get_arabic_joining_u8()
  (u8t[base + (i >> 1)] >> ((i & 1) << 2)) & 15
}

/// The joining type: 0 U, 1 L, 2 R, 3 D, 4 alaph, 5 dalath-rish, 6 T, 7 by general category.
fn arabic_joining_type_raw(u : Int) -> Int {
  if u < 125260 && u >= 0 {
    let u8t = get_arabic_joining_u8()
    let a = arabic_joining_b4(0, u >> 9)
    let b = u8t[123 + (a << 3) + ((u >> 6) & 7)]
    let c = u8t[209 + b + ((u >> 3) & 7)]
    arabic_joining_b4(441, (c << 3) + (u & 7))
  } else {
    7
  }
}
