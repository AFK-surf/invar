// Companion compatibility helpers preserved for Invar downstream callers.

pub fn dir_to_string(d : Direction) -> String {
  match d {
    Direction::LeftToRight => "LeftToRight"
    Direction::RightToLeft => "RightToLeft"
    Direction::TopToBottom => "TopToBottom"
    Direction::BottomToTop => "BottomToTop"
  }
}

pub fn Buffer::set_script(self : Buffer, s : Int) -> Unit {
  self.script = s
}
