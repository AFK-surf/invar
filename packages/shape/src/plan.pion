// The shape plan: which OpenType script and language system
// a run uses, the features the default shaper asks for, each feature's mask bits, and the lookups to apply in
// order, stage by stage.
// Ported from libs/mbui/src/shape/plan.mbt.

import "font"

/// A feature asked for: `value` from cluster `start` to `end` (-1: to the end); global when it covers all.
pub struct Feature {
  pub tag : Int
  pub value : Int
  pub start : Int
  pub end : Int
}

pub fn Feature::new(name : String, value : Int) -> Feature {
  Feature::{ tag: tag(name), value, start: 0, end: -1 }
}

fn Feature::is_global(self : Feature) -> Bool {
  self.start == 0 && self.end == -1
}

let f_global : Int = 0x0001
let f_has_fallback : Int = 0x0002
let f_manual_zwnj : Int = 0x0004
let f_manual_zwj : Int = 0x0008
let f_global_search : Int = 0x0010
let f_random : Int = 0x0020
let f_per_syllable : Int = 0x0040
let max_feature_value : Int = 255
let global_bit_shift : Int = 31
let global_bit_mask : Int = 1 << 31

struct FeatureInfo {
  tag : Int
  seq : Int
  mut max_value : Int
  mut flags : Int
  mut default_value : Int
  stage : Array[Int]
}

struct FeatureMap {
  tag : Int
  index : Array[Int]
  stage : Array[Int]
  shift : Int
  mask : Int
  one_mask : Int
  auto_zwnj : Bool
  auto_zwj : Bool
  random : Bool
  per_syllable : Bool
}

struct LookupMap {
  index : Int
  auto_zwnj : Bool
  auto_zwj : Bool
  random : Bool
  mask : Int
  per_syllable : Bool
}

pub struct ShapePlan {
  pub direction : Direction
  pub script : Int
  ot : OtData
  features : Array[FeatureMap]
  global_mask : Int
  /// GSUB's and GPOS's lookups, and where each stage's end
  lookups : Array[Array[LookupMap]]
  /// each stage's end in the lookups and the pause run after it (0 none; the Indic shaper's 1 to 4)
  stages : Array[Array[(Int, Int)]]
  frac_mask : Int
  numr_mask : Int
  dnom_mask : Int
  rtlm_mask : Int
  kern_mask : Int
  requested_kerning : Bool
  has_frac : Bool
  zero_marks : Bool
  fallback_glyph_classes : Bool
  fallback_mark_positioning : Bool
  adjust_mark_positioning_when_zeroing : Bool
  apply_gpos : Bool
  apply_kern : Bool
  user_features : Array[Feature]
  shaper : Int
  /// the Arabic shaper's mask for each joining action (the last, no action, is 0)
  arabic_masks : Array[Int]
  indic : Option[IndicPlan]
}

fn ShapePlan::get_mask(self : ShapePlan, t : Int) -> (Int, Int) {
  for f in self.features {
    if f.tag == t {
      return (f.mask, f.shift)
    }
  }
  (0, 0)
}

/// The OpenType script tags for a Unicode script, most preferred first.
fn script_tags(script : Int) -> Array[Int] {
  if script == 0 {
    return []
  }
  let tags : Array[Int] = []
  let new_tag = match script {
    0x42656E67 => tag("bng2") // Beng
    0x44657661 => tag("dev2") // Deva
    0x47756A72 => tag("gjr2") // Gujr
    0x47757275 => tag("gur2") // Guru
    0x4B6E6461 => tag("knd2") // Knda
    0x4D6C796D => tag("mlm2") // Mlym
    0x4F727961 => tag("ory2") // Orya
    0x54616D6C => tag("tml2") // Taml
    0x54656C75 => tag("tel2") // Telu
    0x4D796D72 => tag("mym2") // Mymr
    _ => 0
  }
  if new_tag != 0 {
    if new_tag != tag("mym2") {
      tags.push((new_tag & (-256)) | 0x33)
    }
    tags.push(new_tag)
  }
  let old = match script {
    0x5A6D7468 => tag("math") // Zmth
    0x48697261 => tag("kana") // Hira
    0x4C616F6F => tag("lao ")
    0x59696969 => tag("yi  ")
    0x4E6B6F6F => tag("nko ")
    0x56616969 => tag("vai ")
    _ => script | 0x20000000
  }
  tags.push(old)
  tags
}

fn bool_cmp(a : Bool, b : Bool) -> Int {
  if a == b {
    0
  } else if b {
    -1
  } else {
    1
  }
}

fn feature_info_cmp(a : FeatureInfo, b : FeatureInfo) -> Int {
  let c = u32_cmp(a.tag, b.tag)
  if c != 0 {
    c
  } else if a.seq < b.seq {
    -1
  } else if a.seq > b.seq {
    1
  } else {
    0
  }
}

fn sort_feature_infos(arr : Array[FeatureInfo]) -> Unit {
  for i in 1..<arr.length() {
    let item = arr[i]
    let mut j = i
    while j > 0 && feature_info_cmp(arr[j - 1], item) > 0 {
      arr[j] = arr[j - 1]
      j -= 1
    }
    arr[j] = item
  }
}

fn lookup_map_cmp(a : LookupMap, b : LookupMap) -> Int {
  if a.index != b.index {
    return if a.index < b.index { -1 } else { 1 }
  }
  let c1 = bool_cmp(a.auto_zwnj, b.auto_zwnj)
  if c1 != 0 { return c1 }
  let c2 = bool_cmp(a.auto_zwj, b.auto_zwj)
  if c2 != 0 { return c2 }
  let c3 = bool_cmp(a.random, b.random)
  if c3 != 0 { return c3 }
  let c4 = u32_cmp(a.mask, b.mask)
  if c4 != 0 { return c4 }
  bool_cmp(a.per_syllable, b.per_syllable)
}

fn sort_lookup_maps(arr : Array[LookupMap]) -> Unit {
  for i in 1..<arr.length() {
    let item = arr[i]
    let mut j = i
    while j > 0 && lookup_map_cmp(arr[j - 1], item) > 0 {
      arr[j] = arr[j - 1]
      j -= 1
    }
    arr[j] = item
  }
}

fn ShapePlan::new(ot : OtData, direction : Direction, script : Int, user_features : Array[Feature]) -> ShapePlan {
  let d = ot.data
  let tables : Array[Option[LayoutTable]] = [ot.gsub, ot.gpos]
  let stags = script_tags(script)
  let script_index = [-1, -1]
  let lang_index = [-1, -1]
  let chosen_script = [0, 0]
  for ti in 0..<2 {
    let table = match tables[ti] {
      Some(t) => t
      None => continue
    }
    match table.select_script(d, stags) {
      Some((idx, _found, t)) => {
        script_index[ti] = idx
        chosen_script[ti] = t
        lang_index[ti] = table.select_language(d, idx, [])
      }
      None => ()
    }
  }
  // collect_features
  let infos : Array[FeatureInfo] = []
  let current_stage = [0, 0]
  let pauses : Array[Array[(Int, Int)]] = [[], []]
  let add = fn(t : Int, flags : Int, value : Int) -> Unit {
    infos.push(FeatureInfo::{
      tag: t,
      seq: infos.length(),
      max_value: value,
      flags,
      default_value: if (flags & f_global) != 0 { value } else { 0 },
      stage: [current_stage[0], current_stage[1]],
    })
  }
  let enable = fn(t : Int, flags : Int, value : Int) -> Unit { add(t, flags | f_global, value) }
  let add_pause_fn = fn(ti : Int, f : Int) -> Unit {
    pauses[ti].push((current_stage[ti], f))
    current_stage[ti] += 1
  }
  let add_pause = fn(ti : Int) -> Unit { add_pause_fn(ti, 0) }
  enable(tag("rvrn"), 0, 1)
  add_pause(0)
  match direction {
    Direction::LeftToRight => {
      enable(tag("ltra"), 0, 1)
      enable(tag("ltrm"), 0, 1)
    }
    Direction::RightToLeft => {
      enable(tag("rtla"), 0, 1)
      add(tag("rtlm"), 0, 1)
    }
    _ => ()
  }
  add(tag("frac"), 0, 1)
  add(tag("numr"), 0, 1)
  add(tag("dnom"), 0, 1)
  enable(tag("rand"), f_random, max_feature_value)
  enable(tag("trak"), f_has_fallback, 1)
  enable(tag("Harf"), 0, 1)
  enable(tag("HARF"), 0, 1)
  let shaper = categorize(script, direction, chosen_script[0])
  let ifeats = get_indic_features()
  if shaper == shaper_indic {
    add_pause_fn(0, 1)
    enable(tag("locl"), f_per_syllable, 1)
    enable(tag("ccmp"), f_per_syllable, 1)
    add_pause_fn(0, 2)
    for k in 0..<11 {
      add(tag(ifeats[k].0), ifeats[k].1, 1)
      add_pause(0)
    }
    add_pause_fn(0, 3)
    for k in 11..<ifeats.length() {
      add(tag(ifeats[k].0), ifeats[k].1, 1)
    }
  }
  let afeats = get_arabic_features()
  if shaper == shaper_arabic {
    let has_feature = fn(t : Int) -> Bool {
      for ti in 0..<2 {
        match tables[ti] {
          Some(table) =>
            if script_index[ti] >= 0 && table.find_feature(d, script_index[ti], lang_index[ti], t) >= 0 {
              return true
            }
          None => ()
        }
      }
      false
    }
    enable(tag("stch"), 0, 1)
    add_pause(0)
    enable(tag("ccmp"), f_manual_zwj, 1)
    enable(tag("locl"), f_manual_zwj, 1)
    add_pause(0)
    for f in afeats {
      let fallback = script == tag("Arab") && !feature_is_syriac(f)
      add(tag(f), f_manual_zwj | (if fallback { f_has_fallback } else { 0 }), 1)
      add_pause(0)
    }
    add_pause(0)
    enable(tag("rlig"), f_manual_zwj | f_has_fallback, 1)
    if script == tag("Arab") {
      add_pause(0)
    }
    enable(tag("calt"), f_manual_zwj, 1)
    if !has_feature(tag("rclt")) {
      add_pause(0)
    }
    enable(tag("liga"), f_manual_zwj, 1)
    enable(tag("clig"), f_manual_zwj, 1)
    enable(tag("mset"), f_manual_zwj, 1)
  }
  enable(tag("Buzz"), 0, 1)
  enable(tag("BUZZ"), 0, 1)
  for t in ["abvm", "blwm", "ccmp", "locl"] {
    add(tag(t), f_global, 1)
  }
  add(tag("mark"), f_global | f_manual_zwnj | f_manual_zwj, 1)
  add(tag("mkmk"), f_global | f_manual_zwnj | f_manual_zwj, 1)
  add(tag("rlig"), f_global, 1)
  if dir_is_horizontal(direction) {
    for t in ["calt", "clig", "curs", "dist"] {
      add(tag(t), f_global, 1)
    }
    add(tag("kern"), f_global | f_has_fallback, 1)
    for t in ["liga", "rclt"] {
      add(tag(t), f_global, 1)
    }
  } else {
    enable(tag("vert"), f_global_search, 1)
  }
  for f in user_features {
    add(f.tag, if f.is_global() { f_global } else { 0 }, f.value)
  }
  if shaper == shaper_indic {
    // override_features
    add(tag("liga"), f_global, 0)
    add_pause_fn(0, 4)
  }
  // compile: the required feature
  let required_index = [-1, -1]
  let required_tag = [0, 0]
  for ti in 0..<2 {
    match tables[ti] {
      Some(table) =>
        if script_index[ti] >= 0 {
          let idx = table.required_feature(d, script_index[ti], lang_index[ti])
          if idx >= 0 {
            required_index[ti] = idx
            required_tag[ti] = table.feature_tag(d, idx)
          }
        }
      None => ()
    }
  }
  // dedup_feature_infos: by tag, then in the order they came
  sort_feature_infos(infos)
  let deduped : Array[FeatureInfo] = []
  for info in infos {
    if deduped.length() == 0 || deduped[deduped.length() - 1].tag != info.tag {
      deduped.push(FeatureInfo::{
        tag: info.tag,
        seq: info.seq,
        max_value: info.max_value,
        flags: info.flags,
        default_value: info.default_value,
        stage: [info.stage[0], info.stage[1]],
      })
      continue
    }
    let j = deduped[deduped.length() - 1]
    if (info.flags & f_global) != 0 {
      j.flags = j.flags | f_global
      j.max_value = info.max_value
      j.default_value = info.default_value
    } else {
      if (j.flags & f_global) != 0 {
        j.flags = j.flags ^ f_global
      }
      if info.max_value > j.max_value {
        j.max_value = info.max_value
      }
    }
    j.flags = j.flags | (info.flags & f_has_fallback)
    if info.stage[0] < j.stage[0] {
      j.stage[0] = info.stage[0]
    }
    if info.stage[1] < j.stage[1] {
      j.stage[1] = info.stage[1]
    }
  }
  // collect_feature_maps
  let features : Array[FeatureMap] = []
  let required_stage = [0, 0]
  let mut global_mask = global_bit_mask
  let mut next_bit = 4
  for info in deduped {
    let bits_needed = if (info.flags & f_global) != 0 && info.max_value == 1 {
      0
    } else {
      let num_bits = 32 - i32_clz(info.max_value)
      if num_bits < 8 {
        num_bits
      } else {
        8
      }
    }
    if info.max_value == 0 || next_bit + bits_needed >= global_bit_shift {
      continue
    }
    let mut found = false
    let feature_index = [-1, -1]
    for ti in 0..<2 {
      match tables[ti] {
        Some(table) => {
          if required_tag[ti] == info.tag {
            required_stage[ti] = info.stage[ti]
          }
          if script_index[ti] >= 0 {
            let idx = table.find_feature(d, script_index[ti], lang_index[ti], info.tag)
            if idx >= 0 {
              feature_index[ti] = idx
              found = true
            }
          }
        }
        None => ()
      }
    }
    if !found && (info.flags & f_global_search) != 0 {
      for ti in 0..<2 {
        match tables[ti] {
          Some(table) => {
            let idx = table.feature_index(d, info.tag)
            if idx >= 0 {
              feature_index[ti] = idx
              found = true
            }
          }
          None => ()
        }
      }
    }
    if !found && (info.flags & f_has_fallback) == 0 {
      continue
    }
    let (shift, mask) = if (info.flags & f_global) != 0 && info.max_value == 1 {
      (global_bit_shift, global_bit_mask)
    } else {
      let shift = next_bit
      let mask = (1 << (next_bit + bits_needed)) - (1 << next_bit)
      next_bit += bits_needed
      global_mask = global_mask | ((info.default_value << shift) & mask)
      (shift, mask)
    }
    features.push(FeatureMap::{
      tag: info.tag,
      index: feature_index,
      stage: info.stage,
      shift,
      mask,
      one_mask: (1 << shift) & mask,
      auto_zwnj: (info.flags & f_manual_zwnj) == 0,
      auto_zwj: (info.flags & f_manual_zwj) == 0,
      random: (info.flags & f_random) != 0,
      per_syllable: (info.flags & f_per_syllable) != 0,
    })
  }
  add_pause(0)
  add_pause(1)
  // collect_lookup_stages
  let lookups : Array[Array[LookupMap]] = [[], []]
  let stages : Array[Array[(Int, Int)]] = [[], []]
  for ti in 0..<2 {
    let mut stage_index = 0
    let mut last_lookup = 0
    for stage in 0..<current_stage[ti] {
      let list = lookups[ti]
      let add_lookups = fn(feature_index : Int, mask : Int, auto_zwnj : Bool, auto_zwj : Bool, random : Bool, per_syllable : Bool) -> Unit {
        match tables[ti] {
          Some(table) => {
            for index in table.feature_lookups(d, feature_index) {
              if index < table.lookup_count() {
                list.push(LookupMap::{ index, auto_zwnj, auto_zwj, random, mask, per_syllable })
              }
            }
          }
          None => ()
        }
      }
      if required_index[ti] >= 0 && required_stage[ti] == stage {
        add_lookups(required_index[ti], global_bit_mask, true, true, false, false)
      }
      for f in features {
        if f.index[ti] >= 0 && f.stage[ti] == stage {
          add_lookups(f.index[ti], f.mask, f.auto_zwnj, f.auto_zwj, f.random, f.per_syllable)
        }
      }
      if last_lookup + 1 < list.length() {
        let tail : Array[LookupMap] = []
        for k in last_lookup..<list.length() {
          tail.push(list[k])
        }
        sort_lookup_maps(tail)
        while list.length() > last_lookup {
          let _ = list.pop()
        }
        for l in tail {
          if list.length() > last_lookup && list[list.length() - 1].index == l.index {
            let j = list[list.length() - 1]
            list[list.length() - 1] = LookupMap::{
              index: j.index,
              auto_zwnj: j.auto_zwnj && l.auto_zwnj,
              auto_zwj: j.auto_zwj && l.auto_zwj,
              random: j.random,
              mask: j.mask | l.mask,
              per_syllable: j.per_syllable,
            }
          } else {
            list.push(l)
          }
        }
      }
      last_lookup = list.length()
      if stage_index < pauses[ti].length() && pauses[ti][stage_index].0 == stage {
        stages[ti].push((last_lookup, pauses[ti][stage_index].1))
        stage_index += 1
      }
    }
  }
  let ot_get_1 = fn(t : String) -> Int {
    for f in features {
      if f.tag == tag(t) {
        return f.one_mask
      }
    }
    0
  }
  let frac_mask = ot_get_1("frac")
  let numr_mask = ot_get_1("numr")
  let dnom_mask = ot_get_1("dnom")
  let horizontal = dir_is_horizontal(direction)
  let kern_tag = if horizontal { tag("kern") } else { tag("vkrn") }
  let mut kern_mask = 0
  let mut has_gpos_kern = false
  for f in features {
    if f.tag == kern_tag {
      kern_mask = f.mask
      has_gpos_kern = f.index[1] >= 0
    }
  }
  let has_gpos = match ot.gpos {
    Some(_) => true
    None => false
  }
  let apply_gpos = has_gpos
  // the old `kern` table, when GPOS does not kern (the default shaper positions as a fallback)
  let has_kern_table = ot.has_kern
  let apply_kern0 = (!has_gpos_kern || !apply_gpos) && has_kern_table
  // the shaper's zero_width_marks and fallback_position (the Indic shaper: neither)
  let script_fallback = shaper != shaper_indic
  let apply_kern = apply_kern0 && script_fallback
  let adjust = !apply_gpos
  let arabic_masks : Array[Int] = []
  for f in afeats {
    arabic_masks.push(ot_get_1(f))
  }
  arabic_masks.push(0)
  ShapePlan::{
    direction,
    script,
    ot,
    features,
    global_mask,
    lookups,
    stages,
    frac_mask,
    numr_mask,
    dnom_mask,
    rtlm_mask: ot_get_1("rtlm"),
    kern_mask,
    requested_kerning: kern_mask != 0,
    has_frac: frac_mask != 0 || (numr_mask != 0 && dnom_mask != 0),
    zero_marks: shaper != shaper_indic,
    fallback_glyph_classes: !ot.has_glyph_classes(),
    fallback_mark_positioning: adjust && script_fallback,
    adjust_mark_positioning_when_zeroing: adjust,
    apply_gpos,
    apply_kern,
    user_features,
    shaper,
    arabic_masks,
    indic: if shaper == shaper_indic {
      Some(indic_plan_new(script, chosen_script[0], features, stages[0]))
    } else {
      None
    },
  }
}

/// Applies GSUB's or GPOS's lookups, stage by stage.
fn ShapePlan::apply_layout_table(self : ShapePlan, face : font::Face, buffer : Buffer, is_gsub : Bool) -> Unit {
  let ti = if is_gsub { 0 } else { 1 }
  let table_opt = self.ot.table(is_gsub)
  let ctx = ApplyContext::new(is_gsub, self.ot, buffer)
  let mut start = 0
  for stage in self.stages[ti] {
    let (end, pause) = stage
    for k in start..<end {
      let lm = self.lookups[ti][k]
      let table = match table_opt {
        Some(t) => t
        None => continue
      }
      let lookup = match table.lookup(self.ot.data, lm.index) {
        Some(l) => l
        None => continue
      }
      ctx.lookup_index = lm.index
      ctx.set_lookup_mask(lm.mask)
      ctx.auto_zwj = lm.auto_zwj
      ctx.auto_zwnj = lm.auto_zwnj
      ctx.random = lm.random
      ctx.per_syllable = lm.per_syllable
      apply_string(ctx, lookup)
    }
    if pause != 0 {
      indic_pause(self, face, buffer, pause)
    }
    start = end
  }
}
