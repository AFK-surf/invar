// Liquid Glass Studio (34 components) — Browser WebGL2 / WebAssembly entry point.
// Installs the WebGL2 host bridge (`host_web::install`), registers `lg_pages::gallery`,
// and drives `ui::view_frame` + input events via `hostapi::run` with on-demand animation pacing.

import "host_web"
import "hostapi"
import "lg"
import "lg_pages"
import "ui"
import "view"

fn main() -> Unit {
  host_web::install()
  let dark_env = ui::env("dark")
  if dark_env == "0" || dark_env == "false" || dark_env == "light" {
    lg::set_dark(Some(false))
  } else {
    lg::set_dark(Some(true))
  }
  view::faults_stop.v = false
  ui::set_view_app(
    fn(root) {
      let _ = root.transitions_only()
      lg_pages::gallery(root, "library", chrome=true)
    },
    theme=lg::ui_theme,
  )
  hostapi::run(
    "Invar · Liquid Glass Studio (Pion WASM)",
    fn(w, h, scale, now) {
      let changed = ui::view_frame(w, h, scale, now)
      if changed {
        hostapi::request_frame()
      }
    },
    // host.js sends kind: 0=down, 1=move, 2=up, 3=cancel; btn: 0=left, 2=right
    fn(host_kind, x, y, btn) {
      let vp_kind = if host_kind == 0 {
        1
      } else if host_kind == 1 {
        0
      } else {
        host_kind
      }
      let vp_btn = if btn == 2 { 2 } else { 1 }
      ui::view_pointer(vp_kind, x, y, hostapi::now(), button=vp_btn)
    },
    fn(x, y, dx, dy, _phase) { ui::view_wheel(x, y, dx, dy, hostapi::now()) },
    fn(code, mods) { let _ = ui::view_key(code, mods, hostapi::now()) },
    fn(kind, s, _a, _b) { ui::view_text(kind, s) },
  )
}
