// The same groups and frames, at random from a seed, drawn out by groups.h and by damage::Groups: every float the same.

import "damage"

extern "C" fn c_group_set(id : Int, inst : Ptr, moves : Ptr, n : Int) -> Unit = "mb_host_group_set"
extern "C" fn c_group_drop(id : Int) -> Unit = "mb_host_group_drop"
extern "C" fn c_floats(bits : Ptr, frame : Ptr, count : Int) -> Int = "groups_parity_floats"

struct Rnd {
  mut s : Int
}

fn Rnd::below(self : Rnd, n : Int) -> Int {
  // (Lehmer's with a multiplier small enough for 32 bits)
  self.s = (self.s * 16807) % 127773
  if self.s <= 0 {
    self.s += 127772
  }
  (self.s / 7) % n
}

/// A number with a fraction no float holds, below 0 as often.
fn Rnd::num(self : Rnd) -> Double {
  let v = self.below(2000).to_double() * 0.1 + self.below(1000).to_double() * 0.00037
  if self.below(2) == 0 { v } else { -v }
}

fn zeros(n : Int) -> FixedArray[Double] {
  FixedArray::make(n, 0.0)
}

fn inst_put(r : Rnd, a : FixedArray[Double], k : Int) -> Unit {
  let o = k * 60
  for j in 0..<60 {
    a[o + j] = r.num()
  }
  let kind = r.below(13)
  a[o + 5] = kind.to_double()
  if r.below(2) == 0 {
    for j in 24..<32 {
      a[o + j] = 0.0
    }
  }
  if r.below(2) == 0 {
    for j in 40..<44 {
      a[o + j] = 0.0
    }
  }
  if r.below(3) == 0 {
    a[o + 16] = 0.0
    a[o + 17] = 0.0
    a[o + 18] = 1.0e9
    a[o + 19] = 1.0e9
  }
}

fn head_put(r : Rnd, a : FixedArray[Double], k : Int, id : Int, first : Int, n : Int) -> Unit {
  let o = k * 60
  for j in 0..<60 {
    a[o + j] = 0.0
  }
  a[o] = r.num()
  a[o + 1] = r.num()
  a[o + 5] = 13.0
  a[o + 12] = id.to_double()
  a[o + 13] = first.to_double()
  a[o + 14] = n.to_double()
  a[o + 15] = r.below(50).to_double()
  if r.below(2) == 0 {
    for j in 16..<20 {
      a[o + j] = r.num()
    }
  }
}

/// Groups 1..40, each past the first ten with headers of some before it and of itself; every number of it said to both.
fn groups_put(r : Rnd, gs : damage::Groups) -> Unit {
  for id in 1..<41 {
    let n = r.below(6)
    let a = zeros(n * 60 + 60)
    let moves = zeros(n + 1)
    for k in 0..<n {
      if id > 10 && r.below(3) == 0 {
        head_put(r, a, k, 1 + r.below(id), r.below(3), r.below(6))
      } else {
        inst_put(r, a, k)
      }
      moves[k] = r.below(8192).to_double()
    }
    gs.set(id, a, moves, n)
    c_group_set(id, array_data_ptr(a), array_data_ptr(moves), n)
  }
}

/// How many floats were compared.
fn frame_same(r : Rnd, gs : damage::Groups) -> Int {
  let n = 1 + r.below(40)
  let a = zeros(n * 60)
  let mut k = 0
  while k < n {
    if r.below(2) == 0 {
      // (its room what was there before: poison; ids none keeps and places past what is held among them)
      let room = 1 + r.below(12)
      head_put(r, a, k, r.below(44), r.below(5) - 1, room)
      let end = if k + room < n { k + room } else { n }
      for j in ((k + 1) * 60)..<(end * 60) {
        a[j] = 99999.25
      }
      k += room
    } else {
      inst_put(r, a, k)
      k += 1
    }
  }
  let bits = zeros(n * 60)
  debug_assert(c_floats(array_data_ptr(bits), array_data_ptr(a), n) == 1, "drawn out")
  let fs = gs.draw_out_floats(a, n)
  debug_assert(fs.length() == n * 60, "as many")
  for j in 0..<(n * 60) {
    if fs[j].to_bits().to_double() != bits[j] {
      panic("float " + (j % 60).to_string() + " of instance " + (j / 60).to_string())
    }
  }
  n * 60
}

test "groups: drawn out by groups.h and by damage::Groups, every float the same to the bit" {
  let r = Rnd::{ s: 4711 }
  let gs = damage::Groups::new()
  let mut compared = 0
  for _ in 0..<20 {
    groups_put(r, gs)
    for _ in 0..<50 {
      compared += frame_same(r, gs)
    }
    for _ in 0..<6 {
      let id = 1 + r.below(40)
      gs.drop(id)
      c_group_drop(id)
      compared += frame_same(r, gs)
    }
  }
  debug_assert(compared > 500000, "many compared: " + compared.to_string())
}
