// Headers (kind 13) drawn out as the native hosts draw them (packages/host/native/groups.h), in Pion: a frame that says
// kept groups by their headers alone as the instances it stands for, for what compares or looks at whole frames.
// Kept the same as groups.h to the bit (packages/damage/parity).

/// A group kept: its instances in doubles, which of each one's numbers move with it (`moves` bits), and whether it holds
/// headers of others.
struct KeptGroup {
  n : Int
  inst : FixedArray[Double]
  moves : Array[Int]
  heads : Bool
}

/// The groups a host keeps, as it keeps them (`hostapi::group_set`, `hostapi::group_drop`).
pub struct Groups {
  kept : Map[Int, KeptGroup]
}

pub fn Groups::new() -> Groups {
  Groups::{ kept: Map::new() }
}

/// How many are kept.
pub fn Groups::length(self : Groups) -> Int {
  self.kept.length()
}

/// Group `id` kept, its `n` instances in `inst` and their `moves` copied.
pub fn Groups::set(self : Groups, id : Int, inst : FixedArray[Double], moves : FixedArray[Double], n : Int) -> Unit {
  self.drop(id)
  if id <= 0 || n < 0 {
    return
  }
  let own : FixedArray[Double] = make_doubles(n * inst_size, 0.0)
  blit_doubles(inst, 0, own, 0, n * inst_size)
  let m : Array[Int] = []
  let mut heads = false
  for i in 0..<n {
    m.push(moves[i].to_int())
    heads = heads || inst[i * inst_size + 5] == 13.0
  }
  self.kept.set(id, KeptGroup::{ n, inst: own, moves: m, heads })
}

/// Group `id` let go.
pub fn Groups::drop(self : Groups, id : Int) -> Unit {
  let _ = self.kept.remove(id)
}

/// The frame `inst` (`count` instances) with each header drawn out, its group's instances in its place and the room
/// after it. In doubles, each as the renderers make it a float (`Groups::draw_out_floats`).
pub fn Groups::draw_out(self : Groups, inst : FixedArray[Double], count : Int) -> FixedArray[Double] {
  let out = make_doubles(count * inst_size, 0.0)
  let mut k = 0
  while k < count {
    let o = k * inst_size
    if inst[o + 5] != 13.0 {
      blit_doubles(inst, o, out, o, inst_size)
      k += 1
    } else {
      let h : FixedArray[Double] = FixedArray::make(20, 0.0)
      for j in 0..<20 {
        h[j] = inst[o + j]
      }
      k += self.group_out(out, k, count - k, h, 0)
    }
  }
  out
}

/// The same as the floats a renderer draws from.
pub fn Groups::draw_out_floats(self : Groups, inst : FixedArray[Double], count : Int) -> Array[Float] {
  let out : Array[Float] = []
  for v in self.draw_out(inst, count) {
    out.push(v.to_float())
  }
  out
}

/// Header `h`'s group drawn out from instance `at` of `out`, `room` at most: how many it drew.
fn Groups::group_out(self : Groups, out : FixedArray[Double], at : Int, room : Int, h : FixedArray[Double], depth : Int) -> Int {
  let first = h[13].to_int()
  let mut n = h[14].to_int()
  if n < 1 {
    n = 1
  }
  if n > room {
    n = room
  }
  // (a group that comes round to itself ends there, nothing drawn)
  if depth >= group_depth {
    return n
  }
  let cut = !(h[16] == 0.0 && h[17] == 0.0 && h[18] == 0.0 && h[19] == 0.0)
  match self.kept.get(h[12].to_int()) {
    Some(g) => {
      if g.heads {
        let mut w = 0
        let mut i = 0
        while i < g.n && w < n {
          let o = i * inst_size
          if g.inst[o + 5] == 13.0 {
            // (a header in it: moved with it, cut to as much of both clips)
            let hv : FixedArray[Double] = FixedArray::make(20, 0.0)
            for j in 0..<20 {
              hv[j] = g.inst[o + j]
            }
            hv[0] += h[0]
            hv[1] += h[1]
            hv[15] += h[15]
            if cut {
              if hv[16] == 0.0 && hv[17] == 0.0 && hv[18] == 0.0 && hv[19] == 0.0 {
                for j in 16..<20 {
                  hv[j] = h[j]
                }
              } else {
                clip_to(hv, 16, h)
              }
            }
            w += self.group_out(out, at + w, n - w, hv, depth + 1)
          } else {
            inst_out(out, at + w, g, i, h, cut)
            w += 1
          }
          i += 1
        }
      } else if first >= 0 && first + n <= g.n {
        for i in 0..<n {
          inst_out(out, at + i, g, first + i, h, cut)
        }
      }
    }
    // (one not kept: nothing drawn there)
    None => ()
  }
  n
}

/// The rect at `at` of `a` (x0 y0 x1 y1) cut to header `h`'s clip.
fn clip_to(a : FixedArray[Double], at : Int, h : FixedArray[Double]) -> Unit {
  if a[at] < h[16] {
    a[at] = h[16]
  }
  if a[at + 1] < h[17] {
    a[at + 1] = h[17]
  }
  if a[at + 2] > h[18] {
    a[at + 2] = h[18]
  }
  if a[at + 3] > h[19] {
    a[at + 3] = h[19]
  }
}

/// How far a cut may move a rounded clip's edge and leave its corners there round: half a point, as far as a list's row
/// set on the device's pixels stands past its foot (groups.h `MB_CLIP_HAIR`, the same).
let clip_hair : Double = 0.5

/// Whether a cut moved an edge from `b` to `a` by more than a hair (groups.h `mb_clip_moved`).
fn clip_moved(a : Double, b : Double) -> Bool {
  a - b > clip_hair + 1.0e-6 || b - a > clip_hair + 1.0e-6
}

/// Instance `i` of `g` as instance `at` of `out`, moved and cut as header `h` says (groups.h `mb_group_inst_moved`).
fn inst_out(out : FixedArray[Double], at : Int, g : KeptGroup, i : Int, h : FixedArray[Double], cut : Bool) -> Unit {
  let b = at * inst_size
  blit_doubles(g.inst, i * inst_size, out, b, inst_size)
  let dx = h[0]
  let dy = h[1]
  let m = g.moves[i]
  out[b] += dx
  out[b + 1] += dy
  if out[b + 5] == 11.0 {
    out[b + 12] += h[15]
  }
  if m != 0 {
    for j in 0..<4 {
      let by = if j % 2 == 0 { dx } else { dy }
      if (m & (1 << j)) != 0 {
        out[b + 16 + j] += by
      }
      if (m & (16 << j)) != 0 {
        out[b + 40 + j] += by
      }
    }
    if (m & 256) != 0 {
      out[b + 33] += dx
      out[b + 34] += dy
    }
    for j in 0..<4 {
      if (m & (512 << j)) != 0 {
        out[b + 52 + 2 * j] += if j < 2 { dy } else { dx }
      }
    }
  }
  if !cut {
    return
  }
  let square = out[b + 24] == 0.0 && out[b + 25] == 0.0 && out[b + 26] == 0.0 && out[b + 27] == 0.0
  let no_outer = out[b + 40] == 0.0 && out[b + 41] == 0.0 && out[b + 42] == 0.0 && out[b + 43] == 0.0
  if square || no_outer {
    let m0 = out[b + 16]
    let m1 = out[b + 17]
    let m2 = out[b + 18]
    let m3 = out[b + 19]
    clip_to(out, b + 16, h)
    // (by more than a hair: clip_hair)
    let left = clip_moved(out[b + 16], m0)
    let top = clip_moved(out[b + 17], m1)
    let right = clip_moved(out[b + 18], m2)
    let foot = clip_moved(out[b + 19], m3)
    if left || top {
      out[b + 24] = 0.0
      out[b + 28] = 0.0
    }
    if right || top {
      out[b + 25] = 0.0
      out[b + 29] = 0.0
    }
    if right || foot {
      out[b + 26] = 0.0
      out[b + 30] = 0.0
    }
    if left || foot {
      out[b + 27] = 0.0
      out[b + 31] = 0.0
    }
  } else {
    clip_to(out, b + 40, h)
  }
}
