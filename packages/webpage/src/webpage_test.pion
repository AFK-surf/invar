// Unit tests for `packages/webpage`: verifies all `invar.page.*` app_tell/app_said commands and JSON payloads.

import "hostapi"
import "ui"
import "view"

test "webpage_protocol_commands_and_cjk_face_json" {
  let t = ui::Tester::tree(fn(root : view::View) {
    let _ = root.words(view::Live::Is("WebPage"), look=view::words_plain)
  })
  let told : Array[(String, String)] = []
  let h = hostapi::host()
  h.app_tell = fn(name : String, arg : String) { told.push((name, arg)) }
  h.app_said = fn(name : String) -> String {
    if name == "invar.page.loaded_title" {
      "Initial Site Title"
    } else if name == "invar.page.location" {
      "/docs/guide?tab=1#top"
    } else {
      ""
    }
  }

  debug_assert(history_channel == "history", "history_channel constant")
  debug_assert(loaded_title() == "Initial Site Title", "loaded_title reads invar.page.loaded_title")
  debug_assert(location() == "/docs/guide?tab=1#top", "location reads invar.page.location")

  set_title("Invar Docs")
  set_theme_color("#0f172a")
  set_cjk_face(face=2, weight_step=150, families=["PingFang SC", "Noto Sans CJK SC"])
  history_push("/docs/api")
  history_replace("/docs/api#nav")
  history_back()

  debug_assert(told.length() == 6, "6 invar.page.* commands sent")
  debug_assert(told[0].0 == "invar.page.title" && told[0].1 == "Invar Docs", "set_title")
  debug_assert(told[1].0 == "invar.page.theme_color" && told[1].1 == "#0f172a", "set_theme_color")
  debug_assert(told[2].0 == "invar.page.cjk_face", "set_cjk_face command name")
  match hostapi::json_parse(told[2].1) {
    Some(hostapi::JsonValue::JObject(m)) => {
      match m.get("face") {
        Some(hostapi::JsonValue::JNumber(n)) => debug_assert(n == 2.0, "cjk face=2")
        _ => debug_assert(false, "cjk face missing")
      }
      match m.get("step") {
        Some(hostapi::JsonValue::JNumber(n)) => debug_assert(n == 150.0, "cjk step=150")
        _ => debug_assert(false, "cjk step missing")
      }
      match m.get("families") {
        Some(hostapi::JsonValue::JArray(arr)) => {
          debug_assert(arr.length() == 2, "cjk families len=2")
          match arr[0] {
            hostapi::JsonValue::JString(s) => debug_assert(s == "PingFang SC", "first family")
            _ => debug_assert(false, "family[0] not string")
          }
        }
        _ => debug_assert(false, "cjk families missing")
      }
    }
    _ => debug_assert(false, "set_cjk_face payload is not valid JSON object")
  }
  debug_assert(told[3].0 == "invar.page.history_push" && told[3].1 == "/docs/api", "history_push")
  debug_assert(told[4].0 == "invar.page.history_replace" && told[4].1 == "/docs/api#nav", "history_replace")
  debug_assert(told[5].0 == "invar.page.history_back" && told[5].1 == "", "history_back")

  t.dispose()
}
