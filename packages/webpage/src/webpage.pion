// Browser page host protocol (`invar.page.*`) built on `hostapi::app_tell` / `hostapi::app_said`.
// Controls document title, browser theme color, CJK fallback face mapping, and History API sync.

import "hostapi"

/// Channel name on which browser-initiated history navigation events (`{"location":"/a?b#c"}`) are delivered.
pub let history_channel : String = "history"

/// Update the browser tab's document title.
pub fn set_title(title : String) -> Unit {
  hostapi::app_tell("invar.page.title", title)
}

/// Read the page's original `<title>` as loaded before the app changed it (`""` outside a browser page).
pub fn loaded_title() -> String {
  hostapi::app_said("invar.page.loaded_title")
}

/// Update the browser chrome / overscroll theme color (CSS color string; `""` restores page default).
pub fn set_theme_color(color : String) -> Unit {
  hostapi::app_tell("invar.page.theme_color", color)
}

/// Configure system CJK fallback font families and weight step for `face` (1 = body words face).
pub fn set_cjk_face(
  face~ : Int = 1,
  weight_step~ : Int = 100,
  families~ : Array[String] = [],
) -> Unit {
  let fam_vals : Array[hostapi::JsonValue] = []
  for f in families {
    fam_vals.push(hostapi::JsonValue::JString(f))
  }
  let m : Map[String, hostapi::JsonValue] = Map::new()
  m.set("face", hostapi::JsonValue::JNumber(face.to_double()))
  m.set("step", hostapi::JsonValue::JNumber(weight_step.to_double()))
  m.set("families", hostapi::JsonValue::JArray(fam_vals))
  hostapi::app_tell("invar.page.cjk_face", hostapi::json_stringify(hostapi::JsonValue::JObject(m)))
}

/// Read the current page path, query, and fragment (`/a?b#c`), or `""` outside a browser page.
pub fn location() -> String {
  hostapi::app_said("invar.page.location")
}

/// Push a new URL entry onto the browser's session history without reloading.
pub fn history_push(to : String) -> Unit {
  hostapi::app_tell("invar.page.history_push", to)
}

/// Replace the current browser history entry with `to` without reloading.
pub fn history_replace(to : String) -> Unit {
  hostapi::app_tell("invar.page.history_replace", to)
}

/// Navigate one step back in the browser's session history; updates arrive on `history_channel`.
pub fn history_back() -> Unit {
  hostapi::app_tell("invar.page.history_back", "")
}
