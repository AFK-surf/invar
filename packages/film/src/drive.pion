// Deterministic drive script parser & executor for offscreen picture and film capture.
// Supports: wait, hover, click, tapxy, press, drag, holdon, key, type, resize.

import "ui"

fn str_slice(s : String, start : Int, end : Int) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let lo = if start < 0 { 0 } else { start }
  let hi = if end > n { n } else { end }
  let mut i = lo
  while i < hi {
    sb.write_char(s.code_unit_at(i).unsafe_to_char())
    i += 1
  }
  sb.to_string()
}

fn str_trim(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n && (s.code_unit_at(lo) == 32 || s.code_unit_at(lo) == 9 || s.code_unit_at(lo) == 13 || s.code_unit_at(lo) == 10) {
    lo += 1
  }
  let mut hi = n
  while hi > lo && (s.code_unit_at(hi - 1) == 32 || s.code_unit_at(hi - 1) == 9 || s.code_unit_at(hi - 1) == 13 || s.code_unit_at(hi - 1) == 10) {
    hi -= 1
  }
  str_slice(s, lo, hi)
}

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      out.push(str_slice(s, start, i))
      start = i + 1
    }
    i += 1
  }
  if start <= n {
    out.push(str_slice(s, start, n))
  }
  out
}

fn split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
      i += 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && s.code_unit_at(i) != 32 && s.code_unit_at(i) != 9 {
      i += 1
    }
    out.push(str_slice(s, start, i))
  }
  out
}

fn parse_double(s : String) -> Option[Double] {
  let t = str_trim(s)
  let n = t.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(i) == 45 {
    neg = true
    i += 1
  } else if t.code_unit_at(i) == 43 {
    i += 1
  }
  let mut num = 0.0
  let mut any = false
  while i < n {
    let c = t.code_unit_at(i)
    if c >= 48 && c <= 57 {
      num = num * 10.0 + (c - 48).to_double()
      any = true
      i += 1
    } else {
      break
    }
  }
  if i < n && t.code_unit_at(i) == 46 {
    i += 1
    let mut frac = 0.1
    while i < n {
      let c = t.code_unit_at(i)
      if c >= 48 && c <= 57 {
        num = num + (c - 48).to_double() * frac
        frac = frac * 0.1
        any = true
        i += 1
      } else {
        break
      }
    }
  }
  if !any {
    return None
  }
  Some(if neg { -num } else { num })
}

fn parse_at_xy(tok : String) -> Option[(Double, Double)] {
  if tok.length() < 4 || tok.code_unit_at(0) != 64 {
    return None
  }
  let mut comma = -1
  let mut i = 1
  while i < tok.length() {
    if tok.code_unit_at(i) == 44 {
      comma = i
      break
    }
    i += 1
  }
  if comma < 0 {
    return None
  }
  match (parse_double(str_slice(tok, 1, comma)), parse_double(str_slice(tok, comma + 1, tok.length()))) {
    (Some(x), Some(y)) => Some((x, y))
    _ => None
  }
}

fn step_ms(t : ui::Tester, ms : Double, on_frame : (Int) -> Bool, frame_idx : ui::Ref[Int], max_frames : Int) -> Bool {
  if ms <= 0.0 {
    return true
  }
  let period = if t.period_ms > 0.0 { t.period_ms } else { 1000.0 / 60.0 }
  let mut rem = ms
  while rem > 1.0e-6 {
    if frame_idx.v >= max_frames {
      return true
    }
    let dt = if rem > period { period } else { rem }
    t.frame(ms=dt)
    rem = rem - dt
    if !on_frame(frame_idx.v) {
      return false
    }
    frame_idx.v = frame_idx.v + 1
  }
  true
}

fn step_drag(
  t : ui::Tester,
  x0 : Double,
  y0 : Double,
  dx : Double,
  dy : Double,
  ms : Double,
  on_frame : (Int) -> Bool,
  frame_idx : ui::Ref[Int],
  max_frames : Int,
) -> Bool {
  let period = if t.period_ms > 0.0 { t.period_ms } else { 1000.0 / 60.0 }
  let steps = if ms <= 0.0 { 1 } else {
    let n = (ms / period).round().to_int()
    if n < 1 { 1 } else { n }
  }
  let dt = if ms <= 0.0 { 0.0 } else { ms / steps.to_double() }
  let mut i = 1
  while i <= steps {
    if frame_idx.v >= max_frames {
      return true
    }
    let p = i.to_double() / steps.to_double()
    let cx = x0 + dx * p
    let cy = y0 + dy * p
    if dt > 0.0 {
      t.fake.now_ms = t.fake.now_ms + dt
    }
    t.move_to(cx, cy)
    if !on_frame(frame_idx.v) {
      return false
    }
    frame_idx.v = frame_idx.v + 1
    i += 1
  }
  true
}

fn dispatch_key_spec(t : ui::Tester, spec : String) -> Unit {
  if spec == "tab" || spec == "Tab" {
    t.key(ui::key_tab)
  } else if spec == "shift+tab" || spec == "Shift+Tab" {
    t.key(ui::key_tab, mods=1)
  } else if spec == "enter" || spec == "Enter" {
    t.enter()
  } else if spec == "escape" || spec == "Escape" || spec == "esc" {
    t.key(ui::key_escape)
  } else if spec == "space" || spec == "Space" {
    t.key(ui::key_space)
  } else if spec == "backspace" || spec == "Backspace" {
    t.backspace()
  }
}

/// Run a multi-line drive script on `t`, invoking `on_frame(frame_index)` after each frame.
pub fn run_drive_script(
  t : ui::Tester,
  script : String,
  max_frames : Int,
  on_frame : (Int) -> Bool,
  frame_idx : ui::Ref[Int],
) -> Bool {
  if script == "" {
    return true
  }
  let lines = split_lines(script)
  for raw in lines {
    let line = str_trim(raw)
    if line == "" || line.code_unit_at(0) == 35 {
      continue
    }
    let toks = split_ws(line)
    if toks.length() == 0 {
      continue
    }
    let cmd = toks[0]
    if cmd == "wait" && toks.length() >= 2 {
      match parse_double(toks[1]) {
        Some(ms) => if !step_ms(t, ms, on_frame, frame_idx, max_frames) { return false }
        None => ()
      }
    } else if (cmd == "tapxy" || cmd == "click") && toks.length() >= 3 {
      match (parse_double(toks[1]), parse_double(toks[2])) {
        (Some(x), Some(y)) => {
          t.click(x, y)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        _ => ()
      }
    } else if cmd == "tap" && toks.length() >= 2 {
      let target = str_trim(str_slice(line, 3, line.length()))
      match t.get(target) {
        Some(d) => {
          t.tap(d.x + d.w * 0.5, d.y + d.h * 0.5)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        None => match t.find(target) {
          Some((x, y)) => {
            t.tap(x, y)
            if !on_frame(frame_idx.v) { return false }
            frame_idx.v = frame_idx.v + 1
          }
          None => ()
        }
      }
    } else if cmd == "press" && toks.length() >= 2 {
      t.press(toks[1])
      if !on_frame(frame_idx.v) { return false }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "hover" && toks.length() >= 2 {
      match t.find(toks[1]) {
        Some((x, y)) => {
          t.move_to(x, y)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        None => match t.get(toks[1]) {
          Some(d) => {
            t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
            if !on_frame(frame_idx.v) { return false }
            frame_idx.v = frame_idx.v + 1
          }
          None => ()
        }
      }
    } else if cmd == "drag" && toks.length() >= 6 {
      match (parse_double(toks[1]), parse_double(toks[2]), parse_double(toks[3]), parse_double(toks[4]), parse_double(toks[5])) {
        (Some(x), Some(y), Some(dx), Some(dy), Some(ms)) => {
          t.press_at(x, y)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
          if !step_drag(t, x, y, dx, dy, ms, on_frame, frame_idx, max_frames) { return false }
          t.release(x + dx, y + dy)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        _ => ()
      }
    } else if cmd == "holdon" && toks.length() >= 6 {
      match (parse_double(toks[1]), parse_double(toks[2]), parse_double(toks[3]), parse_double(toks[4]), parse_at_xy(toks[5])) {
        (Some(hold_ms), Some(dx), Some(dy), Some(move_ms), Some((x, y))) => {
          t.press_at(x, y)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
          if !step_ms(t, hold_ms, on_frame, frame_idx, max_frames) { return false }
          if !step_drag(t, x, y, dx, dy, move_ms, on_frame, frame_idx, max_frames) { return false }
          t.release(x + dx, y + dy)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        _ => ()
      }
    } else if cmd == "key" && toks.length() >= 2 {
      dispatch_key_spec(t, toks[1])
      if !on_frame(frame_idx.v) { return false }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "type" && toks.length() >= 2 {
      t.type_text(toks[1])
      if !on_frame(frame_idx.v) { return false }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "resize" && toks.length() >= 3 {
      match (parse_double(toks[1]), parse_double(toks[2])) {
        (Some(w), Some(h)) => {
          t.resize(w, h)
          if !on_frame(frame_idx.v) { return false }
          frame_idx.v = frame_idx.v + 1
        }
        _ => ()
      }
    }
  }
  true
}
