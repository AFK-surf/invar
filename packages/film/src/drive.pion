// Deterministic drive script parser & executor for offscreen picture and film capture.
// Supports: wait, hover, click, tapxy, press, drag, holdon, key, type, resize.

import "ui"
import "signals"

fn str_slice(s : String, start : Int, end : Int) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let lo = if start < 0 { 0 } else { start }
  let hi = if end > n { n } else { end }
  let mut i = lo
  while i < hi {
    sb.write_char(s.code_unit_at(i).unsafe_to_char())
    i += 1
  }
  sb.to_string()
}

fn str_trim(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n && (s.code_unit_at(lo) == 32 || s.code_unit_at(lo) == 9 || s.code_unit_at(lo) == 13 || s.code_unit_at(lo) == 10) {
    lo += 1
  }
  let mut hi = n
  while hi > lo && (s.code_unit_at(hi - 1) == 32 || s.code_unit_at(hi - 1) == 9 || s.code_unit_at(hi - 1) == 13 || s.code_unit_at(hi - 1) == 10) {
    hi -= 1
  }
  str_slice(s, lo, hi)
}

fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if s.code_unit_at(i) == 10 {
      out.push(str_slice(s, start, i))
      start = i + 1
    }
    i += 1
  }
  if start <= n {
    out.push(str_slice(s, start, n))
  }
  out
}

fn split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9) {
      i += 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && s.code_unit_at(i) != 32 && s.code_unit_at(i) != 9 {
      i += 1
    }
    out.push(str_slice(s, start, i))
  }
  out
}

fn parse_double(s : String) -> Option[Double] {
  let t = str_trim(s)
  let n = t.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if t.code_unit_at(i) == 45 {
    neg = true
    i += 1
  } else if t.code_unit_at(i) == 43 {
    i += 1
  }
  let mut num = 0.0
  let mut any = false
  while i < n {
    let c = t.code_unit_at(i)
    if c >= 48 && c <= 57 {
      num = num * 10.0 + (c - 48).to_double()
      any = true
      i += 1
    } else {
      break
    }
  }
  if i < n && t.code_unit_at(i) == 46 {
    i += 1
    let mut frac = 0.1
    while i < n {
      let c = t.code_unit_at(i)
      if c >= 48 && c <= 57 {
        num = num + (c - 48).to_double() * frac
        frac = frac * 0.1
        any = true
        i += 1
      } else {
        break
      }
    }
  }
  if !any {
    return None
  }
  Some(if neg { -num } else { num })
}

fn parse_at_xy(tok : String) -> Option[(Double, Double)] {
  if tok.length() < 4 || tok.code_unit_at(0) != 64 {
    return None
  }
  let mut comma = -1
  let mut i = 1
  while i < tok.length() {
    if tok.code_unit_at(i) == 44 {
      comma = i
      break
    }
    i += 1
  }
  if comma < 0 {
    return None
  }
  match (parse_double(str_slice(tok, 1, comma)), parse_double(str_slice(tok, comma + 1, tok.length()))) {
    (Some(x), Some(y)) => Some((x, y))
    _ => None
  }
}

fn step_ms(t : ui::Tester, ms : Double, on_frame : (Int) -> Bool, frame_idx : signals::Ref[Int], max_frames : Int) -> Bool {
  if ms <= 0.0 {
    return true
  }
  let period = if t.period_ms > 0.0 { t.period_ms } else { 1000.0 / 60.0 }
  let mut rem = ms
  while rem > 1.0e-6 {
    if frame_idx.v >= max_frames {
      return true
    }
    let dt = if rem > period { period } else { rem }
    t.frame(ms=dt)
    rem = rem - dt
    if !on_frame(frame_idx.v) {
      return false
    }
    frame_idx.v = frame_idx.v + 1
  }
  true
}

fn step_drag(
  t : ui::Tester,
  x0 : Double,
  y0 : Double,
  dx : Double,
  dy : Double,
  ms : Double,
  on_frame : (Int) -> Bool,
  frame_idx : signals::Ref[Int],
  max_frames : Int,
) -> Bool {
  let period = if t.period_ms > 0.0 { t.period_ms } else { 1000.0 / 60.0 }
  let steps = if ms <= 0.0 { 1 } else {
    let n = (ms / period).round().to_int()
    if n < 1 { 1 } else { n }
  }
  let dt = if ms <= 0.0 { 0.0 } else { ms / steps.to_double() }
  let mut i = 1
  while i <= steps {
    if frame_idx.v >= max_frames {
      return true
    }
    let p = i.to_double() / steps.to_double()
    let cx = x0 + dx * p
    let cy = y0 + dy * p
    if dt > 0.0 {
      t.fake.now_ms = t.fake.now_ms + dt
    }
    t.move_to(cx, cy)
    if !on_frame(frame_idx.v) {
      return false
    }
    frame_idx.v = frame_idx.v + 1
    i += 1
  }
  true
}

fn dispatch_key_spec(t : ui::Tester, spec : String) -> Bool {
  if spec == "tab" || spec == "Tab" {
    t.key(ui::key_tab)
    true
  } else if spec == "shift+tab" || spec == "Shift+Tab" {
    t.key(ui::key_tab, mods=1)
    true
  } else if spec == "enter" || spec == "Enter" {
    t.enter()
    true
  } else if spec == "escape" || spec == "Escape" || spec == "esc" {
    t.key(ui::key_escape)
    true
  } else if spec == "space" || spec == "Space" {
    t.key(ui::key_space)
    true
  } else if spec == "backspace" || spec == "Backspace" {
    t.backspace()
    true
  } else {
    false
  }
}

fn str_trim_left_cr(s : String) -> String {
  let n = s.length()
  let mut lo = 0
  while lo < n && (s.code_unit_at(lo) == 32 || s.code_unit_at(lo) == 9 || s.code_unit_at(lo) == 13 || s.code_unit_at(lo) == 10) {
    lo += 1
  }
  let mut hi = n
  while hi > lo && (s.code_unit_at(hi - 1) == 13 || s.code_unit_at(hi - 1) == 10) {
    hi -= 1
  }
  str_slice(s, lo, hi)
}

fn rest_after_cmd(line : String, cmd_len : Int) -> String {
  str_trim(str_slice(line, cmd_len, line.length()))
}

fn rest_after_cmd_raw(line : String, cmd_len : Int) -> String {
  let n = line.length()
  let mut i = cmd_len
  if i < n && (line.code_unit_at(i) == 32 || line.code_unit_at(i) == 9) {
    i += 1
  }
  str_slice(line, i, n)
}

enum DriveEnd {
  Done
  Stopped
  Failed(String)
}

fn run_drive_script_ex(
  t : ui::Tester,
  script : String,
  max_frames : Int,
  on_frame : (Int) -> Bool,
  frame_idx : signals::Ref[Int],
) -> DriveEnd {
  if script == "" {
    return DriveEnd::Done
  }
  let lines = split_lines(script)
  for raw in lines {
    let raw_cmd = str_trim_left_cr(raw)
    let line = str_trim(raw_cmd)
    if line == "" || line.code_unit_at(0) == 35 {
      continue
    }
    let toks = split_ws(line)
    if toks.length() == 0 {
      continue
    }
    let cmd = toks[0]
    if cmd == "wait" {
      if toks.length() < 2 {
        return DriveEnd::Failed("drive: wait requires milliseconds: \{line}")
      }
      match parse_double(toks[1]) {
        Some(ms) => if !step_ms(t, ms, on_frame, frame_idx, max_frames) { return DriveEnd::Stopped }
        None => return DriveEnd::Failed("drive: invalid wait duration: \{line}")
      }
    } else if cmd == "tapxy" || cmd == "click" {
      if toks.length() < 3 {
        return DriveEnd::Failed("drive: \{cmd} requires x y: \{line}")
      }
      match (parse_double(toks[1]), parse_double(toks[2])) {
        (Some(x), Some(y)) => {
          t.click(x, y)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        _ => return DriveEnd::Failed("drive: invalid coordinates in \{line}")
      }
    } else if cmd == "tap" {
      let target = rest_after_cmd(line, 3)
      if target == "" {
        return DriveEnd::Failed("drive: tap requires a target label")
      }
      match t.get(target) {
        Some(d) => {
          t.tap(d.x + d.w * 0.5, d.y + d.h * 0.5)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        None => match t.find(target) {
          Some((x, y)) => {
            t.tap(x, y)
            if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
            frame_idx.v = frame_idx.v + 1
          }
          None => return DriveEnd::Failed("drive: tap target not found: \{target}")
        }
      }
    } else if cmd == "press" {
      let target = rest_after_cmd(line, 5)
      if target == "" {
        return DriveEnd::Failed("drive: press requires a target label")
      }
      let is_special_key = target == "Enter" || target == "Space" || target == "Tab" || target == "Escape"
      let found = is_special_key || (match t.get(target) {
        Some(_) => true
        None => t.find(target).is_some()
      })
      if !found {
        return DriveEnd::Failed("drive: press target not found: \{target}")
      }
      t.press(target)
      if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "hover" {
      let target = rest_after_cmd(line, 5)
      if target == "" {
        return DriveEnd::Failed("drive: hover requires a target label")
      }
      match t.get(target) {
        Some(d) => {
          t.move_to(d.x + d.w * 0.5, d.y + d.h * 0.5)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        None => match t.find(target) {
          Some((x, y)) => {
            t.move_to(x, y)
            if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
            frame_idx.v = frame_idx.v + 1
          }
          None => return DriveEnd::Failed("drive: hover target not found: \{target}")
        }
      }
    } else if cmd == "drag" {
      if toks.length() < 6 {
        return DriveEnd::Failed("drive: drag requires x y dx dy ms: \{line}")
      }
      match (parse_double(toks[1]), parse_double(toks[2]), parse_double(toks[3]), parse_double(toks[4]), parse_double(toks[5])) {
        (Some(x), Some(y), Some(dx), Some(dy), Some(ms)) => {
          t.press_at(x, y)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
          if !step_drag(t, x, y, dx, dy, ms, on_frame, frame_idx, max_frames) { return DriveEnd::Stopped }
          t.release(x + dx, y + dy)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        _ => return DriveEnd::Failed("drive: invalid drag arguments: \{line}")
      }
    } else if cmd == "holdon" {
      if toks.length() < 6 {
        return DriveEnd::Failed("drive: holdon requires hold_ms dx dy move_ms @x,y: \{line}")
      }
      match (parse_double(toks[1]), parse_double(toks[2]), parse_double(toks[3]), parse_double(toks[4]), parse_at_xy(toks[5])) {
        (Some(hold_ms), Some(dx), Some(dy), Some(move_ms), Some((x, y))) => {
          t.press_at(x, y)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
          if !step_ms(t, hold_ms, on_frame, frame_idx, max_frames) { return DriveEnd::Stopped }
          if !step_drag(t, x, y, dx, dy, move_ms, on_frame, frame_idx, max_frames) { return DriveEnd::Stopped }
          t.release(x + dx, y + dy)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        _ => return DriveEnd::Failed("drive: invalid holdon arguments: \{line}")
      }
    } else if cmd == "key" {
      if toks.length() < 2 {
        return DriveEnd::Failed("drive: key requires a key spec: \{line}")
      }
      if !dispatch_key_spec(t, toks[1]) {
        return DriveEnd::Failed("drive: unknown key spec: \{toks[1]}")
      }
      if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "type" {
      let text = rest_after_cmd_raw(raw_cmd, 4)
      if text == "" {
        return DriveEnd::Failed("drive: type requires text")
      }
      t.type_text(text)
      if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
      frame_idx.v = frame_idx.v + 1
    } else if cmd == "resize" {
      if toks.length() < 3 {
        return DriveEnd::Failed("drive: resize requires w h: \{line}")
      }
      match (parse_double(toks[1]), parse_double(toks[2])) {
        (Some(w), Some(h)) => {
          t.resize(w, h)
          if !on_frame(frame_idx.v) { return DriveEnd::Stopped }
          frame_idx.v = frame_idx.v + 1
        }
        _ => return DriveEnd::Failed("drive: invalid resize arguments: \{line}")
      }
    } else {
      return DriveEnd::Failed("drive: unknown command: \{cmd}")
    }
  }
  DriveEnd::Done
}

/// Run a multi-line drive script on `t`, invoking `on_frame(frame_index)` after each frame.
pub fn run_drive_script(
  t : ui::Tester,
  script : String,
  max_frames : Int,
  on_frame : (Int) -> Bool,
  frame_idx : signals::Ref[Int],
) -> Bool {
  match run_drive_script_ex(t, script, max_frames, on_frame, frame_idx) {
    DriveEnd::Done => true
    DriveEnd::Stopped => false
    DriveEnd::Failed(msg) => {
      say(msg)
      false
    }
  }
}
