// Native macOS offscreen film & PNG snapshot FFI bindings.
// Bridges directly to packages/host/native/apple_film.m + apple_render.m via native/film_bridge.c.

import "host"

extern "C" fn c_film_supported() -> Int = "pion_film_supported"
extern "C" fn c_film_set_view(w : Double, h : Double, scale : Double) -> Unit = "pion_film_set_view"
extern "C" fn c_film_dirty(x : Double, y : Double, w : Double, h : Double) -> Unit = "pion_film_dirty"
extern "C" fn c_film_now_ms() -> Double = "pion_film_now_ms"
extern "C" fn c_film_spin(ms : Double) -> Unit = "pion_film_spin"
extern "C" fn c_film_open(path : Ptr, path_len : Int64, w : Int, h : Int, fps : Int) -> Int = "pion_film_open"
extern "C" fn c_film_draw(inst : Ptr, count : Int, r : Double, g : Double, b : Double) -> Int = "pion_film_draw"
extern "C" fn c_film_put(k : Int) -> Int = "pion_film_put"
extern "C" fn c_film_close(frames : Int) -> Int = "pion_film_close"
extern "C" fn c_film_finish(publish : Int) -> Int = "pion_film_finish"
extern "C" fn c_film_snapshot(path : Ptr, path_len : Int64, transparent : Int) -> Int = "pion_film_snapshot"
extern "C" fn c_film_say(msg : Ptr, msg_len : Int64) -> Unit = "pion_film_say"
extern "C" fn c_film_file_size(path : Ptr, path_len : Int64) -> Int64 = "pion_film_file_size"
extern "C" fn c_film_read_file(path : Ptr, path_len : Int64, out : Ptr, cap : Int64) -> Int64 = "pion_film_read_file"
extern "C" fn c_film_pid() -> Int = "pion_film_pid"
extern "C" fn c_film_remove_file(path : Ptr, path_len : Int64) -> Int = "pion_film_remove_file"
extern "C" fn c_film_ensure_parent_dir(path : Ptr, path_len : Int64) -> Int = "pion_film_ensure_parent_dir"

pub fn is_supported() -> Bool {
  c_film_supported() != 0
}

pub fn init_offscreen(w : Double, h : Double, scale : Double) -> Bool {
  if !host::init_offscreen(w, h, scale) {
    return false
  }
  c_film_set_view(w, h, scale)
  true
}

pub fn set_offscreen_view(w : Double, h : Double, scale : Double) -> Unit {
  c_film_set_view(w, h, scale)
}

pub fn mark_dirty_full() -> Unit {
  c_film_dirty(0.0, 0.0, -1.0, -1.0)
}

pub fn now_ms() -> Double {
  c_film_now_ms()
}

pub fn spin(ms : Double) -> Unit {
  c_film_spin(ms)
}

pub fn film_open(path : String, w : Int, h : Int, fps : Int) -> Bool {
  c_film_open(str_data_ptr(path), path.length().to_int64(), w, h, fps) != 0
}

pub fn film_draw(inst : FixedArray[Double], count : Int, r : Double, g : Double, b : Double) -> Bool {
  c_film_draw(array_data_ptr(inst), count, r, g, b) != 0
}

pub fn film_put_frame(k : Int) -> Bool {
  c_film_put(k) != 0
}

pub fn film_close(frames : Int) -> Bool {
  c_film_close(frames) != 0
}

pub fn film_finish(publish : Bool) -> Bool {
  c_film_finish(if publish { 1 } else { 0 }) != 0
}

pub fn save_snapshot(path : String, transparent~ : Bool = false) -> Bool {
  c_film_snapshot(str_data_ptr(path), path.length().to_int64(), if transparent { 1 } else { 0 }) != 0
}

pub fn say(s : String) -> Unit {
  c_film_say(str_data_ptr(s), s.length().to_int64())
}

pub fn read_file_bytes(path : String) -> Option[Bytes] {
  let sz = c_film_file_size(str_data_ptr(path), path.length().to_int64())
  if sz <= 0L {
    return None
  }
  let n = sz.to_int()
  let buf = Array::make(n, 0 as Byte)
  let got = c_film_read_file(str_data_ptr(path), path.length().to_int64(), array_data_ptr(buf), sz)
  if got <= 0L {
    return None
  }
  Some(bytes_from_ptr(array_data_ptr(buf), got.to_int()))
}

pub fn process_id() -> Int {
  c_film_pid()
}

pub fn remove_file(path : String) -> Bool {
  c_film_remove_file(str_data_ptr(path), path.length().to_int64()) != 0
}

pub fn ensure_parent_dir(path : String) -> Bool {
  c_film_ensure_parent_dir(str_data_ptr(path), path.length().to_int64()) != 0
}
