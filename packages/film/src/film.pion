// Offscreen PNG snapshot (picture / picture_tree / picture_bytes) and H.264 MP4 recording (film / film_tree)
// driven by ui::Tester::tree and rendered via Apple Metal (packages/host).
// Ported from libs/ui/src/film/{picture.pion,film.pion,scene.pion}.

import "host"
import "hostapi"
import "ui"
import "view"
import "signals"

pub let film_fps : Int = 60
let inst_size : Int = ui::inst_size

fn is_nan_d(x : Double) -> Bool {
  x != x
}

fn is_inf_d(x : Double) -> Bool {
  let inf = 1.0 / 0.0
  x == inf || x == -inf
}

fn clear_rgb_from_theme(dark : Bool) -> (Double, Double, Double) {
  let bg = ui::tree_theme().bg
  if (bg & 0xFFL) != 0L {
    (
      ((bg >> 24) & 0xFFL).to_double() / 255.0,
      ((bg >> 16) & 0xFFL).to_double() / 255.0,
      ((bg >> 8) & 0xFFL).to_double() / 255.0,
    )
  } else if dark {
    (0.08, 0.09, 0.11)
  } else {
    (0.98, 0.98, 0.99)
  }
}

/// Normalize ui::Scene instances for Apple Metal offscreen rendering:
/// - ensures instances with default zero clip rects use full-canvas clipping `(0, 0, 1e9, 1e9)`
/// - assigns distinct negative glass capture ids in slot 20 (`pad.x`) for kind 5 (frosted) / kind 6 (liquid)
///   when unset so `apple_render.m` triggers backdrop capture, blur, and refraction.
pub fn prepare_metal_instances(scene : ui::Scene) -> (FixedArray[Double], Int) {
  let n = scene.ninst
  let len = n * inst_size
  let src = scene.inst
  let keep = if len < src.length() { len } else { src.length() }
  let out = FixedArray::make(keep, 0.0)
  let mut k = 0
  while k < keep {
    out[k] = src[k]
    k += 1
  }
  let mut next_glass_id = -1
  let mut i = 0
  while i < n {
    let base = i * inst_size
    if base + 20 < out.length() {
      let kind = (out[base + 5] + 0.5).to_int()
      if kind != 12 && out[base + 18] <= 0.0 && out[base + 19] <= 0.0 {
        out[base + 16] = 0.0
        out[base + 17] = 0.0
        out[base + 18] = 1.0e9
        out[base + 19] = 1.0e9
      }
      if (kind == 5 || kind == 6) && out[base + 20] >= 0.0 {
        out[base + 20] = next_glass_id.to_double()
        next_glass_id -= 1
      }
    }
    i += 1
  }
  (out, n)
}

/// The native host's text and pictures put in the Tester's fake host `cur` before its tree is built
/// (`ui::Tester::tree`'s `host_patch`), so the tree is measured, shaped and drawn by them from its first frame.
fn patch_native_text_and_images(cur : hostapi::Host) -> Unit {
  let native = host::native_host()
  cur.font_metrics = native.font_metrics
  cur.shape = native.shape
  cur.text_key = native.text_key
  cur.glyph = native.glyph
  cur.glyph_put = native.glyph_put
  cur.atlas_size = native.atlas_size
  cur.atlas_generation = native.atlas_generation
  // (and its atlas's pages: the Tester's extensions are its fake's)
  let ext = hostapi::host_ext()
  let native_ext = host::native_host_ext()
  ext.atlas_pages_most = native_ext.atlas_pages_most
  ext.atlas_pages_now = native_ext.atlas_pages_now
  ext.atlas_pages = native_ext.atlas_pages
  cur.face_add = native.face_add
  cur.face_add_bytes = native.face_add_bytes
  cur.face_clear = native.face_clear
  cur.face_add_family = native.face_add_family
  cur.rn_glass_light_angle = native.rn_glass_light_angle
  cur.image_load = native.image_load
  cur.image_load_bytes = native.image_load_bytes
  cur.image_info = native.image_info
  cur.image_free = native.image_free
  cur.image_pixels = native.image_pixels
  hostapi::set_host(cur)
  // Pictures an earlier tree asked for are let go: this tree's are loaded anew by the native host (settle_images waits
  // for their decode), as each picture always loaded its own.
  ui::images_reset()
}

// The glyph atlas the last picture or film left (its tree disposed keeping it), what its native host's atlas generation
// and the scale and the atlas's epoch were then: the next one at the same scale keeps the glyphs placed while nothing
// let them go since (`ui::Tester::tree`'s `keep_glyph_atlas`).
let film_native_atlas_ready : signals::Ref[Bool] = ui::ref_new(false)
let film_native_atlas_gen : signals::Ref[Int] = ui::ref_new(-1)
let film_native_atlas_scale : signals::Ref[Double] = ui::ref_new(0.0)
let film_native_atlas_epoch : signals::Ref[Int] = ui::ref_new(-1)

fn native_atlas_generation() -> Int {
  let native = host::native_host()
  (native.atlas_generation)()
}

fn native_atlas_kept(scale : Double) -> Bool {
  film_native_atlas_ready.v &&
  (film_native_atlas_scale.v - scale).abs() <= 0.001 &&
  film_native_atlas_epoch.v == ui::glyph_atlas_epoch() &&
  film_native_atlas_gen.v == native_atlas_generation()
}

/// A Tester whose tree is measured and drawn by the native host's text and pictures from its first frame, with no
/// in-frame reference-scene verification (a picture's frames are not a test's).
fn native_tester(
  tree : (view::View) -> Unit,
  w : Double,
  h : Double,
  scale : Double,
  theme : Option[() -> ui::Theme],
  transitions_only : Bool,
  platform : Int,
  dark : Bool,
  window_corner : Double,
) -> ui::Tester {
  let keep = native_atlas_kept(scale)
  let t = match theme {
    Some(tf) =>
      ui::Tester::tree(
        tree,
        w=w,
        h=h,
        scale=scale,
        theme=tf,
        transitions_only=transitions_only,
        platform=platform,
        dark=dark,
        window_corner=window_corner,
        // Screenshot/film preview renders are not interactive UI tests; skip test-only frame audits.
        corners_held=false,
        unnamed_press_held=false,
        effect_in_view_held=false,
        keep_glyph_atlas=keep,
        begun=fn() { patch_native_text_and_images(hostapi::host()) },
      )
    None =>
      ui::Tester::tree(
        tree,
        w=w,
        h=h,
        scale=scale,
        transitions_only=transitions_only,
        platform=platform,
        dark=dark,
        window_corner=window_corner,
        corners_held=false,
        unnamed_press_held=false,
        effect_in_view_held=false,
        keep_glyph_atlas=keep,
        begun=fn() { patch_native_text_and_images(hostapi::host()) },
      )
  }
  // Match upstream film/bench setup: draw once without in-frame reference-scene / corner-look double passes,
  // avoiding races with async native image decoding on macOS.
  t.check_looks(false)
  t.corners_look(false)
  if t.frame_requested() {
    // (what the first frame asked for drawn, as the frame that followed it always drew it)
    t.resize(w, h)
  }
  t
}

/// The Tester disposed with its glyph atlas kept for the next picture or film at `scale`.
fn dispose_keeping_atlas(t : ui::Tester, scale : Double) -> Unit {
  t.dispose(keep_glyph_atlas=true)
  film_native_atlas_ready.v = true
  film_native_atlas_gen.v = native_atlas_generation()
  film_native_atlas_scale.v = scale
  film_native_atlas_epoch.v = ui::glyph_atlas_epoch()
}

/// Asks the tree's pictures of the native host and waits (up to ~2 s of real time) for their decode, which runs off
/// the main thread on Apple, so the shot shows them rather than their stand-ins. Returns the scene encoded last: the
/// tree as it is drawn once nothing is pending.
fn settle_images(t : ui::Tester, w : Double, h : Double, scale : Double) -> ui::Scene {
  let mut tries = 0
  while tries < 200 {
    let scene = tester_scene(t, w, h, scale)
    if !ui::images_pending() {
      return scene
    }
    host::pump_main_loop(10.0)
    tries += 1
  }
  tester_scene(t, w, h, scale)
}

fn tester_scene(t : ui::Tester, w : Double, h : Double, scale : Double) -> ui::Scene {
  match ui::view_tree() {
    Some(tr) => ui::encode_tree_scene(tr, w, h, scale, t.time())
    None => t.scene()
  }
}

fn instances_equal(a : FixedArray[Double], b : FixedArray[Double], n : Int) -> Bool {
  if a.length() < n || b.length() < n {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

fn has_live_stream_instance(inst : FixedArray[Double], count : Int) -> Bool {
  let lo = hostapi::stream_tex_base.to_double()
  let hi = hostapi::layer_tex_base.to_double()
  let mut i = 0
  while i < count {
    let base = i * inst_size
    if base + 20 < inst.length() {
      let tid = inst[base + 20]
      if tid > lo && tid <= hi {
        return true
      }
    }
    i += 1
  }
  false
}

fn offscreen_native_host(prev : hostapi::Host) -> hostapi::Host {
  let h = host::native_host()
  h.system_dark = prev.system_dark
  h
}

/// The Tester's tree settled (`settle_images`) and written to `path` as a PNG in one step (`save_snapshot_inst`):
/// drawn as a present of its scene then `save_snapshot` drew it, without a frame handed to be shown between.
fn snapshot_tester(
  t : ui::Tester,
  w : Double,
  h : Double,
  scale : Double,
  dark : Bool,
  path : String,
  transparent : Bool,
  async_write : Bool,
) -> Bool {
  let (r, g, b) = clear_rgb_from_theme(dark)
  let prev = hostapi::host()
  hostapi::set_host(offscreen_native_host(prev))
  let scene = settle_images(t, w, h, scale)
  let (inst, count) = prepare_metal_instances(scene)
  let ok = save_snapshot_inst(inst, count, r, g, b, path, transparent=transparent, async_write=async_write)
  hostapi::set_host(prev)
  ok
}

let picture_bytes_seq : signals::Ref[Int] = ui::ref_new(0)

/// Render a pure-tree `view::View` scene offscreen via native GPU (Metal / EGL-GLES3) to a PNG file at `path`.
/// `async_write=true` writes the PNG behind on Apple while the next picture is drawn: `true` then says the picture
/// was taken, and `flush_pictures()` waits for every such PNG and tells whether all were written (the process waits
/// for them at exit too; elsewhere the PNG is written at once). Left `false`, the PNG is written before this returns.
pub fn picture(
  tree : (view::View) -> Unit,
  path~ : String,
  w~ : Double,
  h~ : Double,
  scale~ : Double = 2.0,
  platform~ : Int = 0,
  dark~ : Bool = false,
  inset~ : Bool = false,
  window_corner~ : Double = 0.0,
  prepare~ : String = "",
  script~ : String = "",
  at~ : Double = 0.0,
  frame? : Int,
  fps~ : Int = film_fps,
  max~ : Int = 3000,
  transparent~ : Bool = false,
  corners_held~ : Bool = false,
  corner_faults_ok~ : (Array[String]) -> Bool = fn(faults : Array[String]) -> Bool { faults.length() == 0 },
  words_over_held~ : Bool = false,
  theme? : () -> ui::Theme,
  transitions_only~ : Bool = true,
  solid_glass~ : Bool = false,
  async_write~ : Bool = false,
) -> Bool {
  let _ = inset
  if !is_supported() || path == "" || w <= 0.0 || h <= 0.0 || scale <= 0.0 ||
     is_nan_d(w) || is_nan_d(h) || is_nan_d(scale) || is_inf_d(w) || is_inf_d(h) || is_inf_d(scale) ||
     at < 0.0 || is_nan_d(at) || is_inf_d(at) || fps <= 0 || max <= 0 {
    say("picture: an output path, positive finite size, non-negative time and a supported host are required")
    return false
  }
  match frame {
    Some(k) => if k < 0 || at > 0.0 || script == "" {
      say("picture: invalid frame capture arguments")
      return false
    }
    None => ()
  }
  if !ensure_parent_dir(path) {
    say("picture: could not create parent directory for \{path}")
    return false
  }
  if solid_glass {
    ui::set_glass_solid(Some(true))
  }
  let prev_init = hostapi::host()
  hostapi::set_host(offscreen_native_host(prev_init))
  let ok_init = init_offscreen(w, h, scale)
  hostapi::set_host(prev_init)
  if !ok_init {
    if solid_glass {
      ui::set_glass_solid(None)
    }
    say("picture: offscreen renderer initialization failed")
    return false
  }
  let t = native_tester(tree, w, h, scale, theme, transitions_only, platform, dark, window_corner)
  t.set_period_ms(1000.0 / fps.to_double())
  let frame_idx = ui::ref_new(0)
  let noop_cb = fn(_k : Int) -> Bool { true }
  let mut ok_drive = true
  if prepare != "" {
    match run_drive_script_ex(t, prepare, max, noop_cb, frame_idx) {
      DriveEnd::Done => ()
      DriveEnd::Stopped => ()
      DriveEnd::Failed(msg) => {
        say(msg)
        ok_drive = false
      }
    }
  }
  if ok_drive && script != "" {
    match frame {
      Some(target_k) => {
        let script_idx = ui::ref_new(0)
        let stop_at = fn(k : Int) -> Bool { k < target_k }
        match run_drive_script_ex(t, script, target_k + 1, stop_at, script_idx) {
          DriveEnd::Done => ()
          DriveEnd::Stopped => ()
          DriveEnd::Failed(msg) => {
            say(msg)
            ok_drive = false
          }
        }
      }
      None => {
        match run_drive_script_ex(t, script, max, noop_cb, frame_idx) {
          DriveEnd::Done => ()
          DriveEnd::Stopped => ()
          DriveEnd::Failed(msg) => {
            say(msg)
            ok_drive = false
          }
        }
      }
    }
  }
  if ok_drive && at > 0.0 {
    t.run_shown(at)
  }
  let mut gates_ok = ok_drive
  if gates_ok && corners_held {
    let cf = t.corner_faults()
    if !corner_faults_ok(cf) {
      let detail = if cf.length() > 0 { cf[0] } else { "custom corner_faults_ok returned false" }
      say("picture: corner_faults failed (\{cf.length()}): \{detail}")
      gates_ok = false
    }
  }
  if gates_ok && words_over_held {
    let wf = t.words_over_faults()
    if wf.length() > 0 {
      say("picture: words_over_faults failed (\{wf.length()}): \{wf[0]}")
      gates_ok = false
    }
  }
  let saved = if gates_ok { snapshot_tester(t, w, h, scale, dark, path, transparent, async_write) } else { false }
  dispose_keeping_atlas(t, scale)
  if solid_glass {
    ui::set_glass_solid(None)
  }
  if !gates_ok {
    return false
  }
  if !saved {
    say("picture: could not write \{path}")
    return false
  }
  true
}

/// Compatibility alias for `picture`.
pub fn picture_tree(
  tree : (view::View) -> Unit,
  path~ : String,
  w~ : Double,
  h~ : Double,
  scale~ : Double = 2.0,
  platform~ : Int = 0,
  dark~ : Bool = false,
  inset~ : Bool = false,
  window_corner~ : Double = 0.0,
  prepare~ : String = "",
  script~ : String = "",
  at~ : Double = 0.0,
  frame? : Int,
  fps~ : Int = film_fps,
  max~ : Int = 3000,
  transparent~ : Bool = false,
  corners_held~ : Bool = false,
  corner_faults_ok~ : (Array[String]) -> Bool = fn(faults : Array[String]) -> Bool { faults.length() == 0 },
  words_over_held~ : Bool = false,
  theme? : () -> ui::Theme,
  transitions_only~ : Bool = true,
  solid_glass~ : Bool = false,
  async_write~ : Bool = false,
) -> Bool {
  picture(
    tree,
    path=path,
    w=w,
    h=h,
    scale=scale,
    platform=platform,
    dark=dark,
    inset=inset,
    window_corner=window_corner,
    prepare=prepare,
    script=script,
    at=at,
    frame?=frame,
    fps=fps,
    max=max,
    transparent=transparent,
    corners_held=corners_held,
    corner_faults_ok=corner_faults_ok,
    words_over_held=words_over_held,
    theme?=theme,
    transitions_only=transitions_only,
    solid_glass=solid_glass,
    async_write=async_write,
  )
}

/// Waits for every PNG `picture` wrote behind (`async_write`) and tells whether all of them were written since the
/// last call. `true` at once when none is pending.
pub fn flush_pictures() -> Bool {
  flush_snapshots()
}

/// Render a pure-tree `view::View` scene offscreen via Apple Metal and return the encoded PNG `Bytes`.
pub fn picture_bytes(
  tree : (view::View) -> Unit,
  w~ : Double,
  h~ : Double,
  scale~ : Double = 2.0,
  platform~ : Int = 0,
  dark~ : Bool = false,
  prepare~ : String = "",
  script~ : String = "",
  at~ : Double = 0.0,
  fps~ : Int = film_fps,
  transparent~ : Bool = false,
  theme? : () -> ui::Theme,
  transitions_only~ : Bool = true,
  solid_glass~ : Bool = false,
) -> Option[Bytes] {
  picture_bytes_seq.v = picture_bytes_seq.v + 1
  let tmp_path = "/tmp/invar_film_bytes_\{process_id()}_\{picture_bytes_seq.v}.png"
  let ok = picture(
    tree,
    path=tmp_path,
    w=w,
    h=h,
    scale=scale,
    platform=platform,
    dark=dark,
    prepare=prepare,
    script=script,
    at=at,
    fps=fps,
    transparent=transparent,
    theme?=theme,
    transitions_only=transitions_only,
    solid_glass=solid_glass,
  )
  let res = if ok { read_file_bytes(tmp_path) } else { None }
  let _ = remove_file(tmp_path)
  res
}

/// Record a scripted pure-tree `view::View` run offscreen via native GPU into an H.264 MP4 at `out`.
pub fn film(
  tree : (view::View) -> Unit,
  script~ : String,
  out~ : String,
  w~ : Double = 390.0,
  h~ : Double = 844.0,
  scale~ : Double = 2.0,
  platform~ : Int = 0,
  dark~ : Bool = false,
  inset~ : Bool = false,
  window_corner~ : Double = 0.0,
  fps~ : Int = film_fps,
  prepare~ : String = "",
  max~ : Int = 3000,
  last~ : String = "",
  copied~ : String = "",
  allow_incomplete~ : Bool = false,
  corners_held~ : Bool = false,
  theme? : () -> ui::Theme,
  transitions_only~ : Bool = true,
) -> Bool {
  let _ = (inset, copied, allow_incomplete)
  if !is_supported() || out == "" || w <= 0.0 || h <= 0.0 || scale <= 0.0 ||
     is_nan_d(w) || is_nan_d(h) || is_nan_d(scale) || is_inf_d(w) || is_inf_d(h) || is_inf_d(scale) ||
     fps <= 0 || max <= 0 {
    say("film: invalid arguments or unsupported host")
    return false
  }
  if !ensure_parent_dir(out) {
    say("film: could not create parent directory for \{out}")
    return false
  }
  if last != "" && !ensure_parent_dir(last) {
    say("film: could not create parent directory for \{last}")
    return false
  }
  let pw = (w * scale).round().to_int()
  let ph = (h * scale).round().to_int()
  let prev_init = hostapi::host()
  hostapi::set_host(offscreen_native_host(prev_init))
  let ok_init = init_offscreen(w, h, scale)
  hostapi::set_host(prev_init)
  if !ok_init {
    say("film: offscreen renderer initialization failed")
    return false
  }
  let t = native_tester(tree, w, h, scale, theme, transitions_only, platform, dark, window_corner)
  t.set_period_ms(1000.0 / fps.to_double())
  let prep_idx = ui::ref_new(0)
  if prepare != "" {
    if !run_drive_script(t, prepare, max, fn(_k : Int) -> Bool { true }, prep_idx) {
      dispose_keeping_atlas(t, scale)
      return false
    }
  }
  if !film_open(out, pw, ph, fps) {
    dispose_keeping_atlas(t, scale)
    return false
  }
  let written = ui::ref_new(0)
  let has_drawn = ui::ref_new(false)
  let last_inst : signals::Ref[FixedArray[Double]] = ui::ref_new(FixedArray::make(0, 0.0))
  let last_count = ui::ref_new(0)
  let last_r = ui::ref_new(-1.0)
  let last_g = ui::ref_new(-1.0)
  let last_b = ui::ref_new(-1.0)
  let last_light_angle = ui::ref_new(0.0)
  let emit_frame = fn(k : Int) -> Bool {
    let (r, g, b) = clear_rgb_from_theme(dark)
    let prev_h = hostapi::host()
    hostapi::set_host(offscreen_native_host(prev_h))
    let scene = match ui::view_tree() {
      Some(tr) => ui::encode_tree_scene(tr, w, h, scale, t.time())
      None => t.scene()
    }
    let (inst, count) = prepare_metal_instances(scene)
    let light_angle = ui::glass_light_angle()
    let same = has_drawn.v &&
      !has_live_stream_instance(inst, count) &&
      count == last_count.v &&
      r == last_r.v &&
      g == last_g.v &&
      b == last_b.v &&
      light_angle == last_light_angle.v &&
      instances_equal(inst, last_inst.v, count * inst_size)
    let ok_draw = if same {
      true
    } else {
      let drawn = film_draw(inst, count, r, g, b)
      if drawn {
        has_drawn.v = true
        last_inst.v = inst
        last_count.v = count
        last_r.v = r
        last_g.v = g
        last_b.v = b
        last_light_angle.v = light_angle
      }
      drawn
    }
    hostapi::set_host(prev_h)
    if !ok_draw {
      return false
    }
    if !film_put_frame(k) {
      return false
    }
    written.v = k + 1
    true
  }
  // Frame 0
  let ok0 = emit_frame(0)
  let frame_idx = ui::ref_new(1)
  let ok_run = if ok0 {
    run_drive_script(t, script, max, emit_frame, frame_idx)
  } else {
    false
  }
  let ok_corners = if ok_run && corners_held {
    let cf = t.corner_faults()
    if cf.length() > 0 {
      say("film: corner_faults failed (\{cf.length()}): \{cf[0]}")
      false
    } else {
      true
    }
  } else {
    ok_run
  }
  let ok_last = if ok_corners && last != "" {
    // (the last frame saved only when it was drawn: never a stale or empty framebuffer)
    snapshot_tester(t, w, h, scale, dark, last, false, false)
  } else {
    ok_corners
  }
  let closed = film_close(written.v)
  let published = film_finish(ok_corners && ok_last && closed)
  dispose_keeping_atlas(t, scale)
  ok_corners && ok_last && closed && published
}

/// Compatibility alias for `film`.
pub fn film_tree(
  tree : (view::View) -> Unit,
  script~ : String,
  out~ : String,
  w~ : Double = 390.0,
  h~ : Double = 844.0,
  scale~ : Double = 2.0,
  platform~ : Int = 0,
  dark~ : Bool = false,
  inset~ : Bool = false,
  window_corner~ : Double = 0.0,
  fps~ : Int = film_fps,
  prepare~ : String = "",
  max~ : Int = 3000,
  last~ : String = "",
  copied~ : String = "",
  allow_incomplete~ : Bool = false,
  corners_held~ : Bool = false,
  theme? : () -> ui::Theme,
  transitions_only~ : Bool = true,
) -> Bool {
  film(
    tree,
    script=script,
    out=out,
    w=w,
