// Offscreen Apple Metal rendering tests for packages/film:
// PNG picture capture, PNG byte header & pixel validation, transparent capture,
// drive script execution, and H.264 MP4 film recording.

import "host"
import "hostapi"
import "ui"
import "view"

fn is_png_header(b : Bytes) -> Bool {
  b.length() > 24 &&
  b[0].to_int() == 0x89 &&
  b[1].to_int() == 0x50 &&
  b[2].to_int() == 0x4E &&
  b[3].to_int() == 0x47 &&
  b[4].to_int() == 0x0D &&
  b[5].to_int() == 0x0A &&
  b[6].to_int() == 0x1A &&
  b[7].to_int() == 0x0A
}

fn read_be32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

test "film_picture_metal_offscreen_png_and_pixel_check" {
  debug_assert(is_supported(), "Apple macOS host must support offscreen film/picture")
  let png_path = "/tmp/invar_film_test_card.png"
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(card : view::View) -> Unit {
        let _ = card
          .width(view::Live::Is(Some(120.0)))
          .height(view::Live::Is(Some(80.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .ground(view::Live::Is(ui::rgba(230, 64, 52, 255)))
          .corners(view::Live::Is(Some((12.0, 12.0, 12.0, 12.0))))
          .words(view::Live::Is("Invar Metal"))
          .ink(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      })
    },
    path=png_path,
    w=160.0,
    h=120.0,
    scale=1.0,
    dark=true,
  )
  debug_assert(ok, "film::picture must succeed on Apple Metal offscreen")

  let png_bytes = match read_file_bytes(png_path) {
    Some(b) => b
    None => { debug_assert(false, "PNG file must be readable and non-empty"); return }
  }
  debug_assert(is_png_header(png_bytes), "output file must have valid PNG magic signature")
  let ihdr_w = read_be32(png_bytes, 16)
  let ihdr_h = read_be32(png_bytes, 20)
  debug_assert(ihdr_w == 160 && ihdr_h == 120, "PNG IHDR dimensions must match 160x120")

  // Decode PNG via native ImageIO and verify pixels are neither all-black nor all-transparent
  host::install()
  let img_id = hostapi::image_load(png_path, 256)
  debug_assert(img_id > 0, "image_load must return positive id")
  let info = Array::make(4, 0.0)
  let mut st = hostapi::image_info(img_id, info)
  let mut tries = 0
  while st == 0 && tries < 100 {
    host::pump_main_loop(10.0)
    st = hostapi::image_info(img_id, info)
    tries += 1
  }
  debug_assert(st == 1, "decoded PNG must reach ready state")
  let px = Array::make(160 * 120 * 4, 0 as Byte)
  debug_assert(hostapi::image_pixels(img_id, px), "image_pixels must read back RGBA pixels")

  let mut non_black = 0
  let mut non_transparent = 0
  let mut coral_pixels = 0
  let mut white_pixels = 0
  let mut idx = 0
  while idx < 160 * 120 * 4 {
    let r = px[idx].to_int()
    let g = px[idx + 1].to_int()
    let b = px[idx + 2].to_int()
    let a = px[idx + 3].to_int()
    if a > 0 { non_transparent += 1 }
    if r > 20 || g > 20 || b > 20 { non_black += 1 }
    if r > 180 && g < 100 && b < 90 && a == 255 { coral_pixels += 1 }
    if r > 200 && g > 200 && b > 200 && a == 255 { white_pixels += 1 }
    idx += 4
  }
  hostapi::image_free(img_id)
  debug_assert(non_transparent > 1000, "rendered PNG must not be all transparent")
  debug_assert(non_black > 1000, "rendered PNG must not be all black")
  debug_assert(coral_pixels > 500, "rendered coral card pixels must appear in Metal output")
  debug_assert(white_pixels > 20, "rendered white CoreText glyph pixels must appear in Metal output")
}

test "film_picture_bytes_retina_2x" {
  let bytes_opt = picture_bytes(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(panel : view::View) -> Unit {
        let _ = panel
          .width(view::Live::Is(Some(80.0)))
          .height(view::Live::Is(Some(60.0)))
          .ground(view::Live::Is(ui::rgba(40, 160, 220, 255)))
      })
    },
    w=100.0,
    h=80.0,
    scale=2.0,
    dark=false,
  )
  let b = match bytes_opt {
    Some(data) => data
    None => { debug_assert(false, "picture_bytes must return Some(Bytes)"); return }
  }
  debug_assert(is_png_header(b), "picture_bytes must return valid PNG bytes")
  debug_assert(read_be32(b, 16) == 200 && read_be32(b, 20) == 160, "2x scale PNG must be 200x160 pixels")
}

test "film_picture_transparent_background" {
  let path = "/tmp/invar_film_test_transparent.png"
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(dot : view::View) -> Unit {
        let _ = dot
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .ground(view::Live::Is(ui::rgba(80, 220, 120, 255)))
          .corners(view::Live::Is(Some((20.0, 20.0, 20.0, 20.0))))
      })
    },
    path=path,
    w=80.0,
    h=80.0,
    scale=1.0,
    transparent=true,
  )
  debug_assert(ok, "transparent PNG snapshot must succeed")
  let b = match read_file_bytes(path) {
    Some(data) => data
    None => { debug_assert(false, "transparent PNG must exist"); return }
  }
  debug_assert(is_png_header(b), "transparent output must be valid PNG")
}

test "film_drive_script_and_interactive_capture" {
  let tapped = ui::ref_new(false)
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(btn : view::View) -> Unit {
        let _ = btn
          .width(view::Live::Is(Some(100.0)))
          .height(view::Live::Is(Some(50.0)))
          .ground(view::Live::Is(ui::rgba(60, 120, 240, 255)))
          .on_press(fn() -> Unit { tapped.v = true })
      })
    },
    path="/tmp/invar_film_test_drive.png",
    w=120.0,
    h=80.0,
    scale=1.0,
    script="wait 50\ntapxy 30 20\nwait 50",
    at=50.0,
  )
  debug_assert(ok, "drive script picture must succeed")
  debug_assert(tapped.v, "tapxy in drive script must trigger on_press handler")
}

test "film_mp4_recording_apple_avfoundation" {
  let mp4_path = "/tmp/invar_film_test_clip.mp4"
  let ok = film(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(card : view::View) -> Unit {
        let _ = card
          .width(view::Live::Is(Some(96.0)))
          .height(view::Live::Is(Some(64.0)))
          .ground(view::Live::Is(ui::rgba(240, 150, 40, 255)))
      })
    },
    script="wait 100",
    out=mp4_path,
    w=128.0,
    h=96.0,
    scale=1.0,
    fps=30,
    dark=true,
  )
  debug_assert(ok, "film::film MP4 recording must succeed on Apple AVFoundation + Metal")
  let mp4_bytes = match read_file_bytes(mp4_path) {
    Some(b) => b
    None => { debug_assert(false, "MP4 file must be readable and non-empty"); return }
  }
  debug_assert(mp4_bytes.length() > 512, "MP4 output must be a non-trivial H.264 file")
}

test "film_rejects_invalid_dimensions" {
  let bad = picture(
    fn(_r : view::View) -> Unit { () },
    path="/tmp/should_not_exist.png",
    w=0.0,
    h=100.0,
  )
  debug_assert(!bad, "picture must reject zero width")
  let bad_path = picture(
    fn(_r : view::View) -> Unit { () },
    path="",
    w=100.0,
    h=100.0,
  )
  debug_assert(!bad_path, "picture must reject empty path")
}

fn decode_png_rgba(path : String, w : Int, h : Int) -> Array[Byte] {
  host::install()
  let img_id = hostapi::image_load(path, 2048)
  debug_assert(img_id > 0, "image_load must succeed for \{path}")
  let info = Array::make(4, 0.0)
  let mut st = hostapi::image_info(img_id, info)
  let mut tries = 0
  while st == 0 && tries < 200 {
    host::pump_main_loop(10.0)
    st = hostapi::image_info(img_id, info)
    tries += 1
  }
  debug_assert(st == 1, "decoded PNG must reach ready state for \{path}")
  let px = Array::make(w * h * 4, 0 as Byte)
  debug_assert(hostapi::image_pixels(img_id, px), "image_pixels must succeed for \{path}")
  hostapi::image_free(img_id)
  px
}

test "film_quad_bezier_long_shallow_translation_invariance_and_sagitta" {
  // 8000 px wide, 1.0 px sagitta shallow quadratic Bezier (apex at t=0.5 is 1.0 px above chord):
  //   A = (-3000, 320), B = (1000, 318), C = (5000, 320) -> P(0.5) = (1000, 319).
  // Verify on real GPU offscreen rendering:
  //   1. Tile translation by (-512, -256) matches direct full-canvas render pixel-for-pixel (max diff <= 1).
  //   2. The 1.0 px sagitta at x=1000 is preserved (peak centered at y=319, NOT flattened to chord y=320).
  let prev = hostapi::host()
  hostapi::set_host(host::native_host())

  // Frame A: direct full canvas (1024x384 @ 1x) containing [512..768)x[256..384) and the apex region.
  debug_assert(init_offscreen(1024.0, 384.0, 1.0), "init_offscreen full canvas")
  let sc_full = ui::Scene::new()
  sc_full.emit_quad_bezier(-3000.0, 320.0, 1000.0, 318.0, 5000.0, 320.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_full, cnt_full) = prepare_metal_instances(sc_full)
  mark_dirty_full()
  hostapi::present(inst_full, cnt_full, 0.0, 0.0, 0.0)
  let path_full = "/tmp/invar_film_qbez_full.png"
  debug_assert(save_snapshot(path_full, transparent=false), "save full qbez snapshot")

  // Frame B: 256x128 tile shifted by (-512, -256), covering [512..768)x[256..384) of Frame A.
  debug_assert(init_offscreen(256.0, 128.0, 1.0), "init_offscreen tile canvas")
  let sc_tile = ui::Scene::new()
  sc_tile.emit_quad_bezier(-3512.0, 64.0, 488.0, 62.0, 4488.0, 64.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_tile, cnt_tile) = prepare_metal_instances(sc_tile)
  mark_dirty_full()
  hostapi::present(inst_tile, cnt_tile, 0.0, 0.0, 0.0)
  let path_tile = "/tmp/invar_film_qbez_tile.png"
  debug_assert(save_snapshot(path_tile, transparent=false), "save tile qbez snapshot")

  // Frame C: 256x128 tile centered on the apex x=1000 (shifted by (-872, -256) so apex is at (128, 63)).
  debug_assert(init_offscreen(256.0, 128.0, 1.0), "init_offscreen apex canvas")
  let sc_apex = ui::Scene::new()
  sc_apex.emit_quad_bezier(-3872.0, 64.0, 128.0, 62.0, 4128.0, 64.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_apex, cnt_apex) = prepare_metal_instances(sc_apex)
  mark_dirty_full()
  hostapi::present(inst_apex, cnt_apex, 0.0, 0.0, 0.0)
  let path_apex = "/tmp/invar_film_qbez_apex.png"
  debug_assert(save_snapshot(path_apex, transparent=false), "save apex qbez snapshot")

  hostapi::set_host(prev)

  let px_full = decode_png_rgba(path_full, 1024, 384)
  let px_tile = decode_png_rgba(path_tile, 256, 128)
  let px_apex = decode_png_rgba(path_apex, 256, 128)

  // 1. Tile vs direct full-canvas comparison over 256x128 overlapping pixels.
  let mut max_diff = 0
  let mut lit_pixels = 0
  let mut y = 0
  while y < 128 {
    let mut x = 0
    while x < 256 {
      let fi = ((y + 256) * 1024 + (x + 512)) * 4
      let ti = (y * 256 + x) * 4
      if px_tile[ti].to_int() > 100 {
        lit_pixels += 1
      }
      let mut ch = 0
      while ch < 3 {
        let a = px_full[fi + ch].to_int()
        let b = px_tile[ti + ch].to_int()
        let d = if a >= b { a - b } else { b - a }
        if d > max_diff {
          max_diff = d
        }
        ch += 1
      }
      x += 1
    }
    y += 1
  }
  debug_assert(lit_pixels >= 200, "curve must draw across tile width, got \{lit_pixels} lit pixels")
  debug_assert(max_diff <= 1, "8000px shallow quad Bezier tile vs direct max channel diff must be <= 1, got \{max_diff}")

  // 2. Sagitta check at apex x=128: curve center is y=63.0 (half-width=1.0, covers y=62..64; pixel center at y+0.5).
  //    Pixel y=62 (center 62.5, dist 0.5) must be bright (>200), whereas pixel y=64 (center 64.5, dist 1.5)
  //    must be dark (<30) — if flattened to chord y=64.0, y=62 would be dark and y=64 would be bright.
  let r_62 = px_apex[(62 * 256 + 128) * 4].to_int()
  let r_63 = px_apex[(63 * 256 + 128) * 4].to_int()
  let r_64 = px_apex[(64 * 256 + 128) * 4].to_int()
  debug_assert(r_62 > 200 && r_63 > 200 && r_64 < 30, "1px sagitta at 8000px apex must stay at y=63 (not chord y=64): y62=\{r_62} y63=\{r_63} y64=\{r_64}")
}
