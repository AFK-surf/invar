// Offscreen Apple Metal rendering tests for packages/film:
// PNG picture capture, PNG byte header & pixel validation, transparent capture,
// drive script execution, and H.264 MP4 film recording.

import "host"
import "hostapi"
import "paint"
import "signals"
import "ui"
import "view"

fn is_png_header(b : Bytes) -> Bool {
  b.length() > 24 &&
  b[0].to_int() == 0x89 &&
  b[1].to_int() == 0x50 &&
  b[2].to_int() == 0x4E &&
  b[3].to_int() == 0x47 &&
  b[4].to_int() == 0x0D &&
  b[5].to_int() == 0x0A &&
  b[6].to_int() == 0x1A &&
  b[7].to_int() == 0x0A
}

fn read_be32(b : Bytes, off : Int) -> Int {
  (b[off].to_int() << 24) |
  (b[off + 1].to_int() << 16) |
  (b[off + 2].to_int() << 8) |
  b[off + 3].to_int()
}

test "film_picture_metal_offscreen_png_and_pixel_check" {
  debug_assert(is_supported(), "Apple macOS host must support offscreen film/picture")
  let png_path = "/tmp/invar_film_test_card.png"
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(card : view::View) -> Unit {
        let _ = card
          .width(view::Live::Is(Some(120.0)))
          .height(view::Live::Is(Some(80.0)))
          .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
          .ground(view::Live::Is(ui::rgba(230, 64, 52, 255)))
          .corners(view::Live::Is(Some((12.0, 12.0, 12.0, 12.0))))
          .words(view::Live::Is("Invar Metal"))
          .ink(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      })
    },
    path=png_path,
    w=160.0,
    h=120.0,
    scale=1.0,
    dark=true,
  )
  debug_assert(ok, "film::picture must succeed on Apple Metal offscreen")

  let png_bytes = match read_file_bytes(png_path) {
    Some(b) => b
    None => { debug_assert(false, "PNG file must be readable and non-empty"); return }
  }
  debug_assert(is_png_header(png_bytes), "output file must have valid PNG magic signature")
  let ihdr_w = read_be32(png_bytes, 16)
  let ihdr_h = read_be32(png_bytes, 20)
  debug_assert(ihdr_w == 160 && ihdr_h == 120, "PNG IHDR dimensions must match 160x120")

  // Decode PNG via native ImageIO and verify pixels are neither all-black nor all-transparent
  host::install()
  let img_id = hostapi::image_load(png_path, 256)
  debug_assert(img_id > 0, "image_load must return positive id")
  let info = Array::make(4, 0.0)
  let mut st = hostapi::image_info(img_id, info)
  let mut tries = 0
  while st == 0 && tries < 100 {
    host::pump_main_loop(10.0)
    st = hostapi::image_info(img_id, info)
    tries += 1
  }
  debug_assert(st == 1, "decoded PNG must reach ready state")
  let px = Array::make(160 * 120 * 4, 0 as Byte)
  debug_assert(hostapi::image_pixels(img_id, px), "image_pixels must read back RGBA pixels")

  let mut non_black = 0
  let mut non_transparent = 0
  let mut coral_pixels = 0
  let mut white_pixels = 0
  let mut idx = 0
  while idx < 160 * 120 * 4 {
    let r = px[idx].to_int()
    let g = px[idx + 1].to_int()
    let b = px[idx + 2].to_int()
    let a = px[idx + 3].to_int()
    if a > 0 { non_transparent += 1 }
    if r > 20 || g > 20 || b > 20 { non_black += 1 }
    if r > 180 && g < 100 && b < 90 && a == 255 { coral_pixels += 1 }
    if r > 200 && g > 200 && b > 200 && a == 255 { white_pixels += 1 }
    idx += 4
  }
  hostapi::image_free(img_id)
  debug_assert(non_transparent > 1000, "rendered PNG must not be all transparent")
  debug_assert(non_black > 1000, "rendered PNG must not be all black")
  debug_assert(coral_pixels > 500, "rendered coral card pixels must appear in Metal output")
  debug_assert(white_pixels > 20, "rendered white CoreText glyph pixels must appear in Metal output")
}

test "film_picture_bytes_retina_2x" {
  let bytes_opt = picture_bytes(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(panel : view::View) -> Unit {
        let _ = panel
          .width(view::Live::Is(Some(80.0)))
          .height(view::Live::Is(Some(60.0)))
          .ground(view::Live::Is(ui::rgba(40, 160, 220, 255)))
      })
    },
    w=100.0,
    h=80.0,
    scale=2.0,
    dark=false,
  )
  let b = match bytes_opt {
    Some(data) => data
    None => { debug_assert(false, "picture_bytes must return Some(Bytes)"); return }
  }
  debug_assert(is_png_header(b), "picture_bytes must return valid PNG bytes")
  debug_assert(read_be32(b, 16) == 200 && read_be32(b, 20) == 160, "2x scale PNG must be 200x160 pixels")
}

test "film_picture_transparent_background" {
  let path = "/tmp/invar_film_test_transparent.png"
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(dot : view::View) -> Unit {
        let _ = dot
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .ground(view::Live::Is(ui::rgba(80, 220, 120, 255)))
          .corners(view::Live::Is(Some((20.0, 20.0, 20.0, 20.0))))
      })
    },
    path=path,
    w=80.0,
    h=80.0,
    scale=1.0,
    transparent=true,
  )
  debug_assert(ok, "transparent PNG snapshot must succeed")
  let b = match read_file_bytes(path) {
    Some(data) => data
    None => { debug_assert(false, "transparent PNG must exist"); return }
  }
  debug_assert(is_png_header(b), "transparent output must be valid PNG")
}

test "film_drive_script_and_interactive_capture" {
  let tapped = ui::ref_new(false)
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(btn : view::View) -> Unit {
        let _ = btn
          .width(view::Live::Is(Some(100.0)))
          .height(view::Live::Is(Some(50.0)))
          .ground(view::Live::Is(ui::rgba(60, 120, 240, 255)))
          .on_press(fn() -> Unit { tapped.v = true })
      })
    },
    path="/tmp/invar_film_test_drive.png",
    w=120.0,
    h=80.0,
    scale=1.0,
    script="wait 50\ntapxy 30 20\nwait 50",
    at=50.0,
  )
  debug_assert(ok, "drive script picture must succeed")
  debug_assert(tapped.v, "tapxy in drive script must trigger on_press handler")
}

test "film_mp4_recording_apple_avfoundation" {
  let mp4_path = "/tmp/invar_film_test_clip.mp4"
  let ok = film(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(card : view::View) -> Unit {
        let _ = card
          .width(view::Live::Is(Some(96.0)))
          .height(view::Live::Is(Some(64.0)))
          .ground(view::Live::Is(ui::rgba(240, 150, 40, 255)))
      })
    },
    script="wait 100",
    out=mp4_path,
    w=128.0,
    h=96.0,
    scale=1.0,
    fps=30,
    dark=true,
  )
  debug_assert(ok, "film::film MP4 recording must succeed on Apple AVFoundation + Metal")
  let mp4_bytes = match read_file_bytes(mp4_path) {
    Some(b) => b
    None => { debug_assert(false, "MP4 file must be readable and non-empty"); return }
  }
  debug_assert(mp4_bytes.length() > 512, "MP4 output must be a non-trivial H.264 file")
}

test "film_rejects_invalid_dimensions" {
  let bad = picture(
    fn(_r : view::View) -> Unit { () },
    path="/tmp/should_not_exist.png",
    w=0.0,
    h=100.0,
  )
  debug_assert(!bad, "picture must reject zero width")
  let bad_path = picture(
    fn(_r : view::View) -> Unit { () },
    path="",
    w=100.0,
    h=100.0,
  )
  debug_assert(!bad_path, "picture must reject empty path")
}

fn decode_png_rgba(path : String, w : Int, h : Int) -> Array[Byte] {
  host::install()
  let img_id = hostapi::image_load(path, 2048)
  debug_assert(img_id > 0, "image_load must succeed for \{path}")
  let info = Array::make(4, 0.0)
  let mut st = hostapi::image_info(img_id, info)
  let mut tries = 0
  while st == 0 && tries < 200 {
    host::pump_main_loop(10.0)
    st = hostapi::image_info(img_id, info)
    tries += 1
  }
  debug_assert(st == 1, "decoded PNG must reach ready state for \{path}")
  let px = Array::make(w * h * 4, 0 as Byte)
  debug_assert(hostapi::image_pixels(img_id, px), "image_pixels must succeed for \{path}")
  hostapi::image_free(img_id)
  px
}

test "film_quad_bezier_long_shallow_translation_invariance_and_sagitta" {
  // 8000 px wide, 1.0 px sagitta shallow quadratic Bezier (apex at t=0.5 is 1.0 px above chord):
  //   A = (-3000, 320), B = (1000, 318), C = (5000, 320) -> P(0.5) = (1000, 319).
  // Verify on real GPU offscreen rendering:
  //   1. Tile translation by (-512, -256) matches direct full-canvas render pixel-for-pixel (max diff <= 1).
  //   2. The 1.0 px sagitta at x=1000 is preserved (peak centered at y=319, NOT flattened to chord y=320).
  let prev = hostapi::host()
  hostapi::set_host(host::native_host())

  // Frame A: direct full canvas (1024x384 @ 1x) containing [512..768)x[256..384) and the apex region.
  debug_assert(init_offscreen(1024.0, 384.0, 1.0), "init_offscreen full canvas")
  let sc_full = ui::Scene::new()
  sc_full.emit_quad_bezier(-3000.0, 320.0, 1000.0, 318.0, 5000.0, 320.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_full, cnt_full) = prepare_metal_instances(sc_full)
  mark_dirty_full()
  hostapi::present(inst_full, cnt_full, 0.0, 0.0, 0.0)
  let path_full = "/tmp/invar_film_qbez_full.png"
  debug_assert(save_snapshot(path_full, transparent=false), "save full qbez snapshot")

  // Frame B: 256x128 tile shifted by (-512, -256), covering [512..768)x[256..384) of Frame A.
  debug_assert(init_offscreen(256.0, 128.0, 1.0), "init_offscreen tile canvas")
  let sc_tile = ui::Scene::new()
  sc_tile.emit_quad_bezier(-3512.0, 64.0, 488.0, 62.0, 4488.0, 64.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_tile, cnt_tile) = prepare_metal_instances(sc_tile)
  mark_dirty_full()
  hostapi::present(inst_tile, cnt_tile, 0.0, 0.0, 0.0)
  let path_tile = "/tmp/invar_film_qbez_tile.png"
  debug_assert(save_snapshot(path_tile, transparent=false), "save tile qbez snapshot")

  // Frame C: 256x128 tile centered on the apex x=1000 (shifted by (-872, -256) so apex is at (128, 63)).
  debug_assert(init_offscreen(256.0, 128.0, 1.0), "init_offscreen apex canvas")
  let sc_apex = ui::Scene::new()
  sc_apex.emit_quad_bezier(-3872.0, 64.0, 128.0, 62.0, 4128.0, 64.0, 2.0, ui::rgba(255, 255, 255, 255))
  let (inst_apex, cnt_apex) = prepare_metal_instances(sc_apex)
  mark_dirty_full()
  hostapi::present(inst_apex, cnt_apex, 0.0, 0.0, 0.0)
  let path_apex = "/tmp/invar_film_qbez_apex.png"
  debug_assert(save_snapshot(path_apex, transparent=false), "save apex qbez snapshot")

  hostapi::set_host(prev)

  let px_full = decode_png_rgba(path_full, 1024, 384)
  let px_tile = decode_png_rgba(path_tile, 256, 128)
  let px_apex = decode_png_rgba(path_apex, 256, 128)

  // 1. Tile vs direct full-canvas comparison over 256x128 overlapping pixels.
  let mut max_diff = 0
  let mut lit_pixels = 0
  let mut y = 0
  while y < 128 {
    let mut x = 0
    while x < 256 {
      let fi = ((y + 256) * 1024 + (x + 512)) * 4
      let ti = (y * 256 + x) * 4
      if px_tile[ti].to_int() > 100 {
        lit_pixels += 1
      }
      let mut ch = 0
      while ch < 3 {
        let a = px_full[fi + ch].to_int()
        let b = px_tile[ti + ch].to_int()
        let d = if a >= b { a - b } else { b - a }
        if d > max_diff {
          max_diff = d
        }
        ch += 1
      }
      x += 1
    }
    y += 1
  }
  debug_assert(lit_pixels >= 200, "curve must draw across tile width, got \{lit_pixels} lit pixels")
  debug_assert(max_diff <= 1, "8000px shallow quad Bezier tile vs direct max channel diff must be <= 1, got \{max_diff}")

  // 2. Sagitta check at apex x=128: curve center is y=63.0 (half-width=1.0, covers y=62..64; pixel center at y+0.5).
  //    Pixel y=62 (center 62.5, dist 0.5) must be bright (>200), whereas pixel y=64 (center 64.5, dist 1.5)
  //    must be dark (<30) — if flattened to chord y=64.0, y=62 would be dark and y=64 would be bright.
  let r_62 = px_apex[(62 * 256 + 128) * 4].to_int()
  let r_63 = px_apex[(63 * 256 + 128) * 4].to_int()
  let r_64 = px_apex[(64 * 256 + 128) * 4].to_int()
  debug_assert(r_62 > 200 && r_63 > 200 && r_64 < 30, "1px sagitta at 8000px apex must stay at y=63 (not chord y=64): y62=\{r_62} y63=\{r_63} y64=\{r_64}")
}

test "film_picture_auto_creates_parent_dir_and_enforces_drive_and_craft_gates" {
  // 1. Nested non-existent parent directory is created automatically.
  let nested_root = "/tmp/invar_film_nested_\{process_id()}"
  let nested_sub = "\{nested_root}/sub"
  let nested = "\{nested_sub}/card.png"
  let ok_nested = picture(
    fn(root : view::View) -> Unit {
      let _ = root.box(fn(c : view::View) -> Unit {
        let _ = c.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(40.0))).ground(view::Live::Is(ui::rgba(50, 120, 220, 255)))
      })
    },
    path=nested,
    w=100.0,
    h=60.0,
    scale=1.0,
  )
  debug_assert(ok_nested, "picture must auto-create parent directory")
  let _ = remove_file(nested)
  let _ = remove_file(nested_sub)
  let _ = remove_file(nested_root)

  // 2. Drive script fails loudly on unknown command or missing target (never silently succeeds).
  let bad_cmd_path = "/tmp/invar_film_bad_cmd_\{process_id()}.png"
  let bad_cmd = picture(
    fn(_r : view::View) -> Unit { () },
    path=bad_cmd_path,
    w=100.0,
    h=60.0,
    scale=1.0,
    script="waitt 50",
  )
  let _ = remove_file(bad_cmd_path)
  debug_assert(!bad_cmd, "picture must fail on unknown drive command")

  let bad_target_path = "/tmp/invar_film_bad_target_\{process_id()}.png"
  let bad_target = picture(
    fn(_r : view::View) -> Unit { () },
    path=bad_target_path,
    w=100.0,
    h=60.0,
    scale=1.0,
    script="tap Nonexistent Button",
  )
  let _ = remove_file(bad_target_path)
  debug_assert(!bad_target, "picture must fail when drive tap target is not found")

  let bad_press_path = "/tmp/invar_film_bad_press_\{process_id()}.png"
  let bad_press = picture(
    fn(_r : view::View) -> Unit { () },
    path=bad_press_path,
    w=100.0,
    h=60.0,
    scale=1.0,
    script="press Nonexistent Button",
  )
  let _ = remove_file(bad_press_path)
  debug_assert(!bad_press, "picture must fail when drive press target is not found")

  // 3. corners_held gate actually runs (catches oversized inner radius > outer radius - padding) and can be opted out.
  let bad_corner_tree = fn(root : view::View) -> Unit {
    let _ = root.box(fn(outer : view::View) -> Unit {
      let _ = outer
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(80.0)))
        .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
        .corners(view::Live::Is(Some((16.0, 16.0, 16.0, 16.0))))
        .ground(view::Live::Is(ui::rgba(200, 200, 200, 255)))
      let _ = outer.box(fn(inner : view::View) -> Unit {
        let _ = inner
          .width(view::Live::Is(Some(96.0)))
          .height(view::Live::Is(Some(56.0)))
          .corners(view::Live::Is(Some((24.0, 24.0, 24.0, 24.0))))
          .ground(view::Live::Is(ui::rgba(60, 120, 240, 255)))
      })
    })
  }
  let gate_path = "/tmp/invar_film_corner_gate_\{process_id()}.png"
  let caught = picture(bad_corner_tree, path=gate_path, w=140.0, h=100.0, scale=1.0, corners_held=true)
  debug_assert(!caught, "picture with corners_held=true must reject concentric corner ladder fault")
  let bypassed = picture(bad_corner_tree, path=gate_path, w=140.0, h=100.0, scale=1.0, corners_held=false)
  debug_assert(bypassed, "picture with corners_held=false must allow opting out of corner gate")
  let _ = remove_file(gate_path)
}

// What encode leaves out of the window (ui's cull, Tree::drawn_held's `cull`) changes no pixel: a column taller than
// the window, a clipped panel whose rows run past its foot, shadows and rings spilling in from rows just outside the
// window and outside the panel, a turned square half out of the window, all drawn the same with the cull and without.
fn cull_scene(root : view::View) -> Unit {
  let _ = root.box(fn(page : view::View) -> Unit {
    let _ = page.width(view::Live::Is(Some(300.0))).gap(view::Live::Is(6.0))
    let mut i = 0
    while i < 60 {
      let idx = i
      let _ = page.box(fn(row : view::View) -> Unit {
        let _ = row
          .width(view::Live::Is(Some(280.0)))
          .height(view::Live::Is(Some(30.0)))
          .ground(view::Live::Is(if idx % 2 == 0 { ui::rgba(240, 244, 250, 255) } else { ui::rgba(255, 255, 255, 255) }))
          .radius(view::Live::Is(8.0))
          .shadow(view::Live::Is((18.0, 8.0, 0x00000066L)))
          .ring(view::Live::Is((3.0, 6.0, 0x3B82F6CCL)))
          .words(view::Live::Is("Row \{idx} 模组"))
      })
      i += 1
    }
  })
  let _ = root.box(fn(panel : view::View) -> Unit {
    let _ = panel
      .over_xy(320.0, 20.0)
      .width(view::Live::Is(Some(150.0)))
      .height(view::Live::Is(Some(120.0)))
      .clips(view::Live::Is(true))
      .ground(view::Live::Is(ui::rgba(250, 250, 250, 255)))
    let mut i = 0
    while i < 30 {
      let idx = i
      let _ = panel.box(fn(r : view::View) -> Unit {
        let _ = r
          .width(view::Live::Is(Some(140.0)))
          .height(view::Live::Is(Some(24.0)))
          .ground(view::Live::Is(ui::rgba(220, 120 + idx * 4, 90, 255)))
          .shadow(view::Live::Is((12.0, 6.0, 0x00000088L)))
      })
      i += 1
    }
  })
  let _ = root.box(fn(sq : view::View) -> Unit {
    let _ = sq
      .over_xy(440.0, 200.0)
      .width(view::Live::Is(Some(80.0)))
      .height(view::Live::Is(Some(80.0)))
      .ground(view::Live::Is(ui::rgba(60, 120, 240, 255)))
      .turn(view::Live::Is(0.6))
  })
}

test "film_cull_changes_no_pixel" {
  ui::set_view_cull_enabled(false)
  let whole = picture_bytes(cull_scene, w=480.0, h=240.0, scale=1.5, dark=false)
  ui::set_view_cull_enabled(true)
  let culled = picture_bytes(cull_scene, w=480.0, h=240.0, scale=1.5, dark=false)
  let a = match whole {
    Some(b) => b
    None => { debug_assert(false, "whole picture"); return }
  }
  let b = match culled {
    Some(b) => b
    None => { debug_assert(false, "culled picture"); return }
  }
  debug_assert(a.length() == b.length(), "same PNG size (\{a.length()} vs \{b.length()})")
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      debug_assert(false, "PNG bytes differ at \{i}")
      return
    }
    i += 1
  }
}

fn turn_anim_scene(root : view::View) -> Unit {
  let _ = root.box(fn(bar : view::View) -> Unit {
    let _ = bar
      .over_xy(20.0, 44.0)
      .width(view::Live::Is(Some(80.0)))
      .height(view::Live::Is(Some(12.0)))
      .ground(view::Live::Is(ui::rgba(230, 50, 40, 255)))
      .turn(view::Live::By(fn() { bar.cycle(800.0) * 6.283185307179586 }))
  })
}

test "film_reactive_view_turn_rotates_offscreen_pixels" {
  let f0 = match picture_bytes(turn_anim_scene, w=120.0, h=100.0, scale=1.0, dark=false) {
    Some(b) => b
    None => { debug_assert(false, "turn t=0 picture"); return }
  }
  let f90 = match picture_bytes(turn_anim_scene, script="wait 200\n", w=120.0, h=100.0, scale=1.0, dark=false) {
    Some(b) => b
    None => { debug_assert(false, "turn t=200ms picture"); return }
  }
  let mut same = f0.length() == f90.length()
  if same {
    let mut i = 0
    while i < f0.length() {
      if f0[i] != f90[i] {
        same = false
        break
      }
      i += 1
    }
  }
  debug_assert(!same, "reactive View::turn must rotate offscreen rendered pixels between 0ms and 200ms")
}

test "film_rotated_child_with_fades_preserves_parent_clip" {
  // Regression for rotated kind-11 paint::Shape with local fade + fades inside a clips(true) parent:
  // A 20x40 clipped parent holds a 40x40 red kind-11 shape rotated by pi (180 deg) with local fade & fades.
  // Parent rect clipping must stay in screen/parent coordinates (slot 35 == 2.0 -> cp = at_p, fp = p):
  //   - (10, 20) inside parent clip [0..20] must be red
  //   - (30, 20) outside parent clip [0..20] must stay white (not leaked by 180-deg flip)
  let path = "/tmp/invar_film_rot_clip_fade_\{process_id()}.png"
  let red_sq : Array[Double] = [0.0, 0.0, 40.0, 0.0, 40.0, 40.0, 0.0, 40.0]
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root
        .width(view::Live::Is(Some(60.0)))
        .height(view::Live::Is(Some(60.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = root.box(fn(parent : view::View) -> Unit {
        let _ = parent
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .width(view::Live::Is(Some(20.0)))
          .height(view::Live::Is(Some(40.0)))
          .clips(view::Live::Is(true))
        let _ = parent.box(fn(child : view::View) -> Unit {
          let _ = child
            .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
            .width(view::Live::Is(Some(40.0)))
            .height(view::Live::Is(Some(40.0)))
            .shapes(view::Live::Is([
              paint::shape_of([(red_sq, true)], fill=ui::rgba(240, 20, 20, 255), fade=(0.0, 4.0, 40.0, 4.0)),
            ]))
            .turn(view::Live::Is(3.141592653589793))
            .fades(view::Live::Is((4.0, 4.0, 4.0, 4.0)))
        })
      })
    },
    path=path,
    w=60.0,
    h=60.0,
    scale=1.0,
    dark=false,
  )
  debug_assert(ok, "rotated shape clip+fade snapshot must succeed")
  let px = decode_png_rgba(path, 60, 60)
  let _ = remove_file(path)
  let in_i = (20 * 60 + 10) * 4
  let out_i = (20 * 60 + 30) * 4
  let in_r = px[in_i].to_int()
  let in_g = px[in_i + 1].to_int()
  let out_r = px[out_i].to_int()
  let out_g = px[out_i + 1].to_int()
  let out_b = px[out_i + 2].to_int()
  debug_assert(
    in_r > 200 && in_g < 60,
    "pixel inside parent clip (10,20) must be red, got rgb(\{in_r},\{in_g})",
  )
  debug_assert(
    out_r > 240 && out_g > 240 && out_b > 240,
    "pixel outside parent clip (30,20) must stay white, got rgb(\{out_r},\{out_g},\{out_b})",
  )
}

test "film_turn_place_and_local_shape_fade_rotate_on_screen" {
  // Regression for live Place-phase View::turn animation + shape-local 1D linear fade at 0/45/90/180 deg:
  // Draws a 40x40 black disc with local fade (y=0 -> 1.0 opaque black, y=40 -> 0.0 transparent white)
  // rotating via node.cycle(800.0) * 2*pi on a white 40x40 canvas.
  let pi2 = 6.28318530717958647692
  let sq : Array[Double] = [8.0, 8.0, 32.0, 8.0, 32.0, 32.0, 8.0, 32.0]
  let make_scene = fn(root : view::View) -> Unit {
    let _ = root
      .width(view::Live::Is(Some(40.0)))
      .height(view::Live::Is(Some(40.0)))
      .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
    let _ = root.box(fn(rot : view::View) -> Unit {
      let _ = rot
        .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
        .width(view::Live::Is(Some(40.0)))
        .height(view::Live::Is(Some(40.0)))
        .shapes(view::Live::Is([
          paint::shape_of([(sq, true)], fill=ui::rgba(0, 0, 0, 255), fade=(0.0, 0.0, 40.0, 40.0)),
        ]))
        .turn(view::Live::By(fn() -> Double { rot.cycle(800.0) * pi2 }))
    })
  }
  let sample = fn(at_ms : Double, tag : String) -> Array[Byte] {
    let path = "/tmp/invar_film_turn_fade_\{tag}_\{process_id()}.png"
    let ok = picture(make_scene, path=path, w=40.0, h=40.0, scale=1.0, dark=false, at=at_ms)
    debug_assert(ok, "rotated fade snapshot at \{at_ms}ms must succeed")
    let px = decode_png_rgba(path, 40, 40)
    let _ = remove_file(path)
    px
  }
  let luma = fn(px : Array[Byte], x : Int, y : Int) -> Int {
    px[(y * 40 + x) * 4].to_int()
  }
  // 0 deg (t=0ms): local top (20, 12) is dark (~77), bottom (20, 28) is light (~179)
  let px0 = sample(0.0, "0")
  debug_assert(luma(px0, 20, 12) < 95 && luma(px0, 20, 28) > 160, "0 deg: top dark, bottom light, got top=\{luma(px0, 20, 12)} bot=\{luma(px0, 20, 28)}")

  // 45 deg (t=100ms): clockwise rotation moves local top (0, -8) to (+5.66, -5.66) => (26, 14) dark, (14, 26) light,
  // and exact 1D gradient center (20, 20) stays at ~128 (50% alpha; bilinear corner fade would distort it!).
  let px45 = sample(100.0, "45")
  let c45 = luma(px45, 20, 20)
  debug_assert(luma(px45, 26, 14) < 95 && luma(px45, 14, 26) > 160, "45 deg: top-right dark, bottom-left light, got tr=\{luma(px45, 26, 14)} bl=\{luma(px45, 14, 26)}")
  debug_assert(c45 >= 122 && c45 <= 134, "45 deg: 1D gradient center (20,20) must be ~128, got \{c45}")

  // 90 deg (t=200ms): clockwise rotation moves local top to right (28, 20) dark, left (12, 20) light
  let px90 = sample(200.0, "90")
  debug_assert(luma(px90, 28, 20) < 95 && luma(px90, 12, 20) > 160, "90 deg: right dark, left light, got right=\{luma(px90, 28, 20)} left=\{luma(px90, 12, 20)}")

  // 180 deg (t=400ms): local top is now bottom (20, 28) dark, top (20, 12) light
  let px180 = sample(400.0, "180")
  debug_assert(luma(px180, 20, 28) < 95 && luma(px180, 20, 12) > 160, "180 deg: bottom dark, top light, got bot=\{luma(px180, 20, 28)} top=\{luma(px180, 20, 12)}")
}

test "film_legacy_five_field_shape_literal_renders_solid" {
  // Regression for downstream callers using the original 5-field paint::Shape struct literal
  // (omitting the scalar fade_* fields): must compile, never segfault, and draw solid red.
  let path = "/tmp/invar_film_legacy_shape5_\{process_id()}.png"
  let sq : Array[Double] = [4.0, 4.0, 36.0, 4.0, 36.0, 36.0, 4.0, 36.0]
  let legacy_shape = paint::Shape::{
    outlines: [(sq, true)],
    fill: ui::rgba(240, 20, 20, 255),
    stroke: 0L,
    width: 0.0,
    even_odd: false,
  }
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root
        .width(view::Live::Is(Some(40.0)))
        .height(view::Live::Is(Some(40.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = root.box(fn(box : view::View) -> Unit {
        let _ = box
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .shapes(view::Live::Is([legacy_shape]))
      })
    },
    path=path,
    w=40.0,
    h=40.0,
    scale=1.0,
    dark=false,
  )
  debug_assert(ok, "legacy 5-field paint::Shape snapshot must succeed")
  let px = decode_png_rgba(path, 40, 40)
  let _ = remove_file(path)
  let ci = (20 * 40 + 20) * 4
  let r = px[ci].to_int()
  let g = px[ci + 1].to_int()
  let b = px[ci + 2].to_int()
  debug_assert(r > 230 && g < 30 && b < 30, "legacy 5-field shape center must be solid red, got rgb(\{r},\{g},\{b})")
}

test "film_parent_fades_multiplies_with_child_shape_local_fade" {
  // Regression for ScrollShadow (parent View::fades) over a child kind-11 shape carrying its own local fade:
  // Parent applies 40pt top fade over two identical 40x60 red shapes side by side; right shape adds a 4pt
  // bottom local fade. At 2x y=8 and y=39 (inside parent top fade, outside bottom local fade), left and right
  // must match identically (parent fade is NOT suppressed!), while at y=118 right is additionally faded.
  let path = "/tmp/invar_film_parent_x_local_fade_\{process_id()}.png"
  let rect_pts : Array[Double] = [0.0, 0.0, 40.0, 0.0, 40.0, 60.0, 0.0, 60.0]
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root
        .width(view::Live::Is(Some(80.0)))
        .height(view::Live::Is(Some(60.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = root.box(fn(parent : view::View) -> Unit {
        let _ = parent
          .row(view::Live::Is(true))
          .width(view::Live::Is(Some(80.0)))
          .height(view::Live::Is(Some(60.0)))
          .fades(view::Live::Is((0.0, 40.0, 0.0, 0.0)))
        let _ = parent.box(fn(left : view::View) -> Unit {
          let _ = left
            .width(view::Live::Is(Some(40.0)))
            .height(view::Live::Is(Some(60.0)))
            .shapes(view::Live::Is([
              paint::shape_of([(rect_pts, true)], fill=ui::rgba(255, 0, 0, 255)),
            ]))
        })
        let _ = parent.box(fn(right : view::View) -> Unit {
          let _ = right
            .width(view::Live::Is(Some(40.0)))
            .height(view::Live::Is(Some(60.0)))
            .shapes(view::Live::Is([
              paint::shape_of([(rect_pts, true)], fill=ui::rgba(255, 0, 0, 255), fade=(0.0, 0.0, 60.0, 4.0)),
            ]))
        })
      })
    },
    path=path,
    w=80.0,
    h=60.0,
    scale=2.0,
    dark=false,
  )
  debug_assert(ok, "parent View::fades x child local shape fade snapshot must succeed")
  let px = decode_png_rgba(path, 160, 120)
  let _ = remove_file(path)
  let green_at = fn(x : Int, y : Int) -> Int { px[(y * 160 + x) * 4 + 1].to_int() }
  let l8 = green_at(40, 8)
  let r8 = green_at(120, 8)
  let l39 = green_at(40, 39)
  let r39 = green_at(120, 39)
  let l118 = green_at(40, 118)
  let r118 = green_at(120, 118)
  let diff8 = if l8 >= r8 { l8 - r8 } else { r8 - l8 }
  let diff39 = if l39 >= r39 { l39 - r39 } else { r39 - l39 }
  debug_assert(l8 > 210 && diff8 <= 2, "y=8 inside parent top fade must match control: left_g=\{l8} right_g=\{r8}")
  debug_assert(l39 > 110 && diff39 <= 2, "y=39 inside parent top fade must match control: left_g=\{l39} right_g=\{r39}")
  debug_assert(l118 < 10 && r118 > 140, "y=118 inside child bottom 4pt local fade must fade right only: left_g=\{l118} right_g=\{r118}")
}

fn decode_png_bytes_rgba(data : Bytes, w : Int, h : Int) -> Array[Byte] {
  let prev = hostapi::host()
  host::install()
  let img_id = hostapi::image_load_bytes(data, 4096)
  debug_assert(img_id > 0, "image_load_bytes must succeed")
  let info = Array::make(4, 0.0)
  let mut st = hostapi::image_info(img_id, info)
  let mut tries = 0
  while st == 0 && tries < 200 {
    host::pump_main_loop(10.0)
    st = hostapi::image_info(img_id, info)
    tries += 1
  }
  debug_assert(st == 1, "decoded PNG bytes must reach ready state")
  debug_assert(info[0].to_int() == w && info[1].to_int() == h, "decoded PNG dims must match \{w}x\{h}, got \{info[0].to_int()}x\{info[1].to_int()}")
  let px = Array::make(w * h * 4, 0 as Byte)
  debug_assert(hostapi::image_pixels(img_id, px), "image_pixels must succeed")
  hostapi::image_free(img_id)
  hostapi::set_host(prev)
  px
}

test "film_stroked_shape_without_fade_renders_opaque" {
  // Regression for R7 P0: kind-11 stroked shapes without local fade (used by kit::icon and lg icons)
  // must clear rr slots 36..39 to 0 so stroke half-width `hw` is NOT interpreted as a vertical fade.
  let path = "/tmp/invar_film_stroked_icon_\{process_id()}.png"
  let diag1 : Array[Double] = [6.0, 6.0, 34.0, 34.0]
  let diag2 : Array[Double] = [34.0, 6.0, 6.0, 34.0]
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root
        .width(view::Live::Is(Some(40.0)))
        .height(view::Live::Is(Some(40.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = root.box(fn(ic : view::View) -> Unit {
        let _ = ic
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .shapes(view::Live::Is([
            paint::shape_of([(diag1, false), (diag2, false)], stroke=ui::rgba(0, 0, 0, 255), width=3.0),
          ]))
      })
    },
    path=path,
    w=40.0,
    h=40.0,
    scale=2.0,
    dark=false,
  )
  debug_assert(ok, "stroked shape snapshot must succeed")
  let px = decode_png_rgba(path, 80, 80)
  let _ = remove_file(path)
  let mut dark_px = 0
  let mut i = 0
  while i < 80 * 80 * 4 {
    if px[i].to_int() < 245 {
      dark_px += 1
    }
    i += 4
  }
  debug_assert(dark_px > 400, "stroked X icon must render opaque pixels (not wiped by rr=hw fade), got dark_px=\{dark_px}")
}

test "film_tiled_take_picture_preserves_shape_local_fade" {
  // Regression for R7 P1a: ui::take_picture tiles tall captures in 2048px vertical bands.
  // Two identical 40x40 red shapes with local top fade at y=4 (band 1) and y=2052 (band 2)
  // must produce identical ~50% faded centers at y=24 and y=2072.
  let sq : Array[Double] = [0.0, 0.0, 40.0, 0.0, 40.0, 40.0, 0.0, 40.0]
  let prev = hostapi::host()
  debug_assert(init_offscreen(40.0, 40.0, 1.0), "init_offscreen for tiled take_picture")
  let native = host::native_host()
  let t = ui::Tester::tree(fn(root : view::View) {
    let _ = root.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
  })
  let h = hostapi::host()
  h.drawn_pixels_of = native.drawn_pixels_of
  let got_png : signals::Ref[Option[Bytes]] = ui::ref_new(None)
  ui::take_picture(
    "r8_tiled_fade",
    40.0,
    fn(b : view::View) {
      let _ = b
        .height(view::Live::Is(Some(2100.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = b.box(fn(top : view::View) {
        let _ = top
          .over(view::Live::Is(true), edges=(Some(0.0), Some(4.0), None, None))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .shapes(view::Live::Is([
            paint::shape_of([(sq, true)], fill=ui::rgba(255, 0, 0, 255), fade=(0.0, 40.0, 0.0, 0.0)),
          ]))
      })
      let _ = b.box(fn(bot : view::View) {
        let _ = bot
          .over(view::Live::Is(true), edges=(Some(0.0), Some(2052.0), None, None))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .shapes(view::Live::Is([
            paint::shape_of([(sq, true)], fill=ui::rgba(255, 0, 0, 255), fade=(0.0, 40.0, 0.0, 0.0)),
          ]))
      })
    },
    fn(png : Option[Bytes]) { got_png.v = png },
    scale=1.0,
  )
  t.frame(ms=16.0)
  t.dispose()
  hostapi::set_host(prev)
  let png = match got_png.v {
    Some(p) => p
    None => { debug_assert(false, "tiled take_picture must deliver Some(png)"); return }
  }
  let px = decode_png_bytes_rgba(png, 40, 2100)
  let g1 = px[(24 * 40 + 20) * 4 + 1].to_int()
  let r1 = px[(24 * 40 + 20) * 4].to_int()
  let g2 = px[(2072 * 40 + 20) * 4 + 1].to_int()
  let r2 = px[(2072 * 40 + 20) * 4].to_int()
  let dg = if g1 >= g2 { g1 - g2 } else { g2 - g1 }
  debug_assert(r1 > 250 && r2 > 250, "both tiled centers must keep red=255, got r1=\{r1} r2=\{r2}")
  debug_assert(g1 >= 115 && g1 <= 145 && g2 >= 115 && g2 <= 145 && dg <= 2, "band 1 y=24 (g=\{g1}) and band 2 y=2072 (g=\{g2}) must match ~50% faded red")
}

test "film_magnifier_preserves_shape_local_fade" {
  // Regression for R7 P1b: View::magnifies translates and zooms kind-11 instances.
  // Source 40x40 red local-fade shape at (0,0), 1x translated loupe at (40,0), and 2x zoomed loupe at (80,0)
  // must all render matching ~50% faded red at their centers (20,20), (60,20), and (100,20).
  let path = "/tmp/invar_film_magnifier_fade_\{process_id()}.png"
  let sq : Array[Double] = [0.0, 0.0, 40.0, 0.0, 40.0, 40.0, 0.0, 40.0]
  let ok = picture(
    fn(root : view::View) -> Unit {
      let _ = root
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(40.0)))
        .ground(view::Live::Is(ui::rgba(255, 255, 255, 255)))
      let _ = root.box(fn(src : view::View) -> Unit {
        let _ = src
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .shapes(view::Live::Is([
            paint::shape_of([(sq, true)], fill=ui::rgba(255, 0, 0, 255), fade=(0.0, 40.0, 0.0, 0.0)),
          ]))
      })
      let _ = root.box(fn(l1 : view::View) -> Unit {
        let _ = l1
          .over(view::Live::Is(true), edges=(Some(40.0), Some(0.0), None, None))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .magnifies(view::Live::Is(Some((20.0, 20.0, 1.0))))
      })
      let _ = root.box(fn(l2 : view::View) -> Unit {
        let _ = l2
          .over(view::Live::Is(true), edges=(Some(80.0), Some(0.0), None, None))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .magnifies(view::Live::Is(Some((20.0, 20.0, 2.0))))
      })
    },
    path=path,
    w=120.0,
    h=40.0,
    scale=1.0,
    dark=false,
  )
  debug_assert(ok, "magnifier local-fade snapshot must succeed")
  let px = decode_png_rgba(path, 120, 40)
  let _ = remove_file(path)
  let g_src = px[(20 * 120 + 20) * 4 + 1].to_int()
  let g_1x = px[(20 * 120 + 60) * 4 + 1].to_int()
  let g_2x = px[(20 * 120 + 100) * 4 + 1].to_int()
  let d1 = if g_src >= g_1x { g_src - g_1x } else { g_1x - g_src }
  let d2 = if g_src >= g_2x { g_src - g_2x } else { g_2x - g_src }
  debug_assert(g_src >= 115 && g_src <= 145, "source center must be ~50% faded red, got g=\{g_src}")
  debug_assert(d1 <= 3 && d2 <= 3, "1x (g=\{g_1x}) and 2x (g=\{g_2x}) magnifier centers must match source (g=\{g_src})")
}
