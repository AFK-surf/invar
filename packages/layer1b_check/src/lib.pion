// Aggregate check package for Layer 1B (font, shape, skia, svg + PNG encoding via pixels).

import "font"
import "shape"
import "skia"
import "svg"
import "pixels"

pub fn layer1b_smoke() -> Bool {
  // 1. font: instantiate FontDb and configure families
  let db = font::FontDb::new()
  db.set_sans_serif_family("Inter")
  let font_ok = db.faces().length() == 0

  // 2. shape: instantiate Buffer, push codepoints, verify direction/cluster setup
  let buf = shape::Buffer::new()
  buf.push(72, 0) // 'H'
  buf.push(105, 1) // 'i'
  buf.set_direction(shape::Direction::LeftToRight)
  let shape_ok = buf.glyph_infos().length() == 2 && shape::dir_to_string(shape::Direction::LeftToRight) == "LeftToRight"

  // 3. svg + skia: render a multi-element vector icon (gradient + circle + path) into skia::Pixmap
  let icon_svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='64' height='64'>" +
    "<defs>" +
    "<linearGradient id='bg' x1='0%' y1='0%' x2='100%' y2='100%'>" +
    "<stop offset='0%' stop-color='#2563eb'/>" +
    "<stop offset='100%' stop-color='#7c3aed'/>" +
    "</linearGradient>" +
    "</defs>" +
    "<rect x='4' y='4' width='56' height='56' rx='12' fill='url(#bg)'/>" +
    "<circle cx='32' cy='32' r='16' fill='#ffffff'/>" +
    "<path d='M 24 32 L 30 38 L 42 26' fill='none' stroke='#2563eb' stroke-width='4' stroke-linecap='round' stroke-linejoin='round'/>" +
    "</svg>"
  let opt = svg::Options::default()
  let size_ok = match svg::svg_size(icon_svg, opt) {
    Some((sw, sh)) => (sw - 64.0f).abs() < 0.01f && (sh - 64.0f).abs() < 0.01f
    None => false
  }
  let pm = match svg::render_svg_to_width(icon_svg, 64, opt) {
    Some(p) => p
    None => return false
  }
  let dim_ok = pm.width == 64 && pm.height == 64

  // Verify non-zero rendered pixels and demultiply into straight RGBA Bytes
  let straight = pm.demultiplied()
  let mut non_zero = 0
  let sb = StringBuilder::new()
  for i in 0..<straight.length() {
    let b = straight[i]
    if b.to_int() != 0 {
      non_zero = non_zero + 1
    }
    sb.write_byte(b)
  }
  let rgba_bytes = sb.to_string().to_bytes()

  // 4. pixels: encode rendered SVG Pixmap as PNG and verify valid PNG signature & decode round-trip
  let png_bytes = pixels::png(pm.width, pm.height, rgba_bytes)
  let png_sig_ok = png_bytes.length() > 32 &&
    png_bytes[0].to_int() == 0x89 &&
    png_bytes[1].to_int() == 0x50 &&
    png_bytes[2].to_int() == 0x4E &&
    png_bytes[3].to_int() == 0x47 &&
    png_bytes[4].to_int() == 0x0D &&
    png_bytes[5].to_int() == 0x0A &&
    png_bytes[6].to_int() == 0x1A &&
    png_bytes[7].to_int() == 0x0A
  let png_roundtrip_ok = pixels::is_png(png_bytes) && match pixels::decode_png(png_bytes) {
    Some((dw, dh, dec)) => dw == 64 && dh == 64 && dec.length() == 64 * 64 * 4
    None => false
  }

  debug_assert(font_ok, "font_ok failed")
  debug_assert(shape_ok, "shape_ok failed")
  debug_assert(size_ok, "size_ok failed")
  debug_assert(dim_ok, "dim_ok failed")
  debug_assert(non_zero > 2000, "non_zero failed: " + non_zero.to_string())
  debug_assert(png_sig_ok, "png_sig_ok failed, len=" + png_bytes.length().to_string())
  debug_assert(png_roundtrip_ok, "png_roundtrip_ok failed, is_png=" + pixels::is_png(png_bytes).to_string())
  font_ok && shape_ok && size_ok && dim_ok && non_zero > 2000 && png_sig_ok && png_roundtrip_ok
}
