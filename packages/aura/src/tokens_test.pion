test "aura_ui_theme_disables_tabular_numerals_and_maps_palette" {
  let light_cfg = AuraConfig::light()
  let light_th = aura_ui_theme(light_cfg)
  let light_pal = aura_palette(light_cfg)
  debug_assert(!light_th.dark, "light ui::Theme dark must be false")
  debug_assert(!light_th.tabular, "HeroUI v3 / CSS default font-variant-numeric is proportional (tabular=false)")
  debug_assert(!light_th.font_alternates, "HeroUI v3 uses default Inter glyph forms (font_alternates=false)")
  debug_assert(light_th.bg == light_pal.background, "light bg matches --background")
  debug_assert(light_th.surface == light_pal.surface, "light surface matches --surface")
  debug_assert(light_th.fg == light_pal.foreground, "light fg matches --foreground")
  debug_assert(light_th.accent == light_pal.accent, "light accent matches --accent")
  debug_assert(light_th.font == 14.0, "Aura default font size is 14pt")

  let dark_cfg = AuraConfig::dark()
  let dark_th = aura_ui_theme(dark_cfg)
  let dark_pal = aura_palette(dark_cfg)
  debug_assert(dark_th.dark, "dark ui::Theme dark must be true")
  debug_assert(!dark_th.tabular, "dark Aura ui::Theme tabular must be false")
  debug_assert(!dark_th.font_alternates, "dark Aura ui::Theme font_alternates must be false")
  debug_assert(dark_th.bg == dark_pal.background, "dark bg matches --background")
  debug_assert(dark_th.fg == dark_pal.foreground, "dark fg matches --foreground")
}
