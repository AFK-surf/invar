// Exhaustive 4-mode token parity tests against HeroUI v3.2.8 Chromium computed values (<= 1/255 per channel).

import "halt"

fn w0_assert_rgba_near(mode : String, name : String, actual : Int64, er : Int, eg : Int, eb : Int, ea : Int) -> Unit {
  let ar = ((actual >> 24) & 0xFFL).to_int()
  let ag = ((actual >> 16) & 0xFFL).to_int()
  let ab = ((actual >> 8) & 0xFFL).to_int()
  let aa = (actual & 0xFFL).to_int()
  let dr = if ar > er { ar - er } else { er - ar }
  let dg = if ag > eg { ag - eg } else { eg - ag }
  let db = if ab > eb { ab - eb } else { eb - ab }
  let da = if aa > ea { aa - ea } else { ea - aa }
  if ea == 0 && aa == 0 { return }
  // For low-alpha tokens (< 64/255), Chromium's CSS serialization quantizes alpha before premultiplying
  // back to straight RGB (up to +-3 on straight RGB while composited on white/black is <= 1/255).
  let rgb_tol = if ea < 64 { 4 } else { 1 }
  if dr > rgb_tol || dg > rgb_tol || db > rgb_tol || da > 1 {
    halt::saying("aura token mismatch", "\{mode} \{name}: got (\{ar},\{ag},\{ab},\{aa}) want (\{er},\{eg},\{eb},\{ea})")
  }
}

test "aura_tokens_light_all_71_match_chromium" {
  let p = aura_palette(AuraConfig::light(vibrant=false))
  w0_assert_rgba_near("light", "--white", p.white, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--black", p.black, 0, 0, 0, 255)
  w0_assert_rgba_near("light", "--snow", p.snow, 252, 252, 252, 255)
  w0_assert_rgba_near("light", "--eclipse", p.eclipse, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--background", p.background, 245, 245, 245, 255)
  w0_assert_rgba_near("light", "--background-secondary", p.background_secondary, 235, 235, 235, 255)
  w0_assert_rgba_near("light", "--background-tertiary", p.background_tertiary, 225, 225, 225, 255)
  w0_assert_rgba_near("light", "--background-inverse", p.background_inverse, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--foreground", p.foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--muted", p.muted, 113, 113, 122, 255)
  w0_assert_rgba_near("light", "--link", p.link, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--surface", p.surface, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--surface-foreground", p.surface_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--surface-hover", p.surface_hover, 234, 234, 234, 255)
  w0_assert_rgba_near("light", "--surface-secondary", p.surface_secondary, 239, 239, 240, 255)
  w0_assert_rgba_near("light", "--surface-secondary-foreground", p.surface_secondary_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--surface-tertiary", p.surface_tertiary, 234, 234, 235, 255)
  w0_assert_rgba_near("light", "--surface-tertiary-foreground", p.surface_tertiary_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--overlay", p.overlay, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--overlay-foreground", p.overlay_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--backdrop", p.backdrop, 0, 0, 0, 128)
  w0_assert_rgba_near("light", "--default", p.default_bg, 235, 235, 236, 255)
  w0_assert_rgba_near("light", "--default-foreground", p.default_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--default-hover", p.default_hover, 225, 225, 226, 255)
  w0_assert_rgba_near("light", "--default-soft", p.default_soft, 235, 235, 235, 128)
  w0_assert_rgba_near("light", "--default-soft-foreground", p.default_soft_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--default-soft-hover", p.default_soft_hover, 235, 235, 237, 153)
  w0_assert_rgba_near("light", "--accent", p.accent, 4, 133, 247, 255)
  w0_assert_rgba_near("light", "--accent-foreground", p.accent_foreground, 252, 252, 252, 255)
  w0_assert_rgba_near("light", "--accent-hover", p.accent_hover, 53, 146, 249, 255)
  w0_assert_rgba_near("light", "--accent-soft", p.accent_soft, 7, 134, 248, 38)
  w0_assert_rgba_near("light", "--accent-soft-foreground", p.accent_soft_foreground, 30, 99, 174, 255)
  w0_assert_rgba_near("light", "--accent-soft-hover", p.accent_soft_hover, 5, 135, 245, 51)
  w0_assert_rgba_near("light", "--focus", p.focus, 4, 133, 247, 255)
  w0_assert_rgba_near("light", "--success", p.success, 23, 201, 100, 255)
  w0_assert_rgba_near("light", "--success-foreground", p.success_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--success-hover", p.success_hover, 33, 181, 93, 255)
  w0_assert_rgba_near("light", "--success-soft", p.success_soft, 20, 201, 101, 38)
  w0_assert_rgba_near("light", "--success-soft-foreground", p.success_soft_foreground, 43, 119, 69, 255)
  w0_assert_rgba_near("light", "--success-soft-hover", p.success_soft_hover, 25, 200, 100, 51)
  w0_assert_rgba_near("light", "--warning", p.warning, 245, 165, 36, 255)
  w0_assert_rgba_near("light", "--warning-foreground", p.warning_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--warning-hover", p.warning_hover, 220, 150, 42, 255)
  w0_assert_rgba_near("light", "--warning-soft", p.warning_soft, 248, 168, 34, 38)
  w0_assert_rgba_near("light", "--warning-soft-foreground", p.warning_soft_foreground, 133, 95, 46, 255)
  w0_assert_rgba_near("light", "--warning-soft-hover", p.warning_soft_hover, 245, 165, 35, 51)
  w0_assert_rgba_near("light", "--danger", p.danger, 255, 56, 60, 255)
  w0_assert_rgba_near("light", "--danger-foreground", p.danger_foreground, 252, 252, 252, 255)
  w0_assert_rgba_near("light", "--danger-hover", p.danger_hover, 255, 85, 81, 255)
  w0_assert_rgba_near("light", "--danger-soft", p.danger_soft, 255, 54, 60, 38)
  w0_assert_rgba_near("light", "--danger-soft-foreground", p.danger_soft_foreground, 164, 52, 51, 255)
  w0_assert_rgba_near("light", "--danger-soft-hover", p.danger_soft_hover, 255, 55, 60, 51)
  w0_assert_rgba_near("light", "--field-background", p.field_background, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--field-foreground", p.field_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light", "--field-placeholder", p.field_placeholder, 113, 113, 122, 255)
  w0_assert_rgba_near("light", "--field-hover", p.field_hover, 248, 248, 248, 235)
  w0_assert_rgba_near("light", "--field-focus", p.field_focus, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--field-border", p.field_border, 0, 0, 0, 0)
  w0_assert_rgba_near("light", "--field-border-hover", p.field_border_hover, 20, 20, 29, 26)
  w0_assert_rgba_near("light", "--field-border-focus", p.field_border_focus, 23, 23, 27, 56)
  w0_assert_rgba_near("light", "--border", p.border, 221, 222, 225, 255)
  w0_assert_rgba_near("light", "--border-secondary", p.border_secondary, 198, 198, 199, 255)
  w0_assert_rgba_near("light", "--border-tertiary", p.border_tertiary, 168, 168, 169, 255)
  w0_assert_rgba_near("light", "--separator", p.separator, 228, 228, 231, 255)
  w0_assert_rgba_near("light", "--separator-secondary", p.separator_secondary, 216, 216, 216, 255)
  w0_assert_rgba_near("light", "--separator-tertiary", p.separator_tertiary, 205, 205, 206, 255)
  w0_assert_rgba_near("light", "--segment", p.segment, 255, 255, 255, 255)
  w0_assert_rgba_near("light", "--segment-foreground", p.segment_foreground, 24, 24, 27, 255)
