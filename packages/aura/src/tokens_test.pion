  w0_assert_rgba_near("light", "--scrollbar-thumb", p.scrollbar_thumb, 27, 27, 27, 38)
  w0_assert_rgba_near("light", "--scrollbar-track", p.scrollbar_track, 0, 0, 0, 0)
}

