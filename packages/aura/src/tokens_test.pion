  w0_assert_rgba_near("light_vibrant", "--segment-foreground", p.segment_foreground, 24, 24, 27, 255)
  w0_assert_rgba_near("light_vibrant", "--scrollbar", p.scrollbar, 27, 27, 27, 38)
  w0_assert_rgba_near("light_vibrant", "--scrollbar-thumb", p.scrollbar_thumb, 27, 27, 27, 38)
  w0_assert_rgba_near("light_vibrant", "--scrollbar-track", p.scrollbar_track, 0, 0, 0, 0)
}

