// Public Aura UI craft audit gate (`aura::assert_aura_ui`).
// Enforces: `t.ui_craft_audit()` excluding `corner:` entries + `t.unasked_faults()` + zero liquid glass (kind 6).
// Does NOT enforce WCAG 4.5:1 contrast (HeroUI light `--muted` is 4.02–4.43 and disabled is 3.36).

import "halt"
import "ui"

/// Count how many liquid glass (`kind == 6`) rectangles were drawn in the latest frame.
pub fn count_liquid_glass(t : ui::Tester) -> Int {
  let gs = t.drawn_glass()
  let mut n = 0
  for g in gs {
    if g.4 == 6 {
      n += 1
    }
  }
  n
}

fn w0_starts_with(s : String, prefix : String) -> Bool {
  if s.length() < prefix.length() {
    return false
  }
  let mut i = 0
  while i < prefix.length() {
    if s.code_unit_at(i) != prefix.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

/// Audit an Aura UI frame and return all faults (empty when clean).
pub fn audit_aura_ui(t : ui::Tester, label~ : String = "scene") -> Array[String] {
  let faults : Array[String] = []
  let craft = t.ui_craft_audit()
  for f in craft {
    if !w0_starts_with(f, "corner:") {
      faults.push("[\{label}] ui_craft: \{f}")
    }
  }
  let unasked = t.unasked_faults()
  for f in unasked {
    faults.push("[\{label}] unasked_fault: \{f}")
  }
  let lg_count = count_liquid_glass(t)
  if lg_count > 0 {
    faults.push("[\{label}] aura must use zero liquid glass kind 6 (found \{lg_count})")
  }
  faults
}

/// Assert that `audit_aura_ui(t, label=label)` reports zero faults.
pub fn assert_aura_ui(t : ui::Tester, label~ : String = "scene") -> Unit {
  let faults = audit_aura_ui(t, label=label)
  if faults.length() > 0 {
    let mut msg = "aura UI audit failed in \{label} (\{faults.length()} fault(s)):"
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    halt::saying("aura::assert_aura_ui", msg)
  }
}
