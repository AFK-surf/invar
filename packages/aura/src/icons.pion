// Ported from @gravity-ui/icons (v2.23.1, MIT, Copyright (c) 2022 YANDEX LLC) as used by HeroUI v3.2.8.
// 15 built-in monochrome currentColor UI icons on a 16x16 logical viewBox, rendered from the exact locked
// SVG `<path fill-rule="evenodd" d="...">` curves via `paint::Shape`.

import "dmath"
import "paint"
import "view"

/// The 15 built-in HeroUI v3.2.8 / `@gravity-ui/icons` glyphs.
#derive(Eq)
pub enum AuraIconKind {
  Check
  ChevronDown
  ChevronLeft
  ChevronRight
  ChevronUp
  Xmark
  Magnifier
  CircleInfo
  CircleCheck
  TriangleExclamation
  CircleExclamation
  Eye
  EyeSlash
  Calendar
  Plus
}

// ---------------------------------------------------------------------------
// Exact SVG path data parser & smooth curve/arc flattener (M L H V C S Q T A Z)
// ---------------------------------------------------------------------------

struct AuraSvgReader {
  bytes : Bytes
  mut i : Int
}

fn aura_svg_byte(b : Bytes, i : Int) -> Int {
  b[i].to_int()
}

fn aura_svg_sep(c : Int) -> Bool {
  c == 32 || c == 44 || c == 10 || c == 9 || c == 13
}

fn aura_svg_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn aura_svg_cmd(c : Int) -> Bool {
  ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) && c != 69 && c != 101
}

fn AuraSvgReader::skip(self : AuraSvgReader) -> Unit {
  while self.i < self.bytes.length() && aura_svg_sep(aura_svg_byte(self.bytes, self.i)) {
    self.i += 1
  }
}

fn AuraSvgReader::has_number(self : AuraSvgReader) -> Bool {
  self.skip()
  if self.i >= self.bytes.length() {
    return false
  }
  let c = aura_svg_byte(self.bytes, self.i)
  c == 45 || c == 43 || c == 46 || aura_svg_digit(c)
}

fn AuraSvgReader::number(self : AuraSvgReader) -> Double {
  self.skip()
  let s = self.bytes
  let n = s.length()
  let mut neg = false
  if self.i < n {
    let c = aura_svg_byte(s, self.i)
    if c == 45 || c == 43 {
      neg = c == 45
      self.i += 1
    }
  }
  let mut v = 0.0
  while self.i < n && aura_svg_digit(aura_svg_byte(s, self.i)) {
    v = v * 10.0 + (aura_svg_byte(s, self.i) - 48).to_double()
    self.i += 1
  }
  if self.i < n && aura_svg_byte(s, self.i) == 46 {
    self.i += 1
    let mut f = 0.1
    while self.i < n && aura_svg_digit(aura_svg_byte(s, self.i)) {
      v = v + (aura_svg_byte(s, self.i) - 48).to_double() * f
      f = f / 10.0
      self.i += 1
    }
  }
  if self.i < n && (aura_svg_byte(s, self.i) == 101 || aura_svg_byte(s, self.i) == 69) {
    self.i += 1
    let mut eneg = false
    if self.i < n && (aura_svg_byte(s, self.i) == 45 || aura_svg_byte(s, self.i) == 43) {
      eneg = aura_svg_byte(s, self.i) == 45
      self.i += 1
    }
    let mut e = 0
    while self.i < n && aura_svg_digit(aura_svg_byte(s, self.i)) {
      e = e * 10 + (aura_svg_byte(s, self.i) - 48)
      self.i += 1
    }
    let mut k = 1.0
    for _ in 0..<e {
      k = k * 10.0
    }
    v = if eneg { v / k } else { v * k }
  }
  if neg { -v } else { v }
}

fn AuraSvgReader::flag(self : AuraSvgReader) -> Bool {
  self.skip()
  if self.i < self.bytes.length() {
    let c = aura_svg_byte(self.bytes, self.i)
    self.i += 1
    return c == 49
  }
  false
}

fn aura_svg_dist(x0 : Double, y0 : Double, x1 : Double, y1 : Double) -> Double {
  let dx = x1 - x0
  let dy = y1 - y0
  (dx * dx + dy * dy).sqrt()
}

fn aura_svg_pieces(len : Double, tess : Double) -> Int {
  let n = (len * tess).ceil().to_int()
  if n < 6 { 6 } else if n > 64 { 64 } else { n }
}

fn aura_svg_cubic(
  out : Array[Double],
  x : Double,
  y : Double,
  c1x : Double,
  c1y : Double,
  c2x : Double,
  c2y : Double,
  ex : Double,
  ey : Double,
  s : Double,
  tess : Double,
) -> Unit {
  let len = aura_svg_dist(x, y, c1x, c1y) + aura_svg_dist(c1x, c1y, c2x, c2y) + aura_svg_dist(c2x, c2y, ex, ey)
  let n = aura_svg_pieces(len, tess)
  for k in 1..=n {
    let t = k.to_double() / n.to_double()
    let mt = 1.0 - t
    let px = mt * mt * mt * x + 3.0 * mt * mt * t * c1x + 3.0 * mt * t * t * c2x + t * t * t * ex
    let py = mt * mt * mt * y + 3.0 * mt * mt * t * c1y + 3.0 * mt * t * t * c2y + t * t * t * ey
    out.push(px * s)
    out.push(py * s)
  }
}

fn aura_svg_arc(
  out : Array[Double],
  x1 : Double,
  y1 : Double,
  rx0 : Double,
  ry0 : Double,
  phi : Double,
  large : Bool,
  sweep : Bool,
  x2 : Double,
  y2 : Double,
  s : Double,
  tess : Double,
) -> Unit {
  if rx0 == 0.0 || ry0 == 0.0 || (x1 == x2 && y1 == y2) {
    out.push(x2 * s)
    out.push(y2 * s)
    return
  }
  let pi = 3.14159265358979323846
  let cp = dmath::cos(phi * pi / 180.0)
  let sp = dmath::sin(phi * pi / 180.0)
  let dx = (x1 - x2) * 0.5
  let dy = (y1 - y2) * 0.5
  let x1p = cp * dx + sp * dy
  let y1p = -sp * dx + cp * dy
  let mut rx = rx0.abs()
  let mut ry = ry0.abs()
  let lam = x1p * x1p / (rx * rx) + y1p * y1p / (ry * ry)
  if lam > 1.0 {
    let sl = lam.sqrt()
    rx = rx * sl
    ry = ry * sl
  }
  let num = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p
  let den = rx * rx * y1p * y1p + ry * ry * x1p * x1p
  let mut co = if den != 0.0 {
    let q = num / den
    if q > 0.0 { q.sqrt() } else { 0.0 }
  } else {
    0.0
  }
  if large == sweep {
    co = -co
  }
  let cxp = co * rx * y1p / ry
  let cyp = -co * ry * x1p / rx
  let cx = cp * cxp - sp * cyp + (x1 + x2) * 0.5
  let cy = sp * cxp + cp * cyp + (y1 + y2) * 0.5
  let ang = fn(ux : Double, uy : Double, vx : Double, vy : Double) -> Double {
    dmath::atan2(ux * vy - uy * vx, ux * vx + uy * vy)
  }
  let t1 = ang(1.0, 0.0, (x1p - cxp) / rx, (y1p - cyp) / ry)
  let mut dt = ang(
    (x1p - cxp) / rx,
    (y1p - cyp) / ry,
    (-x1p - cxp) / rx,
    (-y1p - cyp) / ry,
  )
  if !sweep && dt > 0.0 {
    dt = dt - 2.0 * pi
  } else if sweep && dt < 0.0 {
    dt = dt + 2.0 * pi
  }
  let rmax = if rx > ry { rx } else { ry }
  let n = aura_svg_pieces(dt.abs() * rmax, tess)
  for k in 1..=n {
    let t = t1 + dt * k.to_double() / n.to_double()
    let lx = rx * dmath::cos(t)
    let ly = ry * dmath::sin(t)
    out.push((cp * lx - sp * ly + cx) * s)
    out.push((sp * lx + cp * ly + cy) * s)
  }
}

fn aura_svg_path_outlines(d : String, s : Double) -> Array[(Array[Double], Bool)] {
  let bytes = d.to_bytes()
  let r = AuraSvgReader::{ bytes, i: 0 }
  // Sub-pixel curve tessellation density (at least 2.5 samples per 16x16 unit, scaling with icon size).
  let tess = if s * 2.5 < 2.5 { 2.5 } else { s * 2.5 }
  let subs : Array[(Array[Double], Bool)] = []
  let mut cur : Array[Double] = []
  let mut x = 0.0
  let mut y = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let mut lcx = 0.0
  let mut lcy = 0.0
  let mut last = 0
  let mut cmd = 0
  while true {
    r.skip()
    if r.i >= bytes.length() {
      break
    }
    let ch = aura_svg_byte(bytes, r.i)
    if aura_svg_cmd(ch) {
      cmd = ch
      r.i += 1
      if cmd == 90 || cmd == 122 {
        if cur.length() >= 6 {
          subs.push((cur, true))
        }
        cur = []
        x = sx
        y = sy
        last = cmd
        continue
      }
    } else if !r.has_number() {
      r.i += 1
      continue
    }
    let rel = cmd >= 97
    let ox = if rel { x } else { 0.0 }
    let oy = if rel { y } else { 0.0 }
    let up = if rel { cmd - 32 } else { cmd }
    if up == 77 {
      // Filled SVG subpaths are implicitly closed on subsequent M/m commands.
      if cur.length() >= 6 {
        subs.push((cur, true))
      }
      x = r.number() + ox
      y = r.number() + oy
      sx = x
      sy = y
      cur = [x * s, y * s]
      cmd = if rel { 108 } else { 76 }
    } else if up == 76 {
      x = r.number() + ox
      y = r.number() + oy
      cur.push(x * s)
      cur.push(y * s)
    } else if up == 72 {
      x = r.number() + (if rel { x } else { 0.0 })
      cur.push(x * s)
      cur.push(y * s)
    } else if up == 86 {
      y = r.number() + (if rel { y } else { 0.0 })
      cur.push(x * s)
      cur.push(y * s)
    } else if up == 67 || up == 83 {
      let (c1x, c1y) = if up == 67 {
        let a = r.number() + ox
        let b = r.number() + oy
        (a, b)
      } else if last == 67 || last == 99 || last == 83 || last == 115 {
        (2.0 * x - lcx, 2.0 * y - lcy)
      } else {
        (x, y)
      }
      let c2x = r.number() + ox
      let c2y = r.number() + oy
      let ex = r.number() + ox
      let ey = r.number() + oy
      if cur.length() == 0 {
        cur = [x * s, y * s]
      }
      aura_svg_cubic(cur, x, y, c1x, c1y, c2x, c2y, ex, ey, s, tess)
      lcx = c2x
      lcy = c2y
      x = ex
      y = ey
    } else if up == 81 || up == 84 {
      let (qx, qy) = if up == 81 {
        let a = r.number() + ox
        let b = r.number() + oy
        (a, b)
      } else if last == 81 || last == 113 || last == 84 || last == 116 {
        (2.0 * x - lcx, 2.0 * y - lcy)
      } else {
        (x, y)
      }
      let ex = r.number() + ox
      let ey = r.number() + oy
      let n = aura_svg_pieces(aura_svg_dist(x, y, qx, qy) + aura_svg_dist(qx, qy, ex, ey), tess)
      if cur.length() == 0 {
        cur = [x * s, y * s]
      }
      for k in 1..=n {
        let t = k.to_double() / n.to_double()
        let mt = 1.0 - t
        let px = mt * mt * x + 2.0 * mt * t * qx + t * t * ex
        let py = mt * mt * y + 2.0 * mt * t * qy + t * t * ey
        cur.push(px * s)
        cur.push(py * s)
      }
      lcx = qx
      lcy = qy
      x = ex
      y = ey
    } else if up == 65 {
      let rx = r.number()
      let ry = r.number()
      let phi = r.number()
      let large = r.flag()
      let sweep = r.flag()
      let ex = r.number() + ox
      let ey = r.number() + oy
      if cur.length() == 0 {
        cur = [x * s, y * s]
      }
      aura_svg_arc(cur, x, y, rx, ry, phi, large, sweep, ex, ey, s, tess)
      x = ex
      y = ey
    } else {
      let _ = r.number()
    }
    last = cmd
  }
  if cur.length() >= 6 {
    subs.push((cur, true))
  }
  subs
}

/// Exact locked `@gravity-ui/icons@2.23.1` SVG `d` strings (`viewBox="0 0 16 16"`, `fill-rule="evenodd"`).
pub fn aura_icon_svg_path(kind : AuraIconKind) -> String {
  match kind {
    AuraIconKind::Check =>
      "M13.488 3.43a.75.75 0 0 1 .081 1.058l-6 7a.75.75 0 0 1-1.1.042l-3.5-3.5A.75.75 0 0 1 4.03 6.97l2.928 2.927 5.473-6.385a.75.75 0 0 1 1.057-.081"
    AuraIconKind::ChevronDown =>
      "M2.97 5.47a.75.75 0 0 1 1.06 0L8 9.44l3.97-3.97a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 0-1.06"
    AuraIconKind::ChevronUp =>
      "M13.03 10.53a.75.75 0 0 1-1.06 0L8 6.56l-3.97 3.97a.75.75 0 1 1-1.06-1.06l4.5-4.5a.75.75 0 0 1 1.06 0l4.5 4.5a.75.75 0 0 1 0 1.06"
    AuraIconKind::ChevronLeft =>
      "M10.53 2.97a.75.75 0 0 1 0 1.06L6.56 8l3.97 3.97a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 0"
    AuraIconKind::ChevronRight =>
      "M5.47 13.03a.75.75 0 0 1 0-1.06L9.44 8 5.47 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0"
    AuraIconKind::Xmark =>
      "M3.47 3.47a.75.75 0 0 1 1.06 0L8 6.94l3.47-3.47a.75.75 0 1 1 1.06 1.06L9.06 8l3.47 3.47a.75.75 0 1 1-1.06 1.06L8 9.06l-3.47 3.47a.75.75 0 0 1-1.06-1.06L6.94 8 3.47 4.53a.75.75 0 0 1 0-1.06"
    AuraIconKind::Magnifier =>
      "M11.5 7a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0m-.82 4.74a6 6 0 1 1 1.06-1.06l2.79 2.79a.75.75 0 1 1-1.06 1.06z"
    AuraIconKind::CircleInfo =>
      "M8 13.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-9.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0m-.25 3a.75.75 0 0 0-1.5 0V11a.75.75 0 0 0 1.5 0z"
    AuraIconKind::CircleCheck =>
      "M13.5 8a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0m-3.9-1.55a.75.75 0 1 0-1.2-.9L7.419 8.858 6.03 7.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z"
    AuraIconKind::TriangleExclamation =>
      "M7.134 2.994 2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 .866-1.5L8.866 2.993a1 1 0 0 0-1.732 0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 0 1 1 0 0 1 2 0"
    AuraIconKind::CircleExclamation =>
      "M8 13.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m1-4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0M8.75 5a.75.75 0 0 0-1.5 0v2.5a.75.75 0 0 0 1.5 0z"
    AuraIconKind::Eye =>
      "M1.87 8.515 1.641 8l.229-.515a6.708 6.708 0 0 1 12.26 0l.228.515-.229.515a6.708 6.708 0 0 1-12.259 0M.5 6.876l-.26.585a1.33 1.33 0 0 0 0 1.079l.26.584a8.208 8.208 0 0 0 15 0l.26-.584a1.33 1.33 0 0 0 0-1.08l-.26-.584a8.208 8.208 0 0 0-15 0M9.5 8a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0"
    AuraIconKind::EyeSlash =>
      "M3.03 1.97a.75.75 0 0 0-1.06 1.06l.83.83A8.2 8.2 0 0 0 .5 6.876l-.26.585a1.33 1.33 0 0 0 0 1.079l.26.585a8.21 8.21 0 0 0 11.434 3.87l1.036 1.035a.75.75 0 1 0 1.06-1.06zm7.788 9.908-1.294-1.293a3 3 0 0 1-4.109-4.109L3.866 4.927A6.7 6.7 0 0 0 1.87 7.486L1.641 8l.23.515a6.71 6.71 0 0 0 8.947 3.363M6.55 7.611A1.502 1.502 0 0 0 8.389 9.45zm1.658-2.604 2.784 2.784a3 3 0 0 0-2.784-2.784m5.92 3.508a6.7 6.7 0 0 1-.915 1.496l1.065 1.066A8.2 8.2 0 0 0 15.5 9.125l.26-.585a1.33 1.33 0 0 0 0-1.08l-.26-.584A8.21 8.21 0 0 0 5.572 2.37L6.81 3.61a6.71 6.71 0 0 1 7.32 3.877l.228.514z"
    AuraIconKind::Calendar =>
      "M5.25 5.497a.75.75 0 0 1-.75-.75V4A1.5 1.5 0 0 0 3 5.5v1h10v-1A1.5 1.5 0 0 0 11.5 4v.75a.75.75 0 0 1-1.5 0V4H6v.747a.75.75 0 0 1-.75.75M10 2.5H6v-.752a.75.75 0 1 0-1.5 0V2.5a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h7a3 3 0 0 0 3-3v-6a3 3 0 0 0-3-3v-.75a.75.75 0 0 0-1.5 0zM3 8v3.5A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5V8z"
    AuraIconKind::Plus =>
      "M8 1.75a.75.75 0 0 1 .75.75v4.75h4.75a.75.75 0 0 1 0 1.5H8.75v4.75a.75.75 0 0 1-1.5 0V8.75H2.5a.75.75 0 0 1 0-1.5h4.75V2.5A.75.75 0 0 1 8 1.75"
  }
}

/// Build exact monochrome vector shapes for `kind` inside a `size x size` logical box with fill color `ink`.
pub fn aura_icon_shapes(kind : AuraIconKind, size : Double, ink : Int64) -> Array[paint::Shape] {
  if !(size > 0.0) {
    return []
  }
  let s = size / 16.0
  let outlines = aura_svg_path_outlines(aura_icon_svg_path(kind), s)
  if outlines.length() == 0 {
    return []
  }
  [paint::shape_of(outlines, fill=ink, even_odd=true)]
}

/// Decorative pointer-transparent Aura icon node (Builder API).
pub fn aura_icon_node(
  parent : view::View,
  kind : AuraIconKind,
  size~ : Double = 16.0,
  ink? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let color = match ink {
      Some(f) => f
      None => fn() -> Int64 { aura_theme(node).palette.foreground }
    }
    let _ = node
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .shapes(view::Live::Is(aura_icon_shapes(kind, size, 0x010101FFL)))
      .tint(view::Live::By(color), loc=loc)
  })
}

/// Pion-JSX `<aura::Icon>` wrapper.
pub fn Icon(
  parent : view::View,
  kind~ : AuraIconKind = AuraIconKind::Check,
  size~ : Double = 16.0,
  ink? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  aura_icon_node(parent, kind, size=size, ink?=ink, loc=loc)
}
