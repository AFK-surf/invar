// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): full OKLCH / OKLab semantic token palette.
// All derived tokens are computed in floating-point via Layer-0 `packages/color` and packed to RGBA8
// only at the render boundary (`color::pack_rgba8(color::oklab_to_srgb_clip(...))`).

import "color"

fn w0_lab(l : Double, c : Double, h : Double, alpha~ : Double = 1.0) -> color::Oklab {
  color::oklch_to_oklab(color::Oklch::new(l, c, h, alpha=alpha))
}

fn w0_mix(a : color::Oklab, pa : Double, b : color::Oklab, pb : Double) -> color::Oklab {
  color::mix_oklab(a, Some(pa), b, Some(pb))
}

fn w0_mix_alpha(a : color::Oklab, pa : Double) -> color::Oklab {
  color::mix_oklab(a, Some(pa), color::Oklab::transparent(), None)
}

fn w0_pack(c : color::Oklab) -> Int64 {
  color::pack_rgba8(color::oklab_to_srgb_clip(c))
}

fn w0_pack_lch(c : color::Oklch) -> Int64 {
  color::pack_rgba8(color::oklab_to_srgb_clip(color::oklch_to_oklab(c)))
}

/// Complete semantic color palette for HeroUI v3.2.8 across all 4 modes (light/dark × standard/vibrant).
/// Every field is packed `0xRRGGBBAA` computed from floating-point OKLab/OKLCH derivations.
#derive(Eq)
pub struct AuraPalette {
  pub white : Int64
  pub black : Int64
  pub snow : Int64
  pub eclipse : Int64

  pub background : Int64
  pub background_secondary : Int64
  pub background_tertiary : Int64
  pub background_inverse : Int64
  pub foreground : Int64
  pub muted : Int64
  pub link : Int64

  pub surface : Int64
  pub surface_foreground : Int64
  pub surface_hover : Int64
  pub surface_secondary : Int64
  pub surface_secondary_foreground : Int64
  pub surface_tertiary : Int64
  pub surface_tertiary_foreground : Int64

  pub overlay : Int64
  pub overlay_foreground : Int64
  pub backdrop : Int64

  pub default_bg : Int64
  pub default_foreground : Int64
  pub default_hover : Int64
  pub default_soft : Int64
  pub default_soft_foreground : Int64
  pub default_soft_hover : Int64

  pub accent : Int64
  pub accent_foreground : Int64
  pub accent_hover : Int64
  pub accent_soft : Int64
  pub accent_soft_foreground : Int64
  pub accent_soft_hover : Int64
  pub focus : Int64

  pub success : Int64
  pub success_foreground : Int64
  pub success_hover : Int64
  pub success_soft : Int64
  pub success_soft_foreground : Int64
  pub success_soft_hover : Int64

  pub warning : Int64
  pub warning_foreground : Int64
  pub warning_hover : Int64
  pub warning_soft : Int64
  pub warning_soft_foreground : Int64
  pub warning_soft_hover : Int64

  pub danger : Int64
  pub danger_foreground : Int64
  pub danger_hover : Int64
  pub danger_soft : Int64
  pub danger_soft_foreground : Int64
  pub danger_soft_hover : Int64

  pub field_background : Int64
  pub field_foreground : Int64
  pub field_placeholder : Int64
  pub field_hover : Int64
  pub field_focus : Int64
  pub field_border : Int64
  pub field_border_hover : Int64
  pub field_border_focus : Int64

  pub border : Int64
  pub border_secondary : Int64
  pub border_tertiary : Int64
  pub separator : Int64
  pub separator_secondary : Int64
  pub separator_tertiary : Int64

  pub segment : Int64
  pub segment_foreground : Int64

  pub scrollbar : Int64
  pub scrollbar_thumb : Int64
  pub scrollbar_track : Int64
}

/// Derive the full HeroUI v3.2.8 semantic palette in floating-point OKLab/OKLCH for `cfg`.
pub fn aura_palette(cfg : AuraConfig) -> AuraPalette {
  let white_l = w0_lab(1.0, 0.0, 0.0)
  let black_l = w0_lab(0.0, 0.0, 0.0)
  let snow_l = w0_lab(0.9911, 0.0, 0.0)
  let eclipse_l = w0_lab(0.2103, 0.0059, 285.89)
  let transp_l = color::Oklab::transparent()

  let dark = cfg.dark
  let vibrant = cfg.vibrant

  let bg_l = if dark { w0_lab(0.12, 0.005, 285.823) } else { w0_lab(0.9702, 0.0, 0.0) }
  let fg_l = if dark { snow_l } else { eclipse_l }
  let bg_inv_l = if dark { snow_l } else { eclipse_l }
  let muted_l = if dark { w0_lab(0.705, 0.015, 286.067) } else { w0_lab(0.5517, 0.0138, 285.94) }

  let bg_sec_l = w0_mix(bg_l, 96.0, fg_l, 4.0)
  let bg_ter_l = w0_mix(bg_l, 92.0, fg_l, 8.0)

  let surf_l = if dark { eclipse_l } else { white_l }
  let surf_hover_l = w0_mix(surf_l, 92.0, fg_l, 8.0)
  let surf_sec_l = if dark { w0_lab(0.257, 0.0037, 286.14) } else { w0_lab(0.9524, 0.0013, 286.37) }
  let surf_ter_l = if dark { w0_lab(0.2721, 0.0024, 247.91) } else { w0_lab(0.9373, 0.0013, 286.37) }

  let overlay_l = if dark { eclipse_l } else { white_l }
  let backdrop_rgba : Int64 = if dark { 0x00000099L } else { 0x00000080L }

  let def_l = if dark { w0_lab(0.274, 0.006, 286.033) } else { w0_lab(0.94, 0.001, 286.375) }
  let def_hover_l = w0_mix(def_l, 96.0, fg_l, 4.0)
  let def_soft_l = w0_mix_alpha(def_l, 50.0)
  let def_soft_hover_l = w0_mix_alpha(def_l, 60.0)

  let accent_l = color::oklch_to_oklab(cfg.accent)
  let accent_fg_l = snow_l
  let accent_hover_l = w0_mix(accent_l, 90.0, accent_fg_l, 10.0)
  let accent_soft_l = w0_mix_alpha(accent_l, if dark { 12.0 } else { 15.0 })
  let accent_soft_hover_l = w0_mix_alpha(accent_l, if dark { 16.0 } else { 20.0 })
  let accent_soft_fg_l = if vibrant {
    w0_mix(accent_l, 92.0, fg_l, 8.0)
  } else if dark {
    w0_mix(accent_l, 80.0, snow_l, 30.0)
  } else {
    w0_mix(accent_l, 70.0, eclipse_l, 30.0)
  }

  let success_l = w0_lab(0.7329, 0.1935, 150.81)
  let success_fg_l = eclipse_l
  let success_hover_l = w0_mix(success_l, 90.0, success_fg_l, 10.0)
  let success_soft_l = w0_mix_alpha(success_l, if dark { 12.0 } else { 15.0 })
  let success_soft_hover_l = w0_mix_alpha(success_l, if dark { 16.0 } else { 20.0 })
  let success_soft_fg_l = if vibrant {
    w0_mix(success_l, 92.0, fg_l, 8.0)
  } else if dark {
    w0_mix(success_l, 80.0, snow_l, 30.0)
  } else {
    w0_mix(success_l, 80.0, eclipse_l, 60.0)
  }

  let warning_l = if dark { w0_lab(0.8203, 0.1388, 76.34) } else { w0_lab(0.7819, 0.1585, 72.33) }
  let warning_fg_l = eclipse_l
  let warning_hover_l = w0_mix(warning_l, 90.0, warning_fg_l, 10.0)
  let warning_soft_l = w0_mix_alpha(warning_l, if dark { 12.0 } else { 15.0 })
  let warning_soft_hover_l = w0_mix_alpha(warning_l, if dark { 16.0 } else { 20.0 })
  let warning_soft_fg_l = if vibrant {
    w0_mix(warning_l, 92.0, fg_l, 8.0)
  } else if dark {
    w0_mix(warning_l, 80.0, snow_l, 30.0)
  } else {
    w0_mix(warning_l, 80.0, eclipse_l, 70.0)
  }

  let danger_l = if dark { w0_lab(0.594, 0.1967, 24.63) } else { w0_lab(0.6532, 0.2328, 25.74) }
  let danger_fg_l = snow_l
  let danger_hover_l = w0_mix(danger_l, 90.0, danger_fg_l, 10.0)
  let danger_soft_l = w0_mix_alpha(danger_l, 15.0)
  let danger_soft_hover_l = w0_mix_alpha(danger_l, 20.0)
  let danger_soft_fg_l = if vibrant {
    w0_mix(danger_l, 92.0, fg_l, 8.0)
  } else if dark {
    w0_mix(danger_l, 80.0, snow_l, 30.0)
  } else {
    w0_mix(danger_l, 70.0, eclipse_l, 40.0)
  }

  let field_bg_l = surf_l
  let field_hover_l = w0_mix(field_bg_l, 90.0, fg_l, 2.0)
  let field_border_hover_l = w0_mix(transp_l, 88.0, fg_l, 10.0)
  let field_border_focus_l = w0_mix(transp_l, 74.0, fg_l, 22.0)

  let border_l = if dark { w0_lab(0.28, 0.006, 286.033) } else { w0_lab(0.90, 0.004, 286.32) }
  let border_sec_l = w0_mix(surf_l, 78.0, fg_l, 22.0)
  let border_ter_l = w0_mix(surf_l, 66.0, fg_l, 34.0)

  let sep_l = if dark { w0_lab(0.25, 0.006, 286.033) } else { w0_lab(0.92, 0.004, 286.32) }
  let sep_sec_l = w0_mix(surf_l, 85.0, fg_l, 15.0)
  let sep_ter_l = w0_mix(surf_l, 81.0, fg_l, 19.0)

  let seg_l = if dark { w0_lab(0.3964, 0.01, 285.93) } else { white_l }

  let fg_lch = if dark { color::Oklch::new(0.9911, 0.0, 0.0) } else { color::Oklch::new(0.2103, 0.0059, 285.89) }
  let scroll_lch = color::mix_oklch(fg_lch, Some(15.0), color::Oklch::transparent(), None)
  let scroll_rgba = w0_pack_lch(scroll_lch)

  let fg_rgba = w0_pack(fg_l)
  let muted_rgba = w0_pack(muted_l)
  let accent_rgba = w0_pack(accent_l)

  AuraPalette::{
    white: w0_pack(white_l),
    black: w0_pack(black_l),
    snow: w0_pack(snow_l),
    eclipse: w0_pack(eclipse_l),
    background: w0_pack(bg_l),
    background_secondary: w0_pack(bg_sec_l),
    background_tertiary: w0_pack(bg_ter_l),
    background_inverse: w0_pack(bg_inv_l),
    foreground: fg_rgba,
    muted: muted_rgba,
    link: fg_rgba,
    surface: w0_pack(surf_l),
    surface_foreground: fg_rgba,
    surface_hover: w0_pack(surf_hover_l),
    surface_secondary: w0_pack(surf_sec_l),
    surface_secondary_foreground: fg_rgba,
    surface_tertiary: w0_pack(surf_ter_l),
    surface_tertiary_foreground: fg_rgba,
    overlay: w0_pack(overlay_l),
    overlay_foreground: fg_rgba,
    backdrop: backdrop_rgba,
    default_bg: w0_pack(def_l),
    default_foreground: fg_rgba,
    default_hover: w0_pack(def_hover_l),
    default_soft: w0_pack(def_soft_l),
    default_soft_foreground: fg_rgba,
    default_soft_hover: w0_pack(def_soft_hover_l),
    accent: accent_rgba,
    accent_foreground: w0_pack(accent_fg_l),
    accent_hover: w0_pack(accent_hover_l),
    accent_soft: w0_pack(accent_soft_l),
    accent_soft_foreground: w0_pack(accent_soft_fg_l),
    accent_soft_hover: w0_pack(accent_soft_hover_l),
    focus: accent_rgba,
    success: w0_pack(success_l),
    success_foreground: w0_pack(success_fg_l),
    success_hover: w0_pack(success_hover_l),
    success_soft: w0_pack(success_soft_l),
    success_soft_foreground: w0_pack(success_soft_fg_l),
    success_soft_hover: w0_pack(success_soft_hover_l),
    warning: w0_pack(warning_l),
    warning_foreground: w0_pack(warning_fg_l),
    warning_hover: w0_pack(warning_hover_l),
    warning_soft: w0_pack(warning_soft_l),
    warning_soft_foreground: w0_pack(warning_soft_fg_l),
    warning_soft_hover: w0_pack(warning_soft_hover_l),
    danger: w0_pack(danger_l),
    danger_foreground: w0_pack(danger_fg_l),
    danger_hover: w0_pack(danger_hover_l),
    danger_soft: w0_pack(danger_soft_l),
    danger_soft_foreground: w0_pack(danger_soft_fg_l),
    danger_soft_hover: w0_pack(danger_soft_hover_l),
    field_background: w0_pack(field_bg_l),
    field_foreground: fg_rgba,
    field_placeholder: muted_rgba,
    field_hover: w0_pack(field_hover_l),
    field_focus: w0_pack(field_bg_l),
    field_border: 0x00000000L,
    field_border_hover: w0_pack(field_border_hover_l),
    field_border_focus: w0_pack(field_border_focus_l),
    border: w0_pack(border_l),
    border_secondary: w0_pack(border_sec_l),
    border_tertiary: w0_pack(border_ter_l),
    separator: w0_pack(sep_l),
    separator_secondary: w0_pack(sep_sec_l),
    separator_tertiary: w0_pack(sep_ter_l),
    segment: w0_pack(seg_l),
    segment_foreground: fg_rgba,
    scrollbar: scroll_rgba,
    scrollbar_thumb: scroll_rgba,
    scrollbar_track: 0x00000000L,
  }
}
