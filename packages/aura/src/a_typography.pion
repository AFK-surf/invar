// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Typography scale (H1..H6, Body, BodySm/Small,
// BodyXs, Muted, Code) with weight, alignment, color, and truncation modifiers.

import "text"
import "view"

/// Semantic typography hierarchy aligned with HeroUI `typography.css`.
#derive(Eq)
pub enum AuraTypographyType {
  H1
  H2
  H3
  H4
  H5
  H6
  Body
  BodySm
  BodyXs
  Muted
  Small
  Code
}

/// Typography text color token.
#derive(Eq)
pub enum AuraTypographyColor {
  Default
  Muted
}

/// Typography horizontal alignment.
#derive(Eq)
pub enum AuraTypographyAlign {
  Start
  Center
  End
}

/// Optional font weight override (`Auto` uses the hierarchy's default weight).
#derive(Eq)
pub enum AuraTypographyWeight {
  Auto
  Normal
  Medium
  Semibold
  Bold
}

fn a_typo_spec(kind : AuraTypographyType) -> (Double, Double, Int, Double) {
  // Returns (font_size_pt, line_height_pt, default_weight, tracking_em)
  match kind {
    AuraTypographyType::H1 => (36.0, 40.0, 600, -0.025)
    AuraTypographyType::H2 => (30.0, 36.0, 600, -0.025)
    AuraTypographyType::H3 => (24.0, 32.0, 600, -0.025)
    AuraTypographyType::H4 => (20.0, 28.0, 600, -0.025)
    AuraTypographyType::H5 => (18.0, 28.0, 600, -0.025)
    AuraTypographyType::H6 => (16.0, 24.0, 600, -0.025)
    AuraTypographyType::Body => (16.0, 28.0, 400, 0.0)
    AuraTypographyType::BodySm | AuraTypographyType::Small | AuraTypographyType::Muted => (14.0, 24.0, 400, 0.0)
    AuraTypographyType::BodyXs => (12.0, 20.0, 400, 0.0)
    AuraTypographyType::Code => (14.0, 20.0, 400, 0.0)
  }
}

fn a_typo_weight(kind : AuraTypographyType, w : AuraTypographyWeight) -> Int {
  match w {
    AuraTypographyWeight::Auto => a_typo_spec(kind).2
    AuraTypographyWeight::Normal => 400
    AuraTypographyWeight::Medium => 500
    AuraTypographyWeight::Semibold => 600
    AuraTypographyWeight::Bold => 700
  }
}

fn a_typo_effective_color(kind : AuraTypographyType, color : Option[AuraTypographyColor]) -> AuraTypographyColor {
  match color {
    Some(c) => c
    None =>
      if kind is AuraTypographyType::Muted {
        AuraTypographyColor::Muted
      } else {
        AuraTypographyColor::Default
      }
  }
}

/// Aura `Typography` text element (Builder API).
/// Supports `H1..H6`, `Body`, `BodySm`/`Small`, `BodyXs`, `Muted`, and `Code` (rounded-md `--default`
/// monospace pill), plus color, alignment, weight, and single-line truncation.
pub fn typography_node(
  parent : view::View,
  text_val : view::Live[String],
  kind~ : AuraTypographyType = AuraTypographyType::Body,
  color? : AuraTypographyColor,
  align~ : AuraTypographyAlign = AuraTypographyAlign::Start,
  weight~ : AuraTypographyWeight = AuraTypographyWeight::Auto,
  truncate~ : Bool = false,
  wrap~ : Bool = true,
  mono~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let (fs, lh, _, track_em) = a_typo_spec(kind)
  let wt = a_typo_weight(kind, weight)
  let eff_color = a_typo_effective_color(kind, color)
  let eff_wrap = if truncate { false } else { wrap }
  let tracking = if track_em != 0.0 { view::Spacing::Ems(track_em) } else { view::Spacing::Points(0.0) }
  let look = view::WordsLook::{
    ..view::words_plain,
    size: fs,
    weight: wt,
    line: lh,
    wrap: eff_wrap,
    tracking,
    max_lines: if truncate { 1 } else { 0 },
  }
  let ink_of = fn(v : view::View) -> Int64 {
    let pal = aura_theme(v).palette
    match eff_color {
      AuraTypographyColor::Default => pal.foreground
      AuraTypographyColor::Muted => pal.muted
    }
  }
  if kind is AuraTypographyType::Code {
    let txt_get = text_val.to_getter()
    parent.box(loc=loc, fn(node : view::View) -> Unit {
      let _ = node
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .pad_xy(6.0, 2.0)
        .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
        .radius(view::Live::Is(6.0))
        .ground(view::Live::By(fn() -> Int64 { aura_theme(node).palette.default_bg }))
      let _ = node.box(fn(inner : view::View) -> Unit {
        if mono {
          let _ = inner
            .words_runs(
              view::Live::By(fn() -> Array[text::Run] {
                [text::Run::{ ..text::plain(txt_get()), mono: true }]
              }),
              look=look,
            )
            .ink(view::Live::By(fn() -> Int64 { ink_of(node) }))
        } else {
          let _ = inner
            .words(text_val, look=look)
            .ink(view::Live::By(fn() -> Int64 { ink_of(node) }))
        }
        if truncate {
          let _ = inner.allow_ellipsis(view::Live::Is(true)).cuts(view::Live::Is(true))
        }
      })
    })
  } else {
    let is_heading = match kind {
      AuraTypographyType::H1
      | AuraTypographyType::H2
      | AuraTypographyType::H3
      | AuraTypographyType::H4
      | AuraTypographyType::H5
      | AuraTypographyType::H6 => true
      _ => false
    }
    let txt_get = text_val.to_getter()
    parent.box(loc=loc, fn(node : view::View) -> Unit {
      if is_heading {
        let _ = node.says(view::Live::By(fn() -> Option[view::Said] {
          Some(view::said(view::Role::Heading, label=txt_get()))
        }))
      }
      match align {
        AuraTypographyAlign::Center => {
          let _ = node.fills_across(view::Live::Is(true)).words_centered(view::Live::Is(true))
        }
        AuraTypographyAlign::End => {
          let _ = node
            .row(view::Live::Is(true))
            .fills_across(view::Live::Is(true))
            .lies_along(view::Live::By(fn() -> view::Lies {
              if aura_rtl(node) { view::Lies::Start } else { view::Lies::End }
            }))
        }
        AuraTypographyAlign::Start => ()
      }
      if align is AuraTypographyAlign::End {
        let _ = node.box(fn(inner : view::View) -> Unit {
          let _ = inner
            .words(text_val, look=look)
            .words_look(view::Live::By(fn() -> view::WordsLook { look.with_rtl(aura_rtl(inner)) }))
            .ink(view::Live::By(fn() -> Int64 { ink_of(node) }))
          if truncate {
            let _ = inner.allow_ellipsis(view::Live::Is(true)).cuts(view::Live::Is(true))
          }
        })
      } else {
        let _ = node
          .words(text_val, look=look)
          .words_look(view::Live::By(fn() -> view::WordsLook { look.with_rtl(aura_rtl(node)) }))
          .ink(view::Live::By(fn() -> Int64 { ink_of(node) }))
        if truncate {
          let _ = node.allow_ellipsis(view::Live::Is(true)).cuts(view::Live::Is(true))
        }
      }
    })
  }
}

/// Pion-JSX `<aura::Typography>` wrapper.
pub fn Typography(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  kind~ : AuraTypographyType = AuraTypographyType::Body,
  color? : AuraTypographyColor,
  align~ : AuraTypographyAlign = AuraTypographyAlign::Start,
  weight~ : AuraTypographyWeight = AuraTypographyWeight::Auto,
  truncate~ : Bool = false,
  wrap~ : Bool = true,
  mono~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  typography_node(
    parent,
    t,
    kind=kind,
    color?=color,
    align=align,
    weight=weight,
    truncate=truncate,
    wrap=wrap,
    mono=mono,
    loc=loc,
  )
}
