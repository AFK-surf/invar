// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): theme configuration, responsive viewport breakpoints,
// and per-tree reactive AuraConfig context.

import "color"
import "signals"
import "ui"
import "view"

/// Control density override. Default `AutoResponsive` tracks `Tree::room_signal()` logical width
/// (`sm = 640pt`, `md = 768pt`) strictly decoupled from pointer coarseness.
#derive(Eq)
pub enum AuraDensity {
  AutoResponsive
  Compact
  Regular
  Touch
}

/// Per-tree Aura design-system configuration borrowed via `view::Lent[signals::Signal[AuraConfig]]`.
#derive(Eq)
pub struct AuraConfig {
  pub dark : Bool
  pub vibrant : Bool
  pub radius : Double
  pub spacing : Double
  pub accent : color::Oklch
  pub auto_surface : Bool
  pub density : AuraDensity
  pub reduced_motion : Bool
}

impl signals::Eq for AuraConfig {
  fn eq(self : AuraConfig, other : AuraConfig) -> Bool {
    self == other
  }
}

/// Default HeroUI v3.2.8 accent (`oklch(62.04% 0.195 253.83)`).
pub fn aura_default_accent() -> color::Oklch {
  color::Oklch::new(0.6204, 0.195, 253.83)
}

/// Default light-mode `AuraConfig` aligned with HeroUI v3.2.8.
pub fn AuraConfig::default() -> AuraConfig {
  AuraConfig::{
    dark: false,
    vibrant: false,
    radius: 8.0,
    spacing: 4.0,
    accent: aura_default_accent(),
    auto_surface: false,
    density: AuraDensity::AutoResponsive,
    reduced_motion: false,
  }
}

/// Convenience dark-mode `AuraConfig`.
pub fn AuraConfig::dark(vibrant~ : Bool = false) -> AuraConfig {
  AuraConfig::{ ..AuraConfig::default(), dark: true, vibrant }
}

/// Convenience light-mode `AuraConfig`.
pub fn AuraConfig::light(vibrant~ : Bool = false) -> AuraConfig {
  AuraConfig::{ ..AuraConfig::default(), dark: false, vibrant }
}

/// Tailwind / HeroUI responsive width breakpoints (in logical points).
pub let aura_bp_sm : Double = 640.0
pub let aura_bp_md : Double = 768.0

let w0_config_lent : view::Lent[signals::Signal[AuraConfig]] = view::Lent::new()

/// Borrow an `AuraConfig` signal to `host` and all of its descendants.
pub fn aura_provide_config(host : view::View, cfg : signals::Signal[AuraConfig]) -> view::View {
  host.lends(w0_config_lent, cfg)
}

/// Read the nearest borrowed `AuraConfig` (or default light config if no provider is mounted).
pub fn aura_config_of(v : view::View) -> AuraConfig {
  match v.lent(w0_config_lent) {
    Some(sig) => sig.get()
    None => AuraConfig::default()
  }
}

/// Return the nearest borrowed `AuraConfig` signal, if any.
pub fn aura_config_signal_of(v : view::View) -> Option[signals::Signal[AuraConfig]] {
  v.lent(w0_config_lent)
}

/// Whether the viewport width is at or above the `sm` breakpoint (`>= 640pt`).
/// Strictly tracks `Tree::room_signal()` logical width, decoupled from pointer type.
pub fn aura_is_sm(v : view::View) -> Bool {
  let cfg = aura_config_of(v)
  match cfg.density {
    Compact | Regular => true
    Touch => false
    AutoResponsive => v.tree.room_signal().get().0 >= aura_bp_sm
  }
}

/// Whether the viewport width is at or above the `md` breakpoint (`>= 768pt`).
/// Strictly tracks `Tree::room_signal()` logical width, decoupled from pointer type.
pub fn aura_is_md(v : view::View) -> Bool {
  let cfg = aura_config_of(v)
  match cfg.density {
    Compact => true
    Regular | Touch => false
    AutoResponsive => v.tree.room_signal().get().0 >= aura_bp_md
  }
}

/// Whether the active input pointer is coarse (touch / finger).
/// Controls ONLY `@media (hover: none) and (pointer: coarse)` behaviors (hover wash suppression,
/// mobile overlay transition backdrop blur bypass), never layout sizing breakpoints.
pub fn aura_is_coarse_pointer(_v : view::View) -> Bool {
  ui::pointing() is ui::Pointing::Finger
}
