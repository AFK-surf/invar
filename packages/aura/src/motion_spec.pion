// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): motion timing and reduced-motion helpers.

import "ui"
import "view"

/// Standard HeroUI v3.2.8 interaction motion constants (`button.css` `:active`: base 0.97, `--sm` 0.98, `--lg` 0.96;
/// `close-button.css` `:active`: 0.93).
pub let aura_button_press_scale : Double = 0.97
pub let aura_button_press_scale_sm : Double = 0.98
pub let aura_button_press_scale_lg : Double = 0.96
pub let aura_close_button_press_scale : Double = 0.93
pub let aura_tooltip_delay_ms : Double = 1500.0
pub let aura_tooltip_close_delay_ms : Double = 500.0
pub let aura_spinner_period_ms : Double = 800.0

/// Whether reduced motion is active for `v`'s tree.
/// Inherits the system reduced-motion setting (`ui::reduced_motion()`) unless overridden to `true` via
/// `AuraConfig.reduced_motion`.
pub fn aura_reduced_motion(v : view::View) -> Bool {
  aura_config_of(v).reduced_motion || ui::reduced_motion()
}
