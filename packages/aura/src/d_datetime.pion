  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  read_only~ : () -> Bool = fn() { false },
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  time_field_node(
    parent,
    value,
    on_change,
    label=label,
    description=description,
    error_message=error_message,
    granularity=granularity,
    hour_cycle_12=hour_cycle_12,
    variant=variant,
    invalid=inv,
    disabled=dis,
    read_only=read_only,
    prefix?=prefix,
    suffix?=suffix,
    loc=loc,
  )
}
