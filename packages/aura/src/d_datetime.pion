// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0):
// Track 1D Date & Time Family components (6 leaves):
// 15. Calendar
// 16. RangeCalendar
// 17. CalendarYearPicker
// 18. DateField
// 19. TimeField
// 20. DateInputGroup

import "headless"
import "headless_core"
import "signals"
import "view"

/// Convenience constructors for Aura ISO dates & segmented date/time values.
pub fn aura_date(year : Int, month : Int, day : Int) -> headless_core::IsoDate {
  headless_core::IsoDate::new(year, month, day)
}

pub fn aura_segmented_date(year : Int, month : Int, day : Int) -> headless_core::SegmentedDateTime {
  headless_core::SegmentedDateTime::from_date(headless_core::IsoDate::new(year, month, day))
}

pub fn aura_segmented_time(hour : Int, minute : Int, second~ : Option[Int] = None) -> headless_core::SegmentedDateTime {
  headless_core::SegmentedDateTime::{
    year: None,
    month: None,
    day: None,
    hour: Some(hour),
    minute: Some(minute),
    second,
  }
}

pub fn aura_segmented_empty() -> headless_core::SegmentedDateTime {
  headless_core::SegmentedDateTime::empty()
}

fn d_month_name(month : Int) -> String {
  match month {
    1 => "January"
    2 => "February"
    3 => "March"
    4 => "April"
    5 => "May"
    6 => "June"
    7 => "July"
    8 => "August"
    9 => "September"
    10 => "October"
    11 => "November"
    _ => "December"
  }
}

fn d_weekday_short(idx : Int) -> String {
  match ((idx % 7) + 7) % 7 {
    0 => "Sun"
    1 => "Mon"
    2 => "Tue"
    3 => "Wed"
    4 => "Thu"
    5 => "Fri"
    _ => "Sat"
  }
}

fn d_visible_weeks(cells : Array[headless_core::CalendarCell]) -> Int {
  // Trim trailing all-outside-month 6th week (matches React Aria / HeroUI month grid).
  if cells.length() >= 42 && cells[35].outside_month {
    5
  } else {
    cells.length() / 7
  }
}

fn d_cal_nav_button(
  parent : view::View,
  kind : AuraIconKind,
  label : String,
  on_press : () -> Unit,
  disabled : () -> Bool,
) -> view::View {
  headless::button(
    parent,
    fn() -> String { label },
    fn(_v : view::View) -> Unit { on_press() },
    fn(btn : view::View, _b : headless::Button) -> Unit {
      let _ = btn
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .width(view::Live::Is(Some(24.0)))
        .height(view::Live::Is(Some(24.0)))
        .shrink(view::Live::Is(0.0))
        .corner_circular(view::Live::Is(true))
        .radius(view::Live::Is(12.0))
        .ground(view::Live::By(fn() -> Int64 {
          if !disabled() && (btn.pressed() || (!aura_is_coarse_pointer(btn) && btn.pointed())) {
            aura_theme(btn).palette.default_bg
          } else {
            0x00000000L
          }
        }))
        .group_alpha(view::Live::By(fn() -> Double {
          if disabled() { aura_theme(btn).disabled_opacity } else { 1.0 }
        }))
      let _ = w0_apply_control_focus_ring(btn)
      let _ = aura_icon_node(btn, kind, size=14.0, ink=fn() -> Int64 {
        aura_theme(btn).palette.accent_soft_foreground
      })
    },
    disabled=disabled,
  )
}

// ============================================================================
// 17. CalendarYearPicker (calendar-year-picker.css, wired to headless::calendar_year_picker)
// ============================================================================

/// Aura `CalendarYearPicker` paged 3-column year grid (Builder API), wired to `headless::calendar_year_picker`.
pub fn calendar_year_picker_node(
  parent : view::View,
  selected_year : () -> Int,
  on_select : (Int) -> Unit,
  page_size~ : Int = 12,
  min_year? : Int,
  max_year? : Int,
  width~ : Double = 252.0,
  label~ : String = "Select year",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  headless::calendar_year_picker(
    parent,
    fn() -> String { label },
    selected_year,
    on_select,
    fn(root : view::View, yp : headless::CalendarYearPicker) -> Unit {
      let _ = root.width(view::Live::Is(Some(width))).gap(view::Live::Is(8.0))
      // Header with page range + prev/next buttons
      let _ = root.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
          .row(view::Live::Is(true))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .pad_xy(2.0, 0.0)
        let _ = d_cal_nav_button(hdr, AuraIconKind::ChevronLeft, "Previous years", fn() { yp.prev_page() }, disabled)
        let _ = d_text_box(
          hdr,
          view::Live::By(fn() -> String {
            let ys = yp.years()
            if ys.length() == 0 {
              ""
            } else if ys.length() == 1 {
              "\{ys[0]}"
            } else {
              "\{ys[0]} – \{ys[ys.length() - 1]}"
            }
          }),
          d_words_look(14.0, 500, 20.0),
          view::Live::By(fn() -> Int64 { aura_theme(hdr).palette.foreground }),
        )
        let _ = d_cal_nav_button(hdr, AuraIconKind::ChevronRight, "Next years", fn() { yp.next_page() }, disabled)
      })
      // 3-column reactive year grid (strictly bounded to `yp.years()` — never emits out-of-page GridCells)
      let cols = 3
      let cell_w = (width - 8.0) / 3.0
      let _ = root.box(fn(grid_host : view::View) -> Unit {
        let _ = grid_host.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
        let _ = grid_host.each(
          fn() -> Array[(Int, Int)] {
            let ys = yp.years()
            let total = ys.length()
            let n_rows = (total + cols - 1) / cols
            let out : Array[(Int, Int)] = []
            let mut r = 0
            while r < n_rows {
              let start = r * cols
              let rem = total - start
              let cnt = if rem > cols { cols } else { rem }
              out.push((ys[start], cnt))
              r += 1
            }
            out
          },
          fn(rk : (Int, Int)) -> Int { rk.0 * 4 + rk.1 },
          fn(row_parent : view::View, rk_sig : signals::Signal[(Int, Int)]) -> Unit {
            let (first_y, cnt) = rk_sig.untracked()
            let _ = row_parent.box(fn(row : view::View) -> Unit {
              let _ = row.row(view::Live::Is(true)).fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
              let mut c = 0
              while c < cols {
                if c < cnt {
                  let yr = first_y + c
                  let _ = yp.year_cell(row, yr, fn(cell : view::View, is_sel : () -> Bool, is_off : () -> Bool) -> Unit {
                    let _ = cell
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .width(view::Live::Is(Some(cell_w)))
                      .height(view::Live::Is(Some(32.0)))
                      .corner_circular(view::Live::Is(true))
                      .radius(view::Live::Is(16.0))
                      .ground(view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        let hov = !is_off() && !aura_is_coarse_pointer(cell) && cell.pointed()
                        if is_sel() {
                          if hov { pal.accent_hover } else { pal.accent }
                        } else if hov {
                          pal.default_bg
                        } else {
                          0x00000000L
                        }
                      }))
                      .group_alpha(view::Live::By(fn() -> Double {
                        if is_off() { aura_theme(cell).disabled_opacity } else { 1.0 }
                      }))
                    let _ = w0_apply_control_focus_ring(cell)
                    let _ = d_text_box(
                      cell,
                      view::Live::Is("\{yr}"),
                      d_words_look(14.0, 500, 20.0),
                      view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        if is_sel() { pal.accent_foreground } else { pal.foreground }
                      }),
                    )
                  })
                } else {
                  // Pure layout placeholder box (no GridCell / focus / pointer) to preserve 3-column alignment
                  let _ = row.box(fn(ph : view::View) -> Unit {
                    let _ = ph
                      .width(view::Live::Is(Some(cell_w)))
                      .height(view::Live::Is(Some(32.0)))
                      .points(view::Live::Is(false))
                  })
                }
                c += 1
              }
            })
          },
        )
      })
    },
    page_size=page_size,
    min_year?=min_year,
    max_year?=max_year,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::CalendarYearPicker>` wrapper.
pub fn CalendarYearPicker(
  parent : view::View,
  selected_year~ : () -> Int,
  on_select~ : (Int) -> Unit = fn(_y : Int) { () },
  page_size~ : Int = 12,
  min_year? : Int,
  max_year? : Int,
  width~ : Double = 252.0,
  label~ : String = "Select year",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  calendar_year_picker_node(
    parent,
    selected_year,
    on_select,
    page_size=page_size,
    min_year?=min_year,
    max_year?=max_year,
    width=width,
    label=label,
    disabled=disabled,
    loc=loc,
  )
}

// ============================================================================
// 15. Calendar (calendar.css, wired to headless::calendar)
// ============================================================================

/// Aura `Calendar` single-date ISO Gregorian month grid (Builder API), wired to `headless::calendar`.
pub fn calendar_node(
  parent : view::View,
  initial_focus : headless_core::IsoDate,
  selected : () -> Option[headless_core::IsoDate],
  on_select : (headless_core::IsoDate) -> Unit,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  show_year_picker~ : Bool = true,
  width~ : Double = 252.0,
  label~ : String = "Calendar",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let cell_d = width / 7.0
  let year_open = signals::signal(false)

  headless::calendar(
    parent,
    fn() -> String { label },
    initial_focus,
    selected,
    on_select,
    fn(root : view::View, cal : headless::Calendar) -> Unit {
      let _ = root.width(view::Live::Is(Some(width))).shrink(view::Live::Is(0.0))
      // Header: [<] [Month Year >] [>]
      let _ = root.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
          .row(view::Live::Is(true))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .pad_xy(2.0, 0.0)
          .margin(view::Live::Is((0.0, 0.0, 0.0, 16.0)))
        let _ = hdr.box(fn(left_grp : view::View) -> Unit {
          let _ = left_grp
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(0.0))
          let _ = d_cal_nav_button(left_grp, AuraIconKind::ChevronLeft, "Previous month", fn() { cal.prev_month() }, disabled)
          if show_year_picker {
            let _ = headless::button(
              left_grp,
              fn() -> String { "\{d_month_name(cal.visible_month())} \{cal.visible_year()}" },
              fn(_v : view::View) -> Unit { year_open.set(!year_open.untracked()) },
              fn(trig : view::View, _b : headless::Button) -> Unit {
                let _ = trig
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .gap(view::Live::Is(4.0))
                  .corner_circular(view::Live::Is(true))
                  .radius(view::Live::Is(8.0))
                let _ = w0_apply_control_focus_ring(trig)
                let _ = d_text_box(
                  trig,
                  view::Live::By(fn() -> String { "\{d_month_name(cal.visible_month())} \{cal.visible_year()}" }),
                  d_words_look(14.0, 500, 20.0),
                  view::Live::By(fn() -> Int64 {
                    let pal = aura_theme(trig).palette
                    if year_open.get() { pal.accent_soft_foreground } else { pal.foreground }
                  }),
                )
                let _ = aura_icon_node(trig, AuraIconKind::ChevronRight, size=12.0, ink=fn() -> Int64 {
                  aura_theme(trig).palette.accent_soft_foreground
                })
              },
              disabled=disabled,
            )
          } else {
            let _ = d_text_box(
              left_grp,
              view::Live::By(fn() -> String { "\{d_month_name(cal.visible_month())} \{cal.visible_year()}" }),
              d_words_look(14.0, 500, 20.0),
              view::Live::By(fn() -> Int64 { aura_theme(left_grp).palette.foreground }),
            )
          }
        })
        let _ = d_cal_nav_button(hdr, AuraIconKind::ChevronRight, "Next month", fn() { cal.next_month() }, disabled)
      })

      // Body: either YearPicker or Month Grid
      let _ = root.show(fn() -> Bool { year_open.get() }, fn(yp_host : view::View) -> Unit {
        let _ = calendar_year_picker_node(
          yp_host,
          fn() -> Int { cal.visible_year() },
          fn(yr : Int) -> Unit {
            let cur = cal.focused_date()
            cal.set_focused_date(headless_core::IsoDate::new(yr, cur.month, cur.day))
            year_open.set(false)
          },
          width=width,
          disabled=disabled,
        )
      })

      let _ = root.show(fn() -> Bool { !year_open.get() }, fn(grid_wrap : view::View) -> Unit {
        let _ = grid_wrap.fills_across(view::Live::Is(true))
        // Weekday header row
        let _ = grid_wrap.box(fn(wk : view::View) -> Unit {
          let _ = wk.row(view::Live::Is(true)).fills_across(view::Live::Is(true)).margin(view::Live::Is((0.0, 0.0, 0.0, 12.0)))
          let mut c = 0
          while c < 7 {
            let day_name = d_weekday_short(first_day_of_week + c)
            let _ = wk.box(fn(th : view::View) -> Unit {
              let _ = th
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .width(view::Live::Is(Some(cell_d)))
                .height(view::Live::Is(Some(16.0)))
              let _ = d_text_box(
                th,
                view::Live::Is(day_name),
                d_words_look(12.0, 500, 16.0),
                view::Live::By(fn() -> Int64 { aura_theme(th).palette.muted }),
              )
            })
            c += 1
          }
        })
        // Day rows (re-keyed by visible year*12 + month so month navigation swaps rows cleanly)
        let _ = grid_wrap.each(
          fn() -> Array[Int] {
            let cells = cal.cells()
            let n_wks = d_visible_weeks(cells)
            let ym = cal.visible_year() * 100 + cal.visible_month()
            let out : Array[Int] = []
            let mut r = 0
            while r < n_wks {
              out.push(ym * 10 + r)
              r += 1
            }
            out
          },
          fn(rk : Int) -> Int { rk },
          fn(row_host : view::View, rk_sig : signals::Signal[Int]) -> Unit {
            let week_idx = rk_sig.untracked() % 10
            let cells = signals::untracked(fn() { cal.cells() })
            let _ = row_host.box(fn(row : view::View) -> Unit {
              let _ = row.row(view::Live::Is(true)).fills_across(view::Live::Is(true))
              let mut c = 0
              while c < 7 {
                let idx = week_idx * 7 + c
                if idx < cells.length() {
                  let entry = cells[idx]
                  let dt = entry.date
                  let outside = entry.outside_month
                  let _ = cal.day_cell(row, dt, fn(cell : view::View, is_sel : () -> Bool, is_off : () -> Bool) -> Unit {
                    let _ = cell
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .width(view::Live::Is(Some(cell_d)))
                      .height(view::Live::Is(Some(cell_d)))
                      .shrink(view::Live::Is(0.0))
                      .corner_circular(view::Live::Is(true))
                      .radius(view::Live::Is(cell_d * 0.5))
                      .ground(view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        let sel = is_sel()
                        let td = cal.is_today(dt)
                        let hov = !is_off() && !aura_is_coarse_pointer(cell) && cell.pointed()
                        if sel && !outside {
                          if cell.pressed() { pal.accent_hover } else { pal.accent }
                        } else if sel && outside {
                          pal.default_bg
                        } else if td && !outside {
                          if hov { pal.accent_soft_hover } else { pal.accent_soft }
                        } else if hov || cell.pressed() {
                          pal.default_bg
                        } else {
                          0x00000000L
                        }
                      }))
                      .group_alpha(view::Live::By(fn() -> Double {
                        if outside || is_off() { aura_theme(cell).disabled_opacity } else { 1.0 }
                      }))
                    let _ = w0_apply_control_focus_ring(cell)
                    let _ = d_text_box(
                      cell,
                      view::Live::Is("\{dt.day}"),
                      d_words_look(14.0, 500, 20.0),
                      view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        if is_sel() && !outside {
                          pal.accent_foreground
                        } else if cal.is_today(dt) && !outside {
                          pal.accent_soft_foreground
                        } else if outside {
                          pal.muted
                        } else {
                          pal.foreground
                        }
                      }),
                    )
                  })
                }
                c += 1
              }
            })
          },
        )
      })
    },
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Calendar>` wrapper.
pub fn Calendar(
  parent : view::View,
  initial_focus~ : headless_core::IsoDate,
  selected~ : () -> Option[headless_core::IsoDate] = fn() { None },
  on_select~ : (headless_core::IsoDate) -> Unit = fn(_d : headless_core::IsoDate) { () },
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  show_year_picker~ : Bool = true,
  width~ : Double = 252.0,
  label~ : String = "Calendar",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  calendar_node(
    parent,
    initial_focus,
    selected,
    on_select,
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    show_year_picker=show_year_picker,
    width=width,
    label=label,
    disabled=disabled,
    loc=loc,
  )
}

// ============================================================================
// 16. RangeCalendar (range-calendar.css, wired to headless::range_calendar)
// ============================================================================

/// Aura `RangeCalendar` (Builder API), wired to `headless::range_calendar`.
/// Renders start/end circular accent caps with continuous soft-accent range track and row-edge rounding.
pub fn range_calendar_node(
  parent : view::View,
  initial_focus : headless_core::IsoDate,
  range : () -> Option[(headless_core::IsoDate, headless_core::IsoDate)],
  on_change : (headless_core::IsoDate, headless_core::IsoDate) -> Unit,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  width~ : Double = 252.0,
  label~ : String = "Range calendar",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let cell_d = width / 7.0

  headless::range_calendar(
    parent,
    fn() -> String { label },
    initial_focus,
    range,
    on_change,
    fn(root : view::View, rc : headless::RangeCalendar) -> Unit {
      let _ = root.width(view::Live::Is(Some(width))).shrink(view::Live::Is(0.0))
      // Header
      let _ = root.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
          .row(view::Live::Is(true))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .pad_xy(2.0, 0.0)
          .margin(view::Live::Is((0.0, 0.0, 0.0, 16.0)))
        let _ = hdr.box(fn(left_grp : view::View) -> Unit {
          let _ = left_grp.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(0.0))
          let _ = d_cal_nav_button(left_grp, AuraIconKind::ChevronLeft, "Previous month", fn() {
            let cur = rc.focused_date()
            let _ = rc.set_hover(None)
            rc.focused_sig.set(headless_core::iso_add_months(cur, -1))
          }, disabled)
          let _ = d_text_box(
            left_grp,
            view::Live::By(fn() -> String {
              let d = rc.focused_date()
              "\{d_month_name(d.month)} \{d.year}"
            }),
            d_words_look(14.0, 500, 20.0),
            view::Live::By(fn() -> Int64 { aura_theme(left_grp).palette.foreground }),
          )
        })
        let _ = d_cal_nav_button(hdr, AuraIconKind::ChevronRight, "Next month", fn() {
          let cur = rc.focused_date()
          let _ = rc.set_hover(None)
          rc.focused_sig.set(headless_core::iso_add_months(cur, 1))
        }, disabled)
      })
      // Weekday header row
      let _ = root.box(fn(wk : view::View) -> Unit {
        let _ = wk.row(view::Live::Is(true)).fills_across(view::Live::Is(true)).margin(view::Live::Is((0.0, 0.0, 0.0, 12.0)))
        let mut c = 0
        while c < 7 {
          let day_name = d_weekday_short(first_day_of_week + c)
          let _ = wk.box(fn(th : view::View) -> Unit {
            let _ = th
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .width(view::Live::Is(Some(cell_d)))
              .height(view::Live::Is(Some(16.0)))
            let _ = d_text_box(
              th,
              view::Live::Is(day_name),
              d_words_look(12.0, 500, 16.0),
              view::Live::By(fn() -> Int64 { aura_theme(th).palette.muted }),
            )
          })
          c += 1
        }
      })
      // Week rows
      let _ = root.each(
        fn() -> Array[Int] {
          let cells = rc.cells()
          let n_wks = d_visible_weeks(cells)
          let fd = rc.focused_date()
          let ym = fd.year * 100 + fd.month
          let out : Array[Int] = []
          let mut r = 0
          while r < n_wks {
            out.push(ym * 10 + r)
            r += 1
          }
          out
        },
        fn(rk : Int) -> Int { rk },
        fn(row_host : view::View, rk_sig : signals::Signal[Int]) -> Unit {
          let week_idx = rk_sig.untracked() % 10
          let cells = signals::untracked(fn() { rc.cells() })
          let _ = row_host.box(fn(row : view::View) -> Unit {
            let _ = row.row(view::Live::Is(true)).fills_across(view::Live::Is(true)).margin(view::Live::Is((0.0, 2.0, 0.0, 2.0)))
            let mut c = 0
            while c < 7 {
              let col_i = c
              let idx = week_idx * 7 + c
              if idx < cells.length() {
                let entry = cells[idx]
                let dt = entry.date
                let outside = entry.outside_month
                let _ = rc.day_cell(row, dt, fn(cell : view::View, in_r : () -> Bool, is_off : () -> Bool) -> Unit {
                  let is_start = fn() -> Bool {
                    match rc.highlighted_range() {
                      Some((s, _)) => s == dt
                      None => false
                    }
                  }
                  let is_end = fn() -> Bool {
                    match rc.highlighted_range() {
                      Some((_, e)) => e == dt
                      None => false
                    }
                  }
                  let is_today = fn() -> Bool {
                    match today() {
                      Some(t) => t == dt
                      None => false
                    }
                  }
                  let _ = cell
                    .row(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    .width(view::Live::Is(Some(cell_d)))
                    .height(view::Live::Is(Some(cell_d)))
                    .shrink(view::Live::Is(0.0))
                    .corner_circular(view::Live::Is(true))
                    .corners(view::Live::By(fn() -> Option[(Double, Double, Double, Double)] {
                      if !in_r() || outside {
                        Some((cell_d * 0.5, cell_d * 0.5, cell_d * 0.5, cell_d * 0.5))
                      } else {
                        let st = is_start()
                        let en = is_end()
                        let left_r = if st { cell_d * 0.5 } else if col_i == 0 { 8.0 } else { 0.0 }
                        let right_r = if en { cell_d * 0.5 } else if col_i == 6 { 8.0 } else { 0.0 }
                        Some((left_r, right_r, right_r, left_r))
                      }
                    }))
                    .ground(view::Live::By(fn() -> Int64 {
                      let pal = aura_theme(cell).palette
                      if in_r() && !outside {
                        pal.accent_soft
                      } else {
                        0x00000000L
                      }
                    }))
                    .group_alpha(view::Live::By(fn() -> Double {
                      if outside || is_off() { aura_theme(cell).disabled_opacity } else { 1.0 }
                    }))
                  // Inner circular button (cap / today / hover)
                  let _ = cell.box(fn(inner : view::View) -> Unit {
                    let _ = inner
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .width(view::Live::Is(Some(cell_d)))
                      .height(view::Live::Is(Some(cell_d)))
                      .points(view::Live::Is(false))
                      .corner_circular(view::Live::Is(true))
                      .radius(view::Live::Is(cell_d * 0.5))
                      .ground(view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        let cap = (is_start() || is_end()) && !outside
                        let hov = !is_off() && !aura_is_coarse_pointer(cell) && cell.pointed()
                        if cap {
                          if cell.pressed() { pal.accent_hover } else { pal.accent }
                        } else if is_today() && !outside && !in_r() {
                          if hov { pal.accent_soft_hover } else { pal.accent_soft }
                        } else if !in_r() && hov {
                          pal.default_bg
                        } else {
                          0x00000000L
                        }
                      }))
                    let _ = d_text_box(
                      inner,
                      view::Live::Is("\{dt.day}"),
                      d_words_look(14.0, 500, 20.0),
                      view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(cell).palette
                        if (is_start() || is_end()) && !outside {
                          pal.accent_foreground
                        } else if is_today() && !outside && !in_r() {
                          pal.accent_soft_foreground
                        } else {
                          pal.foreground
                        }
                      }),
                    )
                  })
                  let _ = w0_apply_control_focus_ring(cell)
                })
              }
              c += 1
            }
          })
        },
      )
    },
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::RangeCalendar>` wrapper.
pub fn RangeCalendar(
  parent : view::View,
  initial_focus~ : headless_core::IsoDate,
  range~ : () -> Option[(headless_core::IsoDate, headless_core::IsoDate)] = fn() { None },
  on_change~ : (headless_core::IsoDate, headless_core::IsoDate) -> Unit = fn(_a : headless_core::IsoDate, _b : headless_core::IsoDate) { () },
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  width~ : Double = 252.0,
  label~ : String = "Range calendar",
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  range_calendar_node(
    parent,
    initial_focus,
    range,
    on_change,
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    width=width,
    label=label,
    disabled=disabled,
    loc=loc,
  )
}

// ============================================================================
// 20. DateInputGroup (date-input-group.css, reuses w0_field_shell)
// ============================================================================

/// Segment display order for `DateField` (`MonthDayYear` matches US/HeroUI default `11 / 24 / 2026`,
/// `YearMonthDay` renders ISO `2026 / 11 / 24`).
#derive(Eq)
pub enum AuraDateOrder {
  MonthDayYear
  YearMonthDay
}

fn d_segment_is_placeholder(dt_val : headless_core::SegmentedDateTime, kind : headless_core::DateSegmentKind) -> Bool {
  match kind {
    headless_core::DateSegmentKind::Year => dt_val.year is None
    headless_core::DateSegmentKind::Month => dt_val.month is None
    headless_core::DateSegmentKind::Day => dt_val.day is None
    headless_core::DateSegmentKind::Hour | headless_core::DateSegmentKind::DayPeriod => dt_val.hour is None
    headless_core::DateSegmentKind::Minute => dt_val.minute is None
    headless_core::DateSegmentKind::Second => dt_val.second is None
  }
}

fn d_segment_display(
  df : headless::DateField,
  kind : headless_core::DateSegmentKind,
  trim_leading_zero_12h : Bool,
) -> String {
  if trim_leading_zero_12h && kind == headless_core::DateSegmentKind::Hour && df.hour_cycle_12 {
    match df.value().hour {
      Some(h) => {
        let h12 = h % 12
        "\{if h12 == 0 { 12 } else { h12 }}"
      }
      None => "--"
    }
  } else {
    df.segment_text(kind)
  }
}

/// Aura `DateInputGroup` parent compound slot (Builder API).
/// Single `w0_field_shell` with `focus_within` / `invalid` ring, optional prefix/suffix, and inner segmented input.
pub fn date_input_group_node(
  parent : view::View,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  force_focused~ : Bool = false,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let shell = w0_field_shell(
    parent,
    variant=variant,
    invalid=invalid,
    disabled=disabled,
    height=36.0,
    pad_x=12.0,
    force_focused=force_focused,
    content=fn(row : view::View) -> Unit {
      match prefix {
        Some(p) => {
          let _ = row.box(fn(ph : view::View) -> Unit {
            let _ = ph.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).shrink(view::Live::Is(0.0))
            p(ph)
          })
        }
        None => ()
      }
      let _ = row.box(fn(mid : view::View) -> Unit {
        let _ = mid
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .grow(view::Live::Is(1.0))
          .shrink(view::Live::Is(1.0))
          .min_width(view::Live::Is(Some(0.0)))
        content(mid)
      })
      match suffix {
        Some(s) => {
          let _ = row.box(fn(sh : view::View) -> Unit {
            let _ = sh.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).shrink(view::Live::Is(0.0))
            s(sh)
          })
        }
        None => ()
      }
    },
    loc=loc,
  )
  let _ = shell.fills_across(view::Live::Is(true))
  shell
}

/// Pion-JSX `<aura::DateInputGroup>` wrapper.
pub fn DateInputGroup(
  parent : view::View,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  force_focused~ : Bool = false,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  date_input_group_node(
    parent,
    variant=variant,
    invalid=inv,
    disabled=dis,
    prefix?=prefix,
    suffix?=suffix,
    force_focused=force_focused,
    content=children,
    loc=loc,
  )
}

fn d_mount_segment(
  row : view::View,
  df : headless::DateField,
  kind : headless_core::DateSegmentKind,
  invalid : () -> Bool,
  trim_12h : Bool,
) -> Unit {
  let _ = df.segment(row, kind, fn(seg : view::View, _txt : () -> String) -> Unit {
    let _ = seg
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .pad_xy(2.25, 0.0)
      .corner_circular(view::Live::Is(true))
      .radius(view::Live::Is(6.0))
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura_theme(seg).palette
        if seg.focused() {
          if invalid() { pal.danger_soft } else { pal.accent_soft }
        } else {
          0x00000000L
        }
      }))
    let _ = d_text_box(
      seg,
      view::Live::By(fn() -> String { d_segment_display(df, kind, trim_12h) }),
      d_words_look(14.0, 400, 20.0),
      view::Live::By(fn() -> Int64 {
        let pal = aura_theme(seg).palette
        if seg.focused() {
          if invalid() { pal.danger_soft_foreground } else { pal.accent_soft_foreground }
        } else if invalid() {
          pal.danger
        } else if d_segment_is_placeholder(df.value(), kind) {
          pal.field_placeholder
        } else {
          pal.field_foreground
        }
      }),
    )
  })
}

fn d_mount_literal(row : view::View, lit : String) -> Unit {
  let _ = d_text_box(
    row,
    view::Live::Is(lit),
    d_words_look(14.0, 400, 20.0),
    view::Live::By(fn() -> Int64 { aura_theme(row).palette.muted }),
  )
}

// ============================================================================
// 18. DateField (date-field.css, wired to headless::date_field)
// ============================================================================

/// Aura `DateField` (Builder API), wired to `headless::date_field`.
/// Segmented `SpinButton` date editor (`mm/dd/yyyy` or `yyyy/mm/dd`) inside `DateInputGroup`.
pub fn date_field_node(
  parent : view::View,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  granularity~ : headless_core::DateGranularity = headless_core::DateGranularity::Day,
  hour_cycle_12~ : Bool = false,
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : () -> Bool = fn() { false },
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let date_segs : Array[headless_core::DateSegmentKind] = match order {
    AuraDateOrder::MonthDayYear => [headless_core::DateSegmentKind::Month, headless_core::DateSegmentKind::Day, headless_core::DateSegmentKind::Year]
    AuraDateOrder::YearMonthDay => [headless_core::DateSegmentKind::Year, headless_core::DateSegmentKind::Month, headless_core::DateSegmentKind::Day]
  }
  parent.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
    if label != "" {
      let _ = label_node(col, view::Live::Is(label), disabled=disabled)
    }
    let _ = date_input_group_node(
      col,
      variant=variant,
      invalid=invalid,
      disabled=disabled,
      prefix?=prefix,
      suffix?=suffix,
      content=fn(mid : view::View) -> Unit {
        let _ = headless::date_field(
          mid,
          fn() -> String { if label != "" { label } else { "Date" } },
          value,
          on_change,
          fn(grp : view::View, df : headless::DateField) -> Unit {
            let _ = grp.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(0.0))
            let mut i = 0
            while i < date_segs.length() {
              if i > 0 {
                d_mount_literal(grp, "/")
              }
              d_mount_segment(grp, df, date_segs[i], inv_get, true)
              i += 1
            }
            match granularity {
              headless_core::DateGranularity::Day => ()
              headless_core::DateGranularity::Hour => {
                d_mount_literal(grp, " ")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Hour, inv_get, true)
                if hour_cycle_12 {
                  d_mount_literal(grp, " ")
                  d_mount_segment(grp, df, headless_core::DateSegmentKind::DayPeriod, inv_get, true)
                }
              }
              headless_core::DateGranularity::Minute => {
                d_mount_literal(grp, " ")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Hour, inv_get, true)
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Minute, inv_get, true)
                if hour_cycle_12 {
                  d_mount_literal(grp, " ")
                  d_mount_segment(grp, df, headless_core::DateSegmentKind::DayPeriod, inv_get, true)
                }
              }
              headless_core::DateGranularity::Second => {
                d_mount_literal(grp, " ")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Hour, inv_get, true)
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Minute, inv_get, true)
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Second, inv_get, true)
                if hour_cycle_12 {
                  d_mount_literal(grp, " ")
                  d_mount_segment(grp, df, headless_core::DateSegmentKind::DayPeriod, inv_get, true)
                }
              }
            }
          },
          granularity=granularity,
          hour_cycle_12=hour_cycle_12,
          disabled=dis_get,
          read_only=read_only,
        )
      },
    )
    if description != "" {
      let _ = col.show(fn() -> Bool { !inv_get() }, fn(d : view::View) -> Unit {
        let _ = description_node(d, view::Live::Is(description))
      })
    }
    if error_message != "" {
      let _ = field_error_node(col, view::Live::Is(error_message), visible=invalid)
    }
  })
}

/// Pion-JSX `<aura::DateField>` wrapper.
pub fn DateField(
  parent : view::View,
  value~ : () -> headless_core::SegmentedDateTime,
  on_change~ : (headless_core::SegmentedDateTime) -> Unit = fn(_v : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  granularity~ : headless_core::DateGranularity = headless_core::DateGranularity::Day,
  hour_cycle_12~ : Bool = false,
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  read_only~ : () -> Bool = fn() { false },
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  date_field_node(
    parent,
    value,
    on_change,
    label=label,
    description=description,
    error_message=error_message,
    granularity=granularity,
    hour_cycle_12=hour_cycle_12,
    order=order,
    variant=variant,
    invalid=inv,
    disabled=dis,
    read_only=read_only,
    prefix?=prefix,
    suffix?=suffix,
    loc=loc,
  )
}

// ============================================================================
// 19. TimeField (time-field.css, wired to headless::time_field)
// ============================================================================

/// Aura `TimeField` (Builder API), wired to `headless::time_field`.
/// Segmented 12h/24h `SpinButton` time editor (`hh:mm AM/PM` or `HH:mm:ss`) inside `DateInputGroup`.
pub fn time_field_node(
  parent : view::View,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  granularity~ : headless_core::DateGranularity = headless_core::DateGranularity::Minute,
  hour_cycle_12~ : Bool = true,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : () -> Bool = fn() { false },
  prefix? : (view::View) -> Unit,
  suffix? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  parent.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
    if label != "" {
      let _ = label_node(col, view::Live::Is(label), disabled=disabled)
    }
    let _ = date_input_group_node(
      col,
      variant=variant,
      invalid=invalid,
      disabled=disabled,
      prefix?=prefix,
      suffix?=suffix,
      content=fn(mid : view::View) -> Unit {
        let _ = headless::time_field(
          mid,
          fn() -> String { if label != "" { label } else { "Time" } },
          value,
          on_change,
          fn(grp : view::View, df : headless::DateField) -> Unit {
            let _ = grp.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(0.0))
            d_mount_segment(grp, df, headless_core::DateSegmentKind::Hour, inv_get, true)
            match granularity {
              headless_core::DateGranularity::Day | headless_core::DateGranularity::Hour => ()
              headless_core::DateGranularity::Minute => {
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Minute, inv_get, true)
              }
              headless_core::DateGranularity::Second => {
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Minute, inv_get, true)
                d_mount_literal(grp, ":")
                d_mount_segment(grp, df, headless_core::DateSegmentKind::Second, inv_get, true)
              }
            }
            if hour_cycle_12 {
              d_mount_segment(grp, df, headless_core::DateSegmentKind::DayPeriod, inv_get, true)
            }
          },
          granularity=granularity,
          hour_cycle_12=hour_cycle_12,
          disabled=dis_get,
          read_only=read_only,
        )
      },
    )
    if description != "" {
      let _ = col.show(fn() -> Bool { !inv_get() }, fn(d : view::View) -> Unit {
        let _ = description_node(d, view::Live::Is(description))
      })
    }
    if error_message != "" {
      let _ = field_error_node(col, view::Live::Is(error_message), visible=invalid)
    }
  })
}

/// Pion-JSX `<aura::TimeField>` wrapper.
pub fn TimeField(
  parent : view::View,
  value~ : () -> headless_core::SegmentedDateTime,
  on_change~ : (headless_core::SegmentedDateTime) -> Unit = fn(_v : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
