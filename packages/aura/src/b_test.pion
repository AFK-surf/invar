// Track 1B comprehensive unit tests:
// Covers all 17 components (Builder + Pion-JSX APIs), interactive behaviors, headless/a11y contracts,
// 1.375:1 Switch geometry + 3-layer shadow + press stretch, vector Checkbox sublines, single-Field InputOTP,
// Form cross-field error routing + Fieldset disabled inheritance, and `aura::assert_aura_ui` audit gates.

import "halt"
import "headless"
import "headless_core"
import "signals"
import "ui"
import "view"

fn b_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("b_test", msg)
  }
}

fn b_unwrap_tree(opt : Option[view::Tree]) -> view::Tree {
  match opt {
    Some(tr) => tr
    None => halt::saying("b_test", "missing tree")
  }
}

fn b_count_kind(sc : ui::Scene, want_kind : Int) -> Int {
  let mut n = 0
  let mut i = 0
  while i < sc.ninst {
    if (sc.inst[i * 60 + 5] + 0.5).to_int() == want_kind {
      n += 1
    }
    i += 1
  }
  n
}

fn b_has_text(t : ui::Tester, s : String) -> Bool {
  t.find(s) is Some(_)
}

fn b_has_role_label(t : ui::Tester, role : view::Role, label : String) -> Bool {
  for e in t.agent_snapshot() {
    if e.role == role && e.label == label {
      return true
    }
  }
  false
}

fn b_setup_aura_tree(root : view::View, dark~ : Bool = false, reduced_motion~ : Bool = false) -> signals::Signal[AuraConfig] {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::default(), dark, reduced_motion })
  ui::set_tree_theme(fn() -> ui::Theme { aura_ui_theme(cfg.get()) })
  let _ = aura_provide_config(root, cfg)
  let _ = root.ground(view::Live::By(fn() -> Int64 { aura_theme(root).palette.background }))
  cfg
}

test "b_input_variants_textarea_and_input_group_audit" {
  let changed = signals::signal("")
  let f1 = ui::Field::new(text="alex@invar.dev")
  let f2 = ui::Field::new(text="AFK-surf")
  let f3 = ui::Field::new(text="Multi\nline")
  let f4 = ui::Field::new(text="invar.dev")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    let _ = input_node(
      root,
      field=f1,
      label="Email",
      variant=AuraFieldVariant::Primary,
      on_change=fn(s : String) { changed.set(s) },
    )
    let _ = input_node(
      root,
      field=f2,
      label="Org",
      variant=AuraFieldVariant::Secondary,
    )
    let _ = surface_node(root, variant=AuraSurfaceVariant::Default, pad=12.0, content=fn(sv : view::View) -> Unit {
      let _ = input_node(sv, value="auto-in-surface", label="Auto", variant=AuraFieldVariant::Auto)
    })
    let _ = textarea_node(root, field=f3, label="Bio", rows=2, invalid=view::Live::Is(true))
    let _ = input_group_node(root, content=fn(grp : view::View) -> Unit {
      let _ = input_group_prefix_node(grp, text=view::Live::Is("https://"))
      let _ = input_group_input_node(grp, field=f4, label="Website", has_prefix=true, has_suffix=true)
      let _ = input_group_suffix_node(grp, text=view::Live::Is(".dev"))
    })
  }, width=800.0, height=600.0)
  b_assert(f1.text() == "alex@invar.dev", "primary input text mismatch")
  b_assert(f2.text() == "AFK-surf", "secondary input text mismatch")
  b_assert(f3.text() == "Multi\nline", "textarea text mismatch")
  b_assert(f4.text() == "invar.dev", "input group text mismatch")
  assert_aura_ui(t, label="b_input_variants_textarea_and_input_group")
  t.dispose()
}

test "b_textfield_invalid_hides_description_and_shows_error" {
  let inv = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = text_field_node(
      root,
      label=view::Live::Is("Username"),
      value="x",
      description=view::Live::Is("Pick a handle"),
      error=view::Live::Is("Must be at least 3 characters."),
      invalid=view::Live::By(fn() -> Bool { inv.get() }),
    )
  }, width=600.0, height=300.0)
  b_assert(b_has_text(t, "Username"), "label should be visible")
  b_assert(b_has_text(t, "Pick a handle"), "description should show when valid")
  b_assert(!b_has_text(t, "Must be at least 3 characters."), "error should be hidden when valid")
  inv.set(true)
  t.frame()
  b_assert(!b_has_text(t, "Pick a handle"), "description should hide when invalid")
  b_assert(b_has_text(t, "Must be at least 3 characters."), "error should show when invalid")
  assert_aura_ui(t, label="b_textfield_invalid")
  t.dispose()
}

test "b_search_field_clear_button_and_escape" {
  let fld = ui::Field::new(text="button")
  let cleared = signals::signal(0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = search_field_node(
      root,
      field=fld,
      label=view::Live::Is("Search"),
      on_clear=fn() -> Unit { cleared.set(cleared.get() + 1) },
    )
  }, width=600.0, height=200.0)
  b_assert(fld.text() == "button", "initial search text")
  b_assert(b_has_role_label(t, view::Role::Button, "Clear search"), "clear button should be mounted when non-empty")
  t.press("Clear search")
  t.frame()
  b_assert(fld.text() == "", "clear button should empty field")
  b_assert(cleared.get() == 1, "on_clear should fire once")
  b_assert(!b_has_role_label(t, view::Role::Button, "Clear search"), "clear button should hide when empty")
  assert_aura_ui(t, label="b_search_field")
  t.dispose()
}

test "b_number_field_stepping_clamping_and_format_presets" {
  let qty = signals::signal(42.0)
  let pct = signals::signal(0.25)
  let price = signals::signal(1234.5)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    let _ = number_field_node(
      root,
      view::Live::By(fn() -> Double { qty.get() }),
      fn(v : Double) -> Unit { qty.set(v) },
      label=view::Live::Is("Quantity"),
      min=40.0,
      max=43.0,
      step=1.0,
    )
    let _ = number_field_node(
      root,
      view::Live::By(fn() -> Double { pct.get() }),
      fn(v : Double) -> Unit { pct.set(v) },
      label=view::Live::Is("Discount"),
      min=0.0,
      max=1.0,
      step=0.05,
      precision=0,
      format_preset=AuraNumberFormat::Percent,
    )
    let _ = number_field_node(
      root,
      view::Live::By(fn() -> Double { price.get() }),
      fn(v : Double) -> Unit { price.set(v) },
      label=view::Live::Is("Price"),
      precision=2,
      format_preset=AuraNumberFormat::Currency("$"),
    )
  }, width=600.0, height=400.0)
  t.press("Increment")
  t.frame()
  b_assert(qty.get() == 43.0, "qty should increment to 43")
  t.press("Increment")
  t.frame()
  b_assert(qty.get() == 43.0, "qty should clamp at max=43")
  t.press("Decrement")
  t.frame()
  b_assert(qty.get() == 42.0, "qty should decrement to 42")
  assert_aura_ui(t, label="b_number_field")
  t.dispose()
}

test "b_input_otp_single_field_commit_paste_and_complete" {
  let completed = signals::signal("")
  let ctrl_ref : signals::Ref[Option[headless::InputOtp]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = input_otp_node(
      root,
      max_length=6,
      value="4821",
      on_complete=fn(code : String) -> Unit { completed.set(code) },
      content=fn(v : view::View, ctrl : headless::InputOtp) -> Unit {
        ctrl_ref.v = Some(ctrl)
        let _ = input_otp_group_node(v, content=fn(g : view::View) -> Unit {
          let _ = input_otp_slot_node(g, 0)
          let _ = input_otp_slot_node(g, 1)
          let _ = input_otp_slot_node(g, 2)
        })
        let _ = input_otp_separator_node(v)
        let _ = input_otp_group_node(v, content=fn(g : view::View) -> Unit {
          let _ = input_otp_slot_node(g, 3)
          let _ = input_otp_slot_node(g, 4)
          let _ = input_otp_slot_node(g, 5)
        })
      },
    )
  }, width=600.0, height=200.0)
  b_assert(b_has_text(t, "4") && b_has_text(t, "8") && b_has_text(t, "2") && b_has_text(t, "1"), "initial OTP digits should render")
  match ctrl_ref.v {
    Some(ctrl) => {
      ctrl.paste("9a8b7c654321")
      t.frame()
      b_assert(ctrl.value() == "987654", "paste should filter non-digits and truncate to 6")
      b_assert(completed.get() == "987654", "on_complete should fire when 6 digits filled")
      ctrl.backspace()
      t.frame()
      b_assert(ctrl.value() == "98765", "backspace should remove last digit")
    }
    None => halt::saying("b_test", "missing otp controller")
  }
  assert_aura_ui(t, label="b_input_otp")
  t.dispose()
}

test "b_form_cross_field_error_routing_and_fieldset_disabled" {
  let submitted_count = signals::signal(0)
  let pw = ui::Field::new(text="secret1")
  let confirm = ui::Field::new(text="secret2")
  let form_ref : signals::Ref[Option[headless::Form]] = view::ref_new(None)
  let fs_disabled = signals::signal(false)
  let inner_dis_read = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = form_node(
      root,
      label=view::Live::Is("Account"),
      on_submit=fn(_vals : Map[String, String]) -> Unit { submitted_count.set(submitted_count.get() + 1) },
      validate_form=fn(vals : Map[String, String]) -> Map[String, String] {
        let errs : Map[String, String] = Map::new()
        let a = match vals.get("password") { Some(s) => s; None => "" }
        let b = match vals.get("confirm") { Some(s) => s; None => "" }
        if a != b {
          errs["confirm"] = "Passwords do not match"
        }
        errs
      },
      content=fn(fv : view::View, f : headless::Form) -> Unit {
        form_ref.v = Some(f)
        let _ = fieldset_node(
          fv,
          label=view::Live::Is("Security"),
          disabled=view::Live::By(fn() -> Bool { fs_disabled.get() }),
          content=fn(fsv : view::View, _fs : headless::Fieldset) -> Unit {
            let _ = fieldset_legend_node(fsv, view::Live::Is("Security"))
            let _ = fieldset_description_node(fsv, view::Live::Is("Choose a strong password"))
            let _ = fieldset_group_node(fsv, content=fn(fg : view::View) -> Unit {
              let _ = text_field_node(fg, name="password", label=view::Live::Is("Password"), field=pw)
              let _ = text_field_node(fg, name="confirm", label=view::Live::Is("Confirm"), field=confirm)
              let _ = fg.box(fn(probe : view::View) -> Unit {
                probe.reacts(
                  fn() -> Bool { headless::form_disabled_inherited(probe) },
                  fn(d : Bool) -> Unit { inner_dis_read.set(d) },
                )
              })
            })
            let _ = fieldset_actions_node(fsv, content=fn(act : view::View) -> Unit {
              let _ = button_node(act, view::Live::Is("Save"), on_press=fn() { let _ = f.submit() })
            })
          },
        )
      },
    )
  }, width=600.0, height=500.0)

  match form_ref.v {
    Some(f) => {
      b_assert(!f.submit(), "mismatched passwords should block submit")
      t.frame()
      b_assert(submitted_count.get() == 0, "on_submit must not fire when invalid")
      b_assert(b_has_text(t, "Passwords do not match"), "cross-field error must route to confirm FieldError")
      confirm.set("secret1")
      b_assert(f.submit(), "matching passwords should submit")
      t.frame()
      b_assert(submitted_count.get() == 1, "on_submit must fire once when valid")
      b_assert(!b_has_text(t, "Passwords do not match"), "error must clear after valid submit")
    }
    None => halt::saying("b_test", "missing form controller")
  }
  fs_disabled.set(true)
  t.frame()
  b_assert(inner_dis_read.get(), "Fieldset disabled=true must propagate to descendants")
  assert_aura_ui(t, label="b_form_and_fieldset")
  t.dispose()
}

test "b_checkbox_and_checkbox_group_multi_select" {
  let sel = signals::signal_by(["b"], fn(_a : Array[String], _b : Array[String]) -> Bool { false })
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = checkbox_group_node(
      root,
      label=view::Live::Is("Features"),
      selected=view::Live::By(fn() -> Array[String] { sel.get() }),
      on_change=fn(next : Array[String]) -> Unit { sel.set(next) },
      content=fn(cg : view::View) -> Unit {
        let _ = checkbox_node(cg, value="a", label=view::Live::Is("Alpha"))
        let _ = checkbox_node(cg, value="b", label=view::Live::Is("Beta"))
        let _ = checkbox_node(cg, value="c", label=view::Live::Is("Gamma"), indeterminate=view::Live::Is(true))
      },
    )
  }, width=500.0, height=300.0)
  b_assert(b_has_role_label(t, view::Role::Checkbox, "Alpha"), "Alpha checkbox role should exist")
  t.press("Alpha")
  t.frame()
  b_assert(sel.get().length() == 2, "Alpha should be added to selection")
  t.press("Beta")
  t.frame()
  b_assert(sel.get().length() == 1 && sel.get()[0] == "a", "Beta should be removed leaving Alpha")
  assert_aura_ui(t, label="b_checkbox_group")
  t.dispose()
}

test "b_radio_group_roving_and_selection" {
  let plan = signals::signal("free")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = radio_group_node(
      root,
      view::Live::By(fn() -> String { plan.get() }),
      fn(v : String) -> Unit { plan.set(v) },
      label=view::Live::Is("Plan"),
      content=fn(rg : view::View) -> Unit {
        let _ = radio_node(rg, "free", label=view::Live::Is("Free"))
        let _ = radio_node(rg, "pro", label=view::Live::Is("Pro"))
        let _ = radio_node(rg, "enterprise", label=view::Live::Is("Enterprise"), disabled=view::Live::Is(true))
      },
    )
  }, width=500.0, height=300.0)
  b_assert(b_has_role_label(t, view::Role::RadioGroup, "Plan"), "RadioGroup role should be present")
  t.press("Pro")
  t.frame()
  b_assert(plan.get() == "pro", "plan should update to pro")
  assert_aura_ui(t, label="b_radio_group")
  t.dispose()
}

test "b_switch_elliptical_ratio_shadows_press_stretch_and_group" {
  let on = signals::signal(true)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = switch_group_node(
      root,
      label=view::Live::Is("Switches"),
      content=fn(sg : view::View) -> Unit {
        let _ = switch_node(
          sg,
          view::Live::By(fn() -> Bool { on.get() }),
          fn(b : Bool) -> Unit { on.set(b) },
          label=view::Live::Is("Notifications"),
          size=AuraSwitchSize::Md,
        )
        let _ = switch_node(sg, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("Compact"), size=AuraSwitchSize::Sm)
        let _ = switch_node(sg, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("Large"), size=AuraSwitchSize::Lg)
      },
    )
  }, width=600.0, height=300.0)
  let tr = b_unwrap_tree(tree_ref.v)
  let sc = ui::encode_tree_scene(tr, 600.0, 300.0, 2.0, 0.0)
  b_assert(b_count_kind(sc, 2) >= 9, "checked switches must emit 3-layer aura_switch_thumb_shadows")
  b_assert(b_has_role_label(t, view::Role::Switch, "Notifications"), "Switch role must be present")
  t.press("Notifications")
  t.frame()
  b_assert(!on.get(), "switch should toggle to false")
  assert_aura_ui(t, label="b_switch_group")
  t.dispose()
}

test "b_slider_single_range_and_meter_role" {
  let vol = signals::signal(65.0)
  let lo = signals::signal(25.0)
  let hi = signals::signal(75.0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(16.0))
    let _ = slider_node(
      root,
      view::Live::By(fn() -> Double { vol.get() }),
      fn(v : Double) -> Unit { vol.set(v) },
      label=view::Live::Is("Volume"),
      min=0.0,
      max=100.0,
      step=5.0,
      marks=[AuraSliderMark::{ value: 0.0, label: "0" }, AuraSliderMark::{ value: 100.0, label: "100" }],
    )
    let _ = range_slider_node(
      root,
      view::Live::By(fn() -> Double { lo.get() }),
      view::Live::By(fn() -> Double { hi.get() }),
      fn(a : Double, b : Double) -> Unit { lo.set(a); hi.set(b) },
      label=view::Live::Is("Price Range"),
      min=0.0,
      max=100.0,
      step=5.0,
      min_gap=10.0,
    )
    let _ = meter_node(root, view::Live::Is(72.0), label=view::Live::Is("Storage Used"), color=AuraMeterColor::Accent)
    let _ = meter_node(root, view::Live::Is(90.0), label=view::Live::Is("Quota Alert"), color=AuraMeterColor::Danger)
    let _ = meter_node(root, view::Live::Is(50.0), label=view::Live::Is("Healthy"), color=AuraMeterColor::Success, size=AuraMeterSize::Sm)
    let _ = meter_node(root, view::Live::Is(80.0), label=view::Live::Is("Warn"), color=AuraMeterColor::Warning, size=AuraMeterSize::Lg)
  }, width=600.0, height=500.0)
  b_assert(b_has_text(t, "65"), "slider output should show 65")
  b_assert(b_has_text(t, "25 \u{2013} 75"), "range slider output should show 25 - 75")
  b_assert(b_has_role_label(t, view::Role::Meter, "Storage Used"), "Meter must expose Role::Meter")
  b_assert(b_has_role_label(t, view::Role::Meter, "Quota Alert"), "Danger Meter must expose Role::Meter")
  b_assert(b_has_text(t, "72%") && b_has_text(t, "90%"), "Meter output percentages must render")
  assert_aura_ui(t, label="b_slider_and_meter")
  t.dispose()
}

test "b_jsx_wrappers_smoke_all_17_components" {
  let qty = signals::signal(10.0)
  let checked = signals::signal(true)
  let plan = signals::signal("a")
  let sw = signals::signal(true)
  let sl = signals::signal(50.0)
  let rlo = signals::signal(20.0)
  let rhi = signals::signal(80.0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root, dark=true)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(8.0))
    let _ = Form(root, label=.Is("JSX Form"), children=fn(f : view::View) -> Unit {
      let _ = Fieldset(f, label=.Is("Details"), children=fn(fs : view::View) -> Unit {
        let _ = FieldsetLegend(fs, text=.Is("Details"))
        let _ = FieldsetDescription(fs, text=.Is("All 17 JSX wrappers"))
        let _ = FieldsetGroup(fs, children=fn(g : view::View) -> Unit {
          let _ = Input(g, value="hello", label="Plain")
          let _ = TextArea(g, value="bio", label="Bio")
          let _ = TextField(g, label=.Is("Name"), value="Invar")
          let _ = InputGroup(g, children=fn(ig : view::View) -> Unit {
            let _ = InputGroupPrefix(ig, text=.Is("@"))
            let _ = InputGroupInput(ig, value="team", has_prefix=true, has_suffix=true)
            let _ = InputGroupSuffix(ig, text=.Is(".io"))
          })
          let _ = SearchField(g, value="query", label=.Is("Find"))
          let _ = NumberField(g, value_by=fn() { qty.get() }, on_change=fn(v) { qty.set(v) }, label=.Is("Count"))
          let _ = InputOTP(g, max_length=4, value="12", children=fn(o : view::View) -> Unit {
            let _ = InputOTPGroup(o, children=fn(og : view::View) -> Unit {
              let _ = InputOTPSlot(og, index=0)
              let _ = InputOTPSlot(og, index=1)
            })
            let _ = InputOTPSeparator(o)
            let _ = InputOTPGroup(o, children=fn(og : view::View) -> Unit {
              let _ = InputOTPSlot(og, index=2)
              let _ = InputOTPSlot(og, index=3)
            })
          })
          let _ = CheckboxGroup(g, label=.Is("Opts"), children=fn(cg : view::View) -> Unit {
            let _ = Checkbox(cg, label=.Is("Accept"), checked_by=fn() { checked.get() }, on_change=fn(b) { checked.set(b) })
          })
          let _ = RadioGroup(g, value_by=fn() { plan.get() }, on_change=fn(v) { plan.set(v) }, label=.Is("Tier"), children=fn(rg : view::View) -> Unit {
            let _ = Radio(rg, value="a", label=.Is("Tier A"))
            let _ = Radio(rg, value="b", label=.Is("Tier B"))
          })
          let _ = SwitchGroup(g, label=.Is("Toggles"), children=fn(sg : view::View) -> Unit {
            let _ = Switch(sg, checked_by=fn() { sw.get() }, on_change=fn(b) { sw.set(b) }, label=.Is("Active"))
          })
          let _ = Slider(g, value_by=fn() { sl.get() }, on_change=fn(v) { sl.set(v) }, label=.Is("Level"))
          let _ = RangeSlider(g, low_by=fn() { rlo.get() }, high_by=fn() { rhi.get() }, on_change=fn(a, b) { rlo.set(a); rhi.set(b) }, label=.Is("Span"))
          let _ = Meter(g, value=.Is(64.0), label=.Is("Usage"))
        })
        let _ = FieldsetActions(fs, children=fn(act : view::View) -> Unit {
          let _ = Button(act, label=.Is("Done"))
        })
      })
    })
  }, width=800.0, height=1600.0)
  b_assert(b_has_text(t, "Details") && b_has_text(t, "64%"), "JSX wrappers should render cleanly")
  assert_aura_ui(t, label="b_jsx_wrappers_all_17")
  t.dispose()
}

// ---------------------------------------------------------------------------
// Wave 1 R2 regression tests (positive assertions for all Track B P1 & P2 fixes)
// ---------------------------------------------------------------------------

fn b_click_text(t : ui::Tester, text : String) -> Bool {
  match t.find(text) {
    Some((x, y)) => {
      t.click(x, y)
      true
    }
    None => false
  }
}

fn b_find_said(tr : view::Tree, role : view::Role, label : String) -> Option[view::SaidNode] {
  for sn in tr.said_order() {
    match sn.said {
      Some(sd) => if sd.role == role && sd.label == label { return Some(sn) }
      None => ()
    }
  }
  None
}

fn b_find_said_role(tr : view::Tree, role : view::Role) -> Option[view::SaidNode] {
  for sn in tr.said_order() {
    match sn.said {
      Some(sd) => if sd.role == role { return Some(sn) }
      None => ()
    }
  }
  None
}

fn b_said_has_action(acts : Array[view::Action], want : String) -> Bool {
  for a in acts {
    match (a, want) {
      (view::Action::SetText(_), "SetText") => return true
      (view::Action::Increment, "Increment") => return true
      (view::Action::Decrement, "Decrement") => return true
      _ => ()
    }
  }
  false
}

fn b_find_agent(t : ui::Tester, role : view::Role, label : String) -> Option[ui::AgentEntry] {
  for e in t.agent_snapshot() {
    if e.role == role && e.label == label {
      return Some(e)
    }
  }
  None
}

test "b_r2_readonly_no_rollback_and_disabled_locks_focus_settext" {
  let ro_input = ui::Field::new(text="old")
  let ro_area = ui::Field::new(text="old-area")
  let dis_input = ui::Field::new(text="locked")
  let ro_changes = signals::signal(0)
  let dis_changes = signals::signal(0)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    let _ = input_node(
      root,
      field=ro_input,
      label="ReadOnlyInput",
      read_only=view::Live::Is(true),
      on_change=fn(_s) { ro_changes.set(ro_changes.get() + 1) },
    )
    let _ = textarea_node(
      root,
      field=ro_area,
      label="ReadOnlyArea",
      read_only=view::Live::Is(true),
      on_change=fn(_s) { ro_changes.set(ro_changes.get() + 1) },
    )
    let _ = input_node(
      root,
      field=dis_input,
      label="DisabledInput",
      disabled=view::Live::Is(true),
      on_change=fn(_s) { dis_changes.set(dis_changes.get() + 1) },
    )
  }, width=800.0, height=400.0)

  // External updates must NOT be rolled back to stale "old" on user edit attempts
  ro_input.set("server")
  ro_input.replace_from_user("typing")
  ro_input.insert("x")
  ro_input.paste_text("pasted")
  b_assert(ro_input.text() == "server", "read-only input must keep external update 'server'")

  ro_area.set("server-area")
  ro_area.replace_from_user("typing-area")
  b_assert(ro_area.text() == "server-area", "read-only textarea must keep external update")
  b_assert(ro_changes.get() == 0, "read-only fields must not fire on_change")

  // Disabled input rejects edits and has no SetText action and is not focusable
  dis_input.replace_from_user("hacked")
  b_assert(dis_input.text() == "locked", "disabled input must reject edits")
  b_assert(dis_changes.get() == 0, "disabled input must not fire on_change")

  let tr = b_unwrap_tree(tree_ref.v)
  match b_find_said(tr, view::Role::TextField, "ReadOnlyInput") {
    Some(sn) => {
      b_assert(!sn.disabled, "read-only input must not be marked disabled")
      match sn.said {
        Some(sd) => b_assert(!b_said_has_action(sd.actions, "SetText"), "read-only input must not expose SetText")
        None => halt::saying("b_test", "missing said")
      }
    }
    None => halt::saying("b_test", "missing ReadOnlyInput semantic node")
  }
  match b_find_said(tr, view::Role::TextField, "DisabledInput") {
    Some(sn) => {
      b_assert(sn.disabled, "disabled input must be marked disabled")
      match sn.said {
        Some(sd) => b_assert(!b_said_has_action(sd.actions, "SetText"), "disabled input must not expose SetText")
        None => halt::saying("b_test", "missing said")
      }
    }
    None => halt::saying("b_test", "missing DisabledInput semantic node")
  }
  // Tabbing through the tree must never focus DisabledInput
  t.key(headless_core::key_tab)
  t.frame()
  b_assert(!dis_input.focused(), "disabled input must not receive Tab focus (1)")
  t.key(headless_core::key_tab)
  t.frame()
  b_assert(!dis_input.focused(), "disabled input must not receive Tab focus (2)")
  t.key(headless_core::key_tab)
  t.frame()
  b_assert(!dis_input.focused(), "disabled input must not receive Tab focus (3)")
  t.dispose()
}

test "b_r2_textfield_label_focuses_real_editor_and_reactive_slots" {
  let f = ui::Field::new(text="X")
  let lbl = signals::signal("")
  let inv = signals::signal(false)
  let err = signals::signal("Invalid input")
  let desc = signals::signal("Helper info")
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = text_field_node(
      root,
      field=f,
      label=view::Live::By(fn() { lbl.get() }),
      description=view::Live::By(fn() { desc.get() }),
      error=view::Live::By(fn() { err.get() }),
      invalid=view::Live::By(fn() { inv.get() }),
    )
  }, width=640.0, height=300.0)

  let tr = b_unwrap_tree(tree_ref.v)
  // When label == "", input sits at top of padded root (y=20..30, zero hidden-slot gap)
  let y_without_label = match b_find_said_role(tr, view::Role::TextField) {
    Some(sn) => sn.rect.1
    None => -1.0
  }
  b_assert(y_without_label >= 19.0 && y_without_label <= 30.0, "hidden label slot must not reserve gap, got \{y_without_label}")

  // Show label dynamically
  lbl.set("Probe label")
  t.frame()
  let y_with_label = match b_find_agent(t, view::Role::TextField, "Probe label") {
    Some(e) => {
      b_assert(e.description == "Helper info", "TextField editor must carry description")
      e.rect.1
    }
    None => halt::saying("b_test", "dynamic label did not sync to real editor")
  }
  b_assert(y_with_label > y_without_label + 16.0, "showing label must shift input down")

  // Clicking label focuses the REAL ui::Field
  b_assert(b_click_text(t, "Probe label"), "missing Probe label")
  t.frame()
  b_assert(f.focused(), "clicking TextField label must focus real ui::Field")
  f.insert("Y")
  b_assert(f.text() == "XY" || f.text() == "YX", "typing after label click must edit real field")

  // Dynamic rename + error sync to real editor
  lbl.set("Renamed")
  inv.set(true)
  t.frame()
  match b_find_agent(t, view::Role::TextField, "Renamed") {
    Some(e) => b_assert(e.description == "Invalid input", "error must sync to real editor description")
    None => halt::saying("b_test", "renamed label did not sync to real editor")
  }
  t.dispose()
}

test "b_r2_otp_slot_click_selection_ime_paste_backspace" {
  let f = ui::Field::new(text="4821")
  let completed = signals::signal("")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = input_otp_node(
      root,
      max_length=6,
      value="4821",
      field=f,
      on_complete=fn(code : String) { completed.set(code) },
    )
  }, width=640.0, height=300.0)

  // Caret at end (4), click slot 1 ("8"), type "9" -> must replace "8" giving "4921"
  f.set("4821", caret=4)
  b_assert(b_click_text(t, "8"), "missing OTP slot 8")
  t.frame()
  b_assert(f.focused(), "clicking OTP slot must focus real field")
  let (s0, s1) = f.selection()
  b_assert(s0 == 1 && s1 == 2, "clicking slot 1 must select [1, 2) in real field, got (\{s0}, \{s1})")
  f.insert("9")
  t.frame()
  b_assert(f.text() == "4921", "inserting '9' on clicked slot 1 must produce '4921'")

  // Range selection replacement: replace [1, 3) ("92") with "7" -> "471"
  f.pick(1, 3)
  t.frame()
  f.insert("7")
  t.frame()
  b_assert(f.text() == "471", "range selection replacement must produce '471'")

  // IME pre-edit does not commit; commit fills remaining slots and fires on_complete
  f.pick(3, 3)
  f.compose("5")
  t.frame()
  b_assert(f.composing(), "field must report composing during IME pre-edit")
  b_assert(f.text() == "471", "IME pre-edit must not alter committed OTP text")
  f.insert("567")
  t.frame()
  b_assert(f.text() == "471567", "IME commit must produce '471567'")
  b_assert(completed.get() == "471567", "on_complete must fire on 6 digits")

  // Backspace deletes last digit
  f.backspace()
  t.frame()
  b_assert(f.text() == "47156", "backspace must remove last digit")

  // Full-string paste filters non-digits and truncates to max_length=6
  f.pick(0, 5)
  f.paste_text("9a8b7c654321")
  t.frame()
  b_assert(f.text() == "987654", "paste must filter non-digits and truncate to 6")
  b_assert(completed.get() == "987654", "on_complete must fire after paste completes")
  t.dispose()
}

test "b_r2_number_field_spinbutton_large_step_home_end_single_tab" {
  let qty = signals::signal(50.0)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = number_field_node(
      root,
      view::Live::By(fn() -> Double { qty.get() }),
      fn(v : Double) -> Unit { qty.set(v) },
      label=view::Live::Is("Amount"),
      min=0.0,
      max=100.0,
      step=1.0,
      large_step=10.0,
      precision=2,
    )
  }, width=600.0, height=240.0)

  let tr = b_unwrap_tree(tree_ref.v)
  let spin_id = match b_find_said(tr, view::Role::SpinButton, "Amount") {
    Some(sn) => {
      match sn.said {
        Some(sd) => {
          let range_ok = match sd.range {
            Some((lo, cur, hi)) => lo == 0.0 && cur == 50.0 && hi == 100.0
            None => false
          }
          b_assert(range_ok, "SpinButton must expose value range (0, 50, 100)")
          b_assert(b_said_has_action(sd.actions, "Increment"), "SpinButton must expose Increment action")
          b_assert(b_said_has_action(sd.actions, "Decrement"), "SpinButton must expose Decrement action")
          b_assert(b_said_has_action(sd.actions, "SetText"), "SpinButton must expose SetText action")
        }
        None => halt::saying("b_test", "missing SpinButton said")
      }
      // Focus real editor by clicking center of SpinButton
      let (rx, ry, rw, rh) = sn.rect
      t.click(rx + rw * 0.5, ry + rh * 0.5)
      t.frame()
      sn.id
    }
    None => halt::saying("b_test", "NumberField must expose Role::SpinButton")
  }

  // Up / Down / PageUp (large_step) / PageDown / Home / End
  t.key(headless_core::key_up)
  t.frame()
  b_assert(qty.get() == 51.0, "ArrowUp must increment by step=1")
  t.key(headless_core::key_down)
  t.frame()
  b_assert(qty.get() == 50.0, "ArrowDown must decrement by step=1")
  t.key(headless_core::key_page_up)
  t.frame()
  b_assert(qty.get() == 60.0, "PageUp must increment by large_step=10")
  t.key(headless_core::key_page_down)
  t.frame()
  b_assert(qty.get() == 50.0, "PageDown must decrement by large_step=10")
  t.key(headless_core::key_home)
  t.frame()
  b_assert(qty.get() == 0.0, "Home must jump to min=0")
  t.key(headless_core::key_end)
  t.frame()
  b_assert(qty.get() == 100.0, "End must jump to max=100")

  // Single Tab stop: entire NumberField has exactly 1 focusable node (neither +/- button is focusable)
  b_assert(tr.focus_order().length() == 1, "NumberField must have exactly 1 Tab stop")
  t.key(headless_core::key_tab)
  t.frame()
  let (focused_now, _) = tr.focused_now()
  let is_spin = match focused_now {
    Some(id) => id == spin_id
    None => false
  }
  b_assert(is_spin, "NumberField Tab must stay on the single SpinButton")
  t.dispose()
}

test "b_r2_field_bg_auto_vs_secondary_across_surfaces_light_and_dark" {
  let check_theme = fn(dark : Bool) -> Unit {
    let pal = aura_theme_from(if dark { AuraConfig::dark() } else { AuraConfig::light() }).palette
    let got_root_auto = signals::signal(0L)
    let got_primary_auto = signals::signal(0L)
    let got_primary_sec = signals::signal(0L)
    let got_secondary_auto = signals::signal(0L)
    let got_tertiary_auto = signals::signal(0L)
    let got_overlay_auto = signals::signal(0L)
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      let _ = b_setup_aura_tree(root, dark=dark)
      let _ = root.box(fn(v : view::View) -> Unit {
        got_root_auto.set(b_field_variant_bg(v, pal, AuraFieldVariant::Auto, false, false, false))
      })
      let _ = surface_node(root, variant=AuraSurfaceVariant::Default, content=fn(sv : view::View) -> Unit {
        got_primary_auto.set(b_field_variant_bg(sv, pal, AuraFieldVariant::Auto, false, false, false))
        got_primary_sec.set(b_field_variant_bg(sv, pal, AuraFieldVariant::Secondary, false, false, false))
      })
      let _ = surface_node(root, variant=AuraSurfaceVariant::Secondary, content=fn(sv : view::View) -> Unit {
        got_secondary_auto.set(b_field_variant_bg(sv, pal, AuraFieldVariant::Auto, false, false, false))
      })
      let _ = surface_node(root, variant=AuraSurfaceVariant::Tertiary, content=fn(sv : view::View) -> Unit {
        got_tertiary_auto.set(b_field_variant_bg(sv, pal, AuraFieldVariant::Auto, false, false, false))
      })
      let _ = w0_popover_shell(root, content=fn(ov : view::View) -> Unit {
        got_overlay_auto.set(b_field_variant_bg(ov, pal, AuraFieldVariant::Auto, false, false, false))
      })
    }, width=600.0, height=400.0)
    b_assert(got_root_auto.get() == pal.field_background, "Auto outside surface must use field_background")
    b_assert(got_primary_auto.get() == pal.surface_secondary, "Auto on Primary must use surface_secondary")
    b_assert(got_primary_sec.get() == pal.default_bg, "Explicit Secondary on Primary must use default_bg")
    b_assert(got_secondary_auto.get() == pal.surface_tertiary, "Auto on Secondary must use surface_tertiary")
    b_assert(got_tertiary_auto.get() == pal.surface_tertiary, "Auto on Tertiary must use surface_tertiary")
    b_assert(got_overlay_auto.get() == pal.surface_secondary, "Auto on Overlay must use surface_secondary")
    t.dispose()
  }
  check_theme(false)
  check_theme(true)
}

test "b_r2_range_slider_zero_drift_and_proportional_marks" {
  let lo = signals::signal(0.0)
  let hi = signals::signal(100.0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = root.box(fn(box100 : view::View) -> Unit {
      let _ = box100.width(view::Live::Is(Some(100.0)))
      let _ = range_slider_node(
        box100,
        view::Live::By(fn() -> Double { lo.get() }),
        view::Live::By(fn() -> Double { hi.get() }),
        fn(a : Double, b : Double) -> Unit { lo.set(a); hi.set(b) },
        label=view::Live::Is("Span"),
        min=0.0,
        max=100.0,
        step=1.0,
        marks=[
          AuraSliderMark::{ value: 0.0, label: "M0" },
          AuraSliderMark::{ value: 10.0, label: "M10" },
          AuraSliderMark::{ value: 100.0, label: "M100" },
        ],
      )
    })
  }, width=300.0, height=200.0)

  // Press exact center of low thumb (val=0) with zero movement -> must stay 0.0 (zero drift)
  match b_find_agent(t, view::Role::Slider, "Minimum") {
    Some(e) => {
      let (rx, ry, rw, rh) = e.rect
      let cx = rx + rw * 0.5
      let cy = ry + rh * 0.5
      t.press_at(cx, cy)
      t.release(cx, cy)
      t.frame()
      b_assert(lo.get() == 0.0, "pressing low thumb center must have zero drift")
    }
    None => halt::saying("b_test", "missing Minimum thumb")
  }
  // Press exact center of high thumb (val=100) with zero movement -> must stay 100.0 (zero drift)
  match b_find_agent(t, view::Role::Slider, "Maximum") {
    Some(e) => {
      let (rx, ry, rw, rh) = e.rect
      let cx = rx + rw * 0.5
      let cy = ry + rh * 0.5
      t.press_at(cx, cy)
      t.release(cx, cy)
      t.frame()
      b_assert(hi.get() == 100.0, "pressing high thumb center must have zero drift")
    }
    None => halt::saying("b_test", "missing Maximum thumb")
  }
  // Drag low thumb to exact midpoint of the 100pt box (x = 20 + 50 = 70) -> must equal 50.0
  match b_find_agent(t, view::Role::Slider, "Minimum") {
    Some(e) => {
      let (rx, ry, rw, rh) = e.rect
      let cx = rx + rw * 0.5
      let cy = ry + rh * 0.5
      t.press_at(cx, cy)
      t.move_to(70.0, cy)
      t.release(70.0, cy)
      t.frame()
      b_assert(lo.get() == 50.0, "dragging low thumb to 50% midpoint must set value to 50")
    }
    None => halt::saying("b_test", "missing Minimum thumb for drag")
  }
  // Marks 0, 10, 100 must be positioned proportionally (M10 much closer to M0 than M100)
  match (t.find("M0"), t.find("M10"), t.find("M100")) {
    (Some((x0, _)), Some((x10, _)), Some((x100, _))) => {
      let span = x100 - x0
      b_assert(span > 20.0, "marks span must be positive")
      b_assert((x10 - x0) < span * 0.35, "mark 10 must be positioned near 10%, not 50% space-between")
    }
    _ => halt::saying("b_test", "missing range slider mark labels")
  }
  t.dispose()
}

test "b_r2_switch_clips_and_reactive_disabled_selection_labels" {
  let cb_lbl = signals::signal("")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    let _ = checkbox_node(
      root,
      label=view::Live::By(fn() -> String { cb_lbl.get() }),
      disabled=view::Live::Is(true),
      description=view::Live::Is("Disabled cb desc"),
    )
    let _ = radio_node(
      root,
      "r1",
      label=view::Live::Is("Disabled radio"),
      disabled=view::Live::Is(true),
      description=view::Live::Is("Disabled radio desc"),
    )
    let _ = switch_node(
      root,
      view::Live::Is(true),
      fn(_) { () },
      label=view::Live::Is("Clipped switch"),
      disabled=view::Live::Is(true),
      force_focus_visible=true,
    )
  }, width=600.0, height=400.0)
  b_assert(!b_has_text(t, "Dynamic CB"), "empty checkbox label should not render")
  cb_lbl.set("Dynamic CB")
  t.frame()
  b_assert(b_has_text(t, "Dynamic CB"), "reactive checkbox label must appear when non-empty")
  assert_aura_ui(t, label="b_r2_switch_clips_and_disabled_labels")
  t.dispose()
}

fn b_text_x(t : ui::Tester, s : String) -> Double {
  for d in t.drawn() {
    if d.words == s {
      return d.x
    }
  }
  -1.0
}

test "b_r4_rtl_input_group_zero_focus_jump_and_ime" {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let fld = ui::Field::new(text="invar.dev")
  let pref_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let suff_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let inp_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(20.0)).width(view::Live::Is(Some(500.0)))
    let _ = input_group_node(root, full_width=true, content=fn(g : view::View) -> Unit {
      pref_ref.v = Some(input_group_prefix_node(g, text=view::Live::Is("https://")))
      inp_ref.v = Some(input_group_input_node(g, field=fld, label="Domain", has_prefix=true, has_suffix=true))
      suff_ref.v = Some(input_group_suffix_node(g, text=view::Live::Is(".org")))
    })
  }, width=540.0, height=120.0)
  t.frame()

  let vrect = fn(r : signals::Ref[Option[view::View]]) -> (Double, Double, Double, Double) {
    match r.v { Some(v) => v.rect(); None => (0.0, 0.0, 0.0, 0.0) }
  }
  let (px0, _, pw0, _) = vrect(pref_ref)
  let (sx0, _, sw0, _) = vrect(suff_ref)
  let (ix0, iy0, iw0, ih0) = vrect(inp_ref)

  // Measure glyph x range inside input_group_input_node before focus
  let glyph_min_x = fn() -> Double {
    let sc = t.scene()
    let mut mn = 1.0e9
    let mut k = 0
    while k < sc.ninst {
      let b = k * ui::inst_size
      let kind = sc.inst[b + 5]
      let gx = sc.inst[b]
      if (kind == 1.0 || kind == 3.0) && gx >= ix0 && gx <= ix0 + iw0 {
        if gx < mn { mn = gx }
      }
      k += 1
    }
    mn
  }
  let x_unfocused = glyph_min_x()
  b_assert(x_unfocused < 1.0e8 && x_unfocused > ix0 + iw0 * 0.5, "unfocused RTL InputGroupInput must right-align 'invar.dev' (x=\{x_unfocused})")

  // 1) Click to focus -> ZERO horizontal jump (<= 0.5pt = 1px @ 2x)
  t.tap(ix0 + iw0 - 10.0, iy0 + ih0 * 0.5)
  t.frame(ms=16.0)
  b_assert(fld.focused(), "clicking RTL InputGroupInput must focus field")
  let x_clicked = glyph_min_x()
  b_assert(dmath::abs(x_clicked - x_unfocused) <= 0.5, "click-focus must not jump RTL text (unfocused=\{x_unfocused}, clicked=\{x_clicked})")
  // Prefix & suffix stay fixed
  b_assert(dmath::abs(vrect(pref_ref).0 - px0) <= 0.01 && dmath::abs(vrect(pref_ref).2 - pw0) <= 0.01, "prefix must stay fixed")
  b_assert(dmath::abs(vrect(suff_ref).0 - sx0) <= 0.01 && dmath::abs(vrect(suff_ref).2 - sw0) <= 0.01, "suffix must stay fixed")

  // 2) Blur & Tab-focus -> ZERO horizontal jump
  fld.let_go()
  t.frame(ms=32.0)
  let x_blurred = glyph_min_x()
  b_assert(dmath::abs(x_blurred - x_unfocused) <= 0.5, "blur must not jump RTL text (unfocused=\{x_unfocused}, blurred=\{x_blurred})")
  t.key(headless_core::key_tab)
  t.frame(ms=48.0)
  b_assert(fld.focused(), "Tab must focus RTL InputGroupInput")
  let x_tabbed = glyph_min_x()
  b_assert(dmath::abs(x_tabbed - x_unfocused) <= 0.5, "Tab-focus must not jump RTL text (unfocused=\{x_unfocused}, tabbed=\{x_tabbed})")

  // 3) Caret, selection & IME preedit stay right-aligned
  fld.pick(6, 9)
  t.frame(ms=64.0)
  let srects = fld.selection_rects()
  b_assert(srects.length() == 1 && srects[0].x > iw0 * 0.5, "RTL selection rect must stay right-aligned")
  fld.compose("x")
  t.frame(ms=80.0)
  let cp = fld.caret_pos()
  b_assert(cp.x > iw0 * 0.5, "RTL IME caret must stay right-aligned (cp.x=\{cp.x})")
  t.dispose()
}

test "b_r4_rtl_slider_range_slider_and_non_uniform_marks" {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let sval = signals::signal(80.0)
  let lo = signals::signal(20.0)
  let hi = signals::signal(70.0)
  let marks = [
    AuraSliderMark::{ value: 0.0, label: "M0" },
    AuraSliderMark::{ value: 10.0, label: "M10" },
    AuraSliderMark::{ value: 85.0, label: "M85" },
    AuraSliderMark::{ value: 100.0, label: "M100" },
  ]

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(20.0)).gap(view::Live::Is(24.0)).width(view::Live::Is(Some(340.0)))
    let _ = slider_node(
      root,
      view::Live::By(fn() { sval.get() }),
      fn(v) { sval.set(v) },
      label=view::Live::Is("RTL Volume"),
      min=0.0,
      max=100.0,
      step=1.0,
      marks=marks,
    )
    let _ = range_slider_node(
      root,
      view::Live::By(fn() { lo.get() }),
      view::Live::By(fn() { hi.get() }),
      fn(a, b) { lo.set(a); hi.set(b) },
      label=view::Live::Is("RTL Price"),
      low_label="Min Price",
      high_label="Max Price",
      min=0.0,
      max=100.0,
      step=5.0,
    )
  }, width=400.0, height=320.0)
  t.frame()

  // 1) Non-uniform marks in RTL: M100 < M85 < M10 < M0 visually left-to-right
  let x_m0 = b_text_x(t, "M0")
  let x_m10 = b_text_x(t, "M10")
  let x_m85 = b_text_x(t, "M85")
  let x_m100 = b_text_x(t, "M100")
  b_assert(x_m100 < x_m85 && x_m85 < x_m10 && x_m10 < x_m0, "RTL non-uniform marks must order M100 < M85 < M10 < M0 (got \{x_m100}, \{x_m85}, \{x_m10}, \{x_m0})")

  // 2) RTL single Slider (0-100, initial 80):
  //    Click visual left => 100; click visual right => 0; Right-Arrow decreases; Left-Arrow increases
  match t.get("RTL Volume", role=view::Role::Slider) {
    Some(sd) => {
      let sx = sd.x
      let sy = sd.y
      let sw = sd.w
      let sh = sd.h
      // Visual left end (inside thumb_room margin) -> max (100)
      t.tap(sx + 12.0, sy + sh * 0.5)
      t.frame(ms=16.0)
      b_assert(sval.get() == 100.0, "RTL slider click visual left must give 100, got \{sval.get()}")
      // Right-Arrow decreases in RTL (100 -> 99)
      t.key(headless_core::key_right)
      t.frame(ms=32.0)
      b_assert(sval.get() == 99.0, "RTL slider Right-Arrow must decrease (100 -> 99), got \{sval.get()}")
      // Left-Arrow increases in RTL (99 -> 100)
      t.key(headless_core::key_left)
      t.frame(ms=48.0)
      b_assert(sval.get() == 100.0, "RTL slider Left-Arrow must increase (99 -> 100), got \{sval.get()}")
      // Visual right end -> min (0)
      t.tap(sx + sw - 12.0, sy + sh * 0.5)
      t.frame(ms=64.0)
      b_assert(sval.get() == 0.0, "RTL slider click visual right must give 0, got \{sval.get()}")
    }
    None => b_assert(false, "missing RTL Volume slider")
  }

  // 3) RTL RangeSlider: high thumb is visually LEFT of low thumb; Left-Arrow increases, Right-Arrow decreases
  let (lo_x, lo_y, lo_w, lo_h) = match t.get("Min Price", role=view::Role::Slider) { Some(d) => (d.x, d.y, d.w, d.h); None => { b_assert(false, "missing Min Price"); (0.0, 0.0, 0.0, 0.0) } }
  let (hi_x, hi_y, hi_w, hi_h) = match t.get("Max Price", role=view::Role::Slider) { Some(d) => (d.x, d.y, d.w, d.h); None => { b_assert(false, "missing Max Price"); (0.0, 0.0, 0.0, 0.0) } }
  b_assert(hi_x < lo_x, "RTL RangeSlider: High thumb (70) must be visually left of Low thumb (20) (hi_x=\{hi_x}, lo_x=\{lo_x})")

  // Focus High thumb and test Left-Arrow (increases 70 -> 75) & Right-Arrow (decreases 75 -> 70)
  match (ui::view_tree(), t.get("Max Price", role=view::Role::Slider)) {
    (Some(tr), Some(d)) => { let _ = tr.focus_to(Some(d.id), visible=true) }
    _ => b_assert(false, "missing Max Price node")
  }
  t.frame(ms=96.0)
  let hi_before = hi.get()
  t.key(headless_core::key_left)
  t.frame(ms=112.0)
  b_assert(hi.get() == hi_before + 5.0, "RTL RangeSlider High Left-Arrow must increase by 5 (before=\{hi_before}, after=\{hi.get()})")
  t.key(headless_core::key_right)
  t.frame(ms=128.0)
  b_assert(hi.get() == hi_before, "RTL RangeSlider High Right-Arrow must decrease by 5")

  // Drag Low thumb rightward (toward min=0 in RTL)
  let lo_before = lo.get()
  t.drag(lo_x + lo_w * 0.5, lo_y + lo_h * 0.5, lo_x + lo_w * 0.5 + 40.0, lo_y + lo_h * 0.5)
  t.frame(ms=144.0)
  b_assert(lo.get() < lo_before, "RTL RangeSlider dragging Low thumb right must decrease low (before=\{lo_before}, after=\{lo.get()})")
  t.dispose()
}

test "b_r5_3_pointer_tap_input_group_rtl_ltr_readonly_and_disabled" {
  // 1) RTL InputGroup with prefix/suffix: tap left/mid/right sets caret matching hit_test
  let cfg_rtl = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let fld_rtl = ui::Field::new(text="invar.dev")
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg_rtl)
    let _ = root.pad(view::Live::Is(20.0)).width(view::Live::Is(Some(460.0)))
    let _ = input_group_node(root, full_width=true, content=fn(g : view::View) -> Unit {
      let _ = input_group_prefix_node(g, text=view::Live::Is("https://"))
      let _ = input_group_input_node(g, field=fld_rtl, label="RTL Domain", has_prefix=true, has_suffix=true)
      let _ = input_group_suffix_node(g, text=view::Live::Is(".org"))
    })
  }, width=500.0, height=120.0)
  t1.frame()
  fld_rtl.pick(0, 0)
  let rx_right = fld_rtl.last_max_w - 2.0
  let exp_r = fld_rtl.hit_test(rx_right, 10.0)
  t1.tap(fld_rtl.last_win_x + rx_right, fld_rtl.last_win_y + 10.0)
  t1.frame(ms=16.0)
  let (rr0, rr1) = fld_rtl.selection()
  b_assert(fld_rtl.focused() && rr0 == exp_r && rr1 == exp_r && exp_r == 9, "RTL InputGroup right tap must set (9,9), got (\{rr0},\{rr1})")
  let rx_left = 2.0
  let exp_l = fld_rtl.hit_test(rx_left, 10.0)
  t1.tap(fld_rtl.last_win_x + rx_left, fld_rtl.last_win_y + 10.0)
  t1.frame(ms=32.0)
  let (rl0, rl1) = fld_rtl.selection()
  b_assert(rl0 == exp_l && rl1 == exp_l && exp_l == 0, "RTL InputGroup left tap must set (0,0), got (\{rl0},\{rl1})")
  t1.dispose()

  // 2) LTR InputGroup + read_only + disabled
  let fld_ltr = ui::Field::new(text="invar.dev")
  let fld_ro = ui::Field::new(text="readonly")
  let fld_dis = ui::Field::new(text="disabled")
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = b_setup_aura_tree(root)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0)).width(view::Live::Is(Some(460.0)))
    let _ = input_group_node(root, full_width=true, content=fn(g : view::View) -> Unit {
      let _ = input_group_prefix_node(g, text=view::Live::Is("https://"))
      let _ = input_group_input_node(g, field=fld_ltr, label="LTR Domain", has_prefix=true, has_suffix=true)
      let _ = input_group_suffix_node(g, text=view::Live::Is(".org"))
    })
    let _ = input_node(root, field=fld_ro, label="RO Field", read_only=view::Live::Is(true))
    let _ = input_node(root, field=fld_dis, label="Disabled Field", disabled=view::Live::Is(true))
  }, width=500.0, height=240.0)
  t2.frame()

  // LTR tap right edge -> 9; tap left -> 0
  fld_ltr.pick(0, 0)
  t2.tap(fld_ltr.last_win_x + fld_ltr.last_max_w - 4.0, fld_ltr.last_win_y + 10.0)
  t2.frame(ms=16.0)
  let (lt0, lt1) = fld_ltr.selection()
  b_assert(fld_ltr.focused() && lt0 == 9 && lt1 == 9, "LTR InputGroup right tap must set (9,9), got (\{lt0},\{lt1})")

  // read_only: tap focuses and moves caret, but typing does not change text
  fld_ro.pick(0, 0)
  t2.tap(fld_ro.last_win_x + fld_ro.last_max_w - 4.0, fld_ro.last_win_y + 10.0)
  t2.frame(ms=32.0)
  let (ro0, ro1) = fld_ro.selection()
  b_assert(fld_ro.focused() && ro0 == 8 && ro1 == 8, "read_only tap must focus and move caret to (8,8), got (\{ro0},\{ro1})")
  t2.type_text("XYZ")
  t2.frame(ms=48.0)
  b_assert(fld_ro.text() == "readonly", "read_only field must reject text edits, got '\{fld_ro.text()}'")

  // disabled: tap must NOT focus and must NOT change selection
  fld_dis.pick(0, 0)
  t2.tap(fld_dis.last_win_x + fld_dis.last_max_w - 4.0, fld_dis.last_win_y + 10.0)
  t2.frame(ms=64.0)
  let (ds0, ds1) = fld_dis.selection()
  b_assert(!fld_dis.focused() && ds0 == 0 && ds1 == 0, "disabled field tap must neither focus nor move caret")
  t2.dispose()
}

test "b_r5_5_switch_track_color_smooth_transition_and_reduced_motion" {
  // Helper to read the Switch inner track's drawn ground color (40x20 rounded pill)
  let track_ground = fn(t : ui::Tester) -> Int64 {
    for d in t.drawn() {
      if dmath::abs(d.w - 40.0) < 0.5 && dmath::abs(d.h - 20.0) < 0.5 && d.ground != 0L {
        return d.ground
      }
    }
    0L
  }
  let ch_r = fn(c : Int64) -> Int { ((c >> 24) & 0xFFL).to_int() }
  let ch_g = fn(c : Int64) -> Int { ((c >> 16) & 0xFFL).to_int() }
  let ch_b = fn(c : Int64) -> Int { ((c >> 8) & 0xFFL).to_int() }

  let on_sig = signals::signal(false)
  let cfg = signals::signal(AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = switch_node(
      root,
      view::Live::By(fn() -> Bool { on_sig.get() }),
      fn(v : Bool) -> Unit { on_sig.set(v) },
      label=view::Live::Is("Notify"),
    )
  }, width=300.0, height=100.0)
  t.frame(ms=0.0)
  let pal = aura_theme_from(AuraConfig::light()).palette
  let c_off = track_ground(t)
  b_assert(c_off == pal.default_bg, "OFF switch track must equal default_bg (got \{c_off}, exp \{pal.default_bg})")

  // Toggle ON and advance 48ms: track color must be smoothly mid-way (strictly between OFF and ON, NOT jumped to accent)
  on_sig.set(true)
  t.frame(ms=16.0)
  t.frame(ms=32.0)
  t.frame(ms=48.0)
  let c_mid = track_ground(t)
  b_assert(c_mid != pal.default_bg && c_mid != pal.accent, "48ms switch track must be intermediate color, not endpoint")
  b_assert(ch_r(c_mid) < ch_r(c_off) && ch_r(c_mid) > ch_r(pal.accent), "48ms R channel must interpolate monotonically (off=\{ch_r(c_off)}, mid=\{ch_r(c_mid)}, on=\{ch_r(pal.accent)})")
  b_assert(ch_g(c_mid) < ch_g(c_off) && ch_g(c_mid) > ch_g(pal.accent), "48ms G channel must interpolate monotonically")
  b_assert(ch_b(c_mid) >= ch_b(c_off) && ch_b(c_mid) <= ch_b(pal.accent), "48ms B channel must interpolate monotonically")

  // Advance to settled 600ms: must converge exactly to pal.accent
  t.frame(ms=600.0)
  let c_on = track_ground(t)
  b_assert(c_on == pal.accent, "600ms settled switch track must equal accent (got \{c_on}, exp \{pal.accent})")
  t.dispose()

  // reduced_motion=true: track snaps immediately to pal.accent on toggle
  let on_rm = signals::signal(false)
  let cfg_rm = signals::signal(AuraConfig::{ ..AuraConfig::light(), reduced_motion: true })
  let t_rm = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg_rm)
    let _ = root.pad(view::Live::Is(20.0))
    let _ = switch_node(
      root,
      view::Live::By(fn() -> Bool { on_rm.get() }),
      fn(v : Bool) -> Unit { on_rm.set(v) },
      label=view::Live::Is("Notify RM"),
    )
  }, width=300.0, height=100.0)
  t_rm.frame(ms=0.0)
  b_assert(track_ground(t_rm) == pal.default_bg, "RM OFF must be default_bg")
  on_rm.set(true)
  t_rm.frame(ms=16.0)
  b_assert(track_ground(t_rm) == pal.accent, "reduced_motion=true must snap track immediately to accent")
  t_rm.dispose()
}

test "b_w2r2_rtl_mirroring_checkbox_radio_switch_group_meter_avatar_swatch" {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(14.0))
    let _ = checkbox_node(
      root,
      checked=view::Live::Is(true),
      on_change=fn(_b) { () },
      label=view::Live::Is("CBLabel"),
      description=view::Live::Is("CBDesc"),
    )
    let _ = radio_node(
      root,
      "opt1",
      label=view::Live::Is("RDLabel"),
      selected=view::Live::Is(true),
      description=view::Live::Is("RDDesc"),
    )
    let _ = switch_group_node(
      root,
      label=view::Live::Is("SWGroup"),
      orientation=AuraOrientation::Horizontal,
      content=fn(sg : view::View) -> Unit {
        let _ = switch_node(sg, view::Live::Is(true), fn(_b) { () }, label=view::Live::Is("SWFirst"))
        let _ = switch_node(sg, view::Live::Is(false), fn(_b) { () }, label=view::Live::Is("SWSecond"))
      },
    )
    let _ = meter_node(root, view::Live::Is(75.0), label=view::Live::Is("MeterLbl"))
    let _ = avatar_group_node(
      root,
      [AuraAvatarItem::new("AA"), AuraAvatarItem::new("BB")],
    )
    let _ = color_swatch_picker_node(
      root,
      ["#112233", "#445566"],
      fn() { Some("#112233") },
      fn(_h) { () },
    )
  }, width=360.0, height=500.0)
  t.frame()
  let find_words_rect = fn(txt : String) -> Option[(Double, Double, Double, Double)] {
    for d in t.drawn() {
      if d.words == txt {
        return Some((d.x, d.y, d.w, d.h))
      }
    }
    None
  }
  // 1) Checkbox: in RTL, label sits to the LEFT of the 16pt box with >= 11pt gap; description aligns left of box
  let (cbl_x, cbl_y, cbl_w, _) = match find_words_rect("CBLabel") { Some(r) => r; None => { b_assert(false, "missing CBLabel"); return } }
  let (cbd_x, _, cbd_w, _) = match find_words_rect("CBDesc") { Some(r) => r; None => { b_assert(false, "missing CBDesc"); return } }
  let mut cb_box_x = -1.0
  for d in t.drawn() {
    if dmath::abs(d.w - 16.0) < 0.5 && dmath::abs(d.h - 16.0) < 0.5 && dmath::abs(d.y - cbl_y) < 12.0 {
      cb_box_x = d.x
      break
    }
  }
  b_assert(cb_box_x > 0.0 && cbl_x + cbl_w + 11.0 <= cb_box_x, "RTL Checkbox label must sit >=12pt left of 16pt box: lbl=(\{cbl_x},\{cbl_w}) box_x=\{cb_box_x}")
  b_assert(cbd_x + cbd_w <= cb_box_x - 10.0, "RTL Checkbox description must align under label left of box: desc_r=\{cbd_x + cbd_w} box_x=\{cb_box_x}")

  // 2) Radio: in RTL, label sits to the LEFT of the 16pt circle with >= 11pt gap; description indents on right
  let (rdl_x, rdl_y, rdl_w, _) = match find_words_rect("RDLabel") { Some(r) => r; None => { b_assert(false, "missing RDLabel"); return } }
  let (rdd_x, _, rdd_w, _) = match find_words_rect("RDDesc") { Some(r) => r; None => { b_assert(false, "missing RDDesc"); return } }
  let mut rd_box_x = -1.0
  for d in t.drawn() {
    if dmath::abs(d.w - 16.0) < 0.5 && dmath::abs(d.h - 16.0) < 0.5 && dmath::abs(d.y - rdl_y) < 12.0 {
      rd_box_x = d.x
      break
    }
  }
  b_assert(rd_box_x > 0.0 && rdl_x + rdl_w + 11.0 <= rd_box_x, "RTL Radio label must sit >=12pt left of 16pt circle: lbl=(\{rdl_x},\{rdl_w}) box_x=\{rd_box_x}")
  b_assert(rdd_x + rdd_w <= rd_box_x - 10.0, "RTL Radio description must indent on right under label: desc_r=\{rdd_x + rdd_w} box_x=\{rd_box_x}")

  // 3) Horizontal SwitchGroup: in RTL, SWFirst sits to the RIGHT of SWSecond
  let (sw1_x, _, _, _) = match find_words_rect("SWFirst") { Some(r) => r; None => { b_assert(false, "missing SWFirst"); return } }
  let (sw2_x, _, _, _) = match find_words_rect("SWSecond") { Some(r) => r; None => { b_assert(false, "missing SWSecond"); return } }
  b_assert(sw1_x > sw2_x, "RTL SwitchGroup must mirror item order (SWFirst right of SWSecond): \{sw1_x} vs \{sw2_x}")

  // 4) Meter: in RTL, label sits to the RIGHT of output value (75%)
  let (ml_x, _, _, _) = match find_words_rect("MeterLbl") { Some(r) => r; None => { b_assert(false, "missing MeterLbl"); return } }
  let (mv_x, _, _, _) = match find_words_rect("75%") { Some(r) => r; None => { b_assert(false, "missing 75%"); return } }
  b_assert(ml_x > mv_x, "RTL Meter header must put label right of value: \{ml_x} vs \{mv_x}")

  // 5) AvatarGroup: in RTL, AA sits to the RIGHT of BB
  let (aa_x, _, _, _) = match find_words_rect("AA") { Some(r) => r; None => { b_assert(false, "missing AA"); return } }
  let (bb_x, _, _, _) = match find_words_rect("BB") { Some(r) => r; None => { b_assert(false, "missing BB"); return } }
  b_assert(aa_x > bb_x, "RTL AvatarGroup must mirror order (AA right of BB): \{aa_x} vs \{bb_x}")

  // 6) ColorSwatchPicker: in RTL, first swatch (#112233) sits to the RIGHT of second swatch (#445566)
  let mut sw_a_x = -1.0
  let mut sw_b_x = -1.0
  for d in t.drawn() {
    if d.ground == 0x112233FFL { sw_a_x = d.x }
    if d.ground == 0x445566FFL { sw_b_x = d.x }
  }
  b_assert(sw_a_x > 0.0 && sw_b_x > 0.0 && sw_a_x > sw_b_x, "RTL ColorSwatchPicker must mirror swatch order: #112233 x=\{sw_a_x} vs #445566 x=\{sw_b_x}")

  assert_aura_ui(t, label="b_w2r2_rtl_mirroring")
  t.dispose()
}

test "b_w2r4_checkbox_radio_group_full_row_hit_width_ltr_and_rtl" {
  for is_rtl in [false, true] {
    let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: is_rtl })
    let cb_on = signals::signal(false)
    let rd_val = signals::signal("a")
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      let _ = aura_provide_config(root, cfg)
      let _ = root.ground(view::Live::By(fn() -> Int64 { aura_theme(root).palette.background }))
      let _ = checkbox_group_node(
        root,
        label=view::Live::Is("GroupCBTitle"),
        gap=8.0,
        content=fn(cg : view::View) -> Unit {
          let _ = checkbox_node(cg, label=view::Live::Is("OptCB"), checked=view::Live::By(fn() -> Bool { cb_on.get() }), on_change=fn(v : Bool) -> Unit { cb_on.set(v) })
        },
      )
      let _ = radio_group_node(
        root,
        view::Live::By(fn() -> String { rd_val.get() }),
        fn(v : String) -> Unit { rd_val.set(v) },
        label=view::Live::Is("GroupRDTitle"),
        gap=8.0,
        content=fn(rg : view::View) -> Unit {
          let _ = radio_node(rg, "a", label=view::Live::Is("OptRD"))
        },
      )
    }, width=600.0, height=300.0)
    t.run_shown(200.0)
    let cb = match t.get("OptCB", role=view::Role::Checkbox) {
      Some(d) => d
      None => { b_assert(false, "missing OptCB"); return }
    }
    let rd = match t.get("OptRD", role=view::Role::Radio) {
      Some(d) => d
      None => { b_assert(false, "missing OptRD"); return }
    }
    b_assert(cb.w >= 599.0, "Checkbox inside 600pt group must span full row width (rtl=\{is_rtl}), got w=\{cb.w}")
    b_assert(rd.w >= 599.0, "Radio inside 600pt group must span full row width (rtl=\{is_rtl}), got w=\{rd.w}")
    if is_rtl {
      let mut cb_title_r = -1.0
      let mut rd_title_r = -1.0
      for d in t.drawn() {
        if d.words == "GroupCBTitle" { cb_title_r = d.x + d.w }
        if d.words == "GroupRDTitle" { rd_title_r = d.x + d.w }
      }
      b_assert(cb_title_r >= 598.0, "RTL CheckboxGroup title must align to right edge, got r=\{cb_title_r}")
      b_assert(rd_title_r >= 598.0, "RTL RadioGroup title must align to right edge, got r=\{rd_title_r}")
    }
    t.dispose()
  }
}

test "b_w2r5_rtl_switch_description_alignment_and_hit_width" {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let sw_norm = signals::signal(true)
  let sw_stack = signals::signal(true)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::By(fn() -> Int64 { aura_theme(root).palette.background }))
    let _ = switch_group_node(
      root,
      label=view::Live::Is("GroupSWTitle"),
      description=view::Live::Is("GroupSWDesc"),
      orientation=AuraOrientation::Vertical,
      gap=12.0,
      item_gap=12.0,
      content=fn(sg : view::View) -> Unit {
        let _ = switch_node(
          sg,
          view::Live::By(fn() -> Bool { sw_norm.get() }),
          fn(v : Bool) -> Unit { sw_norm.set(v) },
          label=view::Live::Is("SwitchNorm"),
          description=view::Live::Is("NormHelper"),
        )
        let _ = switch_node(
          sg,
          view::Live::By(fn() -> Bool { sw_stack.get() }),
          fn(v : Bool) -> Unit { sw_stack.set(v) },
          label=view::Live::Is("SwitchStack"),
          description=view::Live::Is("StackHelper"),
          stacked=true,
        )
      },
    )
  }, width=390.0, height=300.0)
  t.run_shown(200.0)

  let s1 = match t.get("SwitchNorm", role=view::Role::Switch) {
    Some(d) => d
    None => { b_assert(false, "missing SwitchNorm"); return }
  }
  let s2 = match t.get("SwitchStack", role=view::Role::Switch) {
    Some(d) => d
    None => { b_assert(false, "missing SwitchStack"); return }
  }
  b_assert(s1.w >= 389.0, "RTL Switch inside vertical group must span full row width (390pt), got w=\{s1.w}")
  b_assert(s2.w >= 389.0, "RTL stacked Switch inside vertical group must span full row width (390pt), got w=\{s2.w}")

  let mut norm_desc_x = -1.0
  let mut norm_desc_r = -1.0
  let mut stack_desc_x = -1.0
  let mut stack_desc_r = -1.0
  let mut grp_title_r = -1.0
  let mut grp_desc_r = -1.0
  for d in t.drawn() {
    if d.words == "NormHelper" { norm_desc_x = d.x; norm_desc_r = d.x + d.w }
    if d.words == "StackHelper" { stack_desc_x = d.x; stack_desc_r = d.x + d.w }
    if d.words == "GroupSWTitle" { grp_title_r = d.x + d.w }
    if d.words == "GroupSWDesc" { grp_desc_r = d.x + d.w }
  }
  // Md switch track is 40pt + 12pt gap = 52pt right indent -> right edge ~338pt (must stay on right side, not x~0)
  b_assert(norm_desc_x > 200.0 && norm_desc_r >= 330.0 && norm_desc_r <= 345.0, "RTL normal Switch description must align on right side under label: x=\{norm_desc_x}, r=\{norm_desc_r}")
  b_assert(stack_desc_x > 250.0 && stack_desc_r >= 388.0, "RTL stacked Switch description must align to right edge: x=\{stack_desc_x}, r=\{stack_desc_r}")
  b_assert(grp_title_r >= 388.0 && grp_desc_r >= 388.0, "RTL SwitchGroup title/desc must align to right edge: title_r=\{grp_title_r}, desc_r=\{grp_desc_r}")

  // Far-left click on full-row RTL switch toggles state
  t.tap(4.0, s1.y + s1.h * 0.5)
  t.run_shown(100.0)
  b_assert(!sw_norm.untracked(), "clicking far left (x=4) of RTL Switch full row must toggle it")
  t.dispose()
}
