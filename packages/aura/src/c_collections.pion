// Aura Track 1C — Collection components (Builder + Pion-JSX):
// ListBox, ListBoxItem, ListBoxSection, Menu, MenuItem, MenuSection, Dropdown, Tag, TagGroup.

import "headless"
import "headless_core"
import "signals"
import "view"

let c_menu_close_lent : view::Lent[() -> Unit] = view::Lent::new()

/// Visual variant for `ListBoxItem` and `MenuItem`.
#derive(Eq)
pub enum AuraItemVariant {
  Default
  Danger
}

// ===========================================================================
// 7. ListBox + 8. ListBoxItem + 9. ListBoxSection
// ===========================================================================

/// Aura `ListBox` (Builder API).
/// Reuses `w0_listbox_shell` and wires `headless::listbox` (sections & disabled items excluded from roving).
pub fn listbox_node(
  parent : view::View,
  is_selected : (String) -> Bool,
  on_select : (String) -> Unit,
  content : (view::View, headless::Listbox[String]) -> Unit,
  label~ : String = "List",
  multiple~ : Bool = false,
  in_overlay~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  w0_listbox_shell(
    parent,
    pad=4.0,
    gap=4.0,
    in_overlay=in_overlay,
    content=fn(shell : view::View) -> Unit {
      let _ = headless::listbox(
        shell,
        fn() -> String { label },
        is_selected,
        on_select,
        fn(lb_v : view::View, lb : headless::Listbox[String]) -> Unit {
          let _ = lb_v.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
          content(lb_v, lb)
        },
        multiple=multiple,
        disabled=disabled,
      )
    },
    loc=loc,
  )
}

/// Pion-JSX `<aura::ListBox>` wrapper.
pub fn ListBox(
  parent : view::View,
  is_selected~ : (String) -> Bool = fn(_k : String) { false },
  on_select~ : (String) -> Unit = fn(_k : String) { () },
  label~ : String = "List",
  multiple~ : Bool = false,
  in_overlay~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  children~ : (view::View, headless::Listbox[String]) -> Unit = fn(_v : view::View, _lb : headless::Listbox[String]) { () },
  loc~ : String = "",
) -> view::View {
  listbox_node(
    parent,
    is_selected,
    on_select,
    children,
    label=label,
    multiple=multiple,
    in_overlay=in_overlay,
    disabled=disabled,
    loc=loc,
  )
}

/// Aura `ListBoxSection` (Builder API). Heading is excluded from roving focus.
pub fn listbox_section_node(
  parent : view::View,
  lb : headless::Listbox[String],
  title : String,
  content : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  lb.section(
    parent,
    fn() -> String { title },
    fn(sec : view::View) -> Unit {
      let _ = sec.fills_across(view::Live::Is(true)).gap(view::Live::Is(0.0))
      content(sec)
    },
    heading_look=fn(hdr : view::View) -> Unit {
      let _ = hdr
        .fills_across(view::Live::Is(true))
        .padding(view::Live::Is((8.0, 6.0, 8.0, 4.0)))
        .points(view::Live::Is(false))
      let _ = hdr.box(fn(tv : view::View) -> Unit {
        let _ = tv
          .points(view::Live::Is(false))
          .words(view::Live::Is(title), look=c_words_look(12.0, 500, 16.0))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.muted }))
      })
    },
    loc=loc,
  )
}

/// Pion-JSX `<aura::ListBoxSection>` wrapper.
pub fn ListBoxSection(
  parent : view::View,
  lb~ : headless::Listbox[String],
  title~ : String = "",
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  listbox_section_node(parent, lb, title, children, loc=loc)
}

/// Aura `ListBoxItem` (Builder API).
pub fn listbox_item_node(
  parent : view::View,
  lb : headless::Listbox[String],
  key : String,
  label : String,
  description? : String,
  icon? : AuraIconKind,
  variant~ : AuraItemVariant = AuraItemVariant::Default,
  disabled~ : () -> Bool = fn() { false },
  show_indicator~ : Bool = true,
  plain_text~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let is_danger = variant is AuraItemVariant::Danger
  lb.option(
    parent,
    key,
    fn() -> String { label },
    fn(row : view::View, opt : headless::ListOption) -> Unit {
      let _ = row
        .row(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(36.0)))
        .padding(view::Live::Is((8.0, 6.0, if show_indicator { 28.0 } else { 8.0 }, 6.0)))
        .gap(view::Live::Is(12.0))
        .corner_circular(view::Live::Is(true))
        .radius(view::Live::Is(16.0))
        .scale(view::Live::By(fn() -> Double {
          if !aura_reduced_motion(row) && !opt.disabled() && opt.pressed() { 0.98 } else { 1.0 }
        }))
        .ground(view::Live::By(fn() -> Int64 {
          if !opt.disabled() && !aura_is_coarse_pointer(row) && opt.hovered() {
            aura_theme(row).palette.default_bg
          } else {
            0x00000000L
          }
        }))
        .group_alpha(view::Live::By(fn() -> Double {
          if opt.disabled() { aura_theme(row).disabled_opacity } else { 1.0 }
        }))
      let _ = w0_apply_control_focus_ring(row)

      match icon {
        Some(ik) => {
          let _ = aura_icon_node(
            row,
            ik,
            size=16.0,
            ink=fn() -> Int64 {
              let pal = aura_theme(row).palette
              if is_danger { pal.danger } else { pal.muted }
            },
          )
        }
        None => ()
      }

      let _ = row.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).points(view::Live::Is(false))
        let _ = col
          .words(
            view::Live::Is(label),
            look=if plain_text { c_words_look(16.0, 400, 24.0) } else { c_words_look(14.0, 500, 20.0) },
          )
          .ink(view::Live::By(fn() -> Int64 {
            let pal = aura_theme(col).palette
            if is_danger { pal.danger } else { pal.foreground }
          }))
        match description {
          Some(desc) => {
            let _ = col
              .words(view::Live::Is(desc), look=c_words_look(12.0, 400, 16.0, wrap=true))
              .ink(view::Live::By(fn() -> Int64 { aura_theme(col).palette.muted }))
          }
          None => ()
        }
      })

      if show_indicator {
        let _ = row.box(fn(ind : view::View) -> Unit {
          let _ = ind
            .over(view::Live::Is(true), edges=(None, Some(0.0), Some(8.0), Some(0.0)))
            .width(view::Live::Is(Some(16.0)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .points(view::Live::Is(false))
          let _ = ind.show(
            fn() -> Bool { opt.selected() },
            fn(chk : view::View) -> Unit {
              let _ = aura_icon_node(
                chk,
                AuraIconKind::Check,
                size=12.0,
                ink=fn() -> Int64 {
                  let pal = aura_theme(chk).palette
                  if is_danger { pal.danger } else { pal.default_foreground }
                },
              )
            },
          )
        })
      }
    },
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::ListBoxItem>` wrapper.
pub fn ListBoxItem(
  parent : view::View,
  lb~ : headless::Listbox[String],
  key~ : String = "",
  label~ : String = "",
  description? : String,
  icon? : AuraIconKind,
  variant~ : AuraItemVariant = AuraItemVariant::Default,
  disabled~ : () -> Bool = fn() { false },
  show_indicator~ : Bool = true,
  plain_text~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  listbox_item_node(
    parent,
    lb,
    key,
    label,
    description?=description,
    icon?=icon,
    variant=variant,
    disabled=disabled,
    show_indicator=show_indicator,
    plain_text=plain_text,
    loc=loc,
  )
}

// ===========================================================================
// 10. Menu + 11. MenuItem + 12. MenuSection
// ===========================================================================

/// Aura `Menu` (Builder API).
/// Reuses `w0_popover_shell` when `in_popover=true` and wires `headless::menu`.
pub fn menu_node(
  parent : view::View,
  content : (view::View, headless::Menu) -> Unit,
  label~ : String = "Menu",
  on_close? : () -> Unit,
  in_popover~ : Bool = true,
  min_width~ : Double = 220.0,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let mount_menu = fn(host : view::View) -> Unit {
    let _ = headless::menu(
      host,
      fn(mv : view::View, m : headless::Menu) -> Unit {
        let _ = mv.fills_across(view::Live::Is(true)).gap(view::Live::Is(2.0))
        match on_close {
          Some(f) => {
            let _ = mv.lends(c_menu_close_lent, f)
          }
          None => ()
        }
        content(mv, m)
      },
      label=fn() -> String { label },
      on_close?=on_close,
      disabled=disabled,
    )
  }
  if in_popover {
    let shell = w0_popover_shell(parent, radius=22.0, pad=6.0, gap=2.0, content=mount_menu, loc=loc)
    let _ = shell.min_width(view::Live::Is(Some(min_width)))
    shell
  } else {
    parent.box(loc=loc, fn(box_v : view::View) -> Unit {
      let _ = box_v.fills_across(view::Live::Is(true)).pad(view::Live::Is(4.0))
      mount_menu(box_v)
    })
  }
}

/// Pion-JSX `<aura::Menu>` wrapper.
pub fn Menu(
  parent : view::View,
  label~ : String = "Menu",
  on_close? : () -> Unit,
  in_popover~ : Bool = true,
  min_width~ : Double = 220.0,
  disabled~ : () -> Bool = fn() { false },
  children~ : (view::View, headless::Menu) -> Unit = fn(_v : view::View, _m : headless::Menu) { () },
  loc~ : String = "",
) -> view::View {
  menu_node(
    parent,
    children,
    label=label,
    on_close?=on_close,
    in_popover=in_popover,
    min_width=min_width,
    disabled=disabled,
    loc=loc,
  )
}

/// Aura `MenuSection` (Builder API).
pub fn menu_section_node(
  parent : view::View,
  m : headless::Menu,
  title : String,
  content : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  m.section(
    parent,
    fn() -> String { title },
    fn(sec : view::View) -> Unit {
      let _ = sec.fills_across(view::Live::Is(true)).gap(view::Live::Is(2.0))
      content(sec)
    },
    heading_look=fn(hdr : view::View) -> Unit {
      let _ = hdr
        .fills_across(view::Live::Is(true))
        .padding(view::Live::Is((10.0, 6.0, 10.0, 4.0)))
        .points(view::Live::Is(false))
      let _ = hdr.box(fn(tv : view::View) -> Unit {
        let _ = tv
          .points(view::Live::Is(false))
          .words(view::Live::Is(title), look=c_words_look(12.0, 500, 16.0))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.muted }))
      })
    },
    loc=loc,
  )
}

/// Pion-JSX `<aura::MenuSection>` wrapper.
pub fn MenuSection(
  parent : view::View,
  m~ : headless::Menu,
  title~ : String = "",
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  menu_section_node(parent, m, title, children, loc=loc)
}

/// Aura `MenuItem` (Builder API). Supports leading icon, shortcut hint, description, danger variant, and separator.
pub fn menu_item_node(
  parent : view::View,
  m : headless::Menu,
  label : String,
  on_action~ : () -> Unit = fn() { () },
  close_on_select~ : Bool = true,
  icon? : AuraIconKind,
  shortcut? : String,
  description? : String,
  variant~ : AuraItemVariant = AuraItemVariant::Default,
  disabled~ : () -> Bool = fn() { false },
  has_submenu~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let is_danger = variant is AuraItemVariant::Danger
  m.item(
    parent,
    fn() -> String { label },
    fn(v : view::View) -> Unit {
      on_action()
      if close_on_select {
        match v.lent(c_menu_close_lent) {
          Some(close_fn) => close_fn()
          None => ()
        }
      }
    },
    fn(row : view::View, mi : headless::MenuItem) -> Unit {
      let _ = row
        .row(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .min_height(view::Live::Is(Some(36.0)))
        .padding(view::Live::Is((10.0, 6.0, if has_submenu { 28.0 } else { 10.0 }, 6.0)))
        .gap(view::Live::Is(12.0))
        .corner_circular(view::Live::Is(true))
        .radius(view::Live::Is(16.0))
        .scale(view::Live::By(fn() -> Double {
          if !aura_reduced_motion(row) && !mi.disabled() && mi.pressed() { 0.98 } else { 1.0 }
        }))
        .ground(view::Live::By(fn() -> Int64 {
          if !mi.disabled() && !aura_is_coarse_pointer(row) && mi.hovered() {
            aura_theme(row).palette.default_bg
          } else {
            0x00000000L
          }
        }))
        .group_alpha(view::Live::By(fn() -> Double {
          if mi.disabled() { aura_theme(row).disabled_opacity } else { 1.0 }
        }))
      let _ = w0_apply_control_focus_ring(row)

      match icon {
        Some(ik) => {
          let _ = aura_icon_node(
            row,
            ik,
            size=16.0,
            ink=fn() -> Int64 {
              let pal = aura_theme(row).palette
              if is_danger { pal.danger } else { pal.muted }
            },
          )
        }
        None => ()
      }

      let _ = row.box(fn(col : view::View) -> Unit {
        let _ = col.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0))).points(view::Live::Is(false))
        let _ = col
          .words(view::Live::Is(label), look=c_words_look(14.0, 500, 20.0))
          .ink(view::Live::By(fn() -> Int64 {
            let pal = aura_theme(col).palette
            if is_danger { pal.danger } else { pal.foreground }
          }))
        match description {
          Some(desc) => {
            let _ = col
              .words(view::Live::Is(desc), look=c_words_look(12.0, 400, 16.0, wrap=true))
              .ink(view::Live::By(fn() -> Int64 { aura_theme(col).palette.muted }))
          }
          None => ()
        }
      })

      match shortcut {
        Some(sc) => {
          let _ = row
            .words(view::Live::Is(sc), look=c_words_look(12.0, 400, 16.0))
            .ink(view::Live::By(fn() -> Int64 { aura_theme(row).palette.muted }))
        }
        None => ()
      }

      if has_submenu {
        let _ = row.box(fn(sub_v : view::View) -> Unit {
          let _ = sub_v
            .over(view::Live::Is(true), edges=(None, Some(0.0), Some(8.0), Some(0.0)))
            .width(view::Live::Is(Some(16.0)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .points(view::Live::Is(false))
          let _ = aura_icon_node(
            sub_v,
            AuraIconKind::ChevronRight,
            size=12.0,
            ink=fn() -> Int64 { aura_theme(sub_v).palette.muted },
          )
        })
      }
    },
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::MenuItem>` wrapper.
pub fn MenuItem(
  parent : view::View,
  m~ : headless::Menu,
  label~ : String = "",
  on_action~ : () -> Unit = fn() { () },
  close_on_select~ : Bool = true,
  icon? : AuraIconKind,
  shortcut? : String,
  description? : String,
  variant~ : AuraItemVariant = AuraItemVariant::Default,
  disabled~ : () -> Bool = fn() { false },
  has_submenu~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  menu_item_node(
    parent,
    m,
    label,
    on_action=on_action,
    close_on_select=close_on_select,
    icon?=icon,
    shortcut?=shortcut,
    description?=description,
    variant=variant,
    disabled=disabled,
    has_submenu=has_submenu,
    loc=loc,
  )
}

// ===========================================================================
// 13. Dropdown (Trigger + Anchored Menu Overlay)
// ===========================================================================

/// Aura `Dropdown` (Builder API).
/// Mounts a trigger button and an anchored `Menu` popover wired to `headless::Popover` + `headless::menu`.
pub fn dropdown_node(
  parent : view::View,
  trigger_label : String,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  menu_content : (view::View, headless::Menu) -> Unit,
  trigger_variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  min_width~ : Double = 220.0,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let pop = headless::Popover::new(open, set_open)
  let opened_by_kbd : signals::Ref[Bool] = view::ref_new(false)
  parent.box(loc=loc, fn(host : view::View) -> Unit {
    let _ = host
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
    let _ = pop.trigger(
      host,
      fn() -> String { trigger_label },
      fn(trig : view::View, disc : headless::Disclosure) -> Unit {
        let (_, px, fs, lh, press_sc) = w0_btn_metrics(AuraButtonSize::Md, false, true)
        let _ = trig
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .height(view::Live::By(fn() -> Option[Double] {
            Some(w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0)
          }))
          .shrink(view::Live::Is(0.0))
          .corner_circular(view::Live::Is(true))
          .radius(view::Live::By(fn() -> Double {
            w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0 * 0.5
          }))
          .group_alpha(view::Live::By(fn() -> Double {
            if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
          }))
        let _ = w0_apply_control_focus_ring(trig)
        let _ = trig.on_key(fn(k : view::Key) -> Bool {
          if !disabled() && !open() && k.mods == 0 {
            if k.code == headless_core::key_down {
              opened_by_kbd.v = true
              set_open(true)
              return true
            } else if k.code == headless_core::key_enter || k.code == headless_core::key_space {
              opened_by_kbd.v = true
            }
          }
          false
        })
        // Paint scale(0.97) on inner visual face so `beside` keeps anchoring to the unscaled 36pt layout rect
        let _ = trig.box(fn(face : view::View) -> Unit {
          let _ = face
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .gap(view::Live::Is(8.0))
            .height(view::Live::By(fn() -> Option[Double] {
              Some(w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0)
            }))
            .pad_xy(px, 0.0)
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            .corner_circular(view::Live::Is(true))
            .radius(view::Live::By(fn() -> Double {
              w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0 * 0.5
            }))
            .scale(view::Live::By(fn() -> Double {
              if !aura_reduced_motion(trig) && !disc.disabled() && (open() || disc.pressed()) { press_sc } else { 1.0 }
            }))
            .ground(view::Live::By(fn() -> Int64 {
              let hov = !disc.disabled() && (open() || disc.pressed() || (!aura_is_coarse_pointer(trig) && disc.hovered()))
              w0_btn_colors(aura_theme(trig).palette, trigger_variant, hov).0
            }))
            .edge(view::Live::By(fn() -> (Double, Int64) {
              let hov = !disc.disabled() && (open() || disc.pressed() || (!aura_is_coarse_pointer(trig) && disc.hovered()))
              w0_btn_colors(aura_theme(trig).palette, trigger_variant, hov).2
            }))
          let _ = face.box(fn(lbl_v : view::View) -> Unit {
            let _ = lbl_v
              .points(view::Live::Is(false))
              .words_centered(view::Live::Is(true))
              .words(
                view::Live::Is(trigger_label),
                look=view::WordsLook::{ ..c_words_look(fs, 500, lh), tracking: view::Spacing::Points(-0.15) },
              )
              .ink(view::Live::By(fn() -> Int64 {
                let hov = !disc.disabled() && (disc.pressed() || (!aura_is_coarse_pointer(trig) && disc.hovered()))
                w0_btn_colors(aura_theme(lbl_v).palette, trigger_variant, hov).1
              }))
          })
        })
      },
      disabled=disabled,
    )

    let root = host.tree.root()
    let portal_tie = root.show_scoped(
      fn() -> Bool { true },
      fn(portal : view::View) -> Unit {
        let _ = portal
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
          .points(view::Live::Is(false))
        c_inherit_aura_config(host, portal)

        pop.layer(
          portal,
          fn() -> String { trigger_label },
          fn(layer_v : view::View, opener : Option[view::View]) -> Unit {
            let (b_side, b_along) = c_placement_to_beside(placement)
            let _ = layer_v
              .points(view::Live::Is(true))
              .min_width(view::Live::Is(Some(min_width)))
            match opener {
              Some(op) => {
                let _ = layer_v.beside(op.id(), side=b_side, along=b_along, offset=gap, padding=8.0)
              }
              None => {
                let _ = layer_v.over(view::Live::Is(true), edges=(Some(0.0), Some(gap), None, None))
              }
            }
            let menu_v = menu_node(
              layer_v,
              fn(mv : view::View, m : headless::Menu) -> Unit {
                menu_content(mv, m)
                let _ = layer_v.at_moment(layer_v.cause_at(), fn() -> Unit {
                  let vis = opened_by_kbd.v
                  opened_by_kbd.v = false
                  let _ = m.focus_first(visible=vis)
                })
              },
              label=trigger_label,
              on_close=fn() -> Unit { set_open(false) },
              in_popover=true,
              min_width=min_width,
            )
            if !aura_reduced_motion(host) && b_along is view::Along::Start {
              // Align start-anchored menu with the trigger's scale(0.97) visual edge (matching getBoundingClientRect)
              let _ = menu_v.margin(view::Live::Is((1.25, 0.0, 0.0, 0.0)))
            }
          },
        )
      },
      at_once=true,
    )
    portal_tie(host)
  })
}

/// Pion-JSX `<aura::Dropdown>` wrapper.
pub fn Dropdown(
  parent : view::View,
  trigger_label~ : String = "Menu",
  open~ : () -> Bool = fn() { false },
  set_open~ : (Bool) -> Unit = fn(_b : Bool) { () },
  trigger_variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  min_width~ : Double = 220.0,
  disabled~ : () -> Bool = fn() { false },
  children~ : (view::View, headless::Menu) -> Unit = fn(_v : view::View, _m : headless::Menu) { () },
  loc~ : String = "",
) -> view::View {
  dropdown_node(
    parent,
    trigger_label,
    open,
    set_open,
    children,
    trigger_variant=trigger_variant,
    placement=placement,
    gap=gap,
    min_width=min_width,
    disabled=disabled,
    loc=loc,
  )
}

// ===========================================================================
// 14. Tag & 15. TagGroup
// ===========================================================================

/// Visual variant for Aura `Tag`.
#derive(Eq)
pub enum AuraTagVariant {
  Default
  Surface
}

/// Size variant for Aura `Tag`.
#derive(Eq)
pub enum AuraTagSize {
  Sm
  Md
  Lg
}

fn c_tag_metrics(size : AuraTagSize) -> (Double, Double, Double, Double, Double) {
  // Returns (pad_x, pad_y, font_size, line_height, radius)
  match size {
    AuraTagSize::Sm => (8.0, 2.0, 12.0, 16.0, 12.0)
    AuraTagSize::Md => (7.5, 4.0, 12.0, 16.0, 12.0)
    AuraTagSize::Lg => (10.0, 6.0, 14.0, 20.0, 16.0)
  }
}

/// Aura `Tag` (Builder API), mounted inside a `headless::TagGroup`.
pub fn tag_node(
  parent : view::View,
  tg : headless::TagGroup[String],
  key : String,
  label : String,
  variant~ : AuraTagVariant = AuraTagVariant::Default,
  size~ : AuraTagSize = AuraTagSize::Md,
  removable~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let (px, py, fs, lh, rad) = c_tag_metrics(size)
  let vis_h = lh + py * 2.0
  let hit_pad_y = if vis_h < 36.0 { (36.0 - vis_h) * 0.5 } else { 0.0 }
  let is_surface = variant is AuraTagVariant::Surface
  tg.tag(
    parent,
    key,
    fn() -> String { label },
    fn(tag_v : view::View, is_sel : () -> Bool, is_dis : () -> Bool) -> Unit {
      let _ = tag_v
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .min_width(view::Live::Is(Some(36.0)))
        .min_height(view::Live::Is(Some(36.0)))
        .group_alpha(view::Live::By(fn() -> Double {
          if is_dis() { aura_theme(tag_v).disabled_opacity } else { 1.0 }
        }))
      if hit_pad_y > 0.0 {
        let _ = tag_v.margin(view::Live::Is((0.0, -hit_pad_y, 0.0, -hit_pad_y)))
      }

      let fg_get = fn() -> Int64 {
        let pal = aura_theme(tag_v).palette
        if is_sel() {
          pal.accent_soft_foreground
        } else if is_surface {
          pal.surface_foreground
        } else {
          pal.default_foreground
        }
      }

      let _ = tag_v.box(fn(pill : view::View) -> Unit {
        let _ = pill
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(4.0))
          .pad_xy(px, py)
          .corner_circular(view::Live::Is(true))
          .radius(view::Live::Is(rad))
          .points(view::Live::Is(false))
          .ground(view::Live::By(fn() -> Int64 {
            let pal = aura_theme(pill).palette
            let hov = !is_dis() && !aura_is_coarse_pointer(tag_v) && tag_v.pointed()
            if is_sel() {
              if hov { pal.accent_soft_hover } else { pal.accent_soft }
            } else if is_surface {
              if hov { pal.surface_hover } else { pal.surface }
            } else {
              if hov { pal.default_hover } else { pal.default_bg }
            }
          }))
          .ring(view::Live::By(fn() -> (Double, Double, Int64) {
            if tag_v.focus_shown() {
              let th = aura_theme(pill)
              (2.0, th.ring_offset_width, th.palette.focus)
            } else {
              (0.0, 0.0, 0L)
            }
          }))
          .ring_gap_color(view::Live::By(fn() -> Int64 {
            if tag_v.focus_shown() { aura_theme(pill).palette.background } else { 0L }
          }))

        let _ = pill.box(fn(lbl_v : view::View) -> Unit {
          let _ = lbl_v
            .points(view::Live::Is(false))
            .words(view::Live::Is(label), look=c_words_look(fs, 500, lh))
            .ink(view::Live::By(fg_get))
        })

        if removable {
          let _ = pill.box(fn(rm_v : view::View) -> Unit {
            let _ = rm_v
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .width(view::Live::Is(Some(12.0)))
              .height(view::Live::Is(Some(12.0)))
              .shrink(view::Live::Is(0.0))
              .corner_circular(view::Live::Is(true))
              .radius(view::Live::Is(6.0))
              .says(view::Live::Is(Some(view::said(view::Role::Button, label="Remove " + label))))
              .on_press(fn() -> Unit {
                if !is_dis() {
                  let _ = tg.remove_tag(key, tag_v)
                }
              })
            let _ = aura_icon_node(rm_v, AuraIconKind::Xmark, size=12.0, ink=fg_get)
          })
        }
      })
    },
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Tag>` wrapper.
pub fn Tag(
  parent : view::View,
  tg~ : headless::TagGroup[String],
  key~ : String = "",
  label~ : String = "",
  variant~ : AuraTagVariant = AuraTagVariant::Default,
  size~ : AuraTagSize = AuraTagSize::Md,
  removable~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  tag_node(
    parent,
    tg,
    key,
    label,
    variant=variant,
    size=size,
    removable=removable,
    disabled=disabled,
    loc=loc,
  )
}

/// Aura `TagGroup` (Builder API). Wired to `headless::tag_group` (selection + Backspace/Delete removal).
pub fn tag_group_node(
  parent : view::View,
  content : (view::View, headless::TagGroup[String]) -> Unit,
  label? : String,
  description? : String,
  error_message? : String,
  is_selected? : (String) -> Bool,
  on_select? : (String) -> Unit,
  on_remove? : (String) -> Unit,
  multiple~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let aria_label = match label {
    Some(l) => l
    None => "Tags"
  }
  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let _ = root.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
    match label {
      Some(lbl) => {
        let _ = label_node(root, view::Live::Is(lbl), disabled=view::Live::By(disabled))
      }
      None => ()
    }
    let _ = headless::tag_group(
      root,
      fn() -> String { aria_label },
      fn(list_v : view::View, tg : headless::TagGroup[String]) -> Unit {
        let _ = list_v
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(6.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(6.0))
        content(list_v, tg)
      },
      is_selected?=is_selected,
      on_select?=on_select,
      on_remove?=on_remove,
      multiple=multiple,
      disabled=disabled,
    )
    match description {
      Some(d) => {
        let _ = root.box(fn(dv : view::View) -> Unit {
          let _ = dv.pad(view::Live::Is(4.0))
          let _ = description_node(dv, view::Live::Is(d))
        })
      }
      None => ()
    }
    match error_message {
      Some(e) => {
        let _ = root.box(fn(ev : view::View) -> Unit {
          let _ = ev.pad(view::Live::Is(4.0))
          let _ = error_message_node(ev, view::Live::Is(e))
        })
      }
      None => ()
    }
  })
}

/// Pion-JSX `<aura::TagGroup>` wrapper.
pub fn TagGroup(
  parent : view::View,
  label? : String,
  description? : String,
  error_message? : String,
  is_selected? : (String) -> Bool,
  on_select? : (String) -> Unit,
  on_remove? : (String) -> Unit,
  multiple~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  children~ : (view::View, headless::TagGroup[String]) -> Unit = fn(_v : view::View, _tg : headless::TagGroup[String]) { () },
  loc~ : String = "",
) -> view::View {
  tag_group_node(
    parent,
    children,
    label?=label,
    description?=description,
    error_message?=error_message,
    is_selected?=is_selected,
    on_select?=on_select,
    on_remove?=on_remove,
    multiple=multiple,
    disabled=disabled,
    loc=loc,
  )
}
