// Wave 1.5 Track 1.5B: ColorPicker compound component (Builder + Pion-JSX).
// Composes `headless::Popover` + `w0_popover_shell` + Wave 1D `ColorSwatch`, `ColorArea`,
// `ColorSlider`, `ColorField`, and `ColorSwatchPicker` with live bidirectional color sync.

import "headless"
import "headless_core"
import "signals"
import "ui"
import "view"

struct XColorPickerCtx {
  model : () -> headless_core::ColorModel
  on_change : (headless_core::ColorModel) -> Unit
  pop : headless::Popover
  disabled : () -> Bool
  presets : Array[String]
}

let x_color_picker_ctx_lent : view::Lent[XColorPickerCtx] = view::Lent::new()

fn x_cp_words(size : Double, weight : Int, line : Double) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line }
}

fn x_cp_default_presets() -> Array[String] {
  ["#0485F7", "#17C964", "#F5A524", "#F31260", "#7828C8", "#27272A"]
}

fn x_cp_hex_has_alpha(raw : String) -> Bool {
  let s = raw.trim()
  let n = s.length()
  let start = if n > 0 && s.code_unit_at(0) == 35 { 1 } else { 0 }
  let digits = n - start
  digits == 8 || digits == 4
}

fn x_cp_preset_swatches(
  parent : view::View,
  colors : Array[String],
  selected : () -> Option[String],
  on_select : (String) -> Unit,
  disabled : () -> Bool,
) -> view::View {
  let dim = 24.0
  let bw = 2.0
  let inner_dim = dim - bw * 2.0
  let item_rad = dim * 0.5
  let inner_rad = inner_dim * 0.5
  let check_sz = dim / 3.0
  headless::color_swatch_picker(
    parent,
    fn() -> String { "Color swatches" },
    selected,
    on_select,
    fn(root : view::View, sp : headless::ColorSwatchPicker) -> Unit {
      let _ = root
        .row(view::Live::Is(true))
        .wrap_on(line_gap=8.0)
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(8.0))
      for hex in colors {
        let rgba = d_parse_hex_rgba(hex)
        let light_swatch = d_is_light_color(rgba)
        let _ = sp.swatch(
          root,
          hex,
          fn() -> String { hex },
          fn(item : view::View, is_sel : () -> Bool) -> Unit {
            let _ = item
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .width(view::Live::Is(Some(dim)))
              .height(view::Live::Is(Some(dim)))
              .shrink(view::Live::Is(0.0))
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(item) }))
              .radius(view::Live::Is(item_rad))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                if is_sel() { (bw, rgba) } else { (0.0, 0L) }
              }))
              .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                if is_sel() { aura_surface_shadows(aura_theme(item).config.dark) } else { [] }
              }))
              .group_alpha(view::Live::By(fn() -> Double {
                if disabled() { aura_theme(item).disabled_opacity } else { 1.0 }
              }))
            let _ = w0_apply_control_focus_ring(item)
            // Inner swatch with 1pt hairline rim so dark presets (e.g. #27272A) remain visible on dark popovers
            let _ = item.box(fn(sw : view::View) -> Unit {
              let _ = sw
                .width(view::Live::Is(Some(inner_dim)))
                .height(view::Live::Is(Some(inner_dim)))
                .shrink(view::Live::Is(0.0))
                .points(view::Live::Is(false))
                .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(sw) }))
                .radius(view::Live::Is(inner_rad))
                .clips(view::Live::Is(true))
                .scale(view::Live::By(fn() -> Double { if is_sel() { 0.77 } else { 1.0 } }))
                .ground(view::Live::Is(rgba))
                .edge(view::Live::By(fn() -> (Double, Int64) {
                  if aura_theme(sw).config.dark { (1.0, 0xFFFFFF33L) } else { (1.0, 0x0000001AL) }
                }))
            })
            let _ = item.box(fn(ind : view::View) -> Unit {
              let _ = ind
                .over(view::Live::Is(true))
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .points(view::Live::Is(false))
              let _ = ind.show(is_sel, fn(chk_host : view::View) -> Unit {
                let _ = aura_icon_node(
                  chk_host,
                  AuraIconKind::Check,
                  size=check_sz,
                  ink=fn() -> Int64 { if light_swatch { 0x000000FFL } else { 0xFFFFFFFFL } },
                )
              })
            })
          },
        )
      }
    },
    columns=6,
    disabled=disabled,
  )
}

fn x_cp_inherit_config(source : view::View, target : view::View) -> Unit {
  match aura_config_signal_of(source) {
    Some(sig) => {
      let _ = aura_provide_config(target, sig)
    }
    None => ()
  }
}

fn x_cp_placement_to_beside(p : headless::Placement, rtl : Bool) -> (view::Side, view::Along) {
  let flip = fn(a : view::Along) -> view::Along {
    if !rtl {
      a
    } else {
      match a {
        view::Along::Start => view::Along::End
        view::Along::End => view::Along::Start
        view::Along::Middle => view::Along::Middle
      }
    }
  }
  match p {
    headless::Placement::BelowStart => (view::Side::Bottom, flip(view::Along::Start))
    headless::Placement::BelowCenter => (view::Side::Bottom, view::Along::Middle)
    headless::Placement::BelowEnd => (view::Side::Bottom, flip(view::Along::End))
    headless::Placement::AboveStart => (view::Side::Top, flip(view::Along::Start))
    headless::Placement::AboveCenter => (view::Side::Top, view::Along::Middle)
    headless::Placement::AboveEnd => (view::Side::Top, flip(view::Along::End))
    headless::Placement::RightStart => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::Start)
    headless::Placement::RightCenter => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::Middle)
    headless::Placement::RightEnd => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::End)
    headless::Placement::LeftStart => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::Start)
    headless::Placement::LeftCenter => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::Middle)
    headless::Placement::LeftEnd => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::End)
  }
}

// ============================================================================
// 1. ColorPickerTrigger
// ============================================================================

/// Aura `ColorPickerTrigger` (Builder API): circular `ColorSwatch` + label trigger button.
/// Aligns to 32pt `ColorSwatch` + 12pt gap + 14pt foreground label.
pub fn color_picker_trigger_node(
  parent : view::View,
  label~ : String = "Pick Color",
  swatch_size~ : AuraColorSwatchSize = AuraColorSwatchSize::Md,
  swatch_shape~ : AuraColorSwatchShape = AuraColorSwatchShape::Circle,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_color_picker_ctx_lent) {
    Some(ctx) =>
      ctx.pop.trigger(
        parent,
        fn() -> String { label },
        fn(trig : view::View, disc : headless::Disclosure) -> Unit {
          let _ = trig
            .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(trig) }))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(12.0))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(trig) }))
            .radius(view::Live::Is(6.0))
            .shrink(view::Live::Is(0.0))
            .group_alpha(view::Live::By(fn() -> Double {
              if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
            }))
          let _ = w0_apply_control_focus_ring(trig)
          match content {
            Some(f) => f(trig)
            None => {
              let model_fn = ctx.model
              let _ = color_swatch_node(
                trig,
                view::Live::By(fn() -> Int64 { model_fn().to_rgba8() }),
                size=swatch_size,
                shape=swatch_shape,
                label=label,
              )
              if label != "" {
                let _ = trig.box(fn(lbl : view::View) -> Unit {
                  let look = x_cp_words(14.0, 500, 20.0)
                  let _ = lbl
                    .points(view::Live::Is(false))
                    .words(view::Live::Is(label), look=look)
                    .words_look(view::Live::By(fn() -> view::WordsLook { look.with_rtl(aura_rtl(lbl)) }))
                    .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl).palette.foreground }))
                })
              }
            }
          }
        },
        disabled=ctx.disabled,
        loc=loc,
      )
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::ColorPickerTrigger>` wrapper.
pub fn ColorPickerTrigger(
  parent : view::View,
  label~ : String = "Pick Color",
  swatch_size~ : AuraColorSwatchSize = AuraColorSwatchSize::Md,
  swatch_shape~ : AuraColorSwatchShape = AuraColorSwatchShape::Circle,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  color_picker_trigger_node(
    parent,
    label=label,
    swatch_size=swatch_size,
    swatch_shape=swatch_shape,
    content?=children,
    loc=loc,
  )
}

// ============================================================================
// 2. ColorPickerPopover
// ============================================================================

/// Aura `ColorPickerPopover` (Builder API): overlay panel (`w0_popover_shell`, min-width 248pt,
/// `radius = min(32, radius * 2.5)` = 20pt) hosting live-synced `ColorArea`, `ColorSlider` (Hue/Alpha),
/// `ColorField`, and `ColorSwatchPicker` (or custom `content`).
pub fn color_picker_popover_node(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  width~ : Double = 248.0,
  show_alpha~ : Bool = true,
  show_field~ : Bool = true,
  show_presets~ : Bool = true,
  presets? : Array[String],
  aria_label~ : String = "Color picker",
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_color_picker_ctx_lent) {
    Some(ctx) => {
      let sw_presets = match presets {
        Some(ps) => ps
        None => ctx.presets
      }
      parent.box(loc=loc, fn(anchor : view::View) -> Unit {
        let _ = anchor
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .points(view::Live::Is(false))
        let root = anchor.tree.root()
        let portal_tie = root.show_scoped(
          fn() -> Bool { true },
          fn(portal : view::View) -> Unit {
            let _ = portal
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::Is(false))
            x_cp_inherit_config(anchor, portal)
            let _ = portal.lends(x_color_picker_ctx_lent, ctx)

            ctx.pop.layer(
              portal,
              fn() -> String { aria_label },
              fn(layer_v : view::View, opener : Option[view::View]) -> Unit {
                let rtl = aura_rtl(anchor)
                let (b_side, b_along) = x_cp_placement_to_beside(placement, rtl)
                let _ = layer_v
                  .points(view::Live::Is(true))
                  .width(view::Live::Is(Some(width)))
                match opener {
                  Some(op) => {
                    let _ = layer_v.beside(op.id(), side=b_side, along=b_along, offset=gap, padding=8.0)
                  }
                  None => {
                    let _ = layer_v.over(view::Live::Is(true), edges=(Some(0.0), Some(gap), None, None))
                  }
                }
                let rad = {
                  let r = aura_theme(anchor).radius * 2.5
                  if r > 32.0 { 32.0 } else { r }
                }
                let shell = w0_popover_shell(
                  layer_v,
                  radius=rad,
                  pad=12.0,
                  gap=12.0,
                  content=fn(panel : view::View) -> Unit {
                    match content {
                      Some(f) => f(panel)
                      None => {
                        let area_sz = width - 24.0
                        let _ = color_area_node(
                          panel,
                          ctx.model,
                          ctx.on_change,
                          x_channel=headless_core::ColorChannel::Saturation,
                          y_channel=headless_core::ColorChannel::Brightness,
                          size=area_sz,
                          label="Color spectrum",
                          disabled=ctx.disabled,
                        )
                        let _ = color_slider_node(
                          panel,
                          headless_core::ColorChannel::Hue,
                          ctx.model,
                          ctx.on_change,
                          label="Hue",
                          disabled=ctx.disabled,
                        )
                        if show_alpha {
                          let _ = color_slider_node(
                            panel,
                            headless_core::ColorChannel::Alpha,
                            ctx.model,
                            ctx.on_change,
                            label="Alpha",
                            disabled=ctx.disabled,
                          )
                        }
                        if show_field {
                          let hex_fld = ui::Field::new(text=signals::untracked(ctx.model).to_hex())
                          let _ = color_field_node(
                            panel,
                            ctx.model,
                            fn(parsed : headless_core::ColorModel) -> Unit {
                              let raw = signals::untracked(fn() -> String { hex_fld.text() })
                              if x_cp_hex_has_alpha(raw) {
                                (ctx.on_change)(parsed)
                              } else {
                                let cur_a = signals::untracked(ctx.model).alpha
                                (ctx.on_change)(headless_core::ColorModel::{ ..parsed, alpha: cur_a })
                              }
                            },
                            label="Hex Color",
                            show_swatch=true,
                            variant=AuraFieldVariant::Secondary,
                            disabled=view::Live::By(ctx.disabled),
                            field_ref=hex_fld,
                          )
                        }
                        if show_presets && sw_presets.length() > 0 {
                          let _ = x_cp_preset_swatches(
                            panel,
                            sw_presets,
                            fn() -> Option[String] { Some((ctx.model)().to_hex(include_alpha=true)) },
                            fn(hex : String) -> Unit {
                              match headless_core::color_parse_hex(hex) {
                                Some(parsed) =>
                                  if x_cp_hex_has_alpha(hex) {
                                    (ctx.on_change)(parsed)
                                  } else {
                                    let cur_a = signals::untracked(ctx.model).alpha
                                    (ctx.on_change)(headless_core::ColorModel::{ ..parsed, alpha: cur_a })
                                  }
                                None => ()
                              }
                            },
                            ctx.disabled,
                          )
                        }
                      }
                    }
                  },
                )
                let _ = shell.width(view::Live::Is(Some(width)))
              },
            )
          },
          at_once=true,
        )
        portal_tie(anchor)
      })
    }
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::ColorPickerPopover>` wrapper.
pub fn ColorPickerPopover(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  width~ : Double = 248.0,
  show_alpha~ : Bool = true,
  show_field~ : Bool = true,
  show_presets~ : Bool = true,
  presets? : Array[String],
  aria_label~ : String = "Color picker",
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  color_picker_popover_node(
    parent,
    placement=placement,
    gap=gap,
    width=width,
    show_alpha=show_alpha,
    show_field=show_field,
    show_presets=show_presets,
    presets?=presets,
    aria_label=aria_label,
    content?=children,
    loc=loc,
  )
}

// ============================================================================
// 3. ColorPicker root
// ============================================================================

/// Aura `ColorPicker` root compound component (Builder API).
/// Provides shared color state + `headless::Popover` to `ColorPickerTrigger` and `ColorPickerPopover`.
/// When `content` is omitted, automatically mounts default `ColorPickerTrigger` + `ColorPickerPopover`.
pub fn color_picker_node(
  parent : view::View,
  model? : () -> headless_core::ColorModel,
  default_model~ : headless_core::ColorModel = headless_core::ColorModel::from_hsva(208.0, 1.0, 1.0),
  on_change~ : (headless_core::ColorModel) -> Unit = fn(_m : headless_core::ColorModel) { () },
  label~ : String = "Pick Accent Color",
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  popover_width~ : Double = 248.0,
  show_alpha~ : Bool = true,
  show_field~ : Bool = true,
  show_presets~ : Bool = true,
  presets? : Array[String],
  disabled~ : () -> Bool = fn() { false },
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let internal_model = signals::signal_by(default_model, fn(a, b) { a == b })
  let model_get = match model {
    Some(f) => f
    None => fn() -> headless_core::ColorModel { internal_model.get() }
  }
  let change_fn = match model {
    Some(_) => on_change
    None =>
      fn(m : headless_core::ColorModel) -> Unit {
        internal_model.set(m)
        on_change(m)
      }
  }
  let internal_open = signals::signal(default_open)
  let open_get = match open {
    Some(f) => f
    None => fn() -> Bool { internal_open.get() }
  }
  let open_set = match set_open {
    Some(f) => f
    None => fn(b : Bool) -> Unit { internal_open.set(b) }
  }
  let pop = headless::Popover::new(open_get, open_set)
  let sw_presets = match presets {
    Some(ps) => ps
    None => x_cp_default_presets()
  }
  let ctx = XColorPickerCtx::{ model: model_get, on_change: change_fn, pop, disabled, presets: sw_presets }

  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let _ = root
      .lends(x_color_picker_ctx_lent, ctx)
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .shrink(view::Live::Is(0.0))
    match content {
      Some(f) => f(root)
      None => {
        let _ = color_picker_trigger_node(root, label=label)
        let _ = color_picker_popover_node(
          root,
          placement=placement,
          width=popover_width,
          show_alpha=show_alpha,
          show_field=show_field,
          show_presets=show_presets,
          presets=sw_presets,
          aria_label=label,
        )
      }
    }
  })
}

/// Pion-JSX `<aura::ColorPicker>` wrapper.
pub fn ColorPicker(
  parent : view::View,
  model? : () -> headless_core::ColorModel,
  default_model~ : headless_core::ColorModel = headless_core::ColorModel::from_hsva(208.0, 1.0, 1.0),
  on_change~ : (headless_core::ColorModel) -> Unit = fn(_m : headless_core::ColorModel) { () },
  label~ : String = "Pick Accent Color",
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  popover_width~ : Double = 248.0,
  show_alpha~ : Bool = true,
  show_field~ : Bool = true,
  show_presets~ : Bool = true,
  presets? : Array[String],
  disabled~ : () -> Bool = fn() { false },
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  color_picker_node(
    parent,
    model?=model,
    default_model=default_model,
    on_change=on_change,
    label=label,
    open?=open,
    set_open?=set_open,
    default_open=default_open,
    placement=placement,
    popover_width=popover_width,
    show_alpha=show_alpha,
    show_field=show_field,
    show_presets=show_presets,
    presets?=presets,
    disabled=disabled,
    content?=children,
    loc=loc,
  )
}
