// ---------------------------------------------------------------------------
// 9. Form (`form_node` / `Form`)
// ---------------------------------------------------------------------------

/// Aura `Form` container integrating `headless::form` (field registration, submit, cross-field error routing).
pub fn form_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is("Form"),
  on_submit~ : (Map[String, String]) -> Unit = fn(_vals : Map[String, String]) { () },
  validate_form? : (Map[String, String]) -> Map[String, String],
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  gap~ : Double = 16.0,
  content~ : (view::View, headless::Form) -> Unit = fn(_v : view::View, _f : headless::Form) { () },
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let dis_get = disabled.to_getter()
  headless::form(
    parent,
    lbl_get,
    on_submit,
    fn(node : view::View, f : headless::Form) -> Unit {
      let _ = node
        .gap(view::Live::Is(gap))
        .fills_across(view::Live::Is(true))
        .lends(b_form_lent, f)
      content(node, f)
    },
    validate_form?=validate_form,
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Form>` wrapper.
pub fn Form(
  parent : view::View,
  into label~ : view::Live[String] = .Is("Form"),
  label_by? : () -> String,
  on_submit~ : (Map[String, String]) -> Unit = fn(_vals : Map[String, String]) { () },
  validate_form? : (Map[String, String]) -> Map[String, String],
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  gap~ : Double = 16.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  form_node(
    parent,
    label=l,
    on_submit=on_submit,
    validate_form?=validate_form,
    disabled=dis,
    gap=gap,
    content=fn(v : view::View, _f : headless::Form) -> Unit { children(v) },
    loc=loc,
  )
}
