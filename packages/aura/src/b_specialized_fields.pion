/// Aura `FieldsetGroup` (`w-full`, vertical `gap-4` = 16pt).
pub fn fieldset_group_node(
  parent : view::View,
  gap~ : Double = 16.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
