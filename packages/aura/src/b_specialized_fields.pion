// Track 1B specialized form fields & containers:
// SearchField, NumberField, InputOTP (with Group/Slot/Separator), Fieldset (with Legend/Description/Group/Actions), Form.

import "headless"
import "headless_core"
import "paint"
import "signals"
import "ui"
import "view"

fn b_minus_icon(parent : view::View, size~ : Double = 16.0, ink : () -> Int64) -> view::View {
  parent.box(fn(node : view::View) -> Unit {
    let x0 = size * 0.1875
    let x1 = size * 0.8125
    let cy = size * 0.5
    let sw = size * (1.5 / 16.0)
    let _ = node
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .lines(view::Live::By(fn() -> Array[paint::Line] {
        [paint::subline([(x0, cy), (x1, cy)], from=0.0, upto=1.0, width=sw, color=ink())]
      }))
  })
}

fn b_with_alpha(rgba : Int64, alpha_byte : Int64) -> Int64 {
  (rgba & 0xFFFFFF00L) | (alpha_byte & 0xFFL)
}

// ---------------------------------------------------------------------------
// 5. SearchField (`search_field_node` / `SearchField`)
// ---------------------------------------------------------------------------

/// Aura `SearchField` (Magnifier icon + `ui::Field` + clear button; Escape clears input).
pub fn search_field_node(
  parent : view::View,
  field? : ui::Field,
  value~ : String = "",
  label~ : view::Live[String] = view::Live::Is(""),
  placeholder~ : view::Live[String] = view::Live::Is("Search..."),
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : view::Live[Bool] = view::Live::Is(false),
  force_focused~ : Bool = false,
  on_change~ : (String) -> Unit = fn(_s : String) { () },
  on_submit~ : (String) -> Unit = fn(_s : String) { () },
  on_clear~ : () -> Unit = fn() { () },
  loc~ : String = "",
) -> view::View {
  let fld = match field {
    Some(f) => f
    None => ui::Field::new(text=value)
  }
  let lbl_get = label.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let ro_get = read_only.to_getter()

  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let eff_dis = fn() -> Bool { b_effective_disabled(root, dis_get) }
    let eff_inv = fn() -> Bool { inv_get() || err_get() != "" }
    let _ = root.gap(view::Live::Is(4.0))
    if full_width {
      let _ = root.fills_across(view::Live::Is(true))
    }
    if lbl_get() != "" {
      let _ = label_node(root, label, disabled=view::Live::By(eff_dis))
    }
    let do_clear = fn() -> Unit {
      if eff_dis() || ro_get() {
        return
      }
      if fld.text() != "" {
        fld.set("")
        on_change("")
        on_clear()
      }
    }
    let shell = w0_field_shell(
      root,
      variant=variant,
      invalid=view::Live::By(eff_inv),
      disabled=view::Live::By(eff_dis),
      pad_x=0.0,
      force_focused=force_focused,
      content=fn(grp : view::View) -> Unit {
        let _ = grp
          .gap(view::Live::Is(0.0))
          .on_key(fn(k : view::Key) -> Bool {
            if k.code == headless_core::key_escape && k.mods == 0 && !eff_dis() && !ro_get() && fld.text() != "" {
              do_clear()
              true
            } else {
              false
            }
          })
        // Search icon (`ms-3 size-4 text-field-placeholder`)
        let _ = grp.box(fn(ic : view::View) -> Unit {
          let _ = ic
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .margin(view::Live::Is((12.0, 0.0, 0.0, 0.0)))
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
          let _ = aura_icon_node(
            ic,
            AuraIconKind::Magnifier,
            size=16.0,
            ink=fn() -> Int64 { aura_theme(ic).palette.field_placeholder },
          )
        })
        // Input (`ps-2 pe-2 flex-1`)
        let _ = grp.box(fn(inp_wrap : view::View) -> Unit {
          let _ = inp_wrap
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .min_width(view::Live::Is(Some(0.0)))
            .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
          let _ = b_mount_ui_field(
            inp_wrap,
            fld,
            placeholder,
            fn() -> String { let l = lbl_get(); if l != "" { l } else { "Search" } },
            false,
            1,
            1,
            eff_dis,
            ro_get,
            false,
            on_change,
            on_submit,
            None,
            Some(20.0),
            loc,
            leaves=[headless_core::key_escape],
          )
        })
        // Clear button (`me-2 size-5` = 20pt circle with 12pt Xmark, hidden when empty)
        let _ = grp.show(
          fn() -> Bool { fld.text() != "" },
          fn(slot : view::View) -> Unit {
            let _ = slot
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .margin(view::Live::Is((0.0, 0.0, 8.0, 0.0)))
              .shrink(view::Live::Is(0.0))
            let _ = headless::button(
              slot,
              fn() -> String { "Clear search" },
              fn(_v : view::View) -> Unit { do_clear() },
              fn(btn : view::View, _b : headless::Button) -> Unit {
                let _ = btn
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .width(view::Live::Is(Some(20.0)))
                  .height(view::Live::Is(Some(20.0)))
                  .shrink(view::Live::Is(0.0))
                  .corner_circular(view::Live::Is(true))
                  .radius(view::Live::Is(10.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    let pal = aura_theme(btn).palette
                    let hov = !eff_dis() && (btn.pressed() || !aura_is_coarse_pointer(btn) && btn.pointed())
                    if hov { pal.default_hover } else { pal.default_bg }
                  }))
                let _ = w0_apply_control_focus_ring(btn)
                let _ = aura_icon_node(
                  btn,
                  AuraIconKind::Xmark,
                  size=12.0,
                  ink=fn() -> Int64 { aura_theme(btn).palette.default_foreground },
                )
              },
              disabled=fn() -> Bool { eff_dis() || ro_get() },
            )
          },
        )
      },
    )
    b_apply_field_surface(shell, variant, eff_inv, eff_dis, force_focused)
    if full_width {
      let _ = shell.fills_across(view::Live::Is(true))
    }
    let _ = root.show(
      fn() -> Bool { !eff_inv() && desc_get() != "" },
      fn(dv : view::View) -> Unit { let _ = description_node(dv, description) },
    )
    let _ = root.show(
      fn() -> Bool { eff_inv() && err_get() != "" },
      fn(ev : view::View) -> Unit { let _ = error_message_node(ev, error) },
    )
  })
}

/// Pion-JSX `<aura::SearchField>` wrapper.
pub fn SearchField(
  parent : view::View,
  field? : ui::Field,
  value~ : String = "",
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into placeholder~ : view::Live[String] = .Is("Search..."),
  placeholder_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  into read_only~ : view::Live[Bool] = .Is(false),
  read_only_by? : () -> Bool,
  force_focused~ : Bool = false,
  on_change~ : (String) -> Unit = fn(_s : String) { () },
  on_submit~ : (String) -> Unit = fn(_s : String) { () },
  on_clear~ : () -> Unit = fn() { () },
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let ph = match placeholder_by { Some(f) => view::Live::By(f); None => placeholder }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  let ro = match read_only_by { Some(f) => view::Live::By(f); None => read_only }
  search_field_node(
    parent,
    field?=field,
    value=value,
    label=l,
    placeholder=ph,
    description=d,
    error=e,
    variant=variant,
    full_width=full_width,
    invalid=inv,
    disabled=dis,
    read_only=ro,
    force_focused=force_focused,
    on_change=on_change,
    on_submit=on_submit,
    on_clear=on_clear,
    loc=loc,
  )
}

// ---------------------------------------------------------------------------
// 6. NumberField (`number_field_node` / `NumberField`)
// ---------------------------------------------------------------------------

/// Formatting preset for `NumberField`.
#derive(Eq)
pub enum AuraNumberFormat {
  Decimal
  Grouped
  Percent
  Currency(String)
}

fn b_number_format_pair(fmt : AuraNumberFormat, precision : Int) -> ((Double) -> String, (String) -> Option[Double]) {
  match fmt {
    AuraNumberFormat::Decimal =>
      (fn(v : Double) -> String { headless::number_format(v, precision) }, headless::number_parse)
    AuraNumberFormat::Grouped =>
      (fn(v : Double) -> String { headless::number_format_grouped(v, precision) }, headless::number_parse_grouped)
    AuraNumberFormat::Percent =>
      (fn(v : Double) -> String { headless::number_format_percent(v, precision) }, headless::number_parse_percent)
    AuraNumberFormat::Currency(sym) =>
      (
        fn(v : Double) -> String { headless::number_format_currency(v, sym, precision) },
        fn(s : String) -> Option[Double] { headless::number_parse_currency(s, sym) },
      )
  }
}

/// Aura `NumberField` numeric stepper input (integrates `headless::number_input`, `scrub_handle`, and format presets).
pub fn number_field_node(
  parent : view::View,
  value : view::Live[Double],
  on_change : (Double) -> Unit,
  label~ : view::Live[String] = view::Live::Is(""),
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  min~ : Double = -1.0e12,
  max~ : Double = 1.0e12,
  step~ : Double = 1.0,
  large_step~ : Double = 10.0,
  precision~ : Int = 0,
  format_preset~ : AuraNumberFormat = AuraNumberFormat::Decimal,
  format? : (Double) -> String,
  parse? : (String) -> Option[Double],
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : view::Live[Bool] = view::Live::Is(false),
  force_focused~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let val_get = value.to_getter()
  let lbl_get = label.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let ro_get = read_only.to_getter()
  let (preset_fmt, preset_parse) = b_number_format_pair(format_preset, precision)
  let fmt_fn = match format { Some(f) => f; None => preset_fmt }
  let parse_fn = match parse { Some(p) => p; None => preset_parse }

  let eff_dis_ref : signals::Ref[() -> Bool] = view::ref_new(dis_get)
  let fld = ui::Field::new(text=fmt_fn(signals::untracked(val_get)))

  headless::number_input(
    parent,
    fn() -> String { let l = lbl_get(); if l != "" { l } else { "Number" } },
    val_get,
    on_change,
    fn(root : view::View, ni : headless::NumberInput) -> Unit {
      let eff_dis = fn() -> Bool { b_effective_disabled(root, dis_get) }
      eff_dis_ref.v = eff_dis
      let eff_inv = fn() -> Bool { inv_get() || err_get() != "" }
      let eff_desc = fn() -> String {
        if eff_inv() && err_get() != "" { err_get() } else { desc_get() }
      }
      if full_width {
        let _ = root.fills_across(view::Live::Is(true))
      }
      // Keep text field synced with formatted value when value signal changes externally or via stepping
      root.reacts(
        fn() -> String { ni.formatted() },
        fn(fmt_txt : String) -> Unit {
          if fld.text() != fmt_txt {
            let matches_val = match parse_fn(fld.text()) {
              Some(pv) => headless::number_round(pv, precision) == ni.value()
              None => false
            }
            if !fld.focused() || !matches_val {
              fld.set(fmt_txt)
            }
          }
        },
        at_start=false,
      )
      // Reactive scrub-to-step label (zero hidden-slot gap)
      let _ = root.show(
        fn() -> Bool { lbl_get() != "" },
        fn(lw : view::View) -> Unit {
          let _ = lw.padding(view::Live::Is((0.0, 0.0, 0.0, 4.0)))
          let _ = ni.scrub_handle(lw, fn(lv : view::View, _st : headless_core::ScrubStepper) -> Unit {
            let _ = label_node(lv, label, disabled=view::Live::By(eff_dis))
          })
        },
      )
      let lo_bound = if min <= max { min } else { max }
      let hi_bound = if min <= max { max } else { min }
      let shell = w0_field_shell(
        root,
        variant=variant,
        invalid=view::Live::By(eff_inv),
        disabled=view::Live::By(eff_dis),
        pad_x=0.0,
        force_focused=force_focused,
        content=fn(grp : view::View) -> Unit {
          let _ = grp.gap(view::Live::Is(0.0)).clips(view::Live::Is(true))
          let divider_color = fn() -> Int64 {
            b_with_alpha(aura_theme(grp).palette.field_placeholder, 0x26L)
          }
          // Decrement button (`w-10 h-full`, tabIndex=-1 so whole NumberField has a single Tab stop)
          let dec_btn = ni.decrement_button(
            grp,
            fn(btn : view::View, _b : headless::Button) -> Unit {
              let _ = btn
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .width(view::Live::Is(Some(39.0)))
                .height(view::Live::By(fn() -> Option[Double] { Some(if aura_is_md(btn) { 36.0 } else { 40.0 }) }))
                .shrink(view::Live::Is(0.0))
                .ground(view::Live::By(fn() -> Int64 {
                  if btn.pressed() && ni.can_decrement() {
                    b_with_alpha(aura_theme(btn).palette.field_foreground, 0x1AL)
                  } else {
                    0x00000000L
                  }
                }))
                .group_alpha(view::Live::By(fn() -> Double {
                  if !ni.can_decrement() && !eff_dis() { aura_theme(btn).disabled_opacity } else { 1.0 }
                }))
              let _ = b_minus_icon(btn, size=16.0, fn() -> Int64 { aura_theme(btn).palette.field_foreground })
            },
          )
          let _ = dec_btn.focusable(view::Live::Is(false))
          // Left hairline divider
          let _ = grp.box(fn(sep : view::View) -> Unit {
            let _ = sep
              .width(view::Live::Is(Some(1.0)))
              .height(view::Live::By(fn() -> Option[Double] { Some(if aura_is_md(sep) { 36.0 } else { 40.0 }) }))
              .shrink(view::Live::Is(0.0))
              .points(view::Live::Is(false))
              .ground(view::Live::By(divider_color))
          })
          // Center input (`flex-1 px-3`), wired directly to `headless::NumberInput::input`
          let _ = grp.box(fn(inp_wrap : view::View) -> Unit {
            let _ = inp_wrap
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .grow(view::Live::Is(1.0))
              .shrink(view::Live::Is(1.0))
              .min_width(view::Live::Is(Some(0.0)))
              .pad_xy(12.0, 0.0)
            let fnode = b_mount_ui_field(
              inp_wrap,
              fld,
              view::Live::Is(""),
              fn() -> String { let l = lbl_get(); if l != "" { l } else { "Number" } },
              false,
              1,
              1,
              eff_dis,
              ro_get,
              false,
              fn(raw : String) -> Unit {
                let _ = ni.commit_text(raw)
              },
              fn(raw : String) -> Unit {
                if !ni.commit_text(raw) {
                  fld.set(ni.formatted())
                }
              },
              None,
              Some(20.0),
              loc,
              description_get=eff_desc,
              leaves=[
                headless_core::key_up,
                headless_core::key_down,
                headless_core::key_page_up,
                headless_core::key_page_down,
                headless_core::key_home,
                headless_core::key_end,
              ],
            )
            let _ = ni.input(fnode, fn(_v : view::View, _n : headless::NumberInput) -> Unit { () }, in_node=true)
            let _ = fnode
              .says(view::Live::By(fn() -> Option[view::Said] {
                let l = lbl_get()
                let lbl = if l != "" { l } else { "Number" }
                let cur = ni.value()
                let acts : Array[view::Action] = if eff_dis() || ro_get() {
                  []
                } else {
                  [view::Action::SetText(""), view::Action::Increment, view::Action::Decrement]
                }
                Some(view::said(
                  view::Role::SpinButton,
                  label=lbl,
                  description=eff_desc(),
                  value=ni.formatted(),
                  range=(lo_bound, cur, hi_bound),
                  actions=acts,
                ))
              }))
            fnode.reacts(
              fn() -> Bool { fnode.focused() },
              fn(foc : Bool) -> Unit {
                if !foc {
                  let fmt_txt = ni.formatted()
                  if fld.text() != fmt_txt {
                    fld.set(fmt_txt)
                  }
                }
              },
              at_start=false,
            )
          })
          // Right hairline divider
          let _ = grp.box(fn(sep : view::View) -> Unit {
            let _ = sep
              .width(view::Live::Is(Some(1.0)))
              .height(view::Live::By(fn() -> Option[Double] { Some(if aura_is_md(sep) { 36.0 } else { 40.0 }) }))
              .shrink(view::Live::Is(0.0))
              .points(view::Live::Is(false))
              .ground(view::Live::By(divider_color))
          })
          // Increment button (`w-10 h-full`, tabIndex=-1 so whole NumberField has a single Tab stop)
          let inc_btn = ni.increment_button(
            grp,
            fn(btn : view::View, _b : headless::Button) -> Unit {
              let _ = btn
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .width(view::Live::Is(Some(39.0)))
                .height(view::Live::By(fn() -> Option[Double] { Some(if aura_is_md(btn) { 36.0 } else { 40.0 }) }))
                .shrink(view::Live::Is(0.0))
                .ground(view::Live::By(fn() -> Int64 {
                  if btn.pressed() && ni.can_increment() {
                    b_with_alpha(aura_theme(btn).palette.field_foreground, 0x1AL)
                  } else {
                    0x00000000L
                  }
                }))
                .group_alpha(view::Live::By(fn() -> Double {
                  if !ni.can_increment() && !eff_dis() { aura_theme(btn).disabled_opacity } else { 1.0 }
                }))
              let _ = aura_icon_node(
                btn,
                AuraIconKind::Plus,
                size=16.0,
                ink=fn() -> Int64 { aura_theme(btn).palette.field_foreground },
              )
            },
          )
          let _ = inc_btn.focusable(view::Live::Is(false))
        },
      )
      b_apply_field_surface(shell, variant, eff_inv, eff_dis, force_focused)
      if full_width {
        let _ = shell.fills_across(view::Live::Is(true))
      }
      let _ = root.show(
        fn() -> Bool { !eff_inv() && desc_get() != "" },
        fn(dv : view::View) -> Unit {
          let _ = dv.padding(view::Live::Is((0.0, 4.0, 0.0, 0.0)))
          let _ = description_node(dv, description)
        },
      )
      let _ = root.show(
        fn() -> Bool { eff_inv() && err_get() != "" },
        fn(ev : view::View) -> Unit {
          let _ = ev.padding(view::Live::Is((0.0, 4.0, 0.0, 0.0)))
          let _ = error_message_node(ev, error)
        },
      )
    },
    min=min,
    max=max,
    step=step,
    large_step=large_step,
    precision=precision,
    format=fmt_fn,
    parse=parse_fn,
    disabled=fn() -> Bool { (eff_dis_ref.v)() },
    read_only=ro_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::NumberField>` wrapper.
pub fn NumberField(
  parent : view::View,
  into value~ : view::Live[Double] = .Is(0.0),
  value_by? : () -> Double,
  on_change~ : (Double) -> Unit = fn(_v : Double) { () },
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  min~ : Double = -1.0e12,
  max~ : Double = 1.0e12,
  step~ : Double = 1.0,
  large_step~ : Double = 10.0,
  precision~ : Int = 0,
  format_preset~ : AuraNumberFormat = AuraNumberFormat::Decimal,
  format? : (Double) -> String,
  parse? : (String) -> Option[Double],
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  into read_only~ : view::Live[Bool] = .Is(false),
  read_only_by? : () -> Bool,
  force_focused~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let v = match value_by { Some(f) => view::Live::By(f); None => value }
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  let ro = match read_only_by { Some(f) => view::Live::By(f); None => read_only }
  number_field_node(
    parent,
    v,
    on_change,
    label=l,
    description=d,
    error=e,
    min=min,
    max=max,
    step=step,
    large_step=large_step,
    precision=precision,
    format_preset=format_preset,
    format?=format,
    parse?=parse,
    variant=variant,
    full_width=full_width,
    invalid=inv,
    disabled=dis,
    read_only=ro,
    force_focused=force_focused,
    loc=loc,
  )
}

// ---------------------------------------------------------------------------
// 7. InputOTP (`input_otp_node` / `InputOTP` + Group / Slot / Separator)
// ---------------------------------------------------------------------------

struct BInputOtpCtx {
  otp : headless::InputOtp
  variant : AuraFieldVariant
  disabled_get : () -> Bool
  invalid_get : () -> Bool
}

let b_input_otp_lent : view::Lent[BInputOtpCtx] = view::Lent::new()

/// Aura `InputOTP` root holding a single real `ui::Field` bridged to `headless::InputOtp`.
pub fn input_otp_node(
  parent : view::View,
  max_length~ : Int = 6,
  value~ : String = "",
  field? : ui::Field,
  allow~ : (Int) -> Bool = headless_core::otp_is_digit,
  label~ : String = "Verification code",
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  on_change~ : (String) -> Unit = fn(_s : String) { () },
  on_complete~ : (String) -> Unit = fn(_s : String) { () },
  content? : (view::View, headless::InputOtp) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let eff_dis_ref : signals::Ref[() -> Bool] = view::ref_new(dis_get)
  let otp = headless::InputOtp::new(
    max_length,
    value=value,
    allow=allow,
    label=fn() -> String { label },
    disabled=fn() -> Bool { (eff_dis_ref.v)() },
    invalid=inv_get,
    on_change=on_change,
    on_complete=on_complete,
  )
  let fld = match field {
    Some(f) => f
    None => ui::Field::new(text=otp.value())
  }
  otp.root(
    parent,
    fn(root : view::View, ctrl : headless::InputOtp) -> Unit {
      let eff_dis = fn() -> Bool { b_effective_disabled(root, dis_get) }
      eff_dis_ref.v = eff_dis
      let _ = root
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(8.0))
        .group_alpha(view::Live::By(fn() -> Double {
          if eff_dis() { aura_theme(root).disabled_opacity } else { 1.0 }
        }))
        .lends(
          b_input_otp_lent,
          BInputOtpCtx::{ otp: ctrl, variant, disabled_get: eff_dis, invalid_get: inv_get },
        )
      match content {
        Some(c) => c(root, ctrl)
        None => {
          let _ = input_otp_group_node(root, content=fn(g : view::View) -> Unit {
            for i in 0..<max_length {
              let _ = input_otp_slot_node(g, i)
            }
          })
        }
      }
      // Mount the single hidden real `ui::Field` after visible slots so hit/text lookup resolves slots first.
      let _ = root.box(fn(hidden_host : view::View) -> Unit {
        let _ = hidden_host
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .width(view::Live::Is(Some(1.0)))
          .height(view::Live::Is(Some(1.0)))
          .clips(view::Live::Is(true))
          .points(view::Live::Is(false))
          .group_alpha(view::Live::Is(0.0))
        let fview = ui::field(
          hidden_host,
          fld,
          label=label,
          max_lines=1,
          colors_by=fn() -> (Int64, Int64, Int64) { (0x00000000L, 0x00000000L, 0x00000000L) },
          edit=fn(e : ui::FieldEdit) -> Unit {
            if eff_dis() {
              if fld.text() != e.was {
                fld.set(e.was)
              }
              return
            }
            let (s0, s1) = fld.selection()
            ctrl.commit_text(e.now, selection_start=s0, selection_end=s1)
            let norm = ctrl.value()
            if fld.text() != norm {
              let caret = if s0 <= norm.length() { s0 } else { norm.length() }
              fld.set(norm, caret=caret)
            }
          },
          pasted=fn(clip : String) -> Unit {
            if !eff_dis() {
              ctrl.paste(clip)
              let norm = ctrl.value()
              fld.set(norm, caret=norm.length())
            }
          },
        )
        let _ = fview
          .focusable(view::Live::By(fn() -> Bool { !eff_dis() }), keys=view::focus_enter | view::focus_space)
          .presses(view::Live::By(fn() -> Bool { !eff_dis() }))
          .says(view::Live::By(fn() -> Option[view::Said] {
            let acts : Array[view::Action] = if eff_dis() { [] } else { [view::Action::SetText("")] }
            Some(view::said(view::Role::TextField, label=label, value=ctrl.value(), actions=acts))
          }))
        ctrl.set_focus_target(fn() -> Bool {
          if eff_dis() {
            false
          } else {
            fld.focus()
            let _ = fview.ask_focus()
            let idx = ctrl.active_index()
            let len = ctrl.value().length()
            if idx >= 0 && idx < len {
              fld.pick(idx, idx + 1)
            } else {
              fld.pick(len, len)
            }
            true
          }
        })
        fview.reacts(
          fn() -> Bool { fview.focused() || fld.focused() },
          fn(foc : Bool) -> Unit {
            ctrl.set_focused(foc)
            if fview.focused() && !fld.focused() && !eff_dis() {
              fld.focus()
            }
          },
        )
        fview.reacts_by(
          fn() -> (Int, Int) { fld.selection() },
          fn(a : (Int, Int), b : (Int, Int)) -> Bool { a.0 == b.0 && a.1 == b.1 },
          fn(sel : (Int, Int)) -> Unit {
            ctrl.set_selection(sel.0, sel.1)
          },
          at_start=false,
        )
      })
    },
    owns_focus=false,
    loc=loc,
  )
}

/// Pion-JSX `<aura::InputOTP>` wrapper.
pub fn InputOTP(
  parent : view::View,
  max_length~ : Int = 6,
  value~ : String = "",
  field? : ui::Field,
  allow~ : (Int) -> Bool = headless_core::otp_is_digit,
  label~ : String = "Verification code",
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  on_change~ : (String) -> Unit = fn(_s : String) { () },
  on_complete~ : (String) -> Unit = fn(_s : String) { () },
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  let c = match children {
    Some(ch) => Some(fn(v : view::View, _o : headless::InputOtp) -> Unit { ch(v) })
    None => None
  }
  input_otp_node(
    parent,
    max_length=max_length,
    value=value,
    field?=field,
    allow=allow,
    label=label,
    variant=variant,
    invalid=inv,
    disabled=dis,
    on_change=on_change,
    on_complete=on_complete,
    content?=c,
    loc=loc,
  )
}

/// Aura `InputOTPGroup` row of OTP slots (`gap-2` = 8pt).
pub fn input_otp_group_node(
  parent : view::View,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(8.0))
    content(node)
  })
}

/// Pion-JSX `<aura::InputOTPGroup>` wrapper.
pub fn InputOTPGroup(
  parent : view::View,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  input_otp_group_node(parent, content=children, loc=loc)
}

/// Aura `InputOTPSlot` (`38x40pt`, `rounded-field` 12pt, `text-lg` 18pt semibold, active ring + fake caret).
pub fn input_otp_slot_node(
  parent : view::View,
  index : Int,
  loc~ : String = "",
) -> view::View {
  match parent.lent(b_input_otp_lent) {
    Some(ctx) => {
      let variant = ctx.variant
      let dis_get = ctx.disabled_get
      let inv_get = ctx.invalid_get
      ctx.otp.slot_node(
        parent,
        index,
        fn(slot : view::View, get_slot : () -> headless_core::OtpSlot) -> Unit {
          let _ = slot
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .width(view::Live::Is(Some(38.0)))
            .height(view::Live::Is(Some(40.0)))
            .shrink(view::Live::Is(0.0))
            .corner_circular(view::Live::Is(true))
            .radius(view::Live::By(fn() -> Double { aura_theme(slot).field_radius }))
            .ground(view::Live::By(fn() -> Int64 {
              let pal = aura_theme(slot).palette
              let st = get_slot()
              let dis = dis_get()
              let hov = !dis && !aura_is_coarse_pointer(slot) && slot.pointed()
              let inv = inv_get()
              b_field_variant_bg(slot, pal, variant, hov, st.is_active, inv)
            }))
            .shadows(view::Live::By(fn() -> Array[view::Shadow] {
              if aura_field_effective_variant(slot, variant) is AuraFieldVariant::Primary {
                aura_surface_shadows(aura_theme(slot).config.dark)
              } else {
                []
              }
            }))
            .ring(view::Live::By(fn() -> (Double, Double, Int64) {
              let st = get_slot()
              let inv = inv_get()
              let th = aura_theme(slot)
              if inv && st.is_active {
                (2.0, 0.0, th.palette.danger)
              } else if inv {
                (1.0, 0.0, th.palette.danger)
              } else if st.is_active {
                (2.0, 0.0, th.palette.focus)
              } else {
                (0.0, 0.0, 0L)
              }
            }))
            .ring_gap_color(view::Live::Is(0L))
          // Character glyph (`text-lg leading-6 font-semibold`)
          let _ = slot.show(
            fn() -> Bool { get_slot().char != "" },
            fn(ch : view::View) -> Unit {
              let _ = ch
                .points(view::Live::Is(false))
                .words_centered(view::Live::Is(true))
                .words(
                  view::Live::By(fn() -> String { get_slot().char }),
                  look=b_words_look(18.0, 600, 24.0, false),
                )
                .ink(view::Live::By(fn() -> Int64 { aura_theme(ch).palette.field_foreground }))
            },
          )
          // Fake caret when slot is active and empty
          let _ = slot.show(
            fn() -> Bool { get_slot().has_fake_caret },
            fn(caret : view::View) -> Unit {
              let _ = caret
                .width(view::Live::Is(Some(2.0)))
                .height(view::Live::Is(Some(16.0)))
                .corner_circular(view::Live::Is(true))
                .radius(view::Live::Is(1.0))
                .points(view::Live::Is(false))
                .ground(view::Live::By(fn() -> Int64 { aura_theme(caret).palette.field_placeholder }))
            },
          )
        },
        loc=loc,
      )
    }
    None => parent.box(loc=loc, fn(_v : view::View) -> Unit { () })
  }
}

/// Pion-JSX `<aura::InputOTPSlot>` wrapper.
pub fn InputOTPSlot(
  parent : view::View,
  index~ : Int = 0,
  loc~ : String = "",
) -> view::View {
  input_otp_slot_node(parent, index, loc=loc)
}

/// Aura `InputOTPSeparator` (`6x2pt`, `rounded-sm`, `bg-separator`).
pub fn input_otp_separator_node(
  parent : view::View,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .width(view::Live::Is(Some(6.0)))
      .height(view::Live::Is(Some(2.0)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .corner_circular(view::Live::Is(true))
      .radius(view::Live::Is(1.0))
      .ground(view::Live::By(fn() -> Int64 { aura_theme(node).palette.separator }))
  })
}

/// Pion-JSX `<aura::InputOTPSeparator>` wrapper.
pub fn InputOTPSeparator(
  parent : view::View,
  loc~ : String = "",
) -> view::View {
  input_otp_separator_node(parent, loc=loc)
}

// ---------------------------------------------------------------------------
// 8. Fieldset (`fieldset_node` / `Fieldset` + Legend / Description / Group / Actions)
// ---------------------------------------------------------------------------

/// Aura `Fieldset` container with group-level disabled inheritance via `headless::fieldset`.
pub fn fieldset_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is(""),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  gap~ : Double = 24.0,
  content~ : (view::View, headless::Fieldset) -> Unit = fn(_v : view::View, _fs : headless::Fieldset) { () },
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let dis_get = disabled.to_getter()
  headless::fieldset(
    parent,
    lbl_get,
    fn(node : view::View, fs : headless::Fieldset) -> Unit {
      let _ = node
        .gap(view::Live::Is(gap))
        .fills_across(view::Live::Is(true))
      content(node, fs)
    },
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Fieldset>` wrapper.
pub fn Fieldset(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  gap~ : Double = 24.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  fieldset_node(
    parent,
    label=l,
    disabled=dis,
    gap=gap,
    content=fn(v : view::View, _fs : headless::Fieldset) -> Unit { children(v) },
    loc=loc,
  )
}

/// Aura `FieldsetLegend` (`text-base font-medium text-foreground` = 16pt/24pt Medium).
pub fn fieldset_legend_node(
  parent : view::View,
  text : view::Live[String],
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(w : view::View) -> Unit {
    let _ = w
      .words(text, look=b_words_look(16.0, 500, 24.0, false))
      .ink(view::Live::By(fn() -> Int64 { aura_theme(w).palette.foreground }))
  })
}

/// Pion-JSX `<aura::FieldsetLegend>` wrapper.
pub fn FieldsetLegend(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  fieldset_legend_node(parent, t, loc=loc)
}

/// Aura `FieldsetDescription` (delegates to `description_node`).
pub fn fieldset_description_node(
