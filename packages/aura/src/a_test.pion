// Track 1A unit tests for packages/aura: Card (+ slots & SurfaceContext), Header, Typography,
// Kbd (+ KbdAbbr/KbdContent), EmptyState, ButtonGroup, ToggleButton, ToggleButtonGroup, Toolbar, Link.
// Covers both Builder and Pion-JSX APIs, headless keyboard/roving semantics, circular corners,
// and `aura::assert_aura_ui` across light and dark themes.

import "halt"
import "headless_core"
import "signals"
import "ui"
import "view"

fn a_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("a_test", msg)
  }
}

fn a_unwrap_tree(opt : Option[view::Tree]) -> view::Tree {
  match opt {
    Some(tr) => tr
    None => halt::saying("a_test", "missing tree")
  }
}

fn a_key_code(name : String) -> Int {
  match name {
    "Right" => headless_core::key_right
    "Left" => headless_core::key_left
    "Down" => headless_core::key_down
    "Up" => headless_core::key_up
    "Enter" => headless_core::key_enter
    "Space" => headless_core::key_space
    _ => 0
  }
}

test "a_card_variants_slots_and_surface_context_lending" {
  let seen_default = signals::signal(AuraSurfaceLevel::Transparent)
  let seen_secondary = signals::signal(AuraSurfaceLevel::Transparent)
  let seen_tertiary = signals::signal(AuraSurfaceLevel::Transparent)
  let seen_transparent = signals::signal(AuraSurfaceLevel::Transparent)
  let cfg = signals::signal(AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::By(fn() -> Int64 { aura_theme(root).palette.background })).pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = card_node(root, variant=AuraSurfaceVariant::Default, content=fn(c : view::View) -> Unit {
      let _ = card_header_node(c, content=fn(h : view::View) -> Unit {
        let _ = card_title_node(h, view::Live::Is("Deployment Ready"))
        let _ = card_description_node(h, view::Live::Is("All checks passed."))
      })
      let _ = card_content_node(c, content=fn(body : view::View) -> Unit {
        seen_default.set(aura_surface_level_of(body))
        let _ = description_node(body, view::Live::Is("Verified in 14.2s."))
      })
      let _ = card_footer_node(c, content=fn(f : view::View) -> Unit {
        let _ = button_node(f, view::Live::Is("Details"), variant=AuraButtonVariant::Tertiary, size=AuraButtonSize::Sm)
        let _ = button_node(f, view::Live::Is("Deploy"), variant=AuraButtonVariant::Primary, size=AuraButtonSize::Sm)
      })
    })
    let _ = card_node(root, variant=AuraSurfaceVariant::Secondary, content=fn(c : view::View) -> Unit {
      seen_secondary.set(aura_surface_level_of(c))
      // Transparent card nested inside Secondary must inherit Secondary!
      let _ = card_node(c, variant=AuraSurfaceVariant::Transparent, content=fn(inner : view::View) -> Unit {
        seen_transparent.set(aura_surface_level_of(inner))
        let _ = card_title_node(inner, view::Live::Is("Transparent Child"))
      })
    })
    let _ = card_node(root, variant=AuraSurfaceVariant::Tertiary, content=fn(c : view::View) -> Unit {
      seen_tertiary.set(aura_surface_level_of(c))
      let _ = card_title_node(c, view::Live::Is("Tertiary Card"))
    })
  }, width=600.0, height=600.0)
  a_assert(seen_default.get() == AuraSurfaceLevel::Primary, "Default card must lend Primary surface context")
  a_assert(seen_secondary.get() == AuraSurfaceLevel::Secondary, "Secondary card must lend Secondary surface context")
  a_assert(seen_tertiary.get() == AuraSurfaceLevel::Tertiary, "Tertiary card must lend Tertiary surface context")
  a_assert(seen_transparent.get() == AuraSurfaceLevel::Secondary, "Transparent card must inherit enclosing Secondary context")
  assert_aura_ui(t, label="a_card_light")
  cfg.set(AuraConfig::dark())
  t.frame(ms=16.0)
  assert_aura_ui(t, label="a_card_dark")
  t.dispose()
}

test "a_header_empty_state_typography_and_kbd" {
  a_assert(aura_kbd_key_symbol(AuraKbdKey::Command) == "⌘", "Command symbol")
  a_assert(aura_kbd_key_label(AuraKbdKey::Command) == "Command", "Command label")
  a_assert(aura_kbd_key_symbol(AuraKbdKey::Enter) == "↵", "Enter symbol")
  a_assert(aura_kbd_key_symbol(AuraKbdKey::Shift) == "⇧", "Shift symbol")
  a_assert(aura_kbd_key_symbol(AuraKbdKey::Escape) == "⎋", "Escape symbol")

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(20.0)).gap(view::Live::Is(8.0))
    let _ = header_node(root, view::Live::Is("Section Header"))
    let _ = typography_node(root, view::Live::Is("Heading 1"), kind=AuraTypographyType::H1)
    let _ = typography_node(root, view::Live::Is("Heading 2"), kind=AuraTypographyType::H2)
    let _ = typography_node(root, view::Live::Is("Heading 3"), kind=AuraTypographyType::H3)
    let _ = typography_node(root, view::Live::Is("Heading 4"), kind=AuraTypographyType::H4)
    let _ = typography_node(root, view::Live::Is("Body text"), kind=AuraTypographyType::Body)
    let _ = typography_node(root, view::Live::Is("Muted text"), kind=AuraTypographyType::Muted)
    let _ = typography_node(root, view::Live::Is("Small text"), kind=AuraTypographyType::Small)
    let _ = typography_node(root, view::Live::Is("const x = 1;"), kind=AuraTypographyType::Code)
    let _ = kbd_node(root, content=fn(k : view::View) -> Unit {
      let _ = kbd_abbr_node(k, AuraKbdKey::Command)
      let _ = kbd_content_node(k, view::Live::Is("K"))
    })
    let _ = kbd_node(root, variant=AuraKbdVariant::Light, content=fn(k : view::View) -> Unit {
      let _ = kbd_abbr_node(k, AuraKbdKey::Shift)
      let _ = kbd_content_node(k, view::Live::Is("P"))
    })
    let _ = empty_state_node(
      root,
      title=view::Live::Is("No items found"),
      description=view::Live::Is("Try adjusting your filters."),
    )
  }, width=600.0, height=700.0)
  assert_aura_ui(t, label="a_header_empty_typo_kbd")
  t.dispose()
}

test "a_button_group_corners_separators_and_full_width" {
  let clicks = signals::signal(0)
  let cfg = signals::signal(AuraConfig::light())
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(20.0)).gap(view::Live::Is(16.0))
    let _ = button_group_node(root, label="Align", variant=AuraButtonVariant::Secondary, content=fn(g : view::View) -> Unit {
      let _ = button_group_item_node(g, view::Live::Is("Left"), 0, 3, on_press=fn() { clicks.set(clicks.get() + 1) })
      let _ = button_group_item_node(g, view::Live::Is("Center"), 1, 3, on_press=fn() { clicks.set(clicks.get() + 10) })
      let _ = button_group_item_node(g, view::Live::Is("Right"), 2, 3, on_press=fn() { clicks.set(clicks.get() + 100) })
    })
    let _ = button_group_node(
      root,
      label="Vertical Group",
      orientation=AuraOrientation::Vertical,
      full_width=true,
      hide_separator=true,
      content=fn(g : view::View) -> Unit {
        let _ = button_group_item_node(g, view::Live::Is("Top"), 0, 2)
        let _ = button_group_item_node(g, view::Live::Is("Bottom"), 1, 2)
      },
    )
  }, width=500.0, height=400.0)
  let tr = a_unwrap_tree(tree_ref.v)
  let sc = ui::encode_tree_scene(tr, 500.0, 400.0, 2.0, 0.0)
  let mut found_first = false
  let mut found_last = false
  let mut i = 0
  while i < sc.ninst {
    if (sc.inst[i * 60 + 5] + 0.5).to_int() == 0 {
      let tl = sc.inst[i * 60 + 36]
      let tr_c = sc.inst[i * 60 + 37]
      let br = sc.inst[i * 60 + 38]
      let bl = sc.inst[i * 60 + 39]
      if tl == 18.0 && tr_c == 0.0 && br == 0.0 && bl == 18.0 {
        found_first = true
      }
      if tl == 0.0 && tr_c == 18.0 && br == 18.0 && bl == 0.0 {
        found_last = true
      }
    }
    i += 1
  }
  a_assert(found_first, "ButtonGroup first item must default to smooth corners (18, 0, 0, 18)")
  a_assert(found_last, "ButtonGroup last item must default to smooth corners (0, 18, 18, 0)")
  cfg.set(AuraConfig::light(corner_circular=true))
  let sc_c = ui::encode_tree_scene(tr, 500.0, 400.0, 2.0, 16.0)
  let mut found_first_c = false
  let mut found_last_c = false
  let mut j = 0
  while j < sc_c.ninst {
    if (sc_c.inst[j * 60 + 5] + 0.5).to_int() == 0 {
      let tl = sc_c.inst[j * 60 + 36]
      let tr_c = sc_c.inst[j * 60 + 37]
      let br = sc_c.inst[j * 60 + 38]
      let bl = sc_c.inst[j * 60 + 39]
      if tl == -18.0 && tr_c == 0.0 && br == 0.0 && bl == -18.0 {
        found_first_c = true
      }
      if tl == 0.0 && tr_c == -18.0 && br == -18.0 && bl == 0.0 {
        found_last_c = true
      }
    }
    j += 1
  }
  a_assert(found_first_c, "ButtonGroup first item must switch to circular corners (-18, 0, 0, -18) when corner_circular=true")
  a_assert(found_last_c, "ButtonGroup last item must switch to circular corners (0, -18, -18, 0) when corner_circular=true")
  t.press("Center")
  a_assert(clicks.get() == 10, "Center press should increment clicks by 10")
  assert_aura_ui(t, label="a_button_group")
  t.dispose()
}

test "a_toggle_button_and_toggle_button_group_roving_and_modes" {
  let bold = signals::signal(false)
  let disabled_on = signals::signal(false)
  let single_sel = signals::signal("L")
  let multi_a = signals::signal(true)
  let multi_b = signals::signal(false)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let first_single_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let second_single_node : signals::Ref[Option[view::View]] = view::ref_new(None)
  let third_single_node : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    let _ = toggle_button_node(
      root,
      view::Live::Is("Bold"),
      fn() { bold.get() },
      on_change=fn(v : Bool) { bold.set(v) },
    )
    let _ = toggle_button_node(
      root,
      view::Live::Is("Locked"),
      fn() { disabled_on.get() },
      on_change=fn(v : Bool) { disabled_on.set(v) },
      disabled=view::Live::Is(true),
    )
    let _ = toggle_button_group_node(
      root,
      view::Live::Is("Text Align"),
      fn(k : String) -> Bool { single_sel.get() == k },
      fn(k : String, on : Bool) -> Unit {
        if on {
          single_sel.set(k)
        }
      },
      fn(g : view::View, grp : AuraToggleGroup[String]) -> Unit {
        first_single_node.v = Some(grp.item(g, "L", view::Live::Is("Align Left"), index=0, total=3))
        second_single_node.v = Some(grp.item(g, "C", view::Live::Is("Align Center"), index=1, total=3))
        third_single_node.v = Some(grp.item(g, "R", view::Live::Is("Align Right"), index=2, total=3))
      },
      mode=AuraSelectionMode::Single,
    )
    let _ = toggle_button_group_node(
      root,
      view::Live::Is("Formatting"),
      fn(k : String) -> Bool { if k == "A" { multi_a.get() } else { multi_b.get() } },
      fn(k : String, on : Bool) -> Unit {
        if k == "A" { multi_a.set(on) } else { multi_b.set(on) }
      },
      fn(g : view::View, grp : AuraToggleGroup[String]) -> Unit {
        let _ = grp.item(g, "A", view::Live::Is("Italic"), index=0, total=2)
        let _ = grp.item(g, "B", view::Live::Is("Underline"), index=1, total=2)
      },
      mode=AuraSelectionMode::Multiple,
      detached=true,
    )
  }, width=600.0, height=400.0)
  let tr = a_unwrap_tree(tree_ref.v)

  // ToggleButton click toggles state
  a_assert(!bold.get(), "Bold starts unselected")
  t.press("Bold")
  a_assert(bold.get(), "Bold should be selected after press")
  t.press("Bold")
  a_assert(!bold.get(), "Bold should be unselected after second press")

  // Disabled ToggleButton ignores press
  t.press("Locked")
  a_assert(!disabled_on.get(), "Disabled ToggleButton must not toggle")

  // ToggleButtonGroup Single mode + keyboard arrow roving
  match first_single_node.v {
    Some(n) => { let _ = tr.focus_to(Some(n.id()), visible=true) }
    None => a_assert(false, "missing first toggle item")
  }
  t.frame(ms=16.0)
  t.key(a_key_code("Right"))
  t.frame(ms=32.0)
  match second_single_node.v {
    Some(n) => a_assert(n.focused(), "ArrowRight must rove focus to second ToggleButtonGroup item")
    None => a_assert(false, "missing second toggle item")
  }
  t.key(a_key_code("Space"))
  t.frame(ms=48.0)
  a_assert(single_sel.get() == "C", "Space on roved ToggleButtonGroup item must select C")
  t.key(a_key_code("Right"))
  t.frame(ms=64.0)
  match third_single_node.v {
    Some(n) => a_assert(n.focused(), "ArrowRight must rove focus to third ToggleButtonGroup item")
    None => a_assert(false, "missing third toggle item")
  }

  // ToggleButtonGroup Multiple mode
  t.press("Underline")
  a_assert(multi_a.get() && multi_b.get(), "Multiple mode must allow both A and B selected simultaneously")

  assert_aura_ui(t, label="a_toggle_button_and_group")
  t.dispose()
}

test "a_toolbar_horizontal_and_vertical_roving_and_link_enter_only" {
  let cut_n = signals::signal(0)
  let paste_n = signals::signal(0)
  let link_n = signals::signal(0)
  let dis_link_n = signals::signal(0)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let tb_h_ref : signals::Ref[Option[AuraToolbar]] = view::ref_new(None)
  let tb_v_ref : signals::Ref[Option[AuraToolbar]] = view::ref_new(None)
  let copy_v : signals::Ref[Option[view::View]] = view::ref_new(None)
  let v2_v : signals::Ref[Option[view::View]] = view::ref_new(None)
  let link_v : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(20.0)).gap(view::Live::Is(16.0))
    let _ = toolbar_node(root, label=view::Live::Is("Edit Actions"), attached=true, content=fn(bar : view::View, tb : AuraToolbar) -> Unit {
      tb_h_ref.v = Some(tb)
      let _ = tb.button(bar, view::Live::Is("Cut"), on_press=fn() { cut_n.set(cut_n.get() + 1) })
      copy_v.v = Some(tb.button(bar, view::Live::Is("Copy")))
      let _ = tb.separator(bar)
      let _ = tb.button(bar, view::Live::Is("Paste"), variant=AuraButtonVariant::Primary, on_press=fn() { paste_n.set(paste_n.get() + 1) })
    })
    let _ = toolbar_node(root, label=view::Live::Is("Vertical Tools"), orientation=AuraOrientation::Vertical, content=fn(bar : view::View, tb : AuraToolbar) -> Unit {
      tb_v_ref.v = Some(tb)
      let _ = tb.button(bar, view::Live::Is("Tool 1"))
      let _ = tb.separator(bar)
      v2_v.v = Some(tb.button(bar, view::Live::Is("Tool 2")))
    })
    link_v.v = Some(link_node(
      root,
      view::Live::Is("Documentation"),
      href=view::Live::Is("https://example.dev/docs"),
      external=true,
      on_press=fn() { link_n.set(link_n.get() + 1) },
    ))
    let _ = link_node(
      root,
      view::Live::Is("Disabled Link"),
      disabled=view::Live::Is(true),
      on_press=fn() { dis_link_n.set(dis_link_n.get() + 1) },
    )
  }, width=600.0, height=500.0)
  let tr = a_unwrap_tree(tree_ref.v)

  // Horizontal toolbar roving
  match tb_h_ref.v {
    Some(tb) => a_assert(tb.focus_stop(visible=true), "Horizontal toolbar focus_stop")
    None => a_assert(false, "missing horizontal toolbar")
  }
  t.frame(ms=16.0)
  t.key(a_key_code("Right"))
  t.frame(ms=32.0)
  match copy_v.v {
    Some(v) => a_assert(v.focused(), "Horizontal Toolbar ArrowRight must move focus to Copy")
    None => a_assert(false, "missing Copy node")
  }

  // Vertical toolbar roving
  match tb_v_ref.v {
    Some(tb) => a_assert(tb.focus_stop(visible=true), "Vertical toolbar focus_stop")
    None => a_assert(false, "missing vertical toolbar")
  }
  t.frame(ms=48.0)
  t.key(a_key_code("Down"))
  t.frame(ms=64.0)
  match v2_v.v {
    Some(v) => a_assert(v.focused(), "Vertical Toolbar ArrowDown must move focus to Tool 2")
    None => a_assert(false, "missing Tool 2 node")
  }

  // Link: Enter activates, Space does NOT activate, disabled ignores press
  match link_v.v {
    Some(v) => { let _ = tr.focus_to(Some(v.id()), visible=true) }
    None => a_assert(false, "missing Link node")
  }
  t.frame(ms=80.0)
  t.key(a_key_code("Space"))
  a_assert(link_n.get() == 0, "ARIA Link must NOT activate on Space")
  t.key(a_key_code("Enter"))
  a_assert(link_n.get() == 1, "ARIA Link must activate on Enter")
  t.press("Documentation")
  a_assert(link_n.get() == 2, "Pointer press increments link count")
  t.press("Disabled Link")
  a_assert(dis_link_n.get() == 0, "Disabled Link must not activate")

  assert_aura_ui(t, label="a_toolbar_and_link")
  t.dispose()
}

test "a_jsx_all_10_components_light_and_dark_audit" {
  let cfg = signals::signal(AuraConfig::light())
  let sel = signals::signal(true)
  let grp_sel = signals::signal("L")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::By(fn() -> Int64 { aura_theme(root).palette.background })).pad(view::Live::Is(20.0)).gap(view::Live::Is(12.0))
    <Card in={root}>
      <CardHeader>
        <CardTitle text="Track 1A JSX Showcase" />
        <CardDescription text="All 10 components rendered via Pion-JSX." />
      </CardHeader>
      <CardContent>
        <Header text="Typography & Keys" />
        <Typography text="Heading Four" kind={.H4} />
        <Typography text="const ok = true;" kind={.Code} />
        <Kbd>
          <KbdAbbr key={.Command} />
          <KbdContent text="K" />
        </Kbd>
        <EmptyState title={.Is("No results")} description={.Is("Try a different query.")} />
      </CardContent>
      <CardFooter>
        <ButtonGroup label="JSX Group">
          <ButtonGroupItem label="One" index={0} total={2} />
          <ButtonGroupItem label="Two" index={1} total={2} />
        </ButtonGroup>
        <ToggleButton label="Pin" selected={fn() { sel.get() }} on_change={fn(v) { sel.set(v) }} />
        <ToggleButtonGroup
          label="JSX Toggle Group"
          is_on={fn(k : String) { grp_sel.get() == k }}
          on_change={fn(k : String, on : Bool) { if on { grp_sel.set(k) } }}
          render={fn(g : view::View, tg : AuraToggleGroup[String]) -> Unit {
            let _ = tg.item(g, "L", view::Live::Is("L"), index=0, total=2)
            let _ = tg.item(g, "R", view::Live::Is("R"), index=1, total=2)
          }}
        />
        <Toolbar
          label="JSX Toolbar"
          render={fn(bar : view::View, tb : AuraToolbar) -> Unit {
            let _ = tb.button(bar, view::Live::Is("Run"))
          }}
        />
        <Link label="Docs" href="https://example.dev" external={true} />
      </CardFooter>
    </Card>
  }, width=900.0, height=700.0)
  a_assert(count_liquid_glass(t) == 0, "Track 1A must have zero liquid glass")
  assert_aura_ui(t, label="a_jsx_showcase_light")
  cfg.set(AuraConfig::dark())
  t.frame(ms=16.0)
  a_assert(count_liquid_glass(t) == 0, "Track 1A dark must have zero liquid glass")
  assert_aura_ui(t, label="a_jsx_showcase_dark")
  t.dispose()
}

test "a_r2a_typography_heading_a11y_and_code_mono_parity" {
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let b_code_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let j_code_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let h_refs : Array[signals::Ref[Option[view::View]]] = [
    view::ref_new(None),
    view::ref_new(None),
    view::ref_new(None),
    view::ref_new(None),
    view::ref_new(None),
    view::ref_new(None),
  ]
  let j_h2_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let body_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(16.0)).gap(view::Live::Is(8.0))
    h_refs[0].v = Some(typography_node(root, view::Live::Is("Title H1"), kind=AuraTypographyType::H1))
    h_refs[1].v = Some(typography_node(root, view::Live::Is("Title H2"), kind=AuraTypographyType::H2, align=AuraTypographyAlign::Center))
    h_refs[2].v = Some(typography_node(root, view::Live::Is("Title H3"), kind=AuraTypographyType::H3, align=AuraTypographyAlign::End))
    h_refs[3].v = Some(typography_node(root, view::Live::Is("Title H4"), kind=AuraTypographyType::H4))
    h_refs[4].v = Some(typography_node(root, view::Live::Is("Title H5"), kind=AuraTypographyType::H5))
    h_refs[5].v = Some(typography_node(root, view::Live::Is("Title H6"), kind=AuraTypographyType::H6))
    j_h2_ref.v = Some(<Typography in={root} text="JSX H2" kind={.H2} />)
    body_ref.v = Some(typography_node(root, view::Live::Is("Plain body"), kind=AuraTypographyType::Body))
    b_code_ref.v = Some(typography_node(root, view::Live::Is("const x = 1;"), kind=AuraTypographyType::Code, mono=false))
    j_code_ref.v = Some(<Typography in={root} text="const x = 1;" kind={.Code} mono={false} />)
  }, width=600.0, height=600.0)
  let tr = a_unwrap_tree(tree_ref.v)
  let expected_titles : Array[String] = ["Title H1", "Title H2", "Title H3", "Title H4", "Title H5", "Title H6"]
  let mut idx = 0
  while idx < 6 {
    match h_refs[idx].v {
      Some(v) => {
        match tr.said_of(v.id()) {
          Some(s) => {
            a_assert(s.role is view::Role::Heading, "H1..H6 must have Role::Heading")
            a_assert(s.label == expected_titles[idx], "H1..H6 accessible label must match text")
          }
          None => a_assert(false, "H1..H6 must expose accessible semantics")
        }
      }
      None => a_assert(false, "missing heading node")
    }
    idx += 1
  }
  match j_h2_ref.v {
    Some(v) => {
      match tr.said_of(v.id()) {
        Some(s) => {
          a_assert(s.role is view::Role::Heading, "JSX H2 must have Role::Heading")
          a_assert(s.label == "JSX H2", "JSX H2 accessible label must match text")
        }
        None => a_assert(false, "JSX H2 must expose accessible semantics")
      }
    }
    None => a_assert(false, "missing JSX H2 node")
  }
  match body_ref.v {
    Some(v) => {
      match tr.said_of(v.id()) {
        Some(s) => a_assert(!(s.role is view::Role::Heading), "Body must not have Role::Heading")
        None => ()
      }
    }
    None => a_assert(false, "missing body node")
  }
  // Builder & JSX Code(mono=false) must measure identical box width and height (same proportional font/style).
  match (b_code_ref.v, j_code_ref.v) {
    (Some(bv), Some(jv)) => {
      let (_, _, bw, bh) = bv.rect()
      let (_, _, jw, jh) = jv.rect()
      a_assert(bw > 0.0 && jw > 0.0, "Code(mono=false) must have positive width")
      let dw = if bw >= jw { bw - jw } else { jw - bw }
      let dh = if bh >= jh { bh - jh } else { jh - bh }
      a_assert(dw < 0.01 && dh < 0.01, "Builder and JSX Code(mono=false) must have identical layout dimensions")
    }
    _ => a_assert(false, "missing Code(mono=false) nodes")
  }
  assert_aura_ui(t, label="a_r2a_typography_heading_code")
  t.dispose()
}

test "a_r2a_kbd_natural_width_and_toggle_group_separator_jsx" {
  let kbd_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let abbr_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let content_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let sep_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let sel = signals::signal("L")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background)).pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true))
      kbd_ref.v = Some(kbd_node(row, content=fn(kv : view::View) -> Unit {
        abbr_ref.v = Some(kbd_abbr_node(kv, AuraKbdKey::Command))
        content_ref.v = Some(kbd_content_node(kv, view::Live::Is("K")))
      }))
    })
    let _ = <ToggleButtonGroup
      in={root}
      label="Manual Sep Group"
      hide_separator={true}
      is_on={fn(k : String) { sel.get() == k }}
      on_change={fn(k : String, on : Bool) { if on { sel.set(k) } }}
      render={fn(g : view::View, tg : AuraToggleGroup[String]) -> Unit {
        let _ = tg.item(g, "L", view::Live::Is("L"), index=0, total=2)
        sep_ref.v = Some(<ToggleButtonGroupSeparator in={g} orientation={.Horizontal} />)
        let _ = tg.item(g, "R", view::Live::Is("R"), index=1, total=2)
      }}
    />
  }, width=500.0, height=300.0)
  match (kbd_ref.v, abbr_ref.v, content_ref.v) {
    (Some(kv), Some(av), Some(cv)) => {
      let (kx, _, kw, _) = kv.rect()
      let (ax, _, aw, _) = av.rect()
      let (cx, _, cw, _) = cv.rect()
      // Natural Kbd width = 8pt left pad + abbr width + 2pt gap + content width + 8pt right pad.
      let expected_w = aw + cw + 18.0
      let dw = if kw >= expected_w { kw - expected_w } else { expected_w - kw }
      a_assert(dw < 1.0, "Kbd must expand naturally to fit Command glyph + 2pt gap + K + 16pt padding")
      let gap_actual = cx - (ax + aw)
      let dgap = if gap_actual >= 2.0 { gap_actual - 2.0 } else { 2.0 - gap_actual }
      a_assert(dgap < 0.5, "Kbd gap between abbr and content must be 2.0pt")
      a_assert(ax >= kx + 7.5 && cx + cw <= kx + kw - 7.5, "Kbd children must not be clipped")
    }
    _ => a_assert(false, "missing Kbd nodes")
  }
  match sep_ref.v {
    Some(sv) => {
      let (_, _, _, sh) = sv.rect()
      a_assert(sh == 18.0, "ToggleButtonGroupSeparator JSX must render 18pt horizontal separator holder")
    }
    None => a_assert(false, "missing ToggleButtonGroupSeparator JSX node")
  }
  assert_aura_ui(t, label="a_r2a_kbd_and_toggle_sep")
  t.dispose()
}
