// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Label, Description, ErrorMessage, and FieldError atoms.

import "view"

fn w0_words_look(size : Double, weight : Int, line : Double, wrap : Bool) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

/// Aura `Label` form label (14pt Medium `--foreground`, optional required asterisk in `--danger`).
pub fn label_node(
  parent : view::View,
  text : view::Live[String],
  required~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(row : view::View) -> Unit {
    let _ = row
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(2.0))
      .group_alpha(view::Live::By(fn() -> Double {
        if disabled.eval() { aura_theme(row).disabled_opacity } else { 1.0 }
      }))
    let _ = row
      .words(text, look=w0_words_look(14.0, 500, 20.0, false))
      .ink(view::Live::By(fn() -> Int64 { aura_theme(row).palette.foreground }))
    if required {
      let _ = row
        .words(view::Live::Is("*"), look=w0_words_look(14.0, 500, 20.0, false))
        .ink(view::Live::By(fn() -> Int64 { aura_theme(row).palette.danger }))
    }
  })
}

/// Pion-JSX `<aura::Label>` wrapper.
pub fn Label(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  required~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  let d = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  label_node(parent, t, required=required, disabled=d, loc=loc)
}

/// Aura `Description` helper text (12pt Regular `--muted`).
pub fn description_node(
  parent : view::View,
  text : view::Live[String],
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let w = parent.words(text, look=w0_words_look(12.0, 400, 16.0, wrap), loc=loc)
  let _ = w.ink(view::Live::By(fn() -> Int64 { aura_theme(w).palette.muted }))
  w
}

/// Pion-JSX `<aura::Description>` wrapper.
pub fn Description(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  description_node(parent, t, wrap=wrap, loc=loc)
}

/// Aura `ErrorMessage` inline validation text (12pt Regular `--danger`).
pub fn error_message_node(
  parent : view::View,
  text : view::Live[String],
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let w = parent.words(text, look=w0_words_look(12.0, 400, 16.0, wrap), loc=loc)
  let _ = w.ink(view::Live::By(fn() -> Int64 { aura_theme(w).palette.danger }))
  w
}

/// Pion-JSX `<aura::ErrorMessage>` wrapper.
pub fn ErrorMessage(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  error_message_node(parent, t, wrap=wrap, loc=loc)
}

/// Aura `FieldError` conditional validation text (renders only when `visible` is true and message non-empty).
pub fn field_error_node(
  parent : view::View,
  text : view::Live[String],
  visible~ : view::Live[Bool] = view::Live::Is(true),
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(holder : view::View) -> Unit {
    let _ = holder.show(
      fn() -> Bool { visible.eval() && text.eval() != "" },
      fn(v : view::View) -> Unit {
        let _ = error_message_node(v, text, wrap=wrap)
      },
    )
  })
}

/// Pion-JSX `<aura::FieldError>` wrapper.
pub fn FieldError(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  into visible~ : view::Live[Bool] = .Is(true),
  visible_by? : () -> Bool,
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  let vis = match visible_by { Some(f) => view::Live::By(f); None => visible }
  field_error_node(parent, t, visible=vis, wrap=wrap, loc=loc)
}
