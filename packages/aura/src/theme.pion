// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): resolved AuraTheme and geometry scales.

import "signals"
import "ui"
import "view"

/// Resolved Aura theme snapshot: config + derived semantic palette + geometry constants.
#derive(Eq)
pub struct AuraTheme {
  pub config : AuraConfig
  pub palette : AuraPalette
  pub radius : Double
  pub field_radius : Double
  pub surface_radius : Double
  pub card_radius : Double
  pub overlay_radius : Double
  pub spacing : Double
  pub border_width : Double
  pub ring_offset_width : Double
  pub disabled_opacity : Double
}

// 2-slot render-thread cache keyed by `AuraConfig` equality so `Live::By` closures avoid recomputing
// ~60 OKLab tokens on every read (handles light + dark side-by-side without thrashing).
let w0_theme_cache_0 : signals::Ref[Option[(AuraConfig, AuraTheme)]] = view::ref_new(None)
let w0_theme_cache_1 : signals::Ref[Option[(AuraConfig, AuraTheme)]] = view::ref_new(None)

/// Resolve an `AuraTheme` from `cfg` (cached by `AuraConfig` equality).
pub fn aura_theme_from(cfg : AuraConfig) -> AuraTheme {
  match w0_theme_cache_0.v {
    Some((c0, t0)) =>
      if c0 == cfg {
        return t0
      }
    None => ()
  }
  match w0_theme_cache_1.v {
    Some((c1, t1)) =>
      if c1 == cfg {
        return t1
      }
    None => ()
  }
  let r = cfg.radius
  let th = AuraTheme::{
    config: cfg,
    palette: aura_palette(cfg),
    radius: r,
    field_radius: r * 1.5,
    surface_radius: r * 1.5,
    card_radius: r * 3.0,
    overlay_radius: r * 3.0,
    spacing: cfg.spacing,
    border_width: 1.0,
    ring_offset_width: 2.0,
    disabled_opacity: 0.5,
  }
  w0_theme_cache_1.v = w0_theme_cache_0.v
  w0_theme_cache_0.v = Some((cfg, th))
  th
}

/// Read the resolved `AuraTheme` for `v`'s tree.
pub fn aura_theme(v : view::View) -> AuraTheme {
  aura_theme_from(aura_config_of(v))
}

/// Bridge an `AuraConfig` into Invar's `ui::Theme` for `ui::set_tree_theme`.
/// HeroUI v3 follows standard CSS `font-variant-numeric: normal` (`tabular: false`) and default
/// Inter glyph forms (`font_alternates: false`, omitting `cv11`/`ss01` across all 4 text hosts).
pub fn aura_ui_theme(cfg : AuraConfig) -> ui::Theme {
  let th = aura_theme_from(cfg)
  let pal = th.palette
  let base = if cfg.dark { ui::Theme::dark() } else { ui::Theme::light() }
  ui::Theme::{
    ..base,
    dark: cfg.dark,
    bg: pal.background,
    surface: pal.surface,
    fg: pal.foreground,
    muted: pal.muted,
    subtle: pal.muted,
    border: pal.border,
    accent: pal.accent,
    on_accent: pal.accent_foreground,
    primary: pal.accent,
    on_primary: pal.accent_foreground,
    danger: pal.danger,
    on_danger: pal.danger_foreground,
    focus: pal.focus,
    radius: th.radius,
    radius_lg: th.surface_radius,
    radius_dialog: th.overlay_radius,
    font: 14.0,
    tabular: false,
    font_alternates: false,
  }
}
