import "dmath"
import "headless"
import "paint"
import "signals"
import "view"

// ============================================================================
// 1. Alert (alert.css)
// ============================================================================

/// Alert semantic status (`default`, `accent`, `success`, `warning`, `danger`).
#derive(Eq)
pub enum AuraAlertStatus {
  Default
  Accent
  Success
  Warning
  Danger
}

fn d_alert_accent_fg(pal : AuraPalette, status : AuraAlertStatus) -> Int64 {
  match status {
    AuraAlertStatus::Default => pal.foreground
    AuraAlertStatus::Accent => pal.accent_soft_foreground
    AuraAlertStatus::Success => pal.success_soft_foreground
    AuraAlertStatus::Warning => pal.warning_soft_foreground
    AuraAlertStatus::Danger => pal.danger_soft_foreground
  }
}

fn d_alert_default_icon(status : AuraAlertStatus) -> AuraIconKind {
  match status {
    AuraAlertStatus::Default | AuraAlertStatus::Accent => AuraIconKind::CircleInfo
    AuraAlertStatus::Success => AuraIconKind::CircleCheck
    AuraAlertStatus::Warning => AuraIconKind::TriangleExclamation
    AuraAlertStatus::Danger => AuraIconKind::CircleExclamation
  }
}

let d_alert_status_lent : view::Lent[AuraAlertStatus] = view::Lent::new()

/// Alert leading indicator slot (`p-1`, 16pt default status icon).
pub fn alert_indicator_node(
  parent : view::View,
  status? : AuraAlertStatus,
  icon? : AuraIconKind,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let eff_status = match status {
      Some(s) => s
      None => match node.lent(d_alert_status_lent) { Some(s) => s; None => AuraAlertStatus::Default }
    }
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .pad(view::Live::Is(4.0))
      .shrink(view::Live::Is(0.0))
    match content {
      Some(f) => f(node)
      None => {
        let kind = match icon { Some(k) => k; None => d_alert_default_icon(eff_status) }
        let _ = aura_icon_node(node, kind, size=16.0, ink=fn() -> Int64 {
          d_alert_accent_fg(aura_theme(node).palette, eff_status)
        })
      }
    }
  })
}

/// Pion-JSX `<aura::AlertIndicator>` wrapper.
pub fn AlertIndicator(
  parent : view::View,
  status? : AuraAlertStatus,
  icon? : AuraIconKind,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  alert_indicator_node(parent, status?=status, icon?=icon, content?=children, loc=loc)
}

/// Alert content column (`flex grow flex-col items-start`).
pub fn alert_content_node(
  parent : view::View,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .grow(view::Live::Is(1.0))
      .shrink(view::Live::Is(1.0))
      .lines_up(view::Live::By(fn() -> Option[view::Along] {
        Some(if aura_rtl(node) { view::Along::End } else { view::Along::Start })
      }))
    content(node)
  })
}

/// Pion-JSX `<aura::AlertContent>` wrapper.
pub fn AlertContent(
  parent : view::View,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  alert_content_node(parent, content=children, loc=loc)
}

/// Alert title (`text-sm leading-6 font-medium`, tinted by alert status).
pub fn alert_title_node(
  parent : view::View,
  text : view::Live[String],
  status? : AuraAlertStatus,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(w : view::View) -> Unit {
    let eff_status = match status {
      Some(s) => s
      None => match w.lent(d_alert_status_lent) { Some(s) => s; None => AuraAlertStatus::Default }
    }
    let title_look = d_words_look(14.0, 500, 24.0, wrap=true)
    let _ = w
      .words(text, look=title_look)
      .words_look(view::Live::By(fn() -> view::WordsLook { title_look.with_rtl(aura_rtl(w)) }))
      .ink(view::Live::By(fn() -> Int64 { d_alert_accent_fg(aura_theme(w).palette, eff_status) }))
  })
}

/// Pion-JSX `<aura::AlertTitle>` wrapper.
pub fn AlertTitle(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  status? : AuraAlertStatus,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  alert_title_node(parent, t, status?=status, loc=loc)
}

/// Alert description (`text-sm leading-5 text-muted`).
pub fn alert_description_node(
  parent : view::View,
  text : view::Live[String],
  loc~ : String = "",
) -> view::View {
  d_text_box(
    parent,
    text,
    d_words_look(14.0, 400, 20.0, wrap=true),
    view::Live::By(fn() -> Int64 { aura_theme(parent).palette.muted }),
    loc=loc,
  )
}

/// Pion-JSX `<aura::AlertDescription>` wrapper.
pub fn AlertDescription(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  alert_description_node(parent, t, loc=loc)
}

/// Aura `Alert` banner (Builder API).
/// Matches `alert.css`: `bg-surface`, `px-4 py-3`, `gap-4`, `radius = min(32, card_radius)`, `shadow-surface`.
pub fn alert_node(
  parent : view::View,
  status~ : AuraAlertStatus = AuraAlertStatus::Default,
  title? : view::Live[String],
  description? : view::Live[String],
  show_indicator~ : Bool = true,
  icon? : AuraIconKind,
  action? : (view::View) -> Unit,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .lends(d_alert_status_lent, status)
      .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(node) }))
      .lines_up(view::Live::Is(Some(view::Along::Start)))
      .gap(view::Live::Is(16.0))
      .pad_xy(16.0, 12.0)
      .fills_across(view::Live::Is(true))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::By(fn() -> Double {
        let r = aura_theme(node).card_radius
        if r > 32.0 { 32.0 } else { r }
      }))
      .ground(view::Live::By(fn() -> Int64 { aura_theme(node).palette.surface }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        aura_surface_shadows(aura_theme(node).config.dark)
      }))
      .says(view::Live::By(fn() -> Option[view::Said] {
        let lbl = match title { Some(t) => t.eval(); None => "Alert" }
        Some(view::said(view::Role::Status, label=lbl))
      }))
    match content {
      Some(f) => f(node)
      None => {
        if show_indicator {
          let _ = alert_indicator_node(node, status=status, icon?=icon)
        }
        let _ = alert_content_node(node, content=fn(col : view::View) -> Unit {
          match title {
            Some(t) => { let _ = alert_title_node(col, t, status=status) }
            None => ()
          }
          match description {
            Some(d) => { let _ = alert_description_node(col, d) }
            None => ()
          }
        })
        match action {
          Some(act) => act(node)
          None => ()
        }
      }
    }
  })
}

/// Pion-JSX `<aura::Alert>` wrapper.
pub fn Alert(
  parent : view::View,
  status~ : AuraAlertStatus = AuraAlertStatus::Default,
  title? : view::Live[String],
  title_by? : () -> String,
  description? : view::Live[String],
  description_by? : () -> String,
  show_indicator~ : Bool = true,
  icon? : AuraIconKind,
  action? : (view::View) -> Unit,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let t : Option[view::Live[String]] = match title_by { Some(f) => Some(view::Live::By(f)); None => title }
  let d : Option[view::Live[String]] = match description_by { Some(f) => Some(view::Live::By(f)); None => description }
  alert_node(
    parent,
    status=status,
    title?=t,
    description?=d,
    show_indicator=show_indicator,
    icon?=icon,
    action?=action,
    content?=children,
    loc=loc,
  )
}

// ============================================================================
// 2. Badge & BadgeAnchor (badge.css)
// ============================================================================

/// Badge fill style (`Primary`, `Secondary`, `Soft`).
#derive(Eq)
pub enum AuraBadgeVariant {
  Primary
  Secondary
  Soft
}

/// Badge anchor corner placement.
#derive(Eq)
pub enum AuraBadgePlacement {
  TopRight
  TopLeft
  BottomRight
  BottomLeft
}

fn d_badge_metrics(size : AuraControlSize, dot : Bool) -> (Double, Double, Double, Double) {
  // Returns (min_dim, radius, font_size, line_height)
  if dot {
    match size {
      AuraControlSize::Sm => (8.0, 4.0, 10.0, 12.0)
      AuraControlSize::Md => (10.0, 5.0, 10.0, 12.0)
      AuraControlSize::Lg => (12.0, 6.0, 10.0, 12.0)
    }
  } else {
    match size {
      AuraControlSize::Sm => (16.0, 8.0, 10.0, 13.4)
      AuraControlSize::Md => (28.0, 14.0, 12.0, 16.08)
      AuraControlSize::Lg => (32.0, 16.0, 14.0, 20.0)
    }
  }
}

fn d_badge_colors(pal : AuraPalette, variant : AuraBadgeVariant, color : AuraStatusColor) -> (Int64, Int64) {
  match variant {
    AuraBadgeVariant::Primary => d_status_solid_pair(pal, color)
    AuraBadgeVariant::Secondary => (pal.default_bg, d_status_soft_fg(pal, color))
    AuraBadgeVariant::Soft => d_status_soft_pair(pal, color)
  }
}

/// Aura `Badge` indicator (Builder API).
/// Supports `Primary`/`Secondary`/`Soft`, 5 status colors, `Sm`/`Md`/`Lg`, `dot` mode,
/// and 1pt `--background` border (`border-color: var(--badge-border)`).
pub fn badge_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is(""),
  variant~ : AuraBadgeVariant = AuraBadgeVariant::Primary,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  size~ : AuraControlSize = AuraControlSize::Md,
  dot~ : Bool = false,
  bordered~ : Bool = true,
  placement? : AuraBadgePlacement,
  loc~ : String = "",
) -> view::View {
  let (dim, rad, fs, lh) = d_badge_metrics(size, dot)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .shrink(view::Live::Is(0.0))
      .min_width(view::Live::Is(Some(dim)))
      .min_height(view::Live::Is(Some(dim)))
      .height(view::Live::Is(Some(dim)))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::Is(rad))
      .ground(view::Live::By(fn() -> Int64 {
        d_badge_colors(aura_theme(node).palette, variant, color).0
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if bordered {
          (1.0, aura_theme(node).palette.background)
        } else {
          (0.0, 0L)
        }
      }))
    if !dot {
      if !(size is AuraControlSize::Sm) {
        let _ = node.pad_xy(6.0, 0.0)
      }
      let _ = d_text_box(
        node,
        label,
        d_words_look(fs, 500, if size is AuraControlSize::Sm { 12.0 } else { lh }),
        view::Live::By(fn() -> Int64 {
          d_badge_colors(aura_theme(node).palette, variant, color).1
        }),
      )
    }
    match placement {
      Some(pl) => {
        let shift = dim * 0.25
        let edges = match pl {
          AuraBadgePlacement::TopRight => (None, Some(-shift), Some(-shift), None)
          AuraBadgePlacement::TopLeft => (Some(-shift), Some(-shift), None, None)
          AuraBadgePlacement::BottomRight => (None, None, Some(-shift), Some(-shift))
          AuraBadgePlacement::BottomLeft => (Some(-shift), None, None, Some(-shift))
        }
        let _ = node.over(view::Live::Is(true), edges=edges).points(view::Live::Is(false))
      }
      None => ()
    }
  })
}

/// Pion-JSX `<aura::Badge>` wrapper.
pub fn Badge(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  variant~ : AuraBadgeVariant = AuraBadgeVariant::Primary,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  size~ : AuraControlSize = AuraControlSize::Md,
  dot~ : Bool = false,
  bordered~ : Bool = true,
  placement? : AuraBadgePlacement,
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  badge_node(
    parent,
    label=l,
    variant=variant,
    color=color,
    size=size,
    dot=dot,
    bordered=bordered,
    placement?=placement,
    loc=loc,
  )
}

/// Aura `BadgeAnchor` positioning wrapper (Builder API).
pub fn badge_anchor_node(
  parent : view::View,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node.shrink(view::Live::Is(0.0))
    content(node)
  })
}

/// Pion-JSX `<aura::BadgeAnchor>` wrapper.
pub fn BadgeAnchor(
  parent : view::View,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  badge_anchor_node(parent, content=children, loc=loc)
}

// ============================================================================
// 3. Chip (chip.css)
// ============================================================================

/// Chip visual variant (`Primary`, `Secondary`, `Tertiary`, `Soft`).
#derive(Eq)
pub enum AuraChipVariant {
  Primary
  Secondary
  Tertiary
  Soft
}

fn d_chip_colors(pal : AuraPalette, variant : AuraChipVariant, color : AuraStatusColor) -> (Int64, Int64) {
  match variant {
    AuraChipVariant::Primary => d_status_solid_pair(pal, color)
    AuraChipVariant::Secondary => (pal.default_bg, d_status_soft_fg(pal, color))
    AuraChipVariant::Tertiary => (0x00000000L, d_status_soft_fg(pal, color))
    AuraChipVariant::Soft => d_status_soft_pair(pal, color)
  }
}

fn d_chip_metrics(size : AuraControlSize) -> (Double, Double, Double, Double) {
  // Returns (pad_x, pad_y, font_size, line_height) matching chip.css:
  // sm: px-1 py-0 text-xs (4, 0, 12, 18)
  // md: px-2 py-0.5 text-xs leading-5 (8, 2, 12, 18 -> h=24 via min_height)
  // lg: px-3 py-1 text-sm (12, 4, 14, 20 -> h=28)
  match size {
    AuraControlSize::Sm => (4.0, 0.0, 12.0, 18.0)
    AuraControlSize::Md => (8.0, 3.0, 12.0, 18.0)
    AuraControlSize::Lg => (12.0, 4.0, 14.0, 20.0)
  }
}

/// Aura `Chip` pill badge/status tag (Builder API).
pub fn chip_node(
  parent : view::View,
  label : view::Live[String],
  variant~ : AuraChipVariant = AuraChipVariant::Secondary,
  color~ : AuraStatusColor = AuraStatusColor::Default,
  size~ : AuraControlSize = AuraControlSize::Md,
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let (px, py, fs, lh) = d_chip_metrics(size)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .gap(view::Live::Is(2.0))
      .pad_xy(px + 2.0, py)
      .shrink(view::Live::Is(0.0))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::By(fn() -> Double { aura_theme(node).radius * 2.0 }))
      .ground(view::Live::By(fn() -> Int64 {
        d_chip_colors(aura_theme(node).palette, variant, color).0
      }))
    match leading {
      Some(f) => f(node)
      None => ()
    }
    let _ = d_text_box(
      node,
      label,
      d_words_look(fs, 500, lh),
      view::Live::By(fn() -> Int64 {
        d_chip_colors(aura_theme(node).palette, variant, color).1
      }),
    )
    match trailing {
      Some(f) => f(node)
      None => ()
    }
  })
}

/// Pion-JSX `<aura::Chip>` wrapper.
pub fn Chip(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  variant~ : AuraChipVariant = AuraChipVariant::Secondary,
  color~ : AuraStatusColor = AuraStatusColor::Default,
  size~ : AuraControlSize = AuraControlSize::Md,
  leading? : (view::View) -> Unit,
  trailing? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  chip_node(
    parent,
    l,
    variant=variant,
    color=color,
    size=size,
    leading?=leading,
    trailing?=trailing,
    loc=loc,
  )
}

// ============================================================================
// 4. Avatar & 5. AvatarGroup (avatar.css, avatar-group.css)
// ============================================================================

/// Avatar background variant (`Default`, `Soft`).
#derive(Eq)
pub enum AuraAvatarVariant {
  Default
  Soft
}

fn d_avatar_metrics(size : AuraControlSize) -> (Double, Double, Double) {
  // Returns (dim, font_size, line_height) matching avatar.css (Sm=32, Md=40, Lg=48)
  match size {
    AuraControlSize::Sm => (32.0, 12.0, 16.0)
    AuraControlSize::Md => (40.0, 14.0, 20.0)
    AuraControlSize::Lg => (48.0, 16.0, 24.0)
  }
}

fn d_avatar_colors(pal : AuraPalette, variant : AuraAvatarVariant, color : AuraStatusColor) -> (Int64, Int64) {
  match variant {
    AuraAvatarVariant::Default => (pal.default_bg, d_status_soft_fg(pal, color))
    AuraAvatarVariant::Soft => d_status_soft_pair(pal, color)
  }
}

/// Aura `Avatar` (Builder API): circular image with fallback initials and color variants.
pub fn avatar_node(
  parent : view::View,
  fallback~ : view::Live[String] = view::Live::Is(""),
  src? : view::Live[String],
  alt~ : String = "",
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Default,
  variant~ : AuraAvatarVariant = AuraAvatarVariant::Default,
  loc~ : String = "",
) -> view::View {
  let (dim, fs, lh) = d_avatar_metrics(size)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .width(view::Live::Is(Some(dim)))
      .height(view::Live::Is(Some(dim)))
      .shrink(view::Live::Is(0.0))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::Is(dim * 0.5))
      .clips(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 {
        d_avatar_colors(aura_theme(node).palette, variant, color).0
      }))
    if alt != "" {
      let _ = node.says(view::Live::Is(Some(view::said(view::Role::Image, label=alt))))
    }
    let _ = d_text_box(
      node,
      fallback,
      d_words_look(fs, 500, lh),
      view::Live::By(fn() -> Int64 {
        d_avatar_colors(aura_theme(node).palette, variant, color).1
      }),
    )
    match src {
      Some(s) => {
        let _ = node.box(fn(img : view::View) -> Unit {
          let _ = img
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(dim)))
            .height(view::Live::Is(Some(dim)))
            .image(view::Live::By(fn() -> Option[(String, String, Int)] {
              let k = s.eval()
              if k == "" { None } else { Some((k, alt, (dim * 2.0).to_int())) }
            }))
            .image_covers(view::Live::Is(true))
        })
      }
      None => ()
    }
  })
}

/// Pion-JSX `<aura::Avatar>` wrapper.
pub fn Avatar(
  parent : view::View,
  into fallback~ : view::Live[String] = .Is(""),
  fallback_by? : () -> String,
  src? : view::Live[String],
  alt~ : String = "",
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Default,
  variant~ : AuraAvatarVariant = AuraAvatarVariant::Default,
  loc~ : String = "",
) -> view::View {
  let fb = match fallback_by { Some(f) => view::Live::By(f); None => fallback }
  avatar_node(
    parent,
    fallback=fb,
    src?=src,
    alt=alt,
    size=size,
    color=color,
    variant=variant,
    loc=loc,
  )
}

/// Avatar item descriptor for `AvatarGroup`.
pub struct AuraAvatarItem {
  pub fallback : String
  pub src : String
  pub alt : String
  pub color : AuraStatusColor
}

/// Construct an `AuraAvatarItem`.
pub fn AuraAvatarItem::new(
  fallback : String,
  src~ : String = "",
  alt~ : String = "",
  color~ : AuraStatusColor = AuraStatusColor::Default,
) -> AuraAvatarItem {
  AuraAvatarItem::{ fallback, src, alt, color }
}

/// Aura `AvatarGroup` (Builder API): negative-overlap stacked avatars with 2pt outer seam ring and `+N` overflow badge.
pub fn avatar_group_node(
  parent : view::View,
  items : Array[AuraAvatarItem],
  max~ : Int = 0,
  size~ : AuraControlSize = AuraControlSize::Md,
  overlap~ : Double = 8.0,
  seam_color? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  let (dim, _, _) = d_avatar_metrics(size)
  let total = items.length()
  let show_n = if max > 0 && total > max { max } else { total }
  let overflow = if max > 0 && total > max { total - max } else { 0 }
  parent.box(loc=loc, fn(row : view::View) -> Unit {
    let _ = row
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .shrink(view::Live::Is(0.0))
    let seam_of = fn() -> Int64 {
      match seam_color {
        Some(f) => f()
        None => aura_theme(row).palette.surface
      }
    }
    let mut i = 0
    while i < show_n {
      let it = items[i]
      let src_opt : Option[view::Live[String]] = if it.src != "" { Some(view::Live::Is(it.src)) } else { None }
      let av = avatar_node(row, fallback=view::Live::Is(it.fallback), src?=src_opt, alt=it.alt, size=size, color=it.color)
      let _ = av.ring(view::Live::By(fn() -> (Double, Double, Int64) { (2.0, 0.0, seam_of()) }))
      if i > 0 {
        let _ = av.margin(view::Live::Is((-overlap, 0.0, 0.0, 0.0)))
      }
      i += 1
    }
    if overflow > 0 {
      let ov = avatar_node(
        row,
        fallback=view::Live::Is("+\{overflow}"),
        size=size,
        color=AuraStatusColor::Default,
      )
      let _ = ov.ring(view::Live::By(fn() -> (Double, Double, Int64) { (2.0, 0.0, seam_of()) }))
      if show_n > 0 {
        let _ = ov.margin(view::Live::Is((-overlap, 0.0, 0.0, 0.0)))
      }
    }
    let _ = dim
  })
}

/// Pion-JSX `<aura::AvatarGroup>` wrapper.
pub fn AvatarGroup(
  parent : view::View,
  items~ : Array[AuraAvatarItem] = [],
  max~ : Int = 0,
  size~ : AuraControlSize = AuraControlSize::Md,
  overlap~ : Double = 8.0,
  seam_color? : () -> Int64,
  loc~ : String = "",
) -> view::View {
  avatar_group_node(parent, items, max=max, size=size, overlap=overlap, seam_color?=seam_color, loc=loc)
}

// ============================================================================
// 6. ProgressBar (progress-bar.css, wired to headless::progress)
// ============================================================================

fn d_progress_fill_color(pal : AuraPalette, color : AuraStatusColor) -> Int64 {
  match color {
    AuraStatusColor::Default => pal.default_foreground
    AuraStatusColor::Accent => pal.accent
    AuraStatusColor::Success => pal.success
    AuraStatusColor::Warning => pal.warning
    AuraStatusColor::Danger => pal.danger
  }
}

fn d_progress_bar_metrics(size : AuraControlSize) -> (Double, Double) {
  // Returns (track_height, radius) matching progress-bar.css (Sm=4/2, Md=8/4, Lg=12/6)
  match size {
    AuraControlSize::Sm => (4.0, 2.0)
    AuraControlSize::Md => (8.0, 4.0)
    AuraControlSize::Lg => (12.0, 6.0)
  }
}

/// Aura `ProgressBar` (Builder API), wired to `headless::progress`.
/// Supports determinate value + `Label`/`Output`, and indeterminate sliding bar animation
/// (static when `aura_reduced_motion(node)` is active).
pub fn progress_bar_node(
  parent : view::View,
  value : () -> Option[Double],
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  label~ : String = "",
  show_output~ : Bool = true,
  value_text? : (Double) -> String,
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  loc~ : String = "",
) -> view::View {
  let (th_h, rad) = d_progress_bar_metrics(size)
  let dis_get = disabled.to_getter()
  let fmt_out = fn(p : headless::Progress) -> String {
    match p.value() {
      Some(v) =>
        match value_text {
          Some(f) => f(v)
          None => "\{dmath::round(p.part() * 100.0).to_int()}%"
        }
      None => ""
    }
  }
  headless::progress(
    parent,
    value,
    fn(root : view::View, prog : headless::Progress) -> Unit {
      let _ = root
        .gap(view::Live::Is(4.0))
        .fills_across(view::Live::Is(true))
        .group_alpha(view::Live::By(fn() -> Double {
          if dis_get() { aura_theme(root).disabled_opacity } else { 1.0 }
        }))
      if label != "" || show_output {
        let _ = root.box(fn(hdr : view::View) -> Unit {
          let _ = hdr
            .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(hdr) }))
            .fills_across(view::Live::Is(true))
            .lies_along(view::Live::Is(view::Lies::Between))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
          if label != "" {
            let _ = d_text_box(
              hdr,
              view::Live::Is(label),
              d_words_look(14.0, 500, 20.0),
              view::Live::By(fn() -> Int64 { aura_theme(hdr).palette.foreground }),
            )
          } else {
            let _ = hdr.box(fn(_sp : view::View) { () })
          }
          if show_output {
            let out_v = d_text_box(
              hdr,
              view::Live::By(fn() -> String { fmt_out(prog) }),
              d_words_look(14.0, 500, 20.0),
              view::Live::By(fn() -> Int64 { aura_theme(hdr).palette.foreground }),
            )
            let _ = out_v.margin(view::Live::By(fn() -> (Double, Double, Double, Double) {
              if aura_rtl(hdr) { (0.0, 0.0, 2.5, 0.0) } else { (0.0, 0.0, -1.5, 0.0) }
            }))
          }
        })
      }
      let _ = root.box(fn(track : view::View) -> Unit {
        let _ = track
          .row(view::Live::Is(true))
          .fills_across(view::Live::Is(true))
          .height(view::Live::Is(Some(th_h)))
          .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(track) }))
          .radius(view::Live::Is(rad))
          .clips(view::Live::Is(true))
          .ground(view::Live::By(fn() -> Int64 { aura_theme(track).palette.default_bg }))
        // Determinate fill via flex grow (works on Frame 0 at any width, mirrors right->left in RTL)
        let _ = track.show(fn() -> Bool { !prog.indeterminate() }, fn(det : view::View) -> Unit {
          let _ = det.row_reverse(view::Live::By(fn() -> Bool { aura_rtl(det) })).fill()
          let _ = det.box(fn(bar : view::View) -> Unit {
            let _ = bar
              .height(view::Live::Is(Some(th_h)))
              .grow(view::Live::By(fn() -> Double { prog.part() }))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(bar) }))
              .radius(view::Live::Is(rad))
              .ground(view::Live::By(fn() -> Int64 {
                if prog.part() <= 0.0 { 0x00000000L } else { d_progress_fill_color(aura_theme(bar).palette, color) }
              }))
          })
          let _ = det.box(fn(sp : view::View) -> Unit {
            let _ = sp
              .height(view::Live::Is(Some(th_h)))
              .grow(view::Live::By(fn() -> Double { 1.0 - prog.part() }))
              .shrink(view::Live::Is(1.0))
              .basis(view::Live::Is(Some(0.0)))
          })
        })
        // Indeterminate sliding bar
        let _ = track.show(fn() -> Bool { prog.indeterminate() }, fn(ind : view::View) -> Unit {
          let _ = ind
            .fill()
            .rects(view::Live::By(fn() -> Array[paint::Rect] {
              let (_, _, tw, _) = track.rect()
              if tw <= 0.0 {
                return []
              }
              let fc = d_progress_fill_color(aura_theme(track).palette, color)
              let bar_w = tw * 0.4
              let phase = if aura_reduced_motion(track) { 0.3 } else { track.cycle(1500.0) }
              let x0 = -bar_w + phase * (tw + bar_w)
              [paint::rect(x0, 0.0, bar_w, th_h, color=fc, corners=(rad, rad, rad, rad))]
            }))
        })
      })
    },
    min=min,
    max=max,
    value_text?=value_text,
    label=fn() -> String { if label != "" { label } else { "Progress" } },
    loc=loc,
  )
}

/// Pion-JSX `<aura::ProgressBar>` wrapper.
pub fn ProgressBar(
  parent : view::View,
  value? : Double,
  value_by? : () -> Option[Double],
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  label~ : String = "",
  show_output~ : Bool = true,
  value_text? : (Double) -> String,
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  loc~ : String = "",
) -> view::View {
  let val_fn = match value_by {
    Some(f) => f
    None => fn() -> Option[Double] { value }
  }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  progress_bar_node(
    parent,
    val_fn,
    min=min,
    max=max,
    label=label,
    show_output=show_output,
    value_text?=value_text,
    size=size,
    color=color,
    disabled=dis,
    loc=loc,
  )
}

// ============================================================================
// 7. ProgressCircle (progress-circle.css, wired to headless::progress, paint::arc)
// ============================================================================

fn d_progress_circle_metrics(size : AuraControlSize) -> (Double, Double) {
  // Returns (diameter, stroke_width) matching progress-circle.css (Sm=20, Md=28, Lg=36; 3/28 stroke ratio)
  match size {
    AuraControlSize::Sm => (20.0, 2.15)
    AuraControlSize::Md => (28.0, 3.0)
    AuraControlSize::Lg => (36.0, 3.85)
  }
}

/// Aura `ProgressCircle` (Builder API), wired to `headless::progress`.
/// Draws the track ring and progress arc via `paint::arc`, **skipping the fill arc when progress == 0%**
/// to prevent round-cap dot artifacts. Supports determinate and indeterminate spin (`reduced_motion` static).
pub fn progress_circle_node(
  parent : view::View,
  value : () -> Option[Double],
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  label~ : String = "Progress",
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  loc~ : String = "",
) -> view::View {
  let (dim, stroke_w) = d_progress_circle_metrics(size)
  let dis_get = disabled.to_getter()
  let pi2 = 6.28318530717958647692
  let start_ang = -1.5707963267948966 // 12 o'clock (-pi/2)
  headless::progress(
    parent,
    value,
    fn(node : view::View, prog : headless::Progress) -> Unit {
      let cx = dim * 0.5
      let cy = dim * 0.5
      let r = dim * 0.5 - stroke_w * 0.5
      let _ = node
        .width(view::Live::Is(Some(dim)))
        .height(view::Live::Is(Some(dim)))
        .shrink(view::Live::Is(0.0))
        .points(view::Live::Is(false))
        .group_alpha(view::Live::By(fn() -> Double {
          if dis_get() { aura_theme(node).disabled_opacity } else { 1.0 }
        }))
        .turn(view::Live::By(fn() -> Double {
          if prog.indeterminate() && !aura_reduced_motion(node) {
            node.cycle(1000.0) * pi2
          } else {
            0.0
          }
        }))
        .lines(view::Live::By(fn() -> Array[paint::Line] {
          let pal = aura_theme(node).palette
          let fc = d_progress_fill_color(pal, color)
          let out : Array[paint::Line] = [
            paint::line(paint::arc(cx, cy, r, from=0.0, sweep=pi2), width=stroke_w, color=pal.default_bg),
          ]
          if prog.indeterminate() {
            let pts = paint::arc(cx, cy, r, from=start_ang, sweep=pi2 * 0.25)
            out.push(paint::line(pts, width=stroke_w, color=fc))
          } else {
            let part = prog.part()
            // CRITICAL: skip arc at 0% to avoid round-cap dot artifact!
            if part > 0.0001 {
              let sweep = if part >= 0.9999 { pi2 } else { pi2 * part }
              let pts = paint::arc(cx, cy, r, from=start_ang, sweep=sweep)
              out.push(paint::line(pts, width=stroke_w, color=fc))
            }
          }
          out
        }))
    },
    min=min,
    max=max,
    label=fn() -> String { label },
    loc=loc,
  )
}

/// Pion-JSX `<aura::ProgressCircle>` wrapper.
pub fn ProgressCircle(
  parent : view::View,
  value? : Double,
  value_by? : () -> Option[Double],
  min~ : Double = 0.0,
  max~ : Double = 100.0,
  label~ : String = "Progress",
  size~ : AuraControlSize = AuraControlSize::Md,
  color~ : AuraStatusColor = AuraStatusColor::Accent,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  loc~ : String = "",
) -> view::View {
  let val_fn = match value_by {
    Some(f) => f
    None => fn() -> Option[Double] { value }
  }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  progress_circle_node(
    parent,
    val_fn,
    min=min,
    max=max,
    label=label,
    size=size,
    color=color,
    disabled=dis,
    loc=loc,
  )
}

// ============================================================================
// 8. Skeleton & SkeletonGroup (skeleton.css, Wave 0 calibrated solid sweep)
// ============================================================================

/// Skeleton animation style (`Shimmer`, `Pulse`, `None`).
#derive(Eq)
pub enum AuraSkeletonAnimation {
  Shimmer
  Pulse
  None
}

struct DSkelGroupCtx {
  host : view::View
  period_ms : Double
  surface_bg : () -> Int64
}

let d_skel_group_lent : view::Lent[DSkelGroupCtx] = view::Lent::new()

/// Mount a 1-rect pure-GPU horizontal shimmer gradient (`[transparent, highlight, transparent]`)
/// using `View::fades((sweep_w * 0.5, 0, sweep_w * 0.5, 0))` translated by `shift * sweep_w - x0`.
/// Reduces 267 2pt paint rects to 1 GPU rect while matching `d_skel_sweep(u)` exactly.
fn d_mount_skel_gpu_shimmer(
  parent : view::View,
  active_fn : () -> Bool,
  geom_fn : () -> (Double, Double, Double, Double),
  highlight_fn : () -> Int64,
) -> Unit {
  let _ = parent.box(fn(fade_wrap : view::View) -> Unit {
    let _ = fade_wrap
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        if !active_fn() {
          return (Some(0.0), Some(0.0), None, None)
        }
        let (x0, sweep_w, _nh, phase) = geom_fn()
        let shift = 2.0 * phase - 1.0
        (Some(shift * sweep_w - x0), Some(0.0), None, None)
      }))
      .width(view::Live::By(fn() -> Option[Double] {
        if !active_fn() {
          return Some(0.0)
        }
        let (_, sweep_w, _, _) = geom_fn()
        Some(if sweep_w > 0.0 { sweep_w } else { 0.0 })
      }))
      .height(view::Live::By(fn() -> Option[Double] {
        if !active_fn() {
          return Some(0.0)
        }
        let (_, _, nh, _) = geom_fn()
        Some(if nh > 0.0 { nh } else { 0.0 })
      }))
      .points(view::Live::Is(false))
      .fades(view::Live::By(fn() -> (Double, Double, Double, Double) {
        if !active_fn() {
          return (0.0, 0.0, 0.0, 0.0)
        }
        let (_, sweep_w, _, _) = geom_fn()
        let half = if sweep_w > 0.0 { sweep_w * 0.5 } else { 0.0 }
        (half, 0.0, half, 0.0)
      }))
    let _ = fade_wrap.box(fn(hl : view::View) -> Unit {
      let _ = hl
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .ground(view::Live::By(fn() -> Int64 {
          if !active_fn() { 0L } else { highlight_fn() }
        }))
    })
  })
}

/// Aura `Skeleton` placeholder (Builder API).
/// Supports standalone shimmer (`from-transparent via-surface-tertiary to-transparent`),
/// synchronized `SkeletonGroup` overlay shimmer, `Pulse`, `None`, and `reduced_motion` static fallback.
pub fn skeleton_node(
  parent : view::View,
  width? : Double,
  height~ : Double = 24.0,
  radius~ : Double = 8.0,
  animation~ : AuraSkeletonAnimation = AuraSkeletonAnimation::Shimmer,
  period_ms~ : Double = 2000.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .height(view::Live::Is(Some(height)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::Is(radius))
      .clips(view::Live::Is(true))
    match width {
      Some(w) => { let _ = node.width(view::Live::Is(Some(w))) }
      None => { let _ = node.fills_across(view::Live::Is(true)) }
    }
    let _ = node
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura_theme(node).palette
        match node.lent(d_skel_group_lent) {
          Some(g) => d_mix_over((g.surface_bg)(), pal.surface_tertiary, 0.7)
          None => d_mix_over(pal.surface, pal.surface_tertiary, 0.7)
        }
      }))
      .group_alpha(view::Live::By(fn() -> Double {
        match animation {
          AuraSkeletonAnimation::Pulse =>
            if aura_reduced_motion(node) {
              1.0
            } else {
              let ph = node.cycle(period_ms)
              0.5 + 0.5 * (0.5 + 0.5 * dmath::cos(ph * 6.28318530717958647692))
            }
          _ => 1.0
        }
      }))
    let is_shimmer_active = fn() -> Bool {
      (animation is AuraSkeletonAnimation::Shimmer) && !aura_reduced_motion(node)
    }
    d_mount_skel_gpu_shimmer(
      node,
      is_shimmer_active,
      fn() -> (Double, Double, Double, Double) {
        let (nx, _, rw, rh) = node.rect()
        let nw = if rw > 0.0 { rw } else { match width { Some(w) => w; None => 0.0 } }
        let nh = if rh > 0.0 { rh } else { height }
        match node.lent(d_skel_group_lent) {
          Some(g) => {
            let (gx, _, gw, _) = g.host.rect()
            let sweep_w = if gw > 0.0 { gw } else { nw }
            (nx - gx, sweep_w, nh, g.host.cycle(g.period_ms))
          }
          None => (0.0, nw, nh, node.cycle(period_ms))
        }
      },
      fn() -> Int64 {
        match node.lent(d_skel_group_lent) {
          Some(_) => 0xFFFFFF80L
          None => aura_theme(node).palette.surface_tertiary
        }
      },
    )
  })
}

/// Pion-JSX `<aura::Skeleton>` wrapper.
pub fn Skeleton(
  parent : view::View,
  width? : Double,
  height~ : Double = 24.0,
  radius~ : Double = 8.0,
  animation~ : AuraSkeletonAnimation = AuraSkeletonAnimation::Shimmer,
  period_ms~ : Double = 2000.0,
  loc~ : String = "",
) -> view::View {
  skeleton_node(
    parent,
    width?=width,
    height=height,
    radius=radius,
    animation=animation,
    period_ms=period_ms,
    loc=loc,
  )
}

/// Aura `SkeletonGroup` container (Builder API): synchronizes all descendant `Skeleton` nodes on a shared shimmer clock.
pub fn skeleton_group_node(
  parent : view::View,
  gap~ : Double = 12.0,
  period_ms~ : Double = 2000.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(grp : view::View) -> Unit {
    let ctx = DSkelGroupCtx::{
      host: grp,
      period_ms,
      surface_bg: fn() -> Int64 { aura_theme(grp).palette.surface },
    }
    let _ = grp
      .lends(d_skel_group_lent, ctx)
      .gap(view::Live::Is(gap))
      .clips(view::Live::Is(true))
      .points(view::Live::Is(false))
    d_mount_skel_gpu_shimmer(
      grp,
      fn() -> Bool { !aura_reduced_motion(grp) },
      fn() -> (Double, Double, Double, Double) {
        let (_, _, gw, gh) = grp.rect()
        (0.0, gw, gh, grp.cycle(period_ms))
      },
      fn() -> Int64 { 0xFFFFFF80L },
    )
    content(grp)
  })
}

/// Pion-JSX `<aura::SkeletonGroup>` wrapper.
pub fn SkeletonGroup(
  parent : view::View,
  gap~ : Double = 12.0,
  period_ms~ : Double = 2000.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  skeleton_group_node(parent, gap=gap, period_ms=period_ms, content=children, loc=loc)
}
