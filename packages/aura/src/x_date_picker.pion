// Wave 1.5 Track 1.5B: DatePicker & DateRangePicker compound components (Builder + Pion-JSX).
// Composes `headless::date_field`, `headless::calendar`, `headless::range_calendar`, `headless::Popover`,
// `w0_popover_shell`, `w0_field_shell`, and Wave 1D `DateInputGroup` / `Calendar` / `RangeCalendar`.

import "headless"
import "headless_core"
import "hostapi"
import "signals"
import "view"

fn x_dp_words(size : Double, weight : Int, line : Double) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line }
}

fn x_dp_inherit_config(source : view::View, target : view::View) -> Unit {
  match aura_config_signal_of(source) {
    Some(sig) => {
      let _ = aura_provide_config(target, sig)
    }
    None => ()
  }
}

fn x_dp_placement_to_beside(p : headless::Placement, rtl : Bool) -> (view::Side, view::Along) {
  let flip = fn(a : view::Along) -> view::Along {
    if !rtl {
      a
    } else {
      match a {
        view::Along::Start => view::Along::End
        view::Along::End => view::Along::Start
        view::Along::Middle => view::Along::Middle
      }
    }
  }
  match p {
    headless::Placement::BelowStart => (view::Side::Bottom, flip(view::Along::Start))
    headless::Placement::BelowCenter => (view::Side::Bottom, view::Along::Middle)
    headless::Placement::BelowEnd => (view::Side::Bottom, flip(view::Along::End))
    headless::Placement::AboveStart => (view::Side::Top, flip(view::Along::Start))
    headless::Placement::AboveCenter => (view::Side::Top, view::Along::Middle)
    headless::Placement::AboveEnd => (view::Side::Top, flip(view::Along::End))
    headless::Placement::RightStart => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::Start)
    headless::Placement::RightCenter => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::Middle)
    headless::Placement::RightEnd => (if rtl { view::Side::Left } else { view::Side::Right }, view::Along::End)
    headless::Placement::LeftStart => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::Start)
    headless::Placement::LeftCenter => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::Middle)
    headless::Placement::LeftEnd => (if rtl { view::Side::Right } else { view::Side::Left }, view::Along::End)
  }
}

fn x_dp_seg_is_placeholder(dt_val : headless_core::SegmentedDateTime, kind : headless_core::DateSegmentKind) -> Bool {
  match kind {
    headless_core::DateSegmentKind::Year => dt_val.year is None
    headless_core::DateSegmentKind::Month => dt_val.month is None
    headless_core::DateSegmentKind::Day => dt_val.day is None
    headless_core::DateSegmentKind::Hour | headless_core::DateSegmentKind::DayPeriod => dt_val.hour is None
    headless_core::DateSegmentKind::Minute => dt_val.minute is None
    headless_core::DateSegmentKind::Second => dt_val.second is None
  }
}

fn x_dp_mount_date_segments(
  parent : view::View,
  aria_label : String,
  value : () -> headless_core::SegmentedDateTime,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
  order : AuraDateOrder,
  invalid : () -> Bool,
  disabled : () -> Bool,
  read_only : () -> Bool,
) -> Unit {
  let segs : Array[headless_core::DateSegmentKind] = match order {
    AuraDateOrder::MonthDayYear => [headless_core::DateSegmentKind::Month, headless_core::DateSegmentKind::Day, headless_core::DateSegmentKind::Year]
    AuraDateOrder::YearMonthDay => [headless_core::DateSegmentKind::Year, headless_core::DateSegmentKind::Month, headless_core::DateSegmentKind::Day]
  }
  let _ = headless::date_field(
    parent,
    fn() -> String { aria_label },
    value,
    on_change,
    fn(grp : view::View, df : headless::DateField) -> Unit {
      let _ = grp.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(0.0))
      let mut i = 0
      while i < segs.length() {
        if i > 0 {
          let _ = grp.box(fn(lit : view::View) -> Unit {
            let _ = lit
              .words(view::Live::Is("/"), look=x_dp_words(14.0, 400, 20.0))
              .ink(view::Live::By(fn() -> Int64 { aura_theme(lit).palette.muted }))
          })
        }
        let kind = segs[i]
        let _ = df.segment(grp, kind, fn(seg : view::View, _txt : () -> String) -> Unit {
          let _ = seg
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .pad_xy(2.25, 0.0)
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(seg) }))
            .radius(view::Live::Is(6.0))
            .ground(view::Live::By(fn() -> Int64 {
              let pal = aura_theme(seg).palette
              if seg.focused() {
                if invalid() { pal.danger_soft } else { pal.accent_soft }
              } else {
                0x00000000L
              }
            }))
          let _ = seg.box(fn(tw : view::View) -> Unit {
            let _ = tw
              .words(view::Live::By(fn() -> String { df.segment_text(kind) }), look=x_dp_words(14.0, 400, 20.0))
              .ink(view::Live::By(fn() -> Int64 {
                let pal = aura_theme(tw).palette
                if seg.focused() {
                  if invalid() { pal.danger_soft_foreground } else { pal.accent_soft_foreground }
                } else if invalid() {
                  pal.danger
                } else if x_dp_seg_is_placeholder(df.value(), kind) {
                  pal.field_placeholder
                } else {
                  pal.field_foreground
                }
              }))
          })
        })
        i += 1
      }
    },
    granularity=headless_core::DateGranularity::Day,
    disabled=disabled,
    read_only=read_only,
  )
}

fn x_dp_seg_to_iso(s : headless_core::SegmentedDateTime) -> Option[headless_core::IsoDate] {
  match (s.year, s.month, s.day) {
    (Some(y), Some(m), Some(d)) => Some(headless_core::IsoDate::new(y, m, d))
    _ => None
  }
}

fn x_dp_host_today() -> Option[headless_core::IsoDate] {
  let ms = hostapi::wall_ms()
  if ms >= 86400000.0 {
    let local_ms = ms + hostapi::utc_offset_min(ms).to_double() * 60000.0
    Some(headless_core::iso_from_epoch_days((local_ms / 86400000.0).floor().to_int()))
  } else {
    None
  }
}

fn x_dp_initial_date(
  primary : Option[headless_core::IsoDate],
  secondary : Option[headless_core::IsoDate],
  today : () -> Option[headless_core::IsoDate],
  min : Option[headless_core::IsoDate],
  max : Option[headless_core::IsoDate],
) -> headless_core::IsoDate {
  match primary {
    Some(d) => return d
    None => ()
  }
  match secondary {
    Some(d) => return d
    None => ()
  }
  match signals::untracked(today) {
    Some(td) => return td
    None => ()
  }
  let host_now = x_dp_host_today()
  match (min, max) {
    (Some(lo), Some(hi)) =>
      match host_now {
        Some(hd) =>
          if headless_core::iso_compare(hd, lo) >= 0 && headless_core::iso_compare(hd, hi) <= 0 {
            hd
          } else if headless_core::iso_compare(hd, lo) < 0 {
            lo
          } else {
            hi
          }
        None => lo
      }
    (Some(lo), None) =>
      match host_now {
        Some(hd) => if headless_core::iso_compare(hd, lo) >= 0 { hd } else { lo }
        None => lo
      }
    (None, Some(hi)) =>
      match host_now {
        Some(hd) => if headless_core::iso_compare(hd, hi) <= 0 { hd } else { hi }
        None => hi
      }
    _ =>
      match host_now {
        Some(hd) => hd
        None => headless_core::iso_from_epoch_days(0)
      }
  }
}

fn x_dp_date_allowed(
  d : headless_core::IsoDate,
  min : Option[headless_core::IsoDate],
  max : Option[headless_core::IsoDate],
  is_unavailable : (headless_core::IsoDate) -> Bool,
) -> Bool {
  !headless_core::calendar_is_unavailable(d, min, max, is_unavailable)
}

fn x_dp_try_commit_single(
  next : headless_core::SegmentedDateTime,
  disabled : () -> Bool,
  read_only : () -> Bool,
  min : Option[headless_core::IsoDate],
  max : Option[headless_core::IsoDate],
  is_unavailable : (headless_core::IsoDate) -> Bool,
  on_change : (headless_core::SegmentedDateTime) -> Unit,
) -> Bool {
  if signals::untracked(disabled) || signals::untracked(read_only) {
    return false
  }
  match x_dp_seg_to_iso(next) {
    Some(d) =>
      if !x_dp_date_allowed(d, min, max, is_unavailable) {
        return false
      }
    None => ()
  }
  on_change(next)
  true
}

fn x_dp_try_commit_range(
  next_s : headless_core::SegmentedDateTime,
  next_e : headless_core::SegmentedDateTime,
  disabled : () -> Bool,
  read_only : () -> Bool,
  min : Option[headless_core::IsoDate],
  max : Option[headless_core::IsoDate],
  is_unavailable : (headless_core::IsoDate) -> Bool,
  on_change : (headless_core::SegmentedDateTime, headless_core::SegmentedDateTime) -> Unit,
) -> Bool {
  if signals::untracked(disabled) || signals::untracked(read_only) {
    return false
  }
  let sd_opt = x_dp_seg_to_iso(next_s)
  let ed_opt = x_dp_seg_to_iso(next_e)
  match sd_opt {
    Some(sd) =>
      if !x_dp_date_allowed(sd, min, max, is_unavailable) {
        return false
      }
    None => ()
  }
  match ed_opt {
    Some(ed) =>
      if !x_dp_date_allowed(ed, min, max, is_unavailable) {
        return false
      }
    None => ()
  }
  match (sd_opt, ed_opt) {
    (Some(sd), Some(ed)) =>
      if headless_core::iso_compare(sd, ed) > 0 {
        return false
      }
    _ => ()
  }
  on_change(next_s, next_e)
  true
}

// ============================================================================
// 1. DatePicker
// ============================================================================

struct XDatePickerCtx {
  value : () -> headless_core::SegmentedDateTime
  on_change : (headless_core::SegmentedDateTime) -> Unit
  pop : headless::Popover
  today : () -> Option[headless_core::IsoDate]
  min : Option[headless_core::IsoDate]
  max : Option[headless_core::IsoDate]
  is_unavailable : (headless_core::IsoDate) -> Bool
  first_day_of_week : Int
  disabled : () -> Bool
  read_only : () -> Bool
  close_on_select : Bool
  anchor_box : signals::Ref[Option[view::View]]
}

let x_date_picker_ctx_lent : view::Lent[XDatePickerCtx] = view::Lent::new()

/// Aura `DatePickerTriggerIndicator` (Builder API): 16pt calendar icon in `--field-placeholder`.
pub fn date_picker_trigger_indicator_node(
  parent : view::View,
  icon~ : AuraIconKind = AuraIconKind::Calendar,
  size~ : Double = 16.0,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(ind : view::View) -> Unit {
    let _ = ind
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
    let _ = aura_icon_node(ind, icon, size=size, ink=fn() -> Int64 {
      aura_theme(ind).palette.field_placeholder
    })
  })
}

/// Pion-JSX `<aura::DatePickerTriggerIndicator>` wrapper.
pub fn DatePickerTriggerIndicator(
  parent : view::View,
  icon~ : AuraIconKind = AuraIconKind::Calendar,
  size~ : Double = 16.0,
  loc~ : String = "",
) -> view::View {
  date_picker_trigger_indicator_node(parent, icon=icon, size=size, loc=loc)
}

/// Aura `DatePickerTrigger` (Builder API): trigger button inside `DateInputGroup` suffix slot
/// toggling the calendar popover.
pub fn date_picker_trigger_node(
  parent : view::View,
  label~ : String = "Open calendar",
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_date_picker_ctx_lent) {
    Some(ctx) =>
      ctx.pop.trigger(
        parent,
        fn() -> String { label },
        fn(trig : view::View, disc : headless::Disclosure) -> Unit {
          let _ = trig
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .width(view::Live::Is(Some(24.0)))
            .height(view::Live::Is(Some(24.0)))
            .shrink(view::Live::Is(0.0))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(trig) }))
            .radius(view::Live::Is(6.0))
            .group_alpha(view::Live::By(fn() -> Double {
              if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
            }))
          let _ = w0_apply_control_focus_ring(trig)
          match content {
            Some(f) => f(trig)
            None => { let _ = date_picker_trigger_indicator_node(trig) }
          }
        },
        disabled=fn() -> Bool { (ctx.disabled)() || (ctx.read_only)() },
        loc=loc,
      )
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::DatePickerTrigger>` wrapper.
pub fn DatePickerTrigger(
  parent : view::View,
  label~ : String = "Open calendar",
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  date_picker_trigger_node(parent, label=label, content?=children, loc=loc)
}

/// Aura `DatePickerPopover` (Builder API): overlay panel (`w0_popover_shell`, `pad=12`, `radius=20`)
/// hosting `Calendar` (with `CalendarYearPicker`), filling segments immediately on date select.
pub fn date_picker_popover_node(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  calendar_width~ : Double = 252.0,
  show_year_picker~ : Bool = true,
  aria_label~ : String = "Choose date",
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_date_picker_ctx_lent) {
    Some(ctx) =>
      parent.box(loc=loc, fn(anchor : view::View) -> Unit {
        let _ = anchor
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .points(view::Live::Is(false))
        let root = anchor.tree.root()
        let portal_tie = root.show_scoped(
          fn() -> Bool { true },
          fn(portal : view::View) -> Unit {
            let _ = portal
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::Is(false))
            x_dp_inherit_config(anchor, portal)
            let _ = portal.lends(x_date_picker_ctx_lent, ctx)

            ctx.pop.layer(
              portal,
              fn() -> String { aria_label },
              fn(layer_v : view::View, opener : Option[view::View]) -> Unit {
                let rtl = aura_rtl(anchor)
                let (b_side, b_along) = x_dp_placement_to_beside(placement, rtl)
                let pop_w = calendar_width + 24.0
                let _ = layer_v
                  .points(view::Live::Is(true))
                  .width(view::Live::Is(Some(pop_w)))
                let anchor_target = match ctx.anchor_box.v {
                  Some(ab) => if ab.alive() { Some(ab) } else { opener }
                  None => opener
                }
                match anchor_target {
                  Some(op) => {
                    let _ = layer_v.beside(op.id(), side=b_side, along=b_along, offset=gap, padding=8.0)
                  }
                  None => {
                    let _ = layer_v.over(view::Live::Is(true), edges=(Some(0.0), Some(gap), None, None))
                  }
                }
                let rad = {
                  let r = aura_theme(anchor).radius * 2.5
                  if r > 32.0 { 32.0 } else { r }
                }
                let shell = w0_popover_shell(
                  layer_v,
                  radius=rad,
                  pad=12.0,
                  gap=8.0,
                  content=fn(panel : view::View) -> Unit {
                    match content {
                      Some(f) => f(panel)
                      None => {
                        let init_d = x_dp_initial_date(
                          x_dp_seg_to_iso(signals::untracked(ctx.value)),
                          None,
                          ctx.today,
                          ctx.min,
                          ctx.max,
                        )
                        let _ = calendar_node(
                          panel,
                          init_d,
                          fn() -> Option[headless_core::IsoDate] { x_dp_seg_to_iso((ctx.value)()) },
                          fn(d : headless_core::IsoDate) -> Unit {
                            let cur = signals::untracked(ctx.value)
                            let next = headless_core::SegmentedDateTime::{
                              ..cur,
                              year: Some(d.year),
                              month: Some(d.month),
                              day: Some(d.day),
                            }
                            if x_dp_try_commit_single(next, ctx.disabled, ctx.read_only, ctx.min, ctx.max, ctx.is_unavailable, ctx.on_change) {
                              if ctx.close_on_select {
                                ctx.pop.close()
                              }
                            }
                          },
                          today=ctx.today,
                          min?=ctx.min,
                          max?=ctx.max,
                          is_unavailable=ctx.is_unavailable,
                          first_day_of_week=ctx.first_day_of_week,
                          show_year_picker=show_year_picker,
                          width=calendar_width,
                          disabled=fn() -> Bool { (ctx.disabled)() || (ctx.read_only)() },
                        )
                      }
                    }
                  },
                )
                let _ = shell.width(view::Live::Is(Some(pop_w)))
              },
            )
          },
          at_once=true,
        )
        portal_tie(anchor)
      })
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::DatePickerPopover>` wrapper.
pub fn DatePickerPopover(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  calendar_width~ : Double = 252.0,
  show_year_picker~ : Bool = true,
  aria_label~ : String = "Choose date",
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  date_picker_popover_node(
    parent,
    placement=placement,
    gap=gap,
    calendar_width=calendar_width,
    show_year_picker=show_year_picker,
    aria_label=aria_label,
    content?=children,
    loc=loc,
  )
}

/// Aura `DatePicker` compound component (Builder API).
/// Combines `Label` + `DateInputGroup` (`DateField` segments + `DatePickerTrigger`) + `DatePickerPopover`.
pub fn date_picker_node(
  parent : view::View,
  value? : () -> headless_core::SegmentedDateTime,
  default_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  on_change~ : (headless_core::SegmentedDateTime) -> Unit = fn(_v : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  close_on_select~ : Bool = true,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  show_year_picker~ : Bool = true,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : () -> Bool = fn() { false },
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let internal_val = signals::signal_by(default_value, fn(a, b) { a.eq(b) })
  let val_get = match value {
    Some(f) => f
    None => fn() -> headless_core::SegmentedDateTime { internal_val.get() }
  }
  let change_fn = match value {
    Some(_) => on_change
    None =>
      fn(v : headless_core::SegmentedDateTime) -> Unit {
        internal_val.set(v)
        on_change(v)
      }
  }
  let internal_open = signals::signal(default_open)
  let open_get = match open {
    Some(f) => f
    None => fn() -> Bool { internal_open.get() }
  }
  let open_set = match set_open {
    Some(f) => f
    None => fn(b : Bool) -> Unit { internal_open.set(b) }
  }
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let pop = headless::Popover::new(open_get, open_set)
  let anchor_box : signals::Ref[Option[view::View]] = view::ref_new(None)
  let ctx = XDatePickerCtx::{
    value: val_get,
    on_change: change_fn,
    pop,
    today,
    min,
    max,
    is_unavailable,
    first_day_of_week,
    disabled: dis_get,
    read_only,
    close_on_select,
    anchor_box,
  }

  parent.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col
      .lends(x_date_picker_ctx_lent, ctx)
      .fills_across(view::Live::Is(true))
      .gap(view::Live::Is(4.0))
    match content {
      Some(f) => f(col)
      None => {
        if label != "" {
          let _ = label_node(col, view::Live::Is(label), disabled=disabled)
        }
        let field_shell = w0_field_shell(
          col,
          variant=variant,
          invalid=invalid,
          disabled=disabled,
          height=36.0,
          pad_x=12.0,
          content=fn(row : view::View) -> Unit {
            let _ = row.row_reverse(view::Live::By(fn() -> Bool { aura_rtl(row) }))
            let _ = row.box(fn(mid : view::View) -> Unit {
              let _ = mid
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .min_width(view::Live::Is(Some(0.0)))
              x_dp_mount_date_segments(
                mid,
                if label != "" { label } else { "Date" },
                val_get,
                fn(next : headless_core::SegmentedDateTime) -> Unit {
                  let _ = x_dp_try_commit_single(next, dis_get, read_only, min, max, is_unavailable, change_fn)
                },
                order,
                inv_get,
                dis_get,
                read_only,
              )
            })
            let _ = date_picker_trigger_node(row, label=if label != "" { "Open \{label} calendar" } else { "Open calendar" })
          },
        )
        let _ = field_shell.fills_across(view::Live::Is(true))
        anchor_box.v = Some(field_shell)
        let _ = date_picker_popover_node(
          col,
          placement=placement,
          show_year_picker=show_year_picker,
          aria_label=if label != "" { label } else { "Choose date" },
        )
        if description != "" {
          let _ = col.show(fn() -> Bool { !inv_get() }, fn(d : view::View) -> Unit {
            let _ = description_node(d, view::Live::Is(description))
          })
        }
        if error_message != "" {
          let _ = field_error_node(col, view::Live::Is(error_message), visible=invalid)
        }
      }
    }
  })
}

/// Pion-JSX `<aura::DatePicker>` wrapper.
pub fn DatePicker(
  parent : view::View,
  value? : () -> headless_core::SegmentedDateTime,
  default_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  on_change~ : (headless_core::SegmentedDateTime) -> Unit = fn(_v : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  close_on_select~ : Bool = true,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  show_year_picker~ : Bool = true,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  read_only~ : () -> Bool = fn() { false },
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  date_picker_node(
    parent,
    value?=value,
    default_value=default_value,
    on_change=on_change,
    label=label,
    description=description,
    error_message=error_message,
    order=order,
    variant=variant,
    open?=open,
    set_open?=set_open,
    default_open=default_open,
    close_on_select=close_on_select,
    placement=placement,
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    show_year_picker=show_year_picker,
    invalid=inv,
    disabled=dis,
    read_only=read_only,
    content?=children,
    loc=loc,
  )
}

// ============================================================================
// 2. DateRangePicker
// ============================================================================

struct XDateRangePickerCtx {
  start_value : () -> headless_core::SegmentedDateTime
  end_value : () -> headless_core::SegmentedDateTime
  on_change : (headless_core::SegmentedDateTime, headless_core::SegmentedDateTime) -> Unit
  pop : headless::Popover
  today : () -> Option[headless_core::IsoDate]
  min : Option[headless_core::IsoDate]
  max : Option[headless_core::IsoDate]
  is_unavailable : (headless_core::IsoDate) -> Bool
  first_day_of_week : Int
  disabled : () -> Bool
  read_only : () -> Bool
  close_on_select : Bool
  anchor_box : signals::Ref[Option[view::View]]
}

let x_date_range_picker_ctx_lent : view::Lent[XDateRangePickerCtx] = view::Lent::new()

/// Aura `DateRangePickerTriggerIndicator` (Builder API): 16pt calendar icon in `--field-placeholder`.
pub fn date_range_picker_trigger_indicator_node(
  parent : view::View,
  icon~ : AuraIconKind = AuraIconKind::Calendar,
  size~ : Double = 16.0,
  loc~ : String = "",
) -> view::View {
  date_picker_trigger_indicator_node(parent, icon=icon, size=size, loc=loc)
}

/// Pion-JSX `<aura::DateRangePickerTriggerIndicator>` wrapper.
pub fn DateRangePickerTriggerIndicator(
  parent : view::View,
  icon~ : AuraIconKind = AuraIconKind::Calendar,
  size~ : Double = 16.0,
  loc~ : String = "",
) -> view::View {
  date_range_picker_trigger_indicator_node(parent, icon=icon, size=size, loc=loc)
}

/// Aura `DateRangePickerRangeSeparator` (Builder API): inline `"-"` separator (2pt horizontal padding, `--field-placeholder`).
pub fn date_range_picker_range_separator_node(
  parent : view::View,
  text~ : String = "-",
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(sep : view::View) -> Unit {
    let _ = sep
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .pad_xy(2.0, 0.0)
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
    let _ = sep.box(fn(tw : view::View) -> Unit {
      let _ = tw
        .words(view::Live::Is(text), look=x_dp_words(14.0, 400, 20.0))
        .ink(view::Live::By(fn() -> Int64 { aura_theme(tw).palette.field_placeholder }))
    })
  })
}

/// Pion-JSX `<aura::DateRangePickerRangeSeparator>` wrapper.
pub fn DateRangePickerRangeSeparator(
  parent : view::View,
  text~ : String = "-",
  loc~ : String = "",
) -> view::View {
  date_range_picker_range_separator_node(parent, text=text, loc=loc)
}

/// Aura `DateRangePickerTrigger` (Builder API): trigger button toggling the range calendar popover.
pub fn date_range_picker_trigger_node(
  parent : view::View,
  label~ : String = "Open date range calendar",
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_date_range_picker_ctx_lent) {
    Some(ctx) =>
      ctx.pop.trigger(
        parent,
        fn() -> String { label },
        fn(trig : view::View, disc : headless::Disclosure) -> Unit {
          let _ = trig
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .width(view::Live::Is(Some(24.0)))
            .height(view::Live::Is(Some(24.0)))
            .shrink(view::Live::Is(0.0))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(trig) }))
            .radius(view::Live::Is(6.0))
            .group_alpha(view::Live::By(fn() -> Double {
              if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
            }))
          let _ = w0_apply_control_focus_ring(trig)
          match content {
            Some(f) => f(trig)
            None => { let _ = date_range_picker_trigger_indicator_node(trig) }
          }
        },
        disabled=fn() -> Bool { (ctx.disabled)() || (ctx.read_only)() },
        loc=loc,
      )
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::DateRangePickerTrigger>` wrapper.
pub fn DateRangePickerTrigger(
  parent : view::View,
  label~ : String = "Open date range calendar",
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  date_range_picker_trigger_node(parent, label=label, content?=children, loc=loc)
}

/// Aura `DateRangePickerPopover` (Builder API): overlay panel (`w0_popover_shell`, `pad=12`, `radius=20`)
/// hosting `RangeCalendar`, filling both start and end segments immediately upon range completion.
pub fn date_range_picker_popover_node(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  calendar_width~ : Double = 252.0,
  aria_label~ : String = "Choose date range",
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_date_range_picker_ctx_lent) {
    Some(ctx) =>
      parent.box(loc=loc, fn(anchor : view::View) -> Unit {
        let _ = anchor
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .points(view::Live::Is(false))
        let root = anchor.tree.root()
        let portal_tie = root.show_scoped(
          fn() -> Bool { true },
          fn(portal : view::View) -> Unit {
            let _ = portal
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::Is(false))
            x_dp_inherit_config(anchor, portal)
            let _ = portal.lends(x_date_range_picker_ctx_lent, ctx)

            ctx.pop.layer(
              portal,
              fn() -> String { aria_label },
              fn(layer_v : view::View, opener : Option[view::View]) -> Unit {
                let rtl = aura_rtl(anchor)
                let (b_side, b_along) = x_dp_placement_to_beside(placement, rtl)
                let pop_w = calendar_width + 24.0
                let _ = layer_v
                  .points(view::Live::Is(true))
                  .width(view::Live::Is(Some(pop_w)))
                let anchor_target = match ctx.anchor_box.v {
                  Some(ab) => if ab.alive() { Some(ab) } else { opener }
                  None => opener
                }
                match anchor_target {
                  Some(op) => {
                    let _ = layer_v.beside(op.id(), side=b_side, along=b_along, offset=gap, padding=8.0)
                  }
                  None => {
                    let _ = layer_v.over(view::Live::Is(true), edges=(Some(0.0), Some(gap), None, None))
                  }
                }
                let rad = {
                  let r = aura_theme(anchor).radius * 2.5
                  if r > 32.0 { 32.0 } else { r }
                }
                let shell = w0_popover_shell(
                  layer_v,
                  radius=rad,
                  pad=12.0,
                  gap=8.0,
                  content=fn(panel : view::View) -> Unit {
                    match content {
                      Some(f) => f(panel)
                      None => {
                        let init_d = x_dp_initial_date(
                          x_dp_seg_to_iso(signals::untracked(ctx.start_value)),
                          x_dp_seg_to_iso(signals::untracked(ctx.end_value)),
                          ctx.today,
                          ctx.min,
                          ctx.max,
                        )
                        let _ = range_calendar_node(
                          panel,
                          init_d,
                          fn() -> Option[(headless_core::IsoDate, headless_core::IsoDate)] {
                            match (x_dp_seg_to_iso((ctx.start_value)()), x_dp_seg_to_iso((ctx.end_value)())) {
                              (Some(s), Some(e)) => Some((s, e))
                              _ => None
                            }
                          },
                          fn(s : headless_core::IsoDate, e : headless_core::IsoDate) -> Unit {
                            let cur_s = signals::untracked(ctx.start_value)
                            let cur_e = signals::untracked(ctx.end_value)
                            let next_s = headless_core::SegmentedDateTime::{
                              ..cur_s,
                              year: Some(s.year),
                              month: Some(s.month),
                              day: Some(s.day),
                            }
                            let next_e = headless_core::SegmentedDateTime::{
                              ..cur_e,
                              year: Some(e.year),
                              month: Some(e.month),
                              day: Some(e.day),
                            }
                            if x_dp_try_commit_range(next_s, next_e, ctx.disabled, ctx.read_only, ctx.min, ctx.max, ctx.is_unavailable, ctx.on_change) {
                              if ctx.close_on_select {
                                ctx.pop.close()
                              }
                            }
                          },
                          today=ctx.today,
                          min?=ctx.min,
                          max?=ctx.max,
                          is_unavailable=ctx.is_unavailable,
                          first_day_of_week=ctx.first_day_of_week,
                          width=calendar_width,
                          disabled=fn() -> Bool { (ctx.disabled)() || (ctx.read_only)() },
                        )
                      }
                    }
                  },
                )
                let _ = shell.width(view::Live::Is(Some(pop_w)))
              },
            )
          },
          at_once=true,
        )
        portal_tie(anchor)
      })
    None => parent.box(loc=loc, fn(_v : view::View) { () })
  }
}

/// Pion-JSX `<aura::DateRangePickerPopover>` wrapper.
pub fn DateRangePickerPopover(
  parent : view::View,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  calendar_width~ : Double = 252.0,
  aria_label~ : String = "Choose date range",
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  date_range_picker_popover_node(
    parent,
    placement=placement,
    gap=gap,
    calendar_width=calendar_width,
    aria_label=aria_label,
    content?=children,
    loc=loc,
  )
}

/// Aura `DateRangePicker` compound component (Builder API).
/// Combines `Label` + `DateInputGroup` (start `DateField` + `DateRangePickerRangeSeparator` + end `DateField`
/// + `DateRangePickerTrigger`) + `DateRangePickerPopover`.
pub fn date_range_picker_node(
  parent : view::View,
  start_value? : () -> headless_core::SegmentedDateTime,
  end_value? : () -> headless_core::SegmentedDateTime,
  default_start_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  default_end_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  on_change~ : (headless_core::SegmentedDateTime, headless_core::SegmentedDateTime) -> Unit = fn(_a : headless_core::SegmentedDateTime, _b : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  separator~ : String = "-",
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  close_on_select~ : Bool = true,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  read_only~ : () -> Bool = fn() { false },
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let internal_start = signals::signal_by(default_start_value, fn(a, b) { a.eq(b) })
  let internal_end = signals::signal_by(default_end_value, fn(a, b) { a.eq(b) })
  let start_get = match start_value {
    Some(f) => f
    None => fn() -> headless_core::SegmentedDateTime { internal_start.get() }
  }
  let end_get = match end_value {
    Some(f) => f
    None => fn() -> headless_core::SegmentedDateTime { internal_end.get() }
  }
  let change_fn = fn(ns : headless_core::SegmentedDateTime, ne : headless_core::SegmentedDateTime) -> Unit {
    if start_value is None {
      internal_start.set(ns)
    }
    if end_value is None {
      internal_end.set(ne)
    }
    on_change(ns, ne)
  }
  let internal_open = signals::signal(default_open)
  let open_get = match open {
    Some(f) => f
    None => fn() -> Bool { internal_open.get() }
  }
  let open_set = match set_open {
    Some(f) => f
    None => fn(b : Bool) -> Unit { internal_open.set(b) }
  }
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let pop = headless::Popover::new(open_get, open_set)
  let anchor_box : signals::Ref[Option[view::View]] = view::ref_new(None)
  let ctx = XDateRangePickerCtx::{
    start_value: start_get,
    end_value: end_get,
    on_change: change_fn,
    pop,
    today,
    min,
    max,
    is_unavailable,
    first_day_of_week,
    disabled: dis_get,
    read_only,
    close_on_select,
    anchor_box,
  }

  parent.box(loc=loc, fn(col : view::View) -> Unit {
    let _ = col
      .lends(x_date_range_picker_ctx_lent, ctx)
      .fills_across(view::Live::Is(true))
      .gap(view::Live::Is(4.0))
    match content {
      Some(f) => f(col)
      None => {
        if label != "" {
          let _ = label_node(col, view::Live::Is(label), disabled=disabled)
        }
        let field_shell = w0_field_shell(
          col,
          variant=variant,
          invalid=invalid,
          disabled=disabled,
          height=36.0,
          pad_x=12.0,
          content=fn(row : view::View) -> Unit {
            let _ = row.row_reverse(view::Live::By(fn() -> Bool { aura_rtl(row) }))
            let _ = row.box(fn(mid : view::View) -> Unit {
              let _ = mid
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .min_width(view::Live::Is(Some(0.0)))
              x_dp_mount_date_segments(
                mid,
                "Start date",
                start_get,
                fn(ns : headless_core::SegmentedDateTime) -> Unit {
                  let _ = x_dp_try_commit_range(ns, signals::untracked(end_get), dis_get, read_only, min, max, is_unavailable, change_fn)
                },
                order,
                inv_get,
                dis_get,
                read_only,
              )
              let _ = date_range_picker_range_separator_node(mid, text=separator)
              x_dp_mount_date_segments(
                mid,
                "End date",
                end_get,
                fn(ne : headless_core::SegmentedDateTime) -> Unit {
                  let _ = x_dp_try_commit_range(signals::untracked(start_get), ne, dis_get, read_only, min, max, is_unavailable, change_fn)
                },
                order,
                inv_get,
                dis_get,
                read_only,
              )
            })
            let _ = date_range_picker_trigger_node(
              row,
              label=if label != "" { "Open \{label} calendar" } else { "Open date range calendar" },
            )
          },
        )
        let _ = field_shell.fills_across(view::Live::Is(true))
        anchor_box.v = Some(field_shell)
        let _ = date_range_picker_popover_node(
          col,
          placement=placement,
          aria_label=if label != "" { label } else { "Choose date range" },
        )
        if description != "" {
          let _ = col.show(fn() -> Bool { !inv_get() }, fn(d : view::View) -> Unit {
            let _ = description_node(d, view::Live::Is(description))
          })
        }
        if error_message != "" {
          let _ = field_error_node(col, view::Live::Is(error_message), visible=invalid)
        }
      }
    }
  })
}

/// Pion-JSX `<aura::DateRangePicker>` wrapper.
pub fn DateRangePicker(
  parent : view::View,
  start_value? : () -> headless_core::SegmentedDateTime,
  end_value? : () -> headless_core::SegmentedDateTime,
  default_start_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  default_end_value~ : headless_core::SegmentedDateTime = headless_core::SegmentedDateTime::empty(),
  on_change~ : (headless_core::SegmentedDateTime, headless_core::SegmentedDateTime) -> Unit = fn(_a : headless_core::SegmentedDateTime, _b : headless_core::SegmentedDateTime) { () },
  label~ : String = "",
  description~ : String = "",
  error_message~ : String = "",
  separator~ : String = "-",
  order~ : AuraDateOrder = AuraDateOrder::MonthDayYear,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  open? : () -> Bool,
  set_open? : (Bool) -> Unit,
  default_open~ : Bool = false,
  close_on_select~ : Bool = true,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  today~ : () -> Option[headless_core::IsoDate] = fn() { None },
  min? : headless_core::IsoDate,
  max? : headless_core::IsoDate,
  is_unavailable~ : (headless_core::IsoDate) -> Bool = fn(_d : headless_core::IsoDate) -> Bool { false },
  first_day_of_week~ : Int = 0,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  read_only~ : () -> Bool = fn() { false },
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  date_range_picker_node(
    parent,
    start_value?=start_value,
    end_value?=end_value,
    default_start_value=default_start_value,
    default_end_value=default_end_value,
    on_change=on_change,
    label=label,
    description=description,
    error_message=error_message,
    separator=separator,
    order=order,
    variant=variant,
    open?=open,
    set_open?=set_open,
    default_open=default_open,
    close_on_select=close_on_select,
    placement=placement,
    today=today,
    min?=min,
    max?=max,
    is_unavailable=is_unavailable,
    first_day_of_week=first_day_of_week,
    invalid=inv,
    disabled=dis,
    read_only=read_only,
    content?=children,
    loc=loc,
  )
}
