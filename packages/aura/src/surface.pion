// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Surface and Separator atomic components.

import "signals"
import "view"

/// Surface variant aligned with HeroUI v3.2.8 `Surface` (`default`, `secondary`, `tertiary`, `transparent`).
#derive(Eq)
pub enum AuraSurfaceVariant {
  Default
  Secondary
  Tertiary
  Transparent
}

fn w0_surface_variant_level(v : AuraSurfaceVariant) -> AuraSurfaceLevel {
  match v {
    AuraSurfaceVariant::Default => AuraSurfaceLevel::Primary
    AuraSurfaceVariant::Secondary => AuraSurfaceLevel::Secondary
    AuraSurfaceVariant::Tertiary => AuraSurfaceLevel::Tertiary
    AuraSurfaceVariant::Transparent => AuraSurfaceLevel::Transparent
  }
}

/// Aura `Surface` container (Builder API).
/// Uses circular CSS corners and borrows `SurfaceContext` to descendants (`Transparent` dynamically inherits the
/// parent level). When `variant` is omitted and `AuraConfig.auto_surface == true`, automatically steps one level
/// deeper than the enclosing `SurfaceContext` via `aura_next_surface_level`; explicit `variant` always wins.
/// Like HeroUI's `.surface` (`surface.css`: background only) it casts no shadow by default; `shadow=true` gives it
/// `Card`'s `shadow-surface` (`card.css`), the 3-layer light shadow (none in dark).
pub fn surface_node(
  parent : view::View,
  variant? : AuraSurfaceVariant,
  radius? : Double,
  pad~ : Double = 0.0,
  gap~ : Double = 0.0,
  shadow~ : Bool = false,
  bordered~ : Bool = false,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let parent_lent = parent.lent(w0_surface_lent)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let eff_level = fn() -> AuraSurfaceLevel {
      match variant {
        Some(v) => w0_surface_variant_level(v)
        None =>
          if aura_config_of(node).auto_surface {
            match parent_lent {
              Some(pg) => aura_next_surface_level(pg())
              None => AuraSurfaceLevel::Primary
            }
          } else {
            AuraSurfaceLevel::Primary
          }
      }
    }
    let _ = aura_provide_surface_by(node, eff_level)
    let _ = node
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::By(fn() -> Double {
        match radius {
          Some(r) => r
          None => aura_theme(node).surface_radius
        }
      }))
      .ground(view::Live::By(fn() -> Int64 {
        aura_surface_bg(aura_theme(node).palette, eff_level())
      }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        if !shadow || eff_level() is AuraSurfaceLevel::Transparent {
          []
        } else {
          aura_surface_shadows(aura_theme(node).config.dark)
        }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if bordered {
          let th = aura_theme(node)
          (th.border_width, th.palette.border)
        } else {
          (0.0, 0L)
        }
      }))
    if pad > 0.0 {
      let _ = node.pad(view::Live::Is(pad))
    }
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::Surface>` wrapper.
pub fn Surface(
  parent : view::View,
  variant? : AuraSurfaceVariant,
  radius? : Double,
  pad~ : Double = 0.0,
  gap~ : Double = 0.0,
  shadow~ : Bool = false,
  bordered~ : Bool = false,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  surface_node(
    parent,
    variant?=variant,
    radius?=radius,
    pad=pad,
    gap=gap,
    shadow=shadow,
    bordered=bordered,
    content=children,
    loc=loc,
  )
}

/// Separator orientation.
#derive(Eq)
pub enum AuraOrientation {
  Horizontal
  Vertical
}

/// Separator visual variant matching `--separator`, `--separator-secondary`, `--separator-tertiary`.
#derive(Eq)
pub enum AuraSeparatorVariant {
  Default
  Secondary
  Tertiary
}

/// Aura `Separator` hairline divider (Builder API).
pub fn separator_node(
  parent : view::View,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraSeparatorVariant = AuraSeparatorVariant::Default,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura_theme(node).palette
        match variant {
          AuraSeparatorVariant::Default => pal.separator
          AuraSeparatorVariant::Secondary => pal.separator_secondary
          AuraSeparatorVariant::Tertiary => pal.separator_tertiary
        }
      }))
    match orientation {
      AuraOrientation::Horizontal => {
        let _ = node.height(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true))
      }
      AuraOrientation::Vertical => {
        let _ = node.width(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true))
      }
    }
  })
}

/// Pion-JSX `<aura::Separator>` wrapper.
pub fn Separator(
  parent : view::View,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraSeparatorVariant = AuraSeparatorVariant::Default,
  loc~ : String = "",
) -> view::View {
  separator_node(parent, orientation=orientation, variant=variant, loc=loc)
}
