// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): ButtonGroup with orientation,
// adjacent corner zeroing, optional internal separators, and full-width stretching.

import "view"

struct a_ButtonGroupCtx {
  orientation : AuraOrientation
  variant : AuraButtonVariant
  size : AuraButtonSize
  full_width : Bool
  hide_separator : Bool
  disabled : () -> Bool
}

let a_btn_group_lent : view::Lent[a_ButtonGroupCtx] = view::Lent::new()

fn a_group_item_corners(
  orientation : AuraOrientation,
  index : Int,
  total : Int,
  r : Double,
  rtl~ : Bool = false,
) -> (Double, Double, Double, Double) {
  if total <= 1 {
    (r, r, r, r)
  } else {
    let is_first = index <= 0
    let is_last = index >= total - 1
    match orientation {
      AuraOrientation::Horizontal =>
        if is_first {
          if rtl { (0.0, r, r, 0.0) } else { (r, 0.0, 0.0, r) }
        } else if is_last {
          if rtl { (r, 0.0, 0.0, r) } else { (0.0, r, r, 0.0) }
        } else {
          (0.0, 0.0, 0.0, 0.0)
        }
      AuraOrientation::Vertical =>
        if is_first {
          (r, r, 0.0, 0.0)
        } else if is_last {
          (0.0, 0.0, r, r)
        } else {
          (0.0, 0.0, 0.0, 0.0)
        }
    }
  }
}

fn a_with_alpha_15(c : Int64) -> Int64 {
  // 15% opacity of RGB color `c` (`opacity-15` in `button-group.css`: 0.15 * 255 = 38 = 0x26).
  (c & 0xFFFFFF00L) | 0x26L
}

fn a_btn_group_sep_color(pal : AuraPalette, variant : AuraButtonVariant) -> Int64 {
  let fg = match variant {
    AuraButtonVariant::Primary => pal.accent_foreground
    AuraButtonVariant::Secondary => pal.accent_soft_foreground
    AuraButtonVariant::Tertiary => pal.default_foreground
    AuraButtonVariant::Ghost => pal.foreground
    AuraButtonVariant::Outline => pal.foreground
    AuraButtonVariant::Danger => pal.danger_foreground
    AuraButtonVariant::DangerSoft => pal.danger_soft_foreground
  }
  a_with_alpha_15(fg)
}

/// Internal separator bar for `ButtonGroup` (`button-group__separator`).
/// Renders a 1pt-wide (horizontal) or 1pt-tall (vertical) 50%-span bar at 15% of current foreground.
pub fn button_group_separator_node(
  parent : view::View,
  orientation? : AuraOrientation,
  variant? : AuraButtonVariant,
  loc~ : String = "",
) -> view::View {
  let ctx = parent.lent(a_btn_group_lent)
  let ori = match orientation {
    Some(o) => o
    None => match ctx { Some(c) => c.orientation; None => AuraOrientation::Horizontal }
  }
  let vari = match variant {
    Some(v) => v
    None => match ctx { Some(c) => c.variant; None => AuraButtonVariant::Secondary }
  }
  parent.box(loc=loc, fn(holder : view::View) -> Unit {
    let _ = holder
      .points(view::Live::Is(false))
      .shrink(view::Live::Is(0.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
    match ori {
      AuraOrientation::Horizontal => {
        let _ = holder.width(view::Live::Is(Some(0.0))).height(view::Live::Is(Some(18.0)))
        let _ = holder.box(fn(bar : view::View) -> Unit {
          let _ = bar
            .over(view::Live::Is(true), edges=(Some(-0.5), Some(0.0), None, None))
            .width(view::Live::Is(Some(1.0)))
            .height(view::Live::Is(Some(18.0)))
            .corner_circular(view::Live::Is(true))
            .radius(view::Live::Is(1.0))
            .points(view::Live::Is(false))
            .ground(view::Live::By(fn() -> Int64 {
              a_btn_group_sep_color(aura_theme(holder).palette, vari)
            }))
        })
      }
      AuraOrientation::Vertical => {
        let _ = holder.height(view::Live::Is(Some(0.0))).fills_across(view::Live::Is(true))
        let _ = holder.box(fn(bar : view::View) -> Unit {
          let _ = bar
            .width_share(view::Live::Is(0.5))
            .height(view::Live::Is(Some(1.0)))
            .corner_circular(view::Live::Is(true))
            .radius(view::Live::Is(1.0))
            .points(view::Live::Is(false))
            .ground(view::Live::By(fn() -> Int64 {
              a_btn_group_sep_color(aura_theme(holder).palette, vari)
            }))
        })
      }
    }
  })
}

/// Pion-JSX `<aura::ButtonGroupSeparator>` wrapper.
pub fn ButtonGroupSeparator(
  parent : view::View,
  orientation? : AuraOrientation,
  variant? : AuraButtonVariant,
  loc~ : String = "",
) -> view::View {
  button_group_separator_node(parent, orientation?=orientation, variant?=variant, loc=loc)
}

/// Aura `ButtonGroup` container (Builder API).
/// Groups related buttons with `Role::Group`, zero gap, shared orientation/variant/size/disabled context,
/// adjacent corner zeroing, optional separators (`hide_separator`), and `full_width`.
pub fn button_group_node(
  parent : view::View,
  label~ : String = "Button group",
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  full_width~ : Bool = false,
  hide_separator~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let dis_get = disabled.to_getter()
  let ctx = a_ButtonGroupCtx::{
    orientation,
    variant,
    size,
    full_width,
    hide_separator,
    disabled: dis_get,
  }
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .lends(a_btn_group_lent, ctx)
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .gap(view::Live::Is(0.0))
      .says(view::Live::Is(Some(view::said(view::Role::Group, label=label))))
    if orientation is AuraOrientation::Horizontal {
      let _ = node.row_reverse(view::Live::By(fn() -> Bool { aura_rtl(node) }))
    } else {
      let _ = node.row(view::Live::Is(false))
    }
    if full_width {
      let _ = node.fills_across(view::Live::Is(true))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::ButtonGroup>` wrapper.
pub fn ButtonGroup(
  parent : view::View,
  label~ : String = "Button group",
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  full_width~ : Bool = false,
  hide_separator~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  button_group_node(
    parent,
    label=label,
    orientation=orientation,
    variant=variant,
    size=size,
    full_width=full_width,
    hide_separator=hide_separator,
    disabled=dis,
    content=children,
    loc=loc,
  )
}

/// A button positioned at `index` of `total` inside a `ButtonGroup` (Builder API).
/// Automatically zeroes adjacent corners, inherits group `variant`/`size`/`disabled`/`full_width`,
/// and inserts an internal separator before `index > 0` unless `hide_separator` is enabled.
pub fn button_group_item_node(
  parent : view::View,
  label : view::Live[String],
  index : Int,
  total : Int,
  on_press~ : () -> Unit = fn() { () },
  variant? : AuraButtonVariant,
  size? : AuraButtonSize,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let ctx = parent.lent(a_btn_group_lent)
  let ori = match ctx { Some(c) => c.orientation; None => AuraOrientation::Horizontal }
  let vari = match variant {
    Some(v) => v
    None => match ctx { Some(c) => c.variant; None => AuraButtonVariant::Secondary }
  }
  let sz = match size {
    Some(s) => s
    None => match ctx { Some(c) => c.size; None => AuraButtonSize::Md }
  }
  let fw = match ctx { Some(c) => c.full_width; None => false }
  let hide_sep = match ctx { Some(c) => c.hide_separator; None => false }
  let grp_dis = match ctx { Some(c) => c.disabled; None => fn() { false } }
  let item_dis = disabled.to_getter()
  let eff_dis = view::Live::By(fn() -> Bool { grp_dis() || item_dis() })

  if index > 0 && !hide_sep {
    let _ = button_group_separator_node(parent, orientation=ori, variant=vari)
  }
  let r = match sz {
    AuraButtonSize::Sm => 16.0
    AuraButtonSize::Md => 18.0
    AuraButtonSize::Lg => 20.0
  }
  let cs = a_group_item_corners(ori, index, total, r, rtl=aura_rtl(parent))
  let b = button_node(
    parent,
    label,
    on_press=on_press,
    variant=vari,
    size=sz,
    disabled=eff_dis,
    corners=cs,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    content?=content,
    loc=loc,
  )
  if fw {
    match ori {
      AuraOrientation::Horizontal => {
        let _ = b.grow(view::Live::Is(1.0))
      }
      AuraOrientation::Vertical => {
        let _ = b.fills_across(view::Live::Is(true))
      }
    }
  }
  b
}

/// Pion-JSX `<aura::ButtonGroupItem>` wrapper.
pub fn ButtonGroupItem(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  index~ : Int = 0,
  total~ : Int = 1,
  on_press~ : () -> Unit = fn() { () },
  variant? : AuraButtonVariant,
  size? : AuraButtonSize,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  button_group_item_node(
    parent,
    lbl,
    index,
    total,
    on_press=on_press,
    variant?=variant,
    size?=size,
    disabled=dis,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    content?=children,
    loc=loc,
  )
}
