// Wave 0 R2 Track C unit tests:
// 1. Responsive Button metrics (748pt vs 788pt), Outline 60% hover, press scale transition.
// 2. Independent CloseButton (24x24pt default, 16pt Xmark, --default fill, 0.93 press scale, focus ring).
// 3. Pending Primary/Danger Button Spinner contrast, Role::Status, zero clock_read_fault, cycle rotation,
//    and system reduced_motion inheritance.
// 4. SurfaceContext dynamic Transparent <-> Secondary switching, AuraConfig.auto_surface, w0_field_shell Auto
//    bg+shadow consistency, and aura_theme_from cache.
// 5. Monochrome @gravity-ui/icons (zero hardcoded 0xFFFFFFFFL across all 15 glyphs).

import "color"
import "halt"
import "hostapi"
import "paint"
import "signals"
import "ui"
import "view"

fn r2c_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("wave0_r2c_test", msg)
  }
}

fn r2c_unwrap_tree(opt : Option[view::Tree]) -> view::Tree {
  match opt {
    Some(tr) => tr
    None => halt::saying("wave0_r2c_test", "missing tree")
  }
}

fn r2c_drawn(tr : view::Tree, id : view::NodeId) -> view::Drawn {
  match tr.drawn_of(id) {
    Some(d) => d
    None => halt::saying("wave0_r2c_test", "missing drawn node")
  }
}

fn r2c_children_drawn(tr : view::Tree, parent_id : view::NodeId) -> Array[view::Drawn] {
  let held = tr.drawn_held()
  let mut p_idx = -1
  let mut i = 0
  while i < held.length() {
    if held[i].0.id == parent_id {
      p_idx = i
      break
    }
    i += 1
  }
  let out : Array[view::Drawn] = []
  if p_idx < 0 {
    return out
  }
  let mut j = 0
  while j < held.length() {
    if held[j].1 == p_idx {
      out.push(held[j].0)
    }
    j += 1
  }
  out
}

fn r2c_approx(a : Double, b : Double, eps : Double) -> Bool {
  let d = a - b
  (if d < 0.0 { -d } else { d }) <= eps
}

test "r2c_button_responsive_748_vs_788_and_outline_60_and_close_button_24pt" {
  let sm_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let md_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let lg_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let icon_md_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let outline_lit_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let close_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let b_sm = button_node(root, view::Live::Is("Small"), size=AuraButtonSize::Sm)
    sm_id.v = b_sm.id()
    let b_md = button_node(root, view::Live::Is("Medium"), size=AuraButtonSize::Md)
    md_id.v = b_md.id()
    let b_lg = button_node(root, view::Live::Is("Large"), size=AuraButtonSize::Lg)
    lg_id.v = b_lg.id()
    let b_ic = button_node(root, view::Live::Is("Add"), size=AuraButtonSize::Md, icon_only=true, content=fn(v : view::View) -> Unit {
      let _ = aura_icon_node(v, AuraIconKind::Plus, size=16.0)
    })
    icon_md_id.v = b_ic.id()
    let b_out = button_node(root, view::Live::Is("Outline"), variant=AuraButtonVariant::Outline, force_pressed=true)
    outline_lit_id.v = b_out.id()
    let cb = close_button_node(root)
    close_id.v = cb.id()
  }, width=748.0, height=500.0)
  let tr = r2c_unwrap_tree(tree_ref.v)

  // Narrow viewport (<768pt): Sm=36 / Md=40 / Lg=44; icon-only Md width=40
  let r_sm_748 = r2c_drawn(tr, sm_id.v)
  let r_md_748 = r2c_drawn(tr, md_id.v)
  let r_lg_748 = r2c_drawn(tr, lg_id.v)
  let r_ic_748 = r2c_drawn(tr, icon_md_id.v)
  r2c_assert(r2c_approx(r_sm_748.h, 36.0, 0.5), "748pt Sm height should be 36, got \{r_sm_748.h}")
  r2c_assert(r2c_approx(r_md_748.h, 40.0, 0.5), "748pt Md height should be 40, got \{r_md_748.h}")
  r2c_assert(r2c_approx(r_lg_748.h, 44.0, 0.5), "748pt Lg height should be 44, got \{r_lg_748.h}")
  r2c_assert(r2c_approx(r_ic_748.w, 40.0, 0.5) && r2c_approx(r_ic_748.h, 40.0, 0.5), "748pt icon-only Md should be 40x40")

  // Outline hover/pressed uses 60% default soft (`default_soft_hover`), NOT 50% (`default_soft`)
  let pal = aura_theme_from(AuraConfig::light()).palette
  let out_bg = r2c_drawn(tr, outline_lit_id.v).ground
  r2c_assert(out_bg == pal.default_soft_hover, "Outline lit bg should be 60% default_soft_hover")
  r2c_assert(out_bg != pal.default_soft, "Outline lit bg must differ from 50% default_soft")

  // CloseButton default visual circle is 24x24pt with --default bg (inside 36x36pt hit wrapper)
  let cb_children = r2c_children_drawn(tr, close_id.v)
  r2c_assert(cb_children.length() == 1, "CloseButton should contain 1 visual circle child")
  let cb_circle = cb_children[0]
  r2c_assert(r2c_approx(cb_circle.w, 24.0, 0.5) && r2c_approx(cb_circle.h, 24.0, 0.5), "CloseButton visual circle should be 24x24pt, got \{cb_circle.w}x\{cb_circle.h}")
  r2c_assert(cb_circle.ground == pal.default_bg, "CloseButton visual circle bg should be --default")

  // Quiet-at-rest + Aura UI craft audit gate
  assert_aura_ui(t, label="r2c_buttons_748")

  // Resize to desktop viewport (>=768pt): Sm=32 / Md=36 / Lg=40; icon-only Md width=36
  let _ = tr.frame(788.0, 500.0, now=16.0)
  let r_sm_788 = r2c_drawn(tr, sm_id.v)
  let r_md_788 = r2c_drawn(tr, md_id.v)
  let r_lg_788 = r2c_drawn(tr, lg_id.v)
  let r_ic_788 = r2c_drawn(tr, icon_md_id.v)
  r2c_assert(r2c_approx(r_sm_788.h, 32.0, 0.5), "788pt Sm height should be 32, got \{r_sm_788.h}")
  r2c_assert(r2c_approx(r_md_788.h, 36.0, 0.5), "788pt Md height should be 36, got \{r_md_788.h}")
  r2c_assert(r2c_approx(r_lg_788.h, 40.0, 0.5), "788pt Lg height should be 40, got \{r_lg_788.h}")
  r2c_assert(r2c_approx(r_ic_788.w, 36.0, 0.5) && r2c_approx(r_ic_788.h, 36.0, 0.5), "788pt icon-only Md should be 36x36")

  t.dispose()
}

test "r2c_pending_spinner_contrast_zero_clock_read_fault_and_reduced_motion" {
  ui::set_reduced_motion(None)
  let prim_btn_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let danger_btn_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let sp_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let rm_seen = view::ref_new(false)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let b1 = button_node(root, view::Live::Is("Saving"), variant=AuraButtonVariant::Primary, pending=view::Live::Is(true))
    prim_btn_id.v = b1.id()
    let b2 = button_node(root, view::Live::Is("Deleting"), variant=AuraButtonVariant::Danger, pending=view::Live::Is(true))
    danger_btn_id.v = b2.id()
    let sp = spinner_node(root, size=AuraSpinnerSize::Md, color=AuraSpinnerColor::Current, ink=view::Live::Is(0x112233FFL))
    sp_id.v = sp.id()
    let _ = root.box(fn(probe : view::View) -> Unit {
      let _ = probe.ground(view::Live::By(fn() -> Int64 {
        rm_seen.v = aura_reduced_motion(probe)
        0x00000000L
      }))
    })
  }, width=800.0, height=400.0)
  let tr = r2c_unwrap_tree(tree_ref.v)
  let pal = aura_theme_from(AuraConfig::light()).palette

  // Advance frames under source-tracked Tester: MUST NOT trigger clock_read_fault,
  // AND Drawn.turn (Place-phase snapshot) must advance alongside live turn_angle_of!
  let _ = tr.frame(800.0, 400.0, now=0.0)
  let turn_0 = tr.turn_angle_of(sp_id.v)
  let drawn_turn_0 = r2c_drawn(tr, sp_id.v).turn
  let _ = tr.frame(800.0, 400.0, now=200.0)
  let turn_200 = tr.turn_angle_of(sp_id.v)
  let drawn_turn_200 = r2c_drawn(tr, sp_id.v).turn
  r2c_assert(!r2c_approx(turn_0, turn_200, 0.05), "Spinner turn must advance with time (t0=\{turn_0}, t200=\{turn_200})")
  r2c_assert(r2c_approx(drawn_turn_0, turn_0, 0.001) && r2c_approx(drawn_turn_200, turn_200, 0.001), "Spinner Drawn.turn must reflect live Place turn (d0=\{drawn_turn_0}, d200=\{drawn_turn_200})")

  // Verify Spinner role is Role::Status
  let sp_said = tr.said_of(sp_id.v)
  let is_status = match sp_said {
    Some(s) => s.role is view::Role::Status
    None => false
  }
  r2c_assert(is_status, "Spinner must report view::Role::Status")

  // Verify Primary pending button Spinner uses accent_foreground (NOT accent!) on its continuous-gradient shapes
  let prim_kids = r2c_children_drawn(tr, prim_btn_id.v)
  r2c_assert(prim_kids.length() >= 1, "Primary pending button must mount show wrapper")
  let prim_sp_kids = r2c_children_drawn(tr, prim_kids[0].id)
  r2c_assert(prim_sp_kids.length() >= 1, "Primary pending show wrapper must mount spinner")
  r2c_assert(prim_sp_kids[0].shapes.length() == 3, "Spinner must draw 3 continuous-gradient path shapes, got \{prim_sp_kids[0].shapes.length()}")
  let prim_arc_col = prim_sp_kids[0].shapes[1].fill
  r2c_assert(prim_arc_col == pal.accent_foreground, "Primary pending spinner must use accent_foreground, not accent")
  r2c_assert(prim_arc_col != pal.accent, "Primary pending spinner must not be invisible accent-on-accent")

  // Verify Danger pending button Spinner uses danger_foreground (NOT danger!)
  let danger_kids = r2c_children_drawn(tr, danger_btn_id.v)
  r2c_assert(danger_kids.length() >= 1, "Danger pending button must mount show wrapper")
  let danger_sp_kids = r2c_children_drawn(tr, danger_kids[0].id)
  r2c_assert(danger_sp_kids.length() >= 1, "Danger pending show wrapper must mount spinner")
  r2c_assert(danger_sp_kids[0].shapes.length() == 3, "Danger spinner must draw 3 continuous-gradient path shapes")
  let danger_arc_col = danger_sp_kids[0].shapes[1].fill
  r2c_assert(danger_arc_col == pal.danger_foreground, "Danger pending spinner must use danger_foreground, not danger")

  // Verify system reduced_motion inheritance (AuraConfig.reduced_motion is false!)
  r2c_assert(!rm_seen.v, "reduced_motion should default to false")
  ui::set_reduced_motion(Some(true))
  let _ = tr.frame(800.0, 400.0, now=400.0)
  r2c_assert(tr.turn_angle_of(sp_id.v) == 0.0, "Spinner must freeze at 0.0 when system reduced_motion is true")
  ui::set_reduced_motion(None)
  t.dispose()
}

test "r2c_surface_ctx_transparent_toggle_auto_surface_field_shadow_and_theme_cache" {
  let mid_sig = signals::signal(AuraSurfaceLevel::Transparent)
  let child_lvl = view::ref_new(AuraSurfaceLevel::Primary)
  let auto_l1 = view::ref_new(AuraSurfaceLevel::Primary)
  let auto_l2 = view::ref_new(AuraSurfaceLevel::Primary)
  let auto_l3 = view::ref_new(AuraSurfaceLevel::Primary)
  let auto_explicit = view::ref_new(AuraSurfaceLevel::Secondary)
  let field_outside_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let field_inside_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), auto_surface: true })
    let _ = aura_provide_config(root, cfg)

    // Auto field outside any Surface -> effective Primary (field_background + shadows)
    let f_out = w0_field_shell(root, variant=AuraFieldVariant::Auto)
    field_outside_id.v = f_out.id()

    // Dynamic Transparent <-> Secondary switching under Primary outer surface
    let _ = surface_node(root, variant=AuraSurfaceVariant::Default, content=fn(outer : view::View) -> Unit {
      let _ = outer.box(fn(mid : view::View) -> Unit {
        let _ = aura_provide_surface(mid, mid_sig)
        let _ = mid.box(fn(probe : view::View) -> Unit {
          let _ = probe.ground(view::Live::By(fn() -> Int64 {
            child_lvl.v = aura_surface_level_of(probe)
            0x00000000L
          }))
        })
      })
      // Auto field inside Primary Surface -> effective Secondary (surface_secondary + 0 shadows)
      let f_in = w0_field_shell(outer, variant=AuraFieldVariant::Auto)
      field_inside_id.v = f_in.id()
    })

    // auto_surface nesting: omitted variant steps Primary -> Secondary -> Tertiary; explicit Default overrides
    let _ = surface_node(root, content=fn(s1 : view::View) -> Unit {
      auto_l1.v = aura_surface_level_of(s1)
      let _ = surface_node(s1, content=fn(s2 : view::View) -> Unit {
        auto_l2.v = aura_surface_level_of(s2)
        let _ = surface_node(s2, content=fn(s3 : view::View) -> Unit {
          auto_l3.v = aura_surface_level_of(s3)
          let _ = surface_node(s3, variant=AuraSurfaceVariant::Default, content=fn(s4 : view::View) -> Unit {
            auto_explicit.v = aura_surface_level_of(s4)
          })
        })
      })
    })
  }, width=800.0, height=500.0)

  let tr = r2c_unwrap_tree(tree_ref.v)
  let pal = aura_theme_from(AuraConfig::light()).palette

  // Check auto_surface progression & explicit override
  r2c_assert(auto_l1.v is AuraSurfaceLevel::Primary, "auto_surface level 1 should be Primary")
  r2c_assert(auto_l2.v is AuraSurfaceLevel::Secondary, "auto_surface level 2 should be Secondary")
  r2c_assert(auto_l3.v is AuraSurfaceLevel::Tertiary, "auto_surface level 3 should be Tertiary")
  r2c_assert(auto_explicit.v is AuraSurfaceLevel::Primary, "explicit variant=Default must override auto_surface")

  // Check dynamic Transparent -> Secondary -> Transparent
  r2c_assert(child_lvl.v is AuraSurfaceLevel::Primary, "Transparent must initially inherit outer Primary")
  mid_sig.set(AuraSurfaceLevel::Secondary)
  let _ = tr.frame(800.0, 500.0, now=16.0)
  r2c_assert(child_lvl.v is AuraSurfaceLevel::Secondary, "Switching Transparent -> Secondary must propagate to descendants")
  mid_sig.set(AuraSurfaceLevel::Transparent)
  let _ = tr.frame(800.0, 500.0, now=32.0)
  r2c_assert(child_lvl.v is AuraSurfaceLevel::Primary, "Switching Secondary -> Transparent must restore outer Primary")

  // Check w0_field_shell Auto bg + shadow consistency
  let f_out_d = r2c_drawn(tr, field_outside_id.v)
  let f_in_d = r2c_drawn(tr, field_inside_id.v)
  r2c_assert(f_out_d.ground == pal.field_background, "Auto field outside surface uses field_background")
  r2c_assert(f_out_d.shadows.length() == 3, "Auto field outside surface casts 3 light surface shadows")
  r2c_assert(f_in_d.ground == pal.surface_secondary, "Auto field inside Primary surface uses surface_secondary")
  r2c_assert(f_in_d.shadows.length() == 0, "Auto field inside Primary surface casts 0 shadows")

  // Check aura_theme_from cache correctness across light/dark/custom accent
  let th_l1 = aura_theme_from(AuraConfig::light())
  let th_l2 = aura_theme_from(AuraConfig::light())
  let th_d = aura_theme_from(AuraConfig::dark())
  let th_c = aura_theme_from(AuraConfig::{ ..AuraConfig::light(), accent: color::Oklch::new(0.6, 0.2, 140.0) })
  r2c_assert(th_l1 == th_l2, "cached light theme must equal recomputed light theme")
  r2c_assert(th_l1.palette.background != th_d.palette.background, "dark theme must not collide with cached light theme")
  r2c_assert(th_l1.palette.accent != th_c.palette.accent, "custom accent must invalidate theme cache")

  t.dispose()
}

test "r2c_icons_monochrome_no_hardcoded_white" {
  let all_kinds : Array[AuraIconKind] = [
    AuraIconKind::Check,
    AuraIconKind::ChevronDown,
    AuraIconKind::ChevronLeft,
    AuraIconKind::ChevronRight,
    AuraIconKind::ChevronUp,
    AuraIconKind::Xmark,
    AuraIconKind::Magnifier,
    AuraIconKind::CircleInfo,
    AuraIconKind::CircleCheck,
    AuraIconKind::TriangleExclamation,
    AuraIconKind::CircleExclamation,
    AuraIconKind::Eye,
    AuraIconKind::EyeSlash,
    AuraIconKind::Calendar,
    AuraIconKind::Plus,
  ]
  let custom_ink = 0x123456FFL
  for kind in all_kinds {
    let shapes = aura_icon_shapes(kind, 16.0, custom_ink)
    r2c_assert(shapes.length() > 0, "icon must produce at least one shape")
    for sh in shapes {
      r2c_assert(sh.fill != 0xFFFFFFFFL && sh.stroke != 0xFFFFFFFFL, "icon must not hardcode 0xFFFFFFFFL")
      r2c_assert(sh.fill == 0L || sh.fill == custom_ink, "icon fill must be 0 or ink")
      r2c_assert(sh.stroke == 0L || sh.stroke == custom_ink, "icon stroke must be 0 or ink")
      r2c_assert(sh.even_odd, "locked @gravity-ui/icons filled paths must use even_odd=true")
    }
  }
}

test "r3_3_spinner_xl_40pt_smooth_gradient_and_locked_curved_icons" {
  // 1. Spinner Xl = 40x40pt + smooth multi-stop gradient geometry
  let xl_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let sp_xl = spinner_node(root, size=AuraSpinnerSize::Xl, color=AuraSpinnerColor::Accent)
    xl_id.v = sp_xl.id()
  }, width=400.0, height=200.0)
  let tr = r2c_unwrap_tree(tree_ref.v)
  let xl_drawn = r2c_drawn(tr, xl_id.v)
  let pal = aura_theme_from(AuraConfig::light()).palette
  r2c_assert(r2c_approx(xl_drawn.w, 40.0, 0.5) && r2c_approx(xl_drawn.h, 40.0, 0.5), "Spinner Xl must be 40x40pt, got \{xl_drawn.w}x\{xl_drawn.h}")
  r2c_assert(xl_drawn.shapes.length() == 3, "Spinner Xl must draw 3 continuous-gradient path shapes, got \{xl_drawn.shapes.length()}")
  r2c_assert((xl_drawn.shapes[0].fill & 0xFFL).to_int() >= 135 && (xl_drawn.shapes[0].fill & 0xFFL).to_int() <= 145, "Shape 0 base alpha should be ~140 (0.55)")
  r2c_assert(xl_drawn.shapes[1].fill == pal.accent, "Shape 1 head gradient fill should be full accent")
  r2c_assert((xl_drawn.shapes[2].fill & 0xFFL).to_int() >= 135 && (xl_drawn.shapes[2].fill & 0xFFL).to_int() <= 145, "Shape 2 tail gradient fill should be ~140 (0.55)")
  r2c_assert(xl_drawn.shapes[1].fade_bot_len > 25.0 && xl_drawn.shapes[2].fade_top_len > 20.0, "Shape 1 bottom fade and Shape 2 top fade must drive continuous 1D local linear GPU gradients")
  // Translucent ink uses group_alpha once on the Spinner root (opaque internal shapes -> zero double-blend)
  r2c_assert(r2c_approx(xl_drawn.group_alpha, 1.0, 0.001), "Opaque Spinner must have group_alpha=1.0 (zero offscreen overhead)")
  t.dispose()

  let tr_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let tr_tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    tr_tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let sp_t = spinner_node(root, size=AuraSpinnerSize::Xl, color=AuraSpinnerColor::Current, ink=view::Live::Is(0x00000080L))
    tr_id.v = sp_t.id()
  }, width=200.0, height=200.0)
  let tr2 = r2c_unwrap_tree(tr_tree_ref.v)
  let td = r2c_drawn(tr2, tr_id.v)
  r2c_assert(r2c_approx(td.group_alpha, 128.0 / 255.0, 0.01), "Translucent ink Spinner must apply ink alpha once via group_alpha, got \{td.group_alpha}")
  r2c_assert(td.shapes[1].fill == 0x000000FFL, "Translucent ink Spinner inner gradient shape must draw opaque RGB inside group_alpha")
  t2.dispose()

  // 2. Locked @gravity-ui/icons Calendar, Eye, EyeSlash: true curved multi-subpath geometry (not raw polygon approximations)
  let ink = 0x112233FFL
  let cal_shapes = aura_icon_shapes(AuraIconKind::Calendar, 16.0, ink)
  r2c_assert(cal_shapes.length() == 1 && cal_shapes[0].even_odd, "Calendar must be single even-odd filled shape")
  r2c_assert(cal_shapes[0].outlines.length() == 3, "Calendar must have 3 closed subpaths (outer + 2 inner cutouts), got \{cal_shapes[0].outlines.length()}")
  let mut cal_pts = 0
  for sub in cal_shapes[0].outlines {
    r2c_assert(sub.1, "Calendar subpath must be closed")
    cal_pts += sub.0.length() / 2
  }
  r2c_assert(cal_pts >= 60, "Calendar must have smooth rounded corner curves (>=60 pts), got \{cal_pts}")

  let eye_shapes = aura_icon_shapes(AuraIconKind::Eye, 16.0, ink)
  r2c_assert(eye_shapes.length() == 1 && eye_shapes[0].even_odd, "Eye must be single even-odd filled shape")
  r2c_assert(eye_shapes[0].outlines.length() == 4, "Eye must have 4 closed subpaths (inner/outer eye + inner/outer iris), got \{eye_shapes[0].outlines.length()}")
  let mut eye_pts = 0
  for sub in eye_shapes[0].outlines {
    r2c_assert(sub.1, "Eye subpath must be closed")
    eye_pts += sub.0.length() / 2
  }
  r2c_assert(eye_pts >= 100, "Eye must use smooth elliptical arcs (>=100 pts, not 8-segment polygon), got \{eye_pts}")

  let slash_shapes = aura_icon_shapes(AuraIconKind::EyeSlash, 16.0, ink)
  r2c_assert(slash_shapes.length() == 1 && slash_shapes[0].even_odd, "EyeSlash must be single even-odd filled shape")
  r2c_assert(slash_shapes[0].outlines.length() >= 4, "EyeSlash must have >=4 closed subpaths, got \{slash_shapes[0].outlines.length()}")
  let mut slash_pts = 0
  for sub in slash_shapes[0].outlines {
    r2c_assert(sub.1, "EyeSlash subpath must be closed")
    slash_pts += sub.0.length() / 2
  }
  r2c_assert(slash_pts >= 100, "EyeSlash must use smooth elliptical arcs (>=100 pts), got \{slash_pts}")
}

test "r3_3_natural_button_widths_within_heroui_targets" {
  // Verify natural intrinsic widths of Primary / Secondary / Outline / Danger buttons (desktop >=768pt, no pinned width!)
  // match HeroUI v3.2.8 targets (84 / 105 / 82 / 81 pt) within +-2pt using measured Inter 500 14pt label advances.
  let p_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let s_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let o_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let d_id = view::ref_new(view::NodeId::{ at: -1, gen: 0 })
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(12.0))
      let bp = button_node(row, view::Live::Is("Primary"), variant=AuraButtonVariant::Primary)
      p_id.v = bp.id()
      let bs = button_node(row, view::Live::Is("Secondary"), variant=AuraButtonVariant::Secondary)
      s_id.v = bs.id()
      let bo = button_node(row, view::Live::Is("Outline"), variant=AuraButtonVariant::Outline)
      o_id.v = bo.id()
      let bd = button_node(row, view::Live::Is("Danger"), variant=AuraButtonVariant::Danger)
      d_id.v = bd.id()
    })
  }, width=800.0, height=200.0)
  // Install exact Inter 500 14pt label advances (measured from Chromium ref_suite) on the fake host
  let h = hostapi::host()
  h.shape = fn(s : String, size : Double, _w : Int, _st : Int, out : Array[Double]) -> Int {
    let n = s.length()
    let total = if s == "Primary" {
      52.0
    } else if s == "Secondary" {
      73.0
    } else if s == "Outline" {
      48.0
    } else if s == "Danger" {
      49.0
    } else {
      n.to_double() * size * 0.52
    }
    let adv = if n > 0 { total / n.to_double() } else { 0.0 }
    let mut i = 0
    while i < n && i * 4 + 3 < out.length() {
      let ch = s.code_unit_at(i)
      out[i * 4] = i.to_double()
      out[i * 4 + 1] = 1.0
      out[i * 4 + 2] = if ch == 10 { 0.0 } else { adv }
      out[i * 4 + 3] = if ch == 10 || ch == 32 || ch == 9 { -1.0 } else { ch.to_double() }
      i += 1
    }
    n
  }
  let tr = r2c_unwrap_tree(tree_ref.v)
  tr.words_again()
  let _ = tr.frame(800.0, 200.0, now=16.0)
  let wp = r2c_drawn(tr, p_id.v).w
  let ws = r2c_drawn(tr, s_id.v).w
  let wo = r2c_drawn(tr, o_id.v).w
  let wd = r2c_drawn(tr, d_id.v).w
  r2c_assert(r2c_approx(wp, 84.0, 2.0), "Primary natural width expected ~84pt (+-2), got \{wp}")
  r2c_assert(r2c_approx(ws, 105.0, 2.0), "Secondary natural width expected ~105pt (+-2), got \{ws}")
  r2c_assert(r2c_approx(wo, 82.0, 2.0), "Outline natural width expected ~82pt (+-2), got \{wo}")
  r2c_assert(r2c_approx(wd, 81.0, 2.0), "Danger natural width expected ~81pt (+-2), got \{wd}")
  t.dispose()
}
