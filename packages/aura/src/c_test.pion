  t1.dispose()

  let dr_open = signals::signal(true)
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = Drawer(
      root,
      open=fn() -> Bool { dr_open.get() },
      on_close=fn() -> Unit { dr_open.set(false) },
