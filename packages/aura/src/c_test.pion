          .ink(view::Live::By(fn() -> Int64 { aura_theme(bv).palette.muted }))
      },
    )
  }, width=800.0, height=600.0)
  assert_aura_ui(t2, label="c_drawer")
  t2.dispose()

  let sh_open = signals::signal(true)
  let t3 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = Sheet(
      root,
      open=fn() -> Bool { sh_open.get() },
      on_close=fn() -> Unit { sh_open.set(false) },
      heading="Bottom Sheet",
      placement=AuraDrawerPlacement::Bottom,
      children=fn(bv : view::View) -> Unit {
        let _ = bv.words(view::Live::Is("Sheet content."), look=c_words_look(14.0, 400, 20.0))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(bv).palette.muted }))
      },
    )
  }, width=800.0, height=600.0)
  assert_aura_ui(t3, label="c_sheet")
  t3.dispose()

  let pop_open = signals::signal(true)
  let t4 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(60.0))
    let _ = Popover(
      root,
      trigger_label="Show Popover",
      open=fn() -> Bool { pop_open.get() },
      set_open=fn(b : Bool) -> Unit { pop_open.set(b) },
      heading="Dimensions",
      children=fn(pv : view::View) -> Unit {
        let _ = pv.words(view::Live::Is("Set layer dimensions."), look=c_words_look(14.0, 400, 20.0))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(pv).palette.muted }))
      },
    )
  }, width=800.0, height=600.0)
  assert_aura_ui(t4, label="c_popover")
  t4.dispose()

  let t5 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(120.0))
    let _ = Tooltip(
      root,
      text=.Is("Tooltip preview text"),
      force_open=true,
      trigger=fn(h : view::View) -> view::View {
        Button(h, label=.Is("Hover Target"), variant=AuraButtonVariant::Secondary)
      },
    )
  }, width=800.0, height=600.0)
  assert_aura_ui(t5, label="c_tooltip")
  t5.dispose()
}

test "c_tooltip_delay_1500_close_500_fake_clock" {
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(120.0))
    let _ = tooltip_node(
      root,
      view::Live::Is("Delayed tip"),
      fn(h : view::View) -> view::View {
        button_node(h, view::Live::Is("Hover Me"), variant=AuraButtonVariant::Secondary)
      },
      open_delay_ms=aura_tooltip_delay_ms,
      close_delay_ms=aura_tooltip_close_delay_ms,
    )
  }, width=600.0, height=400.0)

  c_assert(aura_tooltip_delay_ms == 1500.0, "aura_tooltip_delay_ms must be 1500ms")
  c_assert(aura_tooltip_close_delay_ms == 500.0, "aura_tooltip_close_delay_ms must be 500ms")

  match t.find("Hover Me") {
    Some((hx, hy)) => {
      t.move_to(hx, hy)
      t.frame(ms=1499.0)
      c_assert(!c_has_text(t, "Delayed tip"), "tooltip must not open before 1500ms")
      t.frame(ms=2.0)
      c_assert(c_has_text(t, "Delayed tip"), "tooltip should open at 1500ms")
      t.move_to(5.0, 5.0)
      t.frame(ms=499.0)
      c_assert(c_has_text(t, "Delayed tip"), "tooltip must stay open before 500ms close delay")
      t.frame(ms=2.0)
      c_assert(!c_has_text(t, "Delayed tip"), "tooltip should close after 500ms close delay")
    }
    None => halt::saying("c_test", "missing Hover Me trigger")
  }
  t.dispose()
}

// ===========================================================================
// R2 Regression Tests (All Opus P0/P1 & Astra P1 Track C fixes)
// ===========================================================================

fn c_count_current_pages(tr : view::Tree) -> (Int, String) {
  let mut cnt = 0
  let mut label = ""
  for sn in tr.said_order() {
    match sn.said {
      Some(s) =>
        match s.current {
          Some(cur) =>
            if cur == "page" {
              cnt += 1
              label = s.label
            }
          None => ()
        }
      None => ()
    }
  }
  (cnt, label)
}

test "c_r2_pagination_reactive_window_and_heroui_algorithm" {
  let total = signals::signal(9)
  let page = signals::signal(2)
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = Pagination(
      root,
      total=fn() -> Int { total.get() },
      current=fn() -> Int { page.get() },
      on_change=fn(p : Int) -> Unit { page.set(p) },
    )
  }, width=800.0, height=200.0)

  // HeroUI window for total=9, current=2: 1 2 3 ... 9 (no 4, 5, 6, 7, 8)
  c_assert(t.get("Page 1", role=view::Role::Button) is Some(_), "total=9,cur=2: missing Page 1")
  c_assert(t.get("Page 2", role=view::Role::Button) is Some(_), "total=9,cur=2: missing Page 2")
  c_assert(t.get("Page 3", role=view::Role::Button) is Some(_), "total=9,cur=2: missing Page 3")
  c_assert(t.get("Page 4", role=view::Role::Button) is None, "total=9,cur=2: must not show Page 4")
  c_assert(t.get("Page 5", role=view::Role::Button) is None, "total=9,cur=2: must not show Page 5")
  c_assert(t.get("Page 7", role=view::Role::Button) is None, "total=9,cur=2: must not show Page 7")
  c_assert(t.get("Page 9", role=view::Role::Button) is Some(_), "total=9,cur=2: missing Page 9")
  c_assert(c_has_text(t, "..."), "total=9,cur=2: expected ellipsis")
  match tree_ref.v {
    Some(tr) => {
      let (cnt, lbl) = c_count_current_pages(tr)
      c_assert(cnt == 1 && lbl == "Page 2", "expected unique current Page 2")
    }
    None => c_assert(false, "missing tree")
  }

  // Jump 2 -> 7: 1 ... 6 7 8 9
  page.set(7)
  t.frame()
  c_assert(t.get("Page 1", role=view::Role::Button) is Some(_), "cur=7: missing Page 1")
  c_assert(t.get("Page 2", role=view::Role::Button) is None, "cur=7: stale Page 2 must be removed")
  c_assert(t.get("Page 6", role=view::Role::Button) is Some(_), "cur=7: missing Page 6")
  c_assert(t.get("Page 7", role=view::Role::Button) is Some(_), "cur=7: missing Page 7")
  c_assert(t.get("Page 8", role=view::Role::Button) is Some(_), "cur=7: missing Page 8")
  c_assert(t.get("Page 9", role=view::Role::Button) is Some(_), "cur=7: missing Page 9")
  match tree_ref.v {
    Some(tr) => {
      let (cnt, lbl) = c_count_current_pages(tr)
      c_assert(cnt == 1 && lbl == "Page 7", "expected unique current Page 7")
    }
    None => c_assert(false, "missing tree")
  }

  // Click rebuilt Page 6 button
  c_assert(c_click_text(t, "6"), "should click rebuilt Page 6")
  t.frame()
  c_assert(page.get() == 6, "clicking Page 6 should navigate to 6")

  // Jump -> 1: 1 2 3 ... 9
  page.set(1)
  t.frame()
  c_assert(t.get("Page 1", role=view::Role::Button) is Some(_), "cur=1: missing Page 1")
  c_assert(t.get("Page 2", role=view::Role::Button) is Some(_), "cur=1: missing Page 2")
  c_assert(t.get("Page 3", role=view::Role::Button) is Some(_), "cur=1: missing Page 3")
  c_assert(t.get("Page 7", role=view::Role::Button) is None, "cur=1: stale Page 7 must be removed")

  // Total 9 -> 3: 1 2 3 without ellipsis
  total.set(3)
  t.frame()
  c_assert(t.get("Page 1", role=view::Role::Button) is Some(_), "total=3: missing Page 1")
  c_assert(t.get("Page 2", role=view::Role::Button) is Some(_), "total=3: missing Page 2")
  c_assert(t.get("Page 3", role=view::Role::Button) is Some(_), "total=3: missing Page 3")
  c_assert(t.get("Page 9", role=view::Role::Button) is None, "total=3: stale Page 9 must be removed")
  c_assert(!c_has_text(t, "..."), "total=3: must not show ellipsis")

  // Total 3 -> 0: empty page row
  total.set(0)
  t.frame()
  c_assert(t.get("Page 1", role=view::Role::Button) is None, "total=0: must have no Page 1")
  t.dispose()
}

test "c_r2_dropdown_closes_on_select_and_keyboard_trigger" {
  let open = signals::signal(false)
  let act = signals::signal("")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(24.0))
    let _ = Dropdown(
      root,
      trigger_label="Actions",
      open=fn() -> Bool { open.get() },
      set_open=fn(b : Bool) -> Unit { open.set(b) },
      children=fn(mv : view::View, m : headless::Menu) -> Unit {
        let _ = MenuItem(mv, m=m, label="New File", on_action=fn() -> Unit { act.set("new") })
        let _ = MenuItem(mv, m=m, label="Copy Link", on_action=fn() -> Unit { act.set("copy") })
        let _ = MenuItem(mv, m=m, label="Pin Open", close_on_select=false, on_action=fn() -> Unit { act.set("pin") })
      },
    )
  }, width=800.0, height=500.0)

  // Click trigger opens, click New File fires action and auto-closes
  c_assert(c_click_text(t, "Actions"), "should click Actions trigger")
  t.frame()
  c_assert(open.get(), "clicking trigger should open dropdown")
  c_assert(c_click_text(t, "New File"), "should click New File")
  t.frame()
  c_assert(act.get() == "new", "New File action should fire")
  c_assert(!open.get(), "Dropdown must close after selecting MenuItem by default")

  // close_on_select=false keeps dropdown open, Escape closes it
  c_assert(c_click_text(t, "Actions"), "reopen dropdown")
  t.frame()
  c_assert(c_click_text(t, "Pin Open"), "click close_on_select=false item")
  t.frame()
  c_assert(act.get() == "pin", "Pin Open action should fire")
  c_assert(open.get(), "close_on_select=false must keep dropdown open")
  t.press("Escape")
  t.frame()
  c_assert(!open.get(), "Escape must close dropdown")

  // Keyboard: Tab -> Enter opens and focuses first item -> Down -> Enter activates Copy Link and closes
  act.set("")
  t.press("Tab")
  t.frame()
  t.press("Enter")
  t.frame()
  c_assert(open.get(), "Enter on focused trigger must open dropdown")
  t.key(headless_core::key_down)
  t.frame()
  t.press("Enter")
  t.frame()
  c_assert(act.get() == "copy", "Down + Enter should trigger Copy Link, got: " + act.get())
  c_assert(!open.get(), "keyboard selection must close dropdown")

  // ArrowDown on focused trigger opens dropdown
  t.key(headless_core::key_down)
  t.frame()
  c_assert(open.get(), "ArrowDown on focused trigger must open dropdown")
  t.press("Escape")
  t.frame()
  c_assert(!open.get(), "Escape must close dropdown after ArrowDown open")
  t.dispose()
}

test "c_r2_popover_and_dropdown_placement_not_clamped_to_zero" {
  // Popover with root pad(200)
  let pop_open1 = signals::signal(true)
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(200.0))
    let _ = Popover(
      root,
      trigger_label="Show Popover",
      heading="PopHead",
      open=fn() -> Bool { pop_open1.get() },
      set_open=fn(b : Bool) -> Unit { pop_open1.set(b) },
    )
  }, width=800.0, height=600.0)
  t1.frame()
  t1.frame()
  match (t1.rect_of("Show Popover"), t1.rect_of("PopHead")) {
    (Some((tx, ty, tw, th)), Some((px, py, pw, ph))) => {
      c_assert(px > 80.0, "Popover with root pad(200) must align near trigger, not x=0: trig=(\{tx},\{ty},\{tw},\{th}) pop=(\{px},\{py},\{pw},\{ph})")
      c_assert(py > ty + th, "Popover BelowCenter must sit below trigger: trig=(\{tx},\{ty},\{tw},\{th}) pop=(\{px},\{py},\{pw},\{ph})")
    }
    _ => c_assert(false, "missing Popover trigger or heading rect")
  }
  t1.dispose()

  // Popover with offset parent (no root pad)
  let pop_open2 = signals::signal(true)
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(sp : view::View) -> Unit { let _ = sp.height(view::Live::Is(Some(200.0))) })
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true))
      let _ = row.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(10.0))) })
      let _ = Popover(
        row,
        trigger_label="Show Popover",
        heading="PopHead",
        open=fn() -> Bool { pop_open2.get() },
        set_open=fn(b : Bool) -> Unit { pop_open2.set(b) },
      )
    })
  }, width=800.0, height=600.0)
  t2.frame()
  t2.frame()
  match (t2.rect_of("Show Popover"), t2.rect_of("PopHead")) {
    (Some((tx, ty, _tw, th)), Some((px, py, _pw, _ph))) => {
      c_assert(px > 150.0 && px < tx + 100.0, "Popover without root pad must center under trigger at x=300")
      c_assert(py > ty + th, "Popover must sit below trigger")
    }
    _ => c_assert(false, "missing Popover nopad rects")
  }
  t2.dispose()

  // Dropdown with offset parent (no root pad)
  let dd_open = signals::signal(true)
  let t3 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(sp : view::View) -> Unit { let _ = sp.height(view::Live::Is(Some(200.0))) })
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true))
      let _ = row.box(fn(sp : view::View) -> Unit { let _ = sp.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(10.0))) })
      let _ = Dropdown(
        row,
        trigger_label="Actions",
        open=fn() -> Bool { dd_open.get() },
        set_open=fn(b : Bool) -> Unit { dd_open.set(b) },
        children=fn(mv : view::View, m : headless::Menu) -> Unit {
          let _ = MenuItem(mv, m=m, label="New File")
        },
      )
    })
  }, width=800.0, height=600.0)
  t3.frame()
  t3.frame()
  match (t3.rect_of("Actions"), t3.rect_of("New File")) {
    (Some((tx, ty, _tw, th)), Some((ix, iy, _iw, _ih))) => {
      let dx = if ix > tx { ix - tx } else { tx - ix }
      c_assert(dx < 30.0, "Dropdown BelowStart must align X with trigger at x=300")
      c_assert(iy > ty + th, "Dropdown must sit below trigger")
    }
    _ => c_assert(false, "missing Dropdown nopad rects")
  }
  t3.dispose()
}

test "c_r2_tooltip_root_placement_flip_and_warm_handoff" {
  // 1. Offset parent + force_open=true must place bubble cleanly above trigger without covering it
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(spacer : view::View) -> Unit {
      let _ = spacer.height(view::Live::Is(Some(200.0)))
    })
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true))
      let _ = row.box(fn(sp : view::View) -> Unit {
        let _ = sp.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(36.0)))
      })
      let _ = Tooltip(
        row,
        text=.Is("TipText"),
        force_open=true,
        trigger=fn(h : view::View) -> view::View { button_node(h, view::Live::Is("Hover Me")) },
      )
    })
  }, width=800.0, height=600.0)
  t1.frame()
  t1.frame()
  match (t1.rect_of("Hover Me"), t1.rect_of("TipText")) {
    (Some((tx, ty, tw, th)), Some((bx, by, bw, bh))) => {
      let t_cx = tx + tw * 0.5
      let b_cx = bx + bw * 0.5
      let dcx = if b_cx > t_cx { b_cx - t_cx } else { t_cx - b_cx }
      c_assert(by + bh <= ty, "Tooltip AboveCenter must stay strictly above trigger: trig=(\{tx},\{ty},\{tw},\{th}) bub=(\{bx},\{by},\{bw},\{bh})")
      c_assert(dcx < 12.0, "Tooltip AboveCenter must center horizontally over trigger: trig=(\{tx},\{ty},\{tw},\{th}) bub=(\{bx},\{by},\{bw},\{bh})")
    }
    _ => c_assert(false, "missing tooltip rects")
  }
  t1.dispose()

  // 2. Top edge flip: AboveCenter near y=4 flips to Below
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(4.0))
    let _ = Tooltip(
      root,
      text=.Is("Flipped Tip"),
      placement=headless::Placement::AboveCenter,
      force_open=true,
      trigger=fn(h : view::View) -> view::View { button_node(h, view::Live::Is("TopEdge")) },
    )
  }, width=600.0, height=400.0)
  t2.frame()
  t2.frame()
  match (t2.rect_of("TopEdge"), t2.rect_of("Flipped Tip")) {
    (Some((_tx, ty, _tw, th)), Some((_bx, by, _bw, _bh))) => {
      c_assert(by >= ty + th, "Tooltip near top edge must flip to Below trigger")
    }
    _ => c_assert(false, "missing flipped tooltip rects")
  }
  t2.dispose()

  // 3. Adjacent tooltips share warm handoff and show at most one bubble
  let show_a = signals::signal(true)
  let t3 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(120.0)).row(view::Live::Is(true)).gap(view::Live::Is(24.0))
    let _ = root.show(fn() -> Bool { show_a.get() }, fn(s : view::View) -> Unit {
      let _ = Tooltip(
        s,
        text=.Is("Tip A"),
        open_delay_ms=500.0,
        close_delay_ms=200.0,
        trigger=fn(h : view::View) -> view::View { button_node(h, view::Live::Is("Btn A")) },
      )
    }, at_once=true)
    let _ = Tooltip(
      root,
      text=.Is("Tip B"),
      open_delay_ms=500.0,
      close_delay_ms=200.0,
      trigger=fn(h : view::View) -> view::View { button_node(h, view::Live::Is("Btn B")) },
    )
  }, width=800.0, height=400.0)
  match (t3.find("Btn A"), t3.find("Btn B")) {
    (Some((ax, ay)), Some((bx, by))) => {
      t3.move_to(ax, ay)
      t3.frame(ms=505.0)
      c_assert(c_has_text(t3, "Tip A"), "Tip A should open after 500ms")
      c_assert(!c_has_text(t3, "Tip B"), "Tip B must be closed while Tip A is open")
      // Move immediately to Btn B: warm handoff opens Tip B without 500ms delay and closes Tip A
      t3.move_to(bx, by)
      t3.frame(ms=20.0)
      c_assert(c_has_text(t3, "Tip B"), "Tip B should open immediately via warm handoff")
      c_assert(!c_has_text(t3, "Tip A"), "Only one tooltip bubble may be visible at a time")
      // Move back to Btn A then unmount Btn A: Tip A must be cleaned up
      t3.move_to(ax, ay)
      t3.frame(ms=20.0)
      c_assert(c_has_text(t3, "Tip A"), "Tip A should reopen via warm handoff")
      show_a.set(false)
      t3.frame()
      c_assert(!c_has_text(t3, "Tip A"), "Unmounting trigger must tear down its root tooltip layer")
    }
    _ => c_assert(false, "missing adjacent tooltip triggers")
  }
  t3.dispose()
}

test "c_r2_modal_in_clipped_card_mounts_at_window_root" {
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(card : view::View) -> Unit {
      let _ = card
        .width(view::Live::Is(Some(240.0)))
        .height(view::Live::Is(Some(120.0)))
        .clips(view::Live::Is(true))
      let _ = Modal(
        card,
        open=fn() -> Bool { true },
        heading="ScopedHeading",
        children=fn(bv : view::View) -> Unit {
          let _ = bv.words(view::Live::Is("Body"), look=c_words_look(14.0, 400, 20.0))
        },
      )
    })
  }, width=800.0, height=600.0)
  t.frame()
  match t.rect_of("ScopedHeading") {
    Some((hx, hy, _hw, _hh)) => {
      c_assert(hx > 200.0 && hx < 500.0, "Modal mounted inside 240x120 clipped card must center in 800x600 window")
      c_assert(hy > 180.0 && hy < 400.0, "Modal must be vertically centered in 800x600 window, not clipped to 120pt card")
    }
    None => c_assert(false, "ScopedHeading missing")
  }
  t.dispose()
}

test "c_r2_all_four_overlays_release_modality_on_exit_frame_1" {
  // AlertDialog
  let ex1 = signals::signal(false)
  let c1 = signals::signal(0)
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = button_node(root, view::Live::Is("Behind"), on_press=fn() { c1.set(c1.get() + 1) })
    let _ = alert_dialog_node(root, fn() { true }, fn() { () }, "Alert", "Desc", exiting=fn() { ex1.get() })
  }, width=600.0, height=400.0)
  ex1.set(true)
  t1.frame()
  c_assert(c_click_text(t1, "Behind"), "missing Behind button for AlertDialog")
  t1.frame()
  c_assert(c1.get() == 1, "AlertDialog exiting frame 1 must allow clicking underlying controls")
  t1.dispose()

  // Drawer
  let ex2 = signals::signal(false)
  let c2 = signals::signal(0)
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = button_node(root, view::Live::Is("Behind"), on_press=fn() { c2.set(c2.get() + 1) })
    let _ = drawer_node(root, fn() { true }, fn() { () }, heading="Drawer", exiting=fn() { ex2.get() })
  }, width=600.0, height=400.0)
  ex2.set(true)
  t2.frame()
  c_assert(c_click_text(t2, "Behind"), "missing Behind button for Drawer")
  t2.frame()
  c_assert(c2.get() == 1, "Drawer exiting frame 1 must allow clicking underlying controls")
  t2.dispose()

  // Sheet
  let ex3 = signals::signal(false)
  let c3 = signals::signal(0)
  let t3 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = button_node(root, view::Live::Is("Behind"), on_press=fn() { c3.set(c3.get() + 1) })
    let _ = sheet_node(root, fn() { true }, fn() { () }, heading="Sheet", exiting=fn() { ex3.get() })
  }, width=600.0, height=400.0)
  ex3.set(true)
  t3.frame()
  c_assert(c_click_text(t3, "Behind"), "missing Behind button for Sheet")
  t3.frame()
  c_assert(c3.get() == 1, "Sheet exiting frame 1 must allow clicking underlying controls")
  t3.dispose()

  // Modal
  let ex4 = signals::signal(false)
  let c4 = signals::signal(0)
  let t4 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = button_node(root, view::Live::Is("Behind"), on_press=fn() { c4.set(c4.get() + 1) })
    let _ = modal_node(root, fn() { true }, fn() { () }, heading="Modal", exiting=fn() { ex4.get() })
  }, width=600.0, height=400.0)
  ex4.set(true)
  t4.frame()
  c_assert(c_click_text(t4, "Behind"), "missing Behind button for Modal")
  t4.frame()
  c_assert(c4.get() == 1, "Modal exiting frame 1 must allow clicking underlying controls")
  t4.dispose()
}

fn c_r2_tabs_marker_pos(count : Int, horiz : Bool) -> Double {
  let items : Array[AuraTabItem] = [
    AuraTabItem::new("first", "First", fn(v : view::View) -> Unit {
      let _ = v.words(view::Live::Is("Active body"), look=c_words_look(14.0, 400, 20.0))
    }),
  ]
  for i in 1..<count {
    items.push(AuraTabItem::new("tab-\{i}", "Tab \{i}", fn(_) -> Unit { () }))
  }
  let orient = if horiz { AuraOrientation::Horizontal } else { AuraOrientation::Vertical }
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    if !horiz {
      let _ = root.row(view::Live::Is(true))
    }
    let _ = tabs_node(root, items, fn() -> String { "first" }, fn(_) -> Unit { () }, orientation=orient)
    let _ = root.box(fn(v : view::View) -> Unit {
      let _ = v.words(view::Live::Is("Marker"), look=view::words_plain)
    })
  }, width=800.0, height=600.0)
  let pos = match t.find("Marker") {
    Some((x, y)) => if horiz { y } else { x }
    None => -1000.0
  }
  t.dispose()
  pos
}

test "c_r2_tabs_inactive_panels_occupy_zero_space" {
  let h1 = c_r2_tabs_marker_pos(1, true)
  let h4 = c_r2_tabs_marker_pos(4, true)
  let h10 = c_r2_tabs_marker_pos(10, true)
  let dh4 = if h4 > h1 { h4 - h1 } else { h1 - h4 }
  let dh10 = if h10 > h1 { h10 - h1 } else { h1 - h10 }
  c_assert(h1 >= 0.0 && dh4 < 0.01 && dh10 < 0.01, "Horizontal Tabs inactive panels must occupy 0.0pt (1 vs 4 vs 10)")

  let v1 = c_r2_tabs_marker_pos(1, false)
  let v4 = c_r2_tabs_marker_pos(4, false)
  let v10 = c_r2_tabs_marker_pos(10, false)
  let dv4 = if v4 > v1 { v4 - v1 } else { v1 - v4 }
  let dv10 = if v10 > v1 { v10 - v1 } else { v1 - v10 }
  c_assert(v1 >= 0.0 && dv4 < 0.01 && dv10 < 0.01, "Vertical Tabs inactive panels must occupy 0.0pt (1 vs 4 vs 10)")
}

test "c_r2_nested_theme_inherited_by_popover_and_dropdown_and_cleaned_on_unmount" {
  let sub_cfg = signals::signal(AuraConfig::{ ..AuraConfig::dark(), accent: color::Oklch::new(0.65, 0.22, 145.0) })
  let mounted = signals::signal(true)
  let pop_open = signals::signal(true)
  let dd_open = signals::signal(true)
  let pop_panel_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let dd_item_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root, dark=false)
    let _ = root.show(fn() -> Bool { mounted.get() }, fn(sub : view::View) -> Unit {
      let _ = aura_provide_config(sub, sub_cfg)
      let _ = Popover(
        sub,
        trigger_label="DarkPop",
        heading="DarkPopHead",
        open=fn() -> Bool { pop_open.get() },
        set_open=fn(b : Bool) -> Unit { pop_open.set(b) },
        children=fn(pv : view::View) -> Unit {
          pop_panel_ref.v = Some(pv)
          let _ = pv.words(view::Live::Is("NestedPopBody"), look=c_words_look(14.0, 400, 20.0))
        },
      )
      let _ = Dropdown(
        sub,
        trigger_label="DarkDrop",
        open=fn() -> Bool { dd_open.get() },
        set_open=fn(b : Bool) -> Unit { dd_open.set(b) },
        children=fn(mv : view::View, m : headless::Menu) -> Unit {
          dd_item_ref.v = Some(MenuItem(mv, m=m, label="NestedDropItem"))
        },
      )
    }, at_once=true)
  }, width=800.0, height=600.0)
  t.frame()

  match pop_panel_ref.v {
    Some(pv) => {
      c_assert(aura_theme(pv).config.dark, "Popover inside dark subtree must inherit dark AuraConfig")
      c_assert(aura_theme(pv).config.accent.h == 145.0, "Popover must inherit subtree custom accent")
    }
    None => c_assert(false, "missing Popover panel ref")
  }
  match dd_item_ref.v {
    Some(dv) => {
      c_assert(aura_theme(dv).config.dark, "Dropdown inside dark subtree must inherit dark AuraConfig")
      c_assert(aura_theme(dv).config.accent.h == 145.0, "Dropdown must inherit subtree custom accent")
    }
    None => c_assert(false, "missing Dropdown item ref")
  }

  // Live theme switch on subtree updates overlays reactively
  sub_cfg.set(AuraConfig::{ ..AuraConfig::light(), accent: color::Oklch::new(0.60, 0.20, 30.0) })
  t.frame()
  match (pop_panel_ref.v, dd_item_ref.v) {
    (Some(pv), Some(dv)) => {
      c_assert(!aura_theme(pv).config.dark && aura_theme(pv).config.accent.h == 30.0, "Popover must follow live subtree theme switch")
      c_assert(!aura_theme(dv).config.dark && aura_theme(dv).config.accent.h == 30.0, "Dropdown must follow live subtree theme switch")
    }
    _ => c_assert(false, "missing refs after live theme switch")
  }

  // Unmounting subtree removes root-mounted overlay layers cleanly
  mounted.set(false)
  t.frame()
  c_assert(!c_has_text(t, "DarkPopHead"), "Unmounting trigger subtree must remove Popover root layer")
  c_assert(!c_has_text(t, "NestedDropItem"), "Unmounting trigger subtree must remove Dropdown root layer")
  t.dispose()
}

fn c_find_arrow_rect(t : ui::Tester) -> Option[(Double, Double, Double, Double)] {
  for d in t.drawn() {
    if d.shapes.length() > 0 && ((d.w == 12.0 && d.h == 6.0) || (d.w == 6.0 && d.h == 12.0)) {
      return Some((d.x, d.y, d.w, d.h))
    }
  }
  None
}

test "c_r3_tooltip_and_popover_arrow_flips_in_same_viewport_on_move_scroll_and_resize" {
  // 1. Tooltip top/bottom flip on anchor move (fixed 600x400 viewport, 0-frame lag)
  let sp_h = signals::signal(200.0)
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(sp : view::View) -> Unit {
      let _ = sp.width(view::Live::Is(Some(40.0))).height(view::Live::By(fn() -> Option[Double] { Some(sp_h.get()) }))
    })
    let _ = Tooltip(
      root,
      text=.Is("MovingTip"),
      placement=headless::Placement::AboveCenter,
      force_open=true,
      show_arrow=true,
      trigger=fn(h : view::View) -> view::View { button_node(h, view::Live::Is("MoveTrig")) },
    )
  }, width=600.0, height=400.0)
  t1.frame()
  match (t1.rect_of("MovingTip"), c_find_arrow_rect(t1)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      let bub_cy = by + bh * 0.5
      let arr_cy = ay + ah * 0.5
      c_assert(arr_cy > bub_cy, "AboveCenter tooltip arrow must be on bottom edge (closer to anchor)")
    }
    _ => c_assert(false, "missing initial tooltip bubble or arrow")
  }
  // Move anchor to top edge -> bubble flips Below, arrow must flip to top edge in the SAME frame
  sp_h.set(0.0)
  t1.frame()
  match (t1.rect_of("MovingTip"), c_find_arrow_rect(t1)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      let bub_cy = by + bh * 0.5
      let arr_cy = ay + ah * 0.5
      c_assert(arr_cy < bub_cy, "Flipped Below tooltip arrow must be on top edge (closer to anchor) with 0-frame lag")
    }
    _ => c_assert(false, "missing flipped tooltip bubble or arrow")
  }
  // Move back down -> flips back Above in same frame
  sp_h.set(200.0)
  t1.frame()
  match (t1.rect_of("MovingTip"), c_find_arrow_rect(t1)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      c_assert(ay + ah * 0.5 > by + bh * 0.5, "Restored Above tooltip arrow must be on bottom edge")
    }
    _ => c_assert(false, "missing restored tooltip bubble or arrow")
  }
  t1.dispose()

  // 2. Anchor inside scroll container scrolling to top edge triggers Popover arrow flip
  let pop_open = signals::signal(true)
  let t2 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let sc = ui::scroll_box(root, fn(inner : view::View) -> Unit {
      let _ = inner.box(fn(sp : view::View) -> Unit {
        let _ = sp.height(view::Live::Is(Some(240.0)))
      })
      let _ = Popover(
        inner,
        trigger_label="ScrollTrig",
        heading="ScrollPop",
        open=fn() -> Bool { pop_open.get() },
        set_open=fn(b : Bool) -> Unit { pop_open.set(b) },
        placement=headless::Placement::AboveCenter,
        show_arrow=true,
        children=fn(pv : view::View) -> Unit {
          let _ = pv.box(fn(b : view::View) -> Unit {
            let _ = b.height(view::Live::Is(Some(48.0))).words(view::Live::Is("ScrollBody"), look=c_words_look(14.0, 400, 20.0))
          })
        },
      )
      let _ = inner.box(fn(sp2 : view::View) -> Unit {
        let _ = sp2.height(view::Live::Is(Some(600.0)))
      })
    })
    let _ = sc.fill()
  }, width=600.0, height=400.0)
  t2.frame()
  match (t2.rect_of("ScrollPop"), c_find_arrow_rect(t2)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      c_assert(ay + ah * 0.5 > by + bh * 0.5, "Popover initially Above must have arrow below heading")
    }
    _ => c_assert(false, "missing initial scroll popover or arrow")
  }
  // Scroll down 235pt so trigger moves near top edge -> Popover flips Below and arrow flips to top edge
  t2.wheel(300.0, 200.0, 235.0)
  t2.frame()
  match t2.rect_of("ScrollTrig") {
    Some((_tx, ty, _tw, _th)) => c_assert(ty < 30.0, "ScrollTrig must have scrolled near top edge, got y=\{ty}")
    None => c_assert(false, "missing ScrollTrig")
  }
  match (t2.rect_of("ScrollPop"), c_find_arrow_rect(t2)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      c_assert(ay + ah * 0.5 < by + bh * 0.5, "Scrolled Popover flipped Below must have arrow above heading")
    }
    _ => c_assert(false, "missing scrolled popover or arrow")
  }
  t2.dispose()

  // 3. Left/Right flip + dynamic content resize triggering flip (fixed 600x400 viewport)
  let left_sp = signals::signal(260.0)
  let pop_open3 = signals::signal(true)
  let body_h = signals::signal(24.0)
  let t3 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.row(view::Live::Is(true))
    let _ = root.box(fn(sp : view::View) -> Unit {
      let _ = sp.width(view::Live::By(fn() -> Option[Double] { Some(left_sp.get()) })).height(view::Live::Is(Some(40.0)))
    })
    let _ = Popover(
      root,
      trigger_label="SideTrig",
      heading="SidePop",
      open=fn() -> Bool { pop_open3.get() },
      set_open=fn(b : Bool) -> Unit { pop_open3.set(b) },
      placement=headless::Placement::LeftCenter,
      width=200.0,
      show_arrow=true,
      children=fn(pv : view::View) -> Unit {
        let _ = pv.box(fn(b : view::View) -> Unit {
          let _ = b.height(view::Live::By(fn() -> Option[Double] { Some(body_h.get()) }))
        })
      },
    )
  }, width=600.0, height=400.0)
  t3.frame()
  match (t3.rect_of("SidePop"), c_find_arrow_rect(t3)) {
    (Some((bx, _by, bw, _bh)), Some((ax, _ay, aw, _ah))) => {
      c_assert(ax + aw * 0.5 > bx + bw * 0.5, "LeftCenter popover arrow must be on right edge (closer to anchor)")
    }
    _ => c_assert(false, "missing LeftCenter popover or arrow")
  }
  // Move anchor near left edge -> flips to RightCenter, arrow flips to left edge
  left_sp.set(8.0)
  t3.frame()
  match (t3.rect_of("SidePop"), c_find_arrow_rect(t3)) {
    (Some((bx, _by, bw, _bh)), Some((ax, _ay, aw, _ah))) => {
      c_assert(ax + aw * 0.5 < bx + bw * 0.5, "Flipped RightCenter popover arrow must be on left edge")
    }
    _ => c_assert(false, "missing flipped RightCenter popover or arrow")
  }
  t3.dispose()

  // 4. Dynamic content height growth triggers vertical flip & arrow flip
  let pop_open4 = signals::signal(true)
  let grow_h = signals::signal(20.0)
  let t4 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(sp : view::View) -> Unit {
      let _ = sp.height(view::Live::Is(Some(140.0)))
    })
    let _ = Popover(
      root,
      trigger_label="GrowTrig",
      heading="GrowPop",
      open=fn() -> Bool { pop_open4.get() },
      set_open=fn(b : Bool) -> Unit { pop_open4.set(b) },
      placement=headless::Placement::AboveCenter,
      width=200.0,
      show_arrow=true,
      children=fn(pv : view::View) -> Unit {
        let _ = pv.box(fn(b : view::View) -> Unit {
          let _ = b.height(view::Live::By(fn() -> Option[Double] { Some(grow_h.get()) }))
        })
      },
    )
  }, width=600.0, height=400.0)
  t4.frame()
  match (t4.rect_of("GrowPop"), c_find_arrow_rect(t4)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      c_assert(ay + ah * 0.5 > by + bh * 0.5, "Small Above popover fits above anchor with arrow at bottom")
    }
    _ => c_assert(false, "missing initial grow popover or arrow")
  }
  // Grow content so it no longer fits in 140pt above -> flips Below (220pt room below) and arrow flips to top
  grow_h.set(140.0)
  t4.frame()
  match (t4.rect_of("GrowPop"), c_find_arrow_rect(t4)) {
    (Some((_bx, by, _bw, bh)), Some((_ax, ay, _aw, ah))) => {
      c_assert(ay + ah * 0.5 < by + bh * 0.5, "Grown popover flips Below and arrow flips to top edge")
    }
    _ => c_assert(false, "missing grown popover or arrow")
  }
  t4.dispose()
}

test "c_r3_dropdown_trigger_keeps_natural_width_inside_column" {
  let open = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.box(fn(col : view::View) -> Unit {
      let _ = col.width(view::Live::Is(Some(440.0)))
      let _ = dropdown_node(
        col,
        "Actions",
        fn() -> Bool { open.get() },
        fn(b : Bool) -> Unit { open.set(b) },
        fn(mv : view::View, m : headless::Menu) -> Unit {
          let _ = menu_item_node(mv, m, "New File")
        },
      )
    })
  }, width=600.0, height=400.0)
  t.frame()
  match t.rect_of("Actions") {
    Some((_x, _y, w, _h)) => {
      c_assert(w > 50.0 && w < 100.0, "Dropdown trigger 'Actions' inside 440pt column must keep natural width (~80pt), got \{w}")
    }
    None => c_assert(false, "missing Actions dropdown trigger")
  }
  t.dispose()
}

test "c_r4_rtl_horizontal_tabs_and_ltr_vertical_regressions" {
  let focus_label = fn(t : ui::Tester, lbl : String) -> Unit {
    match (ui::view_tree(), t.get(lbl)) {
      (Some(tr), Some(d)) => { let _ = tr.focus_to(Some(d.id), visible=true) }
      _ => c_assert(false, "missing semantic node '\{lbl}'")
    }
  }
  let focused_label = fn(t : ui::Tester) -> String {
    match ui::view_tree() {
      Some(tr) => match tr.focused_now().0 {
        Some(nid) => {
          for lbl in ["Tab A", "Tab B", "Tab C"] {
            match t.get(lbl) {
              Some(d) if d.id == nid => return lbl
              _ => ()
            }
          }
          ""
        }
        None => ""
      }
      None => ""
    }
  }

  // 1) RTL horizontal Tabs: visual left-to-right is C, B, A.
  //    Focus B -> Right-Arrow focuses/selects A (visual right); Left-Arrow focuses/selects C (visual left).
  let rtl_cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let sel_rtl = signals::signal("B")
  let items = [
    AuraTabItem::new("A", "Tab A", fn(_v) { () }),
    AuraTabItem::new("B", "Tab B", fn(_v) { () }),
    AuraTabItem::new("C", "Tab C", fn(_v) { () }),
  ]
  let t_rtl = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, rtl_cfg)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = tabs_node(
      root,
      items,
      fn() { sel_rtl.get() },
      fn(k) { sel_rtl.set(k) },
      orientation=AuraOrientation::Horizontal,
      show_panels=false,
    )
  }, width=400.0, height=120.0)
  t_rtl.frame()
  let tab_x = fn(lbl : String) -> Double {
    match t_rtl.rect_of(lbl) { Some(r) => r.0; None => -1.0 }
  }
  let ax = tab_x("Tab A")
  let bx = tab_x("Tab B")
  let cx = tab_x("Tab C")
  c_assert(cx < bx && bx < ax, "RTL horizontal Tabs visual order must be C < B < A (got C=\{cx}, B=\{bx}, A=\{ax})")

  // Focus B, press Right-Arrow -> A
  focus_label(t_rtl, "Tab B")
  t_rtl.frame(ms=16.0)
  t_rtl.key(headless_core::key_right)
  t_rtl.frame(ms=32.0)
  c_assert(sel_rtl.get() == "A", "RTL horizontal Tabs: B + Right-Arrow must select A, got \{sel_rtl.get()}")
  c_assert(focused_label(t_rtl) == "Tab A", "RTL horizontal Tabs: real focus must move to Tab A")

  // Focus B, press Left-Arrow -> C
  sel_rtl.set("B")
  focus_label(t_rtl, "Tab B")
  t_rtl.frame(ms=48.0)
  t_rtl.key(headless_core::key_left)
  t_rtl.frame(ms=64.0)
  c_assert(sel_rtl.get() == "C", "RTL horizontal Tabs: B + Left-Arrow must select C, got \{sel_rtl.get()}")
  c_assert(focused_label(t_rtl) == "Tab C", "RTL horizontal Tabs: real focus must move to Tab C")
  t_rtl.dispose()

  // 2) LTR horizontal Tabs regression: B + Right -> C, B + Left -> A
  let sel_ltr = signals::signal("B")
  let t_ltr = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = tabs_node(
      root,
      items,
      fn() { sel_ltr.get() },
      fn(k) { sel_ltr.set(k) },
      orientation=AuraOrientation::Horizontal,
      show_panels=false,
    )
  }, width=400.0, height=120.0)
  t_ltr.frame()
  focus_label(t_ltr, "Tab B")
  t_ltr.frame(ms=16.0)
  t_ltr.key(headless_core::key_right)
  t_ltr.frame(ms=32.0)
  c_assert(sel_ltr.get() == "C" && focused_label(t_ltr) == "Tab C", "LTR horizontal Tabs: B + Right -> C")
  sel_ltr.set("B")
  focus_label(t_ltr, "Tab B")
  t_ltr.frame(ms=48.0)
  t_ltr.key(headless_core::key_left)
  t_ltr.frame(ms=64.0)
  c_assert(sel_ltr.get() == "A" && focused_label(t_ltr) == "Tab A", "LTR horizontal Tabs: B + Left -> A")
  t_ltr.dispose()

  // 3) Vertical Tabs regression (even under RTL): B + Down -> C, B + Up -> A
  let sel_v = signals::signal("B")
  let t_v = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, rtl_cfg)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = tabs_node(
      root,
      items,
      fn() { sel_v.get() },
      fn(k) { sel_v.set(k) },
      orientation=AuraOrientation::Vertical,
      show_panels=false,
    )
  }, width=300.0, height=240.0)
  t_v.frame()
  focus_label(t_v, "Tab B")
  t_v.frame(ms=16.0)
  t_v.key(headless_core::key_down)
  t_v.frame(ms=32.0)
  c_assert(sel_v.get() == "C" && focused_label(t_v) == "Tab C", "Vertical Tabs: B + Down -> C")
  sel_v.set("B")
  focus_label(t_v, "Tab B")
  t_v.frame(ms=48.0)
  t_v.key(headless_core::key_up)
  t_v.frame(ms=64.0)
  c_assert(sel_v.get() == "A" && focused_label(t_v) == "Tab A", "Vertical Tabs: B + Up -> A")
  t_v.dispose()
}
