test "c_accordion_default_and_surface_toggle" {
  let open_key = signals::signal("q1")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(16.0))
    let items = [
      AuraAccordionItem::new("q1", "First question", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Answer one."), look=c_words_look(14.0, 400, 20.0))
      }),
      AuraAccordionItem::new("q2", "Second question", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Answer two."), look=c_words_look(14.0, 400, 20.0))
      }),
    ]
    let _ = accordion_node(
      root,
      items,
      fn() -> Array[String] { if open_key.get() == "" { [] } else { [open_key.get()] } },
      fn(k : String) -> Unit { open_key.set(if open_key.get() == k { "" } else { k }) },
      variant=AuraAccordionVariant::Surface,
    )
    let _ = Accordion(
      root,
      items=items,
      expanded_keys=fn() -> Array[String] { [open_key.get()] },
      on_toggle=fn(k : String) -> Unit { open_key.set(k) },
      variant=AuraAccordionVariant::Default,
    )
  }, width=800.0, height=600.0)

  assert_aura_ui(t, label="c_accordion")
  c_assert(open_key.get() == "q1", "initial expanded key should be q1")
  c_assert(c_click_text(t, "Second question"), "should click Second question")
  c_assert(open_key.get() == "q2", "toggling Second question should switch expanded key to q2")
  t.dispose()
}

test "c_disclosure_and_disclosure_group" {
  let open = signals::signal(false)
  let grp = signals::signal("g1")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = disclosure_node(
      root,
      view::Live::Is("Toggle details"),
      fn() -> Bool { open.get() },
      fn() -> Unit { open.set(!open.get()) },
      fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Details body"), look=c_words_look(14.0, 400, 20.0))
      },
    )
    let _ = Disclosure(
      root,
      heading=.Is("JSX disclosure"),
      open=fn() -> Bool { open.get() },
      on_toggle=fn() -> Unit { open.set(!open.get()) },
    )
    let gitems = [
      AuraAccordionItem::new("g1", "Group Item 1", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Group body 1"), look=c_words_look(14.0, 400, 20.0))
      }),
      AuraAccordionItem::new("g2", "Group Item 2", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Group body 2"), look=c_words_look(14.0, 400, 20.0))
      }),
    ]
    let _ = DisclosureGroup(
      root,
      items=gitems,
      expanded_keys=fn() -> Array[String] { [grp.get()] },
      on_toggle=fn(k : String) -> Unit { grp.set(k) },
    )
  }, width=800.0, height=500.0)

  assert_aura_ui(t, label="c_disclosure")
  c_assert(c_click_text(t, "Toggle details"), "should click disclosure trigger")
  c_assert(open.get(), "disclosure should open after click")
  c_assert(c_click_text(t, "Group Item 2"), "should click Group Item 2")
  c_assert(grp.get() == "g2", "disclosure group should switch to g2")
  t.dispose()
}

test "c_breadcrumbs_aria_current_page" {
  let clicked = signals::signal("")
  let tree_ref : signals::Ref[Option[view::Tree]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    tree_ref.v = Some(root.tree)
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0))
    let items = [
      AuraBreadcrumbItem::new("Home", on_press=fn() -> Unit { clicked.set("Home") }),
      AuraBreadcrumbItem::new("Packages", on_press=fn() -> Unit { clicked.set("Packages") }),
      AuraBreadcrumbItem::new("Aura", on_press=fn() -> Unit { clicked.set("Aura") }),
    ]
    let _ = Breadcrumbs(root, items=items)
  }, width=800.0, height=200.0)

  assert_aura_ui(t, label="c_breadcrumbs")
  match tree_ref.v {
    Some(tr) => {
      let mut found_page = false
      for sn in tr.said_order() {
        match sn.said {
          Some(s) =>
            if s.label == "Aura" {
              match s.current {
                Some(cur) => if cur == "page" { found_page = true }
                None => ()
              }
            }
          None => ()
        }
      }
      c_assert(found_page, "last breadcrumb must expose aria-current=page")
    }
    None => halt::saying("c_test", "missing tree")
  }
  c_assert(c_click_text(t, "Packages"), "should click Packages breadcrumb")
  c_assert(clicked.get() == "Packages", "breadcrumb click callback should fire")
  t.dispose()
}

test "c_pagination_navigation_and_ellipsis" {
  let page = signals::signal(2)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = Pagination(
      root,
      total=fn() -> Int { 9 },
      current=fn() -> Int { page.get() },
      on_change=fn(p : Int) -> Unit { page.set(p) },
    )
  }, width=800.0, height=200.0)

  assert_aura_ui(t, label="c_pagination")
  c_assert(c_has_text(t, "..."), "pagination should render ellipsis for 9 pages")
  c_assert(c_click_text(t, "3"), "should click page 3")
  c_assert(page.get() == 3, "page should change to 3")
  t.dispose()
}

test "c_listbox_section_and_disabled_skip" {
  let sel = signals::signal("build")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = ListBox(
      root,
      is_selected=fn(k : String) -> Bool { sel.get() == k },
      on_select=fn(k : String) -> Unit { sel.set(k) },
      children=fn(v : view::View, lb : headless::Listbox[String]) -> Unit {
        let _ = ListBoxSection(v, lb=lb, title="Commands", children=fn(sv : view::View) -> Unit {
          let _ = ListBoxItem(sv, lb=lb, key="build", label="Build")
          let _ = ListBoxItem(sv, lb=lb, key="disabled", label="Locked", disabled=fn() -> Bool { true })
          let _ = ListBoxItem(sv, lb=lb, key="test", label="Test")
        })
      },
    )
  }, width=600.0, height=400.0)

  assert_aura_ui(t, label="c_listbox")
  c_assert(c_click_text(t, "Test"), "should click Test option")
  c_assert(sel.get() == "test", "selection should update to test")
  let _ = c_click_text(t, "Locked")
  c_assert(sel.get() == "test", "disabled option must not change selection")
  t.dispose()
}

