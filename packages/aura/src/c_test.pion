// Aura Track 1C unit tests: all 21 leaf components (Builder + Pion-JSX),
// `assert_aura_ui` gate, and headless interactive contracts.

import "color"
import "halt"
import "headless"
import "headless_core"
import "signals"
import "ui"
import "view"

fn c_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("c_test", msg)
  }
}

fn c_setup(root : view::View, dark~ : Bool = false) -> Unit {
  let cfg = signals::signal(if dark { AuraConfig::dark() } else { AuraConfig::light() })
  ui::set_tree_theme(fn() -> ui::Theme { aura_ui_theme(cfg.get()) })
  let _ = aura_provide_config(root, cfg)
  let _ = root.ground(view::Live::Is(aura_theme_from(cfg.get()).palette.background))
}

fn c_click_text(t : ui::Tester, s : String) -> Bool {
  match t.find(s) {
    Some((x, y)) => {
      t.click(x, y)
      true
    }
    None => false
  }
}

fn c_has_text(t : ui::Tester, s : String) -> Bool {
  match t.find(s) {
    Some(_) => true
    None => false
  }
}

test "c_tabs_primary_secondary_and_switch" {
  let sel = signals::signal("overview")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(16.0))
    let items = [
      AuraTabItem::new("overview", "Overview", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Overview body"), look=c_words_look(14.0, 400, 20.0))
      }),
      AuraTabItem::new("analytics", "Analytics", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Analytics body"), look=c_words_look(14.0, 400, 20.0))
      }),
      AuraTabItem::new("settings", "Settings", fn(v : view::View) -> Unit {
        let _ = v.words(view::Live::Is("Settings body"), look=c_words_look(14.0, 400, 20.0))
      }),
    ]
    let _ = tabs_node(root, items, fn() -> String { sel.get() }, fn(k : String) -> Unit { sel.set(k) }, variant=AuraTabsVariant::Primary)
    let _ = Tabs(root, items=items, selected=fn() -> String { sel.get() }, on_select=fn(k : String) -> Unit { sel.set(k) }, variant=AuraTabsVariant::Secondary, show_panels=false)
  }, width=800.0, height=500.0)

  assert_aura_ui(t, label="c_tabs")
  c_assert(sel.get() == "overview", "initial tab should be overview")
  c_assert(c_click_text(t, "Analytics"), "should click Analytics tab")
  c_assert(sel.get() == "analytics", "clicking Analytics should update selection")
  c_assert(c_has_text(t, "Analytics body"), "Analytics panel should be shown")
  t.dispose()
}

