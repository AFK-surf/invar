          let _ = MenuItem(sv, m=m, label="New File", shortcut="Cmd+N", on_action=fn() -> Unit { act.set("new") })
          let _ = MenuItem(sv, m=m, label="Delete", variant=AuraItemVariant::Danger, on_action=fn() -> Unit { act.set("delete") })
        })
