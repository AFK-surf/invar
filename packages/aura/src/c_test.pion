test "c_tag_group_select_and_remove" {
  let sel = signals::signal("pion")
  let removed = signals::signal("")
  let invar_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = root.pad(view::Live::Is(16.0))
    let _ = TagGroup(
      root,
      label="Tags",
      is_selected=fn(k : String) -> Bool { sel.get() == k },
      on_select=fn(k : String) -> Unit { sel.set(k) },
      on_remove=fn(k : String) -> Unit { removed.set(k) },
      children=fn(lv : view::View, tg : headless::TagGroup[String]) -> Unit {
        let _ = Tag(lv, tg=tg, key="pion", label="Pion", removable=true)
        invar_ref.v = Some(Tag(lv, tg=tg, key="invar", label="Invar", variant=AuraTagVariant::Surface, size=AuraTagSize::Sm))
        let _ = Tag(lv, tg=tg, key="aura", label="Aura", size=AuraTagSize::Lg)
      },
    )
  }, width=600.0, height=300.0)

  assert_aura_ui(t, label="c_tag_group")
  c_assert(c_click_text(t, "Invar"), "should click Invar tag")
  c_assert(sel.get() == "invar", "clicking Invar tag should select it")
  // Backspace removes focused tag
  match invar_ref.v {
    Some(tv) => {
      let _ = tv.ask_focus(visible=true)
      t.frame()
      t.backspace()
    }
    None => halt::saying("c_test", "missing Invar tag node")
  }
  c_assert(removed.get() == "invar", "Backspace on focused tag should invoke on_remove")
  t.dispose()
}

test "c_modal_blur_backdrop_zero_liquid_glass_and_exit_release" {
  let open = signals::signal(true)
  let exiting = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root, dark=true)
    let _ = Modal(
      root,
      open=fn() -> Bool { open.get() },
      on_close=fn() -> Unit { open.set(false) },
      heading="Confirm Action",
      backdrop=AuraOverlayBackdrop::Blur,
      exiting=fn() -> Bool { exiting.get() },
      footer=fn(fv : view::View) -> Unit {
        let _ = Button(fv, label=.Is("Cancel"), variant=AuraButtonVariant::Tertiary, on_press=fn() -> Unit { open.set(false) })
        let _ = Button(fv, label=.Is("Continue"), variant=AuraButtonVariant::Primary, on_press=fn() -> Unit { open.set(false) })
      },
      children=fn(bv : view::View) -> Unit {
        let _ = bv.words(view::Live::Is("Modal body content."), look=c_words_look(14.0, 400, 20.0, wrap=true))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(bv).palette.muted }))
      },
    )
  }, width=800.0, height=600.0)

  assert_aura_ui(t, label="c_modal_blur_dark")
  c_assert(count_liquid_glass(t) == 0, "Modal Blur backdrop must use frosted (kind 5), never liquid glass (kind 6)")
  // Exiting frame 1 releases pointer interaction
  exiting.set(true)
  t.frame()
  let _ = c_click_text(t, "Continue")
  c_assert(open.get(), "exiting modal must release pointer interaction on frame 1")
  exiting.set(false)
  t.frame()
  c_assert(c_click_text(t, "Continue"), "active modal Continue button should be clickable")
  c_assert(!open.get(), "clicking Continue should close modal")
  t.dispose()
}

test "c_alert_dialog_drawer_sheet_popover_tooltip" {
  let alert_open = signals::signal(true)
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    c_setup(root)
    let _ = AlertDialog(
      root,
      open=fn() -> Bool { alert_open.get() },
      on_close=fn() -> Unit { alert_open.set(false) },
      heading="Delete item?",
      description="This action cannot be undone.",
      footer=fn(fv : view::View) -> Unit {
        let _ = Button(fv, label=.Is("Cancel"), variant=AuraButtonVariant::Tertiary, on_press=fn() -> Unit { alert_open.set(false) })
        let _ = Button(fv, label=.Is("Delete"), variant=AuraButtonVariant::Danger, on_press=fn() -> Unit { alert_open.set(false) })
      },
    )
  }, width=800.0, height=600.0)
  assert_aura_ui(t1, label="c_alert_dialog")
  match t1.get("Delete item?", role=view::Role::AlertDialog) {
    Some(_) => ()
