// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Card and compound slots
// (CardHeader, CardTitle, CardDescription, CardContent, CardFooter) with SurfaceContext lending.

import "view"

fn a_card_surface_level(v : AuraSurfaceVariant) -> AuraSurfaceLevel {
  match v {
    AuraSurfaceVariant::Default => AuraSurfaceLevel::Primary
    AuraSurfaceVariant::Secondary => AuraSurfaceLevel::Secondary
    AuraSurfaceVariant::Tertiary => AuraSurfaceLevel::Tertiary
    AuraSurfaceVariant::Transparent => AuraSurfaceLevel::Transparent
  }
}

fn a_card_words_look(size : Double, weight : Int, line : Double, wrap : Bool) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

/// Aura `Card` container (Builder API).
/// Mirrors `.card` (`p-4`, `gap-3`, `rounded-3xl` capped at 32pt, `shadow-surface` in light mode).
/// Non-`Transparent` variants automatically lend `SurfaceContext` to descendants; `Transparent` skips
/// lending so inner components inherit the enclosing surface context and omits background & shadow.
pub fn card_node(
  parent : view::View,
  variant~ : AuraSurfaceVariant = AuraSurfaceVariant::Default,
  radius? : Double,
  pad~ : Double = 16.0,
  gap~ : Double = 12.0,
  shadow~ : Bool = true,
  bordered~ : Bool = false,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let lvl = a_card_surface_level(variant)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    if !(variant is AuraSurfaceVariant::Transparent) {
      let _ = aura_provide_surface_by(node, fn() -> AuraSurfaceLevel { lvl })
    }
    let _ = node
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
      .radius(view::Live::By(fn() -> Double {
        match radius {
          Some(r) => r
          None => {
            let cr = aura_theme(node).card_radius
            if cr > 32.0 { 32.0 } else { cr }
          }
        }
      }))
      .ground(view::Live::By(fn() -> Int64 {
        aura_surface_bg(aura_theme(node).palette, lvl)
      }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        if !shadow || (variant is AuraSurfaceVariant::Transparent) {
          []
        } else {
          aura_surface_shadows(aura_theme(node).config.dark)
        }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        if bordered && !(variant is AuraSurfaceVariant::Transparent) {
          let th = aura_theme(node)
          (th.border_width, th.palette.border)
        } else {
          (0.0, 0L)
        }
      }))
    if pad > 0.0 {
      let _ = node.pad(view::Live::Is(pad))
    }
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::Card>` wrapper.
pub fn Card(
  parent : view::View,
  variant~ : AuraSurfaceVariant = AuraSurfaceVariant::Default,
  radius? : Double,
  pad~ : Double = 16.0,
  gap~ : Double = 12.0,
  shadow~ : Bool = true,
  bordered~ : Bool = false,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  card_node(
    parent,
    variant=variant,
    radius?=radius,
    pad=pad,
    gap=gap,
    shadow=shadow,
    bordered=bordered,
    content=children,
    loc=loc,
  )
}

/// Aura `CardHeader` slot (Builder API): vertical flex container for title and description.
pub fn card_header_node(
  parent : view::View,
  gap~ : Double = 0.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node.fills_across(view::Live::Is(true))
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::CardHeader>` wrapper.
pub fn CardHeader(
  parent : view::View,
  gap~ : Double = 0.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  card_header_node(parent, gap=gap, content=children, loc=loc)
}

/// Aura `CardTitle` slot (Builder API): `14pt` Medium, `24pt` line-height, `--foreground`.
pub fn card_title_node(
  parent : view::View,
  text : view::Live[String],
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(w : view::View) -> Unit {
    let _ = w
      .words(text, look=a_card_words_look(14.0, 500, 24.0, wrap))
      .ink(view::Live::By(fn() -> Int64 { aura_theme(w).palette.foreground }))
  })
}

/// Pion-JSX `<aura::CardTitle>` wrapper.
pub fn CardTitle(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  card_title_node(parent, t, wrap=wrap, loc=loc)
}

/// Aura `CardDescription` slot (Builder API): `14pt` Regular, `20pt` line-height, `--muted`.
pub fn card_description_node(
  parent : view::View,
  text : view::Live[String],
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(w : view::View) -> Unit {
    let _ = w
      .words(text, look=a_card_words_look(14.0, 400, 20.0, wrap))
      .ink(view::Live::By(fn() -> Int64 { aura_theme(w).palette.muted }))
  })
}

/// Pion-JSX `<aura::CardDescription>` wrapper.
pub fn CardDescription(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  wrap~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  card_description_node(parent, t, wrap=wrap, loc=loc)
}

/// Aura `CardContent` slot (Builder API): flexible vertical body container (`flex-1 flex-col gap-1`).
pub fn card_content_node(
  parent : view::View,
  gap~ : Double = 4.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node.fills_across(view::Live::Is(true)).grow(view::Live::Is(1.0))
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::CardContent>` wrapper.
pub fn CardContent(
  parent : view::View,
  gap~ : Double = 4.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  card_content_node(parent, gap=gap, content=children, loc=loc)
}

/// Aura `CardFooter` slot (Builder API): horizontal action row (`flex-row items-center`).
pub fn card_footer_node(
  parent : view::View,
  gap~ : Double = 8.0,
  align_end~ : Bool = false,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .fills_across(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(if align_end { view::Lies::End } else { view::Lies::Start }))
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    content(node)
  })
}

/// Pion-JSX `<aura::CardFooter>` wrapper.
pub fn CardFooter(
  parent : view::View,
  gap~ : Double = 8.0,
  align_end~ : Bool = false,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  card_footer_node(parent, gap=gap, align_end=align_end, content=children, loc=loc)
}
