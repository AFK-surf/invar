// Aura Track 1C — Overlay components (Builder + Pion-JSX):
// Modal, AlertDialog, Drawer, Sheet, Popover, Tooltip.
// Zero liquid glass (`kind == 6`): Blur backdrop uses `paint::Glass::frosted` (`kind == 5`).

import "headless"
import "paint"
import "signals"
import "view"

/// Backdrop appearance for `Modal`, `AlertDialog`, `Drawer`, and `Sheet`.
#derive(Eq)
pub enum AuraOverlayBackdrop {
  Opaque
  Blur
  Transparent
}

/// Width preset for `Modal` and `AlertDialog`.
#derive(Eq)
pub enum AuraModalSize {
  Xs
  Sm
  Md
  Lg
  Cover
  Full
}

/// Edge placement for `Drawer` and `Sheet`.
#derive(Eq)
pub enum AuraDrawerPlacement {
  Left
  Right
  Top
  Bottom
}

/// Semantic icon tint for `AlertDialog`.
#derive(Eq)
pub enum AuraAlertIconVariant {
  Default
  Accent
  Success
  Warning
  Danger
}

fn c_modal_max_width(size : AuraModalSize) -> Option[Double] {
  match size {
    AuraModalSize::Xs => Some(320.0)
    AuraModalSize::Sm => Some(384.0)
    AuraModalSize::Md => Some(448.0)
    AuraModalSize::Lg => Some(512.0)
    AuraModalSize::Cover | AuraModalSize::Full => None
  }
}

fn c_drawer_edge(p : AuraDrawerPlacement) -> headless::DrawerEdge {
  match p {
    AuraDrawerPlacement::Left => headless::DrawerEdge::Left
    AuraDrawerPlacement::Right => headless::DrawerEdge::Right
    AuraDrawerPlacement::Top => headless::DrawerEdge::Top
    AuraDrawerPlacement::Bottom => headless::DrawerEdge::Bottom
  }
}

fn c_apply_backdrop(node : view::View, backdrop : AuraOverlayBackdrop, animating : () -> Bool) -> Unit {
  match backdrop {
    AuraOverlayBackdrop::Transparent => {
      let _ = node.ground(view::Live::Is(0x00000000L))
    }
    AuraOverlayBackdrop::Opaque => {
      let _ = node.ground(view::Live::By(fn() -> Int64 { aura_theme(node).palette.backdrop }))
    }
    AuraOverlayBackdrop::Blur => {
      // Strictly frosted glass (kind == 5), never liquid glass (kind == 6).
      // On coarse-pointer mobile devices, skip backdrop blur during enter/exit animation.
      let _ = node
        .ground(view::Live::By(fn() -> Int64 {
          if aura_is_coarse_pointer(node) && animating() {
            aura_theme(node).palette.backdrop
          } else {
            0x00000000L
          }
        }))
        .glass(view::Live::By(fn() -> Option[paint::Glass] {
          if aura_is_coarse_pointer(node) && animating() {
            None
          } else {
            let b = aura_theme(node).palette.backdrop
            Some(paint::Glass::frosted(blur=12.0, tint=b, solid=b))
          }
        }))
    }
  }
}

fn c_placement_to_beside(p : headless::Placement, rtl~ : Bool = false) -> (view::Side, view::Along) {
  let flip_h = fn(a : view::Along) -> view::Along {
    if !rtl {
      a
    } else {
      match a {
        view::Along::Start => view::Along::End
        view::Along::End => view::Along::Start
        view::Along::Middle => view::Along::Middle
      }
    }
  }
  match p {
    headless::Placement::BelowStart => (view::Side::Bottom, flip_h(view::Along::Start))
    headless::Placement::BelowCenter => (view::Side::Bottom, view::Along::Middle)
    headless::Placement::BelowEnd => (view::Side::Bottom, flip_h(view::Along::End))
    headless::Placement::AboveStart => (view::Side::Top, flip_h(view::Along::Start))
    headless::Placement::AboveCenter => (view::Side::Top, view::Along::Middle)
    headless::Placement::AboveEnd => (view::Side::Top, flip_h(view::Along::End))
    headless::Placement::RightStart => (view::Side::Right, view::Along::Start)
    headless::Placement::RightCenter => (view::Side::Right, view::Along::Middle)
    headless::Placement::RightEnd => (view::Side::Right, view::Along::End)
    headless::Placement::LeftStart => (view::Side::Left, view::Along::Start)
    headless::Placement::LeftCenter => (view::Side::Left, view::Along::Middle)
    headless::Placement::LeftEnd => (view::Side::Left, view::Along::End)
  }
}

fn c_beside_to_anchor_side(s : view::Side) -> headless::AnchorSide {
  match s {
    view::Side::Bottom => headless::AnchorSide::Below
    view::Side::Top => headless::AnchorSide::Above
    view::Side::Right => headless::AnchorSide::Right
    view::Side::Left => headless::AnchorSide::Left
  }
}

fn c_arrow_shapes(side : headless::AnchorSide, fill : Int64) -> Array[paint::Shape] {
  // 12x6 (vertical) or 6x12 (horizontal) triangle pointing toward anchor
  let pts : Array[Double] = match side {
    headless::AnchorSide::Below => [0.0, 6.0, 6.0, 0.0, 12.0, 6.0]
    headless::AnchorSide::Above => [0.0, 0.0, 12.0, 0.0, 6.0, 6.0]
    headless::AnchorSide::Right => [6.0, 0.0, 0.0, 6.0, 6.0, 12.0]
    headless::AnchorSide::Left => [0.0, 0.0, 6.0, 6.0, 0.0, 12.0]
  }
  [paint::shape_of([(pts, true)], fill=fill)]
}

fn c_arrow_wrap_edges(
  side : headless::AnchorSide,
  offset~ : Double = -6.0,
) -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
  match side {
    headless::AnchorSide::Below => (Some(0.0), Some(offset), Some(0.0), None)
    headless::AnchorSide::Above => (Some(0.0), None, Some(0.0), Some(offset))
    headless::AnchorSide::Right => (Some(offset), Some(0.0), None, Some(0.0))
    headless::AnchorSide::Left => (None, Some(0.0), Some(offset), Some(0.0))
  }
}

fn c_arrow_size(side : headless::AnchorSide) -> (Double, Double) {
  match side {
    headless::AnchorSide::Below | headless::AnchorSide::Above => (12.0, 6.0)
    headless::AnchorSide::Right | headless::AnchorSide::Left => (6.0, 12.0)
  }
}

fn c_mount_arrow(
  host : view::View,
  side_get : () -> headless::AnchorSide,
  offset~ : Double = -6.0,
) -> Unit {
  let _ = host.box(fn(wrap : view::View) -> Unit {
    let _ = wrap
      .points(view::Live::Is(false))
      .row(view::Live::By(fn() -> Bool {
        match side_get() {
          headless::AnchorSide::Below | headless::AnchorSide::Above => true
          headless::AnchorSide::Right | headless::AnchorSide::Left => false
        }
      }))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .over_at(view::Live::By(fn() -> (Option[Double], Option[Double], Option[Double], Option[Double]) {
        c_arrow_wrap_edges(side_get(), offset=offset)
      }))
      .width(view::Live::By(fn() -> Option[Double] {
        match side_get() {
          headless::AnchorSide::Right | headless::AnchorSide::Left => Some(6.0)
          _ => None
        }
      }))
      .height(view::Live::By(fn() -> Option[Double] {
        match side_get() {
          headless::AnchorSide::Below | headless::AnchorSide::Above => Some(6.0)
          _ => None
        }
      }))
    let _ = wrap.box(fn(arr : view::View) -> Unit {
      let _ = arr
        .points(view::Live::Is(false))
        .shrink(view::Live::Is(0.0))
        .width(view::Live::By(fn() -> Option[Double] { Some(c_arrow_size(side_get()).0) }))
        .height(view::Live::By(fn() -> Option[Double] { Some(c_arrow_size(side_get()).1) }))
        .shapes(view::Live::By(fn() -> Array[paint::Shape] {
          c_arrow_shapes(side_get(), aura_theme(arr).palette.overlay)
        }))
    })
  })
}

/// Inherit the nearest `AuraConfig` signal from `source` onto a root-mounted overlay `target`.
fn c_inherit_aura_config(source : view::View, target : view::View) -> Unit {
  match aura_config_signal_of(source) {
    Some(sig) => {
      let _ = aura_provide_config(target, sig)
    }
    None => ()
  }
}

/// Mount a window-level overlay onto `parent.tree.root()` scoped to a 0x0 anchor in `parent`.
/// Automatically inherits nested `AuraConfig` and tears down the root slot when `parent` unmounts.
fn c_mount_window_overlay(
  parent : view::View,
  loc : String,
  when : () -> Bool,
  build : (view::View) -> Unit,
) -> view::View {
  parent.box(loc=loc, fn(anchor : view::View) -> Unit {
    let _ = anchor
      .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, None))
      .points(view::Live::Is(false))
    let root = anchor.tree.root()
    let tie = root.show_scoped(
      when,
      fn(mount : view::View) -> Unit {
        let _ = mount
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
          .points(view::Live::Is(false))
        c_inherit_aura_config(anchor, mount)
        build(mount)
      },
      at_once=true,
    )
    tie(anchor)
  })
}

struct AuraTooltipRegistry {
  next_id : signals::Ref[Int]
  shown : signals::Signal[Option[Int]]
  groups : Array[(Double, Double, headless::TooltipGroup[Int])]
}

let c_tooltip_registry_lent : view::Lent[AuraTooltipRegistry] = view::Lent::new()

fn c_tooltip_group_for(
  root : view::View,
  open_delay_ms : Double,
  close_delay_ms : Double,
) -> (headless::TooltipGroup[Int], Int) {
  let reg = match root.lent(c_tooltip_registry_lent) {
    Some(r) => r
    None => {
      let shown : signals::Signal[Option[Int]] = signals::signal_by(None, fn(a : Option[Int], b : Option[Int]) -> Bool {
        match (a, b) {
          (None, None) => true
          (Some(x), Some(y)) => x == y
          _ => false
        }
      })
      let r = AuraTooltipRegistry::{ next_id: view::ref_new(1), shown, groups: [] }
      let _ = root.lends(c_tooltip_registry_lent, r)
      r
    }
  }
  let id = reg.next_id.v
  reg.next_id.v = id + 1
  for entry in reg.groups {
    if entry.0 == open_delay_ms && entry.1 == close_delay_ms {
      return (entry.2, id)
    }
  }
  let grp = headless::TooltipGroup::new(
    fn() -> Option[Int] { reg.shown.get() },
    fn(v : Option[Int]) -> Unit { reg.shown.set(v) },
    open_delay_ms=open_delay_ms,
    close_delay_ms=close_delay_ms,
  )
  reg.groups.push((open_delay_ms, close_delay_ms, grp))
  (grp, id)
}

fn c_alert_icon_colors(pal : AuraPalette, variant : AuraAlertIconVariant) -> (Int64, Int64, AuraIconKind) {
  match variant {
    AuraAlertIconVariant::Default => (pal.default_bg, pal.foreground, AuraIconKind::CircleInfo)
    AuraAlertIconVariant::Accent => (pal.accent_soft, pal.accent_soft_foreground, AuraIconKind::CircleInfo)
    AuraAlertIconVariant::Success => (pal.success_soft, pal.success_soft_foreground, AuraIconKind::CircleCheck)
    AuraAlertIconVariant::Warning => (pal.warning_soft, pal.warning_soft_foreground, AuraIconKind::TriangleExclamation)
    AuraAlertIconVariant::Danger => (pal.danger_soft, pal.danger_soft_foreground, AuraIconKind::CircleExclamation)
  }
}

// ===========================================================================
// 16. Modal
// ===========================================================================

/// Aura `Modal` (Builder API).
/// Wired to `headless::dialog` + `overlay_stack`. Supports `Opaque`/`Blur`/`Transparent` backdrop,
/// mounts dark overlay inner rim, re-borrows `AuraSurfaceLevel::Overlay`, and releases interaction on frame 1 of exit.
pub fn modal_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  heading~ : String = "",
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  size~ : AuraModalSize = AuraModalSize::Sm,
  width? : Double,
  show_close_button~ : Bool = true,
  exiting~ : () -> Bool = fn() { false },
  body~ : (view::View) -> Unit = fn(_v : view::View) { () },
  footer? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let is_full = size is AuraModalSize::Full
  let is_cover = size is AuraModalSize::Cover
  let aria_label = if heading != "" { heading } else { "Dialog" }

  c_mount_window_overlay(parent, loc, open, fn(mount : view::View) -> Unit {
    let active = fn() -> Bool { open() && !exiting() }
    let _ = mount
      .in_use(view::Live::By(active))
      .points(view::Live::By(active))

    let _ = headless::dialog(
      mount,
      fn() -> String { aria_label },
      active,
      on_close,
        fn(dlg_root : view::View, dlg : headless::Dialog) -> Unit {
          let _ = dlg_root
            .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))

          // Backdrop scrim
          let _ = dlg_root.box(fn(scrim : view::View) -> Unit {
            let _ = scrim
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))
              .on_press(fn() -> Unit { dlg.close() })
            c_apply_backdrop(scrim, backdrop, exiting)
          })

          // Dialog surface
          let ov_sig = signals::signal(AuraSurfaceLevel::Overlay)
          let _ = dlg_root.box(fn(panel : view::View) -> Unit {
            let _ = aura_provide_surface(panel, ov_sig)
            let rad = if is_full { 0.0 } else { 24.0 }
            let _ = panel
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(panel) }))
              .radius(view::Live::Is(rad))
              .pad(view::Live::Is(24.0))
              .ground(view::Live::By(fn() -> Int64 { aura_theme(panel).palette.overlay }))
              .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                if is_full { [] } else { aura_overlay_shadows(aura_theme(panel).config.dark) }
              }))
              .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))

            if !is_full {
              w0_mount_dark_overlay_rim(panel, view::Live::Is(rad))
            }

            match width {
              Some(w) => {
                let _ = panel.width(view::Live::Is(Some(w)))
              }
              None =>
                if is_full || is_cover {
                  let _ = panel.fill()
                } else {
                  match c_modal_max_width(size) {
                    Some(mw) => {
                      let _ = panel.width(view::Live::Is(Some(mw)))
                    }
                    None => ()
                  }
                }
            }

            if show_close_button {
              let _ = panel.box(fn(cb_slot : view::View) -> Unit {
                let _ = cb_slot.over(view::Live::Is(true), edges=(None, Some(16.0), Some(16.0), None))
                let _ = close_button_node(cb_slot, on_press=fn() -> Unit { dlg.close() })
              })
            }

            if heading != "" {
              let _ = panel.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                  .fills_across(view::Live::Is(true))
                  .words(view::Live::Is(heading), look=c_words_look(16.0, 500, 24.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(hdr).palette.foreground }))
              })
            }

            let _ = panel.box(fn(bv : view::View) -> Unit {
              let _ = bv
                .fills_across(view::Live::Is(true))
                .pad_xy(0.0, 3.0)
                .margin(view::Live::Is((0.0, if heading != "" { 8.0 } else { 0.0 }, 0.0, 0.0)))
              let _ = bv.box(fn(inner : view::View) -> Unit {
                let _ = inner.fills_across(view::Live::Is(true))
                body(inner)
              })
            })

            match footer {
              Some(f_fn) => {
                let _ = panel.box(fn(fv : view::View) -> Unit {
                  let _ = fv
                    .row(view::Live::Is(true))
                    .fills_across(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::End))
                    .gap(view::Live::Is(8.0))
                    .margin(view::Live::Is((0.0, 20.0, 0.0, 0.0)))
                  f_fn(fv)
                })
              }
              None => ()
            }
          })
        },
        kind=headless::DialogKind::Dialog,
      )
  })
}

/// Pion-JSX `<aura::Modal>` wrapper.
pub fn Modal(
  parent : view::View,
  open~ : () -> Bool = fn() { false },
  on_close~ : () -> Unit = fn() { () },
  heading~ : String = "",
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  size~ : AuraModalSize = AuraModalSize::Sm,
  width? : Double,
  show_close_button~ : Bool = true,
  exiting~ : () -> Bool = fn() { false },
  footer? : (view::View) -> Unit,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  modal_node(
    parent,
    open,
    on_close,
    heading=heading,
    backdrop=backdrop,
    size=size,
    width?=width,
    show_close_button=show_close_button,
    exiting=exiting,
    body=children,
    footer?=footer,
    loc=loc,
  )
}

// ===========================================================================
// 17. AlertDialog (Role::AlertDialog + circular icon badge + heading/body/footer)
// ===========================================================================

/// Aura `AlertDialog` (Builder API).
/// Wired to `headless::dialog` with `DialogKind::AlertDialog` (`Role::AlertDialog`).
pub fn alert_dialog_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  heading : String,
  description : String,
  icon_variant~ : AuraAlertIconVariant = AuraAlertIconVariant::Danger,
  icon? : AuraIconKind,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  size~ : AuraModalSize = AuraModalSize::Sm,
  width? : Double,
  exiting~ : () -> Bool = fn() { false },
  footer? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  c_mount_window_overlay(parent, loc, open, fn(mount : view::View) -> Unit {
    let active = fn() -> Bool { open() && !exiting() }
    let _ = mount
      .in_use(view::Live::By(active))
      .points(view::Live::By(active))

    let _ = headless::dialog(
      mount,
      fn() -> String { heading },
      active,
      on_close,
        fn(dlg_root : view::View, dlg : headless::Dialog) -> Unit {
          let _ = dlg_root
            .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))

          let _ = dlg_root.box(fn(scrim : view::View) -> Unit {
            let _ = scrim
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))
            c_apply_backdrop(scrim, backdrop, exiting)
          })

          let ov_sig = signals::signal(AuraSurfaceLevel::Overlay)
          let _ = dlg_root.box(fn(panel : view::View) -> Unit {
            let _ = aura_provide_surface(panel, ov_sig)
            let _ = panel
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(panel) }))
              .radius(view::Live::Is(24.0))
              .pad(view::Live::Is(24.0))
              .ground(view::Live::By(fn() -> Int64 { aura_theme(panel).palette.overlay }))
              .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                aura_overlay_shadows(aura_theme(panel).config.dark)
              }))
              .points(view::Live::By(fn() -> Bool { dlg.open() && !exiting() }))

            w0_mount_dark_overlay_rim(panel, view::Live::Is(24.0))

            match width {
              Some(w) => {
                let _ = panel.width(view::Live::Is(Some(w)))
              }
              None =>
                match c_modal_max_width(size) {
                  Some(mw) => {
                    let _ = panel.width(view::Live::Is(Some(mw)))
                  }
                  None => ()
                }
            }

            // Header: circular 40x40 icon badge + 12pt gap + heading
            let _ = panel.box(fn(hdr : view::View) -> Unit {
              let _ = hdr.fills_across(view::Live::Is(true)).gap(view::Live::Is(12.0))
              let _ = hdr.box(fn(badge : view::View) -> Unit {
                let _ = badge
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .width(view::Live::Is(Some(40.0)))
                  .height(view::Live::Is(Some(40.0)))
                  .shrink(view::Live::Is(0.0))
                  .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(badge) }))
                  .radius(view::Live::Is(20.0))
                  .ground(view::Live::By(fn() -> Int64 {
                    c_alert_icon_colors(aura_theme(badge).palette, icon_variant).0
                  }))
                let default_icon = c_alert_icon_colors(aura_theme(badge).palette, icon_variant).2
                let chosen_icon = match icon { Some(k) => k; None => default_icon }
                let _ = aura_icon_node(
                  badge,
                  chosen_icon,
                  size=20.0,
                  ink=fn() -> Int64 { c_alert_icon_colors(aura_theme(badge).palette, icon_variant).1 },
                )
              })
              let _ = hdr.box(fn(title_v : view::View) -> Unit {
                let _ = title_v
                  .fills_across(view::Live::Is(true))
                  .words(view::Live::Is(heading), look=c_words_look(16.0, 500, 24.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(title_v).palette.foreground }))
              })
            })

            if description != "" {
              let _ = panel.box(fn(bv : view::View) -> Unit {
                let _ = bv
                  .fills_across(view::Live::Is(true))
                  .pad_xy(0.0, 3.0)
                  .margin(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
                let _ = bv.box(fn(tv : view::View) -> Unit {
                  let _ = tv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is(description), look=c_words_look(14.0, 400, 20.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.muted }))
                })
              })
            }

            match footer {
              Some(f_fn) => {
                let _ = panel.box(fn(fv : view::View) -> Unit {
                  let _ = fv
                    .row(view::Live::Is(true))
                    .fills_across(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::End))
                    .gap(view::Live::Is(8.0))
                    .margin(view::Live::Is((0.0, 20.0, 0.0, 0.0)))
                  f_fn(fv)
                })
              }
              None => ()
            }
          })
        },
        kind=headless::DialogKind::AlertDialog,
        description=fn() -> String { description },
      )
  })
}

/// Pion-JSX `<aura::AlertDialog>` wrapper.
pub fn AlertDialog(
  parent : view::View,
  open~ : () -> Bool = fn() { false },
  on_close~ : () -> Unit = fn() { () },
  heading~ : String = "",
  description~ : String = "",
  icon_variant~ : AuraAlertIconVariant = AuraAlertIconVariant::Danger,
  icon? : AuraIconKind,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  size~ : AuraModalSize = AuraModalSize::Sm,
  width? : Double,
  exiting~ : () -> Bool = fn() { false },
  footer? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  alert_dialog_node(
    parent,
    open,
    on_close,
    heading,
    description,
    icon_variant=icon_variant,
    icon?=icon,
    backdrop=backdrop,
    size=size,
    width?=width,
    exiting=exiting,
    footer?=footer,
    loc=loc,
  )
}

// ===========================================================================
// 18. Drawer (Left / Right / Top / Bottom + drag handle)
// ===========================================================================

/// Aura `Drawer` (Builder API). Wired to `headless::drawer` across all 4 edges with optional drag handle.
pub fn drawer_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  heading~ : String = "",
  placement~ : AuraDrawerPlacement = AuraDrawerPlacement::Right,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  show_handle~ : Bool = false,
  show_close_button~ : Bool = true,
  panel_width~ : Double = 384.0,
  exiting~ : () -> Bool = fn() { false },
  body~ : (view::View) -> Unit = fn(_v : view::View) { () },
  footer? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let aria_label = if heading != "" { heading } else { "Drawer" }
  let edge = c_drawer_edge(placement)

  c_mount_window_overlay(parent, loc, open, fn(mount : view::View) -> Unit {
    let active = fn() -> Bool { open() && !exiting() }
    let _ = mount
      .in_use(view::Live::By(active))
      .points(view::Live::By(active))

    let _ = headless::drawer(
      mount,
      fn() -> String { aria_label },
      active,
      on_close,
      fn(dr_root : view::View, dr : headless::Drawer) -> Unit {
          let _ = dr_root
            .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
            .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))

          let _ = dr_root.box(fn(scrim : view::View) -> Unit {
            let _ = scrim
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))
              .on_press(fn() -> Unit { dr.close() })
            c_apply_backdrop(scrim, backdrop, exiting)
          })

          let ov_sig = signals::signal(AuraSurfaceLevel::Overlay)
          let _ = dr_root.box(fn(panel : view::View) -> Unit {
            let _ = aura_provide_surface(panel, ov_sig)
            let _ = panel
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(panel) }))
              .pad(view::Live::Is(24.0))
              .ground(view::Live::By(fn() -> Int64 { aura_theme(panel).palette.overlay }))
              .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                aura_overlay_shadows(aura_theme(panel).config.dark)
              }))
              .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))

            match placement {
              AuraDrawerPlacement::Right => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(None, Some(0.0), Some(0.0), Some(0.0)))
                  .width(view::Live::Is(Some(panel_width)))
                  .radius(view::Live::Is(0.0))
                w0_mount_dark_overlay_rim(panel, view::Live::Is(0.0))
              }
              AuraDrawerPlacement::Left => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                  .width(view::Live::Is(Some(panel_width)))
                  .radius(view::Live::Is(0.0))
                w0_mount_dark_overlay_rim(panel, view::Live::Is(0.0))
              }
              AuraDrawerPlacement::Bottom => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), None, Some(0.0), Some(0.0)))
                  .corners(view::Live::Is(Some((16.0, 16.0, 0.0, 0.0))))
                w0_mount_dark_overlay_rim(panel, view::Live::Is(16.0))
              }
              AuraDrawerPlacement::Top => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), None))
                  .corners(view::Live::Is(Some((0.0, 0.0, 16.0, 16.0))))
                w0_mount_dark_overlay_rim(panel, view::Live::Is(16.0))
              }
            }

            if show_handle {
              let _ = panel.box(fn(h_wrap : view::View) -> Unit {
                let _ = h_wrap
                  .row(view::Live::Is(true))
                  .fills_across(view::Live::Is(true))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .padding(view::Live::Is((0.0, 0.0, 0.0, 8.0)))
                  .points(view::Live::Is(false))
                let _ = dr.handle(
                  h_wrap,
                  fn(hv : view::View, _d : headless::Drawer) -> Unit {
                    let _ = hv
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .width(view::Live::Is(Some(44.0)))
                      .height(view::Live::Is(Some(12.0)))
                    let _ = hv.box(fn(bar : view::View) -> Unit {
                      let _ = bar
                        .width(view::Live::Is(Some(36.0)))
                        .height(view::Live::Is(Some(4.0)))
                        .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(bar) }))
                        .radius(view::Live::Is(2.0))
                        .points(view::Live::Is(false))
                        .ground(view::Live::By(fn() -> Int64 { aura_theme(bar).palette.separator }))
                    })
                  },
                )
              })
            }

            if show_close_button {
              let _ = panel.box(fn(cb_slot : view::View) -> Unit {
                let _ = cb_slot.over(view::Live::Is(true), edges=(None, Some(16.0), Some(16.0), None))
                let _ = close_button_node(cb_slot, on_press=fn() -> Unit { dr.close() })
              })
            }

            if heading != "" {
              let _ = panel.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                  .fills_across(view::Live::Is(true))
                  .words(view::Live::Is(heading), look=c_words_look(16.0, 500, 24.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(hdr).palette.foreground }))
              })
            }

            let _ = panel.box(fn(bv : view::View) -> Unit {
              let _ = bv
                .fills_across(view::Live::Is(true))
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .min_height(view::Live::Is(Some(0.0)))
                .pad_xy(0.0, 3.0)
                .margin(view::Live::Is((0.0, if heading != "" { 8.0 } else { 0.0 }, 0.0, 0.0)))
              let _ = bv.box(fn(inner : view::View) -> Unit {
                let _ = inner.fills_across(view::Live::Is(true))
                body(inner)
              })
            })

            match footer {
              Some(f_fn) => {
                let _ = panel.box(fn(fv : view::View) -> Unit {
                  let _ = fv
                    .row(view::Live::Is(true))
                    .fills_across(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::End))
                    .gap(view::Live::Is(8.0))
                    .margin(view::Live::Is((0.0, 20.0, 0.0, 0.0)))
                  f_fn(fv)
                })
              }
              None => ()
            }
          })
        },
        edge=edge,
      )
  })
}

/// Pion-JSX `<aura::Drawer>` wrapper.
pub fn Drawer(
  parent : view::View,
  open~ : () -> Bool = fn() { false },
  on_close~ : () -> Unit = fn() { () },
  heading~ : String = "",
  placement~ : AuraDrawerPlacement = AuraDrawerPlacement::Right,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  show_handle~ : Bool = false,
  show_close_button~ : Bool = true,
  panel_width~ : Double = 384.0,
  exiting~ : () -> Bool = fn() { false },
  footer? : (view::View) -> Unit,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  drawer_node(
    parent,
    open,
    on_close,
    heading=heading,
    placement=placement,
    backdrop=backdrop,
    show_handle=show_handle,
    show_close_button=show_close_button,
    panel_width=panel_width,
    exiting=exiting,
    body=children,
    footer?=footer,
    loc=loc,
  )
}

// ===========================================================================
// 19. Sheet (Bottom/side snap sheet aligned to sheet.css)
// ===========================================================================

/// Aura `Sheet` (Builder API). Wired to `headless::drawer`, styled per `sheet.css`.
pub fn sheet_node(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  heading~ : String = "",
  placement~ : AuraDrawerPlacement = AuraDrawerPlacement::Bottom,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  show_handle~ : Bool = true,
  panel_width~ : Double = 384.0,
  exiting~ : () -> Bool = fn() { false },
  body~ : (view::View) -> Unit = fn(_v : view::View) { () },
  footer? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let aria_label = if heading != "" { heading } else { "Sheet" }
  let edge = c_drawer_edge(placement)

  c_mount_window_overlay(parent, loc, open, fn(mount : view::View) -> Unit {
    let active = fn() -> Bool { open() && !exiting() }
    let _ = mount
      .in_use(view::Live::By(active))
      .points(view::Live::By(active))

    let _ = headless::drawer(
      mount,
      fn() -> String { aria_label },
      active,
      on_close,
      fn(sh_root : view::View, dr : headless::Drawer) -> Unit {
          let _ = sh_root
            .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
            .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))

          let _ = sh_root.box(fn(scrim : view::View) -> Unit {
            let _ = scrim
              .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
              .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))
              .on_press(fn() -> Unit { dr.close() })
            c_apply_backdrop(scrim, backdrop, exiting)
          })

          let ov_sig = signals::signal(AuraSurfaceLevel::Overlay)
          let _ = sh_root.box(fn(panel : view::View) -> Unit {
            let _ = aura_provide_surface(panel, ov_sig)
            let _ = panel
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(panel) }))
              .ground(view::Live::By(fn() -> Int64 { aura_theme(panel).palette.overlay }))
              .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                aura_overlay_shadows(aura_theme(panel).config.dark)
              }))
              .points(view::Live::By(fn() -> Bool { dr.open() && !exiting() }))

            match placement {
              AuraDrawerPlacement::Bottom => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), None, Some(0.0), Some(0.0)))
                  .corners(view::Live::Is(Some((16.0, 16.0, 0.0, 0.0))))
              }
              AuraDrawerPlacement::Top => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), None))
                  .corners(view::Live::Is(Some((0.0, 0.0, 16.0, 16.0))))
              }
              AuraDrawerPlacement::Left => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                  .width(view::Live::Is(Some(panel_width)))
                  .corners(view::Live::Is(Some((0.0, 16.0, 16.0, 0.0))))
              }
              AuraDrawerPlacement::Right => {
                let _ = panel
                  .over(view::Live::Is(true), edges=(None, Some(0.0), Some(0.0), Some(0.0)))
                  .width(view::Live::Is(Some(panel_width)))
                  .corners(view::Live::Is(Some((16.0, 0.0, 0.0, 16.0))))
              }
            }
            w0_mount_dark_overlay_rim(panel, view::Live::Is(16.0))

            if show_handle {
              let _ = dr.handle(
                panel,
                fn(hv : view::View, _d : headless::Drawer) -> Unit {
                  let _ = hv
                    .row(view::Live::Is(true))
                    .fills_across(view::Live::Is(true))
                    .lies_along(view::Live::Is(view::Lies::Middle))
                    .pad_xy(0.0, 12.0)
                  let _ = hv.box(fn(bar : view::View) -> Unit {
                    let _ = bar
                      .width(view::Live::Is(Some(32.0)))
                      .height(view::Live::Is(Some(4.8)))
                      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(bar) }))
                      .radius(view::Live::Is(2.4))
                      .points(view::Live::Is(false))
                      .ground(view::Live::By(fn() -> Int64 { aura_theme(bar).palette.default_bg }))
                  })
                },
              )
            }

            if heading != "" {
              let _ = panel.box(fn(hdr : view::View) -> Unit {
                let _ = hdr
                  .fills_across(view::Live::Is(true))
                  .padding(view::Live::Is((20.0, 15.3, 20.0, 8.7)))
                let _ = hdr.box(fn(tv : view::View) -> Unit {
                  let _ = tv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is(heading), look=c_words_look(18.0, 600, 28.0))
                    .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.overlay_foreground }))
                })
              })
            }

            let _ = panel.box(fn(bv : view::View) -> Unit {
              let _ = bv.fills_across(view::Live::Is(true)).pad_xy(20.0, 8.0)
              let _ = bv.box(fn(inner : view::View) -> Unit {
                let _ = inner.fills_across(view::Live::Is(true))
                body(inner)
              })
            })

            match footer {
              Some(f_fn) => {
                let _ = panel.box(fn(fv : view::View) -> Unit {
                  let _ = fv
                    .row(view::Live::Is(true))
                    .fills_across(view::Live::Is(true))
                    .lines_up(view::Live::Is(Some(view::Along::Middle)))
                    .lies_along(view::Live::Is(view::Lies::End))
                    .gap(view::Live::Is(8.0))
                    .padding(view::Live::Is((20.0, 8.0, 20.0, 16.0)))
                  f_fn(fv)
                })
              }
              None => ()
            }
          })
        },
        edge=edge,
      )
  })
}

/// Pion-JSX `<aura::Sheet>` wrapper.
pub fn Sheet(
  parent : view::View,
  open~ : () -> Bool = fn() { false },
  on_close~ : () -> Unit = fn() { () },
  heading~ : String = "",
  placement~ : AuraDrawerPlacement = AuraDrawerPlacement::Bottom,
  backdrop~ : AuraOverlayBackdrop = AuraOverlayBackdrop::Opaque,
  show_handle~ : Bool = true,
  panel_width~ : Double = 384.0,
  exiting~ : () -> Bool = fn() { false },
  footer? : (view::View) -> Unit,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  sheet_node(
    parent,
    open,
    on_close,
    heading=heading,
    placement=placement,
    backdrop=backdrop,
    show_handle=show_handle,
    panel_width=panel_width,
    exiting=exiting,
    body=children,
    footer?=footer,
    loc=loc,
  )
}

// ===========================================================================
// 20. Popover (w0_popover_shell + headless::Popover + anchor + optional arrow)
// ===========================================================================

/// Aura `Popover` (Builder API).
/// Reuses `w0_popover_shell`, wired to `headless::Popover` + `headless::anchor_place`, with optional arrow.
pub fn popover_node(
  parent : view::View,
  trigger_label : String,
  open : () -> Bool,
  set_open : (Bool) -> Unit,
  content : (view::View) -> Unit,
  heading? : String,
  trigger_variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  placement~ : headless::Placement = headless::Placement::BelowCenter,
  gap~ : Double = 10.0,
  width~ : Double = 280.0,
  show_arrow~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let pop = headless::Popover::new(open, set_open)

  parent.box(loc=loc, fn(host : view::View) -> Unit {
    let _ = host
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
    let _ = pop.trigger(
      host,
      fn() -> String { trigger_label },
      fn(trig : view::View, disc : headless::Disclosure) -> Unit {
        let (_, px, fs, lh, press_sc) = w0_btn_metrics(AuraButtonSize::Md, false, true)
        let _ = trig
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .height(view::Live::By(fn() -> Option[Double] {
            Some(w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0)
          }))
          .shrink(view::Live::Is(0.0))
          .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(trig) }))
          .radius(view::Live::By(fn() -> Double {
            w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0 * 0.5
          }))
          .group_alpha(view::Live::By(fn() -> Double {
            if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
          }))
        let _ = w0_apply_control_focus_ring(trig)
        // Paint scale(0.97) on inner visual face so `beside` keeps anchoring to the unscaled 36pt layout rect
        let _ = trig.box(fn(face : view::View) -> Unit {
          let _ = face
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .gap(view::Live::Is(8.0))
            .height(view::Live::By(fn() -> Option[Double] {
              Some(w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0)
            }))
            .pad_xy(px, 0.0)
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(face) }))
            .radius(view::Live::By(fn() -> Double {
              w0_btn_metrics(AuraButtonSize::Md, false, aura_is_md(trig)).0 * 0.5
            }))
            .scale(view::Live::By(fn() -> Double {
              if !aura_reduced_motion(trig) && !disc.disabled() && (open() || disc.pressed()) { press_sc } else { 1.0 }
            }))
            .ground(view::Live::By(fn() -> Int64 {
              let hov = !disc.disabled() && (open() || disc.pressed() || (!aura_is_coarse_pointer(trig) && disc.hovered()))
              w0_btn_colors(aura_theme(trig).palette, trigger_variant, hov).0
            }))
          let _ = face.box(fn(lbl_v : view::View) -> Unit {
            let _ = lbl_v
              .points(view::Live::Is(false))
              .words_centered(view::Live::Is(true))
              .words(
                view::Live::Is(trigger_label),
                look=view::WordsLook::{ ..c_words_look(fs, 500, lh), tracking: view::Spacing::Points(-0.15) },
              )
              .ink(view::Live::By(fn() -> Int64 {
                let hov = !disc.disabled() && (disc.pressed() || (!aura_is_coarse_pointer(trig) && disc.hovered()))
                w0_btn_colors(aura_theme(lbl_v).palette, trigger_variant, hov).1
              }))
          })
        })
      },
      disabled=disabled,
    )

    let root = host.tree.root()
    let portal_tie = root.show_scoped(
      fn() -> Bool { true },
      fn(portal : view::View) -> Unit {
        let _ = portal
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
          .points(view::Live::Is(false))
        c_inherit_aura_config(host, portal)

        pop.layer(
          portal,
          fn() -> String { match heading { Some(h) => h; None => trigger_label } },
          fn(layer_v : view::View, opener : Option[view::View]) -> Unit {
            let (b_side, b_along) = c_placement_to_beside(placement)
            let fallback_side = headless::placement_side(placement)

            let _ = layer_v
              .points(view::Live::Is(true))
              .width(view::Live::Is(Some(width)))
            match opener {
              Some(op) => {
                let _ = layer_v.beside(op.id(), side=b_side, along=b_along, offset=gap, padding=8.0)
              }
              None => {
                let _ = layer_v.over(view::Live::Is(true), edges=(Some(0.0), Some(gap), None, None))
              }
            }

            let shell = w0_popover_shell(
              layer_v,
              radius=24.0,
              pad=16.0,
              gap=4.0,
              content=fn(panel : view::View) -> Unit {
                match heading {
                  Some(h) => {
                    let _ = panel.box(fn(hv : view::View) -> Unit {
                      let _ = hv
                        .words(view::Live::Is(h), look=c_words_look(14.0, 500, 20.0))
                        .ink(view::Live::By(fn() -> Int64 { aura_theme(hv).palette.overlay_foreground }))
                    })
                  }
                  None => ()
                }
                content(panel)
              },
            )
            let _ = shell.width(view::Live::Is(Some(width)))

            if show_arrow {
              c_mount_arrow(
                layer_v,
                fn() -> headless::AnchorSide {
                  match layer_v.beside_side_told() {
                    Some(s) => c_beside_to_anchor_side(s)
                    None => fallback_side
                  }
                },
                offset=-6.0,
              )
            }
          },
        )
      },
      at_once=true,
    )
    portal_tie(host)
  })
}

/// Pion-JSX `<aura::Popover>` wrapper.
pub fn Popover(
  parent : view::View,
  trigger_label~ : String = "Popover",
  open~ : () -> Bool = fn() { false },
  set_open~ : (Bool) -> Unit = fn(_b : Bool) { () },
  heading? : String,
  trigger_variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  placement~ : headless::Placement = headless::Placement::BelowCenter,
  gap~ : Double = 10.0,
  width~ : Double = 280.0,
  show_arrow~ : Bool = true,
  disabled~ : () -> Bool = fn() { false },
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  popover_node(
    parent,
    trigger_label,
    open,
    set_open,
    children,
    heading?=heading,
    trigger_variant=trigger_variant,
    placement=placement,
    gap=gap,
    width=width,
    show_arrow=show_arrow,
    disabled=disabled,
    loc=loc,
  )
}

// ===========================================================================
// 21. Tooltip (1500ms open delay, 500ms close delay, optional arrow)
// ===========================================================================

/// Aura `Tooltip` (Builder API).
/// Wired to `headless::TooltipGroup` + `headless::tooltip_bubble` with default
/// `open_delay_ms = aura_tooltip_delay_ms` (1500ms) and `close_delay_ms = aura_tooltip_close_delay_ms` (500ms).
pub fn tooltip_node(
  parent : view::View,
  text : view::Live[String],
  trigger : (view::View) -> view::View,
  placement~ : headless::Placement = headless::Placement::AboveCenter,
  gap~ : Double = 8.0,
  show_arrow~ : Bool = true,
  open_delay_ms~ : Double = aura_tooltip_delay_ms,
  close_delay_ms~ : Double = aura_tooltip_close_delay_ms,
  force_open~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let text_get = text.to_getter()

  parent.box(loc=loc, fn(host : view::View) -> Unit {
    let root = host.tree.root()
    let (group, tip_key) = c_tooltip_group_for(root, open_delay_ms, close_delay_ms)
    let trig_v = trigger(host)
    group.trigger(trig_v, tip_key, disabled=disabled)

    let tie = root.show_scoped(
      fn() -> Bool { force_open || group.is_open(tip_key) },
      fn(mount : view::View) -> Unit {
        let _ = mount
          .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), Some(0.0), Some(0.0)))
          .points(view::Live::Is(false))
        c_inherit_aura_config(host, mount)

        let _ = mount.box(fn(placed_v : view::View) -> Unit {
          let (b_side, b_along) = c_placement_to_beside(placement)
          let fallback_side = headless::placement_side(placement)

          let _ = placed_v
            .points(view::Live::Is(false))
            .beside(trig_v.id(), side=b_side, along=b_along, offset=gap, padding=8.0)

          let _ = headless::tooltip_bubble(
            placed_v,
            text_get,
            fn(bub : view::View) -> Unit {
              let _ = bub
                .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(bub) }))
                .radius(view::Live::Is(12.0))
                .pad(view::Live::Is(8.0))
                .ground(view::Live::By(fn() -> Int64 { aura_theme(bub).palette.overlay }))
                .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                  aura_overlay_shadows(aura_theme(bub).config.dark)
                }))
                .points(view::Live::Is(false))
              w0_mount_dark_overlay_rim(bub, view::Live::Is(12.0))
              let _ = bub.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .points(view::Live::Is(false))
                  .words(text, look=c_words_look(12.0, 400, 16.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.overlay_foreground }))
              })
            },
          )

          if show_arrow {
            c_mount_arrow(
              placed_v,
              fn() -> headless::AnchorSide {
                match placed_v.beside_side_told() {
                  Some(s) => c_beside_to_anchor_side(s)
                  None => fallback_side
                }
              },
              offset=-5.0,
            )
          }
        })
      },
      at_once=true,
    )
    tie(trig_v)
  })
}

/// Pion-JSX `<aura::Tooltip>` wrapper.
pub fn Tooltip(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  trigger~ : (view::View) -> view::View = fn(v : view::View) { v },
  placement~ : headless::Placement = headless::Placement::AboveCenter,
  gap~ : Double = 8.0,
  show_arrow~ : Bool = true,
  open_delay_ms~ : Double = aura_tooltip_delay_ms,
  close_delay_ms~ : Double = aura_tooltip_close_delay_ms,
  force_open~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  tooltip_node(
    parent,
    t,
    trigger,
    placement=placement,
    gap=gap,
    show_arrow=show_arrow,
    open_delay_ms=open_delay_ms,
    close_delay_ms=close_delay_ms,
    force_open=force_open,
    disabled=disabled,
    loc=loc,
  )
}
