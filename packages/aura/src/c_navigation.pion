// Aura Track 1C — Navigation components (Builder + Pion-JSX):
// Tabs, Accordion, Disclosure, DisclosureGroup, Breadcrumbs, Pagination.

import "headless"
import "headless_core"
import "signals"
import "view"

fn c_words_look(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

fn c_with_alpha(rgba : Int64, alpha_byte : Int64) -> Int64 {
  ((rgba >> 8) << 8) | (alpha_byte & 0xFFL)
}

fn c_contains_key(keys : Array[String], key : String) -> Bool {
  for k in keys {
    if k == key {
      return true
    }
  }
  false
}

// ===========================================================================
// 1. Tabs (Primary pill slider & Secondary underline, Horizontal / Vertical)
// ===========================================================================

/// Visual variant for Aura `Tabs`.
#derive(Eq)
pub enum AuraTabsVariant {
  Primary
  Secondary
}

/// Tab descriptor for `tabs_node` / `Tabs`.
pub struct AuraTabItem {
  pub key : String
  pub label : String
  pub disabled : Bool
  pub panel : (view::View) -> Unit
}

/// Construct an `AuraTabItem`.
pub fn AuraTabItem::new(
  key : String,
  label : String,
  panel : (view::View) -> Unit,
  disabled~ : Bool = false,
) -> AuraTabItem {
  AuraTabItem::{ key, label, disabled, panel }
}

/// Aura `Tabs` (Builder API).
/// Supports `Primary` (segmented pill slider) and `Secondary` (accent underline),
/// `Horizontal` and `Vertical` orientations, wired to `headless::Tabs`.
pub fn tabs_node(
  parent : view::View,
  items : Array[AuraTabItem],
  selected : () -> String,
  on_select : (String) -> Unit,
  variant~ : AuraTabsVariant = AuraTabsVariant::Primary,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  label~ : String = "Tabs",
  disabled~ : () -> Bool = fn() { false },
  panel_gap~ : Double = 16.0,
  show_panels~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let axis = match orientation {
    AuraOrientation::Horizontal => headless::GroupAxis::Horizontal
    AuraOrientation::Vertical => headless::GroupAxis::Vertical
  }
  let is_horiz = orientation is AuraOrientation::Horizontal
  let is_primary = variant is AuraTabsVariant::Primary

  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let tabs = headless::Tabs::new(
      selected,
      on_select,
      axis=axis,
      rtl_by=fn() -> Bool { aura_rtl(root) },
      disabled=disabled,
    )
    let _ = root
      .row(view::Live::Is(!is_horiz))
      .fills_across(view::Live::Is(true))
      .gap(view::Live::Is(0.0))

    // Tab list container
    let _ = root.box(fn(container : view::View) -> Unit {
      let _ = container
        .fills_across(view::Live::Is(is_horiz))
        .corner_circular(view::Live::Is(true))
        .radius(view::Live::By(fn() -> Double {
          if is_primary { aura_theme(container).radius * 2.5 } else { 0.0 }
        }))
        .ground(view::Live::By(fn() -> Int64 {
          if is_primary { aura_theme(container).palette.default_bg } else { 0x00000000L }
        }))

      let _ = tabs.list(
        container,
        fn() -> String { label },
        fn(list_v : view::View, group : headless::RadioGroup[String]) -> Unit {
          let _ = list_v
            .fills_across(view::Live::Is(is_horiz))
            .pad(view::Live::Is(if is_primary { 4.0 } else { 0.0 }))
            .gap(view::Live::Is(if !is_horiz && is_primary { 4.0 } else { 0.0 }))
          if is_horiz {
            let _ = list_v.row_reverse(view::Live::By(fn() -> Bool { aura_rtl(list_v) }))
          } else {
            let _ = list_v.row(view::Live::Is(false))
          }

          let mut idx = 0
          for item in items {
            let item_key = item.key
            let item_label = item.label
            let item_dis = item.disabled
            let _item_idx = idx
            idx += 1
            let _ = group.item(
              list_v,
              fn() -> String { item_key },
              fn() -> String { item_label },
              fn(tab_v : view::View, ri : headless::RadioItem) -> Unit {
                let _ = tab_v
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .height(view::Live::Is(Some(if is_primary { 32.0 } else { 33.0 })))
                  .pad_xy(16.0, 0.0)
                  .corner_circular(view::Live::Is(true))
                  .radius(view::Live::Is(if is_primary { 16.0 } else { 0.0 }))
                  .ground(view::Live::By(fn() -> Int64 {
                    if is_primary && ri.chosen() {
                      aura_theme(tab_v).palette.segment
                    } else {
                      0x00000000L
                    }
                  }))
                  .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                    if is_primary && ri.chosen() {
                      aura_surface_shadows(aura_theme(tab_v).config.dark)
                    } else {
                      []
                    }
                  }))
                  .group_alpha(view::Live::By(fn() -> Double {
                    if ri.disabled() {
                      aura_theme(tab_v).disabled_opacity
                    } else if !ri.chosen() && !aura_is_coarse_pointer(tab_v) && ri.hovered() {
                      0.7
                    } else {
                      1.0
                    }
                  }))
                if is_horiz {
                  let _ = tab_v.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0)))
                } else {
                  let _ = tab_v.min_width(view::Live::Is(Some(80.0))).fills_across(view::Live::Is(true))
                }
                let _ = w0_apply_control_focus_ring(tab_v)

                // Secondary track border (bottom/left) painted underneath the active accent indicator
                if !is_primary {
                  let _ = tab_v.box(fn(track : view::View) -> Unit {
                    let _ = track.points(view::Live::Is(false))
                    if is_horiz {
                      let _ = track
                        .over(view::Live::Is(true), edges=(Some(0.0), None, Some(0.0), Some(0.0)))
                        .height(view::Live::Is(Some(1.0)))
                        .ground(view::Live::By(fn() -> Int64 { aura_theme(track).palette.border }))
                    } else {
                      let _ = track
                        .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                        .width(view::Live::Is(Some(1.0)))
                        .ground(view::Live::By(fn() -> Int64 { aura_theme(track).palette.border }))
                    }
                  })
                  let _ = tab_v.box(fn(ind : view::View) -> Unit {
                    let _ = ind.points(view::Live::Is(false))
                    if is_horiz {
                      let _ = ind
                        .over(view::Live::Is(true), edges=(Some(0.0), None, Some(0.0), Some(1.0)))
                        .height(view::Live::Is(Some(2.0)))
                        .ground(view::Live::By(fn() -> Int64 {
                          if ri.chosen() { aura_theme(ind).palette.accent } else { 0x00000000L }
                        }))
                    } else {
                      let _ = ind
                        .over(view::Live::Is(true), edges=(Some(0.0), Some(0.0), None, Some(0.0)))
                        .width(view::Live::Is(Some(2.0)))
                        .ground(view::Live::By(fn() -> Int64 {
                          if ri.chosen() { aura_theme(ind).palette.accent } else { 0x00000000L }
                        }))
                    }
                  })
                }

                // Tab label
                let _ = tab_v.box(fn(lbl_v : view::View) -> Unit {
                  if !is_primary && is_horiz {
                    let _ = lbl_v.margin(view::Live::Is((0.0, 0.0, 0.0, 1.0)))
                  }
                  let tab_look = c_words_look(14.0, 500, 20.0)
                  let _ = lbl_v
                    .points(view::Live::Is(false))
                    .words_centered(view::Live::Is(true))
                    .words(
                      view::Live::Is(item_label),
                      look=tab_look,
                    )
                    .words_look(view::Live::By(fn() -> view::WordsLook { tab_look.with_rtl(aura_rtl(lbl_v)) }))
                    .ink(view::Live::By(fn() -> Int64 {
                      let pal = aura_theme(lbl_v).palette
                      if ri.chosen() {
                        if is_primary { pal.segment_foreground } else { pal.foreground }
                      } else {
                        pal.muted
                      }
                    }))
                })
              },
              disabled=fn() -> Bool { item_dis || disabled() },
            )
          }
        },
      )
    })

    // Tab panels: inactive panels occupy 0pt in flow (padding/margin applied only when selected)
    if show_panels {
      for item in items {
        let item_key = item.key
        let item_label = item.label
        let item_panel = item.panel
        let _ = tabs.panel(
          root,
          item_key,
          fn() -> String { item_label },
          fn(pv : view::View, tp : headless::TabPanel) -> Unit {
            let _ = pv
              .fills_across(view::Live::Is(is_horiz))
              .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                if tp.selected() { (8.0, 8.0, 8.0, 8.0) } else { (0.0, 0.0, 0.0, 0.0) }
              }))
              .margin(view::Live::By(fn() -> (Double, Double, Double, Double) {
                if tp.selected() {
                  if is_horiz { (0.0, panel_gap, 0.0, 0.0) } else { (panel_gap, 0.0, 0.0, 0.0) }
                } else {
                  (0.0, 0.0, 0.0, 0.0)
                }
              }))
          },
          item_panel,
        )
      }
    }
  })
}

/// Pion-JSX `<aura::Tabs>` wrapper.
pub fn Tabs(
  parent : view::View,
  items~ : Array[AuraTabItem] = [],
  selected~ : () -> String = fn() { "" },
  on_select~ : (String) -> Unit = fn(_k : String) { () },
  variant~ : AuraTabsVariant = AuraTabsVariant::Primary,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  label~ : String = "Tabs",
  disabled~ : () -> Bool = fn() { false },
  panel_gap~ : Double = 16.0,
  show_panels~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  tabs_node(
    parent,
    items,
    selected,
    on_select,
    variant=variant,
    orientation=orientation,
    label=label,
    disabled=disabled,
    panel_gap=panel_gap,
    show_panels=show_panels,
    loc=loc,
  )
}

// ===========================================================================
// 2. Accordion (Default & Surface variants, centralized expanded_keys)
// ===========================================================================

/// Visual variant for Aura `Accordion`.
#derive(Eq)
pub enum AuraAccordionVariant {
  Default
  Surface
}

/// Item descriptor for `accordion_node` / `Accordion`.
pub struct AuraAccordionItem {
  pub key : String
  pub title : String
  pub disabled : Bool
  pub body : (view::View) -> Unit
}

/// Construct an `AuraAccordionItem`.
pub fn AuraAccordionItem::new(
  key : String,
  title : String,
  body : (view::View) -> Unit,
  disabled~ : Bool = false,
) -> AuraAccordionItem {
  AuraAccordionItem::{ key, title, disabled, body }
}

/// Aura `Accordion` (Builder API).
/// Wired to `headless::accordion` with centralized `expanded_keys` and chevron rotation.
pub fn accordion_node(
  parent : view::View,
  items : Array[AuraAccordionItem],
  expanded_keys : () -> Array[String],
  on_toggle : (String) -> Unit,
  variant~ : AuraAccordionVariant = AuraAccordionVariant::Default,
  multiple~ : Bool = false,
  hide_separator~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let is_surface = variant is AuraAccordionVariant::Surface
  let kind = if multiple {
    headless::AccordionKind::Multiple
  } else {
    headless::AccordionKind::Single(true)
  }

  headless::accordion(
    parent,
    fn(k : String) -> Bool { c_contains_key(expanded_keys(), k) },
    on_toggle,
    fn(root : view::View, acc : headless::Accordion[String]) -> Unit {
      let _ = root
        .fills_across(view::Live::Is(true))
        .corner_circular(view::Live::Is(true))
        .radius(view::Live::Is(if is_surface { 24.0 } else { 0.0 }))
        .ground(view::Live::By(fn() -> Int64 {
          if is_surface { aura_theme(root).palette.surface } else { 0x00000000L }
        }))
        .shadows(view::Live::By(fn() -> Array[view::Shadow] {
          if is_surface { aura_surface_shadows(aura_theme(root).config.dark) } else { [] }
        }))
      if is_surface {
        let _ = aura_provide_surface_by(root, fn() -> AuraSurfaceLevel { AuraSurfaceLevel::Primary })
      }

      let n = items.length()
      let mut idx = 0
      for item in items {
        let item_key = item.key
        let item_title = item.title
        let item_dis = item.disabled
        let item_body = item.body
        let is_first = idx == 0
        let is_last = idx == n - 1
        idx += 1

        let _ = root.box(fn(item_box : view::View) -> Unit {
          let _ = item_box.fills_across(view::Live::Is(true))

          // Trigger button
          let _ = acc.trigger(
            item_box,
            item_key,
            fn() -> String { item_title },
            fn(trig : view::View, disc : headless::Disclosure) -> Unit {
              let _ = trig
                .row(view::Live::Is(true))
                .fills_across(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Between))
                .pad_xy(16.0, 16.0)
                .corner_circular(view::Live::Is(true))
                .ground(view::Live::By(fn() -> Int64 {
                  if disc.open() || disc.disabled() || aura_is_coarse_pointer(trig) || !disc.hovered() {
                    0x00000000L
                  } else if is_surface {
                    aura_theme(trig).palette.default_bg
                  } else {
                    c_with_alpha(aura_theme(trig).palette.foreground, 0x08L)
                  }
                }))
                .group_alpha(view::Live::By(fn() -> Double {
                  if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
                }))
              if is_surface && is_first {
                let _ = trig.corners(view::Live::Is(Some((24.0, 24.0, 0.0, 0.0))))
              } else if is_surface && is_last {
                let _ = trig.corners(view::Live::By(fn() -> Option[(Double, Double, Double, Double)] {
                  if disc.open() { None } else { Some((0.0, 0.0, 24.0, 24.0)) }
                }))
              }
              let _ = w0_apply_control_focus_ring(trig)

              let _ = trig.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .points(view::Live::Is(false))
                  .words(view::Live::Is(item_title), look=c_words_look(14.0, 500, 20.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.foreground }))
              })

              // Chevron indicator (rotates 180 deg when expanded: ChevronDown -> ChevronUp)
              let _ = trig.box(fn(ind_v : view::View) -> Unit {
                let _ = ind_v
                  .width(view::Live::Is(Some(16.0)))
                  .height(view::Live::Is(Some(16.0)))
                  .shrink(view::Live::Is(0.0))
                  .points(view::Live::Is(false))
                  .shapes(view::Live::By(fn() -> Array[paint::Shape] {
                    let k = if disc.open() { AuraIconKind::ChevronUp } else { AuraIconKind::ChevronDown }
                    aura_icon_shapes(k, 16.0, 0x010101FFL)
                  }))
                  .tint(view::Live::By(fn() -> Int64 { aura_theme(ind_v).palette.muted }))
              })
            },
            disabled=fn() -> Bool { item_dis || disabled() },
          )

          // Collapsible panel
          let _ = acc.panel(
            item_box,
            item_key,
            fn() -> String { item_title },
            fn(pv : view::View) -> Unit {
              let _ = pv
                .fills_across(view::Live::Is(true))
                .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                  if acc.is_open(item_key) {
                    (16.0, 0.0, 16.0, 16.0)
                  } else {
                    (0.0, 0.0, 0.0, 0.0)
                  }
                }))
              let _ = pv.box(fn(body_box : view::View) -> Unit {
                let _ = body_box.fills_across(view::Live::Is(true))
                item_body(body_box)
              })
            },
          )

          // Bottom separator (absolute at bottom like CSS ::after so it adds 0 layout height)
          if !hide_separator && !is_last {
            let _ = item_box.box(fn(line : view::View) -> Unit {
              let inset = if is_surface { 16.0 } else { 0.0 }
              let _ = line
                .over(view::Live::Is(true), edges=(Some(inset), None, Some(inset), Some(0.0)))
                .height(view::Live::Is(Some(1.0)))
                .points(view::Live::Is(false))
                .ground(view::Live::By(fn() -> Int64 {
                  let pal = aura_theme(line).palette
                  if is_surface {
                    c_with_alpha(pal.surface_foreground, 0x0FL)
                  } else {
                    pal.separator
                  }
                }))
            })
          }
        })
      }
    },
    kind=kind,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Accordion>` wrapper.
pub fn Accordion(
  parent : view::View,
  items~ : Array[AuraAccordionItem] = [],
  expanded_keys~ : () -> Array[String] = fn() { [] },
  on_toggle~ : (String) -> Unit = fn(_k : String) { () },
  variant~ : AuraAccordionVariant = AuraAccordionVariant::Default,
  multiple~ : Bool = false,
  hide_separator~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  accordion_node(
    parent,
    items,
    expanded_keys,
    on_toggle,
    variant=variant,
    multiple=multiple,
    hide_separator=hide_separator,
    disabled=disabled,
    loc=loc,
  )
}

// ===========================================================================
// 3. Disclosure & 4. DisclosureGroup
// ===========================================================================

/// Aura `Disclosure` (Builder API). Wired to `headless::disclosure`.
pub fn disclosure_node(
  parent : view::View,
  heading : view::Live[String],
  open : () -> Bool,
  on_toggle : () -> Unit,
  content : (view::View) -> Unit,
  disabled~ : () -> Bool = fn() { false },
  show_indicator~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let heading_get = heading.to_getter()
  parent.box(loc=loc, fn(root : view::View) -> Unit {
    let _ = root.fills_across(view::Live::Is(true))
    let _ = headless::disclosure(
      root,
      heading_get,
      open,
      fn(_v : view::View) -> Unit { on_toggle() },
      fn(trig : view::View, disc : headless::Disclosure) -> Unit {
        let _ = trig
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
          .corner_circular(view::Live::Is(true))
          .radius(view::Live::Is(8.0))
          .group_alpha(view::Live::By(fn() -> Double {
            if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
          }))
        let _ = w0_apply_control_focus_ring(trig)
        let _ = trig.box(fn(lbl_v : view::View) -> Unit {
          let _ = lbl_v
            .points(view::Live::Is(false))
            .words(heading, look=c_words_look(16.0, 400, 24.0))
            .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl_v).palette.foreground }))
        })
        if show_indicator {
          let _ = trig.box(fn(ind_v : view::View) -> Unit {
            let _ = ind_v
              .width(view::Live::Is(Some(16.0)))
              .height(view::Live::Is(Some(16.0)))
              .shrink(view::Live::Is(0.0))
              .points(view::Live::Is(false))
              .shapes(view::Live::By(fn() -> Array[paint::Shape] {
                let k = if disc.open() { AuraIconKind::ChevronUp } else { AuraIconKind::ChevronDown }
                aura_icon_shapes(k, 16.0, 0x010101FFL)
              }))
              .tint(view::Live::By(fn() -> Int64 { aura_theme(ind_v).palette.foreground }))
          })
        }
      },
      disabled=disabled,
    )
    let _ = root.show(open, fn(panel_v : view::View) -> Unit {
      let _ = panel_v.fills_across(view::Live::Is(true)).pad(view::Live::Is(8.0))
      let _ = panel_v.box(fn(body_v : view::View) -> Unit {
        let _ = body_v.fills_across(view::Live::Is(true))
        content(body_v)
      })
    })
  })
}

/// Pion-JSX `<aura::Disclosure>` wrapper.
pub fn Disclosure(
  parent : view::View,
  into heading~ : view::Live[String] = .Is(""),
  heading_by? : () -> String,
  open~ : () -> Bool = fn() { false },
  on_toggle~ : () -> Unit = fn() { () },
  disabled~ : () -> Bool = fn() { false },
  show_indicator~ : Bool = true,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let h = match heading_by { Some(f) => view::Live::By(f); None => heading }
  disclosure_node(
    parent,
    h,
    open,
    on_toggle,
    children,
    disabled=disabled,
    show_indicator=show_indicator,
    loc=loc,
  )
}

/// Aura `DisclosureGroup` (Builder API). Wired to `headless::accordion`.
pub fn disclosure_group_node(
  parent : view::View,
  items : Array[AuraAccordionItem],
  expanded_keys : () -> Array[String],
  on_toggle : (String) -> Unit,
  multiple~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  let kind = if multiple {
    headless::AccordionKind::Multiple
  } else {
    headless::AccordionKind::Single(true)
  }
  headless::accordion(
    parent,
    fn(k : String) -> Bool { c_contains_key(expanded_keys(), k) },
    on_toggle,
    fn(root : view::View, acc : headless::Accordion[String]) -> Unit {
      let _ = root.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
      for item in items {
        let item_key = item.key
        let item_title = item.title
        let item_dis = item.disabled
        let item_body = item.body
        let _ = root.box(fn(slot : view::View) -> Unit {
          let _ = slot.fills_across(view::Live::Is(true))
          let _ = acc.trigger(
            slot,
            item_key,
            fn() -> String { item_title },
            fn(trig : view::View, disc : headless::Disclosure) -> Unit {
              let _ = trig
                .row(view::Live::Is(true))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(8.0))
                .pad_xy(4.0, 6.0)
                .corner_circular(view::Live::Is(true))
                .radius(view::Live::Is(8.0))
                .group_alpha(view::Live::By(fn() -> Double {
                  if disc.disabled() { aura_theme(trig).disabled_opacity } else { 1.0 }
                }))
              let _ = w0_apply_control_focus_ring(trig)
              let _ = trig.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .points(view::Live::Is(false))
                  .words(view::Live::Is(item_title), look=c_words_look(14.0, 500, 20.0))
                  .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.foreground }))
              })
              let _ = trig.box(fn(ind_v : view::View) -> Unit {
                let _ = ind_v
                  .width(view::Live::Is(Some(16.0)))
                  .height(view::Live::Is(Some(16.0)))
                  .shrink(view::Live::Is(0.0))
                  .points(view::Live::Is(false))
                  .shapes(view::Live::By(fn() -> Array[paint::Shape] {
                    let k = if disc.open() { AuraIconKind::ChevronUp } else { AuraIconKind::ChevronDown }
                    aura_icon_shapes(k, 16.0, 0x010101FFL)
                  }))
                  .tint(view::Live::By(fn() -> Int64 { aura_theme(ind_v).palette.muted }))
              })
            },
            disabled=fn() -> Bool { item_dis || disabled() },
          )
          let _ = acc.panel(
            slot,
            item_key,
            fn() -> String { item_title },
            fn(pv : view::View) -> Unit {
              let _ = pv.fills_across(view::Live::Is(true)).pad(view::Live::Is(8.0))
              item_body(pv)
            },
          )
        })
      }
    },
    kind=kind,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::DisclosureGroup>` wrapper.
pub fn DisclosureGroup(
  parent : view::View,
  items~ : Array[AuraAccordionItem] = [],
  expanded_keys~ : () -> Array[String] = fn() { [] },
  on_toggle~ : (String) -> Unit = fn(_k : String) { () },
  multiple~ : Bool = false,
  disabled~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  disclosure_group_node(
    parent,
    items,
    expanded_keys,
    on_toggle,
    multiple=multiple,
    disabled=disabled,
    loc=loc,
  )
}

// ===========================================================================
// 5. Breadcrumbs (aria-current="page" on last item)
// ===========================================================================

/// Item descriptor for `breadcrumbs_node` / `Breadcrumbs`.
pub struct AuraBreadcrumbItem {
  pub label : String
  pub on_press : () -> Unit
  pub disabled : Bool
}

/// Construct an `AuraBreadcrumbItem`.
pub fn AuraBreadcrumbItem::new(
  label : String,
  on_press~ : () -> Unit = fn() { () },
  disabled~ : Bool = false,
) -> AuraBreadcrumbItem {
  AuraBreadcrumbItem::{ label, on_press, disabled }
}

/// Aura `Breadcrumbs` (Builder API). Wired to `headless::breadcrumbs` (`aria-current="page"` on last item).
pub fn breadcrumbs_node(
  parent : view::View,
  items : Array[AuraBreadcrumbItem],
  label~ : String = "Breadcrumb",
  loc~ : String = "",
) -> view::View {
  let count = items.length()
  headless::breadcrumbs(
    parent,
    fn() -> Int { count },
    fn(nav : view::View, bc : headless::Breadcrumbs) -> Unit {
      let is_rtl = aura_rtl(nav)
      let _ = nav
        .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(nav) }))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(5.5))
        .margin(view::Live::By(fn() -> (Double, Double, Double, Double) {
          if aura_rtl(nav) { (0.0, 0.0, -1.5, 0.0) } else { (0.0, 0.0, 0.0, 0.0) }
        }))

      let mut idx = 0
      for item in items {
        let item_idx = idx
        let item_label = item.label
        let item_press = item.on_press
        let item_dis = item.disabled
        let is_last = item_idx == count - 1
        idx += 1

        let _ = nav.box(fn(wrap : view::View) -> Unit {
          let _ = wrap
            .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(wrap) }))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(3.5))
          let _ = bc.item(
            wrap,
            item_idx,
            fn() -> String { item_label },
            fn(_v : view::View) -> Unit { item_press() },
            fn(link_v : view::View, is_current : () -> Bool) -> Unit {
              let bc_look = c_words_look(14.0, 500, 20.0)
              let _ = link_v
                .corner_circular(view::Live::Is(true))
                .radius(view::Live::Is(4.0))
                .words(view::Live::Is(item_label), look=bc_look)
                .words_look(view::Live::By(fn() -> view::WordsLook { bc_look.with_rtl(aura_rtl(link_v)) }))
                .ink(view::Live::By(fn() -> Int64 {
                  let pal = aura_theme(link_v).palette
                  if is_current() { pal.link } else { pal.muted }
                }))
                .group_alpha(view::Live::By(fn() -> Double {
                  if item_dis { aura_theme(link_v).disabled_opacity } else { 1.0 }
                }))
              let _ = w0_apply_control_focus_ring(link_v)
            },
            disabled=fn() -> Bool { item_dis },
          )
          if !is_last {
            let _ = aura_icon_node(
              wrap,
              if is_rtl { AuraIconKind::ChevronLeft } else { AuraIconKind::ChevronRight },
              size=12.0,
              ink=fn() -> Int64 { aura_theme(wrap).palette.muted },
            )
          }
        })
      }
    },
    label=fn() -> String { label },
    loc=loc,
  )
}

/// Pion-JSX `<aura::Breadcrumbs>` wrapper.
pub fn Breadcrumbs(
  parent : view::View,
  items~ : Array[AuraBreadcrumbItem] = [],
  label~ : String = "Breadcrumb",
  loc~ : String = "",
) -> view::View {
  breadcrumbs_node(parent, items, label=label, loc=loc)
}

// ===========================================================================
// 6. Pagination (Prev/Next, page pills, ellipsis)
// ===========================================================================

/// Size variant for Aura `Pagination`.
#derive(Eq)
pub enum AuraPaginationSize {
  Sm
  Md
  Lg
}

fn c_pag_metrics(size : AuraPaginationSize, is_md : Bool) -> (Double, Double, Double, Double) {
  // Returns (box_dim, font_size, line_height, press_scale)
  match size {
    AuraPaginationSize::Sm => (if is_md { 28.0 } else { 32.0 }, 12.0, 16.0, aura_button_press_scale_sm)
    AuraPaginationSize::Md => (if is_md { 32.0 } else { 36.0 }, 14.0, 20.0, aura_button_press_scale)
    AuraPaginationSize::Lg => (if is_md { 36.0 } else { 40.0 }, 16.0, 24.0, aura_button_press_scale_lg)
  }
}

/// Compute Aura / HeroUI standard pagination token IDs:
/// positive integer `p` = page button `p`, `-1` = left ellipsis, `-2` = right ellipsis.
/// For default `siblings=1, boundaries=1` and `total=9`:
/// - `current <= 2`: `1 2 3 … 9`
/// - `current >= N-1`: `1 … N-2 N-1 N`
/// - middle: `1 … c-1 c c+1 … N` (omitting ellipsis when adjacent to boundary)
fn c_pagination_token_ids(total : Int, current : Int, siblings : Int, boundaries : Int) -> Array[Int] {
  let out : Array[Int] = []
  if total <= 0 {
    return out
  }
  let cur = if current < 1 { 1 } else if current > total { total } else { current }
  let sib = if siblings < 0 { 0 } else { siblings }
  let bnd = if boundaries < 0 { 0 } else { boundaries }

  let full_limit = bnd * 2 + sib * 2 + 1
  if total <= full_limit {
    let mut p = 1
    while p <= total {
      out.push(p)
      p += 1
    }
    return out
  }

  let mut win_start = cur - sib
  if win_start < bnd + 1 {
    win_start = bnd + 1
  }
  let mut win_end = cur + sib
  if win_end > total - bnd {
    win_end = total - bnd
  }

  if cur <= bnd + sib {
    let min_right = bnd + sib + 1
    if win_end < min_right {
      win_end = min_right
    }
    if win_end > total - bnd {
      win_end = total - bnd
    }
  }
  if cur >= total - bnd - sib + 1 {
    let max_left = total - bnd - sib
    if win_start > max_left {
      win_start = max_left
    }
    if win_start < bnd + 1 {
      win_start = bnd + 1
    }
  }

  // Left boundary
  let mut p = 1
  while p <= bnd && p <= total {
    out.push(p)
    p += 1
  }

  // Left ellipsis
  if win_start > bnd + 1 {
    out.push(-1)
  }

  // Center window
  let mut m = win_start
  while m <= win_end {
    out.push(m)
    m += 1
  }

  // Right ellipsis
  if win_end < total - bnd {
    out.push(-2)
  }

  // Right boundary
  let mut r = total - bnd + 1
  if r <= win_end {
    r = win_end + 1
  }
  while r <= total {
    out.push(r)
    r += 1
  }
  out
}

/// Aura `Pagination` (Builder API).
/// Wired to `headless::pagination` with Prev/Next controls, pill page buttons, and ellipsis.
pub fn pagination_node(
  parent : view::View,
  total : () -> Int,
  current : () -> Int,
  on_change : (Int) -> Unit,
  size~ : AuraPaginationSize = AuraPaginationSize::Md,
  siblings~ : Int = 1,
  boundaries~ : Int = 1,
  disabled~ : () -> Bool = fn() { false },
  label~ : String = "Pagination",
  summary? : () -> String,
  loc~ : String = "",
) -> view::View {
  headless::pagination(
    parent,
    total,
    current,
    on_change,
    fn(nav : view::View, pg : headless::Pagination) -> Unit {
      let _ = nav
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .gap(view::Live::Is(16.0))

      match summary {
        Some(sum_fn) => {
          let (_, fs, lh, _) = c_pag_metrics(size, true)
          let _ = nav
            .words(view::Live::By(sum_fn), look=c_words_look(fs, 400, lh))
            .ink(view::Live::By(fn() -> Int64 { aura_theme(nav).palette.muted }))
        }
        None => ()
      }

      let _ = nav.box(fn(content : view::View) -> Unit {
        let _ = content
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(4.0))

        // Previous button
        let _ = pg.prev_button(
          content,
          fn(btn : view::View, b : headless::Button) -> Unit {
            let _ = btn
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .width(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0 + 4.0) }))
              .height(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0) }))
              .shrink(view::Live::Is(0.0))
              .corner_circular(view::Live::Is(true))
              .radius(view::Live::By(fn() -> Double { c_pag_metrics(size, aura_is_md(btn)).0 * 0.5 }))
              .ground(view::Live::By(fn() -> Int64 {
                if !b.disabled() && (b.pressed() || (!aura_is_coarse_pointer(btn) && b.hovered())) {
                  aura_theme(btn).palette.default_hover
                } else {
                  0x00000000L
                }
              }))
              .group_alpha(view::Live::By(fn() -> Double {
                if b.disabled() { aura_theme(btn).disabled_opacity } else { 1.0 }
              }))
            let _ = w0_apply_control_focus_ring(btn)
            let _ = aura_icon_node(
              btn,
              AuraIconKind::ChevronLeft,
              size=16.0,
              ink=fn() -> Int64 { aura_theme(btn).palette.default_foreground },
            )
          },
        )

        // Page buttons and ellipses (reactive to total/current changes via View::each)
        let _ = content.box(fn(pages_row : view::View) -> Unit {
          let _ = pages_row
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(4.0))
          pages_row.each(
            fn() -> Array[Int] { c_pagination_token_ids(total(), current(), siblings, boundaries) },
            fn(tok : Int) -> Int { tok },
            fn(slot : view::View, tok_sig : signals::Signal[Int]) -> Unit {
              let tok = tok_sig.get()
              let (_, fs, lh, _) = c_pag_metrics(size, true)
              if tok > 0 {
                let page_num = tok
                let _ = pg.page_button(
                  slot,
                  page_num,
                  fn(btn : view::View, is_active : () -> Bool) -> Unit {
                    let _ = btn
                      .row(view::Live::Is(true))
                      .lines_up(view::Live::Is(Some(view::Along::Middle)))
                      .lies_along(view::Live::Is(view::Lies::Middle))
                      .width(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0) }))
                      .height(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0) }))
                      .shrink(view::Live::Is(0.0))
                      .corner_circular(view::Live::Is(true))
                      .radius(view::Live::By(fn() -> Double { c_pag_metrics(size, aura_is_md(btn)).0 * 0.5 }))
                      .ground(view::Live::By(fn() -> Int64 {
                        let pal = aura_theme(btn).palette
                        if !disabled() && (btn.pressed() || (!aura_is_coarse_pointer(btn) && btn.pointed())) {
                          pal.default_hover
                        } else if is_active() {
                          pal.default_bg
                        } else {
                          0x00000000L
                        }
                      }))
                      .group_alpha(view::Live::By(fn() -> Double {
                        if disabled() { aura_theme(btn).disabled_opacity } else { 1.0 }
                      }))
                    let _ = w0_apply_control_focus_ring(btn)
                    let _ = btn.box(fn(lbl_v : view::View) -> Unit {
                      let _ = lbl_v
                        .points(view::Live::Is(false))
                        .words_centered(view::Live::Is(true))
                        .words(view::Live::Is("\{page_num}"), look=c_words_look(fs, 500, lh))
                        .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl_v).palette.default_foreground }))
                    })
                  },
                  in_node=true,
                )
              } else {
                let _ = slot
                  .row(view::Live::Is(true))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .width(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(slot)).0) }))
                  .height(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(slot)).0) }))
                  .shrink(view::Live::Is(0.0))
                  .points(view::Live::Is(false))
                let _ = slot.box(fn(tv : view::View) -> Unit {
                  let _ = tv
                    .points(view::Live::Is(false))
                    .words_centered(view::Live::Is(true))
                    .words(view::Live::Is("..."), look=c_words_look(fs, 400, lh))
                    .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.muted }))
                })
              }
            },
            at_once=true,
          )
        })

        // Next button
        let _ = pg.next_button(
          content,
          fn(btn : view::View, b : headless::Button) -> Unit {
            let _ = btn
              .row(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .lies_along(view::Live::Is(view::Lies::Middle))
              .width(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0 + 4.0) }))
              .height(view::Live::By(fn() -> Option[Double] { Some(c_pag_metrics(size, aura_is_md(btn)).0) }))
              .shrink(view::Live::Is(0.0))
              .corner_circular(view::Live::Is(true))
              .radius(view::Live::By(fn() -> Double { c_pag_metrics(size, aura_is_md(btn)).0 * 0.5 }))
              .ground(view::Live::By(fn() -> Int64 {
                if !b.disabled() && (b.pressed() || (!aura_is_coarse_pointer(btn) && b.hovered())) {
                  aura_theme(btn).palette.default_hover
                } else {
                  0x00000000L
                }
              }))
              .group_alpha(view::Live::By(fn() -> Double {
                if b.disabled() { aura_theme(btn).disabled_opacity } else { 1.0 }
              }))
            let _ = w0_apply_control_focus_ring(btn)
            let _ = aura_icon_node(
              btn,
              AuraIconKind::ChevronRight,
              size=16.0,
              ink=fn() -> Int64 { aura_theme(btn).palette.default_foreground },
            )
          },
        )
      })
    },
    label=fn() -> String { label },
    siblings=siblings,
    boundaries=boundaries,
    disabled=disabled,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Pagination>` wrapper.
pub fn Pagination(
  parent : view::View,
  total~ : () -> Int = fn() { 1 },
  current~ : () -> Int = fn() { 1 },
  on_change~ : (Int) -> Unit = fn(_p : Int) { () },
  size~ : AuraPaginationSize = AuraPaginationSize::Md,
  siblings~ : Int = 1,
  boundaries~ : Int = 1,
  disabled~ : () -> Bool = fn() { false },
  label~ : String = "Pagination",
  summary? : () -> String,
  loc~ : String = "",
) -> view::View {
  pagination_node(
    parent,
    total,
    current,
    on_change,
    size=size,
    siblings=siblings,
    boundaries=boundaries,
    disabled=disabled,
    label=label,
    summary?=summary,
    loc=loc,
  )
}
