// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Toolbar backed 100% by `headless::toolbar`
// with horizontal/vertical arrow-key roving focus and optional attached surface bar styling.

import "headless"
import "view"

/// Handle passed to `toolbar_node` / `Toolbar` to register buttons, toggles, and separators
/// into `headless::Toolbar` roving focus.
pub struct AuraToolbar {
  inner : headless::Toolbar
  orientation : AuraOrientation
  off : () -> Bool
}

/// The underlying toolbar container node.
pub fn AuraToolbar::node(self : AuraToolbar) -> view::View {
  self.inner.node()
}

/// Whether the toolbar is disabled.
pub fn AuraToolbar::disabled(self : AuraToolbar) -> Bool {
  self.inner.disabled()
}

/// Focus the toolbar's current roving tab stop.
pub fn AuraToolbar::focus_stop(self : AuraToolbar, visible~ : Bool = true) -> Bool {
  self.inner.focus_stop(visible=visible)
}

/// Register any focusable child control (e.g. `button_node`, `toggle_button_node`, `link_node`)
/// into this toolbar's keyboard roving focus ring.
pub fn AuraToolbar::join(
  self : AuraToolbar,
  v : view::View,
  disabled~ : () -> Bool = fn() { false },
  preferred~ : () -> Bool = fn() { false },
) -> Unit {
  self.inner.join(v, disabled=disabled, preferred=preferred)
}

/// Mount an Aura `Button` inside this toolbar and automatically join it to roving focus.
pub fn AuraToolbar::button(
  self : AuraToolbar,
  parent : view::View,
  label : view::Live[String],
  on_press~ : () -> Unit = fn() { () },
  variant~ : AuraButtonVariant = AuraButtonVariant::Secondary,
  size~ : AuraButtonSize = AuraButtonSize::Sm,
  icon_only~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let dis_get = disabled.to_getter()
  let tb_off = self.off
  let eff_dis = view::Live::By(fn() -> Bool { tb_off() || dis_get() })
  let b = button_node(
    parent,
    label,
    on_press=on_press,
    variant=variant,
    size=size,
    icon_only=icon_only,
    disabled=eff_dis,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    content?=content,
    loc=loc,
  )
  self.inner.join(b, disabled=dis_get)
  b
}

/// Mount a toolbar separator oriented perpendicular to the toolbar axis (`h-1/2` vertical or `w-1/2` horizontal).
pub fn AuraToolbar::separator(
  self : AuraToolbar,
  parent : view::View,
  span~ : Double = 16.0,
  variant~ : AuraSeparatorVariant = AuraSeparatorVariant::Default,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(sep : view::View) -> Unit {
    let _ = sep
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .corner_circular(view::Live::Is(true))
      .radius(view::Live::Is(0.5))
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura_theme(sep).palette
        match variant {
          AuraSeparatorVariant::Default => pal.separator
          AuraSeparatorVariant::Secondary => pal.separator_secondary
          AuraSeparatorVariant::Tertiary => pal.separator_tertiary
        }
      }))
    match self.orientation {
      AuraOrientation::Horizontal => {
        let _ = sep.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(span)))
      }
      AuraOrientation::Vertical => {
        let _ = sep.width(view::Live::Is(Some(span))).height(view::Live::Is(Some(1.0)))
      }
    }
  })
}

/// Aura `Toolbar` (Builder API), 100% wired to `headless::toolbar`.
/// Supports horizontal/vertical arrow-key roving focus, `attached` floating pill container style
/// (`rounded-3xl bg-surface p-1 shadow-overlay`), and customizable gap (default `8pt`).
pub fn toolbar_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is("Toolbar"),
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  attached~ : Bool = false,
  gap~ : Double = 8.0,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  content~ : (view::View, AuraToolbar) -> Unit = fn(_v : view::View, _tb : AuraToolbar) { () },
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let dis_get = disabled.to_getter()
  let axis = match orientation {
    AuraOrientation::Horizontal => headless::GroupAxis::Horizontal
    AuraOrientation::Vertical => headless::GroupAxis::Vertical
  }
  headless::toolbar(
    parent,
    lbl_get,
    fn(node : view::View, tb : headless::Toolbar) -> Unit {
      let is_h = orientation is AuraOrientation::Horizontal
      let _ = node
        .row(view::Live::Is(is_h))
        .lines_up(view::Live::Is(Some(if is_h { view::Along::Middle } else { view::Along::Start })))
        .lies_along(view::Live::Is(view::Lies::Start))
        .gap(view::Live::Is(gap))
      if attached {
        let _ = node
          .pad(view::Live::Is(4.0))
          .corner_circular(view::Live::Is(true))
          .radius(view::Live::By(fn() -> Double { aura_theme(node).card_radius }))
          .ground(view::Live::By(fn() -> Int64 { aura_theme(node).palette.surface }))
          .shadows(view::Live::By(fn() -> Array[view::Shadow] {
            aura_overlay_shadows(aura_theme(node).config.dark)
          }))
      }
      content(node, AuraToolbar::{ inner: tb, orientation, off: dis_get })
    },
    axis=axis,
    wraps=wraps,
    rtl=rtl,
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Toolbar>` wrapper.
pub fn Toolbar(
  parent : view::View,
  into label~ : view::Live[String] = .Is("Toolbar"),
  label_by? : () -> String,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  attached~ : Bool = false,
  gap~ : Double = 8.0,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  render~ : (view::View, AuraToolbar) -> Unit = fn(_v : view::View, _tb : AuraToolbar) { () },
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  toolbar_node(
    parent,
    label=lbl,
    orientation=orientation,
    attached=attached,
    gap=gap,
    wraps=wraps,
    rtl=rtl,
    disabled=dis,
    content=render,
    loc=loc,
  )
}
