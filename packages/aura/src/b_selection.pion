// Track 1B selection controls & groups:
// Checkbox, CheckboxGroup, Radio, RadioGroup, Switch (1.375:1 elliptical thumb + 3-layer shadow + press stretch), SwitchGroup.

import "headless"
import "headless_core"
import "motion"
import "paint"
import "signals"
import "view"

fn b_clamp01(x : Double) -> Double {
  if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
}

// ---------------------------------------------------------------------------
// 10 & 11. Checkbox (`checkbox_node` / `Checkbox`) & CheckboxGroup
// ---------------------------------------------------------------------------

struct BCheckboxGroupCtx {
  selected_get : () -> Array[String]
  toggle_key : (String) -> Unit
  disabled_get : () -> Bool
  invalid_get : () -> Bool
  variant : AuraFieldVariant
}

let b_checkbox_group_lent : view::Lent[BCheckboxGroupCtx] = view::Lent::new()

fn b_array_contains_str(arr : Array[String], key : String) -> Bool {
  for s in arr {
    if s == key {
      return true
    }
  }
  false
}

/// Aura `Checkbox` control with vector checkmark / indeterminate stroke (`paint::subline`) and `w0_apply_control_focus_ring`.
/// Works standalone or inside `CheckboxGroup` (when `value != ""`).
pub fn checkbox_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is(""),
  value~ : String = "",
  checked~ : view::Live[Bool] = view::Live::Is(false),
  indeterminate~ : view::Live[Bool] = view::Live::Is(false),
  on_change~ : (Bool) -> Unit = fn(_b : Bool) { () },
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  variant? : AuraFieldVariant,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let chk_local = checked.to_getter()
  let ind_get = indeterminate.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let inv_local = invalid.to_getter()
  let dis_local = disabled.to_getter()
  let grp_ctx = parent.lent(b_checkbox_group_lent)

  let eff_variant = match variant {
    Some(v) => v
    None =>
      match grp_ctx {
        Some(g) => g.variant
        None => AuraFieldVariant::Primary
      }
  }
  let eff_checked = fn() -> Bool {
    match grp_ctx {
      Some(g) => if value != "" { b_array_contains_str((g.selected_get)(), value) } else { chk_local() }
      None => chk_local()
    }
  }
  let eff_turn = fn(next : Bool) -> Unit {
    match grp_ctx {
      Some(g) => if value != "" { (g.toggle_key)(value) } else { on_change(next) }
      None => on_change(next)
    }
  }
  let eff_inv = fn() -> Bool {
    let g_inv = match grp_ctx { Some(g) => (g.invalid_get)(); None => false }
    inv_local() || g_inv || err_get() != ""
  }
  let eff_dis_ref : signals::Ref[() -> Bool] = view::ref_new(dis_local)

  parent.box(loc=loc, fn(outer : view::View) -> Unit {
    let eff_dis = fn() -> Bool {
      let g_dis = match grp_ctx { Some(g) => (g.disabled_get)(); None => false }
      b_effective_disabled(outer, dis_local) || g_dis
    }
    eff_dis_ref.v = eff_dis
    let _ = outer
      .group_alpha(view::Live::By(fn() -> Double {
        if eff_dis() { aura_theme(outer).disabled_opacity } else { 1.0 }
      }))

    let _ = headless::toggle(
      outer,
      headless::ToggleKind::Checkbox,
      fn() -> String { let l = lbl_get(); if l != "" { l } else if value != "" { value } else { "Checkbox" } },
      eff_checked,
      eff_turn,
      fn(node : view::View, tog : headless::Toggle) -> Unit {
        if !stacked {
          let _ = node
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
        }
        // Square 16x16pt checkbox control (`rounded-md` = 6pt)
        let _ = node.box(fn(ctrl : view::View) -> Unit {
          let _ = ctrl
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .width(view::Live::Is(Some(16.0)))
            .height(view::Live::Is(Some(16.0)))
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(ctrl) }))
            .radius(view::Live::Is(6.25))
            .ground(view::Live::By(fn() -> Int64 {
              let pal = aura_theme(ctrl).palette
              let on = tog.on() || tog.mixed()
              let inv = eff_inv()
              let hov = !eff_dis() && !aura_is_coarse_pointer(node) && tog.hovered()
              if on && inv {
                pal.danger
              } else if on {
                if hov { pal.accent_hover } else { pal.accent }
              } else {
                match aura_field_effective_variant(ctrl, eff_variant) {
                  AuraFieldVariant::Secondary => pal.default_bg
                  _ => pal.field_background
                }
              }
            }))
            .shadows(view::Live::By(fn() -> Array[view::Shadow] {
              if aura_field_effective_variant(ctrl, eff_variant) is AuraFieldVariant::Primary {
                aura_surface_shadows(aura_theme(ctrl).config.dark)
              } else {
                []
              }
            }))
            .ring(view::Live::By(fn() -> (Double, Double, Int64) {
              let th = aura_theme(ctrl)
              let active = force_focus_visible || tog.focus_shown()
              let on = tog.on() || tog.mixed()
              if active {
                (2.0, th.ring_offset_width, th.palette.focus)
              } else if eff_inv() && !on {
                (1.0, 0.0, th.palette.danger)
              } else {
                (0.0, 0.0, 0L)
              }
            }))
            .ring_gap_color(view::Live::By(fn() -> Int64 {
              let active = force_focus_visible || tog.focus_shown()
              if active { aura_theme(ctrl).palette.background } else { 0L }
            }))
          // Vector indicator using `paint::subline`
          let _ = ctrl.box(fn(ind : view::View) -> Unit {
            let _ = ind
              .width(view::Live::Is(Some(12.0)))
              .height(view::Live::Is(Some(12.0)))
              .points(view::Live::Is(false))
              .lines(view::Live::By(fn() -> Array[paint::Line] {
                let pal = aura_theme(ind).palette
                let ink = if eff_inv() { pal.danger_foreground } else { pal.accent_foreground }
                if tog.mixed() {
                  // Indeterminate horizontal dash (`viewBox 0 0 24 24`, line (3,12)-(21,12) scaled to 12x12)
                  [paint::subline([(2.0, 6.0), (10.0, 6.0)], from=0.0, upto=1.0, width=1.6, color=ink)]
                } else if tog.on() {
                  // Checkmark (`viewBox 0 0 17 18`, polyline 1 9 7 14 15 4 scaled to 10x10 centered in 12x12)
                  let s = 10.0 / 18.0
                  let ox = 1.28
                  let oy = 1.0
                  [
                    paint::subline(
                      [(ox + 1.0 * s, oy + 9.0 * s), (ox + 7.0 * s, oy + 14.0 * s), (ox + 15.0 * s, oy + 4.0 * s)],
                      from=0.0,
                      upto=1.0,
                      width=1.55,
                      color=ink,
                    ),
                  ]
                } else {
                  []
                }
              }))
          })
        })
        let _ = node.show(
          fn() -> Bool { lbl_get() != "" },
          fn(lbl_slot : view::View) -> Unit {
            let _ = lbl_slot
              .points(view::Live::Is(false))
              .padding(view::Live::Is(if stacked { (0.0, 4.0, 0.0, 0.0) } else { (12.0, 0.0, 0.0, 0.0) }))
              .group_alpha(view::Live::By(fn() -> Double {
                if eff_dis() { aura_theme(lbl_slot).disabled_opacity } else { 1.0 }
              }))
            let _ = lbl_slot.box(fn(lbl_v : view::View) -> Unit {
              let look = b_words_look(14.0, 500, 20.0, false)
              let _ = lbl_v
                .points(view::Live::Is(false))
                .words(label, look=look)
                .words_look(view::Live::By(fn() -> view::WordsLook { look.with_rtl(aura_rtl(lbl_v)) }))
                .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl_v).palette.foreground }))
            })
          },
        )
      },
      disabled=fn() -> Bool { (eff_dis_ref.v)() },
      mixed=ind_get,
    )
    let _ = outer.show(
      fn() -> Bool { desc_get() != "" },
      fn(dv : view::View) -> Unit {
        let _ = dv
          .padding(view::Live::Is((if stacked { 0.0 } else { 28.0 }, 4.0, 0.0, 0.0)))
          .group_alpha(view::Live::By(fn() -> Double {
            if eff_dis() { aura_theme(dv).disabled_opacity } else { 1.0 }
          }))
        let _ = description_node(dv, description)
      },
    )
    let _ = outer.show(
      fn() -> Bool { eff_inv() && err_get() != "" },
      fn(ev : view::View) -> Unit {
        let _ = ev
          .padding(view::Live::Is((if stacked { 0.0 } else { 28.0 }, 4.0, 0.0, 0.0)))
          .group_alpha(view::Live::By(fn() -> Double {
            if eff_dis() { aura_theme(ev).disabled_opacity } else { 1.0 }
          }))
        let _ = error_message_node(ev, error)
      },
    )
  })
}

/// Pion-JSX `<aura::Checkbox>` wrapper.
pub fn Checkbox(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  value~ : String = "",
  into checked~ : view::Live[Bool] = .Is(false),
  checked_by? : () -> Bool,
  into indeterminate~ : view::Live[Bool] = .Is(false),
  indeterminate_by? : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_b : Bool) { () },
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  variant? : AuraFieldVariant,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let c = match checked_by { Some(f) => view::Live::By(f); None => checked }
  let ind = match indeterminate_by { Some(f) => view::Live::By(f); None => indeterminate }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  checkbox_node(
    parent,
    label=l,
    value=value,
    checked=c,
    indeterminate=ind,
    on_change=on_change,
    description=d,
    error=e,
    variant?=variant,
    invalid=inv,
    disabled=dis,
    stacked=stacked,
    force_focus_visible=force_focus_visible,
    loc=loc,
  )
}

/// Aura `CheckboxGroup` multi-select group (`Label` + items + `Description` + `FieldError`).
pub fn checkbox_group_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is(""),
  selected~ : view::Live[Array[String]] = view::Live::Is([]),
  on_change~ : (Array[String]) -> Unit = fn(_v : Array[String]) { () },
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  gap~ : Double = 16.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let sel_get = selected.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()

  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let eff_dis = fn() -> Bool { b_effective_disabled(node, dis_get) }
    let eff_inv = fn() -> Bool { inv_get() || err_get() != "" }
    let sel_core : headless_core::SelectionCore[String] = headless_core::SelectionCore::new(multiple=true)
    let ctx = BCheckboxGroupCtx::{
      selected_get: sel_get,
      toggle_key: fn(k : String) -> Unit {
        if !eff_dis() {
          on_change(sel_core.toggle_by(sel_get(), k, fn(a : String, b : String) -> Bool { a == b }))
        }
      },
      disabled_get: eff_dis,
      invalid_get: eff_inv,
      variant,
    }
    let _ = node
      .gap(view::Live::Is(gap))
      .lends(b_checkbox_group_lent, ctx)
      .says(view::Live::By(fn() -> Option[view::Said] {
        Some(view::said(view::Role::Group, label=lbl_get()))
      }))
    if lbl_get() != "" {
      let _ = label_node(node, label, disabled=view::Live::By(eff_dis))
    }
    content(node)
    let _ = node.show(
      fn() -> Bool { !eff_inv() && desc_get() != "" },
      fn(dv : view::View) -> Unit { let _ = description_node(dv, description) },
    )
    let _ = node.show(
      fn() -> Bool { eff_inv() && err_get() != "" },
      fn(ev : view::View) -> Unit { let _ = error_message_node(ev, error) },
    )
  })
}

/// Pion-JSX `<aura::CheckboxGroup>` wrapper.
pub fn CheckboxGroup(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into selected~ : view::Live[Array[String]] = .Is([]),
  selected_by? : () -> Array[String],
  on_change~ : (Array[String]) -> Unit = fn(_v : Array[String]) { () },
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  gap~ : Double = 16.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let sel = match selected_by { Some(f) => view::Live::By(f); None => selected }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  checkbox_group_node(
    parent,
    label=l,
    selected=sel,
    on_change=on_change,
    description=d,
    error=e,
    variant=variant,
    invalid=inv,
    disabled=dis,
    gap=gap,
    content=children,
    loc=loc,
  )
}

// ---------------------------------------------------------------------------
// 12 & 13. Radio (`radio_node` / `Radio`) & RadioGroup (`radio_group_node` / `RadioGroup`)
// ---------------------------------------------------------------------------

struct BRadioGroupCtx {
  group : headless::RadioGroup[String]
  disabled_get : () -> Bool
  invalid_get : () -> Bool
  variant : AuraFieldVariant
}

let b_radio_group_lent : view::Lent[BRadioGroupCtx] = view::Lent::new()

fn b_render_radio_look(
  node : view::View,
  label : view::Live[String],
  lbl_get : () -> String,
  chosen_get : () -> Bool,
  disabled_get : () -> Bool,
  hovered_get : () -> Bool,
  pressed_get : () -> Bool,
  focus_shown_get : () -> Bool,
  invalid_get : () -> Bool,
  variant : AuraFieldVariant,
  stacked : Bool,
  force_focus_visible : Bool,
) -> Unit {
  if !stacked {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
  }
  // 16x16pt circular radio control (`CornerShape::Circular`, r=8pt)
  let _ = node.box(fn(ctrl : view::View) -> Unit {
    let _ = ctrl
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .width(view::Live::Is(Some(16.0)))
      .height(view::Live::Is(Some(16.0)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(ctrl) }))
      .radius(view::Live::Is(8.0))
      .scale(view::Live::By(fn() -> Double {
        if !aura_reduced_motion(ctrl) && pressed_get() && !disabled_get() { 0.95 } else { 1.0 }
      }))
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura_theme(ctrl).palette
        let on = chosen_get()
        let hov = !disabled_get() && !aura_is_coarse_pointer(ctrl) && hovered_get()
        if on {
          if pressed_get() && !disabled_get() { pal.accent_hover } else { pal.accent }
        } else {
          match aura_field_effective_variant(ctrl, variant) {
            AuraFieldVariant::Secondary => if hov { pal.default_hover } else { pal.default_bg }
            _ => if hov { pal.field_hover } else { pal.field_background }
          }
        }
      }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        if !chosen_get() && aura_field_effective_variant(ctrl, variant) is AuraFieldVariant::Primary {
          aura_surface_shadows(aura_theme(ctrl).config.dark)
        } else {
          []
        }
      }))
      .ring(view::Live::By(fn() -> (Double, Double, Int64) {
        let th = aura_theme(ctrl)
        let active = force_focus_visible || focus_shown_get()
        if active {
          (2.0, th.ring_offset_width, th.palette.focus)
        } else if invalid_get() {
          (1.0, 0.0, th.palette.danger)
        } else {
          (0.0, 0.0, 0L)
        }
      }))
      .ring_gap_color(view::Live::By(fn() -> Int64 {
        let active = force_focus_visible || focus_shown_get()
        if active { aura_theme(ctrl).palette.background } else { 0L }
      }))
    // Inner white dot when selected (`scale: 0.4286` => ~6.86pt diameter; `0.5714` => ~9.14pt when pressed)
    let _ = ctrl.show(
      chosen_get,
      fn(dot : view::View) -> Unit {
        let _ = dot
          .width(view::Live::By(fn() -> Option[Double] {
            Some(if pressed_get() && !disabled_get() { 8.0 } else { 6.86 })
          }))
          .height(view::Live::By(fn() -> Option[Double] {
            Some(if pressed_get() && !disabled_get() { 8.0 } else { 6.86 })
          }))
          .points(view::Live::Is(false))
          .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(dot) }))
          .radius(view::Live::By(fn() -> Double {
            if pressed_get() && !disabled_get() { 4.0 } else { 3.43 }
          }))
          .ground(view::Live::By(fn() -> Int64 { aura_theme(dot).palette.accent_foreground }))
      },
    )
  })
  let _ = node.show(
    fn() -> Bool { lbl_get() != "" },
    fn(lbl_slot : view::View) -> Unit {
      let _ = lbl_slot
        .points(view::Live::Is(false))
        .padding(view::Live::Is(if stacked { (0.0, 4.0, 0.0, 0.0) } else { (12.0, 0.0, 0.0, 0.0) }))
        .group_alpha(view::Live::By(fn() -> Double {
          if disabled_get() { aura_theme(lbl_slot).disabled_opacity } else { 1.0 }
        }))
      let _ = lbl_slot.box(fn(lbl_v : view::View) -> Unit {
        let _ = lbl_v
          .points(view::Live::Is(false))
          .words(label, look=b_words_look(14.0, 500, 20.0, false))
          .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl_v).palette.foreground }))
      })
    },
  )
}

/// Aura `Radio` option (integrates with enclosing `RadioGroup` for arrow-key roving, or works standalone via `headless::choice`).
pub fn radio_node(
  parent : view::View,
  value : String,
  label~ : view::Live[String] = view::Live::Is(""),
  selected~ : view::Live[Bool] = view::Live::Is(false),
  on_select~ : () -> Unit = fn() { () },
  description~ : view::Live[String] = view::Live::Is(""),
  variant? : AuraFieldVariant,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let sel_local = selected.to_getter()
  let desc_get = description.to_getter()
  let inv_local = invalid.to_getter()
  let dis_local = disabled.to_getter()
  let grp_ctx = parent.lent(b_radio_group_lent)
  let eff_variant = match variant {
    Some(v) => v
    None =>
      match grp_ctx {
        Some(g) => g.variant
        None => AuraFieldVariant::Primary
      }
  }

  parent.box(loc=loc, fn(outer : view::View) -> Unit {
    let eff_dis = fn() -> Bool {
      let g_dis = match grp_ctx { Some(g) => (g.disabled_get)(); None => false }
      b_effective_disabled(outer, dis_local) || g_dis
    }
    let eff_inv = fn() -> Bool {
      let g_inv = match grp_ctx { Some(g) => (g.invalid_get)(); None => false }
      inv_local() || g_inv
    }
    let _ = outer.group_alpha(view::Live::By(fn() -> Double {
      if eff_dis() { aura_theme(outer).disabled_opacity } else { 1.0 }
    }))
    match grp_ctx {
      Some(g) => {
        let _ = g.group.item(
          outer,
          fn() -> String { value },
          fn() -> String { let l = lbl_get(); if l != "" { l } else { value } },
          fn(node : view::View, item : headless::RadioItem) -> Unit {
            b_render_radio_look(
              node,
              label,
              lbl_get,
              fn() -> Bool { item.chosen() },
              fn() -> Bool { item.disabled() || eff_dis() },
              fn() -> Bool { item.hovered() },
              fn() -> Bool { item.pressed() },
              fn() -> Bool { item.focus_shown() },
              eff_inv,
              eff_variant,
              stacked,
              force_focus_visible,
            )
          },
          disabled=eff_dis,
        )
      }
      None => {
        let _ = headless::choice(
          outer,
          headless::ChoiceKind::Radio,
          fn() -> String { let l = lbl_get(); if l != "" { l } else { value } },
          sel_local,
          fn(_v : view::View) -> Unit { on_select() },
          fn(node : view::View, ch : headless::Choice) -> Unit {
            b_render_radio_look(
              node,
              label,
              lbl_get,
              fn() -> Bool { ch.chosen() },
              fn() -> Bool { ch.disabled() },
              fn() -> Bool { ch.hovered() },
              fn() -> Bool { ch.pressed() },
              fn() -> Bool { ch.focus_shown() },
              eff_inv,
              eff_variant,
              stacked,
              force_focus_visible,
            )
          },
          disabled=eff_dis,
        )
      }
    }
    let _ = outer.show(
      fn() -> Bool { desc_get() != "" },
      fn(dv : view::View) -> Unit {
        let _ = dv
          .padding(view::Live::Is((if stacked { 0.0 } else { 28.0 }, 4.0, 0.0, 0.0)))
          .group_alpha(view::Live::By(fn() -> Double {
            if eff_dis() { aura_theme(dv).disabled_opacity } else { 1.0 }
          }))
        let _ = description_node(dv, description)
      },
    )
  })
}

/// Pion-JSX `<aura::Radio>` wrapper.
pub fn Radio(
  parent : view::View,
  value~ : String = "",
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into selected~ : view::Live[Bool] = .Is(false),
  selected_by? : () -> Bool,
  on_select~ : () -> Unit = fn() { () },
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  variant? : AuraFieldVariant,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let sel = match selected_by { Some(f) => view::Live::By(f); None => selected }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  radio_node(
    parent,
    value,
    label=l,
    selected=sel,
    on_select=on_select,
    description=d,
    variant?=variant,
    invalid=inv,
    disabled=dis,
    stacked=stacked,
    force_focus_visible=force_focus_visible,
    loc=loc,
  )
}

/// Aura `RadioGroup` integrating `headless::radio_group` (arrow-key roving focus, `Role::RadioGroup`).
pub fn radio_group_node(
  parent : view::View,
  value : view::Live[String],
  on_change : (String) -> Unit,
  label~ : view::Live[String] = view::Live::Is(""),
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  orientation~ : AuraOrientation = AuraOrientation::Vertical,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  gap~ : Double = 16.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let val_get = value.to_getter()
  let lbl_get = label.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let inv_get = invalid.to_getter()
  let dis_get = disabled.to_getter()
  let axis = match orientation {
    AuraOrientation::Horizontal => headless::GroupAxis::Horizontal
    AuraOrientation::Vertical => headless::GroupAxis::Vertical
  }
  let eff_dis_ref : signals::Ref[() -> Bool] = view::ref_new(dis_get)

  headless::radio_group(
    parent,
    fn() -> String { let l = lbl_get(); if l != "" { l } else { "Radio group" } },
    val_get,
    on_change,
    fn(node : view::View, rg : headless::RadioGroup[String]) -> Unit {
      let eff_dis = fn() -> Bool { b_effective_disabled(node, dis_get) }
      eff_dis_ref.v = eff_dis
      let eff_inv = fn() -> Bool { inv_get() || err_get() != "" }
      let _ = node.gap(view::Live::Is(gap))
      if lbl_get() != "" {
        let _ = label_node(node, label, disabled=view::Live::By(eff_dis))
      }
      let _ = node.box(fn(items : view::View) -> Unit {
        let _ = items
          .row(view::Live::Is(orientation is AuraOrientation::Horizontal))
          .gap(view::Live::Is(gap))
          .lends(b_radio_group_lent, BRadioGroupCtx::{ group: rg, disabled_get: eff_dis, invalid_get: eff_inv, variant })
        content(items)
      })
      let _ = node.show(
        fn() -> Bool { !eff_inv() && desc_get() != "" },
        fn(dv : view::View) -> Unit { let _ = description_node(dv, description) },
      )
      let _ = node.show(
        fn() -> Bool { eff_inv() && err_get() != "" },
        fn(ev : view::View) -> Unit { let _ = error_message_node(ev, error) },
      )
    },
    kind=headless::GroupKind::Radio,
    axis=axis,
    disabled=fn() -> Bool { (eff_dis_ref.v)() },
    loc=loc,
  )
}

/// Pion-JSX `<aura::RadioGroup>` wrapper.
pub fn RadioGroup(
  parent : view::View,
  into value~ : view::Live[String] = .Is(""),
  value_by? : () -> String,
  on_change~ : (String) -> Unit = fn(_v : String) { () },
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  orientation~ : AuraOrientation = AuraOrientation::Vertical,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  gap~ : Double = 16.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let v = match value_by { Some(f) => view::Live::By(f); None => value }
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  radio_group_node(
    parent,
    v,
    on_change,
    label=l,
    description=d,
    error=e,
    orientation=orientation,
    variant=variant,
    invalid=inv,
    disabled=dis,
    gap=gap,
    content=children,
    loc=loc,
  )
}

// ---------------------------------------------------------------------------
// 14 & 15. Switch (`switch_node` / `Switch`) & SwitchGroup (`switch_group_node` / `SwitchGroup`)
// ---------------------------------------------------------------------------

/// Aura `Switch` size (`Sm`, `Md`, `Lg`), maintaining exact 1.375:1 elliptical thumb aspect ratio.
#derive(Eq)
pub enum AuraSwitchSize {
  Sm
  Md
  Lg
}

fn b_switch_metrics(size : AuraSwitchSize) -> (Double, Double, Double, Double, Double, Double, Double) {
  // Returns (track_w, track_h, track_r, thumb_w, thumb_h, thumb_r, stretch_dx)
  // Exact 1.375:1 thumb ratio: Sm=16.5/12, Md=22/16, Lg=27.5/20
  match size {
    AuraSwitchSize::Sm => (32.0, 16.0, 8.0, 16.5, 12.0, 6.0, 2.5)
    AuraSwitchSize::Md => (40.0, 20.0, 10.0, 22.0, 16.0, 8.0, 3.0)
    AuraSwitchSize::Lg => (48.0, 24.0, 12.0, 27.5, 20.0, 10.0, 3.5)
  }
}

fn b_lerp_rgba(c0 : Int64, c1 : Int64, t : Double) -> Int64 {
  if t <= 0.0 {
    return c0
  }
  if t >= 1.0 {
    return c1
  }
  let ch = fn(shift : Int) -> Int64 {
    let v0 = ((c0 >> shift) & 0xFFL).to_double()
    let v1 = ((c1 >> shift) & 0xFFL).to_double()
    let v = (v0 + (v1 - v0) * t).round().to_int64()
    if v < 0L { 0L } else if v > 255L { 255L } else { v }
  }
  (ch(24) << 24) | (ch(16) << 16) | (ch(8) << 8) | ch(0)
}

/// Aura `Switch` toggle control (1.375:1 elliptical thumb + `aura_switch_thumb_shadows()` 3-layer shadow +
/// smooth press-stretch width animation + `w0_apply_control_focus_ring`).
pub fn switch_node(
  parent : view::View,
  checked : view::Live[Bool],
  on_change : (Bool) -> Unit,
  label~ : view::Live[String] = view::Live::Is(""),
  description~ : view::Live[String] = view::Live::Is(""),
  size~ : AuraSwitchSize = AuraSwitchSize::Md,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let (tw, th_h, tr, thumb_w, thumb_h, thumb_r, stretch_dx) = b_switch_metrics(size)
  let chk_get = checked.to_getter()
  let lbl_get = label.to_getter()
  let desc_get = description.to_getter()
  let dis_local = disabled.to_getter()
  let eff_dis_ref : signals::Ref[() -> Bool] = view::ref_new(dis_local)

  parent.box(loc=loc, fn(outer : view::View) -> Unit {
    let eff_dis = fn() -> Bool { b_effective_disabled(outer, dis_local) }
    eff_dis_ref.v = eff_dis
    let _ = outer
      .group_alpha(view::Live::By(fn() -> Double {
        if eff_dis() { aura_theme(outer).disabled_opacity } else { 1.0 }
      }))

    let _ = headless::toggle(
      outer,
      headless::ToggleKind::Switch,
      fn() -> String { let l = lbl_get(); if l != "" { l } else { "Switch" } },
      chk_get,
      on_change,
      fn(node : view::View, tog : headless::Toggle) -> Unit {
        let init_on = if signals::untracked(chk_get) { 1.0 } else { 0.0 }
        let press_way = motion::NodeWay::new(0.0)
        let slide_way = motion::NodeWay::new(init_on)
        let color_way = motion::NodeWay::new(init_on)
        node.reacts(
          at_start=false,
          fn() -> Bool { tog.pressed() && !eff_dis() },
          fn(down : Bool) -> Unit {
            let target = if down { 1.0 } else { 0.0 }
            if aura_reduced_motion(node) {
              press_way.put(target)
            } else {
              press_way.go(node, target, motion::backdrop_press_spring)
            }
          },
        )
        node.reacts(
          at_start=false,
          fn() -> Bool { tog.on() },
          fn(on : Bool) -> Unit {
            let target = if on { 1.0 } else { 0.0 }
            if aura_reduced_motion(node) {
              slide_way.put(target)
              color_way.put(target)
            } else {
              slide_way.go(node, target, motion::knob_spring)
              color_way.go(node, target, motion::motion_spring(0.25))
            }
          },
        )
        if !stacked {
          let _ = node
            .row_reverse(view::Live::By(fn() -> Bool { aura_rtl(node) }))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
        } else {
          let _ = node.lines_up(view::Live::By(fn() -> Option[view::Along] {
            Some(if aura_rtl(node) { view::Along::End } else { view::Along::Start })
          }))
        }
        // Switch track outer wrapper holds the unclipped focus ring; inner track clips thumb shadow (`overflow-hidden`).
        let _ = node.box(fn(track_frame : view::View) -> Unit {
          let _ = track_frame
            .width(view::Live::Is(Some(tw)))
            .height(view::Live::Is(Some(th_h)))
            .shrink(view::Live::Is(0.0))
            .points(view::Live::Is(false))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(track_frame) }))
            .radius(view::Live::Is(tr))
            .ring(view::Live::By(fn() -> (Double, Double, Int64) {
              let active = force_focus_visible || tog.focus_shown()
              if active {
                let th = aura_theme(track_frame)
                (2.0, th.ring_offset_width, th.palette.focus)
              } else {
                (0.0, 0.0, 0L)
              }
            }))
            .ring_gap_color(view::Live::By(fn() -> Int64 {
              let active = force_focus_visible || tog.focus_shown()
              if active { aura_theme(track_frame).palette.background } else { 0L }
            }))
          let _ = track_frame.box(fn(track : view::View) -> Unit {
            let _ = track
              .width(view::Live::Is(Some(tw)))
              .height(view::Live::Is(Some(th_h)))
              .shrink(view::Live::Is(0.0))
              .points(view::Live::Is(false))
              .clips(view::Live::Is(true))
              .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(track) }))
              .radius(view::Live::Is(tr))
              .ground(view::Live::By(fn() -> Int64 {
                let pal = aura_theme(track).palette
                let on = tog.on()
                let hov = !eff_dis() && (force_pressed || tog.pressed() || !aura_is_coarse_pointer(track) && tog.hovered())
                let off_col = if hov { pal.default_hover } else { pal.default_bg }
                let on_col = if hov { pal.accent_hover } else { pal.accent }
                let t = if aura_reduced_motion(track) {
                  if on { 1.0 } else { 0.0 }
                } else {
                  b_clamp01(color_way.shown(track))
                }
                b_lerp_rgba(off_col, on_col, t)
              }))
            // Elliptical 1.375:1 thumb with 3-layer shadow when checked & press stretch
            let _ = track.box(fn(thumb : view::View) -> Unit {
              let stretch_t = fn() -> Double {
                if aura_reduced_motion(thumb) || eff_dis() {
                  0.0
                } else if force_pressed {
                  1.0
                } else {
                  b_clamp01(press_way.shown(thumb))
                }
              }
              let cur_w = fn() -> Double { thumb_w + stretch_dx * stretch_t() }
              let cur_x = fn() -> Double {
                let w = cur_w()
                let rtl = aura_rtl(thumb)
                let slide_t = if aura_reduced_motion(thumb) {
                  if tog.on() { 1.0 } else { 0.0 }
                } else {
                  b_clamp01(slide_way.shown(thumb))
                }
                let x_off = if rtl { tw - w - 2.0 } else { 2.0 }
                let x_on = if rtl { 2.0 } else { tw - w - 2.0 }
                x_off + (x_on - x_off) * slide_t
              }
              let _ = thumb
                .over(view::Live::Is(true), edges=(Some(0.0), Some((th_h - thumb_h) * 0.5), None, None))
                .offset(view::Live::By(fn() -> (Double, Double) { (cur_x(), 0.0) }))
                .width(view::Live::By(fn() -> Option[Double] { Some(cur_w()) }))
                .height(view::Live::Is(Some(thumb_h)))
                .points(view::Live::Is(false))
                .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(thumb) }))
                .radius(view::Live::Is(thumb_r))
                .ground(view::Live::By(fn() -> Int64 {
                  let pal = aura_theme(thumb).palette
                  if tog.on() { pal.accent_foreground } else { pal.white }
                }))
                .shadows(view::Live::By(fn() -> Array[view::Shadow] {
                  if tog.on() {
                    aura_switch_thumb_shadows()
                  } else {
                    aura_surface_shadows(aura_theme(thumb).config.dark)
                  }
                }))
            })
          })
        })
        let _ = node.show(
          fn() -> Bool { lbl_get() != "" },
          fn(lbl_slot : view::View) -> Unit {
            let _ = lbl_slot
              .points(view::Live::Is(false))
              .padding(view::Live::Is(if stacked { (0.0, 4.0, 0.0, 0.0) } else { (12.0, 0.0, 0.0, 0.0) }))
              .group_alpha(view::Live::By(fn() -> Double {
                if eff_dis() { aura_theme(lbl_slot).disabled_opacity } else { 1.0 }
              }))
            let _ = lbl_slot.box(fn(lbl_v : view::View) -> Unit {
              let look = b_words_look(14.0, 500, 20.0, false)
              let _ = lbl_v
                .points(view::Live::Is(false))
                .words(label, look=look)
                .words_look(view::Live::By(fn() -> view::WordsLook { look.with_rtl(aura_rtl(lbl_v)) }))
                .ink(view::Live::By(fn() -> Int64 { aura_theme(lbl_v).palette.foreground }))
            })
          },
        )
      },
      disabled=fn() -> Bool { (eff_dis_ref.v)() },
    )
    let _ = outer.show(
      fn() -> Bool { desc_get() != "" },
      fn(dv : view::View) -> Unit {
        let _ = dv
          .padding(view::Live::Is((if stacked { 0.0 } else { tw + 12.0 }, 4.0, 0.0, 0.0)))
          .group_alpha(view::Live::By(fn() -> Double {
            if eff_dis() { aura_theme(dv).disabled_opacity } else { 1.0 }
          }))
        let _ = description_node(dv, description)
      },
    )
  })
}

/// Pion-JSX `<aura::Switch>` wrapper.
pub fn Switch(
  parent : view::View,
  into checked~ : view::Live[Bool] = .Is(false),
  checked_by? : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_b : Bool) { () },
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  size~ : AuraSwitchSize = AuraSwitchSize::Md,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  stacked~ : Bool = false,
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let c = match checked_by { Some(f) => view::Live::By(f); None => checked }
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  switch_node(
    parent,
    c,
    on_change,
    label=l,
    description=d,
    size=size,
    disabled=dis,
    stacked=stacked,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    loc=loc,
  )
}

/// Aura `SwitchGroup` container (`Label` + horizontal/vertical items + `Description` + `FieldError`).
pub fn switch_group_node(
  parent : view::View,
  label~ : view::Live[String] = view::Live::Is(""),
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  gap~ : Double = 24.0,
  item_gap~ : Double = 16.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let dis_get = disabled.to_getter()

  headless::fieldset(
    parent,
    fn() -> String { let l = lbl_get(); if l != "" { l } else { "Switch group" } },
    fn(node : view::View, fs : headless::Fieldset) -> Unit {
      let _ = node.gap(view::Live::Is(gap))
      if lbl_get() != "" {
        let _ = label_node(node, label, disabled=view::Live::By(fn() -> Bool { fs.disabled() }))
      }
      let _ = node.box(fn(items : view::View) -> Unit {
        let _ = items
          .row(view::Live::Is(orientation is AuraOrientation::Horizontal))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(item_gap))
        content(items)
      })
      let _ = node.show(
        fn() -> Bool { desc_get() != "" },
        fn(dv : view::View) -> Unit { let _ = description_node(dv, description) },
      )
      let _ = node.show(
        fn() -> Bool { err_get() != "" },
        fn(ev : view::View) -> Unit { let _ = error_message_node(ev, error) },
      )
    },
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::SwitchGroup>` wrapper.
pub fn SwitchGroup(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  gap~ : Double = 24.0,
  item_gap~ : Double = 16.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  switch_group_node(
    parent,
    label=l,
    description=d,
    error=e,
    orientation=orientation,
    disabled=dis,
    gap=gap,
    item_gap=item_gap,
    content=children,
    loc=loc,
  )
}
