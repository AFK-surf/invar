// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): ToggleButton and ToggleButtonGroup
// backed 100% by `headless::toggle` and `headless::toggle_group`.

import "headless"
import "motion"
import "view"

/// Visual variant for `ToggleButton` (`Default` or `Ghost`).
#derive(Eq)
pub enum AuraToggleButtonVariant {
  Default
  Ghost
}

/// Selection mode for `ToggleButtonGroup` (`Single` or `Multiple`).
#derive(Eq)
pub enum AuraSelectionMode {
  Single
  Multiple
}

fn a_tbtn_metrics(size : AuraButtonSize, icon_only : Bool, is_md : Bool) -> (Double, Double, Double, Double, Double) {
  match size {
    AuraButtonSize::Sm =>
      (if is_md { 32.0 } else { 36.0 }, if icon_only { 0.0 } else { 12.0 }, 14.0, 20.0, aura_button_press_scale_sm)
    AuraButtonSize::Md =>
      (if is_md { 36.0 } else { 40.0 }, if icon_only { 0.0 } else { 16.0 }, 14.0, 20.0, aura_button_press_scale)
    AuraButtonSize::Lg =>
      (if is_md { 40.0 } else { 44.0 }, if icon_only { 0.0 } else { 16.0 }, 16.0, 24.0, aura_button_press_scale_lg)
  }
}

fn a_tbtn_colors(
  pal : AuraPalette,
  variant : AuraToggleButtonVariant,
  selected : Bool,
  lit : Bool,
) -> (Int64, Int64) {
  if selected {
    (if lit { pal.accent_soft_hover } else { pal.accent_soft }, pal.accent_soft_foreground)
  } else {
    match variant {
      AuraToggleButtonVariant::Default =>
        (if lit { pal.default_hover } else { pal.default_bg }, pal.default_foreground)
      AuraToggleButtonVariant::Ghost =>
        (if lit { pal.default_bg } else { 0x00000000L }, pal.default_foreground)
    }
  }
}

fn a_tbtn_clamp01(x : Double) -> Double {
  if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
}

fn a_tbtn_lit(node : view::View, force_pressed : Bool, disabled : Bool) -> Bool {
  !disabled && (force_pressed || node.pressed() || (!aura_is_coarse_pointer(node) && node.pointed()))
}

fn a_style_toggle_button(
  node : view::View,
  tgl : headless::Toggle,
  label : view::Live[String],
  variant : AuraToggleButtonVariant,
  size : AuraButtonSize,
  icon_only : Bool,
  full_width : Bool,
  in_attached_group : Bool,
  corners : Option[(Double, Double, Double, Double)],
  force_focus_visible : Bool,
  force_pressed : Bool,
  content : Option[(view::View) -> Unit],
) -> Unit {
  let (_, px, fs, lh, press_sc) = a_tbtn_metrics(size, icon_only, true)
  let press_way = motion::NodeWay::new(0.0)
  if !in_attached_group {
    node.reacts(
      at_start=false,
      fn() -> Bool { node.pressed() && !tgl.disabled() },
      fn(down : Bool) -> Unit {
        let target = if down { 1.0 } else { 0.0 }
        if aura_reduced_motion(node) {
          press_way.put(target)
        } else {
          press_way.go(node, target, motion::backdrop_press_spring)
        }
      },
    )
  }
  let fg_get = fn() -> Int64 {
    let th = aura_theme(node)
    let lit = a_tbtn_lit(node, force_pressed, tgl.disabled())
    a_tbtn_colors(th.palette, variant, tgl.on(), lit).1
  }
  let _ = node
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .gap(view::Live::Is(8.0))
    .height(view::Live::By(fn() -> Option[Double] {
      Some(a_tbtn_metrics(size, icon_only, aura_is_md(node)).0)
    }))
    .shrink(view::Live::Is(0.0))
    .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
    .scale(view::Live::By(fn() -> Double {
      if in_attached_group || aura_reduced_motion(node) || tgl.disabled() {
        1.0
      } else if force_pressed {
        press_sc
      } else {
        let t = a_tbtn_clamp01(press_way.shown(node))
        1.0 + (press_sc - 1.0) * t
      }
    }))
    .group_alpha(view::Live::By(fn() -> Double {
      if tgl.disabled() { aura_theme(node).disabled_opacity } else { 1.0 }
    }))
    .ground(view::Live::By(fn() -> Int64 {
      let th = aura_theme(node)
      let lit = a_tbtn_lit(node, force_pressed, tgl.disabled())
      a_tbtn_colors(th.palette, variant, tgl.on(), lit).0
    }))
  match corners {
    Some(cs) => {
      let _ = node.corners(view::Live::Is(Some(cs)))
    }
    None => {
      let _ = node.radius(view::Live::By(fn() -> Double {
        a_tbtn_metrics(size, icon_only, aura_is_md(node)).0 * 0.5
      }))
    }
  }
  if icon_only {
    let _ = node.width(view::Live::By(fn() -> Option[Double] {
      Some(a_tbtn_metrics(size, icon_only, aura_is_md(node)).0)
    }))
  } else if full_width {
    let _ = node.fills_across(view::Live::Is(true)).pad_xy(px, 0.0)
  } else {
    // Match `button.pion`: compensate Invar's ~1pt words measure cushion so short centered labels ("L") don't overflow inner width
    let _ = node.pad_xy(px - 0.5, 0.0)
  }
  let _ = w0_apply_control_focus_ring(node, force_focus_visible=force_focus_visible)
  match content {
    Some(c) => c(node)
    None => {
      let _ = node.box(fn(lbl_v : view::View) -> Unit {
        let tbtn_look = view::WordsLook::{ ..view::words_plain, size: fs, weight: 500, line: lh, wrap: false }
        let _ = lbl_v
          .points(view::Live::Is(false))
          .words_centered(view::Live::Is(true))
          .words(
            label,
            look=tbtn_look,
          )
          .words_look(view::Live::By(fn() -> view::WordsLook { tbtn_look.with_rtl(aura_rtl(lbl_v)) }))
          .ink(view::Live::By(fg_get))
      })
    }
  }
}

/// Aura `ToggleButton` (Builder API), 100% wired to `headless::toggle(ToggleKind::Button)`.
pub fn toggle_button_node(
  parent : view::View,
  label : view::Live[String],
  selected : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_on : Bool) { () },
  variant~ : AuraToggleButtonVariant = AuraToggleButtonVariant::Default,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  icon_only~ : Bool = false,
  full_width~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  corners? : (Double, Double, Double, Double),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let dis_get = disabled.to_getter()
  let lbl_get = label.to_getter()
  headless::toggle(
    parent,
    headless::ToggleKind::Button,
    lbl_get,
    selected,
    on_change,
    fn(node : view::View, tgl : headless::Toggle) -> Unit {
      a_style_toggle_button(
        node,
        tgl,
        label,
        variant,
        size,
        icon_only,
        full_width,
        false,
        corners,
        force_focus_visible,
        force_pressed,
        content,
      )
    },
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::ToggleButton>` wrapper.
pub fn ToggleButton(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  selected~ : () -> Bool = fn() { false },
  on_change~ : (Bool) -> Unit = fn(_on : Bool) { () },
  variant~ : AuraToggleButtonVariant = AuraToggleButtonVariant::Default,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  icon_only~ : Bool = false,
  full_width~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  corners? : (Double, Double, Double, Double),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  toggle_button_node(
    parent,
    lbl,
    selected,
    on_change=on_change,
    variant=variant,
    size=size,
    icon_only=icon_only,
    full_width=full_width,
    disabled=dis,
    corners?=corners,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    content?=children,
    loc=loc,
  )
}

/// Handle passed to `toggle_button_group_node` / `ToggleButtonGroup` content builder
/// to register items into `headless::ToggleGroup[K]`.
pub struct AuraToggleGroup[K] {
  inner : headless::ToggleGroup[K]
  orientation : AuraOrientation
  variant : AuraToggleButtonVariant
  size : AuraButtonSize
  detached : Bool
  full_width : Bool
  hide_separator : Bool
}

/// Whether the group is disabled.
pub fn AuraToggleGroup::disabled[K](self : AuraToggleGroup[K]) -> Bool {
  self.inner.disabled()
}

/// Whether the group uses single-selection mode.
pub fn AuraToggleGroup::single[K](self : AuraToggleGroup[K]) -> Bool {
  self.inner.single()
}

/// Internal separator between attached `ToggleButtonGroup` items (`toggle-button-group__separator`).
pub fn toggle_button_group_separator_node(
  parent : view::View,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  loc~ : String = "",
) -> view::View {
  button_group_separator_node(parent, orientation=orientation, variant=AuraButtonVariant::Tertiary, loc=loc)
}

/// Pion-JSX `<aura::ToggleButtonGroupSeparator>` wrapper.
pub fn ToggleButtonGroupSeparator(
  parent : view::View,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  loc~ : String = "",
) -> view::View {
  toggle_button_group_separator_node(parent, orientation=orientation, loc=loc)
}

/// Add a toggle button item at `index` of `total` into this `AuraToggleGroup[K]`.
/// Backed by `headless::ToggleGroup::item` for roving focus and ARIA pressed semantics.
pub fn AuraToggleGroup::item[K](
  self : AuraToggleGroup[K],
  parent : view::View,
  key : K,
  label : view::Live[String],
  index~ : Int = 0,
  total~ : Int = 1,
  icon_only~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let dis_get = disabled.to_getter()
  let lbl_get = label.to_getter()
  if index > 0 && !self.detached && !self.hide_separator {
    let _ = toggle_button_group_separator_node(parent, orientation=self.orientation)
  }
  let r = match self.size {
    AuraButtonSize::Sm => 16.0
    AuraButtonSize::Md => 18.0
    AuraButtonSize::Lg => 20.0
  }
  let cs : Option[(Double, Double, Double, Double)] = if self.detached {
    None
  } else {
    Some(a_group_item_corners(self.orientation, index, total, r))
  }
  let v = self.inner.item(
    parent,
    key,
    lbl_get,
    fn(node : view::View, tgl : headless::Toggle) -> Unit {
      a_style_toggle_button(
        node,
        tgl,
        label,
        self.variant,
        self.size,
        icon_only,
        false,
        !self.detached,
        cs,
        force_focus_visible,
        force_pressed,
        content,
      )
    },
    disabled=dis_get,
    loc=loc,
  )
  if self.full_width {
    match self.orientation {
      AuraOrientation::Horizontal => {
        let _ = v.grow(view::Live::Is(1.0))
      }
      AuraOrientation::Vertical => {
        let _ = v.fills_across(view::Live::Is(true))
      }
    }
  }
  v
}

/// Aura `ToggleButtonGroup` (Builder API), 100% wired to `headless::toggle_group`.
/// Supports Single/Multiple selection modes, horizontal/vertical roving keyboard focus,
/// attached vs detached layout, full-width stretching, and optional internal separators.
pub fn toggle_button_group_node[K](
  parent : view::View,
  label : view::Live[String],
  is_on : (K) -> Bool,
  on_change : (K, Bool) -> Unit,
  content : (view::View, AuraToggleGroup[K]) -> Unit,
  mode~ : AuraSelectionMode = AuraSelectionMode::Single,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraToggleButtonVariant = AuraToggleButtonVariant::Default,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  detached~ : Bool = false,
  full_width~ : Bool = false,
  hide_separator~ : Bool = false,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let dis_get = disabled.to_getter()
  let kind = match mode {
    AuraSelectionMode::Single => headless::ToggleGroupKind::Single
    AuraSelectionMode::Multiple => headless::ToggleGroupKind::Multiple
  }
  let axis = match orientation {
    AuraOrientation::Horizontal => headless::GroupAxis::Horizontal
    AuraOrientation::Vertical => headless::GroupAxis::Vertical
  }
  headless::toggle_group(
    parent,
    lbl_get,
    is_on,
    on_change,
    fn(node : view::View, grp : headless::ToggleGroup[K]) -> Unit {
      let _ = node
        .row(view::Live::Is(orientation is AuraOrientation::Horizontal))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .gap(view::Live::Is(if detached { 4.0 } else { 0.0 }))
      if full_width {
        let _ = node.fills_across(view::Live::Is(true))
      }
      let handle = AuraToggleGroup::{
        inner: grp,
        orientation,
        variant,
        size,
        detached,
        full_width,
        hide_separator,
      }
      content(node, handle)
    },
    kind=kind,
    axis=axis,
    wraps=wraps,
    rtl=rtl,
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::ToggleButtonGroup>` wrapper.
pub fn ToggleButtonGroup[K](
  parent : view::View,
  into label~ : view::Live[String] = .Is("Toggle group"),
  label_by? : () -> String,
  is_on~ : (K) -> Bool,
  on_change~ : (K, Bool) -> Unit,
  mode~ : AuraSelectionMode = AuraSelectionMode::Single,
  orientation~ : AuraOrientation = AuraOrientation::Horizontal,
  variant~ : AuraToggleButtonVariant = AuraToggleButtonVariant::Default,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  detached~ : Bool = false,
  full_width~ : Bool = false,
  hide_separator~ : Bool = false,
  wraps~ : Bool = true,
  rtl~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  render~ : (view::View, AuraToggleGroup[K]) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  toggle_button_group_node(
    parent,
    lbl,
    is_on,
    on_change,
    render,
    mode=mode,
    orientation=orientation,
    variant=variant,
    size=size,
    detached=detached,
    full_width=full_width,
    hide_separator=hide_separator,
    wraps=wraps,
    rtl=rtl,
    disabled=dis,
    loc=loc,
  )
}
