// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Kbd, KbdAbbr, and KbdContent.

import "dmath"
import "paint"
import "view"

/// Visual variant for `Kbd` (`Default` with `--default` fill, `Light` transparent).
#derive(Eq)
pub enum AuraKbdVariant {
  Default
  Light
}

/// Standard keyboard modifier and navigation keys matching `kbd.constants.ts`.
#derive(Eq)
pub enum AuraKbdKey {
  Command
  Shift
  Ctrl
  Option
  Enter
  Delete
  Escape
  Tab
  CapsLock
  Up
  Right
  Down
  Left
  PageUp
  PageDown
  Home
  End
  Help
  Space
  Fn
  Win
  Alt
}

/// Unicode glyph for `key`.
pub fn aura_kbd_key_symbol(key : AuraKbdKey) -> String {
  match key {
    AuraKbdKey::Command => "⌘"
    AuraKbdKey::Shift => "⇧"
    AuraKbdKey::Ctrl => "⌃"
    AuraKbdKey::Option => "⌥"
    AuraKbdKey::Enter => "↵"
    AuraKbdKey::Delete => "⌫"
    AuraKbdKey::Escape => "⎋"
    AuraKbdKey::Tab => "⇥"
    AuraKbdKey::CapsLock => "⇪"
    AuraKbdKey::Up => "↑"
    AuraKbdKey::Right => "→"
    AuraKbdKey::Down => "↓"
    AuraKbdKey::Left => "←"
    AuraKbdKey::PageUp => "⇞"
    AuraKbdKey::PageDown => "⇟"
    AuraKbdKey::Home => "↖"
    AuraKbdKey::End => "↘"
    AuraKbdKey::Help => "?"
    AuraKbdKey::Space => "␣"
    AuraKbdKey::Fn => "Fn"
    AuraKbdKey::Win => "⌘"
    AuraKbdKey::Alt => "⌥"
  }
}

/// Accessible label for `key`.
pub fn aura_kbd_key_label(key : AuraKbdKey) -> String {
  match key {
    AuraKbdKey::Command => "Command"
    AuraKbdKey::Shift => "Shift"
    AuraKbdKey::Ctrl => "Control"
    AuraKbdKey::Option => "Option"
    AuraKbdKey::Enter => "Enter"
    AuraKbdKey::Delete => "Delete"
    AuraKbdKey::Escape => "Escape"
    AuraKbdKey::Tab => "Tab"
    AuraKbdKey::CapsLock => "Caps Lock"
    AuraKbdKey::Up => "Up"
    AuraKbdKey::Right => "Right"
    AuraKbdKey::Down => "Down"
    AuraKbdKey::Left => "Left"
    AuraKbdKey::PageUp => "Page Up"
    AuraKbdKey::PageDown => "Page Down"
    AuraKbdKey::Home => "Home"
    AuraKbdKey::End => "End"
    AuraKbdKey::Help => "Help"
    AuraKbdKey::Space => "Space"
    AuraKbdKey::Fn => "Fn"
    AuraKbdKey::Win => "Win"
    AuraKbdKey::Alt => "Alt"
  }
}

fn a_kbd_words_look() -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size: 14.0, weight: 500, line: 20.0, wrap: false }
}

/// Aura `Kbd` keyboard shortcut badge (Builder API).
/// Mirrors `.kbd` (`h-6 items-center gap-0.5 rounded-lg bg-default px-2 text-sm font-medium text-muted`).
pub fn kbd_node(
  parent : view::View,
  variant~ : AuraKbdVariant = AuraKbdVariant::Default,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .height(view::Live::Is(Some(24.0)))
      .shrink(view::Live::Is(0.0))
      .pad_xy(8.0, 0.0)
      .gap(view::Live::Is(2.0))
      .corner_circular(view::Live::Is(true))
      .radius(view::Live::Is(8.0))
      .ground(view::Live::By(fn() -> Int64 {
        match variant {
          AuraKbdVariant::Default => aura_theme(node).palette.default_bg
          AuraKbdVariant::Light => 0x00000000L
        }
      }))
    content(node)
  })
}

/// Pion-JSX `<aura::Kbd>` wrapper.
pub fn Kbd(
  parent : view::View,
  variant~ : AuraKbdVariant = AuraKbdVariant::Default,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  kbd_node(parent, variant=variant, content=children, loc=loc)
}

fn a_kbd_arc_pts(pts : Array[Double], cx : Double, cy : Double, r : Double, a0 : Double, a1 : Double, steps : Int) -> Unit {
  let mut i = 0
  while i <= steps {
    let t = i.to_double() / steps.to_double()
    let ang = a0 + (a1 - a0) * t
    pts.push(cx + r * dmath::cos(ang))
    pts.push(cy + r * dmath::sin(ang))
    i += 1
  }
}

/// Deterministic vector `⌘` (U+2318) glyph inside a 13x20 logical box so macOS Metal and Linux GLES
/// render identical bbox and vertical baseline centroid regardless of platform fallback fonts.
fn a_kbd_command_shapes(ink : Int64) -> Array[paint::Shape] {
  let cx = 6.3
  let cy = 9.3
  let a = 1.95
  let r = 1.75
  let pi = 3.141592653589793
  let pts : Array[Double] = []
  // Top-right 270deg loop -> down right bar
  a_kbd_arc_pts(pts, cx + a + r, cy - a - r, r, pi * 0.5, -pi, 12)
  // Bottom-right 270deg loop -> left along bottom bar
  a_kbd_arc_pts(pts, cx + a + r, cy + a + r, r, pi, -pi * 0.5, 12)
  // Bottom-left 270deg loop -> up left bar
  a_kbd_arc_pts(pts, cx - a - r, cy + a + r, r, -pi * 0.5, -pi * 2.0, 12)
  // Top-left 270deg loop -> right along top bar back to start
  a_kbd_arc_pts(pts, cx - a - r, cy - a - r, r, 0.0, -pi * 1.5, 12)
  [paint::shape_of([(pts, true)], stroke=ink, width=0.85)]
}

/// Aura `KbdAbbr` key symbol slot (Builder API).
pub fn kbd_abbr_node(
  parent : view::View,
  key : AuraKbdKey,
  loc~ : String = "",
) -> view::View {
  let use_vector_cmd = key is AuraKbdKey::Command || key is AuraKbdKey::Win
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .says(view::Live::Is(Some(view::said(view::Role::Text, label=aura_kbd_key_label(key)))))
    if use_vector_cmd {
      let _ = node
        .width(view::Live::Is(Some(12.6)))
        .height(view::Live::Is(Some(20.0)))
        .shrink(view::Live::Is(0.0))
        .shapes(view::Live::By(fn() -> Array[paint::Shape] {
          a_kbd_command_shapes(aura_theme(node).palette.muted)
        }))
    } else {
      let _ = node
        .words(view::Live::Is(aura_kbd_key_symbol(key)), look=a_kbd_words_look())
        .ink(view::Live::By(fn() -> Int64 { aura_theme(node).palette.muted }))
    }
  })
}

/// Pion-JSX `<aura::KbdAbbr>` wrapper.
pub fn KbdAbbr(
  parent : view::View,
  key~ : AuraKbdKey = AuraKbdKey::Command,
  loc~ : String = "",
) -> view::View {
  kbd_abbr_node(parent, key, loc=loc)
}

/// Aura `KbdContent` key text slot (Builder API).
pub fn kbd_content_node(
  parent : view::View,
  text : view::Live[String],
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .words(text, look=a_kbd_words_look())
      .ink(view::Live::By(fn() -> Int64 { aura_theme(node).palette.muted }))
  })
}

/// Pion-JSX `<aura::KbdContent>` wrapper.
pub fn KbdContent(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  kbd_content_node(parent, t, loc=loc)
}
