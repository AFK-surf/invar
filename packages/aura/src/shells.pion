// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): 3 internal shared pixel shells for Wave 1+ components:
// - `w0_popover_shell`: Overlay surface (`--overlay`, circular radius, 3-layer overlay shadow in light,
//   1px bright inner rim in dark as first `points(false)` child, explicitly re-borrows `AuraSurfaceLevel::Overlay`).
// - `w0_listbox_shell`: Overlay/surface listbox wrapper with standard padding and circular radius.
// - `w0_field_shell`: Form input/trigger wrapper with `--field-background`, `field_radius` (12pt),
//   3-layer field shadow in light, and exact per-slot focus + invalid ring grammar.

import "signals"
import "view"

/// Internal shared popover/overlay panel shell (`w0_popover_shell`).
pub fn w0_popover_shell(
  parent : view::View,
  radius? : Double,
  pad~ : Double = 16.0,
  gap~ : Double = 8.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let ov_sig = signals::signal(AuraSurfaceLevel::Overlay)
  parent.box(loc=loc, fn(panel : view::View) -> Unit {
    let _ = aura_provide_surface(panel, ov_sig)
    let rad : view::Live[Double] = view::Live::By(fn() -> Double {
      match radius {
        Some(r) => r
        None => aura_theme(panel).overlay_radius
      }
    })
    let _ = panel
      .corner_circular(view::Live::Is(true))
      .radius(rad)
      .ground(view::Live::By(fn() -> Int64 { aura_theme(panel).palette.overlay }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        aura_overlay_shadows(aura_theme(panel).config.dark)
      }))
    w0_mount_dark_overlay_rim(panel, rad)
    if pad > 0.0 {
      let _ = panel.pad(view::Live::Is(pad))
    }
    if gap > 0.0 {
      let _ = panel.gap(view::Live::Is(gap))
    }
    content(panel)
  })
}

/// Internal shared listbox / menu panel shell (`w0_listbox_shell`).
pub fn w0_listbox_shell(
  parent : view::View,
  pad~ : Double = 4.0,
  gap~ : Double = 2.0,
  in_overlay~ : Bool = true,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  if in_overlay {
    w0_popover_shell(parent, radius=16.0, pad=pad, gap=gap, content=content, loc=loc)
  } else {
    surface_node(
      parent,
      variant=AuraSurfaceVariant::Default,
      radius=16.0,
      pad=pad,
      gap=gap,
      shadow=true,
      content=content,
      loc=loc,
    )
  }
}

fn w0_field_effective_variant(field : view::View, variant : AuraFieldVariant) -> AuraFieldVariant {
  aura_field_effective_variant(field, variant)
}

/// Internal shared form field shell (`w0_field_shell`) with exact per-slot focus and invalid ring grammar.
pub fn w0_field_shell(
  parent : view::View,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  height? : Double,
  pad_x~ : Double = 12.0,
  force_focused~ : Bool = false,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let dis_get = disabled.to_getter()
  parent.box(loc=loc, fn(field : view::View) -> Unit {
    let _ = field
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .gap(view::Live::Is(8.0))
      .pad_xy(pad_x, 0.0)
      .corner_circular(view::Live::Is(true))
      .radius(view::Live::By(fn() -> Double { aura_theme(field).field_radius }))
      .height(view::Live::By(fn() -> Option[Double] {
        match height {
          Some(h) => Some(h)
          None => Some(if aura_is_md(field) { 36.0 } else { 40.0 })
        }
      }))
      .ground(view::Live::By(fn() -> Int64 {
        let th = aura_theme(field)
        let eff = w0_field_effective_variant(field, variant)
        if variant is AuraFieldVariant::Auto {
          aura_field_bg(field, th.palette, AuraFieldVariant::Auto)
        } else {
          aura_field_bg(field, th.palette, eff)
        }
      }))
      .shadows(view::Live::By(fn() -> Array[view::Shadow] {
        if w0_field_effective_variant(field, variant) is AuraFieldVariant::Primary {
          aura_surface_shadows(aura_theme(field).config.dark)
        } else {
          []
        }
      }))
      .group_alpha(view::Live::By(fn() -> Double {
        if dis_get() { aura_theme(field).disabled_opacity } else { 1.0 }
      }))
    let _ = w0_apply_field_focus_ring(field, invalid, force_focused=force_focused)
    content(field)
  })
}
