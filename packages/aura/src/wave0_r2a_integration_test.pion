// Wave 0 R2-A, from the host's key entry (view_key, as every host's keys arrive): headless_core's key codes are ui's,
// and of two sibling Selectors and a DataGrid in one tree, only the one the focus is in takes a key. Backspace and
// Delete clear the focused closed Select, Copy (13) clears nothing, Tab / Shift+Tab move the focus on and close the
// popup, the pointer over an option makes it the active one, and the item browsed to is never said selected.

import "headless"
import "headless_core"
import "signals"
import "ui"
import "view"

fn r2a_ui_strs_are(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

fn r2a_ui_active_is(s : headless::Selector[String], want : String) -> Bool {
  match s.active_key() {
    Some(k) => k == want
    None => false
  }
}

fn r2a_ui_said(id : view::NodeId) -> Option[view::Said] {
  match ui::view_tree() {
    Some(tr) => {
      for sn in tr.said_order() {
        if sn.id == id {
          return sn.said
        }
      }
      None
    }
    None => None
  }
}

fn r2a_ui_selected(v : view::View) -> Bool {
  match r2a_ui_said(v.id()) {
    Some(sd) =>
      match sd.selected {
        Some(b) => b
        None => false
      }
    None => false
  }
}

/// A single-choice Selector over `items` in `root`: its trigger 160x32, its listbox (while open) of 160x28 options.
fn r2a_ui_selector(
  root : view::View,
  label : String,
  items : Array[String],
  initial : Array[String],
  sel_ref : signals::Ref[Option[headless::Selector[String]]],
  trig_ref : signals::Ref[Option[view::View]],
  opts : Map[String, view::View],
  changes : signals::Ref[Int],
) -> Unit {
  let _ = headless::selector(
    root,
    fn() -> String { label },
    fn() -> Array[String] { items },
    fn() -> Array[String] { items },
    fn(k : String) -> String { k },
    fn(v : view::View, s : headless::Selector[String]) {
      sel_ref.v = Some(s)
      trig_ref.v = Some(s.trigger(v, fn(tv : view::View, _s : headless::Selector[String]) {
        let _ = tv.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(32.0)))
      }))
      let _ = v.show(
        fn() -> Bool { s.is_open() },
        fn(host : view::View) {
          let _ = s.listbox(host, fn(lv : view::View) {
            for k in items {
              opts[k] = s.option(lv, k, fn() -> String { k }, fn(ov : view::View, _a : () -> Bool, _c : () -> Bool) {
                let _ = ov.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(28.0)))
              })
            }
          })
        },
        at_once=true,
      )
    },
    initial_selected=initial,
    on_selection_change=fn(_a : Array[String]) { changes.v = changes.v + 1 },
  )
}

test "r2a-ui-01 headless_core key codes and modifier bits equal ui's, never drifting" {
  debug_assert(headless_core::key_backspace == ui::key_code_backspace, "backspace")
  debug_assert(headless_core::key_delete == ui::key_code_delete, "delete")
  debug_assert(headless_core::key_left == ui::key_code_left, "left")
  debug_assert(headless_core::key_right == ui::key_code_right, "right")
  debug_assert(headless_core::key_up == ui::key_code_up, "up")
  debug_assert(headless_core::key_down == ui::key_code_down, "down")
  debug_assert(headless_core::key_enter == ui::key_code_enter && headless_core::key_enter == ui::key_enter, "enter")
  debug_assert(headless_core::key_home == ui::key_code_home, "home")
  debug_assert(headless_core::key_end == ui::key_code_end, "end")
  debug_assert(headless_core::key_select_all == ui::key_code_select_all, "select all")
  debug_assert(headless_core::key_copy == ui::key_code_copy, "copy")
  debug_assert(headless_core::key_cut == ui::key_code_cut, "cut")
  debug_assert(headless_core::key_page_up == ui::key_code_page_up, "page up")
  debug_assert(headless_core::key_page_down == ui::key_code_page_down, "page down")
  debug_assert(headless_core::key_escape == ui::key_escape, "escape")
  debug_assert(headless_core::key_tab == ui::key_tab, "tab")
  debug_assert(headless_core::key_space == ui::key_space && headless_core::key_space == ui::key_of_char(' '), "space")
  debug_assert(headless_core::key_char_base + 97 == ui::key_of_char('a'), "char base")
  debug_assert(headless_core::mod_shift == ui::mod_shift_key, "shift")
  debug_assert(headless_core::mod_ctrl == ui::mod_ctrl, "ctrl")
  debug_assert(headless_core::mod_alt == ui::mod_alt, "alt")
  debug_assert(headless_core::mod_cmd == ui::mod_cmd, "cmd")
  // Copy is never Delete or Backspace
  debug_assert(ui::key_code_copy != headless_core::key_delete && ui::key_code_copy != headless_core::key_backspace, "copy apart")
}

test "r2a-ui-02 two sibling Selectors + a DataGrid: keys reach only the focused control; Tab closes the popup" {
  let a_ref : signals::Ref[Option[headless::Selector[String]]] = view::ref_new(None)
  let a_trig : signals::Ref[Option[view::View]] = view::ref_new(None)
  let a_opts : Map[String, view::View] = Map::new()
  let a_changes = view::ref_new(0)
  let b_ref : signals::Ref[Option[headless::Selector[String]]] = view::ref_new(None)
  let b_trig : signals::Ref[Option[view::View]] = view::ref_new(None)
  let b_opts : Map[String, view::View] = Map::new()
  let b_changes = view::ref_new(0)
  let dg_ref : signals::Ref[Option[headless::DataGrid]] = view::ref_new(None)
  let grid_changes = view::ref_new(0)
  let t = ui::Tester::tree(
    fn(root : view::View) {
      r2a_ui_selector(root, "First", ["A1", "A2", "A3"], ["A1"], a_ref, a_trig, a_opts, a_changes)
      r2a_ui_selector(root, "Second", ["B1", "B2"], ["B2"], b_ref, b_trig, b_opts, b_changes)
      let rows = ["r1", "r2"]
      let cols = ["c1", "c2"]
      let _ = headless::data_grid(
        root,
        fn() -> String { "Scores" },
        fn() -> Array[String] { rows },
        fn() -> Array[String] { cols },
        fn(v : view::View, dg : headless::DataGrid) {
          dg_ref.v = Some(dg)
          for r in rows {
            let _ = dg.row(v, r, fn(rv : view::View, _s : () -> Bool) {
              for c in cols {
                let _ = dg.cell(rv, r, c, fn() -> String { r + c }, fn(n : view::View, _f : () -> Bool) {
                  let _ = n.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(24.0)))
                })
              }
            })
          }
        },
        on_selection_change=fn(_a : Array[String]) { grid_changes.v = grid_changes.v + 1 },
      )
    },
    width=400.0,
    height=600.0,
  )
  let a = match a_ref.v { Some(x) => x; None => panic("missing First") }
  let b = match b_ref.v { Some(x) => x; None => panic("missing Second") }
  let at = match a_trig.v { Some(x) => x; None => panic("missing First trigger") }
  let bt = match b_trig.v { Some(x) => x; None => panic("missing Second trigger") }
  let dg = match dg_ref.v { Some(x) => x; None => panic("missing grid") }
  let untouched = fn(step : String) {
    debug_assert(!b.is_open() && r2a_ui_strs_are(b.selected_keys(), ["B2"]) && b_changes.v == 0, step + ": Second untouched")
    debug_assert(
      dg.selected_rows().length() == 0 && dg.focus_row().is_none() && grid_changes.v == 0,
      step + ": DataGrid untouched",
    )
  }

  let _ = at.ask_focus(visible=true)
  t.frame(ms=16.0)
  debug_assert(at.focused(), "First's trigger focused")

  // Down opens First (never Second, drawn after it), lands on its chosen A1, then moves to A2
  t.key(ui::key_code_down)
  debug_assert(a.is_open() && r2a_ui_active_is(a, "A1"), "Down opens First on its chosen A1")
  untouched("Down")
  t.key(ui::key_code_down)
  debug_assert(r2a_ui_active_is(a, "A2") && at.focused(), "Down moves First's active item; focus stays on its trigger")
  untouched("Down 2")
  // the item browsed to is the active descendant, never said selected; the chosen A1 still is
  match r2a_ui_said(at.id()) {
    Some(sd) => {
      debug_assert(sd.controls.is_some(), "trigger controls its listbox")
      debug_assert(
        match sd.active_descendant {
          Some(id) => id == a_opts["A2"].id()
          None => false
        },
        "active descendant is A2",
      )
    }
    None => panic("missing trigger said")
  }
  debug_assert(!r2a_ui_selected(a_opts["A2"]) && r2a_ui_selected(a_opts["A1"]), "browsing A2 selects nothing: A1 stays the selected one")

  // the pointer over an option makes it the active one
  let (ox, oy, ow, oh) = a_opts["A3"].placed_window_now()
  t.move_to(ox + ow / 2.0, oy + oh / 2.0)
  debug_assert(r2a_ui_active_is(a, "A3"), "pointer over A3 makes it active")
  t.key(ui::key_code_up)
  debug_assert(r2a_ui_active_is(a, "A2"), "Up from A3 to A2")

  // Enter chooses A2 in First alone and closes it
  t.key(ui::key_enter)
  debug_assert(r2a_ui_strs_are(a.selected_keys(), ["A2"]) && !a.is_open() && a_changes.v == 1, "Enter chooses A2")
  untouched("Enter")

  // Copy (13) clears nothing, opens nothing
  t.key(ui::key_code_copy)
  debug_assert(r2a_ui_strs_are(a.selected_keys(), ["A2"]) && !a.is_open() && a_changes.v == 1, "Copy (13) clears nothing")
  untouched("Copy")
  // Backspace / Delete clear the focused closed First alone
  t.key(ui::key_code_backspace)
  debug_assert(a.selected_keys().length() == 0 && !a.is_open(), "Backspace clears First")
  untouched("Backspace")
  a.choose("A3")
  t.frame(ms=16.0)
  t.key(ui::key_code_delete)
  debug_assert(a.selected_keys().length() == 0 && !a.is_open(), "Delete clears First")
  untouched("Delete")

  // Ctrl+A with the focus in First never selects the grid's rows
  t.key(ui::key_of_char('a'), mods=ui::mod_ctrl)
  untouched("Ctrl+A")

  // Tab with First open: the focus goes on to Second's trigger, First's popup closes, Second stays closed
  t.key(ui::key_code_down)
  debug_assert(a.is_open(), "First open again")
  t.key(ui::key_tab)
  debug_assert(bt.focused() && !at.focused(), "Tab moves the focus to Second")
  debug_assert(!a.is_open(), "Tab closed First's popup")
  debug_assert(!b.is_open() && b_changes.v == 0, "Second not opened by the Tab")
  // Shift+Tab back, open First, Shift+Tab out of it (backwards past the first stop): its popup closes
  t.key(ui::key_tab, mods=ui::mod_shift_key)
  debug_assert(at.focused(), "Shift+Tab back to First")
  t.key(ui::key_code_down)
  debug_assert(a.is_open(), "First open")
  t.key(ui::key_tab, mods=ui::mod_shift_key)
  debug_assert(!at.focused() && !a.is_open(), "Shift+Tab out of First closes its popup")
  debug_assert(!b.is_open(), "Second still closed")
  // a click on an option chooses it (the popup's own press never counts as the focus leaving before it lands)
  let _ = at.ask_focus(visible=true)
  t.frame(ms=16.0)
  t.key(ui::key_code_down)
  debug_assert(a.is_open(), "First open for a click")
  let (cx, cy, cw, ch) = a_opts["A3"].placed_window_now()
  t.click(cx + cw / 2.0, cy + ch / 2.0)
  debug_assert(r2a_ui_strs_are(a.selected_keys(), ["A3"]) && !a.is_open(), "clicking A3 chooses it and closes")
  untouched("click")
  debug_assert(t.unasked_faults().length() == 0, "no unasked frames")
  t.dispose()
}
