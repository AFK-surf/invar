// Aura Wave 1.5A — ComboBox compound component (Builder + Pion-JSX).
// Built on `headless::selector` (filterable=true), `ui::Field`, `w0_field_shell`, `w0_popover_shell`.
// Strictly separates `query`, `active_key`, `selected_keys` (single + multi), and `open`;
// keeps keyboard focus on the `Field` with live virtual focus (`controls` + `active_descendant`),
// guards IME composition, preserves `selected_keys` across filtering, and supports full RTL.

import "headless"
import "headless_core"
import "signals"
import "ui"
import "view"

struct XComboBoxCtx {
  sel : headless::Selector[String]
  fld : ui::Field
  idx : XSelectIndex
  filter_get : () -> XFilterResult
  variant : AuraFieldVariant
  full_width : Bool
  multiple : Bool
  invalid : view::Live[Bool]
  disabled_get : () -> Bool
  rtl_get : () -> Bool
  label_get : () -> String
  placeholder : view::Live[String]
  group_ref : signals::Ref[Option[view::View]]
  input_ref : signals::Ref[Option[view::View]]
  syncing_text : signals::Ref[Bool]
  popover_width : Option[Double]
  gap : Double
  placement : headless::Placement
  on_clear : Option[() -> Unit]
  force_focused : Bool
  force_active_ring : Bool
}

let x_combobox_ctx_lent : view::Lent[XComboBoxCtx] = view::Lent::new()

/// Aura `ComboBoxInput` (Builder API): inline `ui::Field` wired with `Role::Combobox`, `controls`,
/// `active_descendant`, IME guard, and filter-safe query updates.
pub fn combo_box_input_node(
  parent : view::View,
  placeholder? : view::Live[String],
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_combobox_ctx_lent) {
    Some(c) => {
      let sel = c.sel
      let fld = c.fld
      let dis_get = c.disabled_get
      let rtl_get = c.rtl_get
      let lbl_get = c.label_get
      let syncing_text = c.syncing_text
      let ph = match placeholder { Some(p) => p; None => c.placeholder }
      let ph_get = ph.to_getter()
      let fnode = ui::field(
        parent,
        fld,
        placeholder_by=ph_get,
        size_by=fn() -> Double { 14.0 },
        rtl_by=rtl_get,
        line=20.0,
        min_lines=1,
        max_lines=1,
        enter_sends=false,
        leaves=[
          headless_core::key_down,
          headless_core::key_up,
          headless_core::key_enter,
          headless_core::key_escape,
          headless_core::key_tab,
          headless_core::key_page_up,
          headless_core::key_page_down,
        ],
        label=signals::untracked(lbl_get),
        colors_by=fn() -> (Int64, Int64, Int64) {
          let pal = aura_theme(parent).palette
          (pal.field_foreground, pal.field_placeholder, pal.focus)
        },
        edit=fn(e : ui::FieldEdit) -> Unit {
          if dis_get() {
            if fld.text() != e.was {
              fld.set(e.was)
            }
            return
          }
          if !syncing_text.v {
            sel.set_query(e.now, open_if_closed=true)
          }
        },
      )
      c.input_ref.v = Some(fnode)
      let _ = fnode
        .grow(view::Live::Is(1.0))
        .shrink(view::Live::Is(1.0))
        .min_width(view::Live::Is(Some(0.0)))
        .focusable(view::Live::By(fn() -> Bool { !dis_get() }), keys=0)
        .presses(view::Live::By(fn() -> Bool { !dis_get() }))
        .says(view::Live::By(fn() -> Option[view::Said] {
          let l = lbl_get()
          let lbl = if l.length() > 0 { l } else { ph_get() }
          let acts : Array[view::Action] = if dis_get() { [] } else { [view::Action::SetText("")] }
          Some(view::said(
            view::Role::Combobox,
            label=lbl,
            value=fld.text(),
            expanded=sel.is_open(),
            controls=sel.controls_id(),
            active_descendant=sel.active_descendant_id(),
            actions=acts,
          ))
        }))
        .on_key(fn(k : view::Key) -> Bool {
          if !fnode.focus_within() {
            return false
          }
          if fld.composing() {
            return false
          }
          sel.handle_key(k, fnode.cause_at())
        })
      fnode.reacts(
        fn() -> Bool { fnode.focused() },
        fn(foc : Bool) -> Unit {
          if foc && !fld.focused() && !dis_get() {
            fld.focus()
          }
        },
      )
      let _ = loc
      fnode
    }
    None => parent.box(fn(_v : view::View) { () }, loc=loc)
  }
}

/// Pion-JSX `<aura::ComboBoxInput>` wrapper.
pub fn ComboBoxInput(
  parent : view::View,
  placeholder? : view::Live[String],
  placeholder_by? : () -> String,
  loc~ : String = "",
) -> view::View {
  let ph : Option[view::Live[String]] = match placeholder_by {
    Some(f) => Some(view::Live::By(f))
    None => placeholder
  }
  combo_box_input_node(parent, placeholder?=ph, loc=loc)
}

/// Aura `ComboBoxClearButton` (Builder API): clears selection and query without opening the popover.
pub fn combo_box_clear_button_node(
  parent : view::View,
  label~ : String = "Clear",
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_combobox_ctx_lent) {
    Some(c) =>
      x_clear_button_node(
        parent,
        fn() -> Bool { c.sel.selected_keys().length() > 0 || c.fld.text() != "" },
        c.disabled_get,
        fn() -> Unit {
          c.sel.clear(clear_query=true)
          match c.on_clear {
            Some(f) => f()
            None => ()
          }
          let post = signals::untracked(fn() -> Array[String] { c.sel.selected_keys() })
          let want = if !c.multiple && post.length() > 0 { c.idx.label_of(post[0]) } else { "" }
          c.syncing_text.v = true
          c.fld.set(want)
          c.syncing_text.v = false
        },
        label=label,
        guard_sel=c.sel,
        loc=loc,
      )
    None => parent.box(fn(_v : view::View) { () }, loc=loc)
  }
}

/// Pion-JSX `<aura::ComboBoxClearButton>` wrapper.
pub fn ComboBoxClearButton(
  parent : view::View,
  label~ : String = "Clear",
  loc~ : String = "",
) -> view::View {
  combo_box_clear_button_node(parent, label=label, loc=loc)
}

/// Aura `ComboBoxTrigger` (Builder API): chevron toggle button at the trailing edge of `ComboBoxInputGroup`.
pub fn combo_box_trigger_node(
  parent : view::View,
  label~ : String = "Toggle options",
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_combobox_ctx_lent) {
    Some(c) => {
      let btn_v = headless::button(
        parent,
        fn() -> String { label },
        fn(_v : view::View) -> Unit {
          if !(c.disabled_get)() {
            let next = !c.sel.is_open()
            c.sel.set_open(next)
            match c.input_ref.v {
              Some(in_v) => {
                let _ = in_v.ask_focus(visible=false)
                c.fld.focus()
              }
              None => ()
            }
          }
        },
        fn(btn : view::View, b : headless::Button) -> Unit {
          let _ = btn
            .row(view::Live::Is(true))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .width(view::Live::Is(Some(24.0)))
            .height(view::Live::Is(Some(28.0)))
            .shrink(view::Live::Is(0.0))
            .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(btn) }))
            .radius(view::Live::Is(6.0))
            .group_alpha(view::Live::By(fn() -> Double {
              if b.disabled() { aura_theme(btn).disabled_opacity } else if b.pressed() { 0.7 } else { 1.0 }
            }))
          let _ = w0_apply_control_focus_ring(btn)
          let ink_get = fn() -> Int64 {
            let pal = aura_theme(btn).palette
            if !b.disabled() && !aura_is_coarse_pointer(btn) && b.hovered() {
              pal.field_foreground
            } else {
              d_with_alpha(pal.field_foreground, 0.7)
            }
          }
          let sel = c.sel
          let _ = btn.show(
            fn() -> Bool { sel.is_open() },
            fn(up_v : view::View) -> Unit {
              let _ = aura_icon_node(up_v, AuraIconKind::ChevronUp, size=16.0, ink=ink_get)
            },
            at_once=true,
          )
          let _ = btn.show(
            fn() -> Bool { !sel.is_open() },
            fn(dn_v : view::View) -> Unit {
              let _ = aura_icon_node(dn_v, AuraIconKind::ChevronDown, size=16.0, ink=ink_get)
            },
            at_once=true,
          )
        },
        disabled=c.disabled_get,
        loc=loc,
      )
      let _ = btn_v.tab_stop(view::Live::Is(false))
      c.sel.guard_press(btn_v)
      btn_v
    }
    None => parent.box(fn(_v : view::View) { () }, loc=loc)
  }
}

/// Pion-JSX `<aura::ComboBoxTrigger>` wrapper.
pub fn ComboBoxTrigger(
  parent : view::View,
  label~ : String = "Toggle options",
  loc~ : String = "",
) -> view::View {
  combo_box_trigger_node(parent, label=label, loc=loc)
}

/// Aura `ComboBoxInputGroup` (Builder API): single `w0_field_shell` wrapping `ComboBoxInput`, optional
/// `ComboBoxClearButton`, and `ComboBoxTrigger` with flush `focused || focus_within` 2pt focus ring.
pub fn combo_box_input_group_node(
  parent : view::View,
  content? : (view::View) -> Unit,
  clearable~ : Bool = false,
  force_focused~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  match parent.lent(x_combobox_ctx_lent) {
    Some(c) => {
      let sel = c.sel
      let fld = c.fld
      let rtl_get = c.rtl_get
      let dis_get = c.disabled_get
      let inv_live = c.invalid
      let variant = c.variant
      let full_width = c.full_width
      let group_ref = c.group_ref
      let foc_force = force_focused || c.force_focused
      let shell = w0_field_shell(
        parent,
        variant=variant,
        invalid=inv_live,
        disabled=view::Live::By(dis_get),
        height=36.0,
        pad_x=0.0,
        force_focused=foc_force,
        content=fn(grp : view::View) -> Unit {
          group_ref.v = Some(grp)
          sel.add_scope(grp)
          let _ = grp
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(rtl_get))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(4.0))
            .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
              if rtl_get() { (4.0, 0.0, 12.0, 0.0) } else { (12.0, 0.0, 4.0, 0.0) }
            }))
            .on_key(fn(k : view::Key) -> Bool {
              if fld.composing() {
                return false
              }
              if !sel.owns_focus() {
                return false
              }
              sel.handle_key(k, grp.cause_at())
            })
          if !c.multiple {
            let restore_label = fn() -> Unit {
              let keys = signals::untracked(fn() -> Array[String] { sel.selected_keys() })
              let want = if keys.length() > 0 { c.idx.label_of(keys[0]) } else { "" }
              if fld.text() != want {
                c.syncing_text.v = true
                fld.set(want)
                c.syncing_text.v = false
              }
              if signals::untracked(fn() -> String { sel.query() }) != "" {
                sel.set_query("", open_if_closed=false)
              }
            }
            let had_focus = view::ref_new(false)
            let was_pressing = view::ref_new(false)
            grp.reacts(
              fn() -> Int {
                (if sel.focus_in_scope() { 2 } else { 0 }) + (if sel.press_in_scope() { 1 } else { 0 })
              },
              fn(bits : Int) -> Unit {
                let f = bits >= 2
                let p = (bits % 2) == 1
                if p {
                  was_pressing.v = true
                }
                if f {
                  had_focus.v = true
                  if !p {
                    was_pressing.v = false
                  }
                  return
                }
                if p {
                  return
                }
                if !had_focus.v {
                  was_pressing.v = false
                  return
                }
                had_focus.v = false
                if was_pressing.v {
                  was_pressing.v = false
                  let _ = grp.at_moment(grp.cause_at() + 0.001, fn() -> Unit {
                    if !sel.owns_focus() && !signals::untracked(fn() -> Bool { sel.press_in_scope() }) {
                      restore_label()
                    }
                  }, later=true)
                } else {
                  restore_label()
                }
              },
              at_start=false,
            )
            let was_open = view::ref_new(signals::untracked(fn() -> Bool { sel.is_open() }))
            grp.reacts(
              fn() -> Bool { sel.is_open() },
              fn(now_open : Bool) -> Unit {
                if was_open.v && !now_open {
                  restore_label()
                }
                was_open.v = now_open
              },
              at_start=false,
            )
          }
          match content {
            Some(ch) => ch(grp)
            None => {
              let _ = combo_box_input_node(grp)
              if clearable {
                let _ = combo_box_clear_button_node(grp)
              }
              let _ = combo_box_trigger_node(grp)
            }
          }
        },
        loc=loc,
      )
      b_apply_field_surface(shell, variant, fn() -> Bool { inv_live.eval() }, dis_get, foc_force)
      if full_width {
        let _ = shell.fills_across(view::Live::Is(true))
      }
      shell
    }
    None => parent.box(fn(_v : view::View) { () }, loc=loc)
  }
}

/// Pion-JSX `<aura::ComboBoxInputGroup>` wrapper.
pub fn ComboBoxInputGroup(
  parent : view::View,
  clearable~ : Bool = false,
  force_focused~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  combo_box_input_group_node(parent, content?=children, clearable=clearable, force_focused=force_focused, loc=loc)
}

/// Aura `ComboBoxPopover` (Builder API): portal-mounted overlay listbox anchored to `ComboBoxInputGroup`.
pub fn combo_box_popover_node(
  parent : view::View,
  content? : (view::View, headless::Selector[String]) -> Unit,
  placement? : headless::Placement,
  gap? : Double,
  width? : Double,
  loc~ : String = "",
) -> view::View {
  let _ = loc
  match parent.lent(x_combobox_ctx_lent) {
    Some(c) => {
      let eff_placement = match placement { Some(p) => p; None => c.placement }
      let eff_gap = match gap { Some(g) => g; None => c.gap }
      let eff_w = match width { Some(w) => Some(w); None => c.popover_width }
      x_mount_selector_popover(
        parent,
        fn() -> Bool { c.sel.is_open() },
        c.group_ref,
        eff_placement,
        eff_gap,
        eff_w,
        c.rtl_get,
        fn(panel : view::View) -> Unit {
          x_mount_scrollable_listbox(
            panel,
            c.sel,
            fn() -> Double { x_popover_list_max_height(parent, c.group_ref, eff_gap, 0.0) },
            fn(lv : view::View) -> Unit {
              match content {
                Some(ch) => ch(lv, c.sel)
                None =>
                  x_render_selector_options(
                    lv,
                    c.sel,
                    c.idx,
                    c.filter_get,
                    c.rtl_get,
                    show_active_ring=true,
                    force_active_ring=c.force_active_ring,
                  )
              }
            },
          )
        },
      )
      parent
    }
    None => parent
  }
}

/// Pion-JSX `<aura::ComboBoxPopover>` wrapper.
pub fn ComboBoxPopover(
  parent : view::View,
  placement? : headless::Placement,
  gap? : Double,
  width? : Double,
  children? : (view::View, headless::Selector[String]) -> Unit,
  loc~ : String = "",
) -> view::View {
  combo_box_popover_node(parent, content?=children, placement?=placement, gap?=gap, width?=width, loc=loc)
}

/// Aura `ComboBox` compound component (Builder API).
pub fn combo_box_node(
  parent : view::View,
  items : Array[AuraSelectOption],
  label~ : view::Live[String] = view::Live::Is(""),
  placeholder~ : view::Live[String] = view::Live::Is("Search..."),
  description~ : view::Live[String] = view::Live::Is(""),
  error~ : view::Live[String] = view::Live::Is(""),
  field? : ui::Field,
  initial_selected~ : Array[String] = [],
  selected_keys? : () -> Array[String],
  initial_query~ : String = "",
  multiple~ : Bool = false,
  clearable~ : Bool = false,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  required~ : Bool = false,
  invalid~ : view::Live[Bool] = view::Live::Is(false),
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  rtl~ : Bool = false,
  dir~ : String = "",
  default_open~ : Bool = false,
  open? : () -> Bool,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  popover_width? : Double,
  force_focused~ : Bool = false,
  force_active_ring~ : Bool = false,
  on_open_change? : (Bool) -> Unit,
  on_selection_change? : (Array[String]) -> Unit,
  on_query_change? : (String) -> Unit,
  on_clear? : () -> Unit,
  selector_ref? : signals::Ref[Option[headless::Selector[String]]],
  field_ref? : signals::Ref[Option[ui::Field]],
  content? : (view::View, headless::Selector[String]) -> Unit,
  loc~ : String = "",
) -> view::View {
  let idx = XSelectIndex::new(items)
  let init_keys : Array[String] = match selected_keys {
    Some(sk) => signals::untracked(sk)
    None => initial_selected
  }
  let init_text = if initial_query != "" {
    initial_query
  } else if !multiple && init_keys.length() > 0 {
    idx.label_of(init_keys[0])
  } else {
    ""
  }
  let fld = match field {
    Some(f) => {
      if f.text() == "" && init_text != "" {
        f.set(init_text)
      }
      f
    }
    None => ui::Field::new(text=init_text)
  }
  match field_ref {
    Some(r) => r.v = Some(fld)
    None => ()
  }
  let lbl_get = label.to_getter()
  let ph_get = placeholder.to_getter()
  let desc_get = description.to_getter()
  let err_get = error.to_getter()
  let dis_get = disabled.to_getter()
  let eff_dis = fn() -> Bool { x_effective_disabled(parent, dis_get) }
  let group_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let input_ref : signals::Ref[Option[view::View]] = view::ref_new(None)
  let syncing_text : signals::Ref[Bool] = view::ref_new(false)
  let sel_holder : signals::Ref[Option[headless::Selector[String]]] = view::ref_new(None)

  let filter_memo = x_make_filter_memo(idx, fn() -> String {
    match sel_holder.v {
      Some(s) => s.query()
      None => ""
    }
  })
  let filter_get = fn() -> XFilterResult { filter_memo.get() }
  let all_k = fn() -> Array[String] { idx.all_keys }
  let vis_k = fn() -> Array[String] { filter_memo.get().keys }
  let eff_lbl = fn() -> String {
    let l = lbl_get()
    if l != "" { l } else { ph_get() }
  }

  headless::selector(
    parent,
    eff_lbl,
    all_k,
    vis_k,
    fn(k : String) -> String { idx.label_of(k) },
    fn(root : view::View, sel : headless::Selector[String]) -> Unit {
      sel_holder.v = Some(sel)
      match selector_ref {
        Some(r) => r.v = Some(sel)
        None => ()
      }
      if initial_query != "" {
        sel.set_query(initial_query, open_if_closed=false)
      }
      let eff_rtl = fn() -> Bool { x_effective_rtl(root, rtl, dir) }
      let eff_inv = fn() -> Bool { invalid.eval() || err_get() != "" }

      let ctx = XComboBoxCtx::{
        sel,
        fld,
        idx,
        filter_get,
        variant,
        full_width,
        multiple,
        invalid: view::Live::By(eff_inv),
        disabled_get: eff_dis,
        rtl_get: eff_rtl,
        label_get: eff_lbl,
        placeholder,
        group_ref,
        input_ref,
        syncing_text,
        popover_width,
        gap,
        placement,
        on_clear,
        force_focused,
        force_active_ring,
      }
      let _ = root.lends(x_combobox_ctx_lent, ctx)
      let _ = root.gap(view::Live::Is(4.0))
      if full_width {
        let _ = root.fills_across(view::Live::Is(true))
      }

      match content {
        Some(ch) => ch(root, sel)
        None => {
          let _ = root.show(
            fn() -> Bool { lbl_get() != "" },
            fn(lw : view::View) -> Unit {
              let _ = lw
                .fills_across(view::Live::Is(true))
                .row(view::Live::Is(true))
                .lies_along(view::Live::By(fn() -> view::Lies {
                  if eff_rtl() { view::Lies::End } else { view::Lies::Start }
                }))
              let _ = label_node(lw, label, required=required, disabled=view::Live::By(eff_dis))
            },
            at_once=true,
          )
          let _ = combo_box_input_group_node(root, clearable=clearable, force_focused=force_focused)
          let _ = combo_box_popover_node(root)
          let _ = root.show(
            fn() -> Bool { !eff_inv() && desc_get() != "" },
            fn(dv : view::View) -> Unit { let _ = description_node(dv, description) },
            at_once=true,
          )
          let _ = root.show(
            fn() -> Bool { eff_inv() && err_get() != "" },
            fn(ev : view::View) -> Unit { let _ = error_message_node(ev, error) },
            at_once=true,
          )
        }
      }

      if !multiple {
        match selected_keys {
          Some(sk) =>
            root.reacts_by(
              sk,
              fn(a : Array[String], b : Array[String]) -> Bool {
                if a.length() != b.length() {
                  return false
                }
                let mut i = 0
                while i < a.length() {
                  if a[i] != b[i] {
                    return false
                  }
                  i += 1
                }
                true
              },
              fn(keys : Array[String]) -> Unit {
                let want = if keys.length() > 0 { idx.label_of(keys[0]) } else { "" }
                if fld.text() != want {
                  syncing_text.v = true
                  fld.set(want)
                  syncing_text.v = false
                }
              },
              at_start=false,
            )
          None => ()
        }
      }

      if default_open && open is None {
        sel.set_open(true)
      }
    },
    initial_selected=initial_selected,
    multiple=multiple,
    filterable=true,
    key_disabled=fn(k : String) -> Bool { idx.disabled_of(k) },
    disabled=eff_dis,
    composing=fn() -> Bool { fld.composing() },
    open_by?=open,
    selected_by?=selected_keys,
    on_open_change?=on_open_change,
    on_selection_change=fn(keys : Array[String]) -> Unit {
      if !multiple {
        if selected_keys is None {
          syncing_text.v = true
          if keys.length() > 0 {
            fld.set(idx.label_of(keys[0]))
          } else {
            fld.set("")
          }
          syncing_text.v = false
        }
        match sel_holder.v {
          Some(s) =>
            if signals::untracked(fn() -> String { s.query() }) != "" {
              s.set_query("", open_if_closed=false)
            }
          None => ()
        }
        // Return keyboard focus to the input after pointer-clicking an option in single-select.
        match input_ref.v {
          Some(in_v) if in_v.alive() && !in_v.focused() => {
            let _ = in_v.ask_focus(visible=false)
            fld.focus()
          }
          _ => ()
        }
      } else {
        // Keep focus in the input after clicking an option in multi-select so the popup stays open.
        match (sel_holder.v, input_ref.v) {
          (Some(s), Some(in_v)) =>
            if signals::untracked(fn() -> Bool { s.is_open() }) && !s.owns_focus() && in_v.alive() {
              let _ = in_v.ask_focus(visible=false)
              fld.focus()
            }
          _ => ()
        }
      }
      match on_selection_change {
        Some(f) => f(keys)
        None => ()
      }
    },
    on_query_change?=on_query_change,
    loc=loc,
  )
}

/// Pion-JSX `<aura::ComboBox>` wrapper.
pub fn ComboBox(
  parent : view::View,
  items~ : Array[AuraSelectOption] = [],
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  into placeholder~ : view::Live[String] = .Is("Search..."),
  placeholder_by? : () -> String,
  into description~ : view::Live[String] = .Is(""),
  description_by? : () -> String,
  into error~ : view::Live[String] = .Is(""),
  error_by? : () -> String,
  field? : ui::Field,
  initial_selected~ : Array[String] = [],
  selected_keys? : () -> Array[String],
  initial_query~ : String = "",
  multiple~ : Bool = false,
  clearable~ : Bool = false,
  variant~ : AuraFieldVariant = AuraFieldVariant::Primary,
  full_width~ : Bool = true,
  required~ : Bool = false,
  into invalid~ : view::Live[Bool] = .Is(false),
  invalid_by? : () -> Bool,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  rtl~ : Bool = false,
  dir~ : String = "",
  default_open~ : Bool = false,
  open? : () -> Bool,
  placement~ : headless::Placement = headless::Placement::BelowStart,
  gap~ : Double = 8.0,
  popover_width? : Double,
  force_focused~ : Bool = false,
  force_active_ring~ : Bool = false,
  on_open_change? : (Bool) -> Unit,
  on_selection_change? : (Array[String]) -> Unit,
  on_query_change? : (String) -> Unit,
  on_clear? : () -> Unit,
  selector_ref? : signals::Ref[Option[headless::Selector[String]]],
  field_ref? : signals::Ref[Option[ui::Field]],
  children? : (view::View, headless::Selector[String]) -> Unit,
  loc~ : String = "",
) -> view::View {
  let l = match label_by { Some(f) => view::Live::By(f); None => label }
  let ph = match placeholder_by { Some(f) => view::Live::By(f); None => placeholder }
  let d = match description_by { Some(f) => view::Live::By(f); None => description }
  let e = match error_by { Some(f) => view::Live::By(f); None => error }
  let inv = match invalid_by { Some(f) => view::Live::By(f); None => invalid }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  combo_box_node(
    parent,
    items,
    label=l,
    placeholder=ph,
    description=d,
    error=e,
    field?=field,
    initial_selected=initial_selected,
    selected_keys?=selected_keys,
    initial_query=initial_query,
    multiple=multiple,
    clearable=clearable,
    variant=variant,
    full_width=full_width,
    required=required,
    invalid=inv,
    disabled=dis,
    rtl=rtl,
    dir=dir,
    default_open=default_open,
    open?=open,
    placement=placement,
    gap=gap,
    popover_width?=popover_width,
    force_focused=force_focused,
    force_active_ring=force_active_ring,
    on_open_change?=on_open_change,
    on_selection_change?=on_selection_change,
    on_query_change?=on_query_change,
    on_clear?=on_clear,
    selector_ref?=selector_ref,
    field_ref?=field_ref,
    content?=children,
    loc=loc,
  )
}
