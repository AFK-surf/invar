// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Header and EmptyState layout components.

import "view"

fn a_he_words_look(size : Double, weight : Int, line : Double, wrap : Bool) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

/// Aura `Header` section heading (Builder API).
/// Mirrors `.header` (`w-full px-2 pt-1.5 pb-1 text-start text-xs font-medium text-muted`).
pub fn header_node(
  parent : view::View,
  text : view::Live[String],
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .fills_across(view::Live::Is(true))
      .padding(view::Live::Is((8.0, 6.0, 8.0, 4.0)))
    match content {
      Some(c) => c(node)
      None => {
        let _ = node.box(fn(tv : view::View) -> Unit {
          let _ = tv
            .words(text, look=a_he_words_look(12.0, 500, 16.0, false))
            .ink(view::Live::By(fn() -> Int64 { aura_theme(tv).palette.muted }))
        })
      }
    }
  })
}

/// Pion-JSX `<aura::Header>` wrapper.
pub fn Header(
  parent : view::View,
  into text~ : view::Live[String] = .Is(""),
  text_by? : () -> String,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let t = match text_by { Some(f) => view::Live::By(f); None => text }
  header_node(parent, t, content?=children, loc=loc)
}

/// Aura `EmptyState` placeholder container (Builder API).
/// Mirrors `.empty-state` (`p-2 text-sm text-muted`) with optional title, description, icon, action,
/// or custom children.
pub fn empty_state_node(
  parent : view::View,
  title? : view::Live[String],
  description? : view::Live[String],
  icon? : (view::View) -> Unit,
  action? : (view::View) -> Unit,
  pad~ : Double = 8.0,
  gap~ : Double = 4.0,
  centered~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node.fills_across(view::Live::Is(true))
    if pad > 0.0 {
      let _ = node.pad(view::Live::Is(pad))
    }
    if gap > 0.0 {
      let _ = node.gap(view::Live::Is(gap))
    }
    if centered {
      let _ = node
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
    }
    match content {
      Some(c) => c(node)
      None => {
        match icon {
          Some(ic) => ic(node)
          None => ()
        }
        match title {
          Some(t) => {
            let _ = node.box(fn(tv : view::View) -> Unit {
              if centered {
                let _ = tv.words_centered(view::Live::Is(true))
              }
              let _ = tv
                .words(t, look=a_he_words_look(14.0, 500, 20.0, true))
                .ink(view::Live::By(fn() -> Int64 { aura_theme(node).palette.foreground }))
            })
          }
          None => ()
        }
        match description {
          Some(d) => {
            let _ = node.box(fn(dv : view::View) -> Unit {
              if centered {
                let _ = dv.words_centered(view::Live::Is(true))
              }
              let _ = dv
                .words(d, look=a_he_words_look(12.0, 400, 16.0, true))
                .ink(view::Live::By(fn() -> Int64 { aura_theme(node).palette.muted }))
            })
          }
          None => ()
        }
        match action {
          Some(ac) => ac(node)
          None => ()
        }
      }
    }
  })
}

/// Pion-JSX `<aura::EmptyState>` wrapper.
pub fn EmptyState(
  parent : view::View,
  title? : view::Live[String],
  title_by? : () -> String,
  description? : view::Live[String],
  description_by? : () -> String,
  icon? : (view::View) -> Unit,
  action? : (view::View) -> Unit,
  pad~ : Double = 8.0,
  gap~ : Double = 4.0,
  centered~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let t : Option[view::Live[String]] = match title_by {
    Some(f) => Some(view::Live::By(f))
    None => title
  }
  let d : Option[view::Live[String]] = match description_by {
    Some(f) => Some(view::Live::By(f))
    None => description
  }
  empty_state_node(
    parent,
    title?=t,
    description?=d,
    icon?=icon,
    action?=action,
    pad=pad,
    gap=gap,
    centered=centered,
    content?=children,
    loc=loc,
  )
}
