// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Spinner and ScrollShadow atomic components.

import "dmath"
import "headless"
import "paint"
import "view"

/// HeroUI Spinner size tokens (`spinner.css`: Sm=16, Md=24, Lg=32, Xl=40).
#derive(Eq)
pub enum AuraSpinnerSize {
  Sm
  Md
  Lg
  Xl
}

/// HeroUI Spinner color tokens.
#derive(Eq)
pub enum AuraSpinnerColor {
  Current
  Accent
  Success
  Warning
  Danger
}

/// Logical size (in points) of `size` matching HeroUI `spinner.css` (`size-4`..`size-10`).
pub fn aura_spinner_dim(size : AuraSpinnerSize) -> Double {
  match size {
    AuraSpinnerSize::Sm => 16.0
    AuraSpinnerSize::Md => 24.0
    AuraSpinnerSize::Lg => 32.0
    AuraSpinnerSize::Xl => 40.0
  }
}

fn w0_spinner_with_alpha(c : Int64, factor : Double) -> Int64 {
  let a = (c & 0xFFL).to_double() * factor
  let ai = if a < 0.0 { 0L } else if a > 255.0 { 255L } else { a.round().to_int64() }
  (c & 0xFFFFFF00L) | ai
}

fn w0_spinner_clamp01(v : Double) -> Double {
  if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
}

fn w0_spinner_color(pal : AuraPalette, color : AuraSpinnerColor, ink : Option[() -> Int64]) -> Int64 {
  match color {
    AuraSpinnerColor::Current =>
      match ink {
        Some(f) => f()
        None => pal.foreground
      }
    AuraSpinnerColor::Accent => pal.accent
    AuraSpinnerColor::Success => pal.success
    AuraSpinnerColor::Warning => pal.warning
    AuraSpinnerColor::Danger => pal.danger
  }
}

// Exact locked HeroUI `spinner.tsx` Path 0 (left/head arc, `viewBox 24x24`, shifted by `(1.5, 1.625)`)
// as a single smooth closed contour (32 inner + 16 cap + 32 outer points), offset by `(-x_off, -y_off)`.
fn w0_spinner_path0(dim : Double, x_off : Double, y_off : Double) -> Array[Double] {
  let s = dim / 24.0
  let cx = 12.0 * s - x_off
  let cy = 12.0 * s - y_off
  let r_in = 7.5 * s
  let r_out = 10.5 * s
  let cap_r = 1.5 * s
  let p0_cx = 10.4975 * s - x_off
  let p0_cy = 3.125 * s - y_off
  let pi = 3.14159265358979323846
  let a_bot = 1.5707963267948966 // +pi/2 (6 o'clock)
  let a0_cap = -1.73851398 // atan2(3.125 - 12.0, 10.4975 - 12.0)
  let a0_ccw = a0_cap + 2.0 * pi // 4.54467133 (wrapping through +pi)
  let pts : Array[Double] = []
  let arc_segs = 32
  let cap_segs = 16

  // 1. Inner arc from bottom (+pi/2) up-left to top-left cap inner tangent (a0_ccw)
  let mut i = 0
  while i <= arc_segs {
    let a = a_bot + (a0_ccw - a_bot) * (i.to_double() / arc_segs.to_double())
    pts.push(cx + r_in * dmath::cos(a))
    pts.push(cy + r_in * dmath::sin(a))
    i += 1
  }
  // 2. Top-left rounded semicircle cap from inner tangent (a0_cap + pi) through tip (a0_cap + pi/2) to outer (a0_cap)
  let mut c = 1
  while c < cap_segs {
    let a = (a0_cap + pi) - pi * (c.to_double() / cap_segs.to_double())
    pts.push(p0_cx + cap_r * dmath::cos(a))
    pts.push(p0_cy + cap_r * dmath::sin(a))
    c += 1
  }
  // 3. Outer arc from top-left cap outer tangent (a0_ccw) back down to bottom (+pi/2)
  let mut j = 0
  while j <= arc_segs {
    let a = a0_ccw + (a_bot - a0_ccw) * (j.to_double() / arc_segs.to_double())
    pts.push(cx + r_out * dmath::cos(a))
    pts.push(cy + r_out * dmath::sin(a))
    j += 1
  }
  pts
}

// Exact locked HeroUI `spinner.tsx` Path 1 (right/tail arc, `viewBox 24x24`, shifted by `(1.5, 1.625)`)
// as a single smooth closed contour (32 outer + 16 cap + 32 inner points), offset by `(-x_off, -y_off)`.
fn w0_spinner_path1(dim : Double, x_off : Double, y_off : Double) -> Array[Double] {
  let s = dim / 24.0
  let cx = 12.0 * s - x_off
  let cy = 12.0 * s - y_off
  let r_in = 7.5 * s
  let r_out = 10.5 * s
  let cap_r = 1.5 * s
  let p1_cx = 18.009 * s - x_off
  let p1_cy = 5.2995 * s - y_off
  let pi = 3.14159265358979323846
  let a_bot = 1.5707963267948966
  let a1_cap = -0.83978436 // atan2(5.2995 - 12.0, 18.009 - 12.0)
  let pts : Array[Double] = []
  let arc_segs = 32
  let cap_segs = 16

  // 1. Outer arc from bottom (+pi/2) up-right to top-right cap outer tangent (a1_cap)
  let mut i = 0
  while i <= arc_segs {
    let a = a_bot + (a1_cap - a_bot) * (i.to_double() / arc_segs.to_double())
    pts.push(cx + r_out * dmath::cos(a))
    pts.push(cy + r_out * dmath::sin(a))
    i += 1
  }
  // 2. Top-right rounded semicircle cap from outer tangent (a1_cap) through tip (a1_cap - pi/2) to inner (a1_cap - pi)
  let mut c = 1
  while c < cap_segs {
    let a = a1_cap - pi * (c.to_double() / cap_segs.to_double())
    pts.push(p1_cx + cap_r * dmath::cos(a))
    pts.push(p1_cy + cap_r * dmath::sin(a))
    c += 1
  }
  // 3. Inner arc from top-right cap inner tangent (a1_cap) back down to bottom (+pi/2)
  let mut j = 0
  while j <= arc_segs {
    let a = a1_cap + (a_bot - a1_cap) * (j.to_double() / arc_segs.to_double())
    pts.push(cx + r_in * dmath::cos(a))
    pts.push(cy + r_in * dmath::sin(a))
    j += 1
  }
  pts
}

/// Build the locked HeroUI `spinner.tsx` SVG contours (`Path 0` base + `Path 0` top linear gradient + `Path 1`
/// linear gradient) at `size` using exact shape-local vertical fades that rotate cleanly at any `View::turn` angle.
pub fn aura_spinner_shapes(size : AuraSpinnerSize, col : Int64) -> Array[paint::Shape] {
  let dim = aura_spinner_dim(size)
  let s = dim / 24.0
  // Exact HeroUI spinner.tsx linearGradient objectBoundingBox stops (translated by (1.5, 1.625)):
  // Path 0 (y=[1.625..22.5], h=20.875): g0 y1=5.271% (2.72532125) -> 1.0, y2=91.793% (20.78678875) -> 0.55
  // Path 1 (y=[3.7995..22.5], h=18.7005): g1 y1=15.24% (6.6494562) -> 0.0, y2=87.15% (20.09698575) -> 0.55
  let p0_y1 = 2.72532125 * s
  let p0_y2 = 20.78678875 * s
  let p1_y1 = 6.6494562 * s
  let p1_y2 = 20.09698575 * s
  [
    paint::shape_of([(w0_spinner_path0(dim, 0.0, 0.0), true)], fill=w0_spinner_with_alpha(col, 0.55)),
    paint::shape_of(
      [(w0_spinner_path0(dim, 0.0, 0.0), true)],
      fill=col,
      fade=(0.0, 0.0, p0_y2, p0_y2 - p0_y1),
    ),
    paint::shape_of(
      [(w0_spinner_path1(dim, 0.0, 0.0), true)],
      fill=w0_spinner_with_alpha(col, 0.55),
      fade=(p1_y1, p1_y2 - p1_y1, 0.0, 0.0),
    ),
  ]
}

/// Aura `Spinner` circular activity indicator (Builder API).
/// Visual grammar aligned with HeroUI `spinner.tsx` + `spinner.css`: locked SVG paths with hardware per-pixel
/// continuous 1D linear gradients evaluated in shape-local coordinates (exact at all 0..360 deg rotation angles,
/// zero radial wedge seams, 100% synchronous on frame 0 across Metal/GLES3/D3D11/WebGL2, parent clip preserved
/// in screen coordinates). Translucent `ink` (`alpha < 255`) composites once via `View::group_alpha` so Path 0
/// never double-blends. Static when `aura_reduced_motion(node)` is active; rotates via `View::cycle` otherwise.
pub fn spinner_node(
  parent : view::View,
  size~ : AuraSpinnerSize = AuraSpinnerSize::Md,
  color~ : AuraSpinnerColor = AuraSpinnerColor::Accent,
  ink? : view::Live[Int64],
  label~ : String = "Loading",
  loc~ : String = "",
) -> view::View {
  let dim = aura_spinner_dim(size)
  let pi2 = 6.28318530717958647692
  let ink_get : Option[() -> Int64] = match ink {
    Some(live) => Some(live.to_getter())
    None => None
  }

  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .width(view::Live::Is(Some(dim)))
      .height(view::Live::Is(Some(dim)))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::Is(false))
      .says(view::Live::Is(Some(view::said(view::Role::Status, label=label))))
      .group_alpha(view::Live::By(fn() -> Double {
        let c = w0_spinner_color(aura_theme(node).palette, color, ink_get)
        (c & 0xFFL).to_double() / 255.0
      }))
      .turn(view::Live::By(fn() -> Double {
        if aura_reduced_motion(node) {
          0.0
        } else {
          node.cycle(aura_spinner_period_ms) * pi2
        }
      }))
      .shapes(view::Live::By(fn() -> Array[paint::Shape] {
        let c = w0_spinner_color(aura_theme(node).palette, color, ink_get)
        let opaque = if (c & 0xFFL) == 0L { 0L } else { (c & 0xFFFFFF00L) | 0xFFL }
        aura_spinner_shapes(size, opaque)
      }))
  })
}

/// Pion-JSX `<aura::Spinner>` wrapper.
pub fn Spinner(
  parent : view::View,
  size~ : AuraSpinnerSize = AuraSpinnerSize::Md,
  color~ : AuraSpinnerColor = AuraSpinnerColor::Accent,
  ink? : view::Live[Int64],
  ink_by? : () -> Int64,
  label~ : String = "Loading",
  loc~ : String = "",
) -> view::View {
  let eff_ink : Option[view::Live[Int64]] = match ink_by {
    Some(f) => Some(view::Live::By(f))
    None => ink
  }
  spinner_node(parent, size=size, color=color, ink?=eff_ink, label=label, loc=loc)
}

/// Aura `ScrollShadow` container (Builder API).
/// Subscribes to `headless::scroll_shadow(scroll)` (`Scroll::drawn_now` + `Scroll::reach`) and applies
/// soft edge fades (`View::fades`) on the active scroll ends.
pub fn scroll_shadow_node(
  parent : view::View,
  scroll : view::Scroll,
  vertical~ : Bool = true,
  shadow_size~ : Double = 40.0,
  threshold~ : Double = 1.0,
  content~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  let hs = headless::scroll_shadow(scroll, vertical=vertical, threshold=threshold)
  parent.box(loc=loc, fn(node : view::View) -> Unit {
    let _ = node
      .fill()
      .clips(view::Live::Is(true))
      .fades(view::Live::By(fn() -> (Double, Double, Double, Double) {
        let start_f = if hs.has_start() { shadow_size } else { 0.0 }
        let end_f = if hs.has_end() { shadow_size } else { 0.0 }
        if vertical {
          (0.0, start_f, 0.0, end_f)
        } else {
          (start_f, 0.0, end_f, 0.0)
        }
      }))
    content(node)
  })
}

/// Pion-JSX `<aura::ScrollShadow>` wrapper.
pub fn ScrollShadow(
  parent : view::View,
  scroll~ : view::Scroll,
  vertical~ : Bool = true,
  shadow_size~ : Double = 40.0,
  threshold~ : Double = 1.0,
  children~ : (view::View) -> Unit = fn(_v : view::View) { () },
  loc~ : String = "",
) -> view::View {
  scroll_shadow_node(
    parent,
    scroll,
    vertical=vertical,
    shadow_size=shadow_size,
    threshold=threshold,
    content=children,
    loc=loc,
  )
}
