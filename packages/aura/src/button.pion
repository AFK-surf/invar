// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Button (7 variants x 3 sizes + icon-only + full-width +
// pending + press scale + isolated group_alpha disabled + keyboard focus-visible 2pt gap fill ring) and CloseButton.

import "headless"
import "motion"
import "view"

/// HeroUI v3.2.8 Button visual variants (all 7).
#derive(Eq)
pub enum AuraButtonVariant {
  Primary
  Secondary
  Tertiary
  Ghost
  Outline
  Danger
  DangerSoft
}

/// HeroUI v3.2.8 Button sizes (3).
#derive(Eq)
pub enum AuraButtonSize {
  Sm
  Md
  Lg
}

fn w0_btn_metrics(size : AuraButtonSize, icon_only : Bool, is_md : Bool) -> (Double, Double, Double, Double, Double) {
  // Returns (height, pad_x, font_size, line_height, press_scale), aligned with HeroUI `button.css`:
  // Narrow (<768pt): Sm=36 / Md=40 / Lg=44; Desktop (>=768pt, `md:`): Sm=32 / Md=36 / Lg=40.
  match size {
    AuraButtonSize::Sm =>
      (if is_md { 32.0 } else { 36.0 }, if icon_only { 0.0 } else { 12.0 }, 14.0, 20.0, aura_button_press_scale_sm)
    AuraButtonSize::Md =>
      (if is_md { 36.0 } else { 40.0 }, if icon_only { 0.0 } else { 16.0 }, 14.0, 20.0, aura_button_press_scale)
    AuraButtonSize::Lg =>
      (if is_md { 40.0 } else { 44.0 }, if icon_only { 0.0 } else { 16.0 }, 16.0, 24.0, aura_button_press_scale_lg)
  }
}

fn w0_btn_colors(
  pal : AuraPalette,
  variant : AuraButtonVariant,
  hovered : Bool,
) -> (Int64, Int64, (Double, Int64)) {
  // Returns (bg, fg, border_edge)
  match variant {
    AuraButtonVariant::Primary =>
      (if hovered { pal.accent_hover } else { pal.accent }, pal.accent_foreground, (0.0, 0L))
    AuraButtonVariant::Secondary =>
      (if hovered { pal.default_hover } else { pal.default_bg }, pal.accent_soft_foreground, (0.0, 0L))
    AuraButtonVariant::Tertiary =>
      (if hovered { pal.default_hover } else { pal.default_bg }, pal.default_foreground, (0.0, 0L))
    AuraButtonVariant::Ghost =>
      (if hovered { pal.default_bg } else { 0x00000000L }, pal.foreground, (0.0, 0L))
    AuraButtonVariant::Outline =>
      (if hovered { pal.default_soft_hover } else { 0x00000000L }, pal.foreground, (1.0, pal.border))
    AuraButtonVariant::Danger =>
      (if hovered { pal.danger_hover } else { pal.danger }, pal.danger_foreground, (0.0, 0L))
    AuraButtonVariant::DangerSoft =>
      (if hovered { pal.danger_soft_hover } else { pal.danger_soft }, pal.danger_soft_foreground, (0.0, 0L))
  }
}

// Whether a button shows its hover / pressed fill (HeroUI `--button-bg-pressed` is `--button-bg-hover`): pointed at by
// a fine pointer, or pressed (any pointer; `force_pressed` for static calibration shots), and neither disabled nor pending.
fn w0_btn_lit(node : view::View, force_pressed : Bool, disabled : Bool, pending : Bool) -> Bool {
  !disabled && !pending && (force_pressed || node.pressed() || !aura_is_coarse_pointer(node) && node.pointed())
}

fn w0_clamp01(x : Double) -> Double {
  if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
}

/// Aura `Button` (Builder API).
/// Uses pill circular radius (`h * 0.5` unless overridden via `corners`), isolated `View::group_alpha(0.5)` when
/// disabled, smooth press scale transition (`0.96..0.98`, zero frame cost at rest), and HeroUI keyboard
/// `focus_visible` 2pt `--background` gap + 2pt `--focus` ring.
pub fn button_node(
  parent : view::View,
  label : view::Live[String],
  on_press~ : () -> Unit = fn() { () },
  variant~ : AuraButtonVariant = AuraButtonVariant::Primary,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  icon_only~ : Bool = false,
  full_width~ : Bool = false,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  pending~ : view::Live[Bool] = view::Live::Is(false),
  corners? : (Double, Double, Double, Double),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let (_, px, fs, lh, press_sc) = w0_btn_metrics(size, icon_only, true)
  let dis_get = disabled.to_getter()
  let pend_get = pending.to_getter()
  let lbl_get = label.to_getter()
  headless::button(
    parent,
    lbl_get,
    fn(_v : view::View) -> Unit { on_press() },
    fn(node : view::View, _btn : headless::Button) -> Unit {
      let press_way = motion::NodeWay::new(0.0)
      node.reacts(
        at_start=false,
        fn() -> Bool { node.pressed() && !dis_get() && !pend_get() },
        fn(down : Bool) -> Unit {
          let target = if down { 1.0 } else { 0.0 }
          if aura_reduced_motion(node) {
            press_way.put(target)
          } else {
            press_way.go(node, target, motion::backdrop_press_spring)
          }
        },
      )
      let fg_get = fn() -> Int64 {
        let th = aura_theme(node)
        let hov = w0_btn_lit(node, force_pressed, dis_get(), pend_get())
        w0_btn_colors(th.palette, variant, hov).1
      }
      let _ = node
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .gap(view::Live::Is(8.0))
        .height(view::Live::By(fn() -> Option[Double] {
          Some(w0_btn_metrics(size, icon_only, aura_is_md(node)).0)
        }))
        .shrink(view::Live::Is(0.0))
        .corner_circular(view::Live::Is(true))
        .scale(view::Live::By(fn() -> Double {
          if aura_reduced_motion(node) || dis_get() || pend_get() {
            1.0
          } else if force_pressed {
            press_sc
          } else {
            let t = w0_clamp01(press_way.shown(node))
            1.0 + (press_sc - 1.0) * t
          }
        }))
        .group_alpha(view::Live::By(fn() -> Double {
          if dis_get() { aura_theme(node).disabled_opacity } else { 1.0 }
        }))
        .ground(view::Live::By(fn() -> Int64 {
          let th = aura_theme(node)
          let hov = w0_btn_lit(node, force_pressed, dis_get(), pend_get())
          w0_btn_colors(th.palette, variant, hov).0
        }))
        .edge(view::Live::By(fn() -> (Double, Int64) {
          let th = aura_theme(node)
          let hov = w0_btn_lit(node, force_pressed, dis_get(), pend_get())
          w0_btn_colors(th.palette, variant, hov).2
        }))
      match corners {
        Some(cs) => {
          let _ = node.corners(view::Live::Is(Some(cs)))
        }
        None => {
          let _ = node.radius(view::Live::By(fn() -> Double {
            w0_btn_metrics(size, icon_only, aura_is_md(node)).0 * 0.5
          }))
        }
      }
      if icon_only {
        let _ = node.width(view::Live::By(fn() -> Option[Double] {
          Some(w0_btn_metrics(size, icon_only, aura_is_md(node)).0)
        }))
      } else if full_width {
        let _ = node.fills_across(view::Live::Is(true)).pad_xy(px, 0.0)
      } else {
        let _ = node.pad_xy(px, 0.0)
      }
      let _ = w0_apply_control_focus_ring(node, force_focus_visible=force_focus_visible)
      match content {
        Some(c) => c(node)
        None => {
          let _ = node.show(
            pend_get,
            fn(sp : view::View) -> Unit {
              let _ = spinner_node(
                sp,
                size=AuraSpinnerSize::Sm,
                color=AuraSpinnerColor::Current,
                ink=view::Live::By(fg_get),
              )
            },
          )
          let _ = node.box(fn(lbl_v : view::View) -> Unit {
            // (its words in the middle of its box: a box measured a little wider than its words, as every measure is,
            // held in the middle of the button, its words then too, as HeroUI's `justify-center` centres them)
            let _ = lbl_v
              .points(view::Live::Is(false))
              .words_centered(view::Live::Is(true))
              .words(
                label,
                look=view::WordsLook::{ ..view::words_plain, size: fs, weight: 500, line: lh, wrap: false },
              )
              .ink(view::Live::By(fg_get))
          })
        }
      }
    },
    disabled=dis_get,
    pending=pend_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Button>` wrapper.
pub fn Button(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  on_press~ : () -> Unit = fn() { () },
  variant~ : AuraButtonVariant = AuraButtonVariant::Primary,
  size~ : AuraButtonSize = AuraButtonSize::Md,
  icon_only~ : Bool = false,
  full_width~ : Bool = false,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  into pending~ : view::Live[Bool] = .Is(false),
  pending_by? : () -> Bool,
  corners? : (Double, Double, Double, Double),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  let pend = match pending_by { Some(f) => view::Live::By(f); None => pending }
  button_node(
    parent,
    lbl,
    on_press=on_press,
    variant=variant,
    size=size,
    icon_only=icon_only,
    full_width=full_width,
    disabled=dis,
    pending=pend,
    corners?=corners,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    content?=children,
    loc=loc,
  )
}

fn w0_close_btn_metrics(size : AuraButtonSize) -> (Double, Double) {
  // HeroUI `close-button.css` default: `h-6 w-6` (24x24pt) with 16pt Xmark icon.
  match size {
    AuraButtonSize::Sm => (20.0, 14.0)
    AuraButtonSize::Md => (24.0, 16.0)
    AuraButtonSize::Lg => (28.0, 18.0)
  }
}

/// Aura `CloseButton` circular icon-only dismiss button (Builder API).
/// Independently implements HeroUI `close-button.css`: 24x24pt default (`h-6 w-6`), `--default` fill,
/// circular pill radius, 16pt `Xmark`, hover wash, 0.93 press scale transition, and `focus_visible` 2pt gap ring.
/// Wraps the 24x24pt visual circle in a 36x36pt hit target with negative margin so layout footprint stays 24x24pt
/// while meeting minimum desktop hit-target ergonomics (`room:` gate).
pub fn close_button_node(
  parent : view::View,
  on_press~ : () -> Unit = fn() { () },
  label~ : String = "Close",
  size~ : AuraButtonSize = AuraButtonSize::Md,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let (dim, icon_sz) = w0_close_btn_metrics(size)
  let hit_dim = if dim < 36.0 { 36.0 } else { dim }
  let hit_out = (hit_dim - dim) * 0.5
  let dis_get = disabled.to_getter()
  headless::button(
    parent,
    fn() -> String { label },
    fn(_v : view::View) -> Unit { on_press() },
    fn(node : view::View, _btn : headless::Button) -> Unit {
      let press_way = motion::NodeWay::new(0.0)
      node.reacts(
        at_start=false,
        fn() -> Bool { node.pressed() && !dis_get() },
        fn(down : Bool) -> Unit {
          let target = if down { 1.0 } else { 0.0 }
          if aura_reduced_motion(node) {
            press_way.put(target)
          } else {
            press_way.go(node, target, motion::backdrop_press_spring)
          }
        },
      )
      let _ = node
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Middle))
        .width(view::Live::Is(Some(hit_dim)))
        .height(view::Live::Is(Some(hit_dim)))
        .shrink(view::Live::Is(0.0))
        .group_alpha(view::Live::By(fn() -> Double {
          if dis_get() { aura_theme(node).disabled_opacity } else { 1.0 }
        }))
      if hit_out > 0.0 {
        let _ = node.margin(view::Live::Is((-hit_out, -hit_out, -hit_out, -hit_out)))
      }
      let _ = node.box(fn(circle : view::View) -> Unit {
        let _ = circle
          .row(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .width(view::Live::Is(Some(dim)))
          .height(view::Live::Is(Some(dim)))
          .shrink(view::Live::Is(0.0))
          .points(view::Live::Is(false))
          .corner_circular(view::Live::Is(true))
          .radius(view::Live::Is(dim * 0.5))
          .scale(view::Live::By(fn() -> Double {
            if aura_reduced_motion(node) || dis_get() {
              1.0
            } else if force_pressed {
              aura_close_button_press_scale
            } else {
              let t = w0_clamp01(press_way.shown(circle))
              1.0 + (aura_close_button_press_scale - 1.0) * t
            }
          }))
          .ground(view::Live::By(fn() -> Int64 {
            let pal = aura_theme(node).palette
            let hov = w0_btn_lit(node, force_pressed, dis_get(), false)
            if hov { pal.default_hover } else { pal.default_bg }
          }))
          .ring(view::Live::By(fn() -> (Double, Double, Int64) {
            let active = force_focus_visible || node.focus_shown()
            if active {
              let th = aura_theme(node)
              (2.0, th.ring_offset_width, th.palette.focus)
            } else {
              (0.0, 0.0, 0L)
            }
          }))
          .ring_gap_color(view::Live::By(fn() -> Int64 {
            let active = force_focus_visible || node.focus_shown()
            if active {
              aura_theme(node).palette.background
            } else {
              0L
            }
          }))
        let _ = aura_icon_node(
          circle,
          AuraIconKind::Xmark,
          size=icon_sz,
          ink=fn() -> Int64 { aura_theme(node).palette.default_foreground },
        )
      })
    },
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::CloseButton>` wrapper.
pub fn CloseButton(
  parent : view::View,
  on_press~ : () -> Unit = fn() { () },
  label~ : String = "Close",
  size~ : AuraButtonSize = AuraButtonSize::Md,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  force_focus_visible~ : Bool = false,
  force_pressed~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  close_button_node(
    parent,
    on_press=on_press,
    label=label,
    size=size,
    disabled=dis,
    force_focus_visible=force_focus_visible,
    force_pressed=force_pressed,
    loc=loc,
  )
}
