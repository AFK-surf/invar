// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): multi-layer elevation shadows & dark overlay inner rim.
// Every layer is a `view::Shadow::drop(sigma_pt, dy_pt, rgba)` ordered bottom-to-top (reverse of CSS box-shadow declaration order),
// where `sigma_pt = css_blur_radius / 2.0` is passed directly to `View::shadows` without further halving.

import "view"

/// Light-mode Surface / Field 3-layer shadow (bottom-to-top, reverse of HeroUI `variables.css:180-182`).
/// Dark mode has no outer shadow (`[]`).
pub fn aura_surface_shadows(dark : Bool) -> Array[view::Shadow] {
  if dark {
    []
  } else {
    [view::Shadow::drop(0.5, 0.0, 0x0000000FL), view::Shadow::drop(1.0, 1.0, 0x0000000FL), view::Shadow::drop(2.0, 2.0, 0x0000000AL)]
  }
}

/// Light-mode Overlay 3-layer shadow (bottom-to-top, reverse of HeroUI `variables.css:184-186`).
/// Dark mode uses a 1px bright inner edge (`w0_overlay_dark_inner_rim`) instead of an outer shadow.
pub fn aura_overlay_shadows(dark : Bool) -> Array[view::Shadow] {
  if dark {
    []
  } else {
    [view::Shadow::drop(14.0, 14.0, 0x00000014L), view::Shadow::drop(6.0, -6.0, 0x00000008L), view::Shadow::drop(4.0, 2.0, 0x0000000FL)]
  }
}

/// Checked Switch thumb 3-layer shadow (bottom-to-top, reverse of HeroUI `switch.css:193-196`).
pub fn aura_switch_thumb_shadows() -> Array[view::Shadow] {
  [view::Shadow::drop(0.5, 0.0, 0x0000004DL), view::Shadow::drop(5.0, 2.0, 0x0000000FL), view::Shadow::drop(2.5, 0.0, 0x00000005L)]
}

/// Calibrated dark-mode Overlay inset rim (`0 0 1px 0 rgba(255,255,255,0.3) inset`): white at 30% fading in from the
/// edge (the 1px blur). Measured on `w0-overlay-dark-2x.png` as 42 then 27 over the overlay's 24 in the two device
/// pixels in from its edge, nothing past them: drawn as two edges over the overlay's ground, the soft one 1pt wide at
/// 0x03 (+3 on each), the outer 0.5pt wide at 0x11 over it (+15 more on the first).
pub let w0_dark_overlay_rim_width : Double = 0.5
pub let w0_dark_overlay_rim_color : Int64 = 0xFFFFFF11L
pub let w0_dark_overlay_rim_soft_width : Double = 1.0
pub let w0_dark_overlay_rim_soft_color : Int64 = 0xFFFFFF03L

/// Attach the dark-mode inset rim (`w0_dark_overlay_rim_*`) to `panel` as its first children, drawn over its ground and
/// under what it holds, taking no room and no pointer, its corners `panel`'s (`radius`): none while its theme is light.
pub fn w0_mount_dark_overlay_rim(panel : view::View, radius : view::Live[Double]) -> Unit {
  for e in [
    (w0_dark_overlay_rim_soft_width, w0_dark_overlay_rim_soft_color),
    (w0_dark_overlay_rim_width, w0_dark_overlay_rim_color),
  ] {
    let _ = panel.box(fn(_rim : view::View) { () })
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .radius(radius)
      .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(panel) }))
      .edge(view::Live::By(fn() -> (Double, Int64) { if aura_theme(panel).config.dark { e } else { (0.0, 0L) } }))
  }
}
