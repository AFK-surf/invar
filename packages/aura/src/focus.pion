// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): per-slot focus ring and invalid ring grammar.
// - Interactive controls (Button, CloseButton, Switch, Trigger, ...): focus-visible ONLY,
//   2pt `--background` solid gap ring + 2pt `--focus` outer ring.
// - Input / Field slots: focused OR focus-within (including pointer click), 2pt `--focus` flush ring (gap = 0pt);
//   when invalid: 1pt `--danger` flush ring (unfocused) or 2pt `--danger` flush ring (focused/focus-within).

import "view"

/// Apply HeroUI interactive-control focus-visible ring (2pt `--background` gap fill + 2pt `--focus` outer ring).
/// `force_focus_visible` allows static calibration shots to display the keyboard focus ring deterministically.
pub fn w0_apply_control_focus_ring(
  node : view::View,
  force_focus_visible~ : Bool = false,
) -> view::View {
  let _ = node
    .ring(view::Live::By(fn() -> (Double, Double, Int64) {
      let active = force_focus_visible || node.focus_shown()
      if active {
        let th = aura_theme(node)
        (2.0, th.ring_offset_width, th.palette.focus)
      } else {
        (0.0, 0.0, 0L)
      }
    }))
    .ring_gap_color(view::Live::By(fn() -> Int64 {
      let active = force_focus_visible || node.focus_shown()
      if active {
        aura_theme(node).palette.background
      } else {
        0L
      }
    }))
  node
}

/// Apply HeroUI input/field slot focus & invalid ring grammar:
/// - invalid && (focused || focus_within): 2pt `--danger` flush ring (`gap = 0pt`)
/// - invalid && !(focused || focus_within): 1pt `--danger` flush ring (`gap = 0pt`)
/// - !invalid && (focused || focus_within): 2pt `--focus` flush ring (`gap = 0pt`)
pub fn w0_apply_field_focus_ring(
  node : view::View,
  invalid : view::Live[Bool],
  force_focused~ : Bool = false,
) -> view::View {
  let _ = node
    .ring(view::Live::By(fn() -> (Double, Double, Int64) {
      let inv = invalid.eval()
      let foc = force_focused || node.focused() || node.focus_within()
      let th = aura_theme(node)
      if inv && foc {
        (2.0, 0.0, th.palette.danger)
      } else if inv {
        (1.0, 0.0, th.palette.danger)
      } else if foc {
        (2.0, 0.0, th.palette.focus)
      } else {
        (0.0, 0.0, 0L)
      }
    }))
    .ring_gap_color(view::Live::Is(0L))
  node
}
