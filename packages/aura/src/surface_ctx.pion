// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): SurfaceContext level hierarchy.
// Borrowed per subtree via `view::Lent[() -> AuraSurfaceLevel]` so `Transparent` dynamically falls back to
// the nearest enclosing non-transparent surface level.

import "signals"
import "view"

/// Semantic surface elevation level in Aura.
#derive(Eq)
pub enum AuraSurfaceLevel {
  Primary
  Secondary
  Tertiary
  Transparent
  Overlay
}

impl signals::Eq for AuraSurfaceLevel {
  fn eq(self : AuraSurfaceLevel, other : AuraSurfaceLevel) -> Bool {
    self == other
  }
}

/// Form field surface variant: `.Primary` (HeroUI default), `.Secondary`, or `.Auto` (follows `SurfaceContext`).
#derive(Eq)
pub enum AuraFieldVariant {
  Primary
  Secondary
  Auto
}

let w0_surface_lent : view::Lent[() -> AuraSurfaceLevel] = view::Lent::new()

/// Borrow a reactive surface-level getter to `host` and its descendants.
/// When the getter evaluates to `Transparent`, it dynamically falls back to the parent's `SurfaceContext`
/// (or `.Primary` if none). Switching between `Transparent` and a concrete level updates descendants live.
pub fn aura_provide_surface_by(host : view::View, level_get : () -> AuraSurfaceLevel) -> view::View {
  let parent_get = host.lent(w0_surface_lent)
  host.lends(w0_surface_lent, fn() -> AuraSurfaceLevel {
    match level_get() {
      AuraSurfaceLevel::Transparent =>
        match parent_get {
          Some(pg) => pg()
          None => AuraSurfaceLevel::Primary
        }
      other => other
    }
  })
}

/// Borrow a surface level signal to `host` and its descendants.
/// `Transparent` surfaces dynamically inherit the ambient parent surface level.
pub fn aura_provide_surface(host : view::View, level : signals::Signal[AuraSurfaceLevel]) -> view::View {
  aura_provide_surface_by(host, fn() -> AuraSurfaceLevel { level.get() })
}

/// Whether `v` is inside an explicit `SurfaceContext` provider.
pub fn aura_has_surface_context(v : view::View) -> Bool {
  match v.lent(w0_surface_lent) {
    Some(_) => true
    None => false
  }
}

/// Read the ambient `AuraSurfaceLevel` (defaults to `.Primary`).
pub fn aura_surface_level_of(v : view::View) -> AuraSurfaceLevel {
  match v.lent(w0_surface_lent) {
    Some(g) => g()
    None => AuraSurfaceLevel::Primary
  }
}

/// Next deeper surface level when nesting with `auto_surface = true`.
pub fn aura_next_surface_level(cur : AuraSurfaceLevel) -> AuraSurfaceLevel {
  match cur {
    AuraSurfaceLevel::Primary => AuraSurfaceLevel::Secondary
    AuraSurfaceLevel::Secondary => AuraSurfaceLevel::Tertiary
    AuraSurfaceLevel::Tertiary => AuraSurfaceLevel::Tertiary
    AuraSurfaceLevel::Transparent => AuraSurfaceLevel::Primary
    AuraSurfaceLevel::Overlay => AuraSurfaceLevel::Secondary
  }
}

/// Background fill color for a given surface level.
pub fn aura_surface_bg(pal : AuraPalette, level : AuraSurfaceLevel) -> Int64 {
  match level {
    AuraSurfaceLevel::Primary => pal.surface
    AuraSurfaceLevel::Secondary => pal.surface_secondary
    AuraSurfaceLevel::Tertiary => pal.surface_tertiary
    AuraSurfaceLevel::Transparent => 0x00000000L
    AuraSurfaceLevel::Overlay => pal.overlay
  }
}

/// Foreground ink color for a given surface level.
pub fn aura_surface_fg(pal : AuraPalette, level : AuraSurfaceLevel) -> Int64 {
  match level {
    AuraSurfaceLevel::Primary => pal.surface_foreground
    AuraSurfaceLevel::Secondary => pal.surface_secondary_foreground
    AuraSurfaceLevel::Tertiary => pal.surface_tertiary_foreground
    AuraSurfaceLevel::Transparent => pal.foreground
    AuraSurfaceLevel::Overlay => pal.overlay_foreground
  }
}

/// Resolve an `AuraFieldVariant` against ambient `SurfaceContext` (explicit `Primary`/`Secondary` win;
/// `Auto` resolves to `Primary` outside any surface or on `Transparent`, and `Secondary` on concrete surfaces).
pub fn aura_field_effective_variant(v : view::View, variant : AuraFieldVariant) -> AuraFieldVariant {
  match variant {
    AuraFieldVariant::Primary => AuraFieldVariant::Primary
    AuraFieldVariant::Secondary => AuraFieldVariant::Secondary
    AuraFieldVariant::Auto =>
      if !aura_has_surface_context(v) {
        AuraFieldVariant::Primary
      } else {
        match aura_surface_level_of(v) {
          AuraSurfaceLevel::Transparent => AuraFieldVariant::Primary
          _ => AuraFieldVariant::Secondary
        }
      }
  }
}

/// Resolve field background color according to `variant` and ambient `SurfaceContext`.
pub fn aura_field_bg(v : view::View, pal : AuraPalette, variant : AuraFieldVariant) -> Int64 {
  match variant {
    AuraFieldVariant::Primary => pal.field_background
    AuraFieldVariant::Secondary => pal.surface_secondary
    AuraFieldVariant::Auto =>
      if !aura_has_surface_context(v) {
        pal.field_background
      } else {
        match aura_surface_level_of(v) {
          AuraSurfaceLevel::Primary | AuraSurfaceLevel::Overlay => pal.surface_secondary
          AuraSurfaceLevel::Secondary => pal.surface_tertiary
          AuraSurfaceLevel::Tertiary => pal.surface_tertiary
          AuraSurfaceLevel::Transparent => pal.field_background
        }
      }
  }
}
