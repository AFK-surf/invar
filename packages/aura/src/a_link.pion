// Ported from HeroUI v3 (v3.2.8 @ c3373a1, Apache-2.0): Link and LinkIcon backed 100% by `headless::link`
// with underline offset, hover/pressed decoration, disabled state, external arrow icon, and Enter activation.

import "headless"
import "paint"
import "view"

// Exact HeroUI `ExternalLinkIcon` polygon in 7x7 viewBox (`icons.tsx:85-101`):
// d="M1.20592 6.84333L0.379822 6.01723L4.52594 1.8672H1.37819L1.38601 0.731812H6.48742V5.83714H5.34421L5.35203 2.6933L1.20592 6.84333Z"
/// Build the external-link diagonal arrow vector shape scaled to `size x size` logical points.
pub fn aura_external_link_icon_shapes(size : Double, ink : Int64) -> Array[paint::Shape] {
  if !(size > 0.0) {
    return []
  }
  let s = size / 7.0
  let pts : Array[Double] = [
    1.20592 * s, 6.84333 * s,
    0.379822 * s, 6.01723 * s,
    4.52594 * s, 1.8672 * s,
    1.37819 * s, 1.8672 * s,
    1.38601 * s, 0.731812 * s,
    6.48742 * s, 0.731812 * s,
    6.48742 * s, 5.83714 * s,
    5.34421 * s, 5.83714 * s,
    5.35203 * s, 2.6933 * s,
  ]
  [paint::shape_of([(pts, true)], fill=ink)]
}

fn a_link_alpha(c : Int64, factor : Double) -> Int64 {
  let a = (c & 0xFFL).to_double() * factor
  let ai = if a < 0.0 { 0L } else if a > 255.0 { 255L } else { a.round().to_int64() }
  (c & 0xFFFFFF00L) | ai
}

/// External link icon slot (Builder API): diagonal arrow with 60% resting opacity, 100% on hover/focus.
pub fn link_icon_node(
  parent : view::View,
  size~ : Double = 9.0,
  active~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  parent.box(loc=loc, fn(wrap : view::View) -> Unit {
    let _ = wrap
      .row(view::Live::Is(true))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .margin(view::Live::Is((4.0, 0.0, 0.0, 6.0)))
      .points(view::Live::Is(false))
      .shrink(view::Live::Is(0.0))
    let _ = wrap.box(fn(ic : view::View) -> Unit {
      let _ = ic
        .width(view::Live::Is(Some(size)))
        .height(view::Live::Is(Some(size)))
        .shrink(view::Live::Is(0.0))
        .points(view::Live::Is(false))
        .shapes(view::Live::Is(aura_external_link_icon_shapes(size, 0x010101FFL)))
        .tint(view::Live::By(fn() -> Int64 {
          let base = aura_theme(wrap).palette.link
          if active() { base } else { a_link_alpha(base, 0.6) }
        }))
    })
  })
}

/// Pion-JSX `<aura::LinkIcon>` wrapper.
pub fn LinkIcon(
  parent : view::View,
  size~ : Double = 9.0,
  active~ : () -> Bool = fn() { false },
  loc~ : String = "",
) -> view::View {
  link_icon_node(parent, size=size, active=active, loc=loc)
}

/// Aura `Link` interactive navigation element (Builder API), 100% wired to `headless::link`.
/// Mirrors `.link`: `font-medium text-link`, 1.5pt underline offset 4pt on hover (`muted/50`) and press (`muted`),
/// optional external arrow icon (`external=true`), keyboard Enter activation (Space does not activate),
/// disabled `group_alpha(0.5)`, and keyboard `focus_visible` ring.
pub fn link_node(
  parent : view::View,
  label : view::Live[String],
  on_press~ : () -> Unit = fn() { () },
  href~ : view::Live[String] = view::Live::Is(""),
  external~ : Bool = false,
  underline~ : Bool = false,
  font_size~ : Double = 16.0,
  line_height~ : Double = 24.0,
  disabled~ : view::Live[Bool] = view::Live::Is(false),
  force_focus_visible~ : Bool = false,
  force_hovered~ : Bool = false,
  force_pressed~ : Bool = false,
  content? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl_get = label.to_getter()
  let href_get = href.to_getter()
  let dis_get = disabled.to_getter()
  headless::link(
    parent,
    lbl_get,
    fn(_v : view::View) -> Unit { on_press() },
    fn(node : view::View, lnk : headless::Link) -> Unit {
      let is_hov = fn() -> Bool {
        !lnk.disabled() && (force_hovered || (!aura_is_coarse_pointer(node) && lnk.hovered()))
      }
      let is_prs = fn() -> Bool {
        !lnk.disabled() && (force_pressed || lnk.pressed())
      }
      let icon_active = fn() -> Bool {
        force_focus_visible || lnk.focus_shown() || is_hov() || is_prs()
      }
      let _ = node
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .lies_along(view::Live::Is(view::Lies::Start))
        .shrink(view::Live::Is(0.0))
        .corner_circular(view::Live::By(fn() -> Bool { aura_corner_circular(node) }))
        .radius(view::Live::Is(12.0))
        .group_alpha(view::Live::By(fn() -> Double {
          if lnk.disabled() { aura_theme(node).disabled_opacity } else { 1.0 }
        }))
      let _ = w0_apply_control_focus_ring(node, force_focus_visible=force_focus_visible)
      match content {
        Some(c) => c(node)
        None => {
          let _ = node.box(fn(text_wrap : view::View) -> Unit {
            let _ = text_wrap.points(view::Live::Is(false))
            let _ = text_wrap.box(fn(tw : view::View) -> Unit {
              let _ = tw
                .points(view::Live::Is(false))
                .words(
                  label,
                  look=view::WordsLook::{ ..view::words_plain, size: font_size, weight: 500, line: line_height, wrap: false },
                )
                .ink(view::Live::By(fn() -> Int64 { aura_theme(node).palette.link }))
            })
            // 1.5pt underline with 4pt offset (`decoration-[1.5px] underline-offset-4`)
            let _ = text_wrap.box(fn(ul : view::View) -> Unit {
              let _ = ul
                .over(view::Live::Is(true), edges=(Some(0.0), None, Some(0.0), Some(-1.0)))
                .height(view::Live::Is(Some(1.5)))
                .points(view::Live::Is(false))
                .ground(view::Live::By(fn() -> Int64 {
                  let pal = aura_theme(node).palette
                  if is_prs() {
                    pal.muted
                  } else if is_hov() {
                    a_link_alpha(pal.muted, 0.5)
                  } else if underline {
                    pal.separator_tertiary
                  } else {
                    0x00000000L
                  }
                }))
            })
          })
          if external {
            let _ = link_icon_node(node, size=9.0, active=icon_active)
          }
        }
      }
    },
    href=href_get,
    disabled=dis_get,
    loc=loc,
  )
}

/// Pion-JSX `<aura::Link>` wrapper.
pub fn Link(
  parent : view::View,
  into label~ : view::Live[String] = .Is(""),
  label_by? : () -> String,
  on_press~ : () -> Unit = fn() { () },
  into href~ : view::Live[String] = .Is(""),
  href_by? : () -> String,
  external~ : Bool = false,
  underline~ : Bool = false,
  font_size~ : Double = 16.0,
  line_height~ : Double = 24.0,
  into disabled~ : view::Live[Bool] = .Is(false),
  disabled_by? : () -> Bool,
  force_focus_visible~ : Bool = false,
  force_hovered~ : Bool = false,
  force_pressed~ : Bool = false,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  let lbl = match label_by { Some(f) => view::Live::By(f); None => label }
  let hr = match href_by { Some(f) => view::Live::By(f); None => href }
  let dis = match disabled_by { Some(f) => view::Live::By(f); None => disabled }
  link_node(
    parent,
    lbl,
    on_press=on_press,
    href=hr,
    external=external,
    underline=underline,
    font_size=font_size,
    line_height=line_height,
    disabled=dis,
    force_focus_visible=force_focus_visible,
    force_hovered=force_hovered,
    force_pressed=force_pressed,
    content?=children,
    loc=loc,
  )
}
