// Comprehensive unit & interaction tests for Wave 1 Track 1D (all 20 leaf components, Builder + Pion-JSX,
// aura::assert_aura_ui gate, keyboard & pointer interaction, 0% ProgressCircle arc skip, reduced_motion,
// non-HSV ColorArea texture caching, ColorField hex validation, Calendar/RangeCalendar/YearPicker/DateField/TimeField).

import "halt"
import "headless_core"
import "signals"
import "ui"
import "view"

fn d_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("d_test", msg)
  }
}

fn d_setup_root(root : view::View, dark : Bool, reduced_motion~ : Bool = false) -> Unit {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::default(), dark, reduced_motion })
  ui::set_tree_theme(fn() -> ui::Theme { aura_ui_theme(cfg.get()) })
  let _ = aura_provide_config(root, cfg)
}

test "d_01_feedback_alert_badge_chip_avatar_group_builder_and_jsx_pass_aura_ui" {
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))

    // 1. Alert (Builder + JSX across all 5 statuses)
    let _ = alert_node(root, status=AuraAlertStatus::Default, title=view::Live::Is("Default Alert"), description=view::Live::Is("Default msg"))
    let _ = alert_node(root, status=AuraAlertStatus::Accent, title=view::Live::Is("Accent Alert"), description=view::Live::Is("Accent msg"))
    let _ = alert_node(root, status=AuraAlertStatus::Success, title=view::Live::Is("Success Alert"), description=view::Live::Is("Success msg"))
    let _ = alert_node(root, status=AuraAlertStatus::Warning, title=view::Live::Is("Warning Alert"), description=view::Live::Is("Warning msg"))
    let _ = Alert(root, status=AuraAlertStatus::Danger, title=view::Live::Is("Danger Alert"), description=view::Live::Is("Danger msg"))

    // 2. Badge + BadgeAnchor (4 placements + dot) + 4. Avatar + 5. AvatarGroup
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(16.0))
      for pl in [
        AuraBadgePlacement::TopRight,
        AuraBadgePlacement::TopLeft,
        AuraBadgePlacement::BottomRight,
        AuraBadgePlacement::BottomLeft,
      ] {
        let _ = BadgeAnchor(row, children=fn(anc : view::View) -> Unit {
          let _ = Avatar(anc, fallback=view::Live::Is("JD"))
          let _ = Badge(anc, label=view::Live::Is("3"), size=AuraControlSize::Sm, placement=pl)
        })
      }
      let _ = badge_node(row, dot=true, color=AuraStatusColor::Success, size=AuraControlSize::Sm)
      let _ = AvatarGroup(
        row,
        items=[
          AuraAvatarItem::new("A1"),
          AuraAvatarItem::new("B2"),
          AuraAvatarItem::new("C3"),
          AuraAvatarItem::new("D4"),
        ],
        max=2,
      )
    })

    // 3. Chip (4 variants x statuses x sizes)
    let _ = root.box(fn(row : view::View) -> Unit {
      let _ = row.row(view::Live::Is(true)).gap(view::Live::Is(8.0))
      let _ = chip_node(row, view::Live::Is("Primary"), variant=AuraChipVariant::Primary, color=AuraStatusColor::Accent, size=AuraControlSize::Sm)
      let _ = chip_node(row, view::Live::Is("Secondary"), variant=AuraChipVariant::Secondary, color=AuraStatusColor::Success, size=AuraControlSize::Md)
      let _ = chip_node(row, view::Live::Is("Tertiary"), variant=AuraChipVariant::Tertiary, color=AuraStatusColor::Warning, size=AuraControlSize::Lg)
      let _ = Chip(row, label=view::Live::Is("Soft"), variant=AuraChipVariant::Soft, color=AuraStatusColor::Danger)
    })
  }, width=1000.0, height=700.0)

  t.frame()
  assert_aura_ui(t, label="1d-feedback-media")
  d_assert(t.find("Default Alert") is Some(_), "must render Default Alert")
  d_assert(t.find("Danger Alert") is Some(_), "must render Danger Alert")
  d_assert(t.find("JD") is Some(_), "must render Avatar initials")
  d_assert(t.find("+2") is Some(_), "must render AvatarGroup overflow count")
  d_assert(t.find("Soft") is Some(_), "must render Soft Chip")
  t.dispose()
}

test "d_02_progress_bar_and_circle_zero_percent_skips_arc_and_indeterminate_reduced_motion" {
  let pct = signals::signal(0.0)
  let indet = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false, reduced_motion=true)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = ProgressBar(
      root,
      value_by=fn() -> Option[Double] { if indet.get() { None } else { Some(pct.get()) } },
      label="Upload",
    )
    let _ = ProgressCircle(
      root,
      value_by=fn() -> Option[Double] { if indet.get() { None } else { Some(pct.get()) } },
      label="Circle",
    )
  }, width=600.0, height=400.0)

  t.frame()
  assert_aura_ui(t, label="1d-progress-0")
  d_assert(t.find("0%") is Some(_), "must display 0% output")
  // Count drawn instances at 0% vs 68%: 0% MUST skip fill arc to avoid round-cap dot artifact
  let inst_0 = t.scene().ninst
  d_assert(inst_0 > 0, "track circle must emit instances at 0%")

  pct.set(68.0)
  t.frame(ms=16.0)
  d_assert(t.find("68%") is Some(_), "must display 68% output")
  let inst_68 = t.scene().ninst
  d_assert(inst_68 > inst_0, "68% progress circle must emit additional fill arc instances over 0%")

  // Indeterminate mode with reduced_motion=true stays static with zero unasked faults
  indet.set(true)
  t.frame(ms=500.0)
  assert_aura_ui(t, label="1d-progress-indet-reduced")
  t.dispose()
}

test "d_03_skeleton_single_group_and_reduced_motion" {
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false, reduced_motion=true)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = Skeleton(root, width=300.0, height=24.0)
    let _ = SkeletonGroup(root, children=fn(g : view::View) -> Unit {
      let _ = skeleton_node(g, width=300.0, height=20.0)
      let _ = skeleton_node(g, width=200.0, height=20.0)
    })
    let _ = skeleton_node(root, width=120.0, height=16.0, animation=AuraSkeletonAnimation::Pulse)
    let _ = skeleton_node(root, width=120.0, height=16.0, animation=AuraSkeletonAnimation::None)
  }, width=600.0, height=300.0)

  t.frame()
  assert_aura_ui(t, label="1d-skeleton-reduced")
  d_assert(t.unasked_faults().length() == 0, "reduced_motion skeleton must be static")
  t.dispose()
}

test "d_04_color_swatch_picker_area_slider_and_field_interactive" {
  let picked = signals::signal("#0485F7")
  let model = signals::signal_by(
    headless_core::ColorModel::from_hsva(210.0, 0.80, 0.90),
    fn(a, b) { a == b },
  )
  let rgb_model = signals::signal_by(
    headless_core::ColorModel::from_rgba(0.7, 0.5, 0.86),
    fn(a, b) { a == b },
  )
  let fld = ui::Field::new(text="#0485F7")
  let ca_ref : signals::Ref[Option[view::View]] = view::ref_new(None)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = ColorSwatch(root, color=view::Live::Is(0x0485F780L), size=AuraColorSwatchSize::Lg)
    let _ = ColorSwatchPicker(
      root,
      colors=["#0485F7", "#17C964", "#F5A524"],
      selected=fn() -> Option[String] { Some(picked.get()) },
      on_select=fn(s) { picked.set(s) },
    )
    let ca = ColorArea(
      root,
      model=fn() { model.get() },
      on_change=fn(m) { model.set(m) },
      size=160.0,
      label="HSV plane",
    )
    ca_ref.v = Some(ca)
    let _ = color_area_node(
      root,
      fn() { rgb_model.get() },
      fn(m) { rgb_model.set(m) },
      x_channel=headless_core::ColorChannel::Red,
      y_channel=headless_core::ColorChannel::Green,
      size=160.0,
      label="RGB plane",
    )
    let _ = ColorSlider(
      root,
      channel=headless_core::ColorChannel::Hue,
      model=fn() { model.get() },
      on_change=fn(m) { model.set(m) },
      label="Hue",
    )
    let _ = ColorField(
      root,
      model=fn() { model.get() },
      on_change=fn(m) { model.set(m) },
      label="Hex Color",
      field_ref=fld,
    )
  }, width=800.0, height=700.0)

  t.frame()
  assert_aura_ui(t, label="1d-color-family")
  d_assert(t.find("210°") is Some(_), "Hue slider must display 210°")
  d_assert(t.find("Hex Color") is Some(_), "ColorField must display label")

  // Keyboard step on ColorArea (ArrowRight increases saturation)
  match ca_ref.v {
    Some(ca) => {
      let before_s = model.get().s
      let _ = ca.ask_focus(visible=true)
      t.frame(ms=16.0)
      t.key(headless_core::key_right)
      t.frame(ms=32.0)
      d_assert(model.get().s > before_s, "ArrowRight on ColorArea must increase saturation")
    }
    None => d_assert(false, "missing ColorArea ref")
  }

  // Click second swatch in ColorSwatchPicker
  t.press("#17C964")
  t.frame(ms=48.0)
  d_assert(picked.get() == "#17C964", "clicking #17C964 swatch must select it")

  // Verify pure-GPU RGB ColorArea registers 0 PNG textures in host image registry
  d_assert(ui::image_cache_count() == 0, "pure-GPU non-HSV ColorArea must register 0 PNG textures")
  t.dispose()
}

test "d_05_calendar_range_calendar_year_picker_and_date_time_fields_interactive" {
  let nov24 = headless_core::IsoDate::new(2026, 11, 24)
  let nov10 = headless_core::IsoDate::new(2026, 11, 10)
  let nov18 = headless_core::IsoDate::new(2026, 11, 18)

  let cal_sel = signals::signal_by(Some(nov24), fn(a, b) {
    match (a, b) { (Some(x), Some(y)) => x == y; (None, None) => true; _ => false }
  })
  let rng_sel = signals::signal_by(Some((nov10, nov18)), fn(a, b) {
    match (a, b) { (Some((x1, x2)), Some((y1, y2))) => x1 == y1 && x2 == y2; (None, None) => true; _ => false }
  })
  let yr_sel = signals::signal(2026)
  let df_val = signals::signal_by(headless_core::SegmentedDateTime::from_date(nov24), fn(a, b) { a.eq(b) })
  let tf_val = signals::signal_by(
    headless_core::SegmentedDateTime::{ year: None, month: None, day: None, hour: Some(14), minute: Some(30), second: None },
    fn(a, b) { a.eq(b) },
  )

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = root.row(view::Live::Is(true)).pad(view::Live::Is(16.0)).gap(view::Live::Is(16.0))
    let _ = Calendar(
      root,
      initial_focus=nov24,
      selected=fn() { cal_sel.get() },
      on_select=fn(d) { cal_sel.set(Some(d)) },
      today=fn() { Some(nov24) },
    )
    let _ = RangeCalendar(
      root,
      initial_focus=nov10,
      range=fn() { rng_sel.get() },
      on_change=fn(a, b) { rng_sel.set(Some((a, b))) },
      today=fn() { Some(nov24) },
    )
    let _ = root.box(fn(col : view::View) -> Unit {
      let _ = col.width(view::Live::Is(Some(280.0))).gap(view::Live::Is(12.0))
      let _ = CalendarYearPicker(
        col,
        selected_year=fn() { yr_sel.get() },
        on_select=fn(y) { yr_sel.set(y) },
      )
      let _ = DateField(
        col,
        value=fn() { df_val.get() },
        on_change=fn(v) { df_val.set(v) },
        label="DateField",
      )
      let _ = TimeField(
        col,
        value=fn() { tf_val.get() },
        on_change=fn(v) { tf_val.set(v) },
        label="TimeField",
      )
    })
  }, width=1000.0, height=700.0)

  t.frame()
  assert_aura_ui(t, label="1d-datetime-family")
  d_assert(t.find("November 2026") is Some(_), "Calendar must render November 2026")
  d_assert(t.find("DateField") is Some(_), "DateField must render label")
  d_assert(t.find("TimeField") is Some(_), "TimeField must render label")
  d_assert(t.find("PM") is Some(_), "TimeField 12h must render PM")

  // Verify Calendar, RangeCalendar, YearPicker, and SpinButton interactive selection
  d_assert(t.get("Calendar", role=view::Role::Grid) is Some(_), "Calendar must expose Role::Grid")
  d_assert(t.get("Range calendar", role=view::Role::Grid) is Some(_), "RangeCalendar must expose Role::Grid")
  d_assert(t.get("Select year", role=view::Role::Grid) is Some(_), "CalendarYearPicker must expose Role::Grid")
  d_assert(t.get("Month", role=view::Role::SpinButton) is Some(_), "DateField Month must expose Role::SpinButton")
  d_assert(t.get("AM/PM", role=view::Role::SpinButton) is Some(_), "TimeField AM/PM must expose Role::SpinButton")

  // Select 2026-11-15 via GridCell press
  t.press("2026-11-15")
  t.frame(ms=16.0)
  d_assert(match cal_sel.get() { Some(d) => d == headless_core::IsoDate::new(2026, 11, 15); None => false }, "pressing 2026-11-15 must select it")

  // Select year 2027 in CalendarYearPicker (page for 2026 is 2016..2027)
  t.press("2027")
  t.frame(ms=32.0)
  d_assert(yr_sel.get() == 2027, "pressing 2027 must select year 2027")

  // Step Month SpinButton up (11 -> 12) and clear with Backspace
  t.press("Month")
  t.frame(ms=48.0)
  t.key(headless_core::key_up)
  t.frame(ms=64.0)
  d_assert(match df_val.get().month { Some(m) => m == 12; None => false }, "ArrowUp on Month must increment 11 -> 12")
  t.key(headless_core::key_backspace)
  t.frame(ms=80.0)
  d_assert(df_val.get().month is None, "Backspace on Month must clear to empty placeholder")

  // Step AM/PM SpinButton (PM -> AM: 14 -> 2)
  t.press("AM/PM")
  t.frame(ms=96.0)
  t.key(headless_core::key_up)
  t.frame(ms=112.0)
  d_assert(match tf_val.get().hour { Some(h) => h == 2; None => false }, "ArrowUp on AM/PM must toggle 14 -> 2")

  t.dispose()
}

test "d_06_dark_mode_and_compound_input_groups_focus_within" {
  let fld = ui::Field::new(text="#17C964")
  let df_val = signals::signal_by(headless_core::SegmentedDateTime::empty(), fn(a, b) { a.eq(b) })
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, true)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = ColorInputGroup(
      root,
      field=fld,
      prefix=fn(p : view::View) -> Unit {
        let _ = ColorSwatch(p, color=view::Live::Is(0x17C964FFL), size=AuraColorSwatchSize::Xs)
      },
      force_focused=true,
    )
    let _ = DateInputGroup(
      root,
      invalid=view::Live::Is(true),
      children=fn(m : view::View) -> Unit {
        let _ = date_field_node(
          m,
          fn() { df_val.get() },
          fn(v) { df_val.set(v) },
          order=AuraDateOrder::YearMonthDay,
        )
      },
    )
  }, width=600.0, height=400.0)

  t.frame()
  assert_aura_ui(t, label="1d-dark-compound-groups")
  d_assert(t.find("yyyy") is Some(_), "empty DateField must display yyyy placeholder")
  d_assert(t.find("mm") is Some(_), "empty DateField must display mm placeholder")
  d_assert(t.find("dd") is Some(_), "empty DateField must display dd placeholder")
  t.dispose()
}

fn d_find_said(name : String, role : view::Role) -> Option[view::SaidNode] {
  match ui::view_tree() {
    Some(tree) => {
      for sn in tree.said_order() {
        match sn.said {
          Some(sd) =>
            if sd.role == role && sd.label == name {
              return Some(sn)
            }
          None => ()
        }
      }
      None
    }
    None => None
  }
}

test "d_07_colorfield_disabled_blocks_edits_and_controlled_sync_preserves_typing" {
  let red = signals::signal(0.0)
  let dis = signals::signal(true)
  let changes = signals::signal(0)
  let f = ui::Field::new(text="#000000")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = color_field_node(
      root,
      fn() { aura_color_rgba(red.get(), 0.0, 0.0) },
      fn(m) {
        changes.set(changes.get() + 1)
        red.set(m.to_srgba().r)
      },
      label="Hex Color",
      field_ref=f,
      disabled=view::Live::By(fn() { dis.get() }),
    )
  }, width=600.0, height=240.0)

  t.frame()
  // Disabled: assistive-tech / user replacement rolls back and never triggers on_change
  f.replace_from_user("#112233")
  t.frame(ms=16.0)
  d_assert(changes.get() == 0, "disabled ColorField must not invoke on_change")
  d_assert(f.text() == "#000000", "disabled ColorField must roll back text to #000000")

  // Disabled semantics: disabled=true and no SetText action
  match d_find_said("Hex Color", view::Role::TextField) {
    Some(s) => {
      d_assert(s.disabled, "disabled ColorField must expose disabled=true in semantics")
      match s.said {
        Some(sd) => d_assert(sd.actions.length() == 0, "disabled ColorField must not expose SetText action")
        None => d_assert(false, "missing Said payload on disabled ColorField")
      }
    }
    None => d_assert(false, "missing ColorField TextField semantics node")
  }

  // External controlled model change syncs text even when disabled / unfocused
  red.set(1.0)
  t.frame(ms=32.0)
  d_assert(f.text() == "#FF0000", "external controlled color update must sync field text to #FF0000")

  // Re-enable: editing intermediate partial hex while focused must not be clobbered
  dis.set(false)
  t.frame(ms=48.0)
  match d_find_said("Hex Color", view::Role::TextField) {
    Some(s) => {
      d_assert(!s.disabled, "enabled ColorField must expose disabled=false")
      match s.said {
        Some(sd) => d_assert(sd.actions.length() > 0, "enabled ColorField must expose SetText action")
        None => d_assert(false, "missing Said payload on enabled ColorField")
      }
    }
    None => d_assert(false, "missing enabled ColorField semantics node")
  }
  f.focus()
  t.frame(ms=64.0)
  f.replace_from_user("#12")
  t.frame(ms=80.0)
  d_assert(f.text() == "#12", "intermediate typing #12 must be preserved while focused")
  d_assert(changes.get() == 0, "incomplete hex #12 must not fire on_change")

  // Valid user edit fires on_change and updates model
  f.replace_from_user("#000000")
  t.frame(ms=96.0)
  d_assert(changes.get() == 1, "valid hex edit must fire on_change once")
  d_assert(red.get() < 0.01, "valid hex #000000 must update red channel to 0")

  // Subsequent external controlled update syncs text back
  red.set(1.0)
  t.frame(ms=112.0)
  d_assert(f.text() == "#FF0000", "subsequent controlled update must sync text to #FF0000")
  t.dispose()
}

test "d_08_color_textures_no_hook_leak_bounded_cache_and_shared_refcount" {
  let show = signals::signal(false)
  let blue = signals::signal(0.2)
  let active_reads = signals::signal(0)
  let stale_reads = signals::signal(0)
  let mut mounted_gen = 0

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = root.show(fn() { show.get() }, fn(host : view::View) -> Unit {
      mounted_gen = mounted_gen + 1
      let my_gen = mounted_gen
      let read_model = fn() -> headless_core::ColorModel {
        if my_gen == mounted_gen {
          active_reads.set(active_reads.untracked() + 1)
        } else {
          stale_reads.set(stale_reads.untracked() + 1)
        }
        aura_color_rgba(0.5, 0.5, blue.get(), alpha=0.75)
      }
      let _ = color_area_node(
        host,
        read_model,
        fn(_) { () },
        x_channel=headless_core::ColorChannel::Red,
        y_channel=headless_core::ColorChannel::Green,
        size=120.0,
      )
      let _ = color_slider_node(
        host,
        headless_core::ColorChannel::Alpha,
        read_model,
        fn(_) { () },
        label="Alpha",
      )
    })
  }, width=600.0, height=400.0)

  ui::images_reset()
  t.frame()
  let base_imgs = ui::image_cache_count()

  // Mount and unmount 100 times in one live tree: must not leak hooks, images, or stale model reads
  let mut i = 0
  while i < 100 {
    show.set(true)
    t.frame(ms=16.0)
    show.set(false)
    t.frame(ms=16.0)
    i += 1
  }
  d_assert(ui::image_cache_count() == base_imgs, "pure-GPU ColorArea mount/unmount must register 0 PNG textures")

  // Advance multiple frames after unmount: zero reads on unmounted closures
  let reads_before = active_reads.untracked()
  let stale_before = stale_reads.untracked()
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  d_assert(active_reads.untracked() == reads_before, "unmounted color widgets must not read model on subsequent frames")
  d_assert(stale_reads.untracked() == stale_before, "no stale color closures may run after unmount")

  // Change 80 distinct colors while mounted: 0 PNG textures registered
  show.set(true)
  t.frame(ms=16.0)
  let mut step = 0
  while step < 80 {
    blue.set(step.to_double() / 80.0)
    t.frame(ms=16.0)
    d_assert(ui::image_cache_count() == base_imgs, "color updates must remain 100% pure-GPU (0 PNG textures)")
    step += 1
  }
  show.set(false)
  t.frame(ms=16.0)
  d_assert(ui::image_cache_count() == base_imgs, "unmount leaves 0 PNG textures")
  t.dispose()
}

test "d_09_year_picker_no_out_of_page_cells_minmax_and_tail_navigation" {
  // 1) page_size = 4, selected = 2024 => years [2024, 2025, 2026, 2027], NO 2028/2029 GridCell
  let sel4 = signals::signal(2024)
  let t4 = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = calendar_year_picker_node(root, fn() { sel4.get() }, fn(y) { sel4.set(y) }, page_size=4)
  }, width=400.0, height=300.0)
  t4.frame()
  d_assert(t4.find("2024 – 2027") is Some(_), "page_size=4 header must show 2024 – 2027")
  for y in [2024, 2025, 2026, 2027] {
    d_assert(t4.get("\{y}", role=view::Role::GridCell) is Some(_), "expected in-page year \{y}")
  }
  d_assert(t4.get("2028", role=view::Role::GridCell) is None, "must not emit out-of-page GridCell 2028")
  d_assert(t4.get("2029", role=view::Role::GridCell) is None, "must not emit out-of-page GridCell 2029")

  // Tail-row keyboard navigation: press 2027, ArrowRight must stay on 2027 (no ghost 2028)
  t4.press("2027")
  t4.frame(ms=16.0)
  d_assert(sel4.get() == 2027, "pressing 2027 must select 2027")
  t4.key(headless_core::key_right)
  t4.frame(ms=16.0)
  t4.key(headless_core::key_enter)
  t4.frame(ms=16.0)
  d_assert(sel4.get() == 2027, "ArrowRight from last cell 2027 must not select out-of-page year")
  t4.dispose()

  // 2) page_size = 1 => single cell 2024, no 2025/2026
  let t1 = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = calendar_year_picker_node(root, fn() { 2024 }, fn(_) { () }, page_size=1)
  }, width=400.0, height=300.0)
  t1.frame()
  d_assert(t1.get("2024", role=view::Role::GridCell) is Some(_), "page_size=1 must render 2024")
  d_assert(t1.get("2025", role=view::Role::GridCell) is None, "page_size=1 must not emit 2025")
  d_assert(t1.get("2026", role=view::Role::GridCell) is None, "page_size=1 must not emit 2026")
  t1.dispose()

  // 3) page_size = 10 => 2020..2029 only, no 2030/2031
  let t10 = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = calendar_year_picker_node(root, fn() { 2024 }, fn(_) { () }, page_size=10)
  }, width=400.0, height=300.0)
  t10.frame()
  d_assert(t10.find("2020 – 2029") is Some(_), "page_size=10 header must show 2020 – 2029")
  d_assert(t10.get("2029", role=view::Role::GridCell) is Some(_), "page_size=10 must include 2029")
  d_assert(t10.get("2030", role=view::Role::GridCell) is None, "page_size=10 must not emit 2030")
  d_assert(t10.get("2031", role=view::Role::GridCell) is None, "page_size=10 must not emit 2031")
  t10.dispose()

  // 4) page_size = 12 with min_year=2020, max_year=2025
  let sel12 = signals::signal(2024)
  let t12 = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = calendar_year_picker_node(
      root,
      fn() { sel12.get() },
      fn(y) { sel12.set(y) },
      page_size=12,
      min_year=2020,
      max_year=2025,
    )
  }, width=400.0, height=300.0)
  t12.frame()
  d_assert(t12.get("2016", role=view::Role::GridCell) is Some(_), "page_size=12 must include 2016")
  d_assert(t12.get("2027", role=view::Role::GridCell) is Some(_), "page_size=12 must include 2027")
  d_assert(t12.get("2028", role=view::Role::GridCell) is None, "page_size=12 must not emit 2028")
  t12.press("2019")
  t12.frame(ms=16.0)
  d_assert(sel12.get() == 2024, "year below min_year must not be selectable")
  t12.press("2026")
  t12.frame(ms=16.0)
  d_assert(sel12.get() == 2024, "year above max_year must not be selectable")
  t12.press("2025")
  t12.frame(ms=16.0)
  d_assert(sel12.get() == 2025, "year within min/max must be selectable")
  t12.dispose()
}

test "d_10_png_encoder_signature_and_chunks" {
  let rgb : Array[Byte] = [
    255.to_byte(), 0.to_byte(), 0.to_byte(),
    0.to_byte(), 255.to_byte(), 0.to_byte(),
    0.to_byte(), 0.to_byte(), 255.to_byte(),
    255.to_byte(), 255.to_byte(), 255.to_byte(),
  ]
  let png = d_encode_rgb_png(2, 2, rgb)
  d_assert(png.length() >= 45, "encoded PNG must contain header + IHDR + IDAT + IEND")
  // Standard 8-byte PNG signature: 89 50 4E 47 0D 0A 1A 0A
  d_assert(png[0].to_int() == 137 && png[1].to_int() == 80 && png[2].to_int() == 78 && png[3].to_int() == 71, "PNG magic bytes 0..3")
  d_assert(png[4].to_int() == 13 && png[5].to_int() == 10 && png[6].to_int() == 26 && png[7].to_int() == 10, "PNG magic bytes 4..7")
  // IHDR chunk type at bytes 12..15, width=2 (byte 19), height=2 (byte 23), depth=8 (byte 24), color_type=2 RGB (byte 25)
  d_assert(png[12].to_int() == 73 && png[13].to_int() == 72 && png[14].to_int() == 68 && png[15].to_int() == 82, "IHDR chunk type")
  d_assert(png[19].to_int() == 2 && png[23].to_int() == 2, "IHDR width=2 height=2")
  d_assert(png[24].to_int() == 8 && png[25].to_int() == 2, "IHDR bit_depth=8 color_type=2 (RGB)")
  // Trailing IEND chunk type at length-8..length-4
  let n = png.length()
  d_assert(png[n - 8].to_int() == 73 && png[n - 7].to_int() == 69 && png[n - 6].to_int() == 78 && png[n - 5].to_int() == 68, "IEND chunk type")
}

test "d_r3_colorfield_deferred_external_sync_on_blur" {
  let color = signals::signal_by(aura_color_rgba(0.0, 0.0, 0.0), fn(a, b) { a.to_hex() == b.to_hex() })
  let changes = signals::signal(0)
  let fld = ui::Field::new(text="#000000")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = color_field_node(
      root,
      fn() { color.get() },
      fn(m) {
        changes.set(changes.untracked() + 1)
        color.set(m)
      },
      label="Hex",
      error_message="Bad hex",
      field_ref=fld,
    )
    let _ = button_node(root, view::Live::Is("Outside"))
  }, width=500.0, height=300.0)
  t.frame()
  d_assert(fld.text() == "#000000", "initial ColorField text must be #000000")

  // Focus and type invalid draft "#12"
  fld.focus()
  t.frame(ms=16.0)
  fld.replace_from_user("#12")
  t.frame(ms=32.0)
  d_assert(fld.text() == "#12", "invalid draft #12 kept while focused")
  d_assert(t.find("Bad hex") is Some(_), "invalid error message shown while draft is invalid")

  // Multiple external updates while focused must NOT clobber draft "#12"
  color.set(aura_color_rgba(0.0, 1.0, 0.0))
  t.frame(ms=48.0)
  d_assert(fld.text() == "#12", "first external update #00FF00 must not clobber active draft")
  color.set(aura_color_rgba(1.0, 0.0, 0.0))
  t.frame(ms=64.0)
  d_assert(fld.text() == "#12", "second external update #FF0000 must not clobber active draft")
  d_assert(changes.get() == 0, "external updates must not fire user on_change")

  // Blur: must immediately reconcile to latest external "#FF0000", clear invalid, zero user on_change
  t.press("Outside")
  t.frame(ms=80.0)
  d_assert(!fld.focused(), "ColorField must be blurred after pressing Outside")
  d_assert(fld.text() == "#FF0000", "blurred ColorField must sync to latest external #FF0000, got \{fld.text()}")
  d_assert(t.find("Bad hex") is None, "invalid error must clear after blur reconciliation")
  d_assert(changes.get() == 0, "blur reconciliation must NOT fire user on_change")

  // Re-focus and type a valid color: works normally
  fld.focus()
  t.frame(ms=96.0)
  fld.replace_from_user("#123456")
  t.frame(ms=112.0)
  d_assert(changes.get() == 1, "valid user edit after blur must fire on_change once")
  d_assert(color.get().to_hex() == "#123456", "model must update to #123456")
  t.dispose()
}

test "d_r4_color_area_pure_gpu_rgb_hsl_zero_png_and_unmount" {
  ui::images_reset()
  let show = signals::signal(true)
  let model = signals::signal_by(aura_color_rgba(0.2, 0.5, 0.8), fn(a, b) {
    a.h == b.h && a.s == b.s && a.v == b.v && a.alpha == b.alpha
  })
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    d_setup_root(root, false)
    let _ = root.show(fn() { show.get() }, fn(host : view::View) -> Unit {
      // Cold RGB (R/G), HSL (H/L), HSL (HslSaturation/Lightness), and ColorSliders
      let _ = color_area_node(
        host,
        fn() { model.get() },
        fn(m) { model.set(m) },
        x_channel=headless_core::ColorChannel::Red,
        y_channel=headless_core::ColorChannel::Green,
        size=120.0,
      )
      let _ = color_area_node(
        host,
        fn() { model.get() },
        fn(m) { model.set(m) },
        x_channel=headless_core::ColorChannel::Hue,
        y_channel=headless_core::ColorChannel::Lightness,
        size=120.0,
      )
      let _ = color_area_node(
        host,
        fn() { model.get() },
        fn(m) { model.set(m) },
        x_channel=headless_core::ColorChannel::HslSaturation,
        y_channel=headless_core::ColorChannel::Lightness,
        size=120.0,
      )
      let _ = color_slider_node(host, headless_core::ColorChannel::Hue, fn() { model.get() }, fn(_) { () }, label="Hue")
      let _ = color_slider_node(host, headless_core::ColorChannel::Alpha, fn() { model.get() }, fn(_) { () }, label="Alpha")
    })
  }, width=500.0, height=500.0)

  t.frame()
  d_assert(ui::image_cache_count() == 0, "cold mount of RGB+HSL ColorAreas must register 0 PNG textures")
  d_assert(ui::image_bytes_used() == 0.0, "cold mount must use 0 image bytes")

  // Drive 70 distinct color updates across all mounted RGB & HSL ColorAreas
  let mut k = 0
  while k < 70 {
    let frac = k.to_double() / 70.0
    model.set(aura_color_rgba(frac, 1.0 - frac, (frac * 0.7 + 0.15)))
    t.frame(ms=16.0)
    k += 1
  }
  d_assert(ui::image_cache_count() == 0, "70 color switches across RGB/HSL ColorAreas must register 0 PNG textures")
  d_assert(ui::image_bytes_used() == 0.0, "70 color switches must use 0 image bytes")

  // Unmount cleanly and advance frames: 0 leaked state / 0 PNG textures
  show.set(false)
  t.frame(ms=16.0)
  t.frame(ms=16.0)
  d_assert(ui::image_cache_count() == 0, "post-unmount must leave 0 PNG textures")
  t.dispose()
}

test "d_r4_skeleton_1_rect_gpu_shimmer_and_reduced_motion" {
  let reduced = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let cfg = signals::signal(AuraConfig::light())
    let _ = aura_provide_config(root, cfg)
    let _ = root.box(fn(col : view::View) -> Unit {
      let _ = col.width(view::Live::Is(Some(534.0))).gap(view::Live::Is(8.0))
      let _ = skeleton_node(col, width=534.0, height=24.0, radius=8.0)
      let _ = skeleton_group_node(col, gap=8.0, content=fn(g : view::View) -> Unit {
        let _ = skeleton_node(g, width=534.0, height=20.0, radius=6.0)
      })
    })
    let _ = reduced
  }, width=600.0, height=200.0)
  t.frame()
  // Pure-GPU 1-rect shimmer: total painted rects in tree must be tiny (<< 267 per 534pt bar)
  let drawn = t.drawn()
  let mut rect_count = 0
  for d in drawn {
    rect_count = rect_count + d.rects.length()
  }
  d_assert(rect_count == 0, "pure-GPU 1-rect Skeleton shimmer must emit 0 paint::Rect slices (got \{rect_count})")
  t.dispose()

  // Verify reduced_motion disables shimmer cleanly
  let cfg_rm = signals::signal(AuraConfig::{ ..AuraConfig::light(), reduced_motion: true })
  let t_rm = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = aura_provide_config(root, cfg_rm)
    let _ = skeleton_node(root, width=534.0, height=24.0, radius=8.0)
  }, width=600.0, height=100.0)
  t_rm.frame()
  assert_aura_ui(t_rm, label="d_r4_skeleton_reduced_motion")
  t_rm.dispose()
}

test "d_r3_rtl_mirroring_across_all_controls" {
  let cfg = signals::signal(AuraConfig::{ ..AuraConfig::light(), rtl: true })
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    ui::set_tree_theme(fn() -> ui::Theme { aura_ui_theme(cfg.get()) })
    let _ = aura_provide_config(root, cfg)
    let _ = root.pad(view::Live::Is(16.0)).gap(view::Live::Is(12.0))
    let _ = tabs_node(
      root,
      [
        AuraTabItem::{ key: "overview", label: "Overview", disabled: false, panel: fn(_) { () } },
        AuraTabItem::{ key: "details", label: "Details", disabled: false, panel: fn(_) { () } },
      ],
      fn() { "overview" },
      fn(_) { () },
      show_panels=false,
    )
    let _ = slider_node(root, view::Live::Is(65.0), fn(_) { () }, label=view::Live::Is("Volume"))
    let _ = progress_bar_node(root, fn() { Some(60.0) }, label="Progress")
    let _ = breadcrumbs_node(
      root,
      [
        AuraBreadcrumbItem::{ label: "Home", disabled: false, on_press: fn() { () } },
        AuraBreadcrumbItem::{ label: "Library", disabled: false, on_press: fn() { () } },
        AuraBreadcrumbItem::{ label: "Aura", disabled: false, on_press: fn() { () } },
      ],
    )
    let _ = button_group_node(root, content=fn(g : view::View) -> Unit {
      let _ = button_group_item_node(g, view::Live::Is("First"), 0, 3)
      let _ = button_group_item_node(g, view::Live::Is("Middle"), 1, 3)
      let _ = button_group_item_node(g, view::Live::Is("Last"), 2, 3)
    })
    let _ = input_group_node(root, content=fn(ig : view::View) -> Unit {
      let _ = input_group_prefix_node(ig, text=view::Live::Is("https://"))
      let _ = input_group_input_node(ig, value="invar.dev")
      let _ = input_group_suffix_node(ig, text=view::Live::Is(".org"))
    })
    let _ = alert_node(root, status=AuraAlertStatus::Accent, title=view::Live::Is("RTL Alert"), description=view::Live::Is("Check"))
    let _ = switch_node(root, view::Live::Is(true), fn(_) { () }, label=view::Live::Is("RTL Switch"))
  }, width=600.0, height=500.0)
  t.frame()
  match (t.find("Overview"), t.find("Details")) {
    (Some((ox, _)), Some((dx, _))) => d_assert(ox > dx, "RTL Tabs: Overview must be right of Details")
    _ => d_assert(false, "missing RTL Tabs labels")
  }
  match (t.find("Volume"), t.find("65")) {
    (Some((vx, _)), Some((nx, _))) => d_assert(vx > nx, "RTL Slider: Volume must be right of 65")
    _ => d_assert(false, "missing RTL Slider labels")
  }
  match (t.find("Progress"), t.find("60%")) {
    (Some((px, _)), Some((nx, _))) => d_assert(px > nx, "RTL ProgressBar: Progress must be right of 60%")
    _ => d_assert(false, "missing RTL ProgressBar labels")
  }
  match (t.find("Home"), t.find("Library"), t.find("Aura")) {
    (Some((hx, _)), Some((lx, _)), Some((ax, _))) =>
      d_assert(hx > lx && lx > ax, "RTL Breadcrumbs: Home > Library > Aura right-to-left")
    _ => d_assert(false, "missing RTL Breadcrumbs labels")
  }
  match (t.find("First"), t.find("Middle"), t.find("Last")) {
    (Some((fx, _)), Some((mx, _)), Some((lx, _))) =>
      d_assert(fx > mx && mx > lx, "RTL ButtonGroup: First > Middle > Last right-to-left")
    _ => d_assert(false, "missing RTL ButtonGroup labels")
  }
  match (t.find("https://"), t.find(".org")) {
    (Some((px, _)), Some((sx, _))) => d_assert(px > sx, "RTL InputGroup: prefix https:// must be right of suffix .org")
    _ => d_assert(false, "missing RTL InputGroup slots")
  }
  t.dispose()
}

test "d_r5_4_hsl_color_area_low_instance_count_and_zero_png_cache" {
  let pairs : Array[(headless_core::ColorChannel, headless_core::ColorChannel, String)] = [
    (headless_core::ColorChannel::Hue, headless_core::ColorChannel::Lightness, "Hue×Lightness"),
    (headless_core::ColorChannel::Lightness, headless_core::ColorChannel::Hue, "Lightness×Hue"),
    (headless_core::ColorChannel::Hue, headless_core::ColorChannel::HslSaturation, "Hue×HslSaturation"),
    (headless_core::ColorChannel::HslSaturation, headless_core::ColorChannel::Hue, "HslSaturation×Hue"),
    (headless_core::ColorChannel::HslSaturation, headless_core::ColorChannel::Lightness, "HslSaturation×Lightness"),
    (headless_core::ColorChannel::Lightness, headless_core::ColorChannel::HslSaturation, "Lightness×HslSaturation"),
  ]
  for pair in pairs {
    let col = signals::signal_by(
      headless_core::ColorModel::from_hsla(210.0, 0.8, 0.5),
      fn(a : headless_core::ColorModel, b : headless_core::ColorModel) -> Bool { a == b },
    )
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      let cfg = signals::signal(AuraConfig::light())
      let _ = aura_provide_config(root, cfg)
      let _ = color_area_node(
        root,
        fn() -> headless_core::ColorModel { col.get() },
        fn(c : headless_core::ColorModel) -> Unit { col.set(c) },
        x_channel=pair.0,
        y_channel=pair.1,
        size=224.0,
      )
    }, width=260.0, height=260.0)
    t.frame()
    let ninst = t.scene().ninst
    d_assert(ninst > 0 && ninst < 30, "\{pair.2} HSL ColorArea must use < 30 GPU instances (not 1540), got \{ninst}")
    d_assert(ui::image_cache_count() == 0, "\{pair.2} must keep image_cache_count == 0")
    d_assert(ui::image_bytes_used() == 0.0, "\{pair.2} must keep image_bytes_used == 0.0")
    // Verify 24 color updates stay fast & stable
    let mut k = 0
    while k < 24 {
      col.set(headless_core::ColorModel::from_hsla((k * 15).to_double(), 0.3 + (k % 7).to_double() * 0.1, 0.25 + (k % 5).to_double() * 0.12))
      t.frame(ms=(k + 1).to_double() * 16.0)
      k += 1
    }
    d_assert(t.scene().ninst == ninst, "\{pair.2} instance count must stay constant across updates")
    t.dispose()
  }
}
