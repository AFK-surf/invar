///|
/// What back does to it, while it takes input (as a key's: View::on_key): `f`, as back is done (the system's back let
/// go there, a back with no gesture, a back button), as one change outside any tracking; the topmost that takes back
/// takes it before any other (Tree::back_taker). Said in the place of what it followed back by (View::follows_back).
pub fn View::takes_back(self : View, f : () -> Unit) -> View {
  guard self.live() is Some(n) else { return self }
  if n.on_back is Option::None && n.on_back_step is Option::None {
    self.tree.backs.push(self.at)
  }
  n.on_back = Some(f)
  n.on_back_step = Option::None
  n.back_said = n.back_said + 1
  // (what takes back changed: what hosts the tree told, once the change is committed whole: Tree::on_modals)
  self.tree.modals_told()
  self
}

///|
/// A modal layer that lets a back gesture under way as it comes over what holds it go on to that (chosen as it began,
/// the whole gesture's: what the old frame's layers do), not called off for it; the next gesture is what is over then
/// (Tree::back_taker). Not said, a modal layer over what holds a gesture calls it off (Tree::back_lost_in).
pub fn View::held_back_goes_on(self : View) -> View {
  guard self.live() is Some(n) else { return self }
  n.back_goes_on = true
  self
}

///|
/// Back followed by it step by step, while it takes input (Tree::back_taker's order, as View::takes_back's): the system's
/// gesture as it goes (Began, Moved, LetGo, CalledOff: x from the edge it came from, at its moment), held by it from its
/// start; a back with no gesture one Back. Each step one change outside any tracking. Said in the place of what it took
/// back by (View::takes_back); said anew, a gesture under way goes on to it no more.
pub fn View::follows_back(self : View, f : (BackStep) -> Unit) -> View {
  guard self.live() is Some(n) else { return self }
  if n.on_back is Option::None && n.on_back_step is Option::None {
    self.tree.backs.push(self.at)
  }
  n.on_back_step = Some(f)
  n.on_back = Option::None
  n.back_said = n.back_said + 1
  self.tree.modals_told()
  self
}

///|
/// What takes back now of the tree's: the node drawn last that takes back (View::takes_back, View::follows_back) and may
/// take input; none where no node does. Asked of those that take back alone (Tree's `backs`, a few), not of every node
/// of the tree walked for them each frame: of two that may take it, the one drawn after the other by where each is
/// among what holds it from the root (as the walk from the root, later kids first, found it first).
pub fn Tree::back_taker(self : Tree) -> Option[NodeId] {
  if self.backs.is_empty() || self.nodes.length() == 0 || !self.nodes[0].live {
    return Option::None
  }
  let mut top = -1
  let mut top_path : Array[Int] = []
  for at in self.backs {
    let n = self.nodes[at]
    if !n.live || (n.on_back is Option::None && n.on_back_step is Option::None) || self.pressless_at(at) || !self.held_from_root(at) {
      continue
    }
    if top < 0 {
      top = at
      continue
    }
    if top_path.is_empty() {
      guard self.kids_path(top) is Some(tp) else {
        top = at
        continue
      }
      top_path = tp
    }
    guard self.kids_path(at) is Some(path) else { continue }
    if drawn_after(path, top_path) {
      top = at
      top_path = path
    }
  }
  if top < 0 {
    Option::None
  } else {
    Some(NodeId::{ at: top, gen: self.nodes[top].gen })
  }
}

///|
/// Where node `at` is from the root: which of each one's kids holds it, the root's first (Tree::layer_path's, by the
/// root's kids as they are, not its layers); none where it is not held so from the root (put by, View::park, or taken
/// out of what held it).
fn Tree::kids_path(self : Tree, at : Int) -> Option[Array[Int]] {
  let path : Array[Int] = []
  let mut i = at
  while i != 0 {
    let p = self.nodes[i].parent
    guard p >= 0 && mbt_compat::arr_search(self.nodes[p].kids, i) is Option::Some(k) else { return Option::None }
    path.push(k)
    i = p
  }
  mbt_compat::arr_rev_in_place(path)
  Some(path)
}

///|
/// Step `step` of back to node `id` as one event at `at`: a gesture begun (Began) or a back with no gesture (Back) to it
/// where it takes back and may take input then, the gesture held by it as it said it then; each step after (Moved,
/// LetGo, CalledOff) to the one holding it alone, as it said it then, the gesture let go as it is let go or called off.
/// What takes back once (View::takes_back) is told back done as the gesture is let go, or with no gesture; what follows
/// it (View::follows_back) each step. Whether it took it.
pub fn Tree::back_step(self : Tree, id : NodeId, step : BackStep, at : Double) -> Bool {
  let took = mbt_compat::ref_new(false)
  self.event(at, fn() {
    guard self.alive_id(id) else { return }
    let n = self.nodes[id.at]
    let mine = Some((id, n.back_said))
    match step {
      BackStep::Began(_, _) | BackStep::Back => {
        if self.pressless_at(id.at) || (n.on_back is Option::None && n.on_back_step is Option::None) {
          return
        }
        if step is BackStep::Began(_, _) {
          self.backing = mine
        }
      }
      _ => {
        guard self.backing == mine else { return }
        if step is BackStep::LetGo(_, _) || step is BackStep::CalledOff {
          self.backing = Option::None
        }
      }
    }
    took.v = true
    back_told(n, step)
  })
  took.v
}

///|
/// The gesture node `id` holds done as the system decided (its back confirmed, from where the gesture had it), as one
/// event at `at`: where it still holds it as it said it as it began, the gesture let go first, then it told so as a back
/// (Back to what follows it, done to what takes it once); held by another saying of it, or by none (said anew, called
/// off, let go), nothing: no gesture's end taken for a back of its own. Whether it took it.
pub fn Tree::back_done(self : Tree, id : NodeId, at : Double) -> Bool {
  let took = mbt_compat::ref_new(false)
  self.event(at, fn() {
    guard self.backing is Some((held, said)) && held == id else { return }
    // (let go of first: what it does as it is told finds no gesture held)
    self.backing = Option::None
    guard self.alive_id(id) && self.nodes[id.at].back_said == said else { return }
    took.v = true
    back_told(self.nodes[id.at], BackStep::Back)
  })
  took.v
}

///|
/// Node `n` told back's step (Tree::back_step): what follows it each, what takes it once back done (let go, or none
/// followed), outside any tracking.
fn back_told(n : Node, step : BackStep) -> Unit {
  match (n.on_back_step, n.on_back, step) {
    (Some(f), _, _) => signals::untracked(fn() { f(step) })
    (None, Some(f), LetGo(_, _)) | (None, Some(f), Back) => signals::untracked(f)
    _ => ()
  }
}

///|
/// The gesture held by a node where it is `at` or in it (0: wherever it is) called off for it, at the moment of what did
/// it (taking no input from then: leaving, said to take no press, a modal layer over it): what follows it told so once
/// (CalledOff), the rest of the gesture nobody's.
fn Tree::back_lost_in(self : Tree, at : Int) -> Unit {
  guard self.backing is Some((id, said)) else { return }
  let mut i = id.at
  let mut under = false
  while i >= 0 && i < self.nodes.length() {
    if i == at {
      under = true
      break
    }
    i = self.nodes[i].parent
  }
  if !under {
    return
  }
  self.backing = Option::None
  if self.alive_id(id) && self.nodes[id.at].back_said == said {
    back_told(self.nodes[id.at], BackStep::CalledOff)
  }
}

///|
/// What forward does to it, while it takes input (as a key's: View::on_key): `f`, as forward is done (a forward gesture
/// let go there, or a forward with no gesture), as one change outside any tracking; the topmost that takes forward takes
/// it before any other (Tree::forward_taker). Said in the place of what it followed forward by (View::follows_forward).
pub fn View::takes_forward(self : View, when? : () -> Bool, f : () -> Unit) -> View {
  guard self.live() is Some(n) else { return self }
  if n.on_forward is Option::None && n.on_forward_step is Option::None {
    self.tree.forwards.push(self.at)
  }
  n.on_forward = Some(f)
  n.on_forward_step = Option::None
  n.forward_when = when
  n.forward_said = n.forward_said + 1
  self
}

///|
/// Forward followed by it step by step, while it takes input (Tree::forward_taker's order, as View::takes_forward's):
/// the gesture as it goes (Began, Moved, LetGo, CalledOff: x from where it began, at its moment), held by it from its
/// start. Each step one change outside any tracking. Said in the place of what it took forward by (View::takes_forward);
/// said anew, a gesture under way goes on to it no more.
pub fn View::follows_forward(self : View, when? : () -> Bool, f : (BackStep) -> Unit) -> View {
  guard self.live() is Some(n) else { return self }
  if n.on_forward is Option::None && n.on_forward_step is Option::None {
    self.tree.forwards.push(self.at)
  }
  n.on_forward_step = Some(f)
  n.on_forward = Option::None
  n.forward_when = when
  n.forward_said = n.forward_said + 1
  self
}

///|
fn forward_node_ready(n : Node) -> Bool {
  match n.forward_when {
    Some(when) => signals::untracked(when)
    Option::None => true
  }
}

///|
/// What takes forward now of the tree's: the node drawn last that takes forward (View::takes_forward,
/// View::follows_forward) and may take input; none where no node does.
pub fn Tree::forward_taker(self : Tree) -> Option[NodeId] {
  if self.forwards.is_empty() || self.nodes.length() == 0 || !self.nodes[0].live {
    return Option::None
  }
  let mut top = -1
  let mut top_path : Array[Int] = []
  for at in self.forwards {
    let n = self.nodes[at]
    if !n.live ||
    (n.on_forward is Option::None && n.on_forward_step is Option::None) ||
    self.pressless_at(at) ||
    !self.held_from_root(at) ||
    !forward_node_ready(n) {
      continue
    }
    if top < 0 {
      top = at
      continue
    }
    if top_path.is_empty() {
      guard self.kids_path(top) is Some(tp) else {
        top = at
        continue
      }
      top_path = tp
    }
    guard self.kids_path(at) is Some(path) else { continue }
    if drawn_after(path, top_path) {
      top = at
      top_path = path
    }
  }
  if top < 0 {
    Option::None
  } else {
    Some(NodeId::{ at: top, gen: self.nodes[top].gen })
  }
}

///|
/// Step `step` of forward to node `id` as one event at `at`: a gesture begun (Began) or a forward with no gesture (Back)
/// to it where it takes forward and may take input then, the gesture held by it as it said it then; each step after
/// (Moved, LetGo, CalledOff) to the one holding it alone, as it said it then, the gesture let go as it is let go or
/// called off. Whether it took it.
pub fn Tree::forward_step(self : Tree, id : NodeId, step : BackStep, at : Double) -> Bool {
  let took = mbt_compat::ref_new(false)
  self.event(at, fn() {
    guard self.alive_id(id) else { return }
    let n = self.nodes[id.at]
    let mine = Some((id, n.forward_said))
    match step {
      BackStep::Began(_, _) | BackStep::Back => {
        if self.pressless_at(id.at) || (n.on_forward is Option::None && n.on_forward_step is Option::None) || !forward_node_ready(n) {
          return
        }
        if step is BackStep::Began(_, _) {
          self.forwarding = mine
        }
      }
      _ => {
        guard self.forwarding == mine else { return }
        if step is BackStep::LetGo(_, _) || step is BackStep::CalledOff {
          self.forwarding = Option::None
        }
      }
    }
    took.v = true
    forward_told(n, step)
  })
  took.v
}

///|
fn forward_told(n : Node, step : BackStep) -> Unit {
  match (n.on_forward_step, n.on_forward, step) {
    (Some(f), _, _) => signals::untracked(fn() { f(step) })
    (None, Some(f), LetGo(_, _)) | (None, Some(f), Back) => signals::untracked(f)
    _ => ()
  }
}

///|
/// The forward gesture held by a node where it is `at` or in it (0: wherever it is) called off for it, at the moment of
/// what did it (taking no input from then: leaving, said to take no press, a modal layer over it): what follows it told
/// so once (CalledOff), the rest of the gesture nobody's.
fn Tree::forward_lost_in(self : Tree, at : Int) -> Unit {
  guard self.forwarding is Some((id, said)) else { return }
  let mut i = id.at
  let mut under = false
  while i >= 0 && i < self.nodes.length() {
    if i == at {
      under = true
      break
    }
    i = self.nodes[i].parent
  }
  if !under {
    return
  }
  self.forwarding = Option::None
  if self.alive_id(id) && self.nodes[id.at].forward_said == said {
    forward_told(self.nodes[id.at], BackStep::CalledOff)
  }
}

///|
/// A modal layer that leaves what is typed to the field of an old view under it that has the focus (a menu a finger
/// opens beside a field, its input method left in place: kit's dropdown_menu's): the text typed that field's still;
/// every key, the wheel and every press the layer's and what it holds, as a modal layer's are, none of them the
/// field's or anything else's under it.
pub fn View::leaves_typing(self : View) -> View {
  guard self.live() is Some(n) else { return self }
  n.leaves_typing = true
  self
}
