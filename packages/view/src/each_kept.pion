import "signals"

// A row of View::each kept as its key leaves (its `keeps`): put by (View::park: held by no node, so not laid out,
// placed, drawn, pressed, focused or read out; what it binds at rest, @signals.rest: what is held while it is read let
// go of, nothing of it worked out again meanwhile) instead of let go, and taken in again (View::take_in, its item set,
// woken, put in its order by each_place) as its key is among the items again: the same nodes, as they were left. Let go
// as its key is no more kept, and with the each. Nothing else of it is its own: no way in or out (it is there already,
// or out of sight at once), no lifecycle but park, take_in and rest. What is due on the tree's timeline in it
// (View::at_moment) still comes due as it rests, and a way read by the clock is where the clock has it as it is woken
// (at_rest_today_wbtest.mbt), so a row taken in within its way shows that way where the clock is then.

///|
/// What an each keeps of the rows whose keys left: `keys_of` the keys kept, read where the items are read (a change of
/// it is a change of them, View::each); `keys` as it was read last; each row put by with what wakes it; the wakings due
/// as the change taking them in ends.
struct EachKept[K, T] {
  keys_of : () -> Array[K]
  keeps_holds : (K) -> Bool
  mut keys : Array[K]
  put_by : KMap[K, (View, signals::Signal[T], Array[() -> Unit], signals::Ref[Bool])]
  wakes : Array[() -> Unit]
}

///|
fn EachKept::new[K : ViewKey, T](
  keys_of : () -> Array[K],
  keeps_holds : (K) -> Bool,
) -> EachKept[K, T] {
  EachKept::{ keys_of, keeps_holds, keys: [], put_by: kmap_new(), wakes: [] }
}

///|
/// The row put by for key `k`, as its item `it` is among the items again: taken into `slot` (after what it holds: put in
/// its order as the change ends, each_place), its item set as it rests (worked out as it wakes), its waking due as the
/// change ends (each_kept_settle). None: none put by for it.
fn each_kept_takes[K : ViewKey, T](
  slot : View,
  kept : Option[EachKept[K, T]],
  k : K,
  it : T,
) -> Option[(View, signals::Signal[T])] {
  let e = match kept {
    Some(e) => e
    _ => { return None }
  }
  let (v, item, wakes, holding) = match e.put_by.get(k) {
    Some((v, item, wakes, holding)) => (v, item, wakes, holding)
    _ => { return None }
  }
  e.put_by.remove(k)
  holding.v = false
  guard v.alive() else { return None }
  slot.take_in(v)
  item.set(it)
  e.wakes.push(fn() {
    answering(fn() {
      for w in wakes {
        w()
      }
    })
  })
  Some((v, item))
}

///|
/// Row `r` of key `k`, gone from the items, put by where its key is kept (before it is asked of any way out: it takes
/// none); whether it was.
fn each_kept_parks[K : ViewKey, T](
  slot : View,
  kept : Option[EachKept[K, T]],
  k : K,
  r : (View, signals::Signal[T]),
) -> Bool {
  let e = match kept {
    Some(e) => e
    _ => { return false }
  }
  guard e.keys.contains(k) else { return false }
  guard r.0.alive() else { return false }
  if !(e.keeps_holds)(k) {
    let wake = slot.park(r.0)
    e.put_by.set(k, (r.0, r.1, [wake], ref_new(false)))
  } else {
    let _ = slot.park(r.0, rest=false)
    let wakes : Array[() -> Unit] = []
    let holding = ref_new(true)
    e.put_by.set(k, (r.0, r.1, wakes, holding))
    slot.tree.after_bindings.push(fn() {
      if e.put_by.contains(k) && r.0.alive() && holding.v {
        slot.tree.rest_in(r.0.at, wakes, drop_holds=false)
      }
    })
  }
  true
}

///|
/// As a change of the each ends: those put by whose keys are no more kept let go (held by nothing, let go by nothing
/// else), those that stopped keeping holds drop their holds, and those taken in woken, each binding that let go of what
/// it read or whose reads changed meanwhile worked out anew, in their places.
fn each_kept_settle[K : ViewKey, T](slot : View, kept : Option[EachKept[K, T]]) -> Unit {
  let e = match kept {
    Some(e) => e
    _ => { return }
  }
  let gone = array_filter(e.put_by.keys(), fn(k) { !e.keys.contains(k) })
  for k in gone {
    match e.put_by.get(k) {
      Some((v, _, _, holding)) => {
        holding.v = false
        e.put_by.remove(k)
        v.let_go()
      }
      None => ()
    }
  }
  for k in e.put_by.keys() {
    let entry = match e.put_by.get(k) {
      Some(kv_val) => kv_val
      None => continue
    }
    let (v, _, wakes, holding) = entry
    if holding.v && !(e.keeps_holds)(k) {
      holding.v = false
      if v.alive() {
        slot.tree.rest_in(v.at, wakes, drop_holds=true)
      }
    }
  }
  let wakes = e.wakes.copy()
  e.wakes.clear()
  array_release_unused(e.wakes, run_gone)
  for w in wakes {
    w()
  }
}

///|
/// All it put by let go, with the each.
fn EachKept::let_go_all[K, T](self : EachKept[K, T]) -> Unit {
  let all = self.put_by.values()
  self.put_by.clear()
  for r in all {
    (r.3).v = false
    r.0.let_go()
  }
}
