// Layout ergonomics: common flex composition helpers that prevent intrinsic-size overflow in nested flex containers
// (`View::fill`) and center children along both axes (`View::center`).

///|
/// Fill the remaining space in a flex container while allowing it to shrink below its content's intrinsic size:
/// equivalent to `self.grow(Is(1.0)).shrink(Is(1.0)).basis(Is(Some(0.0))).min_width(Is(Some(0.0))).min_height(Is(Some(0.0)))`.
pub fn View::fill(self : View, loc~ : String = "") -> View {
  self
  .grow(Is(1.0), loc=loc)
  .shrink(Is(1.0), loc=loc)
  .basis(Is(Some(0.0)), loc=loc)
  .min_width(Is(Some(0.0)), loc=loc)
  .min_height(Is(Some(0.0)), loc=loc)
}

///|
/// Center children along both the main and cross axes:
/// equivalent to `self.lies_along(Is(Middle)).lines_up(Is(Some(Middle)))`.
pub fn View::center(self : View, loc~ : String = "") -> View {
  self.lies_along(Is(Lies::Middle), loc=loc).lines_up(Is(Some(Along::Middle)), loc=loc)
}

///|
/// Fix exact width and height while preventing flex containers from squashing the node:
/// equivalent to `self.width(Is(Some(w))).height(Is(Some(h))).shrink(Is(0.0))`.
pub fn View::fixed(self : View, w : Double, h : Double, loc~ : String = "") -> View {
  self.width(Is(Some(w)), loc=loc).height(Is(Some(h)), loc=loc).shrink(Is(0.0), loc=loc)
}

///|
/// Prevent flex containers from shrinking this node below its size:
/// equivalent to `self.shrink(Is(0.0))`.
pub fn View::rigid(self : View, loc~ : String = "") -> View {
  self.shrink(Is(0.0), loc=loc)
}

///|
/// Lay out children horizontally in a row:
/// equivalent to `self.row(Is(true))`.
pub fn View::as_row(self : View, loc~ : String = "") -> View {
  self.row(Is(true), loc=loc)
}

///|
/// Clip painted descendants to this node's bounds:
/// equivalent to `self.clips(Is(true))`.
pub fn View::clip(self : View, loc~ : String = "") -> View {
  self.clips(Is(true), loc=loc)
}

///|
/// Allow this node to give way along a row and stay within its column width:
/// equivalent to `self.cuts(Is(true))`.
pub fn View::cut(self : View, loc~ : String = "") -> View {
  self.cuts(Is(true), loc=loc)
}

///|
/// Shorthand constructor for a static `Live::Is(v)` value (`is` and `val` are Pion keywords).
pub fn live[T](v : T) -> Live[T] {
  Live::Is(v)
}

///|
/// Shorthand constructor for a reactive `Live::By(f)` value
/// (named `live_by` because `by` is used as a local callback parameter name inside `packages/view`).
pub fn live_by[T](f : () -> T) -> Live[T] {
  Live::By(f)
}

///|
/// Shorthand constructor for a static `Live::Is(Some(v))` optional value.
pub fn is_some[T](v : T) -> Live[Option[T]] {
  Live::Is(Some(v))
}

///|
/// Set static width in points: equivalent to `self.width(Is(Some(v)))`.
pub fn View::w(self : View, v : Double, loc~ : String = "") -> View {
  self.width(Is(Some(v)), loc=loc)
}

///|
/// Set static height in points: equivalent to `self.height(Is(Some(v)))`.
pub fn View::h(self : View, v : Double, loc~ : String = "") -> View {
  self.height(Is(Some(v)), loc=loc)
}

///|
/// Set static width and height in points: equivalent to `self.width(Is(Some(w))).height(Is(Some(h)))`.
pub fn View::size(self : View, w : Double, h : Double, loc~ : String = "") -> View {
  self.width(Is(Some(w)), loc=loc).height(Is(Some(h)), loc=loc)
}

///|
/// Set static minimum width in points: equivalent to `self.min_width(Is(Some(v)))`.
pub fn View::min_w(self : View, v : Double, loc~ : String = "") -> View {
  self.min_width(Is(Some(v)), loc=loc)
}

///|
/// Set static minimum height in points: equivalent to `self.min_height(Is(Some(v)))`.
pub fn View::min_h(self : View, v : Double, loc~ : String = "") -> View {
  self.min_height(Is(Some(v)), loc=loc)
}

///|
/// Set static maximum width in points: equivalent to `self.max_width(Is(Some(v)))`.
pub fn View::max_w(self : View, v : Double, loc~ : String = "") -> View {
  self.max_width(Is(Some(v)), loc=loc)
}

///|
/// Set static maximum height in points: equivalent to `self.max_height(Is(Some(v)))`.
pub fn View::max_h(self : View, v : Double, loc~ : String = "") -> View {
  self.max_height(Is(Some(v)), loc=loc)
}

///|
/// Set static flex-grow factor: equivalent to `self.grow(Is(g))`.
pub fn View::grow_by(self : View, g : Double, loc~ : String = "") -> View {
  self.grow(Is(g), loc=loc)
}

///|
/// Lay out children vertically in a column: equivalent to `self.row(Is(false))`.
pub fn View::as_col(self : View, loc~ : String = "") -> View {
  self.row(Is(false), loc=loc)
}

///|
/// Enable flex wrapping with optional `line_gap` (default `0.0`): equivalent to `self.wraps(Is(Some(line_gap)))`.
pub fn View::wrap_on(self : View, line_gap~ : Double = 0.0, loc~ : String = "") -> View {
  self.wraps(Is(Some(line_gap)), loc=loc)
}

///|
/// Set uniform static padding on all four sides: equivalent to `self.pad(Is(p))`.
pub fn View::pad_all(self : View, p : Double, loc~ : String = "") -> View {
  self.pad(Is(p), loc=loc)
}

///|
/// Set horizontal (`x`) and vertical (`y`) static padding: equivalent to `self.padding(Is((x, y, x, y)))`.
pub fn View::pad_xy(self : View, x : Double, y : Double, loc~ : String = "") -> View {
  self.padding(Is((x, y, x, y)), loc=loc)
}

///|
/// Set static gap between children in points: equivalent to `self.gap(Is(g))`.
pub fn View::gap_px(self : View, g : Double, loc~ : String = "") -> View {
  self.gap(Is(g), loc=loc)
}

///|
/// Set static cross-axis alignment for children: equivalent to `self.lines_up(Is(Some(a)))`.
pub fn View::align_items(self : View, a : Along, loc~ : String = "") -> View {
  self.lines_up(Is(Some(a)), loc=loc)
}

///|
/// Set static main-axis alignment for children: equivalent to `self.lies_along(Is(l))`.
pub fn View::justify(self : View, l : Lies, loc~ : String = "") -> View {
  self.lies_along(Is(l), loc=loc)
}

///|
/// Position this node absolutely at `(x, y)` from its parent's top-left corner:
/// equivalent to `self.over(Is(true), edges=(Some(x), Some(y), None, None))`.
pub fn View::over_xy(self : View, x : Double, y : Double, loc~ : String = "") -> View {
  self.over(Is(true), edges=(Some(x), Some(y), None, None), loc=loc)
}

///|
/// Set static background color (`0xRRGGBBAAL`): equivalent to `self.ground(Is(color))`.
pub fn View::bg(self : View, color : Int64, loc~ : String = "") -> View {
  self.ground(Is(color), loc=loc)
}

///|
/// Set static corner radius in points: equivalent to `self.radius(Is(radius))`.
pub fn View::r(self : View, radius : Double, loc~ : String = "") -> View {
  self.radius(Is(radius), loc=loc)
}

///|
/// Set static border color and stroke width: equivalent to `self.edge(Is((width, color)))`.
pub fn View::border(self : View, color : Int64, width : Double, loc~ : String = "") -> View {
  self.edge(Is((width, color)), loc=loc)
}

///|
/// Set static opacity in `[0.0, 1.0]`: equivalent to `self.alpha(Is(a))`.
pub fn View::alpha_is(self : View, a : Double, loc~ : String = "") -> View {
  self.alpha(Is(a), loc=loc)
}

///|
/// Set static layout visibility (`true` = `Flex`, `false` = `DisplayNone`):
/// equivalent to `self.laid_nowhere(Is(!visible))`.
pub fn View::shown_is(self : View, visible : Bool, loc~ : String = "") -> View {
  self.laid_nowhere(Is(!visible), loc=loc)
}

///|
/// Create a dedicated vertical scrolling child box that fills remaining space:
/// delegates to `self.scroll_box(body, scroll=..., loc=loc)`.
pub fn View::scroll_y(self : View, body : (View) -> Unit, scroll? : Scroll, loc~ : String = "") -> View {
  match scroll {
    Some(sc) => self.scroll_box(body, scroll=sc, loc=loc)
    None => self.scroll_box(body, loc=loc)
  }
}

///|
/// Set static text foreground color (`0xRRGGBBAAL`): equivalent to `self.ink(Is(color))`.
pub fn View::fg(self : View, color : Int64, loc~ : String = "") -> View {
  self.ink(Is(color), loc=loc)
}

///|
/// Set static text content with size, optional color (`0L` keeps theme ink), and weight:
/// delegates to `self.words(Is(text), ink=..., look=WordsLook::of(size, weight=weight))`.
pub fn View::label(
  self : View,
  text : String,
  size~ : Double = 14.0,
  color~ : Int64 = 0L,
  weight~ : Int = 400,
  loc~ : String = "",
) -> View {
  let look = WordsLook::of(size, weight=weight)
  if color != 0L {
    self.words(Is(text), ink=color, look=look, loc=loc)
  } else {
    self.words(Is(text), look=look, loc=loc)
  }
}
