import "signals"

test "focus_within clears up the whole ancestor chain when the focused node is let go" {
  let grand_fw = ref_new(false)
  let parent_fw = ref_new(false)
  let grand_ref : signals::Ref[Option[View]] = ref_new(None)
  let parent_ref : signals::Ref[Option[View]] = ref_new(None)
  let child_ref : signals::Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(grand : View) {
      grand_ref.v = Some(grand)
      let _ = grand.reacts(fn() { grand.focus_within() }, fn(v) { grand_fw.v = v })
      let _ = grand.box(fn(parent : View) {
        parent_ref.v = Some(parent)
        let _ = parent.reacts(fn() { parent.focus_within() }, fn(v) { parent_fw.v = v })
        let _ = parent.focusable(Is(true))
        let _ = parent.box(fn(child : View) {
          child_ref.v = Some(child)
          let _ = child.focusable(Is(true)).width(Is(Some(20.0))).height(Is(Some(20.0)))
        })
      })
    })
  })
  let _ = t.frame(200.0, 200.0)
  let child = match child_ref.v {
    Some(c) => c
    None => { debug_assert(false, "child built"); return }
  }
  let grand = match grand_ref.v {
    Some(g) => g
    None => { debug_assert(false, "grand built"); return }
  }
  let parent = match parent_ref.v {
    Some(p) => p
    None => { debug_assert(false, "parent built"); return }
  }
  let _ = t.focus_to(Some(child.id()), visible=true)
  let _ = t.frame(200.0, 200.0)
  debug_assert(parent_fw.v && grand_fw.v, "focus on the child sets focus_within along its ancestors")
  debug_assert(parent.focus_within() && grand.focus_within(), "read back true while the child holds the focus")
  // (the focused child itself let go: it is marked dead before its focus is lost)
  child.let_go()
  let _ = t.frame(200.0, 200.0)
  debug_assert(t.focused.is_none(), "the focus goes with the node let go")
  debug_assert(!parent_fw.v, "the parent's focus_within is told false at once")
  debug_assert(!grand_fw.v, "the grandparent's focus_within is told false at once")
  debug_assert(!parent.focus_within() && !grand.focus_within(), "and reads false afterwards")
  // (focus elsewhere and back again still works on a fresh chain)
  let _ = t.focus_to(Some(parent.id()), visible=false)
  debug_assert(parent_fw.v && grand_fw.v, "focusing the parent sets its own chain again")
  let _ = t.focus_to(None)
  debug_assert(!parent_fw.v && !grand_fw.v, "and clears it again")
}
