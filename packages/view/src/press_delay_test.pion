// Delayed `View::press_shown()` indication inside scrollable containers (`Tree::press_delay_in_scroll`):
// - `View::pressed()` stays immediate for input logic regardless of scroll containers.
// - Inside a vertical or horizontal `View::scrolls`, `View::press_shown()` waits `delay_ms` before lighting.
// - Releasing or losing the hold before `delay_ms` cancels the timer so `View::press_shown()` never flashes.
// - Holding past `delay_ms` and then losing the hold immediately clears `View::press_shown()`.
// - Outside any scroller (or when `delay_ms == 0`), `View::press_shown()` lights immediately.
// - Disposing a node while its press delay is pending cancels the timer without firing reactions.

import "signals"

let press_delay_test_ms : Double = 100.0
let press_delay_half_ms : Double = 50.0
let press_delay_past_ms : Double = 150.0

test "press_delay_in_scroll: pressed() stays immediate; press_shown() delays in vertical/horizontal scroll and cancels on release or dispose" {
  let delay_ms = ref_new(press_delay_test_ms)
  let outside_v : signals::Ref[Option[View]] = ref_new(None)
  let vert_v : signals::Ref[Option[View]] = ref_new(None)
  let horiz_v : signals::Ref[Option[View]] = ref_new(None)
  let show_vert : signals::Signal[Bool] = signals::signal(true)
  let vert_shown_flips = ref_new(0)
  let tree = Tree::new(fn(root : View) {
    let _ = root.box(fn(out : View) {
      let _ = out.width(Is(Some(100.0))).height(Is(Some(40.0))).presses(Is(true))
      outside_v.v = Some(out)
    })
    let _ = root.box(fn(sc : View) {
      let _ = sc.width(Is(Some(200.0))).height(Is(Some(120.0))).scrolls(Scroll::new(), fn(held : View) {
        held.show(at_once=true, fn() { show_vert.get() }, fn(v : View) {
          let _ = v.width(Is(Some(200.0))).height(Is(Some(40.0))).presses(Is(true))
          v.reacts(fn() { v.press_shown() }, at_start=false, fn(on : Bool) {
            if on {
              vert_shown_flips.v = vert_shown_flips.v + 1
            }
          })
          vert_v.v = Some(v)
        })
        let _ = held.box(fn(pad : View) {
          let _ = pad.height(Is(Some(300.0)))
        })
      })
    })
    let _ = root.box(fn(sc : View) {
      let _ = sc.width(Is(Some(200.0))).height(Is(Some(50.0))).scrolls(Scroll::across(), fn(held : View) {
        let _ = held.row(Is(true))
        let _ = held.box(fn(h : View) {
          let _ = h.width(Is(Some(80.0))).height(Is(Some(40.0))).presses(Is(true))
          horiz_v.v = Some(h)
        })
        let _ = held.box(fn(pad : View) {
          let _ = pad.width(Is(Some(300.0))).height(Is(Some(40.0)))
        })
      })
    })
  })
  tree.press_delay_in_scroll(fn() { delay_ms.v })
  let _ = tree.frame(300.0, 400.0, now=0.0)
  let out = match outside_v.v { Some(v) => v; None => panic("missing outside_v") }
  let vert = match vert_v.v { Some(v) => v; None => panic("missing vert_v") }
  let horiz = match horiz_v.v { Some(v) => v; None => panic("missing horiz_v") }
  let is_pressed = fn(v : View) -> Bool { signals::untracked(fn() { v.pressed() }) }
  let is_shown = fn(v : View) -> Bool { signals::untracked(fn() { v.press_shown() }) }

  // 1. Outside scroller: both pressed() and press_shown() light immediately at t0
  let t1 = 10.0
  tree.event(t1, fn() { tree.hold_press(out.id()) })
  let out_p0 = is_pressed(out)
  let out_s0 = is_shown(out)
  tree.event(t1 + 10.0, fn() { let _ = tree.press_held(out.id()) })
  debug_assert(out_p0 && out_s0, "outside scroller: both pressed() and press_shown() light immediately")
  debug_assert(!is_pressed(out) && !is_shown(out), "outside scroller: cleared on release")

  // 2. Inside vertical scroller, held past delay: pressed() immediate, press_shown() dark before and lit at delay
  let t2 = 100.0
  tree.event(t2, fn() { tree.hold_press(vert.id()) })
  let vert_p0 = is_pressed(vert)
  let vert_s0 = is_shown(vert)
  tree.advance(t2 + press_delay_half_ms)
  let vert_p50 = is_pressed(vert)
  let vert_s50 = is_shown(vert)
  tree.advance(t2 + press_delay_test_ms)
  let vert_p100 = is_pressed(vert)
  let vert_s100 = is_shown(vert)
  tree.event(t2 + press_delay_test_ms + 20.0, fn() { let _ = tree.press_held(vert.id()) })
  debug_assert(vert_p0 && !vert_s0, "vertical scroll at t0: pressed=true, press_shown=false")
  debug_assert(vert_p50 && !vert_s50, "vertical scroll at half delay: pressed=true, press_shown=false")
  debug_assert(vert_p100 && vert_s100, "vertical scroll at full delay: pressed=true, press_shown=true")
  debug_assert(!is_pressed(vert) && !is_shown(vert), "vertical scroll after release: both false")

  // 3. Inside vertical scroller, released early at half delay: press_shown() never lights even past full delay
  let flips_before_early = vert_shown_flips.v
  let t3 = 300.0
  tree.event(t3, fn() { tree.hold_press(vert.id()) })
  tree.advance(t3 + press_delay_half_ms)
  tree.event(t3 + press_delay_half_ms, fn() { let _ = tree.press_held(vert.id()) })
  tree.advance(t3 + press_delay_past_ms)
  debug_assert(!is_shown(vert) && vert_shown_flips.v == flips_before_early, "early release cancels pending press_shown timer")

  // 4. Inside horizontal scroller (Scroll::across): press_shown() also delayed until press_delay_test_ms
  let t4 = 500.0
  tree.event(t4, fn() { tree.hold_press(horiz.id()) })
  let horiz_p0 = is_pressed(horiz)
  let horiz_s0 = is_shown(horiz)
  tree.advance(t4 + press_delay_test_ms)
  let horiz_p100 = is_pressed(horiz)
  let horiz_s100 = is_shown(horiz)
  tree.event(t4 + press_delay_test_ms + 20.0, fn() { let _ = tree.press_held(horiz.id()) })
  debug_assert(horiz_p0 && !horiz_s0, "horizontal scroll at t0: pressed=true, press_shown=false")
  debug_assert(horiz_p100 && horiz_s100, "horizontal scroll at full delay: pressed=true, press_shown=true")
  debug_assert(!is_pressed(horiz) && !is_shown(horiz), "horizontal scroll after release: both false")

  // 5. With 0ms delay (e.g. Mouse): press_shown() lights immediately even inside scroller
  delay_ms.v = 0.0
  let t5 = 700.0
  tree.event(t5, fn() { tree.hold_press(vert.id()) })
  let vert_mouse = is_shown(vert)
  tree.event(t5 + 10.0, fn() { let _ = tree.press_held(vert.id()) })
  debug_assert(vert_mouse, "0ms delay lights press_shown immediately inside scroller")

  // 6. Disposing node while delay is pending cancels timer and releases holder cleanly
  delay_ms.v = press_delay_test_ms
  let flips_before_dispose = vert_shown_flips.v
  let t6 = 800.0
  tree.event(t6, fn() { tree.hold_press(vert.id()) })
  show_vert.set(false)
  let _ = tree.frame(300.0, 400.0, now=t6 + 20.0)
  let holder_after_dispose = tree.holder()
  tree.advance(t6 + press_delay_past_ms)
  debug_assert(holder_after_dispose is None && vert_shown_flips.v == flips_before_dispose, "disposing pending node cancels timer and clears holder")
  tree.dispose()
}
