import "signals"

// View::morph_overlay: what it draws otherwise is told by Tree::drawn_rev, of the node and of what holds it, though
// nothing of it is laid out at another size (what is kept as drawn by that count draws each step of a morph).

fn morph_rev_told(t : Tree, held : NodeId, by : NodeId, what : String, f : () -> Unit) -> Unit {
  let w = t.nodes[by.at].flex.width
  let h = t.nodes[by.at].flex.height
  let taken = t.drawn_rev_taken()
  f()
  let _ = t.frame(200.0, 200.0)
  debug_assert(t.drawn_rev(by) > taken, "\{what}: drawn_rev of the node \{t.drawn_rev(by)} past \{taken}")
  debug_assert(t.drawn_rev(held) > taken, "\{what}: drawn_rev of what holds it \{t.drawn_rev(held)} past \{taken}")
  debug_assert(t.nodes[by.at].flex.width == w && t.nodes[by.at].flex.height == h, "\{what}: laid out as it was")
}

test "morph_overlay tells drawn_rev as each channel changes, its size the same" {
  let alpha = signals::signal(1.0)
  let dx = signals::signal(0.0)
  let scale = signals::signal(1.0)
  let dh = signals::signal(0.0)
  let held : signals::Ref[Option[View]] = ref_new(None)
  let at : signals::Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    held.v = Some(root.box(fn(p : View) {
      at.v = Some(p.box(fn(b : View) {
        let _ = b.width(Is(Some(80.0))).height(Is(Some(40.0))).ground(Is(0x112233FF.to_int64()))
      }))
    }))
  })
  let _ = t.frame(200.0, 200.0)
  match (held.v, at.v) {
    (Some(p), Some(b)) => {
      let pid = p.id()
      let id = b.id()
      let end : signals::Ref[() -> Unit] = ref_new(fn() { })
      morph_rev_told(t, pid, id, "attached", fn() {
        end.v = b.morph_overlay(
          alpha=By(fn() { alpha.get() }),
          offset=By(fn() { (dx.get(), 0.0) }),
          scale=By(fn() { scale.get() }),
          ground_drawn=By(fn() { GroundShape::{ ..ground_as_laid, dh: dh.get() } }),
        )
      })
      morph_rev_told(t, pid, id, "ground_drawn", fn() { dh.set(-10.0) })
      debug_assert(t.ground_drawn_of(id).dh == -10.0, "its ground drawn shorter")
      morph_rev_told(t, pid, id, "alpha", fn() { alpha.set(0.5) })
      morph_rev_told(t, pid, id, "offset", fn() { dx.set(6.0) })
      morph_rev_told(t, pid, id, "scale", fn() { scale.set(0.9) })
      // As it stands, told nothing.
      let taken = t.drawn_rev_taken()
      let _ = t.frame(200.0, 200.0)
      debug_assert(t.drawn_rev(id) <= taken, "at rest, as it was drawn")
      morph_rev_told(t, pid, id, "ended", end.v)
      debug_assert(t.ground_drawn_of(id).dh == 0.0, "its ground as laid out")
      let fn_end : signals::Ref[() -> Unit] = ref_new(fn() { })
      morph_rev_told(t, pid, id, "ground_drawn_fn", fn() {
        fn_end.v = b.morph_overlay(ground_drawn_fn=fn(_, _, w, _) { GroundShape::{ ..ground_as_laid, dw: -w / 2.0 } })
      })
      debug_assert(t.ground_drawn_of(id).dw == -40.0, "its ground half as wide")
      morph_rev_told(t, pid, id, "ground_drawn is", fn() {
        let _ = b.morph_overlay(ground_drawn=Is(GroundShape::{ ..ground_as_laid, dx: 3.0 }))
      })
      morph_rev_told(t, pid, id, "ground_drawn_fn ended", fn_end.v)
      debug_assert(t.ground_drawn_of(id).dx == 3.0, "the one left drawn by")
    }
    _ => debug_assert(false, "made")
  }
  t.dispose()
}
