import "signals"

// What one outermost Tree::laid_out may run of its post-layout re-entries (laid_passes_most), and the frame after it.

// The cycle over (`on`), a legal layout of the next frame goes on to its end, with nothing left due.
fn settles(t : Tree, w : signals::Signal[Double], on : signals::Ref[Bool], box : Int) -> Unit {
  debug_assert(t.laid_depth == 0, "nothing laid out any more: \{t.laid_depth}")
  on.v = false
  w.set(150.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(t.nodes[box].flex.width == 150.0, "next frame lays out what was set: \{t.nodes[box].flex.width}")
  debug_assert(t.laid_depth == 0 && t.laid_passes < laid_passes_most, "counted anew: \{t.laid_passes}")
  debug_assert(!t.due && t.laid_waits.length() == 0 && !t.outs_changed, "nothing left due")
  t.dispose()
}

test "once_laid_out cycle in Tree::laid_out stops within bound" {
  let runs = ref_new(0)
  let on = ref_new(true)
  let w = signals::signal(100.0)
  let box : signals::Ref[Int] = ref_new(-1)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(b : View) {
      box.v = b.at
      let _ = b.width(By(fn() { Some(w.get()) })).height(Is(Some(40.0)))
    })
  })
  let again : signals::Ref[() -> Unit] = ref_new(fn() { })
  again.v = fn() {
    t.once_laid_out(fn() {
      if on.v && runs.v < 200 {
        runs.v = runs.v + 1
        w.set(if w.untracked() == 100.0 { 120.0 } else { 100.0 })
        (again.v)()
      }
    })
  }
  (again.v)()
  let _ = t.frame(300.0, 300.0)
  debug_assert(runs.v > 1, "the cycle ran: \{runs.v}")
  debug_assert(runs.v <= laid_passes_most + 1, "once_laid_out cycle stays within laid_passes_most: \{runs.v}")
  settles(t, w, on, box.v)
  again.v = fn() { }
}

test "sizes_told oscillation in Tree::laid_out stops within bound" {
  let runs = ref_new(0)
  let on = ref_new(true)
  let w = signals::signal(100.0)
  let box : signals::Ref[Int] = ref_new(-1)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(b : View) {
      box.v = b.at
      let _ = b.width(By(fn() { Some(w.get()) })).height(Is(Some(40.0)))
      b.reacts_by(
        fn() { b.laid_size_told() },
        fn(x, y) { opt_pair_dd_eq(x, y) },
        fn(sz) {
          match sz {
            Some((bw, _)) if on.v && runs.v < 200 => {
              runs.v = runs.v + 1
              w.set(if bw < 110.0 { 120.0 } else { 100.0 })
            }
            _ => ()
          }
        },
        at_start=false,
      )
    })
  })
  let _ = t.frame(300.0, 300.0)
  debug_assert(runs.v > 1, "the cycle ran: \{runs.v}")
  debug_assert(runs.v <= laid_passes_most + 1, "sizes_told cycle stays within laid_passes_most: \{runs.v}")
  settles(t, w, on, box.v)
}

test "outs_told oscillation in Tree::laid_out stops within bound" {
  let runs = ref_new(0)
  let on = ref_new(true)
  let w = signals::signal(100.0)
  let box : signals::Ref[Int] = ref_new(-1)
  w.set(80.0)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(r : View) {
      box.v = r.at
      let _ = r.row(Is(true)).width(By(fn() { Some(w.get()) })).height(Is(Some(40.0))).fits(Is(true))
      let _ = r.box(fn(a : View) { let _ = a.width(Is(Some(60.0))).height(Is(Some(20.0))) })
      let _ = r.box(fn(b : View) {
        let _ = b.width(Is(Some(60.0))).height(Is(Some(20.0))).drops(Is(1))
        b.reacts(
          fn() { b.left_out() },
          fn(out : Bool) {
            if on.v && runs.v < 200 {
              runs.v = runs.v + 1
              w.set(if out { 160.0 } else { 80.0 })
            }
          },
          at_start=false,
        )
      })
    })
  })
  let _ = t.frame(300.0, 300.0)
  debug_assert(runs.v > 1, "the cycle ran: \{runs.v}")
  debug_assert(runs.v <= laid_passes_most + 1, "outs_told cycle stays within laid_passes_most: \{runs.v}")
  settles(t, w, on, box.v)
}

test "a chain of once_laid_out shorter than the bound settles in one frame" {
  let left = ref_new(laid_passes_most - 2)
  let w = signals::signal(10.0)
  let box : signals::Ref[Int] = ref_new(-1)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(b : View) {
      box.v = b.at
      let _ = b.width(By(fn() { Some(w.get()) })).height(Is(Some(40.0)))
    })
  })
  let again : signals::Ref[() -> Unit] = ref_new(fn() { })
  again.v = fn() {
    t.once_laid_out(fn() {
      if left.v > 0 {
        left.v = left.v - 1
        w.set(w.untracked() + 1.0)
        (again.v)()
      }
    })
  }
  (again.v)()
  let _ = t.frame(300.0, 300.0)
  let width = t.nodes[box.v].flex.width
  debug_assert(left.v == 0 && width == 10.0 + (laid_passes_most - 2).to_double(), "all of it in one frame: \{left.v}, \{width}")
  debug_assert(!t.due, "nothing left due")
  again.v = fn() { }
  t.dispose()
}

test "a chain longer than the bound goes on in the next frame" {
  let left = ref_new(laid_passes_most + 20)
  let w = signals::signal(10.0)
  let box : signals::Ref[Int] = ref_new(-1)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(b : View) {
      box.v = b.at
      let _ = b.width(By(fn() { Some(w.get()) })).height(Is(Some(40.0)))
    })
  })
  let again : signals::Ref[() -> Unit] = ref_new(fn() { })
  again.v = fn() {
    t.once_laid_out(fn() {
      if left.v > 0 {
        left.v = left.v - 1
        w.set(w.untracked() + 1.0)
        (again.v)()
      }
    })
  }
  (again.v)()
  let asked = ref_new(0)
  t.on_due(fn() { asked.v = asked.v + 1 })
  let _ = t.frame(300.0, 300.0)
  debug_assert(left.v == 20 && t.laid_waits.length() == 1, "the rest kept, waiting: \{left.v}")
  debug_assert(t.due && asked.v > 0, "the next frame asked for: \{asked.v}")
  let _ = t.frame(300.0, 300.0)
  let width = t.nodes[box.v].flex.width
  debug_assert(left.v == 0 && width == 10.0 + (laid_passes_most + 20).to_double(), "done in it: \{left.v}, \{width}")
  debug_assert(!t.due, "nothing left due")
  again.v = fn() { }
  t.dispose()
}

test "what is under the pointer, left untold by the bound, is told in the next frame" {
  let left = ref_new(laid_passes_most)
  let x = signals::signal(200.0)
  let over = ref_new(false)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(b : View) {
      let _ = b.over_at(By(fn() { (Some(x.get()), Some(0.0), None, None) })).width(Is(Some(20.0))).height(Is(Some(40.0)))
      b.reacts(fn() { b.pointer_within() }, fn(v : Bool) { over.v = v })
    })
  })
  let _ = t.frame(300.0, 300.0)
  t.point_at(150.0, 20.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!over.v && !t.due, "off it at first")
  let asked = ref_new(0)
  t.on_due(fn() { asked.v = asked.v + 1 })
  let again : signals::Ref[() -> Unit] = ref_new(fn() { })
  again.v = fn() {
    t.once_laid_out(fn() {
      left.v = left.v - 1
      x.set(x.untracked() - 1.0)
      if left.v > 0 {
        (again.v)()
      }
    })
  }
  (again.v)()
  let _ = t.frame(300.0, 300.0)
  debug_assert(left.v == 0 && t.laid_waits.length() == 0, "the chain done, the bound met: \{left.v}")
  debug_assert(!over.v && t.due && asked.v > 0, "untold, the next frame asked for: \{asked.v}")
  let _ = t.frame(300.0, 300.0)
  debug_assert(over.v && !t.due, "told in it, nothing left due")
  again.v = fn() { }
  t.dispose()
}
