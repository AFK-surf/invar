/// where it says none.
pub fn ListPlace::span_between[K : mbt_compat::MbtHash + Eq + mbt_compat::MapKey](self : ListPlace[K], from : K, to : K, from_slice? : Int, to_slice? : Int, measured? : Bool) -> Option[Double] {
