        coming: false,
        come_said: None,
        come_off: fn() { },
        come_wake: None,
        clips_said: false,
        clips_down: false,
        come_uncut: false,
        list_key_way: false,
        inert: false,
        takes_unseen: false,
        alpha_animating: false,
        modal: false,
        back_goes_on: false,
        leaves_typing: false,
        over_all: false,
        over_scrim: false,
