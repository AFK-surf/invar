import "dmath"
import "flex"
import "signals"
import "text"

let current_tree_room_ref : signals::Ref[Option[signals::Signal[(Double, Double)]]] = signals::ref_new(None)
let view_ctx_hook_registered : signals::Ref[Bool] = signals::ref_new(false)

fn ensure_view_ctx_hook() -> Unit {
  if view_ctx_hook_registered.v {
    return
  }
  view_ctx_hook_registered.v = true
  signals::register_reactive_context(fn() -> (() -> (() -> Unit)) {
    let captured_room = current_tree_room_ref.v
    fn() -> (() -> Unit) {
      let prev_room = current_tree_room_ref.v
      current_tree_room_ref.v = captured_room
      fn() -> Unit {
        current_tree_room_ref.v = prev_room
      }
    }
  })
}

fn init_view_ctx_hook() -> Bool {
  ensure_view_ctx_hook()
  true
}

let view_ctx_hook_init : Bool = init_view_ctx_hook()

///|
/// Active tree's stable size signal `(width, height)` during tree construction, layout, or reactive binding evaluation.
pub fn current_tree_room() -> Option[signals::Signal[(Double, Double)]] {
  current_tree_room_ref.v
}

///|
/// Temporarily clear the active tree room scope while executing `f`, restoring the prior scope on exit.
pub fn without_tree_room[T](f : () -> T) -> T {
  let prev = current_tree_room_ref.v
  current_tree_room_ref.v = None
  let out = f()
  current_tree_room_ref.v = prev
  out
}

fn with_tree_room[T](room : signals::Signal[(Double, Double)], body : () -> T) -> T {
  let prev = current_tree_room_ref.v
  current_tree_room_ref.v = Some(room)
  let out = body()
  current_tree_room_ref.v = prev
  out
}

///|
/// A handle on a node made once: the tree, its index, its making there.
pub struct View {
  tree : Tree
  at : Int
  gen : Int
}

///|
/// A tree whose root `make` makes (as the root's own: its bindings, its nodes), its words measured by `measure` (in
/// pieces set their own way: `measure_runs`; how narrow they may wrap: `measure_runs_least`; said a shorter way where too
/// wide: `measure_shorter`), each told the size
/// of words of the node whose words they are (View::words_scale's), keeping where in the source each node was made
/// where `sources` (source.mbt).
pub fn Tree::new(
  make : (View) -> Unit,
  measure~ : (String, WordsLook, Double, Double) -> (Double, Double) = words_measure,
  measure_runs~ : (Array[text::Run], WordsLook, RunsLook, Double, Double) -> (Double, Double) = runs_measure,
  measure_shorter? : (String, Array[String], WordsLook, Double, Double) -> Double,
  measure_kept? : (String, WordsLook, Double, Double) -> (Double, Double),
  measure_runs_kept? : (Array[text::Run], WordsLook, RunsLook, Double, Double) -> (Double, Double),
  measure_runs_least~ : (Array[text::Run], WordsLook, RunsLook, Double) -> Double = runs_least_measure,
  time? : () -> Double,
  sources~ : Bool = false,
) -> Tree {
  // (nothing a tree made before left waiting for its moment's last change: Tree::moment_waits_run)
  tree_moment_waits.clear()
  // (the moment it is made, taken once: its logic and what it draws start there, and what it is made with is of then)
  let start = match time {
    Some(f) => f()
    None => 0.0
  }
  let t : Tree = Tree::{ phys_id: next_phys_id(),
    clock: signals::signal_by(start, fn(a, b) { a == b }),
    frame_ms: start,
    beat: signals::signal_by(start, fn(a, b) { a == b }),
    resident: signals::signal_by(resident_of(start), fn(a, b) { a == b }),
    resident_readers: Map::new(),
    resident_said: (-1, -1, -1.0, -1, false),
    resident_rev: 0,
    keyed: KeyBook::new(),
    places: signals::signal(0),
    room: signals::signal_by((0.0, 0.0), fn(a, b) { pair_dd_eq(a, b) }),
    clear: signals::signal_by((0.0, 0.0, 0.0, 0.0), fn(a, b) { quad_dddd_eq(a, b) }),
    pressed_anywhere: signals::signal_by((0, -1.0, -1.0), fn(a, b) { triple_idd_eq(a, b) }),
    held_anywhere: signals::signal_by(false, fn(a, b) { a == b }),
    tapped_anywhere: signals::signal_by(0, fn(a, b) { a == b }),
    words_redone: signals::signal_by(0, fn(a, b) { a == b }),
    outs_said: signals::signal_by(0, fn(a, b) { a == b }),
    outs_changed: false,
    sizes_due: false,
    sized: [],
    shows_due: [],
    focus_holds: Map::new(),
    outs_gone: [],
    time,
    cause_at: -1.0,
    measure,
    measure_runs,
    measure_shorter: match measure_shorter {
      Some(f) => f
      None => fn(words, shorter, look, room, scale) { shorter_w_by(measure, words, shorter, look, room, scale) }
    },
    measure_kept: measure_kept.unwrap_or(measure),
    measure_runs_kept: measure_runs_kept.unwrap_or(measure_runs),
    measure_runs_least,
    sources,
    nodes: [],
    free: [],
    looks_due: [],
    places_due: [],
    bindings_due: [],
    after_bindings: [],
    told_passes: 0,
    laid_depth: 0,
    laid_passes: 0,
    pass_log: [],
    pass_again: -1,
    layout_first: -1,
    pass_via: -1,
    event_passes: 0,
    event_passes_most: 0,
    in_events: 0,
    withins_owed: false,
    moment_passes: [],
    draining: 0,
    bindings: 0,
    pulls_marked: [],
    timeline: [],
    leave_holders: [],
    swaps: [],
    come_groups: Map::new(),
    list_inner: Map::new(),
    pick_waits: Map::new(),
    come_ways_said: Map::new(),
    come_ways_lead: Map::new(),
    carried_rows: Map::new(),
    flip_rows: Map::new(),
    flip_gone: Map::new(),
    flip_lists: Map::new(),
    list_feet: Map::new(),
    list_raised: Map::new(),
    old_builds_begun: 0,
    old_builds: 0,
    old_built_waits: [],
    shown_bys: Map::new(),
    shown_followers: Map::new(),
    placed_followers: Map::new(),
    told: 0,
    clock_came_at: -1.0e9,
    advancing: false,
    logic: start,
    layout_due: true,
    order_due: true,
    order_in: [],
    kept_seen: (0, 0, 0, 0, 0),
    kept_waits: 0,
    kept_inputs_waits: 0,
    order_ins: [],
    order_outs: [],
    letting: [],
    order_whole: true,
    due: true,
    telling_due: false,
    due_frame_taken: false,
    last_w: -1.0,
    last_h: -1.0,
    order: [],
    order_holder: [],
    order_end: [],
    order_of: [],
    tops: [],
    order_gen: [],
    order_was: [],
    order_changed: [],
    order_stamp: 0,
    order_new: [],
    order_new_holder: [],
    order_new_end: [],
    walks: [],
    walking: 0,
    draws_rev: 0,
    draws_any_rev: 0,
    drawn_next: FixedArray::make(0, 0),
    drawn_next_for: (-1, -1, -1),
    drawn_path: [],
    hosting: -1,
    held_under: -2,
    held_under_of: None,
    modals: [],
    backs: [],
    committing: 0,
    afters: [],
    modals_due: false,
    held: None,
    gesture_tapped: false,
    held_tracks: Map::new(),
    through: None,
    through_cover: None,
    hold_in: None,
    hold_in_off: fn() { },
    on_through: fn(_, _, _, _, _) { },
    hosts_at: fn(_, _, _) { None },
    retarget: fn(t, _, _, _) { t },
    glides: fn(_, _) { },
    glides_gone: fn(_) { },
    moves: fn(_, _, _) { },
    offset_moved: fn(_) { },
    list_feel: fn() { (Desktop, 1.0) },
    drags_scroll: fn() { true },
    motion_reduced: fn() { false },
    press_least: fn() { 0.0 },
    twice_feel: fn() { (double_press_ms, double_press_slop) },
    last_press: None,
    env: Env::new(),
    laid_waits: [],
    pressing: None,
    pointed: None,
    lit_every: false,
    pointer_xy: (-1.0, -1.0),
    old_scroll_here: fn() { false },
    key_point: (-1.0, -1.0),
    old_there: fn(_, _, _) { true },
    points_hover: None,
    scrolls_at: Map::new(),
    reused_slots: Map::new(),
    bar_cols: [],
    drawn_marks: [],
    bars_due: false,
    backing: None,
    focused: None,
    focus_row_list: None,
    focus_within_chain: [],
    focus_row_n: 0,
    focus_parked: None,
    focus_visible: false,
    on_focus_lost: fn(_) { },
    on_outs: fn() { },
    on_focus_asked: None,
    focus_opened: [],
    focus_gone: [],
    focus_firsts: kmap_new(),
    focus_first_takes: kmap_new(),
    layer_openers: kmap_new(),
    on_layers_focus: fn(_, _) { },
    has_layers_focus: false,
    point_stop: None,
    gone: false,
    besides_at: [],
    beside_widths: Map::new(),
    withins_at: [],
    withins_passing: false,
    pointer_still: None,
    pointer_again: false,
    pointer_pass: 0,
    inputs_at: [],
    inputs_in: [],
    inputs_whole: false,
    point_said: 0,
    hits: 0,
    ticking: false,
    laying: false,
    binding_running: 0,
    bound_by_clock: false,
    hand_owed: false,
    hand_owed_at: -1.0,
    sight_tellers: Map::new(),
    sight_owed: true,
    sight_owed_at: -1.0,
    sights_telling: false,
    handing: false,
    hand_at: -1.0,
    hand_ends: [],
    hand_ends_done: -1.0,
    looks_reading: false,
    hand: fn(_) { },
    bones_set: 0,
    behind_set: 0,
    transitions_only_set: 0,
    clock_read_now: false,
    defaults_set: 0,
    laid_said: Map::new(),
    shakes_said: Map::new(),
    downs: [],
    changed: [],
    composed: [],
    scrolled_now: false,
    scrolled_ats: [],
    drawn_revs: 1,
    places_rev: 0,
    said_revs: 1,
    said_seen: 0,
    said_modal: (-3, -3, -3, -3),
    said_again: Map::new(),
    said_helds: Map::new(),
    removed: [],
    pending: [],
    drawn_due: false,
    before_causes: 0,
    scrims: 0,
    standing: false,
    moves_unlaid: false,
    settle_asked: false,
    settle_at: 0.0,
    measured_gen: -1,
    walk_from: -1,
    measuring: false,
    binding_reading: -1,
    alone_due: [],
    alone_at: 0,
    alone_laid: [],
    alone_asks: Map::new(),
    rows_named: Map::new(),
    carried: Map::new(),
    words_edges: Map::new(),
    lists_scrolled: Map::new(),
    lists_asked: Map::new(),
    rooming: -1,
    room_marks: 0,
    room_spill: [],
    pixel_grid: 0.0,
    stickies: Map::new(),
    sticky_extra: Map::new(),
    reveals: Map::new(),
    rows_grid: 0.0,
    rows_lists: [],
    thumbs: Map::new(),
    rows_grid_said: signals::signal(0.0),
    on_due: fn() { },
    on_cursor: fn() { },
    flush_cause_at: -1.0,
    hands: signals::signal(true),
    on_modals: fn() { },
    shared_live: Map::new(),
    shared_n: 0,
    shared_moving: Map::new(),
    shared_stays: Map::new(),
    departures: [],
    arrivals: [],
    incoming: [],
    pairs_asked: false,
    images_wanted: [],
    flights: [],
    ways_set: [],
    answer_marks: [],
    binding_answered: false,
    lifting: false,
    laids: 0,
    held_kept: [],
    held_kept_for: (-1, -1, -1, -1),
    held_walked: 0,
    boxes_held: 0,
    boxes_held_at: [],
    boxes_one_by_one: 0,
    timed: None,
    structuring: 0,
    measured_ms: 0.0,
    said_count: 0,
    work: Work::{
      besides: 0,
      made: 0,
      let_go: 0,
      bound: 0,
      same: 0,
      computes: 0,
      laid: 0,
      visited: 0,
      measured: 0,
      instances: 0,
      composed: 0,
      changes: 0,
      orders: 0,
      boxes_walked: 0,
      structure: 0,
      pulled: 0,
      drawn_boxes: 0,
      settles: 0,
      found_walked: 0,
      near_kept: 0,
      inputs_walked: 0,
      order_copied: 0,
      passes: 0,
      again: FixedArray::make(8, 0),
      bindings_run: 0,
    },
  }
  // (the clock held while it is read, as a core's topic is: what reads it at rest (put by, View::park; rested in place,
  // View::rests) lets go of it, so the tree is not moving for a way nothing draws, and reads it anew as it wakes,
  // where the clock has it then: @signals.rest)
  t.clock.on_unwatched(fn() { })
  ensure_view_ctx_hook()
  let root = t.made(-1, loc="")
  let prev_room = current_tree_room_ref.v
  current_tree_room_ref.v = Some(t.room)
  if t.sources {
    root.owning(fn() { root.make_with_effect_diagnostics(make) })
  } else {
    root.owning(fn() { make(root) })
  }
  current_tree_room_ref.v = prev_room
  t
}

///|
/// Words measured as a test's are: 7 a character, 18 a line, wrapped to the width offered, whatever the size of words.
pub fn words_measure(words : String, _look : WordsLook, width : Double, _scale : Double) -> (Double, Double) {
  let full = words.length().to_double() * 7.0
  if full <= 0.0 {
    return (0.0, 0.0)
  }
  let w = if width > 0.0 && width < full { width } else { full }
  let lines = if w > 0.0 { (full / w).ceil() } else { 1.0 }
  (w, lines * 18.0)
}

///|
/// A node made in `parent` (-1: the root), its scope its own (made with nothing reading: owned by nothing else),
/// made at `loc` in the source (kept where the tree keeps that: source.mbt), its words at the size they are said where
/// `words_as_said` (what it is made in's, or its own: View::box).
fn Tree::made(self : Tree, parent : Int, words_as_said~ : Bool = false, loc~ : String) -> View {
  self.work.made = self.work.made + 1
  self.hits_bump()
  let at = match self.free.pop() {
    Some(i) => {
      let n = self.nodes[i]
      n.gen = n.gen + 1
      n.live = true
      n.flex = flex::Node::new()
      n.look.ground = 0.to_int64()
      n.look.ground_over = 0.to_int64()
      n.look.ink = 0.to_int64()
      n.look.words = ""
      n.look.words_drawn = None
      // (each array it holds empty made anew only where it is not: never changed in place, only set again)
      if n.shorter.length() > 0 {
        n.shorter = []
      }
      n.shrink_said = None
      n.min_w_said = None
      n.max_w_said = None
      n.min_w_within = false
      n.max_w_within = false
      if n.look.runs.length() > 0 {
        n.look.runs = []
      }
      n.look.runs_look = runs_plain
      n.look.runs_pressed = -1
      n.look.runs_picked = (0, 0)
      if n.look.runs_marks.length() > 0 {
        n.look.runs_marks = []
      }
      if n.look.shapes.length() > 0 {
        n.look.shapes = []
      }
      n.look.tint = 0.to_int64()
      n.look.radius = 0.0
      n.look.corners = None
      n.look.edge = (0.0, 0.to_int64())
      n.look.ring = (0.0, 0.0, 0.to_int64())
      n.look.focus_ring = None
      n.look.image = None
      n.look.image_for = (0.0, 0.0)
      n.look.image_cover = false
      n.look.image_contain = false
      n.look.image_cover_at = None
      n.look.image_fade = false
      n.look.image_in = None
      n.look.glass = None
      n.look.words_look = words_plain
      n.look.shadow = (0.0, 0.0, 0.to_int64())
      if n.look.shadows.length() > 0 {
        n.look.shadows = []
      }
      n.look.corner_circular = false
      n.look.group_alpha = 1.0
      n.look.ring_gap_color = 0.to_int64()
      n.look.halo = (0.0, 0.to_int64())
      n.said = None
      n.said_hidden = false
      if n.behind {
        self.behind_set -= 1
      }
      n.behind = false
      if n.transitions_only {
        self.transitions_only_set -= 1
      }
      n.transitions_only = false
      if n.default_press {
        self.defaults_set -= 1
      }
      n.default_press = false
      if n.bones != 0.to_int64() {
        self.bones_set -= 1
      }
      n.bones = 0.to_int64()
      n.bone_whole = false
      n.cut = false
      n.look.alpha = 1.0
      n.look.blur = 0.0
      n.look.dx = 0.0
      n.look.dy = 0.0
      n.look.sx = 0.0
      n.look.sy = 0.0
      n.look.scale = 1.0
      n.look.pivot = At(0.5, 0.5)
      n.look.scale_shift = 0.0
      n.look.scale_peak = 0.0
      n.look.drawn_as = ""
      n.look.clips = false
      n.look.clips_past = 0.0
      n.look.words_center = false
      n.look.words_breaks = false
      n.look.words_optical = false
      n.look.glyphs_said = 0
      n.look.ellipsis_past = false
      n.look.picture = None
      n.look.turn = 0.0
      n.look.turn_drawn = false
      n.look.fades = (0.0, 0.0, 0.0, 0.0)
      n.look.stretch = 0.0
      n.look.drawn_off = (0.0, 0.0)
      n.look.drawn_exact = false
      n.look.ground_drawn = ground_as_laid
      n.look.content_lens = paint::ContentLens::none()
      n.overlay_alpha = 1.0
      n.overlay_dx = 0.0
      n.overlay_dy = 0.0
      n.overlay_scale = 1.0
      n.overlay_ground_drawn = None
      n.overlay_ground_drawn_fn = None
      if n.overlay_slots.length() > 0 {
        n.overlay_slots = []
      }
      n.overlay_next = 0
      n.look.cut_soft = false
      if n.look.rects.length() > 0 {
        n.look.rects = []
      }
      if n.look.lines.length() > 0 {
        n.look.lines = []
      }
      n.drew = false
      n.drawn_off = (0.0, 0.0, 0.0, 0.0)
      n.glyphs_fn = None
      n.moved_by = None
      n.moved = (0.0, 0.0)
      n.flip_in = (0.0, 0.0, 1.0, 1.0)
      n.flip_across = (0.0, 0.0)
      n.flip_round = None
      n.moved_holds = None
      n.moved_ends = None
      n.went = None
      n.parent = parent
      n.allow_ellipsis = false
      n.words_as_said = words_as_said
      n.slot = false
      n.along_row = false
      n.alone = false
      n.boxes_due = false
      n.inputs_due = false
      n.fault_to = None
      n.hosted = false
      n.on_press = None
      n.on_double_press = None
      n.on_step = None
      n.top_row = false
      n.moves_window = false
      n.on_menu = None
      n.on_wheel = None
      n.on_key = None
      n.on_back = None
      n.on_back_step = None
      n.pressed_cell = None
      n.pointed_cell = None
      n.ground_read = 0
      n.ground_over_read = 0
      n.on_pointer_moved = None
      n.pointed_in_cell = None
      n.within_cell = None
      n.piece_cell = None
      n.said_cell = None
      n.each_row = false
      n.structure_box = false
      n.structure_own = false
      n.structure_synced = false
      n.focusable = false
      n.focus_keys = 0
      n.focus_tab = true
      n.tab_by_stop = false
      n.input_cell = None
      n.cursor = None
      n.as_ground = false
      n.beside = None
      n.beside_last = None
      n.beside_point = None
      n.beside_piece = None
      n.focused_cell = None
      n.size_cell = None
      n.bounds_input = false
      n.tucked_under = None
      n.drawn_clear = None
      n.bar_near = 0.0
      n.bar_across = false
      n.points = false
      n.points_said = false
      n.bar_near_cell = None
      n.inputs_own = false
      n.inputs_in = 0
      n.shows = None
      n.shows_across = false
      n.shows_room = None
      n.claims = None
      n.claims_from = None
      n.claims_said = 0
      n.yields = false
      n.hold_only = None
      n.line_gap = None
      n.claims_scroll = false
      n.claims_for = None
      n.scroll_held = -1
      n.drawn_rev = 0
      n.said_rev = 0
      n.words_rev = 0
      n.kids_rev = 0
      n.own_rev = 0
      n.state_rev = 0
      n.scroll_across = false
      n.scroll_had_siblings = 0
      n.scroll_off = None
      n.scroll_shown = None
      n.scroll_by = -1
      n.list_rows = false
      n.focus_shown_cell = None
      n.focus_within_cell = None
      n.key_said = 0
      n.wheel_said = 0
      n.on_drag = None
      n.drags_whole = false
      n.drag_captures = false
      n.takes = None
      if n.takes_units.length() > 0 {
        n.takes_units = []
      }
      n.takes_ver = None
      n.drag_end = None
      n.look_due = false
      n.place_due = false
      n.placed = false
      n.out = false
      n.content = None
      self.draws_rev = self.draws_rev + 1
      self.draws_any_rev = self.draws_any_rev + 1
      n.left_at = -1.0
      n.span = 0.0
      n.back_at = -1.0
      n.back_from = 0.0
      n.going = None
      n.leave_told = false
      n.coming = false
      n.come_said = None
      n.come_off = fn() { }
      n.come_wake = None
      n.clips_said = false
      n.clips_down = false
      n.come_uncut = false
      n.list_key_way = false
      n.inert = false
      n.takes_unseen = false
      n.alpha_animating = false
      n.modal = false
      n.back_goes_on = false
      n.leaves_typing = false
      n.over_all = false
      n.over_scrim = false
      n.scrim = false
      n.stack = -1
      n.source = None
      n.share = None
      n.share_flight = None
      n.share_route = None
      n.in_flight = None
      n.share_stays = false
      n.share_with_stays = false
      n.share_told = None
      n.flight_mark = false
      n.flights_within = false
      n.lift = None
      i
    }
    None => {
      self.nodes.push(Node::{
        gen: 0,
        live: true,
        flex: flex::Node::new(),
        look: Look::{ ground: 0.to_int64(), ground_over: 0.to_int64(), ink: 0.to_int64(), words: "", words_drawn: None, words_look: words_plain, runs: [], runs_look: runs_plain, runs_pressed: -1, runs_picked: (0, 0), runs_marks: [], shadow: (0.0, 0.0, 0.to_int64()), shadows: [], corner_circular: false, group_alpha: 1.0, ring_gap_color: 0.to_int64(), halo: (0.0, 0.to_int64()), rects: [], shapes: [], tint: 0.to_int64(), lines: [], edge: (0.0, 0.to_int64()), ring: (0.0, 0.0, 0.to_int64()), focus_ring: None, image: None, image_for: (0.0, 0.0), image_cover: false, image_contain: false, image_cover_at: None, image_fade: false, stretch: 0.0, image_in: None, radius: 0.0, corners: None, glass: None, content_lens: paint::ContentLens::none(), blur: 0.0, alpha: 1.0, dx: 0.0, dy: 0.0, sx: 0.0, sy: 0.0, scale: 1.0, pivot: At(0.5, 0.5), scale_shift: 0.0, scale_peak: 0.0, turn: 0.0, turn_drawn: false, fades: (0.0, 0.0, 0.0, 0.0), drawn_off: (0.0, 0.0), drawn_exact: false, ground_drawn: ground_as_laid, cut_soft: false, drawn_as: "", clips: false, clips_past: 0.0, words_center: false, words_breaks: false, words_optical: false, glyphs_said: 0, ellipsis_past: false, picture: None },
        overlay_alpha: 1.0,
        overlay_dx: 0.0,
        overlay_dy: 0.0,
        overlay_scale: 1.0,
        overlay_ground_drawn: None,
        overlay_ground_drawn_fn: None,
        overlay_slots: [],
        overlay_next: 0,
        parent,
        allow_ellipsis: false,
        words_as_said,
