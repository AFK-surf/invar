        if dmax(a, b) > 1.0e-6 &&
        rr > 0.0 &&
        edge_is(cx, rx) &&
        edge_is(cy, ry) &&
        edge_is(qx, kx) &&
        edge_is(qy, ky) {
          rr * dmax(0.0, 1.0 - t)
        } else {
          0.0
        }
      }
