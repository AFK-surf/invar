    // flow with it, pop_leave.mbt) is one departure, not two)
    // (told already, as much a departure kept for as one told now)
    guard !mbt_compat::arr_iter(self.departures).any(fn(d) { d.node.at == at && d.node.gen == n.gen }) else {
      any = true
      continue
    }
