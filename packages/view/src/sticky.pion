///|
/// How far down node `n` (at `i` in the order) is drawn off where it is laid out by `View::sticky` or
/// `View::sticky_section`, using the unified `Tree::sticky_offset_for` resolver.
fn Tree::sticky_dy_at(self : Tree, i : Int, at : Int, n : Node, y : Double, s : Double, wy : (Int) -> Double, ws : (Int) -> Double) -> Double {
  if !self.stickies.is_empty() && mbt_compat::ordered_map_contains_mapkey(self.stickies, at) {
