/// (`each_drawn_in_order`, `drawn_one`, `projected`, `visible_in`, `shared.mbt`, and `said_pass`).
fn Tree::sticky_offset_for(self : Tree, at : Int, n : Node, y : Double, s : Double, room_y : Double, room_s : Double, held_y : Double, held_s : Double, held_lh : Double, extra : Double, with_drawn_off? : Bool) -> Double {
