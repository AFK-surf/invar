import "signals"

fn side_opt_is(got : Option[Side], want : Side) -> Bool {
  match got {
    Some(s) => s == want
    None => false
  }
}

test "beside_side_told updates in the same frame when anchor moves and flips side" {
  let spacer_h = signals::signal(200.0)
  let told_side : signals::Ref[Option[Side]] = ref_new(None)
  let pop_ref : signals::Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(sp : View) {
      let _ = sp.width(Is(Some(40.0))).height(By(fn() { Some(spacer_h.get()) }))
    })
    let anchor = root.box(fn(a : View) {
      let _ = a.width(Is(Some(80.0))).height(Is(Some(32.0)))
    })
    let _ = root.box(fn(pop : View) {
      pop_ref.v = Some(pop)
      let _ = pop
        .over(Is(true))
        .width(Is(Some(100.0)))
        .height(Is(Some(60.0)))
        .beside(anchor.id(), side=Side::Top, along=Along::Middle, offset=8.0, padding=8.0)
      pop.reacts(fn() { pop.beside_side_told() }, fn(s) { told_side.v = s })
    })
  })
  // Initial frame: anchor at y=200 has plenty of room above -> Side::Top
  let _ = t.frame(400.0, 400.0)
  debug_assert(side_opt_is(told_side.v, Side::Top), "initial beside_side_told must be Top")
  match pop_ref.v {
    Some(p) => debug_assert(side_opt_is(p.beside_side_told(), Side::Top), "direct read must be Top")
    None => debug_assert(false, "pop built")
  }
  // Move anchor to y=0 -> no room above, must flip to Side::Bottom in the very same frame (0-frame latency)
  spacer_h.set(0.0)
  let _ = t.frame(400.0, 400.0)
  debug_assert(side_opt_is(told_side.v, Side::Bottom), "beside_side_told must flip to Bottom in the same frame")
  // Move anchor back down to y=200 -> flips back to Side::Top in the same frame
  spacer_h.set(200.0)
  let _ = t.frame(400.0, 400.0)
  debug_assert(side_opt_is(told_side.v, Side::Top), "beside_side_told must flip back to Top in the same frame")
}
