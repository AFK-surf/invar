// Unit tests for packages/view ergonomics: live/live_by/is_some constructors and static View::* helpers.

import "signals"

test "ergonomics: live/live_by/is_some constructors and size/layout helpers match long forms" {
  let dyn_w = signals::signal(80.0)
  let a_id : Ref[Option[NodeId]] = ref_new(None)
  let b_id : Ref[Option[NodeId]] = ref_new(None)
  let ov_id : Ref[Option[NodeId]] = ref_new(None)
  let hidden_id : Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let _ = root.as_col().pad_xy(12.0, 8.0).gap_px(6.0).justify(Lies::Start)
    let _ = root.box(fn(row : View) {
      let _ = row.as_row().w(376.0).h(50.0).gap_px(10.0).wrap_on(line_gap=4.0).align_items(Along::Start)
      let a = row.box(fn(v : View) {
        let _ = v.width(live_by(fn() { Some(dyn_w.get()) })).h(30.0).min_w(40.0).max_w(200.0).min_h(20.0).max_h(60.0)
      })
      a_id.v = Some(a.id())
      let b = row.box(fn(v : View) {
        let _ = v.grow_by(1.0).h(30.0).pad_all(4.0)
      })
      b_id.v = Some(b.id())
    })
    let ov = root.box(fn(v : View) {
      let _ = v.over_xy(15.0, 25.0).size(44.0, 22.0)
    })
    ov_id.v = Some(ov.id())
    let hid = root.box(fn(v : View) {
      let _ = v.size(50.0, 50.0).shown_is(false)
    })
    hidden_id.v = Some(hid.id())
    let _ = root.box(fn(v : View) {
      let _ = v.width(is_some(60.0)).height(live(Some(10.0)))
    })
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  match a_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => {
          debug_assert((d.x - 12.0).abs() < 0.01, "pad_xy left=12")
          debug_assert((d.y - 8.0).abs() < 0.01, "pad_xy top=8")
          debug_assert((d.w - 80.0).abs() < 0.01, "by width=80")
          debug_assert((d.h - 30.0).abs() < 0.01, "h=30")
        }
        None => debug_assert(false, "a should be drawn")
      }
    None => debug_assert(false, "a_id missing")
  }
  match b_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => {
          debug_assert((d.x - 102.0).abs() < 0.01, "b starts after a(80) + gap(10) + pad(12)")
          debug_assert((d.w - 286.0).abs() < 0.01, "b grows to remaining 400 - 24 - 80 - 10 = 286")
        }
        None => debug_assert(false, "b should be drawn")
      }
    None => debug_assert(false, "b_id missing")
  }
  match ov_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => {
          debug_assert((d.x - 15.0).abs() < 0.01 && (d.y - 25.0).abs() < 0.01, "over_xy positions at (15, 25)")
          debug_assert((d.w - 44.0).abs() < 0.01 && (d.h - 22.0).abs() < 0.01, "size sets 44x22")
        }
        None => debug_assert(false, "ov should be drawn")
      }
    None => debug_assert(false, "ov_id missing")
  }
  match hidden_id.v {
    Some(id) => debug_assert(tree.drawn_of(id).is_none(), "shown_is(false) hides node from layout/draw")
    None => debug_assert(false, "hidden_id missing")
  }
  dyn_w.set(120.0)
  let _ = tree.frame(400.0, 300.0, now=16.0)
  match a_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => debug_assert((d.w - 120.0).abs() < 0.01, "by() updates width reactively to 120")
        None => debug_assert(false, "a should still be drawn")
      }
    None => ()
  }
  tree.dispose()
}

test "ergonomics: visual, text, scroll_y and sets_together compatibility" {
  let active = signals::signal(false)
  let card_id : Ref[Option[NodeId]] = ref_new(None)
  let lbl_id : Ref[Option[NodeId]] = ref_new(None)
  let fg_id : Ref[Option[NodeId]] = ref_new(None)
  let sc = Scroll::new()
  let tree = Tree::new(fn(root : View) {
    let _ = root.as_col().pad_all(10.0)
    let card = root.box(fn(v : View) {
      let _ = v.size(160.0, 48.0).r(12.0).border(0x334455FFL, 2.0).alpha_is(0.75)
      let _ = v.sets_together(fn() { active.get() }, fn(on : Bool) {
        if on {
          let _ = v.bg(0x00AAFFFFL).shown_is(true)
        } else {
          let _ = v.bg(0x112233FFL).shown_is(true)
        }
      })
    })
    card_id.v = Some(card.id())
    let lbl = root.box(fn(v : View) {
      let _ = v.label("Hello", size=18.0, color=0xFF00AAFFL, weight=700)
    })
    lbl_id.v = Some(lbl.id())
    let fg_node = root.box(fn(v : View) {
      let _ = v.words(live("World")).fg(0x00FF88FFL)
    })
    fg_id.v = Some(fg_node.id())
    let _ = root.scroll_y(fn(body : View) {
      let _ = body.box(fn(tall : View) {
        let _ = tall.h(600.0)
      })
    }, scroll=sc)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  match card_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => {
          debug_assert(d.ground == 0x112233FFL, "initial bg from sets_together")
          debug_assert((d.radius - 12.0).abs() < 0.01, "r sets radius 12")
          debug_assert((d.edge.0 - 2.0).abs() < 0.01 && d.edge.1 == 0x334455FFL, "border sets (width=2, color)")
          debug_assert((d.alpha - 0.75).abs() < 0.01, "alpha_is sets 0.75")
        }
        None => debug_assert(false, "card should be drawn")
      }
    None => debug_assert(false, "card_id missing")
  }
  match lbl_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => {
          debug_assert(d.words == "Hello", "label sets words text")
          debug_assert((d.words_look.size - 18.0).abs() < 0.01 && d.words_look.weight == 700, "label sets size=18, weight=700")
          debug_assert(d.ink == 0xFF00AAFFL, "label sets color when non-zero")
        }
        None => debug_assert(false, "lbl should be drawn")
      }
    None => debug_assert(false, "lbl_id missing")
  }
  match fg_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => debug_assert(d.ink == 0x00FF88FFL, "fg sets text ink")
        None => debug_assert(false, "fg_node should be drawn")
      }
    None => debug_assert(false, "fg_id missing")
  }
  debug_assert(sc.reach() > 0.0, "scroll_y creates a real scrollable box with positive reach")
  active.set(true)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  match card_id.v {
    Some(id) =>
      match tree.drawn_of(id) {
        Some(d) => debug_assert(d.ground == 0x00AAFFFFL, "sets_together updated bg via ergonomics helper")
        None => debug_assert(false, "card should still be drawn")
      }
    None => ()
  }
  tree.dispose()
}
