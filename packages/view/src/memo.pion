import "signals"

// A node-owned memoized derivation (`View::memo`): shares a computed value across bindings on and under a node so the
// same frame computes it once, stops downstream propagation when equal (`ViewEq` or `same`), disposes automatically with
// the node, and preserves `Tree::clock_read_now` tracking (e.g. for `View::alpha`).

///|
/// A memoized derivation owned by `self` (`View::owns`): evaluates `f` at most once per change of its dependencies,
/// stops propagating when equal (`same`, defaulting to `==`), disposes when `self` leaves, and forwards
/// `clock_read_now` so callers like `View::alpha` keep accurate animation-clock tracking.
pub fn View::memo[T : Eq](self : View, f : () -> T, same? : (T, T) -> Bool, loc~ : String = "") -> () -> T {
  let eq = match same {
    Some(s) => s
    None => fn(a : T, b : T) -> Bool { a == b }
  }
  self.memo_by(f, eq, loc=loc)
}

///|
/// `View::memo` for a value with no `ViewEq` of its own (a tuple, an option): equal as `same` says.
pub fn View::memo_by[T](self : View, f : () -> T, same : (T, T) -> Bool, loc~ : String = "") -> () -> T {
  let tree = self.tree
  let read_clock = ref_new(false)
  let prev_read_clock = ref_new(false)
  let c = signals::computed_by_at(
    fn(_last : Option[T]) -> T {
      let prev = tree.clock_read_now
      tree.clock_read_now = false
      let v = f()
      let read = tree.clock_read_now
      prev_read_clock.v = read_clock.v
      read_clock.v = read
      tree.clock_read_now = prev || read
      v
    },
    fn(a : T, b : T) -> Bool { prev_read_clock.v == read_clock.v && same(a, b) },
    loc,
  )
  let _ = self.owns(fn() -> Unit { c.dispose() })
  fn() -> T {
    let v = c.get()
    if read_clock.v {
      tree.clock_read_now = true
    }
    v
  }
}
