// Compatibility primitives for packages/view (Ref, Hash, KMap, PairMap, DoubleMap, Array helpers).

import "signals"
import "flex"

pub struct Ref[T] {
  phys_id : Int
  pub mut v : T
}

pub fn ref_new[T](v : T) -> Ref[T] {
  Ref::{ phys_id: next_phys_id(), v }
}

pub trait ViewEq {
  fn eq(self : Self, other : Self) -> Bool
}

impl ViewEq for Int {
  fn eq(self : Int, other : Int) -> Bool { self == other }
}

impl ViewEq for Int64 {
  fn eq(self : Int64, other : Int64) -> Bool { self == other }
}

impl ViewEq for Double {
  fn eq(self : Double, other : Double) -> Bool { self == other }
}

impl ViewEq for Bool {
  fn eq(self : Bool, other : Bool) -> Bool { self == other }
}

impl ViewEq for String {
  fn eq(self : String, other : String) -> Bool { self == other }
}

impl ViewEq for Unit {
  fn eq(self : Unit, other : Unit) -> Bool { true }
}

pub trait ViewKey {
  fn eq(self : Self, other : Self) -> Bool
  fn hash(self : Self) -> Int
}

impl ViewKey for Int {
  fn eq(self : Int, other : Int) -> Bool { self == other }
  fn hash(self : Int) -> Int { self }
}

impl ViewKey for Int64 {
  fn eq(self : Int64, other : Int64) -> Bool { self == other }
  fn hash(self : Int64) -> Int {
    let lo = self.to_int()
    let hi = (self >> 32).to_int()
    lo ^ (hi * 31)
  }
}

impl ViewKey for Bool {
  fn eq(self : Bool, other : Bool) -> Bool { self == other }
  fn hash(self : Bool) -> Int { if self { 1 } else { 0 } }
}

impl ViewKey for String {
  fn eq(self : String, other : String) -> Bool { self == other }
  fn hash(self : String) -> Int {
    let mut h = 2166136261
    let n = self.length()
    let mut i = 0
    while i < n {
      h = (h ^ self.code_unit_at(i)) * 16777619
      i += 1
    }
    h
  }
}

pub struct KMap[K, V] {
  buckets : Map[Int, Array[(K, V)]]
  mut count : Int
}

pub fn kmap_new[K, V]() -> KMap[K, V] {
  KMap::{ buckets: Map::new(), count: 0 }
}

pub fn KMap::length[K, V](self : KMap[K, V]) -> Int {
  self.count
}

pub fn KMap::is_empty[K, V](self : KMap[K, V]) -> Bool {
  self.count == 0
}

pub fn KMap::clear[K, V](self : KMap[K, V]) -> Unit {
  self.buckets.clear()
  self.count = 0
}

pub fn KMap::get[K : ViewKey, V](self : KMap[K, V], k : K) -> Option[V] {
  let h = k.hash()
  match self.buckets.get(h) {
    Some(arr) => {
      for entry in arr {
        if entry.0.eq(k) {
          return Some(entry.1)
        }
      }
      None
    }
    None => None
  }
}

pub fn KMap::contains[K : ViewKey, V](self : KMap[K, V], k : K) -> Bool {
  match self.get(k) {
    Some(_) => true
    None => false
  }
}

pub fn KMap::set[K : ViewKey, V](self : KMap[K, V], k : K, v : V) -> Unit {
  let h = k.hash()
  match self.buckets.get(h) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if arr[i].0.eq(k) {
          arr[i] = (k, v)
          return
        }
        i += 1
      }
      arr.push((k, v))
      self.count += 1
    }
    None => {
      self.buckets.set(h, [(k, v)])
      self.count += 1
    }
  }
}

pub fn KMap::remove[K : ViewKey, V](self : KMap[K, V], k : K) -> Unit {
  let h = k.hash()
  match self.buckets.get(h) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if arr[i].0.eq(k) {
          let _ = array_remove(arr, i)
          self.count -= 1
          if arr.length() == 0 {
            self.buckets.remove(h)
          }
          return
        }
        i += 1
      }
    }
    None => ()
  }
}

pub fn KMap::keys[K, V](self : KMap[K, V]) -> Array[K] {
  let out : Array[K] = []
  for h in self.buckets.keys() {
    match self.buckets.get(h) {
      Some(arr) => {
        for entry in arr {
          out.push(entry.0)
        }
      }
      None => ()
    }
  }
  out
}

pub fn KMap::values[K, V](self : KMap[K, V]) -> Array[V] {
  let out : Array[V] = []
  for h in self.buckets.keys() {
    match self.buckets.get(h) {
      Some(arr) => {
        for entry in arr {
          out.push(entry.1)
        }
      }
      None => ()
    }
  }
  out
}

pub fn KMap::entries[K, V](self : KMap[K, V]) -> Array[(K, V)] {
  let out : Array[(K, V)] = []
  for h in self.buckets.keys() {
    match self.buckets.get(h) {
      Some(arr) => {
        for entry in arr {
          out.push(entry)
        }
      }
      None => ()
    }
  }
  out
}

pub struct IntPair {
  pub a : Int
  pub b : Int
}

impl ViewKey for IntPair {
  fn eq(self : IntPair, other : IntPair) -> Bool {
    self.a == other.a && self.b == other.b
  }
  fn hash(self : IntPair) -> Int {
    self.a * 1000003 ^ self.b
  }
}

impl ViewEq for IntPair {
  fn eq(self : IntPair, other : IntPair) -> Bool {
    self.a == other.a && self.b == other.b
  }
}

pub fn array_release_unused[T](_arr : Array[T], _placeholder : T) -> Unit {
  ()
}

pub fn array_shrink_to_fit[T](_arr : Array[T]) -> Unit {
  ()
}

pub fn array_search_by[T](arr : Array[T], pred : (T) -> Bool) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if pred(arr[i]) {
      return Some(i)
    }
    i += 1
  }
  None
}

pub fn array_search_eq[T : ViewEq](arr : Array[T], target : T) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if arr[i].eq(target) {
      return Some(i)
    }
    i += 1
  }
  None
}

pub fn array_search_key[K : ViewKey](arr : Array[K], target : K) -> Option[Int] {
  let mut i = 0
  while i < arr.length() {
    if arr[i].eq(target) {
      return Some(i)
    }
    i += 1
  }
  None
}

pub fn array_truncate[T](arr : Array[T], len : Int) -> Unit {
  let target = if len < 0 { 0 } else { len }
  while arr.length() > target {
    let _ = arr.pop()
  }
}

pub fn array_remove[T](arr : Array[T], idx : Int) -> T {
  let v = arr[idx]
  let last = arr.length() - 1
  let mut i = idx
  while i < last {
    arr[i] = arr[i + 1]
    i += 1
  }
  let _ = arr.pop()
  v
}

pub fn array_get[T](arr : Array[T], idx : Int) -> Option[T] {
  if idx >= 0 && idx < arr.length() {
    Some(arr[idx])
  } else {
    None
  }
}

pub fn opt_map[T, U](o : Option[T], f : (T) -> U) -> Option[U] {
  match o {
    Some(x) => Some(f(x))
    None => None
  }
}

pub fn array_retain[T](arr : Array[T], pred : (T) -> Bool) -> Unit {
  let mut w = 0
  let mut r = 0
  let n = arr.length()
  while r < n {
    if pred(arr[r]) {
      if w != r {
        arr[w] = arr[r]
      }
      w += 1
    }
    r += 1
  }
  array_truncate(arr, w)
}

pub fn array_sort_by[T](arr : Array[T], cmp : (T, T) -> Int) -> Unit {
  let n = arr.length()
  if n <= 1 {
    return
  }
  // Simple insertion / comb sort for small/medium arrays, O(n log n) merge sort for general case
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && cmp(arr[j], key) > 0 {
      arr[j + 1] = arr[j]
      j -= 1
    }
    arr[j + 1] = key
    i += 1
  }
}

pub fn array_drain[T](arr : Array[T], start : Int, end : Int) -> Array[T] {
  let out : Array[T] = []
  let s = if start < 0 { 0 } else { start }
  let e = if end > arr.length() { arr.length() } else { end }
  if s >= e {
    return out
  }
  let mut i = s
  while i < e {
    out.push(arr[i])
    i += 1
  }
  let count = e - s
  let n = arr.length()
  let mut dst = s
  let mut src = e
  while src < n {
    arr[dst] = arr[src]
    dst += 1
    src += 1
  }
  array_truncate(arr, n - count)
  out
}

pub fn array_rev[T](arr : Array[T]) -> Array[T] {
  let out : Array[T] = []
  let mut i = arr.length() - 1
  while i >= 0 {
    out.push(arr[i])
    i -= 1
  }
  out
}

pub fn int_min(a : Int, b : Int) -> Int {
  if a < b { a } else { b }
}

pub fn int_max(a : Int, b : Int) -> Int {
  if a > b { a } else { b }
}

pub fn dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

pub fn dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

pub fn dclamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub fn ignore[T](_x : T) -> Unit {
  ()
}

pub fn array_slice[T](arr : Array[T], start : Int, end : Int) -> Array[T] {
  let out : Array[T] = []
  let s = if start < 0 { 0 } else { start }
  let e = if end > arr.length() { arr.length() } else { end }
  let mut i = s
  while i < e {
    out.push(arr[i])
    i += 1
  }
  out
}

pub fn array_slice_from[T](arr : Array[T], start : Int) -> Array[T] {
  array_slice(arr, start, arr.length())
}

pub fn array_slice_to[T](arr : Array[T], end : Int) -> Array[T] {
  array_slice(arr, 0, end)
}

pub fn array_concat[T](a : Array[T], b : Array[T]) -> Array[T] {
  let out : Array[T] = []
  for x in a {
    out.push(x)
  }
  for x in b {
    out.push(x)
  }
  out
}

pub fn array_push_copy[T](a : Array[T], x : T) -> Array[T] {
  let out : Array[T] = []
  for e in a {
    out.push(e)
  }
  out.push(x)
  out
}

pub fn str_slice_to(s : String, end : Int) -> String {
  let e = if end < 0 { 0 } else if end > s.length() { s.length() } else { end }
  s.slice(0, e)
}

pub fn str_slice_from(s : String, start : Int) -> String {
  let st = if start < 0 { 0 } else if start > s.length() { s.length() } else { start }
  s.slice(st, s.length())
}

pub fn array_last[T](arr : Array[T]) -> Option[T] {
  if arr.length() == 0 {
    None
  } else {
    Some(arr[arr.length() - 1])
  }
}

pub fn bit_not(x : Int) -> Int {
  (-1) ^ x
}

pub fn array_filter[T](arr : Array[T], pred : (T) -> Bool) -> Array[T] {
  let out : Array[T] = []
  for x in arr {
    if pred(x) {
      out.push(x)
    }
  }
  out
}

pub fn array_map[T, U](arr : Array[T], f : (T) -> U) -> Array[U] {
  let out : Array[U] = []
  for x in arr {
    out.push(f(x))
  }
  out
}

pub fn array_filter_map[T, U](arr : Array[T], f : (T) -> Option[U]) -> Array[U] {
  let out : Array[U] = []
  for x in arr {
    match f(x) {
      Some(u) => out.push(u)
      None => ()
    }
  }
  out
}

pub fn array_any[T](arr : Array[T], pred : (T) -> Bool) -> Bool {
  for x in arr {
    if pred(x) {
      return true
    }
  }
  false
}

pub fn array_all[T](arr : Array[T], pred : (T) -> Bool) -> Bool {
  for x in arr {
    if !pred(x) {
      return false
    }
  }
  true
}

pub fn array_find_first[T](arr : Array[T], pred : (T) -> Bool) -> Option[T] {
  for x in arr {
    if pred(x) {
      return Some(x)
    }
  }
  None
}

pub fn array_append[T](dst : Array[T], src : Array[T]) -> Unit {
  for x in src {
    dst.push(x)
  }
}

pub fn opt_eq[T : ViewEq](a : Option[T], b : Option[T]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.eq(y)
    _ => false
  }
}

pub fn opt_ne[T : ViewEq](a : Option[T], b : Option[T]) -> Bool {
  !opt_eq(a, b)
}

let phys_id_seq : Ref[Int] = Ref::{ phys_id: 0, v: 1 }

pub fn next_phys_id() -> Int {
  let id = phys_id_seq.v
  phys_id_seq.v = id + 1
  id
}

pub fn array_insert[T](arr : Array[T], idx : Int, val_item : T) -> Unit {
  arr.push(val_item)
  let mut i = arr.length() - 1
  while i > idx {
    arr[i] = arr[i - 1]
    i -= 1
  }
  arr[idx] = val_item
}

pub fn array_rev_in_place[T](arr : Array[T]) -> Unit {
  let mut i = 0
  let mut j = arr.length() - 1
  while i < j {
    let tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
    i += 1
    j -= 1
  }
}

pub fn array_eq_int(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

pub fn pair_dd_eq(a : (Double, Double), b : (Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1
}

pub fn quad_dddd_eq(a : (Double, Double, Double, Double), b : (Double, Double, Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3
}

pub fn triple_idd_eq(a : (Int, Double, Double), b : (Int, Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1 && a.2 == b.2
}

pub fn opt_pair_dd_eq(a : Option[(Double, Double)], b : Option[(Double, Double)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => pair_dd_eq(x, y)
    _ => false
  }
}

pub fn opt_quad_dddd_eq(a : Option[(Double, Double, Double, Double)], b : Option[(Double, Double, Double, Double)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => quad_dddd_eq(x, y)
    _ => false
  }
}

pub fn str_rev_find(s : String, pat : String) -> Option[Int] {
  let n = s.length()
  let m = pat.length()
  if m == 0 {
    return Some(n)
  }
  if m > n {
    return None
  }
  let mut i = n - m
  while i >= 0 {
    let mut ok = true
    let mut j = 0
    while j < m {
      if s.code_unit_at(i + j) != pat.code_unit_at(j) {
        ok = false
        break
      }
      j += 1
    }
    if ok {
      return Some(i)
    }
    i -= 1
  }
  None
}

pub fn str_has_suffix(s : String, suf : String) -> Bool {
  let n = s.length()
  let m = suf.length()
  if m > n {
    return false
  }
  let off = n - m
  let mut j = 0
  while j < m {
    if s.code_unit_at(off + j) != suf.code_unit_at(j) {
      return false
    }
    j += 1
  }
  true
}

pub fn str_find(s : String, pat : String) -> Option[Int] {
  let n = s.length()
  let m = pat.length()
  if m == 0 {
    return Some(0)
  }
  if m > n {
    return None
  }
  let mut i = 0
  while i <= n - m {
    let mut ok = true
    let mut j = 0
    while j < m {
      if s.code_unit_at(i + j) != pat.code_unit_at(j) {
        ok = false
        break
      }
      j += 1
    }
    if ok {
      return Some(i)
    }
    i += 1
  }
  None
}

pub fn dim_auto() -> flex::Dim {
  flex::Style::new().get_width()
}

pub fn dim_eq(a : flex::Dim, b : flex::Dim) -> Bool {
  match (a, b) {
    (flex::Pt(x), flex::Pt(y)) => x == y
    (flex::Pct(x), flex::Pct(y)) => x == y
    (flex::Within(x), flex::Within(y)) => x == y
    (flex::Pt(_), _) | (_, flex::Pt(_)) => false
    (flex::Pct(_), _) | (_, flex::Pct(_)) => false
    (flex::Within(_), _) | (_, flex::Within(_)) => false
    _ => true
  }
}

pub fn rect4_eq(a : (Double, Double, Double, Double), b : (Double, Double, Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1 && a.2 == b.2 && a.3 == b.3
}

pub fn same_come_group(a : flex::ComeGroup, b : flex::ComeGroup) -> Bool {
  a.at == b.at && a.dur == b.dur && a.members.length() == b.members.length()
}

pub fn str_join(arr : Array[String], sep : String) -> String {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(arr[i])
    i += 1
  }
  sb.to_string()
}




