// Core unit tests for packages/view (declarative tree, layout, reactivity, show/pick/each,
// scroll, virtualized list_window, block reuse, focus, keymap, text wrapping, beside, said,
// bounded_hold, velocity tracker, answering/transition).

import "signals"
import "text"

test "declarative tree construction, flex layout and reactive props" {
  let w_sig = signals::signal(120.0)
  let bg_sig = signals::signal(0x112233FF.to_int64())
  let box_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let _ = root.row(Is(true)).gap(Is(10.0)).padding(Is((12.0, 8.0, 12.0, 8.0)))
    let a = root.box(fn(v : View) {
      let _ = v.width(By(fn() { Some(w_sig.get()) })).height(Is(Some(40.0))).ground(By(fn() { bg_sig.get() }))
    })
    box_id.v = Some(a.id())
    let _ = root.box(fn(v : View) {
      let _ = v.grow(Is(1.0)).height(Is(Some(40.0))).ground(Is(0x445566FF.to_int64()))
    })
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  let drawn = tree.drawn()
  debug_assert(drawn.length() >= 2, "expected at least 2 drawn nodes")
  let aid = match box_id.v {
    Some(id) => id
    None => { debug_assert(false, "box_id must be set"); NodeId::{ at: 0, gen: 0 } }
  }
  match tree.drawn_of(aid) {
    Some(d) => {
      debug_assert((d.x - 12.0).abs() < 0.01, "x should equal left padding 12")
      debug_assert((d.y - 8.0).abs() < 0.01, "y should equal top padding 8")
      debug_assert((d.w - 120.0).abs() < 0.01, "initial width 120")
      debug_assert((d.h - 40.0).abs() < 0.01, "height 40")
      debug_assert(d.ground == 0x112233FF.to_int64(), "initial ground")
    }
    None => debug_assert(false, "box should be drawn")
  }
  w_sig.set(200.0)
  bg_sig.set(0xAABBCCFF.to_int64())
  let _ = tree.frame(400.0, 300.0, now=16.0)
  match tree.drawn_of(aid) {
    Some(d) => {
      debug_assert((d.w - 200.0).abs() < 0.01, "updated width 200")
      debug_assert(d.ground == 0xAABBCCFF.to_int64(), "updated ground")
    }
    None => debug_assert(false, "box should still be drawn after update")
  }
  tree.dispose()
}

test "show combinator mounts and disposes child cleanly" {
  let visible = signals::signal(false)
  let child_ref : signals::Ref[Option[View]] = ref_new(None)
  let disposed = ref_new(0)
  let tree = Tree::new(fn(root : View) {
    root.show(fn() { visible.get() }, fn(v : View) {
      let _ = v.width(Is(Some(80.0))).height(Is(Some(30.0))).ground(Is(0xFF0000FF.to_int64()))
      let _ = v.owns(fn() { disposed.v = disposed.v + 1 })
      child_ref.v = Some(v)
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  debug_assert(child_ref.v.is_none(), "not mounted when false")
  visible.set(true)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  match child_ref.v {
    Some(v) => debug_assert(v.alive(), "mounted and alive when true")
    None => debug_assert(false, "child should be mounted")
  }
  visible.set(false)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  match child_ref.v {
    Some(v) => debug_assert(!v.alive(), "disposed when hidden")
    None => ()
  }
  debug_assert(disposed.v == 1, "owns cleanup called once")
  tree.dispose()
}

test "pick combinator switches branches by key" {
  let tab = signals::signal(1)
  let built : Array[Int] = []
  let tree = Tree::new(fn(root : View) {
    root.pick(fn() { tab.get() }, fn(v : View, k : Int) {
      built.push(k)
      let _ = v.width(Is(Some(100.0))).height(Is(Some(20.0 * k.to_double()))).ground(Is(0x223344FF.to_int64()))
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  debug_assert(built.length() == 1 && built[0] == 1, "built initial branch 1")
  tab.set(2)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  debug_assert(built.length() == 2 && built[1] == 2, "switched to branch 2")
  // Setting same key does not rebuild
  tab.set(2)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  debug_assert(built.length() == 2, "same key does not rebuild")
  tree.dispose()
}

test "each keyed list preserves identity across reorder and removal" {
  let items = signals::signal_by([1, 2, 3], array_eq_int)
  let created : Array[Int] = []
  let row_views : Map[Int, View] = Map::new()
  let tree = Tree::new(fn(root : View) {
    root.each(fn() { items.get() }, fn(k : Int) { k }, fn(v : View, item : signals::Signal[Int]) {
      let k = item.untracked()
      created.push(k)
      row_views[k] = v
      let _ = v.height(Is(Some(24.0))).ground(Is(0x334455FF.to_int64()))
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  debug_assert(created.length() == 3, "created 3 initial rows")
  let id2 = row_views[2].id()
  // Reorder and add 4, remove 1
  items.set([3, 2, 4])
  let _ = tree.frame(300.0, 200.0, now=16.0)
  debug_assert(created.length() == 4 && created[3] == 4, "only new key 4 created")
  debug_assert(!row_views[1].alive(), "removed key 1 disposed")
  debug_assert(row_views[2].alive() && row_views[2].id() == id2, "key 2 preserved identity")
  debug_assert(row_views[4].alive(), "key 4 alive")
  tree.dispose()
}

test "text wrapping and words_measure" {
  let (w1, h1) = words_measure("hello", words_plain, -1.0, 1.0)
  debug_assert((w1 - 35.0).abs() < 0.01 && (h1 - 18.0).abs() < 0.01, "single line 5 chars * 7 = 35, 18 high")
  let (_, h2) = words_measure("hello world foo bar", words_plain, 50.0, 1.0)
  debug_assert(h2 > 18.0, "wrapped text should be taller than one line")
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(100.0)))
    let _ = root.box(fn(v : View) {
      let _ = v.words(Is("hello world"), look=words_plain)
    })
  })
  let _ = tree.frame(100.0, 100.0, now=0.0)
  let drawn = tree.drawn()
  debug_assert(drawn.length() >= 1, "words node drawn")
  tree.dispose()
}

test "scroll container wheel and clamping" {
  let sc = Scroll::new()
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(200.0))).height(Is(Some(100.0)))
    let _ = root.scrolls(sc, fn(inner : View) {
      for i in 0..<10 {
        let _ = inner.box(fn(v : View) {
          let _ = v.height(Is(Some(40.0))).ground(Is((0x101010FF + i * 0x05050500).to_int64()))
        })
      }
    })
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  debug_assert(sc.at(tree) == 0.0, "starts at top 0")
  debug_assert((sc.most() - 300.0).abs() < 1.0, "content 400 - viewport 100 = 300")
  sc.put(150.0)
  let _ = tree.frame(200.0, 100.0, now=16.0)
  debug_assert((sc.at(tree) - 150.0).abs() < 1.0, "scrolled to 150")
  sc.put(999.0)
  let _ = tree.frame(200.0, 100.0, now=32.0)
  debug_assert((sc.at(tree) - 300.0).abs() < 1.0, "clamped to max 300")
  tree.dispose()
}

test "virtualized scrolls_window materializes only visible window of 1000 items" {
  let sc = Scroll::list()
  let place : ListPlace[Int] = ListPlace::new()
  let all_keys : Array[Int] = []
  for i in 0..<1000 {
    all_keys.push(i)
  }
  let keys_sig = signals::signal_by(all_keys, array_eq_int)
  let made_count = ref_new(0)
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(300.0))).height(Is(Some(200.0)))
    let _ = root.scrolls_window(
      sc,
      fn() { keys_sig.get() },
      fn(v : View, k : Int) {
        made_count.v = made_count.v + 1
        let _ = v.height(Is(Some(40.0))).ground(Is(0x222222FF.to_int64()))
        let _ = v.words(Is("row " + k.to_string()))
      },
      est=40.0,
      at_once=true,
      place=place,
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  debug_assert(made_count.v > 0 && made_count.v < 60, "virtualized: far fewer than 1000 rows materialized")
  match place.sight_now() {
    Some(sg) => {
      debug_assert(sg.first == 0, "first visible key is 0")
      debug_assert(sg.last >= 4, "at least 5 rows visible in 200px viewport of 40px rows")
    }
    None => debug_assert(false, "sight_now should be Some after layout")
  }
  place.to_end(glide=false)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  match place.sight_now() {
    Some(sg) => {
      debug_assert(sg.last == 999, "to_end brings last key 999 into sight")
      debug_assert(sg.at_foot, "at_foot should be true after to_end")
    }
    None => debug_assert(false, "sight_now should be Some after to_end")
  }
  tree.dispose()
}

test "scrolls_reused recycles slots across scroll" {
  let sc = Scroll::list()
  let place : ListPlace[Int] = ListPlace::new()
  let all_keys : Array[Int] = []
  for i in 0..<200 {
    all_keys.push(i)
  }
  let keys_sig = signals::signal_by(all_keys, array_eq_int)
  let built_slots = ref_new(0)
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(300.0))).height(Is(Some(200.0)))
    let _ = root.scrolls_reused(
      sc,
      fn() { keys_sig.get() },
      fn(v : View, key : () -> Int) {
        built_slots.v = built_slots.v + 1
        let _ = v.height(Is(Some(40.0))).words(By(fn() { "item " + key().to_string() }))
      },
      est=40.0,
      at_once=true,
      place=place,
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let initial_slots = built_slots.v
  debug_assert(initial_slots > 0 && initial_slots < 40, "small initial recycled slot pool")
  place.bring(100, glide=false)
  let _ = tree.frame(300.0, 200.0, now=32.0)
  debug_assert(built_slots.v <= initial_slots + 20, "slots recycled rather than creating 100 new ones")
  tree.dispose()
}

test "focus order and keymap when-predicate parsing and dispatch" {
  let parsed = key_when_parse("editor && !readonly || modal")
  match parsed {
    Some(w) => {
      debug_assert(key_when_holds(w, fn(c) { c == "editor" }), "editor && !readonly holds")
      debug_assert(!key_when_holds(w, fn(c) { c == "editor" || c == "readonly" }), "editor && readonly does not hold")
      debug_assert(key_when_holds(w, fn(c) { c == "modal" }), "modal holds via ||")
    }
    None => debug_assert(false, "key_when_parse should succeed")
  }
  let fired = ref_new(0)
  let target_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let km = Keymap::{
      bindings: [
        Binding::{
          keys: [Stroke::{ code: 65, mods: 0 }],
          action: "act.test",
          when: KeyWhen::In("panel"),
        },
      ],
      pending_ms: None,
    }
    let _ = root.keymap(Is(km))
    let b = root.box(fn(v : View) {
      let _ = v.width(Is(Some(80.0))).height(Is(Some(30.0)))
      let _ = v.focusable(Is(true)).key_context("panel")
      let _ = v.on_action("act.test", fn(_) { fired.v = fired.v + 1; true })
    })
    target_id.v = Some(b.id())
  })
  let _ = tree.frame(200.0, 200.0, now=0.0)
  let order = tree.focus_order()
  debug_assert(order.length() == 1, "one focusable node in order")
  let ok = tree.stroke(65, 0, 10.0, from=target_id.v)
  debug_assert(ok && fired.v == 1, "action dispatched via keymap")
  tree.dispose()
}

test "place_beside flips side when viewport lacks room" {
  // Anchor near bottom edge (y=280, h=15) in 300x300 viewport; tooltip 80x40 below won't fit -> flips to Top
  let (x, y, side) = place_beside((100.0, 280.0, 60.0, 15.0), 80.0, 40.0, 300.0, 300.0, side=Bottom, offset=4.0, padding=8.0)
  debug_assert(side == Top, "should flip from Bottom to Top near bottom edge")
  debug_assert(y < 280.0, "tooltip placed above anchor")
  debug_assert(x >= 8.0 && x + 80.0 <= 292.0, "tooltip clamped horizontally within padding")
}

test "said accessibility tree and words_within" {
  let tree = Tree::new(fn(root : View) {
    let _ = root.box(fn(v : View) {
      let _ = v.width(Is(Some(100.0))).height(Is(Some(30.0)))
      let _ = v.says(Is(Some(Said::{
        role: Button,
        label: "Submit",
        description: "",
        value: "",
        range: None,
        check: None,
        expanded: None,
        selected: None,
        pressed: None,
        actions: [],
      })))
    })
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  let said = tree.said_order()
  debug_assert(said.length() == 1, "one accessible node")
  match said[0].said {
    Some(s) => debug_assert(s.label == "Submit" && s.role == Button, "accessible role and label match")
    None => debug_assert(false, "said entry must have Said")
  }
  tree.dispose()
}

test "bounded_hold gate waits until ready or deadline" {
  let ready = signals::signal(false)
  let went = ref_new(0)
  let gate = HoldGate::new(acknowledged=true)
  let tree = Tree::new(fn(root : View) {
    gate.collect(fn() {
      hold_note(fn() { ready.get() })
    })
    gate.seal(root)
    gate.go(root, most=100.0, fn() { went.v = went.v + 1 })
  })
  let _ = tree.frame(200.0, 100.0, now=0.0)
  debug_assert(gate.is_pending() && went.v == 0, "gate pending before ready")
  ready.set(true)
  let _ = tree.frame(200.0, 100.0, now=20.0)
  debug_assert(!gate.is_pending() && went.v == 1, "gate fired once ready")
  tree.dispose()
}

test "velocity tracker computes drag velocity" {
  let vt = Tracker::new()
  vt.add(0.0, 0.0)
  vt.add(16.0, 32.0)
  vt.add(32.0, 64.0)
  let vy = vt.velocity_at(32.0)
  debug_assert((vy - 2.0).abs() < 0.2, "vertical velocity ~2.0 pt/ms")
}

test "answering flag toggles during callback" {
  debug_assert(!answering_now(), "not answering initially")
  let inside = ref_new(false)
  answering(fn() {
    inside.v = answering_now()
  })
  debug_assert(inside.v, "answering_now true inside answering()")
  debug_assert(!answering_now(), "restored after answering()")
}

test "View::scroll_box creates child scroller with zero scroll_faults" {
  let sc = Scroll::new()
  let tree = Tree::new(fn(root : View) {
    let _ = root.box(fn(hdr : View) {
      let _ = hdr.height(Is(Some(48.0))).rigid()
    })
    let _ = root.scroll_box(fn(body : View) {
      let _ = body.box(fn(tall : View) {
        let _ = tall.height(Is(Some(1000.0)))
      })
    }, scroll=sc)
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  debug_assert(tree.scroll_faults().length() == 0, "valid scroll_box reports 0 scroll_faults")
  debug_assert(sc.most() > 500.0, "scroll_box has positive scroll reach")
  tree.dispose()
}

test "Tree::scroll_faults catches unbounded ancestor and sibling-polluted scrolls" {
  // Fault A: unbounded flex ancestor (inner scroller inside an unbounded vertical flow -> expands to 1200pt with reach==0)
  let tree_a = Tree::new(fn(root : View) {
    let _ = root.scroll_box(fn(outer_body : View) {
      let _ = outer_body.box(fn(vp : View) {
        let s = Scroll::new()
        let _ = vp.scrolls(s, fn(body : View) {
          let _ = body.box(fn(tall : View) {
            let _ = tall.height(Is(Some(1200.0)))
          })
        })
      })
    })
  })
  let _ = tree_a.frame(400.0, 300.0, now=0.0)
  let faults_a = tree_a.scroll_faults()
  debug_assert(faults_a.length() == 1, "unbounded vertical ancestor must report 1 scroll fault")
  tree_a.dispose()

  // Fault B: View::scrolls called on container that already has sibling children
  let tree_b = Tree::new(fn(root : View) {
    let _ = root.box(fn(hdr : View) {
      let _ = hdr.height(Is(Some(40.0)))
    })
    let s = Scroll::new()
    let _ = root.scrolls(s, fn(body : View) {
      let _ = body.box(fn(tall : View) {
        let _ = tall.height(Is(Some(800.0)))
      })
    })
  })
  let _ = tree_b.frame(400.0, 300.0, now=0.0)
  let faults_b = tree_b.scroll_faults()
  debug_assert(faults_b.length() >= 1, "scrolls on container with siblings must report fault")
  tree_b.dispose()
}

test "View::fades transparent tail (< 0.2) passes hit-tests through while body (>= 0.2) blocks (#8090)" {
  let btn_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let _ = root.box(fn(btn : View) {
      btn_id.v = Some(btn.id())
      let _ = btn
      .over(Is(true))
      .offset(Is((0.0, 0.0)))
      .width(Is(Some(200.0)))
      .height(Is(Some(100.0)))
      .on_press(fn() { () })
    })
    // Top-anchored fading overlay (y=0..100, bottom fade 40pt):
    // at y=50 -> ramp=1.0 (>= 0.2, blocks); at y=95 -> ramp=(100-95)/40=0.125 (< 0.2, passes through)
    let _ = root.box(fn(host : View) {
      let _ = host
      .over(Is(true))
      .offset(Is((0.0, 0.0)))
      .width(Is(Some(200.0)))
      .height(Is(Some(100.0)))
      .fades(Is((0.0, 0.0, 0.0, 40.0)))
      let _ = host.box(fn(cover : View) {
        let _ = cover
        .width_share(Is(1.0))
        .height_share(Is(1.0))
        .points(Is(false))
        .glass(Is(Some(paint::Glass::frosted(blur=8.0, tint=0xFFFFFF80L, solid=0xFFFFFFFFL, progressive=true))))
        let _ = cover.pointed()
      })
    })
  })
  let _ = tree.frame(200.0, 200.0, now=0.0)
  let bid = match btn_id.v {
    Some(id) => id
    None => { debug_assert(false, "btn id"); tree.dispose(); return }
  }
  // In the opaque body (y=50), overlay blocks the button underneath
  debug_assert(tree.target_at(100.0, 50.0) == Target::Nothing, "opaque body (>=0.2) blocks press")
  // In the transparent fade tail (y=95, ramp=0.125 < 0.2), press passes through to button
  debug_assert(tree.target_at(100.0, 95.0) == Target::Pressed(bid), "transparent fade tail (<0.2) passes press through")
  tree.dispose()
}

test "shared flight scales nested slot/box filling children and image_in, container=true does not (#8084)" {
  let linear = Flight::{ phys_id: 1, way: fn(_far : Double) -> (Double, (Double) -> Double) {
    (200.0, fn(t : Double) -> Double { dclamp(t / 200.0, 0.0, 1.0) })
  } }
  let open = signals::signal(false)
  let inner_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let letter_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    // Source thumbnail (stays=true): 60x60 at (10, 10)
    let _ = root.box(fn(thumb : View) {
      let _ = thumb
      .over(Is(true))
      .offset(Is((10.0, 10.0)))
      .width(Is(Some(60.0)))
      .height(Is(Some(60.0)))
      .shared(Is("pic"), linear, stays=true)
    })
    // Destination viewer (with_stays=true): 200x100 at (50, 50) containing nested show(slot) -> wrapper -> filler with image_in
    root.show(fn() { open.get() }, fn(v : View) {
      let _ = v
      .over(Is(true))
      .offset(Is((50.0, 50.0)))
      .width(Is(Some(200.0)))
      .height(Is(Some(100.0)))
      .shared(Is("pic"), linear, with_stays=true)
      v.show(fn() { true }, fn(wrap : View) {
        let _ = wrap.width_share(Is(1.0)).height_share(Is(1.0))
        let _ = wrap.box(fn(pic : View) {
          inner_id.v = Some(pic.id())
          let _ = pic
          .width_share(Is(1.0))
          .height_share(Is(1.0))
          .image(Is(Some(("a.png", "", 0))))
          .image_in(Is(Some(((0.0, 0.0, 200.0, 100.0), 0x000000FFL))))
        })
      })
      let _ = v.box(fn(letter : View) {
        letter_id.v = Some(letter.id())
        let _ = letter
        .over(Is(true))
        .width_share(Is(1.0))
        .height_share(Is(1.0))
        .image(Is(Some(("b.png", "", 0))))
        .image_in(Is(Some(((50.0, 0.0, 100.0, 100.0), 0x000000FFL))))
      })
    })
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  open.set(true)
  let _ = tree.frame(400.0, 300.0, now=0.0)
  // Halfway through flight (t=100ms): rect is 130x80 (scale s=130/200=0.65, local filler fw=200, fh=80/0.65=123.077)
  let _ = tree.frame(400.0, 300.0, now=100.0)
  let exp_fw = 200.0
  let exp_fh = 80.0 / (130.0 / 200.0)
  // Full-box nested filler adapts to flight aspect (w/h == 130/80 = 1.625) and image_in fills local (fw, fh)
  match inner_id.v {
    Some(id) => match tree.drawn_of(id) {
      Some(d) => {
        debug_assert((d.w - 130.0).abs() < 1.0 && (d.h - 80.0).abs() < 1.0, "nested filler follows flight rect 130x80")
        match d.image_in {
          Some(((ix, iy, iw, ih), _)) =>
          debug_assert(ix.abs() < 0.5 && iy.abs() < 0.5 && (iw - exp_fw).abs() < 1.0 && (ih - exp_fh).abs() < 1.0, "full-box image_in scales to filler local size")
          None => debug_assert(false, "expected full-box image_in")
        }
      }
      None => debug_assert(false, "expected nested filler drawn")
    }
    None => debug_assert(false, "expected inner_id")
  }
  // Letterbox filler preserves 1:1 aspect centered in local (200, exp_fh) -> (exp_fh x exp_fh) at x=(200 - exp_fh)/2
  match letter_id.v {
    Some(id) => match tree.drawn_of(id) {
      Some(d) => match d.image_in {
        Some(((ix, iy, iw, ih), _)) =>
        debug_assert((iw - exp_fh).abs() < 1.0 && (ih - exp_fh).abs() < 1.0 && (ix - (exp_fw - exp_fh) * 0.5).abs() < 1.0 && iy.abs() < 0.5, "letterbox image_in fits centered")
        None => debug_assert(false, "expected letterbox image_in")
      }
      None => debug_assert(false, "expected letterbox drawn")
    }
    None => debug_assert(false, "expected letter_id")
  }
  tree.dispose()

  // Container flight (container=true) must NOT stretch filling child
  let swapped = signals::signal(false)
  let child_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree2 = Tree::new(fn(root : View) {
    root.show(fn() { !swapped.get() }, fn(a : View) {
      let _ = a.over(Is(true)).offset(Is((0.0, 0.0))).width(Is(Some(60.0))).height(Is(Some(60.0)))
      .shared(Is("card"), linear, container=true)
    })
    root.show(fn() { swapped.get() }, fn(b : View) {
      let _ = b.over(Is(true)).offset(Is((20.0, 20.0))).width(Is(Some(200.0))).height(Is(Some(100.0)))
      .shared(Is("card"), linear, container=true)
      let _ = b.box(fn(ch : View) {
        child_id.v = Some(ch.id())
        let _ = ch.width_share(Is(1.0)).height_share(Is(1.0))
      })
    })
  })
  let _ = tree2.frame(400.0, 300.0, now=0.0)
  swapped.set(true)
  let _ = tree2.frame(400.0, 300.0, now=0.0)
  let _ = tree2.frame(400.0, 300.0, now=100.0)
  match child_id.v {
    Some(id) => match tree2.drawn_of(id) {
      Some(d) => debug_assert((d.w - 200.0).abs() < 1.0 && (d.h - 100.0).abs() < 1.0, "container=true keeps child at its own laid-out 200x100 size")
      None => debug_assert(false, "expected container child drawn")
    }
    None => debug_assert(false, "expected child_id")
  }
  tree2.dispose()
}

test "scrolls_window in hugs container expands past est when actual row is taller (#8102)" {
  for with_neg_mb in [false, true] {
    for row_h in [60.0, 78.0] {
      let scroll = Scroll::list()
      let room_id : signals::Ref[Option[NodeId]] = ref_new(None)
      let tree = Tree::new(
        fn(root : View) {
          let _ = root.box(fn(sheet : View) {
            let _ = sheet.width(Is(Some(360.0))).max_height(Is(Some(400.0)))
            let _ = sheet.box(fn(body : View) {
              let _ = body.width(Is(Some(360.0))).grow(Is(1.0)).shrink(Is(1.0)).min_height(Is(Some(0.0)))
              let _ = body.box(fn(col : View) {
                let _ = col
                .width(Is(Some(360.0)))
                .grow(Is(1.0))
                .min_height(Is(Some(0.0)))
                .padding(Is((0.0, 0.0, 0.0, 24.0)))
                let _ = col.box(fn(room : View) {
                  room_id.v = Some(room.id())
                  let _ = room.width(Is(Some(360.0)))
                  let _ = room.scrolls_window(scroll, fn() { [0] }, est=56.0, fn(b : View, _k : Int) {
                    let _ = b.height(Is(Some(row_h)))
                  })
                })
                if with_neg_mb {
                  let _ = col.box(fn(f : View) { let _ = f.margin(Is((0.0, 0.0, 0.0, -8.0))) })
                }
              })
            })
          })
        },
        time=fn() { 0.0 },
      )
      let _ = tree.frame(390.0, 844.0)
      let h = match room_id.v {
        Some(id) => match tree.drawn_of(id) {
          Some(d) => d.h
          None => -1.0
        }
        None => -1.0
      }
      debug_assert(
        (h - row_h).abs() <= 0.5,
        "with_neg_mb=\{with_neg_mb} row_h=\{row_h}: room height=\{h} expected \{row_h}",
      )
      debug_assert(scroll.reach() == 0.0, "single row fits without scrolling")
      tree.dispose()
    }
  }
}

test "scrolls in variable-width max_width + max_height hugs container converges when content wraps (#8102)" {
  let cap_w = signals::signal_by(240.0, fn(a, b) { a == b })
  let scroll = Scroll::new()
  let room_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(
    fn(root : View) {
      let _ = root.box(fn(card : View) {
        let _ = card.max_width(By(fn() { Some(cap_w.get()) })).max_height(Is(Some(300.0)))
        let _ = card.box(fn(room : View) {
          room_id.v = Some(room.id())
          let _ = room.scrolls(scroll, fn(held : View) {
            let _ = held.row(Is(true)).wraps(Is(Some(0.0)))
            let mut k = 0
            while k < 6 {
              let _ = held.box(fn(tile : View) {
                let _ = tile.width(Is(Some(80.0))).height(Is(Some(30.0)))
              })
              k += 1
            }
          })
        })
      })
    },
    time=fn() { 0.0 },
  )
  let _ = tree.frame(600.0, 844.0)
  let h1 = match room_id.v {
    Some(id) => match tree.drawn_of(id) { Some(d) => d.h; None => -1.0 }
    None => -1.0
  }
  debug_assert((h1 - 60.0).abs() <= 0.5, "at max_width=240 expected 2 wrapped rows (60.0), got \{h1}")
  debug_assert(scroll.reach() == 0.0, "fits at max_width=240")

  tree.event(100.0, fn() { cap_w.set(160.0) })
  let _ = tree.frame(600.0, 844.0, now=100.0)
  let h2 = match room_id.v {
    Some(id) => match tree.drawn_of(id) { Some(d) => d.h; None => -1.0 }
    None => -1.0
  }
  debug_assert((h2 - 90.0).abs() <= 0.5, "at max_width=160 expected 3 wrapped rows (90.0), got \{h2}")
  debug_assert(scroll.reach() == 0.0, "fits at max_width=160")
  tree.dispose()
}

test "scrolls_window pinned foot is drawn_clear_of scroll host so Android overscroll does not stretch it (#8111)" {
  let s = Scroll::list()
  let host_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let foot_child_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let keys : Array[Int] = []
  let mut i = 0
  while i < 40 {
    keys.push(i)
    i += 1
  }
  let tree = Tree::new(
    fn(root : View) {
      let _ = root.box(fn(col : View) {
        host_id.v = Some(col.id())
        let _ = col.width(Is(Some(390.0))).height(Is(Some(844.0)))
        let _ = col.scrolls_window(
          s,
          fn() { keys },
          est=50.0,
          foot=fn(f : View) {
            let _ = f.box(fn(b : View) {
              foot_child_id.v = Some(b.id())
              let _ = b.height(Is(Some(60.0))).ground(Is(0x224466FFL))
            })
          },
          fn(row : View, _k : Int) {
            let _ = row.height(Is(Some(50.0))).ground(Is(0xEEEEEEFFL))
          },
        )
      })
    },
    time=fn() { 0.0 },
  )
  let _ = tree.frame(390.0, 844.0)
  match (host_id.v, foot_child_id.v) {
    (Some(hid), Some(fid)) => {
      debug_assert(tree.drawn_clear_of(fid, hid), "pinned foot descendant must be drawn_clear_of scroll host")
      match tree.drawn_of(fid) {
        Some(d) => debug_assert((d.h - 60.0).abs() < 0.5 && (d.y - 784.0).abs() < 0.5, "pinned foot sits at y=784 h=60")
        None => debug_assert(false, "expected pinned foot drawn")
      }
    }
    _ => debug_assert(false, "expected host_id and foot_child_id")
  }
  tree.dispose()
}

test "covered_under enforces paint order, nested absolute shell, and full part coverage" {
  let under_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let over_after_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let over_half_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let over_nested_id : signals::Ref[Option[NodeId]] = ref_new(None)

  // Case 1: Absolute background drawn BEFORE `under` must NOT count as covering `under`.
  let t1 = Tree::new(fn(root : View) {
    let _ = root.over(Is(false))
    let _ = root.box(fn(bg_host : View) {
      let _ = bg_host.over(Is(true))
      let _ = bg_host.box(fn(bg : View) {
        let _ = bg.over(Is(true)).ground(Is(0x112233FFL))
      })
      let ov = bg_host.box(fn(v : View) {
        let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
      })
      over_after_id.v = Some(ov.id())
    })
    let u = root.box(fn(v : View) {
      let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
    })
    under_id.v = Some(u.id())
  })
  let _ = t1.frame(300.0, 200.0, now=0.0)
  match (under_id.v, over_after_id.v) {
    (Some(uid), Some(oid)) => {
      debug_assert(!t1.covered_under(uid, oid, (0.0, 0.0, 100.0, 40.0)), "backdrop drawn before under must not cover under")
    }
    _ => debug_assert(false, "case 1 ids must be set")
  }
  t1.dispose()

  // Case 2: Nested `absolute wrapper > opaque shell` drawn AFTER `under` MUST cover `under`.
  under_id.v = None
  let t2 = Tree::new(fn(root : View) {
    let u = root.box(fn(v : View) {
      let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
    })
    under_id.v = Some(u.id())
    let _ = root.box(fn(overlay : View) {
      let _ = overlay.over(Is(true))
      // Nested absolute wrapper > opaque shell sibling beside `over`
      let _ = overlay.box(fn(abs_wrap : View) {
        let _ = abs_wrap.over(Is(true))
        let _ = abs_wrap.box(fn(shell : View) {
          let _ = shell.width(Is(Some(100.0))).height(Is(Some(40.0))).ground(Is(0x223344FFL))
        })
      })
      let ov = overlay.box(fn(v : View) {
        let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
      })
      over_nested_id.v = Some(ov.id())
    })
  })
  let _ = t2.frame(300.0, 200.0, now=0.0)
  match (under_id.v, over_nested_id.v) {
    (Some(uid), Some(oid)) => {
      debug_assert(t2.covered_under(uid, oid, (0.0, 0.0, 100.0, 40.0)), "nested absolute wrapper > opaque shell drawn after under must cover under")
    }
    _ => debug_assert(false, "case 2 ids must be set")
  }
  t2.dispose()

  // Case 3: Cover spanning only half the width of `part` must NOT count as covering `part`.
  under_id.v = None
  let t3 = Tree::new(fn(root : View) {
    let u = root.box(fn(v : View) {
      let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
    })
    under_id.v = Some(u.id())
    let _ = root.box(fn(overlay : View) {
      let _ = overlay.over(Is(true))
      let _ = overlay.box(fn(half_shell : View) {
        let _ = half_shell.over(Is(true), edges=(Some(0.0), Some(0.0), None, None))
          .width(Is(Some(50.0)))
          .height(Is(Some(40.0)))
          .ground(Is(0x223344FFL))
      })
      let ov = overlay.box(fn(v : View) {
        let _ = v.width(Is(Some(100.0))).height(Is(Some(40.0))).on_press(fn() {})
      })
      over_half_id.v = Some(ov.id())
    })
  })
  let _ = t3.frame(300.0, 200.0, now=0.0)
  match (under_id.v, over_half_id.v) {
    (Some(uid), Some(oid)) => {
      debug_assert(!t3.covered_under(uid, oid, (0.0, 0.0, 100.0, 40.0)), "half-width cover must not count as covering full part")
    }
    _ => debug_assert(false, "case 3 ids must be set")
  }
  t3.dispose()
}

test "show lives_with: what is shown in a long-lived host is let go of with its owner, nothing left behind" {
  let open = signals::signal(true)
  let gen = signals::signal(0)
  let made = ref_new(0)
  let shown : signals::Ref[Array[View]] = ref_new([])
  let root_ref : signals::Ref[Option[View]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    root_ref.v = Some(root)
    // (an owner made anew as `gen` changes, as a list's row is: its portal shown in `root`, beside it)
    root.pick(fn() { gen.get() }, fn(item : View, _g : Int) {
      let owner = item.box(fn(b : View) { let _ = b.width(Is(Some(20.0))).height(Is(Some(20.0))) })
      root.show(fn() { open.get() }, fn(p : View) {
        made.v = made.v + 1
        shown.v.push(p)
        let _ = p.width(Is(Some(10.0))).height(Is(Some(10.0)))
      }, at_once=true, lives_with=owner)
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let root = match root_ref.v { Some(r) => r; None => { debug_assert(false, "root"); return } }
  let live_shown = fn() -> Int { array_filter(shown.v, fn(p) { p.alive() }).length() }
  debug_assert(made.v == 1 && live_shown() == 1, "portal shown for the first owner")
  let kids0 = root.kids().length()
  let alive0 = tree.alive()
  let links0 = signals::live_link_count()
  // (owner made anew ten times while open: exactly one portal at a time, nothing growing in the host)
  for i in 1..=10 {
    gen.set(i)
    let _ = tree.frame(300.0, 200.0, now=i.to_double() * 16.0)
    debug_assert(live_shown() == 1, "exactly one portal alive after rebuild")
    debug_assert(root.kids().length() == kids0, "host holds no orphaned slot")
    debug_assert(tree.alive() == alive0, "no node left behind")
    debug_assert(signals::live_link_count() == links0, "no subscription left behind")
  }
  debug_assert(made.v == 11, "one portal made per owner")
  tree.dispose()

  // (owner let go of while its portal is open: the portal goes at once, and `when` turning again makes nothing)
  let keep = signals::signal(true)
  let made2 = ref_new(0)
  let shown2 : signals::Ref[Array[View]] = ref_new([])
  let root2 : signals::Ref[Option[View]] = ref_new(None)
  let t2 = Tree::new(fn(root : View) {
    root2.v = Some(root)
    root.show(fn() { keep.get() }, fn(item : View) {
      let owner = item.box(fn(_b : View) {  })
      root.show(fn() { open.get() }, fn(p : View) {
        made2.v = made2.v + 1
        shown2.v.push(p)
      }, at_once=true, lives_with=owner)
    }, at_once=true)
  })
  let _ = t2.frame(300.0, 200.0, now=0.0)
  let r2 = match root2.v { Some(r) => r; None => { debug_assert(false, "root"); return } }
  debug_assert(made2.v == 1 && shown2.v[0].alive(), "portal shown")
  debug_assert(r2.kids().length() == 2, "owner's slot and the portal's slot")
  keep.set(false)
  let _ = t2.frame(300.0, 200.0, now=16.0)
  debug_assert(!shown2.v[0].alive(), "portal let go of with its owner")
  debug_assert(r2.kids().length() == 1, "only the owner's slot is left in the host")
  open.set(false)
  let _ = t2.frame(300.0, 200.0, now=32.0)
  open.set(true)
  let _ = t2.frame(300.0, 200.0, now=48.0)
  debug_assert(made2.v == 1, "nothing made again once its owner is gone")
  debug_assert(r2.kids().length() == 1, "host still holds nothing of it")
  t2.dispose()
}

test "show lives_with: nothing shown while its owner is leaving, shown again as the owner comes back" {
  let keep = signals::signal(true)
  let shown : signals::Ref[Array[View]] = ref_new([])
  let items = ref_new(0)
  let tree = Tree::new(fn(root : View) {
    root.show(fn() { keep.get() }, fn(item : View) {
      items.v = items.v + 1
      let owner = item.box(fn(b : View) { let _ = b.width(Is(Some(20.0))).height(Is(Some(20.0))) })
      root.show(fn() { true }, fn(p : View) { shown.v.push(p) }, at_once=true, lives_with=owner)
    }, leave=200.0)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let live_shown = fn() -> Int { array_filter(shown.v, fn(p) { p.alive() }).length() }
  debug_assert(live_shown() == 1, "portal shown")
  keep.set(false)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  debug_assert(live_shown() == 0, "no portal while its owner leaves")
  keep.set(true)
  let _ = tree.frame(300.0, 200.0, now=48.0)
  debug_assert(items.v == 1, "the owner came back, not made anew")
  debug_assert(live_shown() == 1, "portal back as its owner comes back")
  keep.set(false)
  let _ = tree.frame(300.0, 200.0, now=64.0)
  let _ = tree.frame(300.0, 200.0, now=600.0)
  debug_assert(live_shown() == 0, "no portal once its owner is gone")
  tree.dispose()
}

test "show lives_with: reverse destruction (host dies while owner lives) leaks zero callbacks" {
  let host_on = signals::signal(false)
  let owner_ref : signals::Ref[Option[View]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let owner = root.box(fn(b : View) {
      let _ = b.width(Is(Some(40.0))).height(Is(Some(40.0)))
    })
    owner_ref.v = Some(owner)
    root.show(fn() { host_on.get() }, fn(host : View) {
      host.show(
        fn() { true },
        fn(p : View) {
          let _ = p.width(Is(Some(20.0))).height(Is(Some(20.0)))
        },
        at_once=true,
        lives_with=owner,
      )
    }, at_once=true)
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  let owner = match owner_ref.v {
    Some(v) => v
    None => { debug_assert(false, "owner created"); return }
  }
  let base_cbs = owner.lifecycle_callback_count()
  for round in 0..<10 {
    let t_on = (round * 2 + 1).to_double() * 16.0
    let t_off = (round * 2 + 2).to_double() * 16.0
    host_on.set(true)
    let _ = tree.frame(300.0, 200.0, now=t_on)
    debug_assert(owner.lifecycle_callback_count() > base_cbs, "portal registered lifecycle hooks on owner")
    host_on.set(false)
    let _ = tree.frame(300.0, 200.0, now=t_off)
    debug_assert(
      owner.lifecycle_callback_count() == base_cbs,
      "round \{round}: owner callbacks must return to baseline \{base_cbs}, got \{owner.lifecycle_callback_count()}",
    )
  }
  tree.dispose()
}

test "key_when_scoped and Tree::stroke scoped_only/focus_only dispatch" {
  debug_assert(!key_when_scoped(KeyWhen::Always), "Always is not scoped")
  debug_assert(!key_when_scoped(KeyWhen::Not(KeyWhen::In("Field"))), "Not(In(Field)) is not scoped")
  debug_assert(!key_when_scoped(KeyWhen::Any([KeyWhen::Always, KeyWhen::In("X")])), "Any([Always, In]) is not scoped")
  debug_assert(key_when_scoped(KeyWhen::In("X")), "In(X) is scoped")
  debug_assert(key_when_scoped(KeyWhen::All([KeyWhen::In("X"), KeyWhen::Not(KeyWhen::In("Field"))])), "All([In, Not]) is scoped")
  debug_assert(key_when_scoped(KeyWhen::Any([KeyWhen::In("A"), KeyWhen::In("B")])), "Any([In, In]) is scoped")
  let focused_hit = ref_new(0)
  let sibling_hit = ref_new(0)
  let global_hit = ref_new(0)
  let focus_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let km = Keymap::new([
      Binding::{ keys: [Stroke::{ code: 5, mods: 0 }], action: "global.up", when: KeyWhen::Always },
      Binding::{ keys: [Stroke::{ code: 5, mods: 0 }], action: "sib.up", when: KeyWhen::In("Sib") },
      Binding::{ keys: [Stroke::{ code: 5, mods: 0 }], action: "foc.up", when: KeyWhen::In("Foc") },
    ])
    let _ = root.keymap(Is(km))
      .on_action("global.up", fn(_) { global_hit.v = global_hit.v + 1; true })
    let _ = root.box(fn(f : View) {
      let _ = f.width(Is(Some(40.0))).height(Is(Some(20.0))).focusable(Is(true)).key_context("Foc")
        .on_action("foc.up", fn(_) { focused_hit.v = focused_hit.v + 1; true })
      focus_id.v = Some(f.id())
    })
    let _ = root.box(fn(s : View) {
      let _ = s.width(Is(Some(40.0))).height(Is(Some(20.0))).key_context("Sib")
        .on_action("sib.up", fn(_) { sibling_hit.v = sibling_hit.v + 1; true })
    })
  })
  let _ = tree.frame(200.0, 200.0, now=0.0)
  debug_assert(tree.stroke(5, 0, 10.0, from=focus_id.v, scoped_only=true, focus_only=true), "scoped focus chain matches")
  debug_assert(focused_hit.v == 1 && sibling_hit.v == 0 && global_hit.v == 0, "only focused scoped action ran")
  debug_assert(!tree.stroke(5, 0, 20.0, from=None, scoped_only=true, focus_only=true), "from=None matches nothing in focus_only mode")
  debug_assert(sibling_hit.v == 0 && global_hit.v == 0, "sibling and global untouched")
  tree.dispose()
}

test "Tree::withins_told handles re-entrant mount, drop, and pointer_is without OOB or losing new observers" {
  let swap_bar = signals::signal(false)
  let new_bar_hits = ref_new(0)
  let new_bar_seen = ref_new(false)
  let drop_self = signals::signal(true)
  let reentrant_done = ref_new(false)
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(400.0))).height(Is(Some(300.0)))
    // Node 1: entering pointer_within triggers swap_bar=true (drops old toolbar with multiple pointer_within
    // nodes and mounts a brand-new toolbar that registers a fresh pointer_within observer).
    let _ = root.box(fn(trigger : View) {
      let _ = trigger.over_at(Is((Some(0.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(100.0)))
      let _ = trigger.reacts(
        fn() { trigger.pointer_within() },
        fn(in_now : Bool) {
          if in_now && !swap_bar.untracked() {
            swap_bar.set(true)
            drop_self.set(false)
          }
        },
      )
    })
    // Old toolbar with 3 pointer_within observers (gets dropped synchronously during withins_told).
    let _ = root.show(
      fn() { !swap_bar.get() },
      fn(old_tb : View) {
        for i in 0..<3 {
          let _ = old_tb.box(fn(btn : View) {
            let _ = btn.over_at(Is((Some(120.0 + i.to_double() * 40.0), Some(0.0), None, None)))
              .width(Is(Some(36.0))).height(Is(Some(36.0)))
            let _ = btn.reacts(fn() { btn.pointer_within() }, fn(_) { () })
          })
        }
      },
      at_once=true,
    )
    // Self-dropping node whose own pointer_within observer exists while swap drops it.
    let _ = root.show(
      fn() { drop_self.get() },
      fn(victim : View) {
        let _ = victim.over_at(Is((Some(260.0), Some(0.0), None, None))).width(Is(Some(40.0))).height(Is(Some(40.0)))
        let _ = victim.reacts(fn() { victim.pointer_within() }, fn(_) { () })
      },
      at_once=true,
    )
    // New toolbar mounted synchronously during withins_told: its pointer_within MUST survive and track later moves!
    let _ = root.show(
      fn() { swap_bar.get() },
      fn(new_tb : View) {
        let _ = new_tb.over_at(Is((Some(200.0), Some(150.0), None, None))).width(Is(Some(100.0))).height(Is(Some(80.0)))
        let _ = new_tb.reacts(
          fn() { new_tb.pointer_within() },
          fn(in_now : Bool) {
            new_bar_seen.v = in_now
            if in_now {
              new_bar_hits.v = new_bar_hits.v + 1
            }
          },
        )
      },
      at_once=true,
    )
    // Re-entrant pointer_is inside a pointer_within effect: must defer via pointer_again and converge.
    let _ = root.box(fn(bounce : View) {
      let _ = bounce.over_at(Is((Some(0.0), Some(150.0), None, None))).width(Is(Some(100.0))).height(Is(Some(80.0)))
      let _ = bounce.reacts(
        fn() { bounce.pointer_within() },
        fn(in_now : Bool) {
          if in_now && !reentrant_done.v {
            reentrant_done.v = true
            bounce.tree.pointer_is(250.0, 190.0)
          }
        },
      )
    })
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  // Direct call outside signals batch so `cell.set(now)` runs effects synchronously inside `withins_told`,
  // dropping old_tb (3 observers) + victim (1 observer) and mounting new_tb mid-iteration.
  tree.point_at(50.0, 50.0)
  let _ = tree.frame(400.0, 300.0, now=16.0)
  debug_assert(swap_bar.untracked(), "entering trigger swapped toolbars without OOB")
  // Move into the newly mounted new_tb -> proves new_tb's pointer_within was NOT wiped by withins_at.clear().
  tree.point_at(250.0, 190.0)
  debug_assert(new_bar_seen.v && new_bar_hits.v >= 1, "newly mounted toolbar pointer_within fired: hits=\{new_bar_hits.v}")
  // Move out, then into bounce -> re-entrantly calls pointer_is(250, 190) -> must update new_tb again!
  tree.point_at(380.0, 280.0)
  debug_assert(!new_bar_seen.v, "moving out cleared new_tb pointer_within")
  let hits_before = new_bar_hits.v
  tree.point_at(50.0, 190.0)
  debug_assert(reentrant_done.v && new_bar_seen.v && new_bar_hits.v == hits_before + 1, "re-entrant pointer_is updated new_tb: hits=\{new_bar_hits.v}")
  tree.dispose()
}

test "Tree::bars_near_told handles drop and mount of bar_near columns during cell.set without OOB or losing new columns" {
  let swap_cols = signals::signal(false)
  let new_col_near = ref_new(false)
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(300.0))).height(Is(Some(200.0)))
    let _ = root.box(fn(col1 : View) {
      let _ = col1.over_at(Is((Some(0.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(200.0)))
      let _ = col1.reacts(
        fn() { col1.bar_near(20.0) },
        fn(near : Bool) {
          if near && !swap_cols.untracked() {
            swap_cols.set(true)
          }
        },
      )
    })
    let _ = root.show(
      fn() { !swap_cols.get() },
      fn(old_wrap : View) {
        for i in 0..<3 {
          let _ = old_wrap.box(fn(c : View) {
            let _ = c.over_at(Is((Some(110.0 + i.to_double() * 50.0), Some(0.0), None, None)))
              .width(Is(Some(40.0))).height(Is(Some(200.0)))
            let _ = c.reacts(fn() { c.bar_near(16.0) }, fn(_) { () })
          })
        }
      },
      at_once=true,
    )
    let _ = root.show(
      fn() { swap_cols.get() },
      fn(new_col : View) {
        let _ = new_col.over_at(Is((Some(150.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(200.0)))
        let _ = new_col.reacts(
          fn() { new_col.bar_near(20.0) },
          fn(near : Bool) { new_col_near.v = near },
        )
      },
      at_once=true,
    )
  })
  let _ = tree.frame(300.0, 200.0, now=0.0)
  // Direct call outside signals batch so `cell.set(now)` runs effects synchronously inside `bars_near_told`,
  // dropping 3 old columns (previously panicking with OOB) and mounting new_col mid-iteration.
  tree.point_at(90.0, 100.0)
  let _ = tree.frame(300.0, 200.0, now=16.0)
  debug_assert(swap_cols.untracked(), "bar_near swap succeeded without OOB")
  // Move pointer near new_col's right edge (x=240 in [230, 250)) -> proves new_col survived bar_cols.clear().
  tree.point_at(240.0, 100.0)
  debug_assert(new_col_near.v, "newly mounted bar_near column must stay registered and fire")
  tree.dispose()
}

test "Tree::withins_told does not panic OOB when dead entries are compacted during re-entrant pointer_is" {
  let dead_on = signals::signal(true)
  let jumped = ref_new(false)
  let tail_seen = ref_new(false)
  let tree = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(400.0))).height(Is(Some(300.0)))
    // 3 dead entries left in `withins_at` once `dead_on` turns false.
    let _ = root.show(
      fn() { dead_on.get() },
      fn(dead_wrap : View) {
        for i in 0..<3 {
          let _ = dead_wrap.box(fn(d : View) {
            let _ = d.over_at(Is((Some(i.to_double() * 20.0), Some(0.0), None, None)))
              .width(Is(Some(16.0))).height(Is(Some(16.0)))
            let _ = d.reacts(fn() { d.pointer_within() }, fn(_) { () })
          })
        }
      },
      at_once=true,
    )
    // Middle observer: entering it re-entrantly calls `pointer_is` to jump onto tail node.
    // On unfixed code, inner `withins_told` compacts away the 3 dead entries, shortening `withins_at`
    // while outer `for w in self.withins_at` still iterates to the old length -> pion panic: oob.
    let _ = root.box(fn(mid : View) {
      let _ = mid.over_at(Is((Some(100.0), Some(0.0), None, None))).width(Is(Some(60.0))).height(Is(Some(60.0)))
      let _ = mid.reacts(
        fn() { mid.pointer_within() },
        fn(in_now : Bool) {
          if in_now && !jumped.v {
            jumped.v = true
            mid.tree.pointer_is(260.0, 30.0)
          }
        },
      )
    })
    // Trailing live observers after `mid`.
    for i in 0..<3 {
      let _ = root.box(fn(tail : View) {
        let _ = tail.over_at(Is((Some(240.0 + i.to_double() * 40.0), Some(0.0), None, None)))
          .width(Is(Some(36.0))).height(Is(Some(60.0)))
        let _ = tail.reacts(
          fn() { tail.pointer_within() },
          fn(in_now : Bool) {
            if i == 0 {
              tail_seen.v = in_now
            }
          },
        )
      })
    }
  })
  let _ = tree.frame(400.0, 300.0, now=0.0)
  // Drop the 3 dead nodes without moving the pointer (leaves 3 dead tuples in `withins_at`).
  dead_on.set(false)
  // Move pointer into `mid` -> re-entrant `pointer_is(260, 30)` must NOT OOB and must settle `tail_seen`.
  tree.point_at(120.0, 30.0)
  debug_assert(jumped.v && tail_seen.v, "re-entrant pointer_is with dead entries must not OOB and must update tail")
  tree.dispose()
}
