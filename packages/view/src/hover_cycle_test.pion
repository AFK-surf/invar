import "signals"

test "a hover that moves itself cannot keep a layout running forever" {
  let reactions = ref_new(0)
  let escaped = ref_new(false)
  let other_width = signals::signal_by(10.0, fn(a, b) { a == b })
  let other_y = signals::signal_by(100.0, fn(a, b) { a == b })
  let other_hover = ref_new(false)
  let opacity = signals::signal_by(1.0, fn(a, b) { a == b })
  let cycling = signals::signal_by(true, fn(a, b) { a == b })
  let box_ref : Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.lines_up(Is(Some(Along::Start)))
    let _ = root.box(fn(n : View) {
      box_ref.v = Some(n)
      let _ = n.reacts(fn() { n.pointer_within() }, fn(_) {
        reactions.v = reactions.v + 1
        if reactions.v >= 200 {
          escaped.v = true
        }
      })
      let _ = n
      .width(
        By(fn() {
          Some(
            if cycling.get() && n.pointer_within() && !escaped.v {
              20.0
            } else {
              40.0
            },
          )
        }),
      )
      .alpha(By(fn() { opacity.get() }))
      .height(Is(Some(20.0)))
    })
    let _ = root.box(fn(n : View) {
      let _ = n.reacts(fn() { n.pointer_within() }, fn(v) { other_hover.v = v })
      let _ = n
      .over(Is(true))
      .offset(By(fn() { (0.0, other_y.get()) }))
      .width(By(fn() { Some(50.0 + other_width.get()) }))
      .height(Is(Some(20.0)))
    })
  })
  let _ = t.frame(300.0, 300.0)
  t.point_at(30.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!escaped.v, "hover layout must stop before its state oscillates 200 times")
  debug_assert(reactions.v > 1, "the hover did change more than once")
  let stopped = reactions.v
  let _ = t.frame(300.0, 300.0)
  debug_assert(reactions.v == stopped, "idle frames do not restart the loop")
  for y in [0.0, 100.0, 0.0, 100.0] {
    other_width.set(if y == 0.0 { 10.0 } else { 11.0 })
    other_y.set(y)
    opacity.set(if y == 0.0 { 0.9 } else { 1.0 })
    let _ = t.frame(300.0, 300.0)
    debug_assert(other_hover.v == (y == 0.0), "other hover observers continue to update")
    debug_assert(t.pending.length() < 1000, "each frame leaves a bounded set of changes for the host")
    let _ = t.take_changed()
  }
  debug_assert(!escaped.v, "unrelated layout does not endlessly restart the hover loop")
  debug_assert(reactions.v == stopped, "unrelated changes on the hovering node do not restart the loop")
  cycling.set(false)
  let _ = t.frame(300.0, 300.0)
  let within_after = signals::untracked(fn() {
    match box_ref.v {
      Some(b) => b.pointer_within()
      None => false
    }
  })
  debug_assert(within_after, "the observer catches up when its feedback goes away")
  t.point_at(100.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!t.due, "the tree settles after the pointer moves away")
  t.dispose()
}

test "moving an ancestor lets a stopped hover catch up" {
  let reactions = ref_new(0)
  let escaped = ref_new(false)
  let offset = signals::signal_by(0.0, fn(a, b) { a == b })
  let trigger_y = signals::signal_by(100.0, fn(a, b) { a == b })
  let box_ref : Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(parent : View) {
      let _ = parent.shift(By(fn() { (offset.get(), 0.0) }))
      let _ = parent.box(fn(n : View) {
        box_ref.v = Some(n)
        let _ = n.reacts(fn() { n.pointer_within() }, fn(_) {
          reactions.v = reactions.v + 1
          if reactions.v >= 200 {
            escaped.v = true
          }
        })
        let _ = n
        .width(
          By(fn() {
            Some(if n.pointer_within() && !escaped.v { 20.0 } else { 40.0 })
          }),
        )
        .height(Is(Some(20.0)))
      })
    })
    let _ = root.box(fn(other : View) {
      let _ = other
      .over(Is(true))
      .offset(By(fn() { (0.0, trigger_y.get()) }))
      .width(Is(Some(60.0)))
      .height(Is(Some(20.0)))
      let _ = other.reacts(fn() { other.pointer_within() }, fn(on) {
        if on {
          offset.set(100.0)
        }
      })
    })
  })
  let _ = t.frame(300.0, 300.0)
  t.point_at(30.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!escaped.v, "escaped should be false")
  debug_assert(t.pointer_still.is_some(), "pointer_still should be Some")
  trigger_y.set(0.0)
  let _ = t.frame(300.0, 300.0)
  let within_after = signals::untracked(fn() {
    match box_ref.v {
      Some(b) => b.pointer_within()
      None => true
    }
  })
  debug_assert(!within_after, "pointer_within should be false after ancestor moves")
  debug_assert(t.pointer_still.is_none(), "pointer_still should be None")
  debug_assert(!t.due, "tree should not be due")
  t.dispose()
}

test "a bar that moves itself cannot keep a layout running forever" {
  let reactions = ref_new(0)
  let escaped = ref_new(false)
  let other_width = signals::signal_by(10.0, fn(a, b) { a == b })
  let bar_ref : Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.lines_up(Is(Some(Along::Start)))
    let _ = root.box(fn(n : View) {
      bar_ref.v = Some(n)
      let _ = n.reacts(fn() { n.bar_near(15.0) }, fn(_) {
        reactions.v = reactions.v + 1
        if reactions.v >= 200 {
          escaped.v = true
        }
      })
      let _ = n
      .width(
        By(fn() {
          Some(if n.bar_near(15.0) && !escaped.v { 20.0 } else { 40.0 })
        }),
      )
      .height(Is(Some(20.0)))
      .ground(Is(0xff000000.to_int64()))
    })
    let _ = root.box(fn(n : View) {
      let _ = n.width(By(fn() { Some(other_width.get()) })).height(Is(Some(1.0)))
    })
  })
  let _ = t.frame(300.0, 300.0)
  t.point_at(35.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!escaped.v, "escaped should be false")
  debug_assert(reactions.v > 1, "reactions should be > 1")
  debug_assert(t.pointer_still.is_some(), "pointer_still should be Some")
  let stopped = reactions.v
  for width in [10.0, 11.0, 10.0, 11.0] {
    other_width.set(width)
    let _ = t.frame(300.0, 300.0)
  }
  debug_assert(reactions.v == stopped, "unrelated layout should not restart bar loop")
  t.point_at(100.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  let bar_after = signals::untracked(fn() {
    match bar_ref.v {
      Some(b) => b.bar_near(15.0)
      None => true
    }
  })
  debug_assert(!bar_after, "bar_near should be false after pointer moves away")
  debug_assert(!t.due, "tree should not be due")
  t.dispose()
}

test "a long chain of distinct hover states settles in one frame" {
  let views : Array[View] = []
  let t = Tree::new(fn(root : View) {
    let mut k = 0
    while k < 50 {
      let idx = k
      let _ = root.box(fn(n : View) {
        let before : Option[View] = if idx > 0 { Some(views[idx - 1]) } else { None }
        views.push(n)
        let _ = n
        .over(Is(true))
        .width(Is(Some(100.0)))
        .height(Is(Some(20.0)))
        .offset(
          By(fn() {
            match before {
              None => (0.0, 80.0)
              Some(b) =>
              if b.pointer_within() {
                (0.0, 80.0)
              } else {
                (0.0, 250.0)
              }
            }
          }),
        )
      })
      k += 1
    }
  })
  t.point_at(10.0, 90.0)
  let _ = t.frame(400.0, 300.0)
  for v in views {
    debug_assert(signals::untracked(fn() { v.pointer_within() }), "every view in chain should be hovered")
  }
  debug_assert(t.pointer_still.is_none(), "long chain should settle without pointer_still")
  debug_assert(!t.due, "tree should not be due")
  t.dispose()
}

test "a hover with no repeating geometry cannot hold a frame forever" {
  let reactions = ref_new(0)
  let t = Tree::new(fn(root : View) {
    let _ = root.box(fn(n : View) {
      let _ = n.reacts(fn() { n.pointer_within() }, fn(_) { reactions.v = reactions.v + 1 })
      let _ = n
      .width(
        By(fn() {
          let within = n.pointer_within()
          let step = reactions.v.to_double() / 1000.0
          Some(
            if within && reactions.v < 500 {
              20.0 + step
            } else {
              40.0 + step
            },
          )
        }),
      )
      .height(Is(Some(20.0)))
    })
  })
  let _ = t.frame(300.0, 300.0)
  t.point_at(30.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(reactions.v > 32 && reactions.v < 300, "reactions should be bounded")
  debug_assert(t.pointer_still.is_some(), "pointer_still should be Some")
  let stopped = reactions.v
  let _ = t.frame(300.0, 300.0)
  debug_assert(reactions.v == stopped, "idle frame should not restart")
  t.point_at(100.0, 10.0)
  let _ = t.frame(300.0, 300.0)
  debug_assert(!t.due, "tree should not be due")
  t.dispose()
}
