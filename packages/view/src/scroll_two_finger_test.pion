// Unit tests for two-finger alternating scroll on View::scrolls (#8178).

import "signals"

fn make_scroll_column() -> (Tree, Scroll, NodeId) {
  let scroll = Scroll::new()
  let host_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let _ = root
    .width(Is(Some(300.0)))
    .height(Is(Some(300.0)))
    .scrolls(scroll, fn(held : View) {
      let _ = held.width(Is(Some(300.0))).height(Is(Some(600.0)))
    })
    host_id.v = Some(root.id())
  })
  let _ = tree.frame(300.0, 300.0, now=0.0)
  let id = match host_id.v {
    Some(x) => x
    None => { debug_assert(false, "host_id must be set"); NodeId::{ at: 0, gen: 0 } }
  }
  (tree, scroll, id)
}

test "scrolls: two fingers taking turns: last down leads, other moves kept, handoff without jump, flung on last lift" {
  let (tree, scroll, id) = make_scroll_column()
  let at : Array[Double] = []
  let _ = tree.drag_at(id, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = tree.drag_at(id, Moved, 150.0, 170.0, 110.0, finger=0)
  at.push(scroll.at(tree))
  // second finger down: it leads, first's move moves nothing
  let _ = tree.drag_at(id, Down, 150.0, 150.0, 120.0, finger=1)
  let _ = tree.drag_at(id, Moved, 150.0, 160.0, 125.0, finger=0)
  at.push(scroll.at(tree))
  let _ = tree.drag_at(id, Moved, 150.0, 140.0, 130.0, finger=1)
  at.push(scroll.at(tree))
  // first finger up: second continues smoothly
  let _ = tree.drag_at(id, Up, 150.0, 160.0, 135.0, finger=0)
  let held = scroll.in_hand()
  let _ = tree.drag_at(id, Moved, 150.0, 130.0, 140.0, finger=1)
  at.push(scroll.at(tree))
  // third finger down (first down again): leads
  let _ = tree.drag_at(id, Down, 150.0, 190.0, 145.0, finger=2)
  let _ = tree.drag_at(id, Moved, 150.0, 180.0, 150.0, finger=2)
  at.push(scroll.at(tree))
  let _ = tree.drag_at(id, Moved, 150.0, 100.0, 155.0, finger=1)
  at.push(scroll.at(tree))
  // leader up: finger 1 leads again from where it was last (100)
  let _ = tree.drag_at(id, Up, 150.0, 180.0, 160.0, finger=2)
  let _ = tree.drag_at(id, Moved, 150.0, 95.0, 165.0, finger=1)
  at.push(scroll.at(tree))
  let _ = tree.drag_at(id, Moved, 150.0, 80.0, 170.0, finger=1)
  let _ = tree.drag_at(id, Moved, 150.0, 65.0, 175.0, finger=1)
  let up = scroll.at(tree)
  let _ = tree.drag_at(id, Up, 150.0, 65.0, 175.0, finger=1)
  let let_go = scroll.in_hand()
  tree.advance(195.0)
  let on = scroll.at(tree)
  tree.advance(5000.0)
  let rest = scroll.at(tree)
  let expected = [20.0, 20.0, 30.0, 40.0, 50.0, 50.0, 55.0]
  debug_assert(at.length() == expected.length(), "at length")
  let mut i = 0
  while i < expected.length() {
    debug_assert((at[i] - expected[i]).abs() < 0.01, "at[i] matches expected")
    i += 1
  }
  debug_assert(held, "still in_hand after first lift")
  debug_assert((up - 85.0).abs() < 0.01, "up position is 85.0")
  debug_assert(!let_go, "not in_hand after last lift")
  debug_assert(on > up, "flung past up")
  debug_assert(rest > on && rest <= 300.0, "rest settles within reach")
  tree.dispose()
}

test "scrolls: leader lifted then other lifted after tracker_gap_ms pause does not fling; quick lift flings; reversed handoff never flings old way" {
  // 60 ms pause (> tracker_gap_ms) after leader lifts: stopped, no fling
  let (tree, scroll, id) = make_scroll_column()
  let _ = tree.drag_at(id, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = tree.drag_at(id, Moved, 150.0, 170.0, 108.0, finger=0)
  let _ = tree.drag_at(id, Moved, 150.0, 150.0, 116.0, finger=0)
  let _ = tree.drag_at(id, Down, 150.0, 150.0, 120.0, finger=1)
  let _ = tree.drag_at(id, Moved, 150.0, 140.0, 124.0, finger=1)
  let _ = tree.drag_at(id, Up, 150.0, 140.0, 128.0, finger=1)
  let _ = tree.drag_at(id, Up, 150.0, 150.0, 188.0, finger=0)
  let up = scroll.at(tree)
  tree.advance(5000.0)
  debug_assert((up - 50.0).abs() < 0.01, "up at 50")
  debug_assert((scroll.at(tree) - 50.0).abs() < 0.01, "stayed at 50 without fling")
  debug_assert(scroll.glides_till().is_none(), "no glide scheduled")
  debug_assert(!scroll.in_hand(), "not in hand")
  tree.dispose()

  // k_quick: resting finger lifts within 4 ms of leader lift -> preserves cumulative velocity fling
  let (tq, sq, idq) = make_scroll_column()
  let _ = tq.drag_at(idq, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = tq.drag_at(idq, Moved, 150.0, 170.0, 108.0, finger=0)
  let _ = tq.drag_at(idq, Moved, 150.0, 150.0, 116.0, finger=0)
  let _ = tq.drag_at(idq, Down, 150.0, 150.0, 120.0, finger=1)
  let _ = tq.drag_at(idq, Moved, 150.0, 140.0, 124.0, finger=1)
  let _ = tq.drag_at(idq, Up, 150.0, 140.0, 128.0, finger=1)
  let _ = tq.drag_at(idq, Up, 150.0, 150.0, 132.0, finger=0)
  let up_q = sq.at(tq)
  tq.advance(5000.0)
  debug_assert((up_q - 50.0).abs() < 0.01, "k_quick up at 50")
  debug_assert(sq.at(tq) > up_q + 5.0, "k_quick preserved fling past 50")
  debug_assert(!sq.in_hand(), "k_quick not in hand")
  tq.dispose()

  // k2: finger 0 moves up, finger 1 takes over and reverses downward, then lifts and finger 0 lifts at once: never flings old way
  let (t2, s2, id2) = make_scroll_column()
  let _ = t2.drag_at(id2, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = t2.drag_at(id2, Moved, 150.0, 150.0, 108.0, finger=0)
  let _ = t2.drag_at(id2, Moved, 150.0, 110.0, 116.0, finger=0)
  let _ = t2.drag_at(id2, Down, 150.0, 110.0, 120.0, finger=1)
  let _ = t2.drag_at(id2, Moved, 150.0, 130.0, 128.0, finger=1)
  let _ = t2.drag_at(id2, Moved, 150.0, 150.0, 136.0, finger=1)
  let _ = t2.drag_at(id2, Up, 150.0, 150.0, 136.0, finger=1)
  let _ = t2.drag_at(id2, Up, 150.0, 110.0, 140.0, finger=0)
  let up_rev = s2.at(t2)
  t2.advance(5000.0)
  debug_assert(s2.at(t2) <= up_rev + 0.01, "k2 reversed handoff must not fling upward")
  debug_assert(!s2.in_hand(), "k2 not in hand")
  t2.dispose()

  // explicit Off cancels all held fingers cleanly without fling
  let (to, so, ido) = make_scroll_column()
  let _ = to.drag_at(ido, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = to.drag_at(ido, Moved, 150.0, 170.0, 110.0, finger=0)
  let _ = to.drag_at(ido, Down, 150.0, 150.0, 120.0, finger=1)
  let _ = to.drag_at(ido, Moved, 150.0, 140.0, 130.0, finger=1)
  debug_assert((so.at(to) - 30.0).abs() < 0.01 && so.in_hand(), "off held at 30")
  let _ = to.drag_at(ido, Off, 150.0, 140.0, 140.0, finger=1)
  debug_assert((so.at(to) - 30.0).abs() < 0.01 && !so.in_hand() && so.glides_till().is_none(), "explicit Off cancelled all fingers cleanly")
  let _ = to.drag_at(ido, Moved, 150.0, 100.0, 150.0, finger=0)
  to.advance(5000.0)
  debug_assert((so.at(to) - 30.0).abs() < 0.01, "post-Off move ignored")
  to.dispose()
}

test "scrolls: eleventh finger down cancels hold cleanly and subsequent hold works" {
  let (tree, scroll, id) = make_scroll_column()
  let _ = tree.drag_at(id, Down, 150.0, 190.0, 100.0, finger=0)
  let _ = tree.drag_at(id, Moved, 150.0, 170.0, 110.0, finger=0)
  let _ = tree.drag_at(id, Down, 150.0, 150.0, 120.0, finger=1)
  let _ = tree.drag_at(id, Moved, 150.0, 140.0, 130.0, finger=1)
  debug_assert((scroll.at(tree) - 30.0).abs() < 0.01 && scroll.in_hand(), "held at 30")
  let mut f = 2
  while f < 10 {
    let _ = tree.drag_at(id, Down, 150.0, 140.0, 130.0 + f.to_double(), finger=f)
    f += 1
  }
  let _ = tree.drag_at(id, Down, 150.0, 120.0, 145.0, finger=10)
  debug_assert((scroll.at(tree) - 30.0).abs() < 0.01 && !scroll.in_hand() && scroll.glides_till().is_none(), "cancelled cleanly")
  let _ = tree.drag_at(id, Moved, 150.0, 100.0, 150.0, finger=1)
  tree.advance(5000.0)
  debug_assert((scroll.at(tree) - 30.0).abs() < 0.01, "ignored post-cancel move")
  let _ = tree.drag_at(id, Down, 150.0, 190.0, 20000.0, finger=0)
  let _ = tree.drag_at(id, Moved, 150.0, 180.0, 20010.0, finger=0)
  let _ = tree.drag_at(id, Up, 150.0, 180.0, 20200.0, finger=0)
  debug_assert((scroll.at(tree) - 40.0).abs() < 0.01, "subsequent hold scrolls to 40")
  tree.dispose()
}

test "scrolls across: two fingers taking turns along row without moving outer column" {
  let col = Scroll::new()
  let across = Scroll::across()
  let row_id : signals::Ref[Option[NodeId]] = ref_new(None)
  let tree = Tree::new(fn(root : View) {
    let _ = root
    .width(Is(Some(390.0)))
    .height(Is(Some(844.0)))
    .scrolls(col, fn(held : View) {
      let _ = held.box(fn(spacer : View) {
        let _ = spacer.width(Is(Some(390.0))).height(Is(Some(120.0)))
      })
      let r = held.box(fn(v : View) {
        let _ = v
        .width(Is(Some(390.0)))
        .height(Is(Some(80.0)))
        .scrolls(across, fn(h : View) {
          let _ = h.width(Is(Some(900.0))).height(Is(Some(80.0)))
        })
      })
      row_id.v = Some(r.id())
      let _ = held.box(fn(tail : View) {
        let _ = tail.width(Is(Some(390.0))).height(Is(Some(1200.0)))
      })
    })
  })
  let _ = tree.frame(390.0, 844.0, now=0.0)
  let _ = tree.wheel_at(150.0, 50.0, 0.0, 100.0, 0, 5.0)
  let _ = tree.frame(390.0, 844.0, now=5.0)
  let id = match row_id.v {
    Some(x) => x
    None => { debug_assert(false, "row_id must be set"); NodeId::{ at: 0, gen: 0 } }
  }
  let at : Array[Double] = []
  let _ = tree.drag_at(id, Down, 200.0, 70.0, 100.0, finger=0)
  let _ = tree.drag_at(id, Moved, 180.0, 70.0, 110.0, finger=0)
  at.push(across.at(tree))
  let _ = tree.drag_at(id, Down, 100.0, 60.0, 120.0, finger=1)
  let _ = tree.drag_at(id, Moved, 170.0, 70.0, 125.0, finger=0)
  at.push(across.at(tree))
  let _ = tree.drag_at(id, Moved, 90.0, 60.0, 130.0, finger=1)
  at.push(across.at(tree))
  let _ = tree.drag_at(id, Up, 170.0, 70.0, 135.0, finger=0)
  let _ = tree.drag_at(id, Moved, 80.0, 60.0, 140.0, finger=1)
  at.push(across.at(tree))
  let _ = tree.drag_at(id, Up, 80.0, 60.0, 400.0, finger=1)
  tree.advance(5000.0)
  let expected = [20.0, 20.0, 30.0, 40.0]
  let mut i = 0
  while i < expected.length() {
    debug_assert((at[i] - expected[i]).abs() < 0.01, "across at[i] matches")
    i += 1
  }
  debug_assert((across.at(tree) - 40.0).abs() < 0.01, "across settled at 40")
  debug_assert((col.at(tree) - 100.0).abs() < 0.01, "outer column stayed at 100")
  tree.dispose()
}
