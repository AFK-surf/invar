///|
fn count_scroll_each_in(tree : Tree, at : Int, scroll_at : Int, limit : Int, out : Array[String]) -> Unit {
  guard at >= 0 && at < tree.nodes.length() else { return }
  let n = tree.nodes[at]
  guard n.live else { return }
  if at != scroll_at && mbt_compat::ordered_map_contains_mapkey(tree.scrolls_at, at) {
    return
  }
  if n.slot {
    let mut rows = 0
    for k in n.kids {
      if k >= 0 && k < tree.nodes.length() && tree.nodes[k].live && tree.nodes[k].each_row {
        rows += 1
      }
    }
    if rows > limit {
      let place = match n.source {
        Some(s) =>
        match s.made_for {
          Some(mf) => " at " + source_place(s.made) + " (for " + source_place(mf) + ")"
          Option::None => " at " + source_place(s.made)
        }
        Option::None => {
          let sid : NodeId = NodeId::{ at: scroll_at, gen: tree.nodes[scroll_at].gen }
          match mbt_compat::arr_get(tree.sources_of(sid), 0) {
            Some(first) => " at " + first.made
            Option::None => ""
          }
        }
      }
      out.push("[UNVIRTUALIZED_SCROLL_EACH] View::each inside non-virtualized View::scrolls\{place} renders \{rows} live items (> \{limit}). " +
        "Fix: use View::list_reused or View::scrolls_reused for large scrollable lists.")
    }
  }
  for k in n.kids {
    count_scroll_each_in(tree, k, scroll_at, limit, out)
  }
}

///|
