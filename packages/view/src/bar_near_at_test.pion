import "signals"

// Tree::bar_near_at by `bar_cols` and Tree::drawn_one: nested, overlapping, hidden and pressless columns, and what
// bounds the input of one.

test "bar_near_at: nested and overlapping columns pick top drawn hit, skipping out and pressless" {
  let show_overlay = signals::signal(false)
  let overlay_presses = signals::signal(true)
  let outer_near = ref_new(false)
  let inner_near = ref_new(false)
  let overlay_near = ref_new(false)
  let t = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(300.0))).height(Is(Some(200.0)))
    // Base outer column (0..200, 0..200), bar_near=16 along x in [184, 200)
    let _ = root.box(fn(outer : View) {
      let _ = outer.width(Is(Some(200.0))).height(Is(Some(200.0)))
      outer.reacts(fn() { outer.bar_near(16.0) }, fn(v : Bool) { outer_near.v = v })
      // Nested inner column (0..120, 0..100), bar_near=16 along x in [104, 120)
      let _ = outer.box(fn(inner : View) {
        let _ = inner.width(Is(Some(120.0))).height(Is(Some(100.0)))
        inner.reacts(fn() { inner.bar_near(16.0) }, fn(v : Bool) { inner_near.v = v })
      })
    })
    // Overlapping upper column (0..200, 0..200) drawn after outer
    root.show(
      fn() { show_overlay.get() },
      fn(ov : View) {
        let _ = ov.over(Is(true), edges=(Some(0.0), None, None, Some(0.0)))
        let _ = ov.width(Is(Some(200.0))).height(Is(Some(200.0)))
        let _ = ov.presses(By(fn() { overlay_presses.get() }))
        ov.reacts(fn() { ov.bar_near(16.0) }, fn(v : Bool) { overlay_near.v = v })
      },
      at_once=true,
    )
  })
  let _ = t.frame(300.0, 200.0, now=10.0)
  // Near inner's right edge: inner wins over outer.
  t.point_at(112.0, 50.0)
  let _ = t.frame(300.0, 200.0, now=20.0)
  debug_assert(inner_near.v && !outer_near.v && !overlay_near.v, "nested inner column wins")
  // Inside inner but off its edge: neither.
  t.point_at(50.0, 50.0)
  let _ = t.frame(300.0, 200.0, now=30.0)
  debug_assert(!inner_near.v && !outer_near.v, "along no edge")
  // Near outer's right edge while overlay is out: outer.
  t.point_at(192.0, 50.0)
  let _ = t.frame(300.0, 200.0, now=40.0)
  debug_assert(outer_near.v && !inner_near.v && !overlay_near.v, "outer matches while overlay is out")
  // Overlapping upper column shown: it wins by draw order.
  show_overlay.set(true)
  let _ = t.frame(300.0, 200.0, now=50.0)
  debug_assert(overlay_near.v && !outer_near.v, "upper column wins by draw order")
  // Upper column pressless: falls through.
  overlay_presses.set(false)
  let _ = t.frame(300.0, 200.0, now=60.0)
  debug_assert(!overlay_near.v && outer_near.v, "pressless overlay is skipped")
  show_overlay.set(false)
  overlay_presses.set(true)
  let _ = t.frame(300.0, 200.0, now=70.0)
  debug_assert(!overlay_near.v && outer_near.v, "outer still matches")
  t.dispose()
}

test "bar_near_at: draw order, not registration order, picks among overlapping; none past what bounds input" {
  let lower_near = ref_new(false)
  let upper_near = ref_new(false)
  let cut_near = ref_new(false)
  let lower : signals::Ref[Option[View]] = ref_new(None)
  let t = Tree::new(fn(root : View) {
    let _ = root.width(Is(Some(400.0))).height(Is(Some(200.0)))
    let _ = root.box(fn(b : View) {
      let _ = b.over_at(Is((Some(0.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(100.0)))
      lower.v = Some(b)
    })
    let _ = root.box(fn(b : View) {
      let _ = b.over_at(Is((Some(0.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(100.0)))
      b.reacts(fn() { b.bar_near(16.0) }, fn(v : Bool) { upper_near.v = v })
    })
    // The lower one registered after the one over it.
    match lower.v {
      Some(b) => b.reacts(fn() { b.bar_near(16.0) }, fn(v : Bool) { lower_near.v = v })
      None => ()
    }
    // A column wider than what bounds it: its edge past the clip is found nowhere.
    let _ = root.box(fn(clip : View) {
      let _ = clip.over_at(Is((Some(200.0), Some(0.0), None, None))).width(Is(Some(60.0))).height(Is(Some(100.0)))
      let _ = clip.bounds_input(Is(true))
      let _ = clip.box(fn(b : View) {
        let _ = b.over_at(Is((Some(0.0), Some(0.0), None, None))).width(Is(Some(100.0))).height(Is(Some(100.0)))
        b.reacts(fn() { b.bar_near(50.0) }, fn(v : Bool) { cut_near.v = v })
      })
    })
  })
  let _ = t.frame(400.0, 200.0, now=0.0)
  t.point_at(92.0, 50.0)
  let _ = t.frame(400.0, 200.0, now=16.0)
  debug_assert(upper_near.v && !lower_near.v, "the last drawn wins, though registered first")
  t.point_at(255.0, 50.0)
  let _ = t.frame(400.0, 200.0, now=32.0)
  debug_assert(cut_near.v, "along its edge, inside what bounds it")
  t.point_at(290.0, 50.0)
  let _ = t.frame(400.0, 200.0, now=48.0)
  debug_assert(!cut_near.v, "along its edge, past what bounds it")
  t.dispose()
}
