// One layer of a node's shadows (View::shadows): CSS `box-shadow`'s, its offset (`dx`, `dy`), its blur as a Gaussian's
// sigma (CSS blur radius / 2), how far it spreads past the box before blurring (`spread`, negative shrinks it), its
// colour (rgba), and whether it is cast inside the box (`inset`; not yet drawn: the renderer says so and stops).

import "signals"

///|
#derive(Eq)
pub struct Shadow {
  pub dx : Double
  pub dy : Double
  pub sigma : Double
  pub spread : Double
  pub color : Int64
  pub inset : Bool
}

fn shadow_same(a : Shadow, b : Shadow) -> Bool {
  a.dx == b.dx && a.dy == b.dy && a.sigma == b.sigma && a.spread == b.spread && a.color == b.color && a.inset == b.inset
}

impl ViewEq for Shadow {
  fn eq(self : Shadow, other : Shadow) -> Bool {
    shadow_same(self, other)
  }
}

impl signals::Eq for Shadow {
  fn eq(self : Shadow, other : Shadow) -> Bool {
    shadow_same(self, other)
  }
}

///|
/// A drop shadow straight down: `sigma` its blur, `dy` how far down, `color` its rgba (no `dx`, no spread, outside).
pub fn Shadow::drop(sigma : Double, dy : Double, color : Int64) -> Shadow {
  Shadow::{ dx: 0.0, dy, sigma, spread: 0.0, color, inset: false }
}

///|
/// Any shadow layer, each part named (CSS `box-shadow: [inset] dx dy (2 * sigma) spread color`).
pub fn Shadow::of(
  dx~ : Double = 0.0,
  dy~ : Double = 0.0,
  sigma~ : Double = 0.0,
  spread~ : Double = 0.0,
  color : Int64,
  inset~ : Bool = false,
) -> Shadow {
  Shadow::{ dx, dy, sigma, spread, color, inset }
}

///|
/// Whether two layer lists are the same, layer by layer (every part of each).
pub fn shadows_same(a : Array[Shadow], b : Array[Shadow]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !shadow_same(a[i], b[i]) {
      return false
    }
    i += 1
  }
  true
}

///|
/// Validate that no shadow layer in `cs` requests unsupported `inset == true`, halting with caller `loc`.
pub fn check_shadows_supported(cs : Array[Shadow], loc : String) -> Unit {
  for sh in cs {
    if sh.inset {
      let at = if loc.length() > 0 { " at " + source_place(loc) } else { "" }
      halt::saying("View::shadows: inset Shadow is not yet supported" + at, "")
    }
  }
}
