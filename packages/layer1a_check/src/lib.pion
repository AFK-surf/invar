// Aggregate check package for Layer 1A (flex, pixels, paint, damage).

import "flex"
import "pixels"
import "paint"
import "damage"

fn mk_inst(x : Double, y : Double, w : Double, h : Double) -> FixedArray[Double] {
  let a = FixedArray::make(60, 0.0)
  a[0] = x
  a[1] = y
  a[2] = w
  a[3] = h
  a[8] = 1.0
  a[9] = 1.0
  a[10] = 1.0
  a[11] = 1.0
  a[18] = 1.0e9
  a[19] = 1.0e9
  a
}

pub fn layer1a_smoke() -> Bool {
  // 1. flex: compute a 2-child row layout
  let root = flex::Node::new()
  root.style.direction = flex::FlexDirection::Row
  root.style.set_width(flex::Dim::Pt(200.0))
  root.style.set_height(flex::Dim::Pt(40.0))
  root.style.set_gap_col(flex::Dim::Pt(10.0))
  let c0 = flex::Node::new()
  c0.style.set_width(flex::Dim::Pt(60.0))
  c0.style.set_height(flex::Dim::Pt(40.0))
  let c1 = flex::Node::new()
  c1.style.grow = 1.0
  c1.style.set_height(flex::Dim::Pt(40.0))
  root.add(c0)
  root.add(c1)
  flex::compute(root)
  let flex_ok = (c0.width - 60.0).abs() < 0.01 && (c1.width - 130.0).abs() < 0.01

  // 2. pixels: encode PNG -> sniff -> image_size -> decode_png
  let buf = pixels::Canvas::new(4, 4)
  buf.fill(paint::color_i64(0xFF80, 0x40FF))
  let png_bytes = pixels::png(4, 4, buf.pixels())
  let sniff_ok = pixels::is_png(png_bytes)
  let size_ok = match pixels::image_size(png_bytes) {
    Some((w, h)) => w == 4 && h == 4
    None => false
  }
  let dec_ok = match pixels::decode_png(png_bytes) {
    Some((w, h, rgba)) => w == 4 && h == 4 && rgba.length() == 64 && rgba[0].to_int() == 255
    None => false
  }

  // 3. paint: liquid glass + rect + smooth corner + linked CornerOf
  let g = paint::Glass::liquid()
  let r = paint::rect(c0.left, c0.top, c0.width, c0.height, color=paint::color_i64(0x1122, 0x33FF))
  let cr = paint::corner_radius(
    paint::CornerOf::Follow(paint::CornerOf::Window, 6.0, 20.0),
    paint::CornerRoots::{ window: 16.0, fit: None, zoom: 1.0 },
  )
  let paint_ok = g.liquid && (r.w - 60.0).abs() < 0.01 && (cr - 10.0).abs() < 1.0e-9

  // 4. damage: diff two frames
  let dmg = damage::Damage::new()
  let f1 = mk_inst(c0.left, c0.top, c0.width, c0.height)
  let f2 = mk_inst(c0.left + 10.0, c0.top, c0.width, c0.height)
  let d1 = dmg.next(f1, 1, 200.0, 40.0, 2.0, 1.0, 1.0, 1.0)
  let d2 = dmg.next(f2, 1, 200.0, 40.0, 2.0, 1.0, 1.0, 1.0)
  let damage_ok = d1.length() > 0 && d2.length() > 0

  flex_ok && sniff_ok && size_ok && dec_ok && paint_ok && damage_ok
}
