// Pion-JSX PascalCase thin shell for `packages/nav`.
// Follows the zero-magic Invar JSX protocol: first positional parameter is `parent : view::View`,
// returns `view::View`.

import "view"

/// Native parallax navigation stack JSX component (`<nav::NavStack controller={ctrl} render_page={...} />`).
pub fn NavStack[T](
  parent : view::View,
  controller~ : NavController[T],
  render_page~ : (view::View, NavEntry[T]) -> Unit,
  edge_swipe_back~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  nav_stack(parent, controller, render_page, edge_swipe_back=edge_swipe_back, loc=loc)
}
