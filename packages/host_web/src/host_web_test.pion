// Unit tests for `host_web` callback trampolines and `hostapi::Host` wiring.

struct KeyUpLog {
  mut count : Int
  mut last_code : Int
  mut last_mods : Int
}

test "set_key_up_handler wires web_cb_key_up trampoline" {
  let log = KeyUpLog::{ count: 0, last_code: 0, last_mods: 0 }
  set_key_up_handler(fn(code : Int, mods : Int) {
    log.count = log.count + 1
    log.last_code = code
    log.last_mods = mods
  })
  web_cb_key_up(1032, 3)
  debug_assert(log.count == 1, "key_up invoked once")
  debug_assert(log.last_code == 1032, "key_up code matches space (1032)")
  debug_assert(log.last_mods == 3, "key_up mods matches Shift|Ctrl (3)")
}

test "web_host populates desktop hostapi::Host platform and slots" {
  let h = web_host()
  debug_assert((h.platform)() == 4, "web platform is 4")
  debug_assert((h.keyboard)() == -1, "browser keyboard is -1")
  debug_assert(!(h.rows_on_pixels)(), "browser rows_on_pixels is false")
}
