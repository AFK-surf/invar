extern "C" fn mb_web_gamepads(out : Ptr, max_fields : Int) -> Int = "mb_web_gamepads"

// Images, URLs, perf metrics
extern "C" fn mb_web_image_load(src : Ptr, src_len : Int64, max_px : Int) -> Int = "mb_web_image_load"
extern "C" fn mb_web_image_load_bytes(data : Ptr, data_len : Int64, max_px : Int) -> Int = "mb_web_image_load_bytes"
extern "C" fn mb_web_image_info(id : Int, out : Ptr) -> Int = "mb_web_image_info"
extern "C" fn mb_web_image_free(id : Int) -> Unit = "mb_web_image_free"
extern "C" fn mb_web_image_pixels(id : Int, out : Ptr, out_len : Int) -> Int = "mb_web_image_pixels"
extern "C" fn mb_web_open_url(url : Ptr, url_len : Int64) -> Int = "mb_web_open_url"
extern "C" fn mb_web_gpu_ms() -> Double = "mb_web_gpu_ms"
extern "C" fn mb_web_mem_bytes() -> Double = "mb_web_mem_bytes"
extern "C" fn mb_web_frames_dropped() -> Int = "mb_web_frames_dropped"
extern "C" fn mb_web_cpu_ms() -> Double = "mb_web_cpu_ms"
extern "C" fn mb_web_perf_state() -> Int = "mb_web_perf_state"
extern "C" fn mb_web_set_perf(on : Int) -> Unit = "mb_web_set_perf"
extern "C" fn mb_web_perf_line(line : Ptr, line_len : Int64) -> Unit = "mb_web_perf_line"
extern "C" fn mb_web_perf_where() -> Ptr = "mb_web_perf_where"
extern "C" fn mb_web_perf_size() -> Double = "mb_web_perf_size"
extern "C" fn mb_web_perf_read() -> Ptr = "mb_web_perf_read"
extern "C" fn mb_web_perf_open(go : Int) -> Int = "mb_web_perf_open"

fn take_c_str(p : Ptr) -> String {
  let s = cstr_to_str(p)
  ptr_free(p)
  s
}

fn take_raw_bytes(p : Ptr) -> Bytes {
  let n = mb_web_last_bytes_len()
  if n <= 0 {
    return "".to_bytes()
  }
  let b = bytes_from_ptr(p, n)
  ptr_free(p)
  b
}

/// Builds a `hostapi::Host` backed by the browser WebGL2 `host.js` + `pion_host_bridge.mjs`.
pub fn web_host() -> hostapi::Host {
  let h = hostapi::Host::noop()
  h.platform = fn() -> Int { 4 }
  h.keys_platform = fn() -> Int { mb_web_keys_platform() }
  h.native_pointing = fn() -> Int { mb_web_native_pointing() }
  h.pointing = fn() -> Int { mb_web_native_pointing() }
  h.keyboard = fn() -> Int { -1 }
  h.rows_on_pixels = fn() -> Bool { false }
  h.wheel_kept = fn(kept : Bool) -> Unit { mb_web_wheel_kept(if kept { 1 } else { 0 }) }
  h.mods_held = fn() -> Int { mb_web_mods_held() }

  // Multi-window, fullscreen, title, appearance & app callbacks
  h.window_opens = fn() -> Bool { mb_web_windows(0, 0, str_data_ptr(""), 0L) != 0 }
  h.windows_in_process = fn() -> Bool { mb_web_windows(0, 0, str_data_ptr(""), 0L) != 0 }
  h.window_open_id = fn(what : String) -> Int { mb_web_windows(1, 0, str_data_ptr(what), what.length().to_int64()) }
  h.window_front_id = fn(wid : Int) -> Bool { mb_web_windows(2, wid, str_data_ptr(""), 0L) != 0 }
  h.window_close_id = fn(wid : Int) -> Unit { let _ = mb_web_windows(3, wid, str_data_ptr(""), 0L) }
  h.window_current = fn() -> Int { mb_web_windows(4, 0, str_data_ptr(""), 0L) }
  h.window_set_title = fn(wid : Int, title : String) -> Unit {
    mb_web_window_set_title(wid, str_data_ptr(title), title.length().to_int64())
  }
  h.window_inset = fn() -> Bool { mb_web_window_inset() != 0 }
  h.full_screen = fn() -> Bool { mb_web_full_screen() != 0 }
  h.set_full_screen = fn(on : Bool) -> Unit { mb_web_set_full_screen(if on { 1 } else { 0 }) }
  h.set_dark = fn(dark : Bool) -> Unit { mb_web_set_dark(if dark { 1 } else { 0 }) }
  h.set_badge = fn(n : Int) -> Unit { mb_web_set_badge(n) }
  h.app_said = fn(name : String) -> String {
    take_c_str(mb_web_app_said(str_data_ptr(name), name.length().to_int64()))
  }
  h.app_tell = fn(name : String, arg : String) -> Unit {
    mb_web_app_tell(str_data_ptr(name), name.length().to_int64(), str_data_ptr(arg), arg.length().to_int64())
  }
  h.set_site_name = fn(name : String) -> Unit {
    mb_web_set_site_name(str_data_ptr(name), name.length().to_int64())
  }
  h.font_scale = fn() -> Double { mb_web_font_scale() }
  h.a11y_on = fn() -> Bool { mb_web_a11y_on() != 0 }
  h.a11y_tree = fn(s : String) -> Unit {
    mb_web_a11y_tree(str_data_ptr(s), s.length().to_int64())
  }
  h.over_done = fn(open_app : Bool) -> Unit { mb_web_over_done(if open_app { 1 } else { 0 }) }
  h.update_apply = fn(said : String) -> Unit {
    mb_web_update_apply(str_data_ptr(said), said.length().to_int64())
  }
  h.install_package = fn(name : String, _data : Bytes) -> Unit {
    let ch = hostapi::system_channel
    let json = "{\"install\":{\"name\":" + hostapi::json_escape_string(name) + ",\"error\":\"unsupported\"}}"
    mb_web_post(str_data_ptr(ch), ch.length().to_int64(), str_data_ptr(json), json.length().to_int64())
  }
  h.drive = fn(kind : Int, _text : String) -> Bool { mb_web_drive(kind) != 0 }
  h.word_at = fn(text : String, off : Int) -> (Int, Int) {
    let v = mb_web_word_at(str_data_ptr(text), text.length().to_int64(), off)
    if v < 0.0 {
      return (-1, -1)
    }
    let k = 4294967296.0
    let s = (v / k).floor()
    (s.to_int(), (v - s * k).to_int())
  }

  // Event loop & clocks
  h.run = fn(
    title : String,
    frame : (Double, Double, Double, Double) -> Unit,
    pointer : (Int, Double, Double, Int) -> Unit,
    wheel : (Double, Double, Double, Double, Int) -> Unit,
    key : (Int, Int) -> Unit,
    text : (Int, String, Int, Int) -> Unit,
  ) -> Unit {
    cb_slots.frame = frame
    cb_slots.pointer = pointer
    cb_slots.wheel = wheel
    cb_slots.key = key
    cb_slots.text = text
    mb_web_run(str_data_ptr(title), title.length().to_int64())
  }
  h.now = fn() -> Double { mb_web_now() }
  h.wall_ms = fn() -> Double { mb_web_wall_ms() }
  h.clock_at_wall = fn(ms : Double) -> Double { ms - (mb_web_wall_ms() - mb_web_now()) }
  h.utc_offset_min = fn(ms : Double) -> Int { mb_web_utc_offset_min(ms) }
  h.event_time = fn() -> Double { mb_web_event_time() }
  h.request_frame = fn() -> Unit { mb_web_request_frame() }
  h.request_frame_on = fn() -> Unit { mb_web_request_frame() }
  h.wake_now = fn() -> Unit { mb_web_wake_now() }
  h.frames_paced = fn(hz : Double) -> Unit { mb_web_frames_paced(hz) }
  h.wake_after = fn(ms : Double) -> Unit { mb_web_wake_after(ms) }
  h.own_clock = fn() -> Bool { mb_web_own_clock() != 0 }

  // Text shaping & glyph atlas
  h.font_metrics = fn(size : Double, weight : Int, style : Int, out : Array[Double]) -> Unit {
    mb_web_font_metrics(size, weight, style, array_data_ptr(out))
  }
  h.shape = fn(text : String, size : Double, weight : Int, style : Int, out : Array[Double]) -> Int {
    mb_web_shape(
      str_data_ptr(text),
      text.length().to_int64(),
      size,
      weight,
      style,
      array_data_ptr(out),
      out.length(),
    )
  }
  h.text_key = fn(text : String, size : Double, weight : Int, style : Int) -> Int {
    mb_web_text_key(str_data_ptr(text), text.length().to_int64(), size, weight, style)
  }
  h.glyph = fn(key : Int, out : Array[Double]) -> Unit {
    mb_web_glyph(key, array_data_ptr(out))
  }
  h.glyph_put = fn(key : Int, x : Int, y : Int) -> Unit {
    mb_web_glyph_put(key, x, y)
  }
  h.glyphs_ahead = fn(keys : Array[Int], n : Int) -> Unit {
    let count = if n < keys.length() { n } else { keys.length() }
    if count > 0 {
      mb_web_glyphs_ahead(array_data_ptr(keys), count)
    }
  }
  h.atlas_size = fn(colour : Bool) -> Int {
    mb_web_atlas_size(if colour { 1 } else { 0 })
  }
  h.atlas_generation = fn() -> Int { mb_web_atlas_generation() }
  h.face_add = fn(face : Int, path : String, weight : Int) -> Bool {
    mb_web_face_add(face, str_data_ptr(path), path.length().to_int64(), weight) != 0
  }
  h.face_add_bytes = fn(face : Int, data : Bytes, weight : Int) -> Bool {
    mb_web_face_add_bytes(face, bytes_data_ptr(data), data.length().to_int64(), weight) != 0
  }
  h.face_clear = fn(face : Int) -> Unit { mb_web_face_clear(face) }

  // Presentation & WebGL2 glass
  h.present = fn(buf : Array[Double], count : Int, r : Double, g : Double, b : Double) -> Unit {
    mb_web_present(array_data_ptr(buf), count, r, g, b)
  }
  h.rn_dirty = fn(x : Double, y : Double, w : Double, h_px : Double) -> Unit {
    mb_web_dirty(x, y, w, h_px)
  }
  h.rn_glass_light_angle = fn(rad : Double) -> Unit {
    mb_web_glass_light_angle(rad)
  }
  h.layer_supported = fn() -> Bool { web_layer_supported() != 0 }
  h.layer_render = fn(id : Int, phys_w : Int, phys_h : Int, scale : Double, inst : Array[Double], count : Int) -> Bool {
    if count < 0 || (count > 0 && inst.length() < count * 60) {
      return false
    }
    let ptr = if count == 0 { ptr_null() } else { array_data_ptr(inst) }
    web_layer_render(id, phys_w, phys_h, scale, ptr, count) != 0
  }
  h.layer_destroy = fn(id : Int) -> Unit {
    web_layer_destroy(id)
  }

  // IME, text menu & clipboard
  h.set_ime = fn(
    active : Bool,
    x : Double,
    y : Double,
    w : Double,
    h_px : Double,
    text : String,
    sel_start : Int,
    sel_end : Int,
  ) -> Unit {
    mb_web_set_ime(
      if active { 1 } else { 0 },
      x,
      y,
      w,
      h_px,
      str_data_ptr(text),
      text.length().to_int64(),
      sel_start,
      sel_end,
    )
  }
  h.text_menu = fn(shown : Bool, x : Double, y : Double, w : Double, h_px : Double, can : Int) -> Unit {
    mb_web_text_menu(if shown { 1 } else { 0 }, x, y, w, h_px, can)
  }
  h.text_menu_own = fn(words : String) -> Unit {
    mb_web_text_menu_own(str_data_ptr(words), words.length().to_int64())
  }
  h.clipboard_set = fn(s : String) -> Unit {
    mb_web_clipboard_set(str_data_ptr(s), s.length().to_int64())
  }
  h.clipboard_set_secret = fn(s : String, _clear_ms : Double) -> Unit {
    mb_web_clipboard_set(str_data_ptr(s), s.length().to_int64())
  }
  h.clipboard_set_image = fn(data : Bytes) -> Unit {
    mb_web_cl_set(str_data_ptr(""), 0L, bytes_data_ptr(data), data.length().to_int64(), str_data_ptr(""), 0L)
  }
  h.cl_read = fn() -> Int { mb_web_cl_read() }
  h.cl_state = fn(id : Int) -> Int { mb_web_cl_state(id) }
  h.cl_picture = fn(id : Int) -> Int { mb_web_cl_picture(id) }
  h.cl_text = fn(id : Int) -> String { take_c_str(mb_web_cl_text(id)) }
  h.cl_png = fn(id : Int) -> Bytes { take_raw_bytes(mb_web_cl_png(id)) }
  h.cl_files = fn(id : Int) -> Int { mb_web_cl_files(id) }
  h.cl_file_name = fn(id : Int, i : Int) -> String { take_c_str(mb_web_cl_file_name(id, i)) }
  h.cl_file = fn(id : Int, i : Int) -> Bytes { take_raw_bytes(mb_web_cl_file(id, i)) }
  h.cl_end = fn(id : Int) -> Unit { mb_web_cl_end(id) }
  h.cl_set = fn(text : String, png : Bytes, label : String) -> Unit {
    mb_web_cl_set(
      str_data_ptr(text),
      text.length().to_int64(),
      bytes_data_ptr(png),
      png.length().to_int64(),
      str_data_ptr(label),
      label.length().to_int64(),
    )
  }

  // File picker, keep / download, save_file & share
  h.pk_start = fn(kind : Int) -> Int { mb_web_pk_start(kind) }
  h.pk_state = fn(id : Int) -> Int { mb_web_pk_state(id) }
  h.pk_count = fn(id : Int) -> Int { mb_web_pk_count(id) }
  h.pk_name = fn(id : Int, i : Int) -> String { take_c_str(mb_web_pk_name(id, i)) }
  h.pk_bytes = fn(id : Int, i : Int) -> Bytes { take_raw_bytes(mb_web_pk_bytes(id, i)) }
  h.pk_info = fn(id : Int, i : Int) -> String { take_c_str(mb_web_pk_info(id, i)) }
  h.pk_end = fn(id : Int) -> Unit { mb_web_pk_end(id) }

  h.kp_begin = fn(name : String, mime : String, way : Int) -> Int {
    mb_web_kp_begin(str_data_ptr(name), name.length().to_int64(), str_data_ptr(mime), mime.length().to_int64(), way)
  }
  h.kp_append = fn(id : Int, data : Bytes) -> Int {
    mb_web_kp_append(id, bytes_data_ptr(data), data.length().to_int64())
  }
  h.kp_finish = fn(id : Int) -> Unit { mb_web_kp_finish(id) }
  h.kp_state = fn(id : Int) -> Int { mb_web_kp_state(id) }
  h.kp_where = fn(id : Int) -> String { take_c_str(mb_web_kp_where(id)) }
  h.kp_end = fn(id : Int) -> Unit { mb_web_kp_end(id) }

  h.save_file = fn(name : String, data : Bytes) -> Bool {
    mb_web_save_file(str_data_ptr(name), name.length().to_int64(), bytes_data_ptr(data), data.length().to_int64()) != 0
  }
  h.share = fn(text : String, name : String, mime : String, data : Bytes) -> Bool {
    mb_web_share(
      str_data_ptr(text), text.length().to_int64(),
      str_data_ptr(name), name.length().to_int64(),
      str_data_ptr(mime), mime.length().to_int64(),
      bytes_data_ptr(data), data.length().to_int64(),
    ) != 0
  }
  h.shared_in = fn() -> String { take_c_str(mb_web_shared_in()) }
  h.shared_in_file = fn(i : Int) -> Bytes { take_raw_bytes(mb_web_shared_in_file(i)) }

  // Charset decoding (TextDecoder)
  h.cs_known = fn(charset : String) -> Int {
    mb_web_cs_known(str_data_ptr(charset), charset.length().to_int64())
  }
  h.cs_decode = fn(data : Bytes, charset : String) -> String {
    take_c_str(mb_web_cs_decode(bytes_data_ptr(data), data.length().to_int64(), str_data_ptr(charset), charset.length().to_int64()))
  }

  // WebAuthn / Passkeys
  h.wa_able = fn() -> Bool { mb_web_wa_able() != 0 }
  h.wa_get = fn(ask : String) -> Int {
    mb_web_wa_get(str_data_ptr(ask), ask.length().to_int64())
  }
  h.wa_out = fn(id : Int) -> String { take_c_str(mb_web_wa_out(id)) }
  h.wa_end = fn(id : Int) -> Unit { mb_web_wa_end(id) }

  // External posts (drag-and-drop, system events)
  h.post_take = fn() -> Int { mb_web_post_take() }
  h.post_next = fn() -> Option[(String, String, Bytes)] {
    let ch = take_c_str(mb_web_post_next())
    if ch.length() == 0 {
      return None
    }
    let json = take_c_str(mb_web_post_json())
    let bs = take_raw_bytes(mb_web_post_bytes())
    Some((ch, json, bs))
  }

  // Device, notifications, navigation
  h.dv_copy_shown = fn() -> Int { 0 }
  h.dv_keep_awake = fn(on : Int) -> Unit { mb_web_keep_awake(on) }
  h.dv_key_catch = fn(on : Int) -> Unit { mb_web_key_catch(on) }
  h.dv_ime_inset = fn() -> Double { mb_web_ime_inset() }
  h.dv_ime_action = fn(k : Int) -> Unit { mb_web_ime_action(k) }
  h.dv_haptic = fn(k : Int) -> Unit { mb_web_haptic(k) }
  h.nt_show = fn(ch : String, tag : String, title : String, body : String, opens : String) -> Unit {
    mb_web_nt_show(
      str_data_ptr(ch), ch.length().to_int64(),
      str_data_ptr(tag), tag.length().to_int64(),
      str_data_ptr(title), title.length().to_int64(),
      str_data_ptr(body), body.length().to_int64(),
      str_data_ptr(opens), opens.length().to_int64(),
    )
  }
  h.nt_cancel = fn(tag : String) -> Unit { mb_web_nt_cancel(str_data_ptr(tag), tag.length().to_int64()) }
  h.nt_state = fn(what : Int) -> Int { mb_web_nt_state(what) }
  h.nt_text = fn(what : Int) -> String { take_c_str(mb_web_nt_text(what)) }

  // Native views (iframe / video / canvas / site bridge)
  h.view_open = fn(kind : Int, arg : String) -> Int {
    mb_web_view_open(kind, str_data_ptr(arg), arg.length().to_int64())
  }
  h.view_place = fn(
    id : Int,
    x : Double, y : Double, w : Double, h_px : Double,
    cx0 : Double, cy0 : Double, cx1 : Double, cy1 : Double,
    r0 : Double, r1 : Double, r2 : Double, r3 : Double,
    shown : Bool,
  ) -> Unit {
    mb_web_view_place(id, x, y, w, h_px, cx0, cy0, cx1, cy1, r0, r1, r2, r3, if shown { 1 } else { 0 })
  }
  h.view_close = fn(id : Int) -> Unit { mb_web_view_close(id) }
  h.view_control = fn(id : Int, op : Int, value : Double) -> Unit { mb_web_view_control(id, op, value) }
  h.view_info = fn(id : Int, out : Array[Double]) -> Int { mb_web_view_info(id, array_data_ptr(out)) }
  h.view_read_next = fn(id : Int, out : Array[Double]) -> Int { mb_web_view_read_next(id, array_data_ptr(out)) }
  h.view_read_answer = fn(id : Int, req : Int, data : Bytes, total : Double, more : Bool) -> Unit {
    mb_web_view_read_answer(id, req, bytes_data_ptr(data), data.length().to_int64(), total, if more { 1 } else { 0 })
  }
  h.view_site_next = fn(id : Int) -> String { take_c_str(mb_web_view_site_next(id)) }
  h.view_site_body = fn(id : Int, req : Int) -> Bytes { take_raw_bytes(mb_web_view_site_body(id, req)) }
  h.view_site_head = fn(id : Int, req : Int, status : Int, headers : String) -> Unit {
    mb_web_view_site_head(id, req, status, str_data_ptr(headers), headers.length().to_int64())
  }
  h.view_site_chunk = fn(id : Int, req : Int, data : Bytes) -> Unit {
    mb_web_view_site_chunk(id, req, bytes_data_ptr(data), data.length().to_int64())
  }
  h.view_site_end = fn(id : Int, req : Int, err : String) -> Unit {
    mb_web_view_site_end(id, req, str_data_ptr(err), err.length().to_int64())
  }
  h.view_site_state = fn(id : Int) -> String { take_c_str(mb_web_view_site_state(id)) }
  h.view_site_load = fn(id : Int, path : String) -> Unit {
    mb_web_view_site_load(id, str_data_ptr(path), path.length().to_int64())
  }
  h.view_tell = fn(id : Int, what : Int, text : String) -> Unit {
    mb_web_view_tell(id, what, str_data_ptr(text), text.length().to_int64())
  }
  h.view_text = fn(id : Int, what : Int) -> Option[String] {
    let s = take_c_str(mb_web_view_text(id, what))
    if s.length() == 0 { None } else { Some(s) }
  }
  h.view_still = fn(id : Int) -> Bytes { take_raw_bytes(mb_web_view_still(id)) }

  // Streaming media (WebCodecs / MediaSource / WebAudio)
  h.st_open = fn() -> Int { mb_web_st_open() }
  h.st_h264 = fn(id : Int, avcc : Bytes, w : Int, h_px : Int) -> Unit {
    mb_web_st_h264(id, bytes_data_ptr(avcc), avcc.length().to_int64(), w, h_px)
  }
  h.st_hevc = fn(id : Int, hvcc : Bytes, w : Int, h_px : Int) -> Unit {
    mb_web_st_hevc(id, bytes_data_ptr(hvcc), hvcc.length().to_int64(), w, h_px)
  }
  h.st_av1 = fn(id : Int, av1c : Bytes, w : Int, h_px : Int) -> Unit {
    mb_web_st_av1(id, bytes_data_ptr(av1c), av1c.length().to_int64(), w, h_px)
  }
  h.st_frame = fn(id : Int, data : Bytes, key : Int, ts : Double) -> Unit {
    mb_web_st_frame(id, bytes_data_ptr(data), data.length().to_int64(), key, ts)
  }
  h.st_frame_shown = fn(id : Int, data : Bytes, key : Int, ts : Double, _show : Int) -> Int {
    mb_web_st_frame(id, bytes_data_ptr(data), data.length().to_int64(), key, ts)
    1
  }
  h.st_jpeg = fn(id : Int, data : Bytes, ts : Double) -> Unit {
    mb_web_st_jpeg(id, bytes_data_ptr(data), data.length().to_int64(), ts)
  }
  h.st_next = fn(id : Int) -> String { take_c_str(mb_web_st_next(id)) }
  h.st_show = fn(id : Int, ts : Double) -> Unit { mb_web_st_show(id, ts) }
  h.st_close = fn(id : Int) -> Unit { mb_web_st_close(id) }
  h.st_h264_here = fn() -> Int { mb_web_st_h264_here() }
  h.st_h265_here = fn() -> Int { mb_web_st_h265_here() }
  h.st_av1_here = fn() -> Int { mb_web_st_av1_here() }
  h.st_feeds = fn() -> Int { mb_web_st_feeds() }
  h.st_codec = fn(id : Int, cmd : String, data : Bytes) -> Unit {
    mb_web_st_codec(id, str_data_ptr(cmd), cmd.length().to_int64(), bytes_data_ptr(data), data.length().to_int64())
  }
  h.st_audio_here = fn() -> Int { mb_web_st_audio_here() }
  h.st_audio = fn(id : Int, data : Bytes) -> Unit {
    mb_web_st_audio(id, bytes_data_ptr(data), data.length().to_int64())
  }
  h.st_audio_played = fn(id : Int) -> Double { mb_web_st_audio_played(id) }
  h.st_audio_queued = fn(id : Int) -> Double { mb_web_st_audio_queued(id) }
  h.st_audio_wanted = fn(id : Int) -> Double { mb_web_st_audio_wanted(id) }
  h.st_audio_volume = fn(id : Int, vol : Double) -> Unit { mb_web_st_audio_volume(id, vol) }
  h.st_flush = fn(id : Int, drain : Int) -> Unit { mb_web_st_flush(id, drain) }
  h.st_layers = fn() -> Int { mb_web_st_layers() }
  h.st_pointer = fn(id : Int, png : Bytes, w : Double, h_px : Double, hx : Double, hy : Double) -> Unit {
    mb_web_st_pointer(id, bytes_data_ptr(png), png.length().to_int64(), w, h_px, hx, hy)
  }
  h.st_pointer_named = fn(id : Int, _k : String, png : () -> Bytes, w : Double, h_px : Double, hx : Double, hy : Double) -> Unit {
    let b = png()
    mb_web_st_pointer(id, bytes_data_ptr(b), b.length().to_int64(), w, h_px, hx, hy)
  }
  h.st_pointer_at = fn(id : Int, x : Double, y : Double, shown : Int) -> Unit {
    mb_web_st_pointer_at(id, x, y, shown)
  }
  h.st_direct = fn(id : Int, route : Double, after : Double, what : Int) -> Unit {
    mb_web_st_direct(id, route, after, what)
  }

  // Terminal bridge
  h.tm_open = fn(cols : Int, rows : Int) -> Int { mb_web_tm_open(cols, rows) }
  h.tm_write = fn(id : Int, data : Bytes) -> Unit {
    mb_web_tm_write(id, bytes_data_ptr(data), data.length().to_int64())
  }
  h.tm_resize = fn(id : Int, cols : Int, rows : Int, cw : Int, ch : Int) -> Unit {
    mb_web_tm_resize(id, cols, rows, cw, ch)
  }
  h.tm_frame = fn(id : Int, flags : Int) -> Bytes { take_raw_bytes(mb_web_tm_frame(id, flags)) }
  h.tm_modes = fn(id : Int) -> Int { mb_web_tm_modes(id) }
  h.tm_scroll = fn(id : Int, kind : Int, value : Int) -> Unit { mb_web_tm_scroll(id, kind, value) }
  h.tm_select = fn(id : Int, kind : Int, x0 : Int, y0 : Int, x1 : Int, y1 : Int) -> Int {
    mb_web_tm_select(id, kind, x0, y0, x1, y1)
  }
  h.tm_text = fn(id : Int, sel : Int) -> String { take_c_str(mb_web_tm_text(id, sel)) }
  h.tm_mouse = fn(
    id : Int, action : Int, button : Int, mods : Int,
    x : Int, y : Int, w : Int, h_px : Int, cw : Int, ch : Int,
  ) -> Bytes {
    take_raw_bytes(mb_web_tm_mouse(id, action, button, mods, x, y, w, h_px, cw, ch))
  }
  h.tm_close = fn(id : Int) -> Unit { mb_web_tm_close(id) }

  // Native bridge calls
  h.ncall_call = fn(name : String, params : String) -> Int {
    mb_web_ncall_call(str_data_ptr(name), name.length().to_int64(), str_data_ptr(params), params.length().to_int64())
  }
  h.ncall_state = fn(id : Int) -> Int { mb_web_ncall_state(id) }
  h.ncall_result = fn(id : Int) -> String { take_c_str(mb_web_ncall_result(id)) }
  h.ncall_end = fn(id : Int) -> Unit { mb_web_ncall_end(id) }

  // Pointer lock & gamepads
  h.pointer_lock = fn(on : Bool) -> Unit { mb_web_pointer_lock(if on { 1 } else { 0 }) }
  h.pointer_locked = fn() -> Bool { mb_web_pointer_locked() != 0 }
  h.pointer_delta = fn(out : Array[Double]) -> Unit { mb_web_pointer_delta(array_data_ptr(out)) }
  h.gamepads = fn(out : Array[Double]) -> Int { mb_web_gamepads(array_data_ptr(out), out.length()) }

  // Logging, environment, accessibility preferences, callbacks
  h.log = fn(s : String) -> Unit {
    mb_web_log(str_data_ptr(s), s.length().to_int64())
  }
  h.bench_mode = fn() -> Int { mb_web_bench_mode() }
  h.exit = fn(code : Int) -> Unit { mb_web_exit(code) }
  h.set_cursor = fn(kind : Int) -> Unit { mb_web_set_cursor(kind) }
  h.env = fn(name : String) -> String {
    take_c_str(mb_web_env(str_data_ptr(name), name.length().to_int64()))
  }
  h.system_dark = fn() -> Bool { mb_web_system_dark() != 0 }
  h.reduce_motion = fn() -> Bool { mb_web_reduce_motion() != 0 }
  h.reduce_transparency = fn() -> Bool { mb_web_reduce_transparency() != 0 }
  h.increase_contrast = fn() -> Bool { mb_web_increase_contrast() != 0 }
  h.frame_awaiting = fn(n : Int, what : String) -> Unit {
    mb_web_frame_awaiting(n, str_data_ptr(what), what.length().to_int64())
  }
  h.set_outside = fn(f : (Int, Int, Int) -> Unit) -> Bool {
    cb_slots.outside = f
    mb_web_set_outside() != 0
  }
  h.set_back = fn(f : (Int, Double, Double, Int) -> Unit) -> Unit {
    cb_slots.back = f
    mb_web_set_back()
  }
  h.back_enabled = fn(on : Bool) -> Unit { mb_web_back_enabled(if on { 1 } else { 0 }) }
  h.set_app_state = fn(f : (Int) -> Unit) -> Unit {
    cb_slots.app_state = f
    mb_web_set_app_state()
  }

  // Images, URLs & performance metrics
  h.image_load = fn(src : String, max_px : Int) -> Int {
    mb_web_image_load(str_data_ptr(src), src.length().to_int64(), max_px)
  }
  h.image_load_bytes = fn(data : Bytes, max_px : Int) -> Int {
    mb_web_image_load_bytes(bytes_data_ptr(data), data.length().to_int64(), max_px)
  }
  h.image_info = fn(id : Int, out : Array[Double]) -> Int {
    mb_web_image_info(id, array_data_ptr(out))
  }
  h.image_free = fn(id : Int) -> Unit { mb_web_image_free(id) }
  h.image_pixels = fn(id : Int, out : Array[Byte]) -> Bool {
    mb_web_image_pixels(id, array_data_ptr(out), out.length()) != 0
  }
  h.open_url = fn(url : String) -> Bool {
    mb_web_open_url(str_data_ptr(url), url.length().to_int64()) != 0
  }
  h.open_tab = fn(url : String) -> Bool {
    mb_web_open_url(str_data_ptr(url), url.length().to_int64()) != 0
  }
  h.gpu_ms = fn() -> Double { mb_web_gpu_ms() }
  h.mem_bytes = fn() -> Double { mb_web_mem_bytes() }
  h.frames_dropped = fn() -> Int { mb_web_frames_dropped() }
  h.cpu_ms = fn() -> Double { mb_web_cpu_ms() }
  h.thread_cpu_ms = fn() -> Double { mb_web_cpu_ms() }
  h.perf_state = fn() -> Int { mb_web_perf_state() }
  h.set_perf = fn(on : Bool) -> Unit { mb_web_set_perf(if on { 1 } else { 0 }) }
  h.perf_line = fn(line : String) -> Unit {
    mb_web_perf_line(str_data_ptr(line), line.length().to_int64())
  }
  h.perf_where = fn() -> String { take_c_str(mb_web_perf_where()) }
  h.perf_size = fn() -> Double { mb_web_perf_size() }
  h.perf_read = fn() -> Bytes { take_raw_bytes(mb_web_perf_read()) }
  h.perf_open = fn(go : Bool) -> Bool { mb_web_perf_open(if go { 1 } else { 0 }) != 0 }
  h
}

/// Installs the browser WebGL2 host into `hostapi` as the active global host.
pub fn install() -> Unit {
  hostapi::set_host(web_host())
}
