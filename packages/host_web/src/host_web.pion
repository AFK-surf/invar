// Browser WebGL2 / WebAssembly host implementation for `hostapi::Host`.
// Bridges `hostapi::Host` calls to `web/pion_host_bridge.mjs` (`pion_rt.mb_web_*`) and `web/host.js` (`globalThis.__mbhost`),
// and exports C-ABI callbacks (`web_frame`, `web_pointer`, `web_wheel`, `web_key`, `web_key_up`, `web_text`, `web_outside`, `web_back`, `web_app_state`)
// so `host.js` and `pion_host_bridge.mjs` drive every frame and desktop input event directly into Wasm.

import "hostapi"

struct WebCbSlots {
  mut frame : (Double, Double, Double, Double) -> Unit
  mut pointer : (Int, Double, Double, Int) -> Unit
  mut wheel : (Double, Double, Double, Double, Int) -> Unit
  mut key : (Int, Int) -> Unit
  mut key_up : (Int, Int) -> Unit
  mut text : (Int, String, Int, Int) -> Unit
  mut outside : (Int, Int, Int) -> Unit
  mut back : (Int, Double, Double, Int) -> Unit
  mut app_state : (Int) -> Unit
}

let cb_slots : WebCbSlots = WebCbSlots::{
  frame: fn(_w : Double, _h : Double, _s : Double, _t : Double) -> Unit { () },
  pointer: fn(_k : Int, _x : Double, _y : Double, _b : Int) -> Unit { () },
  wheel: fn(_x : Double, _y : Double, _dx : Double, _dy : Double, _p : Int) -> Unit { () },
  key: fn(_k : Int, _m : Int) -> Unit { () },
  key_up: fn(_k : Int, _m : Int) -> Unit { () },
  text: fn(_k : Int, _s : String, _a : Int, _b : Int) -> Unit { () },
  outside: fn(_k : Int, _id : Int, _st : Int) -> Unit { () },
  back: fn(_k : Int, _x : Double, _p : Double, _e : Int) -> Unit { () },
  app_state: fn(_st : Int) -> Unit { () },
}

/// Register a callback invoked on browser `keyup` events (`code`, `mods`).
pub fn set_key_up_handler(f : (Int, Int) -> Unit) -> Unit {
  cb_slots.key_up = f
}

/// Returns the live browser keyboard modifier bitmask (Shift=1, Ctrl=2, Alt=4, Meta=8).
pub fn web_mods_held() -> Int {
  mb_web_mods_held()
}

// ---- Exported Wasm callbacks invoked by `web/pion_host_bridge.mjs` ----

extern "C" fn web_cb_frame(w : Double, h : Double, scale : Double, now : Double) -> Unit = "web_frame" {
  (cb_slots.frame)(w, h, scale, now)
}

extern "C" fn web_cb_pointer(kind : Int, x : Double, y : Double, btn : Int) -> Unit = "web_pointer" {
  (cb_slots.pointer)(kind, x, y, btn)
}

extern "C" fn web_cb_wheel(x : Double, y : Double, dx : Double, dy : Double, phase : Int) -> Unit = "web_wheel" {
  (cb_slots.wheel)(x, y, dx, dy, phase)
}

extern "C" fn web_cb_key(code : Int, mods : Int) -> Unit = "web_key" {
  (cb_slots.key)(code, mods)
}

extern "C" fn web_cb_key_up(code : Int, mods : Int) -> Unit = "web_key_up" {
  (cb_slots.key_up)(code, mods)
}

extern "C" fn web_cb_text(kind : Int, cstr : Ptr, a : Int, b : Int) -> Unit = "web_text" {
  (cb_slots.text)(kind, cstr_to_str(cstr), a, b)
}

extern "C" fn web_cb_outside(kind : Int, id : Int, st : Int) -> Unit = "web_outside" {
  (cb_slots.outside)(kind, id, st)
}

extern "C" fn web_cb_back(kind : Int, x : Double, p : Double, e : Int) -> Unit = "web_back" {
  (cb_slots.back)(kind, x, p, e)
}

extern "C" fn web_cb_app_state(st : Int) -> Unit = "web_app_state" {
  (cb_slots.app_state)(st)
}

