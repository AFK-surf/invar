// Browser WebGL2 / WebAssembly host implementation for `hostapi::Host`.
// Bridges `hostapi::Host` calls to `web/pion_host_bridge.mjs` (`pion_rt.mb_web_*`) and `web/host.js` (`globalThis.__mbhost`),
// and exports C-ABI callbacks (`web_frame`, `web_pointer`, `web_wheel`, `web_key`, `web_text`, `web_outside`, `web_back`, `web_app_state`)
// so `host.js` drives every animation frame and input event directly into Wasm.

import "hostapi"

struct WebCbSlots {
  mut frame : (Double, Double, Double, Double) -> Unit
  mut pointer : (Int, Double, Double, Int) -> Unit
  mut wheel : (Double, Double, Double, Double, Int) -> Unit
  mut key : (Int, Int) -> Unit
  mut text : (Int, String, Int, Int) -> Unit
  mut outside : (Int, Int, Int) -> Unit
  mut back : (Int, Double, Double, Int) -> Unit
  mut app_state : (Int) -> Unit
}

let cb_slots : WebCbSlots = WebCbSlots::{
  frame: fn(_w : Double, _h : Double, _s : Double, _t : Double) -> Unit { () },
  pointer: fn(_k : Int, _x : Double, _y : Double, _b : Int) -> Unit { () },
  wheel: fn(_x : Double, _y : Double, _dx : Double, _dy : Double, _p : Int) -> Unit { () },
  key: fn(_k : Int, _m : Int) -> Unit { () },
  text: fn(_k : Int, _s : String, _a : Int, _b : Int) -> Unit { () },
  outside: fn(_k : Int, _id : Int, _st : Int) -> Unit { () },
  back: fn(_k : Int, _x : Double, _p : Double, _e : Int) -> Unit { () },
  app_state: fn(_st : Int) -> Unit { () },
}

// ---- Exported Wasm callbacks invoked by `web/pion_host_bridge.mjs` ----

extern "C" fn web_cb_frame(w : Double, h : Double, scale : Double, now : Double) -> Unit = "web_frame" {
  (cb_slots.frame)(w, h, scale, now)
}

extern "C" fn web_cb_pointer(kind : Int, x : Double, y : Double, btn : Int) -> Unit = "web_pointer" {
  (cb_slots.pointer)(kind, x, y, btn)
}

extern "C" fn web_cb_wheel(x : Double, y : Double, dx : Double, dy : Double, phase : Int) -> Unit = "web_wheel" {
  (cb_slots.wheel)(x, y, dx, dy, phase)
}

extern "C" fn web_cb_key(code : Int, mods : Int) -> Unit = "web_key" {
  (cb_slots.key)(code, mods)
}

extern "C" fn web_cb_text(kind : Int, cstr : Ptr, a : Int, b : Int) -> Unit = "web_text" {
  (cb_slots.text)(kind, cstr_to_str(cstr), a, b)
}

extern "C" fn web_cb_outside(kind : Int, id : Int, st : Int) -> Unit = "web_outside" {
  (cb_slots.outside)(kind, id, st)
}

extern "C" fn web_cb_back(kind : Int, x : Double, p : Double, e : Int) -> Unit = "web_back" {
  (cb_slots.back)(kind, x, p, e)
}

extern "C" fn web_cb_app_state(st : Int) -> Unit = "web_app_state" {
  (cb_slots.app_state)(st)
}

// ---- Imported browser host bridge functions (`pion_rt.mb_web_*`) ----

extern "C" fn mb_web_run(title : Ptr, title_len : Int64) -> Unit = "mb_web_run"
extern "C" fn mb_web_now() -> Double = "mb_web_now"
extern "C" fn mb_web_wall_ms() -> Double = "mb_web_wall_ms"
extern "C" fn mb_web_utc_offset_min(ms : Double) -> Int = "mb_web_utc_offset_min"
extern "C" fn mb_web_event_time() -> Double = "mb_web_event_time"
extern "C" fn mb_web_request_frame() -> Unit = "mb_web_request_frame"
extern "C" fn mb_web_frames_paced(hz : Double) -> Unit = "mb_web_frames_paced"
extern "C" fn mb_web_wake_after(ms : Double) -> Unit = "mb_web_wake_after"
extern "C" fn mb_web_own_clock() -> Int = "mb_web_own_clock"

extern "C" fn mb_web_font_metrics(size : Double, weight : Int, style : Int, out : Ptr) -> Unit = "mb_web_font_metrics"
extern "C" fn mb_web_shape(
  text : Ptr,
  text_len : Int64,
  size : Double,
  weight : Int,
  style : Int,
  out : Ptr,
  out_len : Int,
) -> Int = "mb_web_shape"
extern "C" fn mb_web_text_key(
  text : Ptr,
  text_len : Int64,
  size : Double,
  weight : Int,
  style : Int,
) -> Int = "mb_web_text_key"
extern "C" fn mb_web_glyph(key : Int, out : Ptr) -> Unit = "mb_web_glyph"
extern "C" fn mb_web_glyph_put(key : Int, x : Int, y : Int) -> Unit = "mb_web_glyph_put"
extern "C" fn mb_web_atlas_size(colour : Int) -> Int = "mb_web_atlas_size"
extern "C" fn mb_web_atlas_generation() -> Int = "mb_web_atlas_generation"
extern "C" fn mb_web_face_add(face : Int, path : Ptr, path_len : Int64, weight : Int) -> Int = "mb_web_face_add"
extern "C" fn mb_web_face_add_bytes(face : Int, data : Ptr, data_len : Int64, weight : Int) -> Int = "mb_web_face_add_bytes"
extern "C" fn mb_web_face_clear(face : Int) -> Unit = "mb_web_face_clear"

extern "C" fn mb_web_present(buf : Ptr, count : Int, r : Double, g : Double, b : Double) -> Unit = "mb_web_present"
extern "C" fn mb_web_dirty(x : Double, y : Double, w : Double, h : Double) -> Unit = "mb_web_dirty"
extern "C" fn mb_web_glass_light_angle(rad : Double) -> Unit = "mb_web_glass_light_angle"

extern "C" fn mb_web_set_ime(
  active : Int,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  text : Ptr,
  text_len : Int64,
  sel_start : Int,
  sel_end : Int,
) -> Unit = "mb_web_set_ime"
extern "C" fn mb_web_clipboard_set(s : Ptr, s_len : Int64) -> Unit = "mb_web_clipboard_set"
extern "C" fn mb_web_log(s : Ptr, s_len : Int64) -> Unit = "mb_web_log"
extern "C" fn mb_web_set_cursor(kind : Int) -> Unit = "mb_web_set_cursor"
extern "C" fn mb_web_env(name : Ptr, name_len : Int64) -> Ptr = "mb_web_env"
extern "C" fn mb_web_system_dark() -> Int = "mb_web_system_dark"
extern "C" fn mb_web_reduce_motion() -> Int = "mb_web_reduce_motion"
extern "C" fn mb_web_reduce_transparency() -> Int = "mb_web_reduce_transparency"
extern "C" fn mb_web_keys_platform() -> Int = "mb_web_keys_platform"
extern "C" fn mb_web_native_pointing() -> Int = "mb_web_native_pointing"
extern "C" fn mb_web_frame_awaiting(n : Int, what : Ptr, what_len : Int64) -> Unit = "mb_web_frame_awaiting"
extern "C" fn mb_web_set_outside() -> Int = "mb_web_set_outside"
extern "C" fn mb_web_set_app_state() -> Unit = "mb_web_set_app_state"

extern "C" fn mb_web_image_load(src : Ptr, src_len : Int64, max_px : Int) -> Int = "mb_web_image_load"
extern "C" fn mb_web_image_load_bytes(data : Ptr, data_len : Int64, max_px : Int) -> Int = "mb_web_image_load_bytes"
extern "C" fn mb_web_image_info(id : Int, out : Ptr) -> Int = "mb_web_image_info"
extern "C" fn mb_web_image_free(id : Int) -> Unit = "mb_web_image_free"
extern "C" fn mb_web_open_url(url : Ptr, url_len : Int64) -> Int = "mb_web_open_url"
extern "C" fn mb_web_gpu_ms() -> Double = "mb_web_gpu_ms"
extern "C" fn mb_web_mem_bytes() -> Double = "mb_web_mem_bytes"

fn take_c_str(p : Ptr) -> String {
  let s = cstr_to_str(p)
  ptr_free(p)
  s
}

/// Builds a `hostapi::Host` backed by the browser WebGL2 `host.js` + `pion_host_bridge.mjs`.
pub fn web_host() -> hostapi::Host {
  let h = hostapi::Host::noop()
  h.platform = fn() -> Int { 4 }
  h.keys_platform = fn() -> Int { mb_web_keys_platform() }
  h.native_pointing = fn() -> Int { mb_web_native_pointing() }
  h.keyboard = fn() -> Int { -1 }
  h.rows_on_pixels = fn() -> Bool { false }
  h.run = fn(
    title : String,
    frame : (Double, Double, Double, Double) -> Unit,
    pointer : (Int, Double, Double, Int) -> Unit,
    wheel : (Double, Double, Double, Double, Int) -> Unit,
    key : (Int, Int) -> Unit,
    text : (Int, String, Int, Int) -> Unit,
  ) -> Unit {
    cb_slots.frame = frame
    cb_slots.pointer = pointer
    cb_slots.wheel = wheel
    cb_slots.key = key
    cb_slots.text = text
    mb_web_run(str_data_ptr(title), title.length().to_int64())
  }
  h.now = fn() -> Double { mb_web_now() }
  h.wall_ms = fn() -> Double { mb_web_wall_ms() }
  h.utc_offset_min = fn(ms : Double) -> Int { mb_web_utc_offset_min(ms) }
  h.event_time = fn() -> Double { mb_web_event_time() }
  h.request_frame = fn() -> Unit { mb_web_request_frame() }
  h.frames_paced = fn(hz : Double) -> Unit { mb_web_frames_paced(hz) }
  h.wake_after = fn(ms : Double) -> Unit { mb_web_wake_after(ms) }
  h.own_clock = fn() -> Bool { mb_web_own_clock() != 0 }

  h.font_metrics = fn(size : Double, weight : Int, style : Int, out : Array[Double]) -> Unit {
    mb_web_font_metrics(size, weight, style, array_data_ptr(out))
  }
  h.shape = fn(text : String, size : Double, weight : Int, style : Int, out : Array[Double]) -> Int {
    mb_web_shape(
      str_data_ptr(text),
      text.length().to_int64(),
      size,
      weight,
      style,
      array_data_ptr(out),
      out.length(),
    )
  }
  h.text_key = fn(text : String, size : Double, weight : Int, style : Int) -> Int {
    mb_web_text_key(str_data_ptr(text), text.length().to_int64(), size, weight, style)
  }
  h.glyph = fn(key : Int, out : Array[Double]) -> Unit {
    mb_web_glyph(key, array_data_ptr(out))
  }
  h.glyph_put = fn(key : Int, x : Int, y : Int) -> Unit {
    mb_web_glyph_put(key, x, y)
  }
  h.atlas_size = fn(colour : Bool) -> Int {
    mb_web_atlas_size(if colour { 1 } else { 0 })
  }
  h.atlas_generation = fn() -> Int { mb_web_atlas_generation() }
  h.face_add = fn(face : Int, path : String, weight : Int) -> Bool {
    mb_web_face_add(face, str_data_ptr(path), path.length().to_int64(), weight) != 0
  }
  h.face_add_bytes = fn(face : Int, data : Bytes, weight : Int) -> Bool {
    mb_web_face_add_bytes(face, bytes_data_ptr(data), data.length().to_int64(), weight) != 0
  }
  h.face_clear = fn(face : Int) -> Unit { mb_web_face_clear(face) }

  h.present = fn(buf : Array[Double], count : Int, r : Double, g : Double, b : Double) -> Unit {
    mb_web_present(array_data_ptr(buf), count, r, g, b)
  }
  h.rn_dirty = fn(x : Double, y : Double, w : Double, h_px : Double) -> Unit {
    mb_web_dirty(x, y, w, h_px)
  }
  h.rn_glass_light_angle = fn(rad : Double) -> Unit {
    mb_web_glass_light_angle(rad)
  }

  h.set_ime = fn(
    active : Bool,
    x : Double,
    y : Double,
    w : Double,
    h_px : Double,
    text : String,
    sel_start : Int,
    sel_end : Int,
  ) -> Unit {
    mb_web_set_ime(
      if active { 1 } else { 0 },
      x,
      y,
      w,
      h_px,
      str_data_ptr(text),
      text.length().to_int64(),
      sel_start,
      sel_end,
    )
  }
  h.clipboard_set = fn(s : String) -> Unit {
    mb_web_clipboard_set(str_data_ptr(s), s.length().to_int64())
  }
  h.log = fn(s : String) -> Unit {
    mb_web_log(str_data_ptr(s), s.length().to_int64())
  }
  h.set_cursor = fn(kind : Int) -> Unit { mb_web_set_cursor(kind) }
  h.env = fn(name : String) -> String {
    take_c_str(mb_web_env(str_data_ptr(name), name.length().to_int64()))
  }
  h.system_dark = fn() -> Bool { mb_web_system_dark() != 0 }
  h.reduce_motion = fn() -> Bool { mb_web_reduce_motion() != 0 }
  h.reduce_transparency = fn() -> Bool { mb_web_reduce_transparency() != 0 }
  h.frame_awaiting = fn(n : Int, what : String) -> Unit {
    mb_web_frame_awaiting(n, str_data_ptr(what), what.length().to_int64())
  }
  h.set_outside = fn(f : (Int, Int, Int) -> Unit) -> Bool {
    cb_slots.outside = f
    mb_web_set_outside() != 0
  }
  h.set_app_state = fn(f : (Int) -> Unit) -> Unit {
    cb_slots.app_state = f
    mb_web_set_app_state()
  }

  h.image_load = fn(src : String, max_px : Int) -> Int {
    mb_web_image_load(str_data_ptr(src), src.length().to_int64(), max_px)
  }
  h.image_load_bytes = fn(data : Bytes, max_px : Int) -> Int {
    mb_web_image_load_bytes(bytes_data_ptr(data), data.length().to_int64(), max_px)
  }
  h.image_info = fn(id : Int, out : Array[Double]) -> Int {
    mb_web_image_info(id, array_data_ptr(out))
  }
  h.image_free = fn(id : Int) -> Unit { mb_web_image_free(id) }
  h.open_url = fn(url : String) -> Bool {
    mb_web_open_url(str_data_ptr(url), url.length().to_int64()) != 0
  }
  h.gpu_ms = fn() -> Double { mb_web_gpu_ms() }
  h.mem_bytes = fn() -> Double { mb_web_mem_bytes() }
  h
}

/// Installs the browser WebGL2 host into `hostapi` as the active global host.
pub fn install() -> Unit {
  hostapi::set_host(web_host())
}
