fn take_c_str(p : Ptr) -> String {
  let s = cstr_to_str(p)
  ptr_free(p)
  s
}

fn take_raw_bytes(p : Ptr) -> Bytes {
  let n = mb_web_last_bytes_len()
  if n <= 0 {
    return "".to_bytes()
  }
  let b = bytes_from_ptr(p, n)
  ptr_free(p)
  b
}

/// Builds a `hostapi::Host` backed by the browser WebGL2 `host.js` + `pion_host_bridge.mjs`.
pub fn web_host() -> hostapi::Host {
  let h = hostapi::Host::noop()
  h.platform = fn() -> Int { 4 }
  h.keys_platform = fn() -> Int { mb_web_keys_platform() }
  h.native_pointing = fn() -> Int { mb_web_native_pointing() }
  h.keyboard = fn() -> Int { -1 }
  h.rows_on_pixels = fn() -> Bool { false }
  h.wheel_kept = fn(kept : Bool) -> Unit { mb_web_wheel_kept(if kept { 1 } else { 0 }) }
  h.mods_held = fn() -> Int { mb_web_mods_held() }

  // Multi-window & title
  h.windows_in_process = fn() -> Bool { mb_web_windows(0, 0, str_data_ptr(""), 0L) != 0 }
  h.window_open_id = fn(what : String) -> Int { mb_web_windows(1, 0, str_data_ptr(what), what.length().to_int64()) }
  h.window_front_id = fn(wid : Int) -> Bool { mb_web_windows(2, wid, str_data_ptr(""), 0L) != 0 }
  h.window_close_id = fn(wid : Int) -> Unit { let _ = mb_web_windows(3, wid, str_data_ptr(""), 0L) }
  h.window_current = fn() -> Int { mb_web_windows(4, 0, str_data_ptr(""), 0L) }
  h.window_set_title = fn(wid : Int, title : String) -> Unit {
    mb_web_window_set_title(wid, str_data_ptr(title), title.length().to_int64())
  }

  h.run = fn(
    title : String,
    frame : (Double, Double, Double, Double) -> Unit,
    pointer : (Int, Double, Double, Int) -> Unit,
    wheel : (Double, Double, Double, Double, Int) -> Unit,
    key : (Int, Int) -> Unit,
    text : (Int, String, Int, Int) -> Unit,
  ) -> Unit {
    cb_slots.frame = frame
    cb_slots.pointer = pointer
    cb_slots.wheel = wheel
    cb_slots.key = key
    cb_slots.text = text
    mb_web_run(str_data_ptr(title), title.length().to_int64())
  }
  h.now = fn() -> Double { mb_web_now() }
  h.wall_ms = fn() -> Double { mb_web_wall_ms() }
  h.utc_offset_min = fn(ms : Double) -> Int { mb_web_utc_offset_min(ms) }
  h.event_time = fn() -> Double { mb_web_event_time() }
  h.request_frame = fn() -> Unit { mb_web_request_frame() }
  h.wake_now = fn() -> Unit { mb_web_wake_now() }
  h.frames_paced = fn(hz : Double) -> Unit { mb_web_frames_paced(hz) }
  h.wake_after = fn(ms : Double) -> Unit { mb_web_wake_after(ms) }
  h.own_clock = fn() -> Bool { mb_web_own_clock() != 0 }

  // Text shaping & glyph atlas
  h.font_metrics = fn(size : Double, weight : Int, style : Int, out : Array[Double]) -> Unit {
    mb_web_font_metrics(size, weight, style, array_data_ptr(out))
  }
  h.shape = fn(text : String, size : Double, weight : Int, style : Int, out : Array[Double]) -> Int {
    mb_web_shape(
      str_data_ptr(text),
      text.length().to_int64(),
      size,
      weight,
      style,
      array_data_ptr(out),
      out.length(),
    )
  }
  h.text_key = fn(text : String, size : Double, weight : Int, style : Int) -> Int {
    mb_web_text_key(str_data_ptr(text), text.length().to_int64(), size, weight, style)
  }
  h.glyph = fn(key : Int, out : Array[Double]) -> Unit {
    mb_web_glyph(key, array_data_ptr(out))
  }
  h.glyph_put = fn(key : Int, x : Int, y : Int) -> Unit {
    mb_web_glyph_put(key, x, y)
  }
  h.atlas_size = fn(colour : Bool) -> Int {
    mb_web_atlas_size(if colour { 1 } else { 0 })
  }
  h.atlas_generation = fn() -> Int { mb_web_atlas_generation() }
  h.face_add = fn(face : Int, path : String, weight : Int) -> Bool {
    mb_web_face_add(face, str_data_ptr(path), path.length().to_int64(), weight) != 0
  }
  h.face_add_bytes = fn(face : Int, data : Bytes, weight : Int) -> Bool {
    mb_web_face_add_bytes(face, bytes_data_ptr(data), data.length().to_int64(), weight) != 0
  }
  h.face_clear = fn(face : Int) -> Unit { mb_web_face_clear(face) }

  // Presentation & WebGL2 glass
  h.present = fn(buf : Array[Double], count : Int, r : Double, g : Double, b : Double) -> Unit {
    mb_web_present(array_data_ptr(buf), count, r, g, b)
  }
  h.rn_dirty = fn(x : Double, y : Double, w : Double, h_px : Double) -> Unit {
    mb_web_dirty(x, y, w, h_px)
  }
  h.rn_glass_light_angle = fn(rad : Double) -> Unit {
    mb_web_glass_light_angle(rad)
  }

  // IME, text menu & clipboard
  h.set_ime = fn(
    active : Bool,
    x : Double,
    y : Double,
    w : Double,
    h_px : Double,
    text : String,
    sel_start : Int,
    sel_end : Int,
  ) -> Unit {
    mb_web_set_ime(
      if active { 1 } else { 0 },
      x,
      y,
      w,
      h_px,
      str_data_ptr(text),
      text.length().to_int64(),
      sel_start,
      sel_end,
    )
  }
  h.text_menu = fn(shown : Bool, x : Double, y : Double, w : Double, h_px : Double, can : Int) -> Unit {
    mb_web_text_menu(if shown { 1 } else { 0 }, x, y, w, h_px, can)
  }
  h.text_menu_own = fn(words : String) -> Unit {
    mb_web_text_menu_own(str_data_ptr(words), words.length().to_int64())
  }
  h.clipboard_set = fn(s : String) -> Unit {
    mb_web_clipboard_set(str_data_ptr(s), s.length().to_int64())
  }
  h.clipboard_set_secret = fn(s : String, _clear_ms : Double) -> Unit {
    mb_web_clipboard_set(str_data_ptr(s), s.length().to_int64())
  }
  h.clipboard_set_image = fn(data : Bytes) -> Unit {
    mb_web_cl_set(str_data_ptr(""), 0L, bytes_data_ptr(data), data.length().to_int64(), str_data_ptr(""), 0L)
  }
  h.cl_read = fn() -> Int { mb_web_cl_read() }
  h.cl_state = fn(id : Int) -> Int { mb_web_cl_state(id) }
  h.cl_picture = fn(id : Int) -> Int { mb_web_cl_picture(id) }
  h.cl_text = fn(id : Int) -> String { take_c_str(mb_web_cl_text(id)) }
  h.cl_png = fn(id : Int) -> Bytes { take_raw_bytes(mb_web_cl_png(id)) }
  h.cl_files = fn(id : Int) -> Int { mb_web_cl_files(id) }
  h.cl_file_name = fn(id : Int, i : Int) -> String { take_c_str(mb_web_cl_file_name(id, i)) }
  h.cl_file = fn(id : Int, i : Int) -> Bytes { take_raw_bytes(mb_web_cl_file(id, i)) }
  h.cl_end = fn(id : Int) -> Unit { mb_web_cl_end(id) }
  h.cl_set = fn(text : String, png : Bytes, label : String) -> Unit {
    mb_web_cl_set(
      str_data_ptr(text),
      text.length().to_int64(),
      bytes_data_ptr(png),
      png.length().to_int64(),
      str_data_ptr(label),
      label.length().to_int64(),
    )
  }

  // File picker & download keep
  h.pk_start = fn(kind : Int) -> Int { mb_web_pk_start(kind) }
  h.pk_state = fn(id : Int) -> Int { mb_web_pk_state(id) }
  h.pk_count = fn(id : Int) -> Int { mb_web_pk_count(id) }
  h.pk_name = fn(id : Int, i : Int) -> String { take_c_str(mb_web_pk_name(id, i)) }
  h.pk_bytes = fn(id : Int, i : Int) -> Bytes { take_raw_bytes(mb_web_pk_bytes(id, i)) }
  h.pk_info = fn(id : Int, i : Int) -> String { take_c_str(mb_web_pk_info(id, i)) }
  h.pk_end = fn(id : Int) -> Unit { mb_web_pk_end(id) }

  h.kp_begin = fn(name : String, mime : String, way : Int) -> Int {
    mb_web_kp_begin(str_data_ptr(name), name.length().to_int64(), str_data_ptr(mime), mime.length().to_int64(), way)
  }
  h.kp_append = fn(id : Int, data : Bytes) -> Int {
    mb_web_kp_append(id, bytes_data_ptr(data), data.length().to_int64())
  }
  h.kp_finish = fn(id : Int) -> Unit { mb_web_kp_finish(id) }
  h.kp_state = fn(id : Int) -> Int { mb_web_kp_state(id) }
  h.kp_where = fn(id : Int) -> String { take_c_str(mb_web_kp_where(id)) }
  h.kp_end = fn(id : Int) -> Unit { mb_web_kp_end(id) }

  // External posts (drag-and-drop, system events)
  h.post_take = fn() -> Int { mb_web_post_take() }
  h.post_next = fn() -> Option[(String, String, Bytes)] {
    let ch = take_c_str(mb_web_post_next())
    if ch.length() == 0 {
      return None
    }
    let json = take_c_str(mb_web_post_json())
    let bs = take_raw_bytes(mb_web_post_bytes())
    Some((ch, json, bs))
  }

  // Device, notifications, navigation
  h.dv_keep_awake = fn(on : Int) -> Unit { mb_web_keep_awake(on) }
  h.dv_key_catch = fn(on : Int) -> Unit { mb_web_key_catch(on) }
  h.dv_ime_inset = fn() -> Double { mb_web_ime_inset() }
  h.dv_ime_action = fn(k : Int) -> Unit { mb_web_ime_action(k) }
  h.dv_haptic = fn(k : Int) -> Unit { mb_web_haptic(k) }
  h.nt_show = fn(ch : String, tag : String, title : String, body : String, opens : String) -> Unit {
    mb_web_nt_show(
      str_data_ptr(ch), ch.length().to_int64(),
      str_data_ptr(tag), tag.length().to_int64(),
      str_data_ptr(title), title.length().to_int64(),
      str_data_ptr(body), body.length().to_int64(),
      str_data_ptr(opens), opens.length().to_int64(),
    )
  }
  h.nt_cancel = fn(tag : String) -> Unit { mb_web_nt_cancel(str_data_ptr(tag), tag.length().to_int64()) }
  h.nt_state = fn(what : Int) -> Int { mb_web_nt_state(what) }
  h.nt_text = fn(what : Int) -> String { take_c_str(mb_web_nt_text(what)) }

  h.log = fn(s : String) -> Unit {
    mb_web_log(str_data_ptr(s), s.length().to_int64())
  }
  h.bench_mode = fn() -> Int { mb_web_bench_mode() }
  h.exit = fn(code : Int) -> Unit { mb_web_exit(code) }
  h.set_cursor = fn(kind : Int) -> Unit { mb_web_set_cursor(kind) }
  h.env = fn(name : String) -> String {
    take_c_str(mb_web_env(str_data_ptr(name), name.length().to_int64()))
  }
  h.system_dark = fn() -> Bool { mb_web_system_dark() != 0 }
  h.reduce_motion = fn() -> Bool { mb_web_reduce_motion() != 0 }
  h.reduce_transparency = fn() -> Bool { mb_web_reduce_transparency() != 0 }
  h.frame_awaiting = fn(n : Int, what : String) -> Unit {
    mb_web_frame_awaiting(n, str_data_ptr(what), what.length().to_int64())
  }
  h.set_outside = fn(f : (Int, Int, Int) -> Unit) -> Bool {
    cb_slots.outside = f
    mb_web_set_outside() != 0
  }
  h.set_back = fn(f : (Int, Double, Double, Int) -> Unit) -> Unit {
    cb_slots.back = f
    mb_web_set_back()
  }
  h.back_enabled = fn(on : Bool) -> Unit { mb_web_back_enabled(if on { 1 } else { 0 }) }
  h.set_app_state = fn(f : (Int) -> Unit) -> Unit {
    cb_slots.app_state = f
    mb_web_set_app_state()
  }

  h.image_load = fn(src : String, max_px : Int) -> Int {
    mb_web_image_load(str_data_ptr(src), src.length().to_int64(), max_px)
  }
  h.image_load_bytes = fn(data : Bytes, max_px : Int) -> Int {
    mb_web_image_load_bytes(bytes_data_ptr(data), data.length().to_int64(), max_px)
  }
  h.image_info = fn(id : Int, out : Array[Double]) -> Int {
    mb_web_image_info(id, array_data_ptr(out))
  }
  h.image_free = fn(id : Int) -> Unit { mb_web_image_free(id) }
  h.open_url = fn(url : String) -> Bool {
    mb_web_open_url(str_data_ptr(url), url.length().to_int64()) != 0
  }
  h.open_tab = fn(url : String) -> Bool {
    mb_web_open_url(str_data_ptr(url), url.length().to_int64()) != 0
  }
  h.gpu_ms = fn() -> Double { mb_web_gpu_ms() }
  h.mem_bytes = fn() -> Double { mb_web_mem_bytes() }
  h
}

/// Installs the browser WebGL2 host into `hostapi` as the active global host.
pub fn install() -> Unit {
  hostapi::set_host(web_host())
}
