// Unit tests for packages/player: Media streaming controller, subtitle cues, speed stepping,
// scrubbing, volume/mute/fill/sideways, decode timeout + retry, frame grab wait, and play=false open.

import "codec"
import "ui"

fn video_track(name : String, mime : String) -> MediaTrack {
  MediaTrack::{
    name,
    mime,
    audio: false,
    read: fn(_off : Double, _len : Int, _answer : (Bytes, Double, Bool) -> Unit) -> () -> Unit {
      fn() -> Unit {}
    },
    direct: "",
  }
}

fn views_eq(views : Array[String], exact : String) -> Bool {
  for s in views {
    if s == exact {
      return true
    }
  }
  false
}

fn views_has(views : Array[String], prefix : String, sub : String) -> Bool {
  for s in views {
    if s.starts_with(prefix) && s.contains(sub) {
      return true
    }
  }
  false
}

fn views_count(views : Array[String], prefix : String, sub : String) -> Int {
  let mut n = 0
  for s in views {
    if s.starts_with(prefix) && s.contains(sub) {
      n = n + 1
    }
  }
  n
}

fn views_index(views : Array[String], prefix : String, sub : String) -> Int {
  let mut i = 0
  while i < views.length() {
    let s = views[i]
    if s.starts_with(prefix) && s.contains(sub) {
      return i
    }
    i = i + 1
  }
  -1
}

fn decode_waited(m : Media, now : Double) -> Unit {
  match m.native() {
    Some(n) => {
      if n.state() == 2 && n.decode_since() >= 0.0 && n.decode_since() + media_decode_wait_ms <= now {
        m.decode_given_up()
      }
    }
    None => ()
  }
}

test "player: open, take_ready, seek_by, step_speed, scrub_to/scrub_done, and close" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, w=390.0, h=844.0)
  debug_assert(m.track().is_none(), "starts with no track")
  debug_assert(m.status().state == 0, "starts opening state 0")
  m.open(video_track("a.mp4", "video/mp4"))
  t.draw()
  debug_assert(m.track().is_some(), "open sets track")
  debug_assert(m.take_ready(), "take_ready reports ready once")
  debug_assert(m.started(), "started is true after ready")
  debug_assert((m.duration() - 10000.0).abs() < 0.01, "fake host duration is 10000ms")

  // 15 s on (the fake is 10 s long: clamped to its end), about there at once (nearest key frame)
  m.seek_by(m.nudge_ms())
  debug_assert(views_has(t.views(), "control", " 11 10000"), "seek_by clamps to end via keyframe seek")

  // Speed steps through defaults: 1.0 -> 1.25 -> 1.5 -> 2.0 -> 0.5 -> 0.75 -> 1.0
  m.step_speed()
  debug_assert((m.speed() - 1.25).abs() < 0.001, "1.0 -> 1.25")
  m.step_speed()
  debug_assert((m.speed() - 1.5).abs() < 0.001, "1.25 -> 1.5")
  m.step_speed()
  debug_assert((m.speed() - 2.0).abs() < 0.001, "1.5 -> 2.0")
  m.step_speed()
  debug_assert((m.speed() - 0.5).abs() < 0.001, "2.0 -> 0.5 wrap")
  m.step_speed()
  debug_assert((m.speed() - 0.75).abs() < 0.001, "0.5 -> 0.75")
  m.step_speed()
  debug_assert((m.speed() - 1.0).abs() < 0.001, "0.75 -> 1.0")

  // Dragged to the middle: paused, exact seeks, let go ends scrub without redundant seek
  m.scrub_to(5000.0)
  debug_assert(m.scrubbing() == Some(5000.0), "scrubbing holds target 5000")
  debug_assert(views_has(t.views(), "control", " 2 0"), "scrub pauses playback")
  debug_assert(views_has(t.views(), "control", " 9 1"), "scrub enters scrub mode")
  debug_assert(views_has(t.views(), "control", " 3 5000"), "scrub issues exact seek")
  debug_assert(!views_has(t.views(), "control", " 11 5000"), "scrub does not issue keyframe seek")
  m.scrub_done()
  t.draw()
  debug_assert(m.scrubbing().is_none(), "scrub_done clears scrubbing")
  debug_assert(views_count(t.views(), "control", " 3 5000") == 1, "no duplicate exact seek on scrub_done")
  debug_assert(views_has(t.views(), "control", " 9 0"), "scrub_done exits scrub mode")

  m.toggle_sideways()
  debug_assert(m.is_sideways(), "toggle_sideways before close turns sideways")
  m.close()
  debug_assert(m.native().is_none() && !m.is_sideways(), "close releases native view and resets sideways")
  t.dispose()
}

test "player: seek, seek_near, volume, mute, toggle_fill, and sideways" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, w=390.0, h=844.0)
  m.open(video_track("demo.mp4", "video/mp4"))
  t.draw()

  m.seek(3500.0)
  debug_assert(views_has(t.views(), "control", " 3 3500"), "seek sends exact seek")
  m.seek_near(4200.0)
  debug_assert(views_has(t.views(), "control", " 11 4200"), "seek_near sends keyframe seek")

  m.set_volume(0.0)
  let (v0, muted0) = m.volume()
  debug_assert(v0.abs() < 0.001 && muted0, "set_volume(0.0) clamps to 0.0 and mutes")
  m.set_volume(1.5)
  let (v1, muted1) = m.volume()
  debug_assert((v1 - 1.0).abs() < 0.001 && !muted1, "set_volume(1.5) clamps to 1.0")
  m.toggle_mute()
  let (_, muted2) = m.volume()
  debug_assert(muted2, "toggle_mute turns mute on")
  m.toggle_mute()
  let (_, muted3) = m.volume()
  debug_assert(!muted3, "toggle_mute turns mute off")

  debug_assert(!m.fills(), "fills defaults false")
  m.toggle_fill()
  debug_assert(m.fills(), "toggle_fill turns on")
  m.toggle_fill()
  debug_assert(!m.fills(), "toggle_fill turns off")

  debug_assert(!m.is_sideways(), "starts upright")
  m.toggle_sideways()
  debug_assert(m.is_sideways(), "toggle_sideways turns sideways")
  m.upright()
  debug_assert(!m.is_sideways(), "upright resets sideways")

  let (nudge, dtap, note, wake, sleep) = m.times()
  debug_assert(nudge > 0.0 && dtap > 0.0 && note > 0.0 && wake > 0.0 && sleep > 0.0, "default timing constants positive")
  t.dispose()
}

test "player: subtitle timeline lookup via codec::parse_subtitles and cue_now" {
  let m = Media::new()
  let srt = "1\n00:00:01,000 --> 00:00:03,500\nHello world\n\n2\n00:00:05,000 --> 00:00:08,000\nSecond cue\n"
  let cues = codec::parse_subtitles("demo.srt", srt.to_bytes())
  debug_assert(cues.length() == 2, "parsed 2 SRT cues")
  m.set_subtitle(true, cues)
  let (has_sub, sub_on) = m.subtitle()
  debug_assert(has_sub && sub_on, "subtitles loaded and enabled")

  let mk = fn(pos : Double) -> MediaStatus {
    MediaStatus::{
      state: 1,
      duration: 10000.0,
      position: pos,
      buffered: 10000.0,
      playing: true,
      buffering: false,
      ended: false,
      width: 640.0,
      height: 360.0,
    }
  }
  m.pin(mk(500.0))
  debug_assert(m.cue_now() == "", "before first cue -> empty")
  m.pin(mk(2000.0))
  debug_assert(m.cue_now() == "Hello world", "cue 1 matched at 2000ms")
  m.pin(mk(4000.0))
  debug_assert(m.cue_now() == "", "gap between cues -> empty")
  m.pin(mk(6500.0))
  debug_assert(m.cue_now() == "Second cue", "cue 2 matched at 6500ms")

  m.toggle_subtitle()
  let (_, sub_off) = m.subtitle()
  debug_assert(!sub_off, "toggle_subtitle disables subtitles")
  debug_assert(m.cue_now() == "", "disabled subtitles returns empty")
}

test "player: scrub_done(at=...) seeks to final release point before ending scrub" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, w=390.0, h=844.0)
  m.open(video_track("a.mp4", "video/mp4"))
  t.draw()
  m.scrub_to(4000.0)
  debug_assert(views_has(t.views(), "control", " 3 4000"), "scrub_to seeks to 4000")
  m.scrub_done(at=6000.0)
  t.draw()
  debug_assert(m.scrubbing().is_none(), "scrub_done clears scrubbing")
  debug_assert(views_has(t.views(), "control", " 3 6000"), "scrub_done seeks to release point 6000")
  debug_assert(!views_has(t.views(), "control", " 11 4000"), "no keyframe seek at 4000")
  debug_assert(!views_has(t.views(), "control", " 11 6000"), "no keyframe seek at 6000")
  let log = t.views()
  let exact_idx = views_index(log, "control", " 3 6000")
  let end_idx = views_index(log, "control", " 9 0")
  debug_assert(exact_idx >= 0 && end_idx >= 0 && exact_idx < end_idx, "exact seek precedes scrub end")
  t.dispose()
}

test "player: buffering state pauses on play_pause and resumes playback after scrub_to/scrub_done" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, finish=false)
  m.open(video_track("a.webm", "video/webm"))
  let id = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view"); return }
  }
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":1,\"at\":[10000,2000,0,640,360,100,1,1,5000,0]}}"), "host reports buffering state")
  t.draw()
  debug_assert(m.status().buffering, "status reflects buffering")

  m.scrub_to(4000.0)
  debug_assert(m.scrubbing() == Some(4000.0), "scrubbing active at 4000")
  debug_assert(m.scrub_resumes(), "scrubbing while buffering records scrub_resumes == true")
  let before = t.views().length()
  m.scrub_done()
  let after = t.views()
  let mut resumed = false
  let mut i = before
  while i < after.length() {
    if after[i].starts_with("control \{id} 1 ") {
      resumed = true
    }
    i = i + 1
  }
  debug_assert(resumed, "scrub_done resumes playback after buffering scrub")

  // play_pause while buffering pauses
  let before_pause = t.views().length()
  m.play_pause()
  let after_pause = t.views()
  let mut paused = false
  let mut j = before_pause
  while j < after_pause.length() {
    if after_pause[j].starts_with("control \{id} 2 ") {
      paused = true
    }
    j = j + 1
  }
  debug_assert(paused, "play_pause from buffering sends pause")
  t.dispose()
}

test "player: decode timeout starts only after all bytes arrive and retry resets wait" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, finish=false)
  let wait = media_decode_wait_ms
  let margin = wait / 40.0
  m.open(video_track("a.webm", "video/webm"))
  let id = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view"); return }
  }
  t.draw()
  t.run_for(wait * 1.5)
  decode_waited(m, t.time())
  debug_assert(m.status().state == 0, "a slow read is not a decoder timeout")
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":2,\"at\":[-1,0,0,0,0,100,0,0,0,0]}}"), "host reports decoding state 2")
  t.advance(wait - margin)
  t.frame_at(t.time())
  decode_waited(m, t.time())
  debug_assert(m.status().state == 0, "still waiting before decode_wait_ms")
  t.advance(margin * 2.0)
  t.frame_at(t.time())
  decode_waited(m, t.time())
  debug_assert(m.status().state == -4, "decode_given_up transitions to state -4")

  m.retry()
  let next = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view after retry"); return }
  }
  debug_assert(next != id, "retry creates a fresh native view")
  debug_assert(t.view_said("{\"info\":{\"view\":\{next},\"state\":2,\"at\":[-1,0,0,0,0,100,0,0,0,0]}}"), "retry host reports state 2")
  t.advance(wait - margin)
  t.frame_at(t.time())
  decode_waited(m, t.time())
  debug_assert(m.status().state == 0, "retry gets its own decode wait")
  debug_assert(t.view_said("{\"info\":{\"view\":\{next},\"state\":1,\"at\":[10000,0,0,640,360,100,1,0,0,0]}}"), "retry reaches ready state 1")
  t.draw()
  t.run_for(margin * 2.0)
  decode_waited(m, t.time())
  debug_assert(m.status().state == 1, "ready state stays 1")
  t.dispose()
}

test "player: frame grab wait timeout and give_up_grab allows subsequent grab" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, finish=false)
  let wait = media_grab_wait_ms
  let margin = wait / 40.0
  m.open(video_track("a.mp4", "video/mp4"))
  let n = match m.native() {
    Some(v) => v
    None => { debug_assert(false, "expected native view"); return }
  }
  let stalled = fn(now : Double) -> Bool { n.grab_since() >= 0.0 && n.grab_since() + wait <= now }
  t.draw()
  n.grab_frame(1000.0)
  t.draw()
  t.advance(wait - margin)
  t.frame_at(t.time())
  debug_assert(!stalled(t.time()), "grab not stalled before wait")
  debug_assert(n.grabbing(), "still grabbing before timeout")
  t.advance(margin * 2.0)
  t.frame_at(t.time())
  debug_assert(stalled(t.time()), "grab stalled after wait")
  n.give_up_grab()
  debug_assert(!n.grabbing(), "give_up_grab clears grabbing")
  debug_assert((n.grab_since() - (-1.0)).abs() < 0.001, "give_up_grab resets grab_since")
  n.grab_frame(2000.0)
  debug_assert(n.grabbing(), "subsequent grab succeeds")
  t.dispose()
}

test "player: open with play=false seeks without auto-play until play_pause" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, w=390.0, h=844.0)
  let track = video_track("a.mp4", "video/mp4")
  m.open(track, start=4000.0, play=false)
  t.draw()
  let id = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view"); return }
  }
  debug_assert(views_eq(t.views(), "control \{id} 3 4000"), "sent to start position 4000")
  debug_assert(!views_eq(t.views(), "control \{id} 1 0"), "not played when play=false")
  m.play_pause()
  debug_assert(views_eq(t.views(), "control \{id} 1 0"), "played on play_pause")
  m.open(track)
  let next = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view on reopen"); return }
  }
  debug_assert(views_eq(t.views(), "control \{next} 1 0"), "default open auto-plays")
  t.dispose()
}

test "player: play_pause pauses/resumes playing, replays from start when ended, and pause() pauses" {
  let m = Media::new()
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit {}, finish=false)
  m.open(video_track("b.mp4", "video/mp4"))
  let id = match m.native() {
    Some(n) => n.id()
    None => { debug_assert(false, "expected native view"); return }
  }
  // Playing state: state=1, duration=10000, position=3000, playing=1, buffering=0, ended=0
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":1,\"at\":[10000,3000,1,640,360,100,1,0,5000,0]}}"), "host reports playing state")
  t.draw()
  debug_assert(m.status().playing && !m.status().ended, "status reflects playing")

  // play_pause while playing sends pause (control {id} 2 0)
  let before_p1 = t.views().length()
  m.play_pause()
  let after_p1 = t.views()
  let mut saw_pause = false
  for i = before_p1; i < after_p1.length(); i = i + 1 {
    if after_p1[i] == "control \{id} 2 0" {
      saw_pause = true
    }
  }
  debug_assert(saw_pause, "play_pause while playing sends exact control pause")

  // Host transitions to paused: playing=0, buffering=0, ended=0
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":1,\"at\":[10000,3000,0,640,360,100,0,0,5000,0]}}"), "host reports paused state")
  t.draw()
  debug_assert(!m.status().playing && !m.status().ended, "status reflects paused")

  // play_pause while paused sends resume (control {id} 1 0)
  let before_r1 = t.views().length()
  m.play_pause()
  let after_r1 = t.views()
  let mut saw_resume = false
  for i = before_r1; i < after_r1.length(); i = i + 1 {
    if after_r1[i] == "control \{id} 1 0" {
      saw_resume = true
    }
  }
  debug_assert(saw_resume, "play_pause while paused sends exact control play")

  // Standalone pause() sends control {id} 2 0
  let before_p2 = t.views().length()
  m.pause()
  let after_p2 = t.views()
  let mut saw_standalone_pause = false
  for i = before_p2; i < after_p2.length(); i = i + 1 {
    if after_p2[i] == "control \{id} 2 0" {
      saw_standalone_pause = true
    }
  }
  debug_assert(saw_standalone_pause, "standalone pause() sends exact control pause")

  // Ended state: playing=0, buffering=0, ended=1 (position=10000)
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":1,\"at\":[10000,10000,0,640,360,100,0,0,10000,1]}}"), "host reports ended state")
  t.draw()
  debug_assert(m.status().ended, "status reflects ended")

  // play_pause when ended seeks to 0 then plays: exact control {id} 3 0 followed by control {id} 1 0
  let before_end = t.views().length()
  m.play_pause()
  let after_end = t.views()
  let mut seek0_idx = -1
  let mut play_idx = -1
  for i = before_end; i < after_end.length(); i = i + 1 {
    if after_end[i] == "control \{id} 3 0" && seek0_idx < 0 {
      seek0_idx = i
    }
    if after_end[i] == "control \{id} 1 0" && play_idx < 0 {
      play_idx = i
    }
  }
  debug_assert(seek0_idx >= 0 && play_idx > seek0_idx, "play_pause when ended sends exact control seek 0 then control play")

  // Edge state: playing=1 && ended=1 still replays from start (seek 0 then play), never pause
  debug_assert(t.view_said("{\"info\":{\"view\":\{id},\"state\":1,\"at\":[10000,10000,1,640,360,100,1,0,10000,1]}}"), "host reports playing=1 and ended=1 edge state")
  t.draw()
  debug_assert(m.status().playing && m.status().ended, "status reflects both playing and ended")
  let before_pe = t.views().length()
  m.play_pause()
  let after_pe = t.views()
  let mut pe_seek0_idx = -1
  let mut pe_play_idx = -1
  let mut pe_saw_pause = false
  for i = before_pe; i < after_pe.length(); i = i + 1 {
    if after_pe[i] == "control \{id} 3 0" && pe_seek0_idx < 0 {
      pe_seek0_idx = i
    }
    if after_pe[i] == "control \{id} 1 0" && pe_play_idx < 0 {
      pe_play_idx = i
    }
    if after_pe[i] == "control \{id} 2 0" {
      pe_saw_pause = true
    }
  }
  debug_assert(pe_seek0_idx >= 0 && pe_play_idx > pe_seek0_idx && !pe_saw_pause, "play_pause when playing=1 && ended=1 sends seek 0 then play, not pause")
  t.dispose()
}
