// Numeric utilities (clamp, progress, wrap, velocity_per_second, mix, pipe, interpolate).
// Ported from libs/mbui/src/motion/utils.mbt.

import "halt"

/// `v` kept within `min` .. `max`.
pub fn clamp(min : Double, max : Double, v : Double) -> Double {
  if v > max {
    max
  } else if v < min {
    min
  } else {
    v
  }
}

/// How far `value` is from `from` to `to` (0 at from, 1 at to; not clamped). 1 when the range is empty.
pub fn progress(from : Double, to : Double, value : Double) -> Double {
  let range = to - from
  if range != 0.0 {
    (value - from) / range
  } else {
    1.0
  }
}

/// `v` wrapped into `min` .. `max` (min included, max not).
pub fn wrap(min : Double, max : Double, v : Double) -> Double {
  let size = max - min
  if size == 0.0 {
    return min
  }
  let d = v - min
  let q = (d / size).floor()
  let mut r = d - q * size
  if r < 0.0 {
    r = r + size
  }
  if r >= size {
    r = r - size
  }
  r + min
}

/// A change over a frame of `frame_ms` as a change per second (0 for a frame of no time).
pub fn velocity_per_second(velocity : Double, frame_ms : Double) -> Double {
  if frame_ms != 0.0 {
    velocity * (1000.0 / frame_ms)
  } else {
    0.0
  }
}

pub fn seconds_to_ms(s : Double) -> Double {
  s * 1000.0
}

pub fn ms_to_seconds(ms : Double) -> Double {
  ms / 1000.0
}

/// The value `p` of the way from `from` to `to` (not clamped).
pub fn mix(from : Double, to : Double, p : Double) -> Double {
  from + (to - from) * p
}

/// Compose functions sequentially.
pub fn pipe(fs : Array[(Double) -> Double]) -> (Double) -> Double {
  let list = fs.copy()
  fn(v : Double) -> Double {
    let mut x = v
    for f in list {
      x = f(x)
    }
    x
  }
}

fn rev_doubles(xs : Array[Double]) -> Array[Double] {
  let out : Array[Double] = []
  let mut i = xs.length() - 1
  while i >= 0 {
    out.push(xs[i])
    i -= 1
  }
  out
}

/// Map `input` (ascending or descending) onto `output`, piece by piece.
pub fn interpolate(
  input : Array[Double],
  output : Array[Double],
  clamp_range~ : Bool = true,
  ease? : (Double) -> Double,
  eases? : Array[(Double) -> Double],
  mixer? : (Double, Double) -> (Double) -> Double,
) -> (Double) -> Double {
  let n = input.length()
  if n != output.length() {
    halt::saying("Both input and output ranges must be the same length", loc="motion::interpolate")
  }
  if n == 0 {
    return fn(_v : Double) -> Double { 0.0 }
  }
  if n == 1 {
    let o = output[0]
    return fn(_v : Double) -> Double { o }
  }
  if n == 2 && output[0] == output[1] {
    let o = output[1]
    return fn(_v : Double) -> Double { o }
  }
  let zero_range = input[0] == input[1]
  let inp = if input[0] > input[n - 1] { rev_doubles(input) } else { input.copy() }
  let outp = if input[0] > input[n - 1] { rev_doubles(output) } else { output.copy() }
  let mixers : Array[(Double) -> Double] = []
  let mut i = 0
  while i < n - 1 {
    let a = outp[i]
    let b = outp[i + 1]
    let m : (Double) -> Double = match mixer {
      Some(f) => f(a, b)
      None => fn(p : Double) -> Double { mix(a, b, p) }
    }
    let e : Option[(Double) -> Double] = match (eases, ease) {
      (Some(es), _) => if i < es.length() { Some(es[i]) } else { Some(linear) }
      (None, Some(ef)) => Some(ef)
      _ => None
    }
    let piece : (Double) -> Double = match e {
      Some(ef) => fn(p : Double) -> Double { m(ef(p)) }
      None => m
    }
    mixers.push(piece)
    i += 1
  }
  let count = mixers.length()
  let at = fn(v : Double) -> Double {
    if zero_range && v < inp[0] {
      return outp[0]
    }
    let mut k = 0
    if count > 1 {
      while k < n - 2 {
        if v < inp[k + 1] {
          break
        }
        k += 1
      }
    }
    let f = mixers[k]
    f(progress(inp[k], inp[k + 1], v))
  }
  if clamp_range {
    let lo = inp[0]
    let hi = inp[n - 1]
    fn(v : Double) -> Double {
      at(if v < lo { lo } else if v > hi { hi } else { v })
    }
  } else {
    at
  }
}
