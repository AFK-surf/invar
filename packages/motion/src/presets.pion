// Motion presets, Trans definition, semantic spring tiers, and curve/spec sampling helpers.

import "ui"

/// Enter/exit visual transition spec (fade, scale, offset, ground-first ordering).
pub struct Trans {
  pub fade : Double
  pub scale : Double
  pub ox : Double
  pub oy : Double
  pub dx : Double
  pub dy : Double
  pub fade_spec : Spec
  pub spec : Spec
  pub ground_first : Bool
}

pub fn trans(
  fade~ : Double = 1.0,
  scale~ : Double = 1.0,
  ox~ : Double = 0.5,
  oy~ : Double = 0.5,
  dx~ : Double = 0.0,
  dy~ : Double = 0.0,
  spec~ : Spec = tween(300.0, ease=ui::Ease::Out),
  fade_spec? : Spec,
  ground_first~ : Bool = false,
) -> Trans {
  Trans::{
    fade,
    scale,
    ox,
    oy,
    dx,
    dy,
    fade_spec: match fade_spec { Some(s) => s; None => spec },
    spec,
    ground_first,
  }
}

pub fn Trans::at(self : Trans, pf : Double, pm : Double) -> ui::Look {
  let s = self.scale + (1.0 - self.scale) * pm
  let a = self.fade + (1.0 - self.fade) * pf
  let (alpha, words) = if self.ground_first {
    let ground = m_min(1.0, 2.0 * a)
    (ground, if ground > 0.0 { m_max(0.0, 2.0 * a - 1.0) / ground } else { 0.0 })
  } else {
    (a, 1.0)
  }
  ui::Look::{
    alpha,
    dx: self.dx * (1.0 - pm),
    dy: self.dy * (1.0 - pm),
    sx: s,
    sy: s,
    ox: self.ox,
    oy: self.oy,
    rot: 0.0,
    circle: 0.0,
    words,
  }
}

pub let presence_in_ms : Double = 150.0
pub let presence_out_ms : Double = 100.0

pub let pop_ms : Double = 140.0
pub let pop_out_ms : Double = 100.0
pub let pop_in : Trans = trans(fade=0.0, scale=0.97, spec=tween(pop_ms, ease=ui::Ease::Out), ground_first=true)
pub let pop_out : Trans = trans(fade=0.0, scale=0.97, spec=tween(pop_out_ms, ease=ui::Ease::Leave), ground_first=true)

/// How a liquid-glass popover or menu comes in: glass shell and content fade and scale together
/// (`ground_first=false`, avoiding a hollow refractive glass flash).
pub let glass_pop_in : Trans = trans(fade=0.0, scale=0.97, spec=tween(pop_ms, ease=ui::Ease::Out))

/// How a liquid-glass popover or menu goes out: glass shell and content dissolve together over
/// `pop_out_ms` on `InOut` (`ground_first=false`: even 6-frame 60fps dissolve without a hollow
/// glass shell or final-frame cliff, and C0-continuous reversal if interrupted mid-`glass_pop_in`).
pub let glass_pop_out : Trans = trans(fade=0.0, scale=0.97, spec=tween(pop_out_ms, ease=ui::Ease::InOut))

pub let tip_in : Trans = trans(fade=0.0, spec=tween(120.0, ease=ui::Ease::Out), ground_first=true)
pub let tip_out_ms : Double = pop_out_ms
pub let tip_out : Trans = trans(fade=0.0, spec=tween(tip_out_ms, ease=ui::Ease::Leave), ground_first=true)

pub let dialog_ms : Double = 200.0
pub let dialog_out_ms : Double = pop_out_ms
pub let dialog_in : Trans = trans(fade=0.0, scale=0.98, dy=6.0, spec=tween(dialog_ms, ease=ui::Ease::Out), ground_first=true)
pub let dialog_out : Trans = trans(fade=0.0, scale=0.98, dy=6.0, spec=tween(dialog_out_ms, ease=ui::Ease::Leave), ground_first=true)

pub let ground_in : Trans = trans(fade=0.0, spec=tween(180.0, ease=ui::Ease::Out))
pub let ground_out : Trans = trans(fade=0.0, scale=0.97, spec=tween(pop_out_ms, ease=ui::Ease::Leave))

pub let sheet_scrim_ms : Double = 300.0

pub fn sheet_drag_closes(down : Double, speed : Double, line : Double) -> Bool {
  ui::lands_past(down, speed, line) || speed >= ui::flung_away
}

fn nearest_share(shares : Array[Double], f : Double) -> Double {
  let mut best = shares[0]
  for x in shares {
    if (x - f).abs() < (best - f).abs() {
      best = x
    }
  }
  best
}

pub fn sheet_goes_to(
  shares : Array[Double],
  at : Double,
  speed : Double,
  total : Double,
  close_below : Double,
) -> Option[Double] {
  if shares.length() == 0 || total <= 0.0 {
    return None
  }
  let f = at / total
  if speed >= ui::flung_away {
    let mut below : Option[Double] = None
    for s in shares {
      if s < f {
        match below {
          Some(b) => if s > b { below = Some(s) }
          None => below = Some(s)
        }
      }
    }
    below
  } else if speed <= -ui::flung_away {
    let mut above : Option[Double] = None
    let mut most = shares[0]
    for s in shares {
      if s > most {
        most = s
      }
      if s > f {
        match above {
          Some(b) => if s < b { above = Some(s) }
          None => above = Some(s)
        }
      }
    }
    match above {
      Some(a) => Some(a)
      None => Some(most)
    }
  } else {
    let lands = ui::lands_at(at, -speed) / total
    if lands < close_below {
      None
    } else {
      Some(nearest_share(shares, lands))
    }
  }
}

pub let progress_ms : Double = 200.0
pub let progress_known_ms : Double = 360.0
pub let progress_sweep_ms : Double = 1400.0

let stretch_by : Double = 1.6
let stretch_most : Double = 36.0
let lower_by : Double = 0.2
let lower_most : Double = 6.0

pub fn speed_stretch(v : Double) -> (Double, Double) {
  let longer = m_min(stretch_most, v.abs() * stretch_by)
  (longer, m_min(lower_most, longer * lower_by))
}

pub let zoom_fling_ms : Double = 325.0

// Semantic spring tiers (catalog.mbt + compatibility aliases)
pub let snappy_damped : Spec = spring(ratio=1.0, stiffness=420.0, threshold=0.001)
pub let move_damped : Spec = motion_spring(0.28, threshold=0.5)
pub let cover_damped_spring : Spec = move_damped
pub let carousel_spring : Spec = motion_spring(0.32, threshold=0.5)
pub let tactile_bounce : Spec = motion_spring(0.25, bounce=0.35)
pub let follow_spring : Spec = tactile_bounce

pub fn glass_lens_springs() -> (Spec, Spec, Spec) {
  (backdrop_press_spring, backdrop_scale_x_spring, backdrop_scale_y_spring)
}

/// Critically damped zero-overshoot liquid glass popover bloom spring (zeta = 1.0, stiffness = 540, threshold = 0.001):
/// crisp iOS 27.0 droplet-to-menu emergence (67ms -> 0.46, 117ms -> 0.79, 150ms -> 0.91) with zero overshoot.
pub let popover_bloom_spring : Spec = spring(ratio=1.0, stiffness=540.0, threshold=0.001)

/// Matching critically damped popover glide spring (zeta = 1.0, stiffness = 540, threshold = 0.001) keeping
/// droplet emergence, body morph, and corner radius in unified monotonic motion without overshoot.
pub let popover_neck_spring : Spec = spring(ratio=1.0, stiffness=540.0, threshold=0.001)

pub fn move_duration_ms(distance : Double) -> Double {
  ui::move_ms(distance)
}

pub fn sample_ease(ease : ui::Ease, steps : Int) -> Array[Double] {
  if steps <= 0 {
    return [ui::ease_at(ease, 0.0)]
  }
  let out : Array[Double] = []
  let denom = steps.to_double()
  let mut i = 0
  while i <= steps {
    out.push(ui::ease_at(ease, i.to_double() / denom))
    i += 1
  }
  out
}

pub fn sample_spec(spec : Spec, duration_ms : Double, steps : Int) -> Array[Double] {
  let way = Way::new(0.0)
  way.go(1.0, spec, at=0.0)
  if steps <= 0 {
    return [way.value_at(0.0)]
  }
  let out : Array[Double] = []
  let denom = steps.to_double()
  let mut i = 0
  while i <= steps {
    out.push(way.value_at(duration_ms * i.to_double() / denom))
    i += 1
  }
  out
}

// Ripple / pointer press constants & pure helpers
pub let ripple_enter_ms : Double = 200.0
pub let ripple_exit_ms : Double = 150.0
pub let ripple_tap_ms : Double = ripple_enter_ms + ripple_exit_ms
pub let ripple_ink : Int64 = 0x0000001AL
pub let press_sink : Double = 4.0

pub let pointer_enter_ms : Double = 70.0
pub let pointer_exit_ms : Double = 160.0
pub let pointer_tap_ms : Double = pointer_enter_ms + pointer_exit_ms
pub let pointer_sink_most : Double = 0.01
pub let pointer_veil_part : Double = 0.8

pub fn pointer_veil(ink : Int64) -> Int64 {
  (ink & 0xFFFFFF00L) | ((ink & 0xFFL).to_double() * pointer_veil_part).round().to_int64()
}

pub fn pointer_sink(w : Double, h : Double) -> Double {
  m_min(pointer_sink_most, press_sink / m_max(m_max(w, h), 1.0))
}
