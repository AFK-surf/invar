// Shared internal math and helper utilities for packages/motion.

import "dmath"
import "ui"
import "view"

pub let pi : Double = 3.141592653589793
pub let two_pi : Double = 6.283185307179586
pub let pos_inf : Double = 1.0 / 0.0
pub let neg_inf : Double = -1.0 / 0.0
pub let tap_indication_ms : Double = 100.0

fn m_clamp(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo {
    lo
  } else if v > hi {
    hi
  } else {
    v
  }
}

fn m_min(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

fn m_max(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

fn m_is_nan(x : Double) -> Bool {
  x != x
}

fn m_is_inf(x : Double) -> Bool {
  x == pos_inf || x == neg_inf
}

/// Quantize elapsed milliseconds onto the deterministic motion grid (matching ui::gone_ms).
pub fn gone_ms(ms : Double) -> Double {
  if ms <= 0.0 {
    0.0
  } else {
    ms
  }
}

/// Cover-blend helper: record outgoing weights when switching chosen index mid-flight.
pub fn cover_set_out(
  from : Array[(Int, Double)],
  to : Int,
  p : Double,
) -> Array[(Int, Double)] {
  let k = m_clamp(p, 0.0, 1.0)
  let out : Array[(Int, Double)] = []
  let rem = 1.0 - k
  if rem > 1.0e-6 {
    for entry in from {
      let w = entry.1 * rem
      if w > 1.0e-6 {
        out.push((entry.0, w))
      }
    }
  }
  if k > 1.0e-6 {
    let mut merged = false
    let mut i = 0
    while i < out.length() {
      if out[i].0 == to {
        out[i] = (to, out[i].1 + k)
        merged = true
        break
      }
      i += 1
    }
    if !merged {
      out.push((to, k))
    }
  }
  if out.length() == 0 {
    out.push((to, 1.0))
  }
  out
}

/// Cover-blend helper: interpolate weighted source rectangles toward destination `to` at progress `p`.
pub fn cover_rect(
  from : Array[(Int, Double)],
  to : Int,
  p : Double,
  rect_of : (Int) -> Option[(Double, Double, Double, Double)],
) -> Option[(Double, Double, Double, Double)] {
  let k = m_clamp(p, 0.0, 1.0)
  let dst = match rect_of(to) {
    Some(r) => r
    None => return None
  }
  if k >= 1.0 || from.length() == 0 {
    return Some(dst)
  }
  let mut wsum = 0.0
  let mut sx = 0.0
  let mut sy = 0.0
  let mut sw = 0.0
  let mut sh = 0.0
  for entry in from {
    match rect_of(entry.0) {
      Some((rx, ry, rw, rh)) => {
        wsum = wsum + entry.1
        sx = sx + rx * entry.1
        sy = sy + ry * entry.1
        sw = sw + rw * entry.1
        sh = sh + rh * entry.1
      }
      None => ()
    }
  }
  if wsum <= 1.0e-9 {
    return Some(dst)
  }
  let fx = sx / wsum
  let fy = sy / wsum
  let fw = sw / wsum
  let fh = sh / wsum
  Some((
    fx + (dst.0 - fx) * k,
    fy + (dst.1 - fy) * k,
    fw + (dst.2 - fw) * k,
    fh + (dst.3 - fh) * k,
  ))
}
