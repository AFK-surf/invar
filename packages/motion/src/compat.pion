// Pure-tree Anim, keyed registry helpers, measurement/layout/reshape/reveal/ripple APIs
// aligning 100% of downstream @motion.* exports without legacy Ctx dependency.

import "signals"
import "ui"
import "view"

/// Closed-form animatable scalar backed by `Way`.
pub struct Anim {
  pub mut name : String
  way : Way
}

pub fn Anim::new(v : Double) -> Anim {
  Anim::{ name: "", way: Way::new(v) }
}

pub fn Anim::value_at(self : Anim, at : Double) -> Double {
  self.way.value_at(at)
}

pub fn Anim::target(self : Anim) -> Double {
  self.way.target()
}

pub fn Anim::ends_at(self : Anim) -> Double {
  self.way.ends_at()
}

pub fn Anim::ended_at(self : Anim) -> Double {
  self.way.end()
}

pub fn Anim::ends(self : Anim) -> Double {
  self.way.end()
}

pub fn Anim::over_at(self : Anim, at : Double) -> Bool {
  !self.way.goes_at(at)
}

pub fn Anim::animate(
  self : Anim,
  target : Double,
  spec : Spec,
  at~ : Double = 0.0,
  velocity? : Double,
) -> Unit {
  self.way.go(target, spec, at=at, velocity?=velocity)
}

pub fn Anim::snap(self : Anim, v : Double) -> Unit {
  self.way.put(v)
}

pub fn Anim::shown_on(self : Anim, v : view::View) -> Double {
  self.way.shown_on(v)
}

let anim_registry : Map[String, Anim] = Map::new()
let measured_rects : Map[String, (Double, Double, Double, Double)] = Map::new()
let layout_rests : Map[String, Double] = Map::new()
let reveal_heights : Map[String, Double] = Map::new()

pub fn reset_motion_state() -> Unit {
  anim_registry.clear()
  measured_rects.clear()
  layout_rests.clear()
  reveal_heights.clear()
}

/// Keyed Anim lookup/creation.
pub fn anim(key : String, init~ : Double = 0.0) -> Anim {
  match anim_registry.get(key) {
    Some(a) => a
    None => {
      let a = Anim::new(init)
      a.name = key
      anim_registry[key] = a
      a
    }
  }
}

/// Animate keyed scalar toward `target` by `spec` at moment `at`.
pub fn animate(
  key : String,
  target : Double,
  spec~ : Spec = animate_spring,
  at~ : Double = 0.0,
) -> Double {
  let a = anim(key, init=target)
  if a.target() != target {
    a.animate(target, spec, at=at)
  }
  a.value_at(at)
}

/// Return keyed `Anim` directed toward `target` by `spec` at moment `at`.
pub fn told(
  key : String,
  target : Double,
  spec~ : Spec = animate_spring,
  at~ : Double = 0.0,
) -> Anim {
  let a = anim(key, init=target)
  if a.target() != target {
    a.animate(target, spec, at=at)
  }
  a
}

/// Record a measured rect `(x, y, w, h)` for `key` from `v`.
pub fn measure(v : view::View, key : String) -> Unit {
  if v.was_placed() {
    measured_rects[key] = v.placed_window_now()
  } else {
    let (w, h) = v.laid_size()
    measured_rects[key] = (0.0, 0.0, w, h)
  }
}

pub fn measured(key : String) -> Option[Double] {
  match measured_rects.get(key) {
    Some((_, _, _, h)) => Some(h)
    None => None
  }
}

pub fn measured_rect(key : String) -> Option[(Double, Double, Double, Double)] {
  measured_rects.get(key)
}

pub fn layout_rest(key : String) -> Double {
  match layout_rests.get(key) {
    Some(t) => t
    None => 0.0
  }
}

/// Pure-tree layout animation helper: registers `v` under a keyed `Moves` controller.
pub fn layout[T : Eq](
  v : view::View,
  key : String,
  by : () -> T,
  spec~ : Spec = moved(),
) -> Moves {
  let m = moves_for(v, by, spec=spec)
  m.moves_with(v)
  layout_rests[key] = v.cause_at()
  m
}

/// Pure-tree ground reshape helper: registers `v` as a reshaping ground.
pub fn reshape[T : Eq](
  v : view::View,
  key : String,
  by : () -> T,
  spec~ : Spec = moved(),
  foot~ : Bool = false,
) -> Moves {
  let m = moves_for(v, by, spec=spec)
  m.reshapes(v, foot=foot)
  layout_rests[key] = v.cause_at()
  m
}

/// Apply a reactive `ui::Look` transform (offset/scale/alpha) to `v`.
pub fn placed(v : view::View, at : () -> ui::Look) -> view::View {
  v
    .alpha(view::Live::By(fn() -> Double { at().alpha }))
    .scale(view::Live::By(fn() -> Double { at().sx }))
    .offset(view::Live::By(fn() -> (Double, Double) { (at().dx, at().dy) }))
}

/// Pure-tree reveal wrapper (alias to `reveal_node` with height tracking).
pub fn reveal(
  parent : view::View,
  key : String,
  open : () -> Bool,
  make : (view::View) -> Unit,
  deferred~ : Bool = false,
) -> view::View {
  let node = reveal_node(parent, open, make, deferred=deferred)
  reveal_heights[key] = node.laid_size().1
  node
}

pub fn reveal_height(key : String) -> Double {
  match reveal_heights.get(key) {
    Some(h) => h
    None => 0.0
  }
}

/// Pure-tree tactile press ripple/feel helper attached to `v`.
pub fn ripple(
  v : view::View,
  corner~ : Double = 0.0,
  ink~ : Int64 = ripple_ink,
) -> PressFeel {
  let _ = (corner, ink)
  press_feel(v)
}
