// Expand/collapse reveal_node and soft-edged curtain_reveal for pure-tree nodes.
// Ported from libs/mbui/src/motion/reveal_node.mbt.

import "signals"
import "ui"
import "view"

pub fn reveal_node(
  parent : view::View,
  open : () -> Bool,
  make : (view::View) -> Unit,
  deferred~ : Bool = false,
) -> view::View {
  let init_open = signals::untracked(open)
  let way = NodeWay::new(if init_open { 1.0 } else { 0.0 })
  let made = signals::signal(!deferred || init_open)
  parent.box(fn(room : view::View) -> Unit {
    let held = room.box(fn(h : view::View) -> Unit {
      let _ = h.shrink(view::Live::Is(0.0))
      if made.untracked() {
        make(h)
      } else {
        h.show(fn() -> Bool { made.get() }, make, at_once=true)
      }
    })
    let shown = fn() -> Double { way.shown(room) }
    room.reacts(open, fn(o : Bool) -> Unit {
      let go = fn() -> Unit {
        way.go(room, if o { 1.0 } else { 0.0 }, spec_per_unit(moved(), held.laid_size().1))
      }
      if o && !made.untracked() {
        made.set(true)
        signals::after_flush(go)
      } else {
        go()
      }
    })
    let _ = room
      .opens(view::Live::By(fn() -> Option[Double] {
        let k = shown()
        if k >= 1.0 { None } else { Some(if k > 0.0 { k } else { 0.0 }) }
      }))
      .laid_nowhere(view::Live::By(fn() -> Bool { !open() && shown() <= 0.0 }))
      .clips(view::Live::By(fn() -> Bool { shown() < 1.0 }))
      .cuts_softly(view::Live::By(fn() -> Bool { shown() < 1.0 }))
      .presses(view::Live::By(fn() -> Bool { open() }))
      .hides(view::Live::By(fn() -> Bool { !open() }))
    let _ = held
      .scale(
        view::Live::By(fn() -> Double {
          let k = shown()
          m_clamp(k, 0.0, 1.0)
        }),
        about=view::Pivot::Drawn,
      )
      .alpha(view::Live::By(fn() -> Double {
        let k = shown()
        if k >= 1.0 {
          1.0
        } else {
          let a = (k - view::row_gone_at) / (1.0 - view::row_gone_at)
          if a > 0.0 { a } else { 0.0 }
        }
      }))
  })
}

pub fn curtain_reveal(
  parent : view::View,
  active : () -> Bool,
  color : () -> Int64,
  duration_ms~ : Double = 1100.0,
  wait_after_ms~ : Double = 800.0,
  wait_out_ms~ : Double = 300.0,
  steps~ : Int = 16,
) -> Unit {
  let n_steps = if steps > 0 { steps } else { 1 }
  let steps_d = n_steps.to_double()
  let way = NodeWay::new(0.0)
  let _ = parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .over(view::Live::Is(true))
      .fills_across(view::Live::Is(true))
      .height_share(view::Live::Is(1.0))
      .presses(view::Live::Is(false))
      .points(view::Live::Is(false))
    v.reacts(active, fn(on : Bool) -> Unit {
      if on {
        way.go_from(v, 0.0, 1.0, tween(duration_ms, ease=ui::Ease::Linear))
      } else {
        way.put(0.0)
      }
    })
    let ends = fn(_w : Double, _h : Double) -> Double {
      let _ = way.target()
      way.end()
    }
    let gone = fn(n : view::View) -> Double {
      let p = way.shown(n)
      if wait_out_ms <= 0.0 {
        if p * duration_ms >= wait_after_ms { 0.0 } else { 1.0 }
      } else {
        1.0 - m_clamp((p * duration_ms - wait_after_ms) / wait_out_ms, 0.0, 1.0)
      }
    }
    v.show(fn() -> Bool { active() && way.goes(v) }, fn(overlay : view::View) -> Unit {
      let _ = overlay
        .over(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .height_share(view::Live::Is(1.0))
        .clips(view::Live::Is(true))
        .presses(view::Live::Is(false))
        .points(view::Live::Is(false))
      let strip = fn(k : Int, share : Double, alpha : Double) -> Unit {
        let _ = overlay.box(fn(s : view::View) -> Unit {
          let _ = s
            .over(view::Live::Is(true))
            .fills_across(view::Live::Is(true))
            .height_share(view::Live::Is(share))
            .ground(view::Live::By(color))
            .alpha(view::Live::By(fn() -> Double { alpha * gone(s) }))
            .moved_by(
              fn(_w : Double, h : Double, t : Double) -> (Double, Double) {
                let e = ui::ease_at(ui::Ease::Out, m_clamp(way.value_at(t), 0.0, 1.0))
                let frame = h / share
                let y = frame * (-0.5 + 1.5 * e) + k.to_double() * frame * 0.5 / steps_d
                let ps = s.pixel_scale()
                (0.0, if ps > 0.0 { (y * ps).round() / ps } else { y })
              },
              ends,
            )
        })
      }
      let mut k = 0
      while k < n_steps {
        strip(k, 0.5 / steps_d, (k.to_double() + 0.5) / steps_d)
        k += 1
      }
      strip(n_steps, 1.0, 1.0)
    }, at_once=true)
  })
}
