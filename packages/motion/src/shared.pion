// Shared element flight (View::shared) and aspect-preserving hero flight geometry.
// Shared motion types and hero flight state.

import "ui"
import "view"

pub fn shared(v : view::View, id : String, spec~ : Spec = moved(), loc~ : String = "") -> view::View {
  v.shared(view::Live::Is(id), flight_by(spec), loc=loc)
}

pub fn flight_by(spec : Spec) -> view::Flight {
  view::Flight::{
    way: fn(far : Double) -> (Double, (Double) -> Double) {
      let w = Way::new(0.0)
      let s = if spec_way_said(spec) { spec } else { spec_over(spec, far) }
      w.go(1.0, s, at=0.0)
      let end = w.ends_at()
      (if end < 0.0 { 0.0 } else { end }, fn(ms : Double) -> Double { w.value_at(ms) })
    },
  }
}

pub fn flight_scaled(
  ms_of : (Double) -> Double,
  ease~ : ui::Ease = ui::Ease::Out,
  delay~ : Double = 0.0,
) -> view::Flight {
  view::Flight::{
    way: fn(far : Double) -> (Double, (Double) -> Double) {
      let w = Way::new(0.0)
      w.go(1.0, tween(m_max(0.0, ms_of(far)), ease=ease, delay=delay), at=0.0)
      let end = w.ends_at()
      (if end < 0.0 { 0.0 } else { end }, fn(ms : Double) -> Double { w.value_at(ms) })
    },
  }
}

pub struct HeroThumb {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
  pub seen : Option[(Double, Double, Double, Double)]
  pub corners : (Double, Double, Double, Double)
  pub letterbox : Bool
  pub start_crop : Bool
}

pub struct HeroFlightBox {
  pub cut : (Double, Double, Double, Double)
  pub box : (Double, Double, Double, Double)
  pub corners : (Double, Double, Double, Double)
  pub picture : (Double, Double, Double, Double)
}

pub fn hero_seen_of(
  rect : (Double, Double, Double, Double),
  stage_w : Double,
  stage_h : Double,
) -> (Double, Double, Double, Double) {
  let x0 = m_max(rect.0, 0.0)
  let y0 = m_max(rect.1, 0.0)
  let x1 = m_min(rect.0 + rect.2, stage_w)
  let y1 = m_min(rect.1 + rect.3, stage_h)
  if x1 > x0 && y1 > y0 {
    (x0, y0, x1 - x0, y1 - y0)
  } else {
    rect
  }
}

pub fn hero_flight_box(
  from : HeroThumb,
  dy : Double,
  to : (Double, Double, Double, Double),
  p : Double,
  stage_w : Double,
  stage_h : Double,
) -> Option[HeroFlightBox] {
  let base_seen = match from.seen {
    Some(s) => s
    None => (from.x, from.y, from.w, from.h)
  }
  let (sx, sy, sw, sh) = if dy == 0.0 {
    base_seen
  } else {
    let cut = 0.5
    let y0 = if base_seen.1 > from.y + cut { base_seen.1 } else { from.y + dy }
    let y1 = if base_seen.1 + base_seen.3 < from.y + from.h - cut {
      base_seen.1 + base_seen.3
    } else {
      from.y + dy + from.h
    }
    (base_seen.0, y0, base_seen.2, y1 - y0)
  }
  let fx = from.x
  let fy = from.y + dy
  let fw = from.w
  let fh = from.h
  let (tx, ty, tw, th) = to
  if tw <= 0.0 || th <= 0.0 {
    return None
  }
  let k = if from.letterbox { m_min(fw / tw, fh / th) } else { m_max(fw / tw, fh / th) }
  let pw0 = tw * k
  let ph0 = th * k
  let (px0, py0) = if from.start_crop {
    (fx, fy)
  } else {
    (fx + (fw - pw0) / 2.0, fy + (fh - ph0) / 2.0)
  }
  let along = fn(a : Double, b : Double) -> Double { a + (b - a) * p }
  let (bx, by, bw, bh) = hero_seen_of(to, stage_w, stage_h)
  let cx = along(sx, 0.0)
  let cy = along(sy, 0.0)
  let (tl, tr, br, bl) = from.corners
  let cr = 1.0 - p
  Some(HeroFlightBox::{
    cut: (cx, cy, along(sx + sw, stage_w) - cx, along(sy + sh, stage_h) - cy),
    box: (along(fx, bx), along(fy, by), along(fw, bw), along(fh, bh)),
    corners: (tl * cr, tr * cr, br * cr, bl * cr),
    picture: (along(px0, tx), along(py0, ty), along(pw0, tw), along(ph0, th)),
  })
}

/// Closed-form shared-element hero flight controller (expand 0->1 and collapse 1->0)
/// with velocity-preserving mid-flight reversal and FPS-invariant evaluation.
pub struct HeroFlight {
  pub way : Way
  pub mut from : HeroThumb
  pub mut to : (Double, Double, Double, Double)
  pub mut dy : Double
  pub mut spec : Spec
}

/// Create a `HeroFlight` starting at `initial` progress (`0.0` thumbnail, `1.0` expanded).
pub fn HeroFlight::new(
  from : HeroThumb,
  to : (Double, Double, Double, Double),
  dy~ : Double = 0.0,
  spec~ : Spec = moved(),
  initial~ : Double = 0.0,
) -> HeroFlight {
  HeroFlight::{
    way: Way::new(initial),
    from,
    to,
    dy,
    spec,
  }
}

/// Convenience constructor for a shared-element `HeroFlight` controller.
pub fn hero_flight(
  from : HeroThumb,
  to : (Double, Double, Double, Double),
  dy~ : Double = 0.0,
  spec~ : Spec = moved(),
  initial~ : Double = 0.0,
) -> HeroFlight {
  HeroFlight::new(from, to, dy=dy, spec=spec, initial=initial)
}

/// Launch expand flight (`-> 1.0`) at timestamp `at`.
pub fn HeroFlight::expand(self : HeroFlight, at~ : Double = 0.0) -> Unit {
  self.way.go(1.0, self.spec, at=at)
}

/// Launch collapse flight (`-> 0.0`) at timestamp `at` (preserves velocity if interrupted mid-flight).
pub fn HeroFlight::collapse(self : HeroFlight, at~ : Double = 0.0) -> Unit {
  self.way.go(0.0, self.spec, at=at)
}

/// Closed-form flight progress at timestamp `at`.
pub fn HeroFlight::progress_at(self : HeroFlight, at : Double) -> Double {
  self.way.value_at(at)
}

/// Interpolated `HeroFlightBox` at timestamp `at` on a stage of size `stage_w` × `stage_h`.
pub fn HeroFlight::box_at(
  self : HeroFlight,
  at : Double,
  stage_w : Double,
  stage_h : Double,
) -> Option[HeroFlightBox] {
  let p = self.way.value_at(at)
  hero_flight_box(self.from, self.dy, self.to, p, stage_w, stage_h)
}

/// Whether this hero flight is still animating at timestamp `at`.
pub fn HeroFlight::active_at(self : HeroFlight, at : Double) -> Bool {
  self.way.goes_at(at)
}

/// Timestamp at which this hero flight settles (`-1.0` if already settled).
pub fn HeroFlight::ends_at(self : HeroFlight) -> Double {
  self.way.ends_at()
}
