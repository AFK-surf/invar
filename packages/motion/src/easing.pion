// Easing functions: cubic_bezier, named CSS/Motion curves, steps, mirror/reverse.
// Ported from libs/mbui/src/motion/easing.mbt.

import "dmath"

/// Linear easing: identity.
pub fn linear(p : Double) -> Double {
  p
}

fn calc_bezier(t : Double, a1 : Double, a2 : Double) -> Double {
  t * (3.0 * (1.0 - t) * ((1.0 - t) * a1 + t * a2) + t * t)
}

/// CSS cubic-bezier(x1, y1, x2, y2) solver (Newton + bisection bracket).
pub fn cubic_bezier(x1 : Double, y1 : Double, x2 : Double, y2 : Double) -> (Double) -> Double {
  if x1 == y1 && x2 == y2 {
    return linear
  }
  fn(x : Double) -> Double {
    let mut lower = 0.0
    let mut upper = 1.0
    let mut t = x
    let mut i = 0
    while true {
      if !(t >= lower && t <= upper) {
        t = (lower + upper) / 2.0
      }
      let current = calc_bezier(t, x1, x2) - x
      if current * current < 1.0e-28 || i == 40 {
        break
      }
      if current > 0.0 {
        upper = t
      } else {
        lower = t
      }
      let deriv = calc_bezier(t + 1.0e-7, x1, x2) - x - current
      if deriv == 0.0 {
        t = (lower + upper) / 2.0
      } else {
        t = t - current * 1.0e-7 / deriv
      }
      i += 1
    }
    calc_bezier(t, y1, y2)
  }
}

pub fn mirror_easing(easing : (Double) -> Double) -> (Double) -> Double {
  fn(p : Double) -> Double {
    if p <= 0.5 {
      easing(2.0 * p) / 2.0
    } else {
      (2.0 - easing(2.0 * (1.0 - p))) / 2.0
    }
  }
}

pub fn reverse_easing(easing : (Double) -> Double) -> (Double) -> Double {
  fn(p : Double) -> Double {
    1.0 - easing(1.0 - p)
  }
}

pub let ease_in : (Double) -> Double = cubic_bezier(0.42, 0.0, 1.0, 1.0)
pub let ease_out : (Double) -> Double = cubic_bezier(0.0, 0.0, 0.58, 1.0)
pub let ease_in_out : (Double) -> Double = cubic_bezier(0.42, 0.0, 0.58, 1.0)

pub fn circ_in(p : Double) -> Double {
  let c = m_clamp(p, -1.0, 1.0)
  1.0 - dmath::sin(dmath::acos(c))
}

pub let circ_out : (Double) -> Double = reverse_easing(circ_in)
pub let circ_in_out : (Double) -> Double = mirror_easing(circ_in)

pub let back_out : (Double) -> Double = cubic_bezier(0.33, 1.53, 0.69, 0.99)
pub let back_in : (Double) -> Double = reverse_easing(back_out)
pub let back_in_out : (Double) -> Double = mirror_easing(back_in)

pub fn anticipate(p : Double) -> Double {
  if p >= 1.0 {
    return 1.0
  }
  let q = p * 2.0
  if q < 1.0 {
    let bi = back_in
    0.5 * bi(q)
  } else {
    0.5 * (2.0 - dmath::pow(2.0, -10.0 * (q - 1.0)))
  }
}

#derive(Eq)
pub enum StepsAt {
  End
  Start
}

pub fn steps(n : Int, direction~ : StepsAt = StepsAt::End) -> (Double) -> Double {
  let k = n.to_double()
  fn(p : Double) -> Double {
    let q = match direction {
      StepsAt::End => if p < 0.999 { p } else { 0.999 }
      StepsAt::Start => if p > 0.001 { p } else { 0.001 }
    }
    let expanded = q * k
    let rounded = match direction {
      StepsAt::End => expanded.floor()
      StepsAt::Start => expanded.ceil()
    }
    clamp(0.0, 1.0, rounded / k)
  }
}

pub fn easing_named(name : String) -> Option[(Double) -> Double] {
  if name == "linear" {
    Some(linear)
  } else if name == "easeIn" {
    Some(ease_in)
  } else if name == "easeInOut" {
    Some(ease_in_out)
  } else if name == "easeOut" {
    Some(ease_out)
  } else if name == "circIn" {
    Some(circ_in)
  } else if name == "circInOut" {
    Some(circ_in_out)
  } else if name == "circOut" {
    Some(circ_out)
  } else if name == "backIn" {
    Some(back_in)
  } else if name == "backInOut" {
    Some(back_in_out)
  } else if name == "backOut" {
    Some(back_out)
  } else if name == "anticipate" {
    Some(anticipate)
  } else {
    None
  }
}
