///|
/// Back a little first, then out (Motion's anticipate).
pub fn anticipate(p : Double) -> Double {
  if p >= 1.0 {
    return 1.0
  }
  let q = p * 2.0
  if q < 1.0 {
    0.5 * back_in(q)
  } else {
    0.5 * (2.0 - dmath::pow(2.0, -10.0 * (q - 1.0)))
  }
}

///|
/// Where `steps` jumps: at the end of each step (CSS's jump-end) or its start.

#derive(Eq)
pub enum StepsAt {
  End
  Start
}
pub fn StepsAt::__mbt_debug_repr(self : StepsAt) -> mbt_compat::MbtDebugRepr {
  match self {
    StepsAt::End => mbt_compat::mbt_debug_enum("End", [])
    StepsAt::Start => mbt_compat::mbt_debug_enum("Start", [])
  }
}

///|
/// So many equal steps (Motion's steps, CSS's steps()).
pub fn steps(n : Int, direction? : StepsAt) -> (Double) -> Double {
  let direction = match direction { Some(__mbt_v) => __mbt_v, None => StepsAt::End }

  let k = n.to_double()
  fn(p) {
    let p = match direction {
      StepsAt::End => if p < 0.999 { p } else { 0.999 }
      StepsAt::Start => if p > 0.001 { p } else { 0.001 }
    }
    let expanded = p * k
    let rounded = match direction {
      StepsAt::End => mbt_compat::math_floor(expanded)
      StepsAt::Start => mbt_compat::math_ceil(expanded)
    }
    clamp(0.0, 1.0, rounded / k)
  }
}

///|
/// An easing by Motion's name for it (easingDefinitionToFunction): linear, easeIn, easeInOut, easeOut, circIn,
/// circInOut, circOut, backIn, backInOut, backOut, anticipate. None for any other.
pub fn easing_named(name : String) -> Option[(Double) -> Double] {
  match name {
    "linear" => Some(linear)
    "easeIn" => Some(ease_in)
    "easeInOut" => Some(ease_in_out)
    "easeOut" => Some(ease_out)
    "circIn" => Some(circ_in)
    "circInOut" => Some(circ_in_out)
    "circOut" => Some(circ_out)
    "backIn" => Some(back_in)
    "backInOut" => Some(back_in_out)
    "backOut" => Some(back_out)
    "anticipate" => Some(anticipate)
    _ => Option::None
  }
}
