// Tests for LiquidBond capillary liquid bridge hysteresis, cross-time solver, and 2D surface gap functions.
// Ported 1:1 from libs/mbui/src/motion/liquid_bond_test.mbt.

import "ui"

fn bond_is_steady(ev : BondEvent) -> Bool {
  match ev {
    Steady => true
    _ => false
  }
}

fn bond_is_fused(ev : BondEvent) -> Bool {
  match ev {
    Fused => true
    _ => false
  }
}

fn bond_is_split(ev : BondEvent) -> Bool {
  match ev {
    Split => true
    _ => false
  }
}

test "liquid_bond_separated_approach_has_zero_attraction_until_contact" {
  ui::set_reduced_motion(Some(false))
  let bond = LiquidBond::new(merged=false, merge_max=24.0)
  debug_assert(!bond.is_bonded(), "bond starts unbonded")
  debug_assert(bond.merge_at(0.0) == 0.0, "initial merge is 0")
  // Approaching from 48pt down to 0.01pt: zero attraction, never fuses early
  let approach = [48.0, 20.0, 8.0, 3.0, 1.0, 0.1, 0.01]
  let mut i = 0
  while i < approach.length() {
    let t = (i + 1).to_double() * 16.0
    debug_assert(bond_is_steady(bond.update(approach[i], at=t)), "no early fuse before contact")
    debug_assert(!bond.is_bonded(), "still unbonded before contact")
    debug_assert(bond.merge_at(t) == 0.0, "strictly zero attraction before contact")
    i += 1
  }
  // Exact contact (gap == 0.0) triggers Fused and blooms merge to merge_max
  let t_hit = 200.0
  debug_assert(bond_is_fused(bond.update(0.0, at=t_hit)), "exact contact triggers Fused")
  debug_assert(bond.is_bonded(), "bond is now bonded")
  debug_assert(bond.merge_at(t_hit + 50.0) > 5.0, "merge blooms after contact")
  debug_assert((bond.merge_at(bond.end() + 10.0) - 24.0).abs() < 0.02, "merge settles at merge_max")
  debug_assert(bond.recoil_at(t_hit + 30.0) > 0.0, "positive recoil impulse on fuse")
  debug_assert(bond.recoil_at(bond.end() + 10.0).abs() < 0.002, "recoil settles to 0")
}

test "liquid_bond_merged_stretch_snaps_cleanly_zero_overshoot_zero_reattraction" {
  ui::set_reduced_motion(Some(false))
  let bond = LiquidBond::new(merged=true, merge_max=24.0, break_gap=10.8)
  debug_assert(bond.is_bonded(), "bond starts bonded")
  debug_assert(bond.merge_at(0.0) == 24.0, "initial merge equals merge_max")
  // Pulling through 0 < gap < break_gap stays bonded with full liquid bridge
  let stretch = [0.5, 2.0, 5.0, 9.0, 10.79]
  let mut i = 0
  while i < stretch.length() {
    let t = (i + 1).to_double() * 16.0
    debug_assert(bond_is_steady(bond.update(stretch[i], at=t)), "bridge holds below break_gap")
    debug_assert(bond.is_bonded(), "stays bonded below break_gap")
    debug_assert(bond.merge_at(t) == 24.0, "merge stays at merge_max while bonded")
    i += 1
  }
  // Crossing break_gap triggers Split immediately
  let t_split = 200.0
  debug_assert(bond_is_split(bond.update(10.8, at=t_split)), "crossing break_gap triggers Split")
  debug_assert(!bond.is_bonded(), "bond is now separated")
  // Critically damped decay: monotonic non-increasing and strictly >= 0.0 (zero bounce)
  let mut prev = bond.merge_at(t_split)
  let mut step = 1
  while step <= 40 {
    let cur = bond.merge_at(t_split + step.to_double() * 8.0)
    debug_assert(cur <= prev + 0.000001, "critically damped split must be monotonically non-increasing")
    debug_assert(cur >= 0.0, "critically damped split must not undershoot below 0")
    prev = cur
    step += 1
  }
  let t_rest = bond.end() + 10.0
  debug_assert(bond.merge_at(t_rest) == 0.0, "merge settles to exact 0.0 after split")
  // Returning close to gap = 1.0 or 0.05 after splitting: strictly zero magnetic re-attraction
  let reapproach = [8.0, 4.0, 2.0, 1.0, 0.05]
  let mut j = 0
  while j < reapproach.length() {
    let t = t_rest + (j + 1).to_double() * 16.0
    debug_assert(bond_is_steady(bond.update(reapproach[j], at=t)), "no magnetic re-attraction after split")
    debug_assert(!bond.is_bonded(), "remains unbonded at positive gap")
    debug_assert(bond.merge_at(t) == 0.0, "merge remains 0.0 at positive gap")
    j += 1
  }
  // Only physical contact again re-fuses
  debug_assert(bond_is_fused(bond.update(-0.01, at=t_rest + 200.0)), "negative gap physical contact re-fuses")
  debug_assert(bond.is_bonded(), "bonded again after contact")
}

test "liquid_bond_reset_puts_state_immediately" {
  ui::set_reduced_motion(Some(false))
  let bond = LiquidBond::new(merged=false, merge_max=20.0)
  debug_assert(bond_is_fused(bond.update(0.0, at=100.0)), "contact fuses bond")
  bond.reset(false)
  debug_assert(!bond.is_bonded(), "reset(false) clears bonded")
  debug_assert(bond.merge_at(120.0) == 0.0, "reset(false) clears merge")
  debug_assert(bond.recoil_at(120.0) == 0.0, "reset(false) clears recoil")
  bond.reset(true)
  debug_assert(bond.is_bonded(), "reset(true) sets bonded")
  debug_assert(bond.merge_at(120.0) == 20.0, "reset(true) sets merge to merge_max")
}

test "liquid_bond_cross_time_and_2d_surface_gap_functions" {
  // Linear gap from -56 to +10 over [100, 600] => crosses 6.5 at t = 100 + 500 * (62.5 / 66)
  let gap_open = fn(t : Double) -> Double { -56.0 + 66.0 * ((t - 100.0) / 500.0) }
  let t_split = match liquid_bond_cross_time(100.0, 600.0, gap_open, true, 6.5) {
    Some(v) => v
    None => { debug_assert(false, "gap_open must cross 6.5"); 0.0 }
  }
  let expected_split = 100.0 + 500.0 * (62.5 / 66.0)
  debug_assert((t_split - expected_split).abs() < 0.01, "t_split matches analytic crossing within 0.01ms")

  // Closing from +10 to -56 over [100, 600] => crosses 0.0 at t = 100 + 500 * (10 / 66)
  let gap_close = fn(t : Double) -> Double { 10.0 - 66.0 * ((t - 100.0) / 500.0) }
  let t_touch = match liquid_bond_cross_time(100.0, 600.0, gap_close, false, 0.0) {
    Some(v) => v
    None => { debug_assert(false, "gap_close must cross 0.0"); 0.0 }
  }
  let expected_touch = 100.0 + 500.0 * (10.0 / 66.0)
  debug_assert((t_touch - expected_touch).abs() < 0.01, "t_touch matches analytic crossing within 0.01ms")

  // Never crosses
  debug_assert(liquid_bond_cross_time(100.0, 600.0, fn(_t : Double) -> Double { 5.0 }, true, 10.0).is_none(), "never crosses returns None")

  // Circle gap
  debug_assert((circle_gap(0.0, 0.0, 28.0, 60.0, 0.0, 28.0) - 4.0).abs() < 1.0e-9, "separated circle_gap == 4")
  debug_assert((circle_gap(0.0, 0.0, 28.0, 56.0, 0.0, 28.0) - 0.0).abs() < 1.0e-9, "tangent circle_gap == 0")
  debug_assert((circle_gap(0.0, 0.0, 28.0, 46.0, 0.0, 28.0) - (-10.0)).abs() < 1.0e-9, "overlapping circle_gap == -10")

  // Capsule gap x
  debug_assert(capsule_gap_x(200.0, 206.5) == 6.5, "capsule_gap_x == 6.5")

  // Rounded rect gap: horizontal capsules
  debug_assert((rounded_rect_gap(0.0, 0.0, 160.0, 56.0, 28.0, 164.0, 0.0, 56.0, 56.0, 28.0) - 4.0).abs() < 1.0e-9, "separated rounded_rect_gap == 4")
  debug_assert((rounded_rect_gap(0.0, 0.0, 160.0, 56.0, 28.0, 160.0, 0.0, 56.0, 56.0, 28.0) - 0.0).abs() < 1.0e-9, "tangent rounded_rect_gap == 0")
  debug_assert((rounded_rect_gap(0.0, 0.0, 160.0, 56.0, 28.0, 150.0, 0.0, 56.0, 56.0, 28.0) - (-10.0)).abs() < 1.0e-9, "overlapping rounded_rect_gap == -10")

  // Rounded rect gap: diagonal corner-to-corner distance matches circle gap between corner centers
  let diag = rounded_rect_gap(0.0, 0.0, 60.0, 60.0, 20.0, 70.0, 70.0, 60.0, 60.0, 20.0)
  let expected_diag = (5000.0).sqrt() - 40.0
  debug_assert((diag - expected_diag).abs() < 1.0e-9, "diagonal rounded_rect_gap matches exact corner distance")
}

test "liquid_bond_frame_rate_invariance_60_120_24_7_fps" {
  ui::set_reduced_motion(Some(false))
  let make_bond = fn() -> LiquidBond {
    let b = LiquidBond::new(merged=false, merge_max=24.0, break_gap=10.8)
    debug_assert(bond_is_fused(b.update(0.0, at=100.0)), "make_bond fuses")
    debug_assert(bond_is_split(b.update(11.0, at=500.0)), "make_bond splits")
    b
  }
  let reference = make_bond()
  let rates = [60.0, 120.0, 24.0, 7.0]
  let mut r = 0
  while r < rates.length() {
    let b = make_bond()
    let dt = 1000.0 / rates[r]
    let mut t = 0.0
    while t <= 1200.0 {
      debug_assert(b.merge_at(t) == reference.merge_at(t), "merge_at is bit-identical across frame rates")
      debug_assert(b.recoil_at(t) == reference.recoil_at(t), "recoil_at is bit-identical across frame rates")
      t = t + dt
    }
    r += 1
  }
}
