// Closed-form value motion (Way) with reactive signal notifications and reduced-motion support.
// Ported from libs/mbui/src/motion/way.mbt.

import "signals"
import "ui"
import "view"

let ways_said_count : ui::Ref[Int] = ui::ref_new(0)

pub fn ways_said() -> Int {
  ways_said_count.v
}

pub struct Way {
  mut from : Double
  mut v0 : Double
  mut to : Double
  mut spec : Spec
  mut start : Double
  mut dur : Double
  told : signals::Signal[Int]
}

pub fn Way::new(v : Double) -> Way {
  Way::{
    from: v,
    v0: 0.0,
    to: v,
    spec: Spec::Snap(0.0),
    start: 0.0,
    dur: 0.0,
    told: signals::signal(0),
  }
}

pub fn Way::at(self : Way, t : Double) -> (Double, Double) {
  if self.dur <= 0.0 {
    (self.to, 0.0)
  } else if t >= self.end() {
    (spec_value_at(self.spec, self.dur.ceil(), self.dur, self.from, self.to, self.v0).0, 0.0)
  } else if t <= self.start {
    (self.from, self.v0)
  } else {
    spec_value_at(self.spec, t - self.start, self.dur, self.from, self.to, self.v0)
  }
}

pub fn Way::value_at(self : Way, t : Double) -> Double {
  self.at(t).0
}

pub fn Way::target(self : Way) -> Double {
  self.to
}

pub fn Way::end(self : Way) -> Double {
  self.start + self.dur.ceil()
}

pub fn Way::starts_at(self : Way) -> Double {
  if self.dur > 0.0 { self.start } else { -1.0 }
}

pub fn Way::ends_at(self : Way) -> Double {
  if self.dur > 0.0 { self.end() } else { -1.0 }
}

pub fn Way::goes_at(self : Way, t : Double) -> Bool {
  self.dur > 0.0 && t < self.end()
}

pub fn Way::go(
  self : Way,
  target : Double,
  spec : Spec,
  at~ : Double = 0.0,
  velocity? : Double,
  loc~ : String = "",
) -> Unit {
  let _ = loc
  let (x, v) = self.at(at)
  let vel_in = match velocity { Some(vv) => vv; None => 0.0 }
  if !self.goes_at(at) && x == target && v == 0.0 && vel_in == 0.0 {
    return
  }
  self.from = x
  self.v0 = match velocity { Some(vv) => vv; None => v }
  self.to = target
  self.spec = spec
  self.start = at
  ways_said_count.v = ways_said_count.v + 1
  self.dur = if ui::reduced_motion() { 0.0 } else { spec_duration(spec, x, target, self.v0) }
  self.told.set(self.told.untracked() + 1)
}

pub fn Way::put(self : Way, v : Double, loc~ : String = "") -> Unit {
  let _ = loc
  if self.from == v && self.to == v && self.dur <= 0.0 {
    return
  }
  self.from = v
  self.to = v
  self.v0 = 0.0
  self.spec = Spec::Snap(0.0)
  self.start = 0.0
  self.dur = 0.0
  self.told.set(self.told.untracked() + 1)
}

pub fn Way::said(self : Way) -> Unit {
  let _ = self.told.get()
}

pub fn Way::shown_on(self : Way, n : view::View) -> Double {
  self.motion_on(n).0
}

pub fn Way::motion_on(self : Way, n : view::View) -> (Double, Double) {
  self.said()
  let t = n.drawn_while(fn(at : Double) -> Bool { self.goes_at(at) })
  if t == pos_inf {
    (self.target(), 0.0)
  } else {
    n.hand_at_end(self.end())
    self.at(t)
  }
}
