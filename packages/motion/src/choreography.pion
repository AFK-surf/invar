import "mbt_compat"
import "signals"
import "ui"
import "view"

// A multi-track scene transition choreography built on closed-form Ways: every track shares one cause moment, runs
// independently with its own forward/backward Spec (delay, duration, easing or spring), reverses mid-flight from exact
// position and velocity with zero discontinuity, and arms cleanup on any participating tree node without leaking.

///|
/// One named track of a Choreography: its forward Spec (0 -> 1) and backward Spec (current -> 0).
pub struct TrackSpec {
  pub name : String
  pub forward : Spec
  pub backward : Spec
}

///|
/// Multi-track scene transition coordinator driven by closed-form Ways.
pub struct Choreography {
  priv specs : Array[TrackSpec]
  priv ways : Array[Way]
  priv ended : signals::Signal[Int]
  priv due : Array[(view::NodeId, () -> Unit)]
}

///|
/// Create a choreography at rest (all tracks at 0.0).
pub fn Choreography::new(tracks : Array[TrackSpec]) -> Choreography {
  let ways = mbt_compat::arr_map(tracks, fn(_) { Way::new(0.0) })
  Choreography::{ specs: tracks.copy(), ways: ways, ended: signals::signal(0), due: [] }
}

///|
/// Find track index by name; -1 if not found.
fn Choreography::index_of(self : Choreography, name : String) -> Int {
  for i, s in self.specs {
    if s.name == name {
      return i
    }
  }
  -1
}

///|
/// Start all tracks forward (0.0 -> 1.0) from cause moment `at`. Under reduced motion, snaps immediately to 1.0.

pub fn Choreography::start(self : Choreography, at : Double, loc~ : String = "") -> Unit {
  self.stop()
  if ui::reduced_motion() {
    for w in self.ways {
      w.put(1.0, loc=loc)
    }
    return
  }
  for i, w in self.ways {
    w.put(0.0, loc=loc)
    w.go(1.0, self.specs[i].forward, at=at, loc=loc)
  }
}

///|
/// Reverse all tracks toward 0.0 from exact position and velocity at moment `at`. Under reduced motion, snaps to 0.0.

pub fn Choreography::reverse(self : Choreography, at : Double, loc~ : String = "") -> Unit {
  self.stop()
  if ui::reduced_motion() {
    for w in self.ways {
      w.put(0.0, loc=loc)
    }
    return
  }
  for i, w in self.ways {
    w.go(0.0, self.specs[i].backward, at=at, loc=loc)
  }
}

///|
/// Snap all tracks silently to `v` (typically 0.0 or 1.0).

pub fn Choreography::put(self : Choreography, v : Double, loc~ : String = "") -> Unit {
  self.stop()
  for w in self.ways {
    w.put(v, loc=loc)
  }
}

///|
/// Arm the choreography's latest end moment on node `n`, tied to `n`'s lifetime via `owns_while`. Calling `arm` again
/// on the same node replaces its previous handle without leaking; arming multiple participating nodes is supported.
pub fn Choreography::arm(self : Choreography, n : view::View) -> Unit {
  let id = n.id()
  // Replace any prior arm on this same node without disturbing other armed nodes.
  for let mut i = self.due.length() - 1; i >= 0; i = i - 1 {
    if self.due[i].0 == id {
      let (_, cancel) = mbt_compat::arr_remove(self.due, i)
      cancel()
    }
  }
  let end = self.ends_at()
  guard end >= 0.0 && n.alive() else { return }
  let remove_entry = fn() {
    for let mut i = self.due.length() - 1; i >= 0; i = i - 1 {
      if self.due[i].0 == id {
        mbt_compat::arr_remove(self.due, i) |> ignore
      }
    }
  }
  let unkeep : mbt_compat::Ref[Option[() -> Unit]] = mbt_compat::ref_new(Option::None)
  let drop_unkeep = fn() {
    match unkeep.v {
      Some(f) => {
        unkeep.v = None
        f()
      }
      Option::None => ()
    }
  }
  let stop_moment = n.at_moment(end, fn() {
    drop_unkeep()
    remove_entry()
    self.ended.set(self.ended.untracked() + 1)
  })
  unkeep.v = Some(
    n.owns_while(fn() {
      unkeep.v = None
      stop_moment()
      remove_entry()
    }),
  )
  self.due.push((id, fn() {
    drop_unkeep()
    stop_moment()
  }),)
}

///|
/// Reactive progress (0.0 .. 1.0) of track `name` as node `n` draws it; 0.0 if track not found.
pub fn Choreography::progress(self : Choreography, n : view::View, name : String) -> Double {
  self.ended.get() |> ignore
  let i = self.index_of(name)
  if i < 0 {
    0.0
  } else {
    self.ways[i].shown_on(n)
  }
}

///|
/// Pure evaluation of track `name` at moment `t`; 0.0 if track not found.
pub fn Choreography::value_at(self : Choreography, name : String, t : Double) -> Double {
  let i = self.index_of(name)
  if i < 0 {
    0.0
  } else {
    self.ways[i].value_at(t)
  }
}

///|
/// Whether any track is still moving at `n`'s logic moment (reactive).
pub fn Choreography::active(self : Choreography, n : view::View) -> Bool {
  self.ended.get() |> ignore
  for w in self.ways {
    w.said()
  }
  n.goes_now(fn(at) {
    for let mut i = 0; i < self.ways.length(); i = i + 1 {
      if self.ways[i].goes_at(at) {
        return true
      }
    }
    false
  })
}

///|
/// Latest end timestamp across all active tracks, or -1.0 when all tracks are at rest.
pub fn Choreography::ends_at(self : Choreography) -> Double {
  let mut max_end = -1.0
  for w in self.ways {
    let e = w.ends_at()
    if e >= 0.0 && e > max_end {
      max_end = e
    }
  }
  max_end
}

///|
/// Total span (ms) from earliest track start to latest track end when running, or the nominal forward span from
/// declared TrackSpecs when at rest (useful for aligning `View::show(leave=...)`).
pub fn Choreography::duration(self : Choreography) -> Double {
  let mut min_start = mbt_compat::double_inf()
  let mut max_end = -1.0
  for w in self.ways {
    let s = w.starts_at()
    let e = w.ends_at()
    if s >= 0.0 && e >= 0.0 {
      if s < min_start {
        min_start = s
      }
      if e > max_end {
        max_end = e
      }
    }
  }
  if max_end >= 0.0 && min_start < mbt_compat::double_inf() {
    max_end - min_start
  } else {
    let mut nominal = 0.0
    for spec in self.specs {
      let d = spec.forward.duration(0.0, 1.0, 0.0)
      if d > nominal {
        nominal = d
      }
    }
    nominal
  }
}

///|
/// Declared forward delay (ms) of track `name`; 0.0 if not found.
pub fn Choreography::track_delay(self : Choreography, name : String) -> Double {
  let i = self.index_of(name)
  if i < 0 {
    0.0
  } else {
    self.specs[i].forward.delay()
  }
}

///|
/// Cancel all pending end timers without changing track values.
pub fn Choreography::stop(self : Choreography) -> Unit {
  if self.due.is_empty() {
    return
  }
  let pending = self.due.copy()
  self.due.clear()
  for entry in pending {
    (entry.1)()
  }
}

///|
/// Staggered serial scheduling queue: lets consecutive items from the same `source` run immediately at `now`, while
/// queueing items from a different `source` behind the active tail end (optionally overlapped by `lead` ms).
pub struct SerialQueue {
  priv mut tail_end : Double
  priv mut last_source : String
}

///|
/// Create an empty `SerialQueue`.
pub fn SerialQueue::new() -> SerialQueue {
  SerialQueue::{ tail_end: 0.0, last_source: "" }
}

///|
/// Compute the start moment for an item from `source` arriving at `now`, overlapping the previous tail by `lead` ms
/// when switching sources. Same-source arrivals always start immediately at `now`.
pub fn SerialQueue::next_at(self : SerialQueue, source : String, now : Double, lead? : Double) -> Double {
  let lead = match lead { Some(__mbt_v) => __mbt_v, None => 0.0 }

  if self.last_source != "" && source != self.last_source && self.tail_end - lead > now {
    self.tail_end - lead
  } else {
    now
  }
}

///|
/// Record a scheduled item from `source` finishing at `end_at`, advancing `tail_end` monotonically.
pub fn SerialQueue::commit(self : SerialQueue, source : String, end_at : Double) -> Unit {
  if end_at > self.tail_end {
    self.tail_end = end_at
  }
  self.last_source = source
}

///|
/// Reset the queue back to empty.
pub fn SerialQueue::reset(self : SerialQueue) -> Unit {
  self.tail_end = 0.0
  self.last_source = ""
}
