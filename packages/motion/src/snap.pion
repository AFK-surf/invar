// Damped detent snapping controller (`Snap`): combines deceleration projection (`snap_detent`),
// rubber-band drag clamping, and velocity-conserving closed-form `Way` spring settling.

/// Closed-form damped detent snapping controller (sheets, drawers, carousels, split panes).
pub struct Snap {
  pub way : Way
  pub detents : Array[Double]
  pub spec : Spec
  pub decel_rate : Double
  pub mut target_index : Int
}

/// Create a `Snap` controller over sorted or arbitrary `detents`, starting at `detents[initial]`.
pub fn Snap::new(
  detents : Array[Double],
  initial~ : Int = 0,
  spec~ : Spec = snappy_damped,
  decel_rate~ : Double = 0.998,
) -> Snap {
  let idx = if detents.length() == 0 {
    -1
  } else if initial < 0 {
    0
  } else if initial >= detents.length() {
    detents.length() - 1
  } else {
    initial
  }
  let init_v = if idx >= 0 { detents[idx] } else { 0.0 }
  Snap::{
    way: Way::new(init_v),
    detents,
    spec,
    decel_rate,
    target_index: idx,
  }
}

/// Track direct finger/pointer drag position immediately without spring lag.
pub fn Snap::drag_to(self : Snap, pos : Double) -> Unit {
  self.way.put(pos)
}

/// Track direct drag position with Apple-style rubber-band resistance beyond `[min_detent, max_detent]`.
pub fn Snap::drag_clamped(self : Snap, raw_pos : Double, dimension : Double, coeff~ : Double = 0.55) -> Double {
  if self.detents.length() == 0 {
    self.way.put(raw_pos)
    return raw_pos
  }
  let mut lo = self.detents[0]
  let mut hi = self.detents[0]
  for d in self.detents {
    if d < lo { lo = d }
    if d > hi { hi = d }
  }
  let clamped = rubber_band_clamped(raw_pos, lo, hi, dimension, coeff=coeff)
  self.way.put(clamped)
  clamped
}

/// Release from `(pos, velocity_per_s)` at timestamp `at`: projects landing via `snap_detent`,
/// launches damped spring toward the chosen detent conserving release velocity, and returns the detent index
/// (`None` when projected past `close_past` or `detents` is empty).
pub fn Snap::release(
  self : Snap,
  pos : Double,
  velocity_per_s : Double,
  at : Double,
  close_past? : Double,
) -> Option[Int] {
  self.way.put(pos)
  let chosen = match close_past {
    Some(cp) => snap_detent(pos, velocity_per_s, self.detents, close_past=cp, decel_rate=self.decel_rate)
    None => snap_detent(pos, velocity_per_s, self.detents, decel_rate=self.decel_rate)
  }
  match chosen {
    Some(idx) => {
      self.target_index = idx
      self.way.go(self.detents[idx], self.spec, at=at, velocity=velocity_per_s)
      Some(idx)
    }
    None => None
  }
}

/// Programmatically animate to `detents[index]` at timestamp `at`.
pub fn Snap::snap_to(self : Snap, index : Int, at : Double) -> Unit {
  if index < 0 || index >= self.detents.length() {
    return
  }
  self.target_index = index
  self.way.go(self.detents[index], self.spec, at=at)
}

/// Closed-form `(position, velocity)` at timestamp `at`.
pub fn Snap::at(self : Snap, at : Double) -> (Double, Double) {
  self.way.at(at)
}

/// Closed-form position at timestamp `at`.
pub fn Snap::value_at(self : Snap, at : Double) -> Double {
  self.way.value_at(at)
}

/// Whether the snap spring is still settling at timestamp `at`.
pub fn Snap::active_at(self : Snap, at : Double) -> Bool {
  self.way.goes_at(at)
}

/// Timestamp at which the snap spring settles (`-1.0` if already at rest).
pub fn Snap::ends_at(self : Snap) -> Double {
  self.way.ends_at()
}

/// Most recently chosen detent index (`-1` if none).
pub fn Snap::index(self : Snap) -> Int {
  self.target_index
}
