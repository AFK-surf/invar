// Closed-form touch physics: Apple rubber band, deceleration projection, and detent snapping.
// Ported from libs/mbui/src/motion/physics.mbt.

/// Apple UIScrollView rubber band (default coeff 0.55).
pub fn rubber_band(offset : Double, dimension : Double, coeff~ : Double = 0.55) -> Double {
  if dimension <= 0.0 || offset == 0.0 {
    return 0.0
  }
  let a = offset.abs()
  let r = coeff * a * dimension / (dimension + coeff * a)
  if offset < 0.0 { -r } else { r }
}

/// Clamped value with rubber-band resistance beyond `[min, max]`.
pub fn rubber_band_clamped(
  value : Double,
  min : Double,
  max : Double,
  dimension : Double,
  coeff~ : Double = 0.55,
) -> Double {
  if value < min {
    min + rubber_band(value - min, dimension, coeff=coeff)
  } else if value > max {
    max + rubber_band(value - max, dimension, coeff=coeff)
  } else {
    value
  }
}

/// Distance traveled per unit/s initial velocity under per-ms deceleration rate `decel_rate`.
pub fn landing_reach(decel_rate~ : Double = 0.998) -> Double {
  if decel_rate <= 0.0 || decel_rate >= 1.0 {
    return 0.0
  }
  decel_rate / (1.0 - decel_rate) / 1000.0
}

/// Projected resting position from `pos` and `velocity_per_s`.
pub fn project_landing(pos : Double, velocity_per_s : Double, decel_rate~ : Double = 0.998) -> Double {
  pos + velocity_per_s * landing_reach(decel_rate=decel_rate)
}

/// Nearest detent index to projected landing, or `None` if past `close_past` or `detents` is empty.
pub fn snap_detent(
  pos : Double,
  velocity_per_s : Double,
  detents : Array[Double],
  close_past? : Double,
  decel_rate~ : Double = 0.998,
) -> Option[Int] {
  let projected = project_landing(pos, velocity_per_s, decel_rate=decel_rate)
  match close_past {
    Some(c) => if projected > c { return None }
    None => ()
  }
  let mut best = -1
  let mut far = pos_inf
  let mut i = 0
  while i < detents.length() {
    let f = (detents[i] - projected).abs()
    if f < far {
      far = f
      best = i
    }
    i += 1
  }
  if best < 0 { None } else { Some(best) }
}
