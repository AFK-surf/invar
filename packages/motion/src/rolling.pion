// Odometer-style per-character rolling slots.
// Ported from libs/mbui/src/motion/rolling.mbt.

import "signals"
import "ui"
import "view"

pub fn rolling_chars(words : String) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  let n = words.length()
  while i < n {
    let sb = StringBuilder::new()
    sb.write_char(words.code_unit_at(i).unsafe_to_char())
    out.push(sb.to_string())
    i += 1
  }
  out
}

pub fn rolling_slots_node(
  parent : view::View,
  words : () -> String,
  dir : () -> Double,
  style : () -> ui::TextStyle,
  ink : () -> Int64,
  rolls~ : () -> Bool = fn() -> Bool { true },
  spec~ : Spec = digit_spring,
  fade_px~ : Double = 3.0,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
    v.each(
      fn() -> Array[Int] {
        let n = rolling_chars(words()).length()
        let ks : Array[Int] = []
        let mut i = 0
        while i < n {
          ks.push(n - 1 - i)
          i += 1
        }
        ks
      },
      fn(k : Int) -> Int { k },
      fn(slot : view::View, place : signals::Signal[Int]) -> Unit {
        let char_now = fn() -> String {
          let cs = rolling_chars(words())
          let idx = cs.length() - 1 - place.untracked()
          if idx >= 0 && idx < cs.length() { cs[idx] } else { "" }
        }
        rolling_slot(slot, char_now, dir, style, ink, rolls, spec, fade_px, loc=loc)
      },
      along_row=true,
    )
  }, made_for=loc)
}

fn rolling_slot(
  s : view::View,
  char_now : () -> String,
  dir : () -> Double,
  style : () -> ui::TextStyle,
  ink : () -> Int64,
  rolls : () -> Bool,
  spec : Spec,
  fade_px : Double,
  loc~ : String = "",
) -> Unit {
  let held = signals::untracked(char_now)
  let shown : signals::Signal[String] = signals::signal(held)
  let gone : signals::Signal[String] = signals::signal("")
  let way_dir = ui::ref_new(1.0)
  let roll = NodeWay::new(1.0)
  s.reacts(char_now, fn(c : String) -> Unit {
    if c == shown.untracked() {
      return
    }
    if !signals::untracked(rolls) {
      gone.set("")
      shown.set(c)
      roll.put(1.0)
      return
    }
    gone.set(shown.untracked())
    shown.set(c)
    let d = signals::untracked(dir)
    way_dir.v = if d < 0.0 { -1.0 } else { 1.0 }
    roll.go_from(s, 0.0, 1.0, spec)
  }, at_start=false)
  let rolling = fn() -> Bool { roll.goes(s) }
  let _ = s
    .clips(view::Live::Is(true))
    .fades(view::Live::By(fn() -> (Double, Double, Double, Double) {
      if rolling() { (0.0, fade_px, 0.0, fade_px) } else { (0.0, 0.0, 0.0, 0.0) }
    }))
  let ends = fn(_w : Double, _h : Double) -> Double {
    let _ = roll.target()
    roll.end()
  }
  let _ = s.box(fn(w : view::View) -> Unit {
    let _ = w
      .words(view::Live::By(fn() -> String { shown.get() }))
      .words_look(view::Live::By(fn() -> view::WordsLook { style_words(style()) }))
      .ink(view::Live::By(ink))
      .moved_by(
        fn(_w : Double, h : Double, at : Double) -> (Double, Double) {
          (0.0, way_dir.v * h * (1.0 - m_min(1.0, roll.value_at(at))))
        },
        ends,
      )
  }, made_for=loc)
  s.show(fn() -> Bool { rolling() && gone.get() != "" }, fn(o : view::View) -> Unit {
    let _ = o.over(view::Live::Is(true))
    let _ = o.box(fn(w : view::View) -> Unit {
      let _ = w
        .words(view::Live::By(fn() -> String { gone.get() }))
        .words_look(view::Live::By(fn() -> view::WordsLook { style_words(style()) }))
        .ink(view::Live::By(ink))
        .moved_by(
          fn(_w : Double, h : Double, at : Double) -> (Double, Double) {
            (0.0, -way_dir.v * h * m_min(1.0, roll.value_at(at)))
          },
          ends,
        )
    }, made_for=loc)
  }, at_once=true)
}
