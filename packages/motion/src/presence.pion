// Presence enter/exit progress and look helpers bound to View::leaving.
// Ported from libs/mbui/src/motion/presence.mbt.

import "ui"
import "view"

pub fn presence_in(
  v : view::View,
  enter : Spec,
  exit? : Spec,
  from~ : Double = 0.0,
  carries~ : Bool = false,
  gate? : (() -> Unit) -> Unit,
  stop_gate~ : () -> Unit = fn() -> Unit { () },
) -> () -> Double {
  let way = NodeWay::new(from)
  let come = fn() -> Unit { way.go(v, 1.0, enter) }
  v.reacts(fn() -> Bool { v.leaving() }, fn(going : Bool) -> Unit {
    if going {
      stop_gate()
      let ex = match exit { Some(s) => s; None => enter }
      way.go(v, 0.0, ex)
    } else {
      match gate {
        Some(g) => g(come)
        None => come()
      }
    }
  })
  if carries {
    let _ = v.carries_until(fn() -> Double { way.ends_at() })
  }
  fn() -> Double { way.shown(v) }
}

pub fn presence_look(
  v : view::View,
  enter : Trans,
  exit? : Trans,
  gate? : (() -> Unit) -> Unit,
  stop_gate~ : () -> Unit = fn() -> Unit { () },
) -> () -> ui::Look {
  let moves = fn(t : Trans) -> Bool { t.scale != 1.0 || t.dx != 0.0 || t.dy != 0.0 }
  let carries = moves(enter) || match exit {
    Some(o) => moves(o)
    None => false
  }
  let exit_spec : Option[Spec] = match exit {
    Some(o) => Some(o.spec)
    None => None
  }
  let shown = presence_in(
    v,
    enter.spec,
    exit?=exit_spec,
    carries=carries,
    gate?=gate,
    stop_gate=stop_gate,
  )
  fn() -> ui::Look {
    let p = shown()
    match exit {
      Some(o) => if v.leaving() { o.at(p, p) } else { enter.at(p, p) }
      None => enter.at(p, p)
    }
  }
}
