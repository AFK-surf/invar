// Motion transitions: spring_to, tween_to, keyframes_to, inertia_to, and Compose <-> Motion conversions.
// Ported from libs/mbui/src/motion/transition.mbt.

import "ui"

pub struct Transition {
  pub id : Int
  pub kind : String
  pub delay : Double
  make : (Double, Double, Double) -> Generator
}

let next_transition_id : ui::Ref[Int] = ui::ref_new(1)

fn alloc_transition_id() -> Int {
  let id = next_transition_id.v
  next_transition_id.v = id + 1
  id
}

pub fn Transition::delayed(self : Transition, delay : Double) -> Transition {
  Transition::{ id: alloc_transition_id(), kind: self.kind, delay, make: self.make }
}

pub fn Transition::generator(self : Transition, from : Double, to : Double, velocity : Double) -> Generator {
  (self.make)(from, to, velocity)
}

pub fn generator_duration(g : Generator) -> Double {
  match g.calculated_duration() {
    Some(d) => d
    None => m_min(calc_generator_duration(g), max_generator_duration)
  }
}

pub fn spring_to(
  stiffness? : Double,
  damping? : Double,
  mass? : Double,
  duration? : Double,
  bounce? : Double,
  visual_duration? : Double,
  rest_speed? : Double,
  rest_delta? : Double,
  delay~ : Double = 0.0,
) -> Spec {
  Spec::Motion(Transition::{
    id: alloc_transition_id(),
    kind: "spring",
    delay,
    make: fn(from : Double, to : Double, v : Double) -> Generator {
      spring_generator(
        from,
        to,
        stiffness?=stiffness,
        damping?=damping,
        mass?=mass,
        velocity=v,
        duration?=duration,
        bounce?=bounce,
        visual_duration?=visual_duration,
        rest_speed?=rest_speed,
        rest_delta?=rest_delta,
      )
    },
  })
}

pub fn tween_to(
  duration~ : Double = 300.0,
  ease~ : (Double) -> Double = ease_in_out,
  delay~ : Double = 0.0,
) -> Spec {
  Spec::Motion(Transition::{
    id: alloc_transition_id(),
    kind: "tween",
    delay,
    make: fn(from : Double, to : Double, _v : Double) -> Generator {
      keyframes_generator([from, to], duration=duration, ease=ease)
    },
  })
}

pub fn keyframes_to(
  values : Array[Double],
  duration~ : Double = 300.0,
  times? : Array[Double],
  ease? : (Double) -> Double,
  eases? : Array[(Double) -> Double],
  delay~ : Double = 0.0,
) -> Spec {
  let vals = values.copy()
  let ts_copy : Option[Array[Double]] = match times {
    Some(ts) => Some(ts.copy())
    None => None
  }
  let es_copy : Option[Array[(Double) -> Double]] = match eases {
    Some(es) => Some(es.copy())
    None => None
  }
  Spec::Motion(Transition::{
    id: alloc_transition_id(),
    kind: "keyframes",
    delay,
    make: fn(from : Double, _to : Double, _v : Double) -> Generator {
      let all : Array[Double] = [from]
      for v in vals {
        all.push(v)
      }
      keyframes_generator(all, duration=duration, times?=ts_copy, ease?=ease, eases?=es_copy)
    },
  })
}

pub fn inertia_to(
  power~ : Double = 0.8,
  time_constant~ : Double = 325.0,
  bounce_damping~ : Double = 10.0,
  bounce_stiffness~ : Double = 500.0,
  modify_target? : (Double) -> Double,
  min? : Double,
  max? : Double,
  rest_delta~ : Double = 0.5,
  rest_speed? : Double,
  delay~ : Double = 0.0,
) -> Spec {
  Spec::Motion(Transition::{
    id: alloc_transition_id(),
    kind: "inertia",
    delay,
    make: fn(from : Double, _to : Double, v : Double) -> Generator {
      inertia_generator(
        from,
        velocity=v,
        power=power,
        time_constant=time_constant,
        bounce_damping=bounce_damping,
        bounce_stiffness=bounce_stiffness,
        modify_target?=modify_target,
        min?=min,
        max?=max,
        rest_delta=rest_delta,
        rest_speed?=rest_speed,
      )
    },
  })
}

pub fn compose_to_motion(ratio : Double, stiffness : Double) -> (Double, Double, Double) {
  (stiffness, 2.0 * ratio * stiffness.sqrt(), 1.0)
}

pub fn motion_to_compose(stiffness : Double, damping : Double, mass : Double) -> (Double, Double) {
  (damping / (2.0 * (stiffness * mass).sqrt()), stiffness / mass)
}

pub fn visual_to_compose(visual_duration : Double, bounce : Double) -> (Double, Double) {
  let ratio = bounce_to_damping_ratio(bounce)
  let root = two_pi / (visual_duration * 1.2) * overdamped_freq_scale(ratio, two_pi / 1.2)
  (ratio, root * root)
}
