// Unit tests for packages/motion: spring physics, FPS invariance (60fps vs 120fps),
// retarget velocity conservation, reduced_motion instant settle, hero flight interpolation,
// rubber band & projection, easing curves, NodeWay/ShakeWay/Choreography/EdgePull/Zoom/Handoff.

import "signals"
import "ui"
import "view"

fn approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

test "spring_convergence_critically_and_underdamped" {
  ui::set_reduced_motion(Some(false))
  // Critically damped spring converges cleanly without overshoot
  let w_crit = Way::new(0.0)
  w_crit.go(100.0, snappy_damped, at=0.0)
  let dur = w_crit.ends_at()
  debug_assert(dur > 10.0, "critically damped spring duration must be positive")
  let mid = w_crit.value_at(dur * 0.5)
  debug_assert(mid > 50.0 && mid <= 100.01, "critically damped spring should advance monotonically")
  let end_v = w_crit.value_at(dur + 10.0)
  debug_assert(approx(end_v, 100.0, 1.0e-6), "critically damped spring must settle exactly at target")

  // Underdamped tactile_bounce overshoots target then settles
  let w_bounce = Way::new(0.0)
  w_bounce.go(100.0, tactile_bounce, at=0.0)
  let mut max_v = 0.0
  let mut t = 0.0
  while t <= w_bounce.ends_at() {
    let v = w_bounce.value_at(t)
    if v > max_v { max_v = v }
    t = t + 5.0
  }
  debug_assert(max_v > 100.5, "underdamped tactile_bounce must overshoot target")
  debug_assert(approx(w_bounce.value_at(w_bounce.ends_at() + 10.0), 100.0, 1.0e-6), "underdamped spring must settle at target")
}

test "fps_invariance_60fps_vs_120fps" {
  ui::set_reduced_motion(Some(false))
  let w60 = Way::new(0.0)
  let w120 = Way::new(0.0)
  w60.go(240.0, move_damped, at=100.0)
  w120.go(240.0, move_damped, at=100.0)

  // Sample at 60fps steps (every 16.666...ms) vs 120fps steps (every 8.333...ms)
  // At every shared timestamp (every 2 frames of 120fps = 1 frame of 60fps), values must be bit-identical
  let mut k = 0
  while k <= 30 {
    let t_ms = 100.0 + k.to_double() * (1000.0 / 60.0)
    let v60 = w60.value_at(t_ms)
    let v120 = w120.value_at(t_ms)
    debug_assert(v60 == v120, "closed-form Way must be bit-identical between 60fps and 120fps")
    k += 1
  }
}

test "retarget_mid_flight_velocity_conservation" {
  ui::set_reduced_motion(Some(false))
  let w = Way::new(0.0)
  w.go(100.0, spring(ratio=0.7, stiffness=300.0, threshold=0.01), at=0.0)
  let (pos_mid, vel_mid) = w.at(60.0)
  debug_assert(pos_mid > 10.0 && vel_mid > 100.0, "spring must have positive position and velocity mid-flight")

  // Interrupt and retarget back to 0.0 at t=60ms
  w.go(0.0, spring(ratio=0.7, stiffness=300.0, threshold=0.01), at=60.0)
  let (pos_after, vel_after) = w.at(60.0)
  debug_assert(approx(pos_after, pos_mid, 1.0e-6), "position must be continuous on retarget")
  debug_assert(approx(vel_after, vel_mid, 1.0e-6), "velocity must be conserved on retarget")

  // Momentum should carry position briefly past pos_mid before reversing toward 0
  let pos_next = w.value_at(70.0)
  debug_assert(pos_next > pos_mid, "conserved positive velocity must carry position briefly before turning back")
  debug_assert(approx(w.value_at(w.ends_at() + 10.0), 0.0, 1.0e-6), "retargeted spring must settle at new target 0.0")
}

test "reduced_motion_instant_settle" {
  ui::set_reduced_motion(Some(true))
  let w = Way::new(10.0)
  w.go(90.0, move_damped, at=50.0)
  debug_assert(!w.goes_at(50.0), "reduced_motion Way must not be active")
  debug_assert(w.ends_at() < 0.0, "reduced_motion Way must have instant duration")
  debug_assert(approx(w.value_at(50.0), 90.0, 1.0e-9), "reduced_motion Way must jump immediately to target")

  let shake = ShakeWay::new(amplitude=6.0, duration_ms=300.0, cycles=3.0)
  shake.shake(at=100.0)
  debug_assert(!shake.active_at(150.0), "ShakeWay must be inactive under reduced_motion")
  debug_assert(approx(shake.offset_at(150.0), 0.0, 1.0e-9), "ShakeWay offset must be 0 under reduced_motion")
  ui::set_reduced_motion(Some(false))
}

test "hero_flight_shared_geometry_interpolation" {
  let thumb = HeroThumb::{
    x: 20.0,
    y: 40.0,
    w: 100.0,
    h: 100.0,
    seen: Some((20.0, 50.0, 100.0, 80.0)),
    corners: (16.0, 16.0, 16.0, 16.0),
    letterbox: false,
    start_crop: false,
  }
  let dest = (0.0, 100.0, 400.0, 200.0)
  let b0 = match hero_flight_box(thumb, 0.0, dest, 0.0, 400.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "p=0 must produce HeroFlightBox"); return }
  }
  debug_assert(approx(b0.box.0, 20.0, 1.0e-6) && approx(b0.box.2, 100.0, 1.0e-6), "p=0 box matches thumb")
  debug_assert(approx(b0.corners.0, 16.0, 1.0e-6), "p=0 corners match thumb")
  debug_assert(approx(b0.cut.1, 50.0, 1.0e-6) && approx(b0.cut.3, 80.0, 1.0e-6), "p=0 cut matches seen clip")

  let b_mid = match hero_flight_box(thumb, 0.0, dest, 0.5, 400.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "p=0.5 must produce HeroFlightBox"); return }
  }
  debug_assert(approx(b_mid.corners.0, 8.0, 1.0e-6), "p=0.5 corners half-way to 0")
  debug_assert(approx(b_mid.box.2, 250.0, 1.0e-6), "p=0.5 width interpolated")

  let b1 = match hero_flight_box(thumb, 0.0, dest, 1.0, 400.0, 600.0) {
    Some(b) => b
    None => { debug_assert(false, "p=1 must produce HeroFlightBox"); return }
  }
  debug_assert(approx(b1.box.0, 0.0, 1.0e-6) && approx(b1.box.2, 400.0, 1.0e-6), "p=1 box matches dest")
  debug_assert(approx(b1.corners.0, 0.0, 1.0e-6), "p=1 corners shrink to 0")
  debug_assert(approx(b1.cut.2, 400.0, 1.0e-6) && approx(b1.cut.3, 600.0, 1.0e-6), "p=1 cut expands to stage")
}

test "easing_cubic_bezier_and_named_curves" {
  let cb = cubic_bezier(0.25, 0.1, 0.25, 1.0)
  debug_assert(approx(cb(0.0), 0.0, 1.0e-9), "cubic_bezier(0) == 0")
  debug_assert(approx(cb(1.0), 1.0, 1.0e-9), "cubic_bezier(1) == 1")
  debug_assert(cb(0.5) > 0.7 && cb(0.5) < 0.9, "CSS ease at 0.5 is around 0.8")
  debug_assert(approx(linear(0.37), 0.37, 1.0e-9), "linear identity")
  debug_assert(easing_named("easeInOut").is_some(), "easing_named finds easeInOut")
  debug_assert(easing_named("nonexistent").is_none(), "easing_named returns None for unknown")
  let st = steps(4)
  debug_assert(approx(st(0.0), 0.0, 1.0e-9) && approx(st(0.3), 0.25, 1.0e-9), "steps(4) quantizes")
}

test "physics_rubber_band_projection_and_detents" {
  let r0 = rubber_band(0.0, 200.0)
  debug_assert(approx(r0, 0.0, 1.0e-9), "rubber_band(0) == 0")
  let r1 = rubber_band(100.0, 200.0)
  debug_assert(r1 > 0.0 && r1 < 100.0, "rubber_band dampens displacement")
  let r_neg = rubber_band(-100.0, 200.0)
  debug_assert(approx(r_neg, -r1, 1.0e-9), "rubber_band is odd/symmetric")
  let r_big = rubber_band(100000.0, 200.0)
  debug_assert(r_big < 200.0 && r_big > 195.0, "rubber_band asymptotically approaches dimension")

  let land = project_landing(100.0, 1000.0)
  debug_assert(approx(land, 599.0, 0.5), "project_landing at 0.998 decel_rate projects +499pt")

  let detents = [0.0, 300.0, 600.0]
  let idx = snap_detent(100.0, 1000.0, detents)
  let is_two = match idx {
    Some(i) => i == 2
    None => false
  }
  debug_assert(is_two, "high velocity fling snaps to 600.0 detent")
  let closed = snap_detent(500.0, 1000.0, detents, close_past=700.0)
  debug_assert(closed.is_none(), "landing past close_past returns None")
}

test "motion_generators_spring_inertia_keyframes" {
  let sg = spring_generator(0.0, 100.0, stiffness=200.0, damping=20.0, mass=1.0)
  let s0 = sg.next(0.0)
  debug_assert(approx(s0.value, 0.0, 1.0e-6) && !s0.done, "spring starts at 0")
  let dur = calc_generator_duration(sg)
  debug_assert(dur > 100.0 && dur < 5000.0, "spring generator settles within finite duration")
  let s_end = sg.next(dur + 50.0)
  debug_assert(s_end.done && approx(s_end.value, 100.0, 1.0e-6), "spring generator settles at 100")

  let ig = inertia_generator(0.0, velocity=500.0, power=0.8, time_constant=325.0, min=0.0, max=200.0)
  let idur = calc_generator_duration(ig)
  debug_assert(idur > 0.0 && idur < 10000.0, "bounded inertia settles")
  let iend = ig.next(idur + 100.0)
  debug_assert(approx(iend.value, 200.0, 1.0), "inertia clamped by max boundary spring")

  let kg = keyframes_generator([0.0, 50.0, 100.0], duration=200.0, ease=linear)
  debug_assert(approx(kg.next(100.0).value, 50.0, 1.0e-6), "keyframes midpoint")
  debug_assert(kg.next(200.0).done && approx(kg.next(200.0).value, 100.0, 1.0e-6), "keyframes end")
}

test "velocity_capsule_and_edge_pull" {
  let idle = velocity_capsule(40.0, 24.0, 0.0, 0.0)
  debug_assert(idle.dw == 0.0 && idle.dh == 0.0, "still capsule has zero deformation")
  let fast = velocity_capsule(40.0, 24.0, 1200.0, 0.0)
  debug_assert(fast.dw > 0.0 && fast.dh < 0.0, "horizontal velocity stretches width and thins height")

  let ep = EdgePull::new(limit=10.0)
  debug_assert(!ep.taken(), "EdgePull starts at rest")
  ep.drag(20.0, 50.0, 200.0)
  debug_assert(ep.taken(), "EdgePull is taken during drag")
  debug_assert(should_dismiss(120.0, 0.0, 100.0), "offset past threshold dismisses")
  debug_assert(!should_dismiss(120.0, -600.0, 100.0), "strong opposite fling cancels dismiss")
}

test "choreography_and_serial_queue" {
  ui::set_reduced_motion(Some(false))
  let ch = Choreography::new([
    TrackSpec::{ name: "bg", forward: tween(100.0, ease=ui::Ease::Out), backward: tween(80.0, ease=ui::Ease::Leave) },
    TrackSpec::{ name: "card", forward: tween(150.0, ease=ui::Ease::Out, delay=50.0), backward: tween(100.0, ease=ui::Ease::Leave) },
  ])
  ch.start(10.0)
  debug_assert(approx(ch.value_at("card", 30.0), 0.0, 1.0e-9), "delayed track holds at 0 during delay")
  debug_assert(ch.value_at("bg", 60.0) > 0.4, "un-delayed track advances")
  debug_assert(approx(ch.ends_at(), 210.0, 1.0e-6), "choreography ends at max track end (10 + 50 + 150)")

  // Reverse mid-flight
  let card_mid = ch.value_at("card", 120.0)
  ch.reverse(120.0)
  debug_assert(approx(ch.value_at("card", 120.0), card_mid, 1.0e-6), "reverse starts continuously from mid-flight value")
  debug_assert(approx(ch.value_at("card", 250.0), 0.0, 1.0e-6), "reverse settles at 0")

  let q = SerialQueue::new()
  let t1 = q.next_at("a", 0.0)
  debug_assert(approx(t1, 0.0, 1.0e-9), "first item starts at 0")
  q.commit("a", 200.0)
  debug_assert(approx(q.next_at("a", 50.0), 50.0, 1.0e-9), "same source runs immediately")
  debug_assert(approx(q.next_at("b", 50.0, lead=20.0), 180.0, 1.0e-9), "different source queues behind tail minus lead")
}

test "node_way_and_hover_fade_in_tester_tree" {
  ui::set_reduced_motion(Some(false))
  let active = signals::signal(false)
  let sampled : ui::Ref[Double] = ui::ref_new(-1.0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = root.box(fn(v : view::View) -> Unit {
      let fade = hover_fade(v, fn() -> Bool { active.get() }, duration_ms=100.0)
      let _ = v.alpha(view::Live::By(fn() -> Double {
        let fv = fade()
        sampled.v = fv
        fv
      }))
    })
  }, transitions_only=false)
  debug_assert(approx(sampled.v, 0.0, 1.0e-6), "hover_fade settles at initial 0.0")
  active.set(true)
  t.frame(ms=50.0)
  debug_assert(sampled.v > 0.2 && sampled.v < 0.99, "hover_fade interpolates mid-way at 50ms")
  t.run_shown(120.0)
  debug_assert(approx(sampled.v, 1.0, 1.0e-6), "hover_fade settles at 1.0 after duration")
  t.dispose()
}

test "zoom_fit_pan_and_double_tap" {
  ui::set_reduced_motion(Some(false))
  let z = Zoom::new(max_factor=4.0)
  z.boxed(400.0, 300.0, at=0.0)
  z.natural(800.0, 600.0, at=0.0)
  debug_assert(z.sized(), "Zoom is sized")
  debug_assert(approx(z.fit(), 0.5, 1.0e-6), "800x600 in 400x300 fits at 0.5")
  debug_assert(!z.zoomed_at(0.0), "not zoomed initially")
  z.double_tap(200.0, 150.0, at=0.0)
  debug_assert(z.zoomed_at(400.0), "double_tap zooms in")
  debug_assert(approx(z.scale_at(1000.0), 1.25, 1.0e-3), "double_tap settles at 2.5x fit")
  z.double_tap(200.0, 150.0, at=1000.0)
  debug_assert(!z.zoomed_at(2000.0), "second double_tap resets to fit")
}

test "trans_ground_first_and_presets" {
  let l0 = pop_in.at(0.0, 0.0)
  debug_assert(approx(l0.alpha, 0.0, 1.0e-6) && approx(l0.words, 0.0, 1.0e-6), "pop_in at 0 is invisible")
  let l_half = pop_in.at(0.5, 0.5)
  debug_assert(approx(l_half.alpha, 1.0, 1.0e-6) && approx(l_half.words, 0.0, 1.0e-6), "ground_first ground opaque before words")
  let l1 = pop_in.at(1.0, 1.0)
  debug_assert(approx(l1.alpha, 1.0, 1.0e-6) && approx(l1.words, 1.0, 1.0e-6) && approx(l1.sx, 1.0, 1.0e-6), "pop_in at 1 is full")
  debug_assert(sheet_drag_closes(200.0, 1.5, 100.0), "sheet_drag_closes when flung past line")
  let (s1, s2, s3) = glass_lens_springs()
  debug_assert(spec_duration(s1, 0.0, 1.0, 0.0) > 0.0 && spec_duration(s2, 0.0, 1.0, 0.0) > 0.0 && spec_duration(s3, 0.0, 1.0, 0.0) > 0.0, "glass_lens_springs are valid")
}

test "presets: glass_pop keeps shell and content in step at every progress" {
  debug_assert(pop_in.ground_first, "pop_in keeps ground_first=true for solid surfaces")
  debug_assert(!glass_pop_in.ground_first, "glass_pop_in must have ground_first=false")
  debug_assert(!glass_pop_out.ground_first, "glass_pop_out must have ground_first=false")
  let ps = [0.0, 0.25, 0.5, 0.75, 1.0]
  for p in ps {
    let li = glass_pop_in.at(p, p)
    let lo = glass_pop_out.at(p, p)
    debug_assert(approx(li.words, 1.0, 1.0e-9) && approx(li.alpha, p, 1.0e-9), "glass_pop_in sync fade")
    debug_assert(approx(lo.words, 1.0, 1.0e-9) && approx(lo.alpha, p, 1.0e-9), "glass_pop_out sync fade")
  }
}

test "presets: glass_pop_out dissolves evenly over 60fps frames with no final cliff" {
  ui::set_reduced_motion(Some(false))
  let way = Way::new(1.0)
  way.go(0.0, glass_pop_out.spec, at=0.0)
  let frames = [0.0, 16.67, 33.33, 50.0, 66.67, 83.33, 100.0]
  let values : Array[Double] = []
  for ms in frames {
    values.push(way.value_at(ms))
  }
  for i in 1..<values.length() {
    debug_assert(values[i] < values[i - 1], "glass_pop_out must decrease strictly on frame \{i}")
  }
  debug_assert(values[3] >= 0.45 && values[3] <= 0.55, "glass_pop_out midpoint near 0.5")
  debug_assert(values[5] < 0.10, "glass_pop_out near 0 at 83.33ms")
  debug_assert(approx(values[6], 0.0, 1.0e-9), "glass_pop_out finishes at 0.0")
}

test "tools: overlay_presence with glass_pop closed midway never brightens" {
  ui::set_reduced_motion(Some(false))
  let open = signals::signal(true)
  let look_now : ui::Ref[Option[ui::Look]] = ui::ref_new(None)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    root.show(fn() { open.get() }, leave=pop_out_ms * 2.0, fn(s : view::View) -> Unit {
      let (look, _) = overlay_presence(s, enter=glass_pop_in, exit=glass_pop_out)
      let _ = s
        .alpha(view::Live::By(fn() -> Double {
          let l = look()
          look_now.v = Some(l)
          l.alpha
        }))
        .words(view::Live::Is("玻璃"))
    })
  }, transitions_only=false)
  t.run_shown(pop_ms / 2.0)
  let mid = match look_now.v {
    Some(m) => m
    None => { debug_assert(false, "expected look midway in"); return }
  }
  debug_assert(mid.alpha > 0.0 && mid.alpha < 1.0, "midway in alpha strictly between 0 and 1")
  debug_assert(approx(mid.words, 1.0, 1.0e-9), "midway in words == 1.0")

  open.set(false)
  t.frame()
  let closed = match look_now.v {
    Some(c) => c
    None => { debug_assert(false, "expected look on closing"); return }
  }
  debug_assert(closed.alpha <= mid.alpha, "closing midway must never brighten")
  debug_assert(approx(closed.words, 1.0, 1.0e-9), "closing words == 1.0")

  let mut last = closed.alpha
  let mut k = 0
  while k < 5 {
    t.run_shown(pop_out_ms / 5.0)
    let l = match look_now.v {
      Some(v) => v
      None => { debug_assert(false, "expected look on way out"); return }
    }
    debug_assert(l.alpha <= last + 1.0e-9, "way out alpha must be non-increasing")
    debug_assert(approx(l.words, 1.0, 1.0e-9), "way out words == 1.0")
    last = l.alpha
    k += 1
  }
  debug_assert(approx(last, 0.0, 1.0e-6), "way out reaches 0.0")
  t.run_shown(pop_out_ms * 1.5)
  debug_assert(t.find("玻璃").is_none(), "overlay unmounted after leave")
  t.dispose()
}
