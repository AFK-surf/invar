// Closed-form horizontal rejection shake (ShakeWay).
// Ported from libs/mbui/src/motion/shake_way.mbt.

import "dmath"
import "signals"
import "ui"
import "view"

pub struct ShakeWay {
  pub amplitude : Double
  pub duration_ms : Double
  pub cycles : Double
  mut has_started : Bool
  mut start_time : Double
  rev : signals::Signal[Int]
  ended : signals::Signal[Int]
}

pub fn ShakeWay::new(
  amplitude~ : Double = 4.0,
  duration_ms~ : Double = 280.0,
  cycles~ : Double = 3.0,
) -> ShakeWay {
  ShakeWay::{
    amplitude,
    duration_ms,
    cycles,
    has_started: false,
    start_time: 0.0,
    rev: signals::signal(0),
    ended: signals::signal(0),
  }
}

pub fn ShakeWay::shake(self : ShakeWay, at~ : Double = 0.0, loc~ : String = "") -> Unit {
  let _ = loc
  self.has_started = true
  self.start_time = at
  self.rev.set(self.rev.untracked() + 1)
}

pub fn ShakeWay::active_at(self : ShakeWay, now : Double, reduced_motion? : Bool) -> Bool {
  let _ = self.rev.get()
  let rm = match reduced_motion { Some(r) => r; None => ui::reduced_motion() }
  if rm || !self.has_started {
    return false
  }
  now >= self.start_time && now < self.start_time + self.duration_ms
}

pub fn ShakeWay::offset_at(self : ShakeWay, now : Double, reduced_motion? : Bool) -> Double {
  if !self.active_at(now, reduced_motion?=reduced_motion) {
    return 0.0
  }
  let p = (now - self.start_time) / self.duration_ms
  self.amplitude * (1.0 - p) * dmath::sin(p * self.cycles * two_pi)
}

pub fn ShakeWay::shakes(
  self : ShakeWay,
  v : view::View,
  reduced_motion? : Bool,
  loc~ : String = "",
) -> view::View {
  let goes = fn(t : Double) -> Bool { self.active_at(t, reduced_motion?=reduced_motion) }
  let due : signals::Ref[Option[() -> Unit]] = ui::ref_new(None)
  let stop_due = fn() -> Unit {
    match due.v {
      Some(f) => {
        due.v = None
        f()
      }
      None => ()
    }
  }
  v.reacts(fn() -> Int { self.rev.get() }, fn(_r : Int) -> Unit {
    stop_due()
    let rm = match reduced_motion { Some(r) => r; None => ui::reduced_motion() }
    if rm || !self.has_started || self.duration_ms <= 0.0 || !v.alive() {
      return
    }
    let unkeep : signals::Ref[Option[() -> Unit]] = ui::ref_new(None)
    let drop_unkeep = fn() -> Unit {
      match unkeep.v {
        Some(f) => {
          unkeep.v = None
          f()
        }
        None => ()
      }
    }
    let stop_moment = v.at_moment(self.start_time + self.duration_ms, fn() -> Unit {
      drop_unkeep()
      due.v = None
      self.ended.set(self.ended.untracked() + 1)
    })
    unkeep.v = Some(v.owns_while(fn() -> Unit {
      unkeep.v = None
      stop_moment()
      due.v = None
    }))
    due.v = Some(fn() -> Unit {
      drop_unkeep()
      stop_moment()
      due.v = None
    })
  })
  v.shakes_while(goes).offset(
    view::Live::By(fn() -> (Double, Double) {
      let _ = self.ended.get()
      let at = v.drawn_while(goes)
      let x = self.offset_at(at, reduced_motion?=reduced_motion)
      (x, 0.0)
    }),
    loc=loc,
  )
}
