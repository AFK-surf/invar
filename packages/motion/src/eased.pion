///|
/// Off to `to` over `ms` (eased out, or as `ease` says, `delay` ms after `n`'s cause's moment), from where it is then;
/// its end a moment of `n`'s, said by its caller (`loc`: whose that moment is, a wake of its own).

pub fn Eased::go(self : Eased, n : view::View, to : Double, ms : Double, ease? : ui::Ease, delay? : Double, loc~ : String = "") -> Unit {
  let ease = match ease { Some(__mbt_v) => __mbt_v, None => .Out }
  let delay = match delay { Some(__mbt_v) => __mbt_v, None => 0.0 }

  self.go_by(n, to, tween(ms, ease=ease, delay=delay), loc=loc)
