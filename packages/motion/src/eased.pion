// Eased look property motion bound to a node timeline.
// Ported from libs/mbui/src/motion/eased.mbt.

import "signals"
import "ui"
import "view"

pub struct Eased {
  pub way : Way
  pub ended : signals::Signal[Int]
  pub mut due : () -> Unit
}

pub fn Eased::new(v : Double) -> Eased {
  Eased::{ way: Way::new(v), ended: signals::signal(0), due: fn() -> Unit { () } }
}

pub fn Eased::go(
  self : Eased,
  n : view::View,
  to : Double,
  ms : Double,
  ease~ : ui::Ease = ui::Ease::Out,
  delay~ : Double = 0.0,
  loc~ : String = "",
) -> Unit {
  self.go_by(n, to, tween(ms, ease=ease, delay=delay), loc=loc)
}

pub fn Eased::go_by(
  self : Eased,
  n : view::View,
  to : Double,
  spec : Spec,
  velocity? : Double,
  loc~ : String = "",
) -> Unit {
  if self.way.target() == to {
    return
  }
  (self.due)()
  self.way.go(to, spec, at=n.cause_at(), velocity?=velocity, loc=loc)
  self.due = if self.way.ends_at() >= 0.0 {
    n.at_moment(self.way.end(), fn() -> Unit { self.ended.set(self.ended.untracked() + 1) })
  } else {
    fn() -> Unit { () }
  }
}

pub fn Eased::go_from(
  self : Eased,
  n : view::View,
  from : Double,
  to : Double,
  spec : Spec,
  loc~ : String = "",
) -> Unit {
  (self.due)()
  self.way.put(from, loc=loc)
  self.way.go(to, spec, at=n.cause_at(), loc=loc)
  self.due = if self.way.ends_at() >= 0.0 {
    n.at_moment(self.way.end(), fn() -> Unit { self.ended.set(self.ended.untracked() + 1) })
  } else {
    fn() -> Unit { () }
  }
}

pub fn Eased::put(self : Eased, v : Double) -> Unit {
  (self.due)()
  self.due = fn() -> Unit { () }
  self.way.put(v)
}

pub fn Eased::end(self : Eased) -> Double {
  self.way.end()
}

pub fn Eased::target(self : Eased) -> Double {
  self.way.said()
  self.way.target()
}

pub fn Eased::shown(self : Eased, n : view::View) -> Double {
  let _ = self.ended.get()
  self.way.shown_on(n)
}

pub fn Eased::motion(self : Eased, n : view::View) -> (Double, Double) {
  let _ = self.ended.get()
  self.way.motion_on(n)
}

pub fn eased_on(n : view::View, on : () -> Bool, spec : Spec) -> Eased {
  let init = if signals::untracked(on) { 1.0 } else { 0.0 }
  let e = Eased::new(init)
  n.reacts(on, fn(now : Bool) -> Unit {
    e.go_by(n, if now { 1.0 } else { 0.0 }, spec)
  })
  e
}
