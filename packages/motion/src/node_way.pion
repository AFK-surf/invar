// Node-bound closed-form motion (NodeWay): arms declared end on View::at_moment with automatic cleanup.
// Ported from libs/mbui/src/motion/node_way.mbt.

import "signals"
import "ui"
import "view"

pub struct NodeWay {
  way : Way
  ended : signals::Signal[Int]
  mut due : Option[() -> Unit]
}

pub fn NodeWay::new(v : Double) -> NodeWay {
  NodeWay::{ way: Way::new(v), ended: signals::signal(0), due: None }
}

fn NodeWay::arm(self : NodeWay, n : view::View) -> Unit {
  if self.way.ends_at() >= 0.0 && n.alive() {
    let unkeep : ui::Ref[Option[() -> Unit]] = ui::ref_new(None)
    let drop_unkeep = fn() -> Unit {
      match unkeep.v {
        Some(f) => {
          unkeep.v = None
          f()
        }
        None => ()
      }
    }
    let stop_moment = n.at_moment(self.way.end(), fn() -> Unit {
      drop_unkeep()
      self.due = None
      self.ended.set(self.ended.untracked() + 1)
    })
    unkeep.v = Some(n.owns_while(fn() -> Unit {
      unkeep.v = None
      stop_moment()
      self.due = None
    }))
    self.due = Some(fn() -> Unit {
      drop_unkeep()
      stop_moment()
      self.due = None
    })
  } else {
    self.due = None
  }
}

pub fn NodeWay::stop(self : NodeWay) -> Unit {
  match self.due {
    Some(d) => {
      self.due = None
      d()
    }
    None => ()
  }
}

pub fn NodeWay::go(
  self : NodeWay,
  n : view::View,
  to : Double,
  spec : Spec,
  velocity? : Double,
  loc~ : String = "",
) -> Unit {
  let no_vel = match velocity { None => true; Some(_) => false }
  if self.way.target() == to && no_vel {
    return
  }
  self.stop()
  self.way.go(to, spec, at=n.cause_at(), velocity?=velocity, loc=loc)
  self.arm(n)
}

pub fn NodeWay::go_ms(
  self : NodeWay,
  n : view::View,
  to : Double,
  ms : Double,
  ease~ : ui::Ease = ui::Ease::Out,
  loc~ : String = "",
) -> Unit {
  self.go(n, to, tween(ms, ease=ease), loc=loc)
}

pub fn NodeWay::put_at(
  self : NodeWay,
  n : view::View,
  from : Double,
  to : Double,
  spec : Spec,
  at : Double,
  loc~ : String = "",
) -> Unit {
  self.stop()
  let (_, v) = self.way.at(at)
  self.way.put(from, loc=loc)
  self.way.go(to, spec, at=at, velocity=v, loc=loc)
  self.arm(n)
}

pub fn NodeWay::go_from(
  self : NodeWay,
  n : view::View,
  from : Double,
  to : Double,
  spec : Spec,
  at? : Double,
  loc~ : String = "",
) -> Unit {
  self.stop()
  let start = match at { Some(t) => t; None => n.cause_at() }
  self.way.put(from, loc=loc)
  self.way.go(to, spec, at=start, loc=loc)
  self.arm(n)
}

pub fn NodeWay::put(self : NodeWay, v : Double, loc~ : String = "") -> Unit {
  self.stop()
  self.way.put(v, loc=loc)
}

pub fn NodeWay::value_at(self : NodeWay, t : Double) -> Double {
  self.way.value_at(t)
}

pub fn NodeWay::goes_at(self : NodeWay, t : Double) -> Bool {
  self.way.goes_at(t)
}

pub fn NodeWay::target(self : NodeWay) -> Double {
  self.way.said()
  self.way.target()
}

pub fn NodeWay::end(self : NodeWay) -> Double {
  self.way.end()
}

pub fn NodeWay::ends_at(self : NodeWay) -> Double {
  self.way.ends_at()
}

pub fn NodeWay::goes(self : NodeWay, n : view::View) -> Bool {
  self.way.said()
  let _ = self.ended.get()
  n.goes_now(fn(at : Double) -> Bool { self.way.goes_at(at) })
}

pub fn NodeWay::shown(self : NodeWay, n : view::View) -> Double {
  let _ = self.ended.get()
  self.way.shown_on(n)
}

pub fn NodeWay::starts_at(self : NodeWay) -> Double {
  self.way.starts_at()
}

pub fn NodeWay::motion(self : NodeWay, n : view::View) -> (Double, Double) {
  let _ = self.ended.get()
  self.way.motion_on(n)
}
