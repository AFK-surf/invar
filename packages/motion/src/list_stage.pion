      due.push(k)
    }
  }, None => break } } }
  if due.is_empty() {
    return StageReleaseResult::{
      visible: self.visible_cache,
      released: [],
      released_lingers: [],
      rescheduled: [],
      next_due: self.next_due_at(),
    }
  }
  if self.barrier_until > now {
    let rescheduled : Array[(String, Double)] = []
    for k in due {
      let p = mbt_compat::opt_unwrap(self.held.get(k))
      self.held.set(k, StageHoldPlan::{ ..p, release_at: self.barrier_until })
      rescheduled.push((k, self.barrier_until))
    }
    return StageReleaseResult::{
      visible: self.visible_cache,
      released: [],
      released_lingers: [],
      rescheduled: rescheduled,
      next_due: self.next_due_at(),
    }
  }
  let released : Array[String] = []
  let cand_lingers : Array[String] = []
  for k in due {
    let p = mbt_compat::opt_unwrap(self.held.get(k))
    self.held.remove(k)
    released.push(k)
    match p.linger_key {
      Some(lk) => if !cand_lingers.contains(lk) { cand_lingers.push(lk) }
      Option::None => ()
    }
