    }
    if has_catch_up {
      .CatchUp
    } else if has_local_send {
      .LocalSend
    } else if has_live {
      .LivePush
    } else {
      let mut has_live_removed = false
      for i in (first_kept + 1)..<was.length() {
        let k = was[i]
        if !mbt_compat::ordered_map_contains_mapkey(seen, k) && is_live_removable(k) {
          has_live_removed = true
          break
        }
      }
      if has_live_removed {
        .LivePush
      } else if prepended {
        .PageOlder
      } else {
        .CatchUp
      }
    }
  }
  self.last_origin = origin
  origin
}
