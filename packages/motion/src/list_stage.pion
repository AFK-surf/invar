  let is_anchor = match is_anchor { Some(__mbt_v) => __mbt_v, None => fn(_) { true } }

  StageOriginTracker::{ is_anchor: is_anchor, judged: Option::None, last_origin: .Initial, had: [], settled: false }
}

///|
