  let released_lingers : Array[String] = []
  for lk in cand_lingers {
    if !stage_has_linger_owner(self.held, lk) {
      self.lingering.remove(lk)
      released_lingers.push(lk)
    }
  }
  let visible = self.project_visible(self.raw_was)
  StageReleaseResult::{ visible: visible, released: released, released_lingers: released_lingers, rescheduled: [], next_due: self.next_due_at() }
}

///|
/// Immediately release all held items and lingering anchors, marking flushed keys.
pub fn ListStage::flush(self : ListStage) -> StageFlushResult {
  let flushed = mbt_compat::ordered_map_keys_iter(self.held).collect()
  let flushed_lingers = mbt_compat::ordered_map_keys_iter(self.lingering).collect()
  for k in flushed {
    self.flushed.set(k, true)
  }
  self.held.clear()
  self.lingering.clear()
  self.bridged.clear()
  let visible = self.project_visible(self.raw_was)
  StageFlushResult::{ visible: visible, flushed: flushed, flushed_lingers: flushed_lingers }
}

///|
