test "sha256: the standard's examples" {
  { let __mbt_aa_16 = sha256("".to_bytes()); let __mbt_aa_17 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"; if !(__mbt_aa_16 == __mbt_aa_17) { panic("assert_eq failed at zip_test.mbt:104") } }
  { let __mbt_aa_18 = sha256("abc".to_bytes()); let __mbt_aa_19 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"; if !(__mbt_aa_18 == __mbt_aa_19) { panic("assert_eq failed at zip_test.mbt:105") } }
  { let __mbt_aa_20 = sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()); let __mbt_aa_21 = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"; if !(__mbt_aa_20 == __mbt_aa_21) { panic("assert_eq failed at zip_test.mbt:106") } }
}
