///|
test "stored blocks: two, the first as long as one can be" {
  let data = mbt_compat::bytes_makei(70000, fn(i) { ((i * 37 + 11) % 256).to_byte() })
  let gz : Array[Byte] = [31.to_byte(), 139.to_byte(), 8.to_byte(), 0.to_byte(), 0.to_byte(), 0.to_byte(), 0.to_byte(), 0.to_byte(), 0.to_byte(), 3.to_byte()]
  let le = fn(v : Int, k : Int) { for i in 0..<k { gz.push(((v >> (8 * i)) & 255).to_byte()) } }
  let mut at = 0
  while at < data.length() {
    let len = if data.length() - at > 65535 { 65535 } else { data.length() - at }
    gz.push((if at + len == data.length() { 1 } else { 0 }).to_byte())
    le(len, 2)
    le(len ^ 0xFFFF, 2)
    for i in 0..<len {
      gz.push(data[at + i])
    }
    at += len
  }
  le(crc32(data).reinterpret_as_int(), 4)
  le(data.length(), 4)
  let out = mbt_compat::opt_unwrap(gunzip(mbt_compat::bytes_from_array(gz)))
  { let __mbt_aa_14 = sha256(out); let __mbt_aa_15 = "3c43d02a5c493c6c534dda8983b3da6d13cf36f155491e4d6553c0a88f5b817d"; if !(__mbt_aa_14 == __mbt_aa_15) { panic("assert_eq failed at zip_test.mbt:99") } }
}

