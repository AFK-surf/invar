import "codec"
import "mbt_compat"

// Unzipping (inflate.mbt) and hashing (sha256.mbt) against what Python's gzip, zlib and hashlib make of the same.

///|
test "a short text, in deflate's fixed codes" {
  let out = mbt_compat::opt_unwrap(gunzip(codec::from_base64("H4sIAAAAAAAC/8tIzcnJ11HIQKKsFAz8FQxzPAFXvYeJGwAAAA==")))
  { let __mbt_aa_1 = out; let __mbt_aa_2 = "hello, hello, hello: 0O 1lI".to_bytes(); if !(mbt_compat::bytes_eq(__mbt_aa_1, __mbt_aa_2)) { panic("assert_eq failed at zip_test.mbt:6") } }
  { let __mbt_aa_3 = crc32(out); let __mbt_aa_4 = 2307374423U; if !(__mbt_aa_3 == __mbt_aa_4) { panic("assert_eq failed at zip_test.mbt:7") } }
}

///|
test "nothing gzipped" {
  { let __mbt_aa_5 = mbt_compat::opt_unwrap(gunzip(codec::from_base64("H4sIAAAAAAAC/wMAAAAAAAAAAAA="))).length(); let __mbt_aa_6 = 0; if !(__mbt_aa_5 == __mbt_aa_6) { panic("assert_eq failed at zip_test.mbt:12") } }
}

