    "mocgledTYySF8ZWCoGrwqsjTW9CCSmmV4DEpaZJCBUBEYFyJSASQCh6f5t6f5iE87yjoDYlHPv1NlYoJwbdTpdjv5OnY0O0lcHlgadrwwszTe9" +
    "CiRKQScCgULQayA0ErhHCchMNaMCZCabRQBioJm7v9T1X94RELv8eaPOxgK5btTZoCBde3U2OogfHVgpB18ZBPOo89+psxHB04lAYJoZNSAz0Q" +
    "wSECkCowJkSsAsAKkCMHd/qQln846AD0w596pOveX4fy/yp07bNwAA"
  let gz = codec::from_base64(b64)
  match gunzip(gz) {
    Some(out) => {
      debug_assert(out.length() == 14299, "gunzip len 14299")
      debug_assert(
        sha256(out) == "d3d71d0bccdde270e0eaebdd8659a8703392f402ad634cad6a726d5c4d1acca9",
        "sha256 match",
      )
    }
    None => debug_assert(false, "expected Some")
  }
  // Corrupt byte 1000
  let sb = StringBuilder::new()
  for i in 0..<gz.length() {
    let v = gz[i].to_int()
    if i == 1000 {
      sb.write_byte((v ^ 0x55) as Byte)
    } else {
      sb.write_byte(v as Byte)
    }
  }
  debug_assert(gunzip(sb.to_string().to_bytes()).is_none(), "corrupt rejected")
  debug_assert(gunzip(gz.slice(0, gz.length() - 100)).is_none(), "truncated rejected")
  debug_assert(gunzip("not gzip at all, not at all".to_bytes()).is_none(), "non-gzip rejected")
}

test "stored blocks: two blocks spanning 70000 bytes" {
  let dsb = StringBuilder::new()
  for i in 0..<70000 {
    dsb.write_byte(((i * 37 + 11) % 256) as Byte)
  }
  let data = dsb.to_string().to_bytes()
  let gsb = StringBuilder::new()
  let hdr = [0x1F, 0x8B, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03]
  for x in hdr {
    gsb.write_byte(x as Byte)
  }
  let mut at = 0
  while at < data.length() {
    let len = if data.length() - at > 65535 { 65535 } else { data.length() - at }
    let last = if at + len == data.length() { 1 } else { 0 }
    gsb.write_byte(last as Byte)
    gsb.write_byte((len & 255) as Byte)
    gsb.write_byte(((len >> 8) & 255) as Byte)
    let nlen = len ^ 0xFFFF
    gsb.write_byte((nlen & 255) as Byte)
    gsb.write_byte(((nlen >> 8) & 255) as Byte)
    for i in 0..<len {
      gsb.write_byte(data[at + i])
    }
    at += len
  }
  let c = crc32(data).to_int64()
  for i in 0..<4 {
    gsb.write_byte(((c >> (8 * i)) & 255.to_int64()).to_int() as Byte)
  }
  let sz = data.length()
  for i in 0..<4 {
    gsb.write_byte(((sz >> (8 * i)) & 255) as Byte)
  }
  match gunzip(gsb.to_string().to_bytes()) {
    Some(out) => {
      debug_assert(
        sha256(out) == "3c43d02a5c493c6c534dda8983b3da6d13cf36f155491e4d6553c0a88f5b817d",
        "70000 stored blocks sha256",
      )
    }
    None => debug_assert(false, "expected Some")
  }
}

test "sha256 standard FIPS 180-4 vectors" {
  debug_assert(sha256("".to_bytes()) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 empty")
  debug_assert(sha256("abc".to_bytes()) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc")
  debug_assert(
    sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_bytes()) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    "sha256 448-bit",
  )
}
