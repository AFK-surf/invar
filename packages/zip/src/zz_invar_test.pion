import "codec"

fn bytes_eq(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i].to_int() != b[i].to_int() {
      return false
    }
  }
  true
}

test "a short text in deflate fixed codes" {
  let raw = codec::from_base64("H4sIAAAAAAAC/8tIzcnJ11HIQKKsFAz8FQxzPAFXvYeJGwAAAA==")
  match gunzip(raw) {
    Some(out) => {
      debug_assert(bytes_eq(out, "hello, hello, hello: 0O 1lI".to_bytes()), "gunzip content")
      debug_assert(crc32(out).to_int64() == ((0x8987.to_int64() << 16) | 0xBD57.to_int64()), "crc32 match")
    }
    None => debug_assert(false, "expected Some")
  }
}

test "nothing gzipped" {
  let raw = codec::from_base64("H4sIAAAAAAAC/wMAAAAAAAAAAAA=")
  match gunzip(raw) {
    Some(out) => debug_assert(out.length() == 0, "empty gunzip")
    None => debug_assert(false, "expected Some")
  }
}

