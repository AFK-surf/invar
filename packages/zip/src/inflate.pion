///|
/// The fixed block's codes (RFC 1951 3.2.6), made once.
// moved to 00_init_order.pion: fixed_codes

///|
fn fixed() -> (Huff, Huff) {
  match fixed_codes.v {
    Some(f) => f
    None => {
      let lens = FixedArray::make(288 + 30, 5)
      for i in 0..<288 {
        lens[i] = if i < 144 { 8 } else if i < 256 { 9 } else if i < 280 { 7 } else { 8 }
      }
      let f = (mbt_compat::opt_unwrap(huff(lens, 0, 288)), mbt_compat::opt_unwrap(huff(lens, 288, 30)))
      fixed_codes.v = Some(f)
      f
    }
  }
}

///|
/// What is being made: its bytes so far.
struct Out {
  mut buf : FixedArray[Byte]
  mut len : Int
  most : Int
}

///|
/// Whether `k` more bytes would take it past what it may come to.
fn Out::past_most(self : Out, k : Int) -> Bool {
  self.most > 0 && self.len + k > self.most
}

///|
fn Out::room(self : Out, k : Int) -> Unit {
  if self.len + k > self.buf.length() {
    let mut size = if self.buf.length() < 1024 { 1024 } else { self.buf.length() }
    while size < self.len + k {
      size = size * 2
    }
    let grown = FixedArray::make(size, 0.to_byte())
    self.buf.blit_to(grown, len=self.len)
    self.buf = grown
  }
}

///|
/// A dynamic block's two codes, read from its head; None where they are damaged.
fn dynamic(b : Bits) -> Option[(Huff, Huff)] {
  let nlen = b.take(5) + 257
  let ndist = b.take(5) + 1
  let ncode = b.take(4) + 4
  if nlen > 286 || ndist > 30 {
    return Option::None
  }
  let clens = FixedArray::make(19, 0)
  for i in 0..<ncode {
    clens[clen_order[i]] = b.take(3)
  }
  let lencode = match huff(clens, 0, 19) {
    Option::Some(h) => h
    Option::None => return Option::None
  }
  let lens = FixedArray::make(nlen + ndist, 0)
  let mut i = 0
  while i < nlen + ndist {
    let sym = b.decode(lencode)
    if sym < 0 {
      return Option::None
    }
    if sym < 16 {
      lens[i] = sym
      i += 1
    } else {
      let (value, times) = match sym {
        16 => {
          if i == 0 {
            return Option::None
          }
          (lens[i - 1], 3 + b.take(2))
        }
        17 => (0, 3 + b.take(3))
        _ => (0, 11 + b.take(7))
      }
      if i + times > nlen + ndist {
        return Option::None
      }
      for _ in 0..<times {
        lens[i] = value
        i += 1
      }
    }
  }
  // a block has an end
  if lens[256] == 0 {
    return Option::None
  }
  match (huff(lens, 0, nlen), huff(lens, nlen, ndist)) {
    (Some(l), Some(d)) => Option::Some((l, d))
    _ => Option::None
  }
}

///|
/// A block's symbols to its end into `out`; false where they are damaged.
fn codes(b : Bits, out : Out, lencode : Huff, distcode : Huff) -> Bool {
  while true {
    let sym = b.decode(lencode)
    if sym < 0 || b.past_end() {
      return false
    }
    if sym < 256 {
      if out.past_most(1) {
        return false
      }
      out.room(1)
      out.buf[out.len] = sym.to_byte()
      out.len += 1
    } else if sym == 256 {
      return true
    } else {
      let s = sym - 257
      if s >= 29 {
        return false
      }
      let len = len_base[s] + b.take(len_extra[s])
      let d = b.decode(distcode)
      if d < 0 || d >= 30 {
        return false
      }
      let dist = dist_base[d] + b.take(dist_extra[d])
      if dist > out.len || out.past_most(len) {
        return false
      }
      out.room(len)
      let buf = out.buf
      let mut at = out.len
      for _ in 0..<len {
        buf[at] = buf[at - dist]
        at += 1
      }
      out.len = at
    }
  }
  false
}

///|
/// The bytes `data` deflated (raw: no zlib or gzip head) from `start`, made whole; `size`: how many they are said to
/// be, a hint. None where it is damaged or ends early.
pub fn inflate(data : Bytes, start? : Int, size? : Int) -> Option[Bytes] {
  let start = match start { Some(__mbt_v) => __mbt_v, None => 0 }
  let size = match size { Some(__mbt_v) => __mbt_v, None => 0 }

  mbt_compat::opt_map(inflate_at(data, start, size), fn(r) { r.0 })
}

///|
/// As inflate, for bytes from elsewhere: None too where they would come to more than `most` bytes.
pub fn inflate_most(data : Bytes, most : Int, start? : Int) -> Option[Bytes] {
  let start = match start { Some(__mbt_v) => __mbt_v, None => 0 }

  mbt_compat::opt_map(inflate_at(data, start, 0, most=most), fn(r) { r.0 })
}

///|
/// As inflate, and where the deflated bytes ended (the first byte after them).
fn inflate_at(data : Bytes, start : Int, size : Int, most? : Int) -> Option[(Bytes, Int)] {
  let most = match most { Some(__mbt_v) => __mbt_v, None => 0 }

  let b : Bits = Bits::{ data: data, at: start, buf: 0, n: 0, over: 0 }
  let out : Out = Out::{ buf: FixedArray::make(if size > 0 { size } else { 1024 }, 0.to_byte()), len: 0, most: most }
  while true {
    let last = b.take(1)
    let kind = b.take(2)
    match kind {
      0 => {
        // stored: from the next byte, its length and that length's complement, then the bytes as they are
        b.take(b.n % 8) |> ignore
        let len = b.take(16)
        let nlen = b.take(16)
        if (len ^ nlen) != 0xFFFF {
          return Option::None
        }
        if out.past_most(len) {
          return Option::None
        }
        out.room(len)
        for _ in 0..<len {
          out.buf[out.len] = b.take(8).to_byte()
          out.len += 1
        }
        if b.past_end() {
          return Option::None
        }
      }
      1 => {
        let (l, d) = fixed()
        if !codes(b, out, l, d) {
          return Option::None
        }
      }
      2 =>
      match dynamic(b) {
        Option::Some((l, d)) => if !codes(b, out, l, d) { return Option::None }
        Option::None => return Option::None
      }
      _ => return Option::None
    }
    if last == 1 {
      break
    }
  }
  if b.past_end() {
    return Option::None
  }
  // the bytes whole that are still in `buf` were not the deflated ones'
  Option::Some((mbt_compat::bytes_from_array(mbt_compat::fixed_array_slice_clamp(out.buf, 0, out.len)), b.at - b.n / 8))
}

///|
/// The file gzipped in `data` (RFC 1952: its first member), made whole; None where it is not gzip, is damaged, or its
/// size or CRC-32 is not what it says.
pub fn gunzip(data : Bytes) -> Option[Bytes] {
  let n = data.length()
  if n < 18 || data[0] != 31.to_byte() || data[1] != 139.to_byte() || data[2] != 8.to_byte() {
    return Option::None
  }
  let flags = data[3].to_int()
  let mut at = 10
  // FEXTRA: its length, then it
  if (flags & 4) != 0 {
    if at + 2 > n {
      return Option::None
    }
    at += 2 + (data[at].to_int() | (data[at + 1].to_int() << 8))
  }
  // FNAME, FCOMMENT: each to its zero
  for flag in [8, 16] {
    if (flags & flag) != 0 {
      while at < n && data[at] != 0.to_byte() {
        at += 1
      }
      at += 1
    }
  }
  // FHCRC
  if (flags & 2) != 0 {
    at += 2
  }
  if at >= n {
    return Option::None
  }
  let said = le32(data, n - 4)
  match inflate_at(data, at, said) {
    Option::Some((out, end)) => {
      if end + 8 > n || le32(data, end + 4) != out.length() || crc32(out) != le32(data, end).reinterpret_as_uint() {
        return Option::None
      }
      Option::Some(out)
    }
    Option::None => Option::None
  }
}

///|
fn le32(data : Bytes, at : Int) -> Int {
  data[at].to_int() |
  (data[at + 1].to_int() << 8) |
  (data[at + 2].to_int() << 16) |
  (data[at + 3].to_int() << 24)
}

///|
// moved to 00_init_order.pion: crc_table

///|
/// The CRC-32 of `data` (gzip's, zlib's crc32).
pub fn crc32(data : Bytes) -> UInt {
  let mut c = 0xFFFFFFFFU
  for i in 0..<data.length() {
    c = crc_table[((c ^ mbt_compat::byte_to_uint(data[i])) & 0xFFU).reinterpret_as_int()] ^ (c >> 8)
  }
  c ^ 0xFFFFFFFFU
}
