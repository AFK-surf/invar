// SHA-256 (FIPS 180-4) using Int64 unsigned 32-bit arithmetic.
// Ported from libs/mbui/src/zip/sha256.mbt.

fn u32_hi(hi16 : Int, lo16 : Int) -> Int64 {
  (hi16.to_int64() << 16) | lo16.to_int64()
}

fn sha_k_table() -> Array[Int64] {
  [
    u32_hi(0x428A, 0x2F98), u32_hi(0x7137, 0x4491), u32_hi(0xB5C0, 0xFBCF), u32_hi(0xE9B5, 0xDBA5),
    u32_hi(0x3956, 0xC25B), u32_hi(0x59F1, 0x11F1), u32_hi(0x923F, 0x82A4), u32_hi(0xAB1C, 0x5ED5),
    u32_hi(0xD807, 0xAA98), u32_hi(0x1283, 0x5B01), u32_hi(0x2431, 0x85BE), u32_hi(0x550C, 0x7DC3),
    u32_hi(0x72BE, 0x5D74), u32_hi(0x80DE, 0xB1FE), u32_hi(0x9BDC, 0x06A7), u32_hi(0xC19B, 0xF174),
    u32_hi(0xE49B, 0x69C1), u32_hi(0xEFBE, 0x4786), u32_hi(0x0FC1, 0x9DC6), u32_hi(0x240C, 0xA1CC),
    u32_hi(0x2DE9, 0x2C6F), u32_hi(0x4A74, 0x84AA), u32_hi(0x5CB0, 0xA9DC), u32_hi(0x76F9, 0x88DA),
    u32_hi(0x983E, 0x5152), u32_hi(0xA831, 0xC66D), u32_hi(0xB003, 0x27C8), u32_hi(0xBF59, 0x7FC7),
    u32_hi(0xC6E0, 0x0BF3), u32_hi(0xD5A7, 0x9147), u32_hi(0x06CA, 0x6351), u32_hi(0x1429, 0x2967),
    u32_hi(0x27B7, 0x0A85), u32_hi(0x2E1B, 0x2138), u32_hi(0x4D2C, 0x6DFC), u32_hi(0x5338, 0x0D13),
    u32_hi(0x650A, 0x7354), u32_hi(0x766A, 0x0ABB), u32_hi(0x81C2, 0xC92E), u32_hi(0x9272, 0x2C85),
    u32_hi(0xA2BF, 0xE8A1), u32_hi(0xA81A, 0x664B), u32_hi(0xC24B, 0x8B70), u32_hi(0xC76C, 0x51A3),
    u32_hi(0xD192, 0xE819), u32_hi(0xD699, 0x0624), u32_hi(0xF40E, 0x3585), u32_hi(0x106A, 0xA070),
    u32_hi(0x19A4, 0xC116), u32_hi(0x1E37, 0x6C08), u32_hi(0x2748, 0x774C), u32_hi(0x34B0, 0xBCB5),
    u32_hi(0x391C, 0x0CB3), u32_hi(0x4ED8, 0xAA4A), u32_hi(0x5B9C, 0xCA4F), u32_hi(0x682E, 0x6FF3),
    u32_hi(0x748F, 0x82EE), u32_hi(0x78A5, 0x636F), u32_hi(0x84C8, 0x7814), u32_hi(0x8CC7, 0x0208),
    u32_hi(0x90BE, 0xFFFA), u32_hi(0xA450, 0x6CEB), u32_hi(0xBEF9, 0xA3F7), u32_hi(0xC671, 0x78F2),
  ]
}

fn rotr32(x : Int64, k : Int) -> Int64 {
  let mask = u32_mask()
  let ux = x & mask
  ((ux >> k) | (ux << (32 - k))) & mask
}

fn hex_nibble(v : Int) -> Byte {
  if v < 10 { (48 + v) as Byte } else { (87 + v) as Byte }
}

/// The SHA-256 of `data`, as 64 lowercase hex digits.
pub fn sha256(data : Bytes) -> String {
  let mask = u32_mask()
  let sha_k = sha_k_table()
  let h : Array[Int64] = [
    u32_hi(0x6A09, 0xE667), u32_hi(0xBB67, 0xAE85), u32_hi(0x3C6E, 0xF372), u32_hi(0xA54F, 0xF53A),
    u32_hi(0x510E, 0x527F), u32_hi(0x9B05, 0x688C), u32_hi(0x1F83, 0xD9AB), u32_hi(0x5BE0, 0xCD19),
  ]
  let n = data.length()
  let total = (n + 9 + 63) / 64 * 64
  let from = n / 64 * 64
  let tail_len = total - from
  let tail = make_int_arr(tail_len, 0)
  for i in from..<n {
    tail[i - from] = data[i].to_int()
  }
  tail[n - from] = 0x80
  let bits = n.to_int64() * 8.to_int64()
  for k in 0..<8 {
    tail[tail_len - 1 - k] = ((bits >> (8 * k)) & 0xFF.to_int64()).to_int()
  }
  let w : Array[Int64] = []
  for _ in 0..<64 {
    w.push(0.to_int64())
  }
  let mut at = 0
  while at < total {
    for t in 0..<16 {
      let i = at + t * 4
      let b0 = if i < from { data[i].to_int() } else { tail[i - from] }
      let b1 = if i + 1 < from { data[i + 1].to_int() } else { tail[i + 1 - from] }
      let b2 = if i + 2 < from { data[i + 2].to_int() } else { tail[i + 2 - from] }
      let b3 = if i + 3 < from { data[i + 3].to_int() } else { tail[i + 3 - from] }
      w[t] = (b0.to_int64() << 24) | (b1.to_int64() << 16) | (b2.to_int64() << 8) | b3.to_int64()
    }
    for t in 16..<64 {
      let s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ ((w[t - 15] >> 3) & mask)
      let s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ ((w[t - 2] >> 10) & mask)
      w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & mask
    }
    let mut a = h[0]
    let mut b = h[1]
    let mut c = h[2]
    let mut d = h[3]
    let mut e = h[4]
    let mut f = h[5]
    let mut g = h[6]
    let mut hh = h[7]
    for t in 0..<64 {
      let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
      let ch = (e & f) ^ ((e ^ mask) & g)
      let t1 = (hh + s1 + ch + sha_k[t] + w[t]) & mask
      let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
      let maj = (a & b) ^ (a & c) ^ (b & c)
      let t2 = (s0 + maj) & mask
      hh = g
      g = f
      f = e
      e = (d + t1) & mask
      d = c
      c = b
      b = a
      a = (t1 + t2) & mask
    }
    h[0] = (h[0] + a) & mask
    h[1] = (h[1] + b) & mask
    h[2] = (h[2] + c) & mask
    h[3] = (h[3] + d) & mask
    h[4] = (h[4] + e) & mask
    h[5] = (h[5] + f) & mask
    h[6] = (h[6] + g) & mask
    h[7] = (h[7] + hh) & mask
    at += 64
  }
  let sb = StringBuilder::new()
  for x in h {
    for k in 0..<8 {
      let d = ((x >> (28 - 4 * k)) & 15.to_int64()).to_int()
      sb.write_byte(hex_nibble(d))
    }
  }
  sb.to_string()
}
