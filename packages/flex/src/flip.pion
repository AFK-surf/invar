// FLIP offset animation trajectory (FlipItem, FlipWay).
// Ported from libs/mbui/src/flex/flip.mbt.

pub struct FlipItem {
  pub off : (Double, Double, Double, Double)
  pub v : (Double, Double, Double, Double)
}

pub struct FlipWay {
  pub at : Double
  pub far : Double
  pub v : Double
  pub said : Option[(Double, (Double) -> Double)]
}

pub fn FlipWay::new(at : Double, items : Array[FlipItem], said? : (Double, (Double) -> Double)) -> FlipWay {
  let mut far = 0.0
  let mut dot = 0.0
  let mut sq = 0.0
  for i in items {
    let (a, b, c, d) = i.off
    let (va, vb, vc, vd) = i.v
    far = fmax(far, fmax(fmax(a.abs(), b.abs()), fmax(c.abs(), d.abs())))
    dot += a * va + b * vb + c * vc + d * vd
    sq += a * a + b * b + c * c + d * d
  }
  let v = if sq > 0.0 { dot / sq * far } else { 0.0 }
  FlipWay::{ at, far, v, said }
}

pub fn FlipWay::left(self : FlipWay, now : Double) -> (Double, Double) {
  let t = time_gone(now, self.at)
  if self.far <= 0.0 {
    return (0.0, 0.0)
  }
  if t <= 0.0 {
    return (1.0, self.v / self.far)
  }
  match self.said {
    Some((ms, curve)) => {
      if ms > 0.0 {
        if t >= ms {
          return (0.0, 0.0)
        }
        let x = t / ms
        let dx = 1.0e-4
        let p = curve(x)
        let slope = (curve(fmin(x + dx, 1.0)) - p) / (fmin(x + dx, 1.0) - x) / ms
        return (1.0 - p, -slope)
      }
      let (x, xv) = come_way(self.far, self.v, 0.0, t)
      (x / self.far, xv / self.far)
    }
    None => {
      let (x, xv) = come_way(self.far, self.v, 0.0, t)
      (x / self.far, xv / self.far)
    }
  }
}

pub fn FlipWay::ends(self : FlipWay) -> Double {
  if self.far <= 0.0 {
    return self.at
  }
  match self.said {
    Some((ms, _)) => if ms > 0.0 { self.at + ms } else { self.at + come_way_ms(self.far, self.v, 0.0) }
    None => self.at + come_way_ms(self.far, self.v, 0.0)
  }
}

pub fn FlipWay::drawn(
  self : FlipWay,
  i : FlipItem,
  now : Double,
) -> ((Double, Double, Double, Double), (Double, Double, Double, Double)) {
  let (k, kv) = self.left(now)
  let (a, b, c, d) = i.off
  ((a * k, b * k, c * k, d * k), (a * kv, b * kv, c * kv, d * kv))
}
