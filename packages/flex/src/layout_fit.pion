// Flexbox layout helpers: fit_flow, resolve_flexible, last_resort, absolute positioning, rounding, baselines.
// Ported from libs/mbui/src/flex/layout.mbt (part 2).

fn fit_flow(flow : Array[Node], room : Double, gap : Double, cb_w : Double, cb_h : Double) -> Array[Node] {
  let n = flow.length()
  let (need, more) = fit_needs(flow, cb_w, cb_h)
  let mut total = 0.0
  let mut count = 0
  for j, c in flow {
    if !pos_eq(c.style.position, PositionType::Absolute) && j != more {
      total += need[j]
      count += 1
    }
  }
  let out = make_bools(n, true)
  if more >= 0 { out[more] = false }
  if total + gap * (count - 1).to_double() > room + 0.01 {
    if more >= 0 {
      out[more] = true
      total += need[more]
      count += 1
    }
    let mut left = 0
    while total + gap * (count - 1).to_double() > room + 0.01 {
      let mut pick = -1
      for j, c in flow {
        let k = c.style.drop
        if out[j] && k > 0 && !pos_eq(c.style.position, PositionType::Absolute) && (pick < 0 || k <= flow[pick].style.drop) {
          pick = j
        }
      }
      if pick < 0 { break }
      out[pick] = false
      total -= need[pick]
      count -= 1
      left += 1
    }
    if more >= 0 && left == 0 {
      out[more] = false
    }
  }
  let kept : Array[Node] = []
  for j, c in flow {
    if out[j] { kept.push(c) }
  }
  kept
}

fn first_fit(flow : Array[Node], room : Double, cb_w : Double, cb_h : Double) -> Array[Node] {
  let ways : Array[Int] = []
  for j, c in flow {
    if !pos_eq(c.style.position, PositionType::Absolute) {
      ways.push(j)
    }
  }
  let mut pick = -1
  for j in ways {
    let c = flow[j]
    let b = box_for(c, cb_w, cb_h)
    let w = size_node(c, undef(), undef(), undef(), undef(), cb_w, cb_h, false) + b.mar_l + b.mar_r
    pick = j
    if w <= room + 0.01 { break }
  }
  let kept : Array[Node] = []
  for j, c in flow {
    if j == pick || pos_eq(c.style.position, PositionType::Absolute) {
      kept.push(c)
    }
  }
  kept
}

fn fit_needs(flow : Array[Node], cb_w : Double, cb_h : Double) -> (Array[Double], Int) {
  let need = make_doubles(flow.length(), 0.0)
  let mut more = -1
  for j, c in flow {
    if pos_eq(c.style.position, PositionType::Absolute) { continue }
    let b = box_for(c, cb_w, cb_h)
    let least = if known(b.min_w) { b.min_w } else { 0.0 }
    let w = if c.style.drop != 0 || c.style.fit_whole || (c.style.shrink == 0.0 && !known(b.w)) {
      size_node(c, undef(), undef(), undef(), undef(), cb_w, cb_h, false)
    } else if c.style.min_held {
      row_item_min(c, b, cb_w, cb_h)
    } else if known(b.w) {
      b.w
    } else {
      let kept_w = kept_of(c, cb_w, cb_h)
      if known(kept_w) { fmax(least, kept_w) } else { least }
    }
    need[j] = w + b.mar_l + b.mar_r
    if c.style.drop == -1 { more = j }
  }
  (need, more)
}

fn row_item_min(c : Node, cb : Box, cb_w : Double, cb_h : Double) -> Double {
  if c.style.min_held {
    let held = if c.style.fits && is_row(c.style.direction) {
      fit_least_held(c, cb, true)
    } else {
      size_node(c, undef(), undef(), undef(), undef(), cb_w, cb_h, false)
    }
    if known(cb.min_w) { fmax(cb.min_w, held) } else { held }
  } else {
    cb.min_w
  }
}

fn fit_least_held(c : Node, cb : Box, cut_kept : Bool) -> Double {
  let parts = flow_children(c)
  if c.style.one_of {
    let mut last = -1
    for j, k in parts {
      if !pos_eq(k.style.position, PositionType::Absolute) { last = j }
    }
    if last < 0 { return cb.pbw() }
    let k = parts[last]
    let kb = box_for(k, undef(), undef())
    return cb.pbw() + size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false) + kb.mar_l + kb.mar_r
  }
  let mut may_leave = false
  for k in parts {
    if !pos_eq(k.style.position, PositionType::Absolute) && k.style.drop > 0 {
      may_leave = true
      break
    }
  }
  let mut w = cb.pbw()
  let mut n = 0
  for k in parts {
    let s = k.style
    if pos_eq(s.position, PositionType::Absolute) || s.drop > 0 || (s.drop == -1 && !may_leave) {
      continue
    }
    let kb = box_for(k, undef(), undef())
    let least = if s.drop == -1 {
      size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false)
    } else {
      part_least(k, kb, if cut_kept { kept_of(k, undef(), undef()) } else { undef() })
    }
    w += least + kb.mar_l + kb.mar_r
    n += 1
  }
  if n > 1 {
    w += edge_of(c.style.gap_col_k, c.style.gap_col_v, undef()) * (n - 1).to_double()
  }
  w
}

fn fit_soft_held(c : Node, cb : Box) -> Double {
  let s = c.style
  if s.soft_min >= 0.0 || !s.fits || s.one_of || !is_row(s.direction) {
    return s.soft_min
  }
  let soft = fit_least_held(c, cb, false)
  if known(cb.min_w) { fmax(cb.min_w, soft) } else { soft }
}

fn soft_min_of(c : Node, cb : Box) -> Double {
  let s = c.style
  if s.soft_min >= 0.0 { return s.soft_min }
  if s.min_held && s.fits && !s.one_of && is_row(s.direction) {
    return fit_soft_held(c, cb)
  }
  if s.soft_min < 0.0 && overflow_eq(s.overflow, Overflow::Visible) && c.children.length() > 0 {
    let parts = flow_children(c)
    let along = is_row(s.direction) && wrap_eq(s.wrap, FlexWrap::NoWrap)
    let mut may_leave = false
    if along {
      for k in parts {
        if !pos_eq(k.style.position, PositionType::Absolute) && k.style.drop > 0 {
          may_leave = true
          break
        }
      }
    }
    let mut any = false
    let mut sum = 0.0
    let mut n = 0
    let mut widest = 0.0
    for k in parts {
      let ks = k.style
      if pos_eq(ks.position, PositionType::Absolute) || (along && (ks.drop > 0 || (ks.drop == -1 && !may_leave))) {
        continue
      }
      let kb = box_for(k, undef(), undef())
      let sk = soft_min_of(k, kb)
      let least = (if known(sk) {
        any = true
        sk
      } else if known(kb.w) {
        kb.w
      } else if ks.shrink == 0.0 || ks.min_held {
        size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false)
      } else {
        fmax(or_else(kb.min_w, 0.0), kb.pbw())
      }) + kb.mar_l + kb.mar_r
      sum += least
      n += 1
      widest = fmax(widest, least)
    }
    if !any { return undef() }
    let gap = edge_of(s.gap_col_k, s.gap_col_v, undef())
    let raw = cb.pbw() + (if along { sum + (if n > 1 { gap * (n - 1).to_double() } else { 0.0 }) } else { widest })
    return if known(cb.min_w) { fmax(cb.min_w, raw) } else { raw }
  }
  undef()
}

fn part_least(k : Node, kb : Box, kept : Double) -> Double {
  if k.style.min_held {
    row_item_min(k, kb, undef(), undef())
  } else if known(kb.w) {
    kb.w
  } else if k.style.shrink == 0.0 {
    size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false)
  } else {
    fmax(fmax(or_else(kb.min_w, 0.0), kb.pbw()), or_else(kept, 0.0))
  }
}

fn kept_of(c : Node, cb_w : Double, cb_h : Double) -> Double {
  let s = c.style
  if known(s.fit_need) { return s.fit_need }
  if c.measure is Some(_) {
    if !known(s.cut_least) { return undef() }
    let b = box_for(c, cb_w, cb_h)
    return fmin(size_node(c, undef(), undef(), undef(), undef(), cb_w, cb_h, false), s.cut_least + b.pbw())
  }
  if !overflow_eq(s.overflow, Overflow::Visible) || c.children.length() == 0 {
    return undef()
  }
  let parts = flow_children(c)
  let along = is_row(s.direction) && wrap_eq(s.wrap, FlexWrap::NoWrap)
  let mut may_leave = false
  if along {
    for k in parts {
      if !pos_eq(k.style.position, PositionType::Absolute) && k.style.drop > 0 {
        may_leave = true
        break
      }
    }
  }
  let mut any = false
  let mut sum = 0.0
  let mut n = 0
  let mut widest = 0.0
  for k in parts {
    let ks = k.style
    if pos_eq(ks.position, PositionType::Absolute) || (along && (ks.drop > 0 || (ks.drop == -1 && !may_leave))) {
      continue
    }
    let kb = box_for(k, undef(), undef())
    let kept = kept_of(k, undef(), undef())
    if known(kept) && !known(ks.fit_need) { any = true }
    let least = (if along && ks.drop == -1 {
      size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false)
    } else {
      part_least(k, kb, kept)
    }) + kb.mar_l + kb.mar_r
    sum += least
    n += 1
    widest = fmax(widest, least)
  }
  if !any { return undef() }
  let b = box_for(c, cb_w, cb_h)
  let gap = edge_of(s.gap_col_k, s.gap_col_v, undef())
  b.pbw() + (if along { sum + (if n > 1 { gap * (n - 1).to_double() } else { 0.0 }) } else { widest })
}

fn basis_said(cs : Style, cb : Box, row : Bool, inner_main : Double) -> Double {
  let basis_style = resolve_of(cs.basis_k, cs.basis_v, inner_main)
  let main_style = if row { cb.w } else { cb.h }
  if known(basis_style) && cs.basis_k != LEN_AUTO {
    if sizing_eq(cs.box_sizing, BoxSizing::ContentBox) {
      basis_style + (if row { cb.pbw() } else { cb.pbh() })
    } else {
      basis_style
    }
  } else if known(main_style) {
    main_style
  } else {
    undef()
  }
}

fn least_held(c : Node, cb_w : Double, cb_h : Double) -> Double {
  if !is_row(c.style.direction) { return 0.0 }
  let b = box_for(c, cb_w, cb_h)
  let wraps = !wrap_eq(c.style.wrap, FlexWrap::NoWrap)
  let mut content = 0.0
  let mut n = 0
  for k in flow_children(c) {
    if pos_eq(k.style.position, PositionType::Absolute) { continue }
    let kb = box_for(k, undef(), undef())
    let least = if k.style.shrink == 0.0 {
      least_hyp(k, kb)
    } else {
      fmax(or_else(row_item_min(k, kb, undef(), undef()), 0.0), least_held(k, undef(), undef()))
    }
    let outer = least + kb.mar_l + kb.mar_r
    content = if wraps { fmax(content, outer) } else { content + outer }
    n += 1
  }
  if !wraps && n > 1 {
    content += edge_of(c.style.gap_col_k, c.style.gap_col_v, undef()) * (n - 1).to_double()
  }
  b.pbw() + content
}

fn least_hyp(k : Node, kb : Box) -> Double {
  let b0 = basis_said(k.style, kb, true, undef())
  let basis = if known(b0) { b0 } else { size_node(k, undef(), undef(), undef(), undef(), undef(), undef(), false) }
  clamp_size(fmax(basis, kb.pbw()), row_item_min(k, kb, undef(), undef()), kb.max_w)
}

fn fit_line(
  pool : Pool,
  flow : Array[Node],
  start : Int,
  end : Int,
  room : Double,
  cb_w : Double,
  cb_h : Double,
) -> Double {
  let f = pool.f
  let mut total = 0.0
  let rows : Array[(Int, Array[Node], Array[Double], Int, Double, Double, Array[Bool])] = []
  for k in start..<end {
    let i = k * ITEM
    total += f[i + MARGIN_MAIN]
    if (pool.flags[k] & FITS) == 0 {
      let hyp = f[i + HYP]
      total += if f[i + SHRINK] == 0.0 {
        hyp
      } else {
        let least = or_else(f[i + MIN_MAIN], 0.0)
        let fit = kept_of(flow[pool.at[k]], cb_w, cb_h)
        fmin(hyp, if known(fit) { fmax(least, fit) } else { least })
      }
    } else {
      let c = flow[pool.at[k]]
      let parts = flow_children(c)
      let (need, more) = fit_needs(parts, undef(), undef())
      let pb = box_for(c, cb_w, cb_h).pbw()
      let gap = edge_of(c.style.gap_col_k, c.style.gap_col_v, undef())
      rows.push((k, parts, need, more, pb, gap, make_bools(parts.length(), false)))
    }
  }
  let width = fn(r : (Int, Array[Node], Array[Double], Int, Double, Double, Array[Bool])) -> Double {
    let (k, parts, need, more, pb, gap, out) = r
    let mut w = 0.0
    let mut n = 0
    let mut left = false
    for j, c in parts {
      if pos_eq(c.style.position, PositionType::Absolute) || j == more { continue }
      if out[j] {
        left = true
      } else {
        w += need[j]
        n += 1
      }
    }
    if left && more >= 0 {
      w += need[more]
      n += 1
    }
    let i = k * ITEM
    let at = pb + w + (if n > 1 { gap * (n - 1).to_double() } else { 0.0 })
    fmin(clamp_size(at, f[i + MIN_MAIN], f[i + MAX_MAIN]), f[i + HYP])
  }
  let widths : Array[Double] = []
  for r in rows {
    let w = width(r)
    widths.push(w)
    total += w
  }
  let parts : Array[(Int, Int, Int)] = []
  for ri, r in rows {
    let (_, kids, _, _, _, _, _) = r
    for j, c in kids {
      if c.style.drop > 0 && !pos_eq(c.style.position, PositionType::Absolute) {
        parts.push((ri, j, c.style.drop))
      }
    }
  }
  // Sort parts by (drop asc, ri desc, j desc)
  for i in 1..<parts.length() {
    let key = parts[i]
    let mut j = i - 1
    while j >= 0 {
      let a = parts[j]
      let gt = if a.2 != key.2 { a.2 > key.2 } else if a.0 != key.0 { a.0 < key.0 } else { a.1 < key.1 }
      if !gt { break }
      parts[j + 1] = parts[j]
      j -= 1
    }
    parts[j + 1] = key
  }
  let mut p = 0
  while total > room + 0.01 && p < parts.length() {
    let (ri, j, _) = parts[p]
    p += 1
    let (_, _, _, _, _, _, out) = rows[ri]
    out[j] = true
    let now = width(rows[ri])
    total = total + now - widths[ri]
    widths[ri] = now
  }
  let fits = total <= room + 0.01
  let mut sum = 0.0
  for k in start..<end {
    sum += f[k * ITEM + HYP] + f[k * ITEM + MARGIN_MAIN]
  }
  for ri, r in rows {
    let (k, _, _, _, _, _, _) = r
    let i = k * ITEM
    let now = widths[ri]
    sum = sum + now - f[i + HYP]
    f[i + BASIS] = now
    f[i + HYP] = now
    if fits { f[i + SHRINK] = 0.0 }
  }
  sum
}

fn flow_children(node : Node) -> Array[Node] {
  if node.holds_gone {
    return flow_children_gone(node)
  }
  let mut plain = true
  for c in node.children {
    if !disp_eq(c.style.display, Display::Flex) {
      plain = false
      break
    }
  }
  if plain { return node.children }
  let out : Array[Node] = []
  for c in node.children {
    match c.style.display {
      Display::DisplayNone => ()
      Display::Contents => {
        zero(c)
        for g in flow_children(c) { out.push(g) }
      }
      Display::Flex => out.push(c)
    }
  }
  out
}

fn flow_children_gone(node : Node) -> Array[Node] {
  let out : Array[Node] = []
  for c in node.children {
    match c.style.display {
      Display::DisplayNone => ()
      Display::Contents => {
        zero(c)
        for g in flow_children(c) { out.push(g) }
      }
      Display::Flex => {
        if !(c.style.gone_empty && holds_none(c)) {
          out.push(c)
        }
      }
    }
  }
  out
}

fn gone_there(flow : Array[Node], pool : Pool) -> Double {
  let mut most = 0.0
  for k in 0..<pool.count {
    let c = flow[pool.at[k]]
    if nothing_made(c) { continue }
    let cs = c.style
    let here = if (cs.come_fill && known(cs.come_now)) || cs.gone_empty { cs.come_k } else { 1.0 }
    if here >= 1.0 { return 1.0 }
    most = fmax(most, here)
  }
  if pool.count == 0 { 1.0 } else { most }
}

fn laid_none(n : Node, gone : Bool) -> Bool {
  disp_eq(n.style.display, Display::DisplayNone) || (gone && n.style.gone_empty && holds_none(n))
}

fn holds_none(n : Node) -> Bool {
  for c in n.children {
    if !laid_none(c, n.holds_gone) && !nothing_made(c) {
      return false
    }
  }
  true
}

fn nothing_made(n : Node) -> Bool {
  let s = n.style
  if !s.structural || known(s.come_now) { return false }
  for c in n.children {
    if !disp_eq(c.style.display, Display::DisplayNone) && !nothing_made(c) {
      return false
    }
  }
  true
}

fn left_out(n : Node) -> Unit {
  n.line = -1
  forget(n)
}

fn forget(n : Node) -> Unit {
  n.left = 0.0
  n.top = 0.0
  n.width = 0.0
  n.height = 0.0
  n.p_ok = false
  n.laid_gen = flx.generation
  for c in n.children { forget(c) }
}

fn zero(n : Node) -> Unit {
  n.left = 0.0
  n.top = 0.0
  n.width = 0.0
  n.height = 0.0
  for c in n.children { zero(c) }
}

fn distribute(a : Align, free : Double, n : Int, _content : Bool) -> Double {
  flx.out_b = 0.0
  if n <= 0 { return 0.0 }
  let nd = n.to_double()
  match a {
    Align::FlexEnd => free
    Align::Center => free / 2.0
    Align::SpaceBetween => {
      if n > 1 && free > 0.0 {
        flx.out_b = free / (nd - 1.0)
      }
      0.0
    }
    Align::SpaceAround => {
      if free > 0.0 {
        flx.out_b = free / nd
        free / nd / 2.0
      } else {
        0.0
      }
    }
    Align::SpaceEvenly => {
      if free > 0.0 {
        flx.out_b = free / (nd + 1.0)
        free / (nd + 1.0)
      } else {
        0.0
      }
    }
    _ => 0.0
  }
}

fn resolve_flexible(pool : Pool, a : Int, b : Int, sum_hyp : Double, space : Double) -> Unit {
  let f = pool.f
  let flags = pool.flags
  let grow = sum_hyp < space
  let mut initial_free = space
  let mut flexible = false
  let factor_at = if grow { GROW } else { SHRINK }
  let not_frozen = FROZEN ^ (-1)
  for k in a..<b {
    let i = k * ITEM
    let hyp = f[i + HYP]
    let basis = f[i + BASIS]
    f[i + TARGET] = hyp
    f[i + MAIN] = hyp
    let factor = f[i + factor_at]
    let frozen = factor == 0.0 || (grow && basis > hyp) || (!grow && basis < hyp)
    if frozen {
      flags[k] = flags[k] | FROZEN
    } else {
      flags[k] = flags[k] & not_frozen
      f[i + FACTOR] = factor
      f[i + LO_MAIN] = fmax(or_else(f[i + MIN_MAIN], 0.0), f[i + PB_MAIN])
      flexible = true
    }
    initial_free = initial_free - f[i + MARGIN_MAIN] - (if frozen { hyp } else { basis })
  }
  if !flexible { return }
  let mut rounds = 0
  let mut left = true
  while rounds < 64 && left {
    rounds += 1
    let mut sum_factors = 0.0
    let mut free = space
    let mut sum_scaled = 0.0
    let mut remaining = space
    let mut unfrozen = 0
    for k in a..<b {
      let i = k * ITEM
      let frozen = (flags[k] & FROZEN) != 0
      remaining -= f[i + MARGIN_MAIN]
      if frozen {
        remaining -= f[i + TARGET]
      } else {
        unfrozen += 1
      }
      free = free - f[i + MARGIN_MAIN] - (if frozen { f[i + TARGET] } else { f[i + BASIS] })
      if !frozen {
        sum_factors += f[i + FACTOR]
        sum_scaled += f[i + FACTOR] * f[i + BASIS]
      }
    }
    if sum_factors < 1.0 {
      let scaled = initial_free * sum_factors
      if scaled.abs() < free.abs() { free = scaled }
    }
    let mut total = 0.0
    for k in a..<b {
      if (flags[k] & FROZEN) != 0 { continue }
      let i = k * ITEM
      let basis = f[i + BASIS]
      let t = if unfrozen == 1 && sum_factors >= 1.0 && (grow || sum_scaled > 0.0) {
        remaining
      } else if grow {
        basis + free * f[i + FACTOR] / sum_factors
      } else {
        let scaled = f[i + FACTOR] * basis
        if sum_scaled > 0.0 { basis + free * scaled / sum_scaled } else { basis }
      }
      let c = clamp_size(t, f[i + LO_MAIN], f[i + MAX_MAIN])
      f[i + CLAMPED] = c - t
      total += c - t
      f[i + TARGET] = c
    }
    left = false
    for k in a..<b {
      if (flags[k] & FROZEN) != 0 { continue }
      let i = k * ITEM
      let v = f[i + CLAMPED]
      if total == 0.0 || (total > 0.0 && v > 0.0) || (total < 0.0 && v < 0.0) {
        flags[k] = flags[k] | FROZEN
        f[i + MAIN] = f[i + TARGET]
      } else {
        left = true
      }
    }
  }
  if left {
    for k in a..<b {
      f[k * ITEM + MAIN] = f[k * ITEM + TARGET]
    }
  }
}

fn soft_floor(s : Style, min_w : Double) -> Double {
  if s.soft_min >= 0.0 && (!known(min_w) || s.soft_min < min_w) { s.soft_min } else { min_w }
}

fn last_resort(
  pool : Pool,
  flow : Array[Node],
  a : Int,
  b : Int,
  space : Double,
  cb_w : Double,
  cb_h : Double,
) -> Unit {
  let f = pool.f
  let mut used = 0.0
  for k in a..<b {
    let i = k * ITEM
    used += f[i + MAIN] + f[i + MARGIN_MAIN]
  }
  let over = used - space
  if over <= 0.01 { return }
  let mut room = 0.0
  let mut widest = 0.0
  for k in a..<b {
    let i = k * ITEM
    let main = f[i + MAIN]
    let mut lo = f[i + SOFT_MIN]
    if lo < 0.0 {
      let c = flow[pool.at[k]]
      lo = soft_min_of(c, box_for(c, cb_w, cb_h))
      f[i + SOFT_MIN] = lo
    }
    if known(lo) && lo < main {
      room += main - lo
      widest = fmax(widest, main)
    }
  }
  if room < over - 0.01 { return }
  let given = fn(cap : Double) -> Double {
    let mut g = 0.0
    for k in a..<b {
      let i = k * ITEM
      let main = f[i + MAIN]
      let lo = f[i + SOFT_MIN]
      if known(lo) && lo < main && main > cap {
        g += main - fmax(cap, lo)
      }
    }
    g
  }
  let mut lo = 0.0
  let mut hi = widest
  for _ in 0..<60 {
    let mid = (lo + hi) / 2.0
    if given(mid) > over { lo = mid } else { hi = mid }
  }
  let cap = hi
  for k in a..<b {
    let i = k * ITEM
    let main = f[i + MAIN]
    let lo_v = f[i + SOFT_MIN]
    if known(lo_v) && lo_v < main && main > cap {
      f[i + MAIN] = fmax(cap, lo_v)
    }
  }
}

fn layout_static_absolute(cb : Node, node : Node, ox : Double, oy : Double) -> Unit {
  let gone = node.holds_gone
  for c in node.children {
    let cs = c.style
    if disp_eq(cs.display, Display::DisplayNone) || (gone && cs.gone_empty && holds_none(c)) {
      continue
    }
    if disp_eq(cs.display, Display::Contents) {
      layout_static_absolute(cb, c, ox, oy)
      continue
    }
    if pos_eq(cs.position, PositionType::Absolute) {
      place_absolute(cb, node, c, ox, oy)
      if !kept(c) && c.children.length() > 0 {
        layout_static_absolute(c, c, 0.0, 0.0)
      }
    } else if c.children.length() == 0 {
      ()
    } else if pos_eq(cs.position, PositionType::Static) {
      layout_static_absolute(cb, c, ox + c.left, oy + c.top)
    } else if !kept(c) {
      layout_static_absolute(c, c, 0.0, 0.0)
    }
  }
}

pub fn absolute_relaid(holder : Node, c : Node) -> Int {
  flx.generation += 1
  flx.reusing = true
  flx.absolute_seen = false
  place_absolute(holder, holder, c, 0.0, 0.0)
  if !kept(c) && c.children.length() > 0 {
    layout_static_absolute(c, c, 0.0, 0.0)
  }
  flx.generation
}

fn place_absolute(cb : Node, parent : Node, c : Node, ox : Double, oy : Double) -> Unit {
  let cbb = box_of(cb.style, undef(), undef(), None)
  let pb = box_of(parent.style, undef(), undef(), None)
  let ps = parent.style
  let cs = c.style
  let cw = cb.width - cbb.bor_l - cbb.bor_r
  let ch = cb.height - cbb.bor_t - cbb.bor_b
  let b = box_of(cs, cw, ch, None)
  let l = resolve_of(cs.inset_left_k, cs.inset_left_v, cw)
  let r = resolve_of(cs.inset_right_k, cs.inset_right_v, cw)
  let t = resolve_of(cs.inset_top_k, cs.inset_top_v, ch)
  let bt = resolve_of(cs.inset_bottom_k, cs.inset_bottom_v, ch)
  let mut w = b.w
  let mut h = b.h
  if !known(w) && known(l) && known(r) {
    w = fmax(cw - l - r - b.mar_l - b.mar_r, 0.0)
  }
  if !known(h) && known(t) && known(bt) {
    h = fmax(ch - t - bt - b.mar_t - b.mar_b, 0.0)
  }
  if known(w) { w = clamp_size(w, b.min_w, b.max_w) }
  if known(h) { h = clamp_size(h, b.min_h, b.max_h) }
  let fw = size_node(c, w, h, if known(w) { w } else { cw }, if known(h) { h } else { ch }, cw, ch, false)
  let fh = flx.out_h
  let rw = size_node(c, fw, fh, fw, fh, cw, ch, true)
  let rh = flx.out_h
  c.width = rw
  c.height = rh
  let row = is_row(ps.direction)
  let inner_w = parent.width - pb.pbw()
  let inner_h = parent.height - pb.pbh()
  let free_w = inner_w - rw - b.mar_l - b.mar_r
  let free_h = inner_h - rh - b.mar_t - b.mar_b
  let static_x = pb.bor_l + pb.pad_l + b.mar_l + (if row {
    static_offset(ps.justify, free_w, is_reverse(ps.direction))
  } else {
    static_offset(item_align(ps, cs), free_w, wrap_eq(ps.wrap, FlexWrap::WrapReverse))
  })
  let static_y = pb.bor_t + pb.pad_t + b.mar_t + (if row {
    static_offset(item_align(ps, cs), free_h, wrap_eq(ps.wrap, FlexWrap::WrapReverse))
  } else {
    static_offset(ps.justify, free_h, is_reverse(ps.direction))
  })
  c.left = on_grid(
    if known(l) {
      cbb.bor_l + l + b.mar_l - ox
    } else if known(r) {
      cb.width - cbb.bor_r - r - rw - b.mar_r - ox
    } else {
      static_x
    },
  )
  c.top = on_grid(
    if known(t) {
      cbb.bor_t + t + b.mar_t - oy
    } else if known(bt) {
      cb.height - cbb.bor_b - bt - rh - b.mar_b - oy
    } else {
      static_y
    },
  )
}

fn static_offset(a : Align, free : Double, reverse : Bool) -> Double {
  let o = match a {
    Align::FlexEnd => free
    Align::Center => free / 2.0
    Align::SpaceAround => free / 2.0
    Align::SpaceEvenly => free / 2.0
    _ => 0.0
  }
  if reverse { free - o } else { o }
}

fn round_layout(n : Node, abs_x : Double, abs_y : Double) -> Unit {
  let x = abs_x + n.left
  let y = abs_y + n.top
  let l = n.left.round()
  let t = n.top.round()
  let w = (x + n.width).round() - x.round()
  let h = (y + n.height).round() - y.round()
  for c in n.children {
    round_layout(c, x, y)
  }
  n.left = l
  n.top = t
  n.width = w
  n.height = h
}

fn first_kept(node : Node, b : Box) -> Unit {
  let oy = b.bor_t + b.pad_t
  node.first_baseline = if known(flx.first_told_base) { oy + flx.first_told_base } else { undef() }
  node.first_line_mid = if known(flx.first_told_mid) { oy + flx.first_told_mid } else { undef() }
  flx.first_told_base = undef()
  flx.first_told_mid = undef()
}

fn first_line_at(n : Node, kw : Double, kh : Double, cb_w : Double, cb_h : Double, mid : Bool) -> Double {
  if n.children.length() == 0 {
    match n.measure {
      Some(m) => {
        if !n.room {
          if !known(n.first_baseline) && !known(n.first_line_mid) {
            let b = box_for(n, cb_w, cb_h)
            flx.first_told_base = undef()
            flx.first_told_mid = undef()
            let _ = m(
              if known(kw) { fmax(kw - b.pbw(), 0.0) } else { 0.0 },
              if known(kw) { MeasureMode::Exactly } else { MeasureMode::Undefined },
              if known(kh) { fmax(kh - b.pbh(), 0.0) } else { 0.0 },
              if known(kh) { MeasureMode::Exactly } else { MeasureMode::Undefined },
            )
            first_kept(n, b)
          }
          let told = if mid { n.first_line_mid } else { n.first_baseline }
          if known(told) { return told }
        }
      }
      None => ()
    }
    let _ = size_node(n, kw, kh, kw, kh, cb_w, cb_h, false)
    let h = flx.out_h
    return if mid { h / 2.0 } else { h }
  }
  flx.first_asked = if mid { 2 } else { 1 }
  flx.first_out = undef()
  let _ = size_uncached(n, kw, kh, kw, kh, cb_w, cb_h, false)
  let h = flx.out_h
  flx.first_asked = 0
  let v = flx.first_out
  flx.first_out = undef()
  if known(v) { v } else if mid { h / 2.0 } else { h }
}

fn first_in_pool(
  node : Node,
  b : Box,
  flow : Array[Node],
  pool : Pool,
  row : Bool,
  fw : Double,
  fh : Double,
  gone_cut : Double,
  rows_g : Double,
  cb_w : Double,
  cb_h : Double,
  mid : Bool,
) -> Double {
  let want = if mid { Align::FirstLineCenter } else { Align::Baseline }
  let mut pick = -1
  for k in 0..<pool.count {
    if pool.line_of[k] > 0 { break }
    let c = flow[pool.at[k]]
    if pos_eq(c.style.position, PositionType::Absolute) ||
      disp_eq(c.style.display, Display::DisplayNone) ||
      (node.holds_gone && c.style.gone_empty && holds_none(c)) {
      continue
    }
    if align_eq(item_align(node.style, c.style), want) {
      pick = k
      break
    }
    if pick < 0 { pick = k }
  }
  if pick < 0 { return if mid { fh / 2.0 } else { fh } }
  let f = pool.f
  let i = pick * ITEM
  let c = flow[pool.at[pick]]
  let iw = if row { f[i + MAIN] } else { f[i + CROSS] }
  let ih = if row { f[i + CROSS] } else { f[i + MAIN] }
  let oy0 = b.bor_t + b.pad_t
  let oy1 = if gone_cut > 0.0 { oy0 - b.pad_t * gone_cut } else { oy0 }
  let oy = if rows_g > 0.0 { rows_room(oy1, rows_g) } else { oy1 }
  let y = if row { f[i + CROSS_POS] } else { f[i + MAIN_POS] }
  let dy = if (pool.flags[pick] & INSET) != 0 {
    inset_offset(c.style, fw - b.pbw(), fh - b.pbh(), false)
  } else {
    0.0
  }
  let top = on_grid(if rows_g > 0.0 { ((oy + y + dy) * rows_g + 0.5).floor() / rows_g } else { oy + y + dy })
  top + first_line_at(c, iw, ih, cb_w, cb_h, mid)
}
