// FlipWay::left caching, move_path exactness, reuse-cache float tolerance, and come_height's zero-distance end.

fn fl_item(dy : Double, vy? : Double) -> FlipItem {
  let v = match vy { Some(x) => x; None => 0.0 }
  FlipItem::{ off: (0.0, dy, 0.0, 0.0), v: (0.0, v, 0.0, 0.0) }
}

test "FlipWay::left caches same now and invalidates on new now" {
  let w = FlipWay::new(100.0, [fl_item(80.0, vy=-0.2)])
  let ends = w.ends()
  for t in [90.0, 100.0, 140.0, 210.0, ends, ends + 50.0] {
    let r1 = w.left(t)
    let r2 = w.left(t)
    debug_assert(r1.0 == r2.0 && r1.1 == r2.1, "repeat call must match cached value")
  }
  let a = w.left(130.0)
  let b = w.left(180.0)
  debug_assert(a.0 > b.0, "cache must invalidate when now advances")
  let c = w.left(130.0)
  debug_assert(a.0 == c.0 && a.1 == c.1, "returning to earlier now recomputes identically")
}

test "FlipWay::left with a said curve caches and matches a fresh way" {
  let sd = (200.0, fn(x : Double) -> Double { x * x })
  let w = FlipWay::new(0.0, [fl_item(50.0)], said=sd)
  for t in [-5.0, 0.0, 40.0, 100.0, 199.0, 200.0, 260.0] {
    let fresh = FlipWay::new(0.0, [fl_item(50.0)], said=sd)
    let got = w.left(t)
    let again = w.left(t)
    let want = fresh.left(t)
    debug_assert(got.0 == want.0 && got.1 == want.1, "cached way matches a fresh one")
    debug_assert(again.0 == got.0 && again.1 == got.1, "repeat read is the cached one")
  }
}

test "FlipWay::left reads its curve once a moment" {
  let calls = [0]
  let sd = (200.0, fn(x : Double) -> Double {
    calls[0] += 1
    x
  })
  let w = FlipWay::new(0.0, [fl_item(50.0), fl_item(20.0)], said=sd)
  let _ = w.drawn(fl_item(50.0), 80.0)
  let once = calls[0]
  debug_assert(once > 0, "the first read works it out")
  let _ = w.drawn(fl_item(20.0), 80.0)
  let _ = w.left(80.0)
  debug_assert(calls[0] == once, "items read at that moment share it")
  let _ = w.left(120.0)
  debug_assert(calls[0] > once, "a new moment works it out again")
}

test "move_path matches move_at from rest and boundary values" {
  let dur = 300.0
  let (o0, v0) = move_path(120.0, -0.5, 0.0, dur)
  debug_assert(o0 == 120.0 && v0 == -0.5, "at 0: where it set out")
  let (o1, v1) = move_path(120.0, -0.5, -10.0, dur)
  debug_assert(o1 == 120.0 && v1 == -0.5, "before 0: where it set out")
  let (o2, v2) = move_path(120.0, -0.5, dur, dur)
  debug_assert(o2 == 0.0 && v2 == 0.0, "at its end: there")
  let (o3, v3) = move_path(120.0, -0.5, dur + 5.0, dur)
  debug_assert(o3 == 0.0 && v3 == 0.0, "after its end: there")
  for t in [15.0, 60.0, 150.0, 240.0, 295.0] {
    let (off, vel) = move_path(-100.0, 0.0, t, dur)
    let expected = -100.0 * (1.0 - move_at(t / dur))
    debug_assert((off - expected).abs() < 1.0e-11, "from rest: a Move to the bit")
    debug_assert(vel > 0.0, "positive velocity toward 0")
  }
}

test "move_end and move_at(1) agree with exp(-move_k)" {
  debug_assert((move_at(0.9999999999) - 1.0).abs() < 1.0e-9, "move_at reaches 1 at its end")
  debug_assert((move_end - (1.0 - (1.0 + move_k) * dmath::exp(-move_k))).abs() < 1.0e-15, "move_end from move_k")
}

test "come_back_path sets out at d and rests at 0" {
  let dur = 300.0
  let (y0, v0) = come_back_path(80.0, 0.0, 1.0, 0.0, dur)
  debug_assert(y0 == 80.0 && v0 == 0.0, "sets out at d")
  let (y1, v1) = come_back_path(80.0, 0.0, 1.0, dur, dur)
  debug_assert(y1 == 0.0 && v1 == 0.0, "there at its end")
  let (ya, _) = come_back_path(80.0, 0.0, 1.0, 299.999, dur)
  debug_assert(ya.abs() < 1.0e-3, "close to 0 just before its end")
  let mut was = 80.0
  for t in [30.0, 90.0, 150.0, 210.0, 270.0] {
    let (y, _) = come_back_path(80.0, 0.0, 1.0, t, dur)
    debug_assert(y < was + 1.0e-9, "never back")
    was = y
  }
}

test "come_height: nothing to go ends at once" {
  let n = Node::new()
  let s = n.style
  s.come_at = 100.0
  s.come_now = 150.0
  s.come_from = 40.0
  s.come_v = 0.0
  s.come_to = 1.0
  s.come_spec = Some((300.0, fn(x : Double) -> Double { x }))
  let _ = come_height(s, 40.0)
  debug_assert(s.come_ends == s.come_at, "a come with nowhere to go has no length")
  debug_assert(s.come_k == 1.0, "and is there")
}

test "reused: fixed-width subtree hits cache despite 1-ULP subtraction noise from width minus padding_right" {
  let fixed = 540.37
  let measures = [0]
  let root = Node::new()
  root.style.direction = FlexDirection::Column
  root.style.set_height(Dim::Pt(600.0))
  let child = Node::new()
  child.style.direction = FlexDirection::Column
  child.style.grow = 1.0
  let leaf = Node::new()
  leaf.measure = Some(fn(w : Double, wm : MeasureMode, _h : Double, _hm : MeasureMode) -> (Double, Double) {
    measures[0] += 1
    let width = match wm {
      MeasureMode::Exactly => w
      MeasureMode::AtMost => if w < 300.0 { w } else { 300.0 }
      MeasureMode::Undefined => 300.0
    }
    (width, 40.0)
  })
  child.add(leaf)
  root.add(child)
  let widths = [900.1, 900.3, 900.7, 901.13, 812.73, 745.19]
  root.style.set_width(Dim::Pt(widths[0]))
  root.style.set_padding_right(Dim::Pt(widths[0] - fixed))
  compute(root, width=widths[0], height=600.0, round=false, reuse=true)
  let initial = measures[0]
  debug_assert(initial > 0, "initial layout measures leaf")
  for i in 1..<widths.length() {
    let w = widths[i]
    root.style.set_width(Dim::Pt(w))
    root.style.set_padding_right(Dim::Pt(w - fixed))
    root.dirty = true
    compute(root, width=w, height=600.0, round=false, reuse=true)
    debug_assert(measures[0] == initial, "fixed-width subtree must hit reuse cache without re-measuring leaf")
    debug_assert((child.width - fixed).abs() < 1.0e-6, "child keeps the fixed width")
  }
}

test "reused: a fixed-width child is not laid again when width minus padding_right is one ULP off" {
  // 333.33 comes back from w - (w - 333.33) exactly at 800 and 820.5 and one ULP short at 900, 1100 and 1300.25.
  let fixed = 333.33
  let measures = [0]
  let root = Node::new()
  root.style.direction = FlexDirection::Column
  root.style.set_height(Dim::Pt(600.0))
  let child = Node::new()
  child.style.direction = FlexDirection::Column
  child.style.grow = 1.0
  let leaf = Node::new()
  leaf.measure = Some(fn(w : Double, wm : MeasureMode, _h : Double, _hm : MeasureMode) -> (Double, Double) {
    measures[0] += 1
    let width = match wm {
      MeasureMode::Exactly => w
      MeasureMode::AtMost => if w < 300.0 { w } else { 300.0 }
      MeasureMode::Undefined => 300.0
    }
    (width, 40.0)
  })
  child.add(leaf)
  root.add(child)
  let widths = [800.0, 900.0, 820.5, 1100.0, 1300.25, 800.0]
  root.style.set_width(Dim::Pt(widths[0]))
  root.style.set_padding_right(Dim::Pt(widths[0] - fixed))
  compute(root, width=widths[0], height=600.0, round=false, reuse=true)
  let initial = measures[0]
  let laid = child.laid_out_at()
  for i in 1..<widths.length() {
    let w = widths[i]
    root.style.set_width(Dim::Pt(w))
    root.style.set_padding_right(Dim::Pt(w - fixed))
    root.dirty = true
    compute(root, width=w, height=600.0, round=false, reuse=true)
    debug_assert(child.laid_out_at() == laid, "the fixed-width child is reused, not laid again")
    debug_assert(measures[0] == initial, "and its leaf is not measured again")
    debug_assert((child.width - fixed).abs() < 1.0e-6, "child keeps the fixed width")
  }
}

test "move_path and come_back_path keep their rounding to the bit" {
  let (a, av) = move_path(120.0, -0.5, 75.0, 300.0)
  debug_assert(a.to_bits() == 4631894203396325133L && av.to_bits() == -4618009185376618859L, "move_path from a speed")
  let (b, bv) = move_path(-100.0, 0.0, 150.0, 300.0)
  debug_assert(b.to_bits() == -4600897686862181806L && bv.to_bits() == 4597339637361845697L, "move_path from rest")
  let (c, cv) = come_back_path(80.0, 0.002, 0.3, 90.0, 300.0)
  debug_assert(c.to_bits() == 4630467544778733889L && cv.to_bits() == -4619878117303857182L, "come_back_path slow turn")
  let (e, ev) = come_back_path(-60.0, 0.001, 1.0, 200.0, 350.0)
  debug_assert(e.to_bits() == -4600954173019207468L && ev.to_bits() == 4595135291227404958L, "come_back_path at a Move's")
  let (a2, av2) = move_path(120.0, -0.5, 165.0, 350.0)
  debug_assert(a2.to_bits() == 4623784136794781239L && av2.to_bits() == -4625791426871434638L, "move_path's s")
  let (c2, cv2) = come_back_path(80.0, 0.002, 0.3, 130.0, 300.0)
  debug_assert(c2.to_bits() == 4625886700178964667L && cv2.to_bits() == -4623252302435479903L, "come_back_path's x")
}

test "come_back_k is come_back_k_of(move_k), worked out once" {
  debug_assert(come_back_k.to_bits() == come_back_k_of(move_k).to_bits(), "the constant is the halving's")
  debug_assert(come_back_k > move_k && come_back_k < 4.0 * move_k, "within its halving's bounds")
}

test "same and reusable: within 1e-9 is the same, beyond is not" {
  let f = 333.33
  let off = 1000.0 - (1000.0 - f)
  debug_assert(off != f, "one ULP off")
  debug_assert(same(off, f) && same(f, off), "one ULP is the same")
  debug_assert(!same(f, f + 1.0e-6), "a millionth is not")
  debug_assert(same(undef(), undef()) && !same(undef(), f) && !same(f, undef()), "unknown only matches unknown")
  // known k: the old k one ULP off is reusable whatever came out
  debug_assert(reusable(f, undef(), off, undef(), 0.0), "known k one ULP off")
  debug_assert(!reusable(f, undef(), f + 1.0e-6, undef(), 0.0), "known k a millionth off, other result")
  // at most a: an old a one ULP above is reusable even when the result was wider
  debug_assert(reusable(undef(), f, undef(), off + 2.0e-12, f + 1.0), "at most a, one ULP off")
  debug_assert(!reusable(undef(), f, undef(), f + 1.0, f + 1.0), "at most a, wider result past a")
}
