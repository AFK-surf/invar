// Style and Node types for the Flexbox layout engine (Yoga defaults).
// Ported from libs/mbui/src/flex/style.mbt.

import "dmath"

pub enum Dim {
  Auto
  Pt(Double)
  Pct(Double)
  Within(Double)
}

pub enum FlexDirection {
  Column
  Row
  ColumnReverse
  RowReverse
}

pub enum FlexWrap {
  NoWrap
  Wrap
  WrapReverse
}

pub enum Align {
  Auto
  FlexStart
  Center
  FlexEnd
  Stretch
  Baseline
  FirstLineCenter
  SpaceBetween
  SpaceAround
  SpaceEvenly
}

pub enum PositionType {
  Relative
  Absolute
  Static
}

pub enum Display {
  Flex
  DisplayNone
  Contents
}

pub enum BoxSizing {
  BorderBox
  ContentBox
}

pub enum Overflow {
  Visible
  Hidden
  Scroll
}

pub enum MeasureMode {
  Undefined
  Exactly
  AtMost
}

pub let LEN_AUTO : Int = 0
pub let LEN_PT : Int = 1
pub let LEN_PCT : Int = 2
pub let LEN_WITHIN : Int = 3

fn dim_k(d : Dim) -> Int {
  match d {
    Dim::Auto => LEN_AUTO
    Dim::Pt(_) => LEN_PT
    Dim::Pct(_) => LEN_PCT
    Dim::Within(_) => LEN_WITHIN
  }
}

fn dim_v(d : Dim) -> Double {
  match d {
    Dim::Auto => 0.0
    Dim::Pt(v) => v
    Dim::Pct(p) => p
    Dim::Within(v) => v
  }
}

fn dim_of(k : Int, v : Double) -> Dim {
  if k == LEN_PT {
    Dim::Pt(v)
  } else if k == LEN_PCT {
    Dim::Pct(v)
  } else if k == LEN_WITHIN {
    Dim::Within(v)
  } else {
    Dim::Auto
  }
}

fn dir_eq(a : FlexDirection, b : FlexDirection) -> Bool {
  match (a, b) {
    (FlexDirection::Column, FlexDirection::Column) => true
    (FlexDirection::Row, FlexDirection::Row) => true
    (FlexDirection::ColumnReverse, FlexDirection::ColumnReverse) => true
    (FlexDirection::RowReverse, FlexDirection::RowReverse) => true
    _ => false
  }
}

fn wrap_eq(a : FlexWrap, b : FlexWrap) -> Bool {
  match (a, b) {
    (FlexWrap::NoWrap, FlexWrap::NoWrap) => true
    (FlexWrap::Wrap, FlexWrap::Wrap) => true
    (FlexWrap::WrapReverse, FlexWrap::WrapReverse) => true
    _ => false
  }
}

fn align_eq(a : Align, b : Align) -> Bool {
  match (a, b) {
    (Align::Auto, Align::Auto) => true
    (Align::FlexStart, Align::FlexStart) => true
    (Align::Center, Align::Center) => true
    (Align::FlexEnd, Align::FlexEnd) => true
    (Align::Stretch, Align::Stretch) => true
    (Align::Baseline, Align::Baseline) => true
    (Align::FirstLineCenter, Align::FirstLineCenter) => true
    (Align::SpaceBetween, Align::SpaceBetween) => true
    (Align::SpaceAround, Align::SpaceAround) => true
    (Align::SpaceEvenly, Align::SpaceEvenly) => true
    _ => false
  }
}

fn pos_eq(a : PositionType, b : PositionType) -> Bool {
  match (a, b) {
    (PositionType::Relative, PositionType::Relative) => true
    (PositionType::Absolute, PositionType::Absolute) => true
    (PositionType::Static, PositionType::Static) => true
    _ => false
  }
}

fn disp_eq(a : Display, b : Display) -> Bool {
  match (a, b) {
    (Display::Flex, Display::Flex) => true
    (Display::DisplayNone, Display::DisplayNone) => true
    (Display::Contents, Display::Contents) => true
    _ => false
  }
}

fn sizing_eq(a : BoxSizing, b : BoxSizing) -> Bool {
  match (a, b) {
    (BoxSizing::BorderBox, BoxSizing::BorderBox) => true
    (BoxSizing::ContentBox, BoxSizing::ContentBox) => true
    _ => false
  }
}

fn overflow_eq(a : Overflow, b : Overflow) -> Bool {
  match (a, b) {
    (Overflow::Visible, Overflow::Visible) => true
    (Overflow::Hidden, Overflow::Hidden) => true
    (Overflow::Scroll, Overflow::Scroll) => true
    _ => false
  }
}

