pub fn Style::new() -> Style {
  let nan = dmath::nan()
  Style::{
    display: Display::Flex,
    position: PositionType::Relative,
    direction: FlexDirection::Column,
    wrap: FlexWrap::NoWrap,
    justify: Align::FlexStart,
    align_items: Align::Stretch,
    align_self: Align::Auto,
    align_content: Align::FlexStart,
    grow: 0.0,
    shrink: 0.0,
    aspect: 0.0,
    box_sizing: BoxSizing::BorderBox,
    overflow: Overflow::Visible,
    drop: 0,
    fits: false,
    one_of: false,
    fit_need: nan,
    fit_whole: false,
    cut_least: nan,
    soft_min: nan,
    stretch_past_max: false,
    min_held: false,
    wrap_least: false,
    content_share: nan,
    come_from: nan,
    come_to: nan,
    come_at: nan,
    come_now: nan,
    come_ends: nan,
    come_k: 1.0,
    come_v: 0.0,
    come_goal: nan,
    come_whole: nan,
    come_plan: nan,
    come_turn: None,
    come_group: None,
    come_fill: false,
    come_across: false,
    come_spec: None,
    come_foot: false,
    come_grid: 0.0,
    gone_empty: false,
    structural: false,
    rows_grid: 0.0,
    ver: 0,
    basis_v: 0.0,
    basis_k: LEN_AUTO,
    width_v: 0.0,
    width_k: LEN_AUTO,
    height_v: 0.0,
    height_k: LEN_AUTO,
    min_width_v: 0.0,
    min_width_k: LEN_AUTO,
    min_height_v: 0.0,
    min_height_k: LEN_AUTO,
    max_width_v: 0.0,
    max_width_k: LEN_AUTO,
    max_height_v: 0.0,
    max_height_k: LEN_AUTO,
    margin_left_v: 0.0,
    margin_left_k: LEN_PT,
    margin_top_v: 0.0,
    margin_top_k: LEN_PT,
    margin_right_v: 0.0,
    margin_right_k: LEN_PT,
    margin_bottom_v: 0.0,
    margin_bottom_k: LEN_PT,
    padding_left_v: 0.0,
    padding_left_k: LEN_PT,
    padding_top_v: 0.0,
    padding_top_k: LEN_PT,
    padding_right_v: 0.0,
    padding_right_k: LEN_PT,
    padding_bottom_v: 0.0,
    padding_bottom_k: LEN_PT,
    border_left_v: 0.0,
    border_left_k: LEN_PT,
    border_top_v: 0.0,
    border_top_k: LEN_PT,
    border_right_v: 0.0,
    border_right_k: LEN_PT,
    border_bottom_v: 0.0,
    border_bottom_k: LEN_PT,
    inset_left_v: 0.0,
    inset_left_k: LEN_AUTO,
    inset_top_v: 0.0,
    inset_top_k: LEN_AUTO,
    inset_right_v: 0.0,
    inset_right_k: LEN_AUTO,
    inset_bottom_v: 0.0,
    inset_bottom_k: LEN_AUTO,
    gap_row_v: 0.0,
    gap_row_k: LEN_PT,
    gap_col_v: 0.0,
    gap_col_k: LEN_PT,
  }
}

pub fn Style::reset(self : Style) -> Unit {
  let nan = dmath::nan()
  self.display = Display::Flex
  self.position = PositionType::Relative
  self.direction = FlexDirection::Column
  self.wrap = FlexWrap::NoWrap
  self.justify = Align::FlexStart
  self.align_items = Align::Stretch
  self.align_self = Align::Auto
  self.align_content = Align::FlexStart
  self.grow = 0.0
  self.shrink = 0.0
  self.aspect = 0.0
  self.box_sizing = BoxSizing::BorderBox
  self.overflow = Overflow::Visible
  self.drop = 0
  self.fits = false
  self.one_of = false
  self.fit_need = nan
  self.fit_whole = false
  self.cut_least = nan
  self.soft_min = nan
  self.stretch_past_max = false
  self.min_held = false
  self.wrap_least = false
  self.gone_empty = false
  self.structural = false
  self.come_fill = false
  self.ver += 1
  self.basis_v = 0.0
  self.basis_k = LEN_AUTO
  self.width_v = 0.0
  self.width_k = LEN_AUTO
  self.height_v = 0.0
  self.height_k = LEN_AUTO
  self.min_width_v = 0.0
  self.min_width_k = LEN_AUTO
  self.min_height_v = 0.0
  self.min_height_k = LEN_AUTO
  self.max_width_v = 0.0
  self.max_width_k = LEN_AUTO
  self.max_height_v = 0.0
  self.max_height_k = LEN_AUTO
  self.margin_left_v = 0.0
  self.margin_left_k = LEN_PT
  self.margin_top_v = 0.0
  self.margin_top_k = LEN_PT
  self.margin_right_v = 0.0
  self.margin_right_k = LEN_PT
  self.margin_bottom_v = 0.0
  self.margin_bottom_k = LEN_PT
  self.padding_left_v = 0.0
  self.padding_left_k = LEN_PT
  self.padding_top_v = 0.0
  self.padding_top_k = LEN_PT
  self.padding_right_v = 0.0
  self.padding_right_k = LEN_PT
  self.padding_bottom_v = 0.0
  self.padding_bottom_k = LEN_PT
  self.border_left_v = 0.0
  self.border_left_k = LEN_PT
  self.border_top_v = 0.0
  self.border_top_k = LEN_PT
  self.border_right_v = 0.0
  self.border_right_k = LEN_PT
  self.border_bottom_v = 0.0
  self.border_bottom_k = LEN_PT
  self.inset_left_v = 0.0
  self.inset_left_k = LEN_AUTO
  self.inset_top_v = 0.0
  self.inset_top_k = LEN_AUTO
  self.inset_right_v = 0.0
  self.inset_right_k = LEN_AUTO
  self.inset_bottom_v = 0.0
  self.inset_bottom_k = LEN_AUTO
  self.gap_row_v = 0.0
  self.gap_row_k = LEN_PT
  self.gap_col_v = 0.0
  self.gap_col_k = LEN_PT
}

pub fn Style::set_basis(self : Style, d : Dim) -> Unit { self.basis_k = dim_k(d); self.basis_v = dim_v(d); self.ver += 1 }
pub fn Style::basis_kind(self : Style) -> Int { self.basis_k }
pub fn Style::basis_value(self : Style) -> Double { self.basis_v }
pub fn Style::get_basis(self : Style) -> Dim { dim_of(self.basis_k, self.basis_v) }

