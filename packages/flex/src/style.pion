///|
/// Whether it takes no room holding nothing (its `gone_empty`), its box (no least of its padding so) made again.
pub fn Style::set_gone_empty(self : Style, on : Bool) -> Unit {
  if self.gone_empty != on {
    self.gone_empty = on
    self.ver = self.ver + 1
  }
}

///|
pub fn Style::set_box_sizing(self : Style, b : BoxSizing) -> Unit {
  self.box_sizing = b
  self.ver = self.ver + 1
}

///|
pub fn Style::get_box_sizing(self : Style) -> BoxSizing {
  self.box_sizing
}

///|
/// Sets margin's four sides to `d`.
pub fn Style::set_margin(self : Style, d : Dim) -> Unit {
  self.set_margin_left(d)
  self.set_margin_top(d)
  self.set_margin_right(d)
  self.set_margin_bottom(d)
}

///|
/// Sets padding's four sides to `d`.
pub fn Style::set_padding(self : Style, d : Dim) -> Unit {
  self.set_padding_left(d)
  self.set_padding_top(d)
  self.set_padding_right(d)
  self.set_padding_bottom(d)
}

///|
/// Measures a leaf from its content: (width, width mode, height, height
/// mode) -> (width, height), as Yoga's measure functions. On a node said
/// to be told its room (Node's `room`), told the room its content box gives
/// what it holds before that is laid out (layout_flex), answering more than
/// 0 first where what it holds changed by it.
// type alias expanded: MeasureFn

///|
pub struct Node {
  pub style : Style
  pub children : Array[Node]
  pub mut measure : Option[(Double, MeasureMode, Double, MeasureMode) -> (Double, Double)]
  pub mut left : Double
  pub mut top : Double
  pub mut width : Double
  pub mut height : Double
  pub mut line : Int
  pub mut pre_gen : Int
  pub mut cache : FixedArray[Double]
  pub mut cache_n : Int
  pub mut cache_gen : Int
  pub mut box_cbw : Double
  pub mut box_cbh : Double
  pub mut box_memo : Option[Box]
  pub mut box_ver : Int
  pub mut dirty : Bool
  pub mut p_ok : Bool
  pub mut room : Bool
  pub mut p_kw : Double
  pub mut p_kh : Double
  pub mut p_cbw : Double
  pub mut p_cbh : Double
  pub mut p_w : Double
  pub mut p_h : Double
  pub mut pre : Array[Double]
  pub mut laid_gen : Int
  pub mut skip_gen : Int
  pub mut hidden_gen : Int
  pub mut holds_gone : Bool
  pub mut first_baseline : Double
  pub mut first_line_mid : Double
}

///|
/// What a node keeps of a measure when it keeps nothing (never written: one
/// that keeps something gets its own).
// moved to 00_init_order.pion: no_pre

///|
pub fn Node::new() -> Node {
  Node::{
    style: Style::new(),
    children: [],
    holds_gone: false,
    measure: Option::None,
    left: 0.0,
    top: 0.0,
    width: 0.0,
    height: 0.0,
    line: 0,
    cache: [],
    cache_n: 0,
    cache_gen: -1,
    box_cbw: 0.0,
    box_cbh: 0.0,
    box_memo: Option::None,
    box_ver: -1,
    dirty: true,
    p_ok: false,
    room: false,
    p_kw: 0.0,
    p_kh: 0.0,
    p_cbw: 0.0,
    p_cbh: 0.0,
    p_w: 0.0,
    p_h: 0.0,
    laid_gen: -1,
    hidden_gen: -1,
    pre_gen: -1,
    pre: no_pre,
    skip_gen: -1,
    first_baseline: undef,
    first_line_mid: undef,
  }
}

///|
/// Whether its row left it out as it was last laid out (Style's `drop`): laid out nowhere, of no size.
pub fn Node::left_out(self : Node) -> Bool {
  self.line < 0
}

///|
/// Whether the last compute() laid this node out again, rather than
/// reusing its layout from before (or not reaching it, its parent's being
/// reused): when it did not, nothing under it moved or changed size.
pub fn Node::laid_out(self : Node) -> Bool {
  self.laid_gen == generation.v
}

///|
/// The compute() that last laid this node out (as `computes` counts them).
pub fn Node::laid_out_at(self : Node) -> Int {
  self.laid_gen
}

///|
/// How many compute()s there have been.
pub fn computes() -> Int {
  generation.v
}

///|
/// What a slot of a node's children past its end holds once cut (Node::children_cut): none of them. An array cut
/// shorter keeps what its slots past the end held, counted as held, till they are written again or it goes (native's
/// counting; moonbitlang/core's Array::truncate, clear, pop and remove), so a node cut from what held it, made
/// another's since, held that one still: two that so held each other, rings native's counting never frees.
// moved to 00_init_order.pion: children_gone

///|
/// Its children cut to their first `len`: those past that let go of (Array::release_unused).
pub fn Node::children_cut(self : Node, len : Int) -> Unit {
  let kids = self.children
  if len < kids.length() {
    kids.truncate(len)
  }
  mbt_compat::arr_release_unused_with(kids, children_gone)
}

///|
/// Its child at `i` taken out, those after it each one earlier, the slot past its end let go of (Node::children_cut).
pub fn Node::child_taken_out(self : Node, i : Int) -> Unit {
  let kids = self.children
  guard i >= 0 && i < kids.length() else { return }
  mbt_compat::arr_remove(kids, i) |> ignore
  mbt_compat::arr_release_unused_with(kids, children_gone)
}

///|
pub fn Node::add(self : Node, child : Node) -> Unit {
  self.children.push(child)
  if child.style.gone_empty {
    self.holds_gone = true
  }
}
