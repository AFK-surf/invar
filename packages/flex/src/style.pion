pub fn Style::gap_row_value(self : Style) -> Double { self.gap_row_v }
pub fn Style::get_gap_row(self : Style) -> Dim { dim_of(self.gap_row_k, self.gap_row_v) }

pub fn Style::set_gap_col(self : Style, d : Dim) -> Unit { self.gap_col_k = dim_k(d); self.gap_col_v = dim_v(d); self.ver += 1 }
pub fn Style::gap_col_kind(self : Style) -> Int { self.gap_col_k }
pub fn Style::gap_col_value(self : Style) -> Double { self.gap_col_v }
pub fn Style::get_gap_col(self : Style) -> Dim { dim_of(self.gap_col_k, self.gap_col_v) }

pub fn Style::set_gone_empty(self : Style, on : Bool) -> Unit {
  if self.gone_empty != on {
    self.gone_empty = on
    self.ver += 1
  }
}

pub fn Style::set_box_sizing(self : Style, b : BoxSizing) -> Unit {
  self.box_sizing = b
  self.ver += 1
}

pub fn Style::get_box_sizing(self : Style) -> BoxSizing {
  self.box_sizing
}

pub fn Style::set_margin(self : Style, d : Dim) -> Unit {
  self.set_margin_left(d)
  self.set_margin_top(d)
  self.set_margin_right(d)
  self.set_margin_bottom(d)
}

pub fn Style::set_padding(self : Style, d : Dim) -> Unit {
  self.set_padding_left(d)
  self.set_padding_top(d)
  self.set_padding_right(d)
  self.set_padding_bottom(d)
}

pub struct Node {
  pub id : Int
  pub style : Style
  pub children : Array[Node]
  pub mut measure : Option[(Double, MeasureMode, Double, MeasureMode) -> (Double, Double)]
  pub mut left : Double
  pub mut top : Double
  pub mut width : Double
  pub mut height : Double
  pub mut line : Int
  pub mut pre_gen : Int
  pub mut cache : Array[Double]
  pub mut cache_n : Int
  pub mut cache_gen : Int
  pub mut box_cbw : Double
  pub mut box_cbh : Double
  mut box_memo : Option[Box]
  pub mut box_ver : Int
  pub mut dirty : Bool
  pub mut p_ok : Bool
  pub mut room : Bool
  pub mut p_kw : Double
  pub mut p_kh : Double
  pub mut p_cbw : Double
  pub mut p_cbh : Double
  pub mut p_w : Double
  pub mut p_h : Double
  pub mut pre : Array[Double]
  pub mut laid_gen : Int
  pub mut skip_gen : Int
  pub mut hidden_gen : Int
  pub mut holds_gone : Bool
  pub mut first_baseline : Double
  pub mut first_line_mid : Double
}

pub fn Node::new() -> Node {
  let nan = dmath::nan()
  let nid = next_node_id()
  Node::{
    id: nid,
    style: Style::new(),
    children: [],
    holds_gone: false,
    measure: None,
    left: 0.0,
    top: 0.0,
    width: 0.0,
    height: 0.0,
    line: 0,
    cache: [],
    cache_n: 0,
    cache_gen: -1,
    box_cbw: 0.0,
    box_cbh: 0.0,
    box_memo: None,
    box_ver: -1,
    dirty: true,
    p_ok: false,
    room: false,
    p_kw: 0.0,
    p_kh: 0.0,
    p_cbw: 0.0,
    p_cbh: 0.0,
    p_w: 0.0,
    p_h: 0.0,
    laid_gen: -1,
    hidden_gen: -1,
    pre_gen: -1,
    pre: [],
    skip_gen: -1,
    first_baseline: nan,
    first_line_mid: nan,
  }
}

pub fn Node::left_out(self : Node) -> Bool {
  self.line < 0
}

pub fn Node::laid_out(self : Node) -> Bool {
  self.laid_gen == get_generation()
}

pub fn Node::laid_out_at(self : Node) -> Int {
  self.laid_gen
}

pub fn Node::children_cut(self : Node, len : Int) -> Unit {
  let kids = self.children
  while kids.length() > len {
    let _ = kids.pop()
  }
}

pub fn Node::child_taken_out(self : Node, i : Int) -> Unit {
  let kids = self.children
  if i < 0 || i >= kids.length() {
    return
  }
  let last = kids.length() - 1
  for j in i..<last {
    kids[j] = kids[j + 1]
  }
  let _ = kids.pop()
}

pub fn Node::add(self : Node, child : Node) -> Unit {
  self.children.push(child)
  if child.style.gone_empty {
    self.holds_gone = true
  }
}
