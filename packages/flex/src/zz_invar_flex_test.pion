// Comprehensive Flexbox & Yoga test suite (30+ core scenarios).
// Baseline flex layout, grid, reuse, flip, and motion curve tests.

fn near_f(a : Double, b : Double) -> Bool {
  (a - b).abs() < 1.0e-4
}

fn check_rect(n : Node, l : Double, t : Double, w : Double, h : Double, msg : String) -> Unit {
  debug_assert(near_f(n.left, l) && near_f(n.top, t) && near_f(n.width, w) && near_f(n.height, h), msg)
}

fn pt(v : Double) -> Dim { Dim::Pt(v) }
fn pct_d(v : Double) -> Dim { Dim::Pct(v) }

test "flex 01: column default direction stacks vertically" {
  let root = Node::new()
  root.style.set_width(pt(100.0))
  root.style.set_height(pt(100.0))
  let a = Node::new(); a.style.set_height(pt(20.0)); root.add(a)
  let b = Node::new(); b.style.set_height(pt(30.0)); root.add(b)
  compute(root)
  check_rect(root, 0.0, 0.0, 100.0, 100.0, "root")
  check_rect(a, 0.0, 0.0, 100.0, 20.0, "a")
  check_rect(b, 0.0, 20.0, 100.0, 30.0, "b")
}

test "flex 02: row direction lays out horizontally" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(100.0))
  root.style.set_height(pt(50.0))
  let a = Node::new(); a.style.set_width(pt(25.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(35.0)); root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 25.0, 50.0, "a")
  check_rect(b, 25.0, 0.0, 35.0, 50.0, "b")
}

test "flex 03: row-reverse and column-reverse" {
  let r = Node::new()
  r.style.direction = FlexDirection::RowReverse
  r.style.set_width(pt(100.0)); r.style.set_height(pt(40.0))
  let a = Node::new(); a.style.set_width(pt(20.0)); r.add(a)
  let b = Node::new(); b.style.set_width(pt(30.0)); r.add(b)
  compute(r)
  check_rect(a, 80.0, 0.0, 20.0, 40.0, "row-rev a")
  check_rect(b, 50.0, 0.0, 30.0, 40.0, "row-rev b")

  let c = Node::new()
  c.style.direction = FlexDirection::ColumnReverse
  c.style.set_width(pt(40.0)); c.style.set_height(pt(100.0))
  let x = Node::new(); x.style.set_height(pt(20.0)); c.add(x)
  let y = Node::new(); y.style.set_height(pt(30.0)); c.add(y)
  compute(c)
  check_rect(x, 0.0, 80.0, 40.0, 20.0, "col-rev x")
  check_rect(y, 0.0, 50.0, 40.0, 30.0, "col-rev y")
}

test "flex 04: flex-grow proportional distribution" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(300.0)); root.style.set_height(pt(40.0))
  let a = Node::new(); a.style.grow = 1.0; root.add(a)
  let b = Node::new(); b.style.grow = 2.0; root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 100.0, 40.0, "grow 1")
  check_rect(b, 100.0, 0.0, 200.0, 40.0, "grow 2")
}

test "flex 05: flex-shrink weighted by basis" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(100.0)); root.style.set_height(pt(40.0))
  let a = Node::new(); a.style.set_width(pt(80.0)); a.style.shrink = 1.0; root.add(a)
  let b = Node::new(); b.style.set_width(pt(80.0)); b.style.shrink = 1.0; root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 50.0, 40.0, "shrink a")
  check_rect(b, 50.0, 0.0, 50.0, 40.0, "shrink b")
}

test "flex 06: flex-basis overrides width in row" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(200.0)); root.style.set_height(pt(50.0))
  let a = Node::new(); a.style.set_width(pt(20.0)); a.style.set_basis(pt(70.0)); root.add(a)
  let b = Node::new(); b.style.set_basis(pct_d(25.0)); root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 70.0, 50.0, "basis pt")
  check_rect(b, 70.0, 0.0, 50.0, 50.0, "basis pct")
}

test "flex 07: justify-content center, flex-end, space-between, space-around, space-evenly" {
  let mk = fn(j : Align) -> (Node, Node) {
    let root = Node::new()
    root.style.direction = FlexDirection::Row
    root.style.justify = j
    root.style.set_width(pt(100.0)); root.style.set_height(pt(20.0))
    let a = Node::new(); a.style.set_width(pt(20.0)); root.add(a)
    let b = Node::new(); b.style.set_width(pt(20.0)); root.add(b)
    compute(root)
    (a, b)
  }
  let (a1, b1) = mk(Align::Center)
  check_rect(a1, 30.0, 0.0, 20.0, 20.0, "center a")
  check_rect(b1, 50.0, 0.0, 20.0, 20.0, "center b")
  let (a2, b2) = mk(Align::FlexEnd)
  check_rect(a2, 60.0, 0.0, 20.0, 20.0, "end a")
  check_rect(b2, 80.0, 0.0, 20.0, 20.0, "end b")
  let (a3, b3) = mk(Align::SpaceBetween)
  check_rect(a3, 0.0, 0.0, 20.0, 20.0, "between a")
  check_rect(b3, 80.0, 0.0, 20.0, 20.0, "between b")
  let (a4, b4) = mk(Align::SpaceAround)
  check_rect(a4, 15.0, 0.0, 20.0, 20.0, "around a")
  check_rect(b4, 65.0, 0.0, 20.0, 20.0, "around b")
  let (a5, b5) = mk(Align::SpaceEvenly)
  check_rect(a5, 20.0, 0.0, 20.0, 20.0, "evenly a")
  check_rect(b5, 60.0, 0.0, 20.0, 20.0, "evenly b")
}

test "flex 08: align-items and align-self" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.align_items = Align::Center
  root.style.set_width(pt(120.0)); root.style.set_height(pt(100.0))
  let a = Node::new(); a.style.set_width(pt(20.0)); a.style.set_height(pt(20.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(20.0)); b.style.set_height(pt(20.0)); b.style.align_self = Align::FlexEnd; root.add(b)
  let c = Node::new(); c.style.set_width(pt(20.0)); c.style.align_self = Align::Stretch; root.add(c)
  compute(root)
  check_rect(a, 0.0, 40.0, 20.0, 20.0, "align center")
  check_rect(b, 20.0, 80.0, 20.0, 20.0, "align-self end")
  check_rect(c, 40.0, 0.0, 20.0, 100.0, "align-self stretch")
}

test "flex 09: padding, border, and margin" {
  let root = Node::new()
  root.style.set_width(pt(100.0)); root.style.set_height(pt(100.0))
  root.style.set_padding(pt(10.0))
  root.style.set_border_left(pt(2.0)); root.style.set_border_top(pt(3.0))
  let child = Node::new()
  child.style.set_margin(pt(5.0))
  child.style.set_height(pt(20.0))
  root.add(child)
  compute(root)
  // content width = 100 - 20 - 2 = 78; minus margins 10 -> 68
  check_rect(child, 17.0, 18.0, 68.0, 20.0, "pad+border+margin")
}

test "flex 10: gap row and column" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_gap_col(pt(10.0))
  root.style.set_height(pt(20.0))
  let a = Node::new(); a.style.set_width(pt(30.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(30.0)); root.add(b)
  let c = Node::new(); c.style.set_width(pt(30.0)); root.add(c)
  compute(root)
  check_rect(root, 0.0, 0.0, 110.0, 20.0, "root with gaps")
  check_rect(a, 0.0, 0.0, 30.0, 20.0, "a")
  check_rect(b, 40.0, 0.0, 30.0, 20.0, "b")
  check_rect(c, 80.0, 0.0, 30.0, 20.0, "c")
}

test "flex 11: aspect ratio fills missing dimension" {
  let root = Node::new()
  root.style.set_width(pt(100.0))
  root.style.aspect = 2.0
  compute(root)
  check_rect(root, 0.0, 0.0, 100.0, 50.0, "aspect w->h")

  let r2 = Node::new()
  r2.style.set_height(pt(40.0))
  r2.style.aspect = 2.5
  compute(r2)
  check_rect(r2, 0.0, 0.0, 100.0, 40.0, "aspect h->w")
}

test "flex 12: min and max width/height clamping" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(200.0)); root.style.set_height(pt(100.0))
  let a = Node::new(); a.style.grow = 1.0; a.style.set_basis(pt(0.0)); a.style.set_max_width(pt(60.0)); root.add(a)
  let b = Node::new(); b.style.grow = 1.0; b.style.set_basis(pt(0.0)); b.style.set_min_width(pt(150.0)); root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 50.0, 100.0, "a yields to b min_width")
  check_rect(b, 50.0, 0.0, 150.0, 100.0, "b min_width held")
}

test "flex 13: nested flex containers" {
  let root = Node::new()
  root.style.set_width(pt(200.0)); root.style.set_height(pt(120.0))
  let top_bar = Node::new()
  top_bar.style.direction = FlexDirection::Row
  top_bar.style.set_height(pt(40.0))
  let left = Node::new(); left.style.set_width(pt(50.0)); top_bar.add(left)
  let spacer = Node::new(); spacer.style.grow = 1.0; top_bar.add(spacer)
  let right = Node::new(); right.style.set_width(pt(30.0)); top_bar.add(right)
  let body = Node::new(); body.style.grow = 1.0
  root.add(top_bar)
  root.add(body)
  compute(root)
  check_rect(top_bar, 0.0, 0.0, 200.0, 40.0, "top_bar")
  check_rect(left, 0.0, 0.0, 50.0, 40.0, "left")
  check_rect(spacer, 50.0, 0.0, 120.0, 40.0, "spacer")
  check_rect(right, 170.0, 0.0, 30.0, 40.0, "right")
  check_rect(body, 0.0, 40.0, 200.0, 80.0, "body")
}

test "flex 14: flex-wrap wraps into multiple lines with align-content" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.wrap = FlexWrap::Wrap
  root.style.set_width(pt(100.0))
  root.style.set_gap_row(pt(10.0))
  let a = Node::new(); a.style.set_width(pt(60.0)); a.style.set_height(pt(20.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(60.0)); b.style.set_height(pt(30.0)); root.add(b)
  compute(root)
  check_rect(root, 0.0, 0.0, 100.0, 60.0, "wrapped root")
  check_rect(a, 0.0, 0.0, 60.0, 20.0, "line 0")
  check_rect(b, 0.0, 30.0, 60.0, 30.0, "line 1")
}

test "flex 15: wrap-reverse flips cross axis" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.wrap = FlexWrap::WrapReverse
  root.style.set_width(pt(100.0)); root.style.set_height(pt(100.0))
  let a = Node::new(); a.style.set_width(pt(60.0)); a.style.set_height(pt(20.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(60.0)); b.style.set_height(pt(30.0)); root.add(b)
  compute(root)
  check_rect(a, 0.0, 80.0, 60.0, 20.0, "wrap-rev a")
  check_rect(b, 0.0, 50.0, 60.0, 30.0, "wrap-rev b")
}

test "flex 16: absolute positioning with insets and right/bottom" {
  let root = Node::new()
  root.style.set_width(pt(200.0)); root.style.set_height(pt(100.0))
  let a = Node::new()
  a.style.position = PositionType::Absolute
  a.style.set_inset_left(pt(10.0)); a.style.set_inset_right(pt(20.0))
  a.style.set_inset_top(pt(5.0)); a.style.set_inset_bottom(pt(15.0))
  root.add(a)
  let b = Node::new()
  b.style.position = PositionType::Absolute
  b.style.set_width(pt(30.0)); b.style.set_height(pt(20.0))
  b.style.set_inset_right(pt(10.0)); b.style.set_inset_bottom(pt(10.0))
  root.add(b)
  compute(root)
  check_rect(a, 10.0, 5.0, 170.0, 80.0, "abs stretched")
  check_rect(b, 160.0, 70.0, 30.0, 20.0, "abs right/bottom")
}

test "flex 17: relative positioning offsets without affecting siblings" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(100.0)); root.style.set_height(pt(50.0))
  let a = Node::new(); a.style.set_width(pt(30.0)); a.style.set_inset_left(pt(10.0)); a.style.set_inset_top(pt(5.0)); root.add(a)
  let b = Node::new(); b.style.set_width(pt(30.0)); root.add(b)
  compute(root)
  check_rect(a, 10.0, 5.0, 30.0, 50.0, "rel offset")
  check_rect(b, 30.0, 0.0, 30.0, 50.0, "sibling unaffected")
}

test "flex 18: display none and display contents" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(100.0)); root.style.set_height(pt(40.0))
  let hidden = Node::new(); hidden.style.display = Display::DisplayNone; hidden.style.set_width(pt(50.0)); root.add(hidden)
  let wrap_c = Node::new(); wrap_c.style.display = Display::Contents
  let inner = Node::new(); inner.style.set_width(pt(40.0)); wrap_c.add(inner)
  root.add(wrap_c)
  compute(root)
  check_rect(hidden, 0.0, 0.0, 0.0, 0.0, "display none zeroed")
  check_rect(inner, 0.0, 0.0, 40.0, 40.0, "contents lifted")
}

test "flex 19: auto margins center item" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.set_width(pt(100.0)); root.style.set_height(pt(100.0))
  let a = Node::new()
  a.style.set_width(pt(20.0)); a.style.set_height(pt(20.0))
  a.style.set_margin(Dim::Auto)
  root.add(a)
  compute(root)
  check_rect(a, 40.0, 40.0, 20.0, 20.0, "auto margins center")
}

test "flex 20: content-box vs border-box" {
  let root = Node::new()
  root.style.set_box_sizing(BoxSizing::ContentBox)
  root.style.set_width(pt(100.0)); root.style.set_height(pt(50.0))
  root.style.set_padding(pt(10.0))
  compute(root)
  check_rect(root, 0.0, 0.0, 120.0, 70.0, "content-box adds padding")
}

test "flex 21: percentage dimensions and Within" {
  let root = Node::new()
  root.style.set_width(pt(200.0)); root.style.set_height(pt(100.0))
  let a = Node::new(); a.style.set_width(pct_d(50.0)); a.style.set_height(pct_d(25.0)); root.add(a)
  let b = Node::new(); b.style.set_width(Dim::Within(320.0)); b.style.set_height(pt(20.0)); root.add(b)
  compute(root)
  check_rect(a, 0.0, 0.0, 100.0, 25.0, "percent")
  check_rect(b, 0.0, 25.0, 200.0, 20.0, "within capped by cb")
}

test "flex 22: leaf measure function and baseline alignment" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.align_items = Align::Baseline
  root.style.set_width(pt(200.0))
  let a = Node::new()
  a.measure = Some(fn(_w : Double, _wm : MeasureMode, _h : Double, _hm : MeasureMode) -> (Double, Double) {
    first_line_told(14.0, 8.0)
    (40.0, 20.0)
  })
  let b = Node::new()
  b.measure = Some(fn(_w : Double, _wm : MeasureMode, _h : Double, _hm : MeasureMode) -> (Double, Double) {
    first_line_told(24.0, 14.0)
    (40.0, 30.0)
  })
  root.add(a)
  root.add(b)
  compute(root)
  check_rect(a, 0.0, 10.0, 40.0, 20.0, "baseline shifted down 10")
  check_rect(b, 40.0, 0.0, 40.0, 30.0, "tallest baseline at 0")
}

test "flex 23: pixel grid snapping (grid=2.0 and grid=3.0)" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.justify = Align::Center
  root.style.set_width(pt(101.0)); root.style.set_height(pt(40.0))
  let a = Node::new(); a.style.set_width(pt(20.0)); root.add(a)
  compute(root, round=false, grid=2.0)
  // (101 - 20) / 2 = 40.5, exact on grid=2.0
  debug_assert(near_f(a.left, 40.5), "grid 2.0 half pt")
  compute(root, round=false, grid=1.0)
  // 40.5 rounds half-up to 41.0 on grid=1.0
  debug_assert(near_f(a.left, 41.0), "grid 1.0 round half-up")
}

test "flex 24: reuse cache skips clean subtrees" {
  let root = Node::new()
  root.style.set_width(pt(200.0)); root.style.set_height(pt(200.0))
  let a = Node::new(); a.style.set_height(pt(50.0)); root.add(a)
  let b = Node::new(); b.style.set_height(pt(50.0)); root.add(b)
  compute(root, round=false, reuse=true)
  let gen1 = a.laid_out_at()
  // Second compute without dirtying anything: reused
  compute(root, round=false, reuse=true)
  debug_assert(a.laid_out_at() == gen1, "clean subtree reused")
  // Dirty only b and root
  b.style.set_height(pt(80.0))
  b.dirty = true
  root.dirty = true
  compute(root, round=false, reuse=true)
  debug_assert(a.laid_out_at() == gen1, "a still reused")
  debug_assert(b.laid_out_at() == computes() && near_f(b.height, 80.0), "b relaid")
}

test "flex 25: fits row drops overflow items and shows ellipsis" {
  let root = Node::new()
  root.style.direction = FlexDirection::Row
  root.style.fits = true
  root.style.set_width(pt(100.0)); root.style.set_height(pt(30.0))
  let title = Node::new(); title.style.set_width(pt(60.0)); root.add(title)
  let btn = Node::new(); btn.style.set_width(pt(50.0)); btn.style.drop = 1; root.add(btn)
  let more = Node::new(); more.style.set_width(pt(20.0)); more.style.drop = -1; root.add(more)
  compute(root)
  debug_assert(!title.left_out(), "title kept")
  debug_assert(btn.left_out(), "btn dropped")
  debug_assert(!more.left_out(), "ellipsis shown")
}

test "flex 26: move_ms, move_at, move_path, come_way, and FlipWay" {
  debug_assert(near_f(move_ms(0.0), 200.0), "move_ms min")
  debug_assert(near_f(move_ms(10000.0), 500.0), "move_ms max")
  debug_assert(near_f(move_at(0.0), 0.0) && near_f(move_at(1.0), 1.0), "move_at ends")
  let mid = move_at(0.5)
  debug_assert(mid > 0.85 && mid < 0.95, "move_at 0.5 ~0.9")
  let (x0, _) = come_way(0.0, 0.0, 100.0, 0.0)
  let dur = come_way_ms(0.0, 0.0, 100.0)
  let (x1, v1) = come_way(0.0, 0.0, 100.0, dur)
  debug_assert(near_f(x0, 0.0) && near_f(x1, 100.0) && near_f(v1, 0.0), "come_way endpoints")

  let item = FlipItem::{ off: (100.0, 0.0, 0.0, 0.0), v: (0.0, 0.0, 0.0, 0.0) }
  let fw = FlipWay::new(1000.0, [item])
  let (k0, _) = fw.left(1000.0)
  let (k1, _) = fw.left(fw.ends())
  debug_assert(near_f(k0, 1.0) && near_f(k1, 0.0), "FlipWay endpoints")
}

test "flex 27: gone_empty collapses empty container" {
  let root = Node::new()
  root.style.set_width(pt(100.0))
  let box = Node::new()
  box.style.set_gone_empty(true)
  box.style.set_padding(pt(12.0))
  let hidden = Node::new()
  hidden.style.display = Display::DisplayNone
  hidden.style.set_height(pt(30.0))
  box.add(hidden)
  root.add(box)
  compute(root)
  check_rect(root, 0.0, 0.0, 100.0, 0.0, "gone_empty collapsed")
}
