// Optical text loupe (magnifier) pure geometry with viewport edge avoidance and sampling offsets.
// Zero host dependencies; ready for UI layers to render directly with `paint::Glass::clear(zoom=...)`.

import "dmath"
import "paint"

/// Default optical loupe dimensions and zoom factor.
pub let loupe_default_width : Double = 112.0
pub let loupe_default_height : Double = 48.0
pub let loupe_default_zoom : Double = 1.4
pub let loupe_default_offset_y : Double = 54.0
pub let loupe_default_margin : Double = 8.0
pub let loupe_reach : Double = 26.0

/// Configuration for optical loupe sizing, magnification, and viewport margin.
pub struct LoupeConfig {
  pub width : Double
  pub height : Double
  pub zoom : Double
  pub offset_y : Double
  pub margin : Double
  pub corner_radius : Double
}

pub fn LoupeConfig::default() -> LoupeConfig {
  LoupeConfig::{
    width: loupe_default_width,
    height: loupe_default_height,
    zoom: loupe_default_zoom,
    offset_y: loupe_default_offset_y,
    margin: loupe_default_margin,
    corner_radius: loupe_default_height * 0.5,
  }
}

/// Computed optical loupe placement, edge-clamped center, and magnified content sampling region.
pub struct LoupeGeometry {
  pub visible : Bool
  pub center_x : Double
  pub center_y : Double
  pub x : Double
  pub y : Double
  pub width : Double
  pub height : Double
  pub corner_radius : Double
  pub zoom : Double
  pub focus_x : Double
  pub focus_y : Double
  pub sample_x0 : Double
  pub sample_y0 : Double
  pub sample_w : Double
  pub sample_h : Double
  pub sample_offset_x : Double
  pub sample_offset_y : Double
  pub clamped_x : Bool
  pub clamped_y : Bool
}

/// Compute optical loupe geometry for a caret / drag focus point `(focus_x, focus_y)`
/// inside a viewport `(viewport_x, viewport_y, viewport_w, viewport_h)`.
pub fn compute_loupe(
  focus_x : Double,
  focus_y : Double,
  viewport_w : Double,
  viewport_h : Double,
  config~ : LoupeConfig = LoupeConfig::default(),
  viewport_x~ : Double = 0.0,
  viewport_y~ : Double = 0.0,
) -> LoupeGeometry {
  let w = dmath::max(1.0, config.width)
  let h = dmath::max(1.0, config.height)
  let zoom = dmath::max(1.0, config.zoom)
  let margin = dmath::max(0.0, config.margin)
  let half_w = w * 0.5
  let half_h = h * 0.5

  let min_cx = viewport_x + margin + half_w
  let max_cx = viewport_x + viewport_w - margin - half_w
  let desired_cx = focus_x
  let center_x = if min_cx <= max_cx {
    dmath::clamp(desired_cx, min_cx, max_cx)
  } else {
    viewport_x + viewport_w * 0.5
  }
  let clamped_x = dmath::abs(center_x - desired_cx) > 0.0001

  let min_cy = viewport_y + margin + half_h
  let max_cy = viewport_y + viewport_h - margin - half_h
  let desired_cy = focus_y - config.offset_y
  let center_y = if min_cy <= max_cy {
    dmath::clamp(desired_cy, min_cy, max_cy)
  } else {
    viewport_y + viewport_h * 0.5
  }
  let clamped_y = dmath::abs(center_y - desired_cy) > 0.0001

  let clamped_fx = dmath::clamp(focus_x, viewport_x, viewport_x + dmath::max(0.0, viewport_w))
  let clamped_fy = dmath::clamp(focus_y, viewport_y, viewport_y + dmath::max(0.0, viewport_h))

  let sample_w = w / zoom
  let sample_h = h / zoom
  let sample_x0 = clamped_fx - sample_w * 0.5
  let sample_y0 = clamped_fy - sample_h * 0.5

  LoupeGeometry::{
    visible: viewport_w > 0.0 && viewport_h > 0.0,
    center_x,
    center_y,
    x: center_x - half_w,
    y: center_y - half_h,
    width: w,
    height: h,
    corner_radius: config.corner_radius,
    zoom,
    focus_x: clamped_fx,
    focus_y: clamped_fy,
    sample_x0,
    sample_y0,
    sample_w,
    sample_h,
    sample_offset_x: center_x - clamped_fx,
    sample_offset_y: center_y - clamped_fy,
    clamped_x,
    clamped_y,
  }
}

/// Compute loupe geometry directly from an `EditorState` caret position and viewport bounds.
pub fn loupe_for_editor(
  ed : EditorState,
  viewport_w : Double,
  viewport_h : Double,
  origin_x~ : Double = 0.0,
  origin_y~ : Double = 0.0,
  config~ : LoupeConfig = LoupeConfig::default(),
) -> LoupeGeometry {
  let cp = ed.caret_pos(ed.display_caret())
  let fx = origin_x + cp.x
  let fy = origin_y + cp.y + cp.height * 0.5
  compute_loupe(fx, fy, viewport_w, viewport_h, config=config)
}

/// Build the `paint::Glass::clear(zoom=...)` optical material descriptor for this loupe.
pub fn LoupeGeometry::to_glass(self : LoupeGeometry) -> paint::Glass {
  paint::Glass::clear(zoom=self.zoom)
}

/// Bounding pill rectangle for painting the loupe lens.
pub fn LoupeGeometry::bounds(self : LoupeGeometry, color~ : Int64 = 0L) -> paint::Rect {
  let r = self.corner_radius
  paint::rect(self.x, self.y, self.width, self.height, color=color, corners=(r, r, r, r))
}
