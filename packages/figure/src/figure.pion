// Pure-node-tree social & documentation figure canvas primitives:
// `canvas`, `panel`, `words`, `divider`, `badge`.

import "view"

/// Fixed-size figure canvas node. Children may use `panel`, `words`, `divider`, `badge`,
/// or any standard Invar view component.
pub fn canvas(
  parent : view::View,
  w : Double,
  h : Double,
  ground : Int64,
  body : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v
    .width(view::Live::Is(Some(w)), loc=loc)
    .height(view::Live::Is(Some(h)), loc=loc)
    .ground(view::Live::Is(ground), loc=loc)
    .clip(loc=loc)
    body(v)
  })
}

/// Positioned rounded panel node at `(x, y)` within its parent. Children are placed relative to this panel's origin.
pub fn panel(
  parent : view::View,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  ground : Int64,
  radius : Double,
  body : (view::View) -> Unit,
  edge_width~ : Double = 0.0,
  edge_color~ : Int64 = 0L,
  clip~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v
    .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None), loc=loc)
    .width(view::Live::Is(Some(w)), loc=loc)
    .height(view::Live::Is(Some(h)), loc=loc)
    .radius(view::Live::Is(radius), loc=loc)
    if (ground & 0xFFL) != 0L {
      let _ = v.ground(view::Live::Is(ground), loc=loc)
    }
    if edge_width > 0.0 && (edge_color & 0xFFL) != 0L {
      let _ = v.edge(view::Live::Is((edge_width, edge_color)), loc=loc)
    }
    if clip {
      let _ = v.clip(loc=loc)
    }
    body(v)
  })
}

/// Positioned text leaf at `(x, y)` with optional wrapping `width`.
pub fn words(
  parent : view::View,
  x : Double,
  y : Double,
  text : String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  color~ : Int64 = 0x111111FFL,
  width~ : Double = 0.0,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v.over(view::Live::Is(true), edges=(Some(x), Some(y), None, None), loc=loc)
    if width > 0.0 {
      let _ = v.width(view::Live::Is(Some(width)), loc=loc)
    }
    let look = view::WordsLook::of(size, weight=weight, wrap=width > 0.0)
    let _ = v.words(view::Live::Is(text), ink=color, look=look, loc=loc)
  })
}

/// Horizontal hairline divider positioned at `(x, y)` of width `w`.
pub fn divider(
  parent : view::View,
  x : Double,
  y : Double,
  w : Double,
  color~ : Int64 = 0x0000001FL,
  height~ : Double = 1.0,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v
    .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None), loc=loc)
    .width(view::Live::Is(Some(w)), loc=loc)
    .height(view::Live::Is(Some(height)), loc=loc)
    .ground(view::Live::Is(color), loc=loc)
  })
}

/// Compact pill badge positioned at `(x, y)` with background `bg` and foreground `fg`.
pub fn badge(
  parent : view::View,
  x : Double,
  y : Double,
  text : String,
  bg~ : Int64 = 0x111111FFL,
  fg~ : Int64 = 0xFFFFFFFFL,
  size~ : Double = 11.0,
  radius~ : Double = 999.0,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let _ = v
    .over(view::Live::Is(true), edges=(Some(x), Some(y), None, None), loc=loc)
    .padding(view::Live::Is((8.0, 3.0, 8.0, 3.0)), loc=loc)
    .radius(view::Live::Is(radius), loc=loc)
    .ground(view::Live::Is(bg), loc=loc)
    let look = view::WordsLook::of(size, weight=600)
    let _ = v.words(view::Live::Is(text), ink=fg, look=look, loc=loc)
  })
}
