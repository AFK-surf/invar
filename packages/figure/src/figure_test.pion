// Unit tests for `packages/figure`: canvas, panel coordinates & radius, nesting, divider, and badge.

import "ui"
import "view"

fn f_approx(a : Double, b : Double, eps : Double) -> Bool {
  (a - b).abs() <= eps
}

test "figure_canvas_nested_panel_divider_and_badge" {
  let t = ui::Tester::tree(
    fn(root : view::View) {
      let _ = canvas(root, 640.0, 360.0, ui::rgba(248, 249, 252, 255), fn(c : view::View) {
        let _ = panel(c, 32.0, 24.0, 300.0, 200.0, ui::rgba(255, 255, 255, 255), 16.0, fn(p : view::View) {
          let _ = words(p, 16.0, 14.0, "Figure Title", size=18.0, weight=700)
          let _ = divider(p, 16.0, 48.0, 268.0)
          let _ = badge(p, 16.0, 64.0, "BETA", bg=ui::rgba(17, 24, 39, 255), fg=ui::rgba(255, 255, 255, 255))
        })
      })
    },
    w=700.0,
    h=400.0,
  )

  let mut saw_panel = false
  let mut saw_title = false
  let mut saw_divider = false
  let mut saw_badge = false
  for d in t.drawn() {
    if f_approx(d.x, 32.0, 0.5) && f_approx(d.y, 24.0, 0.5) && f_approx(d.w, 300.0, 0.5) && f_approx(d.h, 200.0, 0.5) {
      saw_panel = true
      debug_assert(f_approx(d.radius, 16.0, 0.1), "panel radius is 16")
    }
    if d.words == "Figure Title" {
      saw_title = true
      debug_assert(f_approx(d.x, 48.0, 0.5) && f_approx(d.y, 38.0, 0.5), "nested words placed relative to panel")
    }
    if f_approx(d.x, 48.0, 0.5) && f_approx(d.y, 72.0, 0.5) && f_approx(d.w, 268.0, 0.5) && f_approx(d.h, 1.0, 0.5) {
      saw_divider = true
    }
    if d.words == "BETA" {
      saw_badge = true
      debug_assert(f_approx(d.x, 48.0, 0.5) && f_approx(d.y, 88.0, 0.5), "badge placed relative to panel")
    }
  }
  debug_assert(saw_panel && saw_title && saw_divider && saw_badge, "all figure primitives rendered at expected coords")
  t.dispose()
}
