// Streaming file export / save to Downloads, Choose, or Photos.
// Ported from libs/mbui/src/hostapi/keep.mbt.

/// How a file is kept.
pub enum KeepWay {
  Downloads
  Choose
  Photos
}

pub fn KeepWay::to_string(self : KeepWay) -> String {
  match self {
    KeepWay::Downloads => "Downloads"
    KeepWay::Choose => "Choose"
    KeepWay::Photos => "Photos"
  }
}

pub fn KeepWay::eq(self : KeepWay, other : KeepWay) -> Bool {
  match (self, other) {
    (KeepWay::Downloads, KeepWay::Downloads) => true
    (KeepWay::Choose, KeepWay::Choose) => true
    (KeepWay::Photos, KeepWay::Photos) => true
    _ => false
  }
}

/// How a keep stands.
pub enum Kept {
  Keeping
  KeptAt(String)
  CalledOff
  Failed
}

/// A file being kept.
pub struct Keep {
  id : Int
}

/// Begins keeping a file named `name` (`mime`) via `way`; `None` when this host keeps none.
pub fn keep_begin(name : String, mime : String, way : KeepWay) -> Option[Keep] {
  let w = match way {
    KeepWay::Downloads => 1
    KeepWay::Choose => 2
    KeepWay::Photos => 3
  }
  let id = kp_begin(name, mime, w)
  if id == 0 {
    None
  } else {
    Some(Keep::{ id })
  }
}

/// Appends the next chunk of bytes; false on write failure.
pub fn Keep::append(self : Keep, data : Bytes) -> Bool {
  kp_append(self.id, data) != 0
}

/// Signals all bytes are written: host commits file to its destination.
pub fn Keep::finish(self : Keep) -> Unit {
  kp_finish(self.id)
}

/// Current status of the keep.
pub fn Keep::kept(self : Keep) -> Kept {
  let s = kp_state(self.id)
  if s == 0 {
    Kept::Keeping
  } else if s == 1 {
    Kept::KeptAt(kp_where(self.id))
  } else if s == 2 {
    Kept::CalledOff
  } else {
    Kept::Failed
  }
}

/// Releases the keep handle (cancels if unfinished).
pub fn Keep::end(self : Keep) -> Unit {
  kp_end(self.id)
}

/// Convenience: keeps `data` all at once as `name`.
pub fn keep(name : String, mime : String, data : Bytes, way : KeepWay) -> Option[Keep] {
  match keep_begin(name, mime, way) {
    Some(k) => {
      if k.append(data) {
        k.finish()
      }
      Some(k)
    }
    None => None
  }
}
