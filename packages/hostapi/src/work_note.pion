// Window-thread work attribution for hang diagnostics.
// Ported from libs/mbui/src/hostapi/work_note.mbt.

struct WorkNotingState {
  mut cb : Option[(() -> Double, (String, Double) -> Unit)]
}

let work_noting : WorkNotingState = WorkNotingState::{ cb: None }

let work_noted_ms : Double = 0.1

/// The journal listening, on its clock (`now`), told each part at least `work_noted_ms` long (`note`); None, none.
pub fn work_noted_by(by : Option[(() -> Double, (String, Double) -> Unit)]) -> Unit {
  work_noting.cb = by
}

/// `f` run, and where it took `work_noted_ms` or more on the journal's clock, the journal is told `what()`.
pub fn work_part[T](what : () -> String, f : () -> T) -> T {
  match work_noting.cb {
    None => f()
    Some((now_fn, note)) => {
      let t0 = now_fn()
      let r = f()
      let ms = now_fn() - t0
      if ms >= work_noted_ms {
        note(what(), ms)
      }
      r
    }
  }
}

/// A part timed by whoever runs it begins: the journal's clock now, below 0 where no journal listens.
pub fn work_began() -> Double {
  match work_noting.cb {
    Some((now_fn, _)) => now_fn()
    None => -1.0
  }
}

/// A part took `ms` on the journal's clock (`work_began`'s): the journal told `what` if `ms >= work_noted_ms`.
pub fn work_took(what : String, ms : Double) -> Unit {
  if ms >= work_noted_ms {
    match work_noting.cb {
      Some((_, note)) => note(what, ms)
      None => ()
    }
  }
}
