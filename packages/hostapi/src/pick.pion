// System file/photo/camera pickers and drag-and-drop file reading.
// Ported from libs/mbui/src/hostapi/pick.mbt.

/// What the system's pickers offer.
pub enum PickKind {
  Photos
  Files
  Camera
}

pub fn PickKind::eq(self : PickKind, other : PickKind) -> Bool {
  match (self, other) {
    (PickKind::Photos, PickKind::Photos) => true
    (PickKind::Files, PickKind::Files) => true
    (PickKind::Camera, PickKind::Camera) => true
    _ => false
  }
}

/// A file picked: its name, bytes (or `held` host-file id), size, and optional image `src`.
pub struct Picked {
  pub name : String
  pub bytes : Bytes
  pub held : Int
  pub size : Double
  pub src : String
}

/// An ask of the system's picker under way.
pub struct Pick {
  id : Int
}

/// Its id, as the host's event names it (`set_outside`: kind 3).
pub fn Pick::id(self : Pick) -> Int {
  self.id
}

/// Asks the system for files of `kind` (`hold`: allow host-held large files).
pub fn pick(kind : PickKind, hold : Bool) -> Option[Pick] {
  let k = match kind {
    PickKind::Photos => 1
    PickKind::Files => 2
    PickKind::Camera => 3
  }
  let id = pk_start(k + (if hold { 16 } else { 0 }))
  if id == 0 {
    None
  } else {
    Some(Pick::{ id })
  }
}

/// Wraps a dropped-files pick id from `mbui.drop`.
pub fn dropped_pick(id : Int) -> Pick {
  let _ = pk_state(id)
  Pick::{ id }
}

/// Releases an unused dropped-files pick.
pub fn forget_dropped(id : Int) -> Unit {
  pk_end(id)
}

/// Reads a gallery photo (`src`) whole as a `Pick`.
pub fn pick_photo(src : String) -> Option[Pick] {
  let id = pk_photo(src)
  if id == 0 {
    None
  } else {
    Some(Pick::{ id })
  }
}

/// What was picked, once ready (`None` while pending); taken once.
pub fn Pick::files(self : Pick) -> Option[Array[Picked]] {
  let state = pk_state(self.id)
  if state == 0 {
    None
  } else if state == 1 {
    let out : Array[Picked] = []
    let count = pk_count(self.id)
    for i in 0..<count {
      let info = pk_info(self.id, i).split("\t")
      let bytes = pk_bytes(self.id, i)
      if info.length() == 3 {
        out.push(Picked::{
          name: pk_name(self.id, i),
          bytes,
          held: ga_int(info[0]).to_int(),
          size: ga_int(info[1]).to_double(),
          src: info[2],
        })
      } else {
        out.push(Picked::{
          name: pk_name(self.id, i),
          bytes,
          held: 0,
          size: bytes.length().to_double(),
          src: "",
        })
      }
    }
    pk_end(self.id)
    Some(out)
  } else {
    pk_end(self.id)
    Some([])
  }
}
