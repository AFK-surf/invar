          __mbt_ap_8 if (__mbt_ap_8).length() == 3 && (match (__mbt_ap_8[0], __mbt_ap_8[1], __mbt_ap_8[2]) { (held, size, src) => true, _ => false }) => match (__mbt_ap_8[0], __mbt_ap_8[1], __mbt_ap_8[2]) { (held, size, src) => out.push(Picked::{
