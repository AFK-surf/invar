// Device photo/video gallery access and reading.
// Ported from libs/mbui/src/hostapi/gallery.mbt.

/// How much of the gallery the app may read.
pub enum GalleryAccess {
  Whole
  Chosen
  Refused
  NoGallery
}

pub fn GalleryAccess::eq(self : GalleryAccess, other : GalleryAccess) -> Bool {
  match (self, other) {
    (GalleryAccess::Whole, GalleryAccess::Whole) => true
    (GalleryAccess::Chosen, GalleryAccess::Chosen) => true
    (GalleryAccess::Refused, GalleryAccess::Refused) => true
    (GalleryAccess::NoGallery, GalleryAccess::NoGallery) => true
    _ => false
  }
}

pub fn gallery_access() -> GalleryAccess {
  let v = ga_access()
  if v == 1 {
    GalleryAccess::Whole
  } else if v == 2 {
    GalleryAccess::Chosen
  } else if v == 0 {
    GalleryAccess::Refused
  } else {
    GalleryAccess::NoGallery
  }
}

/// Asks the system to let the app read the gallery.
pub fn gallery_ask() -> Unit {
  ga_ask()
}

/// How many times the system has answered an ask.
pub fn gallery_answers() -> Int {
  ga_answers()
}

/// A photo (or video) of the gallery.
pub struct GalleryPhoto {
  pub id : Int64
  pub src : String
  pub added : Int64
  pub modified : Int64
  pub taken : Int64
  pub video : Bool
}

/// The gallery being read.
pub struct GalleryRead {
  id : Int
}

/// Its id, as the host's event names it (`set_outside`: kind 4).
pub fn GalleryRead::id(self : GalleryRead) -> Int {
  self.id
}

/// Starts reading the gallery's photos; `None` where there is no gallery.
pub fn gallery_read() -> Option[GalleryRead] {
  let id = ga_read()
  if id == 0 {
    None
  } else {
    Some(GalleryRead::{ id })
  }
}

/// A whole number as the host writes it (digits, optional leading `-`); -1 for anything else.
fn ga_int(s : String) -> Int64 {
  let mut n = 0.to_int64()
  let mut neg = false
  let mut any = false
  let len = s.length()
  for i in 0..<len {
    let ch = s.code_unit_at(i)
    if i == 0 && ch == 45 {
      neg = true
    } else if ch >= 48 && ch <= 57 {
      n = n * 10.to_int64() + (ch - 48).to_int64()
      any = true
    } else {
      return -1.to_int64()
    }
  }
  if !any {
    -1.to_int64()
  } else if neg {
    -n
  } else {
    n
  }
}

/// Its photos once read (`None` while still reading); taken once.
pub fn GalleryRead::photos(self : GalleryRead) -> Option[Array[GalleryPhoto]] {
  let state = ga_read_state(self.id)
  if state == 0 {
    None
  } else if state == 1 {
    let rows = ga_read_rows(self.id)
    ga_read_end(self.id)
    let out : Array[GalleryPhoto] = []
    let lines = rows.split("\n")
    for line in lines {
      let f = line.split("\t")
      if f.length() < 5 {
        continue
      }
      out.push(GalleryPhoto::{
        id: ga_int(f[0]),
        src: f[1],
        added: ga_int(f[2]),
        modified: ga_int(f[3]),
        taken: ga_int(f[4]),
        video: f.length() > 5 && f[5] == "1",
      })
    }
    Some(out)
  } else {
    ga_read_end(self.id)
    Some([])
  }
}
