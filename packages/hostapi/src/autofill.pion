// System autofill login picker.
// Ported from libs/mbui/src/hostapi/autofill.mbt.

import "signals"

let autofill_told : Int = 16

struct AutofillLogin {
  host : String
  account : String
  password : String
}

fn autofill_same(a : Option[AutofillLogin], b : Option[AutofillLogin]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.host == y.host && x.account == y.account && x.password == y.password
    _ => false
  }
}

let autofill_said : signals::Signal[Option[AutofillLogin]] = signals::signal_by(None, autofill_same)

/// Whether this host has an autofill service to ask.
pub fn autofill() -> Bool {
  af_able()
}

/// Asks the autofill service for a login of `host`.
pub fn autofill_ask(host : String) -> Bool {
  if af_ask(host) == 0 {
    return false
  }
  (hooks.outside_waits)(autofill_told, 1, autofill_took)
  true
}

fn split_unit_sep(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let n = s.length()
  for i in 0..<n {
    if s.code_unit_at(i) == 0x1F {
      out.push(s.slice(start, i))
      start = i + 1
    }
  }
  out.push(s.slice(start, n))
  out
}

fn autofill_took() -> Bool {
  let s = af_take()
  if s == "" {
    return false
  }
  let parts = split_unit_sep(s)
  let p0 = if parts.length() > 0 { parts[0] } else { "" }
  let p1 = if parts.length() > 1 { parts[1] } else { "" }
  let p2 = if parts.length() > 2 { parts[2] } else { "" }
  autofill_said.set(Some(AutofillLogin::{ host: p0, account: p1, password: p2 }))
  false
}

/// The login the person picked: `(host, account, password)`, or `None`.
pub fn autofill_take() -> Option[(String, String, String)] {
  match autofill_said.get() {
    Some(l) => Some((l.host, l.account, l.password))
    None => None
  }
}

/// Lets go of the ask.
pub fn autofill_end() -> Unit {
  (hooks.outside_lets_go)(autofill_told, 1)
  autofill_said.set(None)
  af_end()
}

/// What the person picked forgotten (test reset).
pub fn autofill_forget() -> Unit {
  autofill_said.set(None)
}
