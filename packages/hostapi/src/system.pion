// System lifecycle/environment events posted on `system_channel`.
// Ported from libs/mbui/src/hostapi/system.mbt.

/// The channel the system's say is posted on.
pub let system_channel : String = "system"

/// A window's room one way, as the system classes it.
pub enum SizeClass {
  Compact
  Medium
  Expanded
}

pub fn size_class_eq(a : SizeClass, b : SizeClass) -> Bool {
  match (a, b) {
    (SizeClass::Compact, SizeClass::Compact) => true
    (SizeClass::Medium, SizeClass::Medium) => true
    (SizeClass::Expanded, SizeClass::Expanded) => true
    _ => false
  }
}

/// A device's hinge as the system says it.
pub enum Hinge {
  NoHinge
  Closed
  Half
  Open
}

pub fn hinge_to_string(h : Hinge) -> String {
  match h {
    Hinge::NoHinge => "NoHinge"
    Hinge::Closed => "Closed"
    Hinge::Half => "Half"
    Hinge::Open => "Open"
  }
}

pub fn hinge_eq(a : Hinge, b : Hinge) -> Bool {
  match (a, b) {
    (Hinge::NoHinge, Hinge::NoHinge) => true
    (Hinge::Closed, Hinge::Closed) => true
    (Hinge::Half, Hinge::Half) => true
    (Hinge::Open, Hinge::Open) => true
    _ => false
  }
}

/// One thing the system said on `system_channel`.
pub enum SystemSaid {
  /// On screen again after `away` ms off it.
  Shown(Double)
  /// Opened with one of the app's links.
  Link(String)
  /// Shown over another app (`true`) or in its own window again (`false`).
  Over(Bool)
  /// System bars inset `(top, bottom, left, right)` in points.
  Bars(Double, Double, Double, Double)
  /// Window size classes `(width, height)`.
  SizeClasses(SizeClass, SizeClass)
  /// Foldable hinge state and division rects `[(x, y, w, h)]`.
  Fold(Hinge, Array[(Double, Double, Double, Double)])
  /// Device default network changed.
  Network
  /// Package install needs user permission.
  InstallAllow(String)
  /// Package install failed `(name, error)`.
  InstallFailed(String, String)
  /// Menu bar item chosen (`action`).
  Menu(String)
  /// Native nav bar item chosen (`id`).
  NavTapped(String)
  /// Native nav prominent action button rect `(x, y, w, h)`.
  NavAction(Double, Double, Double, Double)
}

/// Where the last tapped nav item is in the app's view `[x, y, w, h]`.
pub let nav_tapped_at : Array[Double] = [0.0, 0.0, 0.0, 0.0]

fn json_obj_num(o : Map[String, JsonValue], k : String) -> Double {
  match o.get(k) {
    Some(JsonValue::JNumber(n)) => n
    _ => 0.0
  }
}

fn parse_size_class(s : String) -> SizeClass {
  if s == "medium" {
    SizeClass::Medium
  } else if s == "expanded" || s == "regular" {
    SizeClass::Expanded
  } else {
    SizeClass::Compact
  }
}

/// Parses a JSON message on `system_channel` into ordered `SystemSaid` events.
pub fn system_said(json : String) -> Array[SystemSaid] {
  let out : Array[SystemSaid] = []
  let v = match json_parse(json) {
    Some(x) => x
    None => return out
  }
  let m = match v {
    JsonValue::JObject(obj) => obj
    _ => return out
  }
  match m.get("link") {
    Some(JsonValue::JString(url)) => out.push(SystemSaid::Link(url))
    _ => ()
  }
  match m.get("over") {
    Some(JsonValue::JBool(b)) => out.push(SystemSaid::Over(b))
    _ => ()
  }
  match m.get("bars") {
    Some(JsonValue::JObject(b)) =>
      out.push(SystemSaid::Bars(
        json_obj_num(b, "top"),
        json_obj_num(b, "bottom"),
        json_obj_num(b, "left"),
        json_obj_num(b, "right"),
      ))
    _ => ()
  }
  match m.get("size_class") {
    Some(JsonValue::JObject(k)) =>
      out.push(SystemSaid::SizeClasses(
        parse_size_class(json_obj_str(k, "width")),
        parse_size_class(json_obj_str(k, "height")),
      ))
    _ => ()
  }
  match m.get("fold") {
    Some(JsonValue::JObject(f)) => {
      let hs = json_obj_str(f, "hinge")
      let hinge = if hs == "closed" {
        Hinge::Closed
      } else if hs == "half" {
        Hinge::Half
      } else if hs == "open" {
        Hinge::Open
      } else {
        Hinge::NoHinge
      }
      let divisions : Array[(Double, Double, Double, Double)] = []
      match f.get("divisions") {
        Some(JsonValue::JArray(list)) => {
          for d in list {
            match d {
              JsonValue::JObject(r) =>
                divisions.push((
                  json_obj_num(r, "x"),
                  json_obj_num(r, "y"),
                  json_obj_num(r, "w"),
                  json_obj_num(r, "h"),
                ))
              _ => ()
            }
          }
        }
        _ => ()
      }
      out.push(SystemSaid::Fold(hinge, divisions))
    }
    _ => ()
  }
  match m.get("shown") {
    Some(JsonValue::JObject(s)) => out.push(SystemSaid::Shown(json_obj_num(s, "away")))
    _ => ()
  }
  match m.get("install") {
    Some(JsonValue::JObject(i)) => {
      let allow = match i.get("allow") {
        Some(JsonValue::JBool(true)) => true
        _ => false
      }
      if allow {
        out.push(SystemSaid::InstallAllow(json_obj_str(i, "name")))
      } else {
        out.push(SystemSaid::InstallFailed(json_obj_str(i, "name"), json_obj_str(i, "error")))
      }
    }
    _ => ()
  }
  match m.get("network") {
    Some(JsonValue::JBool(true)) => out.push(SystemSaid::Network)
    _ => ()
  }
  match m.get("menu") {
    Some(JsonValue::JString(action)) => out.push(SystemSaid::Menu(action))
    _ => ()
  }
  match m.get("nav_action") {
    Some(JsonValue::JObject(a)) =>
      out.push(SystemSaid::NavAction(
        json_obj_num(a, "x"),
        json_obj_num(a, "y"),
        json_obj_num(a, "w"),
        json_obj_num(a, "h"),
      ))
    _ => ()
  }
  match m.get("nav") {
    Some(JsonValue::JString(id)) => {
      match m.get("at") {
        Some(JsonValue::JArray(xs)) => {
          if xs.length() == 4 {
            match (xs[0], xs[1], xs[2], xs[3]) {
              (JsonValue::JNumber(x), JsonValue::JNumber(y), JsonValue::JNumber(w), JsonValue::JNumber(h)) => {
                nav_tapped_at[0] = x
                nav_tapped_at[1] = y
                nav_tapped_at[2] = w
                nav_tapped_at[3] = h
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
      out.push(SystemSaid::NavTapped(id))
    }
    _ => ()
  }
  out
}
