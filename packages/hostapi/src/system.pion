  Network
  Cellular(Bool)
  InstallAllow(String)
  InstallFailed(String, String)
  Menu(String)
  NavTapped(String)
  NavAction(Double, Double, Double, Double)
}

///|
/// A window's room one way, as the system classes it (Android's WindowSizeClass; iOS's UIUserInterfaceSizeClass, whose
/// regular is Expanded: it has nothing between).

#derive(Eq)
pub enum SizeClass {
  Compact
  Medium
  Expanded
}

///|
/// A device's hinge as the system says it.

#derive(Eq)
pub enum Hinge {
  NoHinge
  Closed
  Half
  Open
}

///|
/// By its name, as a page and tests write the hinge: what `derive(Show)` wrote.
pub fn Hinge::to_string(self : Hinge) -> String {
  let logger = StringBuilder()
  let __mbt_show_run : () -> Unit = fn() -> Unit {
    logger.write_string(
      match self {
        Hinge::NoHinge => "NoHinge"
        Hinge::Closed => "Closed"
        Hinge::Half => "Half"
        Hinge::Open => "Open"
      },
    )
  }
  __mbt_show_run()
  logger.to_string()
}

