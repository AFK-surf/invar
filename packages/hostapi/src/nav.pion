// Native navigation bar / glass controls (iOS UIGlassEffect / UIGlassContainerEffect).
// Ported from libs/mbui/src/hostapi/nav.mbt.

/// An item in a native nav bar or floating glass button.
pub struct NavItem {
  pub id : String
  pub title : String
  pub icon : String
  pub dot : Bool
  pub prominent : Bool
  pub menu : Array[(String, String, Bool, String)]
}

pub fn nav_item_eq(a : NavItem, b : NavItem) -> Bool {
  if a.id != b.id || a.title != b.title || a.icon != b.icon ||
     a.dot != b.dot || a.prominent != b.prominent ||
     a.menu.length() != b.menu.length() {
    return false
  }
  for i in 0..<a.menu.length() {
    let x = a.menu[i]
    let y = b.menu[i]
    if x.0 != y.0 || x.1 != y.1 || x.2 != y.2 || x.3 != y.3 {
      return false
    }
  }
  true
}

/// A group of items on one piece of glass.
pub struct NavGroup {
  pub items : Array[NavItem]
  pub foot : Bool
  pub foldable : Bool
}

pub fn nav_group_eq(a : NavGroup, b : NavGroup) -> Bool {
  if a.foot != b.foot || a.foldable != b.foldable || a.items.length() != b.items.length() {
    return false
  }
  for i in 0..<a.items.length() {
    if !nav_item_eq(a.items[i], b.items[i]) {
      return false
    }
  }
  true
}

/// A native glass button placed in the app's content.
pub struct NavFloating {
  pub item : NavItem
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
  pub blocked : Bool
}

pub fn nav_floating_eq(a : NavFloating, b : NavFloating) -> Bool {
  a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h &&
  a.blocked == b.blocked && nav_item_eq(a.item, b.item)
}

/// Full native navigation bar specification.
pub struct NavBar {
  pub floating : Array[NavFloating]
  pub groups : Array[NavGroup]
  pub selected : String
  pub ink : Int64
  pub chosen_ink : Int64
  pub more_icon : String
  pub bare : Bool
  pub title : String
}

pub fn nav_bar_eq(a : NavBar, b : NavBar) -> Bool {
  if a.selected != b.selected || a.ink != b.ink || a.chosen_ink != b.chosen_ink ||
     a.more_icon != b.more_icon || a.bare != b.bare || a.title != b.title ||
     a.floating.length() != b.floating.length() || a.groups.length() != b.groups.length() {
    return false
  }
  for i in 0..<a.floating.length() {
    if !nav_floating_eq(a.floating[i], b.floating[i]) {
      return false
    }
  }
  for i in 0..<a.groups.length() {
    if !nav_group_eq(a.groups[i], b.groups[i]) {
      return false
    }
  }
  true
}

fn nav_item_to_json_val(i : NavItem) -> JsonValue {
  let menu : Array[JsonValue] = []
  for m in i.menu {
    let mo : Map[String, JsonValue] = Map::new()
    mo.set("id", JsonValue::JString(m.0))
    mo.set("title", JsonValue::JString(m.1))
    mo.set("checked", JsonValue::JBool(m.2))
    mo.set("icon", JsonValue::JString(m.3))
    menu.push(JsonValue::JObject(mo))
  }
  let o : Map[String, JsonValue] = Map::new()
  o.set("id", JsonValue::JString(i.id))
  o.set("title", JsonValue::JString(i.title))
  o.set("icon", JsonValue::JString(i.icon))
  o.set("dot", JsonValue::JBool(i.dot))
  o.set("prominent", JsonValue::JBool(i.prominent))
  o.set("menu", JsonValue::JArray(menu))
  JsonValue::JObject(o)
}

/// Serializes the navigation bar specification to JSON for the host.
pub fn NavBar::to_json(self : NavBar) -> String {
  let floating : Array[JsonValue] = []
  for f in self.floating {
    let fo : Map[String, JsonValue] = Map::new()
    fo.set("item", nav_item_to_json_val(f.item))
    fo.set("x", JsonValue::JNumber(f.x))
    fo.set("y", JsonValue::JNumber(f.y))
    fo.set("w", JsonValue::JNumber(f.w))
    fo.set("h", JsonValue::JNumber(f.h))
    fo.set("blocked", JsonValue::JBool(f.blocked))
    floating.push(JsonValue::JObject(fo))
  }
  let groups : Array[JsonValue] = []
  for g in self.groups {
    let items : Array[JsonValue] = []
    for it in g.items {
      items.push(nav_item_to_json_val(it))
    }
    let go : Map[String, JsonValue] = Map::new()
    go.set("items", JsonValue::JArray(items))
    go.set("foot", JsonValue::JBool(g.foot))
    go.set("foldable", JsonValue::JBool(g.foldable))
    groups.push(JsonValue::JObject(go))
  }
  let root : Map[String, JsonValue] = Map::new()
  root.set("floating", JsonValue::JArray(floating))
  root.set("groups", JsonValue::JArray(groups))
  root.set("selected", JsonValue::JString(self.selected))
  root.set("ink", JsonValue::JNumber(self.ink.to_double()))
  root.set("chosen_ink", JsonValue::JNumber(self.chosen_ink.to_double()))
  root.set("more_icon", JsonValue::JString(self.more_icon))
  root.set("bare", JsonValue::JBool(self.bare))
  root.set("title", JsonValue::JString(self.title))
  json_stringify(JsonValue::JObject(root))
}

struct NavSaidState {
  mut last : Option[(NavBar, Bool)]
}

let nav_said : NavSaidState = NavSaidState::{ last: None }

/// Hands `bar` to the host only when changed; returns whether the host shows it.
pub fn nav_bar(bar : NavBar) -> Bool {
  match nav_said.last {
    Some((was, shown)) => {
      if nav_bar_eq(was, bar) {
        return shown
      }
    }
    None => ()
  }
  let shown = nv_bar(bar.to_json()) != 0
  nav_said.last = Some((bar, shown))
  shown
}

/// Resets deduplication so the next `nav_bar` call always sends to the host.
pub fn nav_bar_again() -> Unit {
  nav_said.last = None
}

/// Clears the host's native nav bar.
pub fn nav_bar_none() -> Unit {
  let _ = nav_bar(NavBar::{
    floating: [],
    groups: [],
    selected: "",
    ink: 0.to_int64(),
    chosen_ink: 0.to_int64(),
    more_icon: "",
    bare: false,
    title: "",
  })
}

/// Whether the host lays out native controls itself.
pub fn nav_bar_able() -> Bool {
  (current_host.h.nv_able)()
}
