// Host-backed terminal screen (VT emulation, dirty-row binary frames, selection, mouse encoding).
// Ported from libs/mbui/src/hostapi/terminal.mbt.

/// A terminal the host keeps.
pub struct Terminal {
  pub id : Int
}

pub let term_mode_decckm : Int = 1
pub let term_mode_bracketed_paste : Int = 2
pub let term_mode_mouse_tracking : Int = 4
pub let term_mode_alt_screen : Int = 8
pub let term_mode_alt_scroll : Int = 16
pub let term_mode_focus_event : Int = 32
pub let term_mode_has_selection : Int = 64
pub let term_mode_viewport_active : Int = 128

/// Opens a new terminal of `cols` × `rows` cells; `None` where unsupported.
pub fn Terminal::open(cols : Int, rows : Int) -> Option[Terminal] {
  let id = tm_open(cols, rows)
  if id == 0 {
    None
  } else {
    Some(Terminal::{ id })
  }
}

/// Feeds VT output bytes into the terminal.
pub fn Terminal::write(self : Terminal, data : Bytes) -> Unit {
  tm_write(self.id, data)
}

/// Resizes the terminal grid and cell pixel dimensions.
pub fn Terminal::resize(self : Terminal, cols : Int, rows : Int, cell_w : Int, cell_h : Int) -> Unit {
  tm_resize(self.id, cols, rows, cell_w, cell_h)
}

/// Exports binary render-state frame (`full = true` for all rows, `false` for dirty rows only).
pub fn Terminal::frame(self : Terminal, full : Bool) -> Bytes {
  tm_frame(self.id, if full { 1 } else { 0 })
}

/// Scalar bitmask of active terminal modes (`term_mode_*`).
pub fn Terminal::modes(self : Terminal) -> Int {
  tm_modes(self.id)
}

/// Scrolls the viewport (`kind`: 0 delta, 1 top, 2 bottom, 3 row offset).
pub fn Terminal::scroll(self : Terminal, kind : Int, value : Int) -> Unit {
  tm_scroll(self.id, kind, value)
}

/// Selection control (`kind`: 0 clear, 1 drag, 2 word, 3 line, 4 select all).
pub fn Terminal::select(
  self : Terminal,
  kind : Int,
  x0 : Int,
  y0 : Int,
  x1 : Int,
  y1 : Int,
) -> Bool {
  tm_select(self.id, kind, x0, y0, x1, y1) != 0
}

/// Plain text (`selection_only = true` for selected text, `false` for active screen).
pub fn Terminal::text(self : Terminal, selection_only : Bool) -> String {
  tm_text(self.id, if selection_only { 1 } else { 0 })
}

/// Encodes a mouse event into VT escape sequence bytes.
pub fn Terminal::mouse(
  self : Terminal,
  action : Int,
  button : Int,
  mods : Int,
  x : Int,
  y : Int,
  w : Int,
  h : Int,
  cw : Int,
  ch : Int,
) -> Bytes {
  tm_mouse(self.id, action, button, mods, x, y, w, h, cw, ch)
}

/// Closes and releases the terminal.
pub fn Terminal::close(self : Terminal) -> Unit {
  tm_close(self.id)
}
