// Password manager (`op` CLI) bridge, login matching, JSON parsing, and TTL list cache.
// Ported from libs/mbui/src/hostapi/passwords.mbt.

import "signals"

let op_told : Int = 15

/// How a run of `op` ended.
pub struct OpDone {
  pub code : Int
  pub out : String
  pub err : String
}

pub fn op_done_eq(a : OpDone, b : OpDone) -> Bool {
  a.code == b.code && a.out == b.out && a.err == b.err
}

fn op_done_opt_same(a : Option[OpDone], b : Option[OpDone]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => op_done_eq(x, y)
    _ => false
  }
}

/// A run of `op` under way (`op_run`).
pub struct OpRun {
  id : Int
  said : signals::Signal[Option[OpDone]]
}

/// Whether this host can ask a password manager at all.
pub fn passwords() -> Bool {
  pw_able()
}

/// Runs `op` with `args`; `None` where the host runs none.
pub fn op_run(args : Array[String]) -> Option[OpRun] {
  let sb = StringBuilder::new()
  for a in args {
    for j in 0..<a.length() {
      sb.write_byte(a.code_unit_at(j) as Byte)
    }
    sb.write_byte(0x1F as Byte)
  }
  let id = pw_run(sb.to_string())
  if id <= 0 {
    None
  } else {
    let r = OpRun::{ id, said: signals::signal_by(None, op_done_opt_same) }
    (hooks.outside_waits)(op_told, id, fn() -> Bool { r.take() })
    Some(r)
  }
}

fn OpRun::take(self : OpRun) -> Bool {
  match self.said.untracked() {
    Some(_) => return false
    None => ()
  }
  let s = pw_out(self.id)
  if s == "" {
    return false
  }
  let parts = split_unit_sep(s)
  let p0 = if parts.length() > 0 { parts[0] } else { "-1" }
  let p1 = if parts.length() > 1 { parts[1] } else { "" }
  let p2 = if parts.length() > 2 { parts[2] } else { "" }
  let code = parse_signed_int(p0, -1)
  self.said.set(Some(OpDone::{ code, out: p1, err: p2 }))
  true
}

/// How it ended, once the host's word says it has; `None` until then.
pub fn OpRun::done(self : OpRun) -> Option[OpDone] {
  self.said.get()
}

/// Why a run did not give what it was asked.
pub enum OpTrouble {
  NoTool
  Unreached
  Other(String)
}

pub fn op_trouble_eq(a : OpTrouble, b : OpTrouble) -> Bool {
  match (a, b) {
    (OpTrouble::NoTool, OpTrouble::NoTool) => true
    (OpTrouble::Unreached, OpTrouble::Unreached) => true
    (OpTrouble::Other(x), OpTrouble::Other(y)) => x == y
    _ => false
  }
}

/// Why it ended badly; `None` when `code == 0`.
pub fn OpDone::trouble(self : OpDone) -> Option[OpTrouble] {
  if self.code == 0 {
    return None
  }
  let why = self.err.trim()
  if self.code == -1 || why.contains("not found") || why.contains("not currently signed in") || why.contains("integration") {
    Some(OpTrouble::NoTool)
  } else if why.contains("Get \"https://") || why.contains("Post \"https://") || why.contains("Put \"https://") {
    Some(OpTrouble::Unreached)
  } else {
    Some(OpTrouble::Other(why))
  }
}

/// Forgets the `op` run.
pub fn OpRun::end(self : OpRun) -> Unit {
  (hooks.outside_lets_go)(op_told, self.id)
  pw_end(self.id)
}

/// A login entry from the password manager.
pub struct PasswordLogin {
  pub id : String
  pub title : String
  pub username : String
  pub vault : String
}

pub fn password_login_eq(a : PasswordLogin, b : PasswordLogin) -> Bool {
  a.id == b.id && a.title == b.title && a.username == b.username && a.vault == b.vault
}

fn ascii_to_lower(s : String) -> String {
  let sb = StringBuilder::new()
  for i in 0..<s.length() {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      sb.write_byte((c + 32) as Byte)
    } else {
      sb.write_byte(c as Byte)
    }
  }
  sb.to_string()
}

fn find_substr(haystack : String, needle : String) -> Option[Int] {
  let hn = haystack.length()
  let nn = needle.length()
  if nn == 0 {
    return Some(0)
  }
  if nn > hn {
    return None
  }
  let limit = hn - nn + 1
  for i in 0..<limit {
    let mut ok = true
    for j in 0..<nn {
      if haystack.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
    }
    if ok {
      return Some(i)
    }
  }
  None
}

/// Whether `href` matches `host` (exact, subdomain, or parent domain).
pub fn login_for_host(href : String, host : String) -> Bool {
  let h = ascii_to_lower(host)
  let mut rest = ascii_to_lower(href)
  match find_substr(rest, "://") {
    Some(i) => rest = rest.slice(i + 3, rest.length())
    None => ()
  }
  let mut end = rest.length()
  let seps = ["/", "?", "#", ":"]
  for sep in seps {
    match find_substr(rest, sep) {
      Some(i) => {
        if i < end {
          end = i
        }
      }
      None => ()
    }
  }
  let site = rest.slice(0, end)
  site != "" && (site == h || h.ends_with("." + site) || site.ends_with("." + h))
}

fn json_obj_str(o : Map[String, JsonValue], k : String) -> String {
  match o.get(k) {
    Some(JsonValue::JString(s)) => s
    _ => ""
  }
}

/// Logins from `op item list --categories Login --format json` whose URLs match `host`.
pub fn logins_for(listed : String, host : String) -> Array[PasswordLogin] {
  let out : Array[PasswordLogin] = []
  let v = match json_parse(listed) {
    Some(x) => x
    None => return out
  }
  let items = match v {
    JsonValue::JArray(xs) => xs
    _ => return out
  }
  for it in items {
    let o = match it {
      JsonValue::JObject(m) => m
      _ => continue
    }
    let mut matched = false
    match o.get("urls") {
      Some(JsonValue::JArray(us)) => {
        for u in us {
          match u {
            JsonValue::JObject(uo) => {
              let href = json_obj_str(uo, "href")
              if href != "" && login_for_host(href, host) {
                matched = true
                break
              }
            }
            _ => ()
          }
        }
      }
      _ => ()
    }
    if !matched {
      continue
    }
    let username = json_obj_str(o, "additional_information")
    let vault = match o.get("vault") {
      Some(JsonValue::JObject(vo)) => json_obj_str(vo, "id")
      _ => ""
    }
    out.push(PasswordLogin::{
      id: json_obj_str(o, "id"),
      title: json_obj_str(o, "title"),
      username,
      vault,
    })
  }
  out
}

/// Extracts `(username, password, totp, has_otp)` from `op item get ... --format json`.
pub fn login_secret(got : String) -> (String, String, String, Bool) {
  let mut user = ""
  let mut pass = ""
  let mut otp = ""
  let mut has_otp = false
  let v = match json_parse(got) {
    Some(x) => x
    None => return (user, pass, otp, has_otp)
  }
  let fields : Array[JsonValue] = match v {
    JsonValue::JArray(a) => a
    JsonValue::JObject(o) =>
      match o.get("fields") {
        Some(JsonValue::JArray(a)) => a
        _ => [JsonValue::JObject(o)]
      }
    _ => []
  }
  for f in fields {
    let o = match f {
      JsonValue::JObject(m) => m
      _ => continue
    }
    let kind = ascii_to_lower(json_obj_str(o, "type"))
    let purpose = ascii_to_lower(json_obj_str(o, "purpose"))
    if kind == "otp" || purpose == "otp" {
      has_otp = true
      let code = json_obj_str(o, "totp").trim()
      if code != "" && otp == "" {
        otp = code
      }
      continue
    }
    let what = purpose + " " + ascii_to_lower(json_obj_str(o, "label")) + " " + ascii_to_lower(json_obj_str(o, "id"))
    if what.contains("password") && pass == "" {
      pass = json_obj_str(o, "value")
    } else if what.contains("username") && user == "" {
      user = json_obj_str(o, "value")
    }
  }
  (user, pass, otp, has_otp)
}

/// Extracts `(username, password)` from `op item get`.
pub fn login_fields(got : String) -> (String, String) {
  let (user, pass, _, _) = login_secret(got)
  (user, pass)
}

let op_list_ttl_ms : Double = 300000.0

struct OpCacheState {
  mut json : String
  mut at : Double
}

let op_list_cache : OpCacheState = OpCacheState::{ json: "", at: -1.0 }

/// Clears the cached non-secret `op item list` metadata.
pub fn op_list_cache_reset() -> Unit {
  op_list_cache.json = ""
  op_list_cache.at = -1.0
}

/// Keeps the raw non-secret JSON from a successful `op item list` run.
pub fn op_list_cache_keep(listed : String) -> Unit {
  op_list_cache.json = listed
  op_list_cache.at = now()
}

/// Returns cached logins matching `host` while within `op_list_ttl_ms`.
pub fn op_list_cached_for(host : String) -> Array[PasswordLogin] {
  if op_list_cache.at < 0.0 || op_list_cache.json == "" {
    return []
  }
  if now() - op_list_cache.at >= op_list_ttl_ms {
    op_list_cache_reset()
    return []
  }
  logins_for(op_list_cache.json, host)
}
