///|
/// How a run of `op` ended: its exit code (-1: it could not be started, or there is no `op` here), its standard output
/// and its error output.

#derive(Eq)
pub struct OpDone {
  pub code : Int
  pub out : String
  pub err : String
}

///|
/// Whether this host can ask a password manager at all (macOS and Windows; whether `op` is there is said by a run).
pub fn passwords() -> Bool {
  pw_able()
}

///|
/// Runs `op` with `args` (its arguments, none of them the shell's), without a window of its own; None where the host
/// runs none.
pub fn op_run(args : Array[String]) -> Option[OpRun] {
  // (to the host: the arguments one after another, each ended by a unit separator, U+001F)
  let id = pw_run(mbt_compat::arr_iter(args).map(fn(a) { a + "\u{1f}" }).join(""))
  if id <= 0 {
    Option::None
  } else {
    let r : OpRun = OpRun::{ id: id, said: signals::signal(Option::None) }
    (outside_waits.v)(op_told, id, fn() { r.take() })
    Some(r)
  }
}

///|
/// What the host says of how it ended taken, as its word comes (outside_waits): whether it was there to take.
fn OpRun::take(self : OpRun) -> Bool {
  guard self.said.untracked() is Option::None else { return false }
  let s = pw_out(self.id)
  if s == "" {
    return false
  }
  // (from the host: its exit code, its output and its error output, each ended by a unit separator)
  let parts = mbt_compat::arr_to_array(mbt_compat::arr_map(s.split("\u{1f}"), fn(p) { mbt_compat::str_to_owned(p) }))
  let code = match mbt_compat::str_try_parse_int(({ let __mbt_sl_11 = mbt_compat::arr_get(parts, 0).unwrap_or("-1"); mbt_compat::utf16_slice(__mbt_sl_11, 0, mbt_compat::utf16_len(__mbt_sl_11)) })) { Ok(__mbt_ok_12) => __mbt_ok_12, Err(_) => -1 }
  self.said.set(Some(OpDone::{ code: code, out: mbt_compat::arr_get(parts, 1).unwrap_or(""), err: mbt_compat::arr_get(parts, 2).unwrap_or("") }))
  true
}

///|
/// How it ended, once the host's word says it has; None until then. A signal's read: what reads it (a node's binding
/// or `reacts`, an old view's build) is told as it ends, and reads the same however often.
pub fn OpRun::done(self : OpRun) -> Option[OpDone] {
  self.said.get()
}

///|
/// Why a run did not give what it was asked, as the person can act on it.

#derive(Eq)
pub enum OpTrouble {
  NoTool
  Unreached
  Other(String)
}

///|
/// Why it ended badly; None where it gave what it was asked.
pub fn OpDone::trouble(self : OpDone) -> Option[OpTrouble] {
  if self.code == 0 {
    return Option::None
  }
  let why = mbt_compat::str_to_owned(self.err.trim(chars=" \n"))
  if self.code == -1 || why.contains("not found") || why.contains("not currently signed in") || why.contains("integration") {
    Some(OpTrouble::NoTool)
  } else if why.contains("Get \"https://") || why.contains("Post \"https://") || why.contains("Put \"https://") {
    // (a request that never had an answer, as Go says it: `Get "<url>": <why>`; an answer that refused has none)
    Some(OpTrouble::Unreached)
  } else {
    Some(OpTrouble::Other(why))
  }
}

///|
/// Forgets it (its output, and the process if it still runs).
pub fn OpRun::end(self : OpRun) -> Unit {
  (outside_lets_go.v)(op_told, self.id)
  pw_end(self.id)
}

///|
/// A login of the password manager: its id there, its title, its account, and its vault id when given (not secret: the
/// person picks by it, and the vault narrows `op item get`).

#derive(Eq)
pub struct PasswordLogin {
  pub id : String
  pub title : String
  pub username : String
  pub vault : String
}

///|
/// Whether `href` (a login's website, as the password manager keeps it: an address, or a bare host) is `host` or a
/// host under it, or one `host` is under (a login for google.com fills accounts.google.com).
pub fn login_for_host(href : String, host : String) -> Bool {
  let h = mbt_compat::str_to_lower(host)
  let mut rest = mbt_compat::str_to_lower(href)
  match mbt_compat::str_find(rest, "://") {
    Some(i) => rest = mbt_compat::str_to_owned(mbt_compat::str_exact_view(rest, start=i + 3))
    None => ()
  }
  let mut end = mbt_compat::utf16_len(rest)
  for c in ["/", "?", "#", ":"] {
    match mbt_compat::str_find(rest, c) {
      Some(i) => if i < end { end = i }
      None => ()
    }
  }
  let site = mbt_compat::str_to_owned(mbt_compat::str_exact_view(rest, end=end))
  site != "" && (site == h || mbt_compat::str_has_suffix(h, "." + site) || mbt_compat::str_has_suffix(site, "." + h))
}

///|
/// The logins of `op item list --categories Login --format json`'s answer whose websites are for `host`, in its order.
pub fn logins_for(listed : String, host : String) -> Array[PasswordLogin] {
  let out : Array[PasswordLogin] = []
  let v = match mbt_compat::mbt_json_parse(listed) { Ok(__mbt_ok_13) => __mbt_ok_13, Err(_) => return out }
  guard v is Array(items) else { return out }
  for it in items {
    guard it is .Object(o) else { continue }
    let hrefs : Array[String] = []
    match o.get("urls") {
      Option::Some(Array(us)) =>
      { for u in us {
        match u {
          .Object(uo) =>
          match uo.get("href") {
            Option::Some(String(h)) => hrefs.push(h)
            _ => ()
          }
          _ => ()
        }
      } }
      _ => ()
    }
    guard mbt_compat::arr_iter(hrefs).any(fn(h) { login_for_host(h, host) }) else { continue }
    let str = fn(k : String) {
      match o.get(k) {
        Option::Some(String(v)) => v
        _ => ""
      }
    }
    let username = match o.get("additional_information") {
      Option::Some(String(v)) => v
      _ => ""
    }
    let vault = match o.get("vault") {
      Option::Some(.Object(vo)) =>
      match vo.get("id") {
        Option::Some(String(v)) => v
        _ => ""
      }
      _ => ""
    }
    out.push(PasswordLogin::{ id: str("id"), title: str("title"), username: username, vault: vault })
  }
  out
}

///|
/// The account, password, current TOTP code, and whether an OTP field exists from `op item get <id> --reveal --format
/// json` (a whole item object with `fields`) or `--fields ... --format json` (an array or single field object).
pub fn login_secret(got : String) -> (String, String, String, Bool) {
  let mut user = ""
  let mut pass = ""
  let mut otp = ""
  let mut has_otp = false
  let v = match mbt_compat::mbt_json_parse(got) { Ok(__mbt_ok_14) => __mbt_ok_14, Err(_) => return (user, pass, otp, has_otp) }
  let fields = match v {
    Array(a) => a
    one if one is .Object(o) =>
    match o.get("fields") {
      Option::Some(Array(a)) => a
      _ => [one]
    }
    _ => []
  }
  for f in fields {
    guard f is .Object(o) else { continue }
    let str = fn(k : String) {
      match o.get(k) {
        Option::Some(String(v)) => v
        _ => ""
      }
    }
    let kind = mbt_compat::str_to_lower(str("type"))
    let purpose = mbt_compat::str_to_lower(str("purpose"))
    if kind == "otp" || purpose == "otp" {
      has_otp = true
      let code = mbt_compat::str_to_owned(str("totp").trim(chars=" \n"))
      if code != "" && otp == "" {
        otp = code
      }
      continue
    }
    let what = purpose + " " + mbt_compat::str_to_lower(str("label")) + " " + mbt_compat::str_to_lower(str("id"))
    if what.contains("password") && pass == "" {
      pass = str("value")
    } else if what.contains("username") && user == "" {
      user = str("value")
    }
  }
  (user, pass, otp, has_otp)
}

///|
/// The account and password of `op item get <id> --fields label=username,label=password --reveal --format json`'s
/// answer (fields by their label or purpose); either may be "".
pub fn login_fields(got : String) -> (String, String) {
  let (user, pass, _, _) = login_secret(got)
  (user, pass)
}

