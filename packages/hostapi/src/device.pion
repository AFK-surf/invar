// Device capabilities: clipboard read/write, key catcher, soft keyboard inset, keep awake, haptics, IME actions.
// Ported from libs/mbui/src/hostapi/device.mbt.

/// A read of the clipboard under way (`clip_read`).
pub struct ClipRead {
  id : Int
}

/// Its id, as the host's event names it (`set_outside`: kind 9).
pub fn ClipRead::id(self : ClipRead) -> Int {
  self.id
}

/// What the clipboard held: text, picture status, PNG bytes, and files.
pub struct ClipGot {
  pub text : String
  pub picture : Int
  pub png : Bytes
  pub files : Array[(String, Bytes)]
}

pub let clip_none : Int = 0
pub let clip_png : Int = 1
pub let clip_too_large : Int = 2
pub let clip_unreadable : Int = 3

pub let clip_file_max : Int = 1024 * 1024 * 1024
pub let clip_png_max : Int = 1024 * 1024 * 1024
pub let clip_source_max : Int = 32 * 1024 * 1024
pub let clip_pixels_max : Int = 16 * 1024 * 1024

/// Starts reading the clipboard asynchronously; `None` where the host cannot.
pub fn clip_read() -> Option[ClipRead] {
  let id = cl_read()
  if id == 0 {
    None
  } else {
    Some(ClipRead::{ id })
  }
}

/// What it read, once ready (`None` while reading); taken once.
pub fn ClipRead::got(self : ClipRead) -> Option[ClipGot] {
  let state = cl_state(self.id)
  if state == 0 {
    None
  } else if state == 1 {
    let nf = cl_files(self.id)
    let files : Array[(String, Bytes)] = []
    for i in 0..<nf {
      files.push((cl_file_name(self.id, i), cl_file(self.id, i)))
    }
    let got = ClipGot::{
      text: cl_text(self.id),
      picture: cl_picture(self.id),
      png: cl_png(self.id),
      files,
    }
    cl_end(self.id)
    Some(got)
  } else {
    cl_end(self.id)
    Some(ClipGot::{ text: "", picture: clip_unreadable, png: "".to_bytes(), files: [] })
  }
}

/// Words put on the clipboard with an optional system label.
pub fn clip_set_text(text : String, label : String) -> Unit {
  cl_set(text, "".to_bytes(), label)
}

/// A PNG picture put on the clipboard with an optional system label.
pub fn clip_set_png(png : Bytes, label : String) -> Unit {
  cl_set("", png, label)
}

/// Whether the system shows its own copy toast (Android 13+).
pub fn copy_shown() -> Bool {
  dv_copy_shown() != 0
}

/// Enables/disables raw key catcher mode.
pub fn key_catch(on : Bool) -> Unit {
  dv_key_catch(if on { 1 } else { 0 })
}

/// Soft keyboard height over the window's foot, in points.
pub fn ime_inset() -> Double {
  dv_ime_inset()
}

/// Keeps the screen awake while the app is in front.
pub fn keep_awake(on : Bool) -> Unit {
  dv_keep_awake(if on { 1 } else { 0 })
}

/// Triggers a haptic feedback of `kind` (`haptic_*`).
pub fn haptic(kind : Int) -> Unit {
  dv_haptic(kind)
}

/// Sets the soft keyboard action key (`ime_action_*`).
pub fn ime_action(kind : Int) -> Unit {
  dv_ime_action(kind)
}

pub let ime_action_none : Int = 0
pub let ime_action_search : Int = 1
pub let ime_action_go : Int = 2
pub let ime_action_number : Int = 3
pub let ime_action_secret : Int = 4
pub let ime_action_email : Int = 5
pub let ime_action_plain : Int = 6

pub let haptic_long_press : Int = 0
pub let haptic_context_click : Int = 1
pub let haptic_text_handle_move : Int = 2
pub let haptic_confirm : Int = 3
pub let haptic_reject : Int = 4
pub let haptic_keyboard_tap : Int = 5
