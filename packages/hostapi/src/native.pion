// App-defined native calls (`ncall_*`).
// Ported from libs/mbui/src/hostapi/native.mbt.

/// A native call under way (`native_call`).
pub struct NativeCall {
  pub id : Int
}

/// Its id, as the host's event names it (`set_outside`: kind 10).
pub fn NativeCall::id(self : NativeCall) -> Int {
  self.id
}

/// `name` asked of the host with `params` (JSON); None where the host takes no native calls.
pub fn native_call(name : String, params : String) -> Option[NativeCall] {
  let id = ncall_call(name, params)
  if id == 0 {
    None
  } else {
    Some(NativeCall::{ id })
  }
}

/// Its answer, once the host has given it (`None` until then): `(ok, json_or_err)`; taken once.
pub fn NativeCall::got(self : NativeCall) -> Option[(Bool, String)] {
  let state = ncall_state(self.id)
  if state == 0 {
    None
  } else {
    let said = ncall_result(self.id)
    ncall_end(self.id)
    Some((state == 1, said))
  }
}
