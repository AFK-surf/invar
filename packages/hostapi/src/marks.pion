// Marks drawn onto an image at its own size, as a PNG.
// Ported from libs/mbui/src/hostapi/marks.mbt.

/// Marks being drawn onto an image.
pub struct MarkedImage {
  id : Int
}

/// Its id, as the host's event names it once drawn (`set_outside`: kind 5).
pub fn MarkedImage::id(self : MarkedImage) -> Int {
  self.id
}

/// `image` (its bytes) with `marks` (JSON) drawn on it: None where the host cannot.
pub fn draw_marks(image : Bytes, marks : String) -> Option[MarkedImage] {
  let id = mk_start(image, marks)
  if id == 0 {
    None
  } else {
    Some(MarkedImage::{ id })
  }
}

/// The PNG once drawn (`Some(empty)` on error), `None` while still drawing; taken once.
pub fn MarkedImage::made(self : MarkedImage) -> Option[Bytes] {
  let state = mk_state(self.id)
  if state == 0 {
    None
  } else if state == 1 {
    Some(mk_png(self.id))
  } else {
    let _ = mk_png(self.id)
    Some("".to_bytes())
  }
}

/// Whether it is drawn (or could not be), without taking its PNG.
pub fn MarkedImage::drawn(self : MarkedImage) -> Bool {
  mk_state(self.id) != 0
}
