// Pointer lock (relative mouse delta) and W3C Standard Gamepad polling.
// Ported from libs/mbui/src/hostapi/pointer_lock.mbt.

/// Locks or unlocks the pointer to the window.
pub fn set_pointer_lock(on : Bool) -> Unit {
  (current_host.h.pointer_lock)(on)
}

/// Whether the window holds the pointer now.
pub fn pointer_locked() -> Bool {
  (current_host.h.pointer_locked)()
}

/// Accumulated relative mouse delta `(dx, dy)` since last call while locked.
pub fn pointer_delta_take() -> (Double, Double) {
  let out : Array[Double] = [0.0, 0.0]
  (current_host.h.pointer_delta)(out)
  (out[0], out[1])
}

/// The most game controllers a host reports.
pub let gamepads_most : Int = 4

/// Number of doubles per controller slot.
pub let gamepad_fields : Int = 9

/// Stick dead-zone threshold.
pub let gamepad_dead_zone : Double = 0.06

/// A connected game controller snapshot (W3C Standard Gamepad layout).
pub struct Gamepad {
  pub index : Int
  pub buttons : Int
  pub lx : Double
  pub ly : Double
  pub rx : Double
  pub ry : Double
  pub lt : Double
  pub rt : Double
}

pub fn Gamepad::eq(self : Gamepad, other : Gamepad) -> Bool {
  self.index == other.index &&
  self.buttons == other.buttons &&
  self.lx == other.lx &&
  self.ly == other.ly &&
  self.rx == other.rx &&
  self.ry == other.ry &&
  self.lt == other.lt &&
  self.rt == other.rt
}

/// A stick's axis past `gamepad_dead_zone`, clamped to -1..1 (0 inside dead zone or NaN).
pub fn gamepad_axis(a : Double) -> Double {
  if a != a || a.abs() <= gamepad_dead_zone {
    0.0
  } else if a > 1.0 {
    1.0
  } else if a < -1.0 {
    -1.0
  } else {
    a
  }
}

fn gamepad_trigger(v : Double) -> Double {
  if v != v || v < 0.0 {
    0.0
  } else if v > 1.0 {
    1.0
  } else {
    v
  }
}

/// Connected game controllers right now.
pub fn gamepads() -> Array[Gamepad] {
  let total = gamepads_most * gamepad_fields
  let out : Array[Double] = []
  for _ in 0..<total {
    out.push(0.0)
  }
  let n = (current_host.h.gamepads)(out)
  let limit = if n < gamepads_most { n } else { gamepads_most }
  let pads : Array[Gamepad] = []
  for i in 0..<limit {
    let o = i * gamepad_fields
    if out[o + 1] != 0.0 {
      pads.push(Gamepad::{
        index: out[o].to_int(),
        buttons: out[o + 2].to_int() & 0x1FFFF,
        lx: gamepad_axis(out[o + 3]),
        ly: gamepad_axis(out[o + 4]),
        rx: gamepad_axis(out[o + 5]),
        ry: gamepad_axis(out[o + 6]),
        lt: gamepad_trigger(out[o + 7]),
        rt: gamepad_trigger(out[o + 8]),
      })
    }
  }
  pads
}
