// Text in a legacy encoding decoded by the system's own tables.
// Ported from libs/mbui/src/hostapi/charset.mbt.

import "codec"

/// `data` decoded as `charset` (IANA name: "GB18030", "Big5", "Shift_JIS", ...); None where unknown.
pub fn decode_charset(data : Bytes, charset : String) -> Option[String] {
  if cs_known(charset) == 0 {
    None
  } else {
    Some(cs_decode(data, charset))
  }
}

/// Strict UTF-8 check and decode on `b[start..end]`; returns `None` on any invalid sequence.
fn decode_utf8_strict(b : Bytes, start : Int, end : Int) -> Option[String] {
  let sb = StringBuilder::new()
  let mut i = start
  while i < end {
    let x = b[i].to_int()
    if x < 0x80 {
      sb.write_byte(x as Byte)
      i = i + 1
    } else if x >= 0xC2 && x < 0xE0 {
      if i + 1 >= end {
        return None
      }
      let y = b[i + 1].to_int()
      if y < 0x80 || y >= 0xC0 {
        return None
      }
      sb.write_byte(x as Byte)
      sb.write_byte(y as Byte)
      i = i + 2
    } else if x >= 0xE0 && x < 0xF0 {
      if i + 2 >= end {
        return None
      }
      let y = b[i + 1].to_int()
      let z = b[i + 2].to_int()
      if y < 0x80 || y >= 0xC0 || z < 0x80 || z >= 0xC0 {
        return None
      }
      let cp = ((x & 0x0F) << 12) | ((y & 0x3F) << 6) | (z & 0x3F)
      if cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF) {
        return None
      }
      sb.write_byte(x as Byte)
      sb.write_byte(y as Byte)
      sb.write_byte(z as Byte)
      i = i + 3
    } else if x >= 0xF0 && x < 0xF5 {
      if i + 3 >= end {
        return None
      }
      let y = b[i + 1].to_int()
      let z = b[i + 2].to_int()
      let w = b[i + 3].to_int()
      if y < 0x80 || y >= 0xC0 || z < 0x80 || z >= 0xC0 || w < 0x80 || w >= 0xC0 {
        return None
      }
      let cp = ((x & 0x07) << 18) | ((y & 0x3F) << 12) | ((z & 0x3F) << 6) | (w & 0x3F)
      if cp < 0x10000 || cp > 0x10FFFF {
        return None
      }
      sb.write_byte(x as Byte)
      sb.write_byte(y as Byte)
      sb.write_byte(z as Byte)
      sb.write_byte(w as Byte)
      i = i + 4
    } else {
      return None
    }
  }
  Some(sb.to_string())
}

fn slice_bytes(b : Bytes, start : Int, end : Int) -> Bytes {
  let sb = StringBuilder::new()
  let lo = if start < 0 { 0 } else if start > b.length() { b.length() } else { start }
  let hi = if end < lo { lo } else if end > b.length() { b.length() } else { end }
  for i in lo..<hi {
    sb.write_byte(b[i])
  }
  sb.to_string().to_bytes()
}

/// A file's bytes as text and the encoding that made it ("UTF-8", "UTF-8 BOM", "UTF-16LE",
/// "UTF-16BE", "GB18030", or "UTF-8 (lossy)").
pub fn decode_text(b : Bytes, truncated : Bool) -> (String, String) {
  let n = b.length()
  if n == 0 {
    return ("", "UTF-8")
  }
  let b0 = b[0].to_int()
  let b1 = if n >= 2 { b[1].to_int() } else { 0 }
  let b2 = if n >= 3 { b[2].to_int() } else { 0 }
  if n >= 3 && b0 == 0xEF && b1 == 0xBB && b2 == 0xBF {
    let end = codec::utf8_end(b, 3, n, truncated)
    let text = match decode_utf8_strict(b, 3, end) {
      Some(s) => s
      None => {
        let sub = slice_bytes(b, 3, end)
        codec::utf8_text(sub, sub.length())
      }
    }
    return (text, "UTF-8 BOM")
  }
  if n >= 2 && b0 == 0xFF && b1 == 0xFE {
    return (codec::utf16_text(b, 2, true), "UTF-16LE")
  }
  if n >= 2 && b0 == 0xFE && b1 == 0xFF {
    return (codec::utf16_text(b, 2, false), "UTF-16BE")
  }
  let whole_end = codec::utf8_end(b, 0, n, truncated)
  match decode_utf8_strict(b, 0, whole_end) {
    Some(s) => return (s, "UTF-8")
    None => ()
  }
  if !truncated {
    let cut_end = codec::utf8_end(b, 0, n, true)
    match decode_utf8_strict(b, 0, cut_end) {
      Some(s) => return (s, "UTF-8")
      None => ()
    }
  }
  match decode_charset(b, "GB18030") {
    Some(s) => {
      let mut text = s
      if truncated {
        while text.ends_with("\u{FFFD}") {
          // U+FFFD is 3 bytes in UTF-8
          text = text.slice(0, text.length() - 3)
        }
      }
      (text, "GB18030")
    }
    None => {
      let sub = slice_bytes(b, 0, whole_end)
      (codec::utf8_text(sub, sub.length()), "UTF-8 (lossy)")
    }
  }
}
