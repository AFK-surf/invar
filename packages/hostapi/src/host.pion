struct HostBox {
  mut h : Host
}

struct WakeSlot {
  mut f : () -> Unit
}

let current_host : HostBox = HostBox::{ h: Host::noop() }
let wake_lock : Mutex[Int] = Mutex::new(0)
let wake_slot : WakeSlot = WakeSlot::{ f: fn() -> Unit { () } }

let sideways_now : signals::Signal[Bool] = signals::signal(false)
let turnable_now : signals::Signal[Bool] = signals::signal(false)

/// Installs the active host (resets sideways/turnable signals and nav bar cache).
pub fn set_host(h : Host) -> Unit {
  current_host.h = h
  let wf = h.wake_now
  wake_lock.with_lock(fn(_v : Int) -> Unit {
    wake_slot.f = wf
  })
  sideways_now.set(false)
  turnable_now.set(false)
  nav_said.last = None
}

/// Thread-safe frame wake-up callable from any background OS thread.
/// Synchronized via `wake_lock` without touching `current_host.h`.
pub fn wake_now() -> Unit {
  wake_lock.with_lock(fn(_v : Int) -> Unit {
    (wake_slot.f)()
  })
}

/// Returns the active host.
pub fn host() -> Host {
  current_host.h
}

