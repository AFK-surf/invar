pub fn set_sideways(on : Bool) -> Unit {
  sideways_now.set(on)
  (current_host.h.set_sideways)(on)
}

pub fn set_turnable(on : Bool) -> Unit {
  turnable_now.set((current_host.h.set_turnable)(on) && on)
}

pub fn sideways() -> Bool {
  sideways_now.get() || turnable_now.get()
}

pub fn turned_sideways() -> Bool {
  sideways_now.get()
}

pub fn perf_state() -> Int { (current_host.h.perf_state)() }
pub fn perf_recording() -> Bool { perf_state() == 1 }

pub fn set_perf(on : Bool) -> Unit {
  if perf_state() < 0 {
    return
  }
  (current_host.h.set_perf)(on)
}

pub fn perf_line(line : String) -> Unit {
  if perf_recording() {
    (current_host.h.perf_line)(line)
