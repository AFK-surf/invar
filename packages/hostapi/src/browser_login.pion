// Browser loopback OAuth sign-in (RFC 8252 §7.3) and outside wait hooks.
// Ported from libs/mbui/src/hostapi/browser_login.mbt.

struct HookState {
  mut polled : () -> Unit
  mut outside_waits : (Int, Int, () -> Bool) -> Unit
  mut outside_lets_go : (Int, Int) -> Unit
}

let hooks : HookState = HookState::{
  polled: fn() -> Unit { () },
  outside_waits: fn(_kind : Int, _id : Int, f : () -> Bool) -> Unit { let _ = f() },
  outside_lets_go: fn(_kind : Int, _id : Int) -> Unit { () },
}

pub fn set_polled(f : () -> Unit) -> Unit {
  hooks.polled = f
}

pub fn call_polled() -> Unit {
  (hooks.polled)()
}

pub fn set_outside_waits(f : (Int, Int, () -> Bool) -> Unit) -> Unit {
  hooks.outside_waits = f
}

pub fn set_outside_lets_go(f : (Int, Int) -> Unit) -> Unit {
  hooks.outside_lets_go = f
}

/// A sign-in under way in the browser.
pub struct BrowserLogin {
  id : Int
  /// Where the browser is to come back to: http://127.0.0.1:<port><path>.
  pub redirect : String
}

/// Listens for the browser coming back to `path` (default "/callback") with optional `done` URL.
pub fn browser_login(path : String, done : String) -> Option[BrowserLogin] {
  let id = bl_start(path, done)
  if id == 0 {
    return None
  }
  let port = bl_port(id)
  Some(BrowserLogin::{ id, redirect: "http://127.0.0.1:" + port.to_string() + path })
}

/// Opens the login page `url` in the browser.
pub fn BrowserLogin::open(self : BrowserLogin, url : String) -> Bool {
  bl_open(self.id, url) != 0
}

/// The address the browser came back to, once it has; `None` until then.
pub fn BrowserLogin::back(self : BrowserLogin) -> Option[String] {
  (hooks.polled)()
  let s = bl_back(self.id)
  if s.length() == 0 {
    None
  } else {
    Some(s)
  }
}

/// Stops listening and forgets it.
pub fn BrowserLogin::end(self : BrowserLogin) -> Unit {
  bl_end(self.id)
}
