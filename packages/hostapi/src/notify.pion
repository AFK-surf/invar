// System notifications and push token/service queries.
// Ported from libs/mbui/src/hostapi/notify.mbt.

/// Shows a notification in `channel`, replacing any with the same `tag`.
pub fn notice_show(
  channel : String,
  tag : String,
  title : String,
  body : String,
  opens : String,
) -> Unit {
  nt_show(channel, tag, title, body, opens)
}

/// Cancels the notification of `tag`, if shown.
pub fn notice_cancel(tag : String) -> Unit {
  nt_cancel(tag)
}

/// Notification permission state: "granted", "denied", "ask", "default", or "unknown".
pub fn notice_permission() -> String {
  let s = nt_state(0)
  if s == 1 {
    "granted"
  } else if s == 2 {
    "denied"
  } else if s == 3 {
    "ask"
  } else if s == 4 {
    "default"
  } else {
    "unknown"
  }
}

/// Requests notification permission; false if nothing was asked.
pub fn notice_ask() -> Bool {
  nt_state(1) != 0
}

/// The system's answer to the last `notice_ask`, once.
pub fn notice_answer() -> Option[Bool] {
  let s = nt_state(2)
  if s == 1 {
    Some(true)
  } else if s == 0 {
    Some(false)
  } else {
    None
  }
}

/// Opens system notification settings for the app.
pub fn notice_settings() -> Bool {
  nt_state(3) == 1
}

/// Whether the system shows the badge number on the app's icon.
pub fn badge_shown() -> Bool {
  nt_state(4) == 1
}

/// The `opens` payload of a notification tapped since last look, once ("" none).
pub fn notice_opened() -> String {
  nt_text(0)
}

/// This device's push token for the app ("" none).
pub fn push_token() -> String {
  nt_text(1)
}

/// The push service ("fcm", "apns", "apns-sandbox", or "").
pub fn push_service() -> String {
  nt_text(2)
}
