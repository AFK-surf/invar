import "mbt_compat"

// What a halt prints is its words and its caller's line (said: what it stops with, @halt.saying).

///|

fn here(loc~ : String = "") -> String {
  loc
}

///|
test "a halt says its words and the line that said them" {
  let at = here(loc="halt_test.mbt:11:12")
  let words = said("flow: nothing in the run holds 「x」 to drop", at)
  { let __mbt_aa_1 = mbt_compat::str_has_prefix(words, "flow: nothing in the run holds 「x」 to drop\n  at "); mbt_compat::assert_true(__mbt_aa_1, "halt_test.mbt:13") }
  { let __mbt_aa_2 = words.contains("halt_test.mbt:"); mbt_compat::assert_true(__mbt_aa_2, "halt_test.mbt:14") }
  { let __mbt_aa_3 = mbt_compat::str_has_suffix(words, at.to_string()); mbt_compat::assert_true(__mbt_aa_3, "halt_test.mbt:15") }
}
