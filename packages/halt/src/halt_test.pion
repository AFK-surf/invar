test "halt said formats message and location" {
  let words = said("flow: nothing in the run holds x to drop", "halt_test.pion:2")
  debug_assert(words == "flow: nothing in the run holds x to drop\n  at halt_test.pion:2", "said format")
  debug_assert(words.starts_with("flow: nothing in the run holds x to drop\n  at "), "prefix")
  debug_assert(words.contains("halt_test.pion:"), "contains file")
  debug_assert(words.ends_with("halt_test.pion:2"), "suffix")
}

test "halt assert_halt passes on true" {
  assert_halt(true, "should not halt", "halt_test.pion:10")
  assert_halt(1 + 1 == 2, "math works", "halt_test.pion:11")
}
