// A run stopped says why, and where, before it stops.
// Ported from libs/mbui/src/halt/halt.mbt.

/// What a halt prints: the words, then where they were said.
pub fn said(msg : String, loc : String) -> String {
  msg + "\n  at " + loc
}

/// Stops the run with message and location.
pub fn saying[T](msg : String, loc : String) -> T {
  panic(said(msg, loc))
}

/// Stops the run with message only.
pub fn halt[T](msg : String) -> T {
  panic(msg)
}

/// Asserts a condition, halting with message and location if false.
pub fn assert_halt(cond : Bool, msg : String, loc : String) -> Unit {
  if !cond {
    panic(said(msg, loc))
  }
}

/// Marks an unreachable branch, halting with message and location.
pub fn unreachable[T](msg : String, loc : String) -> T {
  panic(said("unreachable: " + msg, loc))
}
