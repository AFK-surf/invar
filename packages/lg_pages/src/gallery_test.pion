// Unit tests for packages/lg_pages: gallery bar page switching, look switching, modal dialog bar hiding,
// chrome=false mode, bottom dock 4-scene switching, film page controls, and self-hosted library app flows.
// Ported from upstream libs/liquid-glass/src/pages/gallery_wbtest.mbt (see NOTICE).

import "lg"
import "ui"
import "view"

let settled : Double = 1000.0

fn gallery_case(first : String, dark~ : Bool = false, chrome~ : Bool = true, w~ : Double = 1280.0, h~ : Double = 1040.0) -> ui::Tester {
  lg::set_dark(Some(dark))
  ui::Tester::tree(
    fn(root : view::View) -> Unit { gallery(root, first, chrome=chrome) },
    width=w,
    height=h,
    theme=lg::ui_theme,
    platform=0,
    dark=dark,
  )
}

fn tap_node(t : ui::Tester, label : String, role : view::Role) -> Unit {
  match t.get(label, role=role) {
    Some(d) => t.tap(d.x + d.w / 2.0, d.y + d.h / 2.0)
    None => debug_assert(false, "expected node '\{label}' to exist")
  }
}

fn count_glass(t : ui::Tester) -> Int {
  let mut n = 0
  for d in t.drawn() {
    if d.glass.is_some() {
      n += 1
    }
  }
  n
}

test "lg_pages_gallery_bar_switches_pages_and_hides_for_dialog" {
  let t = gallery_case("overview")
  debug_assert(t.get("Overview", role=view::Role::Tab).is_some(), "Overview tab must exist")
  debug_assert(t.get("Interactive", role=view::Role::Tab).is_some(), "Interactive tab must exist")
  debug_assert(t.get("Merge", role=view::Role::Tab).is_some(), "Merge tab must exist")
  debug_assert(t.get("Dialog", role=view::Role::Tab).is_some(), "Dialog tab must exist")
  debug_assert(t.get("Light", role=view::Role::Radio).is_some(), "Light radio must exist")
  debug_assert(t.get("Dark", role=view::Role::Radio).is_some(), "Dark radio must exist")

  tap_node(t, "Interactive", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(count_glass(t) >= 4, "interactive page must draw glass layers")

  tap_node(t, "Dialog", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_some(), "Dialog must open")
  debug_assert(t.get("Light", role=view::Role::Radio).is_none(), "bar must hide while modal dialog is open")

  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_none(), "Escape must close modal dialog")
  debug_assert(t.get("Overview", role=view::Role::Tab).is_some(), "bar must return after dialog closes")
  t.dispose()
}

test "lg_pages_gallery_bar_switches_light_and_dark" {
  let t = gallery_case("overview", dark=false)
  debug_assert(!lg::is_dark(), "initial look must be light")
  tap_node(t, "Dark", view::Role::Radio)
  t.run_shown(settled)
  debug_assert(lg::is_dark(), "tapping Dark must switch look to dark")
  tap_node(t, "Light", view::Role::Radio)
  t.run_shown(settled)
  debug_assert(!lg::is_dark(), "tapping Light must switch look back to light")
  t.dispose()
}

test "lg_pages_gallery_without_chrome_has_no_bar" {
  let t = gallery_case("overview", chrome=false)
  debug_assert(t.get("Overview", role=view::Role::Tab).is_none(), "chrome=false must omit page tabs")
  debug_assert(t.get("Light", role=view::Role::Radio).is_none(), "chrome=false must omit look radios")
  debug_assert(count_glass(t) >= 3, "overview without chrome must still render glass layers")
  t.dispose()
}

test "lg_pages_bottom_dock_switches_scenes_and_publish_dialog" {
  let t = gallery_case("overview", chrome=false)

  tap_node(t, "Deck", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Build Native", role=view::Role::Button).is_some(), "Deck must show Build Native button")
  debug_assert(t.get("Backdrop Luminance", role=view::Role::Slider).is_some(), "Deck must show Backdrop Luminance slider")

  tap_node(t, "Loupe", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Optical Loupe", role=view::Role::Group).is_some(), "Loupe must show Optical Loupe")

  tap_node(t, "Merge", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Drag Droplet", role=view::Role::Group).is_some(), "Merge must show Drag Droplet")
  debug_assert(t.get("Split Droplet", role=view::Role::Button).is_some(), "Merge must show Split Droplet")

  let before_x = match t.get("Drag Droplet", role=view::Role::Group) {
    Some(d) => d.x
    None => 0.0
  }
  tap_node(t, "Split Droplet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Fuse Droplet", role=view::Role::Button).is_some(), "Split must toggle button to Fuse Droplet")
  match t.get("Drag Droplet", role=view::Role::Group) {
    Some(d) => debug_assert(d.x - before_x > 40.0, "Split must separate droplet > 40pt")
    None => debug_assert(false, "Drag Droplet must remain visible after split")
  }

  tap_node(t, "Fuse Droplet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Split Droplet", role=view::Role::Button).is_some(), "Fuse must toggle button back to Split Droplet")

  tap_node(t, "Optics", view::Role::Tab)
  t.run_shown(settled)
  tap_node(t, "Publish", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_some(), "Publish must open modal dialog")
  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_none(), "Escape must close Publish dialog")
  t.dispose()
}

test "lg_pages_film_page_renders_all_four_controls" {
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { page(root, "film") },
    width=600.0,
    height=400.0,
    theme=lg::ui_theme,
    platform=0,
    dark=false,
  )
  debug_assert(t.get("Build Native", role=view::Role::Button).is_some(), "film page must have Build Native button")
  debug_assert(t.get("Toggle", role=view::Role::Switch).is_some(), "film page must have Toggle")
  debug_assert(t.get("Slider", role=view::Role::Slider).is_some(), "film page must have Slider")
  debug_assert(t.get("Home", role=view::Role::Tab).is_some(), "film page must have Home tab")
  t.dispose()
}

test "lg_pages_library_app_switches_categories_sheet_and_theme" {
  let t = gallery_case("library", dark=true, chrome=true, w=1280.0, h=800.0)
  // No legacy gallery bar on `library`
  debug_assert(t.get("Page", role=view::Role::TabList).is_none(), "library must hide legacy Page bar")
  debug_assert(t.get("Library sections", role=view::Role::TabList).is_some(), "library must mount bottom Library sections dock")

  let tabs : Array[String] = ["Controls", "Inputs", "Nav", "Overlays", "Physics", "Code", "Optics"]
  for i = 0; i < tabs.length(); i = i + 1 {
    tap_node(t, tabs[i], view::Role::Tab)
    t.run_shown(settled)
    debug_assert(count_glass(t) >= 2, "each library section must draw glass layers")
  }

  // Open Sheet in Overlays and close with Escape
  tap_node(t, "Overlays", view::Role::Tab)
  t.run_shown(settled)
  tap_node(t, "Open Sheet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_some(), "Open Sheet must open Optical Export Sheet")
  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_none(), "Escape must close Optical Export Sheet")

  // Switch theme to Light via top SegmentedControl
  tap_node(t, "Light", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(!lg::is_dark(), "Light segment must switch library theme to light")
  t.dispose()
}

fn assert_overlay_panel_clean(t : ui::Tester, label : String, panel : view::Drawn) -> Unit {
  let gs = t.drawn_glass()
  let mut panel_idx = -1
  let mut i = 0
  while i < gs.length() {
    let g = gs[i]
    if g.4 == 6 &&
    (g.0 - panel.x).abs() < 2.0 &&
    (g.1 - panel.y).abs() < 2.0 &&
    (g.2 - panel.w).abs() < 2.0 &&
    (g.3 - panel.h).abs() < 2.0 {
      panel_idx = i
    }
    i += 1
  }
  debug_assert(panel_idx >= 0, "[\{label}] expected panel glass instance matching rect")
  debug_assert(panel_idx == gs.length() - 1, "[\{label}] zero nested glass allowed inside overlay panel (found \{gs.length() - 1 - panel_idx} after panel)")
}

test "lg_pages_library_overlays_drawer_and_detent_sheet" {
  let modes = [false, true]
  for dark in modes {
    let t = gallery_case("library", dark=dark, chrome=true, w=1280.0, h=800.0)
    tap_node(t, "Overlays", view::Role::Tab)
    t.run_shown(settled)

    // Leading Drawer
    tap_node(t, "Open Drawer", view::Role::Button)
    t.run_shown(settled)
    match t.get("Studio Drawer", role=view::Role::Dialog) {
      Some(dr) => {
        debug_assert((dr.x - 10.0).abs() < 1.5, "Leading Drawer x == 10")
        assert_overlay_panel_clean(t, "library Leading Drawer", dr)
      }
      None => debug_assert(false, "Expected Studio Drawer to open")
    }
    t.key(ui::key_escape)
    t.run_shown(settled)
    debug_assert(t.get("Studio Drawer", role=view::Role::Dialog).is_none(), "Escape closes drawer")

    // Trailing Drawer
    tap_node(t, "Trailing Drawer", view::Role::Button)
    t.run_shown(settled)
    match t.get("Studio Drawer", role=view::Role::Dialog) {
      Some(dr) => {
        debug_assert((1280.0 - (dr.x + dr.w) - 10.0).abs() < 1.5, "Trailing Drawer right inset == 10")
        assert_overlay_panel_clean(t, "library Trailing Drawer", dr)
      }
      None => debug_assert(false, "Expected Trailing Studio Drawer to open")
    }
    tap_node(t, "Done", view::Role::Button)
    t.run_shown(settled)
    debug_assert(t.get("Studio Drawer", role=view::Role::Dialog).is_none(), "Done closes drawer")

    // Detent Sheet
    tap_node(t, "Open Sheet", view::Role::Button)
    t.run_shown(settled)
    let sh_m = match t.get("Optical Export Sheet", role=view::Role::Dialog) {
      Some(s) => s
      None => { debug_assert(false, "Expected Optical Export Sheet"); return }
    }
    assert_overlay_panel_clean(t, "library Detent Sheet Med", sh_m)
    tap_node(t, "Expand Sheet", view::Role::Button)
    t.run_shown(settled)
    let sh_l = match t.get("Optical Export Sheet", role=view::Role::Dialog) {
      Some(s) => s
      None => { debug_assert(false, "Expected Expanded Optical Export Sheet"); return }
    }
    debug_assert(sh_l.h > sh_m.h + 120.0, "Expanded sheet must be taller than Medium")
    assert_overlay_panel_clean(t, "library Detent Sheet Large", sh_l)
    t.key(ui::key_escape)
    t.run_shown(settled)
    debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_none(), "Escape closes sheet")
    t.dispose()
  }
}

test "lg_pages_optics_light_angle_slider_and_cleanup" {
  let t = gallery_case("overview", dark=false, chrome=false, w=1120.0, h=690.0)
  debug_assert(t.get("Light Angle", role=view::Role::Slider).is_some(), "Optics inspector must expose Light Angle slider")
  ui::set_glass_light_angle(0.5)
  debug_assert((ui::glass_light_angle() - 0.5).abs() < 0.001, "glass_light_angle must reflect set value")
  t.dispose()
  debug_assert(ui::glass_light_angle().abs() < 0.001, "unmounting Optics stage must reset glass_light_angle to 0")
}

test "lg_pages_code_section_ide_terminal_diff_zero_nested_glass_and_scroll_clean" {
  let modes = [false, true]
  for dark in modes {
    set_library_initial_cat(6)
    let t = gallery_case("library", dark=dark, chrome=true, w=1280.0, h=800.0)
    t.run_shown(settled)
    debug_assert(t.get("Pion Code Editor", role=view::Role::TextField).is_some(), "Code section must mount CodeFieldView")
    debug_assert(t.get("Invar VT100 Terminal", role=view::Role::Group).is_some(), "Code section must mount TerminalView")
    debug_assert(t.get("Myers TextDiff", role=view::Role::Group).is_some(), "Code section must mount Myers TextDiff panel")
    // Switch code snippet and trigger live terminal commands
    tap_node(t, "Worker", view::Role::Button)
    t.run_shown(settled)
    tap_node(t, "invar bench", view::Role::Button)
    tap_node(t, "invar audit", view::Role::Button)
    tap_node(t, "24-bit ANSI", view::Role::Button)
    t.run_shown(settled)
    lg::assert_no_nested_glass(t, label="lg_pages Code section")
    debug_assert(t.scroll_faults().length() == 0, "Code section must have 0 scroll faults")
    t.dispose()
  }
  set_library_initial_cat(0)
}

test "lg_pages_parse_library_cat_and_mobile_viewport_clean" {
  debug_assert(parse_library_cat("") == 0, "empty cat defaults to Optics (0)")
  debug_assert(parse_library_cat("optics") == 0, "optics -> 0")
  debug_assert(parse_library_cat("controls") == 1, "controls -> 1")
  debug_assert(parse_library_cat("inputs") == 2, "inputs -> 2")
  debug_assert(parse_library_cat("nav") == 3, "nav -> 3")
  debug_assert(parse_library_cat("overlays") == 4, "overlays -> 4")
  debug_assert(parse_library_cat("physics") == 5, "physics -> 5")
  debug_assert(parse_library_cat("code") == 6, "code -> 6")
  // Mobile viewport (390x844): Optics hero + catalog sheet search hits Code
  set_library_initial_cat(0)
  let tm = gallery_case("library", dark=true, chrome=true, w=390.0, h=844.0)
  tm.run_shown(settled)
  debug_assert(tm.get("Search & Catalog", role=view::Role::Button).is_some(), "mobile dock must show Search & Catalog orb")
  tap_node(tm, "Search & Catalog", view::Role::Button)
  tm.run_shown(settled)
  debug_assert(tm.get("Code", role=view::Role::Button).is_some(), "catalog sheet must list Code category")
  // Filter catalog by "code" so Code moves to the top of the sheet and verify search hits it
  tap_node(tm, "Filter components", view::Role::TextField)
  tm.type_text("code")
  tm.run_shown(settled)
  debug_assert(tm.get("Code", role=view::Role::Button).is_some(), "catalog search 'code' must match Code")
  tap_node(tm, "Code", view::Role::Button)
  tm.run_shown(settled)
  debug_assert(tm.get("Pion Code Editor", role=view::Role::TextField).is_some(), "selecting Code on mobile mounts CodeFieldView")
  lg::assert_no_nested_glass(tm, label="lg_pages mobile Code")
  debug_assert(tm.scroll_faults().length() == 0, "mobile Code section must have 0 scroll faults")
  tm.dispose()
}

test "lg_pages_mobile_layout_412x740_and_390x844_no_truncation_balanced_bars_zero_faults" {
  let viewports : Array[(Double, Double, Bool)] = [
    (412.0, 740.0, true),
    (390.0, 844.0, false),
  ]
  for vp in viewports {
    let (vw, vh, dark) = vp
    set_library_initial_cat(0)
    let t = gallery_case("library", dark=dark, chrome=true, w=vw, h=vh)
    t.run_shown(settled)

    // 1. Optics stage prism & compact Optical Parameters card fit cleanly above bottom dock (no truncation)
    match t.get("Optical Prism", role=view::Role::Group) {
      Some(prism) => {
        debug_assert(prism.y >= 56.0, "mobile prism must sit below top nav bar")
        debug_assert(prism.h >= 120.0 && prism.h <= 140.0, "mobile prism height must be compact (132pt)")
      }
      None => debug_assert(false, "mobile Optics must mount Optical Prism")
    }
    match t.get("Optical Parameters", role=view::Role::Group) {
      Some(card) => {
        debug_assert(card.y + card.h <= vh - 68.0, "mobile Optical Parameters card must clear bottom dock (y+h <= h-68)")
      }
      None => debug_assert(false, "mobile Optics must mount Optical Parameters card")
    }
    match t.get("Publish", role=view::Role::Button) {
      Some(pub_btn) => {
        debug_assert(pub_btn.y + pub_btn.h <= vh - 68.0, "mobile Publish button must be fully visible above dock")
      }
      None => debug_assert(false, "mobile Optics must show Publish button")
    }
    match t.get("Reset", role=view::Role::Button) {
      Some(rst_btn) => {
        debug_assert(rst_btn.y + rst_btn.h <= vh - 68.0, "mobile Reset button must be fully visible above dock")
      }
      None => debug_assert(false, "mobile Optics must show Reset button")
    }

    // 2. Bottom dock: Search & Catalog orb is 50pt tall, matching Library sections tab capsule height
    let orb = match t.get("Search & Catalog", role=view::Role::Button) {
      Some(d) => d
      None => { debug_assert(false, "mobile dock must have Search & Catalog orb"); return }
    }
    let dock = match t.get("Library sections", role=view::Role::TabList) {
      Some(d) => d
      None => { debug_assert(false, "mobile dock must have Library sections tablist"); return }
    }
    debug_assert((orb.h - lg::tabs_h).abs() < 1.0, "Search & Catalog orb height must match tabs_h")
    debug_assert((orb.w - lg::tabs_h).abs() < 1.0, "Search & Catalog orb width must match tabs_h")
    debug_assert((orb.h - dock.h).abs() < 1.5, "Search & Catalog orb must match tab capsule height")
    debug_assert((orb.y - dock.y).abs() < 1.5, "Search & Catalog orb must align vertically with tab capsule")

    // 3. Top bar: trailing controls (Light/Dark + Studio options) do not overlap and stay within viewport
    let menu_btn = match t.get("Studio options", role=view::Role::Button) {
      Some(d) => d
      None => { debug_assert(false, "mobile top bar must have Studio options button"); return }
    }
    debug_assert(menu_btn.x + menu_btn.w <= vw - 10.0, "Studio options button must stay inside viewport")
    debug_assert(menu_btn.y >= 8.0 && menu_btn.y + menu_btn.h <= 64.0, "Studio options button must sit in top bar")

    lg::assert_no_nested_glass(t, label="mobile Optics \{vw}x\{vh}", max_glass_coverage=0.55)
    debug_assert(t.scroll_faults().length() == 0, "mobile Optics must have 0 scroll faults")

    // 4. Switch to Controls, Physics (Loupe & Merge), Overlays and verify 0 nested glass & 0 scroll faults
    tap_node(t, "Controls", view::Role::Tab)
    t.run_shown(settled)
    lg::assert_no_nested_glass(t, label="mobile Controls \{vw}x\{vh}")
    debug_assert(t.scroll_faults().length() == 0, "mobile Controls must have 0 scroll faults")

    tap_node(t, "Overlays", view::Role::Tab)
    t.run_shown(settled)
    lg::assert_no_nested_glass(t, label="mobile Overlays \{vw}x\{vh}")
    debug_assert(t.scroll_faults().length() == 0, "mobile Overlays must have 0 scroll faults")

    t.dispose()

    // Physics (Loupe & Capillary Merge) on mobile viewport
    set_library_initial_cat(5)
    let tp = gallery_case("library", dark=dark, chrome=true, w=vw, h=vh)
    tp.run_shown(settled)
    lg::assert_no_nested_glass(tp, label="mobile Physics Loupe \{vw}x\{vh}")
    debug_assert(tp.scroll_faults().length() == 0, "mobile Physics Loupe must have 0 scroll faults")
    tap_node(tp, "Capillary Merge", view::Role::Tab)
    tp.run_shown(settled)
    debug_assert(tp.get("Drag Droplet", role=view::Role::Group).is_some(), "mobile Physics Merge must mount Drag Droplet")
    debug_assert(tp.get("Split Droplet", role=view::Role::Button).is_some(), "mobile Physics Merge must mount Split Droplet")
    debug_assert(tp.scroll_faults().length() == 0, "mobile Physics Merge must have 0 scroll faults")
    tp.dispose()
  }

  // Short-screen fallback (412x620): card scrolls cleanly inside without scroll faults or nested glass
  set_library_initial_cat(0)
  let ts = gallery_case("library", dark=true, chrome=true, w=412.0, h=620.0)
  ts.run_shown(settled)
  match ts.get("Optical Parameters", role=view::Role::Group) {
    Some(card) => debug_assert(card.y + card.h <= 620.0 - 68.0, "short-screen Optical Parameters card must clear dock")
    None => debug_assert(false, "short-screen Optics must mount Optical Parameters card")
  }
  lg::assert_no_nested_glass(ts, label="mobile Optics short 412x620", max_glass_coverage=0.70)
  debug_assert(ts.scroll_faults().length() == 0, "short-screen mobile Optics must have 0 scroll faults")
  ts.dispose()
  set_library_initial_cat(0)
}

test "lg_pages_mobile_360x780_all_tabs_zero_faults_and_catalog_sheet_all_categories" {
  let cats : Array[Int] = [0, 1, 2, 3, 4, 5, 6]
  for c in cats {
    set_library_initial_cat(c)
    let t = gallery_case("library", dark=true, chrome=true, w=360.0, h=780.0)
    t.run_shown(settled)
    // Full-bleed scroll views allow scrolled glass pills to pass beneath the floating bottom dock;
    // verify zero unasked faults and zero scroll faults across all 7 tabs, plus strict non-overlap on non-underlapping initial frames.
    debug_assert(t.unasked_faults().length() == 0, "mobile 360x780 cat=\{c} must have 0 unasked faults")
    debug_assert(t.scroll_faults().length() == 0, "mobile 360x780 cat=\{c} must have 0 scroll faults")
    if c != 2 && c != 3 {
      lg::assert_no_nested_glass(
        t,
        label="mobile 360x780 cat=\{c}",
        max_glass_coverage=if c == 0 { 0.55 } else { 0.45 },
      )
    }
    if c == 5 {
      tap_node(t, "Capillary Merge", view::Role::Tab)
      t.run_shown(settled)
      debug_assert(t.get("Split Droplet", role=view::Role::Button).is_some(), "360x780 Merge must mount Split Droplet")
      debug_assert(t.scroll_faults().length() == 0, "360x780 Merge must have 0 scroll faults")
    }
    t.dispose()
  }
  set_library_initial_cat(0)
}
