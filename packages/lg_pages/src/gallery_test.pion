// Unit tests for packages/lg_pages: gallery bar page switching, look switching, modal dialog bar hiding,
// chrome=false mode, bottom dock 4-scene switching, film page controls, and self-hosted library app flows.
// Ported from libs/liquid-glass/src/pages/gallery_wbtest.mbt (monoid@1eec0cd3ce).

import "lg"
import "ui"
import "view"

let settled : Double = 1000.0

fn gallery_case(first : String, dark~ : Bool = false, chrome~ : Bool = true, w~ : Double = 1280.0, h~ : Double = 1040.0) -> ui::Tester {
  lg::set_dark(Some(dark))
  ui::Tester::tree(
    fn(root : view::View) -> Unit { gallery(root, first, chrome=chrome) },
    width=w,
    height=h,
    theme=lg::ui_theme,
    platform=0,
    dark=dark,
  )
}

fn tap_node(t : ui::Tester, label : String, role : view::Role) -> Unit {
  match t.get(label, role=role) {
    Some(d) => t.tap(d.x + d.w / 2.0, d.y + d.h / 2.0)
    None => debug_assert(false, "expected node '\{label}' to exist")
  }
}

fn count_glass(t : ui::Tester) -> Int {
  let mut n = 0
  for d in t.drawn() {
    if d.glass.is_some() {
      n += 1
    }
  }
  n
}

test "lg_pages_gallery_bar_switches_pages_and_hides_for_dialog" {
  let t = gallery_case("overview")
  debug_assert(t.get("Overview", role=view::Role::Tab).is_some(), "Overview tab must exist")
  debug_assert(t.get("Interactive", role=view::Role::Tab).is_some(), "Interactive tab must exist")
  debug_assert(t.get("Merge", role=view::Role::Tab).is_some(), "Merge tab must exist")
  debug_assert(t.get("Dialog", role=view::Role::Tab).is_some(), "Dialog tab must exist")
  debug_assert(t.get("Light", role=view::Role::Radio).is_some(), "Light radio must exist")
  debug_assert(t.get("Dark", role=view::Role::Radio).is_some(), "Dark radio must exist")

  tap_node(t, "Interactive", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(count_glass(t) >= 4, "interactive page must draw glass layers")

  tap_node(t, "Dialog", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_some(), "Dialog must open")
  debug_assert(t.get("Light", role=view::Role::Radio).is_none(), "bar must hide while modal dialog is open")

  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_none(), "Escape must close modal dialog")
  debug_assert(t.get("Overview", role=view::Role::Tab).is_some(), "bar must return after dialog closes")
  t.dispose()
}

test "lg_pages_gallery_bar_switches_light_and_dark" {
  let t = gallery_case("overview", dark=false)
  debug_assert(!lg::is_dark(), "initial look must be light")
  tap_node(t, "Dark", view::Role::Radio)
  t.run_shown(settled)
  debug_assert(lg::is_dark(), "tapping Dark must switch look to dark")
  tap_node(t, "Light", view::Role::Radio)
  t.run_shown(settled)
  debug_assert(!lg::is_dark(), "tapping Light must switch look back to light")
  t.dispose()
}

test "lg_pages_gallery_without_chrome_has_no_bar" {
  let t = gallery_case("overview", chrome=false)
  debug_assert(t.get("Overview", role=view::Role::Tab).is_none(), "chrome=false must omit page tabs")
  debug_assert(t.get("Light", role=view::Role::Radio).is_none(), "chrome=false must omit look radios")
  debug_assert(count_glass(t) >= 3, "overview without chrome must still render glass layers")
  t.dispose()
}

test "lg_pages_bottom_dock_switches_scenes_and_publish_dialog" {
  let t = gallery_case("overview", chrome=false)

  tap_node(t, "Deck", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Build Native", role=view::Role::Button).is_some(), "Deck must show Build Native button")
  debug_assert(t.get("Backdrop Luminance", role=view::Role::Slider).is_some(), "Deck must show Backdrop Luminance slider")

  tap_node(t, "Loupe", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Optical Loupe", role=view::Role::Group).is_some(), "Loupe must show Optical Loupe")

  tap_node(t, "Merge", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(t.get("Drag Droplet", role=view::Role::Group).is_some(), "Merge must show Drag Droplet")
  debug_assert(t.get("Split Droplet", role=view::Role::Button).is_some(), "Merge must show Split Droplet")

  let before_x = match t.get("Drag Droplet", role=view::Role::Group) {
    Some(d) => d.x
    None => 0.0
  }
  tap_node(t, "Split Droplet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Fuse Droplet", role=view::Role::Button).is_some(), "Split must toggle button to Fuse Droplet")
  match t.get("Drag Droplet", role=view::Role::Group) {
    Some(d) => debug_assert(d.x - before_x > 40.0, "Split must separate droplet > 40pt")
    None => debug_assert(false, "Drag Droplet must remain visible after split")
  }

  tap_node(t, "Fuse Droplet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Split Droplet", role=view::Role::Button).is_some(), "Fuse must toggle button back to Split Droplet")

  tap_node(t, "Optics", view::Role::Tab)
  t.run_shown(settled)
  tap_node(t, "Publish", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_some(), "Publish must open modal dialog")
  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Publish Invar", role=view::Role::Dialog).is_none(), "Escape must close Publish dialog")
  t.dispose()
}

test "lg_pages_film_page_renders_all_four_controls" {
  lg::set_dark(Some(false))
  let t = ui::Tester::tree(
    fn(root : view::View) -> Unit { page(root, "film") },
    width=600.0,
    height=400.0,
    theme=lg::ui_theme,
    platform=0,
    dark=false,
  )
  debug_assert(t.get("Build Native", role=view::Role::Button).is_some(), "film page must have Build Native button")
  debug_assert(t.get("Toggle", role=view::Role::Switch).is_some(), "film page must have Toggle")
  debug_assert(t.get("Slider", role=view::Role::Slider).is_some(), "film page must have Slider")
  debug_assert(t.get("Home", role=view::Role::Tab).is_some(), "film page must have Home tab")
  t.dispose()
}

test "lg_pages_library_app_switches_categories_sheet_and_theme" {
  let t = gallery_case("library", dark=true, chrome=true, w=1280.0, h=800.0)
  // No legacy gallery bar on `library`
  debug_assert(t.get("Page", role=view::Role::TabList).is_none(), "library must hide legacy Page bar")
  debug_assert(t.get("Library sections", role=view::Role::TabList).is_some(), "library must mount bottom Library sections dock")

  let tabs : Array[String] = ["Controls", "Inputs", "Nav", "Overlays", "Physics", "Optics"]
  for i = 0; i < tabs.length(); i = i + 1 {
    tap_node(t, tabs[i], view::Role::Tab)
    t.run_shown(settled)
    debug_assert(count_glass(t) >= 2, "each library section must draw glass layers")
  }

  // Open Sheet in Overlays and close with Escape
  tap_node(t, "Overlays", view::Role::Tab)
  t.run_shown(settled)
  tap_node(t, "Open Sheet", view::Role::Button)
  t.run_shown(settled)
  debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_some(), "Open Sheet must open Optical Export Sheet")
  t.key(ui::key_escape)
  t.run_shown(settled)
  debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_none(), "Escape must close Optical Export Sheet")

  // Switch theme to Light via top SegmentedControl
  tap_node(t, "Light", view::Role::Tab)
  t.run_shown(settled)
  debug_assert(!lg::is_dark(), "Light segment must switch library theme to light")
  t.dispose()
}

fn assert_overlay_panel_clean(t : ui::Tester, label : String, panel : view::Drawn) -> Unit {
  let gs = t.drawn_glass()
  let mut panel_idx = -1
  let mut i = 0
  while i < gs.length() {
    let g = gs[i]
    if g.4 == 6 &&
      (g.0 - panel.x).abs() < 2.0 &&
      (g.1 - panel.y).abs() < 2.0 &&
      (g.2 - panel.w).abs() < 2.0 &&
      (g.3 - panel.h).abs() < 2.0 {
      panel_idx = i
    }
    i += 1
  }
  debug_assert(panel_idx >= 0, "[\{label}] expected panel glass instance matching rect")
  debug_assert(panel_idx == gs.length() - 1, "[\{label}] zero nested glass allowed inside overlay panel (found \{gs.length() - 1 - panel_idx} after panel)")
}

test "lg_pages_library_overlays_drawer_and_detent_sheet" {
  let modes = [false, true]
  for dark in modes {
    let t = gallery_case("library", dark=dark, chrome=true, w=1280.0, h=800.0)
    tap_node(t, "Overlays", view::Role::Tab)
    t.run_shown(settled)

    // Leading Drawer
    tap_node(t, "Open Drawer", view::Role::Button)
    t.run_shown(settled)
    match t.get("Studio Drawer", role=view::Role::Dialog) {
      Some(dr) => {
        debug_assert((dr.x - 10.0).abs() < 1.5, "Leading Drawer x == 10")
        assert_overlay_panel_clean(t, "library Leading Drawer", dr)
      }
      None => debug_assert(false, "Expected Studio Drawer to open")
    }
    t.key(ui::key_escape)
    t.run_shown(settled)
    debug_assert(t.get("Studio Drawer", role=view::Role::Dialog).is_none(), "Escape closes drawer")

    // Trailing Drawer
    tap_node(t, "Trailing Drawer", view::Role::Button)
    t.run_shown(settled)
    match t.get("Studio Drawer", role=view::Role::Dialog) {
      Some(dr) => {
        debug_assert((1280.0 - (dr.x + dr.w) - 10.0).abs() < 1.5, "Trailing Drawer right inset == 10")
        assert_overlay_panel_clean(t, "library Trailing Drawer", dr)
      }
      None => debug_assert(false, "Expected Trailing Studio Drawer to open")
    }
    tap_node(t, "Done", view::Role::Button)
    t.run_shown(settled)
    debug_assert(t.get("Studio Drawer", role=view::Role::Dialog).is_none(), "Done closes drawer")

    // Detent Sheet
    tap_node(t, "Open Sheet", view::Role::Button)
    t.run_shown(settled)
    let sh_m = match t.get("Optical Export Sheet", role=view::Role::Dialog) {
      Some(s) => s
      None => { debug_assert(false, "Expected Optical Export Sheet"); return }
    }
    assert_overlay_panel_clean(t, "library Detent Sheet Med", sh_m)
    tap_node(t, "Expand Sheet", view::Role::Button)
    t.run_shown(settled)
    let sh_l = match t.get("Optical Export Sheet", role=view::Role::Dialog) {
      Some(s) => s
      None => { debug_assert(false, "Expected Expanded Optical Export Sheet"); return }
    }
    debug_assert(sh_l.h > sh_m.h + 120.0, "Expanded sheet must be taller than Medium")
    assert_overlay_panel_clean(t, "library Detent Sheet Large", sh_l)
    t.key(ui::key_escape)
    t.run_shown(settled)
    debug_assert(t.get("Optical Export Sheet", role=view::Role::Dialog).is_none(), "Escape closes sheet")
    t.dispose()
  }
}

test "lg_pages_optics_light_angle_slider_and_cleanup" {
  let t = gallery_case("overview", dark=false, chrome=false, w=1120.0, h=690.0)
  debug_assert(t.get("Light Angle", role=view::Role::Slider).is_some(), "Optics inspector must expose Light Angle slider")
  ui::set_glass_light_angle(0.5)
  debug_assert((ui::glass_light_angle() - 0.5).abs() < 0.001, "glass_light_angle must reflect set value")
  t.dispose()
  debug_assert(ui::glass_light_angle().abs() < 0.001, "unmounting Optics stage must reset glass_light_angle to 0")
}
