// Interactive Code / IDE Exhibition Section (`cat == 6`) for `packages/lg_pages`:
// - Live editable `code_field::CodeFieldView` with 3 switchable Pure Pion snippets (`Pion-JSX` / `Worker` / `Shader`)
// - Live interactive `terminal::TerminalView` (VT100 + 24-bit ANSI truecolor) with 3 real-time command buttons
// - Live Myers O(ND) `textdiff::diff_lines` panel showing colored insertions/deletions & diff stats
// Strictly zero nested glass: interactive `lg::liquid_button_node` pills sit directly on the optical canvas,
// while code/terminal/diff surfaces use crisp opaque IDE surfaces with concentric borders and horizontal scroll fallback.

import "code_field"
import "lg"
import "signals"
import "terminal"
import "text"
import "textdiff"
import "ui"
import "view"

fn code_esc() -> String {
  let sb = StringBuilder::new()
  sb.write_byte(27 as Byte)
  sb.to_string()
}

fn code_snippet_src(idx : Int, compact~ : Bool = false) -> String {
  if compact {
    match idx {
      1 =>
      "// Worker Pool in Pure Pion\nimport \"signals\"\n\npub fn batch(xs : Array[Int]) {\n  let mut sum = 0\n  for x in xs {\n    sum = sum + (x * 2 + 1)\n  }\n  sum\n}"
      2 =>
      "// Liquid Glass Refraction\nimport \"paint\"\n\npub fn prism(d : Bool) {\n  let t = if d { 0x202020B3L }\n    else { 0xFDFCFDB3L }\n  paint::Glass::liquid(\n    blur=9.0, tint=t, rim=0.65,\n    bezel=22.0, refraction=32.0,\n  )\n}"
      _ =>
      "// Pure Pion + Liquid Glass\nimport \"lg\"\nimport \"signals\"\n\npub fn counter(r : view::View) {\n  let n = signals::signal(42)\n  let _ = lg::liquid_button_node(\n    r, fn() { \"Count: \\{n.get()}\" },\n    fn() { n.set(n.get() + 1) },\n  )\n}"
    }
  } else {
    match idx {
      1 =>
      "// Deterministic Worker Pool in Pure Pion\nimport \"signals\"\n\npub fn run_batch(jobs : Array[Int]) -> Int {\n  let mut total = 0\n  for j in jobs {\n    total = total + (j * 2 + 1)\n  }\n  total\n}"
      2 =>
      "// Liquid Glass Refraction Kernel Params\nimport \"paint\"\n\npub fn hero_prism(dark : Bool) -> paint::Glass {\n  let tint = if dark { 0x202020B3L } else { 0xFDFCFDB3L }\n  paint::Glass::liquid(\n    blur=9.0, tint=tint, rim=0.65,\n    bezel=22.0, refraction=32.0,\n  )\n}"
      _ =>
      "// Pure Pion-JSX + Liquid Glass Surface\nimport \"lg\"\nimport \"signals\"\n\npub fn counter_card(root : view::View) -> Unit {\n  let count = signals::signal(42)\n  let _ = lg::liquid_button_node(\n    root, fn() { \"Count: \\{count.get()}\" },\n    fn() { count.set(count.get() + 1) },\n  )\n}"
    }
  }
}

fn code_diff_before(idx : Int, compact~ : Bool = false) -> String {
  if compact {
    match idx {
      1 =>
      "pub fn batch(xs : Array[Int]) {\n  let mut sum = 0\n  for x in xs {\n    sum = sum + x\n  }\n  sum\n}"
      2 =>
      "pub fn prism(d : Bool) {\n  let t = if d { 0x202020CCL }\n    else { 0xFDFCFD67L }\n  paint::Glass::liquid(\n    blur=8.0, tint=t, rim=0.60,\n    bezel=20.0, refraction=36.0,\n  )\n}"
      _ =>
      "pub fn counter(r : view::View) {\n  let n = signals::signal(0)\n  let _ = lg::liquid_button_node(\n    r, fn() { \"Tap\" },\n    fn() { n.set(n.get() + 1) },\n  )\n}"
    }
  } else {
    match idx {
      1 =>
      "pub fn run_batch(jobs : Array[Int]) -> Int {\n  let mut total = 0\n  for j in jobs {\n    total = total + j\n  }\n  total\n}"
      2 =>
      "pub fn hero_prism(dark : Bool) -> paint::Glass {\n  let tint = if dark { 0x202020CCL } else { 0xFDFCFD67L }\n  paint::Glass::liquid(\n    blur=8.0, tint=tint, rim=0.60,\n    bezel=20.0, refraction=36.0,\n  )\n}"
      _ =>
      "pub fn counter_card(root : view::View) -> Unit {\n  let count = signals::signal(0)\n  let _ = lg::liquid_button_node(\n    root, fn() { \"Tap\" },\n    fn() { count.set(count.get() + 1) },\n  )\n}"
    }
  }
}

fn code_diff_after(idx : Int, compact~ : Bool = false) -> String {
  if compact {
    match idx {
      1 =>
      "pub fn batch(xs : Array[Int]) {\n  let mut sum = 0\n  for x in xs {\n    sum = sum + (x * 2 + 1)\n  }\n  sum\n}"
      2 =>
      "pub fn prism(d : Bool) {\n  let t = if d { 0x202020B3L }\n    else { 0xFDFCFDB3L }\n  paint::Glass::liquid(\n    blur=9.0, tint=t, rim=0.65,\n    bezel=22.0, refraction=32.0,\n  )\n}"
      _ =>
      "pub fn counter(r : view::View) {\n  let n = signals::signal(42)\n  let _ = lg::liquid_button_node(\n    r, fn() { \"Count: \\{n.get()}\" },\n    fn() { n.set(n.get() + 1) },\n  )\n}"
    }
  } else {
    match idx {
      1 =>
      "pub fn run_batch(jobs : Array[Int]) -> Int {\n  let mut total = 0\n  for j in jobs {\n    total = total + (j * 2 + 1)\n  }\n  total\n}"
      2 =>
      "pub fn hero_prism(dark : Bool) -> paint::Glass {\n  let tint = if dark { 0x202020B3L } else { 0xFDFCFDB3L }\n  paint::Glass::liquid(\n    blur=9.0, tint=tint, rim=0.65,\n    bezel=22.0, refraction=32.0,\n  )\n}"
      _ =>
      "pub fn counter_card(root : view::View) -> Unit {\n  let count = signals::signal(42)\n  let _ = lg::liquid_button_node(\n    root, fn() { \"Count: \\{count.get()}\" },\n    fn() { count.set(count.get() + 1) },\n  )\n}"
    }
  }
}

fn code_term_init(term : terminal::TerminalModel, compact~ : Bool = false) -> Unit {
  let e = code_esc()
  if compact {
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m invar doctor\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m pionc2  0.1.0 (QBE + wasm32)\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m hosts   6 native + WebGL 2\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m render  100% GPU · 0 DOM\r\n")
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m invar test --pkg lg_pages\r\n")
    term.feed("  \{e}[38;2;56;189;248mPASS\{e}[0m 334+ tests · 0 faults\r\n")
    term.feed("\{e}[38;2;148;163;184m> ready\{e}[0m\r\n")
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m ")
  } else {
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m invar doctor\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m pionc2   0.1.0 (native QBE + wasm32)\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m hosts    macOS · iOS · Android · Linux · Win · Web\r\n")
    term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m render   100% GPU · 0 DOM · 47 packages\r\n")
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m invar test --pkg lg_pages\r\n")
    term.feed("  \{e}[38;2;56;189;248mPASS\{e}[0m 334+ tests ok · 0 nested glass · 0 faults\r\n")
    term.feed("\{e}[38;2;148;163;184m> ready (tap a command pill above)\{e}[0m\r\n")
    term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m ")
  }
}

fn code_term_run_bench(term : terminal::TerminalModel) -> Unit {
  let e = code_esc()
  term.feed("invar bench\r\n")
  term.feed("  layout \{e}[38;2;74;222;128m0.18ms\{e}[0m paint \{e}[38;2;74;222;128m0.42ms\{e}[0m \{e}[1;38;2;250;204;21m120fps\{e}[0m\r\n")
  term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m ")
}

fn code_term_run_audit(term : terminal::TerminalModel) -> Unit {
  let e = code_esc()
  term.feed("invar audit --json\r\n")
  term.feed("  \{e}[38;2;74;222;128m✓\{e}[0m ok: true · 0 errors · 0 DOM\r\n")
  term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m ")
}

fn code_term_run_ansi(term : terminal::TerminalModel) -> Unit {
  let e = code_esc()
  term.feed("ansi-24bit --spectrum\r\n  ")
  term.feed("\{e}[48;2;239;68;68m  \{e}[48;2;249;115;22m  \{e}[48;2;234;179;8m  \{e}[48;2;34;197;94m  ")
  term.feed("\{e}[48;2;6;182;212m  \{e}[48;2;59;130;246m  \{e}[48;2;168;85;247m  \{e}[48;2;236;72;153m  \{e}[0m 24-bit RGB\r\n")
  term.feed("\{e}[1;38;2;96;165;250m$\{e}[0m ")
}

/// Pure Pion IDE / Terminal / TextDiff exhibition section (`cat == 6`).
fn lib_code_section(
  parent : view::View,
  win_w : () -> Double,
  snippet_idx : signals::Signal[Int],
  cf : code_field::CodeField,
  term : terminal::TerminalModel,
) -> Unit {
  let is_stack = fn() -> Bool {
    let w = win_w()
    w > 0.0 && w < 780.0
  }
  let is_compact = fn() -> Bool {
    let w = win_w()
    w > 0.0 && w < 560.0
  }
  let term_compact = terminal::TerminalModel::new(cols=44, rows=10, palette=terminal::TermPalette::dark())
  code_term_init(term_compact, compact=true)

  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::Is(18.0))
    col.reacts(
      is_compact,
      fn(c : Bool) -> Unit {
        cf.set(code_snippet_src(snippet_idx.untracked(), compact=c))
      },
      at_start=true,
    )
    lib_section_head(col, "CODE · PURE PION IDE, VT100 & DIFF", "100% Pure Pion · Zero Native Deps · Runs on WebAssembly")

    // Top row (2-column on wide viewports, vertical stack on narrow < 780pt): CodeField + VT100 Terminal
    let _ = col.box(fn(split) {
      let _ = split
      .row(view::Live::By(fn() { !is_stack() }))
      .gap(view::Live::Is(16.0))
      .fills_across(view::Live::Is(true))

      // Left column: Editable CodeField + snippet switcher pills
      let _ = split.box(fn(left) {
        let _ = left
        .grow(view::Live::By(fn() { if is_stack() { 0.0 } else { 1.0 } }))
        .basis(view::Live::By(fn() { if is_stack() { None } else { Some(0.0) } }))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(10.0))

        // Header + snippet switcher capsules directly on canvas (zero nested glass)
        let _ = left.box(fn(hdr) {
          let _ = hdr
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(8.0)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
          lib_caption(hdr, "CODE EDITOR")
          let _ = hdr.box(fn(pills) {
            let _ = pills.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let labels = ["Pion-JSX", "Worker", "Shader"]
            for i = 0; i < labels.length(); i = i + 1 {
              let idx = i
              let lbl = labels[i]
              let _ = lg::liquid_button_node(
                pills,
                fn() { lbl },
                fn() {
                  snippet_idx.set(idx)
                  cf.set(code_snippet_src(idx, compact=is_compact()))
                },
                active=fn() { snippet_idx.get() == idx },
                height=28.0,
                pad_x=10.0,
              )
            }
          })
        })

        // Opaque high-contrast editor card (single crisp 1pt border, r=16pt, horizontal scroll fallback)
        let _ = left.box(fn(card) {
          let _ = card
          .radius(view::Live::Is(16.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::Is(code_field::CodePalette::dark().bg))
          .edge(view::Live::By(fn() {
            if lg::is_dark() { (1.0, 0xFFFFFF1FL) } else { (1.0, 0x0000001AL) }
          }))
          let editor_hscroll = view::Scroll::across()
          let _ = card.by_room(fn(host, room) {
            host.pick(
              is_compact,
              fn(slot, compact) {
                let _ = slot.scrolls(
                  editor_hscroll,
                  fn(hs) {
                    let _ = hs.min_width(view::Live::By(fn() {
                      let rw = room.width()
                      if rw > 0.0 { Some(rw) } else { None }
                    }))
                    let _ = code_field::CodeFieldView(
                      hs,
                      cf,
                      font_size=if compact { 11.0 } else { 12.5 },
                      line=if compact { 17.5 } else { 19.5 },
                      palette=code_field::CodePalette::dark(),
                      show_gutter=true,
                      label="Pion Code Editor",
                    )
                  },
                  slop=ui::touch_slop(),
                  bar=ui::tree_scroll_bar(),
                )
              },
              at_once=true,
            )
          })
        })
      })

      // Right column: Interactive VT100/ANSI Terminal + live command pills
      let _ = split.box(fn(right) {
        let _ = right
        .grow(view::Live::By(fn() { if is_stack() { 0.0 } else { 1.0 } }))
        .basis(view::Live::By(fn() { if is_stack() { None } else { Some(0.0) } }))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(10.0))

        let _ = right.box(fn(hdr) {
          let _ = hdr
          .row(view::Live::Is(true))
          .wraps(view::Live::Is(Some(8.0)))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
          lib_caption(hdr, "VT100 TERMINAL")
          let _ = hdr.box(fn(btns) {
            let _ = btns.row(view::Live::Is(true)).wraps(view::Live::Is(Some(6.0))).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let active_term = fn() { if is_compact() { term_compact } else { term } }
            let _ = lg::liquid_button_node(
              btns,
              fn() { "invar bench" },
              fn() { code_term_run_bench(active_term()) },
              height=28.0,
              pad_x=10.0,
            )
            let _ = lg::liquid_button_node(
              btns,
              fn() { "invar audit" },
              fn() { code_term_run_audit(active_term()) },
              height=28.0,
              pad_x=10.0,
            )
            let _ = lg::liquid_button_node(
              btns,
              fn() { "24-bit ANSI" },
              fn() { code_term_run_ansi(active_term()) },
              height=28.0,
              pad_x=10.0,
            )
          })
        })

        let _ = right.box(fn(card) {
          let _ = card
          .radius(view::Live::Is(16.0))
          .clips(view::Live::Is(true))
          .ground(view::Live::Is(terminal::TermPalette::dark().bg))
          .edge(view::Live::By(fn() {
            if lg::is_dark() { (1.0, 0xFFFFFF1FL) } else { (1.0, 0x0000001AL) }
          }))
          let term_hscroll = view::Scroll::across()
          let _ = card.by_room(fn(host, room) {
            host.pick(
              is_compact,
              fn(slot, compact) {
                let _ = slot.scrolls(
                  term_hscroll,
                  fn(hs) {
                    let _ = hs.min_width(view::Live::By(fn() {
                      let rw = room.width()
                      if rw > 0.0 { Some(rw) } else { None }
                    }))
                    let _ = terminal::TerminalView(
                      hs,
                      if compact { term_compact } else { term },
                      font_size=if compact { 10.5 } else { 12.0 },
                      line=if compact { 17.0 } else { 19.5 },
                      label="Invar VT100 Terminal",
                    )
                  },
                  slop=ui::touch_slop(),
                  bar=ui::tree_scroll_bar(),
                )
              },
              at_once=true,
            )
          })
        })
      })
    })

    // Bottom full-width panel: Live Myers O(ND) TextDiff computed via `textdiff::diff_lines`
    let _ = col.box(fn(diff_sec) {
      let _ = diff_sec.gap(view::Live::Is(10.0))
      let _ = diff_sec.box(fn(hdr) {
        let _ = hdr
        .row(view::Live::Is(true))
        .wraps(view::Live::Is(Some(6.0)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(10.0))
        lib_caption(hdr, "MYERS TEXTDIFF · LIVE LINE DIFF")
        let _ = hdr.box(fn(stat_box) {
          let _ = stat_box
          .words(
            view::Live::By(fn() {
              let idx = snippet_idx.get()
              let c = is_compact()
              let ops = textdiff::diff_lines(code_diff_before(idx, compact=c), code_diff_after(idx, compact=c))
              let (add, del, eq) = textdiff::diff_stats(ops)
              "+\{add}  -\{del}  =\{eq} lines"
            }),
            look=lg::words_at(12.0, weight=600),
          )
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
        })
      })

      let _ = diff_sec.box(fn(card) {
        let _ = card
        .radius(view::Live::Is(16.0))
        .clips(view::Live::Is(true))
        .ground(view::Live::Is(0x14171FFFL))
        .edge(view::Live::By(fn() {
          if lg::is_dark() { (1.0, 0xFFFFFF1FL) } else { (1.0, 0x0000001AL) }
        }))
        .says(view::Live::Is(Some(view::said(view::Role::Group, label="Myers TextDiff"))))
        let diff_hscroll = view::Scroll::across()
        let _ = card.by_room(fn(host, room) {
          let _ = host.scrolls(
            diff_hscroll,
            fn(hs) {
              let _ = hs
              .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
              .gap(view::Live::Is(2.0))
              .min_width(view::Live::By(fn() {
                let rw = room.width()
                if rw > 0.0 { Some(rw) } else { None }
              }))
              hs.pick(
                fn() { snippet_idx.get() * 2 + (if is_compact() { 1 } else { 0 }) },
                fn(list_slot, key) {
                  let compact = key % 2 == 1
                  let idx = key / 2
                  let mono_look = view::WordsLook::of(
                    if compact { 10.5 } else { 12.0 },
                    line=if compact { 16.5 } else { 18.5 },
                    wrap=false,
                  )
                  let row_h = if compact { 17.0 } else { 19.0 }
                  let ops = textdiff::diff_lines(code_diff_before(idx, compact=compact), code_diff_after(idx, compact=compact))
                  let _ = list_slot.gap(view::Live::Is(2.0))
                  for i = 0; i < ops.length(); i = i + 1 {
                    let op = ops[i]
                    let (prefix, line_txt, row_bg, fg_col) = match op {
                      textdiff::DiffOp::Insert(s) => ("+ ", s, 0x16A34A2EL, 0x86EFACFFL)
                      textdiff::DiffOp::Delete(s) => ("- ", s, 0xDC262633L, 0xFCA5A5FFL)
                      textdiff::DiffOp::Equal(s) => ("  ", s, 0x00000000L, 0xCBD5E1FFL)
                    }
                    let _ = list_slot.box(fn(row_v) {
                      let _ = row_v
                      .height(view::Live::Is(Some(row_h)))
                      .padding(view::Live::Is((8.0, 0.0, 8.0, 0.0)))
                      .radius(view::Live::Is(4.0))
                      .ground(view::Live::Is(row_bg))
                      .words_runs(
                        view::Live::Is([
                          text::Run::{ ..text::plain("\{prefix}\{line_txt}"), mono: true, color: fg_col },
                        ]),
                        ink=fg_col,
                        look=mono_look,
                      )
                    })
                  }
                },
                at_once=true,
              )
            },
            slop=ui::touch_slop(),
            bar=ui::tree_scroll_bar(),
          )
        })
      })
    })
  })
}
