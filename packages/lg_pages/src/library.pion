/// Initial category for `library_page` (0 = Optics hero by default; configurable via `?cat=` or tests).
let lib_initial_cat : signals::Signal[Int] = signals::signal(0)

/// Set the initial category (`0..6`) for subsequent `library_page` mounts.
pub fn set_library_initial_cat(cat : Int) -> Unit {
  let clamped = if cat < 0 || cat > 6 { 0 } else { cat }
  lib_initial_cat.set(clamped)
}

/// Parse URL `?cat=` parameter (`optics|controls|inputs|nav|overlays|physics|code`) into category index `0..6`.
pub fn parse_library_cat(raw : String) -> Int {
  if raw == "" {
    return 0
  }
  if str_contains_ci(raw, "code") || str_contains_ci(raw, "ide") {
    6
  } else if str_contains_ci(raw, "phys") {
    5
  } else if str_contains_ci(raw, "over") {
    4
  } else if str_contains_ci(raw, "nav") {
    3
  } else if str_contains_ci(raw, "input") {
    2
  } else if str_contains_ci(raw, "ctrl") || str_contains_ci(raw, "control") {
    1
  } else {
    0
  }
}

/// Accessible deep Invar Vermilion & Cobalt with >= 4.5:1 contrast against white text even through translucent glass.
let lib_vermilion : Int64 = 0xA62908FFL

let lib_cobalt : Int64 = 0x004EA8FFL

fn ascii_lower_cu(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

fn str_contains_ci(hay : String, needle : String) -> Bool {
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  let hlen = hay.length()
  if nlen > hlen {
    return false
  }
  let limit = hlen - nlen
  for i = 0; i <= limit; i = i + 1 {
    let mut ok = true
    for j = 0; j < nlen; j = j + 1 {
      if ascii_lower_cu(hay[i + j]) != ascii_lower_cu(needle[j]) {
        ok = false
        break
      }
    }
    if ok {
      return true
    }
  }
  false
}

/// Subtle uppercase section header with a trailing hairline rule (zero glass-on-glass).
fn lib_section_head(parent : view::View, title : String, detail : String) -> Unit {
  let _ = parent.box(fn(hdr) {
    let _ = hdr.gap(view::Live::Is(6.0))
    let _ = hdr.box(fn(row) {
      let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(4.0))).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
      let _ = row.box(fn(l) {
        let _ = l
        .words(view::Live::Is(title), look=words_track(11.0, 600, 0.9))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
      })
      if detail != "" {
        row.show(
          fn() { !(parent.window_w() > 0.0 && parent.window_w() < 560.0) },
          fn(r) {
            let _ = r
            .words(view::Live::Is(detail), look=lg::words_at(11.5, weight=500, wrap=true))
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.70) }))
          },
          at_once=true,
        )
      }
    })
    let _ = hdr.box(fn(line) {
      let _ = line.height(view::Live::Is(Some(1.0))).ground(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.12) }))
    })
  })
}

/// Small caption label above an inline control specimen.
fn lib_caption(parent : view::View, text : String) -> Unit {
  let _ = parent.box(fn(w) {
    let _ = w
    .words(view::Live::Is(text), look=lg::words_at(12.0, weight=500))
    .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.74) }))
  })
}

/// Detached circular Liquid Glass Search/Catalog orb (`50×50`, `r=25`, matching `lg::tabs_h`) paired beside the
/// 4-tab main dock capsule on compact mobile viewports (Apple iOS 26 split-island bottom dock pattern).
fn lib_dock_catalog_orb(parent : view::View, is_open : () -> Bool, on_open : () -> Unit) -> Unit {
  let _ = headless::button(parent, fn() { "Search & Catalog" }, fn(_) { on_open() }, fn(v, btn) {
    let press_way = motion::NodeWay::new(0.0)
    v.reacts(at_start=false, fn() { btn.pressed() }, fn(p) {
      press_way.go(v, if p { 1.0 } else { 0.0 }, motion::backdrop_press_spring)
    })
    let _ = v
    .width(view::Live::Is(Some(50.0)))
    .height(view::Live::Is(Some(50.0)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(25.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .shadow(view::Live::Is(lg::shadow_default))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(lg::liquid_tab_bar_glass()) }))
    .scale(
      view::Live::By(fn() {
        if ui::reduced_motion() {
          1.0
        } else {
          lg::lerp(1.0, 0.97, lg::clamp(press_way.shown(v), 0.0, 1.0))
        }
      }),
      about=view::Pivot::At(0.5, 0.5),
    )
    let _ = v.box(fn(ov) {
      let _ = ov
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .radius(view::Live::Is(25.0))
      .ground(view::Live::By(lg::liquid_press_ink))
      .alpha(view::Live::By(fn() { lg::clamp(press_way.shown(ov), 0.0, 1.0) }))
    })
    let _ = v.box(fn(ic) {
      let _ = ic
      .points(view::Live::Is(false))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      icon_search(ic, 20.0, fn() { if is_open() { lg::colors().accent } else { lg::colors().content } })
    })
    v.show(fn() { btn.focus_shown() }, fn(ring) {
      let _ = ring
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
      .radius(view::Live::Is(28.0))
      .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
    })
  })
}

/// Floating Liquid Glass circular search/catalog button (36×36, r=18) for tablet portrait viewports in the top NavBar.
fn lib_nav_catalog_button(parent : view::View, on_open : () -> Unit) -> Unit {
  let _ = headless::button(parent, fn() { "Search & Catalog" }, fn(_) { on_open() }, fn(v, btn) {
    let _ = v
    .width(view::Live::Is(Some(36.0)))
    .height(view::Live::Is(Some(36.0)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(18.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .shadow(view::Live::Is(lg::shadow_default))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() {
      let dark = lg::is_dark()
      Some(
        paint::Glass::liquid(
          blur=2.1,
          tint=if dark { 0x20202067L } else { 0xFDFCFD67L },
          solid=if dark { 0x1E1F24FFL } else { 0xFAFAFAFFL },
          saturation=1.0,
          rim=0.6,
          bezel=14.0,
          refraction=18.0,
          chroma=0.0,
          merge=0.0,
          adaptive=false,
        ),
      )
    }))
    icon_search(v, 16.0, fn() { lg::colors().content })
    v.show(fn() { btn.focus_shown() }, fn(ring) {
      let _ = ring
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
      .radius(view::Live::Is(21.0))
      .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
    })
  })
}

/// Floating Liquid Glass circular trigger (36×36, r=18) for `lg::liquid_menu_node` inside the
/// transparent floating-island `lg::liquid_nav_bar_node` (single glass layer, zero glass-on-glass).
fn lib_nav_menu_trigger(v : view::View, d : headless::Disclosure) -> Unit {
  let _ = v
  .width(view::Live::Is(Some(36.0)))
  .height(view::Live::Is(Some(36.0)))
  .shrink(view::Live::Is(0.0))
  .radius(view::Live::Is(18.0))
  .lines_up(view::Live::Is(Some(view::Along::Middle)))
  .lies_along(view::Live::Is(view::Lies::Middle))
  .shadow_outside(view::Live::Is(true))
  .shadow(view::Live::Is(lg::shadow_default))
  .glass(view::Live::By(fn() {
    let dark = lg::is_dark()
    Some(
      paint::Glass::liquid(
        blur=2.1,
        tint=if dark { 0x20202067L } else { 0xFDFCFD67L },
        solid=if dark { 0x1E1F24FFL } else { 0xFAFAFAFFL },
        saturation=1.0,
        rim=0.6,
        bezel=14.0,
        refraction=18.0,
        chroma=0.0,
        merge=0.0,
        adaptive=false,
      ),
    )
  }))
  icon_sliders(v, 16.0, fn() { lg::colors().content })
  v.show(fn() { d.focus_shown() }, fn(ring) {
    let _ = ring
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
    .radius(view::Live::Is(21.0))
    .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
  })
}

/// Capsule trigger look for `lg::liquid_menu_node` and `lg::liquid_popover_node` on the exhibition canvas.
fn lib_glass_trigger(
  label : String,
  tint~ : Int64 = lg::clear,
  width? : Double,
) -> (view::View, headless::Disclosure) -> Unit {
  fn(v : view::View, d : headless::Disclosure) {
    let has_tint = tint != lg::clear
    let _ = v
    .row(view::Live::Is(true))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .height(view::Live::Is(Some(32.0)))
    .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
    .gap(view::Live::Is(6.0))
    .radius(view::Live::Is(16.0))
    .shadow_outside(view::Live::Is(true))
    .shadow(view::Live::Is(lg::shadow_default))
    .glass(view::Live::By(fn() { Some(lg::liquid_control_glass(tint=tint)) }))
    match width {
      Some(w) => {
        let _ = v.width(view::Live::Is(Some(w)))
      }
      None => ()
    }
    let _ = v.box(fn(w) {
      let _ = w
      .words(view::Live::Is(label), look=lg::words_at(15.0, weight=lg::weight_medium))
      .ink(view::Live::By(fn() { if has_tint { lg::white } else { lg::colors().content } }))
    })
    v.show(fn() { d.focus_shown() }, fn(ring) {
      let _ = ring
      .over(view::Live::Is(true))
      .points(view::Live::Is(false))
      .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
      .radius(view::Live::Is(27.0))
      .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
    })
  }
}

/// Section 1 — `Controls` (7 components): Button, IconButton, ButtonGroup, Segmented, Toggle, Slider, Stepper.
fn lib_controls_section(
  parent : view::View,
  is_phone : () -> Bool,
  seg_idx : signals::Signal[Int],
  icon_active : signals::Signal[Bool],
  group_active : signals::Signal[Int],
  toggle_a : signals::Signal[Bool],
  toggle_b : signals::Signal[Bool],
  bezel_val : signals::Signal[Double],
  step_val : signals::Signal[Int],
  last_evt : signals::Signal[String],
) -> Unit {
  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::Is(20.0))
    // 1. Buttons & Icon Buttons
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "BUTTONS & ICON ACTIONS", "liquid_button · liquid_icon_button · liquid_button_group · liquid_bar_pill_group")
      let _ = sec.box(fn(btn_row) {
        let _ = btn_row
        .row(view::Live::Is(true))
        .wraps(view::Live::By(fn() { if is_phone() { Some(8.0) } else { Some(10.0) } }))
        .gap(view::Live::By(fn() { if is_phone() { 8.0 } else { 10.0 } }))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_button_node(btn_row, fn() { "Transparent" }, fn() { last_evt.set("Transparent button") })
        let _ = lg::liquid_button_node(
          btn_row,
          fn() { "Surface" },
          fn() { last_evt.set("Surface button") },
          surface=0xFFFFFF4DL,
        )
        let _ = lg::liquid_button_node(
          btn_row,
          fn() { "Publish" },
          fn() { last_evt.set("Publish tinted") },
          tint=lib_vermilion,
        )
        let _ = lg::liquid_button_node(
          btn_row,
          fn() { "Deploy" },
          fn() { last_evt.set("Deploy tinted") },
          tint=lib_cobalt,
        )
      })
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(14.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_icon_button_node(
          row,
          fn() { "Small Prism" },
          fn(ic, ink) { icon_prism(ic, 14.0, ink) },
          fn() { last_evt.set("Small icon") },
          size=lg::LiquidButtonSize::Small,
        )
        let _ = lg::liquid_icon_button_node(
          row,
          fn() { "Toggle Boost" },
          fn(ic, ink) { icon_bolt(ic, 16.0, ink) },
          fn() {
            let next = !icon_active.untracked()
            icon_active.set(next)
            last_evt.set(if next { "Boost active" } else { "Boost idle" })
          },
          size=lg::LiquidButtonSize::Regular,
          active=fn() { icon_active.get() },
          tint=lib_vermilion,
        )
        let _ = lg::liquid_icon_button_node(
          row,
          fn() { "Large Spark" },
          fn(ic, ink) { icon_spark(ic, 18.0, ink) },
          fn() { last_evt.set("Large icon") },
          size=lg::LiquidButtonSize::Large,
        )
        let _ = lg::liquid_button_group_node(
          row,
          fn() {
            [
              lg::LiquidGroupAction::new(
                label=fn() { "Group Prism" },
                icon=fn(ic, ink) { icon_prism(ic, 14.0, ink) },
                press=fn() {
                  group_active.set(0)
                  last_evt.set("Tool: Prism")
                },
                active=fn() { group_active.get() == 0 },
              ),
              lg::LiquidGroupAction::new(
                label=fn() { "Group Grid" },
                icon=fn(ic, ink) { icon_grid(ic, 14.0, ink) },
                press=fn() {
                  group_active.set(1)
                  last_evt.set("Tool: Grid")
                },
                active=fn() { group_active.get() == 1 },
              ),
              lg::LiquidGroupAction::new(
                label=fn() { "Group Layers" },
                icon=fn(ic, ink) { icon_layers(ic, 14.0, ink) },
                press=fn() {
                  group_active.set(2)
                  last_evt.set("Tool: Layers")
                },
                active=fn() { group_active.get() == 2 },
              ),
            ]
          },
          size=lg::LiquidButtonSize::Regular,
        )
        let _ = lg::liquid_bar_pill_group_node(
          row,
          fn(pill) {
            let _ = lg::liquid_button_node(
              pill,
              fn() { "Share" },
              fn() { last_evt.set("Bar Pill: Share") },
              flat=true,
              ghost=true,
              pad_x=12.0,
            )
            let _ = lg::liquid_button_node(
              pill,
              fn() { "Export" },
              fn() { last_evt.set("Bar Pill: Export") },
              flat=true,
              ghost=true,
              pad_x=12.0,
            )
          },
          label=fn() { "Bar Pill Actions" },
        )
      })
    })

    // 2. Segmented Control & Stepper
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "SEGMENTED LENS & STEPPER", "liquid_segmented · liquid_stepper")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(20.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = row.box(fn(seg_col) {
          let _ = seg_col.gap(view::Live::Is(6.0))
          lib_caption(seg_col, "Drag refractive lens across segments")
          let _ = lg::liquid_segmented_node(
            seg_col,
            fn() { ["Glass", "Clear", "Tinted"] },
            fn() { seg_idx.get() },
            fn(i) {
              seg_idx.set(i)
              last_evt.set("Segment #\{i + 1}")
            },
            width=220.0,
          )
        })
        let _ = row.box(fn(st_col) {
          let _ = st_col.gap(view::Live::Is(6.0))
          lib_caption(st_col, "Blur Radius Stepper")
          let _ = lg::liquid_stepper_node(
            st_col,
            fn() { step_val.get() },
            fn(v) {
              step_val.set(v)
              last_evt.set("Blur \{v} pt")
            },
            min=0,
            max=24,
            step=2,
            label=fn() { "Blur Radius" },
            format=fn(v) { "\{v} pt" },
          )
        })
      })
    })

    // 3. Toggles & Slider
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "TOGGLES & CONTINUOUS SLIDER", "liquid_toggle · liquid_slider")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(24.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = row.box(fn(t1) {
          let _ = t1.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = lg::liquid_toggle_node(t1, fn() { toggle_a.get() }, fn(v) { toggle_a.set(v) }, fn() { "Refraction" })
          let _ = t1.box(fn(w) {
            let _ = w.words(view::Live::Is("Refraction"), look=lg::words_at(14.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
        let _ = row.box(fn(t2) {
          let _ = t2.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = lg::liquid_toggle_node(t2, fn() { toggle_b.get() }, fn(v) { toggle_b.set(v) }, fn() { "Specular Glint" })
          let _ = t2.box(fn(w) {
            let _ = w.words(view::Live::Is("Specular Glint"), look=lg::words_at(14.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
        let _ = row.box(fn(sl) {
          let _ = sl.grow(view::Live::Is(1.0)).min_width(view::Live::Is(Some(240.0))).max_width(view::Live::Is(Some(360.0)), within=true)
          param_slider(
            sl,
            "Bezel Depth",
            fn() { "\{bezel_val.get().round().to_int()} pt" },
            fn() { bezel_val.get() },
            fn(v) { bezel_val.set(v) },
            4.0,
            40.0,
          )
        })
      })
    })

    // Live interaction readout
    let _ = col.box(fn(stat) {
      let _ = stat.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = lg::liquid_badge_node(stat, fn() { "Last action" }, tone=lg::LiquidTone::Neutral)
      let _ = stat.box(fn(w) {
        let _ = w
        .words(view::Live::By(fn() { last_evt.get() }), look=lg::words_at(13.0, weight=500))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
      })
    })
  })
}

/// Section 2 — `Inputs` (7 components): TextField, SearchBar, Checkbox, RadioGroup, Chip, Badge, CountBadge.
fn lib_inputs_section(
  parent : view::View,
  is_phone : () -> Bool,
  window_w : () -> Double,
  name_field : ui::Field,
  err_field : ui::Field,
  demo_search : ui::Field,
  morph_search_field : ui::Field,
  morph_search_open : signals::Signal[Bool],
  cb_a : signals::Signal[Bool],
  cb_b : signals::Signal[Bool],
  cb_mixed : signals::Signal[Bool],
  radio_idx : signals::Signal[Int],
  chip_metal : signals::Signal[Bool],
  chip_vulkan : signals::Signal[Bool],
  chip_webgl : signals::Signal[Bool],
  chip_beta_kept : signals::Signal[Bool],
  badge_count : signals::Signal[Int],
) -> Unit {
  let morph_w = fn() -> Double {
    let w = window_w()
    if w <= 0.0 || w >= 560.0 {
      352.0
    } else {
      lg::clamp((w - 48.0).floor(), 240.0, 340.0)
    }
  }
  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::Is(20.0))
    // 1. TextField, SearchBar & iOS 26 Search Morph
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "TEXT FIELDS & SEARCH BAR", "liquid_text_field · liquid_search_bar · liquid_search_morph")
      let _ = sec.box(fn(row) {
        let _ = row
        .row(view::Live::By(fn() { !is_phone() }))
        .wraps(view::Live::By(fn() { if is_phone() { None } else { Some(12.0) } }))
        .gap(view::Live::By(fn() { if is_phone() { 12.0 } else { 16.0 } }))
        .lines_up(view::Live::By(fn() { if is_phone() { None } else { Some(view::Along::Start) } }))
        let _ = row.box(fn(f1) {
          let _ = f1.width(view::Live::By(fn() { if is_phone() { None } else { Some(260.0) } }))
          let _ = lg::liquid_text_field_node(
            f1,
            name_field,
            placeholder="Glass shader name...",
            label=fn() { "Preset Name" },
            clearable=true,
            lead=fn(ic, ink) { icon_prism(ic, 16.0, ink) },
          )
        })
        let _ = row.box(fn(f2) {
          let _ = f2.width(view::Live::By(fn() { if is_phone() { None } else { Some(240.0) } }))
          let _ = lg::liquid_text_field_node(
            f2,
            err_field,
            placeholder="e.g. 22.0",
            label=fn() { "Bezel Radius" },
            error=fn() { "Value must be >= 4 pt" },
            invalid=fn() { true },
          )
        })
        let _ = row.box(fn(f3) {
          let _ = f3
          .width(view::Live::By(fn() { if is_phone() { None } else { Some(240.0) } }))
          .padding(view::Live::By(fn() { if is_phone() { (0.0, 0.0, 0.0, 0.0) } else { (0.0, 22.0, 0.0, 0.0) } }))
          let _ = lg::liquid_search_bar_node(
            f3,
            demo_search,
            placeholder="Search tokens...",
            label=fn() { "Demo Search" },
          )
        })
      })
      let _ = sec.box(fn(morph_col) {
        let _ = morph_col.gap(view::Live::Is(8.0))
        lib_caption(morph_col, "Search Morph · tap orb to expand")
        morph_col.pick(morph_w, fn(slot, mw) {
          let _ = lg::liquid_search_morph_node(
            slot,
            morph_search_field,
            fn() { morph_search_open.get() },
            fn(v) { morph_search_open.set(v) },
            width=mw,
            placeholder="Search Liquid Glass...",
            label=fn() { "Morph Search" },
            cancel_label=fn() { "Cancel Morph Search" },
          )
        }, at_once=true)
      })
    })

    // 2. Checkboxes & RadioGroup
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "CHECKBOXES & RADIO GROUP", "liquid_checkbox · liquid_radio_group")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(36.0)).lines_up(view::Live::Is(Some(view::Along::Start)))
        let _ = row.box(fn(cbs) {
          let _ = cbs.gap(view::Live::Is(10.0))
          let _ = lg::liquid_checkbox_node(cbs, fn() { cb_a.get() }, fn(v) { cb_a.set(v) }, fn() { "Backdrop refraction" })
          let _ = lg::liquid_checkbox_node(cbs, fn() { cb_b.get() }, fn(v) { cb_b.set(v) }, fn() { "Chromatic dispersion" })
          let _ = lg::liquid_checkbox_node(
            cbs,
            fn() { false },
            fn(_) { cb_mixed.set(!cb_mixed.untracked()) },
            fn() { "Mixed layer overrides" },
            mixed=fn() { cb_mixed.get() },
          )
        })
        let _ = row.box(fn(rgs) {
          let _ = rgs.gap(view::Live::Is(8.0))
          lib_caption(rgs, "Optical Transfer Profile")
          let _ = lg::liquid_radio_group_node(
            rgs,
            fn() { ["iOS 27 Light", "iOS 27 Dark", "Clear Adaptive"] },
            fn() { radio_idx.get() },
            fn(i) { radio_idx.set(i) },
          )
        })
      })
    })

    // 3. Chips, Badges & CountBadge
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "CHIPS, BADGES & COUNTERS", "liquid_chip · liquid_badge · liquid_count_badge")
      let _ = sec.box(fn(chips) {
        let _ = chips.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_chip_node(
          chips,
          fn() { "Metal" },
          fn() { chip_metal.set(!chip_metal.untracked()) },
          selected=fn() { chip_metal.get() },
          lead=fn(ic, ink) { icon_bolt(ic, 14.0, ink) },
          tint=lib_cobalt,
        )
        let _ = lg::liquid_chip_node(
          chips,
          fn() { "Vulkan" },
          fn() { chip_vulkan.set(!chip_vulkan.untracked()) },
          selected=fn() { chip_vulkan.get() },
          tint=lib_cobalt,
        )
        let _ = lg::liquid_chip_node(
          chips,
          fn() { "WebGL 2" },
          fn() { chip_webgl.set(!chip_webgl.untracked()) },
          selected=fn() { chip_webgl.get() },
          tint=lib_cobalt,
        )
        chips.show(fn() { chip_beta_kept.get() }, fn(slot) {
          let _ = lg::liquid_chip_node(
            slot,
            fn() { "Removable Tag" },
            fn() { },
            toggleable=false,
            on_remove=fn() { chip_beta_kept.set(false) },
            remove_label=fn() { "Remove tag" },
          )
        })
      })
      let _ = sec.box(fn(badges) {
        let _ = badges.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_badge_node(badges, fn() { "Neutral" }, tone=lg::LiquidTone::Neutral)
        let _ = lg::liquid_badge_node(badges, fn() { "Accent" }, tone=lg::LiquidTone::Accent, dot=true)
        let _ = lg::liquid_badge_node(badges, fn() { "Passing" }, tone=lg::LiquidTone::Success, dot=true)
        let _ = lg::liquid_badge_node(badges, fn() { "Warning" }, tone=lg::LiquidTone::Warning)
        let _ = lg::liquid_badge_node(badges, fn() { "Error" }, tone=lg::LiquidTone::Danger)
        let _ = badges.box(fn(cnt_row) {
          let _ = cnt_row.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((10.0, 0.0, 0.0, 0.0)))
          let _ = lg::liquid_stepper_node(
            cnt_row,
            fn() { badge_count.get() },
            fn(v) { badge_count.set(v) },
            min=0,
            max=120,
            step=10,
            label=fn() { "Badge Counter" },
            show_value=false,
          )
          let _ = lg::liquid_count_badge_node(cnt_row, fn() { badge_count.get() }, tone=lg::LiquidTone::Danger)
          let _ = cnt_row.box(fn(w) {
            let _ = w
            .words(
              view::Live::By(fn() {
                let c = badge_count.get()
                if c == 0 { "0 (auto-hidden)" } else { "count: \{c}" }
              }),
              look=lg::words_at(12.0, weight=500),
            )
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.68) }))
          })
        })
      })
    })
  })
}

/// Section 3 — `Navigation` (6 components): NavBar, Toolbar, List, Disclosure, Card + ControlTile, AdaptiveSurface.
fn lib_navigation_section(
  parent : view::View,
  is_phone : () -> Bool,
  is_nav_stack : () -> Bool,
  window_w : () -> Double,
  grid_on : signals::Signal[Bool],
  boost : signals::Signal[Bool],
  list_active : signals::Signal[Int],
  disc_open : signals::Signal[Bool],
  live_lum : signals::Signal[Double],
  ctab_idx : signals::Signal[Int],
  ctab_min : signals::Signal[Bool],
  last_nav : signals::Signal[String],
) -> Unit {
  let ctab_w = fn() -> Double {
    let w = window_w()
    if w <= 0.0 || w >= 560.0 {
      300.0
    } else {
      lg::clamp((w - 122.0).floor(), 180.0, 280.0)
    }
  }
  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::Is(18.0))
    // 1. Embedded NavBar, Toolbar & iOS 26 Collapsible Tabs
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "NAVIGATION BAR & TOOLBAR", "liquid_nav_bar · liquid_toolbar · liquid_collapsible_tabs")
      let _ = lg::liquid_nav_bar_node(
        sec,
        fn() { "Optical Inspector" },
        subtitle=fn() { if is_phone() { "Metal · WebGL" } else { "Metal · WebGL 2" } },
        compact=is_phone,
        leading=fn(s) {
          let _ = lg::liquid_icon_button_node(
            s,
            fn() { "Inspector Prism" },
            fn(ic, ink) { icon_prism(ic, 16.0, ink) },
            fn() { last_nav.set("Nav island: Prism") },
            size=lg::LiquidButtonSize::Small,
          )
          s.show(fn() { !is_phone() }, fn(slot) {
            let _ = lg::liquid_badge_node(slot, fn() { "Live" }, tone=lg::LiquidTone::Success, dot=true)
          }, at_once=true)
        },
        trailing=fn(s) {
          s.show(fn() { !is_phone() }, fn(slot) {
            let _ = lg::liquid_badge_node(slot, fn() { "60 fps" }, tone=lg::LiquidTone::Neutral)
          }, at_once=true)
          let _ = lg::liquid_icon_button_node(
            s,
            fn() { "Inspector Refresh" },
            fn(ic, ink) { icon_refresh(ic, 16.0, ink) },
            fn() { last_nav.set("Nav island: Refresh") },
            size=lg::LiquidButtonSize::Small,
          )
        },
      )
      let _ = sec.box(fn(tb_row) {
        let _ = tb_row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(14.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_toolbar_node(tb_row, fn(tb) {
          let _ = tb.box(fn(w) {
            let _ = w.words(view::Live::Is("Quick Tools"), look=lg::words_at(13.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
          let _ = lg::liquid_badge_node(tb, fn() { "3 Active" }, tone=lg::LiquidTone::Accent)
        })
        let _ = tb_row.box(fn(w) {
          let _ = w
          .words(view::Live::By(fn() { last_nav.get() }), look=lg::words_at(12.5, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.72) }))
        })
      })
      let _ = sec.box(fn(ct_col) {
        let _ = ct_col.gap(view::Live::Is(10.0))
        let _ = ct_col.box(fn(ct_hdr) {
          let _ = ct_hdr
          .row(view::Live::Is(true))
          .width(view::Live::By(fn() { Some(ctab_w() + 56.0) }))
          .lies_along(view::Live::Is(view::Lies::Apart))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
          let _ = ct_hdr.box(fn(w) {
            let _ = w
            .words(
              view::Live::By(fn() { if is_phone() { "Collapsible Tabs" } else { "Collapsible Tabs · drag or minimize" } }),
              look=lg::words_at(12.0, weight=500),
            )
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.74) }))
          })
          let _ = lg::liquid_button_node(
            ct_hdr,
            fn() { if ctab_min.get() { "Expand" } else { "Minimize" } },
            fn() { ctab_min.set(!ctab_min.untracked()) },
            flat=true,
            height=26.0,
            pad_x=10.0,
          )
        })
        ct_col.pick(ctab_w, fn(slot, ew) {
          let _ = lg::liquid_collapsible_tabs_node(
            slot,
            ["Home", "Browse", "Radio"],
            fn() { ctab_idx.get() },
            fn(i) {
              ctab_idx.set(i)
              let name = match i {
                0 => "Home"
                1 => "Browse"
                _ => "Radio"
              }
              last_nav.set("Collapsible tab: \{name}")
            },
            fn() { ctab_min.get() },
            fn() {
              ctab_min.set(false)
              last_nav.set("Collapsible tabs expanded")
            },
            fn() { last_nav.set("Collapsible tab: Search") },
            action_label=fn() { "Collapsible Search" },
            faces=[
              studio_tab_face("Home", icon_prism),
              studio_tab_face("Browse", icon_grid),
              studio_tab_face("Radio", icon_spark),
            ],
            compact_icons=[
              fn(ic, ink) { icon_prism(ic, 20.0, ink) },
              fn(ic, ink) { icon_grid(ic, 20.0, ink) },
              fn(ic, ink) { icon_spark(ic, 20.0, ink) },
            ],
            label="Collapsible Tabs",
            expanded_width=ew,
          )
        }, at_once=true)
      })
    })

    // 2. Two-column List + Disclosure on left, Control Center + Adaptive Surface on right
    let _ = col.box(fn(split) {
      let _ = split
      .row(view::Live::By(fn() { !is_nav_stack() }))
      .gap(view::Live::Is(20.0))
      .lines_up(view::Live::By(fn() { if is_nav_stack() { None } else { Some(view::Along::Start) } }))
      let _ = split.box(fn(left) {
        let _ = left
        .grow(view::Live::By(fn() { if is_nav_stack() { 0.0 } else { 1.0 } }))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(14.0))
        lib_section_head(left, "LIST & DISCLOSURE", "liquid_list · liquid_disclosure")
        let _ = lg::liquid_list_node(
          left,
          fn() {
            let cur = list_active.get()
            [
              lg::LiquidListRow::new(
                title="GPU Backend",
                subtitle="Single retained render pass",
                value="Metal / WebGL 2",
                icon=fn(ic, ink) { icon_bolt(ic, 16.0, ink) },
                chevron=true,
                active=cur == 0,
                on_press=fn() {
                  list_active.set(0)
                  last_nav.set("Selected: GPU Backend")
                },
              ),
              lg::LiquidListRow::new(
                title="Concentric Audit",
                subtitle="Strict corners & contrast",
                value="0 faults",
                icon=fn(ic, ink) { icon_grid(ic, 16.0, ink) },
                chevron=true,
                active=cur == 1,
                on_press=fn() {
                  list_active.set(1)
                  last_nav.set("Selected: Concentric Audit")
                },
              ),
              lg::LiquidListRow::new(
                title="Closed-Form Springs",
                value="7–120 fps",
                icon=fn(ic, ink) { icon_spark(ic, 16.0, ink) },
                chevron=true,
                active=cur == 2,
                on_press=fn() {
                  list_active.set(2)
                  last_nav.set("Selected: Closed-Form Springs")
                },
              ),
            ]
          },
          header=fn() { "ENGINE CAPABILITIES" },
        )
        let _ = lg::liquid_disclosure_node(
          left,
          fn() { "Pion API Snippet" },
          fn() { disc_open.get() },
          fn(v) { disc_open.set(v) },
          fn(c) {
            let _ = c.box(fn(w) {
              let _ = w
              .words(
                view::Live::Is("lg::liquid_nav_bar_node(root, fn() { \"Studio\" })\nlg::liquid_list_node(root, fn() { rows })"),
                look=lg::words_at(12.0, weight=500, wrap=true),
              )
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
          },
          subtitle=fn() { "Expand to inspect live usage" },
        )
      })

      let _ = split.box(fn(right) {
        let _ = right
        .width(view::Live::By(fn() { if is_nav_stack() { None } else { Some(320.0) } }))
        .shrink(view::Live::By(fn() { if is_nav_stack() { 1.0 } else { 0.0 } }))
        .gap(view::Live::Is(14.0))
        lib_section_head(right, "DECK & ADAPTIVE", "card · tiles · adaptive")
        let _ = right.box(fn(deck_row) {
          let _ = deck_row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(14.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let wide = lg::tile_size * 2.0 + lg::tile_gap
          let _ = lg::liquid_card_node(
            deck_row,
            wide,
            wide,
            fn() { "Library deck" },
            radius=lg::tile_inner / 2.0 + lg::tile_gap,
            press=fn() { },
            content=fn(c) {
              let _ = c.padding(view::Live::Is((lg::tile_gap, lg::tile_gap, lg::tile_gap, lg::tile_gap))).lies_along(view::Live::Is(view::Lies::Between))
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { lg::is_dark() },
                  fn(v) { lg::set_dark(Some(v)) },
                  fn() { "Deck Theme" },
                  icon=fn(box, _ink) {
                    let ink = fn() { if lg::is_dark() { lg::white } else { 0x1C2430D9L } }
                    box.pick(fn() { lg::is_dark() }, fn(inner, d) {
                      if d { icon_moon(inner, 24.0, ink) } else { icon_sun(inner, 24.0, ink) }
                    }, at_once=true)
                  },
                )
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { grid_on.get() },
                  fn(v) { grid_on.set(v) },
                  fn() { "Deck Grid" },
                  icon=fn(box, _ink) {
                    icon_grid(box, 24.0, fn() { if grid_on.get() || lg::is_dark() { lg::white } else { 0x1C2430D9L } })
                  },
                )
              })
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { boost.get() },
                  fn(v) { boost.set(v) },
                  fn() { "Deck Glow" },
                  icon=fn(box, _ink) {
                    icon_bolt(box, 24.0, fn() { if boost.get() || lg::is_dark() { lg::white } else { 0x1C2430D9L } })
                  },
                )
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { false },
                  fn(_) { last_nav.set("Deck pulse") },
                  fn() { "Deck Pulse" },
                  icon=fn(box, _ink) {
                    icon_play(box, 22.0, fn() { if lg::is_dark() { lg::white } else { 0x1C2430D9L } })
                  },
                )
              })
            },
          )
          right_tile_stack(deck_row, last_nav)
        })
        param_slider(
          right,
          "Backdrop Luminance",
          fn() { fmt_unit(live_lum.get()) },
          fn() { live_lum.get() },
          fn(v) { live_lum.set(v) },
          0.0,
          100.0,
        )
        let _ = right.box(fn(plate) {
          let _ = plate
          .height(view::Live::Is(Some(148.0)))
          .radius(view::Live::Is(24.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .ground(view::Live::By(fn() { lg::lerp_color(0x14151BFFL, 0xF5F3EEFFL, lg::clamp(live_lum.get() / 100.0, 0.0, 1.0)) }))
          plate_stripes(
            plate,
            24.0,
            fn() { lg::lerp_color(0x2A2D38FFL, 0xDDD8CEFFL, lg::clamp(live_lum.get() / 100.0, 0.0, 1.0)) },
            20.0,
            22.0,
          )
          let _ = lg::liquid_adaptive_surface_node(plate, fn() { lg::clamp(live_lum.get() / 100.0, 0.0, 1.0) }, size=116.0)
        })
      })
    })
  })
}

/// Helper for two vertical `liquid_control_tile_node` tiles beside the 2×2 control card.
fn right_tile_stack(parent : view::View, last_nav : signals::Signal[String]) -> Unit {
  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::Is(lg::tile_gap))
    let ink = fn() { if lg::is_dark() { lg::white } else { 0x1C2430E6L } }
    let _ = lg::liquid_control_tile_node(
      col,
      fn() { "Tile Play" },
      fn() { last_nav.set("Tile: Play") },
      icon=fn(box, _ink) { icon_play(box, 24.0, ink) },
    )
    let _ = lg::liquid_control_tile_node(
      col,
      fn() { "Tile Reset" },
      fn() { last_nav.set("Tile: Reset") },
      angle=135.0,
      icon=fn(box, _ink) { icon_refresh(box, 24.0, ink) },
    )
  })
}

/// Section 4 — `Overlays` (10 components): Menu, Select, Popover, Tooltip, Drawer, Sheet, ActionSheet, Dialog,
/// Toast, ProgressBar & ProgressRing. All floating panels mount on `overlay_host` at root Z-order.
fn lib_overlays_section(
  parent : view::View,
  is_phone : () -> Bool,
  overlay_host : view::View,
  demo_menu_open : signals::Signal[Bool],
  demo_menu_pin : signals::Signal[Bool],
  select_idx : signals::Signal[Int],
  popover_open : signals::Signal[Bool],
  drawer_open : signals::Signal[Bool],
  drawer_side : signals::Signal[lg::DrawerSide],
  sheet_open : signals::Signal[Bool],
  action_sheet_open : signals::Signal[Bool],
  dialog_open : signals::Signal[Bool],
  toast_visible : signals::Signal[Bool],
  toast_status_idx : signals::Signal[Int],
  prog_val : signals::Signal[Double],
  prog_indet : signals::Signal[Bool],
  last_ovl : signals::Signal[String],
) -> Unit {
  let _ = parent.box(fn(col) {
    let _ = col.gap(view::Live::By(fn() { if is_phone() { 14.0 } else { 20.0 } }))
    // 1. Anchored overlays: Menu, Select, Popover, Tooltip
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "ANCHORED OVERLAYS", "liquid_menu · liquid_select · liquid_popover · liquid_tooltip")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_menu_node(
          row,
          overlay_host,
          fn() { demo_menu_open.get() },
          fn(v) { demo_menu_open.set(v) },
          fn() { "Open Menu" },
          lib_glass_trigger("Open Menu", width=116.0),
          fn() {
            [
              lg::LiquidMenuEntry::item(
                label="Duplicate Preset",
                shortcut="⌘D",
                icon=fn(ic, ink) { icon_layers(ic, 15.0, ink) },
                on_select=fn() { last_ovl.set("Menu: Duplicate Preset") },
              ),
              lg::LiquidMenuEntry::check(
                label="Pin Inspector",
                shortcut="⌘P",
                checked=fn() { demo_menu_pin.get() },
                on_toggle=fn() {
                  let next = !demo_menu_pin.untracked()
                  demo_menu_pin.set(next)
                  last_ovl.set(if next { "Menu: Pinned" } else { "Menu: Unpinned" })
                },
              ),
              lg::LiquidMenuEntry::separator(),
              lg::LiquidMenuEntry::item(
                label="Reset Shader",
                destructive=true,
                on_select=fn() { last_ovl.set("Menu: Reset Shader") },
              ),
            ]
          },
          menu_label=fn() { "Demo Menu" },
          anchor_size=(96.0, 32.0),
          trigger_face=fn(v) {
            let _ = v.box(fn(w) {
              let _ = w.words(view::Live::Is("Open Menu"), look=lg::words_at(13.0, weight=lg::weight_medium)).ink(view::Live::By(fn() { lg::colors().content }))
            })
          },
        )
        let _ = lg::liquid_select_node(
          row,
          overlay_host,
          fn() {
            [
              lg::LiquidSelectOption::new(label="iOS 27 Regular", detail="Balanced blur & rim"),
              lg::LiquidSelectOption::new(label="iOS 27 Clear", detail="High transparency"),
              lg::LiquidSelectOption::new(label="Obsidian Dark", detail="Deep night tint"),
            ]
          },
          fn() { select_idx.get() },
          fn(i) {
            select_idx.set(i)
            last_ovl.set("Select: #\{i + 1}")
          },
          label=fn() { "Material" },
          width=220.0,
        )
        let _ = lg::liquid_popover_node(
          row,
          overlay_host,
          fn() { popover_open.get() },
          fn(v) { popover_open.set(v) },
          fn() { "Open Popover" },
          lib_glass_trigger("Popover", width=100.0),
          fn() { "Shader Telemetry" },
          fn(c) {
            let _ = c.gap(view::Live::Is(8.0))
            let _ = c.box(fn(w) {
              let _ = w
              .words(view::Live::Is("Optical Pipeline"), look=lg::words_at(14.0, weight=600))
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
            let _ = c.box(fn(w) {
              let _ = w
              .words(
                view::Live::Is("Single-pass SDF bevel refraction with shared backdrop capture."),
                look=lg::words_at(13.0, wrap=true),
              )
              .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
            })
          },
          placement=headless::Placement::BelowStart,
          anchor_size=(84.0, 32.0),
          trigger_face=fn(v) {
            let _ = v.box(fn(w) {
              let _ = w.words(view::Live::Is("Popover"), look=lg::words_at(13.0, weight=lg::weight_medium)).ink(view::Live::By(fn() { lg::colors().content }))
            })
          },
        )
        let _ = lg::liquid_tooltip_node(
          row,
          overlay_host,
          fn() { "Rendered directly on GPU via paint::Glass::liquid" },
          fn(wrap) {
            let _ = lg::liquid_button_node(wrap, fn() { "Hover Tooltip" }, fn() { last_ovl.set("Tooltip trigger tapped") })
          },
        )
      })
    })

    // 2. Modal overlays: Drawer, Sheet (detents), ActionSheet, Dialog
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "MODAL DRAWER, SHEETS & DIALOG", "liquid_drawer · liquid_sheet · liquid_action_sheet · liquid_dialog")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_button_node(
          row,
          fn() { "Open Drawer" },
          fn() {
            drawer_side.set(lg::DrawerSide::Leading)
            drawer_open.set(true)
            last_ovl.set("Drawer: Leading")
          },
          tint=lib_cobalt,
        )
        let _ = lg::liquid_button_node(
          row,
          fn() { "Trailing Drawer" },
          fn() {
            drawer_side.set(lg::DrawerSide::Trailing)
            drawer_open.set(true)
            last_ovl.set("Drawer: Trailing")
          },
        )
        let _ = lg::liquid_button_node(
          row,
          fn() { "Open Sheet" },
          fn() { sheet_open.set(true) },
          tint=lib_vermilion,
        )
        let _ = lg::liquid_button_node(
          row,
          fn() { "Action Sheet" },
          fn() { action_sheet_open.set(true) },
          surface=0xFFFFFF4DL,
        )
        let _ = lg::liquid_button_node(row, fn() { "Open Dialog" }, fn() { dialog_open.set(true) })
        let _ = row.box(fn(w) {
          let _ = w
          .words(view::Live::By(fn() { last_ovl.get() }), look=lg::words_at(12.5, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.72) }))
        })
      })
    })

    // 3. Feedback: Toast + ProgressBar & ProgressRing
    let _ = col.box(fn(sec) {
      let _ = sec.gap(view::Live::Is(12.0))
      lib_section_head(sec, "TOAST & PROGRESS", "liquid_toast · liquid_progress_bar · liquid_progress_ring")
      let _ = sec.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(14.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        row.pick(is_phone, fn(slot, phone) {
          let _ = lg::liquid_segmented_node(
            slot,
            fn() { ["Info", "Success", "Warning", "Error"] },
            fn() { toast_status_idx.get() },
            fn(i) {
              toast_status_idx.set(i)
              toast_visible.set(true)
            },
            width=if phone { 260.0 } else { 320.0 },
            height=30.0,
          )
        }, at_once=true)
        let _ = lg::liquid_button_node(
          row,
          fn() { if toast_visible.get() { "Hide Toast" } else { "Show Toast" } },
          fn() { toast_visible.set(!toast_visible.untracked()) },
        )
      })
      let _ = sec.box(fn(toast_slot) {
        let _ = toast_slot.max_width(view::Live::Is(Some(480.0)))
        toast_slot.pick(fn() { toast_status_idx.get() }, fn(slot, idx) {
          let st = match idx {
            1 => lg::LiquidStatus::Success
            2 => lg::LiquidStatus::Warning
            3 => lg::LiquidStatus::Error
            _ => lg::LiquidStatus::Info
          }
          let title = match idx {
            1 => "Bundle compiled"
            2 => "High refraction"
            3 => "Shader fallback"
            _ => "Liquid Glass synced"
          }
          let sub = match idx {
            1 => "Metal + WebGL ready"
            2 => "Bezel depth > 32 pt"
            3 => "Using solid fallback"
            _ => "35 parts at 60 fps"
          }
          let _ = lg::liquid_toast_node(
            slot,
            fn() { toast_visible.get() },
            fn() { title },
            subtitle=fn() { sub },
            status=st,
            action_label=fn() { "Inspect" },
            on_action=fn() { last_ovl.set("Toast action: \{title}") },
            on_dismiss=fn() { toast_visible.set(false) },
          )
        }, at_once=true)
      })
      let _ = sec.box(fn(prow) {
        let _ = prow.row(view::Live::Is(true)).wraps(view::Live::Is(Some(12.0))).gap(view::Live::Is(20.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = prow.box(fn(pb) {
          let _ = pb.grow(view::Live::Is(1.0)).min_width(view::Live::Is(Some(220.0))).max_width(view::Live::Is(Some(280.0)), within=true).gap(view::Live::Is(10.0))
          let _ = lg::liquid_progress_bar_node(
            pb,
            fn() { if prog_indet.get() { None } else { Some(prog_val.get() / 100.0) } },
            label=fn() { "GPU Pipeline" },
            show_value=true,
          )
          let _ = lg::liquid_slider_node(
            pb,
            fn() { prog_val.get() },
            fn(v) {
              prog_indet.set(false)
              prog_val.set(v)
            },
            fn() { "Progress Value" },
            least=0.0,
            most=100.0,
          )
        })
        let _ = lg::liquid_progress_ring_node(
          prow,
          fn() { if prog_indet.get() { None } else { Some(prog_val.get() / 100.0) } },
          size=44.0,
          stroke=4.0,
          label=fn() { "Pipeline Ring" },
        )
        let _ = prow.box(fn(ind) {
          let _ = ind.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = lg::liquid_toggle_node(ind, fn() { prog_indet.get() }, fn(v) { prog_indet.set(v) }, fn() { "Indeterminate" })
          let _ = ind.box(fn(w) {
            let _ = w.words(view::Live::Is("Indeterminate"), look=lg::words_at(13.5, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
      })
    })
  })
}

/// Section 5 — `Physics` (3 components): Progressive Blur + 1.5× Optical Loupe, and 360° Capillary Merge,
/// switched cleanly via `lg::liquid_segmented_node` so each stage has full breathing room.
fn lib_physics_section(
  parent : view::View,
  is_mobile_shell : () -> Bool,
  phys_mode : signals::Signal[Int],
  merge_ctrl : lg::LiquidMerge,
) -> Unit {
  let phys_scroll = view::Scroll::new()
  let build_bar = fn(target : view::View) {
    let _ = target.box(fn(bar) {
      let _ = bar.row(view::Live::Is(true)).wraps(view::Live::Is(Some(8.0))).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
      let _ = lg::liquid_segmented_node(
        bar,
        fn() { ["Loupe & Blur", "Capillary Merge"] },
        fn() { phys_mode.get() },
        fn(i) { phys_mode.set(i) },
        width=250.0,
        height=30.0,
      )
      let _ = lg::liquid_badge_node(
        bar,
        fn() { if phys_mode.get() == 0 { "1.5× Glyph Loupe" } else { "360° LiquidBond" } },
        tone=lg::LiquidTone::Accent,
        dot=true,
      )
    })
  }
  parent.pick(
    is_mobile_shell,
    fn(wrap, mobile) {
      let _ = wrap.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
      if mobile {
        let sc = wrap.scrolls(
          phys_scroll,
          fn(col) {
            let _ = col.padding(view::Live::Is((16.0, 64.0, 16.0, 108.0))).gap(view::Live::Is(14.0))
            build_bar(col)
            col.pick(fn() { phys_mode.get() }, fn(slot, m) {
              if m == 1 {
                merge_scene(slot, merge_ctrl, embedded_scroll=true)
              } else {
                loupe_scene(slot, embedded_scroll=true)
              }
            }, at_once=true)
          },
          slop=ui::touch_slop(),
          bar=ui::tree_scroll_bar(),
        )
        let _ = sc.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
      } else {
        let _ = wrap.box(fn(col) {
          let _ = col
          .grow(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          .padding(view::Live::Is((20.0, 78.0, 20.0, dock_room)))
          .gap(view::Live::Is(14.0))
          build_bar(col)
          let _ = col.box(fn(stage) {
            let _ = stage.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
            stage.pick(fn() { phys_mode.get() }, fn(slot, m) {
              let _ = slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
              if m == 1 {
                merge_scene(slot, merge_ctrl)
              } else {
                loupe_scene(slot)
              }
            }, at_once=true)
          })
        })
      }
    },
    at_once=true,
  )
}

/// Category icon lookup for sidebar & bottom tabs.
fn lib_cat_icon(id : Int) -> (view::View, Double, () -> Int64) -> Unit {
  match id {
    0 => icon_prism
    1 => icon_sliders
    2 => icon_spark
    3 => icon_grid
    4 => icon_layers
    5 => icon_merge
    _ => icon_terminal
  }
}

/// Dynamic 4th-slot mobile dock face reflecting the active overflow category (`Inputs (2)`, `Nav (3)`, `Physics (5)`, or `Code (6)`).
fn lib_tab_face_dynamic(cat : () -> Int) -> (view::View, () -> Int64) -> Unit {
  fn(f : view::View, ink : () -> Int64) -> Unit {
    let _ = f.box(fn(col) {
      let _ = col.lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(2.0))
      col.show(fn() { cat() == 2 }, fn(ic) { icon_spark(ic, 18.0, ink) }, at_once=true)
      col.show(fn() { cat() == 3 }, fn(ic) { icon_grid(ic, 18.0, ink) }, at_once=true)
      col.show(fn() { cat() == 5 }, fn(ic) { icon_merge(ic, 18.0, ink) }, at_once=true)
      col.show(fn() { cat() == 6 }, fn(ic) { icon_terminal(ic, 18.0, ink) }, at_once=true)
      let _ = col.box(fn(w) {
        let _ = w
        .words(
          view::Live::By(fn() {
            let c = cat()
            if c == 2 {
              "Inputs"
            } else if c == 3 {
              "Nav"
            } else if c == 6 {
              "Code"
            } else {
              "Physics"
            }
          }),
          look=lg::words_at(lg::type_tab, weight=lg::weight_medium),
        )
        .ink(view::Live::By(ink))
      })
    })
  }
}

/// Fullscreen 100% self-hosted `Invar` Pure Pion GPU UI flagship showcase application.
fn library_page(
  root : view::View,
  grid_on : signals::Signal[Bool],
  boost : signals::Signal[Bool],
) -> Unit {
  let init_cat = lib_initial_cat.untracked()
  let active_cat = signals::signal(init_cat)
  let sidebar_open = signals::signal(true)
  let top_menu_open = signals::signal(false)
  let search_field = ui::Field::new()
  let search_q = signals::signal("")

  // Optics state
  let refraction_val = signals::signal(28.0)
  let chroma_val = signals::signal(6.0)
  let blur_val = signals::signal(1.5)
  let light_angle_val = signals::signal(0.0)
  let prism_pos = signals::signal_by((0.0, 0.0), pair_d_eq)

  // Controls state
  let seg_idx = signals::signal(0)
  let icon_active = signals::signal(true)
  let group_active = signals::signal(0)
  let toggle_a = signals::signal(true)
  let toggle_b = signals::signal(false)
  let bezel_val = signals::signal(22.0)
  let step_val = signals::signal(8)
  let last_ctrl = signals::signal("Ready · drag or tap any control")

  // Inputs state
  let name_field = ui::Field::new(text="iOS 27 Prism")
  let err_field = ui::Field::new(text="2")
  let demo_search = ui::Field::new()
  let morph_search_field = ui::Field::new()
  let morph_search_open = signals::signal(false)
  let cb_a = signals::signal(true)
  let cb_b = signals::signal(false)
  let cb_mixed = signals::signal(true)
  let radio_idx = signals::signal(0)
  let chip_metal = signals::signal(true)
  let chip_vulkan = signals::signal(false)
  let chip_webgl = signals::signal(true)
  let chip_beta_kept = signals::signal(true)
  let badge_count = signals::signal(12)

  // Navigation state
  let list_active = signals::signal(0)
  let disc_open = signals::signal(false)
  let live_lum = signals::signal(84.0)
  let ctab_idx = signals::signal(0)
  let ctab_min = signals::signal(false)
  let last_nav = signals::signal("Tap a row or expand disclosure")

  // Overlays state
  let demo_menu_open = signals::signal(false)
  let demo_menu_pin = signals::signal(true)
  let select_idx = signals::signal(0)
  let popover_open = signals::signal(false)
  let drawer_open = signals::signal(false)
  let drawer_side : signals::Signal[lg::DrawerSide] = signals::signal(lg::DrawerSide::Leading)
  let drawer_item = signals::signal(0)
  let sheet_open = signals::signal(false)
  let sheet_expanded = signals::signal(false)
  let action_sheet_open = signals::signal(false)
  let dialog_open = signals::signal(false)
  let toast_visible = signals::signal(true)
  let toast_status_idx = signals::signal(1)
  let prog_val = signals::signal(68.0)
  let prog_indet = signals::signal(false)
  let last_ovl = signals::signal("All overlays mount in root Z-layer")

  // Physics state
  let phys_mode = signals::signal(0)
  let merge_ctrl = lg::LiquidMerge::new(separated=false)

  // Code IDE / Terminal / TextDiff state
  let code_snippet_idx = signals::signal(0)
  let code_editor = code_field::CodeField::new(text=code_snippet_src(0), lang="pion", tab_size=2)
  let code_term = terminal::TerminalModel::new(cols=62, rows=11, palette=terminal::TermPalette::dark())
  code_term_init(code_term)

  let reset_demos = fn() {
    grid_on.set(true)
    boost.set(false)
    refraction_val.set(28.0)
    chroma_val.set(6.0)
    blur_val.set(1.5)
    light_angle_val.set(0.0)
    ui::set_glass_light_angle(0.0)
    prism_pos.set((0.0, 0.0))
    seg_idx.set(0)
    icon_active.set(true)
    group_active.set(0)
    toggle_a.set(true)
    toggle_b.set(false)
    bezel_val.set(22.0)
    step_val.set(8)
    cb_a.set(true)
    cb_b.set(false)
    cb_mixed.set(true)
    radio_idx.set(0)
    chip_metal.set(true)
    chip_vulkan.set(false)
    chip_webgl.set(true)
    chip_beta_kept.set(true)
    badge_count.set(12)
    morph_search_open.set(false)
    morph_search_field.set("")
    list_active.set(0)
    disc_open.set(false)
    live_lum.set(84.0)
    ctab_idx.set(0)
    ctab_min.set(false)
    select_idx.set(0)
    toast_visible.set(true)
    toast_status_idx.set(1)
    prog_val.set(68.0)
    prog_indet.set(false)
    phys_mode.set(0)
    search_q.set("")
    last_ctrl.set("All demos reset")
    last_ovl.set("All demos reset")
  }

  let canvas_scroll = view::Scroll::new()
  let catalog_scroll = view::Scroll::new()
  let catalog_sheet_open = signals::signal(false)
  let mobile_extra_cat = signals::signal(
    if init_cat == 2 || init_cat == 3 || init_cat == 5 || init_cat == 6 {
      init_cat
    } else {
      6
    },
  )
  root.reacts(fn() { active_cat.get() }, fn(cat) {
    if cat == 2 || cat == 3 || cat == 5 || cat == 6 {
      mobile_extra_cat.set(cat)
    }
  }, at_start=false)
  let is_narrow = fn() -> Bool {
    let w = root.window_w()
    w > 0.0 && w < 820.0
  }
  let is_compact_dock = fn() -> Bool {
    let w = root.window_w()
    w > 0.0 && w < 640.0
  }
  let is_phone = fn() -> Bool {
    let w = root.window_w()
    w > 0.0 && w < 560.0
  }
  let is_nav_stack = fn() -> Bool {
    let w = root.window_w()
    w > 0.0 && w < 760.0
  }
  let mobile_selected = fn() -> Int {
    match active_cat.get() {
      0 => 0
      1 => 1
      4 => 2
      _ => 3
    }
  }
  let mobile_select = fn(i : Int) {
    match i {
      0 => active_cat.set(0)
      1 => active_cat.set(1)
      2 => active_cat.set(4)
      _ => active_cat.set(mobile_extra_cat.get())
    }
  }

  let is_mobile_shell = fn() -> Bool {
    let w = root.window_w()
    w > 0.0 && w < 740.0
  }
  let any_modal_open = fn() -> Bool {
    catalog_sheet_open.get() ||
    sheet_open.get() ||
    action_sheet_open.get() ||
    drawer_open.get() ||
    dialog_open.get()
  }
  let canvas_bg = fn() -> Int64 {
    if lg::is_dark() { 0x090A0EFFL } else { 0xF4F1EAFFL }
  }
  let dock_way = motion::NodeWay::new(1.0)
  root.reacts(
    at_start=false,
    any_modal_open,
    fn(open : Bool) -> Unit {
      dock_way.go(root, if open { 0.0 } else { 1.0 }, motion::snappy_damped)
    },
  )

  let shell_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
  let nav_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
  let host_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)

  // 1. Full-viewport main layout shell (zero outer clipping padding so shadows & 0.75pt glass rims breathe freely)
  let _ = root.box(fn(shell) {
    let _ = shell.over(view::Live::Is(true))
    shell_ref.v = Some(shell)
  })

  // 2. Soft progressive-blur scroll edges (above scrolled content, strictly beneath floating top nav & bottom dock)
  let _ = lg::liquid_scroll_edge_node(
    root,
    fn(_) {
      if active_cat.get() == 0 {
        0.0
      } else if is_mobile_shell() {
        62.0
      } else {
        76.0
      }
    },
    fn(_) {
      if active_cat.get() == 0 {
        0.0
      } else if is_mobile_shell() {
        54.0
      } else {
        64.0
      }
    },
    side=lg::ScrollEdgeSide::Top,
    bg=fn() { lg::alpha(canvas_bg(), 0.45) },
    shield=false,
  )
  let _ = lg::liquid_scroll_edge_node(
    root,
    fn(n) {
      let vis = lg::clamp(dock_way.shown(n), 0.0, 1.0)
      if active_cat.get() == 0 || vis <= 0.01 {
        0.0
      } else if is_mobile_shell() {
        82.0 * vis
      } else {
        88.0 * vis
      }
    },
    fn(n) {
      let vis = lg::clamp(dock_way.shown(n), 0.0, 1.0)
      if active_cat.get() == 0 || vis <= 0.01 {
        0.0
      } else if is_mobile_shell() {
        76.0 * vis
      } else {
        82.0 * vis
      }
    },
    side=lg::ScrollEdgeSide::Bottom,
    bg=fn() { lg::alpha(canvas_bg(), 0.30) },
    shield=false,
  )

  // 3. Floating Top Navigation Bar overlay slot (above top scroll edge, never clips content below)
  let _ = root.box(fn(nav_slot) {
    let _ = nav_slot
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .padding(view::Live::By(fn() {
      if is_mobile_shell() {
        (14.0, 8.0, 14.0, 0.0)
      } else {
        (20.0, 14.0, 20.0, 0.0)
      }
    }))
    nav_ref.v = Some(nav_slot)
  })

  // 4. Floating bottom tabs (`lg::liquid_bottom_tabs_node`, fades smoothly to alpha=0 & points=false when any modal opens)
  // - Compact mobile (`w < 640`): iOS 26 split-island dock (spacious 4-tab capsule + 10pt gap + 50×50 Search/Catalog orb)
  // - Wide / desktop (`w >= 640`): full 668pt 7-tab capsule
  let _ = root.box(fn(dock_row) {
    let _ = dock_row
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .lies_along(view::Live::Is(view::Lies::End))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .alpha(view::Live::By(fn() { lg::clamp(dock_way.shown(dock_row), 0.0, 1.0) }))
    .padding(view::Live::By(fn() { (0.0, 0.0, 0.0, if is_compact_dock() { 14.0 } else { dock_gap }) }))
    dock_row.show(is_compact_dock, fn(split_dock) {
      let _ = split_dock.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(10.0)).points(view::Live::Is(false))
      let _ = split_dock.box(fn(dock_w) {
        let _ = dock_w
        .width(view::Live::By(fn() {
          let w = root.window_w()
          let side_pad = if w > 0.0 && w < 380.0 { 12.0 } else { 14.0 }
          let avail = w - 2.0 * side_pad - 10.0 - 50.0
          Some(lg::clamp(avail, 240.0, 336.0))
        }))
        .shrink(view::Live::Is(0.0))
        .points(view::Live::By(fn() { !any_modal_open() }))
        let _ = lg::liquid_bottom_tabs_node(
          dock_w,
          ["Optics", "Controls", "Overlays", "More"],
          mobile_selected,
          mobile_select,
          label="Library sections",
          faces=[
            studio_tab_face_mobile("Optics", icon_prism),
            studio_tab_face_mobile("Controls", icon_sliders),
            studio_tab_face_mobile("Overlays", icon_layers),
            lib_tab_face_dynamic(fn() { mobile_extra_cat.get() }),
          ],
        )
      })
      let _ = split_dock.box(fn(orb_wrap) {
        let _ = orb_wrap.points(view::Live::By(fn() { !any_modal_open() }))
        lib_dock_catalog_orb(orb_wrap, fn() { catalog_sheet_open.get() }, fn() { catalog_sheet_open.set(true) })
      })
    }, at_once=true)
    dock_row.show(fn() { !is_compact_dock() }, fn(dock_w) {
      let _ = dock_w
      .width(view::Live::By(fn() {
        let w = root.window_w()
        if w > 0.0 {
          Some(lg::clamp(w - 40.0, 420.0, 460.0))
        } else {
          Some(460.0)
        }
      }))
      .shrink(view::Live::Is(0.0))
      .points(view::Live::By(fn() { !any_modal_open() }))
      let _ = lg::liquid_bottom_tabs_node(
        dock_w,
        ["Optics", "Controls", "Inputs", "Nav", "Overlays", "Physics", "Code"],
        fn() { active_cat.get() },
        fn(i) { active_cat.set(i) },
        label="Library sections",
        height=44.0,
        faces=[
          studio_tab_face("Optics", icon_prism),
          studio_tab_face("Controls", icon_sliders),
          studio_tab_face("Inputs", icon_spark),
          studio_tab_face("Nav", icon_grid),
          studio_tab_face("Overlays", icon_layers),
          studio_tab_face("Physics", icon_merge),
          studio_tab_face("Code", icon_terminal),
        ],
      )
    }, at_once=true)
  })

  // 5. Global root overlay host (strictly above shell, scroll edges, top nav & bottom dock)
  let _ = root.box(fn(host) {
    let _ = host.over(view::Live::Is(true)).points(view::Live::Is(false))
    host_ref.v = Some(host)
  })

  let make_cat_rows = fn(close_sheet : Bool) -> () -> Array[lg::LiquidListRow] {
    fn() {
      let q = search_q.get()
      let cur = active_cat.get()
      let out : Array[lg::LiquidListRow] = []
      for i = 0; i < lib_categories.length(); i = i + 1 {
        let cat = lib_categories[i]
        let hit = q == "" || str_contains_ci(cat.name, q) || str_contains_ci(cat.keywords, q)
        if hit {
          let cid = cat.id
          let icon_fn = lib_cat_icon(cid)
          out.push(
            lg::LiquidListRow::new(
              title=cat.name,
              subtitle=cat.subtitle,
              value=cat.count,
              icon=fn(ic, ink) { icon_fn(ic, 16.0, ink) },
              active=cur == cid,
              on_press=fn() {
                active_cat.set(cid)
                if close_sheet {
                  catalog_sheet_open.set(false)
                }
              },
            ),
          )
        }
      }
      if out.length() == 0 {
        out.push(
          lg::LiquidListRow::new(
            title="No matching parts",
            subtitle="Try menu, slider, toast, merge",
          ),
        )
      }
      out
    }
  }

  match shell_ref.v {
    Some(shell) =>
    match nav_ref.v {
      Some(nav_slot) =>
      match host_ref.v {
        Some(overlay_host) => {
          // 1. Self-hosted Floating Top Navigation Bar (`lg::liquid_nav_bar_node`)
          let _ = nav_slot.box(fn(nav_wrap) {
            let _ = nav_wrap.points(view::Live::Is(true))
            let _ = lg::liquid_nav_bar_node(
              nav_wrap,
              fn() { if is_phone() { "" } else { "Invar" } },
              subtitle=fn() { if is_phone() { "" } else { "Pure Pion GPU UI · 6 Hosts × 47 Packages" } },
              compact=is_phone,
              leading=fn(s) {
                let _ = s.box(fn(brand) {
                  let _ = brand.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                  icon_brand_mark(brand, 20.0, fn() { lg::colors().content })
                  brand.show(is_phone, fn(lbl) {
                    let _ = lbl
                    .words(view::Live::Is("Invar"), look=lg::words_at(16.5, weight=600))
                    .ink(view::Live::By(fn() { lg::colors().content }))
                  }, at_once=true)
                })
                s.show(fn() { !is_narrow() }, fn(slot) {
                  let _ = lg::liquid_badge_node(slot, fn() { "47 Packages · 0 DOM" }, tone=lg::LiquidTone::Accent, dot=true)
                }, at_once=true)
                s.show(fn() { is_narrow() && !is_compact_dock() }, fn(slot) {
                  lib_nav_catalog_button(slot, fn() { catalog_sheet_open.set(true) })
                }, at_once=true)
              },
              trailing=fn(s) {
                let theme_seg = lg::liquid_segmented_node(
                  s,
                  fn() { ["Light", "Dark"] },
                  fn() { if lg::is_dark() { 1 } else { 0 } },
                  fn(i) { lg::set_dark(Some(i == 1)) },
                  width=116.0,
                  height=30.0,
                )
                let _ = theme_seg
                .width(view::Live::By(fn() { if is_phone() { Some(92.0) } else { Some(116.0) } }))
                .max_width(view::Live::By(fn() { if is_phone() { Some(92.0) } else { Some(116.0) } }), within=true)
                let _ = lg::liquid_menu_node(
                  s,
                  overlay_host,
                  fn() { top_menu_open.get() },
                  fn(v) { top_menu_open.set(v) },
                  fn() { "Studio options" },
                  lib_nav_menu_trigger,
                  fn() {
                    let nav_entry = if is_narrow() {
                      lg::LiquidMenuEntry::item(
                        label="Search & Catalog",
                        on_select=fn() { catalog_sheet_open.set(true) },
                      )
                    } else {
                      lg::LiquidMenuEntry::check(
                        label="Sidebar",
                        checked=fn() { sidebar_open.get() },
                        on_toggle=fn() { sidebar_open.set(!sidebar_open.untracked()) },
                      )
                    }
                    [
                      lg::LiquidMenuEntry::check(
                        label="Calibration Grid",
                        checked=fn() { grid_on.get() },
                        on_toggle=fn() { grid_on.set(!grid_on.untracked()) },
                      ),
                      lg::LiquidMenuEntry::check(
                        label="Ambient Glow",
                        checked=fn() { boost.get() },
                        on_toggle=fn() { boost.set(!boost.untracked()) },
                      ),
                      nav_entry,
                      lg::LiquidMenuEntry::separator(),
                      lg::LiquidMenuEntry::item(
                        label="Reset Demos",
                        on_select=reset_demos,
                      ),
                    ]
                  },
                  menu_label=fn() { "Studio Menu" },
                  placement=headless::Placement::BelowEnd,
                  anchor_size=(36.0, 36.0),
                  trigger_face=fn(v) { icon_sliders(v, 16.0, fn() { lg::colors().content }) },
                )
              },
            )
          })

          // 2. Body Row: Left Self-Hosted Sidebar (`264pt`, desktop only) + Right Interactive Exhibition Canvas
          let _ = shell.box(fn(body_row) {
            let _ = body_row
            .row(view::Live::Is(true))
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_height(view::Live::Is(Some(0.0)))
            .gap(view::Live::By(fn() { if is_narrow() { 0.0 } else { 4.0 } }))

            // Left floating glass sidebar (SearchBar + reactive category List + ProgressRing footer)
            body_row.show(fn() { !is_narrow() && sidebar_open.get() }, fn(side) {
              let _ = side
              .width(view::Live::Is(Some(284.0)))
              .shrink(view::Live::Is(0.0))
              .padding(view::Live::Is((20.0, 78.0, 0.0, dock_room)))
              .gap(view::Live::Is(12.0))
              .lies_along(view::Live::Is(view::Lies::Between))
              let _ = side.box(fn(top_part) {
                let _ = top_part.gap(view::Live::Is(12.0))
                let _ = lg::liquid_search_bar_node(
                  top_part,
                  search_field,
                  placeholder="Filter 35 parts...",
                  label=fn() { "Filter components" },
                  edited=fn(s) { search_q.set(s) },
                  on_clear=fn() { search_q.set("") },
                )
                let _ = lg::liquid_list_node(
                  top_part,
                  make_cat_rows(false),
                  header=fn() { "CATEGORIES · 35 PARTS" },
                  dividers=false,
                )
              })

              // Sidebar footer status line
              let _ = side.box(fn(foot) {
                let _ = foot.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((12.0, 4.0, 12.0, 4.0)))
                let _ = lg::liquid_progress_ring_node(
                  foot,
                  fn() { Some(1.0) },
                  size=18.0,
                  stroke=2.2,
                  label=fn() { "Frame rate status" },
                )
                let _ = foot.box(fn(w) {
                  let _ = w
                  .words(view::Live::Is("100% Pure Pion · 0 DOM"), look=lg::words_at(12.0, weight=500))
                  .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.74) }))
                })
              })
            })

            // Right Main Exhibition Canvas (full-bleed clip rect so shadows & glass rims never clip; padding lives inside scroll content)
            let _ = body_row.box(fn(main_area) {
              let _ = main_area.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).fills_across(view::Live::Is(true)).min_height(view::Live::Is(Some(0.0)))
              main_area.pick(fn() { active_cat.get() }, fn(scene_slot, cat_id) {
                let _ = scene_slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
                match cat_id {
                  0 => {
                    let _ = scene_slot.padding(view::Live::By(fn() {
                      if is_mobile_shell() {
                        (16.0, 60.0, 16.0, if is_phone() { 0.0 } else { 84.0 })
                      } else {
                        (20.0, 78.0, 20.0, dock_room)
                      }
                    }))
                    optics_scene(
                      scene_slot,
                      None,
                      grid_on,
                      refraction_val,
                      chroma_val,
                      blur_val,
                      light_angle_val,
                      prism_pos,
                      dialog_open,
                    )
                  }
                  5 => lib_physics_section(scene_slot, is_mobile_shell, phys_mode, merge_ctrl)
                  _ => {
                    let sc = scene_slot.scrolls(
                      canvas_scroll,
                      fn(s) {
                        let _ = s.padding(view::Live::By(fn() {
                          if is_mobile_shell() {
                            (16.0, 64.0, 16.0, 108.0)
                          } else {
                            (20.0, 82.0, 20.0, 108.0)
                          }
                        }))
                        match cat_id {
                          1 =>
                          lib_controls_section(
                            s,
                            is_phone,
                            seg_idx,
                            icon_active,
                            group_active,
                            toggle_a,
                            toggle_b,
                            bezel_val,
                            step_val,
                            last_ctrl,
                          )
                          2 =>
                          lib_inputs_section(
                            s,
                            is_phone,
                            fn() { root.window_w() },
                            name_field,
                            err_field,
                            demo_search,
                            morph_search_field,
                            morph_search_open,
                            cb_a,
                            cb_b,
                            cb_mixed,
                            radio_idx,
                            chip_metal,
                            chip_vulkan,
                            chip_webgl,
                            chip_beta_kept,
                            badge_count,
                          )
                          3 =>
                          lib_navigation_section(
                            s,
                            is_phone,
                            is_nav_stack,
                            fn() { root.window_w() },
                            grid_on,
                            boost,
                            list_active,
                            disc_open,
                            live_lum,
                            ctab_idx,
                            ctab_min,
                            last_nav,
                          )
                          6 =>
                          lib_code_section(
                            s,
                            fn() { root.window_w() },
                            code_snippet_idx,
                            code_editor,
                            code_term,
                          )
                          _ =>
                          lib_overlays_section(
                            s,
                            is_phone,
                            overlay_host,
                            demo_menu_open,
                            demo_menu_pin,
                            select_idx,
                            popover_open,
                            drawer_open,
                            drawer_side,
                            sheet_open,
                            action_sheet_open,
                            dialog_open,
                            toast_visible,
                            toast_status_idx,
                            prog_val,
                            prog_indet,
                            last_ovl,
                          )
                        }
                      },
                      slop=ui::touch_slop(),
                      bar=ui::tree_scroll_bar(),
                    )
                    let _ = sc.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
                  }
                }
              }, at_once=true)
            })
          })

          // 3. Global Modal Overlays mounted on `overlay_host`
          // Mobile & tablet catalog drawer (flat inner search + list -> strictly zero glass-on-glass inside sheet)
          let _ = lg::liquid_sheet_node(
            overlay_host,
            fn() { catalog_sheet_open.get() },
            fn() { catalog_sheet_open.set(false) },
            fn() { "Components · 35 Parts" },
            fn(b) {
              let sc = b.scrolls(catalog_scroll, fn(col) {
                let _ = col.gap(view::Live::Is(12.0)).padding(view::Live::Is((0.0, 0.0, 0.0, 28.0)))
                let _ = lg::liquid_search_bar_node(
                  col,
                  search_field,
                  placeholder="Filter 35 parts...",
                  label=fn() { "Filter components" },
                  edited=fn(s) { search_q.set(s) },
                  on_clear=fn() { search_q.set("") },
                  flat=true,
                )
                let _ = lg::liquid_list_node(
                  col,
                  make_cat_rows(true),
                  header=fn() { "CATEGORIES · 35 PARTS" },
                  dividers=false,
                  flat=true,
                )
                let _ = col.box(fn(foot) {
                  let _ = foot.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((8.0, 2.0, 8.0, 2.0)))
                  let _ = lg::liquid_progress_ring_node(
                    foot,
                    fn() { Some(1.0) },
                    size=18.0,
                    stroke=2.2,
                    label=fn() { "Frame rate status" },
                  )
                  let _ = foot.box(fn(w) {
                    let _ = w
                    .words(view::Live::Is("60 fps · Apache-2.0"), look=lg::words_at(12.0, weight=500))
                    .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.74) }))
                  })
                })
              }, slop=ui::touch_slop(), bar=ui::tree_scroll_bar())
              let _ = sc.max_height(view::Live::By(fn() {
                let wh = root.window_h()
                if wh > 0.0 {
                  Some(lg::clamp(wh - 160.0, 320.0, 580.0))
                } else {
                  Some(540.0)
                }
              }))
            },
            width=420.0,
            max_height=680.0,
          )

          overlay_host.pick(fn() { drawer_side.get() }, fn(slot, cur_side) {
            let _ = slot.over(view::Live::Is(true)).points(view::Live::Is(false))
            let _ = lg::liquid_drawer_node(
              slot,
              fn() { drawer_open.get() },
              fn() { drawer_open.set(false) },
              fn() { "Studio Drawer" },
              fn(b) {
                let _ = b.gap(view::Live::Is(12.0))
                let _ = b.box(fn(w) {
                  let _ = w
                  .words(
                    view::Live::Is("Floating 10pt island glass drawer. Drag horizontally toward the edge to dismiss, or over-pull for rubber-band resistance."),
                    look=lg::words_at(13.5, wrap=true),
                  )
                  .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.82) }))
                })
                let _ = lg::liquid_list_node(
                  b,
                  fn() {
                    let cur = drawer_item.get()
                    [
                      lg::LiquidListRow::new(
                        title="Symmetric Glass",
                        subtitle="80% light & dark parity",
                        value="0xCC",
                        icon=fn(ic, ink) { icon_prism(ic, 16.0, ink) },
                        active=cur == 0,
                        on_press=fn() {
                          drawer_item.set(0)
                          last_ovl.set("Drawer: Symmetric Glass")
                        },
                      ),
                      lg::LiquidListRow::new(
                        title="Concentric Corners",
                        subtitle="28pt outer · 12pt + 16pt",
                        value="0 faults",
                        icon=fn(ic, ink) { icon_grid(ic, 16.0, ink) },
                        active=cur == 1,
                        on_press=fn() {
                          drawer_item.set(1)
                          last_ovl.set("Drawer: Concentric Corners")
                        },
                      ),
                      lg::LiquidListRow::new(
                        title="Spring Physics",
                        subtitle="Velocity-continuous drag",
                        value="60 fps",
                        icon=fn(ic, ink) { icon_spark(ic, 16.0, ink) },
                        active=cur == 2,
                        on_press=fn() {
                          drawer_item.set(2)
                          last_ovl.set("Drawer: Spring Physics")
                        },
                      ),
                    ]
                  },
                  header=fn() { "DRAWER INSPECTOR" },
                  dividers=false,
                  flat=true,
                )
              },
              side=cur_side,
              subtitle=fn() {
                match cur_side {
                  lg::DrawerSide::Leading => "Leading · Floating Island"
                  lg::DrawerSide::Trailing => "Trailing · Floating Island"
                }
              },
              footer=fn(f) {
                let _ = f.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
                let _ = f.box(fn(w) {
                  let _ = w
                  .words(view::Live::Is("Drag edge or Esc"), look=lg::words_at(12.5, weight=500))
                  .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.72) }))
                })
                let _ = headless::button(f, fn() { "Done" }, fn(_e) -> Unit { drawer_open.set(false) }, fn(bv, btn) {
                  let _ = bv
                  .height(view::Live::Is(Some(32.0)))
                  .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
                  .radius(view::Live::Is(16.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .ground(view::Live::Is(lib_cobalt))
                  let _ = bv.box(fn(w) {
                    let _ = w.words(view::Live::Is("Done"), look=lg::words_at(13.5, weight=lg::weight_medium)).ink(view::Live::Is(lg::white))
                  })
                  bv.show(fn() { btn.focus_shown() }, fn(ring) {
                    let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
                    .radius(view::Live::Is(19.0))
                    .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
                  })
                })
              },
            )
          }, at_once=true)

          let _ = lg::liquid_sheet_node(
            overlay_host,
            fn() { sheet_open.get() },
            fn() {
              sheet_open.set(false)
              sheet_expanded.set(false)
            },
            fn() { "Optical Export Sheet" },
            fn(b) {
              let _ = b.gap(view::Live::Is(10.0))
              let _ = b.box(fn(w) {
                let _ = w
                .words(
                  view::Live::Is("Drag the top handle up to morph into a full-height docked reading surface, or drag down past 80pt to dismiss."),
                  look=lg::words_at(14.5, wrap=true),
                )
                .ink(view::Live::By(fn() { lg::colors().content }))
              })
              let _ = lg::liquid_progress_bar_node(b, fn() { Some(0.82) }, label=fn() { "Metal Shader Cache" }, show_value=true)
            },
            subtitle=fn() {
              if sheet_expanded.get() {
                "Large Detent · Docked Reading Surface"
              } else {
                "Medium Detent · Floating Liquid Glass"
              }
            },
            detents=true,
            expanded=fn() { sheet_expanded.get() },
            on_expanded=fn(v) { sheet_expanded.set(v) },
            footer=fn(f) {
              let _ = f.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::End)).gap(view::Live::Is(10.0))
              let _ = headless::button(
                f,
                fn() { "Done" },
                fn(_e) -> Unit {
                  sheet_open.set(false)
                  sheet_expanded.set(false)
                },
                fn(bv, btn) {
                  let _ = bv
                  .height(view::Live::Is(Some(32.0)))
                  .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
                  .radius(view::Live::Is(16.0))
                  .lines_up(view::Live::Is(Some(view::Along::Middle)))
                  .lies_along(view::Live::Is(view::Lies::Middle))
                  .ground(view::Live::Is(lib_vermilion))
                  let _ = bv.box(fn(w) {
                    let _ = w.words(view::Live::Is("Done"), look=lg::words_at(13.5, weight=lg::weight_medium)).ink(view::Live::Is(lg::white))
                  })
                  bv.show(fn() { btn.focus_shown() }, fn(ring) {
                    let _ = ring
                    .over(view::Live::Is(true))
                    .points(view::Live::Is(false))
                    .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
                    .radius(view::Live::Is(19.0))
                    .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
                  })
                },
              )
            },
          )

          let _ = lg::liquid_action_sheet_node(
            overlay_host,
            fn() { action_sheet_open.get() },
            fn() { action_sheet_open.set(false) },
            fn() {
              [
                lg::LiquidActionSheetItem::new(
                  label="Copy Pion Snippet",
                  on_select=fn() { last_ovl.set("ActionSheet: Copied snippet") },
                ),
                lg::LiquidActionSheetItem::new(
                  label="Export 3× PNG",
                  on_select=fn() { last_ovl.set("ActionSheet: Exported PNG") },
                ),
                lg::LiquidActionSheetItem::new(
                  label="Clear Shader Cache",
                  destructive=true,
                  on_select=fn() { last_ovl.set("ActionSheet: Cache cleared") },
                ),
              ]
            },
            title=fn() { "Component Actions" },
            message=fn() { "Separated iOS Liquid Glass action group with independent Cancel capsule." },
          )

          let _ = lg::liquid_dialog_node(
            overlay_host,
            fn() { dialog_open.get() },
            fn() { dialog_open.set(false) },
            fn() { "Publish Invar" },
            fn() { dialog_copy },
            cancel=fn() { "Cancel" },
            action=fn() { "Publish" },
            on_action=fn() {
              dialog_open.set(false)
              last_ovl.set("Dialog: Published")
            },
          )
        }
        None => ()
      }
      None => ()
    }
    None => ()
  }
}
