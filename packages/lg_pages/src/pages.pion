// The gallery's pages (src/shots draws them offscreen): each of the library's parts over a wallpaper of its own
// (drawn, no picture: the same on every run), as Kyant0/AndroidLiquidGlass's catalog shows them over its photograph.
// `page` makes the one asked for: the overview (every part), the dialog open over it, the overview held (each part
// pressed or dragged, held still: its glass up), and the film's (the parts a film drags, each where the film's script
// finds it).

import "lg"
import "paint"
import "signals"
import "ui"
import "view"

/// The parts' glass, as held still for a picture of them held: what the interactive page presses as it is made.
struct Held {
  button : lg::InteractiveHighlight
  toggle : lg::DampedDrag
  slider : lg::DampedDrag
  tabs : lg::DampedDrag
  tabs_light : lg::InteractiveHighlight
  tile : lg::InteractiveHighlight
}

/// The page named `name` in the window's `root`: "overview", "dialog" (the overview, its dialog open) or
/// "interactive" (the overview, its parts held), "film" (the film's parts). `top`: room left over the parts, for what
/// lies over the page's top (the gallery's bar); `closed`: told as the dialog closes.
pub fn page(root : view::View, name : String, top~ : Double = 0.0, closed~ : () -> Unit = fn() { () }) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true))
    wallpaper(w)
    if name == "film" {
      film_page(w, top)
    } else if name == "dialog" {
      overview(w, None, top)
      let open = signals::signal(true)
      let _ = lg::liquid_dialog_node(
        w,
        fn() { open.get() },
        fn() {
          open.set(false)
          closed()
        },
        fn() { "Dialog Title" },
        fn() { lorem },
        on_action=fn() {
          open.set(false)
          closed()
        },
      )
    } else if name == "interactive" {
      overview(w, Some(held_now()), top)
    } else {
      overview(w, None, top)
    }
  })
}

/// Glass held as the interactive page shows it, not pressed yet (`press_all` presses it once each part is made).
fn held_now() -> Held {
  Held::{
    button: lg::InteractiveHighlight::new(),
    toggle: lg::DampedDrag::new(0.0, lo=0.0, hi=1.0, held_scale=lg::thumb_held_scale),
    slider: lg::DampedDrag::new(40.0, lo=0.0, hi=100.0, threshold=0.01, held_scale=lg::thumb_held_scale),
    tabs: lg::DampedDrag::new(0.0, lo=0.0, hi=2.0, held_scale=lg::tab_lens_held_scale),
    tabs_light: lg::InteractiveHighlight::new(),
    tile: lg::InteractiveHighlight::new(),
  }
}

/// The catalog's words (LoremIpsum.kt).
pub let lorem : String = "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."

/// The wallpaper: soft blots of colour under a wide frost (a mesh of colour, as a photograph's), crossed by thin bright
/// stripes and a lattice of rings, sharp, for the glass over it to bend.
fn wallpaper(w : view::View) -> Unit {
  let _ = w.box(fn(paper) {
    let _ = paper.over(view::Live::Is(true)).clips(view::Live::Is(true)).ground(view::Live::By(fn() { if lg::is_dark() { 0x101028FFL } else { 0xF2E9DDFFL } }))
    let blots : Array[(Double, Double, Double, Int64, Int64)] = [
      (-120.0, -160.0, 520.0, 0xFF8A5BFFL, 0x8C2F6BFFL),
      (520.0, -220.0, 560.0, 0x5BC8FFFFL, 0x1E4FA8FFL),
      (900.0, 260.0, 520.0, 0xFFD25BFFL, 0xA8641EFFL),
      (-200.0, 480.0, 600.0, 0x8BE38CFFL, 0x1F7A4AFFL),
      (380.0, 620.0, 560.0, 0xC58BFFFFL, 0x4B2A8CFFL),
      (1000.0, 760.0, 420.0, 0xFF6FA8FFL, 0x8C1E4FFFL),
    ]
    for b in blots {
      let (x, y, d, light_col, dark_col) = b
      let _ = paper.box(fn(c) {
        let _ = c
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(d)))
          .height(view::Live::Is(Some(d)))
          .radius(view::Live::Is(d / 2.0))
          .offset(view::Live::Is((x, y)))
          .ground(view::Live::By(fn() { if lg::is_dark() { dark_col } else { light_col } }))
      })
    }
    let _ = paper.box(fn(f) {
      let _ = f
        .over(view::Live::Is(true))
        .glass(view::Live::Is(Some(paint::Glass::frosted(blur=90.0, tint=0x00000000L, solid=0x808080FFL, contained=true))))
    })
    let mut k = 0
    while k < 14 {
      let yy = -200.0 + k.to_double() * 110.0
      let _ = paper.box(fn(s) {
        let _ = s
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(2400.0)))
          .height(view::Live::Is(Some(6.0)))
          .offset(view::Live::Is((-600.0, yy)))
          .turn(view::Live::Is(-0.35))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF2EL } else { 0xFFFFFF8CL } }))
      })
      k += 1
    }
    let mut row_i = 0
    while row_i < 11 {
      let mut col_i = 0
      while col_i < 14 {
        let d = 26.0
        let ox = 30.0 + col_i.to_double() * 92.0 + (if row_i % 2 == 0 { 0.0 } else { 46.0 })
        let oy = 20.0 + row_i.to_double() * 96.0
        let _ = paper.box(fn(c) {
          let _ = c
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(d)))
            .height(view::Live::Is(Some(d)))
            .radius(view::Live::Is(d / 2.0))
            .offset(view::Live::Is((ox, oy)))
            .edge(view::Live::By(fn() { (3.0, if lg::is_dark() { 0xFFFFFF26L } else { 0xFFFFFF73L }) }))
        })
        col_i += 1
      }
      row_i += 1
    }
  })
}

/// A section of the overview in `parent`: its `title` over what `body` makes.
fn section(parent : view::View, title : String, body : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(s) {
    let _ = s.gap(view::Live::Is(12.0))
    let _ = s.box(fn(t) {
      let _ = t.words(view::Live::Is(title), look=lg::words_at(13.0, weight=600)).ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.6) }))
    })
    body(s)
  })
}

/// A row of parts in `parent`, 16 apart, their middles in line.
fn row(parent : view::View, body : (view::View) -> Unit) -> Unit {
  let _ = parent.box(fn(r) {
    let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
    body(r)
  })
}

/// Every part, in two columns over the wallpaper, `top` more room over them; with `held`, each held as that says
/// (pressed as the page is made).
fn overview(root : view::View, held : Option[Held], top : Double) -> Unit {
  let on = signals::signal(true)
  let off = signals::signal(false)
  let level = signals::signal(40.0)
  let tab3 = signals::signal(0)
  let tab4 = signals::signal(1)
  let air = signals::signal(false)
  let wifi = signals::signal(true)
  let cell = signals::signal(true)
  let held_btn = match held { Some(h) => Some(h.button) None => None }
  let held_tog = match held { Some(h) => Some(h.toggle) None => None }
  let held_sld = match held { Some(h) => Some(h.slider) None => None }
  let held_tab = match held { Some(h) => Some(h.tabs) None => None }
  let held_tl = match held { Some(h) => Some(h.tabs_light) None => None }
  let held_tile = match held { Some(h) => Some(h.tile) None => None }
  let _ = root.box(fn(pg) {
    let _ = pg.grow(view::Live::Is(1.0)).row(view::Live::Is(true)).gap(view::Live::Is(48.0)).padding(view::Live::Is((48.0, 40.0 + top, 48.0, 40.0)))
    let _ = pg.box(fn(left) {
      let _ = left.width(view::Live::Is(Some(520.0))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(28.0))
      section(left, "LiquidButton", fn(s) {
        row(s, fn(r) {
          let _ = lg::liquid_button_node(r, fn() { "Transparent Liquid Button" }, fn() { () }, light?=held_btn)
          let _ = lg::liquid_button_node(r, fn() { "Surface Liquid Button" }, fn() { () }, surface=0xFFFFFF4DL)
        })
        row(s, fn(r) {
          let _ = lg::liquid_button_node(r, fn() { "Tinted Liquid Button" }, fn() { () }, tint=0x0088FFFFL)
          let _ = lg::liquid_button_node(r, fn() { "Tinted Liquid Button" }, fn() { () }, tint=0xFF8D28FFL)
        })
      })
      section(left, "LiquidToggle", fn(s) {
        row(s, fn(r) {
          let _ = lg::liquid_toggle_node(r, fn() { off.get() }, fn(v) { off.set(v) }, fn() { "Wi-Fi" }, drag?=held_tog)
          let _ = lg::liquid_toggle_node(r, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Bluetooth" })
        })
      })
      section(left, "LiquidSlider", fn(s) {
        let _ = s.box(fn(b) {
          let _ = b.width(view::Live::Is(Some(460.0)))
          let _ = lg::liquid_slider_node(b, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Brightness" }, drag?=held_sld)
        })
      })
      section(left, "LiquidBottomTabs", fn(s) {
        let _ = s.box(fn(b) {
          let _ = b.width(view::Live::Is(Some(460.0))).gap(view::Live::Is(20.0))
          let _ = lg::liquid_bottom_tabs_node(
            b,
            ["Tab 1", "Tab 2", "Tab 3"],
            fn() { tab3.get() },
            fn(i) { tab3.set(i) },
            label="Tabs",
            drag?=held_tab,
            light?=held_tl,
          )
          let _ = lg::liquid_bottom_tabs_node(
            b,
            ["Tab 1", "Tab 2", "Tab 3", "Tab 4"],
            fn() { tab4.get() },
            fn(i) { tab4.set(i) },
            label="More tabs",
          )
        })
      })
    })
    let _ = pg.box(fn(right) {
      let _ = right.width(view::Live::Is(Some(616.0))).shrink(view::Live::Is(0.0)).gap(view::Live::Is(28.0))
      section(right, "Control center", fn(s) {
        row(s, fn(r) {
          let wide = lg::tile_size * 2.0 + lg::tile_gap
          let _ = lg::liquid_card_node(
            r,
            wide,
            wide,
            fn() { "Connectivity" },
            radius=lg::tile_inner / 2.0 + lg::tile_gap,
            light?=held_tile,
            press=fn() { () },
            content=fn(c) {
              let _ = c.padding(view::Live::Is((lg::tile_gap, lg::tile_gap, lg::tile_gap, lg::tile_gap))).lies_along(view::Live::Is(view::Lies::Between))
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
                let _ = lg::liquid_control_item_node(rr, fn() { air.get() }, fn(v) { air.set(v) }, fn() { "Airplane mode" })
                let _ = lg::liquid_control_item_node(rr, fn() { wifi.get() }, fn(v) { wifi.set(v) }, fn() { "Wi-Fi" })
              })
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true))
                let _ = lg::liquid_control_item_node(rr, fn() { cell.get() }, fn(v) { cell.set(v) }, fn() { "Cellular" })
              })
            },
          )
          let _ = r.box(fn(col) {
            let _ = col.gap(view::Live::Is(lg::tile_gap))
            row(col, fn(rr) {
              let _ = lg::liquid_control_tile_node(rr, fn() { "Flight" }, fn() { () })
              let _ = lg::liquid_control_tile_node(rr, fn() { "Rotation" }, fn() { () }, angle=135.0)
            })
            let _ = lg::liquid_card_node(col, wide, lg::tile_size, fn() { "Now playing" })
          })
        })
      })
      section(right, "Adaptive luminance", fn(s) {
        row(s, fn(r) {
          for lum in [0.92, 0.08] {
            let lv = lum
            let _ = r.box(fn(b) {
              let _ = b
                .width(view::Live::Is(Some(220.0)))
                .height(view::Live::Is(Some(200.0)))
                .radius(view::Live::Is(28.0))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .ground(view::Live::Is(if lv > 0.5 { 0xF4F4F4FFL } else { 0x1C1C1EFFL }))
              let _ = b.box(fn(stripes) {
                let _ = stripes.over(view::Live::Is(true)).clips(view::Live::Is(true)).radius(view::Live::Is(28.0)).padding(view::Live::Is((0.0, 32.0, 0.0, 0.0))).gap(view::Live::Is(24.0))
                let mut si = 0
                while si < 6 {
                  let _ = stripes.box(fn(line) {
                    let _ = line.height(view::Live::Is(Some(4.0))).ground(view::Live::Is(if lv > 0.5 { 0xD0D0D8FFL } else { 0x3A3A44FFL }))
                  })
                  si += 1
                }
              })
              let _ = lg::liquid_adaptive_surface_node(b, fn() { lv }, size=150.0)
            })
          }
        })
      })
      section(right, "Progressive blur", fn(s) {
        let _ = s.box(fn(b) {
          let _ = b.radius(view::Live::Is(24.0)).clips(view::Live::Is(true))
          let _ = b.box(fn(text) {
            let _ = text.padding(view::Live::Is((20.0, 16.0, 20.0, 16.0))).ground(view::Live::By(fn() { lg::alpha(lg::colors().paper, 0.5) }))
            let _ = text.box(fn(t) {
              let _ = t.words(view::Live::Is(lorem), look=lg::words_at(16.0, wrap=true)).ink(view::Live::By(fn() { lg::colors().content }))
            })
          })
          let _ = b.box(fn(o) {
            let _ = o.over(view::Live::Is(true))
            let _ = lg::liquid_progressive_blur_node(o, height=96.0)
          })
        })
      })
      section(right, "Magnifier", fn(s) {
        let _ = lg::liquid_magnifier_node(s, fn() { lorem }, at=(60.0, 40.0))
      })
    })
  })
  match held {
    Some(h) => {
      signals::untracked(fn() {
        h.button.down(60.0, 24.0, 240.0, 48.0)
        h.button.moved(120.0, 34.0)
        h.toggle.press()
        h.slider.press()
        h.tabs.press()
        h.tabs.update_value(0.55)
        h.tabs_light.down(80.0, 32.0, 460.0, 64.0)
        h.tile.down(110.0, 40.0, 152.0, 152.0)
      })
    }
    None => ()
  }
}

/// The film's page: the parts its script drags, each where the script finds it (lg_shots, film_script): 40 in from
/// the window's top left (`top` more down), 40 apart down it, 520 wide.
fn film_page(root : view::View, top : Double) -> Unit {
  let on = signals::signal(false)
  let level = signals::signal(30.0)
  let tab = signals::signal(0)
  let _ = root.box(fn(pg) {
    let _ = pg.grow(view::Live::Is(1.0)).gap(view::Live::Is(40.0)).padding(view::Live::Is((40.0, 40.0 + top, 40.0, 40.0))).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = lg::liquid_button_node(pg, fn() { "Liquid Button" }, fn() { () })
    let _ = lg::liquid_toggle_node(pg, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Toggle" })
    let _ = pg.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(520.0)))
      let _ = lg::liquid_slider_node(b, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Slider" })
    })
    let _ = pg.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(520.0)))
      let _ = lg::liquid_bottom_tabs_node(b, ["Tab 1", "Tab 2", "Tab 3", "Tab 4"], fn() { tab.get() }, fn(i) { tab.set(i) }, label="Tabs")
    })
  })
}
