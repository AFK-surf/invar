// Invar · Spatial Optical Stage (src/gallery shows it in a window and on the web; src/shots draws it offscreen):
// a single-viewport (1120×690 zero-scroll, also responsive to 1120×637 and 1280×1040) interactive optical workbench
// with a floating glass Dock switching four scenes — Optics (draggable liquid prism + live Glass::liquid inspector),
// Deck (full 2×2 Invar hardware deck + continuous Adaptive Luminance bench), Loupe (Progressive Blur + Pion source
// magnifier), and Merge (iOS 27 capillary liquid bridge hysteresis & programmatic GlassEffectContainer bench).

import "headless"
import "lg"
import "paint"
import "signals"
import "ui"
import "view"

/// The parts' glass, as held still for a picture of them held: what the interactive page presses as it is made.
struct Held {
  button : lg::InteractiveHighlight
  toggle : lg::DampedDrag
  slider : lg::DampedDrag
  tabs : lg::DampedDrag
  tabs_light : lg::InteractiveHighlight
  tile : lg::InteractiveHighlight
}

fn words_track(size : Double, weight : Int, track : Double) -> view::WordsLook {
  view::WordsLook::{
    size,
    weight,
    line: size * 1.4,
    wrap: false,
    tracking: view::Spacing::Points(track),
    balance: false,
    max_lines: 0,
  }
}

fn words_line(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{
    size,
    weight,
    line,
    wrap,
    tracking: if size >= 18.0 { view::Spacing::Points(-0.25) } else { view::Spacing::Points(0.0) },
    balance: false,
    max_lines: 0,
  }
}

fn pair_d_eq(a : (Double, Double), b : (Double, Double)) -> Bool {
  a.0 == b.0 && a.1 == b.1
}

fn held_button(h : Option[Held]) -> Option[lg::InteractiveHighlight] {
  match h {
    Some(x) => Some(x.button)
    None => None
  }
}

fn held_toggle(h : Option[Held]) -> Option[lg::DampedDrag] {
  match h {
    Some(x) => Some(x.toggle)
    None => None
  }
}

fn held_slider(h : Option[Held]) -> Option[lg::DampedDrag] {
  match h {
    Some(x) => Some(x.slider)
    None => None
  }
}

fn held_tabs(h : Option[Held]) -> Option[lg::DampedDrag] {
  match h {
    Some(x) => Some(x.tabs)
    None => None
  }
}

fn held_tabs_light(h : Option[Held]) -> Option[lg::InteractiveHighlight] {
  match h {
    Some(x) => Some(x.tabs_light)
    None => None
  }
}

fn held_tile(h : Option[Held]) -> Option[lg::InteractiveHighlight] {
  match h {
    Some(x) => Some(x.tile)
    None => None
  }
}

/// Studio copy for Progressive Blur.
let progressive_copy : String = "One retained UI tree rendered straight on Metal, Vulkan, D3D11, GLES, and WebGL 2. Closed-form springs, concentric corner ladders, and real-time SDF liquid refraction — zero DOM, zero WebView."

/// Studio copy for Optical Loupe (Pion source specimen).
let loupe_source_copy : String = "let prism = paint::Glass::liquid(\n  blur=1.8, bezel=22.0, refraction=28.0, chroma=-0.06,\n  saturation=1.18, rim=0.68, adaptive=false,\n)\n// One GPU pass on Metal, Vulkan, D3D11, GLES & WebGL 2."

/// Compact-width Pion source specimen for Optical Loupe on narrow viewports (<= 28 chars/line, fits 360pt cleanly).
let loupe_source_copy_compact : String = "let p = Glass::liquid(\n  blur=1.5, bezel=20.0,\n  refraction=28.0,\n  chroma=-0.06,\n)\n// Metal · WebGL 2"

/// Studio copy for Publish Dialog.
let dialog_copy : String = "Compile one Pion UI tree into native GPU bundles for macOS, iOS, Android, Windows, Linux, and WebGL 2 with zero WebView overhead."

/// Format a non-negative number to one decimal place (e.g. `1.8`).
fn fmt_tenth(v : Double) -> String {
  let t = (v * 10.0).round().to_int()
  let whole = t / 10
  let frac = t % 10
  "\{whole}.\{frac}"
}

/// Format a chroma value `0..15` as `-0.06`.
fn fmt_chroma(v : Double) -> String {
  let c = v.round().to_int()
  if c == 0 {
    "0.00"
  } else if c < 10 {
    "-0.0\{c}"
  } else {
    "-0.\{c}"
  }
}

/// Format a 0..100 percentage as `0.88`.
fn fmt_unit(v : Double) -> String {
  let h = (lg::clamp(v, 0.0, 100.0)).round().to_int()
  let whole = h / 100
  let frac = h % 100
  let pad = if frac < 10 { "0" } else { "" }
  "\{whole}.\{pad}\{frac}"
}

/// Format a signed angle in degrees (e.g. `0°`, `+45°`, `-30°`).
fn fmt_deg(v : Double) -> String {
  let n = v.round().to_int()
  if n == 0 {
    "0°"
  } else if n > 0 {
    "+\{n}°"
  } else {
    "\{n}°"
  }
}

/// Degrees to radians for `ui::set_glass_light_angle`.
let deg_to_rad : Double = 3.141592653589793 / 180.0

/// Format a signed integer coordinate with explicit sign and 2-digit pad (e.g. `+00`, `-18`).
fn fmt_signed(v : Double) -> String {
  let n = v.round().to_int()
  let sign = if n < 0 { "-" } else { "+" }
  let a = if n < 0 { -n } else { n }
  let pad = if a < 10 { "0" } else { "" }
  "\{sign}\{pad}\{a}"
}

/// Format a signed number to one decimal place with explicit sign (e.g. `-8.0`, `+48.0`).
fn fmt_signed_tenth(v : Double) -> String {
  let t = (v * 10.0).round().to_int()
  let sign = if t < 0 { "-" } else { "+" }
  let a = if t < 0 { -t } else { t }
  let whole = a / 10
  let frac = a % 10
  "\{sign}\{whole}.\{frac}"
}

/// The page named `name` in the window's `root`: "overview", "dialog" (the overview, its dialog open) or
/// "interactive" (the overview, its parts held), "film" (the film's parts). `top`: room left over the parts, for what
/// lies over the page's top (the gallery's bar); `closed`: told as the dialog closes.
pub fn page(root : view::View, name : String, top~ : Double = 0.0, closed~ : () -> Unit = fn() { }) -> Unit {
  ui::set_tree_theme(lg::ui_theme)
  let grid_on = signals::signal(true)
  let boost = signals::signal(false)
  let dialog_open = signals::signal(name == "dialog")
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0)).clips(view::Live::Is(true))
    wallpaper(w, fn() { grid_on.get() }, fn() { boost.get() })
    match name {
      "library" => library_page(w, grid_on, boost)
      "film" => film_page(w, top)
      "merge" => merge_page(w, top)
      _ => {
        let held = if name == "interactive" { Some(held_now()) } else { None }
        overview(w, held, top, grid_on, boost, dialog_open)
        let _ = lg::liquid_dialog_node(
          w,
          fn() { dialog_open.get() },
          fn() {
            dialog_open.set(false)
            if name == "dialog" {
              closed()
            }
          },
          fn() { "Publish Invar" },
          fn() { dialog_copy },
          cancel=fn() { "Cancel" },
          action=fn() { "Publish" },
          on_action=fn() {
            dialog_open.set(false)
            if name == "dialog" {
              closed()
            }
          },
        )
      }
    }
  })
}

/// Glass held as the interactive page shows it, not pressed yet (`overview` presses it once each part is made).
fn held_now() -> Held {
  Held::{
    button: lg::InteractiveHighlight::new(),
    toggle: lg::DampedDrag::new(1.0, lo=0.0, hi=1.0, held_scale=lg::thumb_held_scale),
    slider: lg::DampedDrag::new(28.0, lo=0.0, hi=56.0, threshold=0.01, held_scale=lg::thumb_held_scale),
    tabs: lg::DampedDrag::new(0.0, lo=0.0, hi=3.0, held_scale=lg::tab_lens_held_scale),
    tabs_light: lg::InteractiveHighlight::new(),
    tile: lg::InteractiveHighlight::new(),
  }
}

/// High-contrast Monoid architectural studio wallpaper: Obsidian `#090A0E` / warm stone `#F4F1EA` base, three
/// restrained 18-layer colour fields (vermilion, cobalt, teal) with subtle `boost` gain, and a toggleable precision
/// calibration layer (80pt hairlines, two crisp diagonal refraction ribbons, and two concentric target reticles).
/// Zero fullscreen `Glass::frosted` keeps WebGL 2 at 60 fps local-damage speed.
fn wallpaper(w : view::View, grid_on : () -> Bool, boost : () -> Bool) -> Unit {
  let _ = w.box(fn(paper) {
    let _ = paper
    .over(view::Live::Is(true))
    .clips(view::Live::Is(true))
    .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0EFFL } else { 0xF4F1EAFFL } }))
    // Three restrained soft colour fields: (x, y, diameter, light_color, dark_color)
    let blots : Array[(Double, Double, Double, Int64, Int64)] = [
      // Top-left: Monoid Vermilion
      (-160.0, -140.0, 520.0, 0xFF9E78FFL, 0xB83E18FFL),
      // Top-right: Deep Cobalt
      (640.0, -180.0, 560.0, 0x7CC4FAFFL, 0x1D4ED8FFL),
      // Bottom-left: Slate Teal
      (-160.0, 380.0, 540.0, 0x7ED8B2FFL, 0x115E59FFL),
    ]
    for bi = 0; bi < blots.length(); bi = bi + 1 {
      let b = blots[bi]
      let x = b.0
      let y = b.1
      let d = b.2
      let light = b.3
      let dark = b.4
      let cx = x + d / 2.0
      let cy = y + d / 2.0
      let layers = 18
      for k = 0; k < layers; k = k + 1 {
        let t = k.to_double() / (layers - 1).to_double()
        let ld = d * (1.76 - 1.60 * t)
        let base_a = 0.018 + 0.018 * t
        let _ = paper.box(fn(c) {
          let _ = c
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(ld)))
          .height(view::Live::Is(Some(ld)))
          .radius(view::Live::Is(ld / 2.0))
          .offset(view::Live::Is((cx - ld / 2.0, cy - ld / 2.0)))
          .ground(view::Live::By(fn() {
            let gain = if boost() { 1.32 } else { 1.0 }
            let a = lg::clamp(base_a * gain, 0.0, 0.12)
            lg::alpha(if lg::is_dark() { dark } else { light }, a)
          }))
        })
      }
    }
    // Precision optical calibration layer (toggled live via alpha without rebuilding nodes)
    let _ = paper.box(fn(cal) {
      let _ = cal
      .over(view::Live::Is(true))
      .clips(view::Live::Is(true))
      .points(view::Live::Is(false))
      .alpha(view::Live::By(fn() { if grid_on() { 1.0 } else { 0.0 } }))
      // 80pt architectural baseline grid (1px hairlines)
      for col = 1; col < 18; col = col + 1 {
        let cx = col.to_double() * 80.0
        let _ = cal.box(fn(vl) {
          let _ = vl
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(1.0)))
          .height(view::Live::Is(Some(1200.0)))
          .offset(view::Live::Is((cx, 0.0)))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF0DL } else { 0x1717170DL } }))
        })
      }
      for row_i = 1; row_i < 15; row_i = row_i + 1 {
        let ry = row_i.to_double() * 80.0
        let _ = cal.box(fn(hl) {
          let _ = hl
          .over(view::Live::Is(true))
          .width(view::Live::Is(Some(1600.0)))
          .height(view::Live::Is(Some(1.0)))
          .offset(view::Live::Is((0.0, ry)))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF0DL } else { 0x1717170DL } }))
        })
      }
      // Two crisp diagonal refraction ribbons (-0.32 rad): primary highlight + Monoid Vermilion hairline
      let _ = cal.box(fn(s1) {
        let _ = s1
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(2200.0)))
        .height(view::Live::Is(Some(4.0)))
        .offset(view::Live::Is((-360.0, 220.0)))
        .turn(view::Live::Is(-0.32))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF22L } else { 0x14172018L } }))
      })
      let _ = cal.box(fn(s2) {
        let _ = s2
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(2200.0)))
        .height(view::Live::Is(Some(3.0)))
        .offset(view::Live::Is((-360.0, 420.0)))
        .turn(view::Live::Is(-0.32))
        .ground(view::Live::Is(monoid_vermilion_ribbon))
      })
      // Two restrained concentric optical target reticles
      let targets : Array[(Double, Double, Double)] = [(160.0, 160.0, 112.0), (1040.0, 560.0, 128.0)]
      let ratios : Array[Double] = [1.0, 0.56]
      for ti = 0; ti < targets.length(); ti = ti + 1 {
        let tg = targets[ti]
        let tx = tg.0
        let ty = tg.1
        let td = tg.2
        for ri = 0; ri < ratios.length(); ri = ri + 1 {
          let rd = td * ratios[ri]
          let _ = cal.box(fn(ring) {
            let _ = ring
            .over(view::Live::Is(true))
            .width(view::Live::Is(Some(rd)))
            .height(view::Live::Is(Some(rd)))
            .radius(view::Live::Is(rd / 2.0))
            .offset(view::Live::Is((tx - rd / 2.0, ty - rd / 2.0)))
            .edge(view::Live::By(fn() { (1.5, if lg::is_dark() { 0xFFFFFF16L } else { 0x17171714L }) }))
          })
        }
      }
    })
  })
}

let monoid_vermilion_ribbon : Int64 = 0xEF63344DL

/// Compact pill button for the Studio Bar (`height: 30`, `radius: 15`) built on `headless::button`.
fn studio_bar_pill(
  parent : view::View,
  label : () -> String,
  on_press : () -> Unit,
  body : (view::View) -> Unit,
) -> Unit {
  let _ = headless::button(parent, label, fn(_) { on_press() }, fn(b, btn) {
    let _ = b
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(30.0)))
    .padding(view::Live::Is((12.0, 0.0, 12.0, 0.0)))
    .radius(view::Live::Is(15.0))
    .gap(view::Live::Is(6.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Middle))
    .ground(view::Live::By(fn() {
      let d = lg::is_dark()
      if btn.pressed() || btn.hovered() {
        if d { 0xFFFFFF24L } else { 0x14172018L }
      } else if d {
        0xFFFFFF14L
      } else {
        0xFFFFFFA8L
      }
    }))
    .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF22L } else { 0x1417201AL }) }))
    body(b)
    b.show(fn() { btn.focus_shown() }, fn(ring) {
      let _ = ring
      .over(view::Live::Is(true))
      .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
      .radius(view::Live::Is(18.0))
      .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
    })
  })
}

/// Top Studio Bar (`height: 36`): left Invar mark + `Invar · OPTICAL STAGE`, right status + Dark/Light + Dialog.
fn studio_bar(parent : view::View, dialog_open : signals::Signal[Bool]) -> Unit {
  let _ = parent.box(fn(hdr) {
    let _ = hdr
    .row(view::Live::Is(true))
    .height(view::Live::Is(Some(36.0)))
    .shrink(view::Live::Is(0.0))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .lies_along(view::Live::Is(view::Lies::Between))
    let _ = hdr.box(fn(left) {
      let _ = left.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
      icon_brand_mark(left, 18.0, fn() { lg::colors().content })
      let _ = left.box(fn(w) {
        let _ = w.words(view::Live::Is("Invar"), look=lg::words_at(15.0, weight=600)).ink(view::Live::By(fn() { lg::colors().content }))
      })
      let _ = left.box(fn(dot) {
        let _ = dot
        .width(view::Live::Is(Some(3.0)))
        .height(view::Live::Is(Some(3.0)))
        .radius(view::Live::Is(1.5))
        .shrink(view::Live::Is(0.0))
        .ground(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.36) }))
      })
      let _ = left.box(fn(w) {
        let _ = w
        .words(view::Live::Is("OPTICAL STAGE"), look=words_track(11.0, 600, 1.0))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.58) }))
      })
    })
    let _ = hdr.box(fn(right) {
      let _ = right.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(12.0))
      let _ = right.box(fn(status) {
        let _ = status.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(7.0))
        let _ = status.box(fn(dot) {
          let _ = dot.width(view::Live::Is(Some(6.0))).height(view::Live::Is(Some(6.0))).radius(view::Live::Is(3.0)).shrink(view::Live::Is(0.0)).ground(view::Live::Is(monoid_vermilion))
        })
        let _ = status.box(fn(w) {
          let _ = w
          .words(view::Live::Is("60 fps · Metal / WebGL 2"), look=lg::words_at(12.0, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.64) }))
        })
      })
      studio_bar_pill(
        right,
        fn() { if lg::is_dark() { "Switch to Light" } else { "Switch to Dark" } },
        fn() { lg::set_dark(Some(!lg::is_dark())) },
        fn(b) {
          b.pick(fn() { lg::is_dark() }, fn(ic, d) {
            if d {
              icon_moon(ic, 14.0, fn() { lg::colors().content })
            } else {
              icon_sun(ic, 14.0, fn() { lg::colors().content })
            }
          }, at_once=true)
          let _ = b.box(fn(w) {
            let _ = w
            .words(view::Live::By(fn() { if lg::is_dark() { "Dark" } else { "Light" } }), look=lg::words_at(12.0, weight=500))
            .ink(view::Live::By(fn() { lg::colors().content }))
          })
        },
      )
      studio_bar_pill(
        right,
        fn() { "Dialog" },
        fn() { dialog_open.set(true) },
        fn(b) {
          let _ = b.box(fn(w) {
            let _ = w.words(view::Live::Is("Dialog"), look=lg::words_at(12.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
        },
      )
    })
  })
}

/// Five horizontal calibration hairlines inside a contrast plate.
fn plate_stripes(parent : view::View, radius : Double, stripe_color : () -> Int64, top_pad : Double, gap : Double) -> Unit {
  let _ = parent.box(fn(stripes) {
    let _ = stripes
    .over(view::Live::Is(true))
    .clips(view::Live::Is(true))
    .points(view::Live::Is(false))
    .radius(view::Live::Is(radius))
    .padding(view::Live::Is((0.0, top_pad, 0.0, 0.0)))
    .gap(view::Live::Is(gap))
    let add = fn() {
      let _ = stripes.box(fn(line) {
        let _ = line.height(view::Live::Is(Some(3.0))).ground(view::Live::By(stripe_color))
      })
    }
    add()
    add()
    add()
    add()
    add()
  })
}

/// Single-layer Liquid Glass material for `OPTICAL PARAMETERS` and `CAPILLARY HYSTERESIS` inspector
/// panels (all buttons inside use `flat=true`, so zero glass-on-glass).
fn inspector_glass() -> paint::Glass {
  let d = lg::is_dark()
  paint::Glass::liquid(
    blur=8.0,
    tint=if d { 0x1A1C2478L } else { 0xFDFCFD85L },
    solid=if d { 0x161820FFL } else { 0xFAF8F4FFL },
    saturation=1.05,
    rim=0.72,
    bezel=20.0,
    refraction=24.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// Light translucent non-glass surface for containers hosting child `Glass::liquid` specimens
/// (such as `ADAPTIVE LUMINANCE` hosting two `liquid_adaptive_surface_node` lenses).
fn inspector_surface(node : view::View) -> Unit {
  let _ = node
  .ground(view::Live::By(fn() { if lg::is_dark() { 0x16181F78L } else { 0xFFFFFF78L } }))
  .edge(view::Live::By(fn() { (0.5, if lg::is_dark() { 0xFFFFFF22L } else { 0x00000018L }) }))
  .shadow(view::Live::Is((8.0, 2.0, 0x00000012L)))
}

/// Parameter slider row inside the Glass Inspector or Deck: label left, formatted readout right, slider below.
fn param_slider(
  parent : view::View,
  name : String,
  readout : () -> String,
  value : () -> Double,
  change : (Double) -> Unit,
  least : Double,
  most : Double,
  drag? : lg::DampedDrag,
  compact~ : Bool = false,
) -> Unit {
  let font_sz = if compact { 12.0 } else { 12.5 }
  let _ = parent.box(fn(b) {
    let _ = b.gap(view::Live::Is(if compact { 3.0 } else { 4.0 }))
    let _ = b.box(fn(sh) {
      let _ = sh.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = sh.box(fn(l) {
        let _ = l
        .words(view::Live::Is(name), look=lg::words_at(font_sz, weight=500))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.82) }))
      })
      let _ = sh.box(fn(v) {
        let _ = v
        .words(view::Live::By(readout), look=lg::words_at(font_sz, weight=600))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.72) }))
      })
    })
    let _ = lg::liquid_slider_node(b, value, change, fn() { name }, least=least, most=most, drag?=drag)
  })
}

/// How tall the Optics stage is at the least and at the most: what it draws (the 236pt sun, the plate and wordmark under
/// it, the 176pt prism) placed by the height it is given between them.
let stage_least : Double = 340.0

/// (stage_least's)
let stage_most : Double = 480.0

/// Shared `OPTICAL PARAMETERS` single-layer Liquid Glass inspector panel used by both desktop split and narrow stacked
/// layouts of `optics_scene`.
fn optics_inspector(
  parent : view::View,
  held : Option[Held],
  grid_on : signals::Signal[Bool],
  refraction_val : signals::Signal[Double],
  chroma_val : signals::Signal[Double],
  blur_val : signals::Signal[Double],
  light_angle_val : signals::Signal[Double],
  prism_pos : signals::Signal[(Double, Double)],
  dialog_open : signals::Signal[Bool],
  stacked : Bool,
) -> Unit {
  let build_header_and_sliders = fn(target : view::View, compact : Bool) {
    let la_font_sz = if compact { 12.0 } else { 12.5 }
    // Header row
    let _ = target.box(fn(ih) {
      let _ = ih.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = ih.box(fn(l) {
        let _ = l
        .words(view::Live::Is("OPTICAL PARAMETERS"), look=words_track(11.0, 600, 0.9))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.62) }))
      })
      let _ = ih.box(fn(r) {
        let _ = r
        .words(view::Live::Is("iOS 27 SDF"), look=lg::words_at(11.0, weight=500))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.52) }))
      })
    })
    // Four live optical parameter sliders
    param_slider(
      target,
      "Refraction",
      fn() { "\{refraction_val.get().round().to_int()} px" },
      fn() { refraction_val.get() },
      fn(v) { refraction_val.set(v) },
      0.0,
      56.0,
      drag?=held_slider(held),
      compact=compact,
    )
    param_slider(
      target,
      "Chroma",
      fn() { fmt_chroma(chroma_val.get()) },
      fn() { chroma_val.get() },
      fn(v) { chroma_val.set(v) },
      0.0,
      15.0,
      compact=compact,
    )
    param_slider(
      target,
      "Blur",
      fn() { "\{fmt_tenth(blur_val.get())} pt" },
      fn() { blur_val.get() },
      fn(v) { blur_val.set(v) },
      0.0,
      12.0,
      compact=compact,
    )
    // Ambient Light Angle (-90°..+90°, live global ui::set_glass_light_angle + one-tap 0° reset)
    let _ = target.box(fn(la_box) {
      let _ = la_box.gap(view::Live::Is(if compact { 3.0 } else { 4.0 }))
      let _ = la_box.box(fn(sh) {
        let _ = sh.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = sh.box(fn(l) {
          let _ = l
          .words(view::Live::Is("Light Angle"), look=lg::words_at(la_font_sz, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.82) }))
        })
        let _ = sh.box(fn(rhs) {
          let _ = rhs.row(view::Live::Is(true)).gap(view::Live::Is(6.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = rhs.box(fn(v) {
            let _ = v
            .words(view::Live::By(fn() { fmt_deg(light_angle_val.get()) }), look=lg::words_at(la_font_sz, weight=600))
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.72) }))
          })
          rhs.show(fn() { light_angle_val.get().abs() > 0.5 }, fn(rst_slot) {
            let _ = headless::button(
              rst_slot,
              fn() { "Reset Light Angle" },
              fn(_) {
                light_angle_val.set(0.0)
                ui::set_glass_light_angle(0.0)
              },
              fn(btn, b) {
                let _ = btn
                .row(view::Live::Is(true))
                .height(view::Live::Is(Some(20.0)))
                .shrink(view::Live::Is(0.0))
                .padding(view::Live::Is((7.0, 0.0, 7.0, 0.0)))
                .radius(view::Live::Is(10.0))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .lies_along(view::Live::Is(view::Lies::Middle))
                .ground(view::Live::By(fn() {
                  let c = lg::colors()
                  if b.pressed() || b.hovered() {
                    lg::alpha(c.accent, 0.24)
                  } else {
                    lg::alpha(c.content, 0.10)
                  }
                }))
                let _ = btn.box(fn(w) {
                  let _ = w
                  .words(view::Live::Is("0°"), look=lg::words_at(11.0, weight=600))
                  .ink(view::Live::By(fn() { lg::colors().content }))
                })
                btn.show(fn() { b.focus_shown() }, fn(ring) {
                  let _ = ring
                  .over(view::Live::Is(true))
                  .points(view::Live::Is(false))
                  .radius(view::Live::Is(10.0))
                  .edge(view::Live::By(fn() { (1.5, lg::colors().accent) }))
                })
              },
            )
          })
        })
      })
      let _ = lg::liquid_slider_node(
        la_box,
        fn() { light_angle_val.get() },
        fn(v) {
          light_angle_val.set(v)
          ui::set_glass_light_angle(v * deg_to_rad)
        },
        fn() { "Light Angle" },
        least=-90.0,
        most=90.0,
      )
    })
  }

  let reset_optics = fn() {
    prism_pos.set((0.0, 0.0))
    refraction_val.set(28.0)
    chroma_val.set(6.0)
    blur_val.set(1.5)
    light_angle_val.set(0.0)
    ui::set_glass_light_angle(0.0)
    grid_on.set(true)
  }

  if stacked {
    let build_mobile_body = fn(body : view::View) {
      let _ = body
      .padding(view::Live::Is((14.0, 12.0, 14.0, 12.0)))
      .gap(view::Live::Is(8.0))
      build_header_and_sliders(body, true)
      // Merged compact bottom row: Grid toggle left, Reset + Publish right (concentric 28 - 12 = 16 with 32pt buttons)
      let _ = body.box(fn(foot) {
        let _ = foot
        .row(view::Live::Is(true))
        .lies_along(view::Live::Is(view::Lies::Between))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(8.0))
        .padding(view::Live::Is((0.0, 2.0, 0.0, 0.0)))
        let _ = foot.box(fn(t_grid) {
          let _ = t_grid.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = lg::liquid_toggle_node(
            t_grid,
            fn() { grid_on.get() },
            fn(v) { grid_on.set(v) },
            fn() { "Grid" },
            drag?=held_toggle(held),
          )
          let _ = t_grid.box(fn(lbl) {
            let _ = lbl.words(view::Live::Is("Grid"), look=lg::words_at(12.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
        let _ = foot.box(fn(btns) {
          let _ = btns.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = lg::liquid_button_node(
            btns,
            fn() { "Reset" },
            reset_optics,
            flat=true,
            pad_x=14.0,
            light?=held_button(held),
          )
          let _ = lg::liquid_button_node(
            btns,
            fn() { "Publish" },
            fn() { dialog_open.set(true) },
            tint=monoid_vermilion,
            flat=true,
            pad_x=16.0,
          )
        })
      })
    }
    let insp_scroll = view::Scroll::new()
    let is_short = fn() -> Bool {
      let h = parent.window_h()
      h > 0.0 && h < 660.0
    }
    parent.pick(is_short, fn(slot, short_scr) {
      let _ = slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
      let _ = slot.box(fn(insp) {
        if short_scr {
          let _ = insp.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0))).clips(view::Live::Is(true))
        }
        let _ = insp
        .radius(view::Live::Is(28.0))
        .shadow(view::Live::Is(lg::shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() { Some(inspector_glass()) }))
        .says(view::Live::Is(Some(view::said(view::Role::Group, label="Optical Parameters"))))
        if short_scr {
          let sc = insp.scrolls(insp_scroll, fn(inner) {
            build_mobile_body(inner)
          }, slop=ui::touch_slop(), bar=ui::tree_scroll_bar())
          let _ = sc.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
        } else {
          build_mobile_body(insp)
        }
      })
    }, at_once=true)
    return
  }

  let _ = parent.box(fn(insp) {
    let _ = insp
    .width(view::Live::Is(Some(348.0)))
    .shrink(view::Live::Is(0.0))
    .radius(view::Live::Is(44.0))
    .padding(view::Live::Is((20.0, 18.0, 20.0, 20.0)))
    .gap(view::Live::Is(9.0))
    .shadow(view::Live::Is(lg::shadow_default))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(inspector_glass()) }))
    .says(view::Live::Is(Some(view::said(view::Role::Group, label="Optical Parameters"))))
    build_header_and_sliders(insp, false)
    // Toggles row: Dark + Grid
    let _ = insp.box(fn(toggles) {
      let _ = toggles.row(view::Live::Is(true)).wraps(view::Live::Is(Some(8.0))).gap(view::Live::Is(20.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).padding(view::Live::Is((0.0, 2.0, 0.0, 2.0)))
      let _ = toggles.box(fn(t1) {
        let _ = t1.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_toggle_node(t1, fn() { lg::is_dark() }, fn(v) { lg::set_dark(Some(v)) }, fn() { "Dark" })
        let _ = t1.box(fn(lbl) {
          let _ = lbl.words(view::Live::Is("Dark"), look=lg::words_at(12.5, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
        })
      })
      let _ = toggles.box(fn(t2) {
        let _ = t2.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_toggle_node(
          t2,
          fn() { grid_on.get() },
          fn(v) { grid_on.set(v) },
          fn() { "Grid" },
          drag?=held_toggle(held),
        )
        let _ = t2.box(fn(lbl) {
          let _ = lbl.words(view::Live::Is("Grid"), look=lg::words_at(12.5, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
        })
      })
    })
    // Live Pion code pill
    let _ = insp.box(fn(code) {
      let _ = code
      .radius(view::Live::Is(14.0))
      .padding(view::Live::Is((12.0, 8.0, 12.0, 8.0)))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0E7AL } else { 0x1417200FL } }))
      .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF14L } else { 0x14172014L }) }))
      let _ = code.box(fn(w) {
        let _ = w
        .words(
          view::Live::By(fn() {
            let b = fmt_tenth(blur_val.get())
            let rf = refraction_val.get().round().to_int()
            let ch = fmt_chroma(chroma_val.get())
            "Glass::liquid(blur: \{b}, refraction: \{rf},\n  chroma: \{ch})"
          }),
          look=words_line(11.5, 500, 16.0, wrap=true),
        )
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.88) }))
      })
    })
    // Bottom action row: Reset + Publish (flat=true inside Glass Inspector -> zero glass-on-glass)
    let _ = insp.box(fn(acts) {
      let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = acts.box(fn(b1) {
        let _ = b1.grow(view::Live::Is(1.0))
        let _ = lg::liquid_button_node(
          b1,
          fn() { "Reset" },
          reset_optics,
          flat=true,
          light?=held_button(held),
        )
      })
      let _ = acts.box(fn(b2) {
        let _ = b2.grow(view::Live::Is(1.0))
        let _ = lg::liquid_button_node(
          b2,
          fn() { "Publish" },
          fn() { dialog_open.set(true) },
          tint=monoid_vermilion,
          flat=true,
        )
      })
    })
  })
}

/// Interactive optical prism stage shared between desktop split and narrow stacked `optics_scene`.
fn optics_stage(
  parent : view::View,
  refraction_val : signals::Signal[Double],
  chroma_val : signals::Signal[Double],
  blur_val : signals::Signal[Double],
  prism_pos : signals::Signal[(Double, Double)],
  last_drag : ui::Ref[(Double, Double)],
  stacked : Bool,
) -> Unit {
  let stacked_h = fn() -> Double {
    let h = parent.window_h()
    if h > 0.0 && h < 680.0 { 184.0 } else { 216.0 }
  }
  let _ = parent.box(fn(stage_host) {
    if stacked {
      let _ = stage_host
      .height(view::Live::By(fn() { Some(stacked_h()) }))
      .shrink(view::Live::Is(0.0))
      .clips(view::Live::Is(true))
      .radius(view::Live::Is(24.0))
    } else {
      let _ = stage_host.grow(view::Live::Is(1.0)).fills_across(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    }
    let stage_room = stage_host.by_room(fn(stage, room) {
      let _ = stage.grow(view::Live::Is(1.0))
      let rw = fn() { room.width() }
      let rh = fn() {
        match room.height() {
          Some(v) => v
          None => if stacked { stacked_h() } else { stage_most }
        }
      }
      let prism_w = fn() {
        if stacked {
          let w = rw()
          if w < 360.0 {
            lg::clamp(w - 112.0, 184.0, 212.0)
          } else {
            lg::clamp(w - 48.0, 196.0, 228.0)
          }
        } else {
          268.0
        }
      }
      let prism_h = if stacked { 132.0 } else { 176.0 }
      let sun_d = if stacked { 140.0 } else { 236.0 }
      let plate_w = if stacked { 156.0 } else { 248.0 }
      let plate_h = if stacked { 84.0 } else { 132.0 }
      // 1. Monoid Vermilion Sun
      let _ = stage.box(fn(sun) {
        let _ = sun
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(sun_d)))
        .height(view::Live::Is(Some(sun_d)))
        .radius(view::Live::Is(sun_d / 2.0))
        .offset(view::Live::By(fn() {
          if stacked {
            (rw() * 0.34 - 70.0, rh() * 0.38 - 70.0)
          } else {
            (rw() * 0.43 - 118.0, rh() * 0.38 - 118.0)
          }
        }))
        .ground(view::Live::Is(monoid_vermilion))
      })
      // 2. Inverse-luminance architectural contrast plate
      let _ = stage.box(fn(plate) {
        let _ = plate
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(plate_w)))
        .height(view::Live::Is(Some(plate_h)))
        .radius(view::Live::Is(if stacked { 18.0 } else { 26.0 }))
        .clips(view::Live::Is(true))
        .offset(view::Live::By(fn() {
          if stacked {
            let max_px = lg::clamp(rw() - plate_w - 4.0, 0.0, 600.0)
            let px = lg::clamp(rw() * 0.78 - plate_w * 0.5, 0.0, max_px)
            (px, rh() * 0.56 - 42.0)
          } else {
            (rw() * 0.56 - 92.0, rh() * 0.54 - 66.0)
          }
        }))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0xF5F2EBFFL } else { 0x151720FFL } }))
        plate_stripes(
          plate,
          if stacked { 18.0 } else { 26.0 },
          fn() { if lg::is_dark() { 0xDDD8CEFFL } else { 0x292D3BFFL } },
          if stacked { 12.0 } else { 20.0 },
          if stacked { 13.0 } else { 20.0 },
        )
        let _ = plate.box(fn(tag) {
          let _ = tag
          .over(view::Live::Is(true))
          .padding(view::Live::Is(if stacked { (10.0, 6.0, 10.0, 8.0) } else { (14.0, 8.0, 14.0, 10.0) }))
          .lines_up(view::Live::Is(Some(view::Along::End)))
          .lies_along(view::Live::Is(view::Lies::End))
          let _ = tag.box(fn(w) {
            let _ = w
            .words(
              view::Live::By(fn() { if lg::is_dark() { "L 0.92" } else { "L 0.08" } }),
              look=words_track(10.5, 600, 0.6),
            )
            .ink(view::Live::By(fn() { if lg::is_dark() { 0x14151B80L } else { 0xFFFFFF80L } }))
          })
        })
      })
      // 3. Oversized architectural wordmark `Invar`
      let _ = stage.box(fn(wm) {
        if stacked {
          let _ = wm.width(view::Live::Is(Some(220.0))).height(view::Live::Is(Some(56.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
        }
        let _ = wm
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .offset(view::Live::By(fn() {
          if stacked {
            (rw() * 0.42 - 110.0, rh() * 0.74 - 22.0)
          } else {
            (rw() * 0.5 - 264.0, rh() * 0.67 - 42.0)
          }
        }))
        .words(view::Live::Is("Invar"), look=lg::words_at(if stacked { 44.0 } else { 116.0 }, weight=700))
        .ink(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF26L } else { 0x1417201FL } }))
      })
      // 4. Draggable live Liquid Glass Prism
      let _ = stage.box(fn(prism) {
        let clamped_pos = fn() -> (Double, Double) {
          let p = prism_pos.get()
          let max_x = lg::clamp((rw() - prism_w()) / 2.0 - 8.0, 0.0, 600.0)
          let max_y = lg::clamp((rh() - prism_h) / 2.0 - 8.0, 0.0, 400.0)
          (lg::clamp(p.0, -max_x, max_x), lg::clamp(p.1, -max_y, max_y))
        }
        let pad = if stacked { 13.0 } else { 20.0 }
        let _ = prism
        .over(view::Live::Is(true))
        .width(view::Live::By(fn() { Some(prism_w()) }))
        .height(view::Live::Is(Some(prism_h)))
        .radius(view::Live::Is(if stacked { 26.0 } else { 32.0 }))
        .padding(view::Live::Is((pad, pad, pad, pad)))
        .lies_along(view::Live::Is(view::Lies::Between))
        .shadow(view::Live::Is(lg::shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() {
          Some(
            paint::Glass::liquid(
              blur=blur_val.get(),
              tint=if lg::is_dark() { 0x1D202A26L } else { 0xFFFFFF26L },
              solid=if lg::is_dark() { 0x1A1C24FFL } else { 0xFAF8F4FFL },
              saturation=1.18,
              rim=0.88,
              bezel=24.0,
              refraction=refraction_val.get(),
              chroma=-chroma_val.get() / 100.0,
              merge=0.0,
              adaptive=false,
            ),
          )
        }))
        .offset(view::Live::By(fn() {
          let p = clamped_pos()
          ((rw() - prism_w()) / 2.0 + p.0, (rh() - prism_h) / 2.0 + p.1)
        }))
        .says(view::Live::By(fn() { Some(view::said(view::Role::Group, label="Optical Prism")) }))
        .gesture(ui::touch_slop(), press=fn(d) { last_drag.v = (d.wx, d.wy) }, drag=fn(d) {
          match d.kind {
            view::DragIs::Down => last_drag.v = (d.wx, d.wy)
            view::DragIs::Moved => {
              let last = last_drag.v
              let prev = prism_pos.untracked()
              let max_x = lg::clamp((rw() - prism_w()) / 2.0 - 8.0, 0.0, 600.0)
              let max_y = lg::clamp((rh() - prism_h) / 2.0 - 8.0, 0.0, 400.0)
              prism_pos.set((lg::clamp(prev.0 + d.wx - last.0, -max_x, max_x), lg::clamp(prev.1 + d.wy - last.1, -max_y, max_y)))
              last_drag.v = (d.wx, d.wy)
            }
            view::DragIs::Up => ()
            view::DragIs::Off => ()
          }
        })
        // Minimal top-left HUD pill
        let _ = prism.box(fn(top_row) {
          let _ = top_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = top_row.box(fn(pill) {
            let _ = pill
            .row(view::Live::Is(true))
            .height(view::Live::Is(Some(24.0)))
            .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
            .radius(view::Live::Is(12.0))
            .gap(view::Live::Is(6.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0x0B0C1080L } else { 0xFFFFFFA6L } }))
            let _ = pill.box(fn(dot) {
              let _ = dot
              .width(view::Live::Is(Some(6.0)))
              .height(view::Live::Is(Some(6.0)))
              .radius(view::Live::Is(3.0))
              .shrink(view::Live::Is(0.0))
              .ground(view::Live::Is(monoid_vermilion))
            })
            let _ = pill.box(fn(lbl) {
              let _ = lbl
              .words(view::Live::Is("DRAG PRISM"), look=words_track(10.5, 600, 0.8))
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
          })
        })
        // Bottom HUD row: live offset coordinates left, prism icon right
        let _ = prism.box(fn(bot_row) {
          let _ = bot_row.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = bot_row.box(fn(coord_pill) {
            let _ = coord_pill
            .height(view::Live::Is(Some(24.0)))
            .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
            .radius(view::Live::Is(12.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0x0B0C1078L } else { 0xFFFFFFA6L } }))
            let _ = coord_pill.box(fn(w) {
              let _ = w
              .words(
                view::Live::By(fn() {
                  let p = clamped_pos()
                  "x \{fmt_signed(p.0)}  y \{fmt_signed(p.1)}"
                }),
                look=lg::words_at(11.0, weight=500),
              )
              .ink(view::Live::By(fn() { lg::colors().content }))
            })
          })
          let _ = bot_row.box(fn(ic_pill) {
            let _ = ic_pill
            .width(view::Live::Is(Some(24.0)))
            .height(view::Live::Is(Some(24.0)))
            .radius(view::Live::Is(12.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .ground(view::Live::By(fn() { if lg::is_dark() { 0x0B0C1078L } else { 0xFFFFFFA6L } }))
            icon_prism(ic_pill, 15.0, fn() { lg::colors().content })
          })
        })
      })
    })
    if stacked {
      let _ = stage_room.height(view::Live::By(fn() { Some(stacked_h()) }))
    } else {
      let _ = stage_room.grow(view::Live::Is(1.0)).min_height(view::Live::Is(Some(stage_least))).max_height(view::Live::Is(Some(stage_most)))
    }
  })
}

/// Scene 0 — `Optics`: left interactive optical stage (Monoid Vermilion sun + inverse-luminance architectural plate +
/// oversized `Invar` wordmark + draggable 268×176 live liquid glass prism) and right 348pt `Glass Inspector`.
/// On narrow viewports (`w < 740pt`), switches to a fixed two-part Flex column: compact live prism stage pinned on top
/// and single-screen compact `OPTICAL PARAMETERS` card below (clearing the floating bottom dock with zero clipping).
fn optics_scene(
  parent : view::View,
  held : Option[Held],
  grid_on : signals::Signal[Bool],
  refraction_val : signals::Signal[Double],
  chroma_val : signals::Signal[Double],
  blur_val : signals::Signal[Double],
  light_angle_val : signals::Signal[Double],
  prism_pos : signals::Signal[(Double, Double)],
  dialog_open : signals::Signal[Bool],
) -> Unit {
  let last_drag = ui::ref_new((0.0, 0.0))
  // Reset global glass light axis angle when leaving/unmounting the Optics stage.
  let _ = parent.owns(fn() { ui::set_glass_light_angle(0.0) })
  let is_stacked = fn() {
    let w = parent.window_w()
    w > 0.0 && w < 740.0
  }
  parent.pick(is_stacked, fn(slot, stacked) {
    let _ = slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
    if stacked {
      let _ = slot.box(fn(col) {
        let _ = col
        .grow(view::Live::Is(1.0))
        .basis(view::Live::Is(Some(0.0)))
        .min_height(view::Live::Is(Some(0.0)))
        .padding(view::Live::By(fn() {
          let w = col.window_w()
          let bot = if w > 0.0 && w < 560.0 { 76.0 } else { 0.0 }
          (0.0, 0.0, 0.0, bot)
        }))
        .gap(view::Live::Is(10.0))
        optics_stage(col, refraction_val, chroma_val, blur_val, prism_pos, last_drag, true)
        let _ = col.box(fn(insp_host) {
          let _ = insp_host
          .grow(view::Live::Is(1.0))
          .basis(view::Live::Is(Some(0.0)))
          .min_height(view::Live::Is(Some(0.0)))
          optics_inspector(insp_host, held, grid_on, refraction_val, chroma_val, blur_val, light_angle_val, prism_pos, dialog_open, true)
        })
      })
    } else {
      let _ = slot.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).gap(view::Live::Is(24.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        optics_stage(row, refraction_val, chroma_val, blur_val, prism_pos, last_drag, false)
        let _ = row.box(fn(insp_col) {
          let _ = insp_col.shrink(view::Live::Is(0.0)).lies_along(view::Live::Is(view::Lies::Middle))
          optics_inspector(insp_col, held, grid_on, refraction_val, chroma_val, blur_val, light_angle_val, prism_pos, dialog_open, false)
        })
      })
    }
  }, at_once=true)
}

/// Scene 1 — `Deck`: centered symmetric two-column Bento (`max_width: 980`) with full 2×2 Monoid hardware deck +
/// semantic buttons on the left and a live continuous `Adaptive Luminance` bench on the right.
fn deck_scene(
  parent : view::View,
  held : Option[Held],
  grid_on : signals::Signal[Bool],
  boost : signals::Signal[Bool],
  live_lum : signals::Signal[Double],
  build_count : signals::Signal[Int],
  last_action : signals::Signal[String],
  reset_all : () -> Unit,
) -> Unit {
  let _ = parent.box(fn(wrap) {
    let _ = wrap.grow(view::Live::Is(1.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
    let _ = wrap.box(fn(bento) {
      let _ = bento
      .row(view::Live::Is(true))
      .width(view::Live::Is(Some(980.0)))
      .max_width(view::Live::Is(Some(980.0)), within=true)
      .gap(view::Live::Is(24.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      // Left column: 2x2 full deck + action tiles + status capsule + 2x2 buttons
      let _ = bento.box(fn(left) {
        let _ = left.grow(view::Live::Is(1.0)).gap(view::Live::Is(18.0))
        let _ = left.box(fn(hdr) {
          let _ = hdr
          .words(view::Live::Is("STUDIO DECK & ACTIONS"), look=words_track(11.0, 600, 0.9))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.60) }))
        })
        let _ = left.box(fn(deck_row) {
          let _ = deck_row.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let wide = lg::tile_size * 2.0 + lg::tile_gap
          let _ = lg::liquid_card_node(
            deck_row,
            wide,
            wide,
            fn() { "Studio controls" },
            radius=lg::tile_inner / 2.0 + lg::tile_gap,
            light?=held_tile(held),
            press=fn() { },
            content=fn(c) {
              let _ = c.padding(view::Live::Is((lg::tile_gap, lg::tile_gap, lg::tile_gap, lg::tile_gap))).lies_along(view::Live::Is(view::Lies::Between))
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { lg::is_dark() },
                  fn(v) {
                    lg::set_dark(Some(v))
                    last_action.set(if v { "Dark Studio" } else { "Light Studio" })
                  },
                  fn() { "Dark Studio" },
                  icon=fn(box, _ink) {
                    let deck_ink = fn() { if lg::is_dark() { lg::white } else { 0x1C2430D9L } }
                    box.pick(fn() { lg::is_dark() }, fn(inner, d) {
                      if d {
                        icon_moon(inner, 26.0, deck_ink)
                      } else {
                        icon_sun(inner, 26.0, deck_ink)
                      }
                    }, at_once=true)
                  },
                )
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { grid_on.get() },
                  fn(v) {
                    grid_on.set(v)
                    last_action.set(if v { "Grid enabled" } else { "Grid hidden" })
                  },
                  fn() { "Optical Grid" },
                  icon=fn(box, _ink) {
                    icon_grid(box, 26.0, fn() {
                      if grid_on.get() || lg::is_dark() { lg::white } else { 0x1C2430D9L }
                    })
                  },
                )
              })
              let _ = c.box(fn(rr) {
                let _ = rr.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between))
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { boost.get() },
                  fn(v) {
                    boost.set(v)
                    last_action.set(if v { "Glow boost on" } else { "Glow boost off" })
                  },
                  fn() { "Glow Boost" },
                  icon=fn(box, _ink) {
                    icon_bolt(box, 26.0, fn() {
                      if boost.get() || lg::is_dark() { lg::white } else { 0x1C2430D9L }
                    })
                  },
                )
                // Fourth symmetric slot: Quick Reset
                let _ = lg::liquid_control_item_node(
                  rr,
                  fn() { false },
                  fn(_) { reset_all() },
                  fn() { "Quick Reset" },
                  icon=fn(box, _ink) {
                    icon_refresh(box, 24.0, fn() { if lg::is_dark() { lg::white } else { 0x1C2430D9L } })
                  },
                )
              })
            },
          )
          let _ = deck_row.box(fn(col) {
            let _ = col.gap(view::Live::Is(lg::tile_gap))
            let _ = col.box(fn(rr) {
              let _ = rr.row(view::Live::Is(true)).gap(view::Live::Is(lg::tile_gap)).lines_up(view::Live::Is(Some(view::Along::Middle)))
              let tile_ink = fn() { if lg::is_dark() { lg::white } else { 0x1C2430E6L } }
              let _ = lg::liquid_control_tile_node(
                rr,
                fn() { "Play pulse" },
                fn() { last_action.set("Pulse · 60 fps") },
                icon=fn(box, _ink) { icon_play(box, 26.0, tile_ink) },
              )
              let _ = lg::liquid_control_tile_node(
                rr,
                fn() { "Reset" },
                fn() { reset_all() },
                angle=135.0,
                icon=fn(box, _ink) { icon_refresh(box, 26.0, tile_ink) },
              )
            })
            let _ = lg::liquid_card_node(
              col,
              wide,
              lg::tile_size,
              fn() { "Studio status" },
              content=fn(c) {
                let _ = c
                .row(view::Live::Is(true))
                .padding(view::Live::Is((16.0, 0.0, 16.0, 0.0)))
                .lines_up(view::Live::Is(Some(view::Along::Middle)))
                .gap(view::Live::Is(10.0))
                .clips(view::Live::Is(true))
                let _ = c.box(fn(dot) {
                  let _ = dot
                  .width(view::Live::Is(Some(6.0)))
                  .height(view::Live::Is(Some(6.0)))
                  .radius(view::Live::Is(3.0))
                  .shrink(view::Live::Is(0.0))
                  .ground(view::Live::Is(monoid_vermilion))
                })
                let _ = c.box(fn(info) {
                  let _ = info.grow(view::Live::Is(1.0)).gap(view::Live::Is(1.0)).clips(view::Live::Is(true))
                  let _ = info.box(fn(main_lbl) {
                    let _ = main_lbl
                    .words(view::Live::Is("Invar"), look=words_line(13.0, 600, 16.0))
                    .ink(view::Live::By(fn() { lg::colors().content }))
                  })
                  let _ = info.box(fn(sub_lbl) {
                    let _ = sub_lbl
                    .words(view::Live::By(fn() { last_action.get() }), look=words_line(11.0, 400, 14.0))
                    .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.68) }))
                  })
                })
              },
            )
          })
        })
        // 2x2 semantic LiquidButton group
        let _ = left.box(fn(btns) {
          let _ = btns.gap(view::Live::Is(12.0))
          let _ = btns.box(fn(r1) {
            let _ = r1.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = lg::liquid_button_node(
              r1,
              fn() { "Build Native" },
              fn() {
                let n = build_count.untracked() + 1
                build_count.set(n)
                last_action.set("Built · #\{n}")
              },
            )
            let _ = lg::liquid_button_node(
              r1,
              fn() { "Inspect Tree" },
              fn() { last_action.set("Inspected tree") },
              surface=0xFFFFFF4DL,
            )
          })
          let _ = btns.box(fn(r2) {
            let _ = r2.row(view::Live::Is(true)).gap(view::Live::Is(12.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = lg::liquid_button_node(
              r2,
              fn() { "Publish Release" },
              fn() { last_action.set("Ready to publish") },
              tint=monoid_vermilion,
            )
            let _ = lg::liquid_button_node(
              r2,
              fn() { "Preview Wasm" },
              fn() { last_action.set("Wasm preview live") },
              tint=0x1D68F5FFL,
            )
          })
        })
      })
      // Right column: interactive Adaptive Luminance bench (440pt wide, content-layer surface)
      let _ = bento.box(fn(right) {
        let _ = right
        .width(view::Live::Is(Some(440.0)))
        .shrink(view::Live::Is(0.0))
        .radius(view::Live::Is(44.0))
        .padding(view::Live::Is((20.0, 20.0, 20.0, 20.0)))
        .gap(view::Live::Is(14.0))
        inspector_surface(right)
        let _ = right.box(fn(rh) {
          let _ = rh.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          let _ = rh.box(fn(l) {
            let _ = l
            .words(view::Live::Is("ADAPTIVE LUMINANCE"), look=words_track(11.0, 600, 0.9))
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.62) }))
          })
          let _ = rh.box(fn(r) {
            let _ = r
            .words(view::Live::Is("LIVE BENCH"), look=words_track(10.5, 500, 0.6))
            .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.50) }))
          })
        })
        param_slider(
          right,
          "Backdrop Luminance",
          fn() { fmt_unit(live_lum.get()) },
          fn() { live_lum.get() },
          fn(v) { live_lum.set(v) },
          0.0,
          100.0,
        )
        let _ = right.box(fn(plates) {
          let _ = plates.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
          // Left: dynamic live-luminance plate
          let _ = plates.box(fn(b) {
            let _ = b
            .width(view::Live::Is(Some(192.0)))
            .height(view::Live::Is(Some(184.0)))
            .radius(view::Live::Is(24.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .ground(view::Live::By(fn() { lg::lerp_color(0x14151BFFL, 0xF5F3EEFFL, lg::clamp(live_lum.get() / 100.0, 0.0, 1.0)) }))
            plate_stripes(
              b,
              24.0,
              fn() { lg::lerp_color(0x2A2D38FFL, 0xDDD8CEFFL, lg::clamp(live_lum.get() / 100.0, 0.0, 1.0)) },
              26.0,
              26.0,
            )
            let _ = lg::liquid_adaptive_surface_node(b, fn() { lg::clamp(live_lum.get() / 100.0, 0.0, 1.0) }, size=136.0)
          })
          // Right: fixed dark reference plate (0.08)
          let _ = plates.box(fn(b) {
            let _ = b
            .width(view::Live::Is(Some(192.0)))
            .height(view::Live::Is(Some(184.0)))
            .radius(view::Live::Is(24.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .lies_along(view::Live::Is(view::Lies::Middle))
            .ground(view::Live::Is(0x14151BFFL))
            plate_stripes(b, 24.0, fn() { 0x2A2D38FFL }, 26.0, 26.0)
            let _ = lg::liquid_adaptive_surface_node(b, fn() { 0.08 }, size=136.0)
          })
        })
      })
    })
  })
}

/// Inner two-tier Loupe specimen column shared by desktop centered and narrow scrollable `loupe_scene`.
fn loupe_content(parent : view::View, compact : Bool) -> Unit {
  let _ = parent.box(fn(col) {
    if compact {
      let _ = col.max_width(view::Live::Is(Some(640.0)), within=true).gap(view::Live::Is(16.0))
    } else {
      let _ = col.width(view::Live::Is(Some(640.0))).max_width(view::Live::Is(Some(640.0)), within=true).gap(view::Live::Is(18.0))
    }
    // Top tier: Progressive Blur
    let _ = col.box(fn(sec1) {
      let _ = sec1.gap(view::Live::Is(10.0))
      let _ = sec1.box(fn(lbl) {
        let _ = lbl
        .words(view::Live::Is("PROGRESSIVE BLUR"), look=words_track(11.0, 600, 0.9))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.60) }))
      })
      let _ = sec1.box(fn(b) {
        let _ = b.radius(view::Live::Is(24.0)).clips(view::Live::Is(true))
        let _ = b.box(fn(text) {
          let _ = text
          .padding(view::Live::Is(if compact { (16.0, 16.0, 16.0, 16.0) } else { (22.0, 20.0, 22.0, 20.0) }))
          .ground(view::Live::By(fn() { lg::alpha(lg::colors().paper, 0.56) }))
          let _ = text.box(fn(t) {
            let _ = t
            .words(view::Live::Is(progressive_copy), look=lg::words_at(if compact { 14.0 } else { 15.5 }, wrap=true))
            .ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
        let _ = b.box(fn(o) {
          let _ = o.over(view::Live::Is(true))
          let _ = lg::liquid_progressive_blur_node(o, words=fn() { "Progressive Blur · Invar" }, height=74.0)
        })
      })
    })
    // Bottom tier: Optical Loupe over Pion source code
    let _ = col.box(fn(sec2) {
      let _ = sec2.gap(view::Live::Is(10.0))
      let _ = sec2.box(fn(lbl) {
        let _ = lbl
        .words(view::Live::Is("OPTICAL LOUPE · PION SOURCE"), look=words_track(11.0, 600, 0.9))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.60) }))
      })
      let _ = lg::liquid_magnifier_node(
        sec2,
        fn() { if compact { loupe_source_copy_compact } else { loupe_source_copy } },
        label=fn() { "Optical Loupe" },
        at=if compact { (88.0, 60.0) } else { (192.0, 108.0) },
      )
    })
  })
}

/// Scene 2 — `Loupe`: centered compact two-tier specimen stage (`max_width: 960`) with single-layer Progressive Blur
/// above and a draggable Pion source Optical Loupe below. Scrolls cleanly on narrow/short viewports.
fn loupe_scene(parent : view::View, embedded_scroll~ : Bool = false) -> Unit {
  let scroll_state = view::Scroll::new()
  let is_compact = fn() {
    let w = parent.window_w()
    w > 0.0 && w < 740.0
  }
  parent.pick(is_compact, fn(slot, compact) {
    let _ = slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
    if compact {
      if embedded_scroll {
        loupe_content(slot, true)
      } else {
        let sc = slot.scrolls(scroll_state, fn(body) {
          let _ = body.padding(view::Live::By(fn() {
            let w = body.window_w()
            let bot = if w > 0.0 && w < 560.0 { 108.0 } else { 20.0 }
            (4.0, 4.0, 4.0, bot)
          }))
          loupe_content(body, true)
        }, slop=ui::touch_slop(), bar=ui::tree_scroll_bar())
        let _ = sc.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
      }
    } else {
      let _ = slot.box(fn(wrap) {
        let _ = wrap.grow(view::Live::Is(1.0)).lines_up(view::Live::Is(Some(view::Along::Middle))).lies_along(view::Live::Is(view::Lies::Middle))
        loupe_content(wrap, false)
      })
    }
  }, at_once=true)
}

/// Compact law row in the Capillary Hysteresis telemetry card: left label, right formula readout.
fn merge_law_row(parent : view::View, title : String, formula : String) -> Unit {
  let _ = parent.box(fn(r) {
    let _ = r.row(view::Live::Is(true)).wraps(view::Live::Is(Some(4.0))).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle))).gap(view::Live::Is(8.0))
    let _ = r.box(fn(l) {
      let _ = l
      .words(view::Live::Is(title), look=lg::words_at(11.5, weight=600))
      .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
    })
    let _ = r.box(fn(v) {
      let _ = v
      .words(view::Live::Is(formula), look=lg::words_at(11.0, weight=500))
      .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.56) }))
    })
  })
}

/// Shared `CAPILLARY HYSTERESIS` telemetry & control island for desktop split and narrow stacked `merge_scene`.
fn merge_inspector(
  parent : view::View,
  merge_ctrl : lg::LiquidMerge,
  insp_ref : ui::Ref[Option[view::View]],
  cause_at : () -> Double,
  stacked : Bool,
) -> Unit {
  let _ = parent.box(fn(insp) {
    insp_ref.v = Some(insp)
    if !stacked {
      let _ = insp.width(view::Live::Is(Some(348.0))).shrink(view::Live::Is(0.0))
    }
    let _ = insp
    .radius(view::Live::Is(if stacked { 40.0 } else { 44.0 }))
    .padding(view::Live::Is(if stacked { (16.0, 16.0, 16.0, 16.0) } else { (20.0, 18.0, 20.0, 20.0) }))
    .gap(view::Live::Is(12.0))
    .shadow(view::Live::Is(lg::shadow_default))
    .shadow_outside(view::Live::Is(true))
    .glass(view::Live::By(fn() { Some(inspector_glass()) }))
    // Header row
    let _ = insp.box(fn(ih) {
      let _ = ih.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = ih.box(fn(l) {
        let _ = l
        .words(view::Live::Is("CAPILLARY HYSTERESIS"), look=words_track(11.0, 600, 0.9))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.62) }))
      })
      let _ = ih.box(fn(r) {
        let _ = r
        .words(view::Live::Is("iOS 27 BOND"), look=lg::words_at(11.0, weight=500))
        .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.52) }))
      })
    })
    // Live bond status capsule (`BONDED` / `SEPARATED`)
    let _ = insp.box(fn(status_row) {
      let _ = status_row.row(view::Live::Is(true)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = status_row.box(fn(badge) {
        let _ = badge
        .row(view::Live::Is(true))
        .height(view::Live::Is(Some(26.0)))
        .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
        .radius(view::Live::Is(13.0))
        .gap(view::Live::Is(7.0))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0E7AL } else { 0x1417200FL } }))
        .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF18L } else { 0x14172016L }) }))
        let _ = badge.box(fn(dot) {
          let _ = dot
          .width(view::Live::Is(Some(7.0)))
          .height(view::Live::Is(Some(7.0)))
          .radius(view::Live::Is(3.5))
          .shrink(view::Live::Is(0.0))
          .ground(view::Live::By(fn() {
            let _ = merge_ctrl.merge_on(dot)
            let _ = merge_ctrl.is_separated()
            if merge_ctrl.is_bonded() {
              monoid_vermilion
            } else {
              lg::alpha(lg::colors().content, 0.42)
            }
          }))
        })
        let _ = badge.box(fn(lbl) {
          let _ = lbl
          .words(
            view::Live::By(fn() {
              let _ = merge_ctrl.merge_on(lbl)
              let _ = merge_ctrl.is_separated()
              if merge_ctrl.is_bonded() { "BONDED" } else { "SEPARATED" }
            }),
            look=words_track(10.5, 600, 0.9),
          )
          .ink(view::Live::By(fn() { lg::colors().content }))
        })
      })
    })
    // Live numeric telemetry (`Surface Gap` & `Smooth Merge k`)
    let _ = insp.box(fn(telem) {
      let _ = telem
      .radius(view::Live::Is(14.0))
      .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
      .gap(view::Live::Is(8.0))
      .ground(view::Live::By(fn() { if lg::is_dark() { 0x090A0E7AL } else { 0x1417200FL } }))
      .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF14L } else { 0x14172014L }) }))
      let _ = telem.box(fn(r1) {
        let _ = r1.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = r1.box(fn(l) {
          let _ = l
          .words(view::Live::Is("Surface Gap"), look=lg::words_at(12.5, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
        })
        let _ = r1.box(fn(v) {
          let _ = v
          .words(
            view::Live::By(fn() { "\{fmt_signed_tenth(merge_ctrl.gap_on(v))} pt" }),
            look=lg::words_at(12.5, weight=600),
          )
          .ink(view::Live::By(fn() { lg::colors().content }))
        })
      })
      let _ = telem.box(fn(r2) {
        let _ = r2.row(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Between)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = r2.box(fn(l) {
          let _ = l
          .words(view::Live::Is("Smooth Merge k"), look=lg::words_at(12.5, weight=500))
          .ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.78) }))
        })
        let _ = r2.box(fn(v) {
          let _ = v
          .words(
            view::Live::By(fn() { "\{fmt_tenth(lg::clamp(merge_ctrl.merge_on(v), 0.0, 99.9))} pt" }),
            look=lg::words_at(12.5, weight=600),
          )
          .ink(view::Live::By(fn() { lg::colors().content }))
        })
      })
    })
    // Hairline separator + 3 capillary hysteresis physics laws
    let _ = insp.box(fn(sep) {
      let _ = sep.height(view::Live::Is(Some(1.0))).ground(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.12) }))
    })
    let _ = insp.box(fn(laws) {
      let _ = laws.gap(view::Live::Is(6.0))
      merge_law_row(laws, "Pinch-Off", "gap >= 9.5 pt -> snap 0")
      merge_law_row(laws, "Approach", "gap > 0 pt -> zero pull")
      merge_law_row(laws, "Coalesce", "gap <= 0 pt -> liquid bloom")
    })
    // Action row: primary programmatic Split/Fuse + concentric Reset pill
    let _ = insp.box(fn(acts) {
      let _ = acts.row(view::Live::Is(true)).gap(view::Live::Is(10.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = acts.box(fn(b1) {
        let _ = b1.grow(view::Live::Is(1.0))
        let _ = lg::liquid_button_node(
          b1,
          fn() { if merge_ctrl.is_separated() { "Fuse Droplet" } else { "Split Droplet" } },
          fn() { merge_ctrl.set_separated(!merge_ctrl.is_separated(), at=cause_at()) },
          tint=monoid_vermilion,
          flat=true,
        )
      })
      let _ = headless::button(
        acts,
        fn() { "Reset" },
        fn(_) { merge_ctrl.set_separated(false, at=cause_at()) },
        fn(b, btn) {
          let _ = b
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(48.0)))
          .padding(view::Live::Is((18.0, 0.0, 18.0, 0.0)))
          .radius(view::Live::Is(24.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
          .ground(view::Live::By(fn() {
            let d = lg::is_dark()
            if btn.pressed() || btn.hovered() {
              if d { 0xFFFFFF24L } else { 0x14172018L }
            } else if d {
              0xFFFFFF14L
            } else {
              0xFFFFFFA8L
            }
          }))
          .edge(view::Live::By(fn() { (1.0, if lg::is_dark() { 0xFFFFFF22L } else { 0x1417201AL }) }))
          let _ = b.box(fn(w) {
            let _ = w.words(view::Live::Is("Reset"), look=lg::words_at(14.0, weight=500)).ink(view::Live::By(fn() { lg::colors().content }))
          })
          b.show(fn() { btn.focus_shown() }, fn(ring) {
            let _ = ring
            .over(view::Live::Is(true))
            .margin(view::Live::Is((-3.0, -3.0, -3.0, -3.0)))
            .radius(view::Live::Is(27.0))
            .edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
          })
        },
      )
    })
  })
}

/// Shared interactive 360° 2D capillary liquid bridge stage for desktop split and narrow stacked `merge_scene`.
fn merge_stage(parent : view::View, merge_ctrl : lg::LiquidMerge, stacked : Bool) -> Unit {
  let _ = parent.box(fn(stage_host) {
    if stacked {
      let _ = stage_host.height(view::Live::Is(Some(300.0))).clips(view::Live::Is(true)).radius(view::Live::Is(24.0))
    } else {
      let _ = stage_host.grow(view::Live::Is(1.0)).fills_across(view::Live::Is(true)).lies_along(view::Live::Is(view::Lies::Middle))
    }
    let stage_room = stage_host.by_room(fn(stage, room) {
      let _ = stage.grow(view::Live::Is(1.0))
      let rw = fn() { room.width() }
      let rh = fn() {
        match room.height() {
          Some(v) => v
          None => if stacked { 300.0 } else { stage_most }
        }
      }
      let orb_d = if stacked { 136.0 } else { 180.0 }
      let plate_w = if stacked { 176.0 } else { 240.0 }
      let plate_h = if stacked { 96.0 } else { 120.0 }
      // 1. Soft Monoid Vermilion orb
      let _ = stage.box(fn(orb) {
        let _ = orb
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(orb_d)))
        .height(view::Live::Is(Some(orb_d)))
        .radius(view::Live::Is(orb_d / 2.0))
        .offset(view::Live::By(fn() { (rw() * 0.28 - orb_d / 2.0, rh() * 0.34 - orb_d / 2.0) }))
        .ground(view::Live::Is(monoid_vermilion))
      })
      // 2. Inverse-luminance architectural calibration plate
      let _ = stage.box(fn(plate) {
        let _ = plate
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .width(view::Live::Is(Some(plate_w)))
        .height(view::Live::Is(Some(plate_h)))
        .radius(view::Live::Is(if stacked { 22.0 } else { 26.0 }))
        .clips(view::Live::Is(true))
        .offset(view::Live::By(fn() {
          if stacked {
            (rw() * 0.60 - plate_w / 2.0, rh() * 0.56 - plate_h / 2.0)
          } else {
            (rw() * 0.56 - 96.0, rh() * 0.54 - 60.0)
          }
        }))
        .ground(view::Live::By(fn() { if lg::is_dark() { 0xF5F2EBFFL } else { 0x151720FFL } }))
        plate_stripes(
          plate,
          if stacked { 22.0 } else { 26.0 },
          fn() { if lg::is_dark() { 0xDDD8CEFFL } else { 0x292D3BFFL } },
          if stacked { 14.0 } else { 18.0 },
          if stacked { 16.0 } else { 18.0 },
        )
      })
      // 3. Low-opacity oversized architectural watermark `capillary`
      let _ = stage.box(fn(wm) {
        let _ = wm
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .offset(view::Live::By(fn() {
          if stacked {
            (rw() * 0.5 - 112.0, rh() * 0.74 - 24.0)
          } else {
            (rw() * 0.5 - 186.0, rh() * 0.72 - 36.0)
          }
        }))
        .words(view::Live::Is("capillary"), look=lg::words_at(if stacked { 52.0 } else { 88.0 }, weight=700))
        .ink(view::Live::By(fn() { if lg::is_dark() { 0xFFFFFF1EL } else { 0x14172018L } }))
      })
      // 4. Top-left HUD pill
      let _ = stage.box(fn(hud_wrap) {
        let _ = hud_wrap
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .padding(view::Live::Is((10.0, 10.0, 0.0, 0.0)))
        .lines_up(view::Live::Is(Some(view::Along::Start)))
        let _ = hud_wrap.box(fn(pill) {
          let _ = pill
          .row(view::Live::Is(true))
          .height(view::Live::Is(Some(24.0)))
          .padding(view::Live::Is((10.0, 0.0, 10.0, 0.0)))
          .radius(view::Live::Is(12.0))
          .gap(view::Live::Is(6.0))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .ground(view::Live::By(fn() { if lg::is_dark() { 0x0B0C1080L } else { 0xFFFFFFA6L } }))
          let _ = pill.box(fn(dot) {
            let _ = dot
            .width(view::Live::Is(Some(6.0)))
            .height(view::Live::Is(Some(6.0)))
            .radius(view::Live::Is(3.0))
            .shrink(view::Live::Is(0.0))
            .ground(view::Live::Is(monoid_vermilion))
          })
          let _ = pill.box(fn(lbl) {
            let _ = lbl
            .words(
              view::Live::Is(if stacked { "DRAG 360° · TOUCH TO FUSE" } else { "DRAG 360° FREELY · TOUCH ANY EDGE TO FUSE" }),
              look=words_track(10.5, 600, 0.8),
            )
            .ink(view::Live::By(fn() { lg::colors().content }))
          })
        })
      })
      // 5. Full-stage hero 360° 2D liquid merge arena
      let _ = stage.box(fn(arena_wrap) {
        let _ = arena_wrap.over(view::Live::Is(true))
        let _ = lg::liquid_merge_node(
          arena_wrap,
          controller=merge_ctrl,
          main_w=if stacked { 160.0 } else { 192.0 },
          main_h=if stacked { 54.0 } else { 60.0 },
          sat_size=if stacked { 56.0 } else { 64.0 },
          arena=fn() { (rw(), rh()) },
          main_label=fn() { "Liquid Capsule" },
          sat_label=fn() { "+" },
          label=fn() { "Drag Droplet" },
        )
      })
    })
    if stacked {
      let _ = stage_room.height(view::Live::Is(Some(300.0)))
    } else {
      let _ = stage_room.grow(view::Live::Is(1.0)).min_height(view::Live::Is(Some(stage_least))).max_height(view::Live::Is(Some(stage_most)))
    }
  })
}

/// Scene 3 — `Merge`: two-column iOS 27 360° 2D capillary liquid bridge arena (left full-stage responsive 2D free-drag
/// arena over high-contrast non-glass targets; right 348pt `Capillary Hysteresis` telemetry & control island driving
/// the same droplet). Automatically stacks vertically inside a scroll container when narrower than `740pt`.
fn merge_scene(parent : view::View, merge_ctrl : lg::LiquidMerge, embedded_scroll~ : Bool = false) -> Unit {
  let insp_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
  let cause_at = fn() -> Double {
    match insp_ref.v {
      Some(n) => n.cause_at()
      None => 0.0
    }
  }
  let scroll_state = view::Scroll::new()
  let is_stacked = fn() {
    let w = parent.window_w()
    w > 0.0 && w < 740.0
  }
  parent.pick(is_stacked, fn(slot, stacked) {
    let _ = slot.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
    if stacked {
      if embedded_scroll {
        let _ = slot.box(fn(col) {
          let _ = col.gap(view::Live::Is(14.0))
          merge_stage(col, merge_ctrl, true)
          merge_inspector(col, merge_ctrl, insp_ref, cause_at, true)
        })
      } else {
        let sc = slot.scrolls(scroll_state, fn(col) {
          let _ = col
          .padding(view::Live::By(fn() {
            let w = col.window_w()
            let bot = if w > 0.0 && w < 560.0 { 108.0 } else { 20.0 }
            (4.0, 4.0, 4.0, bot)
          }))
          .gap(view::Live::Is(14.0))
          merge_stage(col, merge_ctrl, true)
          merge_inspector(col, merge_ctrl, insp_ref, cause_at, true)
        }, slop=ui::touch_slop(), bar=ui::tree_scroll_bar())
        let _ = sc.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0)))
      }
    } else {
      let _ = slot.box(fn(row) {
        let _ = row.row(view::Live::Is(true)).grow(view::Live::Is(1.0)).gap(view::Live::Is(24.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        merge_stage(row, merge_ctrl, false)
        let _ = row.box(fn(insp_col) {
          let _ = insp_col.shrink(view::Live::Is(0.0)).lies_along(view::Live::Is(view::Lies::Middle))
          merge_inspector(insp_col, merge_ctrl, insp_ref, cause_at, false)
        })
      })
    }
  }, at_once=true)
}

/// How far the dock lies from the window's foot.
let dock_gap : Double = 18.0

/// What the stage keeps clear at its foot for the dock over it: the dock's gap, its 64 and the stage's 14 between.
let dock_room : Double = dock_gap + 64.0 + 14.0

/// Spatial Optical Stage: full-viewport two-tier Flex column (zero outer scroll) with top Studio Bar and reactive
/// 4-scene stage (`Optics` / `Deck` / `Loupe` / `Merge`), and over it the bottom centered floating glass Dock
/// (`468 × 64`), where it is whatever the scene.
fn overview(
  root : view::View,
  held : Option[Held],
  top : Double,
  grid_on : signals::Signal[Bool],
  boost : signals::Signal[Bool],
  dialog_open : signals::Signal[Bool],
) -> Unit {
  let scene = signals::signal(0)
  let refraction_val = signals::signal(28.0)
  let chroma_val = signals::signal(6.0)
  let blur_val = signals::signal(1.5)
  let light_angle_val = signals::signal(0.0)
  let initial_prism = match held {
    Some(_) => (36.0, -18.0)
    None => (0.0, 0.0)
  }
  let prism_pos = signals::signal_by(initial_prism, pair_d_eq)
  let live_lum = signals::signal(88.0)
  let build_count = signals::signal(0)
  let last_action = signals::signal("60 fps · SDF Glass")
  let drag_ctrl = lg::LiquidMerge::new(separated=false)
  let reset_all = fn() {
    prism_pos.set((0.0, 0.0))
    refraction_val.set(28.0)
    chroma_val.set(6.0)
    blur_val.set(1.5)
    light_angle_val.set(0.0)
    ui::set_glass_light_angle(0.0)
    live_lum.set(88.0)
    grid_on.set(true)
    boost.set(false)
    last_action.set("60 fps · SDF Glass")
  }
  let _ = root.box(fn(stage_col) {
    let _ = stage_col
    .grow(view::Live::Is(1.0))
    .clips(view::Live::Is(true))
    .padding(view::Live::Is((28.0, 18.0 + top, 28.0, dock_room)))
    .gap(view::Live::Is(14.0))
    // 1. Top Studio Bar (height 36)
    studio_bar(stage_col, dialog_open)
    // 2. Center Main Stage (switched by bottom Dock)
    let _ = stage_col.box(fn(center) {
      let _ = center.grow(view::Live::Is(1.0)).clips(view::Live::Is(true))
      center.pick(fn() { scene.get() }, fn(scene_host, idx) {
        let _ = scene_host.grow(view::Live::Is(1.0)).clips(view::Live::Is(true))
        match idx {
          1 => deck_scene(scene_host, held, grid_on, boost, live_lum, build_count, last_action, reset_all)
          2 => loupe_scene(scene_host)
          3 => merge_scene(scene_host, drag_ctrl)
          _ =>
          optics_scene(
            scene_host,
            held,
            grid_on,
            refraction_val,
            chroma_val,
            blur_val,
            light_angle_val,
            prism_pos,
            dialog_open,
          )
        }
      }, at_once=true)
    })
  })
  // 3. Bottom Centered Floating Glass Dock (468 × 64): over the stage, `dock_gap` from the window's foot whatever the
  // scene, so choosing one never moves it; the stage keeps `dock_room` clear under it
  let _ = root.box(fn(dock_row) {
    let _ = dock_row
    .over(view::Live::Is(true))
    .points(view::Live::Is(false))
    .lies_along(view::Live::Is(view::Lies::End))
    .lines_up(view::Live::Is(Some(view::Along::Middle)))
    .padding(view::Live::Is((0.0, 0.0, 0.0, dock_gap)))
    let _ = dock_row.box(fn(dock_w) {
      let _ = dock_w.width(view::Live::Is(Some(468.0))).shrink(view::Live::Is(0.0)).points(view::Live::Is(true))
      let _ = lg::liquid_bottom_tabs_node(
        dock_w,
        ["Optics", "Deck", "Loupe", "Merge"],
        fn() { scene.get() },
        fn(i) { scene.set(i) },
        label="Stage scenes",
        faces=[
          studio_tab_face("Optics", icon_prism),
          studio_tab_face("Deck", icon_sliders),
          studio_tab_face("Loupe", icon_terminal),
          studio_tab_face("Merge", icon_merge),
        ],
        drag?=held_tabs(held),
        light?=held_tabs_light(held),
      )
    })
  })
  match held {
    Some(h) =>
    signals::untracked(fn() {
      h.button.down(60.0, 24.0, 148.0, 48.0)
      h.button.moved(96.0, 30.0)
      h.toggle.press()
      h.slider.press()
      h.tabs.press()
      h.tabs.update_value(0.55)
      h.tabs_light.down(80.0, 32.0, 468.0, 64.0)
    })
    None => ()
  }
}

/// The film's page: the parts its script drags, each where the script finds it (src/shots, film_script): 40 in from
/// the window's top left (`top` more down), 40 apart down it, 520 wide.
fn film_page(root : view::View, top : Double) -> Unit {
  let on = signals::signal(false)
  let level = signals::signal(30.0)
  let tab = signals::signal(0)
  let _ = root.box(fn(page) {
    let _ = page.grow(view::Live::Is(1.0)).gap(view::Live::Is(40.0)).padding(view::Live::Is((40.0, 40.0 + top, 40.0, 40.0))).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = lg::liquid_button_node(page, fn() { "Build Native" }, fn() { })
    let _ = lg::liquid_toggle_node(page, fn() { on.get() }, fn(v) { on.set(v) }, fn() { "Toggle" })
    let _ = page.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(520.0)))
      let _ = lg::liquid_slider_node(b, fn() { level.get() }, fn(v) { level.set(v) }, fn() { "Slider" })
    })
    let _ = page.box(fn(b) {
      let _ = b.width(view::Live::Is(Some(520.0)))
      let _ = lg::liquid_bottom_tabs_node(
        b,
        ["Home", "Layers", "Motion", "Tokens"],
        fn() { tab.get() },
        fn(i) { tab.set(i) },
        label="Modules",
        faces=[
          studio_tab_face("Home", icon_brand_mark),
          studio_tab_face("Layers", icon_layers),
          studio_tab_face("Motion", icon_spark),
          studio_tab_face("Tokens", icon_terminal),
        ],
      )
    })
  })
}

/// The liquid merge & split page: interactive capillary drag + programmatic button toggle over the wallpaper.
fn merge_page(root : view::View, top : Double) -> Unit {
  let drag_ctrl = lg::LiquidMerge::new(separated=false)
  let toggle_ctrl = lg::LiquidMerge::new(separated=false)
  let _ = root.box(fn(page) {
    let _ = page.grow(view::Live::Is(1.0)).gap(view::Live::Is(36.0)).padding(view::Live::Is((48.0, 48.0 + top, 48.0, 48.0))).lines_up(view::Live::Is(Some(view::Along::Start)))
    let _ = page.box(fn(s) {
      let _ = s.gap(view::Live::Is(12.0))
      let _ = s.box(fn(t) {
        let _ = t.words(view::Live::Is("Drag to Split & Fuse"), look=lg::words_at(13.0, weight=600)).ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.6) }))
      })
      let _ = lg::liquid_merge_node(s, controller=drag_ctrl, arena_w=640.0, arena_h=280.0, label=fn() { "Drag Droplet" })
    })
    let _ = page.box(fn(s) {
      let _ = s.gap(view::Live::Is(12.0))
      let _ = s.box(fn(t) {
        let _ = t.words(view::Live::Is("Programmatic Split / Merge"), look=lg::words_at(13.0, weight=600)).ink(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.6) }))
      })
      let _ = s.box(fn(r) {
        let _ = r.row(view::Live::Is(true)).gap(view::Live::Is(16.0)).lines_up(view::Live::Is(Some(view::Along::Middle)))
        let _ = lg::liquid_merge_node(r, controller=toggle_ctrl, label=fn() { "Toggle Droplet" })
        let btn_ref : ui::Ref[Option[view::View]] = ui::ref_new(None)
        let btn = lg::liquid_button_node(
          r,
          fn() { if toggle_ctrl.is_separated() { "Merge" } else { "Split" } },
          fn() {
            let at = match btn_ref.v {
              Some(n) => n.cause_at()
              None => 0.0
            }
            toggle_ctrl.set_separated(!toggle_ctrl.is_separated(), at=at)
          },
        )
        btn_ref.v = Some(btn)
      })
    })
  })
}
