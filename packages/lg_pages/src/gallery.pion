// The gallery around the pages: the page asked for first, under a bar of glass at the window's top middle that chooses
// the page (Overview, Interactive, Merge, Dialog) and the look (Light, Dark). The bar is the gallery's, not the
// catalog's: its glass is LiquidBottomTabs' (`paint::Glass::liquid`), each choice a capsule in it 4 in, the chosen one
// over a share of the accent. Without `chrome` there is no bar (the page shown in another page, alone).
// Ported 1:1 from libs/liquid-glass/src/pages/gallery.mbt (monoid@1eec0cd3ce).

import "headless"
import "lg"
import "paint"
import "signals"
import "view"

/// The bar's height: a choice's capsule (36) and 4 round it.
pub let bar_h : Double = 44.0

/// How far the bar sits from the window's top.
pub let bar_top : Double = 12.0

/// How far in from the bar's edge a choice's capsule is (the bar's corner 22 less this: a choice's 18).
let bar_pad : Double = 4.0

/// A choice's capsule: its height, and how far in its words are from its sides.
let choice_h : Double = 36.0
let choice_px : Double = 14.0

/// How much of the accent the chosen choice's capsule is.
let chosen_share : Double = 0.24

/// The pages the bar chooses among, each with the name it shows.
pub let gallery_pages : Array[(String, String)] = [
  ("overview", "Overview"),
  ("interactive", "Interactive"),
  ("merge", "Merge"),
  ("dialog", "Dialog"),
]

/// The bar's glass: LiquidBottomTabs' (liquid_bottom_tabs.pion, tabs_glass), unlit.
fn bar_glass() -> paint::Glass {
  let d = lg::is_dark()
  paint::Glass::liquid(
    blur=2.1,
    tint=if d { 0x202020FFL } else { 0xFDFCFD67L },
    solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL },
    saturation=1.0,
    rim=0.6,
    bezel=20.0,
    refraction=28.0,
    chroma=0.0,
    merge=0.0,
    adaptive=false,
  )
}

/// One choice of the bar in `g`, `rg`'s item `key`, showing and read out as `label`: a capsule 36 high, its words in
/// the words' colour; the accent under them where it is the chosen one, the tabs' idle lens colour under a pointer or a
/// finger on it; a ring in the accent where the keyboard's focus is on it.
fn choice[K : view::ViewEq](g : view::View, rg : headless::RadioGroup[K], key : K, label : String) -> Unit {
  let _ = rg.item(g, fn() { key }, fn() { label }, fn(t, it) {
    let _ = t
      .row(view::Live::Is(true))
      .height(view::Live::Is(Some(choice_h)))
      .padding(view::Live::Is((choice_px, 0.0, choice_px, 0.0)))
      .radius(view::Live::Is(choice_h / 2.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      .lies_along(view::Live::Is(view::Lies::Middle))
      .ground(view::Live::By(fn() {
        let c = lg::colors()
        if it.chosen() {
          lg::alpha(c.accent, chosen_share)
        } else if it.pressed() || it.hovered() {
          c.lens_idle
        } else {
          lg::clear
        }
      }))
    let _ = t.box(fn(w) {
      let _ = w
        .words(view::Live::Is(label), look=lg::words_at(14.0, weight=lg::weight_medium))
        .ink(view::Live::By(fn() { lg::colors().content }))
    })
    t.show(fn() { it.focus_shown() }, fn(ring) {
      let _ = ring.over(view::Live::Is(true)).radius(view::Live::Is(choice_h / 2.0)).edge(view::Live::By(fn() { (2.0, lg::colors().accent) }))
    })
  })
}

/// The bar in `parent` (a box over the page, as wide as it): its glass capsule in its middle, `bar_top` from its top,
/// choosing the page `name` holds and the look.
fn bar(parent : view::View, name : signals::Signal[String]) -> Unit {
  let _ = parent.box(fn(over) {
    let _ = over.over(view::Live::Is(true)).padding(view::Live::Is((0.0, bar_top, 0.0, 0.0))).lines_up(view::Live::Is(Some(view::Along::Middle)))
    let _ = over.box(fn(b) {
      let _ = b
        .row(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(bar_pad * 2.0))
        .height(view::Live::Is(Some(bar_h)))
        .padding(view::Live::Is((bar_pad, bar_pad, bar_pad, bar_pad)))
        .radius(view::Live::Is(bar_h / 2.0))
        .shadow(view::Live::Is(lg::shadow_default))
        .shadow_outside(view::Live::Is(true))
        .glass(view::Live::By(fn() { Some(bar_glass()) }))
      let _ = headless::radio_group(b, fn() { "Page" }, fn() { name.get() }, fn(n) { name.set(n) }, fn(g, rg) {
        let _ = g.row(view::Live::Is(true)).gap(view::Live::Is(bar_pad))
        for p in gallery_pages {
          choice(g, rg, p.0, p.1)
        }
      }, kind=headless::GroupKind::Tab)
      let _ = b.box(fn(line) {
        let _ = line.width(view::Live::Is(Some(1.0))).height(view::Live::Is(Some(20.0))).ground(view::Live::By(fn() { lg::alpha(lg::colors().content, 0.12) }))
      })
      let _ = headless::radio_group(b, fn() { "Look" }, fn() { lg::is_dark() }, fn(d) { lg::set_dark(Some(d)) }, fn(g, rg) {
        let _ = g.row(view::Live::Is(true)).gap(view::Live::Is(bar_pad))
        choice(g, rg, false, "Light")
        choice(g, rg, true, "Dark")
      })
    })
  })
}

/// The gallery in the window's `root`: the page named `first` (as `page` makes it; made anew as another is chosen),
/// under the bar where `chrome` says, the parts moved down below it. Closing the dialog page's dialog leaves the
/// overview chosen.
pub fn gallery(root : view::View, first : String, chrome~ : Bool = true) -> Unit {
  let name = signals::signal(first)
  let top = if chrome { bar_top + bar_h } else { 0.0 }
  let _ = root.box(fn(w) {
    let _ = w.grow(view::Live::Is(1.0))
    w.pick(fn() { name.get() }, fn(p, n) {
      let _ = p.grow(view::Live::Is(1.0))
      let page_top = if n == "library" { 0.0 } else { top }
      page(p, n, top=page_top, closed=fn() { name.set("overview") })
    }, at_once=true)
    if chrome {
      w.show(fn() { name.get() != "dialog" && name.get() != "library" }, fn(o) {
        let _ = o.over(view::Live::Is(true))
        bar(o, name)
      })
    }
  })
}
