// Unit tests for mbt2pion-transpiled O(1) generational node slot table `ByNode`.

test "by_node: O(1) put/get/gen-mismatch/remove/keys/swap" {
  let m : ByNode[Int] = ByNode::new()
  let n0 : view::NodeId = { at: 0, gen: 1 }
  let n0_new : view::NodeId = { at: 0, gen: 2 }
  let n3 : view::NodeId = { at: 3, gen: 7 }

  debug_assert(!m.contains(n0), "empty")
  m.put(n0, 42)
  m.put(n3, 99)
  debug_assert(m.count == 2, "count 2")
  debug_assert(match m.get(n0) { Some(v) => v == 42, None => false }, "get n0")
  debug_assert(match m.get(n0_new) { None => true, Some(_) => false }, "stale gen rejected")
  debug_assert(match m.get(n3) { Some(v) => v == 99, None => false }, "get n3")

  let ks = m.keys()
  debug_assert(ks.length() == 2 && ks[0].at == 0 && ks[0].gen == 1 && ks[1].at == 3 && ks[1].gen == 7, "keys order")

  // Overwriting same slot with new gen preserves count
  m.put(n0_new, 77)
  debug_assert(m.count == 2, "count still 2")
  debug_assert(match m.get(n0) { None => true, Some(_) => false }, "old gen evicted")
  debug_assert(match m.get(n0_new) { Some(v) => v == 77, None => false }, "new gen stored")

  // Remove old gen is no-op; remove live gen decrements count
  m.remove(n0)
  debug_assert(m.count == 2, "remove stale gen no-op")
  m.remove(n0_new)
  debug_assert(m.count == 1 && !m.contains(n0_new), "remove live gen")

  // Swap exchanges state cleanly
  let other : ByNode[Int] = ByNode::new()
  m.swap(other)
  debug_assert(m.count == 0 && other.count == 1, "swap counts")
  debug_assert(match other.get(n3) { Some(v) => v == 99, None => false }, "swap value")
}
