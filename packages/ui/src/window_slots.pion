// Multi-window state slots and per-window global swapping.
// Ported from libs/mbui/src/ui/window_slots.mbt and window_kept.mbt.

import "hostapi"
import "view"
import "signals"

pub struct WindowKept {
  pub take : () -> (() -> Unit)
  pub fresh : () -> Unit
}

pub struct WindowSpec {
  pub role : String
  pub title : String
  pub w : Double
  pub h : Double
  pub min_w : Double
  pub min_h : Double
  pub inset : Option[Bool]
  pub what : String
}

pub fn WindowSpec::new(
  what~ : String = "",
  role~ : String = "",
  title~ : String = "",
  w~ : Double = 0.0,
  h~ : Double = 0.0,
  min_w~ : Double = 0.0,
  min_h~ : Double = 0.0,
  inset? : Bool,
) -> WindowSpec {
  WindowSpec::{ role, title, w, h, min_w, min_h, inset, what }
}

let windows_kept : Array[WindowKept] = []
let window_now : Ref[Int] = ref_new(0)
let window_slots : Map[Int, Array[() -> Unit]] = Map::new()
let windows_beside : Map[Int, String] = Map::new()
let window_trees : Map[Int, view::Tree] = Map::new()
let window_tree_maker : Ref[Option[(Int, String) -> (view::View) -> Unit]] = ref_new(None)
let window_closed_tell : Array[(Int) -> Unit] = []
let ui_kept_registered : Ref[Bool] = ref_new(false)

fn register_ui_window_kept() -> Unit {
  if ui_kept_registered.v {
    return
  }
  ui_kept_registered.v = true
  // Per-window signals stored as Ref[Signal] so windows never wake each other.
  window_kept(
    fn() {
      let saved_theme_fn = tree_theme_fn.v
      let saved_theme_fb = tree_theme_fallback.v
      let saved_corner = tree_window_corner.v
      let saved_zoom = tree_window_zoom.v
      let saved_glass = glass_forced_said.v
      let saved_frost = glass_frost_said.v
      let saved_field = focused_field_ref.v
      let saved_inset = inset_said.v
      let saved_zoomed = zoomed_said.v
      let saved_snap = snap_said.v
      let saved_tree = view_app.tree
      let saved_scene = view_app.scene
      let saved_dmg = view_app.dmg
      let saved_a11y = view_app.a11y
      let saved_frame_no = view_app.frame_no
      let saved_last_w = view_app.last_w
      let saved_last_h = view_app.last_h
      let saved_last_scale = view_app.last_scale
      let saved_ptr_x = view_app.pointer_x
      let saved_ptr_y = view_app.pointer_y
      let saved_press_x = view_app.press_x
      let saved_press_y = view_app.press_y
      let saved_press_down = view_app.press_down
      let saved_pressed_node = view_app.pressed_node
      let saved_dragging_node = view_app.dragging_node
      let saved_claim_chain = view_app.claim_chain
      let saved_press_events = view_app.press_events
      let saved_down2 = view_app.down2
      let saved_touch0 = view_app.active_touch_id
      let saved_touch1 = view_app.secondary_touch_id
      let saved_wheel_phase = view_app.last_wheel_phase
      let saved_light_angle = view_app.last_light_angle
      let saved_atlas_gen = view_app.last_atlas_gen
      fn() {
        tree_theme_fn.v = saved_theme_fn
        tree_theme_fallback.v = saved_theme_fb
        tree_window_corner.v = saved_corner
        tree_window_zoom.v = saved_zoom
        glass_forced_said.v = saved_glass
        glass_frost_said.v = saved_frost
        focused_field_ref.v = saved_field
        inset_said.v = saved_inset
        zoomed_said.v = saved_zoomed
        snap_said.v = saved_snap
        view_app.tree = saved_tree
        view_app.scene = saved_scene
        view_app.dmg = saved_dmg
        view_app.a11y = saved_a11y
        view_app.frame_no = saved_frame_no
        view_app.last_w = saved_last_w
        view_app.last_h = saved_last_h
        view_app.last_scale = saved_last_scale
        view_app.pointer_x = saved_ptr_x
        view_app.pointer_y = saved_ptr_y
        view_app.press_x = saved_press_x
        view_app.press_y = saved_press_y
        view_app.press_down = saved_press_down
        view_app.pressed_node = saved_pressed_node
        view_app.dragging_node = saved_dragging_node
        view_app.claim_chain = saved_claim_chain
        view_app.press_events = saved_press_events
        view_app.down2 = saved_down2
        view_app.active_touch_id = saved_touch0
        view_app.secondary_touch_id = saved_touch1
        view_app.last_wheel_phase = saved_wheel_phase
        view_app.last_light_angle = saved_light_angle
        view_app.last_atlas_gen = saved_atlas_gen
      }
    },
    fn() {
      tree_theme_fn.v = signals::signal_ref(None)
      tree_theme_fallback.v = signals::signal_ref(Theme::light())
      tree_window_corner.v = signals::signal(0.0)
      tree_window_zoom.v = signals::signal(1.0)
      glass_forced_said.v = signals::signal(-1)
      glass_frost_said.v = signals::signal(0.0)
      focused_field_ref.v = None
      inset_said.v = inset_said_new()
      zoomed_said.v = zoomed_said_new()
      snap_said.v = snap_said_new()
      view_app.tree = None
      view_app.scene = Scene::new()
      view_app.dmg = damage::Damage::new()
      view_app.a11y = A11yTold::new()
      view_app.frame_no = 0
      view_app.last_w = 0.0
      view_app.last_h = 0.0
      view_app.last_scale = 1.0
      view_app.pointer_x = 0.0
      view_app.pointer_y = 0.0
      view_app.press_x = 0.0
      view_app.press_y = 0.0
      view_app.press_down = false
      view_app.pressed_node = None
      view_app.dragging_node = None
      view_app.claim_chain = []
      view_app.press_events = []
      view_app.down2 = None
      view_app.active_touch_id = None
      view_app.secondary_touch_id = None
      view_app.last_wheel_phase = 0
      view_app.last_light_angle = 0.0
      view_app.last_atlas_gen = -1
    },
  )
}

/// Active window id (0 = primary window, >0 = secondary in-process windows).
pub fn current_window_id() -> Int {
  window_now.v
}

/// Register a per-window global state slot (take returns restore closure; fresh initializes a new window).
pub fn window_kept(take : () -> (() -> Unit), fresh : () -> Unit) -> Unit {
  windows_kept.push(WindowKept::{ take, fresh })
  for wid in window_slots.keys() {
    match window_slots.get(wid) {
      Some(slot) => slot.push(fresh)
      None => ()
    }
  }
}

/// Swap globals to window `wid`, run `body`, and restore the previous window (typically window 0).
pub fn in_window(wid : Int, body : () -> Unit) -> Unit {
  register_ui_window_kept()
  let prev = window_now.v
  if prev == wid {
    body()
    return
  }
  // Save current window's state
  let prev_saved : Array[() -> Unit] = []
  for k in windows_kept {
    prev_saved.push((k.take)())
  }
  window_slots[prev] = prev_saved
  // Load target window's state (or initialize fresh)
  match window_slots.get(wid) {
    Some(restore_list) => {
      for r in restore_list {
        r()
      }
      window_slots.remove(wid)
    }
    None => {
      for k in windows_kept {
        (k.fresh)()
      }
    }
  }
  window_now.v = wid
  body()
  // Save target window's state and restore previous window
  let target_saved : Array[() -> Unit] = []
  for k in windows_kept {
    target_saved.push((k.take)())
  }
  window_slots[wid] = target_saved
  match window_slots.get(prev) {
    Some(restore_list) => {
      for r in restore_list {
        r()
      }
      window_slots.remove(prev)
    }
    None => ()
  }
  window_now.v = prev
}

pub fn set_window_tree(make : (Int, String) -> (view::View) -> Unit) -> Unit {
  window_tree_maker.v = Some(make)
}

pub fn when_window_closed(f : (Int) -> Unit) -> Unit {
  window_closed_tell.push(f)
}

pub fn windows_here() -> Bool {
  match window_tree_maker.v {
    Some(_) => hostapi::windows_in_process()
    None => false
  }
}

/// Open a secondary window via `hostapi::window_open` (or in-process via `window_open_here` when supported).
pub fn window_open(what : String) -> Bool {
  if windows_here() {
    window_open_here(what) > 0
  } else {
    hostapi::window_open(what)
  }
}

pub fn window_open_here(what : String) -> Int {
  if !windows_here() {
    return 0
  }
  let wid = hostapi::window_open_id(what)
  if wid > 0 {
    windows_beside[wid] = what
    match window_tree_maker.v {
      Some(make_for) => {
        in_window(wid, fn() -> Unit {
          let builder = make_for(wid, what)
          let tree = view::Tree::new(
            builder,
            measure=host_words_measure,
            measure_runs=host_runs_measure,
            measure_runs_least=host_runs_least_measure,
            time=hostapi::now,
          )
          tree.on_due(fn() { hostapi::request_frame() })
          view_app.tree = Some(tree)
          window_trees[wid] = tree
        })
      }
      None => ()
    }
  }
  wid
}

/// Dispatch `body` in the host's currently active window (`hostapi::window_current()`).
fn in_host_window(body : () -> Unit) -> Unit {
  let wid = hostapi::window_current()
  if wid == 0 {
    body()
  } else if windows_beside.contains(wid) {
    in_window(wid, body)
  }
}

/// Look up the `view::Tree` belonging to secondary window `wid`.
pub fn window_tree_of(wid : Int) -> Option[view::Tree] {
  if wid == 0 {
    view_tree()
  } else {
    window_trees.get(wid)
  }
}

/// Execute one frame for secondary window `wid` with its isolated per-window globals and `view::Tree`.
pub fn window_frame(wid : Int, w : Double, h : Double, scale : Double, now : Double) -> Bool {
  if wid == 0 {
    return view_frame(w, h, scale, now)
  }
  if !window_trees.contains(wid) {
    return false
  }
  let mut drew = false
  in_window(wid, fn() -> Unit {
    drew = view_frame(w, h, scale, now)
  })
  drew
}

fn window_closed_by_host(wid : Int) -> Unit {
  if wid <= 0 || !windows_beside.contains(wid) {
    return
  }
  in_window(wid, fn() -> Unit {
    match window_trees.get(wid) {
      Some(t) => {
        t.dispose()
        window_trees.remove(wid)
      }
      None => ()
    }
    view_app.tree = None
  })
  windows_beside.remove(wid)
  window_slots.remove(wid)
  for f in window_closed_tell {
    f(wid)
  }
}

pub fn window_close_here(wid : Int) -> Unit {
  if wid <= 0 {
    return
  }
  in_window(wid, fn() -> Unit {
    match window_trees.get(wid) {
      Some(t) => {
        t.dispose()
        window_trees.remove(wid)
      }
      None => ()
    }
  })
  windows_beside.remove(wid)
  window_slots.remove(wid)
  hostapi::window_close_id(wid)
  for f in window_closed_tell {
    f(wid)
  }
}

pub fn windows_open_here() -> Array[(Int, String)] {
  let out : Array[(Int, String)] = []
  for k in windows_beside.keys() {
    match windows_beside.get(k) {
      Some(v) => out.push((k, v))
      None => ()
    }
  }
  out
}

pub fn window_shows(wid : Int) -> Option[String] {
  windows_beside.get(wid)
}

/// Bring in-process secondary window `wid` to the front.
pub fn window_front_here(wid : Int) -> Bool {
  hostapi::window_front_id(wid)
}

fn windows_reset() -> Unit {
  for k in window_trees.keys() {
    match window_trees.get(k) {
      Some(t) => t.dispose()
      None => ()
    }
  }
  window_trees.clear()
  windows_beside.clear()
  window_slots.clear()
  window_now.v = 0
}
