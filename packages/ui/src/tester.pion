// Pure-tree headless test harness (Tester): frame stepping, idle-time skipping (run_shown),
// input injection, incremental a11y verification, and unasked_faults checking.
// Ported from libs/mbui/src/ui/tester.mbt, tester_time.mbt, tester_unasked.mbt.

import "damage"
import "halt"
import "hostapi"
import "view"

pub let frame_period_default : Double = 1000.0 / 60.0
pub let input_step_ms : Double = 1000.0 / 60.0

extern "C" fn c_test_getenv(name : Ptr) -> Ptr = "getenv"

fn parse_positive_double(raw : String) -> Option[Double] {
  let n = raw.length()
  let mut i = 0
  while i < n {
    let c = raw.code_unit_at(i)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      i += 1
    } else {
      break
    }
  }
  let mut end = n
  while end > i {
    let c = raw.code_unit_at(end - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      end -= 1
    } else {
      break
    }
  }
  if i >= end {
    return None
  }
  let mut acc = 0.0
  let mut saw_digit = false
  let mut saw_dot = false
  let mut frac = 0.1
  while i < end {
    let c = raw.code_unit_at(i)
    if c >= 48 && c <= 57 {
      saw_digit = true
      let d = (c - 48).to_double()
      if saw_dot {
        acc = acc + d * frac
        frac = frac * 0.1
      } else {
        acc = acc * 10.0 + d
      }
    } else if c == 46 && !saw_dot {
      saw_dot = true
    } else {
      return None
    }
    i += 1
  }
  if saw_digit && acc > 0.0 {
    Some(acc)
  } else {
    None
  }
}

fn test_env_fps() -> Double {
  let p = c_test_getenv("INVAR_TEST_FPS".as_cstr())
  let os_raw = cstr_to_str(p)
  let raw = if os_raw.length() > 0 { os_raw } else { hostapi::env("INVAR_TEST_FPS") }
  match parse_positive_double(raw) {
    Some(v) => v
    None => 60.0
  }
}

let tester_halt_intercept : signals::Ref[Option[(String) -> Unit]] = ref_new(None)

fn tester_halt(msg : String) -> Unit {
  match tester_halt_intercept.v {
    Some(f) => f(msg)
    None => {
      let _ : Unit = halt::halt(msg)
    }
  }
}

fn tester_capture_halts(f : () -> Unit) -> Array[String] {
  let caught : Array[String] = []
  let prev = tester_halt_intercept.v
  tester_halt_intercept.v = Some(fn(msg : String) { caught.push(msg) })
  f()
  tester_halt_intercept.v = prev
  caught
}

/// Deterministic pure-tree UI test driver backed by FakeHost.
pub struct Tester {
  pub fake : FakeHost
  prev_host : hostapi::Host
  prev_ext : hostapi::HostExt
  pub mut period_ms : Double
  pub mut each_frame_cb : Option[() -> Unit]
  pub mut unasked_issues : Array[String]
  pub mut a11y_issues : Array[String]
  pub mut disposed : Bool
  mut looks_on : Bool
  ref_dmg : damage::Damage
  ref_dmg_by_wid : Map[Int, damage::Damage]
  ref_light_by_wid : Map[Int, Double]
  ref_atlas_by_wid : Map[Int, Int]
  mut saved_pointing : Option[Option[Pointing]]
  mut touch_active : Bool
}

/// Create a pure-tree Tester, install FakeHost, build the tree, and render frame 0.
/// `transitions_only` defaults to true so changes outside `view::transition` settle immediately.
/// `fps` overrides `INVAR_TEST_FPS` when > 0.0; otherwise reads `INVAR_TEST_FPS` or defaults to 60.0.
/// `host_patch` is given the installed fake host before the tree is built (an offscreen renderer puts its own text and
/// pictures in it, so the tree is measured and drawn by them from its first frame); `keep_glyph_atlas` keeps the glyphs
/// placed by the previous tree (one disposed with `keep_glyph_atlas=true`) for this one, the atlas still starting over
/// when the host's atlas generation or the scale differs from that tree's; `looks_on=false`
/// skips the in-frame reference-scene and damage verification (`check_looks`).
pub fn Tester::tree(
  make : (view::View) -> Unit,
  width~ : Double = 800.0,
  height~ : Double = 600.0,
  scale~ : Double = 2.0,
  theme? : () -> Theme,
  transitions_only~ : Bool = true,
  platform~ : Int = 0,
  dark~ : Bool = false,
  fps~ : Double = 0.0,
  host_patch? : (hostapi::Host) -> Unit,
  keep_glyph_atlas~ : Bool = false,
  looks_on~ : Bool = true,
) -> Tester {
  run_reset_hooks()
  let fake = FakeHost::new(width=width, height=height, scale=scale, platform=platform, dark=dark)
  let prev_ext = hostapi::host_ext()
  let prev_host = fake.install()
  match host_patch {
    Some(patch) => patch(hostapi::host())
    None => ()
  }
  let made = if transitions_only {
    fn(root : view::View) {
      let _ = root.transitions_only()
      make(root)
    }
  } else {
    make
  }
  match theme {
    Some(tf) => set_view_app(made, theme=tf, keep_glyph_atlas=keep_glyph_atlas)
    None => set_view_app(made, keep_glyph_atlas=keep_glyph_atlas)
  }
  hostapi::set_back(view_back)
  let eff_fps = if fps > 0.0 { fps } else { test_env_fps() }
  let t = Tester::{
    fake,
    prev_host,
    prev_ext,
    period_ms: 1000.0 / eff_fps,
    each_frame_cb: None,
    unasked_issues: [],
    a11y_issues: [],
    disposed: false,
    looks_on,
    ref_dmg: damage::Damage::new(),
    ref_dmg_by_wid: Map::new(),
    ref_light_by_wid: Map::new(),
    ref_atlas_by_wid: Map::new(),
    saved_pointing: None,
    touch_active: false,
  }
  if looks_on {
    t.install_looks_hook()
  }
  t.frame()
  t
}

/// Advance the clock by `ms` and render one frame (verifying unasked-frame stability and a11y parity).
pub fn Tester::frame(self : Tester, ms~ : Double = 0.0) -> Unit {
  if ms > 0.0 {
    self.fake.now_ms = self.fake.now_ms + ms
  }
  let fired = self.fake.fire_due()
  let tree = match view_tree() {
    Some(tr) => tr
    None => return
  }
  let was_asked = self.fake.frame_requested ||
  fired > 0 ||
  self.fake.frame_count == 0 ||
  self.fake.posted.length() > 0 ||
  messages_pending_count() > 0 ||
  frame_woken.v ||
  tree.clock_read() ||
  tree.wake().is_some()
  self.fake.frame_requested = false
  self.fake.non_clock_requested = false
  if self.looks_on && in_frame_looks_hook.v.is_none() {
    self.seed_all_ref_windows()
    self.install_looks_hook()
  }
  let changed = view_frame(self.fake.width, self.fake.height, self.fake.scale, self.fake.now_ms)
  if !was_asked && changed && self.fake.frame_count > 1 {
    self.unasked_issues.push("unasked frame at \{self.fake.now_ms}ms drew changed scene")
  }
  if self.fake.a11y_enabled {
    self.verify_a11y_parity(tree)
  }
  match self.each_frame_cb {
    Some(cb) => cb()
    None => ()
  }
}

fn Tester::verify_a11y_parity(self : Tester, tree : view::Tree) -> Unit {
  // Compare incremental mirror in view_app.a11y against a freshly built full mirror
  let (all, focus) = tree_sem_nodes(tree, view_app.a11y)
  let fresh = A11yMirror::new()
  let _ = fresh.apply(true, focus, all)
  let inc_lines = view_app.a11y.mirror.lines()
  let full_lines = fresh.lines()
  if inc_lines != full_lines {
    self.a11y_issues.push("a11y incremental mismatch at \{self.fake.now_ms}ms")
  }
}

/// Advance `ms` skipping idle spans: steps at display cadence only while frames are requested or motion/timers are active.
pub fn Tester::run_shown(self : Tester, ms : Double) -> Unit {
  let target = self.fake.now_ms + dmax(0.0, ms)
  let mut guard_steps = 0
  while self.fake.now_ms < target && guard_steps < 10000 {
    guard_steps += 1
    let tree = match view_tree() {
      Some(tr) => tr
      None => break
    }
    let next_wake = match (tree.wake(), self.fake.next_due()) {
      (Some(a), Some(b)) => Some(dmin(a, b))
      (Some(a), None) => Some(a)
      (None, Some(b)) => Some(b)
      _ => None
    }
    let active = self.fake.frame_requested || tree.clock_read()
    if active {
      let step = dmin(self.period_ms, target - self.fake.now_ms)
      self.frame(ms=step)
    } else {
      match next_wake {
        Some(w) if w <= target => {
          let dt = dmax(0.0, w - self.fake.now_ms)
          self.fake.frame_requested = true
          self.frame(ms=dt)
        }
        _ => {
          // Jump straight across idle time without stepping empty frames!
          self.fake.now_ms = target
          break
        }
      }
    }
  }
}

pub fn Tester::each_frame(self : Tester, f : Option[() -> Unit]) -> Unit {
  self.each_frame_cb = f
}

pub fn Tester::move_to(self : Tester, x : Double, y : Double) -> Unit {
  view_pointer(0, x, y, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::press_at(self : Tester, x : Double, y : Double) -> Unit {
  view_pointer(1, x, y, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::release(self : Tester, x : Double, y : Double) -> Unit {
  view_pointer(2, x, y, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::click(self : Tester, x : Double, y : Double) -> Unit {
  view_pointer(1, x, y, self.fake.now_ms)
  view_pointer(2, x, y, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::tap(self : Tester, x : Double, y : Double) -> Unit {
  self.click(x, y)
}

/// Secondary-button (right) click at (x, y), triggering `View::on_menu`.
pub fn Tester::right_click(self : Tester, x : Double, y : Double) -> Unit {
  view_pointer(1, x, y, self.fake.now_ms, button=2)
  view_pointer(2, x, y, self.fake.now_ms, button=2)
  self.fake.frame_requested = true
  self.frame()
}

/// Drag from (x0, y0) to (x1, y1) across `steps` intermediate pointer moves.
pub fn Tester::drag(self : Tester, x0 : Double, y0 : Double, x1 : Double, y1 : Double, steps~ : Int = 4) -> Unit {
  let n = if steps < 1 { 1 } else { steps }
  view_pointer(1, x0, y0, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
  let mut i = 1
  while i <= n {
    let f = i.to_double() / n.to_double()
    let mx = x0 + (x1 - x0) * f
    let my = y0 + (y1 - y0) * f
    self.fake.now_ms = self.fake.now_ms + input_step_ms
    view_pointer(0, mx, my, self.fake.now_ms)
    self.fake.frame_requested = true
    self.frame()
    i += 1
  }
  view_pointer(2, x1, y1, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

/// Press a named control (by semantic label or drawn words) or key name ("Enter", "Space", "Tab", "Escape").
pub fn Tester::press(self : Tester, name : String) -> Unit {
  if name == "Enter" {
    self.enter()
    return
  }
  if name == "Space" {
    self.key(key_space)
    return
  }
  if name == "Tab" {
    self.key(key_tab)
    return
  }
  if name == "Escape" {
    self.key(key_escape)
    return
  }
  match self.get(name) {
    Some(d) => self.click(d.x + d.w * 0.5, d.y + d.h * 0.5)
    None => match self.find(name) {
      Some((x, y)) => self.click(x, y)
      None => ()
    }
  }
}

pub fn Tester::type_text(self : Tester, s : String) -> Unit {
  view_text(0, s)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::compose(self : Tester, s : String) -> Unit {
  view_text(1, s)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::wheel(self : Tester, x : Double, y : Double, dy : Double, dx~ : Double = 0.0, phase~ : Int = 0) -> Unit {
  view_wheel(x, y, dx, dy, self.fake.now_ms, phase=phase)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::key(self : Tester, code : Int, mods~ : Int = 0) -> Unit {
  let _ = view_key(code, mods, self.fake.now_ms)
  self.fake.frame_requested = true
  self.frame()
}

pub fn Tester::enter(self : Tester) -> Unit {
  self.key(key_enter)
}

pub fn Tester::backspace(self : Tester) -> Unit {
  self.key(key_code_backspace)
}

pub fn Tester::resize(self : Tester, w : Double, h : Double) -> Unit {
  self.fake.width = w
  self.fake.height = h
  self.fake.frame_requested = true
  self.frame()
}

/// Enable or disable incremental accessibility tree emission and full-tree parity checking.
pub fn Tester::set_a11y(self : Tester, on : Bool) -> Unit {
  self.fake.a11y_enabled = on
  if on {
    self.fake.frame_requested = true
    self.frame()
  }
}

/// Query a drawn node by semantic label (and optional role).
pub fn Tester::get(self : Tester, name : String, role? : view::Role) -> Option[view::Drawn] {
  let tree = match view_tree() {
    Some(tr) => tr
    None => return None
  }
  for sn in tree.said_order() {
    let sd = match sn.said {
      Some(v) => v
      None => continue
    }
    let lbl = if sd.label.length() > 0 { sd.label } else { tree.said_label(sn.id) }
    let role_ok = match role {
      Some(r) => sd.role == r
      None => true
    }
    if role_ok && lbl == name {
      match tree.drawn_of(sn.id) {
        Some(d) => return Some(d)
        None => ()
      }
    }
  }
  None
}

/// Find the center coordinates of the first drawn node whose text contains `s`.
pub fn Tester::find(self : Tester, s : String) -> Option[(Double, Double)] {
  let tree = match view_tree() {
    Some(tr) => tr
    None => return None
  }
  for d in tree.drawn() {
    let w = d.words
    if w == s || str_contains(w, s) {
      return Some((d.x + d.w * 0.5, d.y + d.h * 0.5))
    }
  }
  None
}

pub fn Tester::scene(self : Tester) -> Scene {
  let _ = self
  view_scene_last().copy()
}

pub fn Tester::drawn(self : Tester) -> Array[view::Drawn] {
  let _ = self
  match view_tree() {
    Some(tr) => tr.drawn()
    None => []
  }
}

/// The glass drawn in the last frame: `(x, y, w, h, kind (5 frosted, 6 liquid), capture_id (1, 2, ...))`.
/// Matches `libs/mbui/src/ui/tester.mbt:2923-2945`.
pub fn Tester::drawn_glass(self : Tester) -> Array[(Double, Double, Double, Double, Int, Int)] {
  let _ = self
  let sc = view_scene_last()
  let out : Array[(Double, Double, Double, Double, Int, Int)] = []
  let mut k = 0
  while k < sc.ninst {
    let b = k * inst_size
    let kind = sc.inst[b + 5].to_int()
    if kind == 5 || kind == 6 {
      out.push((
        sc.inst[b],
        sc.inst[b + 1],
        sc.inst[b + 2],
        sc.inst[b + 3],
        kind,
        (-sc.inst[b + 20]).to_int(),
      ))
    }
    k += 1
  }
  out
}

/// Every 60-Double instance emitted in the last rendered frame.
pub fn Tester::drawn_instances(self : Tester) -> Array[Array[Double]] {
  let _ = self
  let sc = view_scene_last()
  let out : Array[Array[Double]] = []
  let mut k = 0
  while k < sc.ninst {
    let b = k * inst_size
    let row : Array[Double] = []
    let mut j = 0
    while j < inst_size {
      row.push(sc.inst[b + j])
      j += 1
    }
    out.push(row)
    k += 1
  }
  out
}

/// Count of adaptive-ink glyph instances (`kind == 7`) emitted in the last rendered frame.
pub fn Tester::adaptive_glyphs(self : Tester) -> Int {
  let _ = self
  let sc = view_scene_last()
  let mut count = 0
  let mut k = 0
  while k < sc.ninst {
    let b = k * inst_size
    if (sc.inst[b + 5] + 0.5).to_int() == 7 {
      count += 1
    }
    k += 1
  }
  count
}

/// Post an external message immediately to the fake host for delivery on the next frame.
pub fn Tester::post(self : Tester, channel : String, json : String, bytes? : Bytes) -> Unit {
  match bytes {
    Some(b) => self.fake.post(channel, json, bytes=b)
    None => self.fake.post(channel, json)
  }
}

/// Schedule an external message to arrive at exact timestamp `ms` (delivered between frames and drawn on that frame).
pub fn Tester::post_at(self : Tester, ms : Double, channel : String, json : String, bytes? : Bytes) -> Unit {
  match bytes {
    Some(b) => self.fake.post_at(ms, channel, json, bytes=b)
    None => self.fake.post_at(ms, channel, json)
  }
}

/// Number of external messages handed to channel handlers during the most recent frame.
pub fn Tester::messages_taken(self : Tester) -> Int {
  let _ = self
  messages_handed_count()
}

/// Number of coalesced frame wakes caused by `post` / `post_at` since this Tester started.
pub fn Tester::post_wakes(self : Tester) -> Int {
  self.fake.post_wakes
}

/// Report why the app is not idle (None when completely at rest).
pub fn Tester::idle_said(self : Tester) -> Option[String] {
  if self.fake.frame_requested {
    return Some("frame_requested")
  }
  if self.fake.posted.length() > 0 {
    return Some("\{self.fake.posted.length()} posted messages untaken")
  }
  if frame_woken.v {
    return Some("wake_frame pending")
  }
  match self.fake.next_due() {
    Some(at) => return Some("due timer at \{at}ms")
    None => ()
  }
  match view_tree() {
    Some(tr) => {
      if tr.clock_read() {
        return Some("tree clock_read active")
      }
      match tr.wake() {
        Some(at) => Some("tree wake at \{at}ms")
        None => None
      }
    }
    None => None
  }
}

/// Faults where an unrequested frame drew a different scene (AGENTS.md: Tester::unasked_faults).
pub fn Tester::unasked_faults(self : Tester) -> Array[String] {
  self.unasked_issues.copy()
}

/// Incremental accessibility parity faults detected while `set_a11y(true)` is active.
pub fn Tester::a11y_faults(self : Tester) -> Array[String] {
  self.a11y_issues.copy()
}

/// Layout diagnostics for silent-non-scrolling faults on all live scrollers (`Tree::scroll_faults`).
pub fn Tester::scroll_faults(self : Tester) -> Array[String] {
  let _ = self
  match view_tree() {
    Some(tr) => tr.scroll_faults()
    None => []
  }
}

/// Assert that all live scrollers pass `scroll_faults()` (panics with full diagnostics otherwise).
pub fn Tester::assert_scrollable(self : Tester, label~ : String = "") -> Unit {
  let faults = self.scroll_faults()
  if faults.length() > 0 {
    let mut msg = if label.length() > 0 {
      "scroll_faults failed in \{label} (\{faults.length()} fault(s)):"
    } else {
      "scroll_faults failed (\{faults.length()} fault(s)):"
    }
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

/// Set the frame cadence in frames per second (must be > 0.0).
pub fn Tester::set_fps(self : Tester, fps : Double) -> Unit {
  if fps > 0.0 {
    self.period_ms = 1000.0 / fps
  }
}

/// Current frame cadence in frames per second.
pub fn Tester::fps(self : Tester) -> Double {
  if self.period_ms > 0.0 {
    1000.0 / self.period_ms
  } else {
    60.0
  }
}

/// Advance `ms` in fixed `period_ms` frame steps, checking `unasked_faults` and `a11y_faults` on every frame.
pub fn Tester::run_for(self : Tester, ms : Double) -> Unit {
  let span = dmax(0.0, ms)
  if span <= 0.0 {
    return
  }
  let target = self.fake.now_ms + span
  let step_ms = if self.period_ms > 0.0 { self.period_ms } else { frame_period_default }
  let mut guard_steps = 0
  while self.fake.now_ms + 1.0e-9 < target && guard_steps < 100000 {
    guard_steps += 1
    let rem = target - self.fake.now_ms
    let step = if rem < step_ms { rem } else { step_ms }
    self.frame(ms=step)
  }
}

/// Run `run(rate)` across `rates` (default `[60.0, 120.0, 24.0, 7.0]`) and collect any mismatches against the first rate.
pub fn check_fps_matrix(
  rates~ : Array[Double] = [60.0, 120.0, 24.0, 7.0],
  probe : (Double) -> String,
) -> Array[String] {
  let diffs : Array[String] = []
  if rates.length() == 0 {
    return diffs
  }
  let base_rate = rates[0]
  let base_out = probe(base_rate)
  let mut i = 1
  while i < rates.length() {
    let r = rates[i]
    let out = probe(r)
    if out != base_out {
      diffs.push("fps \{r} != \{base_rate}: got '\{out}', expected '\{base_out}'")
    }
    i += 1
  }
  diffs
}

/// Inject a native Back gesture/event (`kind`: 0=Began, 1=Moved, 2=Commit/Standalone, 3=Cancel)
/// routed through the active window's pre-callback `back_on_by_wid` gate.
pub fn Tester::back_gesture(
  self : Tester,
  kind : Int,
  x : Double,
  progress : Double,
  edge : Int,
) -> Unit {
  let _ = self.fake.dispatch_back(current_window_id(), kind, x, progress, edge)
}

pub fn Tester::time(self : Tester) -> Double {
  self.fake.now_ms
}

/// `keep_glyph_atlas` leaves the glyphs placed for the next tree made with `keep_glyph_atlas=true`.
pub fn Tester::dispose(self : Tester, keep_glyph_atlas~ : Bool = false) -> Unit {
  if self.disposed {
    return
  }
  self.disposed = true
  self.restore_touch_pointing()
  self.looks_on = false
  self.ref_dmg.forget()
  self.ref_dmg_by_wid.clear()
  self.ref_light_by_wid.clear()
  self.ref_atlas_by_wid.clear()
  set_in_frame_looks_hook(None)
  reset_press_rules()
  view_forget(keep_glyph_atlas=keep_glyph_atlas)
  active_fake_host.v = None
  let _ = hostapi::set_host(self.prev_host)
  let _ = hostapi::set_host_ext(self.prev_ext)
}

/// Draw at least one frame and continue up to 3 rounds while independent non-clock work remains pending.
/// Halts with the exact non-converged flags if non-clock work is still pending after 3 frames.
pub fn Tester::draw(self : Tester) -> Unit {
  let mut round = 0
  while round < 3 {
    self.frame()
    round += 1
    let posted_pending = self.fake.posted.length() > 0 || self.fake.post_take_buf.length() > 0
    let pending_msgs = messages_pending_count() > 0
    let pending_after = after_frame_cbs.length() > 0
    let pending = self.fake.non_clock_requested || posted_pending || pending_msgs || frame_woken.v || pending_after
    if !pending {
      return
    }
  }
  let reasons : Array[String] = []
  if self.fake.non_clock_requested {
    reasons.push("non_clock_requested")
  }
  if self.fake.posted.length() > 0 || self.fake.post_take_buf.length() > 0 {
    reasons.push("posted_pending(\{self.fake.posted.length() + self.fake.post_take_buf.length()})")
  }
  if messages_pending_count() > 0 {
    reasons.push("messages_pending(\{messages_pending_count()})")
  }
  if frame_woken.v {
    reasons.push("frame_woken")
  }
  if after_frame_cbs.length() > 0 {
    reasons.push("after_frame_cbs(\{after_frame_cbs.length()})")
  }
  let mut detail = ""
  let mut i = 0
  while i < reasons.length() {
    if i > 0 {
      detail = detail + ", "
    }
    detail = detail + reasons[i]
    i += 1
  }
  tester_halt("Tester::draw did not settle after 3 frames: \{detail}")
}

/// Concatenate `unasked_faults() ++ ui_craft_audit() ++ contrast_faults()` without deduplication.
pub fn Tester::audit(self : Tester) -> Array[String] {
  let out : Array[String] = []
  for f in self.unasked_faults() {
    out.push(f)
  }
  for f in self.ui_craft_audit() {
    out.push(f)
  }
  for f in self.contrast_faults() {
    out.push(f)
  }
  out
}

fn normalize_looks_damage(rep : DamageReport) -> DamageReport {
  match rep {
    DamageReport::Full => DamageReport::Full
    DamageReport::None => DamageReport::None
    DamageReport::Rects(rs) => {
      if rs.length() == 0 {
        return DamageReport::None
      }
      let out : Array[(Double, Double, Double, Double)] = []
      for r in rs {
        if r.2 < 0.0 || r.3 < 0.0 {
          return DamageReport::Full
        }
        if r.2 > 0.0 && r.3 > 0.0 {
          out.push(r)
        }
      }
      if out.length() == 0 {
        DamageReport::None
      } else {
        DamageReport::Rects(out)
      }
    }
  }
}

fn sort_unique_doubles(arr : Array[Double]) -> Array[Double] {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j -= 1
    }
    arr[j + 1] = key
    i += 1
  }
  let out : Array[Double] = []
  for v in arr {
    if out.length() == 0 || (v - out[out.length() - 1]).abs() > 1.0e-9 {
      out.push(v)
    }
  }
  out
}

/// Verify that the 2D union of `cover` rectangles covers 100% of `(tx, ty, tw, th)`.
/// Returns `None` when fully covered, or `Some((ux, uy, uw, uh))` for the first uncovered cell.
fn rects_union_covers_rect(
  cover : Array[(Double, Double, Double, Double)],
  tx : Double,
  ty : Double,
  tw : Double,
  th : Double,
) -> Option[(Double, Double, Double, Double)] {
  if tw <= 1.0e-6 || th <= 1.0e-6 {
    return None
  }
  let eps = 1.0e-6
  let tx0 = tx
  let ty0 = ty
  let tx1 = tx + tw
  let ty1 = ty + th
  let raw_xs : Array[Double] = [tx0, tx1]
  let raw_ys : Array[Double] = [ty0, ty1]
  let clipped : Array[(Double, Double, Double, Double)] = []
  for c in cover {
    if c.2 <= 0.0 || c.3 <= 0.0 {
      continue
    }
    let cx0 = c.0 - eps
    let cy0 = c.1 - eps
    let cx1 = c.0 + c.2 + eps
    let cy1 = c.1 + c.3 + eps
    if cx1 <= tx0 || cx0 >= tx1 || cy1 <= ty0 || cy0 >= ty1 {
      continue
    }
    let ix0 = dclamp(cx0, tx0, tx1)
    let iy0 = dclamp(cy0, ty0, ty1)
    let ix1 = dclamp(cx1, tx0, tx1)
    let iy1 = dclamp(cy1, ty0, ty1)
    clipped.push((ix0, iy0, ix1, iy1))
    raw_xs.push(ix0)
    raw_xs.push(ix1)
    raw_ys.push(iy0)
    raw_ys.push(iy1)
  }
  if clipped.length() == 0 {
    return Some((tx, ty, tw, th))
  }
  let xs = sort_unique_doubles(raw_xs)
  let ys = sort_unique_doubles(raw_ys)
  let mut ix = 0
  while ix + 1 < xs.length() {
    let x0 = xs[ix]
    let x1 = xs[ix + 1]
    if x1 - x0 > 1.0e-6 {
      let mx = (x0 + x1) * 0.5
      let mut iy = 0
      while iy + 1 < ys.length() {
        let y0 = ys[iy]
        let y1 = ys[iy + 1]
        if y1 - y0 > 1.0e-6 {
          let my = (y0 + y1) * 0.5
          let mut hit = false
          for r in clipped {
            if r.0 <= mx && mx <= r.2 && r.1 <= my && my <= r.3 {
              hit = true
              break
            }
          }
          if !hit {
            return Some((x0, y0, x1 - x0, y1 - y0))
          }
        }
        iy += 1
      }
    }
    ix += 1
  }
  None
}

fn Tester::ref_dmg_for(self : Tester, wid : Int) -> damage::Damage {
  if wid == 0 {
    return self.ref_dmg
  }
  match self.ref_dmg_by_wid.get(wid) {
    Some(d) => d
    None => {
      let d = damage::Damage::new()
      self.ref_dmg_by_wid[wid] = d
      d
    }
  }
}

fn Tester::verify_looks_frame(
  self : Tester,
  prod : Scene,
  ref_sc : Scene,
  rep : DamageReport,
  w : Double,
  h : Double,
  scale : Double,
  bg_r : Double,
  bg_g : Double,
  bg_b : Double,
) -> Unit {
  if prod.ninst != ref_sc.ninst {
    tester_halt("check_looks: instance count mismatch (prod=\{prod.ninst}, ref=\{ref_sc.ninst})")
    return
  }
  let mut k = 0
  while k < prod.ninst {
    let b = k * inst_size
    let mut j = 0
    while j < inst_size {
      let a = prod.inst[b + j]
      let r = ref_sc.inst[b + j]
      if !(a == r || (a - r).abs() <= 1.0e-9) {
        tester_halt("check_looks: inst[\{k}] slot \{j} mismatch (prod=\{a}, ref=\{r})")
        return
      }
      j += 1
    }
    k += 1
  }
  if prod.segs.length() != ref_sc.segs.length() {
    tester_halt("check_looks: segs length mismatch (prod=\{prod.segs.length()}, ref=\{ref_sc.segs.length()})")
    return
  }
  let mut si = 0
  while si < prod.segs.length() {
    let sa = prod.segs[si]
    let sr = ref_sc.segs[si]
    if !(sa == sr || (sa - sr).abs() <= 1.0e-9) {
      tester_halt("check_looks: segs[\{si}] mismatch (prod=\{sa}, ref=\{sr})")
      return
    }
    si += 1
  }
  let wid = current_window_id()
  let cur_light = view_app.last_light_angle
  let cur_atlas = view_app.last_atlas_gen
  let light_changed = match self.ref_light_by_wid.get(wid) {
    Some(prev_la) => (cur_light - prev_la).abs() > 1.0e-6
    None => false
  }
  let atlas_changed = match self.ref_atlas_by_wid.get(wid) {
    Some(prev_ag) => cur_atlas != prev_ag
    None => false
  }
  self.ref_light_by_wid[wid] = cur_light
  self.ref_atlas_by_wid[wid] = cur_atlas
  let ref_dmg = self.ref_dmg_for(wid)
  let exp_raw = ref_dmg.next(ref_sc.inst, ref_sc.ninst, w, h, scale, bg_r, bg_g, bg_b)
  let expected = if light_changed || atlas_changed {
    DamageReport::Full
  } else {
    normalize_looks_damage(DamageReport::Rects(exp_raw))
  }
  let actual = normalize_looks_damage(rep)
  match actual {
    DamageReport::Full => ()
    DamageReport::None =>
    match expected {
      DamageReport::None => ()
      DamageReport::Full =>
      tester_halt("check_looks: actual damage is None, expected Full")
      DamageReport::Rects(e_rects) =>
      tester_halt("check_looks: actual damage is None, expected \{e_rects.length()} rect(s)")
    }
    DamageReport::Rects(a_rects) =>
    match expected {
      DamageReport::None => ()
      DamageReport::Full =>
      if w > 0.0 && h > 0.0 {
        match rects_union_covers_rect(a_rects, 0.0, 0.0, w, h) {
          Some((ux, uy, uw, uh)) =>
          tester_halt(
            "check_looks: actual damage rects do not cover Full viewport (uncovered=(\{ux}, \{uy}, \{uw}, \{uh}))",
          )
          None => ()
        }
      }
      DamageReport::Rects(e_rects) => {
        for e in e_rects {
          match rects_union_covers_rect(a_rects, e.0, e.1, e.2, e.3) {
            Some((ux, uy, uw, uh)) => {
              tester_halt(
                "check_looks: actual damage union missed expected (\{e.0}, \{e.1}, \{e.2}, \{e.3}) at (\{ux}, \{uy}, \{uw}, \{uh})",
              )
              return
            }
            None => ()
          }
        }
      }
    }
  }
}

fn Tester::install_looks_hook(self : Tester) -> Unit {
  set_in_frame_looks_hook(
    Some(fn(
      prod : Scene,
      ref_sc : Scene,
      rep : DamageReport,
      w : Double,
      h : Double,
      scale : Double,
      bg_r : Double,
      bg_g : Double,
      bg_b : Double,
    ) {
      self.verify_looks_frame(prod, ref_sc, rep, w, h, scale, bg_r, bg_g, bg_b)
    }),
  )
}

fn Tester::seed_one_ref_window(self : Tester, wid : Int) -> Unit {
  let sc = view_scene_last()
  if sc.width > 0.0 && sc.height > 0.0 {
    let dmg = self.ref_dmg_for(wid)
    let _ = dmg.next(
      sc.inst,
      sc.ninst,
      sc.width,
      sc.height,
      sc.scale,
      view_app.last_bg_r,
      view_app.last_bg_g,
      view_app.last_bg_b,
    )
    self.ref_light_by_wid[wid] = view_app.last_light_angle
    self.ref_atlas_by_wid[wid] = view_app.last_atlas_gen
  }
}

fn Tester::seed_all_ref_windows(self : Tester) -> Unit {
  self.ref_dmg.forget()
  self.ref_dmg_by_wid.clear()
  self.ref_light_by_wid.clear()
  self.ref_atlas_by_wid.clear()
  let cur_wid = current_window_id()
  let wids : Array[Int] = [0]
  for pair in windows_open_here() {
    let wid = pair.0
    if wid != 0 && !wids.contains(wid) {
      wids.push(wid)
    }
  }
  for wid in wids {
    if wid == cur_wid {
      self.seed_one_ref_window(wid)
    } else {
      in_window(wid, fn() { self.seed_one_ref_window(wid) })
    }
  }
}

/// Enable or disable per-Tester in-frame reference-scene & damage coverage verification (default `true`).
pub fn Tester::check_looks(self : Tester, on : Bool) -> Unit {
  if !on {
    self.looks_on = false
    set_in_frame_looks_hook(None)
    return
  }
  if !self.looks_on {
    self.seed_all_ref_windows()
    self.looks_on = true
  }
  self.install_looks_hook()
}

fn Tester::restore_touch_pointing(self : Tester) -> Unit {
  match self.saved_pointing {
    Some(prev) => {
      self.saved_pointing = None
      self.touch_active = false
      set_pointing(prev)
    }
    None => {
      self.touch_active = false
    }
  }
}

/// Inject a touch event (`kind`: 0=down, 1=move, 2=up, 3=cancel) at `(x, y)` using `self.fake.now_ms`
/// and a stable touch id without advancing a frame. Preserves and restores prior `Option[Pointing]`.
pub fn Tester::touch(self : Tester, kind : Int, x : Double, y : Double) -> Unit {
  if !self.touch_active {
    self.saved_pointing = Some(said_pointing.v)
    self.touch_active = true
    set_pointing(Some(Pointing::Finger))
  }
  view_host_pointer(10 + kind, x, y, 1, self.fake.now_ms)
  self.fake.frame_requested = true
  if kind == 2 || kind == 3 {
    self.restore_touch_pointing()
  }
}

/// Extract visible text for a drawn node (`field` display/placeholder, rich `runs`, or plain `words`).
/// Returns empty string for skeleton (`bones`) nodes.
fn drawn_words_found(tree : view::Tree, d : view::Drawn) -> String {
  if tree.bones_of(d.id) != 0L {
    return ""
  }
  match field_display_or_hint(d.id) {
    Some(txt) => txt
    None =>
    if d.runs.length() > 0 {
      let sb = StringBuilder::new()
      for r in d.runs {
        sb.write_string(r.text)
      }
      sb.to_string()
    } else {
      d.words
    }
  }
}

fn Tester::find_text_rects(
  self : Tester,
  s : String,
) -> Option[((Double, Double, Double, Double), (Double, Double, Double, Double))] {
  if s.length() == 0 {
    return None
  }
  let tree = match view_tree() {
    Some(tr) => tr
    None => return None
  }
  let sc = view_scene_last()
  let vw = if sc.width > 0.0 { sc.width } else { self.fake.width }
  let vh = if sc.height > 0.0 { sc.height } else { self.fake.height }
  let held = tree.drawn_held()
  let n = held.length()
  let mut i = 0
  while i < n {
    let d = held[i].0
    if d.alpha > 0.0 && d.w > 0.0 && d.h > 0.0 && tree.bones_of(d.id) == 0L {
      let (vx0, vy0, vx1, vy1) = clipped_visible_rect(held, i, vw, vh)
      if vx1 > vx0 && vy1 > vy0 {
        let txt = drawn_words_found(tree, d)
        if txt.length() > 0 && (txt == s || str_contains(txt, s)) {
          return Some(((d.x, d.y, d.w, d.h), (vx0, vy0, vx1, vy1)))
        }
      }
    }
    i += 1
  }
  None
}

/// Return the unclipped `(x, y, w, h)` of the first visible drawn node whose text contains `s`.
/// Skips invisible (`alpha <= 0.0`), zero-size, skeleton (`bones`), and completely clipped nodes.
pub fn Tester::rect_of(self : Tester, s : String) -> Option[(Double, Double, Double, Double)] {
  match self.find_text_rects(s) {
    Some((unclipped, _)) => Some(unclipped)
    None => None
  }
}

/// Tap the center of the visible clipped area of the first node matching `s`, or halt if no such text is on screen.
pub fn Tester::tap_text(self : Tester, s : String) -> Unit {
  match self.find_text_rects(s) {
    Some((_, (vx0, vy0, vx1, vy1))) => self.tap((vx0 + vx1) * 0.5, (vy0 + vy1) * 0.5)
    None => tester_halt("no text \"\{s}\" on screen")
  }
}

fn pack_rgba_channel(v : Double) -> Int64 {
  let c = dclamp(v, 0.0, 1.0)
  let i = (c * 255.0 + 0.5).floor().to_int64()
  if i < 0L { 0L } else if i > 255L { 255L } else { i }
}

/// Return all rectangle primitives (`slot 5 == 0.0`) from the last rendered scene as `(x, y, w, h, 0xRRGGBBAA)`.
pub fn Tester::drawn_rects(self : Tester) -> Array[(Double, Double, Double, Double, Int64)] {
  let _ = self
  let sc = view_scene_last()
  let out : Array[(Double, Double, Double, Double, Int64)] = []
  let mut k = 0
  while k < sc.ninst {
    let b = k * inst_size
    if sc.inst[b + 5] == 0.0 {
      let r = pack_rgba_channel(sc.inst[b + 8])
      let g = pack_rgba_channel(sc.inst[b + 9])
      let bl = pack_rgba_channel(sc.inst[b + 10])
      let a = pack_rgba_channel(sc.inst[b + 11])
      let col = (r << 24) | (g << 16) | (bl << 8) | a
      out.push((sc.inst[b], sc.inst[b + 1], sc.inst[b + 2], sc.inst[b + 3], col))
    }
    k += 1
  }
  out
}
