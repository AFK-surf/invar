// Motion curves (Ease), spring/bezier timing, and reduced-motion query.
// Ported from libs/mbui/src/ui/motion.mbt and tester_time.mbt.

import "dmath"
import "flex"
import "view"
import "hostapi"
import "signals"

/// CSS cubic-bezier(x1, y1, x2, y2) solver (Newton + bisection fallback).
fn bezier_at(x1 : Double, y1 : Double, x2 : Double, y2 : Double, t : Double) -> Double {
  if t <= 0.0 {
    return 0.0
  }
  if t >= 1.0 {
    return 1.0
  }
  let cx = 3.0 * x1
  let bx = 3.0 * (x2 - x1) - cx
  let ax = 1.0 - cx - bx
  let cy = 3.0 * y1
  let by = 3.0 * (y2 - y1) - cy
  let ay = 1.0 - cy - by
  let x_at = fn(s : Double) -> Double { ((ax * s + bx) * s + cx) * s }
  let mut s = t
  let mut found = false
  let mut i = 0
  while i < 8 {
    let e = x_at(s) - t
    if e.abs() < 1.0e-7 {
      found = true
      break
    }
    let d = (3.0 * ax * s + 2.0 * bx) * s + cx
    if d.abs() < 1.0e-6 {
      break
    }
    s = s - e / d
    i += 1
  }
  if !found || s < 0.0 || s > 1.0 {
    let mut lo = 0.0
    let mut hi = 1.0
    s = t
    let mut j = 0
    while j < 60 {
      let x = x_at(s)
      if (x - t).abs() < 1.0e-9 {
        break
      }
      if x < t {
        lo = s
      } else {
        hi = s
      }
      s = (lo + hi) / 2.0
      j += 1
    }
  }
  ((ay * s + by) * s + cy) * s
}

#derive(Eq)
pub enum Ease {
  Move
  Out
  Leave
  InOut
  Linear
  Flight
}

/// Exported curve constants matching downstream expectations (`Out`, `InOut`).
pub let out_ease : Ease = Ease::Out
pub let in_out_ease : Ease = Ease::InOut

pub fn Out() -> Ease {
  Ease::Out
}

pub fn InOut() -> Ease {
  Ease::InOut
}

pub let move_least_ms : Double = flex::move_least_ms
pub let move_most_ms : Double = flex::move_most_ms
pub let flung_away : Double = view::flung_away

pub fn move_ms(points : Double) -> Double {
  flex::move_ms(points)
}

pub fn move_stop_points(v : Double) -> Double {
  flex::move_stop_points(v)
}

pub fn lands_at(at : Double, v : Double) -> Double {
  view::lands_at(at, v)
}

pub fn lands_past(at : Double, v : Double, line : Double) -> Bool {
  view::lands_past(at, v, line)
}

pub fn move_path(d : Double, v : Double, t : Double, dur : Double) -> (Double, Double) {
  flex::move_path(d, v, t, dur)
}

pub fn come_kept() -> flex::ComeKept {
  flex::ComeKept::new()
}

pub fn come_way_by(
  from : Double,
  v : Double,
  goal : Double,
  plan : Double,
  t : Double,
  kept? : flex::ComeKept,
) -> (Double, Double) {
  match kept {
    Some(k) => flex::come_way_by(from, v, goal, plan, t, kept=k)
    None => flex::come_way_by(from, v, goal, plan, t)
  }
}

pub fn come_way_ms(from : Double, v : Double, goal : Double, kept? : flex::ComeKept) -> Double {
  match kept {
    Some(k) => flex::come_way_ms(from, v, goal, kept=k)
    None => flex::come_way_ms(from, v, goal)
  }
}

pub fn ease_at(self : Ease, t : Double) -> Double {
  match self {
    Ease::Move =>
    if t <= 0.0 {
      0.0
    } else if t >= 1.0 {
      1.0
    } else {
      let x = flex::move_k * t
      (1.0 - (1.0 + x) * dmath::exp(-x)) / flex::move_end
    }
    Ease::Out => bezier_at(0.2, 0.7, 0.2, 1.0, t)
    Ease::Leave => bezier_at(0.4, 0.0, 1.0, 1.0, t)
    Ease::InOut => bezier_at(0.42, 0.0, 0.58, 1.0, t)
    Ease::Linear => dclamp(t, 0.0, 1.0)
    Ease::Flight => bezier_at(0.6, 0.0, 0.2, 1.0, t)
  }
}

pub fn Ease::at(self : Ease, t : Double) -> Double {
  ease_at(self, t)
}

/// Named rest durations for test assertions and motion checks.
let named_rests : Map[String, Double] = Map::new()

pub fn record_rest(name : String, at : Double) -> Unit {
  named_rests[name] = at
}

pub fn rest_of(name : String) -> Double {
  match named_rests.get(name) {
    Some(v) => v
    None => 0.0
  }
}

let reduced_motion_override : signals::Ref[Option[Bool]] = ref_new(None)

pub fn set_reduced_motion(on : Option[Bool]) -> Unit {
  reduced_motion_override.v = on
}

pub fn reduced_motion() -> Bool {
  match reduced_motion_override.v {
    Some(v) => v
    None => host_reduce_motion()
  }
}
