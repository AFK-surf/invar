// Tree-mode finger press delay inside scrollable containers (`Tree::press_delay_in_scroll` wired in `view_host.pion`):
// - `View::pressed()` stays immediate for logic on all inputs.
// - Under `Finger`, `View::press_shown()` on a node inside `View::scrolls` delays by `tap_indication_ms` so scrolling
//   past buttons/rows never flashes pressed highlights, clears immediately if scrolled after lighting, and quick taps
//   still fire `on_press` immediately on release.
// - Under `Mouse`, or for a finger outside any scroller, `View::press_shown()` lights immediately.

import "signals"
import "view"

test "tree scroll press delay: Finger delays press_shown() in scroll while pressed() stays immediate; clears on late scroll; Mouse & outside immediate" {
  let shown_in_scroll = signals::ref_new(false)
  let raw_in_scroll = signals::ref_new(false)
  let shown_outside = signals::ref_new(false)
  let clicks = signals::ref_new(0)
  let make = fn(pointing : Pointing) -> Tester {
    shown_in_scroll.v = false
    raw_in_scroll.v = false
    shown_outside.v = false
    clicks.v = 0
    let t = Tester::tree(
      fn(root : view::View) {
        let _ = root.box(fn(top : view::View) {
          let _ = top
            .width(view::Live::Is(Some(300.0)))
            .height(view::Live::Is(Some(44.0)))
            .presses(view::Live::Is(true))
            .on_press(fn() { () })
            .says(view::Live::Is(Some(view::said(view::Role::Button, label="Outside Button"))))
            .ground(
              view::Live::By(fn() {
                shown_outside.v = top.press_shown()
                if top.press_shown() { 0x3366CCFFL } else { 0xEEEEEEFFL }
              }),
            )
        })
        let _ = root.box(fn(sc : view::View) {
          let _ = sc
            .width(view::Live::Is(Some(300.0)))
            .height(view::Live::Is(Some(200.0)))
            .scrolls(view::Scroll::new(), slop=touch_slop(), fn(held : view::View) {
              let _ = held.box(fn(btn : view::View) {
                let _ = btn
                  .width(view::Live::Is(Some(300.0)))
                  .height(view::Live::Is(Some(50.0)))
                  .presses(view::Live::Is(true))
                  .says(view::Live::Is(Some(view::said(view::Role::Button, label="List Button"))))
                  .on_press(fn() { clicks.v = clicks.v + 1 })
                  .ground(
                    view::Live::By(fn() {
                      raw_in_scroll.v = btn.pressed()
                      shown_in_scroll.v = btn.press_shown()
                      if btn.press_shown() { 0x3366CCFFL } else { 0xFFFFFFFFL }
                    }),
                  )
              })
              let _ = held.box(fn(tall : view::View) {
                let _ = tall.height(view::Live::Is(Some(600.0)))
              })
            })
        })
      },
      w=300.0,
      h=300.0,
      pointing=pointing,
    )
    t.draw()
    t
  }

  // 1. Finger outside scroller: lights immediately at t=0
  let t1 = make(Pointing::Finger)
  t1.touch(0, 100.0, 22.0)
  t1.draw()
  let outside_at_0 = shown_outside.v
  t1.touch(2, 100.0, 22.0)
  t1.draw()
  debug_assert(outside_at_0, "finger outside scroller lights immediately at t=0")
  debug_assert(!shown_outside.v, "finger outside scroller clears on touch up")
  t1.dispose()

  // 2. Finger inside scroller, held past tap_indication_ms: pressed() immediate, press_shown() lit at tap_indication_ms
  let t2 = make(Pointing::Finger)
  t2.touch(0, 100.0, 70.0)
  t2.draw()
  let raw_0 = raw_in_scroll.v
  let shown_0 = shown_in_scroll.v
  t2.run_for(tap_indication_ms / 2.0)
  let raw_half = raw_in_scroll.v
  let shown_half = shown_in_scroll.v
  t2.run_for(tap_indication_ms / 2.0)
  let raw_full = raw_in_scroll.v
  let shown_full = shown_in_scroll.v
  t2.touch(2, 100.0, 70.0)
  t2.draw()
  debug_assert(raw_0 && !shown_0, "at t=0 in scroll: pressed=true, press_shown=false")
  debug_assert(raw_half && !shown_half, "at half delay in scroll: pressed=true, press_shown=false")
  debug_assert(raw_full && shown_full, "at full delay in scroll: pressed=true, press_shown=true")
  debug_assert(!raw_in_scroll.v && !shown_in_scroll.v && clicks.v == 1, "after release: both cleared and 1 click")
  t2.dispose()

  // 3. Finger inside scroller, scrolling immediately: press_shown() stays false on every frame, no click
  let t3 = make(Pointing::Finger)
  t3.touch(0, 100.0, 70.0)
  t3.draw()
  let mut flashed = shown_in_scroll.v
  let mut i = 1
  while i <= 8 {
    t3.advance(input_step_ms)
    t3.touch(1, 100.0, 70.0 - i.to_double() * 8.0)
    t3.draw()
    if shown_in_scroll.v {
      flashed = true
    }
    i = i + 1
  }
  t3.touch(2, 100.0, 6.0)
  t3.draw()
  debug_assert(!flashed && !shown_in_scroll.v && clicks.v == 0, "scrolling immediately never flashes press_shown and fires 0 clicks")
  t3.dispose()

  // 4. Finger held past tap_indication_ms (lit), then dragged to scroll: press_shown() clears once scroll claims
  let t4 = make(Pointing::Finger)
  t4.touch(0, 100.0, 70.0)
  t4.draw()
  t4.run_for(tap_indication_ms)
  let lit_before_scroll = shown_in_scroll.v
  let mut j = 1
  while j <= 6 {
    t4.advance(input_step_ms)
    t4.touch(1, 100.0, 70.0 - j.to_double() * 8.0)
    t4.draw()
    j = j + 1
  }
  let lit_during_scroll = shown_in_scroll.v
  t4.touch(2, 100.0, 22.0)
  t4.draw()
  debug_assert(
    lit_before_scroll && !lit_during_scroll && !shown_in_scroll.v && clicks.v == 0,
    "late scroll after tap_indication_ms clears press_shown immediately and cancels click",
  )
  t4.dispose()

  // 5. Finger inside scroller, quick tap (< tap_indication_ms): never flashes, still clicks on release
  let t5 = make(Pointing::Finger)
  t5.touch(0, 100.0, 70.0)
  t5.draw()
  t5.run_for(tap_indication_ms / 2.0)
  let quick_before = shown_in_scroll.v
  t5.touch(2, 100.0, 70.0)
  t5.draw()
  debug_assert(!quick_before && !shown_in_scroll.v && clicks.v == 1, "quick tap never flashes press_shown and fires 1 click")
  t5.dispose()

  // 6. Mouse inside scroller: press_shown() lights immediately at t=0
  let t6 = make(Pointing::Mouse)
  t6.press_at(100.0, 70.0)
  t6.draw()
  let mouse_at_0 = shown_in_scroll.v
  t6.release(100.0, 70.0)
  t6.draw()
  debug_assert(mouse_at_0 && !shown_in_scroll.v && clicks.v == 1, "mouse inside scroller highlights immediately and fires 1 click")
  t6.dispose()
}
