import "halt"
import "mbt_compat"

// A Style said as text, `css("row h=S7 px=S2 radius=Lg hovered{bg=Hover}")`: what `style(…)` says, read as the app
// starts. An app's named styles are constants (a top-level `let`), and moonc made each `style(…)` call ~5-10 KB of C
// in `module_init` (a temporary, an assignment and a decref for every one of its ~38 optional parameters): ~1400 of
// them were ~11.8 MB of C in one function, built again on every build (2026-10-24: 38 s of Windows' MSVC, and most of
// its link). Said as text they are data, a string each, read here once.

///|
/// A Style from its text: items apart by spaces, each a property as `style(…)` names it with a token as
/// style_tokens.pion (and node.pion's Align, Justify) names it: `w=Full`, `px=S2`, `align=ACenter`, `bg=A(Fg, O35)`,
/// `w=Grow(1.0)`, `radius=Exact(3.5)`; `row` and `clip` alone are `=true`. A state's block is its name and the same
/// items in braces: `pressed{bg=Over(Card, A(Fg, O5))}` (narrow, dark, selected, hovered, focused, pressed, disabled).
/// A token is read as its property's type has it (`Full` a Len's in `w=`, a Radius's in `radius=`); a number as its
/// literal in code (the same Double: no more than 2^53 in its digits, and a power of ten of no more than 22, read
/// exactly). Whatever it does not know (a property, a token, a block) aborts naming the text: the constants are read
/// as the app starts, so a mistyped one fails every test at once.
pub fn css(text : String) -> Style {
  match css_read(text) {
    Ok(st) => st
    Err(said) => halt::saying(said, loc="style_css.pion:19:18")
  }
}

///|
/// What css(text) reads, or what it says of the text where it cannot (the words css stops with: the two are one reading,
/// css stopping on what this says).
pub fn css_read(text : String) -> Result[Style, String] {
  match css_parse(text) { Ok(st) => Ok(st), Err(__mbt_err_30) => match __mbt_err_30 { CssError(said) => Err(said) } }
}

///|
/// What a css text is short of: the words said of it (Css::fail).
enum CssError {
  CssError(String)
}

///|
fn css_parse(text : String) -> Result[Style, CssError] { Ok({
  let r : Css = Css::{ s: text, i: 0, depth: 0 }
  let st : CssStates = CssStates::{
    narrow: Option::None,
    dark: Option::None,
    selected: Option::None,
    hovered: Option::None,
    focused: Option::None,
    pressed: Option::None,
    disabled: Option::None,
  }
  let base = r.patch(Some(st))?
  Style::{
    base: base,
    narrow: st.narrow,
    dark: st.dark,
    selected: st.selected,
    hovered: st.hovered,
    focused: st.focused,
    pressed: st.pressed,
    disabled: st.disabled,
  }
}) }

///|
/// The text being read and how far.
struct Css {
  s : String
  mut i : Int
  mut depth : Int
}

///|
/// The state blocks read so far, at the top of a style's text.
struct CssStates {
  mut narrow : Option[Patch]
  mut dark : Option[Patch]
  mut selected : Option[Patch]
  mut hovered : Option[Patch]
  mut focused : Option[Patch]
  mut pressed : Option[Patch]
  mut disabled : Option[Patch]
}

///|
fn Css::fail[T](self : Css, what : String) -> Result[T, CssError] {
  return Err(.CssError("css: \{what} at \{self.i} in \"\{self.s}\""))
}

///|
/// The character it is at; NUL past the end.
fn Css::peek(self : Css) -> Char {
  if self.i < mbt_compat::utf16_len(self.s) {
    mbt_compat::utf16_code_unit_at(self.s, self.i).to_int().unsafe_to_char()
  } else {
    '\u{0}'
  }
}

///|
fn Css::space(self : Css) -> Unit {
  while self.i < mbt_compat::utf16_len(self.s) {
    match self.peek() {
      ' ' | '\n' | '\t' => self.i += 1
      _ => break
    }
  }
}

///|
/// A name: a property's, a token's, a block's.
fn Css::name(self : Css) -> Result[String, CssError] { Ok({
  self.space()
  let a = self.i
  while self.i < mbt_compat::utf16_len(self.s) {
    match self.peek() {
      __mbt_rp_156 if (__mbt_rp_156 >= 'a' && __mbt_rp_156 <= 'z') || (__mbt_rp_156 >= 'A' && __mbt_rp_156 <= 'Z') || (__mbt_rp_156 >= '0' && __mbt_rp_156 <= '9') || (__mbt_rp_156 == '_') => self.i += 1
      _ => break
    }
  }
  if self.i == a {
    self.fail("a name wanted")?
  }
  mbt_compat::str_exact_view(self.s, start=a, end=self.i)
}) }

///|
fn Css::expect(self : Css, c : Char) -> Result[Unit, CssError] {
  self.space()
  if self.peek() != c {
    self.fail("\{c} wanted")?
  }
  self.i += 1
  Ok(())
}

///|
/// 10^e, for e of 0 … 22: the powers of ten a Double holds exactly.
fn css_pow10(e : Int) -> Result[Double, CssError] { Ok({
  match e {
    0 => 1.0e0
    1 => 1.0e1
    2 => 1.0e2
    3 => 1.0e3
    4 => 1.0e4
    5 => 1.0e5
    6 => 1.0e6
    7 => 1.0e7
    8 => 1.0e8
    9 => 1.0e9
    10 => 1.0e10
    11 => 1.0e11
    12 => 1.0e12
    13 => 1.0e13
    14 => 1.0e14
    15 => 1.0e15
    16 => 1.0e16
    17 => 1.0e17
    18 => 1.0e18
    19 => 1.0e19
    20 => 1.0e20
    21 => 1.0e21
    22 => 1.0e22
    _ => return Err(.CssError("css: 10^\{e} is not exact"))
  }
}) }

///|
/// A number, as moonc reads its literal: its digits an integer m (`_` left out), its point and exponent a power of
/// ten e; with m at most 2^53 and e within ±22 both are Doubles exactly and m·10^e (or m/10^-e) is one rounding, the
/// nearest Double, which is what the literal is (Clinger's fast path). One past that aborts rather than be near.
fn Css::num(self : Css) -> Result[Double, CssError] { Ok({
  self.space()
  let neg = self.peek() == '-'
  if neg {
    self.i += 1
  }
  let most = 9007199254740992L // 2^53
  let mut m = 0L
  let mut e = 0
  let mut digits = false
  let mut point = false
  while self.i < mbt_compat::utf16_len(self.s) {
    let c = self.peek()
    match c {
      __mbt_rp_157 if (__mbt_rp_157 >= '0' && __mbt_rp_157 <= '9') => {
        m = m * 10L + (c.to_int() - 48).to_int64()
        if m > most {
          self.fail("a number with more digits than read exactly")?
        }
        if point {
          e -= 1
        }
        digits = true
      }
      '_' => ()
      '.' if !point => point = true
      _ => break
    }
    self.i += 1
  }
  if !digits {
    self.fail("a number wanted")?
  }
  if self.peek() == 'e' || self.peek() == 'E' {
    self.i += 1
    let eneg = self.peek() == '-'
    if eneg || self.peek() == '+' {
      self.i += 1
    }
    let mut x = 0
    let a = self.i
    while self.peek() >= '0' && self.peek() <= '9' && x < 1000 {
      x = x * 10 + (self.peek().to_int() - 48)
      self.i += 1
    }
    if self.i == a {
      self.fail("an exponent wanted")?
    }
    e += if eneg { -x } else { x }
  }
  let v = if e >= 0 && e <= 22 {
    m.to_double() * css_pow10(e)?
  } else if e < 0 && e >= -22 {
    m.to_double() / css_pow10(-e)?
  } else {
    self.fail("a number with a power of ten not read exactly")?
  }
  if neg {
    -v
  } else {
    v
  }
}) }

///|
/// An Int64: decimal or `0x` hex (a colour's rrggbbaa).
fn Css::int64(self : Css) -> Result[Int64, CssError] { Ok({
  self.space()
  let neg = self.peek() == '-'
  if neg {
    self.i += 1
  }
  let hex = self.peek() == '0' &&
  self.i + 1 < mbt_compat::utf16_len(self.s) &&
  (mbt_compat::utf16_code_unit_at(self.s, self.i + 1).to_int() == 'x'.to_int() ||
    mbt_compat::utf16_code_unit_at(self.s, self.i + 1).to_int() == 'X'.to_int())
  if hex {
    self.i += 2
  }
  let base = if hex { 16L } else { 10L }
  let mut m = 0L
  let mut digits = false
  while self.i < mbt_compat::utf16_len(self.s) {
    let c = self.peek()
    let d = match c {
      __mbt_rp_158 if (__mbt_rp_158 >= '0' && __mbt_rp_158 <= '9') => c.to_int() - 48
      __mbt_rp_159 if ((__mbt_rp_159 >= 'a' && __mbt_rp_159 <= 'f')) && (hex) => c.to_int() - 87
      __mbt_rp_160 if ((__mbt_rp_160 >= 'A' && __mbt_rp_160 <= 'F')) && (hex) => c.to_int() - 55
      '_' => {
        self.i += 1
        continue
      }
      _ => break
    }
    if neg && m == 922337203685477580L && base == 10L && d == 8 {
      self.i += 1
      return Ok(-9223372036854775807L - 1L)
    }
    if m > mbt_compat::div_checked_i64((9223372036854775807L - d.to_int64()), base) {
      self.fail("a number past an Int64")?
    }
    m = m * base + d.to_int64()
    digits = true
    self.i += 1
  }
  if !digits {
    self.fail("a number wanted")?
  }
  if neg {
    -m
  } else {
    m
  }
}) }

///|
/// `(v)`, a constructor's one Double.
fn Css::arg(self : Css) -> Result[Double, CssError] { Ok({
  self.expect('(')?
  let v = self.num()?
  self.expect(')')?
  v
}) }

///|
fn Css::arg_int64(self : Css) -> Result[Int64, CssError] { Ok({
  self.expect('(')?
  let v = self.int64()?
  self.expect(')')?
  v
}) }

///|
fn Css::bool(self : Css) -> Result[Bool, CssError] { Ok({
  let n = self.name()?
  match n {
    "true" => true
    "false" => false
    _ => self.fail("no Bool \{n}")?
  }
}) }

///|
fn Css::len(self : Css) -> Result[Len, CssError] { Ok({
  let n = self.name()?
  match n {
    "Hug" => Len::Hug
    "Cut" => Len::Cut
    "Full" => Len::Full
    "Grow" => Len::Grow(self.arg()?)
    "Fixed" => Len::Fixed(self.arg()?)
    "Pct" => Len::Pct(self.arg()?)
    "Within" => Len::Within(self.arg()?)
    "S0" => Len::S0
    "SPx" => Len::SPx
    "S0_5" => Len::S0_5
    "S1" => Len::S1
    "S1_25" => Len::S1_25
    "S1_5" => Len::S1_5
    "S2" => Len::S2
    "S2_5" => Len::S2_5
    "S3" => Len::S3
    "S3_5" => Len::S3_5
    "S4" => Len::S4
    "S4_5" => Len::S4_5
    "S5" => Len::S5
    "S6" => Len::S6
    "S7" => Len::S7
    "S8" => Len::S8
    "S9" => Len::S9
    "S10" => Len::S10
    "S11" => Len::S11
    "S12" => Len::S12
    "S14" => Len::S14
    "S16" => Len::S16
    "S20" => Len::S20
    "S24" => Len::S24
    "S28" => Len::S28
    "S32" => Len::S32
    "S36" => Len::S36
    "S40" => Len::S40
    "S44" => Len::S44
    "S48" => Len::S48
    "S52" => Len::S52
    "S56" => Len::S56
    "S60" => Len::S60
    "S64" => Len::S64
    "S72" => Len::S72
    "S80" => Len::S80
    "S96" => Len::S96
    _ => self.fail("no Len \{n}")?
  }
}) }

///|
fn Css::space_token(self : Css) -> Result[Space, CssError] { Ok({
  let n = self.name()?
  match n {
    "S0" => Space::S0
    "SPx" => Space::SPx
    "S0_5" => Space::S0_5
    "S1" => Space::S1
    "S1_25" => Space::S1_25
    "S1_5" => Space::S1_5
    "S2" => Space::S2
    "S2_5" => Space::S2_5
    "S3" => Space::S3
    "S3_5" => Space::S3_5
    "S4" => Space::S4
    "S4_5" => Space::S4_5
    "S5" => Space::S5
    "S6" => Space::S6
    "S7" => Space::S7
    "S8" => Space::S8
    "S9" => Space::S9
    "S10" => Space::S10
    "S11" => Space::S11
    "S12" => Space::S12
    "S14" => Space::S14
    "S16" => Space::S16
    "S20" => Space::S20
    "S24" => Space::S24
    "S28" => Space::S28
    "S32" => Space::S32
    "S36" => Space::S36
    "S40" => Space::S40
    "S44" => Space::S44
    "S48" => Space::S48
    "S52" => Space::S52
    "S56" => Space::S56
    "S60" => Space::S60
    "S64" => Space::S64
    "S72" => Space::S72
    "S80" => Space::S80
    "S96" => Space::S96
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    "Exact" => Space::Exact(self.arg()?)
    _ => self.fail("no Space \{n}")?
  }
}) }

///|
fn Css::align(self : Css) -> Result[Align, CssError] { Ok({
  let n = self.name()?
  match n {
    "AStart" => Align::AStart
    "ACenter" => Align::ACenter
    "AEnd" => Align::AEnd
    "AStretch" => Align::AStretch
    "AFirstLine" => Align::AFirstLine
    "ABaseline" => Align::ABaseline
    _ => self.fail("no Align \{n}")?
  }
}) }

///|
fn Css::justify(self : Css) -> Result[Justify, CssError] { Ok({
  let n = self.name()?
  match n {
    "JStart" => Justify::JStart
    "JCenter" => Justify::JCenter
    "JEnd" => Justify::JEnd
    "JBetween" => Justify::JBetween
    "JAround" => Justify::JBetween
    "JEvenly" => Justify::JBetween
    _ => self.fail("no Justify \{n}")?
  }
}) }

///|
fn Css::radius(self : Css) -> Result[Radius, CssError] { Ok({
  if self.depth >= 64 {
    self.fail("nesting too deep")?
  }
  self.depth += 1
  let n = self.name()?
  let res = match n {
    "Sharp" => Radius::Sharp
    "Sm" => Radius::Sm
    "Base" => Radius::Base
    "Md" => Radius::Md
    "Lg" => Radius::Lg
    "Xl" => Radius::Xl
    "Xl1_5" => Radius::Xl1_5
    "Xl2" => Radius::Xl2
    "Xl3" => Radius::Xl3
    "Xl4" => Radius::Xl4
    "Full" => Radius::Full
    "Inner" => Radius::Inner
    "InnerOr" => {
      self.expect('(')?
      let own = self.radius()?
      self.expect(')')?
      Radius::InnerOr(own)
    }
    "Around" => Radius::Around
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    "Exact" => Radius::Exact(self.arg()?)
    _ => self.fail("no Radius \{n}")?
  }
  self.depth -= 1
  res
}) }

///|
fn Css::stroke(self : Css) -> Result[Stroke, CssError] { Ok({
  let n = self.name()?
  match n {
    "B0" => Stroke::B0
    "B0_5" => Stroke::B0_5
    "B1" => Stroke::B1
    "B1_5" => Stroke::B1_5
    "B2" => Stroke::B2
    "B4" => Stroke::B4
    "B8" => Stroke::B8
    _ => self.fail("no Stroke \{n}")?
  }
}) }

///|
fn Css::shadow(self : Css) -> Result[Shadow, CssError] { Ok({
  let n = self.name()?
  match n {
    "NoShadow" => Shadow::NoShadow
    "Sm" => Shadow::Sm
    "Base" => Shadow::Base
    "Md" => Shadow::Md
    "Lg" => Shadow::Lg
    "Xl" => Shadow::Xl
    "Cast" => {
      self.expect('(')?
      let blur = self.num()?
      self.expect(',')?
      let y = self.num()?
      self.expect(',')?
      let c = self.int64()?
      self.expect(')')?
      Shadow::Cast(blur, y, c)
    }
    _ => self.fail("no Shadow \{n}")?
  }
}) }

///|
fn Css::opacity(self : Css) -> Result[Opacity, CssError] { Ok({
  let n = self.name()?
  match n {
    "O0" => Opacity::O0
    "O5" => Opacity::O5
    "O10" => Opacity::O10
    "O15" => Opacity::O15
    "O20" => Opacity::O20
    "O25" => Opacity::O25
    "O30" => Opacity::O30
    "O35" => Opacity::O35
    "O40" => Opacity::O40
    "O45" => Opacity::O45
    "O50" => Opacity::O50
    "O55" => Opacity::O55
    "O60" => Opacity::O60
    "O65" => Opacity::O65
    "O70" => Opacity::O70
    "O75" => Opacity::O75
    "O80" => Opacity::O80
    "O85" => Opacity::O85
    "O90" => Opacity::O90
    "O95" => Opacity::O95
    "O100" => Opacity::O100
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    "Exact" => Opacity::Exact(self.arg()?)
    _ => self.fail("no Opacity \{n}")?
  }
}) }

///|
fn Css::color(self : Css) -> Result[Color, CssError] { Ok({
  if self.depth >= 64 {
    self.fail("nesting too deep")?
  }
  self.depth += 1
  let n = self.name()?
  let res = match n {
    "Clear" => Color::Clear
    "Bg" => Color::Bg
    "Surface" => Color::Surface
    "Raised" => Color::Raised
    "Card" => Color::Card
    "Fg" => Color::Fg
    "Muted" => Color::Muted
    "Subtle" => Color::Subtle
    "Faint" => Color::Faint
    "Line" => Color::Line
    "Border" => Color::Border
    "Accent" => Color::Accent
    "AccentText" => Color::AccentText
    "AccentBg" => Color::AccentBg
    "OnAccent" => Color::OnAccent
    "Primary" => Color::Primary
    "OnPrimary" => Color::OnPrimary
    "Positive" => Color::Positive
    "Danger" => Color::Danger
    "DangerBg" => Color::DangerBg
    "OnDanger" => Color::OnDanger
    "Neutral" => Color::Neutral
    "Hover" => Color::Hover
    "Selected" => Color::Selected
    "Focus" => Color::Focus
    "Scrim" => Color::Scrim
    "Link" => Color::Link
    "ShadowC" => Color::ShadowC
    "Warn" => Color::Warn
    "WarnInk" => Color::WarnInk
    "Tint" => Color::Tint
    "TintStrong" => Color::TintStrong
    "Floating" => Color::Floating
    "Veil" => Color::Veil
    "VeilDeep" => Color::VeilDeep
    "OnVeil" => Color::OnVeil
    "Theater" => Color::Theater
    "Lifted" => Color::Lifted
    "Wash" => Color::Wash
    "Sidebar" => Color::Sidebar
    "ListGround" => Color::ListGround
    "FieldHover" => Color::FieldHover
    "A" => {
      self.expect('(')?
      let c = self.color()?
      self.expect(',')?
      let o = self.opacity()?
      self.expect(')')?
      Color::A(c, o)
    }
    "Over" => {
      self.expect('(')?
      let a = self.color()?
      self.expect(',')?
      let b = self.color()?
      self.expect(')')?
      Color::Over(a, b)
    }
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    // det-ok(style-exact, style-literal): what a style's text says, counted at the text (detlint's css)
    "Exact" => Color::Exact(self.arg_int64()?)
    "Data" => Color::Data(self.arg_int64()?)
    _ => self.fail("no Color \{n}")?
  }
  self.depth -= 1
  res
}) }

///|
/// The items up to the end (`states` given: the top, where the state blocks are) or up to a block's `}`.
fn Css::patch(self : Css, states : Option[CssStates]) -> Result[Patch, CssError] { Ok({
  let mut row : Option[Bool] = Option::None
  let mut w : Option[Len] = Option::None
  let mut h : Option[Len] = Option::None
  let mut min_w : Option[Len] = Option::None
  let mut max_w : Option[Len] = Option::None
  let mut min_h : Option[Len] = Option::None
  let mut max_h : Option[Len] = Option::None
  let mut p : Option[Space] = Option::None
  let mut px : Option[Space] = Option::None
  let mut py : Option[Space] = Option::None
  let mut pl : Option[Space] = Option::None
  let mut pr : Option[Space] = Option::None
  let mut pt : Option[Space] = Option::None
  let mut pb : Option[Space] = Option::None
  let mut m : Option[Space] = Option::None
  let mut mx : Option[Space] = Option::None
  let mut my : Option[Space] = Option::None
  let mut ml : Option[Space] = Option::None
  let mut mr : Option[Space] = Option::None
  let mut mt : Option[Space] = Option::None
  let mut mb : Option[Space] = Option::None
  let mut gap : Option[Space] = Option::None
  let mut align : Option[Align] = Option::None
  let mut justify : Option[Justify] = Option::None
  let mut bg : Option[Color] = Option::None
  let mut radius : Option[Radius] = Option::None
  let mut border : Option[Stroke] = Option::None
  let mut border_color : Option[Color] = Option::None
  let mut dashed : Option[Bool] = Option::None
  let mut shadow : Option[Shadow] = Option::None
  let mut clip : Option[Bool] = Option::None
  let mut opacity : Option[Opacity] = Option::None
  while true {
    self.space()
    if self.i >= mbt_compat::utf16_len(self.s) {
      if states is Option::None {
        self.fail("a block not closed")?
      }
      break
    }
    if self.peek() == '}' {
      if states is Some(_) {
        self.fail("a } closing no block")?
      }
      self.i += 1
      break
    }
    let key = self.name()?
    match self.peek() {
      '{' => {
        self.i += 1
        match states {
          Some(st) => {

            let b = Some(self.patch(Option::None)?)
            match key {
              "narrow" => st.narrow = b
              "dark" => st.dark = b
              "selected" => st.selected = b
              "hovered" => st.hovered = b
              "focused" => st.focused = b
              "pressed" => st.pressed = b
              "disabled" => st.disabled = b
              _ => self.fail("no state \{key}")?
            }
          }
          _ => { self.fail("a block in a block")? }
        }
      }
      '=' => {
        self.i += 1
        match key {
          "row" => row = Some(self.bool()?)
          "w" => w = Some(self.len()?)
          "h" => h = Some(self.len()?)
          "min_w" => min_w = Some(self.len()?)
          "max_w" => max_w = Some(self.len()?)
          "min_h" => min_h = Some(self.len()?)
          "max_h" => max_h = Some(self.len()?)
          "p" => p = Some(self.space_token()?)
          "px" => px = Some(self.space_token()?)
          "py" => py = Some(self.space_token()?)
          "pl" => pl = Some(self.space_token()?)
          "pr" => pr = Some(self.space_token()?)
          "pt" => pt = Some(self.space_token()?)
          "pb" => pb = Some(self.space_token()?)
          "m" => m = Some(self.space_token()?)
          "mx" => mx = Some(self.space_token()?)
          "my" => my = Some(self.space_token()?)
          "ml" => ml = Some(self.space_token()?)
          "mr" => mr = Some(self.space_token()?)
          "mt" => mt = Some(self.space_token()?)
          "mb" => mb = Some(self.space_token()?)
          "gap" => gap = Some(self.space_token()?)
          "align" => align = Some(self.align()?)
          "justify" => justify = Some(self.justify()?)
          "bg" => bg = Some(self.color()?)
          "radius" => radius = Some(self.radius()?)
          "border" => border = Some(self.stroke()?)
          "border_color" => border_color = Some(self.color()?)
          "dashed" => dashed = Some(self.bool()?)
          "shadow" => shadow = Some(self.shadow()?)
          "clip" => clip = Some(self.bool()?)
          "opacity" => opacity = Some(self.opacity()?)
          _ => self.fail("no property \{key}")?
        }
      }
      _ =>
      match key {
        "row" => row = Some(true)
        "clip" => clip = Some(true)
        "dashed" => dashed = Some(true)
        _ => self.fail("\{key} with no value")?
      }
    }
    // an item ends at a space, a block's end or the text's
    match self.peek() {
      ' ' | '\n' | '\t' | '}' => ()
      _ if self.i >= mbt_compat::utf16_len(self.s) => ()
      _ => self.fail("an item not ended by a space")?
    }
  }
  Patch::{
    row: row,
    w: w,
    h: h,
    min_w: min_w,
    max_w: max_w,
    min_h: min_h,
    max_h: max_h,
    p: p,
    px: px,
    py: py,
    pl: pl,
    pr: pr,
    pt: pt,
    pb: pb,
    m: m,
    mx: mx,
    my: my,
    ml: ml,
    mr: mr,
    mt: mt,
    mb: mb,
    gap: gap,
    align: align,
    justify: justify,
    bg: bg,
    radius: radius,
    border: border,
    border_color: border_color,
    dashed: dashed,
    shadow: shadow,
    clip: clip,
    opacity: opacity,
  }
}) }
