// Pure-node drag-and-drop receivers for text, filesystem paths, and picked files,
// plus deterministic Tester driving helpers.

import "hostapi"
import "signals"
import "view"

/// A filesystem path dropped onto a view node.
pub struct DroppedPath {
  pub path : String
  pub name : String
  pub is_dir : Bool
}

/// Reactive hover/active state for a drop target node.
pub struct DropZoneState {
  pub active : signals::Signal[Bool]
  pub hovered : signals::Signal[Bool]
}

struct DropWordsTarget {
  id : view::NodeId
  field : Field
  state : DropZoneState
}

struct DropPathsTarget {
  id : view::NodeId
  on_paths : (Array[DroppedPath]) -> Unit
  state : DropZoneState
}

struct DropFilesTarget {
  id : view::NodeId
  on_files : (Array[hostapi::Picked]) -> Unit
  state : DropZoneState
}

struct DropRegistry {
  words : Array[DropWordsTarget]
  paths : Array[DropPathsTarget]
  files : Array[DropFilesTarget]
}

let drop_registry : DropRegistry = DropRegistry::{ words: [], paths: [], files: [] }

/// Whether the current host supports receiving external drops (desktop & web).
pub fn takes_drops() -> Bool {
  let p = hostapi::platform()
  p == 0 || p == 3 || p == 4 || p == 5
}

fn new_drop_zone_state() -> DropZoneState {
  DropZoneState::{ active: signals::signal(false), hovered: signals::signal(false) }
}

fn drop_point_hits(id : view::NodeId, x : Double, y : Double) -> Bool {
  if x == 0.0 && y == 0.0 {
    return true
  }
  match view_tree() {
    Some(tr) => match tr.drawn_of(id) {
      Some(d) => x >= d.x && x <= d.x + d.w && y >= d.y && y <= d.y + d.h
      None => false
    }
    None => true
  }
}

/// Bind `v` as a text-drop receiver that inserts dropped text into `fld`.
pub fn words_into(v : view::View, fld : Field) -> view::View {
  let id = v.id()
  let st = new_drop_zone_state()
  drop_registry.words.push(DropWordsTarget::{ id, field: fld, state: st })
  let _ = v.owns(fn() {
    let keep : Array[DropWordsTarget] = []
    for item in drop_registry.words {
      if item.id != id {
        keep.push(item)
      }
    }
    drop_registry.words.clear()
    for item in keep {
      drop_registry.words.push(item)
    }
  })
  v
}

/// Bind `v` as a filesystem-path drop receiver invoking `on_paths`.
pub fn paths_into(v : view::View, on_paths : (Array[DroppedPath]) -> Unit) -> view::View {
  let id = v.id()
  let st = new_drop_zone_state()
  drop_registry.paths.push(DropPathsTarget::{ id, on_paths, state: st })
  let _ = v.owns(fn() {
    let keep : Array[DropPathsTarget] = []
    for item in drop_registry.paths {
      if item.id != id {
        keep.push(item)
      }
    }
    drop_registry.paths.clear()
    for item in keep {
      drop_registry.paths.push(item)
    }
  })
  v
}

/// Bind `v` as a picked-file drop receiver invoking `on_files`.
pub fn files_into(v : view::View, on_files : (Array[hostapi::Picked]) -> Unit) -> view::View {
  let id = v.id()
  let st = new_drop_zone_state()
  drop_registry.files.push(DropFilesTarget::{ id, on_files, state: st })
  let _ = v.owns(fn() {
    let keep : Array[DropFilesTarget] = []
    for item in drop_registry.files {
      if item.id != id {
        keep.push(item)
      }
    }
    drop_registry.files.clear()
    for item in keep {
      drop_registry.files.push(item)
    }
  })
  v
}

/// Inspect the reactive `DropZoneState` attached to `v`, if any.
pub fn drop_zone_state(v : view::View) -> Option[DropZoneState] {
  let id = v.id()
  for t in drop_registry.files {
    if t.id == id {
      return Some(t.state)
    }
  }
  for t in drop_registry.paths {
    if t.id == id {
      return Some(t.state)
    }
  }
  for t in drop_registry.words {
    if t.id == id {
      return Some(t.state)
    }
  }
  None
}

/// Test driver helper: deliver `files` to the topmost matching `files_into` target at `(x, y)`.
pub fn Tester::hold_files(
  self : Tester,
  files : Array[hostapi::Picked],
  x~ : Double = 0.0,
  y~ : Double = 0.0,
) -> Bool {
  let mut i = drop_registry.files.length() - 1
  while i >= 0 {
    let t = drop_registry.files[i]
    if drop_point_hits(t.id, x, y) {
      t.state.active.set(true)
      t.state.hovered.set(true)
      (t.on_files)(files)
      t.state.hovered.set(false)
      t.state.active.set(false)
      self.fake.frame_requested = true
      self.frame()
      return true
    }
    i -= 1
  }
  false
}

/// Test driver helper: drop `words` onto the topmost matching `words_into` target at `(x, y)`.
pub fn Tester::drop_words(
  self : Tester,
  words : String,
  x~ : Double = 0.0,
  y~ : Double = 0.0,
) -> Bool {
  let mut i = drop_registry.words.length() - 1
  while i >= 0 {
    let t = drop_registry.words[i]
    if drop_point_hits(t.id, x, y) {
      t.state.active.set(true)
      t.state.hovered.set(true)
      t.field.insert(words)
      t.state.hovered.set(false)
      t.state.active.set(false)
      self.fake.frame_requested = true
      self.frame()
      return true
    }
    i -= 1
  }
  false
}

/// Test driver helper: drop filesystem `paths` onto the topmost matching `paths_into` target at `(x, y)`.
pub fn Tester::drop_paths(
  self : Tester,
  paths : Array[DroppedPath],
  x~ : Double = 0.0,
  y~ : Double = 0.0,
) -> Bool {
  let mut i = drop_registry.paths.length() - 1
  while i >= 0 {
    let t = drop_registry.paths[i]
    if drop_point_hits(t.id, x, y) {
      t.state.active.set(true)
      t.state.hovered.set(true)
      (t.on_paths)(paths)
      t.state.hovered.set(false)
      t.state.active.set(false)
      self.fake.frame_requested = true
      self.frame()
      return true
    }
    i -= 1
  }
  false
}
