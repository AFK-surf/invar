// origin: drop.pion:492:1:9:36
// origin-probes: mbt_div_probe=524:48,524:82,528:34,528:68,590:69,590:103;mbt_val_probe=524:68,524:102,528:54,528:88,590:89,590:123
let __mbt_init_drop_mbt_1 : Unit = {
  on_message("mbui.drop", fn(json, _) {
    let v = match mbt_compat::mbt_json_parse(json) { Ok(__mbt_ok_6) => __mbt_ok_6, Err(_) => mbt_compat::MbtJson::null() }
    let num = fn(key : String) {
      match v {
        .Object(m) =>
        match m.get(key) {
          Option::Some(.Number(n, _)) => n
          _ => 0.0
        }
        _ => 0.0
      }
    }
    let kind = match v {
      .Object(m) =>
      match m.get("type") {
        Option::Some(String(s)) => s
        _ => ""
      }
      _ => ""
    }
    // (the window they are over or let go on, as the host says it: 0 the first, or a window beside it; taken in that
    // window's state, its zoom, its tree and what it holds; one closed since, none, what it named let go)
    let wid = num("wid").to_int()
    if wid < 0 || (wid > 0 && !windows_beside.contains(wid)) {
      if kind == "drop" {
        forget_drop(num("pick").to_int())
      }
      return
    }
    as_window(wid, fn() {
      match kind {
        "over" => files_held_at(Some((num("x") / window_zoom_drawn.v, num("y") / window_zoom_drawn.v)))
        "drop" => {
          files_held_at(Option::None)
          let id = num("pick").to_int()
          let (x, y) = (num("x") / window_zoom_drawn.v, num("y") / window_zoom_drawn.v)
          // (where they are, as the host says: taken so, they are not read)
          let paths = match v {
            .Object(m) =>
            match m.get("paths") {
              Option::Some(Array(ps)) =>
              mbt_compat::arr_filter_map(ps, fn(p) {
                match p {
                  .Object(o) =>
                  match (o.get("path"), o.get("dir"), o.get("size")) {
                    (Some(String(path)), dir, size) if path != "" =>
                    Some(DroppedPath::{
                      path: path,
                      dir: dir is Some(.True),
                      size: if size is Option::Some(.Number(n, _)) { n } else { 0.0 },
                    })
                    _ => Option::None
                  }
                  .String(path) if path != "" => Some(DroppedPath::{ path: path, dir: false, size: 0.0 })
                  _ => Option::None
                }
              })
              _ => []
            }
            _ => []
          }
          // (the window's tree's first, by their paths (tree_paths_at); where none of it took them, taken as they are let
          // go by what of an old view takes them there, Ctx::on_files: not those let go on a field with their paths, which
          // are the field's)
          old_input_brought()
          let c = g()
          match tree_paths_at(c, x, y, paths, id) {
            TreeDropped::Not => {
              let on_field = !paths.is_empty() && c.editors.contains(hit_in(c.hit_ids, c.hit_rects, x, y))
              let take_tree = if on_field {
                None
              } else {
                match tree_files_at(x, y) {
                  (Some(f), _) => (f.take)(x, y)
                  _ => None
                }
              }
              match (if on_field { None } else if take_tree is Some(_) { take_tree } else { files_take_at(x, y) }) {
                Some(take) => take(Pick::waits([hostapi::dropped_pick(id)], "files dropped"))
                // (taken by none as files: left to this frame's build, what takes them by their paths or reads them for
                // its field (Ctx::paths_into, Ctx::files_into), else let go as it ends, drops_frame_end)
                // (taken by none as files: left to this frame's build, what takes them by their paths or reads them for
                // its field (Ctx::paths_into, Ctx::files_into), else let go as it ends, drops_frame_end)
                Option::None =>
                if id > 0 || !paths.is_empty() {
                  paths_let_go(x, y, paths, id)
                } else {
                  forget_drop(id)
                }
              }
            }
            // (taken by the tree, or shut under a modal layer)
            // (taken by the tree, or shut under a modal layer)
            .Took | TreeDropped::Shut => hand_event()
          }
        }
        "words" => {
          files_held_at(Option::None)
          match v {
            .Object(m) =>
            match m.get("text") {
              Option::Some(String(s)) if s != "" => words_let_go(num("x") / window_zoom_drawn.v, num("y") / window_zoom_drawn.v, s)
              _ => ()
            }
            _ => ()
          }
        }
        _ => files_held_at(Option::None)
      }
    })
