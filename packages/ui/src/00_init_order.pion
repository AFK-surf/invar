  })
  signals::effect_in_computed.v = Some(fn(loc) {
    view::fault("[EFFECT_IN_COMPUTED] An effect made as a computed's getter runs is made anew every time and has no owner to stop it. Effect made at \{loc}. " +
      "Fix: keep the getter a value calculation. Follow changes where the value is read (a watch, View::reacts, a binding), or make the effect where its owner is made.")
  })
}

