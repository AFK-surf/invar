import "flex"
import "mbt_compat"
import "signals"
import "view"

// A stack of pages, as the app's Android app moves between them:
// a page pushed comes in whole from the right as the one under it goes out whole to the left, side by side,
// following `move_path` over `move_ms(distance)` (distance-adaptive duration on Move ease), nothing fading;
// back, the other way. A page the stack says comes from the left (`from_left`) comes in from there, the one under it
// going out to the right, and goes back that way. Swiped back (from the left edge with a finger or a mouse here; on
// Android, the system's back gesture, its predictive back, and no edge of ui's), the page follows the finger and the
// one under it comes along beside it, edge to edge; let go past a third of the way (or flung) it continues along
// `move_path` over `move_ms(remaining)`, else it returns along `move_path` over `move_ms(remaining)`.
//
// A page brought in (pushed, risen, gone back to) is built whole in the frame its slide starts in, which may take longer
// than the display's frame (its words shaped, its rows laid out for the first time): its slide's clock does not run
// while that frame is late to the screen (the host says how late: @hostapi.frame_late), up to nav_late_most, so it
// moves from where that frame drew it at the display's pace, no step skipped, the wait before it moves instead
// (UIKit's and Android's transitions build the page before they start too).
//
// While a page slides in, the one it covers takes no press (drawn only, as UIKit's and Android's transitions keep
// touches from the page underneath): a press where its button still shows goes to the page coming, or to nothing;
// going back, the page leaving takes none.
//
// Only the top page is built while nothing moves; the pages under it keep
// what their widgets hold (a list's scroll, a field's words), each page's
// ids in a scope of its own, until the page leaves the stack: then it is
// forgotten (and `on_leave` told, for what the app keeps for it), so the
// same page pushed again starts afresh.

///|
struct NavPage[P] {
  serial : Int
  mut ended : Bool
  mut page : P
  mut under : Option[P]
  mut rise : Bool
  mut over : Bool
  mut stint : Int
  mut focus_kept : Int
  mut shown_once : Bool
  mut told_left : Bool
  mut taken_back : Bool
}

///|
/// Pages' serials, unique across every Nav: a page's scope and its state's
/// owner.
// kept across runs: it goes on counting: a Nav made before its Tester holds pages numbered already
// moved to 00_init_order.pion: nav_serial

///|
fn nav_page[P](page : P, under : Option[P]) -> NavPage[P] {
  nav_serial.v = nav_serial.v + 1
  NavPage::{
    serial: nav_serial.v,
    ended: false,
    page: page,
    under: under,
    rise: false,
    over: false,
    stint: next_stint(),
    focus_kept: 0,
    shown_once: false,
    told_left: false,
    taken_back: false,
  }
}

///|
/// Pages' times on top, unique across every Nav.
// kept across runs: it goes on counting, as nav_serial does
// moved to 00_init_order.pion: nav_stint

///|
fn next_stint() -> Int {
  nav_stint.v = nav_stint.v + 1
  nav_stint.v
}

///|
/// The page now on top (the one under a page that went) put there anew.
fn Nav::topped[P](self : Nav[P]) -> Unit {
  if self.pages.length() > 0 {
    self.pages[self.pages.length() - 1].stint = next_stint()
  }
}

///|
pub struct Nav[P] {
  priv pages : Array[NavPage[P]]
  priv mut mode : Int
  priv mut leaving : Option[NavPage[P]]
  priv gone : Array[NavPage[P]]
  priv mut p : Double
  priv finger : signals::Signal[Double]
  priv said : signals::Signal[Int]
  priv mut p0 : Double
  priv mut p1 : Double
  priv mut t0 : Double
  priv mut dur : Double
  priv mut dur_way : Option[Double]
  priv mut slide_room : Double
  priv slide_turn : flex::ComeKept
  priv mut v0 : Double
  priv mut room_w : Double
  priv mut room_h : Double
  priv mut x0 : Double
  priv mut vel : Double
  priv track : view::Tracker
  priv mut moved_x : Double
  priv mut moved_at : Double
  priv mut moved_progress : Double
  priv mut moved_p : Double
  priv on_leave : (P) -> Unit
  priv on_entry_leave : (Int, P) -> Unit
  priv on_entry_park : (Int, P) -> Unit
  priv on_entry_gone : (Int, P) -> Unit
  priv went_back : (P, Bool, Bool, Array[P]) -> Unit
  priv from_left : (P, Option[P]) -> Bool
  priv mover : Mover
  priv mut asked : Int
  priv mut wait_from : Double
  priv mut waited : Bool
  priv mut held_most : Double
  priv mut ended : Double
  priv mut waits_late : Bool
  priv mut late_at : Double
  priv mut flat_shown : Option[NavPage[P]]
  priv mut flat_frame : Int
  priv mut flat_ready : () -> Bool
  priv mut flat_most : Double
  priv mut flat_asked : Int
  priv mut flat_for : Int
  priv mut flat_from : Double
  priv mut flat_kept : Option[(Int, Int)]
  priv mut flat_owner : Bool
  priv mut focus_shown_gone : Option[((Int, Int), Int)]
  priv mut built : Option[NavPage[P]]
  priv mut floor : Int
  priv mut hosted : Option[NavHosted]
  priv shown : signals::Signal[Int]
  priv mut shelf : Array[NavPage[P]]
  priv mut shelves : Option[(P) -> Bool]
  priv mut kept_left : Array[(String, String, NavPage[P])]
  priv mut keeps_left : Option[(P) -> Option[(String, String)]]
  priv mut swap_out : Option[NavPage[P]]
  priv mut swap_in_serial : Int
  priv mut swap_way : Int
  priv mut swap_t0 : Double
  priv mut swap_dur : Double
  priv mut swap_kept : Bool
  priv swap_said : signals::Signal[Int]
  priv gesture_said : signals::Signal[Int]
}

///|
/// How many entries that left a stack it keeps at most (Nav's `kept_left`): the least lately used let go for good as
/// another is kept past it.
// moved to 00_init_order.pion: nav_kept_left_most

///|
/// Per-Nav `kept_left` quota configuration stored beside `Nav[P]` (keyed by `nav.said` identity) so `Nav[P]`'s C
/// struct layout in `decls.h` stays unchanged across `MBC_STORE` cached units.
struct NavKeptLeftLimits {
  mut most_of : Option[(String) -> Int]
  mut total : Int
}

///|
// kept across runs: per-Nav side table (only populated for Navs with custom limits; 0-2 entries)
// moved to 00_init_order.pion: nav_kept_left_limits

///|
// kept across runs: per-Nav side table filtering which `made` kinds may enter the root shelf
// moved to 00_init_order.pion: nav_shelf_kind_filters

///|
// kept across runs: per-Nav side table guarding root-shelf entry serials on park, swap_out settle, and take-back
// moved to 00_init_order.pion: nav_shelf_serial_guards

///|
// kept across runs: per-Nav side table guarding `(serial, key, kind)` before parking into `kept_left`
// moved to 00_init_order.pion: nav_kept_left_guards

///|
fn nav_shelf_kind_allows(said : signals::Signal[Int], kind : String) -> Bool {
  for entry in nav_shelf_kind_filters.v {
    if physical_equal(entry.0, said) {
      return (entry.1)(kind)
    }
  }
  true
}

///|
fn nav_shelf_serial_allows(said : signals::Signal[Int], serial : Int) -> Bool {
  for entry in nav_shelf_serial_guards.v {
    if physical_equal(entry.0, said) {
      return (entry.1)(serial)
    }
  }
  true
}

///|
fn nav_kept_left_guard_allows(said : signals::Signal[Int], serial : Int, key : String, kind : String) -> Bool {
  for entry in nav_kept_left_guards.v {
    if physical_equal(entry.0, said) {
      return (entry.1)(serial, key, kind)
    }
  }
  true
}

///|
fn nav_limits_get(said : signals::Signal[Int]) -> Option[NavKeptLeftLimits] {
  for entry in nav_kept_left_limits.v {
    if physical_equal(entry.0, said) {
      return Some(entry.1)
    }
  }
  Option::None
}

///|
fn nav_limits_set(said : signals::Signal[Int], most_of : Option[(String) -> Int], total : Int) -> Unit {
  if most_of is Option::None && total == nav_kept_left_most {
    match mbt_compat::arr_search_by(nav_kept_left_limits.v, fn(e) { physical_equal(e.0, said) }) {
      Some(i) => {
        mbt_compat::arr_remove(nav_kept_left_limits.v, i) |> ignore
        if nav_kept_left_limits.v.is_empty() {
          nav_kept_left_limits.v = []
        }
      }
      None => ()
    }
    return
  }
  for entry in nav_kept_left_limits.v {
    if physical_equal(entry.0, said) {
      entry.1.most_of = most_of
      entry.1.total = total
      return
    }
  }
  nav_kept_left_limits.v.push((said, NavKeptLeftLimits::{ most_of: most_of, total: total }))
}

///|
/// A stack of pages, `root` at the bottom. `on_leave` is told of each page
/// that leaves it for good (popped, once it has slid away); a page
/// `from_left` says yes to slides in from the left and back out that way, swiped back too. It is given the page and
/// the page under it as it was pushed. `went_back` is told of each page its own back takes off (the edge's
/// swipe, the system's back, Ctx::back), as it goes: what a forward puts back.
pub fn Nav::new[P](root : P, on_leave? : (P) -> Unit, on_entry_leave? : (Int, P) -> Unit, went_back? : (P, Bool, Bool, Array[P]) -> Unit, from_left? : (P, Option[P]) -> Bool, on_entry_park? : (Int, P) -> Unit, on_entry_gone? : (Int, P) -> Unit) -> Nav[P] {
  let on_leave = match on_leave { Some(__mbt_v) => __mbt_v, None => fn(_) { } }
  let on_entry_leave = match on_entry_leave { Some(__mbt_v) => __mbt_v, None => fn(_, _) { } }
  let went_back = match went_back { Some(__mbt_v) => __mbt_v, None => fn(_, _, _, _) { } }
  let from_left = match from_left { Some(__mbt_v) => __mbt_v, None => fn(_, _) { false } }
  let on_entry_park = match on_entry_park { Some(__mbt_v) => __mbt_v, None => fn(_, _) { } }
  let on_entry_gone = match on_entry_gone { Some(__mbt_v) => __mbt_v, None => fn(_, _) { } }

  Nav::{
    pages: [nav_page(root, None)],
    mode: 0,
    leaving: Option::None,
    gone: [],
    p: 0.0,
    finger: signals::signal(0.0),
    said: signals::signal(0),
    p0: 0.0,
    p1: 0.0,
    t0: -1.0,
    dur: 0.0,
    dur_way: Option::None,
    slide_room: 0.0,
    slide_turn: come_kept(),
    v0: 0.0,
    room_w: 0.0,
    room_h: 0.0,
    x0: 0.0,
    vel: 0.0,
    track: view::Tracker::new(),
    moved_x: 0.0,
    moved_at: 0.0,
    moved_progress: -1.0,
    moved_p: 0.0,
    on_leave: on_leave,
    on_entry_leave: on_entry_leave,
    on_entry_park: on_entry_park,
    on_entry_gone: on_entry_gone,
    went_back: went_back,
    from_left: from_left,
    mover: Mover::new(),
    asked: -1,
    wait_from: -1.0,
    waited: false,
    held_most: 0.0,
    ended: -1.0,
    waits_late: false,
    late_at: -1.0,
    flat_shown: Option::None,
    flat_frame: -1,
    flat_ready: fn() { true },
    flat_most: 0.0,
    flat_asked: -1,
    flat_for: -1,
    flat_from: -1.0,
    flat_kept: Option::None,
    flat_owner: false,
    focus_shown_gone: Option::None,
    built: Option::None,
    floor: 0,
    hosted: Option::None,
    shown: signals::signal(0),
    shelf: [],
    shelves: Option::None,
    kept_left: [],
    keeps_left: Option::None,
    swap_out: Option::None,
    swap_in_serial: 0,
    swap_way: 0,
    swap_t0: -1.0,
    swap_dur: 0.0,
    swap_kept: false,
    swap_said: signals::signal(0),
    gesture_said: signals::signal(0),
  }
}

///|
fn Nav::entry_left[P](self : Nav[P], entry : NavPage[P]) -> Unit {
  if entry.ended { return }
  entry.ended = true
  // (its leaving told as it was put by on the kept left: not again)
  if !entry.told_left {
    entry.told_left = true
    (self.on_entry_leave)(entry.serial, entry.page)
    (self.on_leave)(entry.page)
  }
  (self.on_entry_gone)(entry.serial, entry.page)
}

///|
/// Configure per-kind and total `kept_left` caps on `self`.
/// When `most_of` is `Some(f)`, each `kind` may keep at most `f(kind)` entries (`<= 0` refuses parking that kind);
/// `total` caps total entries across all kinds (defaults to `nav_kept_left_most`).
pub fn Nav::set_kept_left_limits[P](self : Nav[P], most_of? : (String) -> Int, total? : Int) -> Unit {
  let total = match total { Some(__mbt_v) => __mbt_v, None => nav_kept_left_most }

  nav_limits_set(self.said, most_of, total)
}

///|
/// Restrict which `made` page kinds may enter `self`'s root `shelf` (`None` clears the filter).
pub fn Nav::set_shelf_kind_filter[P](self : Nav[P], allow : Option[(String) -> Bool]) -> Unit {
  match mbt_compat::arr_search_by(nav_shelf_kind_filters.v, fn(e) { physical_equal(e.0, self.said) }) {
    Some(i) => {
      mbt_compat::arr_remove(nav_shelf_kind_filters.v, i) |> ignore
      if nav_shelf_kind_filters.v.is_empty() {
        nav_shelf_kind_filters.v = []
      }
    }
    None => ()
  }
  match allow {
    Some(f) => nav_shelf_kind_filters.v.push((self.said, f))
    Option::None => ()
  }
}

///|
/// Guard `(serial, key, kind)` before parking an entry into `kept_left` (`None` clears the guard).
pub fn Nav::set_kept_left_guard[P](self : Nav[P], allow : Option[(Int, String, String) -> Bool]) -> Unit {
  match mbt_compat::arr_search_by(nav_kept_left_guards.v, fn(e) { physical_equal(e.0, self.said) }) {
    Some(i) => {
      mbt_compat::arr_remove(nav_kept_left_guards.v, i) |> ignore
      if nav_kept_left_guards.v.is_empty() {
        nav_kept_left_guards.v = []
      }
    }
    None => ()
  }
  match allow {
    Some(f) => nav_kept_left_guards.v.push((self.said, f))
    Option::None => ()
  }
}

///|
/// Evict only `kept_left` entries matching `drop(key, kind)`, leaving other parked entries untouched.
pub fn Nav::evict_kept_left[P](self : Nav[P], drop : (String, String) -> Bool) -> Unit {
  let mut removed = false
  let mut i = 0
  while i < self.kept_left.length() {
    let (key, kind, e) = self.kept_left[i]
    if drop(key, kind) {
      mbt_compat::arr_remove(self.kept_left, i) |> ignore
      self.gone.push(e)
      removed = true
    } else {
      i += 1
    }
  }
  if self.kept_left.is_empty() {
    self.kept_left = []
  }
  if removed {
    self.told()
    wake()
  }
}

///|
/// Register or clear a per-Nav root-shelf entry serial guard checked on shelving, `swap_out` settle, and take-back.
pub fn Nav::set_shelf_serial_guard[P](self : Nav[P], guard_fn : Option[(Int) -> Bool]) -> Unit {
  match mbt_compat::arr_search_by(nav_shelf_serial_guards.v, fn(e) { physical_equal(e.0, self.said) }) {
    Some(i) =>
    match guard_fn {
      Some(f) => nav_shelf_serial_guards.v[i] = (self.said, f)
      Option::None => {
        mbt_compat::arr_remove(nav_shelf_serial_guards.v, i) |> ignore
        if nav_shelf_serial_guards.v.is_empty() {
          nav_shelf_serial_guards.v = []
        }
      }
    }
    None =>
    match guard_fn {
      Some(f) => nav_shelf_serial_guards.v.push((self.said, f))
      Option::None => ()
    }
  }
}

///|
/// Evict root-shelf entries whose serial satisfies `should_evict(serial)`, and cancel shelving for any in-flight
/// `swap_out` root whose serial satisfies `should_evict(serial)` (without disturbing unrelated shelf entries).
pub fn Nav::evict_shelf[P](self : Nav[P], should_evict : (Int) -> Bool) -> Unit {
  let mut removed = false
  let kept : Array[NavPage[P]] = []
  for e in self.shelf {
    if should_evict(e.serial) {
      e.shown_once = false
      self.gone.push(e)
      removed = true
    } else {
      kept.push(e)
    }
  }
  self.shelf = kept
  let mut swap_removed = false
  match self.swap_out {
    Some(was) if should_evict(was.serial) => {
      self.swap_out = Option::None
      self.swap_kept = false
      was.shown_once = false
      self.gone.push(was)
      removed = true
      swap_removed = true
    }
    _ => ()
  }
  if swap_removed {
    self.swap_told()
  }
  if removed {
    self.told()
    wake()
  }
}

///|
/// Serial of the outgoing root page currently in an in-flight `replace_tab` cross-transition, if any.
pub fn Nav::swapping_out_serial[P](self : Nav[P]) -> Option[Int] {
  mbt_compat::opt_map(self.swap_out, fn(e) { e.serial })
}

///|
/// Whether `serial` is currently on the active navigation stack (`self.pages` only; never `leaving`, `swap_out`,
/// `shelf`, or `kept_left`).
pub fn Nav::has_active_serial[P](self : Nav[P], serial : Int) -> Bool {
  mbt_compat::arr_iter(self.pages).any(fn(e) { e.serial == serial })
}

///|
/// Remove `self` from all global per-Nav side tables (call before discarding a `Nav` on app reset).
pub fn Nav::clear_side_tables[P](self : Nav[P]) -> Unit {
  nav_limits_set(self.said, Option::None, nav_kept_left_most)
  self.set_shelf_kind_filter(Option::None)
  self.set_shelf_serial_guard(Option::None)
  self.set_kept_left_guard(Option::None)
}

///|
/// Whether entry `serial` is put by on the stack's kept left (Nav's `kept_left`), read as that changes.
pub fn Nav::is_kept_left[P](self : Nav[P], serial : Int) -> Bool {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  mbt_compat::arr_iter(self.kept_left).any(fn(x) { x.2.serial == serial }) || self.parks_soon(serial) is Some(_)
}

///|
/// Entry `serial`, gone from a stack drawn flat by an owner and to be put by on its kept left as that owner lets it go
/// (nav_flat_view's, as the stack stands whole once the change is told: Nav::leaves): kept so already to what reads it
/// meanwhile (Nav::is_kept_left, Nav::flat_entry), so nothing made of it is let go in the change it leaves in. One let go
/// for good from the kept left (its leaving told) or never shown is none.
fn Nav::parks_soon[P](self : Nav[P], serial : Int) -> Option[NavPage[P]] {
  guard self.flat_owner && self.keeps_left is Some(keeps) else { return Option::None }
  arr_find_first(self.gone, fn(e) {
    e.serial == serial &&
    e.shown_once &&
    !e.ended &&
    !e.told_left &&
    (match keeps(e.page) {
      Some((key, kind)) => nav_kept_left_guard_allows(self.said, e.serial, key, kind)
      Option::None => false
    })
  })
}

///|
/// Entry `e`, gone from the stack, put by on its kept left where what holds the stack keeps it (`keeps_left`: its page
/// made once, shown once at least): one of the same key there before let go for good, and the least lately used where
/// that makes more than nav_kept_left_most; its leaving told now (Nav's on_entry_park in the place of on_entry_leave, so
/// what the entry holds may be kept for it; on_leave), as it would be were it let go, and its keyboard's focus given up. Whether it was kept; else it is the caller's to let go.
fn Nav::try_park_left[P](self : Nav[P], e : NavPage[P]) -> Bool {
  // (one let go for good from the kept left, its leaving told, is never put by again)
  if !e.shown_once || e.ended || e.told_left || mbt_compat::arr_iter(self.pages).any(fn(x) { x.serial == e.serial }) {
    return false
  }
  guard self.keeps_left is Some(keeps) && keeps(e.page) is Some((key, kind)) else { return false }
  if !nav_kept_left_guard_allows(self.said, e.serial, key, kind) {
    return false
  }
  match arr_search_by(self.kept_left, fn(x) { x.0 == key }) {
    Some(i) => self.gone.push(mbt_compat::arr_remove(self.kept_left, i).2)
    Option::None => ()
  }
  let (most_of, total_cap) = match nav_limits_get(self.said) {
    Some(lim) => (lim.most_of, lim.total)
    Option::None => (None, nav_kept_left_most)
  }
  let kind_cap = match most_of {
    Some(f) => f(kind)
    None => total_cap
  }
  if kind_cap <= 0 || total_cap <= 0 {
    return false
  }
  if most_of is Some(_) {
    let mut kind_count = 0
    for x in self.kept_left {
      if x.1 == kind {
        kind_count = kind_count + 1
      }
    }
    while kind_count >= kind_cap {
      match arr_search_by(self.kept_left, fn(x) { x.1 == kind }) {
        Some(i) => {
          self.gone.push(mbt_compat::arr_remove(self.kept_left, i).2)
          kind_count = kind_count - 1
        }
        Option::None => break
      }
    }
  }
  while self.kept_left.length() >= total_cap {
    self.gone.push(mbt_compat::arr_remove(self.kept_left, 0).2)
  }
  e.focus_kept = 0
  e.taken_back = false
  self.kept_left.push((key, kind, e))
  if !e.told_left {
    e.told_left = true
    (self.on_entry_park)(e.serial, e.page)
    (self.on_leave)(e.page)
  }
  true
}

///|
/// Entry `e` gone from the stack: put by on its kept left where that keeps it (Nav::try_park_left), else let go at the
/// next frame (forgotten, told) as ever. Drawn flat by an owner (Nav::flat_owned), let go as ever here: it may be kept
/// shown in place while the one put there waits (Nav::flat_keep), and is put by as that owner lets it go
/// (nav_flat_view).
fn Nav::leaves[P](self : Nav[P], e : NavPage[P]) -> Unit {
  if self.flat_owner || !self.try_park_left(e) {
    self.gone.push(e)
  }
}

///|
/// The entry for `page` put on the stack over `under`: the one put by on its kept left for the same key, where it is
/// of the same kind still (its nodes, as they were left; its time on top anew, its leaving to be told again), else a new
/// one (the one put by of another kind let go for good).
fn Nav::take_kept_left[P](self : Nav[P], page : P, under : Option[P]) -> NavPage[P] {
  match self.keeps_left {
    Some(keeps) =>
    match keeps(page) {
      Some((key, kind)) =>
      match arr_search_by(self.kept_left, fn(x) { x.0 == key }) {
        Some(i) => {
          let (_, kd, e) = mbt_compat::arr_remove(self.kept_left, i)
          if kd == kind && !e.ended {
            e.page = page
            e.under = under
            e.over = false
            e.rise = false
            e.told_left = false
            e.focus_kept = 0
            e.stint = next_stint()
            e.taken_back = true
            return e
          }
          self.gone.push(e)
        }
        Option::None => ()
      }
      Option::None => ()
    }
    Option::None => ()
  }
  nav_page(page, under)
}

///|
/// Every entry put by on the kept left let go for good (at the next frame, or as what holds the stack lets its node go).
fn Nav::kept_left_empty[P](self : Nav[P]) -> Unit {
  for x in self.kept_left {
    self.gone.push(x.2)
  }
  self.kept_left = []
}

///|
/// Every entry put by on the shelf let go for good (at the next frame, or as what holds the stack lets its place go):
/// never put by on the kept left on the way out (`shown_once` cleared, as `replace_above(0, …)` does).
fn Nav::shelf_clear_gone[P](self : Nav[P]) -> Unit {
  for e in self.shelf {
    e.shown_once = false
    self.gone.push(e)
  }
  self.shelf = []
}

///|
/// Whether entry `serial` is on the shelf (Nav::replace_kept) and not kept shown in place meanwhile (Nav::flat_keep):
/// at rest there, building nothing.
fn Nav::is_parked_shelf[P](self : Nav[P], serial : Int) -> Bool {
  mbt_compat::arr_iter(self.shelf).any(fn(e) { e.serial == serial }) &&
  !(self.flat_kept_entry() is Some(kept) && kept.serial == serial)
}

///|
/// Its pages changed: what reads them told.
fn Nav::told[P](self : Nav[P]) -> Unit {
  self.said.set(self.said.untracked() + 1)
}

///|
/// The page on top.
pub fn Nav::top[P](self : Nav[P]) -> P {
  self.said.get() |> ignore
  self.pages[self.pages.length() - 1].page
}

///|
/// How many pages are in the stack.
pub fn Nav::depth[P](self : Nav[P]) -> Int {
  self.said.get() |> ignore
  self.pages.length()
}

///|
/// The pages, bottom to top.
pub fn Nav::pages[P](self : Nav[P]) -> Array[P] {
  self.said.get() |> ignore
  mbt_compat::arr_map(self.pages, fn(e) { e.page })
}

///|
/// The page under the one being built (Ctx::nav, Ctx::nav_flat: the top, the one under it as a page slides over it
/// or away, one leaving, one kept shown while the next is waited for), none under the root; outside them, the top's.
/// What a page asks of where it stands (whether it is the root, where its back goes), never the stack's depth or the
/// page under its top: those are the top's, and a root under a page coming in is still the root.
pub fn Nav::under[P](self : Nav[P]) -> Option[P] {
  self.said.get() |> ignore
  match self.built {
    Some(e) => e.under
    Option::None => self.pages[self.pages.length() - 1].under
  }
}

///|
/// Whether a page is moving (pushed, popped, followed by a finger).
pub fn Nav::moving[P](self : Nav[P]) -> Bool {
  self.mode != 0
}

///|
/// How far the top page is off to the side now, in its widths.
pub fn Nav::offset[P](self : Nav[P]) -> Double {
  if self.mode == 3 {
    self.finger.get() |> ignore
  }
  self.p
}

///|
/// Off to `p1` (mode 1 coming in, 2 going, 4 back to rest from a finger) from where it is, as fast as `v` (its widths
/// per ms: the finger's as it let go), on a Move as long as its way is far (move_ms of it, in points: across its room,
/// or up it for a page that rose).
fn Nav::go[P](self : Nav[P], mode : Int, p1 : Double, brings? : Bool, v? : Double) -> Unit {
  let brings = match brings { Some(__mbt_v) => __mbt_v, None => false }
  let v = match v { Some(__mbt_v) => __mbt_v, None => 0.0 }

  wake()
  // (held by the window's tree: from where it is at its cause's moment, not where a frame last drew it)
  match self.hosted {
    Some(h) => self.p = self.p_at((h.now)())
    Option::None => ()
  }
  self.mode = mode
  self.p0 = self.p
  self.p1 = p1
  let rising = match self.leaving {
    Some(e) => e.rise
    Option::None => self.pages[self.pages.length() - 1].rise
  }
  // (held by the window's tree: how big its node is laid out as of the cause's moment)
  let (room_w, room_h) = match self.hosted {
    Some(h) => (h.room)()
    Option::None => (self.room_w, self.room_h)
  }
  let room = if rising { room_h } else { room_w }
  self.slide_room = room
  // (a room not known (no frame has laid it out): no way is no length; how long, once it is known, Ctx::nav)
  self.dur_way = if room > 0.0 { Option::None } else { Some((p1 - self.p).abs()) }
  // (set out away from where it goes (a push still coming in, popped): slowing to rest, then back, come_way_ms)
  self.dur = if room > 0.0 && v * (p1 - self.p) < 0.0 {
    come_way_ms(self.p * room, v * room, p1 * room, kept=self.slide_turn)
  } else {
    move_ms((p1 - self.p).abs() * room)
  }
  self.v0 = v
  // told in a frame, it starts there, at its time (its end known as it is told); told between frames, at the next
  // frame that builds it (Ctx::nav)
  // (held by the window's tree: at its cause's moment, the tree's now)
  self.t0 = match self.hosted {
    Some(h) => (h.now)()
    Option::None => if in_frame.v { g().clock } else { -1.0 }
  }
  self.wait_from = -1.0
  self.waited = false
  // (a page brought in: its start moved on by how late its first frame is to the screen)
  // (not where the window's tree holds it: its slide a function of the time from its cause alone)
  self.waits_late = brings && self.hosted is Option::None
  self.late_at = -1.0
  // said once, as it sets out: frames until it is there (held by the window's tree: its moments there told first, its
  // start and end, or its wait, while which it is at rest: Moving's rest_at)
  self.asked = g().frame_no
  match self.hosted {
    Some(h) => (h.went)()
    Option::None => ()
  }
  g().moving(self.mover, self.as_moving(), what="a stack's slide")
  self.shown_told()
}

///|
/// When its slide is over, asked at each frame's end while it slides: read only, the same whoever asks first. Told to
/// go between frames, it starts at the first frame after that builds it (Ctx::nav sets its start): until then +inf;
/// not built in that frame, at rest, said to move again as Ctx::nav starts it.
fn Nav::rest_at[P](self : Nav[P], now : Double, frame : Int) -> Double {
  ignore(now)
  if self.t0 == nav_held && self.hosted is Some(_) {
    // held by the window's tree for what its page shows: at rest while it waits, its start a moment there (Nav::held_by),
    // said to move again as it sets out
    -1.0
  } else {
    self.ends_at(frame)
  }
}

///|
/// What moves, as Ctx::moving is told it (Moving).
fn Nav::as_moving[P](self : Nav[P]) -> Moving {
  Moving::new(fn(now, frame) { self.rest_at(now, frame) })
}

///|
/// When its slide is over (Nav::ends_at), or the last one was where none slides now (Nav::ended): what nav_rest says
/// of it, the same whether the frames drawn have passed that moment or not.
fn Nav::rested_at[P](self : Nav[P], frame : Int) -> Double {
  let r = self.ends_at(frame)
  if r < 0.0 {
    self.ended
  } else {
    r
  }
}

///|
/// When its slide is over, as a test runs to it (Nav::rest, nav_rest): Moving's rest_at, but for a slide held by the
/// window's tree, the latest it could end (its wait's most, then its way), as one held by the frames says it.
fn Nav::ends_at[P](self : Nav[P], frame : Int) -> Double {
  let slide_end = if self.mode != 1 && self.mode != 2 && self.mode != 4 {
    -1.0
  } else if self.t0 == nav_held {
    // held for what its page shows (its coming, or the most it waits, a wake, starts it): at rest by the latest its
    // slide could end, said again as it starts
    self.wait_from + self.held_most + self.dur
  } else if self.t0 >= 0.0 {
    self.t0 + self.dur
  } else if frame <= self.asked {
    1.0 / 0.0
  } else {
    -1.0
  }
  let swap_end = if self.swap_out is Some(_) && self.swap_t0 >= 0.0 && self.swap_dur > 0.0 {
    self.swap_t0 + self.swap_dur
  } else {
    -1.0
  }
  dmax(slide_end, swap_end)
}

///|
/// When the stacks built in the last frame (Ctx::nav) are all at rest: the latest of their slides' ends (the frames'
/// clock; +inf: told to slide, not started yet), a slide over its end as it was (Nav::rested_at); -1: none has slid.
/// What a test runs to after a page pushed, popped or let go, when it holds no stack itself (an app's own): the same
/// moment whether the frames on its way have passed it or not.
pub fn nav_rest() -> Double {
  g().nav_rest
}

///|
/// When this stack's slide is over (the frames' clock; +inf: told to go, not started yet; -1: it is not sliding): what
/// a test runs to.
pub fn Nav::rest[P](self : Nav[P]) -> Double {
  self.ends_at(g().frame_no)
}

///|
fn Nav::swap_told[P](self : Nav[P]) -> Unit {
  self.swap_said.set(self.swap_said.untracked() + 1)
}

///|
fn Nav::gesture_told[P](self : Nav[P]) -> Unit {
  self.gesture_said.set(self.gesture_said.untracked() + 1)
}

///|
/// Finishes an active root tab cross-transition (`Nav::replace_tab`), shelving or releasing the outgoing page.
fn Nav::settle_swap[P](self : Nav[P]) -> Unit {
  match self.swap_out {
    Some(was) => {
      if self.swap_t0 >= 0.0 && self.swap_dur > 0.0 {
        self.ended = dmax(self.ended, self.swap_t0 + self.swap_dur)
      }
      self.swap_out = Option::None
      if self.swap_kept {
        match self.shelves {
          Some(shelves) if shelves(was.page) && nav_shelf_serial_allows(self.said, was.serial) => {
            was.focus_kept = 0
            self.shelf.push(was)
          }
          _ => self.leaves(was)
        }
      } else {
        self.leaves(was)
      }
      self.swap_kept = false
      self.swap_told()
      self.shown_told()
      wake()
    }
    Option::None => ()
  }
}

///|
/// Ends what moves at once, where it was going.
fn Nav::settle[P](self : Nav[P]) -> Unit {
  self.settle_swap()
  let was_gesture = self.mode == 3 || self.mode == 4
  if (self.mode == 1 || self.mode == 2 || self.mode == 4) && self.t0 >= 0.0 {
    self.ended = self.t0 + self.dur
  }
  match self.leaving {
    Some(e) => {
      // forgotten at the next frame, or put by on the kept left where what holds the stack keeps it (drawn flat by an
      // owner: as that owner lets it go, nav_flat_view)
      self.leaves(e)
      wake()
    }
    Option::None => ()
  }
  self.leaving = Option::None
  self.mode = 0
  self.p = 0.0
  if was_gesture {
    self.gesture_told()
  }
  self.shown_told()
}

///|
/// A slide held (Nav::comes_when): its start, until it goes.
// moved to 00_init_order.pion: nav_held

///|
/// Whether what the stack shows was pushed over the page under it (Nav::push_over): its top, at rest, coming in or
/// swiped; or one going back off it.
fn Nav::stacked[P](self : Nav[P]) -> Bool {
  match self.leaving {
    Some(e) => e.over
    Option::None => self.top_over()
  }
}

///|
/// The page those pushed over it lie over (Nav::push_over): the topmost put in place, as Ctx::nav's `floor`.
fn Nav::over_floor[P](self : Nav[P]) -> Int {
  let mut k = self.pages.length() - 1
  while k > 0 && self.pages[k].over {
    k = k - 1
  }
  k
}

///|
/// The most a slide bringing a page in waits for its first frame to reach the screen (the app's LOCAL_MS, as long
/// as a page opening waits for what it shows): later than that, it moves on from its time.
// moved to 00_init_order.pion: nav_late_most

///|
/// The page just pushed slides in once it has what it shows (`ready`, asked while it waits: the core has answered for it), `most` ms at most
/// after it was pushed (the app's App.kt: a page opening waits LOCAL_MS for what the core has on the device, never
/// for a station), not first as its loading look swapped for it a frame or two later: till then nothing moves, the
/// page under it as it was. Asked each frame its stack is built, before Ctx::nav; its slide starts at the moment it
/// goes (its readiness come, or the most it waits), its wait from when it was pushed. A push already sliding (asked
/// later than the frame after it) is not held.
pub fn Nav::comes_when[P](self : Nav[P], ready : () -> Bool, most : Double) -> Unit {
  // (held by the window's tree: its wait the tree's, at its causes, Nav::held_by)
  if self.hosted is Some(_) || self.mode != 1 || self.p0 != 1.0 || self.waited {
    return
  }
  let c = g()
  if self.wait_from < 0.0 {
    // (pushed as the frame before was built, after this was asked in it: drawn there where it starts, nothing moved
    // yet; asked later than that, it slides on)
    if self.t0 >= 0.0 && c.frame_no > self.asked + 1 {
      self.waited = true
      return
    }
    self.wait_from = if self.t0 >= 0.0 { self.t0 } else { c.clock }
  }
  if c.clock >= self.wait_from + most || ready() {
    self.waited = true
    if self.t0 == nav_held {
      self.t0 = c.clock
      // (its first frame this one, the page built with what it shows)
      self.late_at = -1.0
      c.moving(self.mover, self.as_moving(), what="a stack's slide")
    }
    return
  }
  self.t0 = nav_held
  self.held_most = most
  c.wake_at_time(self.wait_from + most)
}

///|
/// Drawn flat (Ctx::nav_flat), the page put on top shows once it has what it shows (`ready`), `most` ms at most after
/// it was put there (pushed, or in place of the one on top): till then the page that showed before stays, as it was,
/// not the new one's loading look swapped for it a frame or two later (the app's LOCAL_MS, as Nav::comes_when holds
/// a slide). Asked each frame its stack is drawn, before Ctx::nav_flat.
pub fn Nav::shows_when[P](self : Nav[P], ready : () -> Bool, most : Double) -> Unit {
  self.flat_ready = ready
  self.flat_most = most
  self.flat_asked = g().frame_no
}

///|
/// Whether entry `serial` is the page on top, put on again from the stack's kept left (Nav::take_kept_left) and not
/// shown yet (its owner waiting for what it shows: nav_flat_view), read as that changes: laid out where it was as it
/// waits, out of sight, never laid out nowhere and then again.
pub fn Nav::waiting_taken_back[P](self : Nav[P], serial : Int) -> Bool {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  let top = self.pages[self.pages.length() - 1]
  top.serial == serial && top.taken_back
}

///|
/// The stay of the page on top: its entry (a page put on the stack is an entry of its own, the same page twice two) and
/// its time on top (come back to, another), read as it changes. What a wait for what it shows is the wait of.
pub fn Nav::top_stay[P](self : Nav[P]) -> (Int, Int) {
  self.said.get() |> ignore
  let top = self.pages[self.pages.length() - 1]
  (top.serial, top.stint)
}

///|
/// Drawn flat (Ctx::nav_flat), what shows is said by its owner at its causes, not by the frames (`owned`; let go, as
/// Nav::shows_when says it): what it keeps shown (Nav::flat_keep) and when the one on top shows.
pub fn Nav::flat_owned[P](self : Nav[P], owned : Bool) -> Unit {
  if self.flat_owner != owned || (!owned && self.flat_kept is Some(_)) {
    self.flat_owner = owned
    self.flat_kept = Option::None
    self.told()
  }
  self.focus_kept_settle()
}

///|
/// Drawn flat by an owner (Nav::flat_owned), the stay shown in place of the one on top (Nav::top_stay's of a page shown
/// before it), kept so till its owner says otherwise (`None`: the one on top), whatever frames are drawn: its entry kept
/// while it shows, though it has left the stack, then let go (forgotten and told, Nav's `on_leave`) as any other. A
/// stay no longer there (its entry let go, or on top again as another stay) keeps nothing.
pub fn Nav::flat_keep[P](self : Nav[P], stay : Option[(Int, Int)]) -> Unit {
  if self.flat_kept != stay {
    self.flat_kept = stay
    self.told()
  }
  self.focus_kept_settle()
}

///|
/// The focus in a page that left a stack drawn flat by an owner (Nav::focus_follows), as the owner says what it keeps
/// shown (at that cause: the same as the page left, or as the one it kept is let go): kept shown, it stays; else none
/// has it (where nothing else took it meanwhile).
fn Nav::focus_kept_settle[P](self : Nav[P]) -> Unit {
  guard self.focus_shown_gone is Some((stay, f)) else { return }
  if self.flat_owner && self.flat_kept == Some(stay) {
    return
  }
  self.focus_shown_gone = Option::None
  let c = g()
  if c.focus == f {
    c.focus_moved(0)
  }
}

///|
/// The entry kept shown in place of the one on top (Nav::flat_keep), where it is still the stay kept: in the stack
/// under the top, or gone from it and not let go yet.
fn Nav::flat_kept_entry[P](self : Nav[P]) -> Option[NavPage[P]] {
  guard self.flat_kept is Some((serial, stint)) else { return Option::None }
  let top = self.pages[self.pages.length() - 1]
  if top.serial == serial {
    return Option::None
  }
  let find = fn(es : Array[NavPage[P]]) -> Option[NavPage[P]] {
    mbt_compat::arr_iter(es).find_first(fn(e) { e.serial == serial && e.stint == stint })
  }
  match find(self.pages) {
    Some(e) => Some(e)
    Option::None =>
    match find(self.gone) {
      Some(e) => Some(e)
      // (put on the shelf as the one put in its place waits: kept shown till its owner lets it go)
      // (put on the shelf as the one put in its place waits: kept shown till its owner lets it go)
      Option::None => find(self.shelf)
    }
  }
}

///|
/// Drawn flat (Ctx::nav_flat), the page drawn in place of the one on top this frame while that one is waited for
/// (Nav::shows_when): the page drawn there last, until the one on top has what it shows or its wait is over; else none.
/// The same whoever asks in a frame.
fn Nav::flat_held[P](self : Nav[P], c : Ctx) -> Option[NavPage[P]] {
  let top = self.pages[self.pages.length() - 1]
  // (shown here as the last frame was drawn, or in this frame's build before: else no page shows to stay)
  match self.flat_shown {
    Some(shown) if shown.serial != top.serial && self.flat_asked == c.frame_no && self.flat_frame >= c.frame_no - 1 => {
      if self.flat_for != top.serial {
        self.flat_for = top.serial
        self.flat_from = c.clock
      }
      if c.clock < self.flat_from + self.flat_most && !(self.flat_ready)() {
        c.wake_at_time(self.flat_from + self.flat_most)
        Some(shown)
      } else {
        Option::None
      }
    }
    _ => Option::None
  }
}

///|
/// Drawn flat (Ctx::nav_flat), whether the page on top shows this frame: not waited for while the one before stays
/// (Nav::shows_when). What moves to show it (a pane brought over on a tape) sets out once it does, as a page pushed
/// slides in once it has what it shows (Nav::comes_when); one pushed over a stack drawn flat holds its own slide.
/// Asked as the frame builds, after Nav::shows_when.
pub fn Nav::top_shows[P](self : Nav[P]) -> Bool {
  if self.flat_owner {
    return self.stacked() || self.flat_kept_entry() is Option::None
  }
  self.stacked() || self.flat_held(g()) is Option::None
}

///|
/// Pushes `page`: it slides in over the one on top.
pub fn Nav::push[P](self : Nav[P], page : P) -> Unit {
  self.pushes(page, false)
}

///|
/// What one cause does to the stack (a push, a rise, a pop, back to a depth, a page let go, one or more put in place),
/// told as one: what reads it (`said`, `shown`) sees it whole, never half done (its pages pushed, its slide not yet set
/// out: none beside its top, at rest; or a slide under way ended, the pages that replace it not yet there).
fn told_once[T](f : () -> T) -> T {
  signals::start_batch()
  let r = f()
  signals::end_batch()
  r
}

///|
/// What one cause does to the stack, told once (told_once), and the keyboard's focus as it leaves the page on top: the
/// focus is only in what shows (the one rule, Ctx::focus_taken_under's;, here the stack its third caller, the old
/// frame's layers and the tree's the others). A page put over the one on top takes the focus from what in that one had
/// it (put aside with it, the input method put away; the new page's own way of taking it, as it is first built, its
/// own); the page on top again gives it back to what had it as it was covered, where nothing else took it meanwhile
/// (none has it, or what is let go of with the page over it); a page gone takes it with it (none has it then; one the
/// owner of a stack drawn flat keeps shown in its place till the one put there has its view, as that owner lets it go:
/// Nav::focus_kept_settle). At the
/// cause's moment, never as a frame is built: a finger's back gives it back as it is let go and goes back, not as it
/// drags; called off, nothing. Where the window's tree does not hold the stack (an old view's own), nothing.
fn Nav::told_focus[P, T](self : Nav[P], f : () -> T) -> T {
  let before = self.pages[self.pages.length() - 1]
  told_once(fn() {
    let r = f()
    self.focus_follows(before)
    r
  })
}

///|
/// The focus as the page on top went from `before` to what is on top now (Nav::told_focus).
fn Nav::focus_follows[P](self : Nav[P], before : NavPage[P]) -> Unit {
  guard self.hosted is Some(h) else { return }
  let top = self.pages[self.pages.length() - 1]
  if physical_equal(top, before) {
    return
  }
  let c = g()
  let covered = mbt_compat::arr_iter(self.pages).any(fn(e) { physical_equal(e, before) })
  if covered {
    // (what had it in the page covered: put aside with that page, under the one put over it)
    if c.focus != 0 && (h.holds)(c.focus) {
      before.focus_kept = c.focus
      c.focus_taken_under(0, false)
    }
  } else if c.focus != 0 && (h.holds)(c.focus) {
    if self.flat_owner {
      // (in a page put out of place where an owner may keep it shown till the one put there has its view: as the owner
      // says at this cause, Nav::flat_keep; sfdesk's page_wait.pion)
      self.focus_shown_gone = Some(((before.serial, before.stint), c.focus))
    } else {
      // (in a page gone: with it)
      c.focus_moved(0)
    }
  }
  let kept = top.focus_kept
  if kept != 0 {
    top.focus_kept = 0
    if (c.focus == 0 || (h.holds)(c.focus)) && (h.still)(kept) {
      nav_focus_give_back(c, kept)
    }
  }
}

///|
/// Pushes `page`, over the one on top (Nav::push_over) or not: what it is known as it sets out (Nav::go).
fn Nav::pushes[P](self : Nav[P], page : P, over : Bool) -> Unit {
  self.told_focus(fn() { self.pushes_now(page, over) })
}

///|
fn Nav::pushes_now[P](self : Nav[P], page : P, over : Bool) -> Unit {
  self.settle()
  self.pages.push(self.take_kept_left(page, Some(self.top())))
  self.pages[self.pages.length() - 1].over = over
  self.told()
  self.p = 1.0
  self.go(1, 0.0, brings=true)
}

///|
/// Pushes `page` over the one on top as Nav::push does, and so too where the stack is drawn flat (Ctx::nav_flat with
/// `stacks`: a pane on a tape, a phone's screen beside a list): there it slides in over it, and back takes it off
/// sliding, following the system's gesture, as a phone's stack has it; a page pushed (Nav::push) or put in place there
/// is shown in place.
pub fn Nav::push_over[P](self : Nav[P], page : P) -> Unit {
  self.pushes(page, true)
}

///|
/// Whether the page on top waits for what it shows before it comes in (its slide held: Nav::comes_when, Nav::held_by),
/// read as that changes: so from its push till it has what it shows or its wait is over.
pub fn Nav::top_waits[P](self : Nav[P]) -> Bool {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  self.mode == 1 && self.t0 == nav_held
}

///|
/// Whether the page on top was pushed over the one under it (Nav::push_over).
pub fn Nav::top_over[P](self : Nav[P]) -> Bool {
  self.pages[self.pages.length() - 1].over
}

///|
/// Pushes `page` rising from the bottom over the one on top, which stays where it is (App.kt: a new chat, 380 ms on
/// (.2, .8, .2, 1)); back, it sinks down the same way (swiped back, it goes down with the finger).
pub fn Nav::rise[P](self : Nav[P], page : P) -> Unit {
  self.told_focus(fn() { self.rise_now(page) })
}

///|
fn Nav::rise_now[P](self : Nav[P], page : P) -> Unit {
  self.settle()
  let e = self.take_kept_left(page, Some(self.top()))
  e.rise = true
  self.pages.push(e)
  self.told()
  self.p = 1.0
  self.go(1, 0.0, brings=true)
}

///|
/// The top page becomes `page` in place, keeping what its widgets hold (a new chat becoming the chat it made, its
/// composer's words and focus kept); back from it, it goes sideways as a pushed page does.
pub fn Nav::become[P](self : Nav[P], page : P) -> Unit {
  let e = self.pages[self.pages.length() - 1]
  e.page = page
  e.rise = false
  e.taken_back = false
  // (what reads which page is on top told: the same page, its widgets' state kept, now another)
  self.told()
  wake()
}

///|
/// Whether the top page rose from the bottom (Nav::rise) and has not become another.
pub fn Nav::risen[P](self : Nav[P]) -> Bool {
  self.pages[self.pages.length() - 1].rise
}

///|
/// Back a page: the top slides away; false when there is none under it.
pub fn Nav::pop[P](self : Nav[P]) -> Bool {
  self.told_focus(fn() { self.pop_now() })
}

///|
fn Nav::pop_now[P](self : Nav[P]) -> Bool {
  if self.pages.length() < 2 {
    return false
  }
  if self.mode == 1 && self.t0 == nav_held {
    // (still waiting for what it shows, so never shown: taken off as it is, nothing sliding, its wait called off; the
    // page under it, shown in place all along, on top)
    self.leaves(mbt_compat::opt_unwrap(self.pages.pop()))
    wake()
    self.mode = 0
    self.p = 0.0
    self.t0 = -1.0
    self.waited = false
    // (its time on top anew before the stack says it changed: what reads that reads this one, Nav::topped)
    self.topped()
    self.told()
    match self.hosted {
      Some(h) => (h.went)()
      Option::None => ()
    }
    self.shown_told()
    return true
  }
  // (one still coming in: turned back from where it is, as fast as it goes there, not put in place first)
  let mut carry_v = 0.0
  if self.mode == 1 && self.t0 >= 0.0 && self.leaving is Option::None {
    let now = match self.hosted {
      Some(h) => (h.now)()
      Option::None => g().clock
    }
    let (cur_p, cur_v) = self.slid_motion_at(now)
    self.p = cur_p
    carry_v = cur_v
    self.settle_swap()
  } else if self.mode != 0 && self.mode != 3 {
    self.settle()
    if self.pages.length() < 2 {
      return false
    }
  }
  self.leaving = self.pages.pop()
  self.topped()
  self.told()
  self.go(2, 1.0, brings=true, v=carry_v)
  true
}

///|
/// Back to the page `depth` deep (1 the root): the top slides away over it, those between taken off as they are, never
/// shown again (forgotten, `on_leave` told, as the top's slide begins); false when the stack is no deeper than that.
pub fn Nav::pop_to[P](self : Nav[P], depth : Int) -> Bool {
  self.told_focus(fn() { self.pop_to_now(depth) })
}

///|
fn Nav::pop_to_now[P](self : Nav[P], depth : Int) -> Bool {
  if depth < 1 || self.pages.length() <= depth {
    return false
  }
  if self.mode != 0 && self.mode != 3 {
    self.settle()
  }
  while self.pages.length() > depth + 1 {
    self.leaves(mbt_compat::arr_remove(self.pages, self.pages.length() - 2))
  }
  self.pop()
}

///|
/// The top page replaced by `page`, in place (nothing slides).
pub fn Nav::replace[P](self : Nav[P], page : P) -> Unit {
  self.told_focus(fn() { self.replace_now(page) })
}

///|
fn Nav::replace_now[P](self : Nav[P], page : P) -> Unit {
  self.settle()
  // (told once, as the new one is on top: never with no page)
  let was = self.pages.pop()
  match was {
    Some(e) => self.leaves(e)
    Option::None => ()
  }
  let e = self.take_kept_left(page, mbt_compat::opt_map(mbt_compat::arr_last(self.pages), fn(e) { e.page }))
  // (in its place: over the one under it as it was, Nav::push_over)
  match was {
    Some(w) => e.over = w.over
    Option::None => ()
  }
  self.pages.push(e)
  self.told()
  wake()
}

///|
/// The root page replaced by `page` in place, as Nav::replace does, the one it replaces put on the shelf where what
/// holds the stack shelves it (its page made as nodes: Nav's `shelves`): known by its serial still, out of the stack
/// (not shown, taking no press), its keyboard's focus given up; and where `page` is on the shelf, that entry taken back
/// in the new one's place (its time on top anew, over as the one it replaces was). Where nothing shelves, or the stack
/// is more than its root, it is Nav::replace. What a place of a bar switched to is .
pub fn Nav::replace_kept[P : Eq](self : Nav[P], page : P) -> Unit {
  self.told_focus(fn() { self.replace_kept_now(page) })
}

///|
fn Nav::replace_kept_now[P : Eq](self : Nav[P], page : P) -> Unit {
  self.settle()
  guard self.shelves is Some(shelves) && self.pages.length() == 1 else { return self.replace_now(page) }
  let was = mbt_compat::opt_unwrap(self.pages.pop())
  if shelves(was.page) && nav_shelf_serial_allows(self.said, was.serial) {
    was.focus_kept = 0
    self.shelf.push(was)
  } else {
    // (a root left for good: never put by on the kept left, as replace_above's of the root)
    was.shown_once = false
    self.gone.push(was)
  }
  let e = match arr_search_by(self.shelf, fn(e) { e.page == page }) {
    Some(i) => {
      let e = mbt_compat::arr_remove(self.shelf, i)
      if nav_shelf_serial_allows(self.said, e.serial) {
        e.stint = next_stint()
        e
      } else {
        e.shown_once = false
        self.gone.push(e)
        nav_page(page, None)
      }
    }
    Option::None => nav_page(page, None)
  }
  e.over = was.over
  self.pages.push(e)
  self.told()
  wake()
}

///|
/// The serial of the entry on the shelf whose page is `page` (Nav::replace_kept), if one is: what putting it at the
/// root takes back.
pub fn Nav::shelved[P : Eq](self : Nav[P], page : P) -> Option[Int] {
  mbt_compat::opt_map(arr_find_first(self.shelf, fn(e) { e.page == page }), fn(e) { e.serial })
}

///|
/// Replaces the root page with `page` using a dual-ended cross-transition (`Nav::replace_tab`): the outgoing root
/// stays drawn (non-interactive) while fading/sliding out, then moves to the shelf (`kept=true`) or is released.
/// Interruptible on rapid switches; falls back to `replace_kept`/`replace` when `depth != 1`, reduced motion is on,
/// or `dur <= 0.0`.
pub fn Nav::replace_tab[P : Eq](self : Nav[P], page : P, way? : Int, dur? : Double, kept? : Bool) -> Unit {
  let way = match way { Some(__mbt_v) => __mbt_v, None => 0 }
  let dur = match dur { Some(__mbt_v) => __mbt_v, None => 260.0 }
  let kept = match kept { Some(__mbt_v) => __mbt_v, None => true }

  self.told_focus(fn() { self.replace_tab_now(page, way, dur, kept) })
}

///|
fn Nav::replace_tab_now[P : Eq](self : Nav[P], page : P, way : Int, dur : Double, kept : Bool) -> Unit {
  self.settle()
  if self.pages.length() != 1 {
    if kept {
      self.replace_kept_now(page)
    } else {
      self.replace_now(page)
    }
    return
  }
  if self.pages[0].page == page {
    return
  }
  if reduced_motion() || dur <= 0.0 {
    self.swap_in_serial = 0
    self.swap_t0 = -1.0
    self.swap_dur = 0.0
    if kept {
      self.replace_kept_now(page)
    } else {
      self.replace_now(page)
    }
    return
  }
  let was = mbt_compat::opt_unwrap(self.pages.pop())
  let e = if kept && self.shelves is Some(_) {
    match arr_search_by(self.shelf, fn(x) { x.page == page }) {
      Some(i) => {
        let x = mbt_compat::arr_remove(self.shelf, i)
        if nav_shelf_serial_allows(self.said, x.serial) {
          x.stint = next_stint()
          x
        } else {
          x.shown_once = false
          self.gone.push(x)
          nav_page(page, None)
        }
      }
      Option::None => nav_page(page, None)
    }
  } else {
    nav_page(page, None)
  }
  e.over = was.over
  self.pages.push(e)
  self.swap_out = Some(was)
  self.swap_in_serial = e.serial
  self.swap_way = way
  self.swap_dur = dur
  self.swap_kept = kept
  self.swap_t0 = match self.hosted {
    Some(h) => (h.now)()
    Option::None => if in_frame.v { g().clock } else { -1.0 }
  }
  self.told()
  self.swap_told()
  match self.hosted {
    Some(h) => (h.swap_went)()
    Option::None => ()
  }
  g().moving(self.mover, self.as_moving(), what="a stack's tab swap")
  self.shown_told()
  wake()
}

///|
/// The shelf emptied (Nav::replace_kept): each entry on it left for good, as one let go of is (what holds the stack
/// lets go of its page: forgotten, Nav's `on_leave` told). As the workspace in view changes.
pub fn Nav::shelf_empty[P](self : Nav[P]) -> Unit {
  let had_swap = match self.swap_out {
    Some(was) => {
      self.swap_out = Option::None
      self.swap_kept = false
      self.gone.push(was)
      self.swap_told()
      true
    }
    Option::None => false
  }
  if had_swap || self.shelf.length() > 0 || self.kept_left.length() > 0 {
    self.shelf_clear_gone()
    // (and what left over the root, kept: Nav's `kept_left`, let go for good the same way)
    self.kept_left_empty()
    self.told()
    wake()
  }
}

///|
/// The pages over the stack's first `keep` replaced by `pages` (the first of them over the last kept; `keep` 0, the root
/// too), in place (nothing slides), told once as it is so: never seen with those taken off and these not on yet (a
/// list's row choosing the page beside it in place of whatever was open over the list). Never with no page: `pages`
/// empty, `keep` 1 at least.
pub fn Nav::replace_above[P](self : Nav[P], keep : Int, pages : Array[P]) -> Unit {
  self.told_focus(fn() { self.replace_above_now(keep, pages) })
}

///|
fn Nav::replace_above_now[P](self : Nav[P], keep : Int, pages : Array[P]) -> Unit {
  let keep = if keep < 0 { 0 } else { keep }
  if pages.is_empty() && (keep == 0 || self.pages.length() <= keep) {
    return
  }
  self.settle()
  while self.pages.length() > keep {
    let e = mbt_compat::opt_unwrap(self.pages.pop())
    // (the root's too: what left over it is of another root, let go with it, never put by, nav_flat_view's
    // either; else kept, Nav::try_park_left)
    if keep == 0 {
      e.shown_once = false
      self.gone.push(e)
    } else {
      self.leaves(e)
    }
  }
  // (another workspace's pages, or a page in place of a place: none put by is taken back, Nav::replace_kept; over a
  // root kept, what is on its shelf and kept left stays)
  if keep == 0 {
    self.shelf_clear_gone()
    self.kept_left_empty()
  }
  for page in pages {
    self.pages.push(self.take_kept_left(page, mbt_compat::opt_map(mbt_compat::arr_last(self.pages), fn(e) { e.page })))
  }
  // (none put on: the one now on top come back to, as a pop's is)
  if pages.is_empty() {
    self.topped()
  }
  self.told()
  wake()
}

///|
/// A stack changed: changed as the frame is built, built again from it in the frame (no frame shows the page it left
/// as it was), all of it anew; between frames, the next frame (Ctx::read_changed), what builds a stack told
/// (stacks_said: a part kept as its nodes that holds one, built again).
fn wake() -> Unit {
  if !building.v {
    stacks_said.v.set(stacks_said.v.untracked() + 1)
  }
  g().read_changed("a stack changed")
}

///|
/// How many times a stack changed between frames (wake): what builds one reads it (Ctx::nav, Ctx::nav_flat).
// kept across runs: a count, read as it changes
// moved to 00_init_order.pion: stacks_said

///|
/// Back as a back gesture asks: kind 0 started at x (in a view `w` wide), 1
/// moved to x, 2 let go there (back if past a third, or back_far, or flung), 3 called
/// off, 4 back (the system decided: from where a gesture had it, or a back
/// with none); `t` the time; `progress` the system's (-1 none: ui's own
/// edge). Never past its floor (Ctx::nav's `floor`; `floor`, where what tells it the steps says where that is now: the
/// one it asked whether back is the stack's by, Nav::backs_over's).
fn Nav::gesture[P](self : Nav[P], kind : Int, x : Double, w : Double, t : Double, progress? : Double, floor? : Int) -> Unit {
  let progress = match progress { Some(__mbt_v) => __mbt_v, None => -1.0 }

  let w = dmax(w, 1.0)
  let floor = floor.unwrap_or(self.floor)
  match kind {
    0 =>
    if self.mode == 0 && self.pages.length() > floor + 1 {
      self.mode = 3
      self.p = 0.0
      self.finger.set(0.0)
      self.gesture_told()
      self.shown_told()
      self.x0 = x
      self.vel = 0.0
      self.track.reset()
      self.track.add(t, x)
      self.moved_x = x
      self.moved_at = t
      self.moved_progress = progress
      self.moved_p = 0.0
    }
    1 =>
    if self.mode == 3 {
      if progress >= 0.0 && x == self.moved_x {
        // the system's step with its finger where it was, longer than a moving finger's steps are apart: lifted,
        // the system going back on its own before it says it is called off (Android's BackProgressAnimator takes
        // its progress to 0 first, on its spring, the finger's place kept); the page goes back with that progress,
        // not standing where the finger left it. (A finger held still: its progress comes to where the finger is,
        // by no more than it lagged.)
        if t > self.moved_at + tracker_gap_ms && self.moved_progress > 0.0 && progress < self.moved_progress {
          self.p = self.moved_p * progress / self.moved_progress
          self.finger.set(self.p)
          self.track.add(t, self.x0 + self.p * w)
        }
      } else {
        self.p = dclamp((x - self.x0) / w, 0.0, 1.0)
        self.finger.set(self.p)
        self.track.add(t, x)
        self.moved_x = x
        self.moved_at = t
        self.moved_progress = progress
        self.moved_p = self.p
      }
    }
    2 =>
    if self.mode == 3 {
      let dx = self.p * w
      // where it was let go counts where it moved there (Tracker::up); held still first, it was not flung
      // (Tracker::velocity_at)
      self.track.up(t, x)
      self.vel = self.track.velocity_at(t)
      if back_goes(dx, w, self.vel) {
        self.let_go(dmax(self.vel, 0.0) / w)
      } else if self.p <= 0.0 {
        // (brought back to its place by the finger: at rest there, not sent on past it at the finger's speed)
        self.rest_from_finger()
      } else {
        // back to rest, as fast as the finger let it go (its widths per ms)
        self.go(4, 0.0, v=self.vel / w)
      }
    }
    3 =>
    if self.mode == 3 {
      if self.p <= 0.0 {
        self.rest_from_finger()
      } else {
        self.go(4, 0.0)
      }
    }
    _ =>
    if self.mode == 3 {
      self.let_go(0.0)
    } else if self.pages.length() > floor + 1 {
      let e = self.pages[self.pages.length() - 1]
      if self.pop() {
        (self.went_back)(e.page, e.over, e.rise, self.pages())
      }
    }
  }
}

///|
/// Let go where it rests (in its place): at rest at once, what lay under it put away (Ctx::nav told, as Nav::go tells).
fn Nav::rest_from_finger[P](self : Nav[P]) -> Unit {
  self.settle()
  if self.hosted is Option::None {
    wake()
  }
}

///|
/// How far a finger takes a page back, however wide it is: a third of a phone's (360 across), so a wide one (a fold
/// open, a tablet, a phone on its side; a chat's detail over its list) goes back as a phone's does, not only once a
/// third of its width is crossed .
// moved to 00_init_order.pion: back_far

///|
/// Gone back from where a finger left the page: on from there, as fast as it let it go (`v`, its widths per ms).
fn Nav::let_go[P](self : Nav[P], v : Double) -> Unit {
  self.told_focus(fn() { self.let_go_now(v) })
}

///|
fn Nav::let_go_now[P](self : Nav[P], v : Double) -> Unit {
  let was_gesture = self.mode == 3 || self.mode == 4
  self.leaving = self.pages.pop()
  self.topped()
  self.told()
  match self.leaving {
    Some(e) => (self.went_back)(e.page, e.over, e.rise, self.pages())
    Option::None => ()
  }
  self.go(2, 1.0, v=v)
  if was_gesture {
    self.gesture_told()
  }
}

///|
/// The stack drawn, filling what it is given: the top page (and, while one
/// moves, the page beside it), each built by `page` on a ground of `bg`.
/// Back (Ctx::back, the left edge's swipe within `edge` of its side, the
/// system's) comes here while it has a page to go back to, unless the top
/// page takes it itself (what is open in it closed first). `floor`: the
/// pages at and under that index are not this stack's to go back from (a
/// pane's stack over a list kept beside it: Ctx::nav_flat's `stacks`):
/// back comes here while it has a page over the floor. `takes_back`: false,
/// back is not its now (the pane it is drawn in not the one in use).
pub fn Ctx::nav[P](self : Ctx, nav : Nav[P], page : (P) -> Unit, bg? : Int64, edge? : Double, floor? : Int, takes_back? : Bool) -> Int {
  let bg = match bg { Some(__mbt_v) => __mbt_v, None => 0L }
  let edge = match edge { Some(__mbt_v) => __mbt_v, None => 20.0 }
  let floor = match floor { Some(__mbt_v) => __mbt_v, None => 0 }
  let takes_back = match takes_back { Some(__mbt_v) => __mbt_v, None => true }

  // (its pages read: built again as they change)
  nav.said.get() |> ignore
  stacks_said.v.get() |> ignore
  // (held by the window's tree: its slides told at their causes, which this build learns of as what shows changes)
  if nav.hosted is Some(_) {
    nav.shown.get() |> ignore
  }
  nav.floor = floor
  nav.room_w = self.width
  nav.room_h = self.height
  // (told before its room was known: how long its way takes, worked out now that it is, once; when it set out kept)
  match nav.dur_way {
    Some(way) => {
      let rising = match nav.leaving {
        Some(e) => e.rise
        Option::None => nav.pages[nav.pages.length() - 1].rise
      }
      let room = if rising { nav.room_h } else { nav.room_w }
      if room > 0.0 {
        nav.dur = move_ms(way * room)
        nav.dur_way = Option::None
      }
    }
    Option::None => ()
  }
  if nav.mode == 3 {
    self.page_in_hand = true
  }
  for e in nav.gone {
    self.forget(e.serial)
    nav.entry_left(e)
  }
  nav.gone.clear()
  if nav.t0 == nav_held {
    // held for what the page pushed shows (Nav::comes_when): where it was, not moving yet; at rest by the latest its
    // slide could end (nav_rest)
    let r = nav.rested_at(self.frame_no)
    if r > self.nav_rest {
      self.nav_rest = r
    }
  } else if nav.mode == 1 || nav.mode == 2 || nav.mode == 4 {
    if nav.t0 < 0.0 && nav.hosted is Option::None {
      // it starts now: said to move again (not built in the frame it was to start in, it had been let be)
      nav.t0 = self.clock
      self.moving(nav.mover, nav.as_moving(), what="a stack's slide")
    }
    // where its pages are is worked out as they are laid out and painted (Nav::at, Ctx::nav_layer): its frames are
    // painted alone (frame_watch.pion). Its end is a moment, the frame at it built again (over at the end it says,
    // t0 + dur, to the bit: (t0 + dur - t0) / dur can fall short of 1 by a rounding)
    nav.late_check(self)
    // (held by the window's tree: set out and over at its moments there, Nav::held_by, the frame at them drawn so)
    if nav.hosted is Some(_) {
      ()
    } else if nav.dur <= 0.0 || self.clock >= nav.t0 + nav.dur {
      nav.settle()
      // the page that slid away forgotten in the frame its slide ends (`on_leave` told), not the next
      for e in nav.gone {
        self.forget(e.serial)
        nav.entry_left(e)
      }
      nav.gone.clear()
    } else {
      self.wake_at_time(nav.t0 + nav.dur)
    }
    let r = nav.rested_at(self.frame_no)
    if r > self.nav_rest {
      self.nav_rest = r
    }
  } else if nav.ended > self.nav_rest {
    // (at rest: its last slide's end, as it was)
    self.nav_rest = nav.ended
  }
  let n = nav.pages.length()
  let top = match nav.leaving {
    Some(e) => e
    Option::None => nav.pages[n - 1]
  }
  let under = match nav.leaving {
    Some(_) => Some(nav.pages[n - 1])
    Option::None => if nav.mode != 0 && n > 1 { Some(nav.pages[n - 2]) } else { Option::None }
  }
  // a page that rose goes up and down over the one under it, which stays
  let rising = top.rise
  // the side the top page is off to (one from the left goes back left, the page under it coming from the right)
  let way = if (nav.from_left)(top.page, top.under) { -1.0 } else { 1.0 }
  // back as it was before the stack, for when neither its top page nor it takes it
  let before = self.back_next
  let before_node = self.back_node_next
  let before_edge = self.back_edge_next
  let before_island = self.back_island_next
  let before_chain = self.back_chain_next
  let leaving = nav.leaving is Some(_)
  let i = self.box(w=Fill(1.0), h=Fill(1.0), clip=true, fn() {
    // (pushed: the page it covers takes nothing from the moment it is pushed)
    match under {
      Some(e) => self.nav_layer(nav, e, true, rising, way, bg, page, inert=nav.mode == 1)
      Option::None => ()
    }
    // what the top page takes back for (a sheet, a menu, a step of its own, a stack in it) goes back before the stack
    // does, as Android's BackHandler in a page is asked before the pages' own; the page under it, one leaving, take none
    self.back_next = Option::None
    self.back_node_next = -1
    self.back_island_next = Option::None
    self.back_chain_next = .Unsaid
    // (going back: the page leaving takes nothing)
    self.nav_layer(nav, top, false, rising, way, bg, page, inert=leaving)
  })
  let stack_takes = takes_back && (n > floor + 1 || nav.mode >= 3 || (floor == 0 && nav.mode != 0))
  let stack : BackEntry = BackEntry::{
    f: fn(kind, x, w, t, progress) { nav.gesture(kind, x, w, t, progress=progress) },
    node: i,
    edge: edge,
    island: self.island_said(),
    layer: 0,
    stack: self.back_stack_said(),
    stack_in: Option::None,
    within: self.back_within,
  }
  if self.back_next is Some(_) && !leaving && takes_back {
    // (what the top page said first, the stack under it, what was before it under that: what takes back as each over
    // it took it, Ctx::layer_back_taken)
    let under = if stack_takes { BackList::Said(stack, before_chain) } else { before_chain }
    self.back_chain_next = back_list_over(self.back_chain_next, under)
  } else if stack_takes {
    self.back_next = Some(stack.f)
    self.back_node_next = stack.node
    self.back_edge_next = stack.edge
    self.back_island_next = stack.island
    self.back_chain_next = BackList::Said(stack, before_chain)
  } else {
    self.back_next = before
    self.back_node_next = before_node
    self.back_edge_next = before_edge
    self.back_island_next = before_island
    self.back_chain_next = before_chain
  }
  i
}

///|
/// Builds `body`, back taken in it (Ctx::on_back, Ctx::take_back, an overlay, a stack: Ctx::nav) kept over what took
/// it before: true when it took it; when not, back is as it was. For what goes back only when nothing within it does
/// (a stack drawn flat, whose pop is taken after it: Ctx::nav_flat).
pub fn Ctx::took_back(self : Ctx, body : () -> Unit) -> Bool {
  let before_chain = self.back_chain_next
  let before = self.back_next
  let before_node = self.back_node_next
  let before_edge = self.back_edge_next
  let before_island = self.back_island_next
  self.back_next = Option::None
  self.back_node_next = -1
  self.back_island_next = Option::None
  self.back_chain_next = .Unsaid
  body()
  if self.back_next is Some(_) {
    // (what was before it under what it said: what takes back as each over it took it)
    self.back_chain_next = back_list_over(self.back_chain_next, before_chain)
    true
  } else {
    self.back_next = before
    self.back_node_next = before_node
    self.back_edge_next = before_edge
    self.back_island_next = before_island
    self.back_chain_next = before_chain
    false
  }
}

///|
/// Page `e` of the stack, the top or the one `under` it, built over its whole room on a ground of `bg`, placed where
/// its slide has it at the frame's time (Nav::at: the page beside the top edge to edge with it, one that rose going up
/// and down over the one under it, which stays): laid out there, and placed there again as each frame is painted,
/// nothing built (Ctx::moved_by).
fn Ctx::nav_layer[P](self : Ctx, nav : Nav[P], e : NavPage[P], under : Bool, rising : Bool, way : Double, bg : Int64, page : (P) -> Unit, inert? : Bool) -> Unit {
  let inert = match inert { Some(__mbt_v) => __mbt_v, None => false }

  let i = self.box(w=Fill(1.0), h=Fill(1.0), bg=bg, fn() {
    let saved = self.owner
    let saved_stint = self.stint
    self.owner = e.serial
    self.stint = e.stint
    nav.built_by(e, fn() { self.scope_(e.serial, fn() { page(e.page) }) })
    self.owner = saved
    self.stint = saved_stint
  })
  self.nodes[i].layer = true
  if nav.mode != 0 {
    let height = self.height
    self.moved_by(i, fn(w, _) {
      // (the clock read, followed, while it slides)
      let p = nav.at(self.now_before(nav.slide_end(self)))
      if rising {
        (0.0, if under { 0.0 } else { p * height })
      } else {
        (way * (if under { p - 1.0 } else { p }) * w, 0.0)
      }
    })
  }
  if inert {
    self.draw_only(i)
  }
}

///|
/// When the top page's slide ends (-1: none goes), its start moved on as late as its first frame was (Nav::late_check):
/// till then what places it reads the clock, followed (painted again each frame).
fn Nav::slide_end[P](self : Nav[P], c : Ctx) -> Double {
  if (self.mode == 1 || self.mode == 2 || self.mode == 4) && self.t0 >= 0.0 {
    self.late_check(c)
    self.t0 + self.dur
  } else {
    -1.0
  }
}

///|
/// Where its slide has the top page at `now`, the one way it is read (Nav::at as a frame is laid out, Nav::p_at as it
/// is painted alone: the two read alike to the bit): its time gone on the moments' grid (gone_ms).
fn Nav::slid_at[P](self : Nav[P], now : Double) -> Double {
  self.slid_motion_at(now).0
}

///|
/// Where its slide has the top page at `now` (Nav::slid_at) and how fast it goes there (its widths per ms).
fn Nav::slid_motion_at[P](self : Nav[P], now : Double) -> (Double, Double) {
  let gone = flex::time_gone(now, self.t0)
  let t = if self.dur <= 0.0 || gone >= self.dur { self.dur } else { dmax(gone, 0.0) }
  if self.slide_room > 0.0 && self.v0 * (self.p1 - self.p0) < 0.0 {
    // (turned back: in points across its room, as long as Nav::go said)
    let room = self.slide_room
    let (pos, vel) = come_way_by(self.p0 * room, self.v0 * room, self.p1 * room, self.p1 * room, t, kept=self.slide_turn)
    (pos / room, vel / room)
  } else {
    // (no faster toward its end than a Move brings it to rest there without going past: move_k / dur of how far,
    // as @flex.ComeGroup's)
    let d = self.p0 - self.p1
    let most = if self.dur > 0.0 { move_k / self.dur * d.abs() } else { 0.0 }
    let v0 = if d > 0.0 {
      dmax(self.v0, -most)
    } else if d < 0.0 {
      dmin(self.v0, most)
    } else {
      0.0
    }
    let (x, v) = move_path(d, v0, t, self.dur)
    (self.p1 + x, v)
  }
}

///|
/// Where the top page is, in its widths off to its side (0 in place: Nav's `p`), as its slide has it at `now` (the
/// frame's time as it is laid out and painted: Nav::slide_end says till when that is followed), from where it set out,
/// by when and how; followed by a finger, where the finger has it.
fn Nav::at[P](self : Nav[P], now : Double) -> Double {
  if (self.mode == 1 || self.mode == 2 || self.mode == 4) && self.t0 >= 0.0 {
    self.p = self.slid_at(now)
  }
  // (following a finger: where it has it, read so)
  if self.mode == 3 {
    self.finger.get() |> ignore
  }
  self.p
}

///|
/// A page brought in: its first frame drawn from where it starts; the next (built or painted alone) told how late that
/// one was to the screen, its slide's start moved on by that (nav_late_most at most), from its cause's frame, once.
fn Nav::late_check[P](self : Nav[P], c : Ctx) -> Unit {
  if !self.waits_late {
    return
  }
  if self.late_at < 0.0 {
    self.late_at = c.clock
  } else if c.clock > self.late_at {
    self.waits_late = false
    let late = dmin(h_frame_late(), nav_late_most)
    if late > 0.0 {
      self.t0 = self.t0 + late
      c.moving(self.mover, self.as_moving(), what="a stack's slide")
    }
  }
}

///|
/// `body` building page `e` of the stack (what Nav::under answers for), within whatever page of another is being built.
fn Nav::built_by[P](self : Nav[P], e : NavPage[P], body : () -> Unit) -> Unit {
  let saved = self.built
  self.built = Some(e)
  body()
  self.built = saved
}

///|
/// The time on top of the page being built (a stack's: a number of its own each time the page is put on top, pushed
/// or come back to; 0 outside any): what is put up anew when its page is (a picture that could not be had asked for
/// again, as Compose's produceState runs again as its page comes back), whatever frames were drawn between.
pub fn Ctx::page_stint(self : Ctx) -> Int {
  self.stint
}

///|
/// Notes widget state `id` as the current page's (forgotten with it).
fn Ctx::own(self : Ctx, id : Int) -> Unit {
  if self.owner != 0 {
    match self.owned.get(self.owner) {
      Some(a) => a.push(id)
      Option::None => self.owned.set(self.owner, [id])
    }
  }
}

///|
/// The page of a stack what is built now belongs to (0: none, outside a stack): the same through all of the page's
/// builds, whatever row of a list it is built in, so what is made once for a page is found again by it after rows came
/// before it (a list's rows' ids are by their index).
pub fn Ctx::page_owner(self : Ctx) -> Int {
  self.owner
}

///|
pub struct OwnedReleases {
  priv ids : Array[Int]
  priv callbacks : mbt_compat::OrderedMap[Int, () -> Unit]
}

///|
/// Calls the latest `release` when the current page leaves its stack, once per key in the current scope. A retained
/// page keeps its resources while another page is over it. Outside a stack there is no page to release.
pub fn Ctx::on_page_release(self : Ctx, key : String, release : () -> Unit) -> Unit {
  if self.owner == 0 {
    return
  }
  let id = self.id(key)
  let callbacks = match self.owned_releases.get(self.owner) {
    Some(callbacks) => callbacks
    Option::None => {
      let callbacks : OwnedReleases = OwnedReleases::{ ids: [], callbacks: mbt_compat::ordered_map_new() }
      self.owned_releases.set(self.owner, callbacks)
      callbacks
    }
  }
  if !callbacks.callbacks.contains(id) {
    callbacks.ids.push(id)
  }
  callbacks.callbacks.set(id, release)
}

///|
/// Forgets what page `serial`'s widgets held.
fn Ctx::forget(self : Ctx, serial : Int) -> Unit {
  match self.owned.get(serial) {
    Some(ids) => {
      for id in ids {
        self.lists.remove(id)
        match self.editors.get(id) {
          Some(st) => editor_gone(st, id)
          Option::None => ()
        }
        self.editors.remove(id)
        self.springs.remove(id)
        drags.remove(id)
        press_followers.remove(id)
        files_on.remove(id)
        code_fields.remove(id)
        if self.focus == id {
          self.focus_moved(0)
        }
      }
      self.owned.remove(serial)
    }
    Option::None => ()
  }
  match self.owned_releases.get(serial) {
    Some(callbacks) => {
      self.owned_releases.remove(serial)
      for id in callbacks.ids {
        match callbacks.callbacks.get(id) {
          Some(release) => release()
          Option::None => ()
        }
      }
    }
    Option::None => ()
  }
}

///|
/// Back done now, as Ctx::back does it, from a handler (an action of the window's tree's: ⌘[), no build's Ctx at hand.
pub fn go_back() -> Bool {
  g().back()
}

///|
/// Back, as a back button asks: the stack drawn last (the innermost that
/// can) goes back a page. False when nothing could.
pub fn Ctx::back(self : Ctx) -> Bool {
  // (what takes back now, where it may take input: a node of the window's tree's, else the old views', view_host.pion;
  // found and done as one event of the window's tree at this moment, what was due by then done first)
  let went = mbt_compat::ref_new(false)
  let go = fn() {
    match self.back_taker() {
      Some(h) if old_owner_open(h.owner) => {
        (h.f)(4, 0.0, 1.0, view_moment(), -1.0)
        self.read_changed("gone back")
        went.v = true
      }
      _ => ()
    }
  }
  match view_app.v {
    Some(tree) => tree.event(view_moment(), go)
    Option::None => go()
  }
  went.v
}

///|
/// Back taken by what is drawn over the stack (a viewer, a sheet), on the frames it calls this, after the stack is
/// drawn: the system's back, a back button (Ctx::back) call `f` once let go; no edge swipe of its own.
pub fn Ctx::take_back(self : Ctx, f : () -> Unit) -> Unit {
  self.back_next = Some(fn(kind, _x, _w, _t, _) {
    if kind == 2 || kind == 4 {
      f()
    }
  })
  self.back_node_next = -1
  self.back_island_next = self.island_said()
  self.back_says()
}

///|
/// Back taken by what is drawn over the stack, on the frames it calls this, after the stack is drawn, followed as it
/// goes (Ctx::take_back's, step by step): the system's back gesture (Android's predictive back, from either edge: x
/// from the edge it came from, as a stack's page follows it) and a back with no gesture come to `f` as their steps;
/// for what moves back with the finger as a stack's page does without being one (a tape's panels). No edge swipe of
/// its own.
pub fn Ctx::follow_back(self : Ctx, f : (view::BackStep) -> Unit) -> Unit {
  self.back_next = Some(fn(kind, x, _w, t, _) {
    match kind {
      0 => f(.Began(x, t))
      1 => f(.Moved(x, t))
      2 => f(.LetGo(x, t))
      3 => f(.CalledOff)
      _ => f(view::BackStep::Back)
    }
  })
  self.back_node_next = -1
  self.back_island_next = self.island_said()
  self.back_says()
}

///|
/// The top page of `nav` alone, in place, nothing sliding and nothing swiped back: a desktop's pane beside a sidebar,
/// whose pages are the same stack as a phone's (Ctx::nav draws it so on a narrow window). A page gone is forgotten
/// (its widgets' state, `on_leave` told) as Ctx::nav forgets it; one moving is put where it was going.
/// `stacks`: what is pushed over (Nav::push_over) a stack of the pane's own, as a phone's (a pane on a tape, a phone's
/// screen beside a list): it slides in over the page under it, and back takes it off sliding (following the system's
/// gesture) as Ctx::nav has them, down to the page put there in place (its `floor`), which is shown in place as ever;
/// `takes_back` false, back not its now (Ctx::nav's: the pane not the one in use).
pub fn Ctx::nav_flat[P](self : Ctx, nav : Nav[P], page : (P) -> Unit, bg? : Int64, stacks? : Bool, takes_back? : Bool) -> Int {
  let bg = match bg { Some(__mbt_v) => __mbt_v, None => 0L }
  let stacks = match stacks { Some(__mbt_v) => __mbt_v, None => false }
  let takes_back = match takes_back { Some(__mbt_v) => __mbt_v, None => true }

  // (its pages read: built again as they change)
  nav.said.get() |> ignore
  stacks_said.v.get() |> ignore
  // (the room it is drawn in, as Ctx::nav has it: how far what is pushed over it slides, told at its cause)
  nav.room_w = self.width
  nav.room_h = self.height
  if stacks && nav.stacked() {
    // (one pushed over it slides in once it has what it shows, waiting as long as one put in place waits:
    // Nav::shows_when's, asked this frame)
    // (held by the window's tree, Nav::held_over: as its node says, at its causes, none of this)
    if nav.flat_asked == self.frame_no {
      nav.comes_when(nav.flat_ready, nav.flat_most)
    }
    return self.nav(nav, page, bg=bg, floor=nav.over_floor(), takes_back=takes_back)
  }
  if nav.mode != 0 || nav.leaving is Some(_) {
    nav.settle()
  }
  let top = nav.pages[nav.pages.length() - 1]
  // the page put on top since, waited for while the one before stays: as its owner said it at its causes
  // (Nav::flat_keep), else as the frames found it (Nav::shows_when)
  let held = if nav.flat_owner { nav.flat_kept_entry() } else { nav.flat_held(self) }
  // what left the stack forgotten (and told), but the page that stays shown while the new one is waited for
  let kept : Array[NavPage[P]] = []
  for e in nav.gone {
    match held {
      Some(h) if h.serial == e.serial => kept.push(e)
      _ => {
        self.forget(e.serial)
        nav.entry_left(e)
      }
    }
  }
  nav.gone.clear()
  mbt_compat::arr_append(nav.gone, kept)
  let drawn = held.unwrap_or(top)
  nav.flat_frame = self.frame_no
  if held is Option::None {
    nav.flat_shown = Some(top)
    nav.flat_for = -1
  }
  self.box(w=Fill(1.0), h=Fill(1.0), clip=true, bg=bg, fn() {
    let saved = self.owner
    let saved_stint = self.stint
    self.owner = drawn.serial
    self.stint = drawn.stint
    nav.built_by(drawn, fn() { self.scope_(drawn.serial, fn() { page(drawn.page) }) })
    self.owner = saved
    self.stint = saved_stint
  })
}

///|
/// Whether a page a finger drew `dx` across of `w`, let go going `vel` (points a ms), goes back: landing a third across
/// or back_far on from that speed (lands_past), or flung (past 40, faster than 0.6).
fn back_goes(dx : Double, w : Double, vel : Double) -> Bool {
  let flung = dx > 40.0 && vel > 0.6
  lands_past(dx, vel, w / 3.0) || lands_past(dx, vel, back_far) || flung
}
