// Deterministic input recording, text serialization, and replay engine (`RecEvent`, `InputTape`).
// Zero third-party dependencies; replays timestamped pointer, wheel, keyboard, text, resize, and wait traces onto `Tester`.

import "dmath"

/// A single timestamped input event in a deterministic `InputTape`.
#derive(Eq)
pub enum RecEvent {
  Move(Double, Double, Double)
  Press(Double, Double, Double)
  Release(Double, Double, Double)
  Wheel(Double, Double, Double, Double, Int, Double)
  Key(Int, Int, Double)
  Text(String, Double)
  Resize(Double, Double, Double)
  Wait(Double)
}

/// Ordered sequence of recorded input events with lossless line-oriented serialization and `Tester` replay.
pub struct InputTape {
  pub events : Array[RecEvent]
}

/// Create an empty `InputTape`.
pub fn InputTape::new() -> InputTape {
  InputTape::{ events: [] }
}

/// Number of recorded events in the tape.
pub fn InputTape::len(self : InputTape) -> Int {
  self.events.length()
}

/// Clear all recorded events.
pub fn InputTape::clear(self : InputTape) -> Unit {
  self.events.clear()
}

/// Record a pointer move to `(x, y)` at timestamp `at` (ms).
pub fn InputTape::record_move(self : InputTape, x : Double, y : Double, at : Double) -> Unit {
  self.events.push(RecEvent::Move(x, y, at))
}

/// Record a primary pointer press at `(x, y)` at timestamp `at` (ms).
pub fn InputTape::record_press(self : InputTape, x : Double, y : Double, at : Double) -> Unit {
  self.events.push(RecEvent::Press(x, y, at))
}

/// Record a primary pointer release at `(x, y)` at timestamp `at` (ms).
pub fn InputTape::record_release(self : InputTape, x : Double, y : Double, at : Double) -> Unit {
  self.events.push(RecEvent::Release(x, y, at))
}

/// Record a wheel event at `(x, y)` with delta `(dx, dy)` and `phase` at timestamp `at` (ms).
pub fn InputTape::record_wheel(
  self : InputTape,
  x : Double,
  y : Double,
  dx : Double,
  dy : Double,
  phase : Int,
  at : Double,
) -> Unit {
  self.events.push(RecEvent::Wheel(x, y, dx, dy, phase, at))
}

/// Record a key press with `code` and `mods` at timestamp `at` (ms).
pub fn InputTape::record_key(self : InputTape, code : Int, mods : Int, at : Double) -> Unit {
  self.events.push(RecEvent::Key(code, mods, at))
}

/// Record committed text input `text` at timestamp `at` (ms).
pub fn InputTape::record_text(self : InputTape, text : String, at : Double) -> Unit {
  self.events.push(RecEvent::Text(text, at))
}

/// Record a viewport resize to `(w, h)` at timestamp `at` (ms).
pub fn InputTape::record_resize(self : InputTape, w : Double, h : Double, at : Double) -> Unit {
  self.events.push(RecEvent::Resize(w, h, at))
}

/// Record an explicit wait span of `ms` milliseconds.
pub fn InputTape::record_wait(self : InputTape, ms : Double) -> Unit {
  self.events.push(RecEvent::Wait(ms))
}

fn escape_tape_text(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu == 92 {
      sb.write_string("\\\\")
    } else if cu == 10 {
      sb.write_string("\\n")
    } else if cu == 13 {
      sb.write_string("\\r")
    } else if cu == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i += 1
  }
  sb.to_string()
}

fn unescape_tape_text(s : String) -> String {
  let sb = StringBuilder::new()
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu == 92 && i + 1 < n {
      let nx = s.code_unit_at(i + 1)
      if nx == 92 {
        sb.write_string("\\")
      } else if nx == 110 {
        sb.write_string("\n")
      } else if nx == 114 {
        sb.write_string("\r")
      } else if nx == 116 {
        sb.write_string("\t")
      } else {
        sb.write_string(s.slice(i + 1, i + 2))
      }
      i += 2
    } else {
      sb.write_string(s.slice(i, i + 1))
      i += 1
    }
  }
  sb.to_string()
}

/// Serialize all events in this tape into a portable newline-delimited text format.
pub fn InputTape::to_lines(self : InputTape) -> String {
  let sb = StringBuilder::new()
  let n = self.events.length()
  let mut i = 0
  while i < n {
    if i > 0 {
      sb.write_char('\n')
    }
    match self.events[i] {
      RecEvent::Move(x, y, at) => sb.write_string("M \{x} \{y} \{at}")
      RecEvent::Press(x, y, at) => sb.write_string("P \{x} \{y} \{at}")
      RecEvent::Release(x, y, at) => sb.write_string("R \{x} \{y} \{at}")
      RecEvent::Wheel(x, y, dx, dy, phase, at) => sb.write_string("W \{x} \{y} \{dx} \{dy} \{phase} \{at}")
      RecEvent::Key(code, mods, at) => sb.write_string("K \{code} \{mods} \{at}")
      RecEvent::Text(text, at) => sb.write_string("T \{at} \{escape_tape_text(text)}")
      RecEvent::Resize(w, h, at) => sb.write_string("Z \{w} \{h} \{at}")
      RecEvent::Wait(ms) => sb.write_string("D \{ms}")
    }
    i += 1
  }
  sb.to_string()
}

fn slice_str(s : String, start : Int, end : Int) -> String {
  s.slice(start, end)
}

fn inputrec_split_lines(raw : String) -> Array[String] {
  let out : Array[String] = []
  let n = raw.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    let cu = raw.code_unit_at(i)
    if cu == 10 {
      let end = if i > start && raw.code_unit_at(i - 1) == 13 { i - 1 } else { i }
      if end > start {
        out.push(slice_str(raw, start, end))
      }
      start = i + 1
    }
    i += 1
  }
  if start < n {
    let end = if raw.code_unit_at(n - 1) == 13 { n - 1 } else { n }
    if end > start {
      out.push(slice_str(raw, start, end))
    }
  }
  out
}

fn inputrec_split_spaces(line : String) -> Array[String] {
  let out : Array[String] = []
  let n = line.length()
  let mut i = 0
  while i < n {
    while i < n && line.code_unit_at(i) == 32 {
      i += 1
    }
    let start = i
    while i < n && line.code_unit_at(i) != 32 {
      i += 1
    }
    if i > start {
      out.push(slice_str(line, start, i))
    }
  }
  out
}

fn parse_int_token(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return 0
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  let mut acc = 0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu >= 48 && cu <= 57 {
      acc = acc * 10 + (cu - 48)
    } else {
      break
    }
    i += 1
  }
  if neg { -acc } else { acc }
}

fn parse_double_token(s : String) -> Double {
  let n = s.length()
  if n == 0 {
    return 0.0
  }
  let mut i = 0
  let mut neg = false
  if s.code_unit_at(0) == 45 {
    neg = true
    i = 1
  } else if s.code_unit_at(0) == 43 {
    i = 1
  }
  let mut res = 0.0
  while i < n {
    let cu = s.code_unit_at(i)
    if cu >= 48 && cu <= 57 {
      res = res * 10.0 + (cu - 48).to_double()
      i += 1
    } else {
      break
    }
  }
  if i < n && s.code_unit_at(i) == 46 {
    i += 1
    let mut place = 0.1
    while i < n {
      let cu = s.code_unit_at(i)
      if cu >= 48 && cu <= 57 {
        res = res + (cu - 48).to_double() * place
        place = place * 0.1
        i += 1
      } else {
        break
      }
    }
  }
  if i < n && (s.code_unit_at(i) == 101 || s.code_unit_at(i) == 69) {
    i += 1
    let mut exp_neg = false
    if i < n && s.code_unit_at(i) == 45 {
      exp_neg = true
      i += 1
    } else if i < n && s.code_unit_at(i) == 43 {
      i += 1
    }
    let mut exp_val = 0
    while i < n {
      let cu = s.code_unit_at(i)
      if cu >= 48 && cu <= 57 {
        exp_val = exp_val * 10 + (cu - 48)
        i += 1
      } else {
        break
      }
    }
    let p = if exp_neg { -exp_val.to_double() } else { exp_val.to_double() }
    res = res * dmath::pow(10.0, p)
  }
  if neg { -res } else { res }
}

/// Deserialize an `InputTape` from lines produced by `InputTape::to_lines`.
pub fn InputTape::from_lines(raw : String) -> InputTape {
  let tape = InputTape::new()
  for line in inputrec_split_lines(raw) {
    if line.length() == 0 {
      continue
    }
    let tag = line.code_unit_at(0)
    // Text event preserves spaces in payload: `T <at> <escaped_text>`
    if tag == 84 && line.length() >= 3 && line.code_unit_at(1) == 32 {
      let mut sp = 2
      let n = line.length()
      while sp < n && line.code_unit_at(sp) != 32 {
        sp += 1
      }
      let at = parse_double_token(slice_str(line, 2, sp))
      let payload = if sp + 1 <= n { unescape_tape_text(slice_str(line, sp + 1, n)) } else { "" }
      tape.events.push(RecEvent::Text(payload, at))
      continue
    }
    let parts = inputrec_split_spaces(line)
    if parts.length() == 0 {
      continue
    }
    let k = parts[0]
    if k == "M" && parts.length() >= 4 {
      tape.events.push(RecEvent::Move(parse_double_token(parts[1]), parse_double_token(parts[2]), parse_double_token(parts[3])))
    } else if k == "P" && parts.length() >= 4 {
      tape.events.push(RecEvent::Press(parse_double_token(parts[1]), parse_double_token(parts[2]), parse_double_token(parts[3])))
    } else if k == "R" && parts.length() >= 4 {
      tape.events.push(RecEvent::Release(parse_double_token(parts[1]), parse_double_token(parts[2]), parse_double_token(parts[3])))
    } else if k == "W" && parts.length() >= 7 {
      tape.events.push(
        RecEvent::Wheel(
          parse_double_token(parts[1]),
          parse_double_token(parts[2]),
          parse_double_token(parts[3]),
          parse_double_token(parts[4]),
          parse_int_token(parts[5]),
          parse_double_token(parts[6]),
        ),
      )
    } else if k == "K" && parts.length() >= 4 {
      tape.events.push(RecEvent::Key(parse_int_token(parts[1]), parse_int_token(parts[2]), parse_double_token(parts[3])))
    } else if k == "Z" && parts.length() >= 4 {
      tape.events.push(RecEvent::Resize(parse_double_token(parts[1]), parse_double_token(parts[2]), parse_double_token(parts[3])))
    } else if k == "D" && parts.length() >= 2 {
      tape.events.push(RecEvent::Wait(parse_double_token(parts[1])))
    }
  }
  tape
}

fn advance_tester_to(t : Tester, at : Double) -> Unit {
  let dt = at - t.time()
  if dt > 0.0 {
    t.run_shown(dt)
  }
}

/// Replay all events in this tape deterministically onto `t`, stepping the clock to each recorded timestamp.
pub fn InputTape::replay(self : InputTape, t : Tester) -> Unit {
  for ev in self.events {
    match ev {
      RecEvent::Move(x, y, at) => {
        advance_tester_to(t, at)
        t.move_to(x, y)
      }
      RecEvent::Press(x, y, at) => {
        advance_tester_to(t, at)
        t.press_at(x, y)
      }
      RecEvent::Release(x, y, at) => {
        advance_tester_to(t, at)
        t.release(x, y)
      }
      RecEvent::Wheel(x, y, _dx, dy, _phase, at) => {
        advance_tester_to(t, at)
        t.wheel(x, y, dy)
      }
      RecEvent::Key(code, mods, at) => {
        advance_tester_to(t, at)
        t.key(code, mods=mods)
      }
      RecEvent::Text(text, at) => {
        advance_tester_to(t, at)
        t.type_text(text)
      }
      RecEvent::Resize(w, h, at) => {
        advance_tester_to(t, at)
        t.resize(w, h)
      }
      RecEvent::Wait(ms) => {
        if ms > 0.0 {
          t.run_shown(ms)
        }
      }
    }
  }
}
