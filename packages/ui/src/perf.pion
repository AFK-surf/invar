import "hostapi"
import "mbt_compat"

// What a frame did, for whoever measures the app (a scripted run measured offscreen: ui/src/film's bench, the app's
// scripts/appbench.sh): how much was built, laid out and drawn, and how long each took by the clock the work is timed
// by (work_now: a real host's; a Tester's, which the test's clock does not time, given one by the bench). Measured,
// never judged: nothing here asserts a time.

///|
/// The clock work is timed by (ms): the host's, unless a bench gave a Tester the machine's (set_work_clock).
// kept across runs: set by a bench before its Tester, for its run
// moved to 00_init_order.pion: work_clock

///|
/// The clock the frame's work is timed by from now on (Ctx's t_build, t_layout, t_paint, t_present; frame_perf): the
/// machine's for a bench over a Tester, whose own clock is the run's; None, the host's.
pub fn set_work_clock(f : Option[() -> Double]) -> Unit {
  work_clock.v = f
}

///|
fn work_now() -> Double {
  match work_clock.v {
    Some(f) => f()
    Option::None => h_now()
  }
}

///|
/// Optional test override for per-thread CPU time (ms); when unset and `work_clock` is active, returns -1.0.
// kept across runs: reset by tests that set it
// moved to 00_init_order.pion: thread_cpu_clock

///|
fn work_thread_cpu() -> Double {
  match thread_cpu_clock.v {
    Some(f) => f()
    Option::None =>
    match work_clock.v {
      Some(_) => -1.0
      Option::None => hostapi::thread_cpu_ms()
    }
  }
}

///|
/// The first finger lifted since the last frame (ms on the work clock), for the time until a frame is submitted.
// kept across runs: reset as the hand is reset, or the first frame after the touch is submitted
// moved to 00_init_order.pion: perf_touch_at

///|
fn perf_touch_started() -> Unit {
  if !hostapi::perf_recording() {
    perf_touch_at.v = -1.0
  } else if perf_touch_at.v < 0.0 {
    perf_touch_at.v = work_now()
  }
}

///|
/// A frame submitted after a finger was lifted: this says the delay to submission, not when it appeared on screen or
/// whether it drew what the touch chose.
fn perf_touch_submitted(at : Double) -> Unit {
  let start = perf_touch_at.v
  perf_touch_at.v = -1.0
  if start >= 0.0 && hostapi::perf_recording() && at >= start + probe_slow_ms {
    hostapi::perf_line("touch: to_submit=\{mbt_compat::double_to_string(((at - start) * 10.0).round() / 10.0)}ms")
  }
}

///|
/// What the last frame did: the nodes its builds made (the last build's), those laid out anew, those placed elsewhere
/// as they were and those where they were (layout.pion's commit); the instances it drew; how long the window's tree
/// took to be brought before it (its nodes made, bound and laid out: view_frame), how long its builds, its layout and
/// its paint took (ms, by work_now); how many times it was built (a layout read back that moved builds it again).

pub struct FramePerf {
  pub nodes : Int
  pub laid : Int
  pub placed : Int
  pub same : Int
  pub insts : Int
  pub looks : Bool
  pub painted : Bool
  pub kept : Int
  pub rows : Int
  pub tree_ms : Double
  pub tree_laid : Int
  pub input_ms : Double
  pub build_ms : Double
  pub layout_ms : Double
  pub paint_ms : Double
  pub passes : Int
}

///|
/// The layout's counts as the frame began, and how many builds it took (frame_body).
// kept across runs: written by each frame before it is read
// moved to 00_init_order.pion: perf_at

///|
/// The window's tree's part of the last frame (FramePerf's `tree_ms`, `tree_laid`, `input_ms`), and where what it is
/// counted from stood as that frame began: the tree's count of nodes laid out, the script's steps since.
struct PerfTree {
  mut ms : Double
  mut laid : Int
  mut input_ms : Double
  mut laid_at : Int
  mut input_since : Double
}

///|
// kept across runs: put back as a run begins (perf_tree_reset)
// moved to 00_init_order.pion: perf_tree

///|
/// As a run begins: nothing of the run before's (its steps' time not yet taken by a frame, where its tree's count of
/// nodes laid out stood: a tree made anew counts from none).
fn perf_tree_reset() -> Unit {
  perf_tree.ms = 0.0
  perf_tree.laid = 0
  perf_tree.input_ms = 0.0
  perf_tree.laid_at = 0
  perf_tree.input_since = 0.0
}

///|
/// The frame's window's tree brought in `ms` (on_frame's `tw` to `t0`): its part of the frame (perf_tree), the script's
/// steps since the frame before taken as its input.
fn perf_tree_framed(ms : Double) -> Unit {
  let laid = match view_app.v {
    Some(tree) => tree.work().laid
    Option::None => 0
  }
  perf_tree.ms = ms
  perf_tree.laid = journal_since(laid, perf_tree.laid_at)
  perf_tree.laid_at = laid
  perf_tree.input_ms = perf_tree.input_since
  perf_tree.input_since = 0.0
}

///|
/// A script's steps handed the app in `ms` after a frame was presented (on_frame's drive_frame): the next frame's input.
fn perf_input_taken(ms : Double) -> Unit {
  perf_tree.input_since = perf_tree.input_since + ms
}

///|
/// As a frame begins: where the layout's counts stand.
fn perf_frame_start() -> Unit {
  for j in 0..<3 {
    perf_at[j] = commit_counts[j]
  }
  perf_at[3] = 0
}

///|
/// What the last frame did (FramePerf).
pub fn Tester::frame_perf(self : Tester) -> FramePerf {
  self.reads_own()
  ignore(self)
  frame_perf()
}

///|
fn frame_perf() -> FramePerf {
  let c = g()
  FramePerf::{
    nodes: if looks_drawn.v || painted_alone.v { 0 } else { c.count },
    laid: commit_counts[0] - perf_at[0],
    placed: commit_counts[1] - perf_at[1],
    same: commit_counts[2] - perf_at[2],
    insts: c.ninst,
    looks: looks_drawn.v,
    painted: painted_alone.v,
    kept: if looks_drawn.v || painted_alone.v { 0 } else { nodes_run.kept },
    rows: if looks_drawn.v || painted_alone.v { 0 } else { nodes_run.built },
    tree_ms: perf_tree.ms,
    tree_laid: perf_tree.laid,
    input_ms: perf_tree.input_ms,
    build_ms: c.t_build,
    layout_ms: c.t_layout,
    paint_ms: c.t_paint,
    passes: perf_at[3],
  }
}

///|
/// When the app asks for its next frame, as it tells a host after the last one (on_frame): 0, the display's next
/// frame (a frame wanted, a motion going, a cycle shown, a fiber stepping a frame at a time, a frame asked for between
/// frames); else the moment it asked to be woken at; +inf, none.
pub fn Tester::wanted_after(self : Tester) -> Double {
  self.reads_own()
  self.wanted_next()
}

///|
/// Tester::wanted_after, its Tester not asked to be the one made last: the Tester's own check of its frames
/// (Tester::frame_at_said).
fn Tester::wanted_next(self : Tester) -> Double {
  let c = g()
  if self.fake.wants ||
  c.wants_frame ||
  c.took_input ||
  paint_left() ||
  layout_left() ||
  c.motion_left ||
  c.cycling ||
  c.fiber_frame ||
  posted_left() != "" {
    0.0
  } else if c.wake_at > 0.0 {
    c.wake_at
  } else {
    mbt_compat::double_inf()
  }
}

///|
/// How many times the app has asked its host for the next display frame for what goes on by the clock (a motion going,
/// a cycle shown, a fiber stepping a frame at a time), as a host is asked (on_frame): what draws it on a device. A
/// Tester draws none for it (its time goes by run_for).
pub fn Tester::frames_on(self : Tester) -> Int {
  self.fake.frames_on
}

///|
/// How many frames a second the last frame said what moves on by the clock needs, as a host is told (frame_pace.pion,
/// @hostapi.frames_paced); 0 where it said none (the display's every frame, or no frame by the clock asked for).
pub fn Tester::frames_paced(self : Tester) -> Double {
  self.fake.paced
}

///|
/// Why the app asks for a frame (Tester::wanted_after), in words: the display's next frame's, else its wake's; "" when
/// it asks for none.
pub fn Tester::wanted_why(self : Tester) -> String {
  self.reads_own()
  let c = g()
  let why = []
  if self.fake.wants {
    why.push("a frame asked for between frames")
  }
  if c.wants_frame {
    why.push("a frame asked for" +
      by_of(c.frame_by) +
      (if c.took_input { " (an input's frame after)" } else { "" }) +
      (if c.read_back_moved { " (read back moved: \{c.read_back_key})" } else { "" }))
  }
  if paint_left() {
    why.push("a frame asked for to paint: " + paint_said.v)
  }
  if layout_left() {
    why.push("a frame asked for to lay out: " +
      (if layout_said.v != "" { layout_said.v } else { "what a part or a list's row read changed" }))
  }
  if c.took_input && !c.wants_frame {
    why.push("an input's frame after")
  }
  if c.motion_left {
    why.push("moving: " + c.moving_now().join("; "))
  }
  if c.cycling {
    why.push("cycling: " + self.cycles().join("; "))
  }
  if c.fiber_frame {
    why.push("a fiber stepping: " + fx.v.unsettled())
  }
  let posted = posted_left()
  if posted != "" {
    why.push(posted)
  }
  if why.is_empty() && c.wake_at > 0.0 {
    why.push("a wake in \{(c.wake_at - c.clock).ceil().to_int()} ms" +
      by_of(c.wake_by) +
      (if c.periodic.is_empty() { "" } else { " (comes again: " + self.periodic().join("; ") + ")" }))
  }
  why.join("; ")
}

///|
/// What a bench is told as the measured frame being drawn has been drawn by the app (Tester::bench's `around`)
// kept across runs: set by a bench as each measured frame begins, taken as it ends
// moved to 00_init_order.pion: bench_frame_end

///|
fn bench_frame_ends() -> Unit {
  if bench_frame_end.v is Some(f) {
    bench_frame_end.v = None
    f()
  }
}

///|
/// `script` run (Tester::drive's steps) on the display's frames at `fps` a second, a frame drawn at one only where the
/// app asks for it there, as a host draws (Tester::wanted_after): `each` told, at each of the display's frames from the
/// script's step `log measure` on (what comes before it, the app opening, not measured), whether one was drawn there.
/// `around` told as each measured frame drawn begins (false) and as the app has drawn it (true: the Tester's own
/// checks of it after, which a device runs not), with the display's frame it is at: what counts a frame's work from
/// outside (ui/film's mark, a profiled run's). Its frames keep not who drew each thing nor the lines of words drawn,
/// as a device's (the Tester's words-over check, words_over.pion, finds nothing in them; Tester::text_runs none). Until
/// the script ends or `max` of the display's frames went by. What the Tester logged.
pub fn Tester::bench(self : Tester, script : String, fps? : Double, max? : Int, each~ : (Tester, Bool) -> Unit, around? : (Int, Bool) -> Unit) -> Array[String] {
  let fps = match fps { Some(__mbt_v) => __mbt_v, None => 120.0 }
  let max = match max { Some(__mbt_v) => __mbt_v, None => 20000 }

  self.fake.logs.clear()
  // (who drew each instance not kept, as a device keeps it not: the Tester's words-over check's, each instance's owner
  // noted as it is drawn and copied as a list's rows are kept, ~7% of a frame's instructions; from the script's start,
  // the rows it keeps made so before what is measured)
  let tracked = inst_owners.track
  inst_owners.track = false
  inst_owners_clear()
  // (nor the lines of words drawn, as a device keeps them not: Tester::text_runs's, each line of words noted as it is
  // drawn and copied as a list's rows are kept again)
  let runs = text_runs.on
  text_runs.on = false
  text_runs.runs.clear()
  drive_start(script, "")
  let step = 1000.0 / fps
  let mut tick = self.fake.time
  let mut n = 0
  let mut measuring = false
  while driver.v is Some(_) && n < max {
    tick = tick + step
    let due = self.wanted_after()
    let frame = due <= tick + 1.0e-9 || (measuring && bench_whole.v)
    if frame {
      if measuring && around is Some(f) {
        f(n, false)
        bench_frame_end.v = Some(fn() { f(n, true) })
      }
      self.frame_at(tick)
      // (a frame that drew nothing of the app's: ended here)
      bench_frame_ends()
    } else {
      // (no frame: the time goes on)
      self.fake.time = tick
    }
    if measuring {
      each(self, frame)
    } else {
      measuring = mbt_compat::arr_iter(self.fake.logs).any(fn(l) { l == "DRIVE LOG measure" })
      bench_measuring.v = measuring
    }
    n = n + 1
  }
  bench_measuring.v = false
  inst_owners.track = tracked
  text_runs.on = runs
  self.fake.logs.copy()
}

///|
/// Whether a bench builds every frame whole, keeping nothing, from its `log measure` on (Tester::bench_whole): what a
/// frame built anew costs, whatever it is built for.
// kept across runs: a bench's, set once as it begins
// moved to 00_init_order.pion: bench_whole

///|
/// Whether a bench is past its script's `log measure` (Tester::bench).
// kept across runs: a bench's, let go as it ends
// moved to 00_init_order.pion: bench_measuring

///|
/// Every frame of the bench from its `log measure` on drawn, and built whole, keeping nothing (no part, no row, no
/// layout of before but what the flex engine keeps): what building the frame anew costs (scripts/appbench.sh's
/// `whole`).
pub fn Tester::bench_whole(self : Tester, on : Bool) -> Unit {
  ignore(self)
  bench_whole.v = on
}

///|
/// Whether each frame a host draws is said on its log (MBUI_PROBE_FRAMES=1; on a phone `adb shell setprop
/// debug.ui.probe_frames 1`, the app started anew): -1 not asked yet.
// kept across runs: asked once of the process
// moved to 00_init_order.pion: perf_frames_on

///|
/// Frame at `t` presented (on_frame): what it did, its work (the window's tree's, `tree`, part of it) and its presenting
/// (ms), what of the window it drew again, the GPU's time of the last done, the rows and parts it built and kept
/// (kept_nodes.pion), why it was built (the last frame built's, frame_watch.pion's built_why: what it read changed and
/// where, a moment come, nothing for one of its looks alone), a PERF line on the log, where asked (perf_frames_on):
/// what the app's scripts/appbench.sh reads of a phone.
fn perf_log(c : Ctx, t : Double, tree : Double, work : Double, present : Double) -> Unit {
  if perf_frames_on.v < 0 {
    { let __mbt_r = perf_frames_on; __mbt_r.v = (if hostapi::env("MBUI_PROBE_FRAMES") == "1" { 1 } else { 0 }) }
  }
  if perf_frames_on.v == 0 {
    return
  }
  let p = frame_perf()
  h_log("PERF t=\{mbt_compat::double_to_string(t)} work=\{mbt_compat::double_to_string(work)} tree=\{mbt_compat::double_to_string(tree)} tree_laid=\{p.tree_laid} build=\{mbt_compat::double_to_string(c.t_build)} layout=\{mbt_compat::double_to_string(c.t_layout)} paint=\{mbt_compat::double_to_string(c.t_paint)} present=\{mbt_compat::double_to_string(present)} gpu=\{mbt_compat::double_to_string(h_gpu_ms())} nodes=\{p.nodes} laid=\{p.laid} insts=\{p.insts} looks=\{if p.looks { 1 } else { 0 }} painted=\{if p.painted { 1 } else { 0 }} share=\{mbt_compat::double_to_string(presented_share.v)} passes=\{p.passes} rows=\{nodes_run.built} kept=\{nodes_run.kept} why=\{mbt_compat::str_escape(built_why.v)}")
}

///|
/// How many bytes the performance record's files hold as the host last said it wrote them (hostcall.pion's on_outside:
/// outside_perf; -1: not said yet): what reads it (perf_size) follows a write that changed it, none that did not.
// kept across runs: said as the host tells a write, put back as a run begins (reset_globals)
// moved to 00_init_order.pion: perf_bytes_said

///|
/// The host wrote to the performance record: how much it holds now, told what reads it (perf_size).
fn perf_told() -> Unit {
  perf_bytes_said.set(hostapi::perf_size())
}

///|
/// How many bytes the performance record's files hold (@hostapi.perf_size), as the host last said it wrote them: what
/// reads it follows each write the host tells (outside_perf) that changed it, nothing asked of the host on a clock;
/// read again where the record is turned on or off (what turns it says so).
pub fn perf_size() -> Double {
  perf_bytes_said.get() |> ignore
  hostapi::perf_size()
}
