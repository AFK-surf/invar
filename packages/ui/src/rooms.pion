// Touch/desktop hit-target minimum size (`room:`) and anti-overlap (`apart:`) automated UI gates.
// Enforces minimum hit-target dimensions and pairwise separation across interactive UI controls.

import "view"

/// Hit-target sizing rules: minimum size for touch (`finger`), pointer (`mouse`),
/// and optional width threshold (`large_from`) above which touch devices use `mouse` sizing.
pub struct PressRules {
  pub finger : Double
  pub mouse : Double
  pub large_from : Option[Double]
}

struct PressRulesBox {
  mut rules : PressRules
}

let press_rules_state : PressRulesBox = PressRulesBox::{
  rules: PressRules::{ finger: 44.0, mouse: 36.0, large_from: None },
}

/// Set the active press-target sizing rules.
pub fn set_press_rules(rules : PressRules) -> Unit {
  press_rules_state.rules = rules
}

/// Return the currently active press-target sizing rules.
pub fn press_rules_now() -> PressRules {
  press_rules_state.rules
}

/// Reset press-target sizing rules back to defaults (`finger: 44.0, mouse: 36.0, large_from: None`).
pub fn reset_press_rules() -> Unit {
  press_rules_state.rules = PressRules::{ finger: 44.0, mouse: 36.0, large_from: None }
}

/// Minimum hit-target dimension in points for the given platform and window width.
/// iOS (`1`) and Android (`2`) use `rules.finger` (44pt) unless `width >= large_from`;
/// desktop/web platforms (`0`, `3`, `4`, `5`) or large screens use `rules.mouse` (36pt).
pub fn room_least(platform~ : Int = 0, width~ : Double = 800.0) -> Double {
  let r = press_rules_state.rules
  let is_touch = platform == 1 || platform == 2
  if !is_touch {
    return r.mouse
  }
  match r.large_from {
    Some(from) => if width >= from { r.mouse } else { r.finger }
    None => r.finger
  }
}

struct RoomTarget {
  id : view::NodeId
  vx0 : Double
  vy0 : Double
  vx1 : Double
  vy1 : Double
  layer : Int
  held_idx : Int
  label : String
}

fn rect_within(
  ax0 : Double,
  ay0 : Double,
  ax1 : Double,
  ay1 : Double,
  bx0 : Double,
  by0 : Double,
  bx1 : Double,
  by1 : Double,
) -> Bool {
  ax0 >= bx0 - 0.5 && ay0 >= by0 - 0.5 && ax1 <= bx1 + 0.5 && ay1 <= by1 + 0.5
}

fn room_label(tree : view::Tree, d : view::Drawn) -> String {
  match tree.said_of(d.id) {
    Some(s) => {
      if s.label.length() > 0 {
        return s.label
      }
    }
    None => ()
  }
  if d.words.length() > 0 {
    return d.words
  }
  let sl = tree.said_label(d.id)
  if sl.length() > 0 {
    return sl
  }
  "node#\{d.id.at}"
}

fn clipped_visible_rect(
  held : Array[(view::Drawn, Int, Bool)],
  idx : Int,
  win_w : Double,
  win_h : Double,
) -> (Double, Double, Double, Double) {
  let d = held[idx].0
  let mut x0 = dmax(0.0, d.x)
  let mut y0 = dmax(0.0, d.y)
  let mut x1 = dmin(win_w, d.x + d.w)
  let mut y1 = dmin(win_h, d.y + d.h)
  let mut p = held[idx].1
  while p >= 0 {
    let anc = held[p].0
    if anc.clips || anc.clips_self {
      if anc.clips_way != 1 {
        x0 = dmax(x0, anc.x)
        x1 = dmin(x1, anc.x + anc.w)
      }
      if anc.clips_way != 2 {
        y0 = dmax(y0, anc.y)
        y1 = dmin(y1, anc.y + anc.h)
      }
    }
    p = held[p].1
  }
  (x0, y0, x1, y1)
}

fn target_is_occluded(
  tree : view::Tree,
  held : Array[(view::Drawn, Int, Bool)],
  idx : Int,
  id : view::NodeId,
  part : (Double, Double, Double, Double),
) -> Bool {
  let n = held.length()
  let (px0, py0, px1, py1) = part
  let mut j = idx + 1
  while j < n {
    let dj = held[j].0
    if (dj.glass.is_some() || (dj.alpha >= 1.0 && (dj.ground & 0xFFL) == 0xFFL)) &&
    dj.x <= px0 + 0.5 &&
    dj.y <= py0 + 0.5 &&
    dj.x + dj.w >= px1 - 0.5 &&
    dj.y + dj.h >= py1 - 0.5 &&
    !tree.holds_in_order(id, dj.id) &&
    !tree.holds_in_order(dj.id, id) &&
    tree.covered_under(id, dj.id, part) {
      return true
    }
    j += 1
  }
  false
}

/// Inspect all visible interactive targets in the last frame for expandable hit-room (`room:`) and overlap (`apart:`) faults.
/// Policy: `room:` enforces per-target expandable room `>= least` against window/clip/short-holder bounds (`view::press_room`);
/// adjacent siblings share the gap by nearest-edge midpoint split (`Tree::reached`) and are guarded against visual overlap by `apart:`.
pub fn Tester::room_faults(self : Tester) -> Array[String] {
  let tree = match view_tree() {
    Some(tr) => tr
    None => return []
  }
  let (rw, rh) = tree.room_signal().untracked()
  let win_w = if rw > 0.0 { rw } else { self.fake.width }
  let win_h = if rh > 0.0 { rh } else { self.fake.height }
  let held = tree.drawn_held()
  let n = held.length()
  let held_idx_by_at : Map[Int, Int] = Map::new()
  let mut hi = 0
  while hi < n {
    held_idx_by_at[held[hi].0.id.at] = hi
    hi += 1
  }
  let targets : Array[RoomTarget] = []
  let seen : Map[Int, Bool] = Map::new()
  // 1. Collect targets from `tree.press_boxes()` using real `tree.over_all_of(id)` layer
  let pboxes = tree.press_boxes()
  for pb in pboxes {
    let id = pb.0
    if tree.claims_scroll(id) {
      continue
    }
    let box = pb.1
    let idx = match held_idx_by_at.get(id.at) {
      Some(k) if held[k].0.id == id => k
      _ => -1
    }
    let (vx0, vy0, vx1, vy1) = if idx >= 0 {
      clipped_visible_rect(held, idx, win_w, win_h)
    } else {
      (dmax(0.0, box.0), dmax(0.0, box.1), dmin(win_w, box.2), dmin(win_h, box.3))
    }
    let vw = vx1 - vx0
    let vh = vy1 - vy0
    if vw > 0.5 && vh > 0.5 {
      seen[id.at] = true
      let occluded = if idx >= 0 {
        target_is_occluded(tree, held, idx, id, (vx0, vy0, vx1, vy1))
      } else {
        false
      }
      if !occluded {
        let lbl = if idx >= 0 { room_label(tree, held[idx].0) } else { "node#\{id.at}" }
        targets.push(RoomTarget::{
          id,
          vx0,
          vy0,
          vx1,
          vy1,
          layer: tree.over_all_of(id),
          held_idx: idx,
          label: lbl,
        })
      }
    }
  }
  // 2. Collect partially-visible interactive targets (pressable, draggable, or hold-only)
  let mut i = 0
  while i < n {
    let d = held[i].0
    if !seen.contains(d.id.at) &&
    !tree.claims_scroll(d.id) &&
    d.alpha > 0.01 &&
    d.w > 0.0 &&
    d.h > 0.0 &&
    tree.press_or_drag_of(d.id) {
      let (vx0, vy0, vx1, vy1) = clipped_visible_rect(held, i, win_w, win_h)
      let vw = vx1 - vx0
      let vh = vy1 - vy0
      if vw > 0.5 && vh > 0.5 {
        seen[d.id.at] = true
        if !target_is_occluded(tree, held, i, d.id, (vx0, vy0, vx1, vy1)) {
          targets.push(RoomTarget::{
            id: d.id,
            vx0,
            vy0,
            vx1,
            vy1,
            layer: tree.over_all_of(d.id),
            held_idx: i,
            label: room_label(tree, d),
          })
        }
      }
    }
    i += 1
  }
  let faults : Array[String] = []
  let least = room_least(platform=self.fake.platform_id, width=win_w)
  let nt = targets.length()
  // Rule 1 (`room:`): expandable hit-room via `view::press_room` must meet `least`
  let mut a = 0
  while a < nt {
    let ta = targets[a]
    if !tree.pressed_as_drawn(ta.id) {
      let (bx0, by0, bx1, by1) = tree.input_bounds(ta.id)
      let edge = (
        dmax(0.0, bx0),
        dmax(0.0, by0),
        dmin(win_w, bx1),
        dmin(win_h, by1),
      )
      // Narrow `cut` along interactive ancestors shorter than `least`
      let mut cx0 = edge.0
      let mut cy0 = edge.1
      let mut cx1 = edge.2
      let mut cy1 = edge.3
      if ta.held_idx >= 0 {
        let mut p = held[ta.held_idx].1
        while p >= 0 {
          let anc = held[p].0
          if tree.press_or_drag_of(anc.id) {
            let (ax0, ay0, ax1, ay1) = clipped_visible_rect(held, p, win_w, win_h)
            if ax1 - ax0 < least {
              cx0 = dmax(cx0, ax0)
              cx1 = dmin(cx1, ax1)
            }
            if ay1 - ay0 < least {
              cy0 = dmax(cy0, ay0)
              cy1 = dmin(cy1, ay1)
            }
          }
          p = held[p].1
        }
      }
      let cut = (cx0, cy0, cx1, cy1)
      let (rx0, ry0, rx1, ry1) = view::press_room(ta.vx0, ta.vy0, ta.vx1, ta.vy1, cut, edge, least)
      let rw = rx1 - rx0
      let rh = ry1 - ry0
      if rw < least - 0.5 || rh < least - 0.5 {
        faults.push("room: \{ta.label} (\{rw}x\{rh} < \{least}pt)")
      }
    }
    a += 1
  }
  // Rule 2 (`apart:`): pairwise on drawn visible boxes in the same `over_all_of` layer
  a = 0
  while a < nt {
    let ta = targets[a]
    let mut b = a + 1
    while b < nt {
      let tb = targets[b]
      if ta.layer == tb.layer &&
      !tree.holds_in_order(ta.id, tb.id) &&
      !tree.holds_in_order(tb.id, ta.id) &&
      !rect_within(ta.vx0, ta.vy0, ta.vx1, ta.vy1, tb.vx0, tb.vy0, tb.vx1, tb.vy1) &&
      !rect_within(tb.vx0, tb.vy0, tb.vx1, tb.vy1, ta.vx0, ta.vy0, ta.vx1, ta.vy1) {
        let gx = dmax(tb.vx0 - ta.vx1, ta.vx0 - tb.vx1)
        let gy = dmax(tb.vy0 - ta.vy1, ta.vy0 - tb.vy1)
        let ix0 = dmax(ta.vx0, tb.vx0)
        let iy0 = dmax(ta.vy0, tb.vy0)
        let ix1 = dmin(ta.vx1, tb.vx1)
        let iy1 = dmin(ta.vy1, tb.vy1)
        let ow = ix1 - ix0
        let oh = iy1 - iy0
        if gx < -0.5 && gy < -0.5 && ow * oh > 1.0 {
          let part = (ix0, iy0, ix1, iy1)
          if !tree.covered_under(ta.id, tb.id, part) && !tree.covered_under(tb.id, ta.id, part) {
            faults.push("apart: \{ta.label} overlaps \{tb.label} (\{ow}x\{oh})")
          }
        }
      }
      b += 1
    }
    a += 1
  }
  faults
}

/// Assert that all visible clickable targets pass `room_faults()` (panics with full diagnostics otherwise).
pub fn Tester::assert_rooms(self : Tester, label~ : String = "") -> Unit {
  let faults = self.room_faults()
  if faults.length() > 0 {
    let mut msg = if label.length() > 0 {
      "room_faults failed in \{label} (\{faults.length()} fault(s)):"
    } else {
      "room_faults failed (\{faults.length()} fault(s)):"
    }
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}
