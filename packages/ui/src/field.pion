// Pure-tree text editor Field, EditorResult, FieldEdit, and `field(...)` tree node constructor.
// Backed by `packages/editor` (`EditorState`, `UndoStack`, `SelectionHandleDrag`, `LoupeGeometry`).

import "editor"
import "hostapi"
import "paint"
import "signals"
import "view"

pub let caret_blink_ms : Double = 530.0
pub let caret_blinks_for_ms : Double = 30000.0
pub let caret_blink_android_ms : Double = 500.0

/// Snapshot result of an editor interaction.
pub struct EditorResult {
  pub text : String
  pub submitted : Bool
  pub changed : Bool
  pub focused : Bool
  pub sel_start : Int
  pub sel_end : Int
}

/// Record of a user edit operation (from index, previous text, new text).
pub struct FieldEdit {
  pub from : Int
  pub was : String
  pub now : String
}

/// Retained text field state (owned by the app, bound to one pure-tree `field` node).
/// All reactive signals are forwarded directly from `self.editor` (zero duplicated state).
pub struct Field {
  pub phys_id : Int
  pub editor : editor::EditorState
  pub handle_drag : editor::SelectionHandleDrag
  text_sig : signals::Signal[String]
  caret_sig : signals::Signal[Int]
  anchor_sig : signals::Signal[Int]
  focused_sig : signals::Signal[Bool]
  composing_sig : signals::Signal[String]
  layout_sig : signals::Signal[Int]
  pub handles_sig : signals::Signal[Bool]
  pub loupe_sig : signals::Signal[Option[(Double, Double)]]
  pub mut color : Int64
  pub mut ph_color : Int64
  pub mut caret_color : Int64
  pub mut sel_color : Int64
  pub mut generation : Int
  pub mut tree_node : Option[view::NodeId]
  pub mut parked_flag : Bool
  pub mut on_submitted : Option[(String) -> Unit]
  pub mut on_edited : Option[(String) -> Unit]
  pub mut on_edit : Option[(FieldEdit) -> Unit]
  pub mut on_pasted : Option[(String) -> Unit]
  pub mut enter_sends : Bool
  pub mut command_sends : Bool
  pub mut paste_limit : Int
  pub mut secret : Bool
  pub mut last_font_size : Double
  pub mut last_line_h : Double
  pub mut last_max_w : Double
  pub mut last_win_x : Double
  pub mut last_win_y : Double
}

let focused_field_ref : Ref[Option[Field]] = ref_new(None)

pub fn field_has_focus() -> Bool {
  match focused_field_ref.v {
    Some(f) => f.focused_sig.untracked()
    None => false
  }
}

pub fn focused_field_now() -> Option[Field] {
  focused_field_ref.v
}

pub fn Field::new(text~ : String = "") -> Field {
  let cfg = editor::EditorConfig::default()
  cfg.enter_sends = true
  let ed = editor::EditorState::new(text=text, config=cfg)
  Field::{
    phys_id: next_ui_id(),
    editor: ed,
    handle_drag: editor::SelectionHandleDrag::new(),
    text_sig: ed.text_signal(),
    caret_sig: ed.caret_signal(),
    anchor_sig: ed.anchor_signal(),
    focused_sig: ed.focused_signal(),
    composing_sig: ed.marked_signal(),
    layout_sig: signals::signal(0),
    handles_sig: signals::signal(false),
    loupe_sig: signals::signal_by(None, fn(a : Option[(Double, Double)], b : Option[(Double, Double)]) -> Bool {
      match (a, b) {
        (None, None) => true
        (Some((ax, ay)), Some((bx, by))) => ax == bx && ay == by
        _ => false
      }
    }),
    color: c64(0x1D1D, 0x1FFF),
    ph_color: c64(0x8E8E, 0x93FF),
    caret_color: c64(0x0A84, 0xFFFF),
    sel_color: c64(0x0A84, 0xFF40),
    generation: 0,
    tree_node: None,
    parked_flag: false,
    on_submitted: None,
    on_edited: None,
    on_edit: None,
    on_pasted: None,
    enter_sends: true,
    command_sends: false,
    paste_limit: 0,
    secret: false,
    last_font_size: 15.0,
    last_line_h: 21.0,
    last_max_w: 0.0,
    last_win_x: 0.0,
    last_win_y: 0.0,
  }
}

pub fn Field::set_handles_shown(self : Field, on : Bool) -> Unit {
  self.handles_sig.set(on)
}

pub fn Field::handles_shown(self : Field) -> Bool {
  self.handles_sig.get()
}

pub fn Field::set_loupe_at(self : Field, pt : Option[(Double, Double)]) -> Unit {
  self.loupe_sig.set(pt)
}

pub fn Field::loupe_at(self : Field) -> Option[(Double, Double)] {
  self.loupe_sig.get()
}

fn Field::sync_config(self : Field) -> Unit {
  self.editor.config.enter_sends = self.enter_sends
  self.editor.config.command_sends = self.command_sends
  self.editor.config.paste_limit = self.paste_limit
  self.editor.config.secret = self.secret
}

pub fn Field::text(self : Field) -> String {
  self.text_sig.get()
}

pub fn Field::selection(self : Field) -> (Int, Int) {
  let a = self.anchor_sig.get()
  let c = self.caret_sig.get()
  if a <= c { (a, c) } else { (c, a) }
}

pub fn Field::focused(self : Field) -> Bool {
  self.focused_sig.get()
}

pub fn Field::parked(self : Field) -> Bool {
  self.parked_flag
}

pub fn Field::composing(self : Field) -> Bool {
  self.composing_sig.get().length() > 0
}

pub fn Field::composed_said(self : Field) -> String {
  self.composing_sig.get()
}

pub fn Field::colors(self : Field, placeholder~ : Int64, caret~ : Int64) -> Unit {
  self.ph_color = placeholder
  self.caret_color = caret
  self.sel_color = (caret & c64(0xFFFF, 0xFF00)) | 0x40L
}

fn Field::notify_edit(self : Field, from : Int, was : String, now : String) -> Unit {
  match self.on_edited {
    Some(f) => f(now)
    None => ()
  }
  match self.on_edit {
    Some(f) => f(FieldEdit::{ from, was, now })
    None => ()
  }
}

pub fn Field::set(self : Field, text : String, caret? : Int) -> Unit {
  self.sync_config()
  self.editor.set(text, caret?=caret)
}

pub fn Field::follow(self : Field, text : String, generation~ : Int = 0) -> Unit {
  if generation != self.generation || (!self.focused_sig.untracked() && self.text_sig.untracked() != text) {
    self.generation = generation
    self.set(text)
  }
}

pub fn Field::pick(self : Field, from : Int, to : Int) -> Unit {
  self.editor.set_selection(from, to)
}

pub fn Field::take(self : Field) -> String {
  let out = self.text_sig.untracked()
  self.set("")
  out
}

pub fn Field::focus(self : Field) -> Unit {
  match focused_field_ref.v {
    Some(prev) if prev.phys_id != self.phys_id => prev.editor.blur()
    _ => ()
  }
  focused_field_ref.v = Some(self)
  self.editor.focus()
}

pub fn Field::let_go(self : Field) -> Unit {
  self.editor.blur()
  match focused_field_ref.v {
    Some(cur) if cur.phys_id == self.phys_id => focused_field_ref.v = None
    _ => ()
  }
}

/// Insert text at current caret/selection (commits active IME composition as an atomic undo step).
pub fn Field::insert(self : Field, ins : String) -> Unit {
  self.sync_config()
  let was = self.editor.text
  let (lo, _) = self.editor.selection_range()
  let now = work_clock_now()
  if self.editor.is_composing() {
    self.editor.compose_commit(ins, now=now)
  } else {
    if ins.length() == 0 {
      return
    }
    self.editor.insert_text(ins, now=now)
  }
  if self.editor.text != was {
    self.notify_edit(lo, was, self.editor.text)
  }
}

/// Set active IME composition text.
pub fn Field::compose(self : Field, s : String) -> Unit {
  if s.length() == 0 {
    self.editor.compose_cancel()
  } else {
    self.editor.compose_update(s, sel_start=0, sel_end=s.length())
  }
}

/// Delete selection or one grapheme cluster before caret.
pub fn Field::backspace(self : Field) -> Unit {
  self.sync_config()
  let was = self.editor.text
  self.editor.backspace(now=work_clock_now())
  if self.editor.text != was {
    self.notify_edit(self.editor.caret, was, self.editor.text)
  }
}

/// Delete selection or one grapheme cluster after caret.
pub fn Field::delete_forward(self : Field) -> Unit {
  self.sync_config()
  let was = self.editor.text
  self.editor.delete_forward(now=work_clock_now())
  if self.editor.text != was {
    self.notify_edit(self.editor.caret, was, self.editor.text)
  }
}

pub fn Field::copy_selection(self : Field) -> String {
  self.sync_config()
  let sel = self.editor.copy()
  if sel.length() > 0 && !self.secret {
    clipboard_set(sel)
  }
  sel
}

pub fn Field::cut_selection(self : Field) -> String {
  self.sync_config()
  let was = self.editor.text
  let (lo, _) = self.editor.selection_range()
  let sel = self.editor.cut(now=work_clock_now())
  if sel.length() > 0 && !self.secret {
    clipboard_set(sel)
  }
  if self.editor.text != was {
    self.notify_edit(lo, was, self.editor.text)
  }
  sel
}

pub fn Field::paste_text(self : Field, clip : String) -> Unit {
  self.sync_config()
  let was = self.editor.text
  let (lo, _) = self.editor.selection_range()
  if !self.editor.paste(clip, now=work_clock_now()) {
    match self.editor.take_pasted() {
      Some(p) =>
      match self.on_pasted {
        Some(f) => f(p)
        None => ()
      }
      None => ()
    }
    return
  }
  if self.editor.text != was {
    self.notify_edit(lo, was, self.editor.text)
  }
}

pub fn Field::undo(self : Field) -> Bool {
  self.sync_config()
  let was = self.editor.text
  if self.editor.undo(now=work_clock_now()) {
    self.notify_edit(0, was, self.editor.text)
    true
  } else {
    false
  }
}

pub fn Field::redo(self : Field) -> Bool {
  self.sync_config()
  let was = self.editor.text
  if self.editor.redo(now=work_clock_now()) {
    self.notify_edit(0, was, self.editor.text)
    true
  } else {
    false
  }
}

/// Lay out visual lines for `max_w` using real font shaping via `measure_text_width`.
pub fn Field::layout_for(
  self : Field,
  max_w : Double,
  font_size~ : Double = 0.0,
  line_h~ : Double = 0.0,
) -> Array[editor::VisualLine] {
  self.sync_config()
  let sz = if font_size > 0.0 { font_size } else { self.last_font_size }
  let lh = if line_h > 0.0 { line_h } else if self.last_line_h > 0.0 { self.last_line_h } else { sz * 1.4 }
  self.last_font_size = sz
  self.last_line_h = lh
  self.last_max_w = max_w
  let lines = self.editor.layout_lines(max_w, fn(s : String) { measure_text_width(s, sz) }, lh)
  self.layout_sig.set(self.layout_sig.untracked() + 1)
  lines
}

pub fn Field::move_up(self : Field, extend~ : Bool = false) -> Unit {
  self.sync_config()
  self.editor.move_up(extend=extend)
}

pub fn Field::move_down(self : Field, extend~ : Bool = false) -> Unit {
  self.sync_config()
  self.editor.move_down(extend=extend)
}

pub fn Field::select_word_at(self : Field, pos : Int) -> (Int, Int) {
  self.sync_config()
  self.editor.select_word_at(pos)
}

pub fn Field::select_line_at(self : Field, pos : Int) -> (Int, Int) {
  self.sync_config()
  self.editor.select_line_at(pos)
}

pub fn Field::selection_rects(self : Field) -> Array[paint::Rect] {
  self.sync_config()
  self.editor.selection_rects(color=self.sel_color)
}

pub fn Field::caret_pos(self : Field) -> editor::CaretPos {
  self.sync_config()
  self.editor.caret_pos(self.editor.caret)
}

pub fn Field::handles(
  self : Field,
  style~ : editor::HandleStyle = editor::HandleStyle::Android,
) -> Option[(editor::SelectionHandle, editor::SelectionHandle)] {
  self.sync_config()
  editor::selection_handles_of(self.editor, style=style)
}

pub fn Field::loupe(
  self : Field,
  viewport_w : Double,
  viewport_h : Double,
  origin_x~ : Double = 0.0,
  origin_y~ : Double = 0.0,
) -> editor::LoupeGeometry {
  self.sync_config()
  editor::loupe_for_editor(self.editor, viewport_w, viewport_h, origin_x=origin_x, origin_y=origin_y)
}

/// Handle a keyboard event on this field. Returns true if consumed.
pub fn Field::handle_key(self : Field, code : Int, mods : Int) -> Bool {
  self.sync_config()
  let platform = hostapi::keys_platform()
  let is_apple = platform == editor::platform_macos || platform == editor::platform_ios
  let primary = if is_apple { (mods & mod_cmd) != 0 } else { (mods & mod_ctrl) != 0 }
  let shift = (mods & mod_shift_key) != 0
  let alt = (mods & mod_alt) != 0

  if code == key_code_copy || (primary && !alt && !shift && code == key_of_char('c')) {
    let _ = self.copy_selection()
    return true
  }
  if code == key_code_cut || (primary && !alt && !shift && code == key_of_char('x')) {
    let _ = self.cut_selection()
    return true
  }
  if primary && !alt && !shift && code == key_of_char('v') {
    self.paste_text(clipboard_get())
    return true
  }

  let was = self.editor.text
  let handled = self.editor.handle_key(code, mods, platform, now=work_clock_now())
  if !handled {
    return false
  }
  match self.editor.take_submitted() {
    Some(s) =>
    match self.on_submitted {
      Some(f) => {
        f(s)
        return true
      }
      None => return false
    }
    None => ()
  }
  if self.editor.text != was {
    self.notify_edit(self.editor.caret, was, self.editor.text)
  }
  true
}

struct TreeField {
  node_id : view::NodeId
  field : Field
  font_size : () -> Double
  line : Double
  hint : () -> String
}

let tree_fields : Array[TreeField] = []

fn find_tree_field(id : view::NodeId) -> Option[TreeField] {
  for tf in tree_fields {
    if tf.node_id == id {
      return Some(tf)
    }
  }
  None
}

fn remove_tree_field(id : view::NodeId) -> Unit {
  let mut idx = -1
  let mut i = 0
  while i < tree_fields.length() {
    if tree_fields[i].node_id == id {
      idx = i
      break
    }
    i += 1
  }
  if idx >= 0 {
    let tf = tree_fields[idx]
    array_remove_at(tree_fields, idx)
    if tf.field.focused_sig.untracked() {
      tf.field.let_go()
    }
    tf.field.tree_node = None
  }
}

fn fields_reset() -> Unit {
  tree_fields.clear()
  focused_field_ref.v = None
}

/// Pure-tree text input field bound to `fld : Field`.
pub fn field(
  parent : view::View,
  fld : Field,
  placeholder~ : String = "",
  font_size~ : Double = 15.0,
  line~ : Double = 0.0,
  min_lines~ : Int = 1,
  max_lines~ : Int = 5,
  color~ : Int64 = c64(0x1D1D, 0x1FFF),
  placeholder_color~ : Int64 = c64(0x8E8E, 0x93FF),
  caret_color~ : Int64 = c64(0x0A84, 0xFFFF),
  enter_sends? : Bool,
  command_sends~ : Bool = false,
  paste_limit~ : Int = 0,
  secret~ : Bool = false,
  submitted? : (String) -> Unit,
  pasted? : (String) -> Unit,
  edited? : (String) -> Unit,
  edit? : (FieldEdit) -> Unit,
  size_by? : () -> Double,
  placeholder_by? : () -> String,
  label~ : String = "",
) -> view::View {
  let sz_fn = match size_by {
    Some(f) => f
    None => fn() { font_size }
  }
  let hint_fn = match placeholder_by {
    Some(f) => f
    None => fn() { placeholder }
  }
  let is_multi = max_lines != 1
  fld.color = color
  fld.ph_color = placeholder_color
  fld.caret_color = caret_color
  fld.sel_color = (caret_color & c64(0xFFFF, 0xFF00)) | 0x40L
  fld.enter_sends = match enter_sends {
    Some(b) => b
    None => max_lines <= 1
  }
  fld.command_sends = command_sends
  fld.paste_limit = paste_limit
  fld.secret = secret
  fld.editor.config.multiline = is_multi
  fld.editor.config.wrap = is_multi
  fld.sync_config()
  fld.on_submitted = submitted
  fld.on_pasted = pasted
  fld.on_edited = edited
  fld.on_edit = edit

  let init_sz = (sz_fn)()
  let line_h = if line > 0.0 { line } else { init_sz * 1.4 }
  fld.last_font_size = init_sz
  fld.last_line_h = line_h
  let look = view::WordsLook::of(init_sz, line=line_h, wrap=is_multi, max_lines=max_lines)

  parent.box(fn(f : view::View) {
    let id = f.id()
    fld.tree_node = Some(id)
    tree_fields.push(TreeField::{ node_id: id, field: fld, font_size: sz_fn, line, hint: hint_fn })
    let min_h = line_h * (if min_lines > 0 { min_lines } else { 1 }).to_double()
    let _ = f.min_height(view::Live::Is(Some(min_h)))
    let _ = f.focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
    let _ = f.words(
      view::Live::By(fn() {
        let t = fld.text()
        let m = fld.composed_said()
        if t.length() > 0 || m.length() > 0 {
          fld.editor.display_text()
        } else {
          (hint_fn)()
        }
      }),
      ink=fld.color,
      look=look,
    )
    let _ = f.ink(view::Live::By(fn() {
      if fld.text().length() > 0 || fld.composing() { fld.color } else { fld.ph_color }
    }))
    // Pure-tree multi-line selection highlight overlay (one rect per spanned visual line).
    let _ = f.box(fn(sel_layer : view::View) {
      let _ = sel_layer.over(view::Live::Is(true)).presses(view::Live::Is(false))
      sel_layer.each_of(
        fn() {
          let _ = fld.text()
          let _ = fld.selection()
          let _ = fld.composed_said()
          let _ = fld.layout_sig.get()
          let rects = fld.selection_rects()
          let idxs : Array[Int] = []
          for i in 0..<rects.length() {
            idxs.push(i)
          }
          idxs
        },
        fn(row : view::View, idx : Int) {
          let _ = row
          .over_at(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              let rects = fld.selection_rects()
              if idx < rects.length() {
                let r = rects[idx]
                (Some(r.x), Some(r.y), None, None)
              } else {
                (Some(0.0), Some(0.0), None, None)
              }
            }),
          )
          .width(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              let rects = fld.selection_rects()
              if idx < rects.length() { Some(rects[idx].w) } else { Some(0.0) }
            }),
          )
          .height(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              let rects = fld.selection_rects()
              if idx < rects.length() { Some(rects[idx].h) } else { Some(0.0) }
            }),
          )
          .ground(view::Live::Is(fld.sel_color))
          .radius(view::Live::Is(3.0))
          .presses(view::Live::Is(false))
        },
        at_once=true,
      )
    })
    // Refined selection handles (iOS lollipop: 1.5pt stem + 4.5pt-radius knob above start / below end, zero line overlap).
    let _ = f.show(
      fn() {
        let _ = fld.text()
        let _ = fld.selection()
        fld.handles_sig.get() && fld.editor.has_selection()
      },
      fn(h_layer : view::View) {
        let _ = h_layer.over(view::Live::Is(true)).presses(view::Live::Is(false))
        let accent = fld.caret_color
        let kr = 4.5
        let kd = kr * 2.0
        // Start handle: stem + small circle perched above start line.
        let _ = h_layer.box(fn(s_stem : view::View) {
          let _ = s_stem
          .over_at(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((sh, _)) => (Some(sh.tip_x - 0.75), Some(sh.line_top), None, None)
                None => (Some(-100.0), Some(-100.0), None, None)
              }
            }),
          )
          .width(view::Live::Is(Some(1.5)))
          .height(
            view::Live::By(fn() {
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((sh, _)) => Some(sh.line_height)
                None => Some(0.0)
              }
            }),
          )
          .ground(view::Live::Is(accent))
          .radius(view::Live::Is(0.75))
          .presses(view::Live::Is(false))
        })
        let _ = h_layer.box(fn(s_knob : view::View) {
          let _ = s_knob
          .over_at(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((sh, _)) => (Some(sh.tip_x - kr), Some(sh.line_top - kd + 0.5), None, None)
                None => (Some(-100.0), Some(-100.0), None, None)
              }
            }),
          )
          .width(view::Live::Is(Some(kd)))
          .height(view::Live::Is(Some(kd)))
          .ground(view::Live::Is(accent))
          .radius(view::Live::Is(kr))
          .presses(view::Live::Is(false))
        })
        // End handle: stem + small circle perched below end line.
        let _ = h_layer.box(fn(e_stem : view::View) {
          let _ = e_stem
          .over_at(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((_, eh)) => (Some(eh.tip_x - 0.75), Some(eh.line_top), None, None)
                None => (Some(-100.0), Some(-100.0), None, None)
              }
            }),
          )
          .width(view::Live::Is(Some(1.5)))
          .height(
            view::Live::By(fn() {
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((_, eh)) => Some(eh.line_height)
                None => Some(0.0)
              }
            }),
          )
          .ground(view::Live::Is(accent))
          .radius(view::Live::Is(0.75))
          .presses(view::Live::Is(false))
        })
        let _ = h_layer.box(fn(e_knob : view::View) {
          let _ = e_knob
          .over_at(
            view::Live::By(fn() {
              let _ = fld.text()
              let _ = fld.selection()
              let _ = fld.layout_sig.get()
              match fld.handles(style=editor::HandleStyle::IOS) {
                Some((_, eh)) => (Some(eh.tip_x - kr), Some(eh.line_top + eh.line_height - 0.5), None, None)
                None => (Some(-100.0), Some(-100.0), None, None)
              }
            }),
          )
          .width(view::Live::Is(Some(kd)))
          .height(view::Live::Is(Some(kd)))
          .ground(view::Live::Is(accent))
          .radius(view::Live::Is(kr))
          .presses(view::Live::Is(false))
        })
      },
      at_once=true,
    )
    // True optical magnifier loupe using `View::magnifies` (samples exact focus point at 1.4x zoom).
    let _ = f.show(
      fn() {
        match fld.loupe_sig.get() {
          Some(_) => true
          None => false
        }
      },
      fn(loupe_v : view::View) {
        let _ = loupe_v
        .over_at(
          view::Live::By(fn() {
            let _ = fld.layout_sig.get()
            match fld.loupe_sig.get() {
              Some((fx, fy)) => {
                let vw = if f.window_w() > 0.0 { f.window_w() } else { 480.0 }
                let vh = if f.window_h() > 0.0 { f.window_h() } else { 320.0 }
                let lg = editor::compute_loupe(fx, fy, vw, vh)
                (Some(lg.x - fld.last_win_x), Some(lg.y - fld.last_win_y), None, None)
              }
              None => (Some(-200.0), Some(-200.0), None, None)
            }
          }),
        )
        .width(view::Live::Is(Some(editor::loupe_default_width)))
        .height(view::Live::Is(Some(editor::loupe_default_height)))
        .radius(view::Live::Is(editor::loupe_default_height * 0.5))
        .ground(view::Live::Is(c64(0xFFFF, 0xFFFF)))
        .shadow(view::Live::Is((12.0, 4.0, c64(0x0000, 0x0024))))
        .border(c64(0xCBD5, 0xE1EE), 1.0)
        .magnifies(
          view::Live::By(fn() {
            match fld.loupe_sig.get() {
              Some((fx, fy)) => Some((fx, fy, editor::loupe_default_zoom))
              None => None
            }
          }),
        )
        .presses(view::Live::Is(false))
      },
      at_once=true,
    )
    let _ = f.says(
      view::Live::By(fn() {
        let lbl = if label.length() > 0 { label } else { (hint_fn)() }
        Some(view::said(view::Role::TextField, label=lbl, value=fld.text()))
      }),
    )
    let _ = f.on_press(fn() {
      fld.focus()
    })
    let _ = f.owns(fn() {
      remove_tree_field(id)
    })
  })
}
