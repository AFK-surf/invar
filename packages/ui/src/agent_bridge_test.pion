// Unit tests for AgentBridge: redaction & side-channel defense, hidden subtree shielding,
// modal underlying blocking, confirm gate, ambiguity defense, full actions, JSON & Tester helpers.

import "signals"
import "view"

fn ab_assert(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic(msg)
  }
}

test "agent_bridge 01 secret redaction, side-channel protection, and hidden subtree" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = agent_secret(v)
        .says(view::Live::Is(Some(view::said(
          view::Role::TextField,
          label="API Token",
          description="Secret key value",
          value="sk-live-998877",
        ))))
    })
    let _ = root.box(fn(sec : view::View) {
      let _ = agent_hidden(sec)
        .says(view::Live::Is(Some(view::said(view::Role::Region, label="Internal Debug"))))
      let _ = sec.box(fn(btn : view::View) {
        let _ = btn
          .presses(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="Secret Reset"))))
          .on_press(fn() { () })
      })
    })
    let _ = root.box(fn(pub_btn : view::View) {
      let _ = pub_btn
        .presses(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Continue"))))
        .on_press(fn() { () })
    })
  })

  let snap = t.agent_snapshot()
  ab_assert(snap.length() == 2, "hidden subtree excluded, only token + Continue visible")

  let token_matches = t.agent_query(text="API Token")
  ab_assert(token_matches.length() == 1, "secret node findable by non-secret label")
  ab_assert(token_matches[0].redacted, "secret node marked redacted")
  ab_assert(token_matches[0].value == "[redacted]", "secret value redacted")
  ab_assert(token_matches[0].description == "", "secret description redacted")

  // Side-channel defense: probing secret value via agent_query must return 0 matches.
  let probe = t.agent_query(text="998877")
  ab_assert(probe.length() == 0, "redacted value cannot be probed via agent_query")
  let probe_desc = t.agent_query(text="Secret key")
  ab_assert(probe_desc.length() == 0, "redacted description cannot be probed")

  // Hidden subtree nodes are completely unreachable.
  ab_assert(t.agent_query(text="Secret Reset").length() == 0, "hidden child invisible to query")
  let hidden_act = t.agent_act(AgentStep::by_query(AgentAction::Press, text="Secret Reset"))
  ab_assert(agent_act_is_err(hidden_act), "cannot act on hidden child")

  let json = match view_tree() {
    Some(tr) => agent_snapshot_json(tr)
    None => panic("missing tree")
  }
  ab_assert(str_contains(json, "\"value\":\"[redacted]\""), "JSON contains redacted placeholder")
  ab_assert(!str_contains(json, "998877"), "JSON never leaks secret value")
  ab_assert(!str_contains(json, "Secret Reset"), "JSON never leaks hidden subtree")
  t.dispose()
}

test "agent_bridge 02 modal blocking, confirm gate, ambiguity protection, and within scoping" {
  let modal_open = signals::signal(false)
  let deleted = view::ref_new(0)
  let saved_a = view::ref_new(0)
  let saved_b = view::ref_new(0)
  let modal_ok = view::ref_new(0)

  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(sec_a : view::View) {
      let _ = sec_a.says(view::Live::Is(Some(view::said(view::Role::Region, label="Profile Form"))))
      let _ = sec_a.box(fn(b : view::View) {
        let _ = b
          .presses(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="Save"))))
          .on_press(fn() { saved_a.v = saved_a.v + 1 })
      })
    })
    let _ = root.box(fn(sec_b : view::View) {
      let _ = sec_b.says(view::Live::Is(Some(view::said(view::Role::Region, label="Billing Form"))))
      let _ = sec_b.box(fn(b : view::View) {
        let _ = b
          .presses(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="Save"))))
          .on_press(fn() { saved_b.v = saved_b.v + 1 })
      })
    })
    let _ = root.box(fn(del : view::View) {
      let _ = agent_confirm(del, "Permanently delete account")
        .presses(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Delete Account"))))
        .on_press(fn() { deleted.v = deleted.v + 1 })
    })
    root.show(fn() -> Bool { modal_open.get() }, fn(layer : view::View) {
      let _ = layer
        .modal(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Confirm Modal"))))
      let _ = layer.box(fn(ok_btn : view::View) {
        let _ = ok_btn
          .presses(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="Confirm"))))
          .on_press(fn() { modal_ok.v = modal_ok.v + 1 })
      })
    }, at_once=true)
  })

  // Ambiguous "Save" rejected without `within` or `ref_id`.
  match t.agent_act(AgentStep::by_query(AgentAction::Press, text="Save", role=view::Role::Button)) {
    Err(AgentActError::Ambiguous(refs)) => ab_assert(refs.length() == 2, "two Save buttons reported")
    _ => panic("expected Ambiguous error for duplicate Save")
  }
  ab_assert(saved_a.v == 0 && saved_b.v == 0, "ambiguous press did not fire")

  // Scoped with `within="Billing Form"` succeeds unambiguously.
  let r_bill = t.agent_act(AgentStep::by_query(
    AgentAction::Press,
    text="Save",
    role=view::Role::Button,
    within="Billing Form",
  ))
  ab_assert(agent_act_is_ok(r_bill) && saved_b.v == 1 && saved_a.v == 0, "within disambiguates Billing Save")

  // Confirm gate: denied by default, allowed with matching approval.
  match t.agent_act(AgentStep::by_query(AgentAction::Press, text="Delete Account")) {
    Err(AgentActError::NeedsConfirm(reason)) => ab_assert(reason == "Permanently delete account", "confirm reason")
    _ => panic("expected NeedsConfirm")
  }
  ab_assert(deleted.v == 0, "unapproved delete blocked")

  let r_del = t.agent_act(
    AgentStep::by_query(AgentAction::Press, text="Delete Account"),
    allow=AgentApproval::AllowReason("Permanently delete account"),
  )
  ab_assert(agent_act_is_ok(r_del) && deleted.v == 1, "approved delete succeeded")

  // Modal layer blocks all underlying nodes from snapshot & actions.
  modal_open.set(true)
  t.frame(ms=16.0)
  ab_assert(t.agent_query(text="Delete Account").length() == 0, "underlying node blocked by modal")
  ab_assert(agent_act_is_err(t.agent_act(AgentStep::by_query(AgentAction::Press, text="Save", within="Profile Form"))), "modal blocks underlying press")
  let r_modal = t.agent_act(AgentStep::by_query(AgentAction::Press, text="Confirm", role=view::Role::Button))
  ab_assert(agent_act_is_ok(r_modal) && modal_ok.v == 1, "modal button remains actionable")
  t.dispose()
}

test "agent_bridge 03 all actions (Press, Focus, Increment, Decrement, SetValue), Disabled, and agent_act_all" {
  let vol = signals::signal(50)
  let name = signals::signal("Alice")
  let disabled_btn = signals::signal(true)
  let field_focused = view::ref_new(false)
  let btn_clicks = view::ref_new(0)

  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(fld : view::View) {
      let _ = agent_value_writer(fld, fn(s : String) { name.set(s) })
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=0)
        .says(view::Live::By(fn() -> Option[view::Said] {
          Some(view::said(view::Role::TextField, label="Display Name", value=name.get()))
        }))
      fld.reacts(fn() -> Bool { fld.focused() }, fn(f : Bool) { field_focused.v = f })
    })
    let _ = root.box(fn(sl : view::View) {
      let _ = sl
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true))
        .says(view::Live::By(fn() -> Option[view::Said] {
          let cur = vol.get().to_double()
          Some(view::said(
            view::Role::Slider,
            label="Volume",
            value=vol.get().to_string(),
            range=(0.0, cur, 100.0),
            actions=[view::Action::Increment, view::Action::Decrement],
          ))
        }))
        .on_step(fn(by : Int) { vol.set(vol.get() + by * 5) })
    })
    let _ = root.box(fn(b : view::View) {
      let _ = b
        .presses(view::Live::By(fn() -> Bool { !disabled_btn.get() }))
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Submit"))))
        .on_press(fn() { btn_clicks.v = btn_clicks.v + 1 })
    })
  })

  // Empty query must always return Err(NotFound) rather than accidentally hitting a lone control.
  match t.agent_act(AgentStep::by_query(AgentAction::Press)) {
    Err(AgentActError::NotFound(_)) => ()
    _ => panic("expected NotFound for empty query")
  }

  // Disabled button returns Disabled error.
  match t.agent_act(AgentStep::by_query(AgentAction::Press, text="Submit")) {
    Err(AgentActError::Disabled(_)) => ()
    _ => panic("expected Disabled error")
  }
  disabled_btn.set(false)
  t.frame(ms=16.0)

  // UnsupportedAction: SetValue on a button without agent_value_writer.
  match t.agent_act(AgentStep::by_query(AgentAction::SetValue("x"), text="Submit")) {
    Err(AgentActError::UnsupportedAction(_)) => ()
    _ => panic("expected UnsupportedAction for SetValue on button")
  }

  // Batch execution via agent_act_all across Focus, SetValue, Increment, Decrement, Press.
  let tr = match view_tree() {
    Some(x) => x
    None => panic("missing tree")
  }
  let results = agent_act_all(tr, [
    AgentStep::by_query(AgentAction::Focus, text="Display Name"),
    AgentStep::by_query(AgentAction::SetValue("Bob"), text="Display Name"),
    AgentStep::by_query(AgentAction::Increment, text="Volume"),
    AgentStep::by_query(AgentAction::Increment, text="Volume"),
    AgentStep::by_query(AgentAction::Decrement, text="Volume"),
    AgentStep::by_query(AgentAction::Press, text="Submit"),
  ], at=32.0)
  t.frame(ms=16.0)

  ab_assert(results.length() == 6, "all 6 steps ran")
  for r in results {
    ab_assert(agent_act_is_ok(r), "every step succeeded")
  }
  match results[1] {
    Ok(updated) => ab_assert(updated.value == "Bob", "agent_act returns refreshed AgentEntry after SetValue")
    Err(_) => panic("expected Ok with refreshed entry")
  }
  ab_assert(field_focused.v, "Focus action focused Display Name")
  ab_assert(name.get() == "Bob", "SetValue updated Display Name")
  ab_assert(vol.get() == 55, "Increment twice + Decrement once => 55")
  ab_assert(btn_clicks.v == 1, "Press activated Submit")
  t.dispose()
}
