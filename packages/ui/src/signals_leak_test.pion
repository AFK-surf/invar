// Regression tests for zero reactive node/link leaks across Tester mount/draw/dispose
// and dynamic subtree page switching.

import "signals"
import "view"

test "signals leak: empty Tester multi-round mount/draw/dispose returns to baseline" {
  // Warm up one round so any one-time module-level lazy globals are settled
  let warm = Tester::tree(fn(_root : view::View) { () }, width=400.0, height=300.0)
  warm.draw()
  warm.dispose()

  let base_nodes = signals::live_node_count()
  let base_links = signals::live_link_count()
  debug_assert(base_links == 0, "baseline links after empty Tester dispose: \{base_links}")
  debug_assert(base_nodes == 0, "baseline nodes after empty Tester dispose: \{base_nodes}")

  for round in 0..<8 {
    let t = Tester::tree(fn(_root : view::View) { () }, width=400.0, height=300.0)
    t.draw()
    t.dispose()
    let n = signals::live_node_count()
    let l = signals::live_link_count()
    debug_assert(
      l == 0,
      "empty Tester round \{round}: live_link_count=\{l} (expected 0)",
    )
    debug_assert(
      n == base_nodes,
      "empty Tester round \{round}: live_node_count=\{n} != base_nodes=\{base_nodes}",
    )
  }
}

test "signals leak: dynamic subtree page switching and full tree dispose return to baseline" {
  // Warm up
  let warm = Tester::tree(fn(_root : view::View) { () }, width=600.0, height=400.0)
  warm.draw()
  warm.dispose()

  let base_nodes = signals::live_node_count()
  let base_links = signals::live_link_count()
  debug_assert(base_links == 0, "baseline links must be 0, got \{base_links}")

  // Part 1: Repeated dynamic page switching inside a live tree
  let page = signals::signal(0)
  let counter = signals::signal(1)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.fill().box(fn(col : view::View) {
        col.switch_by(
          fn() { page.get() % 2 },
          fn(v : view::View, which : Int) {
            let local_sig = signals::signal(if which == 0 { "Page A" } else { "Page B" })
            let local_comp = signals::computed(fn(_p : Option[String]) -> String {
              "\{local_sig.get()} #\{counter.get()}"
            })
            let _ = v.box(fn(b : view::View) {
              let _ = b.words(view::Live::By(fn() { local_comp.get() }), look=view::words_plain)
            })
          },
        )
      })
    },
    width=600.0,
    height=400.0,
  )
  t.draw()
  // Settle after first toggle
  page.set(1)
  t.draw()
  page.set(2)
  t.draw()
  let settled_nodes = signals::live_node_count()
  let settled_links = signals::live_link_count()

  for i in 3..<23 {
    page.set(i)
    counter.set(i)
    t.draw()
    if i % 2 == 0 {
      let n = signals::live_node_count()
      let l = signals::live_link_count()
      debug_assert(
        n == settled_nodes,
        "page switch round \{i}: live_node_count=\{n} != settled_nodes=\{settled_nodes}",
      )
      debug_assert(
        l == settled_links,
        "page switch round \{i}: live_link_count=\{l} != settled_links=\{settled_links}",
      )
    }
  }
  t.dispose()
  debug_assert(
    signals::live_link_count() == 0,
    "after dynamic tree dispose: live_link_count=\{signals::live_link_count()}",
  )
  debug_assert(
    signals::live_node_count() == base_nodes,
    "after dynamic tree dispose: live_node_count=\{signals::live_node_count()} != base_nodes=\{base_nodes}",
  )

  // Part 2: Multi-round full tree mount + draw + dispose
  for round in 0..<8 {
    let s = signals::signal(round)
    let c = signals::computed(fn(_p : Option[Int]) -> Int { s.get() * 10 })
    let t2 = Tester::tree(
      fn(root : view::View) {
        let _ = root.fill().box(fn(col : view::View) {
          for k in 0..<5 {
            let _ = col.box(fn(b : view::View) {
              let _ = b.words(
                view::Live::By(fn() { "item \{k}: \{c.get()}" }),
                look=view::words_plain,
              )
            })
          }
        })
      },
      width=600.0,
      height=400.0,
    )
    t2.draw()
    s.set(round + 1)
    t2.draw()
    t2.dispose()
    let n = signals::live_node_count()
    let l = signals::live_link_count()
    debug_assert(
      l == 0,
      "full tree dispose round \{round}: live_link_count=\{l} (expected 0)",
    )
    debug_assert(
      n == base_nodes,
      "full tree dispose round \{round}: live_node_count=\{n} != base_nodes=\{base_nodes}",
    )
  }
}
