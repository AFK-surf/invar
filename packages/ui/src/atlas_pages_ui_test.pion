// A screen of glyphs more than one page of the fake host's atlas holds (hostapi's PagedAtlas): drawn whole where the
// host has pages, with glyphs left out where it has one (as before pages).

import "signals"
import "view"

///|
fn cjk_run(n : Int) -> String {
  let mut s = ""
  for i in 0..<n {
    s = s + (0x4E00 + i).unsafe_to_char().to_string()
  }
  s
}

///|
fn glyph_quads(t : Tester) -> (Int, Int) {
  let sc = t.scene()
  let mut n = 0
  let mut past_page = 0
  for i in 0..<sc.ninst {
    let b = i * 60
    let kind = sc.inst[b + 5]
    if (kind - 1.0).abs() < 0.01 || (kind - 3.0).abs() < 0.01 {
      n += 1
      if sc.inst[b + 13] >= 2048.0 {
        past_page += 1
      }
    }
  }
  (n, past_page)
}

///|
/// 100 glyphs 200 px square (100 points at 2 px a point): 64 fill a page of the fake host's 2048.
fn big_glyphs(pages : Int) -> (Tester, signals::Signal[String]) {
  let words = signals::signal("")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b
      .width(view::Live::Is(Some(1600.0)))
      .words(view::Live::By(fn() { words.get() }), look=view::words_plain)
    })
  }, w=1800.0, h=1800.0, scale=2.0)
  t.glyph_box(100.0, 100.0)
  t.atlas_pages_most(pages)
  (t, words)
}

test "atlas pages: a screen of glyphs more than a page holds is drawn whole where the host has pages" {
  let (t, words) = big_glyphs(4)
  words.set(cjk_run(100))
  t.frame()
  t.frame()
  let (n, past) = glyph_quads(t)
  debug_assert(n == 100, "all 100 drawn: \{n}")
  debug_assert(past == 36, "36 on the second page (their v a page down): \{past}")
  let (now, said) = t.atlas_pages()
  debug_assert(now == 2 && said.length() == 1 && said[0] == 2, "the host told 2 pages once: now \{now}, said \{said.length()}")
  t.dispose()
}

test "atlas pages: with one page (a host without pages) the same screen leaves glyphs out, as before" {
  let (t, words) = big_glyphs(1)
  words.set(cjk_run(100))
  t.frame()
  t.frame()
  let (n, past) = glyph_quads(t)
  debug_assert(n < 100 && past == 0, "left out with one page: \{n} drawn")
  let (now, _) = t.atlas_pages()
  debug_assert(now == 1, "one page")
  t.dispose()
}

test "atlas pages: the second page is given back once the screen no longer shows it, and the frame rests" {
  let (t, words) = big_glyphs(4)
  words.set(cjk_run(100))
  t.frame()
  t.frame()
  debug_assert(t.atlas_pages().0 == 2, "two pages")
  words.set(cjk_run(10))
  t.frame()
  let (n, past) = glyph_quads(t)
  debug_assert(n == 10 && past == 0, "10 drawn, from page 0: \{n} \{past}")
  // (a page to give back later asks the host for a wake of its own, not the frame's: the frame is at rest)
  debug_assert(t.at_rest(), "at rest while a page waits to be given back")
  // (the second page's glyphs are no longer shown: given back after atlas_page_idle, frame or no frame)
  for _i in 0..<15 {
    t.frame(ms=1000.0)
  }
  debug_assert(t.atlas_pages().0 == 1, "given back: \{t.atlas_pages().0}")
  let (n2, _) = glyph_quads(t)
  debug_assert(n2 == 10, "still 10 drawn: \{n2}")
  t.dispose()
}
