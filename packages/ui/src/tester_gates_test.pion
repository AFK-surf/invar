// Automated UI quality gate tests:
// 1. Multi-framerate animation determinism (`fps`, `set_fps`, `run_for`, `check_fps_matrix`).
// 2. Touch/desktop hit-target size (`room:`) and anti-overlap (`apart:`) gates (`PressRules`, `room_faults`, `assert_rooms`).

import "signals"
import "view"

test "fps gate: set_fps, fps, and multi-rate transition determinism (60/120/24/7 fps)" {
  let diffs = check_fps_matrix(fn(rate : Double) -> String {
    let shifted = signals::signal(false)
    let start_ms = signals::signal(0.0)
    let dur = 300.0
    let t = Tester::tree(
      fn(root : view::View) {
        let _ = root.box(fn(b : view::View) {
          let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(48.0)))
          let _ = b.moved_by(
            fn(_w : Double, _h : Double, now : Double) {
              if !shifted.get() {
                (0.0, 0.0)
              } else {
                let p = dclamp((now - start_ms.get()) / dur, 0.0, 1.0)
                (120.0 * ease_at(Ease::Move, p), 0.0)
              }
            },
            fn(_w : Double, _h : Double) {
              if shifted.get() { start_ms.get() + dur } else { 0.0 }
            },
          )
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Mover"))))
        })
      },
      w=400.0,
      h=200.0,
    )
    t.set_fps(rate)
    debug_assert((t.fps() - rate).abs() < 1.0e-6, "Tester::fps should match configured rate")
    view::transition(fn() {
      start_ms.set(t.time())
      shifted.set(true)
    })
    t.run_for(450.0)
    debug_assert(t.unasked_faults().length() == 0, "no unasked frame faults during run_for")
    let pos = match t.drawn_by_name("Mover") {
      Some(d) => "\{d.x.round().to_int()},\{d.y.round().to_int()},\{d.w.round().to_int()},\{d.h.round().to_int()}"
      None => "missing"
    }
    debug_assert(pos == "120,0,100,48", "Mover must settle at (120, 0, 100, 48)")
    t.dispose()
    pos
  })
  debug_assert(diffs.length() == 0, "all 4 frame rates (60/120/24/7) must settle identically")

  // Verify set_fps dynamically updates period_ms and fps()
  let t2 = Tester::tree(fn(_root : view::View) { () })
  t2.set_fps(60.0)
  debug_assert((t2.fps() - 60.0).abs() < 1.0e-6, "initial fps is 60")
  t2.set_fps(120.0)
  debug_assert((t2.fps() - 120.0).abs() < 1.0e-6, "set_fps updates to 120")
  t2.set_fps(0.0)
  debug_assert((t2.fps() - 120.0).abs() < 1.0e-6, "non-positive set_fps is ignored")
  t2.dispose()
}

test "rooms gate: open-space 32x32 expands to 36pt with exact 1/4pt hit consistency" {
  let clicks = ref_new(0)
  let btn_id : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.padding(view::Live::Is((100.0, 100.0, 100.0, 100.0)))
      let _ = root.box(fn(b : view::View) {
        btn_id.v = Some(b.id())
        let _ = b.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
        let _ = b.on_press(fn() { clicks.v = clicks.v + 1 })
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Open32"))))
      })
    },
    w=400.0,
    h=300.0,
    platform=0,
  )
  // Open-space 32x32 expands to 36x36 ([98, 134) x [98, 134)) -> 0 faults
  debug_assert(t.room_faults().length() == 0, "open-space 32x32 must pass room_faults on desktop")
  let tr = match view_tree() {
    Some(x) => x
    None => {
      debug_assert(false, "tree must exist")
      return
    }
  }
  let bid = match btn_id.v {
    Some(id) => id
    None => {
      debug_assert(false, "btn_id must be recorded")
      return
    }
  }
  let d = match t.drawn_by_name("Open32") {
    Some(x) => x
    None => {
      debug_assert(false, "Open32 must be drawn")
      return
    }
  }
  let (x0, y0, x1, y1) = (d.x, d.y, d.x + d.w, d.y + d.h)
  let win = (0.0, 0.0, 400.0, 300.0)
  let (rx0, ry0, rx1, ry1) = view::press_room(x0, y0, x1, y1, win, win, 36.0)
  let mx = (x0 + x1) * 0.5
  let my = (y0 + y1) * 0.5
  // Non-tautological 1/4pt inside vs outside static press_room against live Tree::target_at
  debug_assert(tr.target_at(rx0 + 0.25, my) == view::Target::Pressed(bid), "1/4pt inside left edge must hit")
  debug_assert(tr.target_at(rx0 - 0.25, my) == view::Target::Nothing, "1/4pt outside left edge must miss")
  debug_assert(tr.target_at(rx1 - 0.25, my) == view::Target::Pressed(bid), "1/4pt inside right edge must hit")
  debug_assert(tr.target_at(rx1 + 0.25, my) == view::Target::Nothing, "1/4pt outside right edge must miss")
  debug_assert(tr.target_at(mx, ry0 + 0.25) == view::Target::Pressed(bid), "1/4pt inside top edge must hit")
  debug_assert(tr.target_at(mx, ry0 - 0.25) == view::Target::Nothing, "1/4pt outside top edge must miss")
  debug_assert(tr.target_at(mx, ry1 - 0.25) == view::Target::Pressed(bid), "1/4pt inside bottom edge must hit")
  debug_assert(tr.target_at(mx, ry1 + 0.25) == view::Target::Nothing, "1/4pt outside bottom edge must miss")
  // Half-open [x0-2, x1+2): tapping x1 + 1.75 hits, tapping x1 + 2.0 misses
  t.tap(x1 + 1.75, my)
  debug_assert(clicks.v == 1, "tapping x1 + 1.75 must hit expanded 32x32 button")
  t.tap(x1 + 2.0, my)
  debug_assert(clicks.v == 1, "tapping x1 + 2.0 must miss half-open [x0-2, x1+2) box")
  t.dispose()
}

test "rooms gate: 24x24x5 swatch dots at 8pt and 12pt gaps with midpoint split" {
  let check_gap = fn(gap : Double) {
    let hit_idx = ref_new(-1)
    let t = Tester::tree(
      fn(root : view::View) {
        let _ = root.padding(view::Live::Is((40.0, 40.0, 40.0, 40.0)))
        let _ = root.box(fn(row : view::View) {
          let _ = row.as_row().gap(view::Live::Is(gap))
          let mut i = 0
          while i < 5 {
            let idx = i
            let _ = row.box(fn(dot : view::View) {
              let _ = dot.width(view::Live::Is(Some(24.0))).height(view::Live::Is(Some(24.0)))
              let _ = dot.on_press(fn() { hit_idx.v = idx })
              let _ = dot.says(view::Live::Is(Some(view::said(view::Role::Button, label="Dot\{idx}"))))
            })
            i += 1
          }
        })
      },
      w=400.0,
      h=200.0,
      platform=0,
    )
    let faults = t.room_faults()
    debug_assert(faults.length() == 0, "24x24x5 swatch dots at \{gap}pt gap must have 0 faults")
    if gap == 8.0 {
      // Dot0 is [40, 64], Dot1 is [72, 96], midpoint is 68.0 (or relative 28.0)
      let d0 = match t.drawn_by_name("Dot0") {
        Some(x) => x
        None => {
          debug_assert(false, "Dot0 drawn")
          return
        }
      }
      let my = d0.y + 12.0
      let mid = d0.x + 28.0
      t.tap(mid - 0.25, my)
      debug_assert(hit_idx.v == 0, "midpoint - 0.25 must hit dot 0")
      t.tap(mid + 0.25, my)
      debug_assert(hit_idx.v == 1, "midpoint + 0.25 must hit dot 1")
    }
    t.dispose()
  }
  check_gap(8.0)
  check_gap(12.0)
}

test "rooms gate: constrained 32x32 in 32pt pill, 32pt scroll clip, and 40x40 in 40pt pill breakpoints" {
  // 32x32 inside interactive 32pt pill -> cut narrowed to 32pt -> fails desktop (36) and iOS (44)
  let make_pill_32 = fn(root : view::View) {
    let _ = root.padding(view::Live::Is((40.0, 40.0, 40.0, 40.0)))
    let _ = root.box(fn(pill : view::View) {
      let _ = pill.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(32.0)))
      let _ = pill.on_press(fn() { () })
      let _ = pill.says(view::Live::Is(Some(view::said(view::Role::Button, label="Pill32"))))
      let _ = pill.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
        let _ = b.on_press(fn() { () })
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="TinyInPill"))))
      })
    })
  }
  let td = Tester::tree(make_pill_32, w=400.0, h=200.0, platform=0)
  let fd = td.room_faults()
  debug_assert(fd.length() == 1 && str_has_prefix(fd[0], "room:"), "32x32 in 32pt pill must report exact 1 room: fault on desktop")
  td.dispose()

  let ti = Tester::tree(make_pill_32, w=400.0, h=200.0, platform=1)
  let fi = ti.room_faults()
  debug_assert(fi.length() == 1 && str_has_prefix(fi[0], "room:"), "32x32 in 32pt pill must report exact 1 room: fault on iOS")
  ti.dispose()

  // 32x32 inside 32pt scroll clip (clips + bounds_input) -> edge narrowed to 32pt -> fails room:
  let t_clip = Tester::tree(
    fn(root : view::View) {
      let _ = root.padding(view::Live::Is((40.0, 40.0, 40.0, 40.0)))
      let _ = root.box(fn(sc : view::View) {
        let _ = sc.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(32.0)))
        let _ = sc.clips(view::Live::Is(true)).bounds_input(view::Live::Is(true))
        let _ = sc.box(fn(b : view::View) {
          let _ = b.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
          let _ = b.on_press(fn() { () })
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="InScrollClip"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fc = t_clip.room_faults()
  debug_assert(fc.length() == 1 && str_has_prefix(fc[0], "room:"), "32x32 in 32pt scroll clip must report room:")
  t_clip.dispose()

  // 40x40 inside 40pt pill: passes desktop (36), fails narrow iOS (44), passes wide iOS with large_from: Some(768.0)
  let make_pill_40 = fn(root : view::View) {
    let _ = root.padding(view::Live::Is((40.0, 40.0, 40.0, 40.0)))
    let _ = root.box(fn(pill : view::View) {
      let _ = pill.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(40.0)))
      let _ = pill.on_press(fn() { () })
      let _ = pill.says(view::Live::Is(Some(view::said(view::Role::Button, label="Pill40"))))
      let _ = pill.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
        let _ = b.on_press(fn() { () })
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="MedInPill"))))
      })
    })
  }
  let td40 = Tester::tree(make_pill_40, w=800.0, h=600.0, platform=0)
  td40.assert_rooms(label="desktop 40x40 in 40pt pill")
  td40.dispose()

  let ti40 = Tester::tree(make_pill_40, w=390.0, h=844.0, platform=1)
  let fi40 = ti40.room_faults()
  debug_assert(fi40.length() == 1 && str_has_prefix(fi40[0], "room:"), "40x40 in 40pt pill must report exact 1 room: fault on narrow iOS")
  ti40.dispose()

  // Plain clips(true) WITHOUT bounds_input does NOT narrow hit-target expansion (matches Tree::target_at 1/4pt)
  let clip_btn_id : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let t_plain_clip = Tester::tree(
    fn(root : view::View) {
      let _ = root.padding(view::Live::Is((60.0, 60.0, 60.0, 60.0)))
      let _ = root.box(fn(box : view::View) {
        let _ = box.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(32.0)))
        let _ = box.clips(view::Live::Is(true))
        let _ = box.box(fn(b : view::View) {
          clip_btn_id.v = Some(b.id())
          let _ = b.width(view::Live::Is(Some(32.0))).height(view::Live::Is(Some(32.0)))
          let _ = b.on_press(fn() { () })
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="PlainClip32"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  debug_assert(t_plain_clip.room_faults().length() == 0, "plain clips(true) without bounds_input must NOT false-positive room:")
  match (view_tree(), clip_btn_id.v, t_plain_clip.drawn_by_name("PlainClip32")) {
    (Some(tr), Some(bid), Some(d)) => {
      let mx = d.x + d.w * 0.5
      // Expands 2pt above y0 (60 -> 58) and below y1 (92 -> 94)
      debug_assert(tr.target_at(mx, d.y - 1.75) == view::Target::Pressed(bid), "1/4pt inside expanded top under plain clips must hit")
      debug_assert(tr.target_at(mx, d.y - 2.25) == view::Target::Nothing, "1/4pt outside expanded top must miss")
    }
    _ => debug_assert(false, "PlainClip32 must exist")
  }
  t_plain_clip.dispose()

  set_press_rules(PressRules::{ finger: 44.0, mouse: 36.0, large_from: Some(768.0) })
  let tw40 = Tester::tree(make_pill_40, w=800.0, h=600.0, platform=1)
  debug_assert(room_least() == 36.0, "wide iOS uses mouse rule 36pt")
  tw40.assert_rooms(label="wide iOS large_from 40x40 in 40pt pill")
  tw40.dispose()
  debug_assert(press_rules_now().large_from is None, "dispose resets press_rules to defaults")
}

test "rooms gate: clipped 80x40 to 20pt, partial-visible drag-only, transparent over_all, and hold_only" {
  // 1. 80x40 pressable clipped to 20pt visible width -> fails room:
  let t_part = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(clip : view::View) {
        let _ = clip.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(60.0)))
        let _ = clip.clips(view::Live::Is(true)).bounds_input(view::Live::Is(true))
        let _ = clip.box(fn(b : view::View) {
          let _ = b.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(40.0)))
          let _ = b.on_press(fn() { () })
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Clipped80"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fp = t_part.room_faults()
  debug_assert(fp.length() == 1, "80x40 clipped to 20pt visible width must report room fault")
  t_part.dispose()

  // 2. Partial-visible drag-only target -> fails room:
  let t_drag = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(clip : view::View) {
        let _ = clip.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(60.0)))
        let _ = clip.clips(view::Live::Is(true)).bounds_input(view::Live::Is(true))
        let _ = clip.box(fn(b : view::View) {
          let _ = b.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(40.0)))
          let _ = b.on_drag(fn(_d) { () })
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="DragPart"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fdrag = t_drag.room_faults()
  debug_assert(fdrag.length() == 1 && str_has_prefix(fdrag[0], "room:"), "partial-visible drag-only target must report room:")
  t_drag.dispose()

  // 3. Transparent non-modal over_all overlay over a button -> different over_all_of layer -> 0 apart: faults
  let t_ov = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(under : view::View) {
        let _ = under.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(48.0)))
        let _ = under.on_press(fn() { () })
        let _ = under.says(view::Live::Is(Some(view::said(view::Role::Button, label="UnderBtn"))))
      })
      let _ = root.box(fn(tip : view::View) {
        let _ = tip.over_all(view::Live::Is(true)).over(view::Live::Is(true)).offset(view::Live::Is((10.0, 5.0)))
        let _ = tip.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(48.0)))
        let _ = tip.on_press(fn() { () })
        let _ = tip.says(view::Live::Is(Some(view::said(view::Role::Button, label="TipBtn"))))
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  debug_assert(t_ov.room_faults().length() == 0, "transparent non-modal over_all overlay must not false-positive apart:")
  t_ov.dispose()

  // 4. hold_only target: open-space passes + hold_at 1/4pt consistency; constrained fails room:
  let hold_id : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let t_hold = Tester::tree(
    fn(root : view::View) {
      let _ = root.padding(view::Live::Is((60.0, 60.0, 60.0, 60.0)))
      let _ = root.box(fn(h : view::View) {
        hold_id.v = Some(h.id())
        let _ = h.width(view::Live::Is(Some(28.0))).height(view::Live::Is(Some(28.0)))
        let _ = h.gesture(8.0, hold=(300.0, fn(_d) { () }))
        let _ = h.says(view::Live::Is(Some(view::said(view::Role::Button, label="HoldOpen"))))
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  debug_assert(t_hold.room_faults().length() == 0, "open-space hold_only target expands and passes")
  match (view_tree(), hold_id.v, t_hold.drawn_by_name("HoldOpen")) {
    (Some(tr), Some(hid), Some(d)) => {
      let win = (0.0, 0.0, 400.0, 200.0)
      let (rx0, _, rx1, _) = view::press_room(d.x, d.y, d.x + d.w, d.y + d.h, win, win, 36.0)
      let my = d.y + d.h * 0.5
      let hit_l = match tr.hold_at(rx0 + 0.25, my) { Some(x) => x == hid; None => false }
      let hit_r = match tr.hold_at(rx1 - 0.25, my) { Some(x) => x == hid; None => false }
      debug_assert(hit_l, "hold_only 1/4pt inside must hit hold_at")
      debug_assert(tr.hold_at(rx0 - 0.25, my) is None, "hold_only 1/4pt outside must miss hold_at")
      debug_assert(hit_r, "hold_only 1/4pt inside right must hit hold_at")
      debug_assert(tr.hold_at(rx1 + 0.25, my) is None, "hold_only 1/4pt outside right must miss hold_at")
    }
    _ => debug_assert(false, "hold_only node must exist")
  }
  t_hold.dispose()

  let t_hold_c = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(clip : view::View) {
        let _ = clip.width(view::Live::Is(Some(24.0))).height(view::Live::Is(Some(24.0)))
        let _ = clip.clips(view::Live::Is(true)).bounds_input(view::Live::Is(true))
        let _ = clip.box(fn(h : view::View) {
          let _ = h.width(view::Live::Is(Some(24.0))).height(view::Live::Is(Some(24.0)))
          let _ = h.gesture(8.0, hold=(300.0, fn(_d) { () }))
          let _ = h.says(view::Live::Is(Some(view::said(view::Role::Button, label="HoldConstrained"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fhc = t_hold_c.room_faults()
  debug_assert(fhc.length() == 1 && str_has_prefix(fhc[0], "room:"), "constrained hold_only must report room:")
  t_hold_c.dispose()
}

test "rooms gate: two separated 44x44 buttons pass with 0 faults" {
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(r : view::View) {
        let _ = r.as_row().gap(view::Live::Is(12.0))
        let _ = r.box(fn(a : view::View) {
          let _ = a.width(view::Live::Is(Some(44.0))).height(view::Live::Is(Some(44.0)))
          let _ = a.on_press(fn() { () })
          let _ = a.says(view::Live::Is(Some(view::said(view::Role::Button, label="Left"))))
        })
        let _ = r.box(fn(b : view::View) {
          let _ = b.width(view::Live::Is(Some(44.0))).height(view::Live::Is(Some(44.0)))
          let _ = b.on_press(fn() { () })
          let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Right"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=1,
  )
  t.assert_rooms(label="two separated 44x44 buttons")
  t.dispose()
}

test "rooms gate: overlapping buttons report apart:, opaque overlay suppresses false apart:" {
  // Two overlapping buttons without opaque cover -> must report apart:
  let t_over = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(a : view::View) {
        let _ = a.over(view::Live::Is(true)).offset(view::Live::Is((20.0, 20.0)))
        let _ = a.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(48.0)))
        let _ = a.on_press(fn() { () })
        let _ = a.says(view::Live::Is(Some(view::said(view::Role::Button, label="First"))))
      })
      let _ = root.box(fn(b : view::View) {
        let _ = b.over(view::Live::Is(true)).offset(view::Live::Is((50.0, 30.0)))
        let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(48.0)))
        let _ = b.on_press(fn() { () })
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Second"))))
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fo = t_over.room_faults()
  debug_assert(fo.length() >= 1, "overlapping buttons must report room/apart fault")
  t_over.dispose()

  // Underlying button covered by an upper opaque overlay -> must NOT report apart:
  let t_cov = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(under : view::View) {
        let _ = under.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(60.0)))
        let _ = under.on_press(fn() { () })
        let _ = under.says(view::Live::Is(Some(view::said(view::Role::Button, label="Under"))))
      })
      let _ = root.box(fn(sheet : view::View) {
        let _ = sheet.over(view::Live::Is(true))
        let _ = sheet.width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let _ = sheet.ground(view::Live::Is(rgba(255, 255, 255, 255)))
        let _ = sheet.box(fn(top : view::View) {
          let _ = top.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(60.0)))
          let _ = top.on_press(fn() { () })
          let _ = top.says(view::Live::Is(Some(view::said(view::Role::Button, label="Top"))))
        })
      })
    },
    w=400.0,
    h=200.0,
    platform=0,
  )
  let fc = t_cov.room_faults()
  debug_assert(fc.length() == 0, "button under opaque overlay must not falsely report apart:")
  t_cov.dispose()
}

test "rows_steady: single-list and dual-list scrolls_window populate lists_scrolled without loop/OOM" {
  // 1. Single scrolls_window list (registers in Tree.lists_scrolled)
  let s1 = view::Scroll::new()
  let t1 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(box : view::View) {
        let _ = box.width(view::Live::Is(Some(320.0))).height(view::Live::Is(Some(200.0))).scrolls_window(
          s1,
          fn() { [0, 1, 2, 3, 4, 5] },
          fn(row : view::View, k : Int) {
            let _ = row.height(view::Live::Is(Some(44.0))).words(view::Live::Is("Row \{k}"))
          },
          est=44.0,
        )
      })
    },
    w=320.0,
    h=200.0,
  )
  t1.frame(ms=16.0)
  t1.frame(ms=16.0)
  match view_tree() {
    Some(tr) => {
      let seen1 = tr.rows_steady_seen(0.0, 32.0, 16.6667)
      debug_assert(seen1.length() == 1, "single scrolls_window must populate 1 TreeListSteady entry")
    }
    None => debug_assert(false, "single scrolls_window must have an active view tree")
  }
  debug_assert(t1.scroll_faults().length() == 0, "single scrolls_window must have 0 scroll faults")
  t1.dispose()

  // 2. Dual scrolls_window lists (regression for nested `for ai = 0` collision when lists_scrolled.length() >= 2)
  let sa = view::Scroll::new()
  let sb = view::Scroll::new()
  let t2 = Tester::tree(
    fn(root : view::View) {
      let _ = root.as_row().gap(view::Live::Is(8.0))
      let _ = root.box(fn(box : view::View) {
        let _ = box.width(view::Live::Is(Some(220.0))).height(view::Live::Is(Some(200.0))).scrolls_window(
          sa,
          fn() { [0, 1, 2, 3, 4, 5] },
          fn(row : view::View, k : Int) {
            let _ = row.height(view::Live::Is(Some(44.0))).words(view::Live::Is("Left \{k}"))
          },
          est=44.0,
        )
      })
      let _ = root.box(fn(box : view::View) {
        let _ = box.width(view::Live::Is(Some(220.0))).height(view::Live::Is(Some(200.0))).scrolls_window(
          sb,
          fn() { [0, 1, 2, 3, 4, 5] },
          fn(row : view::View, k : Int) {
            let _ = row.height(view::Live::Is(Some(44.0))).words(view::Live::Is("Right \{k}"))
          },
          est=44.0,
        )
      })
    },
    w=480.0,
    h=200.0,
  )
  t2.frame(ms=16.0)
  t2.frame(ms=16.0)
  match view_tree() {
    Some(tr) => {
      let seen2 = tr.rows_steady_seen(0.0, 32.0, 16.6667)
      debug_assert(seen2.length() == 2, "dual scrolls_window must populate 2 TreeListSteady entries without loop/OOM")
    }
    None => debug_assert(false, "dual scrolls_window must have an active view tree")
  }
  debug_assert(t2.scroll_faults().length() == 0, "dual scrolls_window must have 0 scroll faults")
  t2.dispose()
}
