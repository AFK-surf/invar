import "halt"
import "mbt_compat"
import "paint"

// Styles (ui's ui/style.pion): what a box or a line of words looks like, said once as a value and named, built of the
// theme's tokens, not of numbers. A style says token names (`px=S4`, `bg=Card`, `radius=Xl2`); what they come to is
// looked up in the theme in force as the node is built (Ctx::box, Ctx::text), so one style is a constant, right in
// light and dark, wide and narrow. Its states (pressed, hovered, focused, selected, disabled, dark, narrow) are blocks
// in it, picked by the framework from the node's own state; nothing in it moves by itself (no transition): a state
// changed is the other value from the frame that sees it, as an app's own `if c.pressed(id)` was.

///|
/// Spacing, Tailwind's scale (v3.4: a step 4 px; v4's quarter steps where the app's Android app says them: S1_25 5,
/// S4_5 18): padding, gaps, a size. `Exact(v)` a value off the scale, said in an app's token file only (detlint's `style-literal` counts it anywhere else, `style-exact` everywhere).

#derive(Eq)
pub enum Space {
  S0
  SPx
  S0_5
  S1
  S1_25
  S1_5
  S2
  S2_5
  S3
  S3_5
  S4
  S4_5
  S5
  S6
  S7
  S8
  S9
  S10
  S11
  S12
  S14
  S16
  S20
  S24
  S28
  S32
  S36
  S40
  S44
  S48
  S52
  S56
  S60
  S64
  S72
  S80
  S96
  Exact(Double)
}

///|
/// The spacing scale: every named step, in order (what each comes to: Space::px). What measures spacing against the
/// scale (gaps.pion's rule 6) reads it here, so the scale is said once.
pub fn space_scale() -> Array[Space] {
  [Space::S0, Space::SPx, Space::S0_5, Space::S1, Space::S1_25, Space::S1_5, Space::S2, Space::S2_5, Space::S3, Space::S3_5, Space::S4, Space::S4_5, Space::S5, Space::S6, Space::S7, Space::S8, Space::S9, Space::S10, Space::S11, Space::S12, Space::S14, Space::S16, Space::S20, Space::S24, Space::S28, Space::S32, Space::S36, Space::S40, Space::S44, Space::S48, Space::S52, Space::S56, Space::S60, Space::S64, Space::S72, Space::S80, Space::S96]
}

///|
/// What a spacing token comes to, in logical pixels.
pub fn Space::px(self : Space) -> Double {
  match self {
    Space::S0 => 0.0
    Space::SPx => 1.0
    Space::S0_5 => 2.0
    Space::S1 => 4.0
    Space::S1_25 => 5.0
    Space::S1_5 => 6.0
    Space::S2 => 8.0
    Space::S2_5 => 10.0
    Space::S3 => 12.0
    Space::S3_5 => 14.0
    Space::S4 => 16.0
    Space::S4_5 => 18.0
    Space::S5 => 20.0
    Space::S6 => 24.0
    Space::S7 => 28.0
    Space::S8 => 32.0
    Space::S9 => 36.0
    Space::S10 => 40.0
    Space::S11 => 44.0
    Space::S12 => 48.0
    Space::S14 => 56.0
    Space::S16 => 64.0
    Space::S20 => 80.0
    Space::S24 => 96.0
    Space::S28 => 112.0
    Space::S32 => 128.0
    Space::S36 => 144.0
    Space::S40 => 160.0
    Space::S44 => 176.0
    Space::S48 => 192.0
    Space::S52 => 208.0
    Space::S56 => 224.0
    Space::S60 => 240.0
    Space::S64 => 256.0
    Space::S72 => 288.0
    Space::S80 => 320.0
    Space::S96 => 384.0
    Space::Exact(v) => exact_ok(v, "Space")
  }
}

///|
/// What a spacing token comes to as a margin: as `px`, and an `Exact` below 0 too (CSS's margins: one taking back a
/// padding, a list reaching past its column), not NaN.
pub fn Space::margin_px(self : Space) -> Double {
  match self {
    Space::Exact(v) => {
      if v != v {
        halt::saying("style: a margin's Exact is NaN", loc="style_tokens.pion:150:9")
      }
      v
    }
    s => s.px()
  }
}

///|
/// A width or a height: what it holds (`Hug`, the default; `Cut` cut short where its row has less), all of the parent's (`Full`), a share of what is left
/// along the parent's main axis (`Grow(k)`), a share of the parent's room in percent (`Pct(p)`, CSS's 50%; a size only,
/// not a bound), a spacing token, or `Fixed(v)` (a value worked out as the view builds: a list's width; in a token
/// file, a value off the scale); as a least across (`min_w`), `Within(v)`: `v` where the parent has the room, all of it
/// where it has less (CSS's `min(100%, 320px)`).

#derive(Eq)
pub enum Len {
  Hug
  Cut
  Full
  Grow(Double)
  Fixed(Double)
  Pct(Double)
  Within(Double)
  S0
  SPx
  S0_5
  S1
  S1_25
  S1_5
  S2
  S2_5
  S3
  S3_5
  S4
  S4_5
  S5
  S6
  S7
  S8
  S9
  S10
  S11
  S12
  S14
  S16
  S20
  S24
  S28
  S32
  S36
  S40
  S44
  S48
  S52
  S56
  S60
  S64
  S72
  S80
  S96
}

///|
/// As a fault of style_node's says a length (sf's style_wrong): what `derive(Show)` wrote, a number as its text.
pub fn Len::to_string(self : Len) -> String {
  let logger = StringBuilder()
  let __mbt_show_run : () -> Unit = fn() -> Unit {
    match self {
      Len::Hug => logger.write_string("Hug")
      Len::Cut => logger.write_string("Cut")
      Len::Full => logger.write_string("Full")
      Len::Grow(v) => logger.write_string("Grow(\{mbt_compat::double_to_string(v)})")
      Len::Fixed(v) => logger.write_string("Fixed(\{mbt_compat::double_to_string(v)})")
      Len::Pct(v) => logger.write_string("Pct(\{mbt_compat::double_to_string(v)})")
      Len::Within(v) => logger.write_string("Within(\{mbt_compat::double_to_string(v)})")
      Len::S0 => logger.write_string("S0")
      Len::SPx => logger.write_string("SPx")
      Len::S0_5 => logger.write_string("S0_5")
      Len::S1 => logger.write_string("S1")
      Len::S1_25 => logger.write_string("S1_25")
      Len::S1_5 => logger.write_string("S1_5")
      Len::S2 => logger.write_string("S2")
      Len::S2_5 => logger.write_string("S2_5")
      Len::S3 => logger.write_string("S3")
      Len::S3_5 => logger.write_string("S3_5")
      Len::S4 => logger.write_string("S4")
      Len::S4_5 => logger.write_string("S4_5")
      Len::S5 => logger.write_string("S5")
      Len::S6 => logger.write_string("S6")
      Len::S7 => logger.write_string("S7")
      Len::S8 => logger.write_string("S8")
      Len::S9 => logger.write_string("S9")
      Len::S10 => logger.write_string("S10")
      Len::S11 => logger.write_string("S11")
      Len::S12 => logger.write_string("S12")
      Len::S14 => logger.write_string("S14")
      Len::S16 => logger.write_string("S16")
      Len::S20 => logger.write_string("S20")
      Len::S24 => logger.write_string("S24")
      Len::S28 => logger.write_string("S28")
      Len::S32 => logger.write_string("S32")
      Len::S36 => logger.write_string("S36")
      Len::S40 => logger.write_string("S40")
      Len::S44 => logger.write_string("S44")
      Len::S48 => logger.write_string("S48")
      Len::S52 => logger.write_string("S52")
      Len::S56 => logger.write_string("S56")
      Len::S60 => logger.write_string("S60")
      Len::S64 => logger.write_string("S64")
      Len::S72 => logger.write_string("S72")
      Len::S80 => logger.write_string("S80")
      Len::S96 => logger.write_string("S96")
    }
  }
  __mbt_show_run()
  logger.to_string()
}

///|
/// The spacing token a length names, if it names one.
fn Len::space(self : Len) -> Option[Space] {
  match self {
    Len::S0 => Some(Space::S0)
    Len::SPx => Some(Space::SPx)
    Len::S0_5 => Some(Space::S0_5)
    Len::S1 => Some(Space::S1)
    Len::S1_25 => Some(Space::S1_25)
    Len::S1_5 => Some(Space::S1_5)
    Len::S2 => Some(Space::S2)
    Len::S2_5 => Some(Space::S2_5)
    Len::S3 => Some(Space::S3)
    Len::S3_5 => Some(Space::S3_5)
    Len::S4 => Some(Space::S4)
    Len::S4_5 => Some(Space::S4_5)
    Len::S5 => Some(Space::S5)
    Len::S6 => Some(Space::S6)
    Len::S7 => Some(Space::S7)
    Len::S8 => Some(Space::S8)
    Len::S9 => Some(Space::S9)
    Len::S10 => Some(Space::S10)
    Len::S11 => Some(Space::S11)
    Len::S12 => Some(Space::S12)
    Len::S14 => Some(Space::S14)
    Len::S16 => Some(Space::S16)
    Len::S20 => Some(Space::S20)
    Len::S24 => Some(Space::S24)
    Len::S28 => Some(Space::S28)
    Len::S32 => Some(Space::S32)
    Len::S36 => Some(Space::S36)
    Len::S40 => Some(Space::S40)
    Len::S44 => Some(Space::S44)
    Len::S48 => Some(Space::S48)
    Len::S52 => Some(Space::S52)
    Len::S56 => Some(Space::S56)
    Len::S60 => Some(Space::S60)
    Len::S64 => Some(Space::S64)
    Len::S72 => Some(Space::S72)
    Len::S80 => Some(Space::S80)
    Len::S96 => Some(Space::S96)
    _ => Option::None
  }
}

///|
/// How long a length is in points where it says one (Fixed, a spacing token); None where it says how it fits (Hug, Cut,
/// Full, Grow, Pct, Within): a node of the window's tree laid out as a style says (sf's style_node).
pub fn Len::points(self : Len) -> Option[Double] {
  match self {
    Len::Fixed(v) => Some(v)
    l =>
    match l.space() {
      Some(s) => Some(s.px())
      None => Option::None
    }
  }
}

///|
/// A length as a node's size.
fn Len::size(self : Len) -> Size {
  match self {
    Len::Hug => Size::Auto
    Len::Cut => Size::Cut
    Len::Full => Size::Fill(1.0)
    Len::Grow(k) => Size::Fill(k)
    Len::Pct(p) => Size::Pct(exact_ok(p, "Len Pct"))
    Len::Fixed(v) => Size::Px(exact_ok(v, "Len"))
    Len::Within(v) => halt::saying("style: Within(\{mbt_compat::double_to_string(v)}) is a least across (min_w), not a size", loc="style_tokens.pion:334:18")
    l => Size::Px(mbt_compat::opt_unwrap(l.space()).px())
  }
}

///|
/// A length as a bound (min_w, max_w…): `Hug` none (`none_is`), `Full` none as well.
fn Len::bound(self : Len, none_is : Double) -> Double {
  match self {
    Len::Hug | Len::Cut | Len::Full | Len::Grow(_) => none_is
    Len::Pct(p) => halt::saying("style: a bound is not a share (Pct(\{mbt_compat::double_to_string(p)}))", loc="style_tokens.pion:344:15")
    Len::Fixed(v) | Len::Within(v) => exact_ok(v, "Len")
    l => mbt_compat::opt_unwrap(l.space()).px()
  }
}

///|
/// A corner, the theme's scale (Tailwind's names, and Xl1_5 between Xl and Xl2, Xl4 past Xl3), a pill (`Full`: half the shorter side), or `Inner`: the corner of
/// the rounded container it lies in less how far in it lies, so that what lies in a container's corner is concentric
/// with it by how it is written (worked out once laid out: corners.pion's corners_after_layout); `InnerOr(r)` the same
/// where it lies in a rounded container's corner and `r` where it lies in none (the web's innerOr: a capsule standing
/// alone that, in a panel's corner, follows the panel's, which so is the panel's own to choose); `Around` the other way
/// round, the container's own corner from what lies in it.

pub enum Radius {
  Sharp
  Sm
  Base
  Md
  Lg
  Xl
  Xl1_5
  Xl2
  Xl3
  Xl4
  Full
  Inner
  InnerOr(Radius)
  Around
  Exact(Double)
  Corners(Double, Double, Double, Double)
  Linked(paint::CornerOf)
  LinkedEach(paint::CornerOf, paint::CornerOf, paint::CornerOf, paint::CornerOf)
}
pub impl Eq for Radius {
  fn equal(self : Radius, other : Radius) -> Bool {
    match (self, other) {
      (.Sharp, .Sharp) => true
      (.Sm, .Sm) => true
      (.Base, .Base) => true
      (.Md, .Md) => true
      (.Lg, .Lg) => true
      (.Xl, .Xl) => true
      (.Xl1_5, .Xl1_5) => true
      (.Xl2, .Xl2) => true
      (.Xl3, .Xl3) => true
      (.Xl4, .Xl4) => true
      (.Full, .Full) => true
      (.Inner, .Inner) => true
      (.InnerOr(__a0), .InnerOr(__b0)) => (__a0 == __b0)
      (.Around, .Around) => true
      (.Exact(__a0), .Exact(__b0)) => (__a0 == __b0)
      (.Corners(__a0, __a1, __a2, __a3), .Corners(__b0, __b1, __b2, __b3)) => (__a0 == __b0) && (__a1 == __b1) && (__a2 == __b2) && (__a3 == __b3)
      (.Linked(__a0), .Linked(__b0)) => (__a0 == __b0)
      (.LinkedEach(__a0, __a1, __a2, __a3), .LinkedEach(__b0, __b1, __b2, __b3)) => (__a0 == __b0) && (__a1 == __b1) && (__a2 == __b2) && (__a3 == __b3)
      _ => false
    }
  }
}

///|
/// A size of words with its line's height: by what the words are (`Caption` … `Display`: the theme's roles, as a
/// design system's type tokens say them, each its own size on each screen), the theme's scale (Tailwind's names, and
/// Xs2, Xs3 under Xs, as Xl2, Xl3 over Xl; Xl5 … Xl7 past them, a picture's one number), or `Exact(size, line)`.

#derive(Eq)
pub enum TextSize {
  Caption
  Meta
  Ui
  Body
  Title
  Heading
  Display
  Xs3
  Xs2
  Xs
  Sm
  Base
  Lg
  Xl
  Xl2
  Xl3
  Xl4
  Xl5
  Xl6
  Xl7
  Exact(Double, Double)
}

///|
/// A line's height said apart from the words' size (which has one of its own, TextSize): the theme's scale
/// (Tailwind's leading-3 … leading-10 by default: 12, 16 … 40; L4_75, 19), `Font` the font's own, or `Exact(px)`.

#derive(Eq)
pub enum Leading {
  Font
  L3
  L4
  L4_75
  L5
  L6
  L7
  L8
  L9
  L10
  Exact(Double)
}

///|
/// Letter spacing (Tailwind's tracking, in ems of the words' size), or `Exact(px)` in pixels: added to each
/// cluster's advance, half before it and half after (Android's letterSpacing).

#derive(Eq)
pub enum Tracking {
  Tighter
  Tight
  Normal
  Wide
  Wider
  Widest
  Exact(Double)
}

///|
/// The spacing in pixels, for words of `size`.
pub fn Tracking::px(self : Tracking, size : Double) -> Double {
  match self {
    Tracking::Tighter => -0.05 * size
    Tracking::Tight => -0.025 * size
    Tracking::Normal => 0.0
    Tracking::Wide => 0.025 * size
    Tracking::Wider => 0.05 * size
    Tracking::Widest => 0.1 * size
    Tracking::Exact(v) => v
  }
}

///|
/// How heavy words are.

#derive(Eq)
pub enum Weight {
  Normal
  Medium
  Semibold
  Bold
}

///|
pub fn Weight::value(self : Weight) -> Int {
  match self {
    Weight::Normal => 400
    Weight::Medium => 500
    Weight::Semibold => 600
    Weight::Bold => 700
  }
}

///|
/// How much of a colour shows, Tailwind's scale (`O35` is 0.35), or `Exact(a)`.

#derive(Eq)
pub enum Opacity {
  O0
  O5
  O10
  O15
  O20
  O25
  O30
  O35
  O40
  O45
  O50
  O55
  O60
  O65
  O70
  O75
  O80
  O85
  O90
  O95
  O100
  Exact(Double)
}

///|
pub fn Opacity::value(self : Opacity) -> Double {
  match self {
    Opacity::O0 => 0.0
    Opacity::O5 => 0.05
    Opacity::O10 => 0.1
    Opacity::O15 => 0.15
    Opacity::O20 => 0.2
    Opacity::O25 => 0.25
    Opacity::O30 => 0.3
    Opacity::O35 => 0.35
    Opacity::O40 => 0.4
    Opacity::O45 => 0.45
    Opacity::O50 => 0.5
    Opacity::O55 => 0.55
    Opacity::O60 => 0.6
    Opacity::O65 => 0.65
    Opacity::O70 => 0.7
    Opacity::O75 => 0.75
    Opacity::O80 => 0.8
    Opacity::O85 => 0.85
    Opacity::O90 => 0.9
    Opacity::O95 => 0.95
    Opacity::O100 => 1.0
    Opacity::Exact(v) => {
      if !(v >= 0.0 && v <= 1.0) {
        halt::saying("style: Opacity Exact(\{mbt_compat::double_to_string(v)}) is not within 0 … 1", loc="style_tokens.pion:541:9")
      }
      v
    }
  }
}

///|
/// A colour by its role in the theme (Theme's fields), one of them at an opacity (`A(Fg, O5)`), one laid over another
/// (`Over(Card, A(Fg, O5))`), none (`Clear`), or `Exact(rrggbbaa)`.

pub enum Color {
  Clear
  Bg
  Surface
  Raised
  Card
  Fg
  Muted
  Subtle
  Faint
  Line
  Border
  Accent
  AccentText
  AccentBg
  OnAccent
  Primary
  OnPrimary
  Positive
  Danger
  DangerBg
  OnDanger
  Neutral
  Hover
  Selected
  Focus
  Scrim
  Link
  ShadowC
  Warn
  WarnInk
  Tint
  TintStrong
  Floating
  Veil
  VeilDeep
  OnVeil
  Theater
  Lifted
  Wash
  Sidebar
  ListGround
  FieldHover
  A(Color, Opacity)
  Over(Color, Color)
  Exact(Int64)
  Data(Int64)
}
pub impl Eq for Color {
  fn equal(self : Color, other : Color) -> Bool {
    match (self, other) {
      (.Clear, .Clear) => true
      (.Bg, .Bg) => true
      (.Surface, .Surface) => true
      (.Raised, .Raised) => true
      (.Card, .Card) => true
      (.Fg, .Fg) => true
      (.Muted, .Muted) => true
      (.Subtle, .Subtle) => true
      (.Faint, .Faint) => true
      (.Line, .Line) => true
      (.Border, .Border) => true
      (.Accent, .Accent) => true
      (.AccentText, .AccentText) => true
      (.AccentBg, .AccentBg) => true
      (.OnAccent, .OnAccent) => true
      (.Primary, .Primary) => true
      (.OnPrimary, .OnPrimary) => true
      (.Positive, .Positive) => true
      (.Danger, .Danger) => true
      (.DangerBg, .DangerBg) => true
      (.OnDanger, .OnDanger) => true
      (.Neutral, .Neutral) => true
      (.Hover, .Hover) => true
      (.Selected, .Selected) => true
      (.Focus, .Focus) => true
      (.Scrim, .Scrim) => true
      (.Link, .Link) => true
      (.ShadowC, .ShadowC) => true
      (.Warn, .Warn) => true
      (.WarnInk, .WarnInk) => true
      (.Tint, .Tint) => true
      (.TintStrong, .TintStrong) => true
      (.Floating, .Floating) => true
      (.Veil, .Veil) => true
      (.VeilDeep, .VeilDeep) => true
      (.OnVeil, .OnVeil) => true
      (.Theater, .Theater) => true
      (.Lifted, .Lifted) => true
      (.Wash, .Wash) => true
      (.Sidebar, .Sidebar) => true
      (.ListGround, .ListGround) => true
      (.FieldHover, .FieldHover) => true
      (.A(__a0, __a1), .A(__b0, __b1)) => (__a0 == __b0) && (__a1 == __b1)
      (.Over(__a0, __a1), .Over(__b0, __b1)) => (__a0 == __b0) && (__a1 == __b1)
      (.Exact(__a0), .Exact(__b0)) => (__a0 == __b0)
      (.Data(__a0), .Data(__b0)) => (__a0 == __b0)
      _ => false
    }
  }
}

///|
/// An edge's width (Tailwind's border widths, and a hairline: B0_5; B1_5 a ring a little firmer than a line, as a dot
/// looked at is drawn round).

#derive(Eq)
pub enum Stroke {
  B0
  B0_5
  B1
  B1_5
  B2
  B4
  B8
}

///|
/// How wide a border of this stroke is, in points (an old view's box's, and the library's style_node's for an edge).
pub fn Stroke::px(self : Stroke) -> Double {
  match self {
    Stroke::B0 => 0.0
    Stroke::B0_5 => 0.5
    Stroke::B1 => 1.0
    Stroke::B1_5 => 1.5
    Stroke::B2 => 2.0
    Stroke::B4 => 4.0
    Stroke::B8 => 8.0
  }
}

///|
/// A shadow (Tailwind's, its first layer: ui draws one), in the theme's shadow colour.

#derive(Eq)
pub enum Shadow {
  NoShadow
  Sm
  Base
  Md
  Lg
  Xl
  Cast(Double, Double, Int64)
}

///|
/// A shadow's blur (its sigma, as CALayer's shadowRadius) and how far down it falls.
pub fn Shadow::blur_y(self : Shadow) -> (Double, Double) {
  match self {
    Shadow::NoShadow => (0.0, -1.0)
    Shadow::Sm => (2.0, 1.0)
    Shadow::Base => (3.0, 1.0)
    Shadow::Md => (6.0, 4.0)
    Shadow::Lg => (15.0, 10.0)
    Shadow::Xl => (25.0, 20.0)
    Shadow::Cast(b, y, _) => (b, y)
  }
}

///|
/// An off-scale value's check: a size, a gap, a corner is never below 0 (nor NaN); one that is fails here, naming
/// what it was, rather than drawn as 0.
fn exact_ok(v : Double, what : String) -> Double {
  if !(v >= 0.0) {
    halt::saying("style: \{what} Exact(\{mbt_compat::double_to_string(v)}) is below 0", loc="style_tokens.pion:681:5")
  }
  v
}
