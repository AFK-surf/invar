// Design tokens and layout/paint/semantics primitives for packages/ui.
// Ported from libs/mbui/src/ui/style_tokens.mbt and re-exported core primitives.

import "halt"
import "paint"
import "view"
import "text"

/// Concentric inner corner radius (outer - inset, clamped >= 0).
pub fn concentric(outer : Double, inset : Double) -> Double {
  paint::concentric(outer, inset)
}

/// Concentric outer corner radius (inner + inset).
pub fn concentric_out(inner : Double, inset : Double) -> Double {
  paint::concentric_out(inner, inset)
}

/// Capsule inset inside a corner of radius `corner` for a control of height `height`.
pub fn capsule_in(corner : Double, height : Double, room~ : Double = 1.0e30) -> Double {
  paint::capsule_in(corner, height, room=room)
}

/// Re-exported Live property wrapper mirroring view::Live.
pub enum Live[T] {
  Is(T)
  By(() -> T)
}

pub fn Live::to_view[T](self : Live[T]) -> view::Live[T] {
  match self {
    Live::Is(v) => view::Live::Is(v)
    Live::By(f) => view::Live::By(f)
  }
}

/// Layout direction.
#derive(Eq)
pub enum Dir {
  Row
  Col
  RowRev
  ColRev
}

/// Text/row reading direction.
#derive(Eq)
pub enum Direction {
  Ltr
  Rtl
}

/// Orientation of a control or scroll axis.
#derive(Eq)
pub enum Orientation {
  Horizontal
  Vertical
}

/// Cross-axis alignment.
/// Downstream `style_node` maps `Align::FirstLine` to `View::lines_up_first_line(Is(true))`.
#derive(Eq)
pub enum Align {
  Start
  Center
  End
  Stretch
  Baseline
  FirstLine
}

/// Main-axis justification.
#derive(Eq)
pub enum Justify {
  Start
  Center
  End
  Between
  Around
  Evenly
}

/// Side of a box or popover anchor.
#derive(Eq)
pub enum Side {
  Top
  Bottom
  Left
  Right
}

/// Alignment along a side.
#derive(Eq)
pub enum Along {
  Start
  Center
  End
}

/// Low-level node size specification.
#derive(Eq)
pub enum Size {
  Auto
  Cut
  Fill(Double)
  Px(Double)
  Pct(Double)
}

/// Ground fill of a box.
#derive(Eq)
pub enum Ground {
  None
  Solid(Int64)
  Token(Color)
}

/// Fill rule / paint fill descriptor.
#derive(Eq)
pub enum Fill {
  None
  Color(Int64)
  Token(Color)
}

