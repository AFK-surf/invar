  Linked(paint::CornerOf)
  LinkedEach(paint::CornerOf, paint::CornerOf, paint::CornerOf, paint::CornerOf)
}

/// Font size + line height role/scale token.
#derive(Eq)
pub enum TextSize {
  Caption
  Meta
  Ui
  Body
  Title
  Heading
  Display
  Xs3
  Xs2
  Xs
  Sm
  Base
  Lg
  Xl
  Xl2
  Xl3
  Xl4
  Xl5
  Xl6
  Xl7
