}

/// Line height token.
#derive(Eq)
pub enum Leading {
  Font
  L3
  L4
  L4_75
  L5
  L6
  L7
  L8
  L9
  L10
  Exact(Double)
}

/// Letter spacing token.
#derive(Eq)
pub enum Tracking {
  Tighter
  Tight
  Normal
  Wide
  Wider
  Widest
  Exact(Double)
}

pub fn Tracking::px(self : Tracking, size : Double) -> Double {
  match self {
    Tracking::Tighter => -0.05 * size
    Tracking::Tight => -0.025 * size
    Tracking::Normal => 0.0
    Tracking::Wide => 0.025 * size
    Tracking::Wider => 0.05 * size
    Tracking::Widest => 0.1 * size
    Tracking::Exact(v) => v
  }
}

/// Font weight token.
#derive(Eq)
pub enum Weight {
  Normal
  Medium
  Semibold
  Bold
}

pub fn Weight::value(self : Weight) -> Int {
  match self {
    Weight::Normal => 400
    Weight::Medium => 500
    Weight::Semibold => 600
    Weight::Bold => 700
  }
}

/// Opacity token.
#derive(Eq)
pub enum Opacity {
  O0
  O5
  O10
  O15
  O20
  O25
  O30
  O35
  O40
  O45
  O50
  O55
  O60
  O65
  O70
  O75
  O80
  O85
  O90
  O95
  O100
  Exact(Double)
}

pub fn opacity_value(self : Opacity) -> Double {
  match self {
    Opacity::O0 => 0.0
    Opacity::O5 => 0.05
    Opacity::O10 => 0.1
    Opacity::O15 => 0.15
    Opacity::O20 => 0.2
    Opacity::O25 => 0.25
    Opacity::O30 => 0.3
    Opacity::O35 => 0.35
    Opacity::O40 => 0.4
    Opacity::O45 => 0.45
    Opacity::O50 => 0.5
    Opacity::O55 => 0.55
    Opacity::O60 => 0.6
    Opacity::O65 => 0.65
    Opacity::O70 => 0.7
    Opacity::O75 => 0.75
    Opacity::O80 => 0.8
    Opacity::O85 => 0.85
    Opacity::O90 => 0.9
    Opacity::O95 => 0.95
    Opacity::O100 => 1.0
    Opacity::Exact(v) => {
      if !(v >= 0.0 && v <= 1.0) {
        halt::saying("style: Opacity Exact(\{v}) is not within 0 .. 1", loc="ui/tokens.pion")
      }
      v
    }
  }
}

pub fn Opacity::value(self : Opacity) -> Double {
  opacity_value(self)
}

