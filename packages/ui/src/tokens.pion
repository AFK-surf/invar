/// Border width token.
#derive(Eq)
pub enum Stroke {
  B0
  B0_5
  B1
  B1_5
  B2
  B4
  B8
}

pub fn Stroke::px(self : Stroke) -> Double {
  match self {
    Stroke::B0 => 0.0
    Stroke::B0_5 => 0.5
    Stroke::B1 => 1.0
    Stroke::B1_5 => 1.5
    Stroke::B2 => 2.0
    Stroke::B4 => 4.0
    Stroke::B8 => 8.0
  }
}

/// Shadow token.
#derive(Eq)
pub enum Shadow {
  NoShadow
  Sm
  Base
  Md
  Lg
  Xl
  Cast(Double, Double, Int64)
}

pub fn Shadow::blur_y(self : Shadow) -> (Double, Double) {
  match self {
    Shadow::NoShadow => (0.0, -1.0)
    Shadow::Sm => (2.0, 1.0)
    Shadow::Base => (3.0, 1.0)
    Shadow::Md => (6.0, 4.0)
    Shadow::Lg => (15.0, 10.0)
    Shadow::Xl => (25.0, 20.0)
    Shadow::Cast(b, y, _) => (b, y)
  }
}
