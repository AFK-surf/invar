  RadioGroup
  Slider
  ProgressBar
  Tab
  TabList
  TabPanel
  Dialog
  AlertDialog
  Tooltip
  Menu
  MenuBar
  MenuItem
  MenuItemCheckbox
  MenuItemRadio
  Listbox
  Option
  Combobox
  Toolbar
  Separator
  Image
  TextField
  Status
  Region
  Navigation
  Form
  Heading
  ScrollArea
  Table
  Row
  ColumnHeader
  Cell
}

pub fn Role::to_view(self : Role) -> view::Role {
  match self {
    Role::Text => view::Role::Text
    Role::Group => view::Role::Group
    Role::Button => view::Role::Button
    Role::Link => view::Role::Link
    Role::Checkbox => view::Role::Checkbox
    Role::Switch => view::Role::Switch
    Role::Radio => view::Role::Radio
    Role::RadioGroup => view::Role::RadioGroup
    Role::Slider => view::Role::Slider
    Role::ProgressBar => view::Role::ProgressBar
    Role::Tab => view::Role::Tab
    Role::TabList => view::Role::TabList
    Role::TabPanel => view::Role::TabPanel
    Role::Dialog => view::Role::Dialog
    Role::AlertDialog => view::Role::AlertDialog
    Role::Tooltip => view::Role::Tooltip
    Role::Menu => view::Role::Menu
    Role::MenuBar => view::Role::MenuBar
    Role::MenuItem => view::Role::MenuItem
    Role::MenuItemCheckbox => view::Role::MenuItemCheckbox
    Role::MenuItemRadio => view::Role::MenuItemRadio
    Role::Listbox => view::Role::Listbox
    Role::Option => view::Role::Option
    Role::Combobox => view::Role::Combobox
    Role::Toolbar => view::Role::Toolbar
    Role::Separator => view::Role::Separator
    Role::Image => view::Role::Image
    Role::TextField => view::Role::TextField
    Role::Status => view::Role::Status
    Role::Region => view::Role::Region
    Role::Navigation => view::Role::Navigation
    Role::Form => view::Role::Form
    Role::Heading => view::Role::Heading
    Role::ScrollArea => view::Role::ScrollArea
    Role::Table => view::Role::Table
    Role::Row => view::Role::Row
    Role::ColumnHeader => view::Role::ColumnHeader
    Role::Cell => view::Role::Cell
  }
}

pub fn role_name(r : view::Role) -> String {
  let sb = StringBuilder::new()
  view::role_output(r, sb)
  sb.to_string()
}

/// Tri-state checkbox value mirroring view::Check.
#derive(Eq)
pub enum Check {
  Off
  On
  Mixed
}

pub fn Check::to_view(self : Check) -> view::Check {
  match self {
    Check::Off => view::Check::Off
    Check::On => view::Check::On
    Check::Mixed => view::Check::Mixed
  }
}

/// Accessibility action mirroring view::Action.
#derive(Eq)
pub enum Action {
  Activate
  Increment
  Decrement
  Expand
  Collapse
  Dismiss
  Focus
  SetText(String)
}

/// Velocity in logical points per millisecond (2D).
#derive(Eq)
pub struct Velocity {
  pub vx : Double
  pub vy : Double
}

pub fn Velocity::zero() -> Velocity {
  Velocity::{ vx: 0.0, vy: 0.0 }
}

pub fn Velocity::speed(self : Velocity) -> Double {
  (self.vx * self.vx + self.vy * self.vy).sqrt()
}

/// Styled text run descriptor.
pub struct Run {
  pub text : String
  pub color : Int64
  pub bold : Bool
  pub italic : Bool
  pub underline : Bool
  pub strike : Bool
  pub code : Bool
  pub link : String
  pub size : Double
}

pub fn Run::plain(s : String) -> Run {
  Run::{
    text: s,
    color: 0L,
    bold: false,
    italic: false,
    underline: false,
    strike: false,
    code: false,
    link: "",
    size: 0.0,
  }
}

/// Alias-equivalent TextRun for rich text APIs.
pub struct TextRun {
  pub text : String
  pub color : Int64
  pub weight : Int
  pub italic : Bool
  pub underline : Bool
  pub mono : Bool
  pub link : String
}

pub fn TextRun::new(
  s : String,
  color~ : Int64 = 0L,
  weight~ : Int = 400,
  italic~ : Bool = false,
  underline~ : Bool = false,
  mono~ : Bool = false,
  link~ : String = "",
) -> TextRun {
  TextRun::{ text: s, color, weight, italic, underline, mono, link }
}

/// Words container holding plain text or styled runs.
pub struct Words {
  pub text : String
  pub runs : Array[Run]
  pub wrap : Bool
  pub max_lines : Int
}

pub fn Words::of(s : String, wrap~ : Bool = false, max_lines~ : Int = 0) -> Words {
  Words::{ text: s, runs: [], wrap, max_lines }
}

/// Polyline stroke primitive wrapping paint::Line.
pub struct Line {
  pub points : Array[(Double, Double)]
  pub width : Double
  pub color : Int64
}

pub fn Line::to_paint(self : Line) -> paint::Line {
  paint::Line::{ points: self.points, width: self.width, color: self.color }
}

/// Vector shape primitive wrapping paint::Shape.
pub struct Shape {
  pub inner : paint::Shape
}

pub fn Shape::from_paint(s : paint::Shape) -> Shape {
  Shape::{ inner: s }
}

/// Spacing scale (Tailwind v3.4 + quarter steps).
#derive(Eq)
pub enum Space {
  S0
  SPx
  S0_5
  S1
  S1_25
  S1_5
  S2
  S2_5
  S3
  S3_5
  S4
  S4_5
  S5
  S6
  S7
  S8
  S9
  S10
  S11
  S12
  S14
  S16
  S20
  S24
  S28
  S32
  S36
  S40
  S44
  S48
  S52
  S56
  S60
  S64
  S72
  S80
  S96
  Exact(Double)
}

pub fn space_scale() -> Array[Space] {
  [
    Space::S0, Space::SPx, Space::S0_5, Space::S1, Space::S1_25, Space::S1_5,
    Space::S2, Space::S2_5, Space::S3, Space::S3_5, Space::S4, Space::S4_5,
    Space::S5, Space::S6, Space::S7, Space::S8, Space::S9, Space::S10,
    Space::S11, Space::S12, Space::S14, Space::S16, Space::S20, Space::S24,
    Space::S28, Space::S32, Space::S36, Space::S40, Space::S44, Space::S48,
    Space::S52, Space::S56, Space::S60, Space::S64, Space::S72, Space::S80,
    Space::S96,
  ]
}

pub fn space_px(self : Space) -> Double {
  match self {
    Space::S0 => 0.0
    Space::SPx => 1.0
    Space::S0_5 => 2.0
    Space::S1 => 4.0
    Space::S1_25 => 5.0
    Space::S1_5 => 6.0
    Space::S2 => 8.0
    Space::S2_5 => 10.0
    Space::S3 => 12.0
    Space::S3_5 => 14.0
    Space::S4 => 16.0
    Space::S4_5 => 18.0
    Space::S5 => 20.0
    Space::S6 => 24.0
    Space::S7 => 28.0
    Space::S8 => 32.0
    Space::S9 => 36.0
    Space::S10 => 40.0
    Space::S11 => 44.0
    Space::S12 => 48.0
    Space::S14 => 56.0
    Space::S16 => 64.0
    Space::S20 => 80.0
    Space::S24 => 96.0
    Space::S28 => 112.0
    Space::S32 => 128.0
    Space::S36 => 144.0
    Space::S40 => 160.0
    Space::S44 => 176.0
    Space::S48 => 192.0
    Space::S52 => 208.0
    Space::S56 => 224.0
    Space::S60 => 240.0
    Space::S64 => 256.0
    Space::S72 => 288.0
    Space::S80 => 320.0
    Space::S96 => 384.0
    Space::Exact(v) => exact_ok(v, "Space")
  }
}

pub fn Space::px(self : Space) -> Double {
  space_px(self)
}

pub fn Space::margin_px(self : Space) -> Double {
  match self {
    Space::Exact(v) => {
      if v != v {
        halt::saying("style: a margin's Exact is NaN", loc="ui/tokens.pion")
      }
      v
    }
    s => space_px(s)
  }
}

/// Width/height length token.
#derive(Eq)
pub enum Len {
  Hug
  Cut
  Full
  Grow(Double)
  Fixed(Double)
  Pct(Double)
  Within(Double)
  S0
  SPx
  S0_5
  S1
  S1_25
  S1_5
  S2
  S2_5
  S3
  S3_5
  S4
  S4_5
  S5
  S6
  S7
  S8
  S9
  S10
  S11
  S12
  S14
  S16
  S20
  S24
  S28
  S32
  S36
  S40
  S44
  S48
  S52
  S56
  S60
  S64
  S72
  S80
  S96
}

fn len_space(self : Len) -> Option[Space] {
  match self {
    Len::S0 => Some(Space::S0)
    Len::SPx => Some(Space::SPx)
    Len::S0_5 => Some(Space::S0_5)
    Len::S1 => Some(Space::S1)
    Len::S1_25 => Some(Space::S1_25)
    Len::S1_5 => Some(Space::S1_5)
    Len::S2 => Some(Space::S2)
    Len::S2_5 => Some(Space::S2_5)
    Len::S3 => Some(Space::S3)
    Len::S3_5 => Some(Space::S3_5)
    Len::S4 => Some(Space::S4)
    Len::S4_5 => Some(Space::S4_5)
    Len::S5 => Some(Space::S5)
    Len::S6 => Some(Space::S6)
    Len::S7 => Some(Space::S7)
    Len::S8 => Some(Space::S8)
    Len::S9 => Some(Space::S9)
    Len::S10 => Some(Space::S10)
    Len::S11 => Some(Space::S11)
    Len::S12 => Some(Space::S12)
    Len::S14 => Some(Space::S14)
    Len::S16 => Some(Space::S16)
    Len::S20 => Some(Space::S20)
    Len::S24 => Some(Space::S24)
    Len::S28 => Some(Space::S28)
    Len::S32 => Some(Space::S32)
    Len::S36 => Some(Space::S36)
    Len::S40 => Some(Space::S40)
    Len::S44 => Some(Space::S44)
    Len::S48 => Some(Space::S48)
    Len::S52 => Some(Space::S52)
    Len::S56 => Some(Space::S56)
    Len::S60 => Some(Space::S60)
    Len::S64 => Some(Space::S64)
    Len::S72 => Some(Space::S72)
    Len::S80 => Some(Space::S80)
    Len::S96 => Some(Space::S96)
    _ => None
  }
}

pub fn Len::points(self : Len) -> Option[Double] {
  match self {
    Len::Fixed(v) => Some(v)
    _ => match len_space(self) {
      Some(s) => Some(space_px(s))
      None => None
    }
  }
}

