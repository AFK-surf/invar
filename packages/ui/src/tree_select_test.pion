// End-to-end tests for Field edit menu protocol, read-only selectable text, and inline hyperlinks.

import "hostapi"
import "text"
import "view"

test "tree_select 01: Field edit_menu_actions, edit_menu_rect, and perform_edit_action" {
  let fld = Field::new(text="Hello World")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.over_at(view::Live::Is((Some(20.0), Some(40.0), None, None))).width(view::Live::Is(Some(240.0)))
      let _ = field(b, fld, max_lines=2, font_size=15.0, line=22.0, label="Msg")
    })
  })
  fld.focus()
  fld.pick(0, 5) // "Hello"
  t.frame(ms=16.0)

  // Partial selection offers Cut, Copy, Paste, SelectAll
  let actions = fld.edit_menu_actions()
  debug_assert(actions.length() == 4, "partial selection offers Cut/Copy/Paste/SelectAll")
  debug_assert(actions[0] == EditAction::Cut, "first action is Cut")
  debug_assert(actions[1] == EditAction::Copy, "second action is Copy")
  debug_assert(actions[2] == EditAction::Paste, "third action is Paste")
  debug_assert(actions[3] == EditAction::SelectAll, "fourth action is SelectAll")

  // edit_menu_rect anchors at window coordinates of selection
  let mr = fld.edit_menu_rect()
  debug_assert(mr.selected && mr.w > 10.0 && mr.x >= 20.0 && mr.y >= 40.0, "edit_menu_rect matches selection box")

  // Perform Copy -> clipboard updated, menu dismissed, selection collapses
  fld.set_menu_open(true)
  fld.perform_edit_action(EditAction::Copy)
  debug_assert(t.clipboard() == "Hello", "Copy action populated clipboard")
  debug_assert(!fld.menu_open(), "Copy action dismissed menu")

  // Perform SelectAll -> selects entire text, removes SelectAll from available actions
  fld.perform_edit_action(EditAction::SelectAll)
  let (a, b) = fld.selection()
  debug_assert(a == 0 && b == 11, "SelectAll selected entire 11-byte text")
  let full_actions = fld.edit_menu_actions()
  debug_assert(full_actions.length() == 3, "full selection omits SelectAll")

  // Perform Cut + Paste round-trip
  fld.perform_edit_action(EditAction::Cut)
  debug_assert(fld.text() == "" && t.clipboard() == "Hello World", "Cut cleared text and set clipboard")
  fld.perform_edit_action(EditAction::Paste)
  debug_assert(fld.text() == "Hello World", "Paste restored text from clipboard")

  // Secret field hides Cut and Copy even with selection
  fld.st.secret = true
  fld.pick(0, 5)
  let secret_actions = fld.edit_menu_actions()
  debug_assert(!secret_actions.contains(EditAction::Cut) && !secret_actions.contains(EditAction::Copy), "secret hides Cut/Copy")
  t.dispose()
}

test "tree_select 02: SelectableText drag selection, double-tap word, multi-line rects, and Cmd/Ctrl+C" {
  let fld = Field::new(text="Alpha Beta\nGamma Delta")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(260.0)))
      let _ = field(b, fld, max_lines=4, font_size=15.0, line=22.0, label="ReadOnly")
    })
  })
  fld.focus()
  t.frame(ms=16.0)
  // Drag across line 0 ("Beta") down to line 1 ("Gamma")
  let d = match t.drawn_by_name("ReadOnly", role=view::Role::TextField) {
    Some(found) => found
    None => {
      debug_assert(false, "ReadOnly field must be drawn")
      return
    }
  }
  t.drag(d.x + 56.0, d.y + 8.0, d.x + 48.0, d.y + 30.0)
  t.frame(ms=16.0)
  let (sa, sb) = fld.selection()
  debug_assert(sb > sa, "drag created selection")
  debug_assert(sa >= 5 && sa <= 7 && sb >= 14 && sb <= 18, "drag selected across lines")
  // Verify multi-line selection emits >= 2 highlight rects
  let sc = t.scene()
  let mut sel_rects = 0
  let mut i = 0
  while i < sc.ninst {
    let base = i * inst_size
    let kind = (sc.inst[base + 5] + 0.5).to_int()
    if kind == 0 && sc.inst[base + 11] > 0.05 && sc.inst[base + 11] < 0.8 && sc.inst[base + 3] >= 10.0 && sc.inst[base + 2] >= 6.0 {
      sel_rects = sel_rects + 1
    }
    i += 1
  }
  debug_assert(sel_rects >= 2, "cross-line selection produces >= 2 highlight rects")
  // Cmd/Ctrl+C copies selection to clipboard
  fld.pick(6, 16)
  t.frame(ms=16.0)
  t.key(key_of_char('c'), mods=mod_cmd)
  debug_assert(t.clipboard() == "Beta\nGamma", "Cmd+C copied cross-line selection to clipboard")
  // Double-tap selects word "Alpha"
  t.tap(d.x + 15.0, d.y + 8.0)
  t.tap(d.x + 15.0, d.y + 8.0)
  t.frame(ms=16.0)
  let (wa, wb) = fld.selection()
  debug_assert(wa == 0 && wb == 5, "double-tap selected word 'Alpha', got (\{wa}, \{wb})")
  t.key(key_of_char('c'), mods=mod_cmd)
  debug_assert(t.clipboard() == "Alpha", "word selection copy matches 'Alpha'")
  // Collapse selection cleanly
  fld.pick(0, 0)
  let (ea, eb) = fld.selection()
  debug_assert(ea == eb, "selection collapsed cleanly")
  t.dispose()
}

test "tree_select 03: LinkedText inline hyperlink hit-test, hover cursor, and click callback" {
  let runs = [
    text::plain("See "),
    text::link("Invar Docs", "https://invar.dev/docs"),
    text::plain(" and "),
    text::link("API Guide", "https://invar.dev/api"),
    text::plain(" for details."),
  ]
  let opened = ref_new("")
  let rl_ref : signals::Ref[Option[RunsLinks]] = ref_new(None)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(500.0)))
      let _ = b.words_runs(view::Live::Is(runs), look=view::WordsLook::of(15.0, line=22.0))
      let rl = runs_links(b, fn() { runs }, fn(href : String) { opened.v = href })
      rl_ref.v = Some(rl)
    })
  }, w=600.0, h=200.0, platform=0, pointing=Pointing::Mouse)
  t.frame(ms=16.0)
  debug_assert(t.find("Invar Docs").is_some(), "first link text rendered")
  debug_assert(t.find("API Guide").is_some(), "second link text rendered")
  // "See " = 4*9=36px, "Invar Docs" = [36..126], " and " = [126..171], "API Guide" = [171..252]
  let (_, dy) = match t.find("Invar Docs") {
    Some(p) => p
    None => {
      debug_assert(false, "Invar Docs link must be found")
      return
    }
  }
  let pointed_now = fn() -> Int {
    match rl_ref.v {
      Some(rl) => rl.pointed.untracked()
      None => -1
    }
  }
  // Hover on plain prefix -> cursor stays default (Arrow), pointed == -1
  let _ = view_pointer(1, 6.0, dy, 0)
  t.frame(ms=16.0)
  debug_assert(t.cursor() == view::Cursor::Arrow && pointed_now() == -1, "plain text prefix keeps default cursor")
  debug_assert(opened.v == "", "hovering plain text does not fire link callback")
  // Hover over first link ("Invar Docs") -> pointed >= 0
  let _ = view_pointer(1, 65.0, dy, 0)
  t.frame(ms=16.0)
  debug_assert(pointed_now() >= 0 || t.cursor() != view::Cursor::Arrow, "hovering first link activates link hover")
  // Click first link -> callback receives https://invar.dev/docs
  t.tap(65.0, dy)
  t.frame(ms=16.0)
  debug_assert(opened.v == "https://invar.dev/docs", "clicking first link delivered first href, got '\{opened.v}'")
  // Hover back over plain prefix -> cursor returns to default
  let _ = view_pointer(1, 6.0, dy, 0)
  t.frame(ms=16.0)
  debug_assert(t.cursor() == view::Cursor::Arrow && pointed_now() == -1, "moving off link clears pointer cursor")
  // Click second link ("API Guide") -> callback receives https://invar.dev/api
  let _ = view_pointer(1, 195.0, dy, 0)
  t.frame(ms=16.0)
  debug_assert(pointed_now() >= 0 || t.cursor() != view::Cursor::Arrow, "hovering second link activates link hover")
  t.tap(195.0, dy)
  t.frame(ms=16.0)
  debug_assert(opened.v == "https://invar.dev/api", "clicking second link delivered second href, got '\{opened.v}'")
  t.dispose()
}
