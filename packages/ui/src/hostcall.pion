// PDFs (native.pion Pdf).

///|
fn h_pdf_open(data : Bytes) -> Int {
  let doc = hostapi::pdf_open(data)
  if text_recording() {
    g().host_rec.pdfs.set(doc, (bytes_name(data), data.length()))
  }
  doc
}

///|
/// A PDF's answers' head: its bytes' name and length, and `more`.
fn pdf_head(named : (String, Int), more : Array[Int]) -> mbt_compat::MbtJson {
  let a : Array[mbt_compat::MbtJson] = [mbt_compat::MbtJson::string(named.0), mbt_compat::MbtJson::number(named.1.to_double())]
  for m in more {
    a.push(mbt_compat::MbtJson::number(m.to_double()))
  }
  mbt_compat::MbtJson::array(a)
}

///|
fn h_pdf_pages(doc : Int) -> Int {
  let n = hostapi::pdf_pages(doc)
  match g().host_rec.pdfs.get(doc) {
    Option::Some(named) if text_recording() => {
      let line : mbt_compat::MbtJson = mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("pn", pdf_head(named, [])), ("r", mbt_compat::MbtJson::number(n.to_double()))]))
      text_say(line.stringify(), line)
    }
    _ => ()
  }
  n
}

///|
fn h_pdf_page_size(doc : Int, page : Int, out : FixedArray[Double]) -> Unit {
  hostapi::pdf_page_size(doc, page, out)
  match g().host_rec.pdfs.get(doc) {
    Option::Some(named) if text_recording() => {
      let line : mbt_compat::MbtJson = mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("ps", pdf_head(named, [page])), ("r", nums(out, 2))]))
      text_say(line.stringify(), line)
    }
    _ => ()
  }
}

///|
fn h_pdf_page_load(doc : Int, page : Int, max_px : Int) -> Int {
  let id = hostapi::pdf_page_load(doc, page, max_px)
  match g().host_rec.pdfs.get(doc) {
    Option::Some(named) if text_recording() => rec_image_asked(id, mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("pi", pdf_head(named, [page, max_px]))])))
    _ => ()
  }
  outside_start(outside_image, id, "image \{id} (PDF \{doc}, page \{page})")
  id
}

///|
fn h_pdf_close(doc : Int) -> Unit {
  hostapi::pdf_close(doc)
}

