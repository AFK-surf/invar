///|
/// The word of `text` around `off` as the host's word boundaries have it, (-1, -1) where it has none.
fn h_word_at(text : String, off : Int) -> (Int, Int) {
  let (s, e) = hostapi::word_at(text, off)
  if text_recording() {
    let head : mbt_compat::MbtJson = mbt_compat::MbtJson::Array([mbt_compat::MbtJson::string(text), mbt_compat::MbtJson::number(off.to_double())])
    let line : mbt_compat::MbtJson = mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("wa", head), ("r", mbt_compat::MbtJson::Array([mbt_compat::MbtJson::number(s.to_double()), mbt_compat::MbtJson::number(e.to_double())]))]))
    text_say("wa|" + head.stringify(), line)
  }
  (s, e)
}

