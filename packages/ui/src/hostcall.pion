      } else {
        bytes_of(kept.stringify())
      }
    }
    _ =>
    if s.contains("=") && !s.contains(" ") && !s.contains("\n") {
      let kept = query_kept("?" + s)
      let kept = mbt_compat::str_unsafe_substring(kept, start=1, end=mbt_compat::utf16_len(kept))
      if kept == s {
