      }, None => break } } }
      mbt_compat::MbtJson::object(out)
    }
    .Array(xs) => mbt_compat::MbtJson::array(mbt_compat::arr_map(xs, json_kept))
    _ => j
  }
}

///|
/// Whether a header's or a query field's name says it carries a credential.
fn secret_name(name : String) -> Bool {
  let n = mbt_compat::str_to_lower(name)
  n == "cookie" ||
  n == "set-cookie" ||
  mbt_compat::arr_iter(["auth", "token", "key", "secret", "session", "password", "sig"]).any(fn(w) { n.contains(w) })
}

///|
/// A path with its query's credential fields' values "-".
fn query_kept(path : String) -> String {
  match mbt_compat::str_find(path, "?") {
    None => path
    Some(q) => {
      let fields = mbt_compat::arr_map(mbt_compat::str_unsafe_substring(path, start=q + 1, end=mbt_compat::utf16_len(path)).split("&"), fn(f) {
        let f = mbt_compat::str_to_owned(f)
        match mbt_compat::str_find(f, "=") {
          Some(i) if secret_name(mbt_compat::str_unsafe_substring(f, start=0, end=i)) => mbt_compat::str_unsafe_substring(f, start=0, end=i) + "=-"
          _ => f
        }
      })
      mbt_compat::str_unsafe_substring(path, start=0, end=q) + "?" + mbt_compat::arr_to_array(fields).join("&")
    }
  }
}

