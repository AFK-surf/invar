import "paint"
import "view"

// Corners linked (ui/paint's corner.pion): what a corner is worked out from where the old views ask it.

///|
/// What linked corners are worked out from as the old views ask them: the window's corner as the system draws it now,
/// the ranges of the theme being built under (Theme::corner_fit; the window's theme between builds).
pub fn corner_roots() -> paint::CornerRoots {
  { window: window_corner(), fit: g().corner_fit, zoom: tree_window_zoom.v.get() }
}

///|
/// The window's corner as the system draws it, for the window's tree's nodes: as the frame began (view_frame), told as
/// it changes (the window maximized, another system's corner), what read it worked out again.
// kept across runs: set as each frame begins
// moved to 00_init_order.pion: tree_window_corner

///|
/// The content zoom of the frame being drawn, followed along with the window's corner.
// kept across runs: set as each frame begins
// moved to 00_init_order.pion: tree_window_zoom

///|
/// A node of the window's tree's corner linked so (View::radius): worked out from the window's roots as they are now
/// (tree_corner_roots_now), again as they change (the window maximized, another system's corner, another theme's
/// ranges).
pub fn corner_of(k : paint::CornerOf) -> view::Live[Double] {
  .By(fn() { paint::CornerOf::radius(k, tree_corner_roots_now()) })
}

///|
/// What linked corners of the window's tree's nodes are worked out from now, followed: the window's corner as the frame
/// began (tree_window_corner), the ranges of the theme its nodes are drawn in (tree_theme: the one the app tells it, as
/// it changes, at once; else the window's): what reads it worked out again as either changes.
pub fn tree_corner_roots_now() -> paint::CornerRoots {
  { window: tree_window_corner.v.get(), fit: tree_theme().corner_fit, zoom: tree_window_zoom.v.get() }
}

///|
/// The theme the window's tree's nodes are drawn in (what the old views are built in for the window's width), as the
/// frame began (view_frame) and as the old views set it building it (view_told_as_built); told as it changes (another
/// width's, the system's dark coming, one the app set), what read it worked out again; one made anew as it was is no
/// change.
// kept across runs: set as each frame begins
// moved to 00_init_order.pion: tree_theme_said

///|
/// The theme a node of the window's tree is drawn in now: the app's, as it tells it (set_tree_theme: what its old
/// views are built in, read as it changes); an app that tells none, the window's as each frame begins (tree_theme_said;
/// before the first frame, the window's).
let tree_theme_paint_cache : mbt_compat::Ref[Option[Theme]] = mbt_compat::ref_new(None)

pub fn tree_theme() -> Theme {
  if paint_phase.v == 1 {
    match tree_theme_paint_cache.v {
      Some(t) => return t
      Option::None => ()
    }
  }
  let res = match tree_theme_of.v.get() {
    Option::Some(f) => f()
    Option::None => match tree_theme_said.v.get() {
      Option::Some(t) => t
      Option::None => g().theme
    }
  }
  if paint_phase.v == 1 {
    tree_theme_paint_cache.v = Some(res)
  }
  res
}

///|
/// The app's theme for its window's tree (set_tree_theme), none told: told to what read the theme by it (another way
/// to it, what it reads followed from then).
// kept across runs: told by the app as its tree is made; let go as a tree is (view_forget)
// moved to 00_init_order.pion: tree_theme_of

///|
/// The theme the window's tree is drawn in, as the app has it (what its old views are built in: Ctx::with_theme's),
/// read where it is drawn so it follows as it changes (a signal read in `f`): told as the tree is made, before its
/// first node is (run_tree's, Tester::tree's and set_view_app's `theme` tell it so).
pub fn set_tree_theme(f : () -> Theme) -> Unit {
  tree_theme_paint_cache.v = None
  tree_theme_of.v.set(Some(f))
}

///|
/// Whether the window has none of the system's title bar (window_inset: its buttons in the app's top row; not full
/// screen nor going there), as the frame began (view_frame); told as it changes, what read it worked out again.
// kept across runs: set as each frame begins
// moved to 00_init_order.pion: tree_inset_said

///|
/// window_inset for a node of the window's tree: as the frame began, followed (tree_inset_said); before the first
/// frame, the window's.
pub fn window_inset_now() -> Bool {
  match tree_inset_said.v.get() {
    Option::Some(on) => on
    Option::None => window_inset()
  }
}

///|
/// window_points_to_content for a node of the window's tree: at the zoom the frame is drawn at, followed
/// (tree_window_zoom).
pub fn window_points_to_content_now(points : Double) -> Double {
  points / tree_window_zoom.v.get()
}

///|
/// window_keys_left for a node of the window's tree (window_inset_now), followed.
pub fn window_keys_left_now() -> Bool {
  window_inset_now() && platform() != 3 && platform() != 5
}

///|
/// window_keys_own for a node of the window's tree (window_inset_now), followed.
pub fn window_keys_own_now() -> Bool {
  window_inset_now() && (platform() == 3 || platform() == 5)
}

///|
/// The corners of nodes of the window's tree that are linked each (tree_corners_linked), by the node: what the corner
/// rule takes of them as of an old view's box said so (Ctx::with_tree_nodes).
// kept across runs: each let go with its node
// moved to 00_init_order.pion: tree_links

///|
/// Node `v` of the window's tree round at each corner as `links` says (Radius::LinkedEach's: a panel's in the window's
/// corners following them, the others the design's), read as it changes: drawn so (View::corners), and the corner rule
/// taking its corners as linked, as an old view's box said so.
pub fn tree_corners_linked(v : view::View, links : () -> Option[FixedArray[paint::CornerOf]]) -> Unit {
  let id = v.id()
  tree_links.put(id, links)
  v.owns(fn() { tree_links.remove(id) }) |> ignore
  v.corners(.By(fn() {
    match links() {
      Some(k) => {
        // (as the tree's linked corners are worked out: its window's corner, its theme's, its zoom, followed)
        let roots = tree_corner_roots_now()
        Some((paint::CornerOf::radius(k[0], roots), paint::CornerOf::radius(k[1], roots), paint::CornerOf::radius(k[2], roots), paint::CornerOf::radius(k[3], roots)),)
      }
      Option::None => Option::None
    }
  }))
  |> ignore
}
