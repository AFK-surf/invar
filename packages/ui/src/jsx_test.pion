// Real Pion-JSX + Leading-Dot `.Enum` regression tests for all 8 packages/ui JSX components:
// Box, Row, Col, Spacer, Text, Show, Scroll, Image.

import "signals"
import "view"

test "jsx: Box, Row, Col, Spacer, Text, Show, Scroll, Image full layout, reactivity, blur, on_press, scroll_faults" {
  let dpi = signals::signal(1600)
  let connected = signals::signal(false)
  let badge_bg = signals::signal(0x22C55EFFL)
  let badge_blur = signals::signal(4.0)
  let extra_shown = signals::signal(true)
  let img_src = signals::signal("mem:jsx_a")
  let clicks = signals::signal(0)
  let sc = view::Scroll::new()
  let header_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let badge_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let extra_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)

  let t = Tester::tree(fn(root : view::View) {
    forget_image("mem:jsx_a")
    forget_image("mem:jsx_b")
    add_image("mem:jsx_a", "jsx-image-a-bytes".to_bytes())
    add_image("mem:jsx_b", "jsx-image-b-bytes".to_bytes())
    <Box in={root} fill>
      <Box
        moves_window
        row
        rigid
        height={56.0}
        along={.Between}
        align={.Middle}
        pad_x={16.0}
        ref_view={fn(v : view::View) { header_ref.v = Some(v.id()) }}
      >
        <Box gap={2.0}>
          <Box
            ref_view={fn(v : view::View) {
              let _ = v.words(
                view::Live::Is("PRO X2 SUPERSTRIKE"),
                look=view::WordsLook::of(17.0, weight=700),
              )
            }}
          />
          <Box
            ref_view={fn(v : view::View) {
              let _ = v.words(
                view::Live::By(fn() { "DPI: \{dpi.get()}" }),
                look=view::WordsLook::of(12.0),
              )
            }}
          />
        </Box>
        <Spacer />
        <Show when=>{connected.get()} at_once>
          <Box
            width={24.0}
            height={24.0}
            radius={12.0}
            bg_by=>{badge_bg.get()}
            blur_by=>{badge_blur.get()}
            cursor={.Hand}
            on_press=>{clicks.set(clicks.untracked() + 1)}
            ref_view={fn(v : view::View) { badge_ref.v = Some(v.id()) }}
          />
        </Show>
        <Box
          width={12.0}
          height={12.0}
          bg={0xFF0000FFL}
          shown_by=>{extra_shown.get()}
          ref_view={fn(v : view::View) { extra_ref.v = Some(v.id()) }}
        />
      </Box>
      <Scroll scroll={sc}>
        <Box gap={8.0} pad={12.0}>
          <Box row gap={8.0} align={.Middle}>
            <Box
              width={64.0}
              height={64.0}
              radius={12.0}
              ref_view={fn(v : view::View) {
                let _ = v.image(view::Live::By(fn() { Some((img_src.get(), "", 0)) }))
                let _ = v.image_covers(view::Live::Is(true))
              }}
            />
            <Spacer width={12.0} />
            <Box width={40.0} height={24.0} bg={0x112233FFL} blur={3.0} />
          </Box>
          <Box height={900.0} bg={0x223344FFL} />
        </Box>
      </Scroll>
    </Box>
  }, w=400.0, h=300.0, scale=1.0)

  debug_assert(t.scroll_faults().length() == 0, "JSX <Scroll> has zero scroll_faults")
  debug_assert(sc.reach() > 500.0, "JSX <Scroll> computes positive scroll reach")

  let tr = match view_tree() {
    Some(tree) => tree
    None => {
      debug_assert(false, "view_tree must be present")
      return
    }
  }
  match header_ref.v {
    Some(id) =>
    match tr.drawn_of(id) {
      Some(d) => {
        debug_assert((d.h - 56.0).abs() < 0.01, "JSX header height == 56")
        debug_assert((d.w - 400.0).abs() < 0.01, "JSX header spans root width")
      }
      None => debug_assert(false, "header should be drawn")
    }
    None => debug_assert(false, "header_ref must be set")
  }
  debug_assert(badge_ref.v.is_none(), "Show hides badge when connected=false")
  match extra_ref.v {
    Some(id) => debug_assert(tr.drawn_of(id).is_some(), "shown_by=true draws extra box")
    None => debug_assert(false, "extra_ref must be set")
  }
  debug_assert(t.find("PRO X2 SUPERSTRIKE").is_some(), "static Text rendered")
  debug_assert(t.find("DPI: 1600").is_some(), "text_by rendered initial DPI: 1600")

  let find_image_tex = fn(scene : Scene) -> Option[Int] {
    let mut i = 0
    while i < scene.ninst {
      let b = i * inst_size
      if (scene.inst[b + 5] - 4.0).abs() < 0.01 {
        return Some(scene.inst[b + 20].round().to_int())
      }
      i += 1
    }
    None
  }
  let tex_a = match find_image_tex(t.scene()) {
    Some(id) => id
    None => {
      debug_assert(false, "JSX <Image> emitted kind=4.0 for mem:jsx_a")
      0
    }
  }
  debug_assert(tex_a > 0, "JSX <Image> bound texture id > 0")

  // Reactive updates: mount Show child, update DPI/bg_by/blur_by/shown_by/src_by
  dpi.set(3200)
  connected.set(true)
  badge_bg.set(0x3B82F6FFL)
  badge_blur.set(8.0)
  extra_shown.set(false)
  img_src.set("mem:jsx_b")
  t.fake.wants = true
  t.draw()

  debug_assert(t.find("DPI: 3200").is_some(), "text_by updated reactively to DPI: 3200")
  match extra_ref.v {
    Some(id) => debug_assert(tr.drawn_of(id).is_none(), "shown_by=false hides extra box")
    None => ()
  }
  match find_image_tex(t.scene()) {
    Some(tex_b) => debug_assert(tex_b > 0 && tex_b != tex_a, "JSX <Image> src_by switches texture id")
    None => debug_assert(false, "JSX <Image> should emit kind=4.0 for mem:jsx_b")
  }
  match badge_ref.v {
    Some(id) =>
    match tr.drawn_of(id) {
      Some(d) => {
        debug_assert((d.w - 24.0).abs() < 0.01 && (d.h - 24.0).abs() < 0.01, "badge 24x24")
        debug_assert((d.radius - 12.0).abs() < 0.01, "badge radius 12")
        debug_assert(d.ground == 0x3B82F6FFL, "badge bg_by updated")
        debug_assert((d.blur - 8.0).abs() < 0.01, "badge blur_by updated to 8.0")
        let cx = d.x + d.w * 0.5
        let cy = d.y + d.h * 0.5
        let _ = tr.press(cx, cy)
        debug_assert(clicks.get() == 1, "on_press fired via JSX handler")
      }
      None => debug_assert(false, "badge should be drawn when connected=true")
    }
    None => debug_assert(false, "badge_ref should be set after Show mounts")
  }

  // Unmount Show child
  connected.set(false)
  t.fake.wants = true
  t.frame(ms=16.0)
  match badge_ref.v {
    Some(id) => debug_assert(tr.drawn_of(id).is_none(), "Show unmounts badge when connected=false")
    None => ()
  }

  forget_image("mem:jsx_a")
  forget_image("mem:jsx_b")
  t.dispose()
}

test "jsx: single-prop into Live[T] ergonomics + backward-compat *_by" {
  let msg = signals::signal("hello")
  let msg_ro : signals::ReadSignal[String] = msg.read()
  let count = signals::signal(1)
  let box_bg = signals::signal(0x112233FFL)
  let box_alpha = signals::signal(0.6)
  let box_blur = signals::signal(2.0)
  let box_shown = signals::signal(true)
  let text_col = signals::signal(0xAABBCCFFL)
  let img_src = signals::signal("mem:into_a")
  let box_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let bare_shown_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)
  let row_ref : signals::Ref[Option[view::NodeId]] = ref_new(None)

  let t = Tester::tree(fn(root : view::View) {
    forget_image("mem:into_a")
    forget_image("mem:into_b")
    add_image("mem:into_a", "into-img-a".to_bytes())
    add_image("mem:into_b", "into-img-b".to_bytes())
    <Col in={root} fill gap={4.0}>
      // 1. literal, Signal, ReadSignal, closure, explicit .Is(...) and legacy text_by
      <Text text="literal-text" />
      <Text text={msg} color={text_col} alpha={box_alpha} />
      <Text text={msg_ro} />
      <Text text=>{"count=\{count.get()}"} />
      <Text text={.Is("raw-live")} />
      <Text text="ignored-by-legacy" text_by=>{"legacy:" + msg.get()} />
      // 2. Box single-prop into + Row forwarding + bare boolean `shown`
      <Box
        width={40.0}
        height={20.0}
        bg={box_bg}
        alpha={box_alpha}
        blur={box_blur}
        shown={box_shown}
        ref_view={fn(v : view::View) { box_ref.v = Some(v.id()) }}
      />
      <Box
        width={16.0}
        height={16.0}
        bg={0x445566FFL}
        shown
        ref_view={fn(v : view::View) { bare_shown_ref.v = Some(v.id()) }}
      />
      <Row
        width={30.0}
        height={12.0}
        bg={box_bg}
        ref_view={fn(v : view::View) { row_ref.v = Some(v.id()) }}
      />
      // 3. Image single-prop into src={Signal}
      <Image src={img_src} width={32.0} height={32.0} />
    </Col>
  }, w=320.0, h=240.0, scale=1.0)

  let tr = match view_tree() {
    Some(tree) => tree
    None => {
      debug_assert(false, "view_tree must be present")
      return
    }
  }

  debug_assert(t.find("literal-text").is_some(), "Text literal")
  debug_assert(t.find("hello").is_some(), "Text Signal/ReadSignal")
  debug_assert(t.find("count=1").is_some(), "Text closure =>")
  debug_assert(t.find("raw-live").is_some(), "Text explicit .Is(...)")
  debug_assert(t.find("legacy:hello").is_some(), "Text legacy text_by precedence")

  match bare_shown_ref.v {
    Some(id) => debug_assert(tr.drawn_of(id).is_some(), "bare bool shown draws box")
    None => debug_assert(false, "bare_shown_ref missing")
  }
  match box_ref.v {
    Some(id) =>
    match tr.drawn_of(id) {
      Some(d) => {
        debug_assert(d.ground == 0x112233FFL, "Box into bg initial")
        debug_assert((d.alpha - 0.6).abs() < 0.01, "Box into alpha initial")
        debug_assert((d.blur - 2.0).abs() < 0.01, "Box into blur initial")
      }
      None => debug_assert(false, "box_ref should be drawn")
    }
    None => debug_assert(false, "box_ref missing")
  }
  match row_ref.v {
    Some(id) =>
    match tr.drawn_of(id) {
      Some(d) => debug_assert(d.ground == 0x112233FFL, "Row forwards Option[Live[Int64]] bg")
      None => debug_assert(false, "row_ref should be drawn")
    }
    None => debug_assert(false, "row_ref missing")
  }

  // Reactive updates
  msg.set("world")
  count.set(7)
  box_bg.set(0x778899FFL)
  box_alpha.set(0.9)
  box_blur.set(5.0)
  box_shown.set(false)
  text_col.set(0x11EE22FFL)
  img_src.set("mem:into_b")
  t.fake.wants = true
  t.frame(ms=16.0)

  debug_assert(t.find("world").is_some(), "Text Signal updated")
  debug_assert(t.find("count=7").is_some(), "Text closure updated")
  debug_assert(t.find("legacy:world").is_some(), "Text legacy text_by updated")
  match box_ref.v {
    Some(id) => debug_assert(tr.drawn_of(id).is_none(), "Box into shown=false hides box")
    None => ()
  }
  match row_ref.v {
    Some(id) =>
    match tr.drawn_of(id) {
      Some(d) => debug_assert(d.ground == 0x778899FFL, "Row forwarded into bg updated")
      None => debug_assert(false, "row_ref should still be drawn")
    }
    None => ()
  }

  forget_image("mem:into_a")
  forget_image("mem:into_b")
  t.dispose()
}
