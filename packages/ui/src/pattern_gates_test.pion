// Positive (all 13 APG patterns + RTL) and negative mutation tests for `pattern_gates.pion`.

import "signals"
import "view"

fn any_pattern_fault(faults : Array[String], needle : String) -> Bool {
  for f in faults {
    if str_contains(f, needle) {
      return true
    }
  }
  false
}

// Helper: build a compliant roving-focus composite container (used for Tabs, RadioGroup, Listbox, Toolbar, Menu).
fn make_roving_items(
  parent : view::View,
  container_role : view::Role,
  container_label : String,
  item_role : view::Role,
  names : Array[String],
  horizontal : Bool,
  rtl : Bool,
  single_tab_stop : Bool,
  enable_arrows : Bool,
  with_selected : Bool,
  with_check : Bool,
) -> Unit {
  let active = signals::signal(0)
  let nodes : Array[view::View] = []
  let _ = parent.box(fn(box : view::View) {
    let _ = box.says(view::Live::Is(Some(view::said(container_role, label=container_label))))
    let mut i = 0
    while i < names.length() {
      let idx = i
      let name = names[i]
      let item = box.box(fn(v : view::View) {
        let _ = v
          .width(view::Live::Is(Some(60.0)))
          .height(view::Live::Is(Some(28.0)))
          .presses(view::Live::Is(true))
          .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space, tab=!single_tab_stop)
          .says(view::Live::By(fn() -> Option[view::Said] {
            let is_on = active.get() == idx
            if with_selected {
              Some(view::said(item_role, label=name, selected=is_on))
            } else if with_check {
              let chk = if is_on { view::Check::On } else { view::Check::Off }
              Some(view::said(item_role, label=name, check=chk))
            } else {
              Some(view::said(item_role, label=name))
            }
          }))
          .on_press(fn() { active.set(idx) })
        if single_tab_stop {
          let _ = v.tab_stop(view::Live::By(fn() -> Bool { active.get() == idx }))
        }
      })
      nodes.push(item)
      i += 1
    }
    if enable_arrows {
      let _ = box.on_key(fn(k : view::Key) -> Bool {
        if k.mods != 0 || nodes.length() == 0 {
          return false
        }
        let mut cur = -1
        let mut j = 0
        while j < nodes.length() {
          if nodes[j].focused() {
            cur = j
            break
          }
          j += 1
        }
        if cur < 0 {
          return false
        }
        let next_k = if horizontal { if rtl { key_code_left } else { key_code_right } } else { key_code_down }
        let prev_k = if horizontal { if rtl { key_code_right } else { key_code_left } } else { key_code_up }
        let n = nodes.length()
        let to : Option[Int] = if k.code == next_k {
          Some((cur + 1) % n)
        } else if k.code == prev_k {
          Some((cur + n - 1) % n)
        } else if k.code == key_code_home {
          Some(0)
        } else if k.code == key_code_end {
          Some(n - 1)
        } else {
          None
        }
        match to {
          Some(dest) => {
            active.set(dest)
            let _ = nodes[dest].ask_focus(visible=true)
            true
          }
          None => false
        }
      })
    }
  })
}

test "pattern_gates positive: Tabs, RadioGroup, Listbox, Menu, Toolbar (LTR & RTL)" {
  // Tabs LTR & RTL (with visible TabPanel)
  let t_tabs = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::TabList, "Sections", view::Role::Tab, ["One", "Two", "Three"], true, false, true, true, true, false)
    let _ = root.box(fn(p : view::View) {
      let _ = p.says(view::Live::Is(Some(view::said(view::Role::TabPanel, label="Panel One", selected=true))))
    })
  })
  t_tabs.assert_pattern(AriaPattern::Tabs, label="tabs-ltr")
  t_tabs.dispose()

  let t_tabs_rtl = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::TabList, "Sections RTL", view::Role::Tab, ["One", "Two", "Three"], true, true, true, true, true, false)
    let _ = root.box(fn(p : view::View) {
      let _ = p.says(view::Live::Is(Some(view::said(view::Role::TabPanel, label="Panel One RTL", selected=true))))
    })
  })
  t_tabs_rtl.assert_pattern(AriaPattern::Tabs, rtl=true, label="tabs-rtl")
  t_tabs_rtl.dispose()

  // RadioGroup LTR & RTL
  let t_rg = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::RadioGroup, "Size", view::Role::Radio, ["Small", "Medium", "Large"], true, false, true, true, false, true)
  })
  t_rg.assert_pattern(AriaPattern::RadioGroup, label="rg-ltr")
  t_rg.dispose()

  let t_rg_rtl = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::RadioGroup, "Size RTL", view::Role::Radio, ["Small", "Medium", "Large"], true, true, true, true, false, true)
  })
  t_rg_rtl.assert_pattern(AriaPattern::RadioGroup, rtl=true, label="rg-rtl")
  t_rg_rtl.dispose()

  // Listbox
  let t_lb = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::Listbox, "Colors", view::Role::Option, ["Red", "Green", "Blue"], false, false, true, true, true, false)
  })
  t_lb.assert_pattern(AriaPattern::Listbox, label="listbox-ok")
  t_lb.dispose()

  // Menu
  let t_menu = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::Menu, "File", view::Role::MenuItem, ["New", "Open", "Save"], false, false, false, true, false, false)
  })
  t_menu.assert_pattern(AriaPattern::Menu, label="menu-ok")
  t_menu.dispose()

  // Toolbar LTR & RTL
  let t_tb = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::Toolbar, "Edit", view::Role::Button, ["Bold", "Italic", "Underline"], true, false, true, true, false, false)
  })
  t_tb.assert_pattern(AriaPattern::Toolbar, label="toolbar-ltr")
  t_tb.dispose()

  let t_tb_rtl = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::Toolbar, "Edit RTL", view::Role::Button, ["Bold", "Italic", "Underline"], true, true, true, true, false, false)
  })
  t_tb_rtl.assert_pattern(AriaPattern::Toolbar, rtl=true, label="toolbar-rtl")
  t_tb_rtl.dispose()
}

test "pattern_gates positive: Dialog, AlertDialog, Accordion, Disclosure, Combobox, Slider (LTR & RTL), Switch, Checkbox" {
  // Dialog
  let t_dlg = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(d : view::View) {
      let _ = d
        .says(view::Live::Is(Some(view::said(view::Role::Dialog, label="Preferences"))))
        .modal(view::Live::Is(true))
      let _ = d.box(fn(b : view::View) {
        let _ = b
          .presses(view::Live::Is(true))
          .focusable(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="OK"))))
      })
    })
  })
  t_dlg.assert_pattern(AriaPattern::Dialog, label="dialog-ok")
  t_dlg.dispose()

  // AlertDialog with modal trap and outside button blocked
  let t_adlg = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(outside : view::View) {
      let _ = outside
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Background"))))
    })
    let _ = root.box(fn(d : view::View) {
      let _ = d
        .says(view::Live::Is(Some(view::said(view::Role::AlertDialog, label="Delete Item"))))
        .modal(view::Live::Is(true))
      let _ = d.box(fn(b : view::View) {
        let _ = b
          .presses(view::Live::Is(true))
          .focusable(view::Live::Is(true))
          .says(view::Live::Is(Some(view::said(view::Role::Button, label="Confirm"))))
      })
    })
  })
  t_adlg.assert_pattern(AriaPattern::AlertDialog, label="alert-dialog-ok")
  t_adlg.dispose()

  // Accordion
  let t_acc = Tester::tree(fn(root : view::View) {
    let open = signals::signal(0)
    let triggers : Array[view::View] = []
    let _ = root.box(fn(acc : view::View) {
      let names = ["Section 1", "Section 2"]
      let mut i = 0
      while i < names.length() {
        let idx = i
        let nm = names[i]
        let btn = acc.box(fn(v : view::View) {
          let _ = v
            .presses(view::Live::Is(true))
            .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
            .says(view::Live::By(fn() -> Option[view::Said] {
              Some(view::said(view::Role::Button, label=nm, expanded=open.get() == idx))
            }))
            .on_press(fn() { open.set(idx) })
        })
        triggers.push(btn)
        i += 1
      }
      let _ = acc.on_key(fn(k : view::Key) -> Bool {
        if k.mods != 0 { return false }
        let cur = if triggers[0].focused() { 0 } else if triggers[1].focused() { 1 } else { -1 }
        if cur < 0 { return false }
        let dest = if k.code == key_code_down || k.code == key_code_end {
          1
        } else if k.code == key_code_up || k.code == key_code_home {
          0
        } else {
          return false
        }
        let _ = triggers[dest].ask_focus(visible=true)
        true
      })
    })
  })
  t_acc.assert_pattern(AriaPattern::Accordion, label="accordion-ok")
  t_acc.dispose()

  // Disclosure
  let t_disc = Tester::tree(fn(root : view::View) {
    let open = signals::signal(false)
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
        .says(view::Live::By(fn() -> Option[view::Said] {
          Some(view::said(view::Role::Button, label="Details", expanded=open.get()))
        }))
        .on_press(fn() { open.set(!open.get()) })
    })
  })
  t_disc.assert_pattern(AriaPattern::Disclosure, label="disclosure-ok")
  t_disc.dispose()

  // Combobox
  let t_cb = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v.says(view::Live::Is(Some(view::said(view::Role::Combobox, label="Search", expanded=true))))
      let _ = v.box(fn(o1 : view::View) {
        let _ = o1.says(view::Live::Is(Some(view::said(view::Role::Option, label="Alpha", selected=true))))
      })
      let _ = v.box(fn(o2 : view::View) {
        let _ = o2.says(view::Live::Is(Some(view::said(view::Role::Option, label="Beta", selected=false))))
      })
    })
  })
  t_cb.assert_pattern(AriaPattern::Combobox, label="combobox-ok")
  t_cb.dispose()

  // Slider LTR & RTL
  let make_slider = fn(rtl : Bool) -> Tester {
    Tester::tree(fn(root : view::View) {
      let sval : signals::Signal[Double] = signals::signal(50.0)
      let _ = root.box(fn(v : view::View) {
        let _ = v
          .presses(view::Live::Is(true))
          .focusable(view::Live::Is(true))
          .says(view::Live::By(fn() -> Option[view::Said] {
            Some(view::said(view::Role::Slider, label="Volume", range=(0.0, sval.get(), 100.0)))
          }))
          .on_key(fn(k : view::Key) -> Bool {
            if k.mods != 0 || !v.focused() { return false }
            let inc = if rtl { key_code_left } else { key_code_right }
            let dec = if rtl { key_code_right } else { key_code_left }
            if k.code == inc {
              sval.set(dmin(100.0, sval.get() + 10.0))
              true
            } else if k.code == dec {
              sval.set(dmax(0.0, sval.get() - 10.0))
              true
            } else if k.code == key_code_end {
              sval.set(100.0)
              true
            } else if k.code == key_code_home {
              sval.set(0.0)
              true
            } else {
              false
            }
          })
      })
    })
  }
  let t_sl = make_slider(false)
  t_sl.assert_pattern(AriaPattern::Slider, label="slider-ltr")
  t_sl.dispose()
  let t_sl_rtl = make_slider(true)
  t_sl_rtl.assert_pattern(AriaPattern::Slider, rtl=true, label="slider-rtl")
  t_sl_rtl.dispose()

  // Switch
  let t_sw = Tester::tree(fn(root : view::View) {
    let on = signals::signal(false)
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
        .says(view::Live::By(fn() -> Option[view::Said] {
          let chk = if on.get() { view::Check::On } else { view::Check::Off }
          Some(view::said(view::Role::Switch, label="Airplane Mode", check=chk))
        }))
        .on_press(fn() { on.set(!on.get()) })
    })
  })
  t_sw.assert_pattern(AriaPattern::Switch, label="switch-ok")
  t_sw.dispose()

  // Checkbox
  let t_chk = Tester::tree(fn(root : view::View) {
    let on = signals::signal(false)
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=view::focus_space)
        .says(view::Live::By(fn() -> Option[view::Said] {
          let chk = if on.get() { view::Check::On } else { view::Check::Off }
          Some(view::said(view::Role::Checkbox, label="Accept Terms", check=chk))
        }))
        .on_press(fn() { on.set(!on.get()) })
    })
  })
  t_chk.assert_pattern(AriaPattern::Checkbox, label="checkbox-ok")
  t_chk.dispose()
}

test "pattern_gates negative mutations: missing label, missing states, multi-tab-stop, broken arrows, modal escape, Space no-op" {
  // 1. Missing label on Dialog
  let t1 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(d : view::View) {
      let _ = d.says(view::Live::Is(Some(view::said(view::Role::Dialog, label=""))))
    })
  })
  let f1 = t1.pattern_faults(AriaPattern::Dialog)
  debug_assert(any_pattern_fault(f1, "missing accessible label"), "must catch missing label")
  t1.dispose()

  // 2. Missing range on Slider
  let t2 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Slider, label="Broken Slider"))))
    })
  })
  let f2 = t2.pattern_faults(AriaPattern::Slider)
  debug_assert(any_pattern_fault(f2, "missing range state"), "must catch missing range on Slider")
  t2.dispose()

  // 3. Missing check on Checkbox & Switch
  let t3 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v.says(view::Live::Is(Some(view::said(view::Role::Checkbox, label="No Check"))))
    })
  })
  let f3 = t3.pattern_faults(AriaPattern::Checkbox)
  debug_assert(any_pattern_fault(f3, "missing check state"), "must catch missing check on Checkbox")
  t3.dispose()

  // 4. Missing expanded on Disclosure & Combobox
  let t4 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v.says(view::Live::Is(Some(view::said(view::Role::Button, label="Plain Button"))))
    })
    let _ = root.box(fn(c : view::View) {
      let _ = c.says(view::Live::Is(Some(view::said(view::Role::Combobox, label="No Exp"))))
    })
  })
  let f4a = t4.pattern_faults(AriaPattern::Disclosure)
  let f4b = t4.pattern_faults(AriaPattern::Combobox)
  debug_assert(any_pattern_fault(f4a, "missing expanded state"), "must catch missing expanded on Disclosure")
  debug_assert(any_pattern_fault(f4b, "missing expanded state"), "must catch missing expanded on Combobox")
  t4.dispose()

  // 5. Multiple Tab stops on Tabs
  let t5 = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::TabList, "Bad Tabs", view::Role::Tab, ["A", "B"], true, false, false, true, true, false)
  })
  let f5 = t5.pattern_faults(AriaPattern::Tabs)
  debug_assert(any_pattern_fault(f5, "Tab stops"), "must catch multiple Tab stops")
  t5.dispose()

  // 6. Broken arrow keys on Toolbar (and RTL mismatch on Tabs)
  let t6 = Tester::tree(fn(root : view::View) {
    make_roving_items(root, view::Role::Toolbar, "Dead Toolbar", view::Role::Button, ["A", "B"], true, false, true, false, false, false)
  })
  let f6 = t6.pattern_faults(AriaPattern::Toolbar)
  debug_assert(any_pattern_fault(f6, "next arrow did not move focus"), "must catch broken arrow keys")
  t6.dispose()

  // 7. AlertDialog missing modal trap and allowing outside focus escape
  let t7 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(outside : view::View) {
      let _ = outside
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true))
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Escaped"))))
    })
    let _ = root.box(fn(d : view::View) {
      let _ = d.says(view::Live::Is(Some(view::said(view::Role::AlertDialog, label="Unmodal Alert"))))
    })
  })
  let f7 = t7.pattern_faults(AriaPattern::AlertDialog)
  debug_assert(any_pattern_fault(f7, "missing active modal trap"), "must catch AlertDialog missing modal")
  debug_assert(any_pattern_fault(f7, "focus escaped outside AlertDialog"), "must catch AlertDialog focus escape")
  t7.dispose()

  // 8. Space does not toggle Switch
  let t8 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
        .says(view::Live::Is(Some(view::said(view::Role::Switch, label="Frozen Switch", check=view::Check::Off))))
    })
  })
  let f8 = t8.pattern_faults(AriaPattern::Switch)
  debug_assert(any_pattern_fault(f8, "Space did not toggle Switch"), "must catch Switch Space no-op")
  t8.dispose()

  // 9. Tabs missing TabPanel and Tabs not switching selected state on activation
  let t9 = Tester::tree(fn(root : view::View) {
    let nodes : Array[view::View] = []
    let _ = root.box(fn(tl : view::View) {
      let _ = tl.says(view::Live::Is(Some(view::said(view::Role::TabList, label="Frozen Tabs"))))
      let mut i = 0
      while i < 2 {
        let idx = i
        let n = tl.box(fn(v : view::View) {
          let _ = v
            .presses(view::Live::Is(true))
            .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space, tab=false)
            .tab_stop(view::Live::Is(idx == 0))
            .says(view::Live::Is(Some(view::said(view::Role::Tab, label=if idx == 0 { "T1" } else { "T2" }, selected=idx == 0))))
        })
        nodes.push(n)
        i += 1
      }
      let _ = tl.on_key(fn(k : view::Key) -> Bool {
        if k.mods != 0 { return false }
        let dest = if k.code == key_code_right || k.code == key_code_end { 1 } else if k.code == key_code_left || k.code == key_code_home { 0 } else { return false }
        let _ = nodes[dest].ask_focus(visible=true)
        true
      })
    })
  })
  let f9 = t9.pattern_faults(AriaPattern::Tabs)
  debug_assert(any_pattern_fault(f9, "missing visible TabPanel"), "must catch missing TabPanel")
  debug_assert(any_pattern_fault(f9, "did not switch selected state"), "must catch Tabs not switching selected")
  t9.dispose()

  // 10. Accordion trigger not toggling expanded on Space/Enter
  let t10 = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
        .presses(view::Live::Is(true))
        .focusable(view::Live::Is(true), keys=view::focus_enter | view::focus_space)
        .says(view::Live::Is(Some(view::said(view::Role::Button, label="Frozen Section", expanded=false))))
    })
  })
  let f10 = t10.pattern_faults(AriaPattern::Accordion)
  debug_assert(any_pattern_fault(f10, "Space/Enter did not toggle expanded"), "must catch Accordion Space/Enter no-op")
  t10.dispose()
}
