// INVAR-EXT: Invar-unique UI craft audit gates wrapping upstream Tester audit methods.
// Upstream contrast.pion, corners.pion, first_line.pion, line_start.pion,
// tester_focus_visible.pion, tester_unseen_press.pion, and words_over.pion
// provide the core fault detectors; this file provides assertion wrappers,
// MotionProbe, shadow_clip_faults, and combined ui_craft_audit.

import "view"

fn gate_label(tree : view::Tree, d : view::Drawn) -> String {
  let sl = tree.said_label(d.id)
  if sl.length() > 0 {
    sl
  } else if d.words.length() > 0 {
    d.words
  } else {
    "#\{d.id.at}"
  }
}

fn gate_label_id(tree : view::Tree, id : view::NodeId) -> String {
  match tree.said_of(id) {
    Some(s) =>
      if s.label.length() > 0 {
        return "\"\{s.label}\""
      }
    None => ()
  }
  let sl = tree.said_label(id)
  if sl.length() > 0 {
    "\"\{sl}\""
  } else {
    "#\{id.at}"
  }
}

fn assert_fault_list(kind : String, faults : Array[String], label : String) -> Unit {
  if faults.length() > 0 {
    let mut msg = if label.length() > 0 {
      "\{kind} failed in \{label} (\{faults.length()} fault(s)):"
    } else {
      "\{kind} failed (\{faults.length()} fault(s)):"
    }
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

/// Assert zero concentric-corner faults.
pub fn Tester::assert_corners(self : Tester, label~ : String = "") -> Unit {
  assert_fault_list("corner_faults", self.corner_faults(), label)
}

/// Assert zero contrast faults.
pub fn Tester::assert_contrast(self : Tester, label~ : String = "") -> Unit {
  assert_fault_list("contrast_faults", self.contrast_faults(), label)
}

/// Text overflow and overlap faults from upstream `words_over_now` plus geometric text-box overlap/overflow check.
pub fn Tester::words_over_faults(self : Tester) -> Array[String] {
  let raw = self.words_over_now()
  let out : Array[String] = []
  for f in raw {
    if mbt_compat::str_has_prefix(f, "words_over:") {
      out.push(f)
    } else {
      out.push("words_over: " + f)
    }
  }
  if out.is_empty() {
    match view_tree() {
      Some(tree) => {
        let held = tree.drawn_held()
        let n = held.length()
        let boxes : Array[(view::NodeId, String, Double, Double, Double, Double)] = []
        let mut i = 0
        while i < n {
          let d = held[i].0
          if d.words.length() > 0 && d.alpha > 0.02 && d.bones == 0L && d.w > 0.5 && d.h > 0.5 {
            let mut vx0 = d.x
            let mut vy0 = d.y
            let mut vx1 = d.x + d.w
            let mut vy1 = d.y + d.h
            let mut p = held[i].1
            while p >= 0 && p < n {
              let pd = held[p].0
              if pd.clips || pd.clips_self {
                vx0 = dmax(vx0, pd.x)
                vy0 = dmax(vy0, pd.y)
                vx1 = dmin(vx1, pd.x + pd.w)
                vy1 = dmin(vy1, pd.y + pd.h)
              }
              p = held[p].1
            }
            vx0 = dmax(vx0, 0.0)
            vy0 = dmax(vy0, 0.0)
            vx1 = dmin(vx1, self.w)
            vy1 = dmin(vy1, self.h)
            if vx1 - vx0 > 0.5 && vy1 - vy0 > 0.5 {
              let par_idx = held[i].1
              if par_idx >= 0 {
                let par = held[par_idx].0
                if !par.clips && !par.clips_self && par.w > 0.5 && par.h > 0.5 {
                  if d.x < par.x - 2.0 || d.y < par.y - 2.0 || d.x + d.w > par.x + par.w + 2.0 || d.y + d.h > par.y + par.h + 2.0 {
                    out.push("words_over: \"\{d.words}\" overflows parent \{gate_label(tree, par)}")
                  }
                }
              }
              boxes.push((d.id, d.words, vx0, vy0, vx1, vy1))
            }
          }
          i += 1
        }
        let nb = boxes.length()
        let mut a = 0
        while a < nb {
          let ba = boxes[a]
          let mut b = a + 1
          while b < nb {
            let bb = boxes[b]
            if !tree.holds_in_order(ba.0, bb.0) && !tree.holds_in_order(bb.0, ba.0) {
              let ix0 = dmax(ba.2, bb.2)
              let iy0 = dmax(ba.3, bb.3)
              let ix1 = dmin(ba.4, bb.4)
              let iy1 = dmin(ba.5, bb.5)
              let ow = ix1 - ix0
              let oh = iy1 - iy0
              if ow > 2.0 && oh > 2.0 {
                let part = (ix0, iy0, ix1, iy1)
                if !tree.covered_under(ba.0, bb.0, part) && !tree.covered_under(bb.0, ba.0, part) {
                  out.push("words_over: \"\{ba.1}\" overlaps \"\{bb.1}\" (\{ow}x\{oh})")
                }
              }
            }
            b += 1
          }
          a += 1
        }
      }
      None => ()
    }
  }
  out
}

/// Assert zero text overflow or overlap faults.
pub fn Tester::assert_words_over(self : Tester, label~ : String = "") -> Unit {
  assert_fault_list("words_over_faults", self.words_over_faults(), label)
}

