/// Check sampled `(x, y, w, h)` trajectories for single-frame jumps or 1-frame oscillations.
pub fn Tester::motion_steady_faults(
  self : Tester,
  samples : Array[(Double, Double, Double, Double)],
  max_jump_pt~ : Double = 48.0,
) -> Array[String] {
  let _ = self
  let faults : Array[String] = []
  let n = samples.length()
  if n < 2 {
    return faults
  }
  let mut i = 1
  while i < n {
    let (x0, y0, w0, h0) = samples[i - 1]
    let (x1, y1, w1, h1) = samples[i]
    let dx = (x1 - x0).abs()
    let dy = (y1 - y0).abs()
    let dw = (w1 - w0).abs()
    let dh = (h1 - h0).abs()
    let step = dmax(dmax(dx, dy), dmax(dw, dh))
    if step > max_jump_pt {
      faults.push("motion jump at frame \{i}: delta=\{step}pt exceeds max_jump_pt=\{max_jump_pt}pt")
    }
    if i >= 2 {
      let (xp, yp, _, _) = samples[i - 2]
      let dx0 = x0 - xp
      let dx1 = x1 - x0
      let dy0 = y0 - yp
      let dy1 = y1 - y0
      if (dx0 * dx1 < -4.0 && dx0.abs() > 2.0 && dx1.abs() > 2.0) ||
        (dy0 * dy1 < -4.0 && dy0.abs() > 2.0 && dy1.abs() > 2.0) {
        faults.push("motion reversal oscillation at frame \{i}")
      }
    }
    i += 1
  }
  faults
}

/// Frame-by-frame motion probe that attaches to `Tester::each_frame` and samples `(x, y, w, h)` for a named node.
pub struct MotionProbe {
  pub target : String
  pub samples : Array[(Double, Double, Double, Double)]
}

/// Create a `MotionProbe` tracking semantic label or drawn text `target`.
pub fn MotionProbe::new(target : String) -> MotionProbe {
  MotionProbe::{ target, samples: [] }
}

/// Record the current `(x, y, w, h)` of `self.target` if drawn in `t`.
pub fn MotionProbe::sample(self : MotionProbe, t : Tester) -> Unit {
  for d in t.drawn() {
    if d.words == self.target {
      self.samples.push((d.x, d.y, d.w, d.h))
      return
    }
  }
  match view_tree() {
    Some(tr) => {
      for d in tr.drawn() {
        if tr.said_label(d.id) == self.target {
          self.samples.push((d.x, d.y, d.w, d.h))
          return
        }
      }
    }
    None => ()
  }
}

/// Attach this probe to `t.each_frame` and capture the initial frame immediately.
pub fn MotionProbe::attach(self : MotionProbe, t : Tester) -> Unit {
  self.sample(t)
  t.each_frame(Some(fn() { self.sample(t) }))
}

/// Evaluate collected samples against `Tester::motion_steady_faults`.
pub fn MotionProbe::faults(
  self : MotionProbe,
  t : Tester,
  max_jump_pt~ : Double = 48.0,
) -> Array[String] {
  t.motion_steady_faults(self.samples, max_jump_pt=max_jump_pt)
}

/// Assert that collected motion samples contain no jumps or oscillations.
pub fn MotionProbe::assert_steady(
  self : MotionProbe,
  t : Tester,
  max_jump_pt~ : Double = 48.0,
  label~ : String = "",
) -> Unit {
  assert_fault_list("motion_steady_faults", self.faults(t, max_jump_pt=max_jump_pt), label)
}

/// Halo margins `(left, top, right, bottom)` for a drop shadow of blur `blur` and vertical offset `dy`.
pub fn shadow_halo(blur : Double, dy : Double) -> (Double, Double, Double, Double) {
  if blur <= 0.0 {
    return (0.0, 0.0, 0.0, 0.0)
  }
  let pad = blur * 3.0 + 2.0
  (pad, dmax(pad - dy, 0.0), pad, dmax(pad + dy, 0.0))
}

fn round_tenth(v : Double) -> Double {
  (v * 10.0).round() / 10.0
}

/// Check that drop-shadow halos are not clipped by viewport or clipping ancestors.
pub fn Tester::shadow_clip_faults(
  self : Tester,
  sigma~ : Double = 2.5,
  include_viewport~ : Bool = true,
) -> Array[String] {
  let tree = match view_tree() {
    Some(tr) => tr
    None => return []
  }
  let held = tree.drawn_held()
  let n = held.length()
  let faults : Array[String] = []
  let vw = self.w
  let vh = self.h
  let mut i = 0
  while i < n {
    let d = held[i].0
    let (sblur, sy, scol) = d.shadow
    let sa = ((scol & 0xFFL).to_int().to_double() / 255.0) * d.alpha
    if d.alpha > 0.01 && d.w > 0.5 && d.h > 0.5 && sblur > 0.0 && sa > 0.01 {
      let mut cx0 = 0.0
      let mut cy0 = 0.0
      let mut cx1 = vw
      let mut cy1 = vh
      let mut has_l = include_viewport
      let mut has_t = include_viewport
      let mut has_r = include_viewport
      let mut has_b = include_viewport
      let mut src_l = "viewport"
      let mut src_t = "viewport"
      let mut src_r = "viewport"
      let mut src_b = "viewport"
      let mut p = held[i].1
      while p >= 0 {
        let anc = held[p].0
        if anc.clips || anc.clips_self {
          let aname = "clip(" + gate_label(tree, anc) + ")"
          if anc.clips_way != 1 {
            if (include_viewport || anc.x > 0.5) && (!has_l || anc.x > cx0) {
              cx0 = anc.x
              src_l = aname
              has_l = true
            }
            if (include_viewport || anc.x + anc.w < vw - 0.5) && (!has_r || anc.x + anc.w < cx1) {
              cx1 = anc.x + anc.w
              src_r = aname
              has_r = true
            }
          }
          if anc.clips_way != 2 {
            if (include_viewport || anc.y > 0.5) && (!has_t || anc.y > cy0) {
              cy0 = anc.y
              src_t = aname
              has_t = true
            }
            if (include_viewport || anc.y + anc.h < vh - 0.5) && (!has_b || anc.y + anc.h < cy1) {
              cy1 = anc.y + anc.h
              src_b = aname
              has_b = true
            }
          }
        }
        p = held[p].1
      }
      let vx0 = dmax(if has_l { cx0 } else { 0.0 }, d.x)
      let vy0 = dmax(if has_t { cy0 } else { 0.0 }, d.y)
      let vx1 = dmin(if has_r { cx1 } else { vw }, d.x + d.w)
      let vy1 = dmin(if has_b { cy1 } else { vh }, d.y + d.h)
      if vx1 - vx0 > 0.5 && vy1 - vy0 > 0.5 {
        let spread = sblur * sigma
        let name = gate_label(tree, d)
        let span_w = (if has_r { cx1 } else { vw }) - (if has_l { cx0 } else { 0.0 })
        let span_h = (if has_b { cy1 } else { vh }) - (if has_t { cy0 } else { 0.0 })
        let full_w = d.w >= span_w - 2.0
        let full_h = d.h >= span_h - 2.0
        if has_l && d.x >= cx0 - 0.5 && !(d.x <= cx0 + 0.5 && (full_h || full_w)) {
          let room = dmax(0.0, d.x - cx0)
          if room + 0.5 < spread {
            faults.push(
              "shadow_clip: \{name} left shadow needs \{round_tenth(spread)}pt (blur=\{sblur}), only \{round_tenth(room)}pt before \{src_l}",
            )
          }
        }
        if has_r && d.x + d.w <= cx1 + 0.5 && !(d.x + d.w >= cx1 - 0.5 && (full_h || full_w)) {
          let room = dmax(0.0, cx1 - (d.x + d.w))
          if room + 0.5 < spread {
            faults.push(
              "shadow_clip: \{name} right shadow needs \{round_tenth(spread)}pt (blur=\{sblur}), only \{round_tenth(room)}pt before \{src_r}",
            )
          }
        }
        let need_t = dmax(0.0, spread - sy)
        if has_t && need_t > 0.5 && d.y >= cy0 - 0.5 && !(d.y <= cy0 + 0.5 && (full_w || full_h)) {
          let room = dmax(0.0, d.y - cy0)
          if room + 0.5 < need_t {
            faults.push(
              "shadow_clip: \{name} top shadow needs \{round_tenth(need_t)}pt (blur=\{sblur}, dy=\{sy}), only \{round_tenth(room)}pt before \{src_t}",
            )
          }
        }
        let need_b = dmax(0.0, spread + sy)
        if has_b && need_b > 0.5 && d.y + d.h <= cy1 + 0.5 && !(d.y + d.h >= cy1 - 0.5 && (full_w || full_h)) {
          let room = dmax(0.0, cy1 - (d.y + d.h))
          if room + 0.5 < need_b {
            faults.push(
              "shadow_clip: \{name} bottom shadow needs \{round_tenth(need_b)}pt (blur=\{sblur}, dy=\{sy}), only \{round_tenth(room)}pt before \{src_b}",
            )
          }
        }
      }
    }
    i += 1
  }
  faults
}

/// Assert zero clipped drop-shadow halos against viewport (when `include_viewport=true`) and ancestor clips.
pub fn Tester::assert_shadow_clip(
  self : Tester,
  sigma~ : Double = 2.5,
  include_viewport~ : Bool = true,
  label~ : String = "",
) -> Unit {
  assert_fault_list(
    "shadow_clip_faults",
    self.shadow_clip_faults(sigma=sigma, include_viewport=include_viewport),
    label,
  )
}

/// Combined UI craft audit aggregating room, scroll, corner, unseen-press, focus-visible, text-overflow, first-line, line-start, and clipped-ancestor shadow gates.
pub fn Tester::ui_craft_audit(self : Tester) -> Array[String] {
  let out : Array[String] = []
  for f in self.room_faults() {
    out.push(f)
  }
  for f in self.scroll_faults() {
    out.push(f)
  }
  for f in self.corner_faults() {
    out.push(f)
  }
  for f in self.unseen_press_faults() {
    out.push(f)
  }
  for f in self.focus_visible_faults() {
    out.push(f)
  }
  for f in self.words_over_faults() {
    out.push(f)
  }
  for f in self.first_line_faults() {
    out.push(f)
  }
  for f in self.line_start_faults() {
    out.push(f)
  }
  for f in self.shadow_clip_faults(sigma=2.0, include_viewport=false) {
    out.push(f)
  }
  for f in self.shadow_clip_faults(sigma=2.0, include_viewport=false) {
    out.push(f)
  }
  out
}

/// Assert that `ui_craft_audit()` returns zero faults.
pub fn Tester::assert_ui_craft(self : Tester, label~ : String = "") -> Unit {
  assert_fault_list("ui_craft_audit", self.ui_craft_audit(), label)
}
