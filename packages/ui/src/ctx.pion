  self.hover_in = []
  self.press_on = []
  self.clicked = []
  self.double_clicked = []
  self.press_chain = []
  self.lists.clear()
  { let __mbt_mit_711 = mbt_compat::ordered_map_iter_lazy(self.editors); while true { match (__mbt_mit_711.next)() { Some((id, st)) => {
    editor_gone(st, id)
  }, None => break } } }
  self.editors.clear()
  self.springs.clear()
  self.movers = []
  self.cycles = []
  self.periodic = []
  self.laid_reads.clear()
  self.size_reads.clear()
  self.place_reads.clear()
  self.info_reads = []
  self.row_reads.clear()
  self.words_reads.clear()
  self.words_shape_reads.clear()
  self.left_ids.clear()
  self.left_reads.clear()
  self.cut_ids.clear()
  self.laid_watch.clear()
  self.tallest_h.clear()
  self.laid_rects.clear()
  self.shown_watch.clear()
  self.shown_spans.clear()
  self.covers.clear()
  self.cover_asks = []
  self.owned.clear()
  self.owned_releases.clear()
  self.layer_gen.clear()
