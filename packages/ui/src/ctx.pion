///|
/// Let go of as the next run begins (reset_globals): all it holds dropped and its room given back. The Ctx itself may
/// never be: once an array it holds is emptied of what reads it, moonc's native backend keeps it for good
/// (runtime Array::clear retention), so each Tester's would stay with all it held, its instances' room (2 MB) and every
/// frame's nodes; what it holds goes here instead.
fn Ctx::let_go(self : Ctx) -> Unit {
  // (built into still by what kept it, nothing of that drawn: as a first frame's, from nothing, on as little room)
  self.inst = FixedArray::make(inst_size, 0.0)
  self.ninst = 0
  self.spans_cut()
  self.count = 0
  self.cur = -1
  self.back = Option::None
  self.back_next = Option::None
  self.layer_hook = Option::None
  self.back_held = Option::None
  self.forward_held = Option::None
  self.forward_off = false
  // (not its corner_ladder: its theme's own, Ctx::set_theme)
  for n in self.nodes {
    n.unlinked()
  }
  self.nodes = []
  self.id_stack = []
  self.hit_ids = []
  self.hit_rects = []
  self.next_hit_ids = []
  self.next_hit_rects = []
  self.hit_clips = []
  self.next_hit_clips = []
  self.hit_ends = []
  self.next_hit_ends = []
  self.hit_marks = []
  self.next_hit_marks = []
  self.built_ids.clear()
  self.marks_ahead.clear()
  self.focus_ahead.clear()
  self.points.clear()
  self.passes.clear()
  self.next_passes.clear()
  self.next_points.clear()
  self.next_point_hits = []
  self.scroll_ids = []
