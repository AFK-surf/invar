  priv mut glide_shows : Bool
  priv mut named : String
  priv mut made_at : Option[String]
  priv bar : Bar
  priv mut laid : Int
  priv mut pinned_by : Double
  priv mut began : (Int, Double, Double, Bool, Bool)
  priv mut left : (Int, Double, Double, Bool, Bool)
  priv mut glide_began : (Double, Double, Double, Double, Double)
  priv mut scroll_asked : (Int, Int, Double)
  priv mut fling : Int
  priv mut fling_v : Double
  priv mut fling_t0 : Double
  priv mut fling_dist : Double
  priv mut fling_dur : Double
  priv mut fling_done : Double
  priv mut fling_from : Option[(Int, Double, Double)]
  priv mut drag_pending : Double
