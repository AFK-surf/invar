// Dragging a long list's scroll bar thumb: one frame's encode works the theme and glass_solid out once (not once for
// each node it encodes), and no hover hit-test runs while the drag holds the pointer, once again as it ends.

import "view"

fn drag_list_page(root : view::View, scroll : view::Scroll) -> Unit {
  let _ = root.scroll_box(fn(body : view::View) {
    let mut i = 0
    while i < 120 {
      let idx = i
      let _ = body.box(fn(row : view::View) {
        let _ = row
        .row(view::Live::Is(true))
        .width(view::Live::Is(Some(340.0)))
        .height(view::Live::Is(Some(40.0)))
        .bg(if idx % 2 == 0 { 0xF4F6FAFFL } else { 0xFFFFFFFFL })
        .points(view::Live::Is(true))
        // (words of the theme's own size: each reads tree_theme().font as it is encoded)
        let _ = row.box(fn(lbl : view::View) { let _ = lbl.words(view::Live::Is("Row \{idx}")) })
        let _ = row.box(fn(sub : view::View) { let _ = sub.words(view::Live::Is("detail \{idx}")) })
      })
      i += 1
    }
  }, scroll=scroll, bar=tree_scroll_bar())
}

fn thumb_place(t : view::Tree) -> Option[view::Drawn] {
  let thumbs = t.thumbs_now()
  for e in t.drawn_held() {
    let (d, _, _) = e
    for th in thumbs {
      if th == d.id && d.h > 4.0 {
        return Some(d)
      }
    }
  }
  None
}

test "drag_frame: a frame's encode works the theme out once, not for each node" {
  let base = tree_theme()
  let calls : Array[Int] = [0]
  let scroll = view::Scroll::new()
  let t = Tester::tree(
    fn(root : view::View) { drag_list_page(root, scroll) },
    w=400.0,
    h=320.0,
    scale=1.5,
    theme=fn() {
      calls[0] = calls[0] + 1
      base
    },
  )
  t.frame(ms=16.0)
  // (a frame of nothing but encode: the scroll moved, nothing laid out anew)
  calls[0] = 0
  scroll.put(400.0)
  t.fake.wants = true
  t.frame(ms=16.0)
  let in_frame = calls[0]
  t.dispose()
  // ~8 rows in sight, 3 nodes each with words: once a node, it was 20+; held for the frame it is a handful
  debug_assert(in_frame <= 6, "theme worked out \{in_frame} times in one scrolled frame")
}

test "drag_frame: dragging the thumb scrolls the list, hover found again only as the drag ends" {
  let scroll = view::Scroll::new()
  let t = Tester::tree(fn(root : view::View) { drag_list_page(root, scroll) }, w=400.0, h=320.0, scale=1.5)
  t.frame(ms=16.0)
  let tree = match view_tree() {
    Some(tr) => tr
    None => { debug_assert(false, "tree"); return }
  }
  // (the bar shows as the pointer comes over it)
  t.move_to(395.0, 40.0)
  t.frame(ms=200.0)
  let th = match thumb_place(tree) {
    Some(d) => d
    None => { debug_assert(false, "a thumb in sight"); return }
  }
  let x = th.x + th.w * 0.5
  let y0 = th.y + th.h * 0.5
  t.press_at(x, y0)
  let before = scroll.at(tree)
  let mut k = 1
  while k <= 8 {
    t.fake.time = t.fake.time + 8.0
    t.move_to(x, y0 + k.to_double() * 20.0)
    k += 1
  }
  let moved = scroll.at(tree) - before
  debug_assert(moved > 100.0, "the thumb dragged 160pt scrolled the list (\{moved})")
  // (held by the drag: the rows under the pointer are not pointed at while it lasts)
  let during = tree.points_now()
  t.release(30.0, 100.0)
  let after = tree.points_now()
  debug_assert(during.is_none(), "nothing hovered while the thumb is dragged")
  debug_assert(after.is_some(), "the row under the pointer is hovered as the drag ends")
  t.dispose()
}

test "drag_frame: each move of a held thumb asks the host for a frame (a host that draws only when asked)" {
  let scroll = view::Scroll::new()
  let t = Tester::tree(fn(root : view::View) { drag_list_page(root, scroll) }, w=400.0, h=320.0, scale=1.5)
  t.frame(ms=16.0)
  let tree = match view_tree() {
    Some(tr) => tr
    None => { debug_assert(false, "tree"); return }
  }
  t.move_to(395.0, 40.0)
  t.frame(ms=200.0)
  let th = match thumb_place(tree) {
    Some(d) => d
    None => { debug_assert(false, "a thumb in sight"); return }
  }
  let x = th.x + th.w * 0.5
  let y0 = th.y + th.h * 0.5
  t.press_at(x, y0)
  t.frame(ms=16.0)
  // (the list moved by its offset alone: nothing in the tree marked, the host asked for the frame all the same)
  let mut k = 1
  while k <= 4 {
    t.fake.wants = false
    let was = scroll.at(tree)
    t.fake.time = t.fake.time + 8.0
    // (as a host hands a move over: the pointer's event alone, the frame left for the host to take if it is asked)
    let _ = view_pointer(1, x, y0 + k.to_double() * 20.0, 0)
    debug_assert(scroll.at(tree) > was, "move \{k} scrolled the list")
    debug_assert(t.fake.wants, "move \{k} asked the host for a frame")
    t.frame(ms=8.0)
    k += 1
  }
  t.release(x, y0 + 80.0)
  t.dispose()
}

test "drag_frame: host mouse-leave (kind 7) clears hover when idle and never moves an active drag" {
  let seen : Array[(view::DragIs, Double)] = []
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b
        .width(view::Live::Is(Some(300.0)))
        .height(view::Live::Is(Some(100.0)))
        .presses(view::Live::Is(true))
        .points(view::Live::Is(true))
        .on_drag(fn(d) { seen.push((d.kind, d.x)) }, captures=true)
    })
  }, w=400.0, h=200.0)
  t.frame(ms=16.0)
  let tree = match view_tree() {
    Some(tr) => tr
    None => { debug_assert(false, "tree"); return }
  }
  let _ = view_pointer(1, 120.0, 40.0, 0)
  debug_assert(tree.points_now().is_some(), "pointer over box sets hover")
  debug_assert(tree.pointed_now().is_some(), "pointer over box sets pointed_now")
  let _ = view_pointer(7, -1.0, -1.0, 0)
  debug_assert(tree.points_now().is_none(), "mouse-leave when idle clears points_now")
  debug_assert(tree.pointed_now().is_none(), "mouse-leave when idle clears pointed_now")

  let _ = view_pointer(0, 120.0, 40.0, 0)
  let _ = view_pointer(1, 180.0, 40.0, 0)
  let count_before_leave = seen.length()
  let _ = view_pointer(7, -1.0, -1.0, 0)
  debug_assert(seen.length() == count_before_leave, "mouse-leave during drag must not emit a Moved event")
  let _ = view_pointer(2, 180.0, 40.0, 0)
  t.dispose()
}
