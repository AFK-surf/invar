// Internal helpers, Ref forwarder, numeric clamps, safe 64-bit color constructors, and FNV-1a stable hashing.

import "signals"

pub fn dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

pub fn dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}

pub fn dclamp(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo { lo } else if v > hi { hi } else { v }
}

/// Safe 0xRRGGBBAA Int64 constructor from two 16-bit halves (avoids 32-bit signed int sign-extension).
pub fn c64(hi16 : Int, lo16 : Int) -> Int64 {
  ((hi16 & 0xFFFF).to_int64() << 16) | (lo16 & 0xFFFF).to_int64()
}

/// Safe 0xRRGGBBAA Int64 constructor from 8-bit channels.
pub fn rgba(r : Int, g : Int, b : Int, a : Int) -> Int64 {
  ((r & 0xFF).to_int64() << 24) |
  ((g & 0xFF).to_int64() << 16) |
  ((b & 0xFF).to_int64() << 8) |
  (a & 0xFF).to_int64()
}

struct PhysCounter {
  mut next : Int
}

let ui_phys_counter : PhysCounter = PhysCounter::{ next: 1 }

fn next_ui_id() -> Int {
  let id = ui_phys_counter.next
  ui_phys_counter.next = id + 1
  id
}

pub fn ref_new[T](v : T) -> signals::Ref[T] {
  signals::ref_new(v)
}

/// FNV-1a 64-bit stable hash over bytes (matches upstream stablehash.mbt).
pub fn stable_hash_bytes(data : Bytes) -> Int64 {
  // FNV offset basis 0xcbf29ce484222325, prime 0x100000001b3
  let mut h : Int64 = (0xCBF29CE4.to_int64() << 32) | ((0x8422.to_int64() << 16) | 0x2325.to_int64())
  let prime : Int64 = (0x00000100.to_int64() << 32) | 0x000001B3.to_int64()
  let n = data.length()
  let mut i = 0
  while i < n {
    h = (h ^ data[i].to_int().to_int64()) * prime
    i += 1
  }
  h
}

/// FNV-1a 64-bit stable hash over a string's UTF-16 code units.
pub fn stable_hash(s : String) -> Int64 {
  let mut h : Int64 = (0xCBF29CE4.to_int64() << 32) | ((0x8422.to_int64() << 16) | 0x2325.to_int64())
  let prime : Int64 = (0x00000100.to_int64() << 32) | 0x000001B3.to_int64()
  let n = s.length()
  let mut i = 0
  while i < n {
    let cu = s.code_unit_at(i)
    h = (h ^ (cu & 0xFF).to_int64()) * prime
    h = (h ^ ((cu >> 8) & 0xFF).to_int64()) * prime
    i += 1
  }
  h
}

import "halt"

fn exact_ok(v : Double, what : String) -> Double {
  if !(v >= 0.0) {
    halt::saying("style: \{what} Exact(\{v}) is below 0", "ui/00_helpers.pion")
  }
  v
}

pub fn str_has_prefix(s : String, pre : String) -> Bool {
  let n = s.length()
  let m = pre.length()
  if m > n {
    return false
  }
  let mut i = 0
  while i < m {
    if s.code_unit_at(i) != pre.code_unit_at(i) {
      return false
    }
    i += 1
  }
  true
}

pub fn str_contains(s : String, pat : String) -> Bool {
  let n = s.length()
  let m = pat.length()
  if m == 0 {
    return true
  }
  if m > n {
    return false
  }
  let mut i = 0
  while i <= n - m {
    let mut ok = true
    let mut j = 0
    while j < m {
      if s.code_unit_at(i + j) != pat.code_unit_at(j) {
        ok = false
        break
      }
      j += 1
    }
    if ok {
      return true
    }
    i += 1
  }
  false
}

pub fn array_remove_at[T](arr : Array[T], idx : Int) -> Unit {
  let n = arr.length()
  if idx < 0 || idx >= n {
    return
  }
  let mut i = idx
  while i + 1 < n {
    arr[i] = arr[i + 1]
    i += 1
  }
  let _ = arr.pop()
}
