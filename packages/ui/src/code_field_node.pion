import "hostapi"
import "mbt_compat"
import "signals"
import "text"
import "view"

// A code field (code_field.pion's head) as a node of the window's tree, made once: its boxes nodes bound to the Field's
// words, the field of the tree's over them (its words unseen) taking the typing; how big the boxes are and whether they
// go in one row or a row a group made by the room it is given as it is laid out (View::by_room), nothing of its layout
// read back. What is typed is kept to digits, `length` at most, as it is typed (the edit's own moment); the code told
// once it is complete, and again only once it changed (a digit taken back and typed again counts). A code refused is
// emptied by what holds the Field (Field::set): the next one typed is told, the same or not.

///|
/// How a code field's digits and edges are drawn: its digits' ink (`off` while it takes no typing), its boxes' edges,
/// the next one's while it has the keys, all of them while the code is wrong and nothing is typed.

#derive(Eq)
pub struct CodeInks {
  pub digits : Int64
  pub off : Int64
  pub edge : Int64
  pub next : Int64
  pub wrong : Int64
}

///|
/// What Ctx::code_field draws where nothing else is said.
// kept across runs: a value (no field of it changes)
// moved to 00_init_order.pion: code_inks

///|
/// The digit `ch` is, if it is one: a full-width digit (-, as a Chinese input method types them) as the digit it
/// is.
fn code_digit(ch : Char) -> Option[Char] {
  if ch >= '0' && ch <= '9' {
    Some(ch)
  } else if ch >= '\u{FF10}' && ch <= '\u{FF19}' {
    Some((ch.to_int() - 0xFF10 + '0'.to_int()).unsafe_to_char())
  } else {
    Option::None
  }
}

///|
/// The digits of `typed`, `length` at most.
fn code_digits(typed : String, length : Int) -> String {
  let b = StringBuilder()
  let mut n = 0
  { let __mbt_s_44 = typed; let __mbt_sn_44 = mbt_compat::str_byte_len(__mbt_s_44); let mut __mbt_sp_44 = 0; while __mbt_sp_44 < __mbt_sn_44 { let (__mbt_ch_44, __mbt_spn_44) = mbt_compat::str_cursor_step(__mbt_s_44, __mbt_sp_44); __mbt_sp_44 = __mbt_spn_44; let ch = __mbt_ch_44;
    if code_digit(ch) is Some(d) && n < length {
      b.write_char(d)
      n = n + 1
    }
  } }
  b.to_string()
}

///|
/// A code field in `parent` (the file's head; Ctx::code_field's look and sizes, each said the same way), editing
/// `input`: `typed` told the code at the moment it is complete (once a code). While `wrong()`, its boxes edged so while
/// nothing is typed; while not `enabled()`, its digits in `inks().off` and typing changes nothing. It takes the keys
/// as it is made unless not `autofocus`. `label`: what a screen reader calls it. The node (as wide as what holds it,
/// the boxes in its middle).

pub fn code_field_node(parent : view::View, input : Field, typed : (String) -> Unit, label? : String, length? : Int, groups? : Array[Int], wrong? : () -> Bool, enabled? : () -> Bool, autofocus? : Bool, box_w? : Double, box_h? : Double, min_scale? : Double, radius? : Double, gap? : Double, group_gap? : Double, font_size? : Double, weight? : Int, mono? : Bool, inks? : () -> CodeInks, loc~ : String = "") -> view::View {
  let label = match label { Some(__mbt_v) => __mbt_v, None => "" }
  let length = match length { Some(__mbt_v) => __mbt_v, None => 6 }
  let groups = match groups { Some(__mbt_v) => __mbt_v, None => [3, 3] }
  let wrong = match wrong { Some(__mbt_v) => __mbt_v, None => fn() { false } }
  let enabled = match enabled { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let autofocus = match autofocus { Some(__mbt_v) => __mbt_v, None => true }
  let box_w = match box_w { Some(__mbt_v) => __mbt_v, None => 42.0 }
  let box_h = match box_h { Some(__mbt_v) => __mbt_v, None => 52.0 }
  let min_scale = match min_scale { Some(__mbt_v) => __mbt_v, None => 0.8 }
  let radius = match radius { Some(__mbt_v) => __mbt_v, None => 12.0 }
  let gap = match gap { Some(__mbt_v) => __mbt_v, None => 8.0 }
  let group_gap = match group_gap { Some(__mbt_v) => __mbt_v, None => 8.0 }
  let font_size = match font_size { Some(__mbt_v) => __mbt_v, None => 24.0 }
  let weight = match weight { Some(__mbt_v) => __mbt_v, None => 600 }
  let mono = match mono { Some(__mbt_v) => __mbt_v, None => true }
  let inks = match inks { Some(__mbt_v) => __mbt_v, None => fn() { code_inks } }

  // (the groups as runs of boxes, [from, to); what they leave out one more)
  let rows : Array[(Int, Int)] = []
  let mut from = 0
  for n in groups {
    if from + n < length {
      rows.push((from, from + n))
      from = from + n
    }
  }
  rows.push((from, length))
  let widest = mbt_compat::arr_fold(rows, 0, fn(m, r) { if r.1 - r.0 > m { r.1 - r.0 } else { m } })
  let one_row = length.to_double() * box_w +
  (length - 1 + rows.length() - 1).to_double() * gap +
  (rows.length() - 1).to_double() * group_gap
  let group_row = widest.to_double() * box_w + (widest - 1).to_double() * gap
  // (the complete code last told: none since it was not complete; the digits it holds as last typed)
  let told : mbt_compat::Ref[Option[String]] = mbt_compat::ref_new(None)
  let kept = mbt_compat::ref_new(signals::untracked(fn() { code_digits(input.text(), length) }))
  parent.by_room(loc=loc, fn(held, room) {
    // As wide as its room: drawn smaller where one row is wider than that, down to `min_scale`; narrower still, a row
    // a group, as large as that room lets them be, never larger than asked.
    let fits = fn() { room.width() <= 0.0 || one_row * min_scale <= room.width() }
    let scale = fn() {
      let w = room.width()
      if w <= 0.0 {
        1.0
      } else {
        dmin(1.0, w / (if fits() { one_row } else { group_row }))
      }
    }
    let shown = fn() { code_digits(input.text(), length) }
    // the field itself over the boxes, its words unseen: a tap there gives it the keys (they take none of their own)
    let typing : mbt_compat::Ref[Option[view::View]] = mbt_compat::ref_new(None)
    held.box(fn(over) {
      over.over(view::Live::Is(true)) |> ignore
      let f = field(over, input, font_size=font_size, max_lines=1, line=box_h, color=0x00000000L, placeholder_color=0x00000000L, caret_color=0x00000000L, enter_sends=true, ime_action=hostapi::ime_action_number, label=label, edited=fn(t) {
        // (while it takes no typing, put back as it was; else digits only, `length` at most)
        if !enabled() {
          input.set(kept.v)
          return
        }
        let d = code_digits(t, length)
        if d != t {
          input.set(d)
        }
        kept.v = d
        if mbt_compat::utf16_len(d) == length && told.v != Some(d) {
          told.v = Some(d)
          typed(d)
        }
      })
      f.grow(.Is(1.0)) |> ignore
      typing.v = Some(f)
      if autofocus {
        input.focus()
      }
    })
    |> ignore
    held.lines_up(view::Live::Is(Some(.Middle))) |> ignore
    held.box(fn(boxes) {
      boxes
      .row(view::Live::By(fits))
      .lines_up(view::Live::Is(Some(.Middle)))
      .gap(view::Live::By(fn() { if fits() { gap * scale() * 2.0 + group_gap * scale() } else { gap * scale() } }))
      |> ignore
      for r in rows {
        boxes.box(fn(group) {
          group.row(view::Live::Is(true)).gap(view::Live::By(fn() { gap * scale() })) |> ignore
          for i in r.0..<r.1 {
            group.box(fn(b : view::View) {
              let b = b
              .width(.By(fn() { Some(box_w * scale()) }))
              .height(view::Live::By(fn() { Some(box_h * scale()) }))
              view::View::radius(b, .By(fn() { radius * scale() }), loc="code_field_node.pion:173:27")
              .edge(
                view::Live::By(fn() {
                  let k = inks()
                  let digits = shown()
                  let next = if mbt_compat::utf16_len(digits) < length - 1 { mbt_compat::utf16_len(digits) } else { length - 1 }
                  let ink = if wrong() && digits == "" {
                    k.wrong
                  } else if enabled() && i == next && mbt_compat::opt_map_or(typing.v, false, fn(f) { f.focused() }) {
                    k.next
                  } else {
                    k.edge
                  }
                  (1.0, ink)
                }),
              )
              .lines_up(view::Live::Is(Some(.Middle)))
              .lies_along(view::Live::Is(.Middle))
              |> ignore
              b.show(fn() { i < mbt_compat::utf16_len(shown()) }, fn(d) {
                d
                .words_runs(view::Live::By(fn() { [text::span(mbt_compat::str_scalars(shown())[i].to_string(), mono=mono)] }))
                .words_look(
                  view::Live::By(fn() {
                    { let __mbt_su_b_5 : view::WordsLook = view::words_plain; view::WordsLook::{ size: font_size * scale(), weight: weight, line: font_size * scale(), wrap: false, tracking: __mbt_su_b_5.tracking, balance: __mbt_su_b_5.balance, max_lines: __mbt_su_b_5.max_lines, tabular: __mbt_su_b_5.tabular, diagonal_fractions: __mbt_su_b_5.diagonal_fractions } }
                  }),
                )
                .ink(view::Live::By(fn() { if enabled() { inks().digits } else { inks().off } }))
                |> ignore
              })
            })
            |> ignore
          }
        })
        |> ignore
      }
    })
    |> ignore
    // (what it holds followed, whoever writes it; the code told forgotten as it holds less than a code (emptied for the
    // next try): typed again, it is told again)
    held.reacts(shown, fn(d) {
      kept.v = d
      if mbt_compat::utf16_len(d) < length {
        told.v = None
      }
    })
  })
}
