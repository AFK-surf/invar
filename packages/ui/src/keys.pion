/// Map an ASCII/Unicode character to its mbui key code (1000 + lowercase code point).
pub fn key_of_char(ch : Char) -> Int {
  let n = ch.to_int()
  let lower = if n >= 65 && n <= 90 { n + 32 } else { n }
  1000 + lower
}

/// Platform whose keyboard shortcuts apply (0 macOS, 1 iOS, 2 Android, 3 Windows, 4 Web, 5 Linux).
pub fn keys_system() -> Int {
  let k = hostapi::keys_platform()
  if k >= 0 { k } else { hostapi::platform() }
}

/// Whether Apple command shortcuts (Cmd vs Ctrl) apply on this host.
pub fn keys_apple() -> Bool {
  let k = keys_system()
  k == 0 || k == 1
}
