import "mbt_compat"

// A scripted run as a film (Tester::film): the film's frames at its own rate from the Tester's first frame on, each
// the picture of the last frame the run drew by its moment. Whoever films draws the pictures (ui/src/film: a host's
// renderer offscreen, over a Tester whose text and pictures are that host's, Tester::new's `live`); here only which
// picture each of the film's frames is, so that a film of a run is the run's frames, nothing waited for and nothing
// left out.

///|
/// The first frame that could not be drawn or written.

#derive(Eq)
pub enum FilmFailure {
  Draw
  Write(Int)
}

///|
/// A filmed run's log and, if a frame failed, what happened.
pub struct FilmRun {
  pub logs : Array[String]
  pub failure : Option[FilmFailure]
}

///|
/// `script` run over the view (Tester::drive: a frame at each of the display's frames, until it ends or `max` frames)
/// and filmed at `fps` frames a second from the Tester's first frame on: `draw` told of each frame drawn (the
/// Tester's first, then each the run draws), `put(k)` that the picture drawn last is the film's frame k, for every k
/// from 0 to the last in order, each once: the last drawn by a frame's moment is that frame's picture. A callback
/// returns false when its drawing or writing failed; no further frame is drawn or written, and the failure is returned
/// with the Tester's log. A completed drive still has to be checked for DRIVE PASS.
pub fn Tester::film(self : Tester, script : String, fps? : Double, max? : Int, draw~ : (Tester) -> Bool, put~ : (Int) -> Bool) -> FilmRun {
  let fps = match fps { Some(__mbt_v) => __mbt_v, None => 60.0 }
  let max = match max { Some(__mbt_v) => __mbt_v, None => 3000 }

  let t0 = self.fake.time
  let first = self.fake.logs.copy()
  // the film's frame the picture drawn last is
  let shown = mbt_compat::ref_new(0)
  let failure : mbt_compat::Ref[Option[FilmFailure]] = mbt_compat::ref_new(None)
  if !draw(self) {
    return FilmRun::{ logs: first, failure: Some(FilmFailure::Draw) }
  }
  let logs = self.drive_while(script, max=max, each=fn(t) {
    let k = ((t.fake.time - t0) * fps / 1000.0).round().to_int()
    while shown.v < k {
      if !put(shown.v) {
        failure.v = Some(Write(shown.v))
        return false
      }
      shown.v = shown.v + 1
    }
    if !draw(t) {
      failure.v = Some(Draw)
      return false
    }
    true
  })
  if failure.v is Option::None && !put(shown.v) {
    failure.v = Some(Write(shown.v))
  }
  FilmRun::{ logs: mbt_compat::arr_concat(first, logs), failure: failure.v }
}

///|
/// Stop a scripted run at film frame `frame`, where frame 0 is the picture before its first step. A frame is reached
/// only if the run has not failed or ended before it. The tester's display period must be set to the film's rate.
/// The returned log explains a failed step; stopping at a requested frame is not a failed drive.
pub fn Tester::film_frame(self : Tester, script : String, frame : Int, max? : Int) -> (Bool, Array[String]) {
  let max = match max { Some(__mbt_v) => __mbt_v, None => 3000 }

  self.fake.logs.clear()
  if frame < 0 || frame > max {
    return (false, self.fake.logs.copy())
  }
  drive_start(script, "")
  let mut n = 0
  while n < frame && driver.v is Some(_) {
    self.frame()
    n = n + 1
  }
  let logs = self.fake.logs.copy()
  let failed = mbt_compat::arr_iter(logs).any(fn(line) { mbt_compat::str_has_prefix(line, "DRIVE FAIL") || line == "DRIVE END 1" })
  // This is a requested prefix, not a failure of the script and not an instruction to quit the app.
  driver.v = None
  (n == frame && !failed, logs)
}

///|
/// What the last frame presented, as a host's renderer is given it (@hostapi.present): its instances (scene.pion's,
/// `inst_size` numbers each: the Tester's own, read, not changed), how many, and what is under them (red, green,
/// blue, 0-1).
pub fn Tester::presented(self : Tester) -> (FixedArray[Double], Int, (Double, Double, Double)) {
  self.reads_own()
  ignore(self)
  let c = g()
  (c.inst, c.ninst, c.clear)
}

///|
/// The live host's picture for the Tester's image `id` (Tester::new's `live`), what that host's renderer draws an
/// instance of it by; None for one it has not (a stream's frame, a picture a test made up, one that did not decode).
pub fn Tester::live_image(self : Tester, id : Int) -> Option[Int] {
  self.fake.live_images.get(id)
}
