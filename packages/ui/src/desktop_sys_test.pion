// End-to-end tests for desktop & system integration:
// window_zoom, drop (words/paths/files), files (pick/keep/gallery_read/update_*), and gamepads_follow.

import "hostapi"
import "view"
import "signals"

test "desktop_sys: window_zoom clamping, coordinate conversion, and Cmd/Ctrl +/-/0 shortcuts" {
  let host_zoom = ref_new(1.0)
  let t = Tester::tree(
    fn(_root : view::View) { () },
    platform=0,
    begun=fn() {
      let h = hostapi::host()
      h.set_window_zoom = fn(z : Double) { host_zoom.v = z }
    },
  )
  set_window_zoom(1.0)
  debug_assert(window_zoom_supported(), "macOS supports window zoom")
  debug_assert((window_zoom() - 1.0).abs() < 1.0e-6, "reset sets 1.0")

  set_window_zoom(0.1)
  debug_assert((window_zoom() - 0.5).abs() < 1.0e-6 && (host_zoom.v - 0.5).abs() < 1.0e-6, "clamps low to 0.5")
  set_window_zoom(9.0)
  debug_assert((window_zoom() - 3.0).abs() < 1.0e-6 && (host_zoom.v - 3.0).abs() < 1.0e-6, "clamps high to 3.0")

  set_window_zoom(2.0)
  t.frame(ms=16.0)
  debug_assert((window_points_to_content(100.0) - 50.0).abs() < 1.0e-6, "points_to_content divides by zoom")
  debug_assert((host_zoom.v - 2.0).abs() < 1.0e-6, "set_window_zoom notifies host")
  debug_assert((tree_window_zoom.v.get() - 2.0).abs() < 1.0e-6, "set_window_zoom updates tree_window_zoom on next frame")

  // Incremental zoom in/out and reset
  set_window_zoom(window_zoom() + 0.1)
  t.frame(ms=16.0)
  debug_assert((window_zoom() - 2.1).abs() < 1.0e-6, "zoomed in to 2.1")
  debug_assert((host_zoom.v - 2.1).abs() < 1.0e-6, "host notified of 2.1")
  set_window_zoom(window_zoom() - 0.1)
  t.frame(ms=16.0)
  debug_assert((window_zoom() - 2.0).abs() < 1.0e-6, "zoomed out to 2.0")
  set_window_zoom(1.0)
  t.frame(ms=16.0)
  debug_assert((window_zoom() - 1.0).abs() < 1.0e-6, "reset to 1.0")
  debug_assert((host_zoom.v - 1.0).abs() < 1.0e-6, "reset notifies host of 1.0")
  debug_assert((window_points_to_content(100.0) - 100.0).abs() < 1.0e-6, "1.0 zoom identity conversion")
  debug_assert((tree_window_zoom.v.get() - 1.0).abs() < 1.0e-6, "tree_window_zoom reset to 1.0")
  t.dispose()
}

test "desktop_sys: pure-node drop targets for words_into, paths_into, and files_into" {
  let fld = Field::new(text="Hi ")
  let fld_p = Field::new()
  let fld_f = Field::new()
  let got_paths : signals::Ref[Array[DroppedPath]] = ref_new([])
  let got_files : signals::Ref[Array[hostapi::Picked]] = ref_new([])
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(w : view::View) {
        let _ = words_into(w.over_xy(0.0, 0.0).width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0))), fld)
      })
      let _ = root.box(fn(p : view::View) {
        let _ = paths_into(
          p.over_xy(0.0, 50.0).width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0))),
          fld_p,
          fn(ps : Array[DroppedPath]) { got_paths.v = ps },
        )
      })
      let _ = root.box(fn(f : view::View) {
        let _ = files_into(
          f.over_xy(0.0, 100.0).width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0))),
          fld_f,
          fn(fs : Array[hostapi::Picked]) { got_files.v = fs },
        )
      })
    },
    w=200.0,
    h=200.0,
  )

  debug_assert(takes_drops(), "desktop FakeHost takes_drops")
  t.drop_words(20.0, 20.0, "there")
  t.draw()
  debug_assert(fld.text() == "Hi there", "Field received dropped words")
  debug_assert(got_paths.v.length() == 0, "words drop did not fire paths_into")

  t.drop_files(20.0, 70.0, [], paths=["/tmp/a.txt"])
  t.draw()
  debug_assert(got_paths.v.length() == 1, "paths_into received 1 DroppedPath")
  debug_assert(got_paths.v[0].path == "/tmp/a.txt", "paths_into preserved path")

  t.drop_files(20.0, 120.0, [("pic.png", "png".to_bytes())])
  t.draw()
  debug_assert(got_files.v.length() == 1, "files_into received 1 Picked file")
  debug_assert(got_files.v[0].name == "pic.png" && got_files.v[0].bytes.length() == 3, "files_into preserved name and bytes")

  t.dispose()
}

test "desktop_sys: FilePick, FileKeep, keep_bytes, GalleryRead, and update_* bridge" {
  let t = Tester::tree(fn(_root : view::View) { () }, platform=0)
  t.picks([("report.pdf", "PDFDATA".to_bytes())])
  match pick(hostapi::PickKind::Files) {
    Some(fp) => {
      t.draw()
      match fp.files() {
        Some(fs) => {
          debug_assert(fs.length() == 1, "pick read 1 file")
          debug_assert(fs[0].name == "report.pdf", "pick read report.pdf")
          debug_assert(fs[0].bytes.length() == 7, "pick preserved 7-byte payload")
        }
        None => debug_assert(false, "expected picked files")
      }
    }
    None => debug_assert(false, "expected pick Some")
  }

  match keep("out.bin", "application/octet-stream", "hello".to_bytes(), way=hostapi::KeepWay::Downloads) {
    Some(fk) => {
      debug_assert(t.kept().length() == 1, "keep recorded 1 file")
      debug_assert(t.kept()[0].0 == "out.bin", "keep recorded out.bin")
      debug_assert(t.kept()[0].2.length() == 5, "keep wrote 5 bytes")
      fk.end()
    }
    None => debug_assert(false, "expected keep Some")
  }

  t.gallery([hostapi::GalleryPhoto::{ id: 42L, src: "photo://42", added: 100L, modified: 100L, taken: 100L, video: false }])
  match gallery_read() {
    Some(gr) => {
      t.draw()
      match gr.photos() {
        Some(ps) => {
          debug_assert(ps.length() == 1, "gallery_read returned 1 photo")
          debug_assert(ps[0].src == "photo://42" && ps[0].id == 42L, "gallery_read parsed photo id and src")
        }
        None => debug_assert(false, "expected gallery photos")
      }
    }
    None => debug_assert(false, "expected gallery_read Some")
  }

  update_fetch("https://example.invalid/app.dmg", "abc", 1024.0, "v2.0", false, "")
  debug_assert(t.update_asked().length() == 1, "update_fetch forwarded")
  update_apply("v2.0")
  debug_assert(t.update_asked().length() >= 2, "update_apply forwarded")
  t.dispose()
}

test "desktop_sys: gamepad_normalize_axis dead-zone and gamepads_follow polling" {
  let seen_count = ref_new(0)
  let last_buttons = ref_new(0)
  let last_lx = ref_new(0.0)
  let last_rt = ref_new(0.0)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
      gamepads_follow(b, fn() { true }, fn(_idx : Int, pad : Option[hostapi::Gamepad]) {
        seen_count.v = seen_count.v + 1
        match pad {
          Some(p) => {
            last_buttons.v = p.buttons
            last_lx.v = p.lx
            last_rt.v = p.rt
          }
          None => ()
        }
      })
    })
  })
  // Inside dead zone -> reported 0.0
  t.set_gamepads([hostapi::Gamepad::{ index: 0, buttons: 5, lx: 0.04, ly: 0.0, rx: 0.0, ry: 0.0, lt: 0.0, rt: 0.5 }])
  t.frame(ms=1050.0)
  debug_assert(seen_count.v >= 1, "gamepads_follow invoked on pad connect")
  debug_assert(last_buttons.v == 5, "buttons bitmask forwarded")
  debug_assert((last_rt.v - 0.5).abs() < 1.0e-5, "right trigger forwarded")
  // Above dead zone -> non-zero stick deflection forwarded
  t.set_gamepads([hostapi::Gamepad::{ index: 0, buttons: 7, lx: 0.75, ly: -0.5, rx: 0.0, ry: 0.0, lt: 0.0, rt: 1.0 }])
  t.frame(ms=1050.0)
  debug_assert(last_buttons.v == 7, "updated buttons forwarded")
  debug_assert((last_lx.v - 0.75).abs() < 1.0e-5, "updated lx forwarded")
  debug_assert((last_rt.v - 1.0).abs() < 1.0e-5, "updated rt forwarded")
  // Disconnect -> None delivered
  t.set_gamepads([])
  t.frame(ms=1050.0)
  debug_assert(seen_count.v >= 3, "gamepads_follow notified on disconnect")
  t.dispose()
}
