// Incremental accessibility semantics tree (SemNode, A11yMirror, A11yTold).
// Ported from libs/mbui/src/ui/a11y.mbt and semantics.mbt.

import "view"
import "hostapi"
import "signals"

let a11y_sep : String = "\u{1F}"

/// Accessibility semantics node emitted to screen readers and verified by Tester::set_a11y.
pub struct SemNode {
  pub id : Int
  pub role : String
  pub flags : String
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
  pub label : String
  pub value : String
  pub description : String
  pub range : Option[(Double, Double, Double)]
  pub actions : String
  pub widget : Int
  pub kids : Array[Int]
}

fn sem_kids_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() { return false }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] { return false }
    i += 1
  }
  true
}

fn sem_range_eq(a : Option[(Double, Double, Double)], b : Option[(Double, Double, Double)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((a0, a1, a2)), Some((b0, b1, b2))) =>
      (a0 - b0).abs() < 0.001 && (a1 - b1).abs() < 0.001 && (a2 - b2).abs() < 0.001
    _ => false
  }
}

fn sem_node_eq(a : SemNode, b : SemNode) -> Bool {
  a.id == b.id &&
  a.role == b.role &&
  a.flags == b.flags &&
  (a.x - b.x).abs() < 0.001 &&
  (a.y - b.y).abs() < 0.001 &&
  (a.w - b.w).abs() < 0.001 &&
  (a.h - b.h).abs() < 0.001 &&
  a.label == b.label &&
  a.value == b.value &&
  a.description == b.description &&
  sem_range_eq(a.range, b.range) &&
  a.actions == b.actions &&
  a.widget == b.widget &&
  sem_kids_eq(a.kids, b.kids)
}

/// Host-side mirror of the incremental accessibility tree.
pub struct A11yMirror {
  pub nodes : Map[Int, SemNode]
  pub holder : Map[Int, Int]
  pub mut focus : Int
}

pub fn A11yMirror::new() -> A11yMirror {
  A11yMirror::{ nodes: Map::new(), holder: Map::new(), focus: 0 }
}

pub fn A11yMirror::apply(self : A11yMirror, full : Bool, focus : Int, told : Array[SemNode]) -> Array[Int] {
  let gone : Array[Int] = []
  if full {
    for k in self.nodes.keys() {
      gone.push(k)
    }
    self.nodes.clear()
    self.holder.clear()
  }
  self.focus = focus
  let held : Map[Int, Bool] = Map::new()
  for n in told {
    for k in n.kids {
      held[k] = true
    }
  }
  let let_go : Array[Int] = []
  for n in told {
    match self.nodes.get(n.id) {
      Some(was) => {
        for k in was.kids {
          if !n.kids.contains(k) {
            let_go.push(k)
          }
        }
      }
      None => ()
    }
    self.nodes[n.id] = n
    for k in n.kids {
      self.holder[k] = n.id
    }
  }
  let mut i = 0
  while i < let_go.length() {
    let k = let_go[i]
    i += 1
    if held.contains(k) {
      continue
    }
    match self.nodes.get(k) {
      Some(n) => {
        self.nodes.remove(k)
        self.holder.remove(k)
        gone.push(k)
        for c in n.kids {
          let_go.push(c)
        }
      }
      None => ()
    }
  }
  gone
}

pub fn A11yMirror::lines(self : A11yMirror) -> String {
  let sb = StringBuilder::new()
  let visited : Array[(Int, Int, Double, Double)] = [(0, 0, 0.0, 0.0)]
  // DFS traversal in child order using an explicit stack
  while visited.length() > 0 {
    let top_idx = visited.length() - 1
    let (k, holder, px, py) = visited[top_idx]
    array_remove_at(visited, top_idx)
    match self.nodes.get(k) {
      Some(n) => {
        let x = px + n.x
        let y = py + n.y
        if k != 0 {
          let flags = if self.focus == k { n.flags + "f" } else { n.flags }
          sb.write_string("\{k}\{a11y_sep}\{holder}\{a11y_sep}\{n.widget}\{a11y_sep}\{n.role}\{a11y_sep}\{flags}\{a11y_sep}\{x.round().to_int()}\{a11y_sep}\{y.round().to_int()}\{a11y_sep}\{n.w.round().to_int()}\{a11y_sep}\{n.h.round().to_int()}\{a11y_sep}\{n.label}\{a11y_sep}\{n.value}\{a11y_sep}\{n.description}\{a11y_sep}\{n.actions}\n")
        }
        let next_holder = if k != 0 { k } else { holder }
        let mut ci = n.kids.length() - 1
        while ci >= 0 {
          visited.push((n.kids[ci], next_holder, x, y))
          ci -= 1
        }
      }
      None => ()
    }
  }
  sb.to_string()
}

fn append_action_letter(sb : StringBuilder, seen : String, ch : String) -> String {
  if seen.contains(ch) {
    return seen
  }
  sb.write_string(ch)
  seen + ch
}

fn encode_sem_actions(tree : view::Tree, id : view::NodeId, actions : Array[view::Action]) -> String {
  let sb = StringBuilder::new()
  let mut seen = ""
  for act in actions {
    let letter = match act {
      view::Action::Activate => "a"
      view::Action::Increment => "i"
      view::Action::Decrement => "d"
      view::Action::Expand => "e"
      view::Action::Collapse => "c"
      view::Action::Dismiss => "x"
      view::Action::Focus => "f"
      view::Action::SetText(_) => "t"
    }
    seen = append_action_letter(sb, seen, letter)
  }
  if tree.acts_on(id) {
    seen = append_action_letter(sb, seen, "a")
    if tree.steps_do(id) {
      seen = append_action_letter(sb, seen, "i")
      seen = append_action_letter(sb, seen, "d")
    }
  }
  sb.to_string()
}

/// Build full SemNode snapshot from a view::Tree, preserving semantic parent-child hierarchy
/// and parent-relative coordinates expected by native hosts and A11yMirror.
pub fn tree_sem_nodes(tree : view::Tree) -> (Array[SemNode], Int) {
  let order = tree.said_order()
  let n_order = order.length()
  let mut focus_id = 0
  let (focused_nid, _) = tree.focused_now()
  let abs_x : Array[Double] = []
  let abs_y : Array[Double] = []
  let abs_w : Array[Double] = []
  let abs_h : Array[Double] = []
  let nids : Array[Int] = []
  let kids_by_nid : Map[Int, Array[Int]] = Map::new()
  kids_by_nid[0] = []

  let mut idx = 0
  while idx < n_order {
    let sn = order[idx]
    let (dx, dy, dw, dh) = match tree.drawn_of(sn.id) {
      Some(d) => (d.x, d.y, d.w, d.h)
      None => (0.0, 0.0, 0.0, 0.0)
    }
    abs_x.push(dx)
    abs_y.push(dy)
    abs_w.push(dw)
    abs_h.push(dh)
    match sn.said {
      Some(_) => {
        let nid = sn.id.at + 1
        nids.push(nid)
        kids_by_nid[nid] = []
      }
      None => nids.push(0)
    }
    idx += 1
  }

  let parent_idx_of : Array[Int] = []
  idx = 0
  while idx < n_order {
    let sn = order[idx]
    if nids[idx] == 0 {
      parent_idx_of.push(-1)
      idx += 1
      continue
    }
    let mut pidx = sn.parent
    while pidx >= 0 && pidx < n_order && nids[pidx] == 0 {
      pidx = order[pidx].parent
    }
    if pidx < 0 || pidx >= n_order {
      pidx = -1
    }
    parent_idx_of.push(pidx)
    let parent_nid = if pidx >= 0 { nids[pidx] } else { 0 }
    match kids_by_nid.get(parent_nid) {
      Some(ks) => ks.push(nids[idx])
      None => {
        let ks : Array[Int] = [nids[idx]]
        kids_by_nid[parent_nid] = ks
      }
    }
    idx += 1
  }

  let out : Array[SemNode] = []
  idx = 0
  while idx < n_order {
    let sn = order[idx]
    let sd = match sn.said {
      Some(v) => v
      None => {
        idx += 1
        continue
      }
    }
    let nid = nids[idx]
    match focused_nid {
      Some(fnid) => if fnid == sn.id { focus_id = nid }
      None => ()
    }
    let rname = role_name(sd.role)
    let flags_sb = StringBuilder::new()
    match sd.check {
      Some(view::Check::Off) => flags_sb.write_string("c")
      Some(view::Check::On) => flags_sb.write_string("C")
      Some(view::Check::Mixed) => flags_sb.write_string("M")
      None => ()
    }
    match sd.expanded {
      Some(false) => flags_sb.write_string("e")
      Some(true) => flags_sb.write_string("E")
      None => ()
    }
    match sd.selected {
      Some(true) => flags_sb.write_string("s")
      _ => ()
    }
    match sd.pressed {
      Some(true) => flags_sb.write_string("p")
      _ => ()
    }
    if sn.disabled { flags_sb.write_string("d") }
    let pidx = parent_idx_of[idx]
    let px = if pidx >= 0 { abs_x[pidx] } else { 0.0 }
    let py = if pidx >= 0 { abs_y[pidx] } else { 0.0 }
    let x = abs_x[idx] - px
    let y = abs_y[idx] - py
    let w = abs_w[idx]
    let h = abs_h[idx]
    let lbl = if sd.label.length() > 0 { sd.label } else { tree.said_label(sn.id) }
    let kids = match kids_by_nid.get(nid) {
      Some(ks) => ks
      None => []
    }
    out.push(SemNode::{
      id: nid,
      role: rname,
      flags: flags_sb.to_string(),
      x,
      y,
      w,
      h,
      label: lbl,
      value: sd.value,
      description: sd.description,
      range: sd.range,
      actions: encode_sem_actions(tree, sn.id, sd.actions),
      widget: nid,
      kids,
    })
    idx += 1
  }
  let root_kids = match kids_by_nid.get(0) {
    Some(ks) => ks
    None => []
  }
  let root = SemNode::{
    id: 0,
    role: "Region",
    flags: "",
    x: 0.0,
    y: 0.0,
    w: 0.0,
    h: 0.0,
    label: "",
    value: "",
    description: "",
    range: None,
    actions: "",
    widget: 0,
    kids: root_kids,
  }
  let all : Array[SemNode] = [root]
  for n in out {
    all.push(n)
  }
  (all, focus_id)
}

/// Incremental sender state tracking what was last sent to the host.
pub struct A11yTold {
  pub mirror : A11yMirror
  pub node_ids : Map[Int, view::NodeId]
  pub mut initialized : Bool
}

pub fn A11yTold::new() -> A11yTold {
  A11yTold::{ mirror: A11yMirror::new(), node_ids: Map::new(), initialized: false }
}

/// Active window's incremental a11y state.
pub fn view_a11y_told() -> A11yTold {
  view_app.a11y
}

/// Reversible field escaping for the `\x1f`-delimited, `\n`-terminated a11y wire format.
/// Escapes `\` -> `\\`, `\n` -> `\n`, `\r` -> `\r`, `\x1f` -> `\u001f`.
pub fn escape_sem_field(s : String) -> String {
  let n = s.length()
  let mut needs = false
  let mut i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 || b == 10 || b == 13 || b == 31 {
      needs = true
      break
    }
    i += 1
  }
  if !needs {
    return s
  }
  let sb = StringBuilder::new()
  i = 0
  while i < n {
    let b = s.code_unit_at(i)
    if b == 92 {
      sb.write_string("\\\\")
    } else if b == 10 {
      sb.write_string("\\n")
    } else if b == 13 {
      sb.write_string("\\r")
    } else if b == 31 {
      sb.write_string("\\u001f")
    } else {
      sb.write_byte(b as Byte)
    }
    i += 1
  }
  sb.to_string()
}

fn encode_sem_wire(full : Bool, focus : Int, changed : Array[SemNode]) -> String {
  let sb = StringBuilder::new()
  let fflag = if full { "1" } else { "0" }
  sb.write_string("T\{a11y_sep}\{fflag}\{a11y_sep}\{focus}\n")
  for n in changed {
    let kids_sb = StringBuilder::new()
    let mut i = 0
    while i < n.kids.length() {
      if i > 0 { kids_sb.write_string(",") }
      kids_sb.write_string("\{n.kids[i]}")
      i += 1
    }
    let lbl = escape_sem_field(n.label)
    let val_s = escape_sem_field(n.value)
    let desc = escape_sem_field(n.description)
    let (r_low, r_at, r_high) = match n.range {
      Some((lo, at_v, hi)) => ("\{lo}", "\{at_v}", "\{hi}")
      None => ("", "", "")
    }
    sb.write_string("N\{a11y_sep}\{n.id}\{a11y_sep}\{n.role}\{a11y_sep}\{n.flags}\{a11y_sep}\{n.x.round().to_int()}\{a11y_sep}\{n.y.round().to_int()}\{a11y_sep}\{n.w.round().to_int()}\{a11y_sep}\{n.h.round().to_int()}\{a11y_sep}\{lbl}\{a11y_sep}\{val_s}\{a11y_sep}\{desc}\{a11y_sep}\{r_low}\{a11y_sep}\{r_at}\{a11y_sep}\{r_high}\{a11y_sep}\{n.actions}\{a11y_sep}\{n.widget}\{a11y_sep}\{kids_sb.to_string()}\n")
  }
  sb.to_string()
}

/// Dispatch an incoming accessibility semantic action JSON on `hostapi::a11y_channel`
/// (`{"action":"resend"}` or `{"id": N, "action"|"op": "press"|"activate"|"inc"|"increment"|"dec"|"decrement"|"focus"|"dismiss"|"set_text", ...}`)
/// directly to the matching node in the active `view_tree()` by node identity (`sn.id.at + 1 == id`)
/// with generation validation against the last synced tree.
pub fn a11y_handle_action(json : String) -> Bool {
  let obj = match hostapi::json_parse(json) {
    Some(hostapi::JsonValue::JObject(m)) => m
    _ => return false
  }
  let op = match obj.get("action") {
    Some(hostapi::JsonValue::JString(s)) => s
    _ => match obj.get("op") {
      Some(hostapi::JsonValue::JString(s)) => s
      _ => return false
    }
  }
  if op == "resend" {
    view_app.a11y.initialized = false
    view_app.a11y.node_ids.clear()
    hostapi::request_frame()
    return true
  }
  let nid = match obj.get("id") {
    Some(hostapi::JsonValue::JNumber(v)) => v.to_int()
    _ => return false
  }
  if nid <= 0 {
    return false
  }
  let tree = match view_tree() {
    Some(t) => t
    None => return false
  }
  let mut target : Option[view::NodeId] = None
  for sn in tree.said_order() {
    if sn.id.at + 1 == nid {
      target = Some(sn.id)
      break
    }
  }
  let node_id = match target {
    Some(id) => id
    None => return false
  }
  match view_app.a11y.node_ids.get(nid) {
    Some(expected) => {
      if expected.gen != node_id.gen {
        return false
      }
    }
    None => ()
  }
  let now = hostapi::now()
  let mut ok = false
  signals::start_batch()
  if op == "press" || op == "activate" || op == "expand" || op == "collapse" {
    ok = tree.activate_at(node_id, now)
  } else if op == "inc" || op == "increment" {
    ok = tree.step_at(node_id, 1, now)
  } else if op == "dec" || op == "decrement" {
    ok = tree.step_at(node_id, -1, now)
  } else if op == "focus" {
    ok = tree.focus_to(Some(node_id), visible=true)
  } else if op == "dismiss" {
    ok = tree.ask_action("dismiss", now, from=Some(node_id))
    if !ok {
      ok = tree.key_at(key_escape, 0, now)
    }
  } else if op == "set_text" {
    let txt_opt = match obj.get("text") {
      Some(hostapi::JsonValue::JString(s)) => Some(s)
      _ => match obj.get("value") {
        Some(hostapi::JsonValue::JString(s)) => Some(s)
        _ => None
      }
    }
    match txt_opt {
      Some(txt) => {
        let _ = tree.focus_to(Some(node_id), visible=true)
        let already_focused = match focused_field_ref.v {
          Some(f) if f.focused_sig.untracked() => true
          _ => false
        }
        if !already_focused {
          let _ = tree.activate_at(node_id, now)
        }
        match focused_field_ref.v {
          Some(f) if f.focused_sig.untracked() => {
            f.set(txt)
            ok = true
          }
          _ => {
            match view_app.text_interceptor {
              Some(_) => {
                view_text(0, txt)
                ok = true
              }
              None => ()
            }
          }
        }
      }
      None => ()
    }
  }
  signals::end_batch()
  if ok {
    hostapi::request_frame()
  }
  ok
}

fn record_a11y_node_ids(tree : view::Tree, dst : Map[Int, view::NodeId]) -> Unit {
  dst.clear()
  for sn in tree.said_order() {
    match sn.said {
      Some(_) => {
        dst[sn.id.at + 1] = sn.id
      }
      None => ()
    }
  }
}

/// Compute and send incremental a11y update for `tree` against `told`.
/// Returns (wire_string, changed_nodes_count, full_sent).
pub fn a11y_sync(tree : view::Tree, told : A11yTold, force_full~ : Bool = false) -> (String, Int, Bool) {
  let (all, focus) = tree_sem_nodes(tree)
  record_a11y_node_ids(tree, told.node_ids)
  record_a11y_node_ids(tree, view_app.a11y.node_ids)
  let full = force_full || !told.initialized
  let changed : Array[SemNode] = []
  if full {
    for n in all {
      changed.push(n)
    }
  } else {
    for n in all {
      match told.mirror.nodes.get(n.id) {
        Some(prev) => if !sem_node_eq(prev, n) { changed.push(n) }
        None => changed.push(n)
      }
    }
  }
  if !full && changed.length() == 0 && told.mirror.focus == focus {
    return ("", 0, false)
  }
  let _ = told.mirror.apply(full, focus, changed)
  told.initialized = true
  let wire = encode_sem_wire(full, focus, changed)
  hostapi::a11y_tree(wire)
  (wire, changed.length(), full)
}
