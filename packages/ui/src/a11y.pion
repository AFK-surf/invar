    __mbt_cap_2_sb.write_char('\n')
  }
  let next = if own && k != 0 { k } else { holder }
  for c in n.kids {
    __mbt_local_A11yMirror__lines_put_2(__mbt_cap_2_sb, __mbt_cap_2_self, c, next, x, y)
  }
}

fn __mbt_local_A11yMirror__dump_put_3(__mbt_cap_3_sb : StringBuilder, __mbt_cap_3_self : A11yMirror, k : Int, depth : Int) -> Unit {
  guard __mbt_cap_3_self.nodes.get(k) is Some(n) else { return }
  let own = k != 0 && !n.flags.contains("v")
  if own {
    for _ in 0..<depth {
