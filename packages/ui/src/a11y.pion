  self.focus = focus
  // (what this update's hold: none of it gone, wherever it was)
  let held : mbt_compat::OrderedMap[Int, Bool] = mbt_compat::ordered_map_new()
  for n in told {
    for k in n.kids {
      held.set(k, true)
    }
  }
  let let_go : Array[Int] = []
  for n in told {
    match self.nodes.get(n.id) {
      Some(was) =>
      if was.kids.length() > 8 && !n.kids.is_empty() {
        let now_kids : mbt_compat::OrderedMap[Int, Bool] = mbt_compat::ordered_map_new()
        for k in n.kids {
          now_kids.set(k, true)
        }
        for k in was.kids {
          if !now_kids.contains(k) {
            let_go.push(k)
          }
        }
      } else {
        for k in was.kids {
          if !n.kids.contains(k) {
            let_go.push(k)
          }
        }
      }
      Option::None => ()
    }
    self.nodes.set(n.id, n)
    for k in n.kids {
      self.holder.set(k, n.id)
    }
  }
  let __mbt_cap_1_gone = gone; let __mbt_cap_1_held = held; let __mbt_cap_1_self = self; ()

  for k in let_go {
    __mbt_local_A11yMirror__apply_drop_1(__mbt_cap_1_gone, __mbt_cap_1_held, __mbt_cap_1_self, k)
  }
