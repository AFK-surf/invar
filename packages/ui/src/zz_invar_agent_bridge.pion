// INVAR-EXT: Render-thread causal ring and Redacted[T] extensions for AgentBridge and Worker.

import "causal"
import "redacted"
import "view"

let ui_causal_ring_inst : causal::CausalRing = causal::CausalRing::new(256)

fn ui_causal_ring_reset() -> Unit {
  ui_causal_ring_inst.reset()
}

let __invar_init_ui_causal_reset : Unit = {
  on_reset(ui_causal_ring_reset)
}

/// Access the render-thread causal ring (disabled by default; zero allocation when disabled).
/// Automatically disabled and cleared on every `Tester` reset via `on_reset`.
pub fn causal_ring() -> causal::CausalRing {
  ui_causal_ring_inst
}

fn agent_run_step_action(
  tree : view::Tree,
  entry : AgentEntry,
  action : AgentAction,
  at : Double,
) -> Bool {
  match action {
    AgentAction::Press => {
      let ran = tree.activate_at(entry.node_id, at)
      if ran {
        agent_mark_frame_owed(tree)
      }
      ran
    }
    AgentAction::Focus => {
      let ran = tree.focus_to(Some(entry.node_id), visible=true)
      if ran {
        agent_mark_frame_owed(tree)
      }
      ran
    }
    AgentAction::Increment => {
      let ran = tree.step_at(entry.node_id, 1, at)
      if ran {
        agent_mark_frame_owed(tree)
      }
      ran
    }
    AgentAction::Decrement => {
      let ran = tree.step_at(entry.node_id, -1, at)
      if ran {
        agent_mark_frame_owed(tree)
      }
      ran
    }
    AgentAction::SetValue(val_) =>
    match agent_writers.get(entry.node_id) {
      Some(write) => {
        tree.event(at, fn() { write(val_) })
        agent_mark_frame_owed(tree)
        true
      }
      Option::None => {
        let ran = mbt_compat::ref_new(false)
        tree.event(at, fn() {
          ran.v = tree_field_asked(entry.node_id, view::Action::SetText(val_))
        })
        if ran.v {
          agent_mark_frame_owed(tree)
        }
        ran.v
      }
    }
  }
}

/// Register a redacted programmatic value writer on `v`.
/// Automatically marks `v` (and its subtree) with `agent_secret(v)` so values are always
/// redacted to `"[redacted]"` in snapshots/JSON and excluded from `agent_query` side-channel
/// search, while delivering typed `redacted::Redacted[String]` to `write`.
pub fn agent_value_writer_redacted(
  v : view::View,
  write : (redacted::Redacted[String]) -> Unit,
) -> Unit {
  if !v.alive() {
    return
  }
  agent_secret(v)
  agent_value_writer(v, fn(raw : String) -> Unit {
    write(redacted::Redacted::new(raw))
  })
}
