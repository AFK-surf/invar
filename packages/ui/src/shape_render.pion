// GPU vector shape encoding: horizontal band bucketing (kind = 11.0) and
// frame-tail segment data packs (kind = 12.0, 6 segments per 60-Double instance).
// Ported 1:1 from libs/mbui/src/ui/shape.mbt.

import "paint"
import "pixels"
import "view"

struct CachedPicture {
  of : pixels::Vector
  w : Double
  scale : Double
  shapes : Array[paint::Shape]
}

struct ViewPicturesState {
  mut map : Map[view::NodeId, CachedPicture]
}

let view_pictures : ViewPicturesState = ViewPicturesState::{ map: Map::new() }

fn view_pictures_reset() -> Unit {
  view_pictures.map.clear()
}

fn vector_eq(a : pixels::Vector, b : pixels::Vector) -> Bool {
  if a.w != b.w || a.h != b.h || a.layers.length() != b.layers.length() {
    return false
  }
  let mut i = 0
  while i < a.layers.length() {
    let la = a.layers[i]
    let lb = b.layers[i]
    if la.d != lb.d ||
    la.fill != lb.fill ||
    la.stroke != lb.stroke ||
    la.width != lb.width ||
    la.even_odd != lb.even_odd ||
    la.sx != lb.sx ||
    la.sy != lb.sy ||
    la.tx != lb.tx ||
    la.ty != lb.ty {
      return false
    }
    i += 1
  }
  true
}

fn view_picture_shapes(id : view::NodeId, p : pixels::Vector, w : Double, scale : Double) -> Array[paint::Shape] {
  match view_pictures.map.get(id) {
    Some(v) if v.w == w && v.scale == scale && vector_eq(v.of, p) => v.shapes
    _ => {
      let shapes = paint::vector_shapes(p, w, scale)
      view_pictures.map[id] = CachedPicture::{ of: p, w, scale, shapes }
      shapes
    }
  }
}

/// Height of each horizontal shape band in logical points (matches shape.mbt:72).
let shape_band : Double = 8.0

/// Float4 slot offsets for the 6 segments packed in a kind=12.0 data instance (matches shape.mbt:78):
/// float4s 0, 2, 3, 4, 6, 7 -> Double offsets 0, 8, 12, 16, 24, 28
/// (leaving 4..7 for kind=12.0 at slot 5, 20..23 for tex_id=0, 32..35 for rot=0).
let seg_slots : Array[Int] = [0, 2, 3, 4, 6, 7]

struct ShapeBand {
  x : Double
  y : Double
  w : Double
  h : Double
  pieces : Array[Double]
  even_odd : Bool
}

fn shape_band_made(
  outlines : Array[(Array[Double], Bool)],
  fill : Bool,
  hw : Double,
  even_odd : Bool,
  node_scale~ : Double = 1.0,
) -> Array[ShapeBand] {
  let out : Array[ShapeBand] = []
  let segs : Array[Double] = []
  for o in outlines {
    let (pts, closed) = o
    let n = pts.length() / 2
    if n == 0 || (fill && n < 2) {
      continue
    }
    if n == 1 {
      segs.push(pts[0])
      segs.push(pts[1])
      segs.push(pts[0])
      segs.push(pts[1])
      continue
    }
    let mut k = 0
    while k < n - 1 {
      segs.push(pts[2 * k])
      segs.push(pts[2 * k + 1])
      segs.push(pts[2 * k + 2])
      segs.push(pts[2 * k + 3])
      k += 1
    }
    if fill || closed {
      segs.push(pts[2 * n - 2])
      segs.push(pts[2 * n - 1])
      segs.push(pts[0])
      segs.push(pts[1])
    }
  }
  let count = segs.length() / 4
  if count == 0 {
    return out
  }
  // (outlines are in the node's laid-out points: drawn `node_scale` times that, as its box is)
  if node_scale != 1.0 {
    let mut si = 0
    while si < segs.length() {
      segs[si] = segs[si] * node_scale
      si += 1
    }
  }
  let m = hw + 1.0
  let mut y0 = 1.0e18
  let mut y1 = -1.0e18
  let mut k = 0
  while k < count {
    y0 = dmin(y0, dmin(segs[4 * k + 1], segs[4 * k + 3]))
    y1 = dmax(y1, dmax(segs[4 * k + 1], segs[4 * k + 3]))
    k += 1
  }
  y0 = y0 - m
  y1 = y1 + m
  let b0s : Array[Double] = []
  let b1s : Array[Double] = []
  let mut b0 = y0
  while b0 < y1 {
    let b1 = dmin(b0 + shape_band, y1)
    b0s.push(b0)
    b1s.push(b1)
    b0 = b1
  }
  let band_count = b0s.length()
  if band_count == 0 {
    return out
  }
  let buckets : Array[Array[Int]] = []
  let mut bi_init = 0
  while bi_init < band_count {
    buckets.push([])
    bi_init += 1
  }
  k = 0
  while k < count {
    let ya = dmin(segs[4 * k + 1], segs[4 * k + 3])
    let yb = dmax(segs[4 * k + 1], segs[4 * k + 3])
    let raw0 = ((ya - m - y0) / shape_band).floor().to_int() - 1
    let raw1 = ((yb + m - y0) / shape_band).floor().to_int() + 1
    let bi0 = if raw0 < 0 { 0 } else if raw0 >= band_count { band_count - 1 } else { raw0 }
    let bi1 = if raw1 < 0 { 0 } else if raw1 >= band_count { band_count - 1 } else { raw1 }
    let mut bi = bi0
    while bi <= bi1 {
      if yb >= b0s[bi] - m && ya <= b1s[bi] + m {
        buckets[bi].push(k)
      }
      bi += 1
    }
    k += 1
  }
  let mut bi = 0
  while bi < band_count {
    let mine = buckets[bi]
    if mine.length() > 0 {
      let mut x0 = 1.0e18
      let mut x1 = -1.0e18
      for idx in mine {
        x0 = dmin(x0, dmin(segs[4 * idx], segs[4 * idx + 2]))
        x1 = dmax(x1, dmax(segs[4 * idx], segs[4 * idx + 2]))
      }
      let bx = x0 - m
      let bw = dmax(x1 - x0 + 2.0 * m, 1.0e-6)
      let cur_b0 = b0s[bi]
      let bh = dmax(b1s[bi] - cur_b0, 1.0e-6)
      let pieces : Array[Double] = []
      for idx in mine {
        pieces.push((segs[4 * idx] - bx) / bw)
        pieces.push((segs[4 * idx + 1] - cur_b0) / bh)
        pieces.push((segs[4 * idx + 2] - bx) / bw)
        pieces.push((segs[4 * idx + 3] - cur_b0) / bh)
      }
      out.push(ShapeBand::{ x: bx, y: cur_b0, w: bw, h: bh, pieces, even_odd: fill && even_odd })
    }
    bi += 1
  }
  out
}

fn emit_shape(
  scene : Scene,
  ox : Double,
  oy : Double,
  outlines : Array[(Array[Double], Bool)],
  fill : Bool,
  hw : Double,
  even_odd : Bool,
  color : Int64,
  alpha : Double,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
  node_scale~ : Double = 1.0,
) -> Unit {
  let bands = shape_band_made(outlines, fill, hw, even_odd, node_scale=node_scale)
  for b in bands {
    let first = scene.segs.length() / 4
    for v in b.pieces {
      scene.segs.push(v)
    }
    let idx = scene.push_inst(
      ox + b.x,
      oy + b.y,
      b.w,
      b.h,
      hw,
      11.0,
      0.0,
      0.0,
      color,
      alpha,
      first.to_double(),
      (b.pieces.length() / 4).to_double(),
      if b.even_odd { 1.0 } else { 0.0 },
      0.0,
      clip_x=clip_x,
      clip_y=clip_y,
      clip_x1=clip_x1,
      clip_y1=clip_y1,
    )
    if scene.ink_r > 0.0 {
      let sb = idx * inst_size
      scene.inst[sb + 21] = scene.ink_x
      scene.inst[sb + 22] = scene.ink_y
      scene.inst[sb + 23] = scene.ink_r
    }
  }
}

fn encode_shapes(
  scene : Scene,
  d : view::Drawn,
  pic_shapes : Array[paint::Shape],
  node_scale : Double,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
) -> Unit {
  let ns = if node_scale > 0.0 { node_scale } else { 1.0 }
  for sh in d.shapes {
    if sh.fill != 0L {
      let col = if d.tint != 0L { d.tint } else { sh.fill }
      if (col & 0xFFL) != 0L {
        emit_shape(
          scene,
          d.x,
          d.y,
          sh.outlines,
          true,
          0.0,
          sh.even_odd,
          col,
          d.alpha,
          clip_x,
          clip_y,
          clip_x1,
          clip_y1,
          node_scale=ns,
        )
      }
    }
    if sh.stroke != 0L && sh.width > 0.0 {
      let col = if d.tint != 0L { d.tint } else { sh.stroke }
      if (col & 0xFFL) != 0L {
        emit_shape(
          scene,
          d.x,
          d.y,
          sh.outlines,
          false,
          sh.width * 0.5 * ns,
          false,
          col,
          d.alpha,
          clip_x,
          clip_y,
          clip_x1,
          clip_y1,
          node_scale=ns,
        )
      }
    }
  }
  // Picture shapes preserve each layer's own opacity under `d.tint` (matching pixels::tinted).
  for sh in pic_shapes {
    if sh.fill != 0L {
      let col = if d.tint != 0L { pixels::tinted(sh.fill, Some(d.tint)) } else { sh.fill }
      if (col & 0xFFL) != 0L {
        emit_shape(
          scene,
          d.x,
          d.y,
          sh.outlines,
          true,
          0.0,
          sh.even_odd,
          col,
          d.alpha,
          clip_x,
          clip_y,
          clip_x1,
          clip_y1,
          node_scale=ns,
        )
      }
    }
    if sh.stroke != 0L && sh.width > 0.0 {
      let col = if d.tint != 0L { pixels::tinted(sh.stroke, Some(d.tint)) } else { sh.stroke }
      if (col & 0xFFL) != 0L {
        emit_shape(
          scene,
          d.x,
          d.y,
          sh.outlines,
          false,
          sh.width * 0.5 * ns,
          false,
          col,
          d.alpha,
          clip_x,
          clip_y,
          clip_x1,
          clip_y1,
          node_scale=ns,
        )
      }
    }
  }
}

/// Pack accumulated shape segments (`scene.segs`) into kind=12.0 instances (6 segments per instance)
/// appended at the tail of `scene.inst`, matching `shape.mbt:457-523`.
pub fn Scene::emit_segs(self : Scene) -> Unit {
  let n = self.segs.length() / 4
  if n == 0 {
    return
  }
  let k = (n + 5) / 6
  let mut j = 0
  while j < k {
    let b = self.ninst * inst_size
    self.ensure_inst_len(b + inst_size)
    let mut z = 0
    while z < inst_size {
      self.inst[b + z] = 0.0
      z += 1
    }
    self.inst[b + 5] = 12.0
    let first = j * 6
    let last = if first + 6 < n { first + 6 } else { n }
    let mut i = first
    while i < last {
      let o = b + seg_slots[i - first] * 4
      let p = 4 * i
      self.inst[o] = self.segs[p]
      self.inst[o + 1] = self.segs[p + 1]
      self.inst[o + 2] = self.segs[p + 2]
      self.inst[o + 3] = self.segs[p + 3]
      i += 1
    }
    self.ninst = self.ninst + 1
    j += 1
  }
}

/// Public vector shape emission into `Scene` (kind=11.0 bands backed by frame-tail kind=12.0 segment packs).
pub fn Scene::emit_vector(
  self : Scene,
  ox : Double,
  oy : Double,
  outlines : Array[(Array[Double], Bool)],
  fill~ : Bool = true,
  hw~ : Double = 0.0,
  even_odd~ : Bool = false,
  color~ : Int64 = 0xFFFFFFFFL,
  alpha~ : Double = 1.0,
  clip_x~ : Double = 0.0,
  clip_y~ : Double = 0.0,
  clip_x1~ : Double = 1.0e9,
  clip_y1~ : Double = 1.0e9,
) -> Unit {
  if (color & 0xFFL) == 0L || alpha <= 0.0 {
    return
  }
  emit_shape(self, ox, oy, outlines, fill, hw, even_odd, color, alpha, clip_x, clip_y, clip_x1, clip_y1)
}
