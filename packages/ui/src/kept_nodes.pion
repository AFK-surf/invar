import "hostapi"
import "mbt_compat"
import "signals"
import "view"

// A list's row kept as the nodes its build made (the way there's 5): a row built and laid out is a
// value, its nodes as laid out and what its build said of the frame besides them. It is built under a watch of its own
// (what it reads of signals and of time, the frames' clock and the moments it shows changing at, followed by it alone:
// kept_part.pion's KeptClock), and is not built again while nothing it read changed, nothing it was built from changed
// (what built its list read nothing that changed: the frame was not built anew for it, nodes_run's `fresh`) and its
// list gives it the same room: its nodes are put back into the frame's where its build would make them, moved to where
// it is laid now, and what it said of the frame that its nodes do not hold is said again there (said.pion's build
// lists, what it marked used this frame, what it read of the layout, read back as it read it; what takes the focus,
// what is read out, its corners, what scrolls, its words, its looks and what it showed of what moves are its nodes':
// the way there's 1).
// Its layout is kept with it; what lays out its list places it, and it is painted as what is built is.
//
// What is said of the frame in no way that is said again here (a layer it opened over the page, how a list stands, a
// list, a field or a native view of its own: kept_census) builds it every frame. Where a Tester runs, each pass of a
// frame's build that kept a row is built once more keeping none, and the two must build the same nodes, laid out the
// same, and say the same of the frame (rows_check_begin): every test holds every row kept.

///|
/// A list's row kept as its nodes: what its build made and said, where it is in the frame's nodes, what it was built
/// from (its list's room and what built the list), and whether it may be kept at all (`ok`; `why` not).
// built_frame is read by its tests alone

struct RowNodes {
  list : Int
  item : Int
  mut watch : signals::Watch
  mut drawing : Option[RowDrawing]
  mut laid_by : Double
  mut laid_h : Double
  mut laid_cut : Bool
  mut row_key : Option[String]
  laid_pass : mbt_compat::Ref[Int]
  store : Array[Node]
  mut n : Int
  mut base : Int
  mut in_pool : Bool
  mut said_base : Int
  mut h : Double
  mut iw : Double
  mut count : Int
  mut seed : Int
  mut owner : Int
  mut bones : Int64
  mut sel : Bool
  mut layer : Int
  mut direction : Direction
  mut stint : Int
  mut scale : Double
  mut whole_px : Bool
  mut shaped : Int
  mut reads_out : Bool
  mut lit_all : Bool
  mut reads_all : Bool
  mut own : Bool
  mut rows_stay : Bool
  mut typed_stays : Bool
  mut theme : Option[Theme]
  mut ok : Bool
  mut why : String
  said : Array[SaidAgain]
  marks : Array[Int]
  info : Array[(String, () -> Bool)]
  used : Array[() -> Unit]
  again : Array[(Int) -> Unit]
  mut back : Option[BackSaid]
  laid : Array[LaidRead]
  laid_looks : Array[(Double, Double, Option[FixedArray[Double]], Bool)]
  links : Array[(Int, Int, Int, Int)]
  lists : Array[Int]
  mut key : String
  mut read : Bool
  mut named : String
  mut made_at : Option[String]
  mut built_frame : Int
  mut built_at : Double
  mut shown : Int
  holder : mbt_compat::Ref[Option[RowNodes]]
  mut inner : Array[(RowNodes, Int)]
  inner_now : Array[RowNodes]
}

///|
/// The rows kept, by list and item.
// kept across runs: let go of as a run begins (nodes_forget) and as each frame ends for those it did not lay
// moved to 00_init_order.pion: kept_nodes

///|
/// Nodes no row nor the frame holds, for a row's to be swapped with.
// kept across runs: only spares
// moved to 00_init_order.pion: spare_nodes

///|
/// The rows as this frame lays them: whether what built their lists may have built them otherwise (`fresh`: the frame
/// built anew, none kept); whether what a row read changed since it was built (`told`: the next frame lays out again);
/// the row being built (none: what is built is no row's); how many rows this frame kept and built; whether rows are
/// kept at all (`on`: a Tester's frame built whole after one that kept rows keeps none).
struct NodesRun {
  mut fresh : Bool
  mut evented : Bool
  mut evented_only : Int
  mut typed_alone : Bool
  mut whole : Bool
  mut part_fresh : Bool
  mut told : Bool
  mut told_by : (Int, Int)
  mut told_at : Option[String]
  mut pass : Int
  mut building : Option[RowNodes]
  mut aside : Int
  mut kept : Int
  mut built : Int
  mut built_read : Int
  mut kept_at : Array[(Int, Int)]
  mut built_at : Array[(Int, Int)]
  mut built_asked : Bool
  mut on : Bool
}

///|
// kept across runs: put back as a run begins (nodes_forget), its counts as each frame does
// moved to 00_init_order.pion: nodes_run

///|
/// Whether rows are kept as their nodes this frame.
fn Ctx::nodes_keep(self : Ctx) -> Bool {
  nodes_run.on && !nodes_run.fresh && !inst_owners.on && !self.lit_every
}

///|
/// Whether the rows of list `st` are kept as their nodes this frame: what built it built it from what had not changed
/// (ListState's `fresh`: the frame built anew, or the part it is in built again for what it read, builds them anew).
fn Ctx::nodes_keep_in(self : Ctx, st : ListState) -> Bool {
  nodes_run.on && !st.fresh && !inst_owners.on && !self.lit_every
}

///|
/// What is built now said something of itself that a package keeps outside ui's frame, by what is built (the motion
/// package's entries, by node): a list's row being built is built every frame (kept_nodes.pion's head).
pub fn built_aside(why? : String) -> Unit {
  let why = match why { Some(__mbt_v) => __mbt_v, None => "" }

  nodes_run.aside = nodes_run.aside + 1
  aside_why.v = why
}

///|
/// What was said last of what is built now that a package keeps outside ui's frame (built_aside), where it said: why
/// a row or a part is built every frame, said by rows_unkept.
// kept across runs: written as it is said
// moved to 00_init_order.pion: aside_why

///|
/// What the build marked used this frame (`f` marks it so again: a picture, a timer held, what asks to be lit, a
/// package's motion kept by its key): a list's row being built marks it again each frame it is kept.
pub fn built_used(f : () -> Unit) -> Unit {
  match nodes_run.building {
    Some(rn) => rn.used.push(f)
    Option::None => ()
  }
}

///|
/// What the build said of a node that a package keeps by its node (the motion package's entries): `f` says it again of
/// the node `by` on from it, each frame a list's row being built is kept (its nodes put back elsewhere among the
/// frame's: kept_nodes.pion's head).
pub fn built_again(f : (Int) -> Unit) -> Unit {
  match nodes_run.building {
    Some(rn) => rn.again.push(f)
    Option::None => ()
  }
}

///|
/// As each pass of a frame's build begins (frame_build): the rows' nodes out of the frame's, their places in it taken
/// by spares, for the build to make its own; a row kept is put back where its list lays it (Ctx::row_laid). As the
/// frame begins, nothing built is a row's.
fn Ctx::rows_detach(self : Ctx) -> Unit {
  nodes_run.building = None
  nodes_run.pass = nodes_run.pass + 1
  { let __mbt_mit_184 = mbt_compat::ordered_map_iter_lazy(kept_nodes); while true { match (__mbt_mit_184.next)() { Some((_, rn)) => {
    if !rn.in_pool {
      continue
    }
    // (built anew, none kept: a row's nodes taken out of the frame's all the same, for its build to make again in
    // them where its list lays it (Ctx::row_laid), as laid out before where it is the same, whatever was built before
    // it in the frame: left where they were, a node more or less built before them (a bar's in a motion) put another
    // node in each of their places, all of them laid out anew; a part's left there, for it to make again in its place.
    // But a row that shows only what it read, unless none is kept at all)
    if self.built_with_frame(rn) {
      if rn.item >= 0 {
        self.row_nodes_out(rn)
      } else {
        self.inner_staying_out(rn)
      }
      rn.in_pool = false
      rn.n = 0
      rn.ok = false
      continue
    }
    self.row_nodes_out(rn)
    rn.in_pool = false
  }, None => break } } }
}

///|
/// Whether this pass builds row or part `rn` anew, none of it kept (rows_detach).
fn Ctx::built_with_frame(self : Ctx, rn : RowNodes) -> Bool {
  nodes_run.whole || (nodes_run.fresh && !rn.reads_all && self.goes_with_frame(rn))
}

///|
/// The parts kept among part `rn`'s nodes that go on as it is built anew (an own part or one whose rows stay, in an old
/// view's built for what came to it alone: rows_detach), out of the frame's into their own, spares in their places: `rn`
/// left in the frame's for its build to make again there, what it builds over where they were is not theirs, and they
/// are put back from their own. Those built anew with it are left with it, theirs in turn looked through.
fn Ctx::inner_staying_out(self : Ctx, rn : RowNodes) -> Unit {
  for p in rn.inner {
    let (i, _) = p
    if self.built_with_frame(i) {
      self.inner_staying_out(i)
    } else {
      self.row_nodes_out(i)
      i.in_pool = false
    }
  }
}

///|
/// Whether a frame built anew builds row or part `rn` anew: not an old view's own part, nor a row of a list in a part
/// whose rows stay with it (Ctx::kept_part's `rows_stay`), but for an event that came to it; nor, where what came is what
/// was typed alone, a part that goes on through that (`typed_stays`) or a row of a list in one.
fn Ctx::goes_with_frame(self : Ctx, rn : RowNodes) -> Bool {
  if rn.item < 0 {
    if typed_stays_now(rn.typed_stays, rn.list) {
      return false
    }
    return !(rn.own || rn.rows_stay) || evented_for(rn.list)
  }
  match self.lists.get(rn.list) {
    Some(st) if st.typed_stays && nodes_run.typed_alone => false
    Some(st) if st.island != 0 => evented_for(st.island)
    _ => true
  }
}

///|
/// Whether part `id`, going on through what was typed elsewhere alone (`typed_stays`), goes on through this frame: what
/// came is that alone, and it came to another part than this.
fn typed_stays_now(typed_stays : Bool, id : Int) -> Bool {
  typed_stays && nodes_run.typed_alone && nodes_run.evented_only != id
}

///|
/// Row or part `rn`'s nodes out of the frame's, into its own (`store`), their places taken by those it held, or by
/// spares.
fn Ctx::row_nodes_out(self : Ctx, rn : RowNodes) -> Unit {
  for j in 0..<rn.n {
    let i = rn.base + j
    let o = self.nodes[i]
    if j < rn.store.length() {
      self.nodes[i] = rn.store[j]
      rn.store[j] = o
    } else {
      self.nodes[i] = match spare_nodes.pop() {
        Some(s) => s
        Option::None => Node::new()
      }
      rn.store.push(o)
    }
    // (where each is, as who it is is found by it: Ctx::node_known)
    self.nodes[i].slot = i
    o.slot = -1
  }
  inner_out(rn)
}

///|
/// The parts kept among row or part `rn`'s nodes (an island in an island), out of its own (`store`) into theirs, spares
/// in their places: each one's own, never two's.
fn inner_out(rn : RowNodes) -> Unit {
  for p in rn.inner {
    let (i, off) = p
    for j in 0..<i.n {
      if j >= i.store.length() {
        i.store.push(match spare_nodes.pop() {
          Some(s) => s
          Option::None => Node::new()
        },)
      }
      let o = rn.store[off + j]
      rn.store[off + j] = i.store[j]
      i.store[j] = o
    }
    inner_out(i)
  }
}

///|
/// The parts kept among the nodes of row or part `rn`, put back from `at` among the frame's: theirs in their places,
/// where they are now, laid this frame.
fn Ctx::inner_in(self : Ctx, rn : RowNodes, at : Int) -> Unit {
  for p in rn.inner {
    let (i, off) = p
    for j in 0..<i.n {
      let k = at + off + j
      let o = self.nodes[k]
      self.nodes[k] = i.store[j]
      i.store[j] = o
      self.nodes[k].slot = k
      o.slot = -1
    }
    i.base = at + off
    i.in_pool = false
    i.shown = self.frame_no
    i.laid_pass.v = nodes_run.pass
    self.inner_in(i, at + off)
  }
}

///|
/// Row `rn`'s own nodes (`store`: those it was last built in) put in the frame's where the next are made, for its
/// build to make again; those there its own instead.
fn Ctx::row_nodes_lent(self : Ctx, rn : RowNodes) -> Unit {
  let c0 = self.count
  let n = rn.store.length()
  while self.nodes.length() < c0 + n {
    self.nodes.push(match spare_nodes.pop() {
      Some(s) => s
      Option::None => Node::new()
    },)
  }
  for j in 0..<n {
    let o = self.nodes[c0 + j]
    self.nodes[c0 + j] = rn.store[j]
    rn.store[j] = o
    self.nodes[c0 + j].slot = c0 + j
    o.slot = -1
  }
}

///|
/// The frame is built (parts_frame_end): the rows it did not lay let go, what they read no longer followed, their nodes
/// spares.
fn rows_nodes_end(c : Ctx) -> Unit {
  if kept_nodes.is_empty() {
    return
  }
  let gone = []
  { let __mbt_mit_353 = mbt_compat::ordered_map_iter_lazy(kept_nodes); while true { match (__mbt_mit_353.next)() { Some((key, rn)) => {
    if rn.shown != c.frame_no {
      gone.push(key)
    }
  }, None => break } } }
  for key in gone {
    match kept_nodes.get(key) {
      Some(rn) => {
        rn.watch.stop()
        row_drawing_forget(rn)
        row_nodes_unlinked(rn)
        // (its nodes not in the frame's: its own, at the end of the frame's now, each found there by who it is as what
        // it was is built again (a page covered a while, back: Ctx::node_known), so far as there is room, else spares;
        // in it, the frame's, and what it holds of the frame's)
        for o in rn.store {
          if c.nodes.length() < 2 * known_made.v + known_room {
            o.slot = c.nodes.length()
            c.nodes.push(o)
          } else {
            o.slot = -1
            spare_nodes.push(o)
          }
        }
      }
      Option::None => ()
    }
    kept_nodes.remove(key)
  }
}

///|
/// Row or part `rn`, kept no more, let go of what holds it and what it holds (its holder, the parts kept among its
/// nodes): a part holds its holder (`holder`, read by its watch too) and is held by it (`inner`), a ring native's
/// counting never frees, which would keep both, their nodes and what their builds said, once neither is kept.
fn row_nodes_unlinked(rn : RowNodes) -> Unit {
  rn.holder.v = None
  rn.inner = []
  rn.inner_now.clear()
}

///|
/// Node `n`, let go of or perhaps so, let go of what holds it and what it holds of others: as a leaf its layout's
/// measure holds it, and as it held others its layout's children are those it held when it was last laid out
/// (Ctx::flex_tree), which a node made another's since may hold in turn: rings native's counting never frees. Laid
/// out again, it is told both again.
fn Node::unlinked(self : Node) -> Unit {
  self.fl.measure = Option::None
  self.fl.children_cut(0)
}

///|
/// Put back as a run begins (reset_globals): no row kept, what they read let go.
fn nodes_forget() -> Unit {
  { let __mbt_mit_406 = mbt_compat::ordered_map_iter_lazy(kept_nodes); while true { match (__mbt_mit_406.next)() { Some((_, rn)) => {
    rn.watch.stop()
    row_drawing_forget(rn)
    row_nodes_unlinked(rn)
    for o in rn.store {
      o.unlinked()
    }
  }, None => break } } }
  for o in spare_nodes {
    o.unlinked()
  }
  kept_nodes.clear()
  spare_nodes.clear()
  known_nodes.clear()
  nodes_run.fresh = true
  nodes_run.whole = true
  nodes_run.told = false
  nodes_run.building = None
  nodes_run.kept = 0
  nodes_run.built = 0
  nodes_run.built_read = 0
  nodes_run.kept_at.clear()
  nodes_run.built_at.clear()
  nodes_run.built_asked = false
  nodes_run.typed_alone = false
  typed_frame_last.v = -1
  nodes_run.on = true
}

///|
/// As a frame is built (frame_body): no row kept nor built yet, none laid in it (what a row read told from here on,
/// before it is laid in the frame, it reads anew as it is: what came for the frame taken, row_nodes_new).
fn rows_frame_start() -> Unit {
  nodes_run.pass = nodes_run.pass + 1
  nodes_run.kept = 0
  nodes_run.built = 0
  nodes_run.kept_at.clear()
}

///|
/// What a row's or a part's build read, followed (made where it is built: owned by what owns that): told, the row or the
/// part is built again; among another's nodes (`holder`), that one with it.
fn row_watch(list : Int, item : Int, laid_pass : mbt_compat::Ref[Int], holder : mbt_compat::Ref[Option[RowNodes]]) -> signals::Watch {
  signals::watch(fn() {
    // (among another's nodes: that one built again for it, it with it, and what holds that, out to the last: one put
    // back puts back what it holds as it was)
    touch_holders(holder.v)
    if frame_running.v && frame_built.v && laid_pass.v != nodes_run.pass {
      return
    }
    nodes_run.told = true
    nodes_run.told_by = (list, item)
    watch_told_moment()
    nodes_run.told_at = signals::setting_at()
    // (between frames: one owed; in one, the next asked for as it ends: on_frame)
    if !frame_running.v {
      h_frame_owed()
    } else if building.v &&
    (match old_view_of(kept_nodes.get((list, item))) {
      Some(island) => !part_built_now(island)
      Option::None => false
    }) {
      // (an old view's, built in this pass already (laid_pass: one this pass has not come to yet builds from it as it
      // is), its build over (one setting what it reads as it builds keeps to the next frame): what it read set by what
      // came after it (a press on another taken as that one was built, a picture tapped in a list's row as it was laid
      // out, its viewer set out as its node is made): the frame built again in it, that old view alone built anew, so
      // that it is drawn in the frame that changed it)
      let at = match nodes_run.told_at {
        Some(at) => ", set at \{at}"
        Option::None => ""
      }
      g().read_followed_changed("what an old view read changed as the frame was built" + at)
    }
  })
}

///|
/// What holds `r` built again with it, and what holds that, out to the last.
fn touch_holders(r : Option[RowNodes]) -> Unit {
  match r {
    Some(o) => {
      o.watch.touch()
      touch_holders(o.holder.v)
    }
    Option::None => ()
  }
}

///|
/// The old view's own part (made_island: `own`, no list's) that part or row `r` is, or that holds it among its nodes.
fn old_view_of(r : Option[RowNodes]) -> Option[RowNodes] {
  match r {
    Some(rn) if rn.own && rn.item < 0 => Some(rn)
    Some(rn) => old_view_of(rn.holder.v)
    Option::None => Option::None
  }
}

///|
/// Whether part `rn` is being built now: it, or one it holds being built (nodes_run's `building`, out along what holds
/// each).
fn part_built_now(rn : RowNodes) -> Bool {
  let mut b = nodes_run.building
  while true {
    match b {
      Some(o) => {
        if physical_equal(o, rn) {
          return true
        }
        b = o.holder.v
      }
      Option::None => return false
    }
  }
  false
}

///|
/// The row or part told last (nodes_run's `told_by`), in words for the performance record ("" not known): `the island
/// "<name>"`, `the part kept at <where Ctx::kept_part was said>`, `a row of list "<key>" made at <where Ctx::list was
/// said>`. Worked out only as the record's why is, from what each build left (no words made as it is built).
fn Ctx::told_said(self : Ctx) -> String {
  let (list, item) = nodes_run.told_by
  if item < 0 {
    match kept_nodes.get((list, item)) {
      Some(rn) if rn.named != "" => "the island \"\{rn.named}\""
      Option::Some(__mbt_sp_96) if (match __mbt_sp_96.made_at { Some(at) => true, _ => false }) => match __mbt_sp_96.made_at { Some(at) => "the part kept at \{at}", _ => panic("unreachable") }
      _ => ""
    }
  } else {
    match self.lists.get(list) {
      Some(st) =>
      "a row of list \"\{st.named}\"" +
      (match st.made_at {
        Some(at) => " made at \{at}"
        Option::None => ""
      })
      Option::None => ""
    }
  }
}

///|
/// Row or part `rn`, its watch made anew where what owned it stopped it (an old view gone, its island built by another
/// with the same key): stale, its build owned here, never put back as though it still followed what it read.
fn row_nodes_owned(rn : RowNodes) -> RowNodes {
  if rn.watch.gone() {
    rn.watch = row_watch(rn.list, rn.item, rn.laid_pass, rn.holder)
  }
  rn
}

///|
/// A row of list `list`, item `item`, not built yet.
fn row_nodes_new(list : Int, item : Int) -> RowNodes {
  // (the pass it was last laid in: told in a pass before it is laid in it, it reads anew as it is)
  let laid_pass = mbt_compat::ref_new(-1)
  let holder : mbt_compat::Ref[Option[RowNodes]] = mbt_compat::ref_new(None)
  let watch = row_watch(list, item, laid_pass, holder)
  RowNodes::{
    list: list,
    item: item,
    watch: watch,
    drawing: Option::None,
    laid_by: 0.0,
    laid_h: -1.0,
    laid_cut: false,
    row_key: Option::None,
    laid_pass: laid_pass,
    store: [],
    n: 0,
    base: 0,
    in_pool: false,
    said_base: 0,
    h: 0.0,
    iw: 0.0,
    count: 0,
    seed: 0,
    owner: 0,
    bones: 0L,
    sel: false,
    layer: 0,
    direction: Direction::Ltr,
    stint: 0,
    scale: 0.0,
    whole_px: false,
    shaped: -1,
    reads_out: false,
    lit_all: false,
    reads_all: false,
    own: false,
    rows_stay: false,
    typed_stays: false,
    back: Option::None,
    theme: Option::None,
    ok: false,
    why: "",
    said: [],
    marks: [],
    info: [],
    used: [],
    again: [],
    laid: [],
    laid_looks: [],
    links: [],
    lists: [],
    key: "",
    read: false,
    built_frame: -1,
    built_at: -1.0,
    shown: -1,
    holder: holder,
    inner: [],
    inner_now: [],
    named: "",
    made_at: Option::None,
  }
}

///|
/// How far each of what a build may say of the frame in no way said again here stands (kept_census_names, in order):
/// one that grew as a row was built makes it a row built every frame.
fn Ctx::kept_census(self : Ctx, into : Array[Int]) -> Unit {
  into.clear()
  into.push(self.layers.length())
  into.push(self.layers_opened.length())
  into.push(self.cover_asks.length())
  into.push(self.place_reads.length())
  into.push(self.row_reads.length())
  into.push(self.words_reads.length())
  into.push(self.words_shape_reads.length())
  into.push(self.shown_watch.length())
  into.push(self.move_runs.length())
  into.push(self.asked_actions.length())
  into.push(self.told.length())
  into.push(self.shots.length())
  into.push(self.dismissals.length())
  into.push(self.layer_return.length())
  into.push(self.lists.length())
  into.push(self.editors.length())
  into.push(self.owned.length())
  into.push(self.groups.length())
  into.push(self.covers.length())
  into.push(self.springs.length())
  into.push(native_nodes.length())
  into.push(stream_nodes.length())
  into.push(dr.overlay.length())
  into.push(dr.raised.length())
  into.push(dr.scrims.length())
  into.push(desk.next_sels.length())
  into.push(nodes_run.aside)
}

///|
/// What kept_census counts, by name, in its order.
// kept across runs: a table, never written
// moved to 00_init_order.pion: kept_census_names

///|
/// Row `k` of list node `li` (`st`) laid at (`ix`, `y`), `iw` wide (Ctx::place_list): kept where nothing it shows
/// changed (kept_nodes.pion's head), else built and laid out there, under its own watch; its node and how tall its slot
/// is.
fn Ctx::row_laid(self : Ctx, li : Int, st : ListState, k : Int, ix : Double, y : Double, iw : Double) -> (Int, Double) {
  let nan = 0.0 / 0.0
  // (a row in a row's build: what holds it is built every frame, kept_census)
  if nodes_run.building is Some(_) {
    let r = self.build_row(li, st, k)
    return (r, self.row_slot(r, self.layout(r, ix, y, iw, nan)))
  }
  let key = (self.nodes[li].id, k)
  let row_key = match st.causes {
    Some(c) if k < c.keys.length() => Some(c.keys[k])
    _ => None
  }
  let rn = match kept_nodes.get(key) {
    Some(rn) => row_nodes_owned(rn)
    Option::None => {
      let rn = row_nodes_new(key.0, key.1)
      kept_nodes.set(key, rn)
      rn
    }
  }
  rn.shown = self.frame_no
  rn.laid_pass.v = nodes_run.pass
  if self.nodes_keep_in(st) &&
  rn.ok &&
  rn.row_key == row_key &&
  !rn.in_pool &&
  rn.n > 0 &&
  !rn.watch.is_stale() &&
  rn.iw == iw &&
  rn.reads_all == st.rows_read &&
  // (one that shows only what it read kept however its list is built: but not in another theme, light or dark, the
  // one its list is built in the same while nothing of it changed: what is no signal of its own)
  (!st.rows_read || (rn.theme is Some(th) && physical_equal(th, st.theme))) &&
  (st.rows_read || rn.count == st.count) &&
  rn.seed == st.seed &&
  rn.owner == st.owner &&
  rn.bones == st.bones &&
  rn.sel == st.sel &&
  rn.layer == st.layer &&
  rn.direction == st.direction &&
  rn.stint == st.stint &&
  rn.scale == self.scale &&
  rn.whole_px == self.whole_px &&
  rn.shaped == words_shaped_in.get() &&
  layout_reuse.v &&
  rn.reads_out == reads_out() &&
  rn.lit_all == self.lit_all {
    // (what is worked out again of it as it is put back, its places by its size and what it marks used, read as its
    // build read it: followed by its watch, not by what lays out its list)
    return signals::untracked(fn() { self.row_splice(li, rn, ix, y) })
  }
  // built: in the nodes it was built in before, where its build makes them (what lays them out keeps what it worked
  // out of them where they are the same); what it says of the frame from where each list stands
  row_drawing_forget(rn)
  rn.row_key = row_key
  self.row_nodes_lent(rn)
  let b = self.nodes_begin(rn)
  nodes_run.building = Some(rn)
  let (r, h) = rn.watch.read(fn() {
    let r = self.build_row(li, st, k)
    (r, self.row_slot(r, self.layout(r, ix, y, iw, nan)))
  })
  nodes_run.building = None
  rn.h = h
  rn.iw = iw
  rn.count = st.count
  rn.reads_all = st.rows_read
  rn.theme = if st.rows_read { Some(st.theme) } else { Option::None }
  rn.seed = st.seed
  rn.owner = st.owner
  rn.bones = st.bones
  rn.sel = st.sel
  rn.layer = st.layer
  rn.direction = st.direction
  rn.stint = st.stint
  self.nodes_end(rn, r, b, part=false)
  (r, h)
}

///|
/// Where what the frame's builds say stood as a row or a part began being built (Ctx::nodes_begin): what it said is
/// taken from there as it is over (Ctx::nodes_end).
struct NodesBegun {
  census : Array[Int]
  info : Int
  drawn : Int
  back : BackSaid
}

///|
/// What takes back as the frame's builds have said so far (Ctx's `back_next` and what goes with it); a row's or a part's
/// (RowNodes' `back`): its node from the first of its nodes where it is one of them (`own`).
struct BackSaid {
  f : Option[(Int, Double, Double, Double, Double) -> Unit]
  node : Int
  own : Bool
  edge : Double
  island : Option[view::NodeId]
  chain : BackList
  over : Array[(BackEntry, Bool)]
}

///|
/// What takes back as said so far.
fn Ctx::back_said(self : Ctx) -> BackSaid {
  BackSaid::{
    f: self.back_next,
    node: self.back_node_next,
    own: false,
    edge: self.back_edge_next,
    island: self.back_island_next,
    chain: self.back_chain_next,
    over: [],
  }
}

///|
/// Whether what takes back is as `b` says.
fn Ctx::back_as(self : Ctx, b : BackSaid) -> Bool {
  let f_same = match (self.back_next, b.f) {
    (None, None) => true
    (Some(x), Some(y)) => physical_equal(x, y)
    _ => false
  }
  f_same &&
  self.back_node_next == b.node &&
  self.back_edge_next == b.edge &&
  self.back_island_next == b.island &&
  (physical_equal(self.back_chain_next, b.chain) || (self.back_chain_next is .Unsaid && b.chain is .Unsaid))
}

///|
/// Row or part `rn` about to be built: where what the frame's builds say stands.
fn Ctx::nodes_begin(self : Ctx, rn : RowNodes) -> NodesBegun {
  let census : Array[Int] = []
  self.kept_census(census)
  self.build_marks(rn.marks)
  rn.used.clear()
  rn.again.clear()
  rn.laid.clear()
  rn.inner_now.clear()
  NodesBegun::{
    census: census,
    info: self.info_reads.length(),
    drawn: dr.entries.length(),
    back: self.back_said(),
  }
}

///|
/// Row or part `rn` built, its nodes from `r` (`b`: what the builds said stood as it began): its nodes and what it
/// said of the frame kept with it, and whether it may be kept (it said nothing of the frame that is not said again, its
/// nodes all its own and none of a kind built each frame; a part may hold lists, laid out each frame).
fn Ctx::nodes_end(self : Ctx, rn : RowNodes, r : Int, b : NodesBegun, part~ : Bool) -> Unit {
  nodes_run.built = nodes_run.built + 1
  if !nodes_run.whole && nodes_run.built_asked {
    nodes_run.built_at.push((rn.list, rn.item))
  }
  if !part && rn.reads_all {
    nodes_run.built_read = nodes_run.built_read + 1
  }
  rn.built_frame = self.frame_no
  rn.built_at = self.clock
  rn.base = r
  rn.said_base = r
  rn.n = self.count - r
  rn.in_pool = true
  // (the parts kept among its nodes, where among them)
  rn.inner = mbt_compat::arr_map(rn.inner_now, fn(i) { (i, i.base - r) })
  rn.inner_now.clear()
  rn.scale = self.scale
  rn.whole_px = self.whole_px
  rn.shaped = words_shaped_in.get()
  rn.reads_out = reads_out()
  rn.lit_all = self.lit_all
  self.build_take(rn.marks, rn.said, cut=false)
  // (what takes back as its build left it, where it changed it: its node, where one of its own, from its first)
  // (and what it said over what was said as it began, its own nodes from its first: said again over what is said then;
  // where it put back something else, kept it is not)
  let mut back_otherwise = false
  rn.back = if self.back_as(b.back) {
    Option::None
  } else {
    let node = self.back_node_next
    let own = node >= r && node < r + rn.n
    let over : Array[(BackEntry, Bool)] = []
    let mut at = self.back_chain_next
    while !(physical_equal(at, b.back.chain) || (at is .Unsaid && b.back.chain is .Unsaid)) {
      match at {
        BackList::Said(e, under) => {
          let mine = e.node >= r && e.node < r + rn.n
          over.push(({ let __mbt_su_b_97 : BackEntry = e; BackEntry::{ f: __mbt_su_b_97.f, node: if mine { e.node - r } else { e.node }, edge: __mbt_su_b_97.edge, island: __mbt_su_b_97.island, layer: __mbt_su_b_97.layer, stack: __mbt_su_b_97.stack, stack_in: __mbt_su_b_97.stack_in, within: __mbt_su_b_97.within } }, mine))
          at = under
        }
        .Unsaid => {
          back_otherwise = true
          break
        }
      }
    }
    Some({ let __mbt_su_b_98 : BackSaid = self.back_said(); BackSaid::{ f: __mbt_su_b_98.f, node: if own { node - r } else { node }, own: own, edge: __mbt_su_b_98.edge, island: __mbt_su_b_98.island, chain: __mbt_su_b_98.chain, over: over } })
  }
  rn.info.clear()
  for j in b.info..<self.info_reads.length() {
    rn.info.push(self.info_reads[j])
  }
  let census_after : Array[Int] = []
  self.kept_census(census_after)
  rn.why = ""
  for j in 0..<census_after.length() {
    if rn.why == "" && census_after[j] != b.census[j] && !(part && kept_census_names[j] == "a list of its own") {
      rn.why = if kept_census_names[j] == "what a package keeps of it" && aside_why.v != "" {
        aside_why.v
      } else {
        kept_census_names[j]
      }
    }
  }
  if rn.why == "" && back_otherwise {
    rn.why = "back said otherwise than over what was said before it"
  }
  if rn.why == "" {
    rn.why = self.row_nodes_why(r, rn.n, part=part)
  }
  // (an entry of draw.pion's of a node not its own: what holds it drawn otherwise for it)
  for j in b.drawn..<dr.entries.length() {
    let e = dr.entries[j]
    if rn.why == "" && (e.node < r || e.node >= r + rn.n || (e.keep_rel >= 0 && e.keep_rel < r)) {
      rn.why = "a look of what holds it"
    }
  }
  rn.ok = rn.why == ""
  rn.laid_looks.clear()
  rn.links.clear()
  rn.lists.clear()
  if rn.ok {
    for j in 0..<rn.n {
      let nd = self.nodes[r + j]
      rn.laid_looks.push((nd.opacity, nd.radius, mbt_compat::opt_map(nd.radii, fn(a) { a.copy() }), nd.corners_worked))
      // (how its nodes hold each other as it built them, from its first: what holds its root is where it is put back;
      // a list's rows are its layout's, none as built)
      let at = fn(i : Int) { if i >= r && i < r + rn.n { i - r } else { -1 } }
      rn.links.push((at(nd.parent), at(nd.first), at(nd.last), at(nd.next)))
      if nd.kind == kind_list {
        rn.lists.push(nd.id)
        match self.lists.get(nd.id) {
          Some(st) => {
            if rn.rows_stay {
              st.island = rn.list
            }
            // (the part it is in, not one that holds that: Ctx::list says none as it is built)
            if rn.typed_stays {
              st.typed_stays = true
            }
          }
          Option::None => ()
        }
      }
    }
  }
}

///|
/// Why the `n` nodes from `r` (a row or a part just built) may not be kept: one held elsewhere, or of a kind built each
/// frame (a list of a row's own: a part lays its lists out each frame; a native view, a reader's page, a layer, a
/// shot); "" none. (What is placed by the clock (Ctx::moved_by: a page sliding) is kept with what moves it, its node's
/// own, placed again as each frame is laid out and painted. A field is kept as the rest: what changes what it holds is
/// an event, which builds the frame anew, and one with the focus is built each frame: Ctx::editor.)
fn Ctx::row_nodes_why(self : Ctx, r : Int, n : Int, part~ : Bool) -> String {
  for j in 0..<n {
    let nd = self.nodes[r + j]
    if j > 0 && (nd.parent < r || nd.parent >= r + n) {
      return "a node of it held elsewhere"
    }
    if nd.kind == kind_list && !part {
      return "a list of its own"
    }
    if nd.kind == kind_scroll {
      return "what scrolls in it"
    }
    if nd.kind == kind_native {
      return "a native view"
    }
    if nd.kind == kind_page {
      return "a reader's page"
    }
    if nd.portal || nd.shot {
      return "a layer"
    }
  }
  ""
}

///|
/// Row `rn` kept: its nodes put back into the frame's where its build would make them (under list node `li`), moved to
/// where its list lays it now (`ix`, `y`), what its build said of the frame said again; its node and how tall its slot
/// is.
fn Ctx::row_splice(self : Ctx, li : Int, rn : RowNodes, ix : Double, y : Double) -> (Int, Double) {
  let c0 = self.nodes_put_back(rn, li)
  // where its list lays it now: placed as laying it out there places it, from what its layout worked out (Ctx::replace,
  // as layout.pion's commit places what it did not lay out anew), on the same numbers as building it there
  self.replace(c0, ix, y)
  self.nodes_said_again(rn)
  (c0, rn.h)
}

///|
/// The nodes of row or part `rn` put back into the frame's at its end, as its build made them, its root under node
/// `parent` after what is there (as Ctx::alloc puts one): how they hold each other as built, from where they are now,
/// and what the layout works out of them as their build left it. Their first.
fn Ctx::nodes_put_back(self : Ctx, rn : RowNodes, parent : Int) -> Int {
  let c0 = self.count
  let n = rn.n
  while self.nodes.length() < c0 + n {
    self.nodes.push(match spare_nodes.pop() {
      Some(s) => s
      Option::None => Node::new()
    },)
  }
  for j in 0..<n {
    let o = self.nodes[c0 + j]
    self.nodes[c0 + j] = rn.store[j]
    rn.store[j] = o
    self.nodes[c0 + j].slot = c0 + j
    o.slot = -1
  }
  self.inner_in(rn, c0)
  let at = fn(k : Int) { if k >= 0 { c0 + k } else { -1 } }
  for j in 0..<n {
    let nd = self.nodes[c0 + j]
    let (opacity, radius, radii, worked) = rn.laid_looks[j]
    nd.opacity = opacity
    nd.radius = radius
    nd.radii = mbt_compat::opt_map(radii, fn(a) { a.copy() })
    nd.corners_worked = worked
    let (up, first, last, next) = rn.links[j]
    nd.parent = if j == 0 { parent } else { at(up) }
    nd.first = at(first)
    nd.last = at(last)
    nd.next = at(next)
  }
  let p = self.nodes[parent]
  if p.last >= 0 {
    self.nodes[p.last].next = c0
  } else {
    p.first = c0
  }
  p.last = c0
  // (counted among what its parent holds with no id, as made: what is built after it there is who it was)
  if n > 0 && self.nodes[c0].keyless {
    p.kids = p.kids + 1
  }
  self.count = c0 + n
  rn.base = c0
  rn.in_pool = true
  c0
}

///|
/// What row or part `rn`'s build said of the frame, said again of its nodes where they are now.
fn Ctx::nodes_said_again(self : Ctx, rn : RowNodes) -> Unit {
  let by = rn.base - rn.said_base
  self.say_again(rn.said, unmoved)
  for f in rn.used {
    f()
  }
  for f in rn.again {
    f(by)
  }
  // (back, as its build left it)
  match rn.back {
    Some(b) => {
      self.back_next = b.f
      self.back_node_next = if b.own { rn.base + b.node } else { b.node }
      self.back_edge_next = b.edge
      self.back_island_next = b.island
      // (what it said, over what is said now: its own nodes where they are now)
      for k = b.over.length() - 1; k >= 0; k = k - 1 {
        let (e, mine) = b.over[k]
        self.back_chain_next = BackList::Said({ let __mbt_su_b_99 : BackEntry = e; BackEntry::{ f: __mbt_su_b_99.f, node: if mine { rn.base + e.node } else { e.node }, edge: __mbt_su_b_99.edge, island: __mbt_su_b_99.island, layer: __mbt_su_b_99.layer, stack: __mbt_su_b_99.stack, stack_in: __mbt_su_b_99.stack_in, within: __mbt_su_b_99.within } }, self.back_chain_next)
      }
    }
    Option::None => ()
  }
  for l in rn.laid {
    self.laid_said_again(l)
  }
  // (the lists it holds built this frame, as built, from nothing changed: laid out from where they stand, their rows
  // kept, Ctx::place_list)
  for id in rn.lists {
    match self.lists.get(id) {
      Some(st) => {
        st.built = self.frame_no
        st.fresh = false
      }
      Option::None => ()
    }
  }
  for r in rn.info {
    self.info_reads.push(r)
  }
  self.moves_said_again(rn.base, rn.base + rn.n)
  self.ticks_said_again(rn.base, rn.base + rn.n)
  nodes_run.kept = nodes_run.kept + 1
  nodes_run.kept_at.push((rn.list, rn.item))
}

///|
/// What `body` builds, kept as its nodes (Ctx::part_nodes) whether parts are drawn again as recorded or not
/// (kept_part.pion's way, kept by tests alone): a part over the others whose build says what floats
/// over them (Ctx::floats_over), said again with its nodes, so what scrolls under it keeps clear of it kept or not.

pub fn Ctx::kept_as_nodes(self : Ctx, id : Int, key : String, body : () -> Unit, read_out? : Bool, loc~ : String = "") -> Unit {
  let read_out = match read_out { Some(__mbt_v) => __mbt_v, None => false }

  self.part_nodes(id, key, body, read_out, made_at=loc)
}

///|
/// What `body` builds, in a box of its own filling the one being built, read out or not (Ctx::kept_part's), kept as
/// its nodes (kept_nodes.pion's head): built again where something it read changed, or what builds it may build it
/// otherwise (the frame built anew), or it is built elsewhere (`key`, its id's scope, its owner, its layer, ...); else
/// its nodes put back as its build made them and what it said of the frame said again there, laid out with the rest. `flows`:
/// its box in the flow of the one being built, as wide as that and as tall as what it holds (an old view as tall as what
/// it holds: view_host.pion's old `natural`), not filling it over what else it holds.
fn Ctx::part_nodes(self : Ctx, id : Int, key : String, body : () -> Unit, read_out : Bool, own? : Bool, rows_stay? : Bool, typed_stays? : Bool, named? : String, made_at? : String, flows? : Bool) -> Unit {
  let own = match own { Some(__mbt_v) => __mbt_v, None => false }
  let rows_stay = match rows_stay { Some(__mbt_v) => __mbt_v, None => false }
  let typed_stays = match typed_stays { Some(__mbt_v) => __mbt_v, None => false }
  let named = match named { Some(__mbt_v) => __mbt_v, None => "" }
  let flows = match flows { Some(__mbt_v) => __mbt_v, None => false }

  let build = fn() {
    let inner = fn() {
      if read_out {
        body()
      } else {
        self.hidden_from_semantics(body)
      }
    }
    if flows {
      self.box(style=part_flowing, inner) |> ignore
    } else {
      self.box(left=0.0, top=0.0, right=0.0, bottom=0.0, inner) |> ignore
    }
  }
  // (a part in a row's or a part's build: kept as its nodes among that one's, which is built again as it is told
  // (RowNodes' `holder`), and put back with them)
  let outer = nodes_run.building
  let rn = match kept_nodes.get((id, -1)) {
    Some(rn) => row_nodes_owned(rn)
    Option::None => {
      let rn = row_nodes_new(id, -1)
      kept_nodes.set((id, -1), rn)
      rn
    }
  }
  rn.shown = self.frame_no
  rn.laid_pass.v = nodes_run.pass
  rn.own = own
  rn.rows_stay = rows_stay
  rn.typed_stays = typed_stays
  // (going on through what was typed elsewhere alone: kept as an old view's own part is, this frame)
  let stays = typed_stays_now(typed_stays, id)
  rn.named = named
  rn.made_at = made_at
  rn.holder.v = outer
  // (`own`: what puts it here is made once (made.pion's made_island), so what it is built from is its key and what it
  // read alone, whatever else the frame built anew)
  // (`typed_stays` alone: kept through what was typed elsewhere alone, built as what holds it is otherwise, what its
  // lists are built from given them anew)
  let may_keep = if own || rows_stay || stays {
    nodes_run.on && !nodes_run.whole && !evented_for(id) && !inst_owners.on && !self.lit_every
  } else if typed_stays {
    false
  } else {
    self.nodes_keep()
  }
  if may_keep &&
  rn.ok &&
  !rn.in_pool &&
  rn.n > 0 &&
  !rn.watch.is_stale() &&
  rn.key == key &&
  rn.read == read_out &&
  rn.seed == self.id_seed &&
  rn.owner == self.owner &&
  rn.bones == self.bones &&
  rn.sel == desk.selecting &&
  rn.layer == self.layer_cur &&
  rn.direction == self.direction &&
  rn.scale == self.scale &&
  rn.whole_px == self.whole_px &&
  rn.shaped == words_shaped_in.get() &&
  layout_reuse.v &&
  rn.reads_out == reads_out() &&
  rn.lit_all == self.lit_all {
    // (what is worked out again of it as it is put back, what it marks used, read as its build read it: followed by its
    // watch, not by what builds it)
    signals::untracked(fn() {
      self.nodes_put_back(rn, self.cur) |> ignore
      self.nodes_said_again(rn)
    })
    self.held_by(outer, rn)
    return
  }
  // (built for what it read, or as it is new or built elsewhere: what it builds its lists from may be otherwise, their
  // rows built anew; built only as it may not be kept, nothing it read changed: its lists' rows kept)
  // (`typed_stays` alone, built as it is not kept: its lists' rows as they would be built in what holds it, anew where
  // that builds them anew, kept where it keeps them, whatever else of it changed)
  let fresh = if typed_stays && !(own || rows_stay) {
    !stays && (nodes_run.fresh || nodes_run.part_fresh)
  } else {
    (nodes_run.fresh && !stays && (!(own || rows_stay) || evented_for(id))) ||
    rn.n == 0 ||
    rn.watch.is_stale() ||
    rn.key != key ||
    rn.read != read_out ||
    rn.seed != self.id_seed ||
    rn.owner != self.owner
  }
  // (its nodes of before out of the frame's, as a part not built a while (a page covered) has them: put where its
  // build makes them, for each to be known as who it is (Ctx::node_known), laid out as before; left in the frame's
  // (a frame built anew), found there)
  if rn.store.length() > 0 {
    let r0 = rn.store[0]
    match known_nodes.get(r0.ident) {
      Option::Some(o) if physical_equal(o, r0) => self.row_nodes_lent(rn)
      _ => ()
    }
  }
  let b = self.nodes_begin(rn)
  let r = self.count
  nodes_run.building = Some(rn)
  let was = nodes_run.part_fresh
  nodes_run.part_fresh = fresh
  // (how long it took, by where it was made, for a hang it is in: @hostapi.work_part)
  hostapi::work_part(fn() {
    match made_at {
      Some(at) => "part \{at}"
      Option::None => "part " + named
    }
  }, fn() { rn.watch.read(build) })
  nodes_run.part_fresh = was
  nodes_run.building = outer
  rn.key = key
  rn.read = read_out
  rn.seed = self.id_seed
  rn.owner = self.owner
  rn.bones = self.bones
  rn.sel = desk.selecting
  rn.layer = self.layer_cur
  rn.direction = self.direction
  self.nodes_end(rn, r, b, part=true)
  self.held_by(outer, rn)
}

///|
/// Part `rn`, just put among the frame's nodes, put among those of the row or part being built (`outer`) if one is:
/// its nodes theirs till they are taken out of the frame's, what it said again besides them said again with them.
fn Ctx::held_by(self : Ctx, outer : Option[RowNodes], rn : RowNodes) -> Unit {
  ignore(self)
  match outer {
    Some(o) => {
      rn.in_pool = false
      o.inner_now.push(rn)
      for f in rn.used {
        o.used.push(f)
      }
      for l in rn.laid {
        o.laid.push(l)
      }
      // (what it says again where its nodes are moved to, from where they are among the frame's now: moved as that
      // one's are)
      let d = rn.base - rn.said_base
      for f in rn.again {
        o.again.push(fn(by) { f(by + d) })
      }
    }
    Option::None => ()
  }
}

///|
/// The rows (their list and item) and the parts (their id, -1) the frames built, not kept, since this was last asked
/// (a test's), each time one was: none of those a build keeping none built to compare with.
pub fn Tester::rows_built(self : Tester) -> Array[(Int, Int)] {
  self.reads_own()
  ignore(self)
  let out = nodes_run.built_at.copy()
  nodes_run.built_at.clear()
  nodes_run.built_asked = true
  out
}

///|
/// How many rows the last frame kept as their nodes, and how many it built (a test's, a bench's).
pub fn Tester::rows_as_nodes(self : Tester) -> (Int, Int) {
  self.reads_own()
  ignore(self)
  (nodes_run.kept, nodes_run.built)
}

///|
/// How many rows of lists that show only what they read (Ctx::list's `rows_read`) were built since the run began,
/// every frame's added up: those built again keeping none to hold a frame that kept some among them, where the Tester
/// checks so (check_looks).
pub fn Tester::rows_read_built(self : Tester) -> Int {
  self.reads_own()
  ignore(self)
  nodes_run.built_read
}

///|
/// Why the rows and the parts of the last frame that may not be kept may not (a part's said so), each reason once with
/// how many (a test's, a bench's).
pub fn rows_unkept() -> Array[(String, Int)] {
  let by : mbt_compat::OrderedMap[String, Int] = mbt_compat::ordered_map_new()
  { let __mbt_mit_1287 = mbt_compat::ordered_map_iter_lazy(kept_nodes); while true { match (__mbt_mit_1287.next)() { Some((_, rn)) => {
    if !rn.ok && rn.why != "" {
      let why = if rn.item < 0 { "a part: " + rn.why } else { rn.why }
      by.set(why, by.get(why).unwrap_or(0) + 1)
    }
  }, None => break } } }
  let out = []
  { let __mbt_mit_1294 = mbt_compat::ordered_map_iter_lazy(by); while true { match (__mbt_mit_1294.next)() { Some((k, v)) => {
    out.push((k, v))
  }, None => break } } }
  out
}

///|
/// What a row read of the layout as it was built (readback.pion): a box's rect, its size, whether a row left it out;
/// what it read, and where.
enum LaidRead {
  Rect(Int, Option[(Double, Double, Double, Double)], String)
  Size(Int, Option[(Double, Double)], String)
  Left(Int, Bool, String)
  Sel(Option[(Double, Double, Double)], String)
}

///|
/// What the row being built read of the layout (readback.pion), kept with it.
fn row_read_laid(r : LaidRead) -> Unit {
  match nodes_run.building {
    Some(rn) => rn.laid.push(r)
    Option::None => ()
  }
}

///|
/// What a row kept read of the layout as it was built, read again as it read it: read back once the frame is laid out,
/// laid out otherwise, the frame is built again (readback.pion).
fn Ctx::laid_said_again(self : Ctx, r : LaidRead) -> Unit {
  match r {
    .Rect(id, v, loc) => {
      self.laid_watch.set(id, self.frame_no)
      if !self.laid_reads.contains(id) {
        self.laid_reads.set(id, (v, loc))
      }
    }
    .Size(id, v, loc) => {
      self.laid_watch.set(id, self.frame_no)
      if !self.size_reads.contains(id) {
        self.size_reads.set(id, (v, loc))
      }
    }
    LaidRead::Left(id, v, loc) => {
      if !self.left_reads.contains(id) {
        self.left_reads.set(id, (v, loc))
      }
    }
    .Sel(v, loc) =>
    if sel_read.v is Option::None {
      sel_read.v = Some((v, loc))
    }
  }
}

///|
/// Whether what came for this frame came to the part kept by `id` (Ctx::part_nodes): all of it does, but where it was
/// the hand's alone and went to one old view's part (NodesRun's evented_only), only that one.
fn evented_for(id : Int) -> Bool {
  nodes_run.evented && (nodes_run.evented_only < 0 || nodes_run.evented_only == id)
}

///|
/// A part that flows (part_nodes' `flows`): across what holds it, as tall as what it holds.
// kept across runs: a value (no field of it changes)
// moved to 00_init_order.pion: part_flowing
