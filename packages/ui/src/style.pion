// Style, Patch, TextStyle, TextPatch, Look, Drawing, Response, and Changed[T].
// Ported from libs/mbui/src/ui/style.mbt, draw.mbt, response.mbt.

pub struct Patch {
  pub row : Option[Bool]
  pub w : Option[Len]
  pub h : Option[Len]
  pub min_w : Option[Len]
  pub max_w : Option[Len]
  pub min_h : Option[Len]
  pub max_h : Option[Len]
  pub p : Option[Space]
  pub px : Option[Space]
  pub py : Option[Space]
  pub pl : Option[Space]
  pub pr : Option[Space]
  pub pt : Option[Space]
  pub pb : Option[Space]
  pub m : Option[Space]
  pub mx : Option[Space]
  pub my : Option[Space]
  pub ml : Option[Space]
  pub mr : Option[Space]
  pub mt : Option[Space]
  pub mb : Option[Space]
  pub gap : Option[Space]
  pub align : Option[Align]
  pub justify : Option[Justify]
  pub bg : Option[Color]
  pub radius : Option[Radius]
  pub border : Option[Stroke]
  pub border_color : Option[Color]
  pub dashed : Option[Bool]
  pub shadow : Option[Shadow]
  pub clip : Option[Bool]
  pub opacity : Option[Opacity]
}

pub struct Style {
  pub base : Patch
  pub narrow : Option[Patch]
  pub dark : Option[Patch]
  pub selected : Option[Patch]
  pub hovered : Option[Patch]
  pub focused : Option[Patch]
  pub pressed : Option[Patch]
  pub disabled : Option[Patch]
}

pub fn patch(
  row? : Bool,
  w? : Len,
  h? : Len,
  min_w? : Len,
  max_w? : Len,
  min_h? : Len,
  max_h? : Len,
  p? : Space,
  px? : Space,
  py? : Space,
  pl? : Space,
  pr? : Space,
  pt? : Space,
  pb? : Space,
  m? : Space,
  mx? : Space,
  my? : Space,
  ml? : Space,
  mr? : Space,
  mt? : Space,
  mb? : Space,
  gap? : Space,
  align? : Align,
  justify? : Justify,
  bg? : Color,
  radius? : Radius,
  border? : Stroke,
  border_color? : Color,
  dashed? : Bool,
  shadow? : Shadow,
  clip? : Bool,
  opacity? : Opacity,
) -> Patch {
  Patch::{
    row, w, h, min_w, max_w, min_h, max_h,
    p, px, py, pl, pr, pt, pb,
    m, mx, my, ml, mr, mt, mb,
    gap, align, justify, bg, radius, border, border_color, dashed, shadow, clip, opacity,
  }
}

pub fn style(
  row? : Bool,
  w? : Len,
  h? : Len,
  min_w? : Len,
  max_w? : Len,
  min_h? : Len,
  max_h? : Len,
  p? : Space,
  px? : Space,
  py? : Space,
  pl? : Space,
  pr? : Space,
  pt? : Space,
  pb? : Space,
  m? : Space,
  mx? : Space,
  my? : Space,
  ml? : Space,
  mr? : Space,
  mt? : Space,
  mb? : Space,
  gap? : Space,
  align? : Align,
  justify? : Justify,
  bg? : Color,
  radius? : Radius,
  border? : Stroke,
  border_color? : Color,
  dashed? : Bool,
  shadow? : Shadow,
  clip? : Bool,
  opacity? : Opacity,
  narrow? : Patch,
  dark? : Patch,
  selected? : Patch,
  hovered? : Patch,
  focused? : Patch,
  pressed? : Patch,
  disabled? : Patch,
) -> Style {
  Style::{
    base: Patch::{
      row, w, h, min_w, max_w, min_h, max_h,
      p, px, py, pl, pr, pt, pb,
      m, mx, my, ml, mr, mt, mb,
      gap, align, justify, bg, radius, border, border_color, dashed, shadow, clip, opacity,
    },
    narrow, dark, selected, hovered, focused, pressed, disabled,
  }
}

fn opt_over[T](a : Option[T], b : Option[T]) -> Option[T] {
  match b {
    Some(_) => b
    None => a
  }
}

fn opt_patch_then(a : Option[Patch], b : Option[Patch]) -> Option[Patch] {
  match (a, b) {
    (Some(x), Some(y)) => Some(x.then(y))
    (Some(_), None) => a
    (None, Some(_)) => b
    _ => None
  }
}

pub fn Patch::then(self : Patch, o : Patch) -> Patch {
  let a = self
  let a_px = match o.p { Some(_) => None; None => a.px }
  let a_py = match o.p { Some(_) => None; None => a.py }
  let a_pl = match (o.p, o.px) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.pl }
  let a_pr = match (o.p, o.px) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.pr }
  let a_pt = match (o.p, o.py) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.pt }
  let a_pb = match (o.p, o.py) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.pb }
  let a_mx = match o.m { Some(_) => None; None => a.mx }
  let a_my = match o.m { Some(_) => None; None => a.my }
  let a_ml = match (o.m, o.mx) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.ml }
  let a_mr = match (o.m, o.mx) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.mr }
  let a_mt = match (o.m, o.my) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.mt }
  let a_mb = match (o.m, o.my) { (Some(_), _) => None; (_, Some(_)) => None; _ => a.mb }
  Patch::{
    row: opt_over(a.row, o.row),
    w: opt_over(a.w, o.w),
    h: opt_over(a.h, o.h),
    min_w: opt_over(a.min_w, o.min_w),
    max_w: opt_over(a.max_w, o.max_w),
    min_h: opt_over(a.min_h, o.min_h),
    max_h: opt_over(a.max_h, o.max_h),
    p: opt_over(a.p, o.p),
    px: opt_over(a_px, o.px),
    py: opt_over(a_py, o.py),
    pl: opt_over(a_pl, o.pl),
    pr: opt_over(a_pr, o.pr),
    pt: opt_over(a_pt, o.pt),
    pb: opt_over(a_pb, o.pb),
    m: opt_over(a.m, o.m),
    mx: opt_over(a_mx, o.mx),
    my: opt_over(a_my, o.my),
    ml: opt_over(a_ml, o.ml),
    mr: opt_over(a_mr, o.mr),
    mt: opt_over(a_mt, o.mt),
    mb: opt_over(a_mb, o.mb),
    gap: opt_over(a.gap, o.gap),
    align: opt_over(a.align, o.align),
    justify: opt_over(a.justify, o.justify),
    bg: opt_over(a.bg, o.bg),
    radius: opt_over(a.radius, o.radius),
    border: opt_over(a.border, o.border),
    border_color: opt_over(a.border_color, o.border_color),
    dashed: opt_over(a.dashed, o.dashed),
    shadow: opt_over(a.shadow, o.shadow),
    clip: opt_over(a.clip, o.clip),
    opacity: opt_over(a.opacity, o.opacity),
  }
}

pub fn Style::then(self : Style, o : Style) -> Style {
  Style::{
    base: self.base.then(o.base),
    narrow: opt_patch_then(self.narrow, o.narrow),
    dark: opt_patch_then(self.dark, o.dark),
    selected: opt_patch_then(self.selected, o.selected),
    hovered: opt_patch_then(self.hovered, o.hovered),
    focused: opt_patch_then(self.focused, o.focused),
    pressed: opt_patch_then(self.pressed, o.pressed),
    disabled: opt_patch_then(self.disabled, o.disabled),
  }
}

pub struct TextPatch {
  pub size : Option[TextSize]
  pub leading : Option[Leading]
  pub tracking : Option[Tracking]
  pub weight : Option[Weight]
  pub color : Option[Color]
  pub italic : Option[Bool]
  pub mono : Option[Bool]
  pub tabular : Option[Bool]
  pub underline : Option[Bool]
  pub strike : Option[Bool]
  pub wrap : Option[Bool]
  pub max_lines : Option[Int]
}

pub struct TextStyle {
  pub base : TextPatch
  pub narrow : Option[TextPatch]
  pub dark : Option[TextPatch]
  pub selected : Option[TextPatch]
  pub hovered : Option[TextPatch]
  pub disabled : Option[TextPatch]
}

pub fn text_patch(
  size? : TextSize,
  leading? : Leading,
  tracking? : Tracking,
  weight? : Weight,
  color? : Color,
  italic? : Bool,
  mono? : Bool,
  tabular? : Bool,
  underline? : Bool,
  strike? : Bool,
  wrap? : Bool,
  max_lines? : Int,
) -> TextPatch {
  TextPatch::{ size, leading, tracking, weight, color, italic, mono, tabular, underline, strike, wrap, max_lines }
}

pub fn text_style(
  size? : TextSize,
  leading? : Leading,
  tracking? : Tracking,
  weight? : Weight,
  color? : Color,
  italic? : Bool,
  mono? : Bool,
  tabular? : Bool,
  underline? : Bool,
  strike? : Bool,
  wrap? : Bool,
  max_lines? : Int,
  narrow? : TextPatch,
  dark? : TextPatch,
  selected? : TextPatch,
  hovered? : TextPatch,
  disabled? : TextPatch,
) -> TextStyle {
  TextStyle::{
    base: TextPatch::{ size, leading, tracking, weight, color, italic, mono, tabular, underline, strike, wrap, max_lines },
    narrow, dark, selected, hovered, disabled,
  }
}

pub fn TextPatch::then(self : TextPatch, o : TextPatch) -> TextPatch {
  TextPatch::{
    size: opt_over(self.size, o.size),
    leading: opt_over(self.leading, o.leading),
    tracking: opt_over(self.tracking, o.tracking),
    weight: opt_over(self.weight, o.weight),
    color: opt_over(self.color, o.color),
    italic: opt_over(self.italic, o.italic),
    mono: opt_over(self.mono, o.mono),
    tabular: opt_over(self.tabular, o.tabular),
    underline: opt_over(self.underline, o.underline),
    strike: opt_over(self.strike, o.strike),
    wrap: opt_over(self.wrap, o.wrap),
    max_lines: opt_over(self.max_lines, o.max_lines),
  }
}

fn opt_text_patch_then(a : Option[TextPatch], b : Option[TextPatch]) -> Option[TextPatch] {
  match (a, b) {
    (Some(x), Some(y)) => Some(x.then(y))
    (Some(_), None) => a
    (None, Some(_)) => b
    _ => None
  }
}

pub fn TextStyle::then(self : TextStyle, o : TextStyle) -> TextStyle {
  TextStyle::{
    base: self.base.then(o.base),
    narrow: opt_text_patch_then(self.narrow, o.narrow),
    dark: opt_text_patch_then(self.dark, o.dark),
    selected: opt_text_patch_then(self.selected, o.selected),
    hovered: opt_text_patch_then(self.hovered, o.hovered),
    disabled: opt_text_patch_then(self.disabled, o.disabled),
  }
}

/// Visual transform/opacity overlay over layout.
#derive(Eq)
pub struct Look {
  pub alpha : Double
  pub dx : Double
  pub dy : Double
  pub sx : Double
  pub sy : Double
  pub ox : Double
  pub oy : Double
  pub rot : Double
  pub circle : Double
  pub words : Double
}

pub let still_look : Look = Look::{
  alpha: 1.0,
  dx: 0.0,
  dy: 0.0,
  sx: 1.0,
  sy: 1.0,
  ox: 0.5,
  oy: 0.5,
  rot: 0.0,
  circle: 0.0,
  words: 1.0,
}

pub fn look(
  alpha~ : Double = 1.0,
  dx~ : Double = 0.0,
  dy~ : Double = 0.0,
  scale~ : Double = 1.0,
  sx? : Double,
  sy? : Double,
  ox~ : Double = 0.5,
  oy~ : Double = 0.5,
  rot~ : Double = 0.0,
  circle~ : Double = 0.0,
  words~ : Double = 1.0,
) -> Look {
  let fx = match sx { Some(v) => v; None => scale }
  let fy = match sy { Some(v) => v; None => scale }
  Look::{ alpha, dx, dy, sx: fx, sy: fy, ox, oy, rot, circle, words }
}

/// Plain (identity) look.
pub fn plain() -> Look {
  still_look
}

pub fn Look::then(self : Look, o : Look) -> Look {
  let scales = self.sx != 1.0 || self.sy != 1.0 || self.rot != 0.0
  Look::{
    alpha: self.alpha * o.alpha,
    dx: self.dx + o.dx,
    dy: self.dy + o.dy,
    sx: self.sx * o.sx,
    sy: self.sy * o.sy,
    ox: if scales { self.ox } else { o.ox },
    oy: if scales { self.oy } else { o.oy },
    rot: self.rot + o.rot,
    circle: if self.circle > 0.0 { self.circle } else { o.circle },
    words: self.words * o.words,
  }
}

pub fn Look::is_still(self : Look) -> Bool {
  self.alpha == 1.0 &&
  self.dx == 0.0 &&
  self.dy == 0.0 &&
  self.sx == 1.0 &&
  self.sy == 1.0 &&
  self.rot == 0.0 &&
  self.circle == 0.0 &&
  self.words == 1.0
}

/// Captured drawing instances of a node for exit animations.
pub struct Drawing {
  pub insts : Array[Double]
  pub segs : Array[Double]
  pub mut x : Double
  pub mut y : Double
  pub mut w : Double
  pub mut h : Double
  pub mut frame : Int
}

pub fn Drawing::new() -> Drawing {
  Drawing::{ insts: [], segs: [], x: 0.0, y: 0.0, w: 0.0, h: 0.0, frame: -1 }
}

pub fn Drawing::copy(self : Drawing) -> Drawing {
  Drawing::{
    insts: self.insts.copy(),
    segs: self.segs.copy(),
    x: self.x,
    y: self.y,
    w: self.w,
    h: self.h,
    frame: self.frame,
  }
}

pub fn Drawing::is_empty(self : Drawing) -> Bool {
  self.insts.length() == 0
}

/// Widget interaction response.
pub struct Response {
  pub id : Int
  pub clicked : Bool
  pub long_pressed : Bool
  pub right_clicked : Option[(Double, Double)]
  pub hovered : Bool
  pub pressed : Bool
  pub focused : Bool
  pub focus_shown : Bool
  pub gained_focus : Bool
  pub changed : Bool
  pub bounds : (Double, Double, Double, Double)
}

pub fn Response::none() -> Response {
  Response::{
    id: 0,
    clicked: false,
    long_pressed: false,
    right_clicked: None,
    hovered: false,
    pressed: false,
    focused: false,
    focus_shown: false,
    gained_focus: false,
    changed: false,
    bounds: (0.0, 0.0, 0.0, 0.0),
  }
}

pub fn Response::changed_to(self : Response, yes : Bool) -> Response {
  Response::{
    id: self.id,
    clicked: self.clicked,
    long_pressed: self.long_pressed,
    right_clicked: self.right_clicked,
    hovered: self.hovered,
    pressed: self.pressed,
    focused: self.focused,
    focus_shown: self.focus_shown,
    gained_focus: self.gained_focus,
    changed: self.changed || yes,
    bounds: self.bounds,
  }
}

pub fn Response::rect(self : Response) -> (Double, Double, Double, Double) {
  self.bounds
}

/// Value paired with widget interaction response.
pub struct Changed[T] {
  pub value : T
  pub response : Response
}

pub fn Changed::changed[T](self : Changed[T]) -> Bool {
  self.response.changed
}
