// Style values (ui's ui/style.pion): a box's (Style, its state blocks Patch) and words' (TextStyle, TextPatch); made with
// `style(…)`, `patch(…)`, `text_style(…)`, `text_patch(…)`, or a Style read from its text (`css("…")`, style_css.pion:
// what a named constant is said with), put together with `then`. Every property is a token of
// style_tokens.pion; one not said is the default (Ctx::box's, Ctx::text's) or what the style under it says.

///|
/// What a box looks like, every property optional (None: not said here). Padding from the finer to the coarser: `pl`
/// `pr` `pt` `pb` over `px` `py` over `p`; the margins (`m`…) the same.

#derive(Eq)
pub struct Patch {
  pub row : Option[Bool]
  pub w : Option[Len]
  pub h : Option[Len]
  pub min_w : Option[Len]
  pub max_w : Option[Len]
  pub min_h : Option[Len]
  pub max_h : Option[Len]
  pub p : Option[Space]
  pub px : Option[Space]
  pub py : Option[Space]
  pub pl : Option[Space]
  pub pr : Option[Space]
  pub pt : Option[Space]
  pub pb : Option[Space]
  pub m : Option[Space]
  pub mx : Option[Space]
  pub my : Option[Space]
  pub ml : Option[Space]
  pub mr : Option[Space]
  pub mt : Option[Space]
  pub mb : Option[Space]
  pub gap : Option[Space]
  pub align : Option[Align]
  pub justify : Option[Justify]
  pub bg : Option[Color]
  pub radius : Option[Radius]
  pub border : Option[Stroke]
  pub border_color : Option[Color]
  pub dashed : Option[Bool]
  pub shadow : Option[Shadow]
  pub clip : Option[Bool]
  pub opacity : Option[Opacity]
}

///|
/// A box's style: what it looks like, and what it looks like instead in a state (each a Patch over it). The states
/// are laid on in one order, the later winning: narrow, dark, selected, hovered, focused, pressed, disabled; the
/// ground of `hovered` and `pressed` laid over the ground under it (Style::resolve).

#derive(Eq)
pub struct Style {
  pub base : Patch
  pub narrow : Option[Patch]
  pub dark : Option[Patch]
  pub selected : Option[Patch]
  pub hovered : Option[Patch]
  pub focused : Option[Patch]
  pub pressed : Option[Patch]
  pub disabled : Option[Patch]
}

///|
/// A box's look, every property a token (style_tokens.pion); a state's block in place of none.
pub fn patch(row? : Bool, w? : Len, h? : Len, min_w? : Len, max_w? : Len, min_h? : Len, max_h? : Len, p? : Space, px? : Space, py? : Space, pl? : Space, pr? : Space, pt? : Space, pb? : Space, m? : Space, mx? : Space, my? : Space, ml? : Space, mr? : Space, mt? : Space, mb? : Space, gap? : Space, align? : Align, justify? : Justify, bg? : Color, radius? : Radius, border? : Stroke, border_color? : Color, dashed? : Bool, shadow? : Shadow, clip? : Bool, opacity? : Opacity) -> Patch {
  Patch::{
    row: row,
    w: w,
    h: h,
    min_w: min_w,
    max_w: max_w,
    min_h: min_h,
    max_h: max_h,
    p: p,
    px: px,
    py: py,
    pl: pl,
    pr: pr,
    pt: pt,
    pb: pb,
    m: m,
    mx: mx,
    my: my,
    ml: ml,
    mr: mr,
    mt: mt,
    mb: mb,
    gap: gap,
    align: align,
    justify: justify,
    bg: bg,
    radius: radius,
    border: border,
    border_color: border_color,
    dashed: dashed,
    shadow: shadow,
    clip: clip,
    opacity: opacity,
  }
}

///|
/// A box's style: its look (as `patch`) and its states' blocks.
pub fn style(row? : Bool, w? : Len, h? : Len, min_w? : Len, max_w? : Len, min_h? : Len, max_h? : Len, p? : Space, px? : Space, py? : Space, pl? : Space, pr? : Space, pt? : Space, pb? : Space, m? : Space, mx? : Space, my? : Space, ml? : Space, mr? : Space, mt? : Space, mb? : Space, gap? : Space, align? : Align, justify? : Justify, bg? : Color, radius? : Radius, border? : Stroke, border_color? : Color, dashed? : Bool, shadow? : Shadow, clip? : Bool, opacity? : Opacity, narrow? : Patch, dark? : Patch, selected? : Patch, hovered? : Patch, focused? : Patch, pressed? : Patch, disabled? : Patch) -> Style {
  Style::{
    base: Patch::{
      row: row,
      w: w,
      h: h,
      min_w: min_w,
      max_w: max_w,
      min_h: min_h,
      max_h: max_h,
      p: p,
      px: px,
      py: py,
      pl: pl,
      pr: pr,
      pt: pt,
      pb: pb,
      m: m,
      mx: mx,
      my: my,
      ml: ml,
      mr: mr,
      mt: mt,
      mb: mb,
      gap: gap,
      align: align,
      justify: justify,
      bg: bg,
      radius: radius,
      border: border,
      border_color: border_color,
      dashed: dashed,
      shadow: shadow,
      clip: clip,
      opacity: opacity,
    },
    narrow: narrow,
    dark: dark,
    selected: selected,
    hovered: hovered,
    focused: focused,
    pressed: pressed,
    disabled: disabled,
  }
}

///|
/// `a` if said, else `b`.
fn first[T](a : Option[T], b : Option[T]) -> Option[T] {
  match a {
    Some(_) => a
    Option::None => b
  }
}

///|
fn or_else[T](b : Option[T], a : Option[T]) -> Option[T] {
  match b {
    Some(_) => b
    Option::None => a
  }
}

///|
/// `self` with what `o` says over it. Padding said coarser in `o` takes the finer of `self` with it: `o`'s `p` is
/// every side's, its `px` the left's and the right's.
pub fn Patch::then(self : Patch, o : Patch) -> Patch {
  let a = self
  // what o's coarser padding covers is o's, whatever a said finer
  let a_px = if o.p is Some(_) { None } else { a.px }
  let a_py = if o.p is Some(_) { None } else { a.py }
  let a_pl = if o.p is Some(_) || o.px is Some(_) { None } else { a.pl }
  let a_pr = if o.p is Some(_) || o.px is Some(_) { None } else { a.pr }
  let a_pt = if o.p is Some(_) || o.py is Some(_) { None } else { a.pt }
  let a_pb = if o.p is Some(_) || o.py is Some(_) { None } else { a.pb }
  let a_mx = if o.m is Some(_) { None } else { a.mx }
  let a_my = if o.m is Some(_) { None } else { a.my }
  let a_ml = if o.m is Some(_) || o.mx is Some(_) { None } else { a.ml }
  let a_mr = if o.m is Some(_) || o.mx is Some(_) { None } else { a.mr }
  let a_mt = if o.m is Some(_) || o.my is Some(_) { None } else { a.mt }
  let a_mb = if o.m is Some(_) || o.my is Some(_) { None } else { a.mb }
  Patch::{
    row: or_else(o.row, a.row),
    w: or_else(o.w, a.w),
    h: or_else(o.h, a.h),
    min_w: or_else(o.min_w, a.min_w),
    max_w: or_else(o.max_w, a.max_w),
    min_h: or_else(o.min_h, a.min_h),
    max_h: or_else(o.max_h, a.max_h),
    p: or_else(o.p, a.p),
    px: or_else(o.px, a_px),
    py: or_else(o.py, a_py),
    pl: or_else(o.pl, a_pl),
    pr: or_else(o.pr, a_pr),
    pt: or_else(o.pt, a_pt),
    pb: or_else(o.pb, a_pb),
    m: or_else(o.m, a.m),
    mx: or_else(o.mx, a_mx),
    my: or_else(o.my, a_my),
    ml: or_else(o.ml, a_ml),
    mr: or_else(o.mr, a_mr),
    mt: or_else(o.mt, a_mt),
    mb: or_else(o.mb, a_mb),
    gap: or_else(o.gap, a.gap),
    align: or_else(o.align, a.align),
    justify: or_else(o.justify, a.justify),
    bg: or_else(o.bg, a.bg),
    radius: or_else(o.radius, a.radius),
    border: or_else(o.border, a.border),
    border_color: or_else(o.border_color, a.border_color),
    dashed: or_else(o.dashed, a.dashed),
    shadow: or_else(o.shadow, a.shadow),
    clip: or_else(o.clip, a.clip),
    opacity: or_else(o.opacity, a.opacity),
  }
}

///|
fn opt_with(a : Option[Patch], b : Option[Patch]) -> Option[Patch] {
  match (a, b) {
    (Some(a), Some(b)) => Some(a.then(b))
    (None, _) => b
    (_, None) => a
  }
}

///|
/// `self` with what `o` says over it, its state blocks too (each over the same state's: Patch::then).
pub fn Style::then(self : Style, o : Style) -> Style {
  Style::{
    base: self.base.then(o.base),
    narrow: opt_with(self.narrow, o.narrow),
    dark: opt_with(self.dark, o.dark),
    selected: opt_with(self.selected, o.selected),
    hovered: opt_with(self.hovered, o.hovered),
    focused: opt_with(self.focused, o.focused),
    pressed: opt_with(self.pressed, o.pressed),
    disabled: opt_with(self.disabled, o.disabled),
  }
}

///|
/// The look of `s` for a node in these states, its blocks laid on in their order.
fn Style::resolve(self : Style, narrow : Bool, dark : Bool, selected : Bool, hovered : Bool, focused : Bool, pressed : Bool, disabled : Bool) -> Patch {
  // (in this order, one after another, nothing made to go through them: a box's look is resolved for each box on
  // every frame)
  let mut p = self.base
  match self.narrow {
    Some(b) if narrow => p = p.then(b)
    _ => ()
  }
  match self.dark {
    Some(b) if dark => p = p.then(b)
    _ => ()
  }
  match self.selected {
    Some(b) if selected => p = p.then(b)
    _ => ()
  }
  // what answers the hand (pointed at, pressed) is laid over the ground under it, the box's own or its selected one,
  // not put in its place: a tint over any ground is a step more, a box pointed at in a box pointed at a step more again
  // (the kit's `tinted`)
  match self.hovered {
    Some(b) if hovered => p = p.lit_by(b)
    _ => ()
  }
  match self.focused {
    Some(b) if focused => p = p.then(b)
    _ => ()
  }
  match self.pressed {
    Some(b) if pressed => p = p.lit_by(b)
    _ => ()
  }
  match self.disabled {
    Some(b) if disabled => p = p.then(b)
    _ => ()
  }
  p
}

///|
/// `self` with a hand's state block `o` over it: what `o` says in place of what `self` does, but its ground over
/// `self`'s.
fn Patch::lit_by(self : Patch, o : Patch) -> Patch {
  let p = self.then(o)
  match (self.bg, o.bg) {
    (Some(under), Some(top)) if under != Color::Clear => { let __mbt_su_b_155 : Patch = p; Patch::{ row: __mbt_su_b_155.row, w: __mbt_su_b_155.w, h: __mbt_su_b_155.h, min_w: __mbt_su_b_155.min_w, max_w: __mbt_su_b_155.max_w, min_h: __mbt_su_b_155.min_h, max_h: __mbt_su_b_155.max_h, p: __mbt_su_b_155.p, px: __mbt_su_b_155.px, py: __mbt_su_b_155.py, pl: __mbt_su_b_155.pl, pr: __mbt_su_b_155.pr, pt: __mbt_su_b_155.pt, pb: __mbt_su_b_155.pb, m: __mbt_su_b_155.m, mx: __mbt_su_b_155.mx, my: __mbt_su_b_155.my, ml: __mbt_su_b_155.ml, mr: __mbt_su_b_155.mr, mt: __mbt_su_b_155.mt, mb: __mbt_su_b_155.mb, gap: __mbt_su_b_155.gap, align: __mbt_su_b_155.align, justify: __mbt_su_b_155.justify, bg: Some(Color::Over(under, top)), radius: __mbt_su_b_155.radius, border: __mbt_su_b_155.border, border_color: __mbt_su_b_155.border_color, dashed: __mbt_su_b_155.dashed, shadow: __mbt_su_b_155.shadow, clip: __mbt_su_b_155.clip, opacity: __mbt_su_b_155.opacity } }
    _ => p
  }
}

///|
/// What words look like, every property optional. `wrap=false`: one line, cut with an ellipsis; `max_lines`: wrapped
/// words cut after that many lines, the last ending in an ellipsis; `tracking`: letter spacing; `leading`: the line's
/// height in place of the size's own; `tabular`: digits all one width, for a number that changes where it stands (a
/// percentage, a time running: CSS's font-variant-numeric tabular-nums). `balance`: wrapped words broken where their
/// lines come out more even on as many lines as they would take (CSS's text-wrap: balance): a note's, its short last
/// line drawn in toward the others.
pub struct TextPatch {
  pub size : Option[TextSize]
  pub weight : Option[Weight]
  pub color : Option[Color]
  pub w : Option[Len]
  pub center : Option[Bool]
  pub wrap : Option[Bool]
  pub tracking : Option[Tracking]
  pub max_lines : Option[Int]
  pub leading : Option[Leading]
  pub tabular : Option[Bool]
  pub balance : Option[Bool]
}

///|
/// Words' style: their look, and instead in the dark and on a narrow screen (the states words have).
pub struct TextStyle {
  pub base : TextPatch
  pub narrow : Option[TextPatch]
  pub dark : Option[TextPatch]
}

///|
pub fn text_patch(size? : TextSize, weight? : Weight, color? : Color, w? : Len, center? : Bool, wrap? : Bool, tracking? : Tracking, max_lines? : Int, leading? : Leading, tabular? : Bool, balance? : Bool) -> TextPatch {
  TextPatch::{ size: size, weight: weight, color: color, w: w, center: center, wrap: wrap, tracking: tracking, max_lines: max_lines, leading: leading, tabular: tabular, balance: balance }
}

///|
pub fn text_style(size? : TextSize, weight? : Weight, color? : Color, w? : Len, center? : Bool, wrap? : Bool, tracking? : Tracking, max_lines? : Int, leading? : Leading, tabular? : Bool, balance? : Bool, narrow? : TextPatch, dark? : TextPatch) -> TextStyle {
  TextStyle::{ base: TextPatch::{ size: size, weight: weight, color: color, w: w, center: center, wrap: wrap, tracking: tracking, max_lines: max_lines, leading: leading, tabular: tabular, balance: balance }, narrow: narrow, dark: dark }
}

///|
pub fn TextPatch::then(self : TextPatch, o : TextPatch) -> TextPatch {
  TextPatch::{
    size: or_else(o.size, self.size),
    weight: or_else(o.weight, self.weight),
    color: or_else(o.color, self.color),
    w: or_else(o.w, self.w),
    center: or_else(o.center, self.center),
    wrap: or_else(o.wrap, self.wrap),
    tracking: or_else(o.tracking, self.tracking),
    max_lines: or_else(o.max_lines, self.max_lines),
    leading: or_else(o.leading, self.leading),
    tabular: or_else(o.tabular, self.tabular),
    balance: or_else(o.balance, self.balance),
  }
}

///|
fn opt_text_with(a : Option[TextPatch], b : Option[TextPatch]) -> Option[TextPatch] {
  match (a, b) {
    (Some(a), Some(b)) => Some(a.then(b))
    (None, _) => b
    (_, None) => a
  }
}

///|
pub fn TextStyle::then(self : TextStyle, o : TextStyle) -> TextStyle {
  TextStyle::{
    base: self.base.then(o.base),
    narrow: opt_text_with(self.narrow, o.narrow),
    dark: opt_text_with(self.dark, o.dark),
  }
}

///|
fn TextStyle::resolve(self : TextStyle, narrow : Bool, dark : Bool) -> TextPatch {
  let mut p = self.base
  match self.narrow {
    Some(b) if narrow => p = p.then(b)
    _ => ()
  }
  match self.dark {
    Some(b) if dark => p = p.then(b)
    _ => ()
  }
  p
}
