fn paint_watch_of() -> signals::Watch {
  ride_paint_watch
}

fn h_frame_owed() -> Unit {
  ()
}

/// Thin frame context wrapping the real `Scene` for `view_ride.pion`.
struct Ctx {
  scene : Scene
  mut inst : Array[Double]
  mut ninst : Int
  mut segs : Array[Double]
  mut scale : Double
  mut build_no : Int
  mut cycling : Bool
  mut wants_frame : Bool
  mut wake_at : Double
  mut clock : Double
}

fn Ctx::from_scene(sc : Scene, now : Double) -> Ctx {
  Ctx::{
    scene: sc,
    inst: sc.inst,
    ninst: sc.ninst,
    segs: sc.segs,
    scale: sc.scale,
    build_no: view_app.frame_no,
    cycling: false,
    wants_frame: false,
    wake_at: -1.0,
    clock: now,
  }
}

fn Ctx::sync_to_scene(self : Ctx) -> Unit {
  self.scene.ninst = self.ninst
}

fn Ctx::sync_from_scene(self : Ctx) -> Unit {
  self.ninst = self.scene.ninst
}

fn Ctx::grow(self : Ctx) -> Unit {
  let cur = self.inst.length()
  let next_cap = if cur == 0 { 256 * inst_size } else { cur * 2 }
  while self.inst.length() < next_cap {
    self.inst.push(0.0)
  }
}

fn Ctx::moves_now(self : Ctx) -> Bool {
  let _ = self
  false
}

fn Ctx::now_before(self : Ctx, _end : Double) -> Double {
  self.clock
}

fn Ctx::segs_cut(self : Ctx, n : Int) -> Unit {
  while self.segs.length() > n {
    let _ = self.segs.pop()
  }
}

fn Ctx::segs_from(self : Ctx, start : Int) -> Array[Double] {
  let out : Array[Double] = []
  let mut i = start
  while i < self.segs.length() {
    out.push(self.segs[i])
    i += 1
  }
  out
}

fn Ctx::segs_put(self : Ctx, segs : Array[Double], _pack : SegPack) -> Double {
  let base = self.segs.length()
  for v in segs {
    self.segs.push(v)
  }
  (base / 4).to_double()
}

fn Ctx::segs_whole(self : Ctx) -> Unit {
  let _ = self
}

fn Ctx::segs_whole_at(self : Ctx) -> Int {
  self.segs.length() / 4
}

fn Ctx::view_picture(self : Ctx, _c : view::Content, _x : Double, _y : Double, _s : Double, _a : Double) -> Unit {
  let _ = self
}

fn Ctx::view_unseen(self : Ctx, _c : view::Content, _s : Double) -> Unit {
  let _ = self
}

pub fn view_ride_drawn_now() -> Int {
  ride_drawn.v
}

pub fn view_ride_drawn_reset() -> Unit {
  ride_drawn.v = 0
}

pub fn view_ride_heads_now() -> Int {
  ride_heads.v
}

pub fn view_ride_groups_count() -> Int {
  ride_groups.length()
}

pub fn view_ride_glyphs_gone_now() -> Int {
  ride_glyphs_gone.v
}
