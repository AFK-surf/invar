let words_zoom : signals::Ref[Double] = signals::ref_new(1.0)
let shooting : signals::Ref[Bool] = signals::ref_new(false)
let cycle_tagged : signals::Ref[Bool] = signals::ref_new(false)
let old_whole : signals::Ref[Bool] = signals::ref_new(false)
let old_box_of : ByNode[Int] = ByNode::new()
let paint_phase : signals::Ref[Int] = signals::ref_new(0)
let paint_said : signals::Ref[String] = signals::ref_new("")
let ride_paint_watch : signals::Watch = signals::watch(fn() { () })
let ride_last_tree_id : signals::Ref[Int] = signals::ref_new(-1)
let ride_last_theme_dark : signals::Ref[Bool] = signals::ref_new(false)
let ride_last_theme_bg : signals::Ref[Int64] = signals::ref_new(0L)
let ride_last_theme_fg : signals::Ref[Int64] = signals::ref_new(0L)
