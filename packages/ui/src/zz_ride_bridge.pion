}

struct SegPack {
  mut packed : Option[Array[Double]]
  mut seen : Bool
}

fn SegPack::new() -> SegPack {
  SegPack::{ packed: None, seen: false }
}

struct InstOwners {
  owner : Array[Int]
  cell : Array[(Double, Double)]
  tree : Array[Option[view::NodeId]]
  mark : Array[Int]
}

let inst_owners : InstOwners = InstOwners::{
  owner: [],
  cell: [],
  tree: [],
  mark: [],
}

fn inst_owners_kept() -> Bool {
  false
}

fn inst_owned(q : Int) -> Unit {
  while inst_owners.owner.length() <= q {
    inst_owners.owner.push(-1)
    inst_owners.cell.push((0.0, 1.0))
    inst_owners.tree.push(None)
    inst_owners.mark.push(0)
  }
}

struct DrawStateBridge {
  mut mode : Int
  scrims : Array[Int]
}

let dr : DrawStateBridge = DrawStateBridge::{
  mode: 0,
  scrims: [],
}

