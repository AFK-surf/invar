  mut frost : Double
  mut contrast : Bool
  mut forced : Int
  mut in_group : Int
  mut ink_x : Double
  mut ink_y : Double
  mut ink_r : Double
}

let glass_paint : GlassPaint = GlassPaint::{
  run: 0,
  frost_run: 0,
  liquid_run: 0,
  liquid_blur: 0.0,
  liquid_first: -1,
  liquid_y0: 0.0,
  liquid_y1: 0.0,
  run_start: -1,
  run_len: 0,
  solid: false,
  frost: 0.0,
  contrast: false,
  forced: -1,
  in_group: 0,
  ink_x: 0.0,
