import "mbt_compat"

// GB18030 decoded by the Tester's fake host (fake_host.pion: @hostapi.decode_charset), as a system's tables decode it
// (Android's, Apple's, Windows', a browser's TextDecoder): a test's program asks no system. Made by Python's codec
// (scripts of a one-off: the two-byte rows as they decode, the four-byte runs of the BMP where code points follow each
// other); what is not GB18030, U+FFFD.

///|
/// The two-byte characters: a row each of lead bytes 0x81 to 0xFE, 190 each of trail bytes 0x40 to 0xFE but 0x7F.
// kept across runs: a table, never written
// moved to 00_init_order.pion: gb_rows

///|
/// The four-byte sequences of the BMP: (their index, its code point) where a run of code points following each other
/// starts, in order.
// kept across runs: a table, never written
// moved to 00_init_order.pion: gb_runs

///|
fn gb_four(i : Int) -> Int {
  if i >= 189000 {
    let cp = 0x10000 + (i - 189000)
    return if cp <= 0x10FFFF { cp } else { 0xFFFD }
  }
  if i >= 39420 {
    return 0xFFFD
  }
  let mut lo = 0
  let mut hi = gb_runs.length() - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if gb_runs[mid].0 <= i {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  let (start, cp) = gb_runs[lo]
  if i < start {
    0xFFFD
  } else {
    let c = cp + (i - start)
    let next = if lo + 1 < gb_runs.length() { gb_runs[lo + 1].1 } else { 0x10000 }
    if c < next && (c < 0xD800 || c >= 0xE000) { c } else { 0xFFFD }
  }
}

///|
/// `data` as GB18030 (GBK and GB2312 are in it): what is not, U+FFFD.
fn gb18030_decode(data : Bytes) -> String {
  let n = data.length()
  let out = { let _ = n; StringBuilder() }
  let mut i = 0
  while i < n {
    let a = data[i].to_int()
    if a < 0x80 {
      out.write_char(a.unsafe_to_char())
      i += 1
      continue
    }
    if a == 0x80 || a == 0xFF || i + 1 >= n {
      out.write_char('\u{FFFD}')
      i += 1
      continue
    }
    let b = data[i + 1].to_int()
    if b >= 0x30 && b <= 0x39 {
      if i + 3 < n {
        let c = data[i + 2].to_int()
        let d = data[i + 3].to_int()
        if c >= 0x81 && c <= 0xFE && d >= 0x30 && d <= 0x39 {
          let cp = gb_four((((a - 0x81) * 10 + (b - 0x30)) * 126 + (c - 0x81)) * 10 + (d - 0x30))
          out.write_char(cp.unsafe_to_char())
          i += 4
          continue
        }
      }
      out.write_char('\u{FFFD}')
      i += 1
      continue
    }
    if b >= 0x40 && b <= 0xFE && b != 0x7F {
      let row = gb_rows[a - 0x81]
      out.write_char(mbt_compat::utf16_code_unit_at(row, if b < 0x7F { b - 0x40 } else { b - 0x41 }).to_int().unsafe_to_char())
      i += 2
    } else {
      out.write_char('\u{FFFD}')
      i += 1
    }
  }
  out.to_string()
}
