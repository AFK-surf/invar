import "halt"
import "mbt_compat"

// A Tester's look at each frame painted alone or of its looks alone (frame_watch.pion): the same frame built whole
// after it, as it began, nothing it says to tell told, and the two compared, the test failing where they differ; what
// a list moved with nothing built is found, pressed and read out by, and the words it keeps, compared too. Nothing of
// the app's frames asks it: the Tester has it look at each frame as it is drawn (frame_look).

///|
/// Whether each frame painted alone or of the looks alone is drawn whole after it as well and the two compared (a
/// Tester's: every test holds it); a host draws it once.
// kept across runs: set by each Tester as it is made (Tester::new), a bench's turned off
// moved to 00_init_order.pion: looks_check

///|
/// What the frame is found, pressed and read out by, and the words it keeps, as lines (looks_check: a frame where a
/// list moved with nothing built against it built whole).
fn scroll_said(c : Ctx) -> Array[String] {
  let out : Array[String] = []
  for k in 0..<c.hit_ids.length() {
    let r = c.hit_rects
    let q = c.hit_clips
    out.push("target \{c.hit_ids[k]} at \{mbt_compat::double_to_string(r[k * 4])},\{mbt_compat::double_to_string(r[k * 4 + 1])} \{mbt_compat::double_to_string(r[k * 4 + 2])}×\{mbt_compat::double_to_string(r[k * 4 + 3])} cut \{mbt_compat::double_to_string(q[k * clip_n])},\{mbt_compat::double_to_string(q[k * clip_n + 1])},\{mbt_compat::double_to_string(q[k * clip_n + 2])},\{mbt_compat::double_to_string(q[k * clip_n + 3])}",)
  }
  for sm in c.sems {
    let nd = c.nodes[sm.node]
    out.push("read out \{sm.id} \{sm.label} at \{mbt_compat::double_to_string(nd.x)},\{mbt_compat::double_to_string(nd.y)} \{mbt_compat::double_to_string(nd.fw)}×\{mbt_compat::double_to_string(nd.fh)}")
  }
  let keys : Array[String] = []
  words_kept.each(fn(k, _) { keys.push(k) })
  keys.sort()
  for k in keys {
    let w = mbt_compat::opt_unwrap(words_kept.get(k))
    for p in w.pieces {
      out.push("words \{k} at \{mbt_compat::double_to_string(p.x)},\{mbt_compat::double_to_string(p.y)} \{mbt_compat::double_to_string(p.w)}×\{mbt_compat::double_to_string(p.h)} from \{p.start}")
    }
  }
  out
}

fn looks_away(a : FixedArray[Double], b : Int, c : Int) -> Bool {
  let c0 = a[b + c]
  let c1 = a[b + c + 1]
  let c2 = a[b + c + 2]
  let c3 = a[b + c + 3]
  if c0 == 0.0 && c1 == 0.0 && c2 == 0.0 && c3 == 0.0 {
    return false
  }
  let rw = a[b + 2]
  let rh = a[b + 3]
  if !(rw > 0.0 && rh > 0.0) {
    return false
  }
  let rx = a[b]
  let ry = a[b + 1]
  dmin(rx + rw, c2) <= dmax(rx, c0) || dmin(ry + rh, c3) <= dmax(ry, c1)
}

fn looks_off_window(a : FixedArray[Double], b : Int, w : Double, h : Double) -> Bool {
  if w <= 0.0 || h <= 0.0 {
    return false
  }
  let kind = a[b + 5].to_int()
  if kind == 12 || kind == 6 || kind == 7 {
    return false
  }
  let grow = if kind == 2 {
    3.0 * a[b + 7] + 2.0
  } else if kind == 8 {
    3.0 * dmax(a[b + 7], 0.0) + dmax(a[b + 14], 0.0) + 4.0
  } else {
    0.0
  }
  let mut x0 = a[b] - grow
  let mut y0 = a[b + 1] - grow
  let mut x1 = a[b] + dmax(a[b + 2], 0.0) + grow
  let mut y1 = a[b + 1] + dmax(a[b + 3], 0.0) + grow
  if a[b + 32] != 0.0 {
    let px = a[b + 33]
    let py = a[b + 34]
    let dx = dmax((x0 - px).abs(), (x1 - px).abs())
    let dy = dmax((y0 - py).abs(), (y1 - py).abs())
    let rr = (dx * dx + dy * dy).sqrt()
    x0 = px - rr
    y0 = py - rr
    x1 = px + rr
    y1 = py + rr
  }
  x1 <= 0.0 || x0 >= w || y1 <= 0.0 || y0 >= h
}

let looks_seen_buf_a : mbt_compat::Ref[FixedArray[Double]] = mbt_compat::ref_new(FixedArray::make(1, 0.0))
let looks_seen_buf_b : mbt_compat::Ref[FixedArray[Double]] = mbt_compat::ref_new(FixedArray::make(1, 0.0))

fn looks_seen_into(a : FixedArray[Double], n : Int, w : Double, h : Double, buf : mbt_compat::Ref[FixedArray[Double]]) -> (FixedArray[Double], Int) {
  let need = n * inst_size + 1
  let out = if buf.v.length() >= need {
    buf.v
  } else {
    let grown = FixedArray::make(need, 0.0)
    buf.v = grown
    grown
  }
  let mut k = 0
  let mut run_start = -1
  for q in 0..<n {
    let b = q * inst_size
    if looks_away(a, b, 16) || looks_away(a, b, 40) || looks_off_window(a, b, w, h) {
      if run_start >= 0 {
        let run_len = q - run_start
        a.blit_to(out, len=run_len * inst_size, src_offset=run_start * inst_size, dst_offset=k * inst_size)
        k = k + run_len
        run_start = -1
      }
    } else if run_start < 0 {
      run_start = q
    }
  }
  if run_start >= 0 {
    let run_len = n - run_start
    a.blit_to(out, len=run_len * inst_size, src_offset=run_start * inst_size, dst_offset=k * inst_size)
    k = k + run_len
  }
  (out, k)
}

///|
/// The instances of `a`, `n` of them, that draw something inside the window (`w` by `h`): those its clip (16-19),
/// its outer clip (40-43), or the window itself cut wholly away left out; and how many.
fn looks_seen(a : FixedArray[Double], n : Int, w : Double, h : Double) -> (FixedArray[Double], Int) {
  let out = FixedArray::make(n * inst_size + 1, 0.0)
  let mut k = 0
  let mut run_start = -1
  for q in 0..<n {
    let b = q * inst_size
    if looks_away(a, b, 16) || looks_away(a, b, 40) || looks_off_window(a, b, w, h) {
      if run_start >= 0 {
        let run_len = q - run_start
        a.blit_to(out, len=run_len * inst_size, src_offset=run_start * inst_size, dst_offset=k * inst_size)
        k = k + run_len
        run_start = -1
      }
    } else if run_start < 0 {
      run_start = q
    }
  }
  if run_start >= 0 {
    let run_len = n - run_start
    a.blit_to(out, len=run_len * inst_size, src_offset=run_start * inst_size, dst_offset=k * inst_size)
    k = k + run_len
  }
  (out, k)
}

///|
/// The frame painted alone or of the looks alone (`painted`; `alone`, `n` instances; its looks asking to be woken at
/// `wake`, or drawn each frame: `cycling`) against the same frame built whole (`c`'s): the same instances, its looks
/// asking the same, else the test fails, saying where they part: the first instance that differs (what it is and
/// where), and how many each drew.
fn looks_compare(c : Ctx, alone : FixedArray[Double], n : Int, wake : Double, cycling : Bool, t : Double, then : Array[(Double, Double, Double, Double, String, Int, Double, Double, Double)], painted~ : Bool) -> Unit {
  let at = t.to_int()
  let kind = if painted { "painted alone" } else { "of its looks alone" }
  // (what is drawn of each: one its clips cut wholly away draws nothing, as a host draws it (a page's list's rows past
  // where it shows, kept in its group, cut by its header's clip: view_ride.pion's inst_cut_to))
  let (alone, n) = looks_seen_into(alone, n, c.window_w, c.window_h, looks_seen_buf_a)
  let (whole, m) = looks_seen_into(c.inst, c.ninst, c.window_w, c.window_h, looks_seen_buf_b)
  let (first, slot) = drawn_parted(alone, n, whole, m)
  if first >= 0 {
    let inst = fn(a : FixedArray[Double], q : Int, k : Int) {
      if q >= k {
        "none"
      } else {
        let b = q * inst_size
        "kind \{mbt_compat::double_to_string(a[b + 5])} at \{mbt_compat::double_to_string(a[b])},\{mbt_compat::double_to_string(a[b + 1])} \{mbt_compat::double_to_string(a[b + 2])}×\{mbt_compat::double_to_string(a[b + 3])}" +
        (if slot >= 0 { " (slot \{slot}: \{mbt_compat::double_to_string(a[b + slot])})" } else { "" })
      }
    }
    // (what is drawn there, as built whole: the words of the nodes over the place)
    let (px, py) = if first < m {
      (whole[first * inst_size], whole[first * inst_size + 1])
    } else {
      (alone[first * inst_size], alone[first * inst_size + 1])
    }
    let there = []
    for i in 0..<c.count {
      let nd = c.nodes[i]
      if nd.text != "" && px >= nd.x - 1.0 && px <= nd.x + nd.fw + 1.0 && py >= nd.y - 1.0 && py <= nd.y + nd.fh + 1.0 {
        there.push(nd.text)
      }
    }
    looks_fail("the frame at \{at} ms \{kind} (\{n} instances) parts from it built whole (\{m}) at instance \{first}: \{inst(alone, first, n)}, built whole \{inst(whole, first, m)}; words there: \{there.join(" | ")}; \{looks_node_moved(c, then)}")
  }
  if cycling != looks_own.cycling || wake != looks_own.wake {
    let next = fn(cy : Bool, w : Double) { if cy { "each frame" } else { "at \{mbt_compat::double_to_string(w)}" } }
    looks_fail("the frame at \{at} ms \{kind} has its looks ask for the next \{next(cycling, wake)}, built whole \{next(looks_own.cycling, looks_own.wake)}")
  }
}

///|
/// Where the nodes of the frame a frame of its looks alone is drawn from were laid out (x, y, w, h), their words and
/// ids, kept where they are compared (looks_check): where it parts from the frame built whole, the first node laid out
/// elsewhere is said.
// kept across runs: written by each frame built whole while looks_check is on
// moved to 00_init_order.pion: looks_nodes

///|
/// The first node laid out elsewhere in `c` than in the frame the looks alone were drawn from (looks_nodes), said.
fn looks_node_moved(c : Ctx, then : Array[(Double, Double, Double, Double, String, Int, Double, Double, Double)]) -> String {
  if then.length() != c.count {
    return "\{then.length()} nodes then, \{c.count} now"
  }
  for i in 0..<c.count {
    let nd = c.nodes[i]
    let (x, y, w, h, text, id, tx, ty, op) = then[i]
    if nd.x != x ||
    nd.y != y ||
    nd.fw != w ||
    nd.fh != h ||
    nd.text != text ||
    nd.id != id ||
    nd.tx != tx ||
    nd.ty != ty ||
    nd.opacity != op {
      // (what it holds: the words under it)
      let words = []
      let mut j = nd.first
      while j >= 0 && words.length() < 4 {
        if c.nodes[j].text != "" {
          words.push(c.nodes[j].text)
        }
        j = c.nodes[j].next
      }
      let mut up = nd.parent
      let mut above = ""
      while up >= 0 && above == "" {
        let mut k = c.nodes[up].first
        while k >= 0 && above == "" {
          if c.nodes[k].text != "" {
            above = c.nodes[k].text
          }
          k = c.nodes[k].next
        }
        up = c.nodes[up].parent
      }
      return "node \{i} (id \{id}, \{text}) at \{mbt_compat::double_to_string(x)},\{mbt_compat::double_to_string(y)} \{mbt_compat::double_to_string(w)}×\{mbt_compat::double_to_string(h)} moved \{mbt_compat::double_to_string(tx)},\{mbt_compat::double_to_string(ty)} alpha \{mbt_compat::double_to_string(op)} then, \{mbt_compat::double_to_string(nd.x)},\{mbt_compat::double_to_string(nd.y)} \{mbt_compat::double_to_string(nd.fw)}×\{mbt_compat::double_to_string(nd.fh)} moved \{mbt_compat::double_to_string(nd.tx)},\{mbt_compat::double_to_string(nd.ty)} alpha \{mbt_compat::double_to_string(nd.opacity)} now; words in it: \{words.join(" | ")}; near: \{above}"
    }
  }
  "every node where it was"
}

///|
/// Where the Tester whose frames are compared was made (Tester::new's `loc`).
// kept across runs: set by each Tester as it is made
// moved to 00_init_order.pion: looks_made_at

///|
fn looks_fail(s : String) -> Unit {
  let said = "a frame not built whole (frame_watch.pion), the Tester made at \{looks_made_at.v}: " +
  s +
  " (built whole last at \{looks_base.built_at.to_int()} ms\{if wall_read.v { "; the time of day read as it was built" } else { "" }}; what is said to move: \{g().moving_now().join("; ")})"
  if looks_unjudged.v {
    return
  }
  halt::saying(said, loc="tester_looks.pion:222:3")
}

///|
/// Whether this Tester's frames are not judged (a frame not built whole, how what moves goes): a run whose frames are
/// only the way to what it tells its core (sfreplay's pace passes, held to their strict pass's messages), every other
/// run judging them.
// kept across runs: set by the Tester that asks it (Tester::frames_unjudged), off as each Tester is made
// moved to 00_init_order.pion: looks_unjudged

///|
/// This Tester's frames not judged (looks_unjudged): `on` for its run.
pub fn Tester::frames_unjudged(self : Tester, on : Bool) -> Unit {
  looks_unjudged.v = on
  if on {
    self.motion = MotionJudged::Results
  }
}

///|
/// Whether this Tester's frames are not judged for how what moves goes (words_over, rows_steady, sizes_steady,
/// gaps_steady), all else of them judged as ever.
// kept across runs: set by the Tester that asks it (Tester::motion_unjudged), off as each Tester is made
// moved to 00_init_order.pion: motion_unjudged

///|
/// This Tester's frames not judged for how what moves goes (motion_unjudged): `on` for its run.
pub fn Tester::motion_unjudged(self : Tester, on : Bool) -> Unit {
  ignore(self)
  motion_unjudged.v = on
  // (its file's bars not set beside what it found, none of it looked for: motion_runs, `MOTION unjudged <file>`)
  if on && motion_runs() {
    let at = looks_made_at.v
    mbt_compat::mbt_println(("MOTION unjudged \{match mbt_compat::str_find(at, ":") { Some(i) => mbt_compat::str_unsafe_substring(at, start=0, end=i); None => at }}").to_string())
  }
}

///|
/// Whether each frame of the looks alone is drawn whole after it as well and the two compared (on in every Tester:
/// frame_watch.pion's head): off for a run measured as a host runs it (ui/src/film's bench).
pub fn Tester::check_looks(self : Tester, on : Bool) -> Unit {
  ignore(self)
  looks_check.v = on
}

///|
/// Why the last frame was built whole ("" where it was of its looks alone): it left more to come of its own, what it
/// read changed (the clock, where it read it so), a moment it waits for came.
pub fn Tester::built_why(self : Tester) -> String {
  self.reads_own()
  ignore(self)
  built_why.v
}

///|
/// Why the last frame was painted alone, from the last build's tree ("" where it was built whole or of its looks
/// alone): what its paint read changed (the clock, where it read it so), a moment its paint waits for came, the paint
/// before it drew otherwise.
pub fn Tester::painted_why(self : Tester) -> String {
  self.reads_own()
  ignore(self)
  painted_why.v
}

///|
/// Whether two numbers of an instance draw the same: equal, both none (NaN), or apart by no more than the rounding of
/// adding a move to what was placed as laid out (Ctx::moved_place) leaves, a billionth of them: nothing a pixel shows.
fn drawn_same(x : Double, y : Double) -> Bool {
  x == y || (x.is_nan() && y.is_nan()) || (x - y).abs() <= 1.0e-9 * dmax(1.0, dmax(x.abs(), y.abs()))
}

///|
/// Where the instances `a` (`n` of them) and `b` (`m`) first part: the first instance one of whose numbers does not
/// draw the same (drawn_same), and that number's slot; past the last of the fewer, slot -1, where one has more; (-1,
/// -1) where they draw the same.
fn drawn_parted(a : FixedArray[Double], n : Int, b : FixedArray[Double], m : Int) -> (Int, Int) {
  for q in 0..<(if n < m { n } else { m }) {
    let at = q * inst_size
    for j in 0..<inst_size {
      if !drawn_same(a[at + j], b[at + j]) {
        return (q, j)
      }
    }
  }
  if n != m {
    (if n < m { n } else { m }, -1)
  } else {
    (-1, -1)
  }
}

///|
/// The nodes of the frame `c` laid out, as looks_node_moved compares them: where each was laid out, its words and id,
/// how far it was moved and how opaque.
fn looks_nodes_of(c : Ctx) -> Array[(Double, Double, Double, Double, String, Int, Double, Double, Double)] {
  let out = []
  for i in 0..<c.count {
    let nd = c.nodes[i]
    out.push((nd.x, nd.y, nd.fw, nd.fh, nd.text, nd.id, nd.tx, nd.ty, nd.opacity))
  }
  out
}

///|
/// The nodes of the frame `c` painted last, as looks_compare says where one moved: kept as each frame painted ends.
fn looks_nodes_kept(c : Ctx) -> Unit {
  looks_nodes.clear()
  for n in looks_nodes_of(c) {
    looks_nodes.push(n)
  }
}

///|
/// A frame as it is drawn, looked at where the Tester checks the looks (frame_look, looks_check): built whole or
/// painted alone, its nodes kept for the compare after it; painted alone or of its looks alone, built whole again as
/// it began (no row kept; what its builds say to tell told only where the frame told nothing of its own, a list moved
/// in it having told what follows it) and the two compared, the test failing where they differ.
fn looks_looked(c : Ctx, _w : Double, _h : Double, _scale : Double, t : Double, kind : Int, scrolled : Bool) -> Unit {
  if !looks_check.v {
    return
  }
  if kind < 2 {
    looks_nodes_kept(c)
  }
  if kind == 0 {
    return
  }
  c.flat_from(0)
  let n = c.ninst
  let alone = FixedArray::make(n * inst_size + 1, 0.0)
  c.inst.blit_to(alone, len=n * inst_size)
  let wake = looks_own.wake
  let cycling = looks_own.cycling
  let then = looks_nodes.copy()
  let painted = kind == 1
  // (a list moved with nothing built: what it is found and read out by, and its words, compared too)
  let was = if scrolled { Some(scroll_said(c)) } else { None }
  // (built whole as a frame begins: what the paint alone read, read anew by its paint; no row kept; no frame of the
  // app's, what a test asks of each frame not told of it)
  let hook = frame_hook.v
  let saved_looks_hook = in_frame_looks_hook.v
  let saved_made = view_paint_work.made
  let saved_copied = view_paint_work.copied
  let saved_handed = view_paint_work.handed
  frame_hook.v = None
  in_frame_looks_hook.v = None
  paint_phase.v = 0
  tree_theme_paint_cache.v = None
  nodes_run.fresh = true
  nodes_run.whole = true
  // INVAR-EXT: mark Tester-only reference rebuild pass without mutating production looks_drawn
  looks_ref_pass.v = true
  frame_watch_of().read(fn() { frame_body_drawn(c, t, tell=!scrolled) }) |> ignore
  looks_ref_pass.v = false
  c.flat_from(0)
  frame_hook.v = hook
  in_frame_looks_hook.v = saved_looks_hook
  view_paint_work.made = saved_made
  view_paint_work.copied = saved_copied
  view_paint_work.handed = saved_handed
  looks_drawn.v = false
  painted_alone.v = false
  looks_compare(c, alone, n, wake, cycling, t, then, painted=painted)
  looks_nodes_kept(c)
  match was {
    Some(was) => {
      let now = scroll_said(c)
      if was != now {
        let mut k = 0
        while k < was.length() && k < now.length() && was[k] == now[k] {
          k = k + 1
        }
        looks_fail("the frame at \{t.to_int()} ms, a list moved with nothing built, parts from it built whole: \{mbt_compat::arr_get(was, k).unwrap_or("none")}, built whole \{mbt_compat::arr_get(now, k).unwrap_or("none")}; built whole because \{built_why.v}")
      }
    }
    Option::None => ()
  }
}

///|
/// How many frames were drawn of their looks alone so far (frame_watch.pion: nothing built, laid out or painted, a list
/// moved by its header), each drawn whole after it as well and compared where the looks are checked.
pub fn Tester::looks_alone(self : Tester) -> Int {
  self.reads_own()
  ignore(self)
  looks_frames.v
}
