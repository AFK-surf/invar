import "mbt_compat"

// What a host answers of pictures and PDFs, kept with its text (textrec.pion) and given again under a Tester: how large a
// picture decodes (from its bytes or its source, at the size asked), how many pages a PDF has and how large each is,
// how large a page drawn is. So a screen with pictures a Tester draws is the host's, to the instance, as its text is.
//
// The lines (TEXTREC, as the text's: MBUI_TEXT_RECORD=1):
//   {"ib":[bytes,length,px],"r":[w,h,ow,oh]}       a picture handed over as bytes (their FNV-1a, hex), decoded at px
//   {"is":[source,px],"r":[w,h,ow,oh]}             a picture by its source
//   {"pn":[bytes,length],"r":pages}                a PDF's pages
//   {"ps":[bytes,length,page],"r":[w,h]}           a page's size (points)
//   {"pi":[bytes,length,page,px],"r":[w,h,ow,oh]}  a page drawn at px
//   {"wa":[text,offset],"r":[start,end]}           the system's word of `text` around `offset` (UTF-16; -1 -1: none)

///|
/// What is being recorded of the host's answers, by its ids: what each picture asked is (its line's head), each PDF.
pub struct HostRec {
  priv images : mbt_compat::OrderedMap[Int, mbt_compat::MbtJson]
  priv pdfs : mbt_compat::OrderedMap[Int, (String, Int)]
}

///|
fn HostRec::new() -> HostRec {
  HostRec::{ images: mbt_compat::ordered_map_new(), pdfs: mbt_compat::ordered_map_new() }
}

///|
/// Bytes as one number (FNV-1a, 64 bits), in hex: what names a picture or a PDF handed over by its bytes.
fn bytes_name(data : Bytes) -> String {
  let h = stable_hash_bytes(data)
  let hex = "0123456789abcdef"
  let sb = StringBuilder()
  for k in 0..<16 {
    let d = ((h >> ((15 - k) * 4)) & 15L).to_int()
    sb.write_char(mbt_compat::utf16_code_unit_at(hex, d).unsafe_to_char())
  }
  sb.to_string()
}

///|
/// A picture asked of the host, to be recorded once it is decoded (its id, its line's head).
fn rec_image_asked(id : Int, head : mbt_compat::MbtJson) -> Unit {
  if text_recording() {
    g().host_rec.images.set(id, head)
  }
}

///|
/// A picture the host has decoded: its sizes recorded, once.
fn rec_image_ready(id : Int, out : FixedArray[Double]) -> Unit {
  if text_recording() {
    match g().host_rec.images.get(id) {
      Option::Some(head) => {
        g().host_rec.images.remove(id)
        let line : mbt_compat::MbtJson = match head {
          .Object(m) => {
            let o = mbt_compat::ordered_map_from_array(m.to_array())
            o.set("r", nums(out, 4))
            mbt_compat::MbtJson::object(o)
          }
          _ => head
        }
        text_say(line.stringify(), line)
      }
      Option::None => ()
    }
  }
}

///|
/// The kept answers of pictures and PDFs, by their lines' heads ("ib|…", "is|…", "pn|…", "ps|…", "pi|…").
fn host_answers_of(lines : String) -> mbt_compat::OrderedMap[String, mbt_compat::MbtJson] {
  let out : mbt_compat::OrderedMap[String, mbt_compat::MbtJson] = mbt_compat::ordered_map_new()
  for v in lines.split("\n") {
    let line = mbt_compat::str_to_owned(v)
    let start = match mbt_compat::str_find(line, "TEXTREC ") {
      Some(i) => i + 8
      None => if mbt_compat::str_has_prefix(line, "{") { 0 } else { continue }
    }
    let j = match mbt_compat::mbt_json_parse(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=start))) { Ok(__mbt_ok_20) => __mbt_ok_20, Err(_) => continue }
    guard j is .Object(m) else { continue }
    for kind in ["ib", "is", "pn", "ps", "pi", "wa"] {
      match (m.get(kind), m.get("r")) {
        (Some(head), Some(r)) => out.set(kind + "|" + head.stringify(), r)
        _ => ()
      }
    }
  }
  out
}

///|
/// The kept answer for `kind` asked with `head`, if a Tester has kept text and it has this; what it lacks is said
/// (Tester::text_missing).
fn kept_answer(kind : String, head : mbt_compat::MbtJson) -> Option[mbt_compat::MbtJson] {
  guard text_table.v is Some(t) else { return Option::None }
  let key = kind + "|" + head.stringify()
  match t.answers.get(key) {
    Some(r) => Some(r)
    Option::None => {
      text_lacks(t, "host " + key)
      Option::None
    }
  }
}

///|
/// A kept picture's four sizes (w, h, ow, oh).
fn kept_sizes(r : Option[mbt_compat::MbtJson]) -> Option[(Double, Double, Double, Double)] {
  match r {
    __mbt_mc_90 => match __mbt_mc_90 { Option::Some(mbt_compat::MbtJson::Array(__mbt_ap_89)) => if __mbt_ap_89.length() >= 4 { let __mbt_el_91 = __mbt_ap_89[0]; let __mbt_el_92 = __mbt_ap_89[1]; let __mbt_el_93 = __mbt_ap_89[2]; let __mbt_el_94 = __mbt_ap_89[3]; match (__mbt_el_91, __mbt_el_92, __mbt_el_93, __mbt_el_94) { (mbt_compat::MbtJson::Number(__mbt_pb_w_85, _), mbt_compat::MbtJson::Number(__mbt_pb_h_86, _), mbt_compat::MbtJson::Number(__mbt_pb_ow_87, _), mbt_compat::MbtJson::Number(__mbt_pb_oh_88, _)) => { let w = __mbt_pb_w_85; let h = __mbt_pb_h_86; let ow = __mbt_pb_ow_87; let oh = __mbt_pb_oh_88; Some((w, h, ow, oh)) }, _ => match __mbt_mc_90 { _ => Option::None } } } else { match __mbt_mc_90 { _ => Option::None } }, _ => match __mbt_mc_90 { _ => Option::None } }
  }
}
