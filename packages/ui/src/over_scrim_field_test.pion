        .over_at(view::Live::Is((Some(20.0), Some(20.0), None, None)))
        .width(view::Live::Is(Some(80.0)))
        .height(view::Live::Is(Some(80.0)))
        .ground(view::Live::Is(c_lift))
        .over_scrim(view::Live::Is(true))
      })
      let _ = root.box(fn(holder : view::View) {
        let _ = holder
        .over(view::Live::Is(true))
        .blur(view::Live::Is(6.0))
        .content_lens(view::Live::Is(paint::ContentLens::{ blur: 4.0, refraction: 0.25, bezel: 2.0, alpha: 1.0 }))
        let _ = holder.box(fn(s : view::View) {
          let _ = s.over(view::Live::Is(true)).scrim_under().ground(view::Live::Is(c_scrim))
          let _ = s.box(fn(p : view::View) {
            let _ = p
            .over_at(view::Live::Is((Some(140.0), Some(140.0), None, None)))
            .width(view::Live::Is(Some(100.0)))
            .height(view::Live::Is(Some(100.0)))
            .ground(view::Live::Is(c_panel))
          })
        })
      })
    },
    w=300.0,
    h=300.0,
  )
  let sc = t.scene()
  let idx_lift = find_rect_index_by_rgb(sc, c_lift)
  debug_assert(idx_lift >= 0, "lifted rect emitted")
  let (in_lens, lift_depth, end_depth) = check_host_scanner_blur_balance(sc, idx_lift)
  t.dispose()
  debug_assert(in_lens == 0, "no kind 15 blur pop may fall inside a kind 8 lens span, got \{in_lens}")
  debug_assert(lift_depth == 0, "host scanner sees blur depth 0 at external over_scrim node, got \{lift_depth}")
  debug_assert(end_depth == 0, "host scanner ends frame at blur depth 0, got \{end_depth}")
}
