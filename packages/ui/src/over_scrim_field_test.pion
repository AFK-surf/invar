}

test "field_prod 11: app reset releases pending drop Pick and preserves pending ClipRead for single cl_end" {
  let fld = Field::new()
  let deliveries = ref_new(0)
  let cl_ends = ref_new(0)
  let pk_ends = ref_new(0)
  let ready = ref_new(0)
