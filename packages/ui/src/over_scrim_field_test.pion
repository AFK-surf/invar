  set_window_tree(fn(_wid, _what) {
    fn(r : view::View) {
      let _ = field(r, fld, label="Files Field", files=fn(_fs) {
        delivered.v = delivered.v + 1
        seen_wid.v = current_window_id()
        if delivered.v == 1 {
          view_outside_event(9, 45, 1)
        }
      })
    }
  })
  let b = window_open_here("clip-win")
  let _ = window_frame(b, 300.0, 200.0, 1.0, 16.0)
