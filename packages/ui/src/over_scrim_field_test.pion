    fn(root : view::View) {
      let _ = field(root, fld, label="Drop Field", files=fn(_fs) { deliveries.v = deliveries.v + 1 })
      let _ = files_into(root, Field::new(), fn(_fs) { deliveries.v = deliveries.v + 1 })
    },
    w=300.0,
    h=200.0,
  )
  let h = hostapi::host()
  h.cl_read = fn() { 81 }
  h.cl_state = fn(_id) { ready.v }
  h.cl_end = fn(_id) { cl_ends.v = cl_ends.v + 1 }
  h.pk_state = fn(_id) { ready.v }
  h.pk_end = fn(_id) { pk_ends.v = pk_ends.v + 1 }
  let _ = fld.handle_key(key_of_char('v'), mod_cmd)
  debug_assert(drop_host_pick(82), "pending drop queued")
  set_view_app(fn(_r) { () })
  ready.v = 1
  view_outside_event(3, 82, 1)
  view_outside_event(9, 81, 1)
  t.dispose()
  debug_assert(cl_ends.v == 1 && pk_ends.v == 1 && deliveries.v == 0, "reset releases both handles once with zero delivery")
}

