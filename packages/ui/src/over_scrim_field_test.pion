}

test "field_prod 15: look replacement inserting newline updates caret line layout" {
  let fld = Field::new(text="a b")
  let t = Tester::tree(
    fn(r : view::View) {
      let _ = field(r, fld, label="Look Field", max_lines=3, look=fn(_s) { ("a\nb", []) })
    },
    w=300.0,
    h=200.0,
  )
  fld.focus()
  fld.pick(3, 3)
  t.frame()
  let (shown, _) = match fld.st.look { Some(f) => f(fld.st.text); None => (fld.st.text, []) }
  let line = fld.caret_line()
  t.dispose()
  debug_assert(shown == "a\nb" && line == 1, "look newline replacement moves end caret to line 1")
}

fn optical_depths_at(sc : Scene, target : Int) -> (Int, Int) {
  let mut bdepth = 0
  let mut target_bdepth = -1
  let mut target_ldepth = 0
  for k in 0..<sc.ninst {
    let kind = sc.inst[k * inst_size + 5]
    if kind == 14.0 { bdepth += 1 }
    if kind == 15.0 { bdepth -= 1 }
    if k == target { target_bdepth = bdepth }
    if kind == 8.0 {
      let span = sc.inst[k * inst_size + 12].to_int()
      if span > 0 && k < target && target <= k + span {
        target_ldepth += 1
      }
    }
  }
  (target_bdepth, target_ldepth)
}

test "over_scrim 12: external sibling over_scrim does not inherit scrim parent blur or lens" {
  let c_lift = rgba(210, 40, 20, 255)
  let c_scrim = rgba(10, 50, 10, 160)
  let c_panel = rgba(20, 40, 200, 255)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(n : view::View) {
        let _ = n.over(view::Live::Is(true)).ground(view::Live::Is(c_lift)).over_scrim(view::Live::Is(true))
      })
      let _ = root.box(fn(holder : view::View) {
        let _ = holder
        .over(view::Live::Is(true))
        .blur(view::Live::Is(6.0))
        .content_lens(view::Live::Is(paint::ContentLens::{ blur: 4.0, refraction: 0.25, bezel: 2.0, alpha: 1.0 }))
        let _ = holder.box(fn(s : view::View) {
          let _ = s.over(view::Live::Is(true)).scrim_under().ground(view::Live::Is(c_scrim))
          let _ = s.box(fn(p : view::View) {
            let _ = p.over(view::Live::Is(true)).ground(view::Live::Is(c_panel))
          })
        })
      })
    },
    w=400.0,
    h=400.0,
  )
  let sc = t.scene()
  let idx_scrim = find_rect_index_by_rgb(sc, c_scrim)
  let idx_lift = find_rect_index_by_rgb(sc, c_lift)
  let idx_panel = find_rect_index_by_rgb(sc, c_panel)
  debug_assert(idx_scrim >= 0 && idx_scrim < idx_lift && idx_lift < idx_panel, "order scrim < lift < panel")
  let (lb, ll) = optical_depths_at(sc, idx_lift)
  let (pb, pl) = optical_depths_at(sc, idx_panel)
  t.dispose()
  debug_assert(lb == 0 && ll == 0, "external sibling over_scrim has blur/lens depth 0/0, got \{lb}/\{ll}")
  debug_assert(pb == 1 && pl == 1, "scrim panel child preserves parent blur/lens depth 1/1, got \{pb}/\{pl}")
}

