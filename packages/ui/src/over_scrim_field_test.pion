  set_window_tree(fn(_wid, _what) {
    fn(r : view::View) {
      let _ = files_into(r, Field::new(), fn(_fs) { calls.v = calls.v + 1 })
    }
  })
  let a = window_open_here("win-old")
  let _ = window_frame(a, 300.0, 200.0, 1.0, 16.0)
  debug_assert(drop_host_pick(33, wid=a), "queued on old window")
  window_close_here(a)
