test "field_prod 14: clipboard callback claims pending before re-entry and runs in initiating window" {
  let seen_wid = ref_new(-1)
  let ends = ref_new(0)
  let delivered = ref_new(0)
  let state = ref_new(0)
  let fld = Field::new()
