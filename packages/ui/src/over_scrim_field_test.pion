  let line1 = fld.caret_line()
  t.dispose()
  debug_assert(line0 == 0 && line1 == 1, "reactive look newline switch moves end caret from line 0 to line 1, got \{line0} -> \{line1}")
}

fn check_host_scanner_blur_balance(sc : Scene, target : Int) -> (Int, Int, Int) {
  let mut kind15_in_lens = 0
  for k in 0..<sc.ninst {
    if sc.inst[k * inst_size + 5] == 8.0 {
      let span = sc.inst[k * inst_size + 12].to_int()
      let end_k = if k + span < sc.ninst { k + span } else { sc.ninst - 1 }
      let mut j = k + 1
      while j <= end_k {
        if sc.inst[j * inst_size + 5] == 15.0 {
          kind15_in_lens += 1
        }
        j += 1
      }
    }
  }
  let mut host_depth = 0
  let mut target_depth = -1
  let mut k = 0
  while k < sc.ninst {
    let kind = sc.inst[k * inst_size + 5]
    if k == target {
      target_depth = host_depth
    }
    if kind == 14.0 {
      host_depth += 1
      k += 1
    } else if kind == 15.0 {
      host_depth -= 1
      k += 1
    } else if kind == 8.0 {
      let span = sc.inst[k * inst_size + 12].to_int()
      k += 1 + (if span > 0 { span } else { 0 })
    } else {
      k += 1
    }
  }
  (kind15_in_lens, target_depth, host_depth)
}

test "over_scrim 14: LIFO blur/lens suspend keeps kind 15 outside kind 8 child spans under host scanner" {
  let c_lift = rgba(230, 30, 30, 255)
  let c_scrim = rgba(10, 40, 10, 160)
  let c_panel = rgba(20, 60, 220, 255)
  let t = Tester::tree(
    fn(root : view::View) {
