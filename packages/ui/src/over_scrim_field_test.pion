  debug_assert(pb == 1 && pl == 1, "shared optical parent applies once (1/1) to scrim panel, got \{pb}/\{pl}")
}

test "field_prod 16: host drop with both pick and paths routes to paths_into, files_into, or words_into with single release" {
  let got_paths = ref_new("")
  let path_calls = ref_new(0)
  let file_calls = ref_new(0)
  let fld = Field::new()
  let pk_ends : Map[Int, Int] = Map::new()
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(z_paths : view::View) {
        let _ = z_paths
        .over_at(view::Live::Is((Some(0.0), Some(0.0), None, None)))
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(100.0)))
        let _ = paths_into(z_paths, Field::new(), fn(ps : Array[DroppedPath]) {
          path_calls.v = path_calls.v + 1
          if ps.length() > 0 {
            got_paths.v = ps[0].path
          }
        })
      })
      let _ = root.box(fn(z_files : view::View) {
        let _ = z_files
        .over_at(view::Live::Is((Some(110.0), Some(0.0), None, None)))
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(100.0)))
        let _ = files_into(z_files, Field::new(), fn(_fs : Array[hostapi::Picked]) {
          file_calls.v = file_calls.v + 1
        })
      })
      let _ = root.box(fn(z_words : view::View) {
        let _ = z_words
        .over_at(view::Live::Is((Some(220.0), Some(0.0), None, None)))
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(100.0)))
        let _ = words_into(z_words, fld)
      })
    },
    w=400.0,
    h=200.0,
  )
  let h = hostapi::host()
  h.pk_state = fn(_id) { 1 }
  h.pk_count = fn(_id) { 0 }
  h.pk_end = fn(id) {
    let prev = match pk_ends.get(id) {
      Some(c) => c
      None => 0
    }
    pk_ends[id] = prev + 1
  }
  // 1) paths_into target receives paths and releases pick once
  t.post(host_drop_channel, "{\"type\":\"drop\",\"x\":20,\"y\":20,\"pick\":301,\"paths\":[{\"path\":\"/tmp/a.txt\",\"dir\":false}],\"wid\":0}")
  view_outside_event(11, 0, 0)
  t.frame()
  // 2) files_into target receives Pick and releases pick once
  t.post(host_drop_channel, "{\"type\":\"drop\",\"x\":130,\"y\":20,\"pick\":302,\"paths\":[\"/tmp/b.txt\"],\"wid\":0}")
  view_outside_event(11, 0, 0)
  t.frame()
  // 3) words_into target receives joined paths text and releases pick once
  t.post(host_drop_channel, "{\"type\":\"drop\",\"x\":240,\"y\":20,\"pick\":303,\"paths\":[\"/tmp/c.txt\",\"/tmp/d.txt\"],\"wid\":0}")
  view_outside_event(11, 0, 0)
  t.frame()
  t.dispose()
  debug_assert(path_calls.v == 1 && got_paths.v == "/tmp/a.txt" && opt_int_eq(pk_ends.get(301), 1), "paths_into hit once and pk_end once")
  debug_assert(file_calls.v == 1 && opt_int_eq(pk_ends.get(302), 1), "files_into hit once and pk_end once")
  debug_assert(fld.text() == "/tmp/c.txt\n/tmp/d.txt" && opt_int_eq(pk_ends.get(303), 1), "words_into received joined paths and pk_end once")
}

test "field_prod 17: reactive look changing newline updates caret line immediately" {
  let multi = signals::signal(false)
  let fld = Field::new(text="a b")
  let t = Tester::tree(
    fn(r : view::View) {
      let _ = field(
        r,
        fld,
        max_lines=3,
        look=fn(s) {
          if multi.get() {
            ("a\nb", [])
          } else {
            (s, [])
          }
        },
      )
    },
    w=300.0,
    h=200.0,
  )
  fld.focus()
  fld.pick(3, 3)
  t.frame()
  let line0 = fld.caret_line()
  multi.set(true)
