// INVAR-EXT: Native CPS bridge to packages/effect (EffectScope, Ctx::fork, Ctx::effect).

import "effect"
import "signals"

///|
// moved to 00_init_order.pion: fx

///|
struct Life {
  scope_ : effect::EffectScope
  mut seen : Int
}

///|
// moved to 00_init_order.pion: lives

///|
fn fx_runtime(seed : Option[Int]) -> effect::Runtime {
  let rt = match seed {
    Some(s) => effect::Runtime::new(seed=s)
    Option::None => effect::Runtime::new()
  }
  rt.on_wake(fn() { if !offscreen_frame() { h_request_frame() } })
  rt.outside_clock(fn() { whole_ms(if frame_moment.v >= 0.0 { frame_moment.v } else { h_now() }).to_int64() })
  rt.outside_event(fn() { if frame_moment.v >= 0.0 { frame_serial.v } else { -1 } })
  rt.on_timer(fn(at) { if frame_moment.v < 0.0 {
    g().wake_at_time(at.to_double(), later=true)
    h_wake_after(dmax(at.to_double() - h_now(), 0.0))
  } else if frame_running.v && !frame_built.v {
    g().wake_at_time(at.to_double(), later=true)
  } })
  rt
}

///|
fn fx_reset(seed : Option[Int]) -> Unit {
  fx.v = fx_runtime(seed)
  lives.clear()
}

///|
pub fn runtime() -> effect::Runtime {
  fx.v
}

///|
fn fx_frame_start(c : Ctx) -> Unit {
  let at = whole_ms(c.clock).to_int64()
  let was = signals::set_active_sub(Option::None)
  let owner = signals::set_owner(Option::None)
  fx.v.frame(at)
  signals::set_active_sub(was) |> ignore
  signals::set_owner(owner) |> ignore
}

///|
fn fx_frame_end(c : Ctx) -> Unit {
  if !lives.is_empty() {
    let gone : Array[Int] = []
    lives.each(fn(id, l) { if l.seen != c.build_no { gone.push(id) } })
    for id in gone {
      match lives.get(id) {
        Some(l) => l.scope_.close_now()
        Option::None => ()
      }
      lives.remove(id)
    }
  }
  let rt = fx.v
  if !rt.idle() {
    c.request_frame()
  }
  c.fiber_frame = rt.wants_frame()
  match rt.next_timer() {
    Some(at) => c.wake_at_time(at.to_double(), later=true)
    Option::None => ()
  }
}

///|
pub fn Ctx::fork[X](self : Ctx, f : ((effect::Exit[X]) -> Unit) -> Unit, name? : String) -> effect::Fiber[X] {
  let name = match name { Some(__mbt_v) => __mbt_v, None => "" }

  ignore(self)
  fx.v.fork(f, name=name)
}

///|
pub fn Ctx::lifetime(self : Ctx, key : String) -> effect::EffectScope {
  let id = self.id("\u{2}life/" + key)
  match lives.get(id) {
    Some(l) => {
      l.seen = self.build_no
      l.scope_
    }
    Option::None => {
      let l = Life::{ scope_: fx.v.scope_(), seen: self.build_no }
      lives.set(id, l)
      l.scope_
    }
  }
}

///|
pub fn Ctx::effect(self : Ctx, key : String, f : (effect::EffectScope, (effect::Exit[Unit]) -> Unit) -> Unit) -> Unit {
  let fresh = !lives.contains(self.id("\u{2}life/" + key))
  let s = self.lifetime(key)
  if fresh {
    ignore(s.fork(fn(k) { f(s, k) }, name=key))
  }
}
