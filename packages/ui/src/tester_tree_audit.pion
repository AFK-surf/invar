///|
fn Tester::hold_scroll_each_said(self : Tester) -> Option[String] {
  if scroll_each_hold_limit.v <= 0 {
    return Option::None
  }
  let faults = self.scroll_each_faults(limit=scroll_each_hold_limit.v)
  if faults.is_empty() {
    Option::None
  } else {
    Some("unvirtualized scroll-each limit exceeded on a frame drawn at \{mbt_compat::double_to_string(self.fake.time)}, the Tester made at \{looks_made_at.v}:\n" +
      faults.join("\n"),)
  }
}

