// Adversarial unit tests for all 6 UI quality audit gates (`audit_gates.pion`),
// combined `ui_craft_audit`, and deterministic `InputTape` record/serialize/replay (`inputrec.pion`).

import "signals"
import "view"

fn any_fault_prefix(faults : Array[String], pre : String) -> Bool {
  for f in faults {
    if str_has_prefix(f, pre) {
      return true
    }
  }
  false
}

test "gate 1: corner_faults passes concentric ladder and catches oversized inner radius" {
  // Positive: outer r=16, pad=8 -> inner r=8 satisfies r <= 16 - 8 + 1.5
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(card : view::View) {
      let _ = card
      .width(view::Live::Is(Some(200.0)))
      .height(view::Live::Is(Some(120.0)))
      .pad(view::Live::Is(8.0))
      .radius(view::Live::Is(16.0))
      .ground(view::Live::Is(rgba(30, 30, 36, 255)))
      let _ = card.box(fn(inner : view::View) {
        let _ = inner
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(48.0)))
        .radius(view::Live::Is(8.0))
        .ground(view::Live::Is(rgba(60, 64, 76, 255)))
      })
    })
  })
  t_ok.assert_corners(label="concentric-ok")
  t_ok.dispose()

  // Negative: outer r=16, pad=8 -> inner r=14 violates 16 - 8 + 1.5 = 9.5
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(card : view::View) {
      let _ = card
      .width(view::Live::Is(Some(200.0)))
      .height(view::Live::Is(Some(120.0)))
      .pad(view::Live::Is(8.0))
      .radius(view::Live::Is(16.0))
      .ground(view::Live::Is(rgba(30, 30, 36, 255)))
      let _ = card.box(fn(inner : view::View) {
        let _ = inner
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(48.0)))
        .radius(view::Live::Is(14.0))
        .ground(view::Live::Is(rgba(60, 64, 76, 255)))
      })
    })
  })
  let faults = t_bad.corner_faults()
  debug_assert(any_fault_prefix(faults, "corner:"), "expected corner: fault for oversized inner radius")
  t_bad.dispose()
}

// A 320x260 sheet (outer r=27) holding one 30pt-tall full capsule (r=15), placed by the sheet's
// padding (left, top, right, bottom).
fn capsule_in_sheet(pad : (Double, Double, Double, Double)) -> Tester {
  Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(sheet : view::View) {
      let _ = sheet
      .width(view::Live::Is(Some(320.0)))
      .height(view::Live::Is(Some(260.0)))
      .padding(view::Live::Is(pad))
      .radius(view::Live::Is(27.0))
      .ground(view::Live::Is(rgba(30, 30, 36, 255)))
      let _ = sheet.box(fn(pill : view::View) {
        let _ = pill
        .width(view::Live::Is(Some(320.0 - pad.0 - pad.2)))
        .height(view::Live::Is(Some(30.0)))
        .radius(view::Live::Is(15.0))
        .ground(view::Live::Is(rgba(60, 64, 76, 255)))
      })
    })
  })
}

test "gate 1: corner_faults applies the ladder only inside the outer corner arc zone" {
  // Every corner of the capsule sits at least 38.2pt from the sheet's corners (>= outer r=27):
  // it is in the straight interior, so no concentric constraint applies.
  let t_far = capsule_in_sheet((16.0, 191.8, 16.0, 38.2))
  t_far.assert_corners(label="outside-arc-zone")
  t_far.dispose()

  // Exact boundary: corner inset == outer r=27 leaves the arc zone.
  let t_edge = capsule_in_sheet((27.0, 27.0, 27.0, 176.0))
  t_edge.assert_corners(label="inset-equals-outer")
  t_edge.dispose()

  // Inside the arc zone: inset=16 allows r <= 27 - 16 + 1.5 = 12.5, the capsule's r=15 violates it.
  let t_in = capsule_in_sheet((16.0, 16.0, 16.0, 198.0))
  let faults = t_in.corner_faults()
  debug_assert(any_fault_prefix(faults, "corner:"), "expected corner: fault inside the outer corner arc zone")
  t_in.dispose()
}

test "gate 2: contrast_faults enforces WCAG 2.1 ratio for body and large text" {
  // Positive: dark ink on white background (~21:1)
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(card : view::View) {
      let _ = card.pad(view::Live::Is(12.0)).ground(view::Live::Is(rgba(255, 255, 255, 255)))
      let _ = card.words(
        view::Live::Is("Readable"),
        ink=rgba(17, 17, 17, 255),
        look=view::WordsLook::of(14.0),
      )
    })
  })
  t_ok.assert_contrast(label="wcag-ok")
  t_ok.dispose()

  // Negative: light gray text on white background (~1.6:1 < 4.5)
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(card : view::View) {
      let _ = card.pad(view::Live::Is(12.0)).ground(view::Live::Is(rgba(255, 255, 255, 255)))
      let _ = card.words(
        view::Live::Is("LowContrast"),
        ink=rgba(200, 200, 200, 255),
        look=view::WordsLook::of(14.0),
      )
    })
  })
  let faults = t_bad.contrast_faults()
  debug_assert(any_fault_prefix(faults, "contrast:"), "expected contrast: fault for low-contrast text")
  t_bad.dispose()
}

test "gate 3: words_over_faults catches sibling text overlap and unclipped overflow" {
  // Positive: properly spaced column of text labels
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(col : view::View) {
      let _ = col.gap(view::Live::Is(8.0)).pad(view::Live::Is(12.0))
      let _ = col.words(view::Live::Is("Line One"), look=view::words_plain)
      let _ = col.words(view::Live::Is("Line Two"), look=view::words_plain)
    })
  })
  t_ok.assert_words_over(label="words-ok")
  t_ok.dispose()

  // Negative: two absolute text nodes colliding at the exact same position
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(stage : view::View) {
      let _ = stage.width(view::Live::Is(Some(300.0))).height(view::Live::Is(Some(100.0)))
      let _ = stage.box(fn(a : view::View) {
        let _ = a.over(view::Live::Is(true), edges=(Some(10.0), Some(10.0), None, None))
        let _ = a.words(view::Live::Is("Overlap A"), look=view::words_plain)
      })
      let _ = stage.box(fn(b : view::View) {
        let _ = b.over(view::Live::Is(true), edges=(Some(14.0), Some(12.0), None, None))
        let _ = b.words(view::Live::Is("Overlap B"), look=view::words_plain)
      })
    })
  })
  let faults = t_bad.words_over_faults()
  debug_assert(any_fault_prefix(faults, "words_over:"), "expected words_over: fault for overlapping text")
  t_bad.dispose()
}

test "gate 7: first_line_faults catches centered icon beside multi-line text and passes first-line aligned icon" {
  // Positive: icon aligned to top/first line beside a 2-line column
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(r : view::View) {
      let _ = r.row(view::Live::Is(true)).align_items(view::Along::Start).gap(view::Live::Is(8.0)).pad(view::Live::Is(12.0))
      let _ = r.box(fn(icon : view::View) {
        let _ = icon
        .width(view::Live::Is(Some(16.0)))
        .height(view::Live::Is(Some(16.0)))
        .ground(view::Live::Is(rgba(80, 120, 240, 255)))
      })
      let _ = r.box(fn(col : view::View) {
        let _ = col.gap(view::Live::Is(4.0))
        let _ = col.box(fn(l1 : view::View) { let _ = l1.words(view::Live::Is("First line title"), look=view::WordsLook::of(14.0)) })
        let _ = col.box(fn(l2 : view::View) { let _ = l2.words(view::Live::Is("Second line detail"), look=view::WordsLook::of(14.0)) })
      })
    })
  })
  t_ok.assert_first_line(label="first-line-ok")
  t_ok.dispose()

  // Negative: icon vertically centered against a 3-line column
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(r : view::View) {
      let _ = r.row(view::Live::Is(true)).align_items(view::Along::Middle).gap(view::Live::Is(8.0)).pad(view::Live::Is(12.0))
      let _ = r.box(fn(icon : view::View) {
        let _ = icon
        .width(view::Live::Is(Some(16.0)))
        .height(view::Live::Is(Some(16.0)))
        .ground(view::Live::Is(rgba(80, 120, 240, 255)))
      })
      let _ = r.box(fn(col : view::View) {
        let _ = col.gap(view::Live::Is(4.0))
        let _ = col.box(fn(l1 : view::View) { let _ = l1.words(view::Live::Is("First line title"), look=view::WordsLook::of(14.0)) })
        let _ = col.box(fn(l2 : view::View) { let _ = l2.words(view::Live::Is("Second line detail"), look=view::WordsLook::of(14.0)) })
        let _ = col.box(fn(l3 : view::View) { let _ = l3.words(view::Live::Is("Third line extra"), look=view::WordsLook::of(14.0)) })
      })
    })
  })
  let faults = t_bad.first_line_faults()
  debug_assert(any_fault_prefix(faults, "first_line:"), "expected first_line: fault for centered icon beside multi-line block")
  debug_assert(any_fault_prefix(t_bad.ui_craft_audit(), "first_line:"), "ui_craft_audit must include first_line_faults")
  t_bad.dispose()
}

test "gate 8: line_start_faults catches continuation line floating between mark and words" {
  // Positive: continuation line aligns with mark's left edge (x=12) or words' left edge (x=40)
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(col : view::View) {
      let _ = col.pad(view::Live::Is(12.0)).gap(view::Live::Is(6.0))
      let _ = col.box(fn(head : view::View) {
        let _ = head.row(view::Live::Is(true)).gap(view::Live::Is(8.0))
        let _ = head.box(fn(mark : view::View) {
          let _ = mark
          .width(view::Live::Is(Some(20.0)))
          .height(view::Live::Is(Some(20.0)))
          .ground(view::Live::Is(rgba(80, 120, 240, 255)))
        })
        let _ = head.box(fn(title : view::View) {
          let _ = title.words(view::Live::Is("Header"), look=view::WordsLook::of(14.0))
        })
      })
      let _ = col.box(fn(line1 : view::View) {
        let _ = line1.words(view::Live::Is("Aligned with mark"), look=view::WordsLook::of(13.0))
      })
      let _ = col.box(fn(indented : view::View) {
        let _ = indented.padding(view::Live::Is((28.0, 0.0, 0.0, 0.0)))
        let _ = indented.box(fn(line2 : view::View) {
          let _ = line2.words(view::Live::Is("Aligned with words"), look=view::WordsLook::of(13.0))
        })
      })
    })
  })
  t_ok.assert_line_start(label="line-start-ok")
  t_ok.dispose()

  // Negative: continuation line indented by 10pt (floating in middle of 20pt mark + 8pt gap)
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(col : view::View) {
      let _ = col.pad(view::Live::Is(12.0)).gap(view::Live::Is(6.0))
      let _ = col.box(fn(head : view::View) {
        let _ = head.row(view::Live::Is(true)).gap(view::Live::Is(8.0))
        let _ = head.box(fn(mark : view::View) {
          let _ = mark
          .width(view::Live::Is(Some(20.0)))
          .height(view::Live::Is(Some(20.0)))
          .ground(view::Live::Is(rgba(80, 120, 240, 255)))
        })
        let _ = head.box(fn(title : view::View) {
          let _ = title.words(view::Live::Is("Header"), look=view::WordsLook::of(14.0))
        })
      })
      let _ = col.box(fn(misaligned : view::View) {
        let _ = misaligned.padding(view::Live::Is((10.0, 0.0, 0.0, 0.0)))
        let _ = misaligned.box(fn(line : view::View) {
          let _ = line.words(view::Live::Is("Floating line"), look=view::WordsLook::of(13.0))
        })
      })
    })
  })
  let faults = t_bad.line_start_faults()
  debug_assert(any_fault_prefix(faults, "line_start:"), "expected line_start: fault for floating continuation line")
  debug_assert(any_fault_prefix(t_bad.ui_craft_audit(), "line_start:"), "ui_craft_audit must include line_start_faults")
  t_bad.dispose()
}

test "gate 4: unseen_press_faults catches alpha=0 clickable button and passes inert alpha=0" {
  // Positive: alpha=0 button with presses(Is(false)) is inert and safe
  let t_ok = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b
      .width(view::Live::Is(Some(80.0)))
      .height(view::Live::Is(Some(40.0)))
      .alpha(view::Live::Is(0.0))
      .presses(view::Live::Is(false))
      .on_press(fn() {})
    })
  })
  t_ok.assert_unseen_press(label="inert-alpha-zero")
  t_ok.dispose()

  // Negative: alpha=0 button still accepting clicks -> click-through hazard
  let t_bad = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b
      .width(view::Live::Is(Some(80.0)))
      .height(view::Live::Is(Some(40.0)))
      .alpha(view::Live::Is(0.0))
      .on_press(fn() {})
    })
  })
  let faults = t_bad.unseen_press_faults()
  debug_assert(any_fault_prefix(faults, "unseen_press:"), "expected unseen_press: fault for alpha=0 clickable button")
  t_bad.dispose()
}

test "gate 5: focus_visible_faults passes visible focused node and catches offscreen focused node" {
  // Positive: focused button inside viewport
  let t_ok = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(40.0)))
        .focusable(view::Live::Is(true))
        .on_press(fn() {})
      })
    },
    width=400.0,
    height=300.0,
  )
  t_ok.press("Tab")
  t_ok.assert_focus_visible(label="focus-in-viewport")
  t_ok.dispose()

  // Negative: focused button positioned completely outside the viewport (x=900 > width=400)
  let t_bad = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b
        .over(view::Live::Is(true), edges=(Some(900.0), Some(20.0), None, None))
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(40.0)))
        .focusable(view::Live::Is(true))
        .on_press(fn() {})
      })
    },
    width=400.0,
    height=300.0,
  )
  t_bad.press("Tab")
  let faults = t_bad.focus_visible_faults()
  debug_assert(any_fault_prefix(faults, "focus_visible:"), "expected focus_visible: fault for offscreen focused node")
  t_bad.dispose()
}

test "gate 6: motion_steady_faults and MotionProbe catch jumps and oscillations" {
  let pos_x = signals::signal(0.0)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(pill : view::View) {
      let _ = pill
      .over_at(view::Live::By(fn() { (Some(pos_x.get()), Some(20.0), None, None) }))
      .width(view::Live::Is(Some(80.0)))
      .height(view::Live::Is(Some(40.0)))
      .words(view::Live::Is("Pill"), look=view::words_plain)
    })
  })
  // Smooth trajectory via MotionProbe: 0 -> 10 -> 20 -> 30
  let probe = MotionProbe::new("Pill")
  probe.attach(t)
  pos_x.set(10.0)
  t.frame(ms=16.0)
  pos_x.set(20.0)
  t.frame(ms=16.0)
  pos_x.set(30.0)
  t.frame(ms=16.0)
  probe.assert_steady(t, label="smooth-slide")

  // Sudden jump (> 48pt)
  pos_x.set(150.0)
  t.frame(ms=16.0)
  let jump_faults = probe.faults(t)
  debug_assert(any_fault_prefix(jump_faults, "motion_jump:"), "expected motion_jump: fault")

  // Back-and-forth oscillation (150 -> 160 -> 150)
  let jitter_samples = [
    (10.0, 20.0, 80.0, 40.0),
    (20.0, 20.0, 80.0, 40.0),
    (10.0, 20.0, 80.0, 40.0),
  ]
  let jitter_faults = t.motion_steady_faults(jitter_samples)
  debug_assert(any_fault_prefix(jitter_faults, "motion_jitter:"), "expected motion_jitter: fault")
  t.dispose()
}

test "combined ui_craft_audit passes clean layout and aggregates faults" {
  let t_clean = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(card : view::View) {
      let _ = card
      .pad(view::Live::Is(12.0))
      .radius(view::Live::Is(16.0))
      .ground(view::Live::Is(rgba(255, 255, 255, 255)))
      let _ = card.box(fn(btn : view::View) {
        let _ = btn
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(44.0)))
        .radius(view::Live::Is(4.0))
        .ground(view::Live::Is(rgba(20, 20, 24, 255)))
        .on_press(fn() {})
        let _ = btn.words(view::Live::Is("Action"), ink=rgba(255, 255, 255, 255), look=view::words_plain)
      })
    })
  })
  t_clean.assert_ui_craft(label="clean-card")
  t_clean.dispose()
}

test "inputrec: InputTape record -> to_lines -> from_lines -> deterministic replay" {
  let tape = InputTape::new()
  tape.record_move(40.0, 22.0, 16.0)
  tape.record_press(40.0, 22.0, 32.0)
  tape.record_release(40.0, 22.0, 48.0)
  tape.record_wait(32.0)
  tape.record_press(40.0, 22.0, 96.0)
  tape.record_release(40.0, 22.0, 112.0)
  tape.record_resize(640.0, 480.0, 144.0)
  tape.record_text("hello world\nline2", 160.0)
  tape.record_key(key_enter, 0, 176.0)
  tape.record_wheel(100.0, 100.0, 0.0, -24.0, 0, 192.0)

  let serialized = tape.to_lines()
  let restored = InputTape::from_lines(serialized)
  debug_assert(restored.len() == tape.len(), "round-trip event count matches")
  debug_assert(restored.to_lines() == serialized, "round-trip serialization is bit-exact")
  // CRLF line endings, blank lines and repeated spaces parse to the same tape
  let crlf = "\r\n" + serialized.replace("\n", "\r\n\r\n").replace("M ", "M  ")
  let restored_crlf = InputTape::from_lines(crlf)
  debug_assert(restored_crlf.len() == tape.len(), "CRLF tape event count matches")
  debug_assert(restored_crlf.to_lines() == serialized, "CRLF tape parses bit-exact")

  // Run original tape and restored tape on two fresh Tester trees and assert identical final state
  let run_with_tape = fn(tp : InputTape) -> (Int, Double, Double) {
    let clicks = ref_new(0)
    let t = Tester::tree(
      fn(root : view::View) {
        let _ = root.box(fn(b : view::View) {
          let _ = b
          .width(view::Live::Is(Some(120.0)))
          .height(view::Live::Is(Some(44.0)))
          .on_press(fn() { clicks.v = clicks.v + 1 })
          let _ = b.words(view::Live::Is("Tap"), look=view::words_plain)
        })
      },
      width=400.0,
      height=300.0,
    )
    tp.replay(t)
    let out = (clicks.v, t.fake.width, t.fake.height)
    t.dispose()
    out
  }

  let res_orig = run_with_tape(tape)
  let res_restored = run_with_tape(restored)
  debug_assert(res_orig.0 == 2, "expected 2 clicks from replayed tape")
  debug_assert(res_orig.1 == 640.0 && res_orig.2 == 480.0, "expected resized viewport 640x480")
  debug_assert(
    res_orig.0 == res_restored.0 && res_orig.1 == res_restored.1 && res_orig.2 == res_restored.2,
    "deserialized tape replay reproduces identical final state",
  )
}
