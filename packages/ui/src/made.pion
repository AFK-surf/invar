import "halt"
import "mbt_compat"
import "signals"
import "view"

// What is made once (the way there's 2): a node made by what it is filled with (`fill`, a call of
// Ctx::box or Ctx::text that makes that one node and nothing in it), what it holds made the same way, each followed by
// a watch of its own (ui/signals' Watch). Each frame what is made is put among the frame's nodes where its holder is
// built (Ctx::made), each node as it was made where nothing its fill read changed, filled anew in its place where
// something did; what it holds that comes and goes (made_each, made_show) is made as it comes and let go as it goes,
// what stays kept. What a press on it does is said once (Made::on_press) and done as the press is let go, not read
// as the frame is built. What the frame is told of a node (its marks, its focus, what is read out, its looks, its
// words: the way there's 1) is the node's, so a node put back as it was says it as it did.
//
// A frame built whole (the Tester's check, a pass built again) fills every node anew: what was kept and what is
// filled anew must come out the same, as rows kept as their nodes are held to (kept_nodes.pion).

///|
/// A node made once (made_box, made_text): what fills it, what it holds, the node as last filled, the watch of what
/// its fill read, what a press on it does.
pub struct Made {
  priv fill : (Ctx) -> Unit
  priv kids : MadeKids
  priv mut node : Option[Node]
  priv watch : signals::Watch
  priv mut on_press : Option[() -> Unit]
  priv held : mbt_compat::Ref[Option[RowNodes]]
  priv island : Option[(String, () -> String, Bool, Bool)]
  priv old : Bool
}

///|
/// What a node made holds: the same always, or what a run of `make` makes (made_each, made_show), made anew as what
/// that read changes.
enum MadeKids {
  Kept(Array[Made])
  Made(MadeChanging)
}

///|
struct MadeChanging {
  make : () -> Array[Made]
  watch : signals::Watch
  mut now : Array[Made]
}

///|
/// A watch of what a made node's fill, or what makes what it holds, read: told, the frame is built again for it (as
/// for a list's row kept as its nodes: kept_nodes.pion), between frames one owed; and the row or part kept as its nodes
/// it is in (`held`), built again with it, as though it read it itself.
fn made_watch(held : mbt_compat::Ref[Option[RowNodes]]) -> signals::Watch {
  signals::watch(fn() {
    match held.v {
      Some(rn) => rn.watch.touch()
      Option::None => ()
    }
    nodes_run.told = true
    watch_told_moment()
    if !frame_running.v {
      h_frame_owed()
    }
  })
}

///|
/// A node made by `fill` (a call of Ctx::box with a body that makes nothing, or of Ctx::text: what it reads followed,
/// filled anew in its place as any of it changes), holding `kids`.
pub fn made_box(fill : (Ctx) -> Unit, kids? : Array[Made]) -> Made {
  let kids = match kids { Some(__mbt_v) => __mbt_v, None => [] }

  let held = mbt_compat::ref_new(None)
  Made::{ fill: fill, kids: .Kept(kids), node: Option::None, watch: made_watch(held), on_press: Option::None, held: held, island: Option::None, old: false }
}

///|
/// What `body` builds the old way (Ctx::box and the rest, each frame it is built), in a box of its own filling what
/// holds it, kept as its nodes by a watch of its own (Ctx::kept_as_nodes): built again only as what it read changes or
/// what it is built from besides (`key`, worked out where it is put) does. Made once where it is (`name`), whatever
/// else of the frame is built anew: what is made once holds it, and what it reads it reads itself, never what was
/// handed it as it was made (the way there's 3: the old view as an island). `read_out`: what reads
/// the widgets reads it.
pub fn made_island(name : String, key : () -> String, body : (Ctx) -> Unit, read_out? : Bool, flows? : Bool) -> Made {
  let read_out = match read_out { Some(__mbt_v) => __mbt_v, None => true }
  let flows = match flows { Some(__mbt_v) => __mbt_v, None => false }

  let held = mbt_compat::ref_new(None)
  Made::{
    fill: body,
    kids: .Kept([]),
    node: Option::None,
    watch: made_watch(held),
    on_press: Option::None,
    held: held,
    island: Some((name, key, read_out, flows)),
    old: false,
  }
}

///|
/// What `body` builds the old way (Ctx::box and the rest), built each time it is put, kept as nothing: the frame's
/// watch follows what it reads, as it follows the rest of the frame built the old way (the way
/// there's 3: the old view in what is made once, its islands kept as they are where it is the frame's).
pub fn made_old(body : (Ctx) -> Unit) -> Made {
  let held = mbt_compat::ref_new(None)
  Made::{
    fill: body,
    kids: .Kept([]),
    node: Option::None,
    watch: made_watch(held),
    on_press: Option::None,
    held: held,
    island: Option::None,
    old: true,
  }
}

///|
/// A node made by `fill`, holding what `kids` makes (made_each, made_show), made anew as what it read changes.
pub fn made_holding(fill : (Ctx) -> Unit, kids : () -> Array[Made]) -> Made {
  let held = mbt_compat::ref_new(None)
  Made::{
    fill: fill,
    kids: .Made(MadeChanging::{ make: kids, watch: made_watch(held), now: [] }),
    node: Option::None,
    watch: made_watch(held),
    on_press: Option::None,
    held: held,
    island: Option::None,
    old: false,
  }
}

///|
/// Pressed (a tap, a click, Enter or Space where it takes the focus) and let go on it: `f`, as it is let go, outside
/// any build. Its fill gives it an id.
pub fn Made::on_press(self : Made, f : () -> Unit) -> Made {
  self.on_press = Some(f)
  self
}

///|
/// What `items` holds, a node each made by `row` from its item as a signal of its own: made as its key (`key`) comes,
/// kept while it stays (its item set anew there: what reads it filled anew), let go as it goes; in `items`' order.
pub fn made_each[T : Eq, K : mbt_compat::MbtHash + Eq + mbt_compat::MapKey](items : () -> Array[T], key : (T) -> K, row : (signals::Signal[T]) -> Made) -> () -> Array[Made] {
  let kept : Array[(K, signals::Signal[T], Made)] = []
  fn() {
    let now = items()
    let seen : Array[K] = []
    let out : Array[Made] = []
    signals::untracked(fn() {
      for item in now {
        let k = key(item)
        seen.push(k)
        let mut found = false
        for entry in kept {
          if entry.0 == k {
            entry.1.set(item)
            out.push(entry.2)
            found = true
            break
          }
        }
        if !found {
          let s = signals::signal(item)
          let m = row(s)
          kept.push((k, s, m))
          out.push(m)
        }
      }
    })
    let mut i = kept.length() - 1
    while i >= 0 {
      let mut alive = false
      for sk in seen {
        if sk == kept[i].0 {
          alive = true
          break
        }
      }
      if !alive {
        let gone_m = kept[i].2
        let _ = mbt_compat::arr_remove(kept, i)
        gone_m.let_go()
      }
      i -= 1
    }
    out
  }
}

///|
/// What `then` makes while `when` holds (made once as it comes to hold, let go as it stops), else nothing.
pub fn made_show(when : () -> Bool, then : () -> Made) -> () -> Array[Made] {
  let shown : mbt_compat::Ref[Option[Made]] = mbt_compat::ref_new(None)
  fn() {
    if when() {
      match shown.v {
        Some(m) => [m]
        Option::None => {
          let m = signals::untracked(then)
          shown.v = Some(m)
          [m]
        }
      }
    } else {
      match shown.v {
        Some(m) => {
          m.let_go()
          shown.v = None
        }
        Option::None => ()
      }
      []
    }
  }
}

///|
/// What `make` makes of which of its cases `which` says holds (Solid's Switch): made once as that case comes, let go as
/// another does, kept while it stays.
pub fn made_pick[K : Eq](which : () -> K, make : (K) -> Made) -> () -> Array[Made] {
  let shown : mbt_compat::Ref[Option[(K, Made)]] = mbt_compat::ref_new(None)
  fn() {
    let k = which()
    match shown.v {
      Some((was, m)) if was == k => [m]
      was => {
        match was {
          Some((_, m)) => m.let_go()
          None => ()
        }
        let m = signals::untracked(fn() { make(k) })
        shown.v = Some((k, m))
        [m]
      }
    }
  }
}

///|
/// Let go: it and what it holds follow nothing more.
fn Made::let_go(self : Made) -> Unit {
  self.watch.stop()
  match self.node {
    Some(n) if n.id != 0 && self.on_press is Some(_) => made_presses.remove(n.id)
    _ => ()
  }
  match self.node {
    Some(n) => n.unlinked()
    Option::None => ()
  }
  self.node = Option::None
  match self.kids {
    .Kept(ks) =>
    { for k in ks {
      k.let_go()
    } }
    .Made(ch) => {
      ch.watch.stop()
      for k in ch.now {
        k.let_go()
      }
    }
  }
}

///|
/// What is made, by key (Ctx::made), and the nodes put among the frame's by the last build, by their slots: taken out
/// as each build begins (made_detach) for the build to make its own in their places.
// kept across runs: let go as a run begins (made_forget)
// moved to 00_init_order.pion: made_roots

///|
// kept across runs: written as each build puts what is made among the frame's nodes
// moved to 00_init_order.pion: made_placed

///|
/// What a press on each node made does, by its id, as it was last put among the frame's (Made::on_press), till it is
/// let go: one kept in a list's row put back unbuilt with it does as it did.
// kept across runs: written as what is made is put among the frame's nodes, let go with it
// moved to 00_init_order.pion: made_presses

///|
/// What the second of two presses on each target does in place of a press (Ctx::on_double_press), by its id, as its
/// box was last built.
// kept across runs: written as what says it is built; a run's start clears it
// moved to 00_init_order.pion: made_double_presses

///|
/// What a part beside each target does as a press on the target is let go, as well as the target's own (a popover its
/// trigger opens: Ctx::on_press_beside), by its id, as it was last built.
// kept across runs: written as what says it is built; a run's start clears it
// moved to 00_init_order.pion: made_beside_presses

///|
/// A run begins: nothing made is kept.
fn made_forget() -> Unit {
  { let __mbt_mit_284 = mbt_compat::ordered_map_iter_lazy(made_roots); while true { match (__mbt_mit_284.next)() { Some((_, m)) => {
    m.let_go()
  }, None => break } } }
  made_roots.clear()
  made_placed.clear()
  made_presses.clear()
  made_double_presses.clear()
  made_beside_presses.clear()
  island_presses.clear()
  island_lists.clear()
  keys_taken.clear()
}

///|
/// As each pass of a frame's build begins: the nodes made the last put among the frame's taken out, a spare in each of
/// their places, for this build to make its own there.
fn Ctx::made_detach(self : Ctx) -> Unit {
  for p in made_placed {
    let (slot, n) = p
    if slot < self.nodes.length() && physical_equal(self.nodes[slot], n) {
      self.nodes[slot] = match spare_nodes.pop() {
        Some(sp) => sp
        Option::None => Node::new()
      }
    }
  }
  made_placed.clear()
}

///|
/// What `make` makes, made once (by `key` in the scope it is said in), put here among the frame's nodes each frame it
/// is built: each node as it was made where nothing its fill read changed, filled anew where something did.
pub fn Ctx::made(self : Ctx, key : String, make : () -> Made) -> Unit {
  let id = self.id(key)
  let m = match made_roots.get(id) {
    Some(m) => m
    Option::None => {
      let m = signals::untracked(make)
      made_roots.set(id, m)
      m
    }
  }
  self.made_put(m)
}

///|
/// Node `m` put here among the frame's, then what it holds in it.
fn Ctx::made_put(self : Ctx, m : Made) -> Unit {
  if m.old {
    (m.fill)(self)
    return
  }
  match m.island {
    Some((name, key, read_out, flows)) => {
      let k = signals::untracked(key)
      self.part_nodes(self.id(name), k, fn() { (m.fill)(self) }, read_out, own=true, named=name, flows=flows)
      return
    }
    Option::None => ()
  }
  let slot = self.count
  // (in a list's row or a part kept as its nodes: its nodes are the row's, kept with it, never put back by it too (one
  // node in two places), filled as the row is built; what makes it changed builds the row again: made_watch)
  m.held.v = nodes_run.building
  let in_row = nodes_run.building is Some(_)
  // (a frame built whole fills every node anew: what is kept held to what filling it makes)
  let whole = nodes_run.whole
  match m.node {
    Some(n) if !m.watch.is_stale() && !whole && !in_row => self.made_put_back(n, slot)
    _ => {
      m.watch.read(fn() { (m.fill)(self) })
      if self.count != slot + 1 {
        halt::saying("a made node's fill makes one node, nothing in it: \{self.count - slot} made", loc="made.pion:360:9")
      }
      // (the node it was last made in, taken out of the frame's as this build began (made_detach) and made in another
      // now: let go of, and so of what it holds, Node::unlinked)
      match m.node {
        Some(o) if !physical_equal(o, self.nodes[slot]) => o.unlinked()
        _ => ()
      }
      m.node = Some(self.nodes[slot])
    }
  }
  let n = self.nodes[slot]
  if !in_row {
    made_placed.push((slot, n))
  }
  match m.on_press {
    Some(f) if n.id != 0 => made_presses.set(n.id, f)
    _ => ()
  }
  let kids = match m.kids {
    .Kept(ks) => ks
    .Made(ch) => {
      if ch.watch.is_stale() || whole {
        ch.now = ch.watch.read(ch.make)
      }
      ch.now
    }
  }
  self.with_parent(slot, fn() {
    for k in kids {
      self.made_put(k)
    }
  })
}

///|
/// Node `n`, made and kept, put in `slot` (the next of the frame's) under what is being built, as alloc_part would
/// put one made there; what the frame is told of it said again (the way there's 1: what its node
/// does not hold).
fn Ctx::made_put_back(self : Ctx, n : Node, slot : Int) -> Unit {
  while self.nodes.length() <= slot {
    self.nodes.push(match spare_nodes.pop() {
      Some(sp) => sp
      Option::None => Node::new()
    },)
  }
  spare_nodes.push(self.nodes[slot])
  self.nodes[slot] = n
  self.count = slot + 1
  n.slot = slot
  n.parent = self.cur
  n.first = -1
  n.last = -1
  n.next = -1
  // (who it is, as the build would make it here (Ctx::node_known): made in this pass, what it holds counted from none,
  // and counted among what holds it, so that what is made in and after it is who it was)
  n.kids = 0
  n.made_pass = known_pass.v
  known_nodes.set(n.ident, n)
  if n.keyless && self.cur >= 0 {
    let p = self.nodes[self.cur]
    p.kids = p.kids + 1
  }
  if self.cur >= 0 {
    let p = self.nodes[self.cur]
    if p.last >= 0 {
      self.nodes[p.last].next = slot
    } else {
      p.first = slot
    }
    p.last = slot
  }
  if n.id != 0 {
    self.id_built(slot)
  }
  self.moves_said_again(slot, slot + 1)
  self.ticks_said_again(slot, slot + 1)
}

///|
/// A press on target `id` (a tap, a click, Enter or Space where it takes the focus, the Activate a screen reader asks),
/// let go on it, does `f`: then, as it is let go, outside any build, not read as the next frame is built (the model's
/// 5: acting is a callback); its moment the event's (Ctx::moment). Said as `id`'s box is built (what it does is what the last build said), it takes presses (the pointer's
/// hand over it). It runs in the scope it was said in
/// (Ctx::id, Ctx::scope): a key it names is the target or the field it named where it was said (in_said_scope).
pub fn Ctx::on_press(self : Ctx, id : Int, f : () -> Unit) -> Unit {
  if id == 0 {
    return
  }
  self.takes_presses(id)
  // (read so: what said it is built again as it is pressed, as what reads a click is (a part's Response, hand.pion), and
  // draws what the press changed of what it holds)
  hand.clicked.has(id) |> ignore
  hand.asked.has(id) |> ignore
  let g = self.in_said_scope(f)
  made_presses.set(id, g)
  island_said_press(0, id, g)
}

///|
/// `f` as it runs outside any build, in the scope (Ctx::scope's) the build that said it was in then: the ids its keys
/// name (Ctx::id) those of what was built where it was said, not the window's root's.
fn Ctx::in_said_scope(self : Ctx, f : () -> Unit) -> () -> Unit {
  let seed = self.id_seed
  fn() {
    let was = self.id_seed
    self.id_seed = seed
    f()
    self.id_seed = was
  }
}

///|
/// `f` with one argument, as Ctx::in_said_scope runs a handler in the scope the build that said it was in then.
fn Ctx::in_said_scope_1[T](self : Ctx, f : (T) -> Unit) -> (T) -> Unit {
  let seed = self.id_seed
  fn(x) {
    let was = self.id_seed
    self.id_seed = seed
    f(x)
    self.id_seed = was
  }
}

///|
/// The second of two presses on target `id` (a desktop's double click: the second let go within double_click_ms of the
/// first, as near as double_click_slop) does `f` in place of what a press on it does (Ctx::on_press, which the first
/// did): as it is let go, outside any build, its moment the event's. Said as `id`'s box is built.
pub fn Ctx::on_double_press(self : Ctx, id : Int, f : () -> Unit) -> Unit {
  if id == 0 {
    return
  }
  self.takes_presses(id)
  // (read so: what said it is built again as it is pressed twice, hand.pion)
  hand.double.has(id) |> ignore
  let g = self.in_said_scope(f)
  made_double_presses.set(id, g)
  island_said_press(1, id, g)
}

///|
/// A press let go on target `id` does `f` too, beside what the target's own handler does (Ctx::on_press, said by what
/// the target is): what a part that stands by another's target does as it is pressed (a popover its trigger opens or
/// shuts), as it is let go, outside any build, its moment the event's. Said as the part is built; its own, one for each
/// target, not the target's.
pub fn Ctx::on_press_beside(self : Ctx, id : Int, f : () -> Unit) -> Unit {
  if id == 0 {
    return
  }
  self.takes_presses(id)
  // (read so: what said it is built again as the target is pressed, hand.pion)
  hand.clicked.has(id) |> ignore
  let g = self.in_said_scope(f)
  made_beside_presses.set(id, g)
  island_said_press(2, id, g)
}

///|
/// What each old view said its presses do as it was built (Ctx::on_press, on_double_press, on_press_beside: which of
/// the three, the target's id, the handler said last), by its island's node, for it to take back as it is let go
/// (old_presses_gone): kept for its targets' ids alone, the three would hold every handler of every old view ever
/// built, and all their handlers hold (a chat page's, opened again and again, each time with ids of its own).
// kept across runs: written as an old view says a press, let go with it; a run's start clears it
// moved to 00_init_order.pion: island_presses

///|
fn island_said_press(which : Int, id : Int, f : () -> Unit) -> Unit {
  match island_building.v {
    Some(i) => {
      let k = (i.at, i.gen)
      let m = match island_presses.get(k) {
        Some(m) => m
        Option::None => {
          let m : mbt_compat::OrderedMap[(Int, Int), () -> Unit] = mbt_compat::ordered_map_new_pair()
          island_presses.set(k, m)
          m
        }
      }
      m.set((which, id), f)
    }
    Option::None => ()
  }
}

///|
/// What each old view keeps by an id of its own (its lists, Ctx::list_grew and the keys each had; what it tells after
/// its build again as its lists move, Ctx::after_build_or_scroll; how the hand has its bars, Ctx::bar_hand), by its
/// island's node, let go with it (old_presses_gone): by their ids alone, list_counts, list_keys_seen,
/// tells_follow_lists and bars_hand would keep those of every old view ever built, each a chat's whole list of keys.
// kept across runs: written as an old view builds, let go with it; a run's start clears it
// moved to 00_init_order.pion: island_lists

///|
fn island_said_list(id : Int) -> Unit {
  island_said_id(0, id)
}

///|
/// Kept by id `id` of kind `kind` (0 a list's, 1 a tell that follows lists, 2 a bar's, 3 an editor's) for the old view
/// being built.
fn island_said_id(kind : Int, id : Int) -> Unit {
  match island_building.v {
    Some(i) => {
      let k = (i.at, i.gen)
      match island_lists.get(k) {
        Some(m) => m.set((kind, id), true)
        Option::None => { let m : mbt_compat::OrderedMap[(Int, Int), Bool] = mbt_compat::ordered_map_new_pair(); m.set((kind, id), true); island_lists.set(k, m) }
      }
    }
    Option::None => ()
  }
}

///|
/// The old view of island `i` let go: the presses it said taken back, where what it said is what is said for them
/// still (another said for the same target since keeps its own).
fn old_presses_gone(i : view::NodeId) -> Unit {
  match island_lists.get((i.at, i.gen)) {
    Some(ls) => {
      island_lists.remove((i.at, i.gen))
      { let __mbt_mit_578 = mbt_compat::ordered_map_iter_lazy(ls); while true { match (__mbt_mit_578.next)() { Some((k, _)) => {
        // (unless another old view built it too: one made again in its place, as it went)
        if !mbt_compat::arr_any(island_lists.values(), fn(o) { o.contains(k) }) {
          let (kind, id) = k
          if kind == 0 {
            list_counts.remove(id)
            list_keys_seen.remove(id)
          } else if kind == 1 {
            tells_follow_lists.remove(id)
          } else if kind == 2 {
            bars_hand.remove(id)
          } else {
            // (an editor of it: what it was told let go, and its state where the window's Ctx keeps it by its id)
            let c = g()
            match c.editors.get(id) {
              Some(st) => {
                editor_gone(st, id)
                c.editors.remove(id)
              }
              Option::None => ()
            }
          }
        }
      }, None => break } } }
    }
    Option::None => ()
  }
  guard island_presses.get((i.at, i.gen)) is Some(m) else { return }
  island_presses.remove((i.at, i.gen))
  { let __mbt_mit_607 = mbt_compat::ordered_map_iter_lazy(m); while true { match (__mbt_mit_607.next)() { Some((k, f)) => {
    let (which, id) = k
    let presses = if which == 0 {
      made_presses
    } else if which == 1 {
      made_double_presses
    } else {
      made_beside_presses
    }
    match presses.get(id) {
      Some(g) if physical_equal(g, f) => presses.remove(id)
      _ => ()
    }
  }, None => break } } }
}

///|
/// What the part over a field said the field's keys do (Ctx::on_key), and the build that last said it (or put the part
/// back unbuilt with it).
struct KeysTaken {
  take : (Int, Int) -> Bool
  mut build : Int
}

///|
/// The keys taken over each field (by the field's id, its owner): one part's at a time, the last build's to say it.
// kept across runs: said as each build builds what takes them, let go as a build does not; a run's start clears it
// moved to 00_init_order.pion: keys_taken

///|
/// The keys of field `owner` (the id that has the focus as they come: its editor's) that the part being built over it
/// takes (a menu of what to put in it: ↑ ↓ to choose, Enter to put the one chosen in): `take` given each key (its code
/// and what is held with it) as it comes, outside any build, before the window's tree's Tab, the field and the frame
/// see it, only while `owner` has the focus where it takes input then (Ctx::focus_allowed: its island taking input;
/// Ctx::keys_reach: no layer over it the keys go to), never a key catcher's (its keys all its own); saying whether it
/// took it (taken, nothing else sees it). `take` asks, as the key comes, whether what it was built for still holds
/// (the menu still open over the words it was built for): not, it takes nothing, and the key goes on as any key does. Said each build it is built (kept unbuilt with its part, as it was); a build that does not
/// say it has let it go.
pub fn Ctx::on_key(self : Ctx, owner : Int, take : (Int, Int) -> Bool) -> Unit {
  if owner == 0 {
    return
  }
  let w = KeysTaken::{ take: take, build: self.build_no }
  keys_taken.set(owner, w)
  built_used(fn() { w.build = g().build_no })
}

///|
/// A key come (`code`, `mods`) to `focus` (the focus where it takes input, 0 none): given to what the last build said
/// takes that field's keys, if it does.
fn keys_taken_now(focus : Int, code : Int, mods : Int) -> Bool {
  // (the focus where the keys go: no layer over it that takes them, modal or with the focus in it, Ctx::keys_reach; a
  // key catcher's are all its own, as they are before anything else: catcher_key)
  if focus == 0 || g().dev.catchers.contains(focus) || !g().keys_reach(focus) {
    return false
  }
  match keys_taken.get(focus) {
    Some(w) if w.build >= builds_made.v => {
      signals::start_batch()
      let took = signals::untracked(fn() { (w.take)(code, mods) })
      signals::end_batch()
      took
    }
    Some(_) => {
      keys_taken.remove(focus)
      false
    }
    Option::None => false
  }
}

///|
/// A step up (`up`) or down asked of `id` (the Increment or Decrement a screen reader asks): given, at its moment, to
/// what its last build said takes its keys (Ctx::on_key), as the Up or Down key is; whether it took it.
fn made_stepped(id : Int, up : Bool) -> Bool {
  match keys_taken.get(id) {
    Some(w) if w.build >= builds_made.v => {
      signals::start_batch()
      let took = signals::untracked(fn() { (w.take)(if up { key_code_up } else { key_code_down }, 0) })
      signals::end_batch()
      took
    }
    _ => false
  }
}

///|
/// A frame built: what takes the keys of a field it no longer said so of let go (its part not built nor kept).
fn keys_taken_built() -> Unit {
  let last = builds_made.v
  let gone : Array[Int] = []
  keys_taken.each(fn(k, w) { if w.build < last { gone.push(k) } })
  for k in gone {
    keys_taken.remove(k)
  }
}

///|
/// Target `id` let go of a press (a click, a tap, a key): what a node made said a press on it does, done now, outside
/// any build (Made::on_press).
fn made_pressed(id : Int) -> Unit {
  run_press(made_presses.get(id))
  run_press(made_beside_presses.get(id))
}

///|
/// The second of two presses let go on target `id`: what was said it does (Ctx::on_double_press), done now, outside any
/// build; whether one was said (none: it is a press as any other).
fn made_double_pressed(id : Int) -> Bool {
  let f = made_double_presses.get(id)
  run_press(f)
  f is Some(_)
}

///|
/// A press's handler run outside any build: what it changes told once it has done.
fn run_press(f : Option[() -> Unit]) -> Unit {
  match f {
    Some(f) => {
      signals::start_batch()
      signals::untracked(f)
      signals::end_batch()
    }
    Option::None => ()
  }
}
