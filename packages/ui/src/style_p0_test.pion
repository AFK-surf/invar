// Wave P0-2A unit tests:
// - `text::span` & `ui::span` (full fields, `weight` precedence over `bold`)
// - `TextPatch` (`w`, `center`, `balance`) & `TextStyle::resolve` 6-layer priority
// - Reactive `style_words`, `style_ink`, `style_tabular`, `style_cut`, `style_fills`, `style_centered`
//   across dual windows and offscreen `view::Tree` `tree_narrow()`
// - `Align::AFirstLine` and declarative `ui::css` / `ui::css_read`

import "signals"
import "text"
import "view"

fn p0_2a_int_eq(opt : Option[Int], want : Int) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_bool_eq(opt : Option[Bool], want : Bool) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_len_eq(opt : Option[Len], want : Len) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_space_eq(opt : Option[Space], want : Space) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_align_eq(opt : Option[Align], want : Align) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_justify_eq(opt : Option[Justify], want : Justify) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_color_eq(opt : Option[Color], want : Color) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_stroke_eq(opt : Option[Stroke], want : Stroke) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_opacity_eq(opt : Option[Opacity], want : Opacity) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_shadow_eq(opt : Option[Shadow], want : Shadow) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_tsize_eq(opt : Option[TextSize], want : TextSize) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

fn p0_2a_weight_eq(opt : Option[Weight], want : Weight) -> Bool {
  match opt { Some(v) => v == want; None => false }
}

test "p0-2a: text::span and ui::span full fields and weight-over-bold precedence" {
  let g = text::Ground::{ room: 0.4, height: 1.2, corner: 0.25, after: 0.3 }
  let d = text::InlineDrawing::{
    width: 1.5,
    height: 1.0,
    baseline: 0.8,
    paths: [],
    words: [("x", 0.1, 0.2, 0.9)],
  }

  let r_plain = text::span("hello")
  debug_assert(r_plain.text == "hello", "plain text")
  debug_assert(r_plain.weight == 0 && !r_plain.italic && !r_plain.code && !r_plain.mono && !r_plain.serif, "plain defaults")
  debug_assert(r_plain.scale == 1.0 && r_plain.color == 0L && r_plain.bg == 0L, "plain numeric defaults")
  debug_assert(!r_plain.strike && !r_plain.underline && r_plain.link == "", "plain deco defaults")
  debug_assert(r_plain.face is None && r_plain.ground is None && r_plain.drawing is None, "plain option defaults")

  // bold=true with default weight=0 -> 700
  let r_bold = text::span("bold", bold=true)
  debug_assert(r_bold.weight == 700, "bold=true with weight=0 sets weight 700")

  // weight != 0 takes precedence over bold=true
  let r_weighted = text::span("semi", weight=600, bold=true)
  debug_assert(r_weighted.weight == 600, "explicit weight != 0 overrides bold=true")
  let r_light = text::span("light", weight=300, bold=true)
  debug_assert(r_light.weight == 300, "explicit weight=300 overrides bold=true")

  // All fields forwarded through ui::span
  let r_full = text::span(
    "full",
    weight=500,
    bold=true,
    italic=true,
    code=true,
    mono=true,
    serif=true,
    face=Some(2),
    scale=0.85,
    color=rgba(10, 20, 30, 255),
    bg=rgba(200, 210, 220, 255),
    ground=Some(g),
    strike=true,
    underline=true,
    link="https://example.com",
    drawing=Some(d),
  )
  debug_assert(r_full.text == "full" && r_full.weight == 500, "full weight")
  debug_assert(r_full.italic && r_full.code && r_full.mono && r_full.serif, "full flags")
  debug_assert(p0_2a_int_eq(r_full.face, 2), "full face")
  debug_assert(r_full.scale == 0.85, "full scale")
  debug_assert(r_full.color == rgba(10, 20, 30, 255), "full color")
  debug_assert(r_full.bg == rgba(200, 210, 220, 255), "full bg")
  debug_assert(r_full.strike && r_full.underline && r_full.link == "https://example.com", "full deco & link")
  match r_full.ground {
    Some(rg) => debug_assert(rg.room == 0.4 && rg.height == 1.2 && rg.corner == 0.25 && rg.after == 0.3, "full ground")
    None => debug_assert(false, "expected ground")
  }
  match r_full.drawing {
    Some(rd) => debug_assert(rd.width == 1.5 && rd.height == 1.0 && rd.baseline == 0.8 && rd.words.length() == 1, "full drawing")
    None => debug_assert(false, "expected drawing")
  }
}

test "p0-2a: TextPatch w/center/balance and TextStyle::resolve 2-layer priority" {
  let base_st = text_style(
    size=TextSize::Body,
    weight=Weight::Normal,
    color=Color::Fg,
    w=Len::Hug,
    center=false,
    balance=false,
    narrow=text_patch(size=TextSize::Sm, w=Len::Cut, balance=true),
    dark=text_patch(color=Color::Muted, center=true),
  )

  // Layer 0: base only
  let p0 = base_st.resolve(false, false)
  debug_assert(p0_2a_tsize_eq(p0.size, TextSize::Body), "base size")
  debug_assert(p0_2a_color_eq(p0.color, Color::Fg), "base color")
  debug_assert(p0_2a_len_eq(p0.w, Len::Hug), "base w")
  debug_assert(p0_2a_bool_eq(p0.center, false), "base center")
  debug_assert(p0_2a_bool_eq(p0.balance, false), "base balance")

  // Layer 1: base -> narrow
  let p1 = base_st.resolve(true, false)
  debug_assert(p0_2a_tsize_eq(p1.size, TextSize::Sm), "narrow overrides size")
  debug_assert(p0_2a_len_eq(p1.w, Len::Cut), "narrow overrides w")
  debug_assert(p0_2a_bool_eq(p1.balance, true), "narrow overrides balance")
  debug_assert(p0_2a_color_eq(p1.color, Color::Fg), "narrow keeps base color")

  // Layer 2: base -> narrow -> dark
  let p2 = base_st.resolve(true, true)
  debug_assert(p0_2a_tsize_eq(p2.size, TextSize::Sm), "dark keeps narrow size")
  debug_assert(p0_2a_color_eq(p2.color, Color::Muted), "dark overrides color")
  debug_assert(p0_2a_bool_eq(p2.center, true), "dark overrides center")
  debug_assert(p0_2a_bool_eq(p2.balance, true), "earlier non-overridden fields survive")

  // Verify TextPatch::then preserves and overrides w/center/balance
  let composed = text_patch(w=Len::Cut, center=true, balance=false).then(text_patch(balance=true))
  debug_assert(p0_2a_len_eq(composed.w, Len::Cut), "then keeps w")
  debug_assert(p0_2a_bool_eq(composed.center, true), "then keeps center")
  debug_assert(p0_2a_bool_eq(composed.balance, true), "then overrides balance")
}

test "p0-2a: css_read complex expression, Over RGBA, Align::FirstLine, row=false, and state blocks" {
  let expr = "row=false w=Fixed(24) h=S8 min_w=S2 max_w=Pct(80) min_h=Hug max_h=Within(120) p=S4 px=S2 py=S1 pt=S0_5 pr=SPx pb=S1_25 pl=S1_5 m=S2 mx=Exact(3.5) my=S0 mt=S3 mr=S4 mb=S5 ml=S6 gap=S2_5 align=AFirstLine justify=JEvenly bg=Over(Card, A(Fg, O5)) radius=InnerOr(Lg) border=B0_5 border_color=Line dashed=true shadow=Cast(8.0, 2.5, 0x11223344) clip opacity=O75 narrow{w=Full row} dark{bg=Raised} selected{bg=Selected} hovered{bg=Hover} hovered{opacity=O90} focused{border=B2} pressed{bg=AccentBg} disabled{opacity=O50}"
  let st = match css_read(expr) {
    Ok(s) => s
    Err(e) => panic("expected valid css, got: " + e)
  }

  debug_assert(p0_2a_bool_eq(st.base.row, false), "row=false")
  debug_assert(p0_2a_len_eq(st.base.w, Len::Fixed(24.0)), "w=Fixed(24)")
  debug_assert(p0_2a_len_eq(st.base.h, Len::S8), "h=S8")
  debug_assert(p0_2a_len_eq(st.base.min_w, Len::S2), "min_w=S2")
  debug_assert(p0_2a_len_eq(st.base.max_w, Len::Pct(80.0)), "max_w=Pct(80)")
  debug_assert(p0_2a_len_eq(st.base.min_h, Len::Hug), "min_h=Hug")
  debug_assert(p0_2a_len_eq(st.base.max_h, Len::Within(120.0)), "max_h=Within(120)")
  debug_assert(p0_2a_space_eq(st.base.p, Space::S4) && p0_2a_space_eq(st.base.px, Space::S2) && p0_2a_space_eq(st.base.py, Space::S1), "p/px/py")
  debug_assert(p0_2a_space_eq(st.base.pt, Space::S0_5) && p0_2a_space_eq(st.base.pr, Space::SPx) && p0_2a_space_eq(st.base.pb, Space::S1_25) && p0_2a_space_eq(st.base.pl, Space::S1_5), "pt/pr/pb/pl")
  debug_assert(p0_2a_space_eq(st.base.mx, Space::Exact(3.5)), "mx=Exact(3.5)")
  debug_assert(p0_2a_space_eq(st.base.gap, Space::S2_5), "gap=S2_5")
  debug_assert(p0_2a_align_eq(st.base.align, Align::AFirstLine), "align=AFirstLine")
  debug_assert(p0_2a_justify_eq(st.base.justify, Justify::JBetween), "justify=JEvenly maps to JBetween")
  debug_assert(p0_2a_stroke_eq(st.base.border, Stroke::B0_5), "border=B0_5")
  debug_assert(p0_2a_color_eq(st.base.border_color, Color::Line), "border_color=Line")
  debug_assert(p0_2a_bool_eq(st.base.dashed, true), "dashed=true")
  debug_assert(p0_2a_bool_eq(st.base.clip, true), "bare clip flag")
  debug_assert(p0_2a_opacity_eq(st.base.opacity, Opacity::O75), "opacity=O75")
  debug_assert(p0_2a_shadow_eq(st.base.shadow, Shadow::Cast(8.0, 2.5, 0x11223344L)), "shadow=Cast")
  match st.base.radius {
    Some(Radius::InnerOr(Radius::Lg)) => ()
    _ => debug_assert(false, "radius=InnerOr(Lg)")
  }

  // Verify Over(Card, A(Fg, O5)) resolves to exact Porter-Duff RGBA in both light & dark themes
  let want_bg = Color::Over(Color::Card, Color::A(Color::Fg, Opacity::O5))
  debug_assert(p0_2a_color_eq(st.base.bg, want_bg), "bg token structure")
  let light = Theme::light()
  let dark = Theme::dark()
  debug_assert(
    light.color(want_bg) == over(light.card, alpha(light.fg, 0.05)),
    "Over(Card, A(Fg, O5)) light RGBA exact match",
  )
  debug_assert(
    dark.color(want_bg) == over(dark.card, alpha(dark.fg, 0.05)),
    "Over(Card, A(Fg, O5)) dark RGBA exact match",
  )

  // Verify state blocks + duplicate hovered block whole-block replacement (last-wins)
  match st.narrow {
    Some(nb) => debug_assert(p0_2a_len_eq(nb.w, Len::Full) && p0_2a_bool_eq(nb.row, true), "narrow block")
    None => debug_assert(false, "missing narrow block")
  }
  match st.hovered {
    Some(hb) => debug_assert(hb.bg is None && p0_2a_opacity_eq(hb.opacity, Opacity::O90), "duplicate hovered block replaces previous block")
    None => debug_assert(false, "missing hovered block")
  }
  let dup_override = css("hovered{bg=Hover opacity=O50} hovered{bg=Accent}")
  match dup_override.hovered {
    Some(hb) => debug_assert(p0_2a_color_eq(hb.bg, Color::Accent) && hb.opacity is None, "duplicate hovered replaces previous block whole")
    None => debug_assert(false, "missing dup hovered block")
  }
  let dup_clear = css("hovered{clip} hovered{}")
  match dup_clear.hovered {
    Some(hb) => debug_assert(hb.clip is None, "empty duplicate hovered block clears previous clip")
    None => debug_assert(false, "missing cleared hovered block")
  }

  // All Align & Justify variants
  debug_assert(p0_2a_align_eq(css("align=AStart justify=JStart").base.align, Align::AStart), "AStart")
  debug_assert(p0_2a_align_eq(css("align=ACenter justify=JCenter").base.align, Align::ACenter), "ACenter")
  debug_assert(p0_2a_align_eq(css("align=AEnd justify=JEnd").base.align, Align::AEnd), "AEnd")
  debug_assert(p0_2a_align_eq(css("align=AStretch justify=JBetween").base.align, Align::AStretch), "AStretch")
  debug_assert(p0_2a_align_eq(css("align=ABaseline justify=JAround").base.align, Align::ABaseline), "ABaseline")
  debug_assert(p0_2a_justify_eq(css("align=AFirstLine justify=JEvenly").base.justify, Justify::JBetween), "JEvenly maps to JBetween")
  debug_assert(p0_2a_color_eq(css("bg=Exact(0xFF8800FF) border_color=Data(0x00AAFF80)").base.bg, Color::Exact(0xFF8800FFL)), "Exact hex color")
}

test "p0-2a: css_read rejections and 0-based UTF-8 byte offsets" {
  // Reject col
  debug_assert(css_read("col") is Err(_), "bare col rejected")
  debug_assert(css_read("col=true") is Err(_), "col=true rejected")

  // Reject Corners / Linked / LinkedEach
  debug_assert(css_read("radius=Corners(1, 2, 3, 4)") is Err(_), "Corners rejected")
  debug_assert(css_read("radius=Linked(x)") is Err(_), "Linked rejected")
  debug_assert(css_read("radius=LinkedEach(x)") is Err(_), "LinkedEach rejected")

  // Reject nested state blocks, unclosed block, stray }
  debug_assert(css_read("hovered{dark{bg=Bg}}") is Err(_), "nested state block rejected")
  debug_assert(css_read("hovered{bg=Bg") is Err(_), "unclosed block rejected")
  debug_assert(css_read("bg=Bg}") is Err(_), "stray closing brace rejected")

  // Reject NaN / Inf / -Inf / mantissa > 2^53 / exponent > 22
  debug_assert(css_read("w=Fixed(NaN)") is Err(_), "NaN rejected")
  debug_assert(css_read("w=Fixed(Inf)") is Err(_), "Inf rejected")
  debug_assert(css_read("w=Fixed(-Inf)") is Err(_), "-Inf rejected")
  debug_assert(css_read("w=Fixed(9007199254740993)") is Err(_), "mantissa > 2^53 rejected")
  debug_assert(css_read("w=Fixed(1e23)") is Err(_), "exponent > 22 rejected")
  debug_assert(css_read("w=Fixed(1e-23)") is Err(_), "exponent < -22 rejected")

  // Multi-line + multi-byte UTF-8 byte offset accuracy:
 // "row\n " -> 'r'(0) 'o'(1) 'w'(2) '\n'(3) ' '(4) ' '(5) ''(6..9)
  let utf8_bad = "row\n  中文"
  match css_read(utf8_bad) {
    Err(msg) => {
      let expected = "css: a name wanted at 6 in \"row\n  中文\""
      debug_assert(msg == expected, "UTF-8 byte offset 6, got: " + msg)
    }
    Ok(_) => debug_assert(false, "expected Err for non-ASCII token")
  }

  // Exact byte offset after ASCII prefix on second line:
  // "row\n  w=Fixed(NaN)" -> "row\n  w=Fixed(" is 14 bytes, 'N' is at byte 14
  let nan_multi = "row\n  w=Fixed(NaN)"
  match css_read(nan_multi) {
    Err(msg) => {
      let expected = "css: a number wanted at 14 in \"row\n  w=Fixed(NaN)\""
      debug_assert(msg == expected, "NaN byte offset 14, got: " + msg)
    }
    Ok(_) => debug_assert(false, "expected Err for NaN")
  }
}

test "p0-2a: reactive style_words/style_ink/style_tabular/style_cut/style_fills/style_centered across dual windows and offscreen tree" {
  let _ = windows_reset()

  let st = text_style(
    size=TextSize::Body,
    weight=Weight::Normal,
    color=Color::Fg,
    w=Len::Full,
    center=false,
    balance=false,
    tabular=false,
    tracking=Tracking::Tight,
    max_lines=3,
    narrow=text_patch(
      size=TextSize::Sm,
      weight=Weight::Semibold,
      w=Len::Cut,
      center=true,
      balance=true,
      tabular=true,
    ),
    dark=text_patch(
      color=Color::Accent,
      leading=Leading::L6,
    ),
  )

  // Window 0: light theme, 1000px wide, narrow enabled
  let t = Tester::tree(fn(_r : view::View) { () }, w=1000.0, h=600.0)
  set_tree_theme(fn() { Theme::light() })
  set_narrow_enabled(true)
  t.frame()

  let w0_look = style_words(st)
  debug_assert(w0_look.size == 16.0 && w0_look.line == 24.0 && w0_look.weight == 400, "w0 wide light WordsLook")
  debug_assert(w0_look.wrap && !w0_look.balance && w0_look.max_lines == 3, "w0 wide light wrap/balance/max_lines")
  debug_assert(w0_look.tracking == view::Spacing::Ems(-0.025), "w0 tracking Ems")
  debug_assert(style_ink(st) == Theme::light().fg, "w0 light ink")
  debug_assert(p0_2a_bool_eq(style_tabular(st), false), "w0 wide tabular=Some(false)")
  debug_assert(!style_cut(st) && style_fills(st) && !style_centered(st), "w0 wide cut/fills/centered")

  // Window 1 (secondary): dark theme, narrow disabled
  in_window(201, fn() {
    set_tree_theme(fn() { Theme::dark() })
    set_narrow_enabled(false)
    let w1_look = style_words(st)
    debug_assert(w1_look.line == 24.0 && w1_look.size == 16.0, "w1 dark WordsLook")
    debug_assert(style_ink(st) == Theme::dark().accent, "w1 dark accent ink")
    debug_assert(!style_cut(st) && style_fills(st) && !style_centered(st), "w1 wide flags")
  })

  // Window 0 unaffected by Window 1
  debug_assert(style_ink(st) == Theme::light().fg, "w0 light ink preserved after secondary window")

  // Offscreen standalone Tree::new inside 1000px wide Window 0:
  // flips 400px (narrow) -> 1000px (wide)
  let off_size = signals::ref_new(0.0)
  let off_cut = signals::ref_new(false)
  let off_fills = signals::ref_new(false)
  let off_centered = signals::ref_new(false)
  let off_tabular : signals::Ref[Option[Bool]] = signals::ref_new(None)
  let off_balance = signals::ref_new(false)
  let off_tree = view::Tree::new(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b
          .fill()
          .words(view::Live::Is("probe"))
          .words_look(view::Live::By(fn() {
            let lk = style_words(st)
            off_size.v = lk.size
            off_balance.v = lk.balance
            off_cut.v = style_cut(st)
            off_fills.v = style_fills(st)
            off_centered.v = style_centered(st)
            off_tabular.v = style_tabular(st)
            lk
          }))
          .ink(view::Live::By(fn() { style_ink(st) }))
      })
    },
    measure=host_words_measure,
    measure_runs=host_runs_measure,
    measure_runs_least=host_runs_least_measure,
  )

  let _ = encode_tree_scene(off_tree, 400.0, 600.0, 1.0, 10.0)
  debug_assert(off_size.v == 14.0 && off_balance.v, "offscreen 400px resolves narrow TextSize::Sm & balance=true")
  debug_assert(off_cut.v && !off_fills.v && off_centered.v && p0_2a_bool_eq(off_tabular.v, true), "offscreen 400px resolves narrow cut/fills/centered/tabular")

  let _ = encode_tree_scene(off_tree, 1000.0, 600.0, 1.0, 26.0)
  debug_assert(off_size.v == 16.0 && !off_balance.v, "offscreen 1000px resolves wide TextSize::Body & balance=false")
  debug_assert(!off_cut.v && off_fills.v && !off_centered.v && p0_2a_bool_eq(off_tabular.v, false), "offscreen 1000px resolves wide flags")

  // Unset tabular returns None
  let unset_tab = text_style(size=TextSize::Ui)
  debug_assert(style_tabular(unset_tab) is None, "unset tabular returns None")

  off_tree.dispose()
  clear_tree_theme()
  t.dispose()
  let _ = windows_reset()
}

test "p0-2a: css_read extreme exponent, exact Int64::min, and recursion depth bounds" {
  // 0.<999 zeros>1e10000 must fail with |e| > 22 instead of silently truncating exponent to 1000
  let sb = StringBuilder::new()
  sb.write_string("w=Fixed(0.")
  let mut i = 0
  while i < 999 {
    sb.write_string("0")
    i += 1
  }
  sb.write_string("1e10000)")
  debug_assert(css_read(sb.to_string()) is Err(_), "extreme exponent must be rejected")

  // Exact Int64::min accepted; Int64::min - 1 and Int64::max + 1 rejected
  let min_i64 : Int64 = -9223372036854775807L - 1L
  match css_read("bg=Data(-9223372036854775808)") {
    Ok(s) => debug_assert(p0_2a_color_eq(s.base.bg, Color::Data(min_i64)), "exact Int64::min parsed")
    Err(e) => panic("expected exact Int64::min to succeed, got: " + e)
  }
  debug_assert(css_read("bg=Data(-9223372036854775809)") is Err(_), "Int64::min - 1 rejected")
  debug_assert(css_read("bg=Data(9223372036854775808)") is Err(_), "Int64::max + 1 rejected")

  // Ordinary 8-level nesting succeeds
  let mut color8 = "Fg"
  let mut radius8 = "Lg"
  let mut k = 0
  while k < 8 {
    color8 = "A(Over(" + color8 + ",Bg),O70)"
    radius8 = "InnerOr(" + radius8 + ")"
    k += 1
  }
  debug_assert(css_read("bg=" + color8 + " radius=" + radius8) is Ok(_), "8-level nesting succeeds")

  // 70-level nesting safely returns Err("... nesting too deep ...")
  let mut deep_rad = "Lg"
  let mut deep_col = "Fg"
  let mut d = 0
  while d < 70 {
    deep_rad = "InnerOr(" + deep_rad + ")"
    deep_col = "A(" + deep_col + ",O50)"
    d += 1
  }
  match css_read("radius=" + deep_rad) {
    Err(e) => debug_assert(str_contains(e, "nesting too deep"), "deep radius nesting error: " + e)
    Ok(_) => debug_assert(false, "expected Err for 70-level radius nesting")
  }
  match css_read("bg=" + deep_col) {
    Err(e) => debug_assert(str_contains(e, "nesting too deep"), "deep color nesting error: " + e)
    Ok(_) => debug_assert(false, "expected Err for 70-level color nesting")
  }
}

test "p0-2a: secondary dark window callbacks and offscreen tree retain owner theme from light main window" {
  let _ = windows_reset()
  let w0 = Tester::tree(fn(_ : view::View) { () }, w=1000.0, h=600.0)
  set_tree_theme(fn() { Theme::light() })
  set_narrow_enabled(false)

  let revision = signals::signal(0)
  let observed = signals::ref_new(0)
  let stop = signals::ref_new(fn() -> Unit { () })
  let st = text_style(
    w=Len::Full,
    weight=Weight::Normal,
    tabular=false,
    narrow=text_patch(w=Len::Cut),
    dark=text_patch(
      w=Len::Cut,
      weight=Weight::Bold,
      color=Color::Accent,
      center=true,
      tabular=true,
    ),
  )

  let trees : Array[view::Tree] = []
  in_window(202, fn() {
    set_tree_theme(fn() { Theme::dark() })
    set_narrow_enabled(true)
    stop.v = signals::effect(fn() {
      let _ = revision.get()
      let mut bits = 0
      if style_words(st).weight == 700 { bits += 1 }
      if style_ink(st) == Theme::dark().accent { bits += 2 }
      if p0_2a_bool_eq(style_tabular(st), true) { bits += 4 }
      if style_cut(st) { bits += 8 }
      if !style_fills(st) { bits += 16 }
      if style_centered(st) { bits += 32 }
      observed.v = bits
    })
    let off_st = text_style(
      w=Len::Full,
      weight=Weight::Normal,
      narrow=text_patch(w=Len::Cut),
      dark=text_patch(weight=Weight::Bold),
    )
    let tree = view::Tree::new(
      fn(root : view::View) {
        let _ = root.words(view::Live::By(fn() {
          let lk = style_words(off_st)
          let cut = style_cut(off_st)
          "\{lk.weight}/\{cut}"
        }))
      },
      measure=host_words_measure,
      measure_runs=host_runs_measure,
      measure_runs_least=host_runs_least_measure,
    )
    trees.push(tree)
  })

  // Retained effect in secondary dark window keeps dark theme when triggered from light main window
  debug_assert(observed.v == 63, "initial dark owner mask == 63")
  revision.set(1)
  debug_assert(observed.v == 63, "re-triggered dark owner mask == 63")

  // Offscreen tree created in secondary dark narrow-enabled window keeps both theme and narrow policy
  let off = trees[0]
  let _ = encode_tree_scene(off, 400.0, 200.0, 1.0, 10.0)
  let mut small = ""
  for d in off.drawn() {
    if d.words != "" {
      small = d.words
    }
  }
  let _ = encode_tree_scene(off, 900.0, 200.0, 1.0, 20.0)
  let mut wide = ""
  for d in off.drawn() {
    if d.words != "" {
      wide = d.words
    }
  }
  debug_assert(small == "700/true" && wide == "700/false", "offscreen 400/900: \{small} then \{wide}")

  // Layout-time helpers (style_cut/style_fills/style_tabular/style_centered) sample theme untracked
  let dark_sig = signals::signal(false)
  set_tree_theme(fn() { if dark_sig.get() { Theme::dark() } else { Theme::light() } })
  let layout_runs = signals::ref_new(0)
  let stop_layout = signals::effect(fn() {
    let _ = style_cut(st)
    let _ = style_fills(st)
    let _ = style_tabular(st)
    let _ = style_centered(st)
    layout_runs.v = layout_runs.v + 1
  })
  debug_assert(layout_runs.v == 1, "layout effect runs once initially")
  dark_sig.set(true)
  debug_assert(layout_runs.v == 1, "theme change must not re-trigger untracked layout helpers")

  stop_layout()
  (stop.v)()
  off.dispose()
  clear_tree_theme()
  w0.dispose()
  let _ = windows_reset()
}
