// Automated WAI-ARIA APG interaction pattern contract gates on `Tester`.
// Verifies roles, accessible naming, required states, single Tab stop for composite controls,
// real keyboard driving (arrows with RTL, Home/End, Space/Enter), modal containment, and focus safety.

import "view"

/// Standard WAI-ARIA Authoring Practices Guide (APG) interaction patterns checked by `Tester::pattern_faults`.
#derive(Eq)
pub enum AriaPattern {
  Tabs
  Menu
  Dialog
  AlertDialog
  Listbox
  RadioGroup
  Accordion
  Disclosure
  Combobox
  Slider
  Switch
  Checkbox
  Toolbar
}

fn pattern_name(p : AriaPattern) -> String {
  match p {
    Tabs => "Tabs"
    Menu => "Menu"
    Dialog => "Dialog"
    AlertDialog => "AlertDialog"
    Listbox => "Listbox"
    RadioGroup => "RadioGroup"
    Accordion => "Accordion"
    Disclosure => "Disclosure"
    Combobox => "Combobox"
    Slider => "Slider"
    Switch => "Switch"
    Checkbox => "Checkbox"
    Toolbar => "Toolbar"
  }
}

fn opt_bool_eq(a : Option[Bool], b : Option[Bool]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_check_eq(a : Option[view::Check], b : Option[view::Check]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn said_name_of(tree : view::Tree, sn : view::SaidNode) -> String {
  match sn.said {
    Some(sd) => if sd.label.length() > 0 { sd.label } else { tree.said_label(sn.id) }
    None => tree.said_label(sn.id)
  }
}

fn check_label(tree : view::Tree, sn : view::SaidNode, pat : String, what : String, faults : Array[String]) -> Unit {
  if said_name_of(tree, sn).length() == 0 {
    faults.push("pattern(\{pat}): \{what} node#\{sn.id.at} missing accessible label")
  }
}

fn find_visible_role(order : Array[view::SaidNode], role : view::Role) -> Array[view::SaidNode] {
  let out : Array[view::SaidNode] = []
  for sn in order {
    if sn.hidden {
      continue
    }
    match sn.said {
      Some(sd) => if sd.role == role { out.push(sn) }
      None => ()
    }
  }
  out
}

fn find_visible_descendants(
  tree : view::Tree,
  order : Array[view::SaidNode],
  container : view::NodeId,
  matches : (view::Role) -> Bool,
) -> Array[view::SaidNode] {
  let out : Array[view::SaidNode] = []
  for sn in order {
    if sn.hidden || sn.id == container {
      continue
    }
    if !tree.holds_in_order(container, sn.id) {
      continue
    }
    match sn.said {
      Some(sd) => if matches(sd.role) { out.push(sn) }
      None => ()
    }
  }
  out
}

fn live_enabled_nodes(items : Array[view::SaidNode]) -> Array[view::SaidNode] {
  let out : Array[view::SaidNode] = []
  for sn in items {
    if !sn.hidden && !sn.disabled && sn.allowed {
      out.push(sn)
    }
  }
  out
}

fn focus_order_contains(order : Array[view::FocusAt], id : view::NodeId) -> Bool {
  for f in order {
    if f.id == id {
      return true
    }
  }
  false
}

fn check_focus_valid(tree : view::Tree, pat : String, step : String, faults : Array[String]) -> Unit {
  let (foc, _) = tree.focused_now()
  match foc {
    Some(fid) => {
      if !tree.allows(fid) {
        faults.push("pattern(\{pat}): focus landed on disallowed node#\{fid.at} after \{step}")
        return
      }
      for sn in tree.said_order() {
        if sn.id == fid {
          if sn.hidden {
            faults.push("pattern(\{pat}): focus landed on hidden node#\{fid.at} after \{step}")
          }
          if sn.disabled {
            faults.push("pattern(\{pat}): focus landed on disabled node#\{fid.at} after \{step}")
          }
          return
        }
      }
    }
    None => ()
  }
}

fn check_single_tab_stop(
  tree : view::Tree,
  pat : String,
  live : Array[view::SaidNode],
  faults : Array[String],
) -> Unit {
  if live.length() == 0 {
    return
  }
  let fo = tree.focus_order()
  let mut stops = 0
  for sn in live {
    if focus_order_contains(fo, sn.id) {
      stops += 1
    }
  }
  if stops == 0 {
    faults.push("pattern(\{pat}): composite control has 0 Tab stops among \{live.length()} enabled items (expected 1)")
  } else if stops > 1 {
    faults.push("pattern(\{pat}): composite control has \{stops} Tab stops (expected single roving Tab stop)")
  }
}

fn drive_composite_keys(
  t : Tester,
  tree : view::Tree,
  pat : String,
  live : Array[view::SaidNode],
  horizontal : Bool,
  rtl : Bool,
  faults : Array[String],
) -> Unit {
  let n = live.length()
  if n < 2 {
    return
  }
  let first = live[0].id
  let second = live[1].id
  let last = live[n - 1].id
  let ok_focus = tree.focus_to(Some(first), visible=true)
  t.frame()
  if !ok_focus {
    faults.push("pattern(\{pat}): first live item node#\{first.at} could not receive focus")
    return
  }
  check_focus_valid(tree, pat, "initial focus", faults)
  let next_key = if horizontal {
    if rtl { key_code_left } else { key_code_right }
  } else {
    key_code_down
  }
  let prev_key = if horizontal {
    if rtl { key_code_right } else { key_code_left }
  } else {
    key_code_up
  }
  t.key(next_key)
  check_focus_valid(tree, pat, "next arrow", faults)
  let (after_next, _) = tree.focused_now()
  match after_next {
    Some(id) =>
      if id != second {
        faults.push("pattern(\{pat}): next arrow did not move focus from node#\{first.at} to node#\{second.at} (got node#\{id.at})")
      }
    None => faults.push("pattern(\{pat}): next arrow dropped focus")
  }
  t.key(key_code_end)
  check_focus_valid(tree, pat, "End", faults)
  let (after_end, _) = tree.focused_now()
  match after_end {
    Some(id) =>
      if id != last {
        faults.push("pattern(\{pat}): End key did not move focus to last item node#\{last.at} (got node#\{id.at})")
      }
    None => faults.push("pattern(\{pat}): End key dropped focus")
  }
  t.key(key_code_home)
  check_focus_valid(tree, pat, "Home", faults)
  let (after_home, _) = tree.focused_now()
  match after_home {
    Some(id) =>
      if id != first {
        faults.push("pattern(\{pat}): Home key did not move focus to first item node#\{first.at} (got node#\{id.at})")
      }
    None => faults.push("pattern(\{pat}): Home key dropped focus")
  }
  t.key(prev_key)
  check_focus_valid(tree, pat, "prev arrow", faults)
}

/// Run the WAI-ARIA APG contract checks for `pattern` on the current `Tester` tree.
/// Returns a list of human-readable fault descriptions (empty when compliant).
pub fn Tester::pattern_faults(self : Tester, pattern : AriaPattern, rtl~ : Bool = false) -> Array[String] {
  let tree = match view_tree() {
    Some(tr) => tr
    None => return ["pattern(\{pattern_name(pattern)}): no active tree"]
  }
  let pat = pattern_name(pattern)
  let faults : Array[String] = []
  let order = tree.said_order()
  check_focus_valid(tree, pat, "initial state", faults)

  match pattern {
    Tabs => {
      let lists = find_visible_role(order, view::Role::TabList)
      if lists.length() == 0 {
        faults.push("pattern(Tabs): missing visible TabList role")
        return faults
      }
      let tl = lists[0]
      check_label(tree, tl, pat, "TabList", faults)
      let tabs = find_visible_descendants(tree, order, tl.id, fn(r : view::Role) -> Bool { r == view::Role::Tab })
      if tabs.length() == 0 {
        faults.push("pattern(Tabs): TabList has no visible Tab children")
        return faults
      }
      let mut any_selected = false
      for tab in tabs {
        check_label(tree, tab, pat, "Tab", faults)
        match tab.said {
          Some(sd) =>
            match sd.selected {
              Some(true) => any_selected = true
              Some(false) => ()
              None => faults.push("pattern(Tabs): Tab node#\{tab.id.at} missing selected state")
            }
          None => ()
        }
      }
      if !any_selected {
        faults.push("pattern(Tabs): no Tab has selected=true")
      }
      let live = live_enabled_nodes(tabs)
      check_single_tab_stop(tree, pat, live, faults)
      drive_composite_keys(self, tree, pat, live, true, rtl, faults)
    }

    Menu => {
      let menus = find_visible_role(order, view::Role::Menu)
      if menus.length() == 0 {
        faults.push("pattern(Menu): missing visible Menu role")
        return faults
      }
      let m = menus[0]
      check_label(tree, m, pat, "Menu", faults)
      let items = find_visible_descendants(tree, order, m.id, fn(r : view::Role) -> Bool {
        r == view::Role::MenuItem || r == view::Role::MenuItemCheckbox || r == view::Role::MenuItemRadio
      })
      if items.length() == 0 {
        faults.push("pattern(Menu): Menu has no visible MenuItem children")
        return faults
      }
      for it in items {
        check_label(tree, it, pat, "MenuItem", faults)
        match it.said {
          Some(sd) =>
            if (sd.role == view::Role::MenuItemCheckbox || sd.role == view::Role::MenuItemRadio) && sd.check.is_none() {
              faults.push("pattern(Menu): checkable menu item node#\{it.id.at} missing check state")
            }
          None => ()
        }
      }
      let live = live_enabled_nodes(items)
      drive_composite_keys(self, tree, pat, live, false, rtl, faults)
    }

    Dialog => {
      let dlgs = find_visible_role(order, view::Role::Dialog)
      if dlgs.length() == 0 {
        faults.push("pattern(Dialog): missing visible Dialog role")
        return faults
      }
      let dlg = dlgs[0]
      check_label(tree, dlg, pat, "Dialog", faults)
      // If modal is active, ensure focus_order stays contained inside the dialog.
      match tree.modal_top() {
        Some(m) => {
          if m == dlg.id || tree.holds_in_order(m, dlg.id) {
            for f in tree.focus_order() {
              if f.id != dlg.id && !tree.holds_in_order(dlg.id, f.id) {
                faults.push("pattern(Dialog): focusable node#\{f.id.at} escaped modal Dialog")
              }
            }
          }
        }
        None => ()
      }
      self.key(key_tab)
      check_focus_valid(tree, pat, "Tab", faults)
    }

    AlertDialog => {
      let dlgs = find_visible_role(order, view::Role::AlertDialog)
      if dlgs.length() == 0 {
        faults.push("pattern(AlertDialog): missing visible AlertDialog role")
        return faults
      }
      let dlg = dlgs[0]
      check_label(tree, dlg, pat, "AlertDialog", faults)
      let modal_ok = match tree.modal_top() {
        Some(m) => m == dlg.id || tree.holds_in_order(m, dlg.id)
        None => false
      }
      if !modal_ok {
        faults.push("pattern(AlertDialog): AlertDialog node#\{dlg.id.at} missing active modal trap")
      }
      for f in tree.focus_order() {
        if f.id != dlg.id && !tree.holds_in_order(dlg.id, f.id) {
          faults.push("pattern(AlertDialog): focus escaped outside AlertDialog to node#\{f.id.at}")
        }
      }
      self.key(key_tab)
      check_focus_valid(tree, pat, "Tab", faults)
      let (foc, _) = tree.focused_now()
      match foc {
        Some(fid) =>
          if fid != dlg.id && !tree.holds_in_order(dlg.id, fid) {
            faults.push("pattern(AlertDialog): Tab moved focus outside AlertDialog to node#\{fid.at}")
          }
        None => ()
      }
    }

    Listbox => {
      let lbs = find_visible_role(order, view::Role::Listbox)
      if lbs.length() == 0 {
        faults.push("pattern(Listbox): missing visible Listbox role")
        return faults
      }
      let lb = lbs[0]
      check_label(tree, lb, pat, "Listbox", faults)
      let opts = find_visible_descendants(tree, order, lb.id, fn(r : view::Role) -> Bool { r == view::Role::Option })
      if opts.length() == 0 {
        faults.push("pattern(Listbox): Listbox has no visible Option children")
        return faults
      }
      for opt in opts {
        check_label(tree, opt, pat, "Option", faults)
        match opt.said {
          Some(sd) =>
            if sd.selected.is_none() {
              faults.push("pattern(Listbox): Option node#\{opt.id.at} missing selected state")
            }
          None => ()
        }
      }
      let live = live_enabled_nodes(opts)
      check_single_tab_stop(tree, pat, live, faults)
      drive_composite_keys(self, tree, pat, live, false, rtl, faults)
    }

    RadioGroup => {
      let rgs = find_visible_role(order, view::Role::RadioGroup)
      if rgs.length() == 0 {
        faults.push("pattern(RadioGroup): missing visible RadioGroup role")
        return faults
      }
      let rg = rgs[0]
      check_label(tree, rg, pat, "RadioGroup", faults)
      let radios = find_visible_descendants(tree, order, rg.id, fn(r : view::Role) -> Bool { r == view::Role::Radio })
      if radios.length() == 0 {
        faults.push("pattern(RadioGroup): RadioGroup has no visible Radio children")
        return faults
      }
      for r in radios {
        check_label(tree, r, pat, "Radio", faults)
        match r.said {
          Some(sd) =>
            if sd.check.is_none() && sd.selected.is_none() {
              faults.push("pattern(RadioGroup): Radio node#\{r.id.at} missing check/selected state")
            }
          None => ()
        }
      }
      let live = live_enabled_nodes(radios)
      check_single_tab_stop(tree, pat, live, faults)
      drive_composite_keys(self, tree, pat, live, true, rtl, faults)
    }

    Accordion => {
      let triggers : Array[view::SaidNode] = []
      for sn in order {
        if sn.hidden {
          continue
        }
        match sn.said {
          Some(sd) => if sd.role == view::Role::Button && sd.expanded.is_some() { triggers.push(sn) }
          None => ()
        }
      }
      if triggers.length() == 0 {
        faults.push("pattern(Accordion): missing visible Button triggers with expanded state")
        return faults
      }
      for tr in triggers {
        check_label(tree, tr, pat, "Accordion trigger", faults)
      }
      let live = live_enabled_nodes(triggers)
      drive_composite_keys(self, tree, pat, live, false, rtl, faults)
    }

    Disclosure => {
      let btns = find_visible_role(order, view::Role::Button)
      if btns.length() == 0 {
        faults.push("pattern(Disclosure): missing visible Button role")
        return faults
      }
      let mut found : Option[view::SaidNode] = None
      for b in btns {
        match b.said {
          Some(sd) =>
            if sd.expanded.is_some() {
              found = Some(b)
              break
            }
          None => ()
        }
      }
      let disc = match found {
        Some(b) => b
        None => {
          faults.push("pattern(Disclosure): Button node#\{btns[0].id.at} missing expanded state")
          return faults
        }
      }
      check_label(tree, disc, pat, "Disclosure", faults)
      if !disc.disabled && disc.allowed {
        let before = match tree.said_of(disc.id) {
          Some(sd) => sd.expanded
          None => None
        }
        let _ = tree.focus_to(Some(disc.id), visible=true)
        self.frame()
        self.key(key_space)
        check_focus_valid(tree, pat, "Space", faults)
        let after = match tree.said_of(disc.id) {
          Some(sd) => sd.expanded
          None => None
        }
        if opt_bool_eq(before, after) {
          faults.push("pattern(Disclosure): Space did not toggle expanded state on node#\{disc.id.at}")
        }
      }
    }

    Combobox => {
      let cbs = find_visible_role(order, view::Role::Combobox)
      if cbs.length() == 0 {
        faults.push("pattern(Combobox): missing visible Combobox role")
        return faults
      }
      let cb = cbs[0]
      check_label(tree, cb, pat, "Combobox", faults)
      let exp = match cb.said {
        Some(sd) => sd.expanded
        None => None
      }
      if exp.is_none() {
        faults.push("pattern(Combobox): Combobox node#\{cb.id.at} missing expanded state")
      }
      if opt_bool_eq(exp, Some(true)) {
        let opts = find_visible_role(order, view::Role::Option)
        for opt in opts {
          check_label(tree, opt, pat, "Combobox Option", faults)
        }
        if opts.length() >= 2 {
          self.key(key_code_down)
          check_focus_valid(tree, pat, "Down", faults)
        }
      }
    }

    Slider => {
      let sliders = find_visible_role(order, view::Role::Slider)
      if sliders.length() == 0 {
        faults.push("pattern(Slider): missing visible Slider role")
        return faults
      }
      let sl = sliders[0]
      check_label(tree, sl, pat, "Slider", faults)
      let init_range = match sl.said {
        Some(sd) => sd.range
        None => None
      }
      let (lo, v0, hi) = match init_range {
        Some(r) => r
        None => {
          faults.push("pattern(Slider): Slider node#\{sl.id.at} missing range state")
          return faults
        }
      }
      if lo > hi || v0 < lo || v0 > hi {
        faults.push("pattern(Slider): Slider node#\{sl.id.at} range (\{lo}, \{v0}, \{hi}) is out of bounds")
      }
      if !sl.disabled && sl.allowed && hi > lo {
        let _ = tree.focus_to(Some(sl.id), visible=true)
        self.frame()
        let inc_key = if rtl { key_code_left } else { key_code_right }
        let dec_key = if rtl { key_code_right } else { key_code_left }
        if v0 < hi {
          self.key(inc_key)
          check_focus_valid(tree, pat, "increment arrow", faults)
          match tree.said_of(sl.id) {
            Some(sd) =>
              match sd.range {
                Some((_, v1, _)) =>
                  if v1 <= v0 {
                    faults.push("pattern(Slider): increment arrow did not increase value (\{v0} -> \{v1})")
                  }
                None => faults.push("pattern(Slider): range disappeared after increment arrow")
              }
            None => ()
          }
        } else {
          self.key(dec_key)
          check_focus_valid(tree, pat, "decrement arrow", faults)
          match tree.said_of(sl.id) {
            Some(sd) =>
              match sd.range {
                Some((_, v1, _)) =>
                  if v1 >= v0 {
                    faults.push("pattern(Slider): decrement arrow did not decrease value (\{v0} -> \{v1})")
                  }
                None => faults.push("pattern(Slider): range disappeared after decrement arrow")
              }
            None => ()
          }
        }
        self.key(key_code_end)
        check_focus_valid(tree, pat, "End", faults)
        match tree.said_of(sl.id) {
          Some(sd) =>
            match sd.range {
              Some((_, ve, _)) =>
                if (ve - hi).abs() > 0.001 {
                  faults.push("pattern(Slider): End key did not jump to max \{hi} (got \{ve})")
                }
              None => ()
            }
          None => ()
        }
        self.key(key_code_home)
        check_focus_valid(tree, pat, "Home", faults)
        match tree.said_of(sl.id) {
          Some(sd) =>
            match sd.range {
              Some((_, vh, _)) =>
                if (vh - lo).abs() > 0.001 {
                  faults.push("pattern(Slider): Home key did not jump to min \{lo} (got \{vh})")
                }
              None => ()
            }
          None => ()
        }
      }
    }

    Switch => {
      let sws = find_visible_role(order, view::Role::Switch)
      if sws.length() == 0 {
        faults.push("pattern(Switch): missing visible Switch role")
        return faults
      }
      let sw = sws[0]
      check_label(tree, sw, pat, "Switch", faults)
      let before = match sw.said {
        Some(sd) => sd.check
        None => None
      }
      if before.is_none() {
        faults.push("pattern(Switch): Switch node#\{sw.id.at} missing check state")
        return faults
      }
      if !sw.disabled && sw.allowed {
        let _ = tree.focus_to(Some(sw.id), visible=true)
        self.frame()
        self.key(key_space)
        check_focus_valid(tree, pat, "Space", faults)
        let after = match tree.said_of(sw.id) {
          Some(sd) => sd.check
          None => None
        }
        if opt_check_eq(before, after) {
          faults.push("pattern(Switch): Space did not toggle Switch state on node#\{sw.id.at}")
        }
      }
    }

    Checkbox => {
      let cbs = find_visible_role(order, view::Role::Checkbox)
      if cbs.length() == 0 {
        faults.push("pattern(Checkbox): missing visible Checkbox role")
        return faults
      }
      let cb = cbs[0]
      check_label(tree, cb, pat, "Checkbox", faults)
      let before = match cb.said {
        Some(sd) => sd.check
        None => None
      }
      if before.is_none() {
        faults.push("pattern(Checkbox): Checkbox node#\{cb.id.at} missing check state")
        return faults
      }
      if !cb.disabled && cb.allowed {
        let _ = tree.focus_to(Some(cb.id), visible=true)
        self.frame()
        self.key(key_space)
        check_focus_valid(tree, pat, "Space", faults)
        let after = match tree.said_of(cb.id) {
          Some(sd) => sd.check
          None => None
        }
        if opt_check_eq(before, after) {
          faults.push("pattern(Checkbox): Space did not toggle Checkbox state on node#\{cb.id.at}")
        }
      }
    }

    Toolbar => {
      let tbs = find_visible_role(order, view::Role::Toolbar)
      if tbs.length() == 0 {
        faults.push("pattern(Toolbar): missing visible Toolbar role")
        return faults
      }
      let tb = tbs[0]
      check_label(tree, tb, pat, "Toolbar", faults)
      let items = find_visible_descendants(tree, order, tb.id, fn(r : view::Role) -> Bool {
        r == view::Role::Button ||
          r == view::Role::Checkbox ||
          r == view::Role::Switch ||
          r == view::Role::Radio ||
          r == view::Role::Link
      })
      if items.length() == 0 {
        faults.push("pattern(Toolbar): Toolbar has no visible interactive children")
        return faults
      }
      for it in items {
        check_label(tree, it, pat, "Toolbar item", faults)
      }
      let live = live_enabled_nodes(items)
      check_single_tab_stop(tree, pat, live, faults)
      drive_composite_keys(self, tree, pat, live, true, rtl, faults)
    }
  }
  faults
}

/// Assert that the current `Tester` tree satisfies the WAI-ARIA APG contract for `pattern`.
pub fn Tester::assert_pattern(
  self : Tester,
  pattern : AriaPattern,
  rtl~ : Bool = false,
  label~ : String = "",
) -> Unit {
  assert_fault_list("pattern_faults", self.pattern_faults(pattern, rtl=rtl), label)
}
