// INVAR-EXT: Compatibility alias delegating to upstream tester_pattern.pion.

/// Returns pattern audit faults for `pattern`, delegating to `Tester::check_pattern`.
pub fn Tester::pattern_faults(self : Tester, pattern : AriaPattern, rtl~ : Bool = false) -> Array[String] {
  self.check_pattern(pattern, rtl=rtl)
}
