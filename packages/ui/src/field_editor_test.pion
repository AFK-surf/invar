// End-to-end integration tests for `ui::Field` backed by upstream `EditorState`:
// multi-line wrapping + Up/Down preferred_x, CJK + Emoji ZWJ deletion without UTF-8 corruption,
// Blink 1000ms undo coalescing, IME compose/commit/undo, multi-line selection highlight rects,
// touch selection handle dragging, optical loupe / View::magnifies, and focused multi-line caret y.

import "view"

test "field_editor 01: multiline wrap, Up/Down preferred_x, and real measure_text_width" {
  let fld = Field::new(text="Hello world\nHi\nLonger third line")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(95.0)))
      let _ = field(b, fld, max_lines=6, font_size=15.0, line=22.0, label="Notes")
    })
  })
  fld.focus()
  fld.pick(5, 5)
  t.frame(ms=16.0)
  let line_count = match fld.st.tl {
    Some(tl) => tl.line_start.length()
    None => 0
  }
  debug_assert(line_count >= 4, "95pt wrap breaks multi-paragraph text into >= 4 lines, got \{line_count}")
  t.key(key_code_down)
  let pref1 = fld.st.pref_x
  debug_assert(pref1 > 0.0, "preferred_x captured on first move_down")
  t.key(key_code_down)
  debug_assert((fld.st.pref_x - pref1).abs() < 1.0e-6, "preferred_x preserved across short line")
  t.key(key_code_up)
  debug_assert((fld.st.pref_x - pref1).abs() < 1.0e-6, "preferred_x preserved on move_up")
  t.dispose()
}

test "field_editor 02: CJK + Emoji ZWJ grapheme deletion never corrupts UTF-8" {
  let family = "\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA9\xE2\x80\x8D\xF0\x9F\x91\xA7"
  let fld = Field::new(text="Hi你好" + family)
  let t = Tester::tree(fn(root : view::View) {
    let _ = field(root, fld, max_lines=3, label="Chat")
  })
  fld.focus()
  let end_pos = mbt_compat::utf16_len(fld.text())
  fld.pick(end_pos, end_pos)
  t.frame(ms=16.0)
  t.backspace()
  debug_assert(fld.text() == "Hi你好", "single backspace deleted whole 18-byte ZWJ family emoji")
  t.backspace()
  debug_assert(fld.text() == "Hi你", "second backspace deleted whole 3-byte CJK char")
  t.key(key_of_char('z'), mods=mod_cmd)
  debug_assert(fld.text() == "Hi你好" + family, "coalesced backspaces restored in one undo step")
  debug_assert(fld.st.undos.length() == 0, "undo stack drained after single coalesced undo")
  t.dispose()
}

test "field_editor 03: Blink 1000ms undo coalescing driven by work_clock_now" {
  let fld = Field::new()
  let t = Tester::tree(fn(root : view::View) {
    let _ = field(root, fld, max_lines=3, label="Draft")
  })
  fld.focus()
  t.frame(ms=16.0)
  // Fast burst within 1000ms coalesces into 1 undo step
  t.type_text("h")
  t.frame(ms=100.0)
  t.type_text("i")
  t.frame(ms=100.0)
  t.type_text("!")
  debug_assert(fld.st.undos.length() == 1, "fast typing burst coalesced into 1 undo step, got \{fld.st.undos.length()}")
  // Pause > 1000ms starts a fresh undo step
  t.frame(ms=1200.0)
  t.type_text("ok")
  debug_assert(fld.st.undos.length() == 2, "typing after >1000ms pause starts step 2, got \{fld.st.undos.length()}")
  debug_assert(fld.text() == "hi!ok", "typed both bursts")
  t.key(key_of_char('z'), mods=mod_cmd)
  debug_assert(fld.text() == "hi!", "undo reverted only post-pause burst")
  t.key(key_of_char('z'), mods=mod_cmd)
  debug_assert(fld.text() == "", "undo reverted first burst cleanly")
  debug_assert(fld.st.undos.length() == 0, "undo stack empty after reverting both bursts")
  t.dispose()
}

test "field_editor 04: IME compose, live display_text, atomic commit, and undo" {
  let fld = Field::new(text="say ")
  let t = Tester::tree(fn(root : view::View) {
    let _ = field(root, fld, max_lines=3, label="IME")
  })
  fld.focus()
  t.frame(ms=16.0)
  view_text(1, "nihao")
  debug_assert(fld.composing(), "composing active")
  debug_assert(fld.st.marked == "nihao", "marked text holds live IME composition")
  view_text(0, "你好")
  debug_assert(!fld.composing(), "commit clears composing")
  debug_assert(fld.text() == "say 你好", "committed CJK text")
  t.key(key_of_char('z'), mods=mod_cmd)
  debug_assert(fld.text() == "say ", "IME commit undone atomically in 1 step")
  debug_assert(!fld.composing(), "undo keeps composing cleared")
  t.dispose()
}

test "field_editor 05: multi-line selection highlight rects, handle crossover flip, and loupe geometry" {
  let fld = Field::new(text="one two\nthree four")
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(300.0)))
        let _ = field(b, fld, max_lines=4, font_size=15.0, line=22.0, label="Body")
      })
    },
    platform=4,
  )
  fld.focus()
  // Cross-line selection from "two" (4) to "three" (13) -> 2 selection highlight bands rendered
  fld.pick(4, 13)
  fld.st.sel_handles = true
  t.frame(ms=16.0)
  let (a, b) = fld.selection()
  debug_assert(a == 4 && b == 13, "cross-line selection range preserved")
  let sc = t.scene()
  let mut sel_rects = 0
  let mut i = 0
  while i < sc.ninst {
    let base = i * inst_size
    let kind = (sc.inst[base + 5] + 0.5).to_int()
    let alpha = sc.inst[base + 11]
    if kind == 0 && alpha > 0.05 && alpha < 0.8 && sc.inst[base + 3] >= 10.0 && sc.inst[base + 2] >= 6.0 {
      sel_rects = sel_rects + 1
    }
    i += 1
  }
  debug_assert(sel_rects >= 2, "cross-line selection emits >= 2 highlight rects, got \{sel_rects}")
  // Touch selection handles positioned on both ends of selection
  debug_assert(fld.st.sel_ay > 0.0 && fld.st.sel_by > fld.st.sel_ay, "start/end handles sit on distinct lines")
  debug_assert(fld.st.sel_ax > 0.0 && fld.st.sel_bx > 0.0, "both selection handles have valid x positions")
  // Dragging start handle past end handle swaps selection cleanly (crossover)
  let start_x = fld.st.sel_ax
  let start_y = fld.st.sel_ay
  let end_y = fld.st.sel_by
  t.drag(start_x, start_y, start_x + 120.0, end_y)
  t.frame(ms=16.0)
  let (a2, b2) = fld.selection()
  debug_assert(a2 >= 0 && b2 >= 0 && a2 <= fld.text().length() && b2 <= fld.text().length(), "selection stays within text bounds after handle drag")
  // Single-line selection end handle sits right of start handle
  fld.pick(4, 7)
  fld.st.sel_handles = true
  t.frame(ms=16.0)
  debug_assert(fld.st.sel_bx > fld.st.sel_ax, "end handle sits right of start handle on same line")
  debug_assert((fld.st.sel_by - fld.st.sel_ay).abs() < 1.0, "same-line handles share y")
  t.dispose()
}

test "field_editor 06: View::magnifies copies & scales instances around (sx, sy) into loupe capsule" {
  let fld = Field::new(text="Line 1\nLine 2\nLine 3 target")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(box_v : view::View) {
      let _ = box_v
      .over_at(view::Live::Is((Some(40.0), Some(100.0), None, None)))
      .width(view::Live::Is(Some(300.0)))
      let _ = field(box_v, fld, max_lines=5, font_size=15.0, line=24.0, label="MagField")
    })
    let _ = root.box(fn(loupe : view::View) {
      let _ = loupe
      .over_at(view::Live::Is((Some(100.0), Some(20.0), None, None)))
      .width(view::Live::Is(Some(120.0)))
      .height(view::Live::Is(Some(48.0)))
      .radius(view::Live::Is(24.0))
      .ground(view::Live::Is(rgba(255, 255, 255, 255)))
      .magnifies(view::Live::Is(Some((80.0, 120.0, 1.4))))
    })
  })
  t.resize(480.0, 320.0)
  fld.focus()
  fld.pick(14, fld.text().length())
  t.frame(ms=16.0)
  let sc = t.scene()
  debug_assert(sc.ninst > 0, "multi-line field emitted scene instances")
  // Verify at least one magnified instance was projected into the loupe capsule bounds [100..220, 20..68]
  let mut in_loupe = 0
  let mut i = 0
  while i < sc.ninst {
    let base = i * inst_size
    let ix = sc.inst[base]
    let iy = sc.inst[base + 1]
    if ix >= 95.0 && ix <= 225.0 && iy >= 15.0 && iy <= 72.0 {
      in_loupe = in_loupe + 1
    }
    i += 1
  }
  debug_assert(in_loupe >= 1, "View::magnifies projected magnified instances into loupe capsule")
  t.dispose()
}

test "field_editor 07: focused multi-line caret renders at true line y > d.y + 15.0" {
  let fld = Field::new(text="First line\nSecond line\nThird line")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(box_v : view::View) {
      let _ = box_v
      .over_at(view::Live::Is((Some(20.0), Some(30.0), None, None)))
      .width(view::Live::Is(Some(320.0)))
      let _ = field(box_v, fld, max_lines=5, font_size=15.0, line=24.0, label="MultiCaret")
    })
  })
  t.resize(480.0, 320.0)
  fld.focus()
  fld.pick(fld.text().length(), fld.text().length())
  t.frame(ms=16.0)
  let sc = t.scene()
  let mut found_caret = false
  let mut i = 0
  while i < sc.ninst {
    let base = i * inst_size
    let kind = (sc.inst[base + 5] + 0.5).to_int()
    let iw = sc.inst[base + 2]
    let ih = sc.inst[base + 3]
    let iy = sc.inst[base + 1]
    if kind == 0 && iw > 0.5 && iw <= 4.0 && ih >= 14.0 && iy > 45.0 {
      found_caret = true
    }
    i += 1
  }
  debug_assert(sc.ninst > 0, "focused multi-line caret emitted scene instances")
  debug_assert(found_caret, "focused multi-line caret must render on line 3 at y > d.y + 15.0")
  t.dispose()
}
