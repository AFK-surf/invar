import "hostapi"
import "mbt_compat"

// What a real host gave the app between its frames, kept with them (MBUI_DRAW_LOG=1, frames.pion): each input as
// the host handed it (a pointer's, a wheel's, a key's, the input method's, the system's back, the app shown or
// hidden), with the host's own time for it, as an INPUT line between the DRAWHASH lines of the frames around it. A
// Tester's `replay_frames` hands each on again at its place, at its time: the run's whole input, seen again frame by
// frame.
//
//   INPUT {"k":"pointer","t":T,"a":[kind,x,y,button,mods]} (optional by, more=1 for batched moves; mods: keys held as it went down)
//   INPUT {"k":"pointer-flush","t":T,"a":[]} (unrouted finger ending a batched touch-move)
//   INPUT {"k":"wheel","t":T,"a":[x,y,dx,dy,phase]}   "key" [code,mods]
//   INPUT {"k":"text","t":T,"a":[kind,a,b],"s":TEXT}    "back" [kind,x,progress,edge]   "app" [state]

///|
fn draw_logging() -> Bool {
  if draw_log.v < 0 {
    { let __mbt_r = draw_log; __mbt_r.v = (if hostapi::env("MBUI_DRAW_LOG") == "1" { 1 } else { 0 }) }
  }
  draw_log.v == 1
}

///|
/// An input came between two frames (any of the host's: a pointer's, a key's…): the next frame is the framework's to
/// draw, and the one after it, for what was changed by what read the input late in a frame (a list's rows are built
/// after the rest). Kept on the log when it is (MBUI_DRAW_LOG).
// moved to 00_init_order.pion: inputs_since

///|
/// The moment a pointer last went down or was let go, since the last frame (pointer_in; -1 none): a press at that same
/// moment draws no frame early (frame_at_press), so what the two do is taken together by the frame that comes, as at
/// one moment it must be.
// kept across runs: set by a press or a let-go, put back as each frame begins
// moved to 00_init_order.pion: press_moment

///|
/// An input came between two frames that what is built takes (a press, a key, words typed, a drag, a wheel): the
/// frame after the next is built, for what it changed late in it that is no signal yet (what the build itself keeps of
/// a press: a menu shut). Not a pointer moved with nothing down: what changes of where it is, what
/// reads it reads (hand.pion).
// moved to 00_init_order.pion: inputs_taken

///|
/// `typed`: an input that goes into the field with the focus (words typed, a key of the field's own), the part of the
/// old view it is in (typed_part); -1, every old view's.
fn took_input(kind : String, t : Double, args : Array[Double], text? : String, typed? : Int) -> Unit {
  let typed = match typed { Some(__mbt_v) => __mbt_v, None => -1 }

  // (the event's own moment, taken once as it began: view_host.pion)
  let t = if view_app.v is Some(tr) && tr.moment() is Some(m) { m } else { t }
  input_came()
  // (a pointer moved, gone out of the window, a wheel turned: the hand on ui's own, what it is over; else the app's
  // to take, an event from outside: kept_part.pion)
  // (and the system's back gesture going on: where it is, Nav's `finger`, on_back)
  let moved = (kind == "pointer" && (args[0] == 1.0 || args[0] == 7.0)) || (kind == "back" && args[0] == 1.0)
  // (a wheel: what it turned says whether it is taken, on_wheel; a list's place a signal of its own)
  let wheel = kind == "wheel"
  if !moved && !wheel {
    inputs_taken.v = true
  }
  if !(moved || wheel) {
    // (a press is the hand's: what it changes is built again, and what is kept is built for it where it went (the hand's
    // events, frame_watch.pion; an old view's alone where it went to one: view_host.pion), not as from outside)
    // (and what is typed into a field of one old view: the hand's too, gone to that one, as a press is to what it is on)
    if kind == "pointer" || typed >= 0 {
      outside_counted()
    } else {
      outside_came()
    }
  }
  // (what is no pointer's goes to whatever old view takes it: all of them, but what is typed into a field, that field's
  // alone, view_host.pion)
  if kind != "pointer" {
    view_input_went(typed)
  }
  input_taped(kind, t, args, text?=text)
}

///|
/// An input written on the tape being made (taping), nothing else: one the old view takes none of (a press on the tree
/// made once, view_host.pion) is replayed all the same.
fn input_taped(kind : String, t : Double, args : Array[Double], text? : String) -> Unit {
  let t = if view_app.v is Some(tr) && tr.moment() is Some(m) { m } else { t }
  if taping() {
    let m : mbt_compat::OrderedMap[String, mbt_compat::MbtJson] = mbt_compat::ordered_map_from_array([("k", mbt_compat::MbtJson::string(kind)), ("t", mbt_compat::MbtJson::number(t)), ("a", mbt_compat::MbtJson::array(mbt_compat::arr_map(args, fn(x) { mbt_compat::MbtJson::number(x) })))])
    match text {
      Some(s) => m.set("s", mbt_compat::MbtJson::string(s))
      Option::None => ()
    }
    tape_line("INPUT " + mbt_compat::MbtJson::object(m).stringify())
  }
}

///|
/// One INPUT line handed on again (Tester::replay_frames), the fake host's clock at its time while it is.
fn replay_input(f : FakeHost, line : String) -> Unit {
  guard mbt_compat::str_find(line, "INPUT ") is Some(i) else { return }
  let j = match mbt_compat::mbt_json_parse(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=i + 6))) { Ok(__mbt_ok_21) => __mbt_ok_21, Err(_) => return }
  guard j is .Object(m) else { return }
  let a : Array[Double] = match m.get("a") {
    Option::Some(Array(xs)) =>
    mbt_compat::arr_map(xs, fn(x) {
      match x {
        .Number(d, _) => d
        _ => 0.0
      }
    })
    _ => []
  }
  let n = fn(k : Int) -> Double { if k < a.length() { a[k] } else { 0.0 } }
  let t = match m.get("t") {
    Option::Some(.Number(d, _)) => d
    _ => f.time
  }
  let frame_time = f.time
  f.time = t
  match m.get("k") {
    Option::Some(String("pointer")) => {
      let by = if a.length() > 5 { n(5).to_int() } else { -1 }
      // (a move with more of its batch after it: app.pion's pointer_event_now)
      let more = a.length() > 6 && n(6) == 1.0
      pointer_in(n(0).to_int(), n(1), n(2), n(3).to_int(), n(4).to_int(), by=by, more=more)
    }
    Option::Some(String("pointer-flush")) =>
    view_event_said(fn() { pointing_said_by_host(1) }, fn() {
      if moves_batched.v {
        moves_batched.v = false
        view_pointed(bring=true)
      }
    }, what="pointer-flush")
    Option::Some(String("wheel")) => on_wheel(n(0), n(1), n(2), n(3), n(4).to_int())
    Option::Some(String("key")) => on_key(n(0).to_int(), n(1).to_int())
    Option::Some(String("text")) => {
      let s = match m.get("s") {
        Option::Some(String(s)) => s
        _ => ""
      }
      on_text(n(0).to_int(), s, n(1).to_int(), n(2).to_int())
    }
    Option::Some(String("back")) => on_back(n(0).to_int(), n(1), n(2), n(3).to_int())
    Option::Some(String("app")) => on_app_state(n(0).to_int())
    _ => ()
  }
  f.time = frame_time
}
