import "hostapi"
import "mbt_compat"
import "signals"
import "view"

///|
/// The most a controller's state is told a second while it does not change (a stick held over): as a browser's page
/// reads them, once a display's frame at 60.
// moved to 00_init_order.pion: gamepad_ms

///|
/// How often the controllers are looked for while none is connected.
// moved to 00_init_order.pion: gamepads_looked_ms

///|
/// Whether a controller's state is to be told now: changed since the last told, or a stick or trigger held off rest
/// and gamepad_ms since.
fn gamepad_due(p : hostapi::Gamepad, was : Option[(hostapi::Gamepad, Double)], at : Double) -> Bool {
  match was {
    Option::None => true
    Some((told, _)) if told != p => true
    Some((_, told_at)) => {
      let held = p.lx != 0.0 || p.ly != 0.0 || p.rx != 0.0 || p.ry != 0.0 || p.lt != 0.0 || p.rt != 0.0
      held && at - told_at >= gamepad_ms
    }
  }
}

///|
/// The game controllers this device reads (@hostapi.gamepads), followed while `on` holds (read as it changes): each
/// told `then` by its slot as it changes, a stick or trigger held off rest again gamepad_ms apart, one gone told once
/// (None); looked at gamepad_ms apart while one is connected, gamepads_looked_ms apart while none is, on the node's
/// clock (not waited for: a test's run is idle across it). Nothing told as `on` stops holding: what was told is
/// forgotten, told again whole as it holds again.
pub fn gamepads_follow(v : view::View, on : () -> Bool, then : (Int, Option[hostapi::Gamepad]) -> Unit) -> Unit {
  let told : mbt_compat::OrderedMap[Int, (hostapi::Gamepad, Double)] = mbt_compat::ordered_map_new()
  let ticking : mbt_compat::Ref[Option[() -> Unit]] = mbt_compat::ref_new(None)
  let active = mbt_compat::ref_new(false)
  let running = mbt_compat::ref_new(false)
  let stop_tick = fn() {
    match ticking.v {
      Some(stop) => {
        ticking.v = None
        stop()
      }
      Option::None => ()
    }
  }
  let __mbt_cap_5_running = running; let __mbt_cap_5_then = then; let __mbt_cap_5_ticking = ticking; let __mbt_cap_5_told = told; let __mbt_cap_5_v = v; ()
  let sync = fn() {
    let want = active.v && signals::untracked(on)
    if want == running.v {
      return
    }
    running.v = want
    stop_tick()
    told.clear()
    if want {
      __mbt_local_gamepads_follow_look_5(__mbt_cap_5_running, __mbt_cap_5_then, __mbt_cap_5_ticking, __mbt_cap_5_told, __mbt_cap_5_v, v.cause_at())
    }
  }

  v.when_active(while_covered=true, fn() {
    active.v = true
    sync()
    fn() {
      active.v = false
      sync()
    }
  })
  |> ignore
  v.reacts(on, fn(_) { sync() })
}
fn __mbt_local_gamepads_follow_look_5(__mbt_cap_5_running : mbt_compat::Ref[Bool], __mbt_cap_5_then : (Int, Option[hostapi::Gamepad]) -> Unit, __mbt_cap_5_ticking : mbt_compat::Ref[Option[() -> Unit]], __mbt_cap_5_told : mbt_compat::OrderedMap[Int, (hostapi::Gamepad, Double)], __mbt_cap_5_v : view::View, at : Double) -> Unit {
  __mbt_cap_5_ticking.v = None
  if !__mbt_cap_5_running.v || !__mbt_cap_5_v.alive() {
    return
  }
  let now = if at > __mbt_cap_5_v.cause_at() { at } else { __mbt_cap_5_v.cause_at() }
  let pads = hostapi::gamepads()
  for p in pads {
    if gamepad_due(p, __mbt_cap_5_told.get(p.index), now) {
      __mbt_cap_5_told.set(p.index, (p, now))
      __mbt_cap_5_then(p.index, Some(p))
    }
  }
  for i in mbt_compat::ordered_map_keys_iter(__mbt_cap_5_told).to_array() {
    if !arr_any(pads, fn(p) { p.index == i }) {
      __mbt_cap_5_told.remove(i)
      __mbt_cap_5_then(i, Option::None)
    }
  }
  let next = now + (if pads.is_empty() { gamepads_looked_ms } else { gamepad_ms })
  __mbt_cap_5_ticking.v = Some(__mbt_cap_5_v.at_moment_active(next, fn() { __mbt_local_gamepads_follow_look_5(__mbt_cap_5_running, __mbt_cap_5_then, __mbt_cap_5_ticking, __mbt_cap_5_told, __mbt_cap_5_v, next) }, later=true, while_covered=true))
}
