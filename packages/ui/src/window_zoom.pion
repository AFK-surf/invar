// Reactive window zoom state, coordinate scaling, and Cmd/Ctrl +/-/0 shortcuts.

import "hostapi"
import "signals"

pub let window_zoom_min : Double = 0.5
pub let window_zoom_max : Double = 3.0
pub let window_zoom_step : Double = 0.1

let window_zoom_sig : signals::Signal[Double] = signals::signal(1.0)

fn clamp_zoom(z : Double) -> Double {
  if z != z || z < window_zoom_min {
    window_zoom_min
  } else if z > window_zoom_max {
    window_zoom_max
  } else {
    (z * 100.0).round() / 100.0
  }
}

/// Current reactive window zoom factor (`0.5..3.0`, default `1.0`).
pub fn window_zoom() -> Double {
  window_zoom_sig.get()
}

/// Whether the current host platform supports desktop window zoom (macOS, Windows, Linux).
pub fn window_zoom_supported() -> Bool {
  let p = hostapi::platform()
  p == 0 || p == 3 || p == 5
}

/// Convert window-space points into unzoomed content coordinates.
pub fn window_points_to_content(points : Double) -> Double {
  let z = window_zoom()
  if z > 0.0 {
    points / z
  } else {
    points
  }
}

/// Set window zoom factor (clamped to `0.5..3.0`), updating the reactive signal and host.
pub fn set_window_zoom(zoom : Double) -> Unit {
  let next = clamp_zoom(zoom)
  window_zoom_sig.set(next)
  hostapi::set_window_zoom(next)
}

/// Increase window zoom by one step (`+0.1`), clamped to `3.0`.
pub fn zoom_in() -> Double {
  let next = clamp_zoom(window_zoom_sig.untracked() + window_zoom_step)
  set_window_zoom(next)
  next
}

/// Decrease window zoom by one step (`-0.1`), clamped to `0.5`.
pub fn zoom_out() -> Double {
  let next = clamp_zoom(window_zoom_sig.untracked() - window_zoom_step)
  set_window_zoom(next)
  next
}

/// Reset window zoom back to `1.0`.
pub fn zoom_reset() -> Double {
  set_window_zoom(1.0)
  1.0
}

/// Handle `Cmd/Ctrl` + `+` / `=` / `-` / `0` zoom shortcuts; returns true if consumed.
pub fn handle_zoom_shortcut(code : Int, mods : Int) -> Bool {
  let accel = if keys_apple() { (mods & mod_cmd) != 0 } else { (mods & mod_ctrl) != 0 }
  if !accel || (mods & mod_alt) != 0 {
    return false
  }
  if code == key_of_char('+') || code == key_of_char('=') {
    let _ = zoom_in()
    true
  } else if code == key_of_char('-') || code == key_of_char('_') {
    let _ = zoom_out()
    true
  } else if code == key_of_char('0') {
    let _ = zoom_reset()
    true
  } else {
    false
  }
}
