// INVAR-EXT: Real Invar compatibility layer and downstream bridges for packages/ui.
// Upstream UI runtime baseline commit: caa0645c917ba4038b8555f390aa77bc970256e1.
// All functions delegate directly to upstream ui/view/hostapi state; zero silent-ignore stubs.
//
// Invar hooks in upstream files:
//   - view_host.pion: view_blocks_enabled bypass, edge_after text check, droplet blur sign,
//     view_focus_lost/view_layers_focus modal focus sync, dummy ViewBlock skip when !draws_any,
//     s.actions forwarding in semantics_tree
//   - app.pion: Tester-only record_frame_damage scene comparison, view_scene_last recording,
//     in_frame_looks_hook reference paint
//   - tester.pion: keep_glyph_atlas propagation, host_ext_outside preservation
//   - tester_looks.pion: looks_ref_pass.v = true during reference rebuild pass (isolated from production looks_drawn)
//   - tester_time.pion: non-converging after_frame_cbs / non_clock_requested reason in draw_owed_said
//   - a11y.pion: s.actions forwarding and tree.drawn_of(e.id, drawn=true) alignment in a11y_tree_pass
//   - rooms.pion: over_all_of layer check, interior-clipped target recovery, window-edge slack guard
//   - editor.pion / tree_field.pion: pure read-only Field::focused()
//   - hostcall.pion / image.pion: outside_event_woke guard, single image_info poll on load, skip poll when looks_ref_pass
//   - fake_host.pion: async: image default size/state, empty src skip

import "hostapi"
import "mbt_compat"
import "signals"
import "text"
import "view"

// --- Basic utility helpers ---

pub fn ref_new[T](v : T) -> signals::Ref[T] {
  signals::ref_new(v)
}

pub fn c64(hi16 : Int, lo16 : Int) -> Int64 {
  ((hi16 & 0xFFFF).to_int64() << 16) | (lo16 & 0xFFFF).to_int64()
}

pub fn rgba(r : Int, g : Int, b : Int, a : Int) -> Int64 {
  ((r & 0xFF).to_int64() << 24) |
  ((g & 0xFF).to_int64() << 16) |
  ((b & 0xFF).to_int64() << 8) |
  (a & 0xFF).to_int64()
}

pub fn str_contains(s : String, pat : String) -> Bool {
  s.contains(pat)
}

pub fn str_has_prefix(s : String, pre : String) -> Bool {
  mbt_compat::str_has_prefix(s, pre)
}

pub fn array_remove_at[T](arr : Array[T], idx : Int) -> Unit {
  if idx < 0 || idx >= arr.length() {
    return
  }
  let _ = mbt_compat::arr_remove(arr, idx)
}

