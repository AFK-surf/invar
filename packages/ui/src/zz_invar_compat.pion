pub fn FakeHost::install(self : FakeHost) -> hostapi::Host {
  let prev = hostapi::host()
  hostapi::set_host(self.as_host())
  let ext = hostapi::HostExt::noop()
  ext.wake_now = fn() { self.wants = true }
  hostapi::set_host_ext(ext)
  prev
}

