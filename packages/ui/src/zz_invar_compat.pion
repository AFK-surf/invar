}

// --- Scroll view convenience wrappers ---

pub fn scroll_box(
  parent : view::View,
  body : (view::View) -> Unit,
  scroll? : view::Scroll,
  fill~ : Bool = true,
  bar~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let _ = loc
  let s = match scroll {
    Some(sc) => sc
    None => view::Scroll::new()
  }
  parent.box(fn(vp : view::View) {
    let _ = if bar {
      vp.scrolls(s, body, slop=touch_slop(), bar=tree_scroll_bar(), fill=false)
    } else {
      vp.scrolls(s, body, slop=touch_slop(), fill=false)
    }
    if fill {
      let _ = vp.fill(loc=loc)
    }
  })
}

pub fn scroll_row(
  parent : view::View,
  body : (view::View) -> Unit,
  scroll? : view::Scroll,
  fill~ : Bool = true,
  bar~ : Bool = true,
  loc~ : String = "",
) -> view::View {
  let _ = loc
  let s = match scroll {
    Some(sc) => sc
    None => view::Scroll::across()
  }
  parent.box(fn(vp : view::View) {
    let _ = if bar {
      vp.scrolls(s, body, slop=touch_slop(), bar=tree_scroll_bar(), fill=false)
    } else {
      vp.scrolls(s, body, slop=touch_slop(), fill=false)
    }
    if fill {
      let _ = vp.fill(loc=loc)
    }
  })
}

// --- Persistent before-frame hooks (preserved across first ui::run / Tester::tree) ---

let before_frame_hooks : Array[(Int, () -> Unit)] = []
let before_frame_next_id : mbt_compat::Ref[Int] = mbt_compat::ref_new(1)

pub fn on_before_frame(cb : () -> Unit) -> Int {
  let id = before_frame_next_id.v
  before_frame_next_id.v = id + 1
  before_frame_hooks.push((id, cb))
  id
}

pub fn remove_before_frame(id : Int) -> Unit {
  let mut i = 0
  while i < before_frame_hooks.length() {
    if before_frame_hooks[i].0 == id {
      let _ = mbt_compat::arr_remove(before_frame_hooks, i)
      return
    }
    i += 1
  }
}

fn run_before_frame_hooks() -> Unit {
  if before_frame_hooks.is_empty() {
    return
  }
  let snap = before_frame_hooks.copy()
  for entry in snap {
    (entry.1)()
  }
}

// --- Over-scrim floor stack ---

let over_scrim_stack : Array[(Int, (Double, Double) -> Option[(Double, Double)])] = []
let over_scrim_next_id : mbt_compat::Ref[Int] = mbt_compat::ref_new(1)
let over_scrim_token_win : Map[Int, Int] = Map::new()

fn sync_over_scrim_floor() -> Unit {
  if over_scrim_stack.is_empty() {
    over_scrim_floor.v = fn(_) { None }
  } else {
    let top = over_scrim_stack[over_scrim_stack.length() - 1].1
    over_scrim_floor.v = fn(c : Ctx) { top(c.width, c.height) }
  }
}

pub fn push_over_scrim_floor(f : (Double, Double) -> Option[(Double, Double)]) -> Int {
  let id = over_scrim_next_id.v
  over_scrim_next_id.v = id + 1
  over_scrim_stack.push((id, f))
  over_scrim_token_win.set(id, window_now.now)
  sync_over_scrim_floor()
  id
}

fn remove_over_scrim_floor_here(token : Int) -> Unit {
  let mut i = 0
  while i < over_scrim_stack.length() {
    if over_scrim_stack[i].0 == token {
      let _ = mbt_compat::arr_remove(over_scrim_stack, i)
      sync_over_scrim_floor()
      return
    }
    i += 1
  }
}

pub fn remove_over_scrim_floor(token : Int) -> Unit {
  match over_scrim_token_win.get(token) {
    Some(wid) => {
      over_scrim_token_win.remove(token)
      if wid != window_now.now {
        in_window(wid, fn() { remove_over_scrim_floor_here(token) })
        return
      }
    }
    None => ()
  }
  remove_over_scrim_floor_here(token)
}

// --- Image & text measurement bridges ---

pub fn image_bytes_for(key : String) -> Option[Bytes] {
  image_data.get(key)
}

pub fn images_pending() -> Bool {
  let it = mbt_compat::ordered_map_iter_lazy(image_cache)
  while true {
    match (it.next)() {
      Some((_, list)) => {
        for e in list {
          if e.state == 0 {
            return true
          }
        }
      }
      None => break
    }
  }
  false
}

pub fn images_reset() -> Unit {
  let it = mbt_compat::ordered_map_iter_lazy(image_cache)
  while true {
    match (it.next)() {
      Some((_, list)) => {
        for e in list {
          hostapi::image_free(e.id)
        }
      }
      None => break
    }
  }
  image_cache.clear()
  image_by_id.clear()
  image_bytes.v = 0.0
  image_data.clear()
}

pub fn glyph_atlas_epoch() -> Int {
  hostapi::atlas_generation()
}

pub fn measure_text_width(
  text : String,
  size : Double,
  weight~ : Int = 400,
  style_bits~ : Int = 0,
  tracking~ : Double = 0.0,
) -> Double {
  if text.length() == 0 {
    return 0.0
  }
  let eff_style = if tracking != 0.0 { style_bits | hostapi::style_no_ligatures } else { style_bits }
  let cap = (text.length() + 4) * 4
  let sbuf = FixedArray::make(cap, 0.0)
  let n = hostapi::shape(text, size, weight, eff_style, sbuf)
  let mut total = 0.0
  let mut k = 0
  while k < n {
    total = total + sbuf[k * 4 + 2] + tracking
    k += 1
  }
  total
}

// --- Field bridges backed directly by EditorState ---

#derive(Eq)
pub enum EditAction {
  Cut
  Copy
  Paste
  SelectAll
}

pub fn Field::caret(self : Field) -> Int {
  self.st.caret
}

pub fn Field::selection_range(self : Field) -> (Int, Int) {
  self.st.sel()
}

pub fn Field::has_selection(self : Field) -> Bool {
  self.st.anchor != self.st.caret
}

pub fn Field::set_selection(self : Field, from : Int, to : Int) -> Unit {
  self.pick(from, to)
}

pub fn Field::insert(self : Field, ins : String) -> Unit {
  self.st.insert(ins)
  self.st.words_told()
}

pub fn Field::handle_key(self : Field, code : Int, mods : Int) -> Bool {
  if code == key_of_char('v') && (mods & (mod_cmd | mod_ctrl)) != 0 {
    match self.st.tree_node {
      Option::Some(nid) => {
        match clipboard_read() {
          Some(r) => {
            desk.pasting = Some((tree_said_id(nid), r))
            tree_fields_pasting(h_now())
            return true
          }
          Option::None => ()
        }
      }
      Option::None => ()
    }
  }
  let before_text = self.st.text
  let before_caret = self.st.caret
  let before_anchor = self.st.anchor
  self.st.key(code, mods, h_now())
  self.st.text != before_text || self.st.caret != before_caret || self.st.anchor != before_anchor
}

pub fn Field::is_focus_asked(self : Field) -> Bool {
  self.st.focus_asked
}

pub fn Field::set_enter_sends(self : Field, on : Bool) -> Unit {
  self.st.enter_sends = on
}

pub fn Field::set_text_colors(self : Field, color : Int64, placeholder : Int64, caret : Int64) -> Unit {
  self.st.color = color
  self.st.ph_color = placeholder
  self.st.caret_color = caret
}

pub fn Field::text_colors(self : Field) -> (Int64, Int64, Int64) {
  (self.st.color, self.st.ph_color, self.st.caret_color)
}

pub struct EditMenuRect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
  pub selected : Bool
}

pub fn Field::menu_open(self : Field) -> Bool {
  self.st.menu
}

pub fn Field::set_menu_open(self : Field, open : Bool) -> Unit {
  self.st.menu = open
}

pub fn Field::edit_menu_rect(self : Field) -> EditMenuRect {
  let st = self.st
  let (a, b) = if st.anchor <= st.caret { (st.anchor, st.caret) } else { (st.caret, st.anchor) }
  let selected = a != b
  match st.tl {
    Some(tl) => {
      let (x0, line0) = tl.caret_side(a, false)
      let (x1, line1) = tl.caret_side(b, false)
      let rx = st.ox + (if line0 == line1 { dmin(x0, x1) } else { x0 })
      let ry = st.oy + line0.to_double() * tl.line_h
      let rw = if line0 == line1 { dmax(2.0, (x1 - x0).abs()) } else { dmax(2.0, dmax(x0, x1)) }
      let rh = dmax(tl.line_h, (line1 - line0 + 1).to_double() * tl.line_h)
      let (dx, dy, dw, dh) = st.drawn_box(rx, ry, rw, rh)
      EditMenuRect::{ x: dx, y: dy, w: dw, h: dh, selected }
    }
    Option::None => EditMenuRect::{ x: st.ox, y: st.oy, w: 0.0, h: 0.0, selected }
  }
}

pub fn Field::edit_menu_actions(self : Field) -> Array[EditAction] {
  let bits = self.st.can()
  let out : Array[EditAction] = []
  if (bits & 1) != 0 {
    out.push(EditAction::Cut)
  }
  if (bits & 2) != 0 {
    out.push(EditAction::Copy)
  }
  if (bits & 4) != 0 {
    out.push(EditAction::Paste)
  }
  if (bits & 8) != 0 {
    out.push(EditAction::SelectAll)
  }
  out
}

pub fn Field::perform_edit_action(self : Field, action : EditAction) -> Unit {
  let now = h_now()
  let c = g()
  let said_id = match self.st.tree_node {
    Some(nid) => tree_said_of.get(nid).unwrap_or(0)
    Option::None => self.st.built_id
  }
  if said_id != 0 && c.editors.contains(said_id) {
    match action {
      EditAction::Cut => {
        c.field_edit(said_id, hostapi::text_menu_cut)
        self.st.menu = false
        self.st.sel_handles = false
      }
      EditAction::Copy => {
        c.field_edit(said_id, hostapi::text_menu_copy)
        self.st.anchor = self.st.caret
        self.st.menu = false
        self.st.sel_handles = false
      }
      EditAction::Paste => {
        c.field_paste(said_id)
        tree_fields_pasting(now)
        if desk.pasting is Some(_) {
          match fake.v {
            Some(f) => {
              desk.pasting = None
              c.field_edit(said_id, hostapi::text_menu_paste, paste=f.clipboard)
            }
            Option::None => ()
          }
        }
        self.st.menu = false
        self.st.sel_handles = false
      }
      EditAction::SelectAll => {
        c.field_edit(said_id, hostapi::text_menu_select_all)
        self.st.menu = false
      }
    }
    return
  }
  // Standalone (unmounted) Field fallback: execute directly on EditorState.
  match action {
    EditAction::Cut => {
      self.st.key(key_cut, 0, now)
      self.st.words_told()
      self.st.menu = false
      self.st.sel_handles = false
    }
    EditAction::Copy => {
      self.st.key(key_copy, 0, now)
      self.st.anchor = self.st.caret
      self.st.menu = false
      self.st.sel_handles = false
    }
    EditAction::Paste => {
      match clipboard_read() {
        Some(r) =>
          match r.got() {
            Some(got) if got.text != "" => {
              self.st.text_input(text_paste, got.text, 0, 0, now)
              self.st.words_told()
            }
            _ => ()
          }
        Option::None => ()
      }
      self.st.menu = false
      self.st.sel_handles = false
    }
    EditAction::SelectAll => {
      self.st.key(key_select_all, 0, now)
      self.st.menu = false
    }
  }
}

// --- Scene & Tester bridges for film / bench / bench_gpu / lg ---

pub struct ScenePerf {
  pub mut frame_ms : Double
  pub mut layout_ms : Double
  pub mut paint_ms : Double
  pub mut present_ms : Double
  pub mut instances : Int
  pub mut dirty_rects : Int
}

pub fn ScenePerf::zero(instances : Int) -> ScenePerf {
  ScenePerf::{ frame_ms: 0.0, layout_ms: 0.0, paint_ms: 0.0, present_ms: 0.0, instances, dirty_rects: 0 }
}

pub struct Scene {
  pub mut inst : FixedArray[Double]
  pub mut ninst : Int
  pub mut width : Double
  pub mut height : Double
  pub mut scale : Double
  pub mut ink_x : Double
  pub mut ink_y : Double
  pub mut ink_r : Double
  pub perf : ScenePerf
}

pub fn Scene::new() -> Scene {
  Scene::{ inst: FixedArray::make(inst_size, 0.0), ninst: 0, width: 0.0, height: 0.0, scale: 1.0, ink_x: 0.0, ink_y: 0.0, ink_r: 0.0, perf: ScenePerf::zero(0) }
}

pub fn Scene::clear(self : Scene, w : Double, h : Double, scale : Double) -> Unit {
  self.ninst = 0
  self.width = w
  self.height = h
  self.scale = scale
}

pub fn Scene::ensure_inst_len(self : Scene, need : Int) -> Unit {
  if need > self.inst.length() {
    let mut cap = if self.inst.length() > 0 { self.inst.length() * 2 } else { inst_size * 16 }
    while cap < need {
      cap = cap * 2
    }
    let grown = FixedArray::make(cap, 0.0)
    self.inst.blit_to(grown, len=self.inst.length())
    self.inst = grown
  }
}

pub fn view_scene_last() -> Scene {
  let c = g()
  let n = c.ninst
  let snap = FixedArray::make(if n > 0 { n * inst_size } else { inst_size }, 0.0)
  if n > 0 {
    c.inst.blit_to(snap, len=n * inst_size)
  }
  Scene::{ inst: snap, ninst: n, width: c.width, height: c.height, scale: c.scale, ink_x: 0.0, ink_y: 0.0, ink_r: 0.0, perf: ScenePerf::zero(n) }
}

let standalone_encode : mbt_compat::Ref[Bool] = mbt_compat::ref_new(false)

pub fn encode_tree_scene(tree : view::Tree, w : Double, h : Double, scale : Double, now : Double) -> Scene {
  let prev_app = view_app.v
  let prev_win = view_window.v
  let prev_size_sig = tree_window_size_sig.v
  let prev_standalone = standalone_encode.v
  let prev_focus = g().focus
  let is_same = match prev_app {
    Some(p) => physical_equal(p, tree)
    None => false
  }
  if !is_same {
    view_drawn_by(tree)
    view_app.v = Some(tree)
    tree_window_size_sig.v = signals::signal((w, h), same=fn(a, b) { a.0 == b.0 && a.1 == b.1 })
    bump_ui_ctx_slots_rev()
    standalone_encode.v = true
    g().focus = 0
    match tree.focused_now().0 {
      Some(fnid) => {
        g().focus = tree_said_id(fnid)
      }
      Option::None =>
      match pending_focus_field.v {
        Some(pst) =>
        match pst.tree_node {
          Some(fnid) =>
          match tree_fields.get(fnid) {
            Some(tf) if physical_equal(tf.view.tree, tree) => {
              let _ = tree.focus_to(Some(fnid))
              g().focus = tree_said_id(fnid)
            }
            _ => ()
          }
          Option::None => ()
        }
        Option::None => ()
      }
    }
    paint_watch_of().touch()
  }
  // Poll any pending native image decodes before encoding the frame (needed when
  // an offscreen host pumps decodes via pump_main_loop without invoking image_decoded).
  let mut polled_ready = false
  let img_it = mbt_compat::ordered_map_iter_lazy(image_cache)
  while true {
    match (img_it.next)() {
      Some((src, list)) => {
        for e in list {
          if e.state == 0 {
            image_done(src, e, now)
            if e.state != 0 {
              polled_ready = true
            }
          }
        }
      }
      None => break
    }
  }
  if polled_ready {
    view_blocks.clear()
    paint_watch_of().touch()
  }
  on_frame(w, h, scale, now)
  let sc = view_scene_last()
  if !is_same {
    g().focus = prev_focus
    standalone_encode.v = prev_standalone
    view_app.v = prev_app
    view_window.v = prev_win
    tree_window_size_sig.v = prev_size_sig
    bump_ui_ctx_slots_rev()
  }
  sc
}

pub fn Tester::scene(self : Tester) -> Scene {
  let (inst, ninst, _) = self.presented()
  let snap = FixedArray::make(if ninst > 0 { ninst * inst_size } else { inst_size }, 0.0)
  if ninst > 0 {
    inst.blit_to(snap, len=ninst * inst_size)
  }
  Scene::{ inst: snap, ninst, width: self.w, height: self.h, scale: self.fake.scale, ink_x: 0.0, ink_y: 0.0, ink_r: 0.0, perf: ScenePerf::zero(ninst) }
}

pub fn Tester::frame_requested(self : Tester) -> Bool {
  self.fake.wants
}

pub fn Tester::set_frame_requested(self : Tester, on : Bool) -> Unit {
  self.fake.wants = on
}

pub fn Tester::set_time(self : Tester, ms : Double) -> Unit {
  self.fake.time = ms
}

pub fn Tester::drawn_by_name(self : Tester, name : String, role? : view::Role) -> Option[view::Drawn] {
  let _ = self
  match view_tree() {
    Some(tr) => {
      for d in tr.drawn() {
        let lbl = tr.said_label(d.id)
        let ok_name = lbl == name || d.words == name
        if ok_name {
          match role {
            Some(r) =>
              match tr.said_of(d.id) {
                Some(s) if s.role == r => return Some(d)
                _ => ()
              }
            None => return Some(d)
          }
        }
      }
      None
    }
    None => None
  }
}

pub fn Tester::tap_by_name(self : Tester, name : String) -> Unit {
  match self.drawn_by_name(name) {
    Some(d) => self.tap(d.x + d.w * 0.5, d.y + d.h * 0.5)
    None => self.tap_text(name)
  }
}

pub fn Tester::assert_rooms(self : Tester, label~ : String = "") -> Unit {
  let faults = self.room_faults()
  if faults.length() > 0 {
    let mut msg = if label.length() > 0 {
      "room_faults failed in \{label} (\{faults.length()} fault(s)):"
    } else {
      "room_faults failed (\{faults.length()} fault(s)):"
    }
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

/// Compares the accessibility mirror received by the host against the current
/// semantics tree (`g().a11y_lines()`). Note: `Tester::hold_a11y_whole` also
/// enforces this invariant automatically after every frame when a11y is active.
pub fn Tester::a11y_faults(self : Tester) -> Array[String] {
  if !self.fake.a11y {
    return []
  }
  let has = self.fake.a11y_told.lines()
  let whole = g().a11y_lines()
  if has == whole {
    []
  } else {
    ["a11y mirror mismatch:\n--- told\n\{has}--- read out\n\{whole}"]
  }
}

pub fn image_cache_count() -> Int {
  let mut n = image_data.length()
  let it = mbt_compat::ordered_map_iter_lazy(image_cache)
  while true {
    match (it.next)() {
      Some((_, list)) => n = n + list.length()
      None => break
    }
  }
  n
}

let glass_frost_said : mbt_compat::Ref[signals::Signal[Double]] = mbt_compat::ref_new(signals::signal(0.0, same=fn(a, b) { a == b }))

pub fn set_glass_frost(frost : Double) -> Unit {
  let v = if frost != frost || frost <= 0.0 {
    0.0
  } else if frost >= 1.0 {
    1.0
  } else {
    frost
  }
  if (glass_frost_said.v.untracked() - v).abs() > 1.0e-9 {
    glass_frost_said.v.set(v)
    hostapi::request_frame()
  }
}

pub fn glass_frost() -> Double {
  glass_frost_said.v.get()
}

let view_cull_enabled : mbt_compat::Ref[Bool] = mbt_compat::ref_new(true)

pub fn set_view_cull_enabled(on : Bool) -> Unit {
  view_cull_enabled.v = on
}

pub fn reset_glyph_atlas() -> Unit {
  paint_glyph_reset()
  glyphs_lost.v = true
  glyph_moves.v += 1
  text_cache.glyphs.clear()
  text_cache.fonts.clear()
  text_cache.last_font = Option::None
  text_cache.seg_fonts.clear()
  text_cache.seg_last_font_0 = Option::None
  text_cache.seg_last_font_1 = Option::None
  text_cache.metrics.clear()
  text_cache.fresh.clear()
  glyphs_laid.clear()
  glyphs_ahead_laid_keys.clear()
  glyphs_ahead_laid_bases.clear()
  view_blocks.clear()
  ride_kept.clear()
  words_forgotten()
  outside_came()
  let sz = h_atlas_size(false)
  if sz > 0 {
    text_cache.atlas = Some(hostapi::Atlas::new(sz))
  } else {
    match text_cache.atlas {
      Some(a) => a.clear()
      Option::None => ()
    }
  }
  let csz = h_atlas_size(true)
  if csz > 0 {
    text_cache.colour_atlas = Some(hostapi::Atlas::new(csz))
  } else {
    match text_cache.colour_atlas {
      Some(a) => a.clear()
      Option::None => ()
    }
  }
  text_cache.fresh.clear()
  glyphs_laid.clear()
  glyphs_ahead_laid_keys.clear()
  glyphs_ahead_laid_bases.clear()
  view_blocks.clear()
  ride_kept.clear()
  view_due.v.set(view_due.v.untracked() + 1)
}

pub fn clear_text_cache() -> Unit {
  clear_shapes()
  text_cache.fonts.clear()
  text_cache.last_font = Option::None
  text_cache.shaped = 0
  text_cache.seg_fonts.clear()
  text_cache.seg_last_font_0 = Option::None
  text_cache.seg_last_font_1 = Option::None
  text_cache.seg_shaped = 0
  text_cache.metrics.clear()
  rich_kept.clear()
  paint_glyph_reset()
}

pub fn view_paint_work_now() -> ViewPaintWork {
  view_painted()
}

pub fn view_paint_work_reset() -> Unit {
  view_paint_work.made = 0
  view_paint_work.copied = 0
  view_paint_work.handed = 0
}

pub fn Scene::emit_quad_bezier(
  self : Scene,
  x0 : Double,
  y0 : Double,
  cx : Double,
  cy : Double,
  x1 : Double,
  y1 : Double,
  width : Double,
  color : Int64,
  alpha~ : Double = 1.0,
  clip_x~ : Double = 0.0,
  clip_y~ : Double = 0.0,
  clip_x1~ : Double = 1.0e9,
  clip_y1~ : Double = 1.0e9,
) -> Unit {
  if width <= 0.0 || (color & 0xFFL) == 0L || alpha <= 0.0 {
    return
  }
  let mut min_x = if x0 < x1 { x0 } else { x1 }
  let mut max_x = if x0 > x1 { x0 } else { x1 }
  let dx = x0 - 2.0 * cx + x1
  if dx.abs() > 1.0e-9 {
    let tx = (x0 - cx) / dx
    if tx > 0.0 && tx < 1.0 {
      let mt = 1.0 - tx
      let qx = mt * mt * x0 + 2.0 * mt * tx * cx + tx * tx * x1
      if qx < min_x { min_x = qx }
      if qx > max_x { max_x = qx }
    }
  }
  let mut min_y = if y0 < y1 { y0 } else { y1 }
  let mut max_y = if y0 > y1 { y0 } else { y1 }
  let dy = y0 - 2.0 * cy + y1
  if dy.abs() > 1.0e-9 {
    let ty = (y0 - cy) / dy
    if ty > 0.0 && ty < 1.0 {
      let mt = 1.0 - ty
      let qy = mt * mt * y0 + 2.0 * mt * ty * cy + ty * ty * y1
      if qy < min_y { min_y = qy }
      if qy > max_y { max_y = qy }
    }
  }
  let hw = width * 0.5
  let pad = hw + 1.5
  let bx = min_x - pad
  let by = min_y - pad
  let bw = max_x - min_x + 2.0 * pad
  let bh = max_y - min_y + 2.0 * pad
  let idx = self.ninst
  let db = idx * inst_size
  if db + inst_size > self.inst.length() {
    let mut next_cap = if self.inst.length() > 0 { self.inst.length() * 2 } else { inst_size * 16 }
    while next_cap < db + inst_size {
      next_cap = next_cap * 2
    }
    let grown = FixedArray::make(next_cap, 0.0)
    self.inst.blit_to(grown, len=self.inst.length())
    self.inst = grown
  }
  let inst = self.inst
  let r = ((color >> 24) & 0xFFL).to_double() / 255.0
  let g_ch = ((color >> 16) & 0xFFL).to_double() / 255.0
  let b_ch = ((color >> 8) & 0xFFL).to_double() / 255.0
  let a_clamped = if alpha < 0.0 { 0.0 } else if alpha > 1.0 { 1.0 } else { alpha }
  let a = ((color & 0xFFL).to_double() / 255.0) * a_clamped
  inst[db] = bx
  inst[db + 1] = by
  inst[db + 2] = bw
  inst[db + 3] = bh
  inst[db + 4] = hw
  inst[db + 5] = 10.0
  inst[db + 6] = 1.0
  inst[db + 7] = 0.0
  inst[db + 8] = r
  inst[db + 9] = g_ch
  inst[db + 10] = b_ch
  inst[db + 11] = a
  inst[db + 12] = (x0 - bx) / bw
  inst[db + 13] = (y0 - by) / bh
  inst[db + 14] = (x1 - bx) / bw
  inst[db + 15] = (y1 - by) / bh
  inst[db + 16] = clip_x
  inst[db + 17] = clip_y
  inst[db + 18] = clip_x1
  inst[db + 19] = clip_y1
  inst[db + 36] = (cx - bx) / bw
  inst[db + 37] = (cy - by) / bh
  inst[db + 38] = 0.0
  inst[db + 39] = 0.0
  if self.ink_r > 0.0 {
    inst[db + 21] = self.ink_x
    inst[db + 22] = self.ink_y
    inst[db + 23] = self.ink_r
  }
  self.ninst = idx + 1
}

pub fn Tester::width(self : Tester) -> Double {
  self.w
}

pub fn Tester::height(self : Tester) -> Double {
  self.h
}

pub fn Tester::period_ms(self : Tester) -> Double {
  self.period
}

pub fn Tester::set_period_ms(self : Tester, ms : Double) -> Unit {
  self.period = ms
}

pub fn Tester::fps(self : Tester) -> Double {
  if self.period > 0.0 { 1000.0 / self.period } else { 60.0 }
}

pub fn Tester::set_fps(self : Tester, rate : Double) -> Unit {
  if rate > 0.0 {
    self.period = 1000.0 / rate
  }
}

let touch_saved_pointing : mbt_compat::Ref[Option[Option[Pointing]]] = mbt_compat::ref_new(Option::None)

pub fn Tester::dispose(self : Tester, keep_glyph_atlas~ : Bool = false) -> Unit {
  match touch_saved_pointing.v {
    Option::Some(prev) => {
      touch_saved_pointing.v = Option::None
      set_pointing(prev)
    }
    Option::None => ()
  }
  image_data.clear()
  ui_causal_ring_reset()
  press_rules.v = PressRules::{ finger: 44.0, mouse: 36.0, large_from: Option::None }
  if !keep_glyph_atlas {
    reset_glyph_atlas()
  }
  let restore = match host_outside.v {
    Some(h) => h
    Option::None => hostapi::host()
  }
  self.end_run(restore)
  match host_ext_outside.v {
    Some(ext) => {
      host_ext_outside.v = Option::None
      hostapi::set_host_ext(ext)
    }
    Option::None => ()
  }
}

pub fn Tester::drawn(self : Tester) -> Array[view::Drawn] {
  let _ = self
  match view_tree() {
    Some(tr) => tr.drawn()
    None => []
  }
}

pub fn Tester::scroll_faults(self : Tester) -> Array[String] {
  let _ = self
  match view_tree() {
    Some(tr) => tr.scroll_faults()
    None => []
  }
}

pub fn Tester::assert_scrollable(self : Tester, label~ : String = "") -> Unit {
  let faults = self.scroll_faults()
  if faults.length() > 0 {
    let mut msg = if label.length() > 0 {
      "scroll_faults failed in \{label} (\{faults.length()} fault(s)):"
    } else {
      "scroll_faults failed (\{faults.length()} fault(s)):"
    }
    for f in faults {
      msg = "\{msg}\n  - \{f}"
    }
    debug_assert(false, msg)
  }
}

pub fn check_fps_matrix(
  rates~ : Array[Double] = [60.0, 120.0, 24.0, 7.0],
  probe : (Double) -> String,
) -> Array[String] {
  let diffs : Array[String] = []
  if rates.length() == 0 {
    return diffs
  }
  let base_rate = rates[0]
  let base_out = probe(base_rate)
  let mut i = 1
  while i < rates.length() {
    let r = rates[i]
    let out = probe(r)
    if out != base_out {
      diffs.push("fps \{r} != \{base_rate}: got '\{out}', expected '\{base_out}'")
    }
    i += 1
  }
  diffs
}

pub struct FrameOutbox[T] {
  buf : Mutex[Array[T]]
  meta : Mutex[Array[Int]]
  wake : Option[() -> Unit]
}

pub fn FrameOutbox::new[T](wake? : () -> Unit) -> FrameOutbox[T] {
  let empty : Array[T] = []
  let meta_init : Array[Int] = [0, 0, 0]
  FrameOutbox::{
    buf: Mutex::new(empty),
    meta: Mutex::new(meta_init),
    wake,
  }
}

fn FrameOutbox::ask[T](self : FrameOutbox[T]) -> Unit {
  let mut should_wake = false
  self.meta.with_lock(fn(m : Array[Int]) -> Unit {
    if m[0] == 0 {
      m[0] = 1
      m[1] = m[1] + 1
      should_wake = true
    }
  })
  if should_wake {
    match self.wake {
      Some(w) => w()
      None => hostapi::wake_now()
    }
  }
}

pub fn FrameOutbox::tell[T](self : FrameOutbox[T], change : T) -> Unit {
  self.buf.with_lock(fn(q : Array[T]) -> Unit {
    q.push(change)
  })
  self.ask()
}

pub fn FrameOutbox::take[T](self : FrameOutbox[T], most? : Int) -> Array[T] {
  let out : Array[T] = []
  let mut has_more = false
  self.meta.with_lock(fn(m : Array[Int]) -> Unit {
    m[0] = 0
    m[2] = m[2] + 1
  })
  self.buf.with_lock(fn(q : Array[T]) -> Unit {
    let n = q.length()
    let limit = match most {
      Some(m) => {
        let clamped = if m < 0 { 0 } else { m }
        if clamped < n { clamped } else { n }
      }
      None => n
    }
    let mut i = 0
    while i < limit {
      out.push(q[i])
      i += 1
    }
    if limit < n {
      let rest : Array[T] = []
      let mut j = limit
      while j < n {
        rest.push(q[j])
        j += 1
      }
      q.clear()
      for item in rest {
        q.push(item)
      }
      has_more = true
    } else {
      q.clear()
    }
  })
  if has_more {
    self.ask()
  }
  out
}

pub fn FrameOutbox::bind[T](self : FrameOutbox[T], apply : (Array[T]) -> Unit, most? : Int) -> Unit {
  let _ = on_before_frame(fn() -> Unit {
    let batch = match most {
      Some(m) => self.take(most=m)
      None => self.take()
    }
    if batch.length() > 0 {
      apply(batch)
    }
  })
}

pub fn FrameOutbox::waiting[T](self : FrameOutbox[T]) -> Int {
  let mut n = 0
  self.buf.with_lock(fn(q : Array[T]) -> Unit {
    n = q.length()
  })
  n
}

pub fn FrameOutbox::wakes[T](self : FrameOutbox[T]) -> Int {
  let mut w = 0
  self.meta.with_lock(fn(m : Array[Int]) -> Unit {
    w = m[1]
  })
  w
}

pub fn FrameOutbox::takes[T](self : FrameOutbox[T]) -> Int {
  let mut t = 0
  self.meta.with_lock(fn(m : Array[Int]) -> Unit {
    t = m[2]
  })
  t
}

