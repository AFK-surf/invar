pub fn field_display_or_hint(id : view::NodeId) -> Option[String] {
  match tree_fields.get(id) {
    Some(tf) => {
      let st = tf.st
      if st.text.length() > 0 || st.marked.length() > 0 {
        if st.secret {
          Some(st.display_text())
        } else {
          Some(st.text + st.marked)
        }
      } else {
        let primary = (tf.hint)()
        if !tf.shorter.is_empty() {
          match tf.view.tree.drawn_of(id) {
            Some(d) if d.w > 0.0 => {
              let fb = g().tree_field_box(id, tf, d.x, d.y, d.w, d.h)
              let lay = fb.hint_lay()
              let room = fb.w - fb.pad_l - fb.pad_r + 0.5
              if lay(primary).w <= room {
                return Some(primary)
              }
              let mut picked = primary
              for cand in tf.shorter {
                picked = cand
                if lay(cand).w <= room {
                  return Some(cand)
                }
              }
              return Some(picked)
            }
            _ => ()
          }
        }
        Some(primary)
      }
    }
    Option::None => Option::None
  }
}

