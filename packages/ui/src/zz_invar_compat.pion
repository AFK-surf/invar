let damage_report_poison : mbt_compat::Ref[Option[DamageReport]] = mbt_compat::ref_new(Option::None)
let view_block_poison : mbt_compat::Ref[Bool] = mbt_compat::ref_new(false)
let looks_ref_pass : mbt_compat::Ref[Bool] = mbt_compat::ref_new(false)
