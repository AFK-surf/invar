pub fn host_words_measure(words : String, look : view::WordsLook, width : Double, scale : Double) -> (Double, Double) {
  let tl = layout_words(view_words_set(words, look, false), view_sp(scale, look.size), look.weight, if width < 0.0 { 1.0e9 } else { width }, look.wrap, balance=look.balance, line=view_line(scale, look), spacing=view_spacing(scale, look), style=view_words_style(look=look), max_lines=look.max_lines)
  (tl.w, tl.h)
}

