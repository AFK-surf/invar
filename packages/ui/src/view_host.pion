  hostapi::wake_now()
}

struct BeforeFrameHook {
  id : Int
  cb : () -> Unit
}

struct BeforeFrameState {
  mut next_id : Int
  hooks : Array[BeforeFrameHook]
}

let before_frame_state : BeforeFrameState = BeforeFrameState::{ next_id: 1, hooks: [] }

/// Register a callback invoked at the start of every `view_frame`, before `tree.frame(...)`.
/// Returns a hook id that can be passed to `remove_before_frame`.
pub fn on_before_frame(cb : () -> Unit) -> Int {
  let id = before_frame_state.next_id
  before_frame_state.next_id = id + 1
  before_frame_state.hooks.push(BeforeFrameHook::{ id, cb })
  id
}

/// Remove a previously registered `on_before_frame` callback by id.
pub fn remove_before_frame(id : Int) -> Unit {
  let mut i = 0
  while i < before_frame_state.hooks.length() {
    if before_frame_state.hooks[i].id == id {
      array_remove_at(before_frame_state.hooks, i)
      return
    }
    i += 1
  }
}

fn clear_before_frame_hooks() -> Unit {
  before_frame_state.hooks.clear()
}

fn run_before_frame_hooks() -> Unit {
  if before_frame_state.hooks.length() == 0 {
    return
  }
  let snapshot = before_frame_state.hooks.copy()
  for h in snapshot {
    (h.cb)()
  }
}

let replacing_app : signals::Ref[Bool] = ref_new(false)

fn view_forget_inner(clear_hooks : Bool) -> Bool {
  let prev_replacing = replacing_app.v
  replacing_app.v = prev_replacing || clear_hooks
  let start_epoch = ui_ctx_epoch.v
  let old_tree = primary_view_tree.v
  primary_view_tree.v = None
  if window_now.v == 0 {
    view_app.tree = None
  }
  match old_tree {
    Some(t) => dispose_primary_tree(t)
    None => ()
  }
  if ui_ctx_epoch.v != start_epoch {
    replacing_app.v = prev_replacing
    return false
  }
  if !windows_reset() {
    replacing_app.v = prev_replacing
    return false
  }
  let my_epoch = ui_ctx_epoch.v
  if clear_hooks {
    clear_before_frame_hooks()
    tree_narrow_below_sig.v.set(700.0)
    if ui_ctx_epoch.v != my_epoch {
      replacing_app.v = prev_replacing
      return false
    }
    tree_narrow_enabled_sig.v.set(false)
    if ui_ctx_epoch.v != my_epoch {
      replacing_app.v = prev_replacing
      return false
    }
  }
  view_app.maker = None
  view_app.scene = Scene::new()
  view_app.dmg = damage::Damage::new()
  view_app.a11y = A11yTold::new()
  view_app.frame_no = 0
  view_app.last_w = 0.0
  view_app.last_h = 0.0
  view_app.last_scale = 1.0
  view_app.press_down = false
  view_app.pressed_node = None
  view_app.dragging_node = None
  view_app.claim_chain.clear()
  view_app.press_events.clear()
  view_app.down2 = None
  view_app.active_touch_id = None
  view_app.secondary_touch_id = None
  view_app.finger_0 = 0
  view_app.finger_1 = -1
  view_app.finger_next = 1
  view_app.last_present_hash = 0L
  view_app.underlay_painter = None
  view_app.fast_present = false
  view_app.pointer_interceptor = None
  view_app.wheel_interceptor = None
  view_app.key_interceptor = None
  view_app.text_interceptor = None
  view_app.last_wheel_phase = 0
  view_app.last_light_angle = -999.0
  view_app.last_bg_r = 0.0
  view_app.last_bg_g = 0.0
  view_app.last_bg_b = 0.0
  view_app.last_atlas_gen = -1
  view_app.shown_cursor = -1
  fields_reset()
  drops_reset()
  over_scrim_floor_owner.clear()
  streams_and_natives_reset()
  shots_clear()
  reset_glyph_atlas()
  view_blocks_reset()
  view_pictures_reset()
  host_samples_begin()
  last_damage_report.v = DamageReport::None
  damage_report_poison.v = None
  in_frame_looks_hook.v = None
  view_block_poison.v = false
  if !messages_reset_checked(my_epoch) {
    replacing_app.v = prev_replacing
    return false
  }
  reset_glass_light_angle()
  if ui_ctx_epoch.v != my_epoch {
    replacing_app.v = prev_replacing
    return false
  }
  replacing_app.v = prev_replacing
  true
}

fn view_forget() -> Unit {
  match window_lifecycle_guard_error("view_forget") {
    Some(msg) => {
      let _ : Unit = halt::halt(msg)
    }
    None => ()
  }
  let _ = view_forget_inner(true)
}

/// Register the pure-tree root builder and optional reactive theme provider.
/// Calling `set_view_app` while switching windows (`take`/`restore`/`fresh`) or during tree teardown (`root.owns`) halts immediately.
pub fn set_view_app(make : (view::View) -> Unit, theme? : () -> Theme) -> Unit {
  match window_lifecycle_guard_error("set_view_app") {
    Some(msg) => {
      let _ : Unit = halt::halt(msg)
    }
    None => ()
  }
  let had_app = primary_view_tree.v.is_some() || replacing_app.v
  if !view_forget_inner(had_app) {
    return
  }
  let my_epoch = ui_ctx_epoch.v
  register_ui_window_kept()
  ensure_drop_registry_kept()
  match theme {
    Some(tf) => set_tree_theme(tf)
    None => clear_tree_theme()
  }
  if ui_ctx_epoch.v != my_epoch {
    return
  }
  view_app.maker = Some(make)
  primary_building_epochs.push(my_epoch)
  let tree = view::Tree::new(
    make,
    measure=host_words_measure,
    measure_runs=host_runs_measure,
    measure_runs_least=host_runs_least_measure,
    // (its clock starts at the host's now, the one every frame and event after is told in: started at 0, the first
    // frame took it from 0 to the host's (on Windows, ms since boot), and what was set at a moment of the old start
    // (at_moment(cause_at() + 1000), again at each) came due once for each second between: ~300 000 turns, 0.18 s of a
    // window's start, 2026-11-22)
    time=hostapi::now,
  )
  let kept_epochs : Array[Int] = []
  for ep in primary_building_epochs {
    if ep != my_epoch {
      kept_epochs.push(ep)
    }
  }
  primary_building_epochs.clear()
  for ep in kept_epochs {
    primary_building_epochs.push(ep)
  }
  if ui_ctx_epoch.v != my_epoch {
    let saved_primary_slot = primary_building_saved_slot.get(my_epoch)
    primary_building_saved_slot.remove(my_epoch)
    window_open_seq.v = window_open_seq.v + 1
    let detached_gen = window_open_seq.v
    dispose_detached_tree(0, detached_gen, tree, saved_primary_slot, primary_epoch=Some(my_epoch))
    return
  }
  primary_building_saved_slot.remove(my_epoch)
  tree.drawn_by(image_ready=image_ready_at, image_ask=image_ask_at)
  tree.on_due(fn() {
    if in_tree_frame.v {
      hostapi::request_frame_on()
    } else {
      hostapi::request_frame()
    }
  })
  tree.on_cursor(fn() { view_cursor_tell() })
  install_tree_hooks(tree, 0, 0)
  view_app.tree = Some(tree)
  primary_view_tree.v = Some(tree)
}

/// Sync the host pointer cursor with the active drag/press node or hovered node under `(pointer_x, pointer_y)`.
fn view_cursor_tell() -> Unit {
  let tree = match view_app.tree {
    Some(t) => t
    None => return
  }
  let cur = match view_app.dragging_node {
    Some(id) => tree.cursor_of(id)
    None => match view_app.pressed_node {
      Some(id) => tree.cursor_of(id)
      None => match tree.points_now() {
        Some(id) => tree.cursor_of(id)
        None => match tree.target_at(view_app.pointer_x, view_app.pointer_y) {
          view::Target::Dragged(id) => tree.cursor_of(id)
          view::Target::Pressed(id) => tree.cursor_of(id)
          view::Target::TopRow(id) => tree.cursor_of(id)
          _ => view::Cursor::Arrow
        }
      }
    }
  }
  let code = view::cursor_code(cur)
  if code != view_app.shown_cursor {
    view_app.shown_cursor = code
    hostapi::set_cursor(code)
  }
}

/// Porter-Duff src-over compositing of straight 0xRRGGBBAA `over_c` onto `under`, used when a translucent edge
/// shares a single kind=0 GPU rect instance with its ground so the border never punches a hole through the fill.
fn over_rgba(under : Int64, over_c : Int64) -> Int64 {
  let sa = (over_c & 0xFFL).to_double() / 255.0
  if sa <= 0.0 {
    return under
  }
  if sa >= 1.0 {
    return over_c
  }
  let da = (under & 0xFFL).to_double() / 255.0
  if da <= 0.0 {
    return over_c
  }
  let out_a = sa + da * (1.0 - sa)
  if out_a <= 0.0 {
    return 0L
  }
  let sr = ((over_c >> 24) & 0xFFL).to_double()
  let sg = ((over_c >> 16) & 0xFFL).to_double()
  let sb = ((over_c >> 8) & 0xFFL).to_double()
  let dr = ((under >> 24) & 0xFFL).to_double()
  let dg = ((under >> 16) & 0xFFL).to_double()
  let db = ((under >> 8) & 0xFFL).to_double()
  let k = da * (1.0 - sa)
  let clamp_b = fn(v : Double) -> Int64 {
    let i = v.round().to_int64()
    if i < 0L { 0L } else if i > 255L { 255L } else { i }
  }
  let r = clamp_b((sr * sa + dr * k) / out_a)
  let g = clamp_b((sg * sa + dg * k) / out_a)
  let b = clamp_b((sb * sa + db * k) / out_a)
  let a = clamp_b(out_a * 255.0)
  (r << 24) | (g << 16) | (b << 8) | a
}

fn color_rgba_tuple(c : Int64, alpha_mul : Double) -> (Double, Double, Double, Double) {
  let r = ((c >> 24) & 0xFFL).to_double() / 255.0
  let g = ((c >> 16) & 0xFFL).to_double() / 255.0
  let b = ((c >> 8) & 0xFFL).to_double() / 255.0
  let a = ((c & 0xFFL).to_double() / 255.0) * dclamp(alpha_mul, 0.0, 1.0)
  (r, g, b, a)
}

fn apply_node_corners(scene : Scene, idx : Int, d : view::Drawn) -> Unit {
  match d.corners {
    Some((c0, c1, c2, c3)) => scene.set_corners(idx, c0, c1, c2, c3)
    None => ()
  }
}

fn node_corners_tuple(d : view::Drawn) -> (Double, Double, Double, Double) {
  match d.corners {
    Some((c0, c1, c2, c3)) => (c0, c1, c2, c3)
    None => (d.radius, d.radius, d.radius, d.radius)
  }
}

fn intersect_clip(
  a_clip : (Double, Double, Double, Double),
  a_rc : (Double, Double, Double, Double),
  bx0 : Double,
  by0 : Double,
  bx1 : Double,
  by1 : Double,
  b_rc : (Double, Double, Double, Double),
) -> ((Double, Double, Double, Double), (Double, Double, Double, Double)) {
  let (ax0, ay0, ax1, ay1) = a_clip
  let nx0 = dmax(ax0, bx0)
  let ny0 = dmax(ay0, by0)
  let nx1 = dmin(ax1, bx1)
  let ny1 = dmin(ay1, by1)
  let eps = 0.01
  let c0 = if (nx0 - bx0).abs() < eps && (ny0 - by0).abs() < eps {
    if (nx0 - ax0).abs() < eps && (ny0 - ay0).abs() < eps { dmax(a_rc.0, b_rc.0) } else { b_rc.0 }
  } else if (nx0 - ax0).abs() < eps && (ny0 - ay0).abs() < eps {
    a_rc.0
  } else {
    0.0
  }
  let c1 = if (nx1 - bx1).abs() < eps && (ny0 - by0).abs() < eps {
    if (nx1 - ax1).abs() < eps && (ny0 - ay0).abs() < eps { dmax(a_rc.1, b_rc.1) } else { b_rc.1 }
  } else if (nx1 - ax1).abs() < eps && (ny0 - ay0).abs() < eps {
    a_rc.1
  } else {
    0.0
  }
  let c2 = if (nx1 - bx1).abs() < eps && (ny1 - by1).abs() < eps {
    if (nx1 - ax1).abs() < eps && (ny1 - ay1).abs() < eps { dmax(a_rc.2, b_rc.2) } else { b_rc.2 }
  } else if (nx1 - ax1).abs() < eps && (ny1 - ay1).abs() < eps {
    a_rc.2
  } else {
    0.0
  }
  let c3 = if (nx0 - bx0).abs() < eps && (ny1 - by1).abs() < eps {
    if (nx0 - ax0).abs() < eps && (ny1 - ay1).abs() < eps { dmax(a_rc.3, b_rc.3) } else { b_rc.3 }
  } else if (nx0 - ax0).abs() < eps && (ny1 - ay1).abs() < eps {
    a_rc.3
  } else {
    0.0
  }
  ((nx0, ny0, nx1, ny1), (c0, c1, c2, c3))
}

fn glass_spot(spot : Option[(Double, Double)]) -> Double {
  match spot {
    None => 0.0
    Some((lx, ly)) => {
      let qx = dclamp(((lx + 256.0) * 2.0).round(), 0.0, 4095.0)
      let qy = dclamp(((ly + 256.0) * 2.0).round(), 0.0, 4095.0)
      qx * 4096.0 + qy + 1.0
    }
  }
}

fn rects_meet_by(j : Int, k : Int, a : FixedArray[Double], pad : Double) -> Bool {
  let bj = j * inst_size
  let bk = k * inst_size
  a[bj] - pad < a[bk] + a[bk + 2] &&
  a[bk] - pad < a[bj] + a[bj + 2] &&
  a[bj + 1] - pad < a[bk + 1] + a[bk + 3] &&
  a[bk + 1] - pad < a[bj + 1] + a[bj + 3]
}

fn Scene::glass_capture(self : Scene, k : Int, liquid : Bool, shares : Bool) -> Unit {
  let b = k * inst_size
  let a = self.inst
  let kind = a[b + 5]
  let blur = a[b + 7]
  let eff_blur = if liquid && blur < 0.0 { 0.0 } else { blur }
  let is_single_liquid = liquid && a[b + 23] <= 0.0
  let is_progressive = !liquid && a[b + 22] < -0.5
  if shares && !liquid && !is_progressive && self.frost_run != 0 {
    a[b + 20] = -self.frost_run.to_double()
    return
  }
  if shares &&
  is_single_liquid &&
  eff_blur >= 0.0 &&
  self.liquid_run != 0 &&
  self.liquid_blur == eff_blur &&
  self.liquid_first >= 0 {
    let ky0 = a[b + 1]
    let ky1 = ky0 + a[b + 3]
    let dy_gap = dmax(0.0, dmax(ky0 - self.liquid_y1, self.liquid_y0 - ky1))
    if dy_gap <= 64.0 {
      let run_tag = -self.liquid_run.to_double()
      let mut blocked = false
      let mut j = self.liquid_first
      while j < k {
        let pj = j * inst_size
        let jk = a[pj + 5]
        if jk != 2.0 &&
        jk != 12.0 &&
        a[pj + 20] != run_tag &&
        a[pj + 2] > 0.0 &&
        a[pj + 3] > 0.0 &&
        rects_meet_by(j, k, a, 0.0) {
          blocked = true
          break
        }
        j += 1
      }
      if !blocked {
        a[b + 20] = run_tag
        self.liquid_y0 = dmin(self.liquid_y0, ky0)
        self.liquid_y1 = dmax(self.liquid_y1, ky1)
        return
      }
    }
  }
  let prev = self.glass_run_start + self.glass_run_len
  let prev_is_single = liquid && k > 0 && a[(k - 1) * inst_size + 23] <= 0.0
  let prev_is_progressive = !liquid && k > 0 && a[(k - 1) * inst_size + 22] < -0.5
  let prev_eff_blur = if k > 0 {
    let pb = a[(k - 1) * inst_size + 7]
    if liquid && pb < 0.0 { 0.0 } else { pb }
  } else {
    0.0
  }
  let mut same = self.glass_run != 0 &&
  prev == k &&
  !is_progressive &&
  !prev_is_progressive &&
  eff_blur >= 0.0 &&
  a[(k - 1) * inst_size + 5] == kind &&
  prev_eff_blur == eff_blur &&
  (!liquid ||
    (is_single_liquid && prev_is_single) ||
    (!is_single_liquid && !prev_is_single && self.glass_run_len < 8))
  if same && (!liquid || is_single_liquid) {
    let pad = if is_single_liquid { 2.0 } else { 0.0 }
    if is_single_liquid && self.liquid_run == self.glass_run && self.liquid_first >= 0 {
      let ky0 = a[b + 1]
      let ky1 = ky0 + a[b + 3]
      let dy_gap = dmax(0.0, dmax(ky0 - self.liquid_y1, self.liquid_y0 - ky1))
      if dy_gap > 64.0 {
        same = false
      }
    }
    if same {
      let mut j = self.glass_run_start
      while j < k {
        if rects_meet_by(j, k, a, pad) {
          same = false
          break
        }
        j += 1
      }
    }
  }
  if same {
    self.glass_run_len = self.glass_run_len + 1
    if is_single_liquid && self.liquid_run == self.glass_run {
      self.liquid_y0 = dmin(self.liquid_y0, a[b + 1])
      self.liquid_y1 = dmax(self.liquid_y1, a[b + 1] + a[b + 3])
    }
  } else {
    self.glass_run = self.glass_run + 1
    self.glass_run_start = k
    self.glass_run_len = 1
    if !liquid && !is_progressive {
      self.frost_run = self.glass_run
      self.liquid_run = 0
      self.liquid_first = -1
    } else if is_single_liquid && eff_blur >= 0.0 {
      self.liquid_run = self.glass_run
      self.liquid_blur = eff_blur
      self.liquid_first = k
      self.liquid_y0 = a[b + 1]
      self.liquid_y1 = a[b + 1] + a[b + 3]
    } else {
      self.liquid_run = 0
      self.liquid_first = -1
    }
  }
  a[b + 20] = -self.glass_run.to_double()
}

pub fn effective_glass(gl : paint::Glass, frost : Double, contrast~ : Bool = false) -> paint::Glass {
  if frost <= 0.0001 && !contrast {
    return gl
  }
  // Exempt pure optical magnifying lenses (zoom > 1).
  if gl.liquid && (gl.tint & 0xFFL) == 0L && gl.zoom > 1.0001 {
    return gl
  }
  // Exempt progressive scroll-edge blur layers.
  if !gl.liquid && gl.progressive {
    return gl
  }
  let f = dmin(dmax(frost + (if contrast { 0.22 } else { 0.0 }), 0.0), 0.95)
  let mix = f * 0.5
  let clamp_byte = fn(v : Double) -> Int64 {
    let r = v.round().to_int64()
    if r < 0L { 0L } else if r > 255L { 255L } else { r }
  }
  let tr = ((gl.tint >> 24) & 0xFFL).to_double()
  let tg = ((gl.tint >> 16) & 0xFFL).to_double()
  let tb = ((gl.tint >> 8) & 0xFFL).to_double()
  let ta = (gl.tint & 0xFFL).to_double() / 255.0
  let sr = ((gl.solid >> 24) & 0xFFL).to_double()
  let sg = ((gl.solid >> 16) & 0xFFL).to_double()
  let sb = ((gl.solid >> 8) & 0xFFL).to_double()
  let nr = clamp_byte(tr + (sr - tr) * mix)
  let ng = clamp_byte(tg + (sg - tg) * mix)
  let nb = clamp_byte(tb + (sb - tb) * mix)
  let a_frac = ta + (0.94 - ta) * f
  let na = clamp_byte(a_frac * 255.0)
  let ntint = (nr << 24) | (ng << 16) | (nb << 8) | na
  // Keep slot 7 = -(16 * droplet_role) until droplet naturally fades to 0 at col.a = 0.102,
  // then smoothly ramp blur from 0 once a_frac > 0.12 (zero discontinuity at frost 0 -> eps or col.a ~ 0.102).
  let is_clear_droplet = gl.liquid && (gl.tint & 0xFFL) == 0L && gl.blur <= 0.0 && gl.droplet_role > 0 && !contrast
  let nblur = if is_clear_droplet {
    if a_frac <= 0.12 {
      0.0
    } else {
      dmax(14.0 * ((a_frac - 0.12) / 0.88) * 0.5, 0.01)
    }
  } else if gl.blur < 14.0 {
    gl.blur + (14.0 - gl.blur) * mix
  } else {
    gl.blur
  }
  let nrefraction = if gl.liquid {
    gl.refraction * (1.0 - 0.55 * f)
  } else {
    gl.refraction
  }
  let nrim = if contrast && gl.liquid { dmax(gl.rim, 0.85) } else { gl.rim }
  let nrim_edge = if contrast && !gl.liquid { dmax(gl.rim_edge, 1.0) } else { gl.rim_edge }
  let nchroma = if contrast && gl.liquid && gl.droplet_role == 0 { 0.0 } else { gl.chroma }
  paint::Glass::{
    ..gl,
    tint: ntint,
    blur: nblur,
    refraction: nrefraction,
    chroma: nchroma,
    rim: nrim,
    rim_edge: nrim_edge,
  }
}

fn encode_glass(
  scene : Scene,
  d : view::Drawn,
  gl : paint::Glass,
  node_scale : Double,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
) -> Unit {
  if gl.strength <= 0.001 {
    return
  }
  let eff_alpha = d.alpha * gl.strength
  if solid_now() {
    let idx = scene.push_inst(
      d.x, d.y, d.w, d.h, d.radius, 0.0, 0.0, 0.0, gl.solid, eff_alpha,
      0.0, 0.0, 0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    apply_node_corners(scene, idx, d)
    return
  }
  let gl = effective_glass(gl, frost_now(), contrast=contrast_now())
  let kind = if gl.liquid { 6.0 } else { 5.0 }
  let gblur = if gl.blur > 0.0 { gl.blur * node_scale } else { gl.blur }
  let blur_slot = if !gl.liquid {
    if gl.contained { -gblur } else { gblur }
  } else if gl.blur <= 0.0 && gl.droplet_role > 0 {
    let zd = if gl.zoom > 1.0001 { dmin(gl.zoom, 3.0) - 1.0 } else { 0.0 }
    -(16.0 * gl.droplet_role.to_double()) - zd
  } else if gl.blur <= 0.0 && gl.zoom > 1.0001 {
    -(dmin(gl.zoom, 3.0) - 1.0)
  } else {
    dmax(gblur, 0.0)
  }
  let p14 = if gl.liquid {
    let spot_v = glass_spot(gl.spot)
    if gl.adaptive { -(spot_v + 1.0) } else { spot_v }
  } else {
    gl.rim_back
  }
  let idx = scene.push_inst(
    d.x, d.y, d.w, d.h, d.radius, kind, gl.saturation, blur_slot, gl.tint, 1.0,
    if gl.liquid { gl.rim } else { gl.rim_edge },
    if gl.liquid { gl.bezel } else { gl.rim_lit },
    p14,
    eff_alpha,
    clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
  )
  let base = idx * inst_size
  if base + 23 < scene.inst.length() {
    scene.inst[base + 21] = dmax(gl.refraction, 0.0)
    scene.inst[base + 22] = if gl.liquid { gl.chroma } else if gl.progressive { -1.0 } else { 0.0 }
    scene.inst[base + 23] = if gl.liquid && gl.layer > 0 { 0.0 } else { gl.merge }
  }
  scene.glass_capture(idx, gl.liquid, gl.shares_capture)
  apply_node_corners(scene, idx, d)
}

fn emit_node_shadow(
  scene : Scene,
  d : view::Drawn,
  outside : Bool,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
  rc : (Double, Double, Double, Double),
) -> Unit {
  let (sblur, sy, scol) = d.shadow
  if sblur > 0.0 && (scol & 0xFFL) != 0L {
    let sidx = scene.push_inst(
      d.x, d.y + sy, d.w, d.h, d.radius, 2.0, 0.0, sblur, scol, d.alpha,
      if outside { 1.0 } else { 0.0 },
      if outside { sy } else { 0.0 },
      0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    apply_node_corners(scene, sidx, d)
    scene.set_clip_corners(sidx, rc.0, rc.1, rc.2, rc.3)
    if d.turn != 0.0 {
      let sb = sidx * inst_size
      scene.inst[sb + 32] = d.turn
      scene.inst[sb + 33] = d.x + d.w * 0.5
      scene.inst[sb + 34] = d.y + d.h * 0.5
      scene.inst[sb + 35] = 1.0
    }
  }
}

struct DeferredGlassShadow {
  d : view::Drawn
  clip : (Double, Double, Double, Double)
  rc : (Double, Double, Double, Double)
}

fn flush_deferred_shadows(scene : Scene, pending : Array[DeferredGlassShadow]) -> Unit {
  if pending.length() == 0 {
    return
  }
  for item in pending {
    let (cx0, cy0, cx1, cy1) = item.clip
    emit_node_shadow(scene, item.d, true, cx0, cy0, cx1, cy1, item.rc)
  }
  pending.clear()
}

/// Per-frame node-level `ViewBlock` cache accounting (`made`: encoded fresh, `copied`: reused from cache, `handed`: total instances emitted).
pub struct ViewPaintWork {
  pub mut made : Int
  pub mut copied : Int
  pub mut handed : Int
}

struct ViewBlock {
  gen : Int
  w : Double
  h : Double
  radius : Double
  corners : Option[(Double, Double, Double, Double)]
  ground : Int64
  edge_w : Double
  edge_col : Int64
  alpha : Double
  words : String
  runs : Array[text::Run]
  runs_code_ground : Int64
  words_size : Double
  words_weight : Int
  words_line : Double
  words_wrap : Bool
  words_tracking : view::Spacing
  words_balance : Bool
  words_max_lines : Int
  words_center : Bool
  words_optical : Bool
  ink : Int64
  ellipsis_past : Bool
  clips_self : Bool
  image : Option[(String, String, Int)]
  image_in : Option[((Double, Double, Double, Double), Int64)]
  image_cover : Bool
  image_contain : Bool
  image_cover_at : Option[(Double, Double)]
  ring_w : Double
  ring_gap : Double
  ring_col : Int64
  shadow_blur : Double
  shadow_y : Double
  shadow_col : Int64
  shadow_outside : Bool
  gd_dx : Double
  gd_dy : Double
  gd_dw : Double
  gd_dh : Double
  gd_corners : Option[(Double, Double, Double, Double)]
  rects : Array[paint::Rect]
  node_scale : Double
  scale : Double
  sub_x : Double
  sub_y : Double
  atlas_gen : Int
  ninst : Int
  after_ground_n : Int
  words_start : Int
  words_end : Int
  words_square_clip : Bool
  mono_glyph_plots : Array[Int]
  colour_glyph_plots : Array[Int]
  image_obs : Array[(String, Option[(Int, Double, Double)])]
  image_epoch : Int
  inst : Array[Double]
}

struct ViewBlocksState {
  mut enabled : Bool
  mut atlas_gen : Int
  mut solid : Bool
  mut blocks : Array[Option[ViewBlock]]
  work : ViewPaintWork
  scratch : Scene
}

let view_blocks_state : ViewBlocksState = ViewBlocksState::{
  enabled: true,
  atlas_gen: -1,
  solid: false,
  blocks: [],
  work: ViewPaintWork::{ made: 0, copied: 0, handed: 0 },
  scratch: Scene::new(),
}

pub fn view_paint_work_now() -> ViewPaintWork {
  ViewPaintWork::{
    made: view_blocks_state.work.made,
    copied: view_blocks_state.work.copied,
    handed: view_blocks_state.work.handed,
  }
}

pub fn view_paint_work_reset() -> Unit {
  view_blocks_state.work.made = 0
  view_blocks_state.work.copied = 0
  view_blocks_state.work.handed = 0
}

pub fn set_view_blocks_enabled(on : Bool) -> Unit {
  view_blocks_state.enabled = on
  if !on {
    view_blocks_state.blocks.clear()
  }
}

pub enum DamageReport {
  Full
  None
  Rects(Array[(Double, Double, Double, Double)])
}

let last_damage_report : signals::Ref[DamageReport] = ref_new(DamageReport::None)
let damage_report_poison : signals::Ref[Option[DamageReport]] = ref_new(None)
let view_block_poison : signals::Ref[Bool] = ref_new(false)
let in_frame_looks_hook : signals::Ref[Option[(Scene, Scene, DamageReport, Double, Double, Double, Double, Double, Double) -> Unit]] = ref_new(None)

/// Return the normalized `DamageReport` captured by the last `view_frame` in the active window.
pub fn view_last_damage_report() -> DamageReport {
  last_damage_report.v
}

/// Test-only hook: force `view_frame` to report a poisoned `DamageReport` (`None` disables poison).
pub fn set_damage_report_poison(p : Option[DamageReport]) -> Unit {
  damage_report_poison.v = p
}

/// Test-only hook: force `view_blocks` to reuse stale cached blocks on cacheable nodes.
pub fn set_view_block_poison(on : Bool) -> Unit {
  view_block_poison.v = on
}

/// Install or clear the in-frame reference-vs-production scene & damage parity hook.
pub fn set_in_frame_looks_hook(
  f : Option[(Scene, Scene, DamageReport, Double, Double, Double, Double, Double, Double) -> Unit],
) -> Unit {
  in_frame_looks_hook.v = f
}

/// Return the current display text (respecting secret masking and IME composition) or placeholder hint
/// for a `ui::field` node, if `id` is a field in the active window.
pub fn field_display_or_hint(id : view::NodeId) -> Option[String] {
  match find_tree_field(id) {
    Some(tf) => {
      let txt = tf.field.text_sig.untracked()
      let comp = signals::untracked(fn() { tf.field.composed_said() })
      if txt.length() > 0 || comp.length() > 0 {
        Some(tf.field.editor.display_text())
      } else {
        let primary = signals::untracked(tf.hint)
        let sz = signals::untracked(tf.font_size)
        Some(pick_placeholder(primary, tf.shorter, tf.field.last_max_w, sz))
      }
    }
    None => None
  }
}

fn normalize_damage_report(
  dirty : Array[(Double, Double, Double, Double)],
  force_full : Bool,
) -> DamageReport {
  if force_full {
    return DamageReport::Full
  }
  if dirty.length() == 0 {
    return DamageReport::None
  }
  for r in dirty {
    if r.2 < 0.0 || r.3 < 0.0 {
      return DamageReport::Full
    }
  }
  DamageReport::Rects(dirty.copy())
}

fn view_blocks_reset() -> Unit {
  view_blocks_state.blocks.clear()
  view_blocks_state.atlas_gen = -1
  view_blocks_state.solid = false
  view_block_poison.v = false
}

fn view_blocks_sync_frame() -> Unit {
  let gen = glyph_state.epoch
  let solid = solid_now()
  if view_blocks_state.atlas_gen != gen || view_blocks_state.solid != solid {
    view_blocks_state.blocks.clear()
    view_blocks_state.atlas_gen = gen
    view_blocks_state.solid = solid
  }
}

fn opt_quad_eq(
  a : Option[(Double, Double, Double, Double)],
  b : Option[(Double, Double, Double, Double)],
) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((a0, a1, a2, a3)), Some((b0, b1, b2, b3))) =>
    a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3
    _ => false
  }
}

fn opt_image_eq(
  a : Option[(String, String, Int)],
  b : Option[(String, String, Int)],
) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((a0, a1, a2)), Some((b0, b1, b2))) => a0 == b0 && a1 == b1 && a2 == b2
    _ => false
  }
}

fn opt_pair_eq(a : Option[(Double, Double)], b : Option[(Double, Double)]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some((a0, a1)), Some((b0, b1))) => a0 == b0 && a1 == b1
    _ => false
  }
}

fn opt_image_in_eq(
  a : Option[((Double, Double, Double, Double), Int64)],
  b : Option[((Double, Double, Double, Double), Int64)],
) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(((a0, a1, a2, a3), am)), Some(((b0, b1, b2, b3), bm))) =>
    a0 == b0 && a1 == b1 && a2 == b2 && a3 == b3 && am == bm
    _ => false
  }
}

fn spacing_eq(a : view::Spacing, b : view::Spacing) -> Bool {
  match (a, b) {
    (view::Spacing::Ems(x), view::Spacing::Ems(y)) => x == y
    (view::Spacing::Points(x), view::Spacing::Points(y)) => x == y
    (view::Spacing::ScaledPoints(x), view::Spacing::ScaledPoints(y)) => x == y
    _ => false
  }
}

fn run_opt_int_eq(a : Option[Int], b : Option[Int]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x == y
    _ => false
  }
}

fn opt_run_ground_eq(a : Option[text::Ground], b : Option[text::Ground]) -> Bool {
  match (a, b) {
    (None, None) => true
    (Some(x), Some(y)) => x.room == y.room && x.height == y.height && x.corner == y.corner && x.after == y.after
    _ => false
  }
}

fn runs_has_drawing(runs : Array[text::Run]) -> Bool {
  let n = runs.length()
  let mut i = 0
  while i < n {
    if runs[i].drawing.is_some() {
      return true
    }
    i += 1
  }
  false
}

fn runs_eq(a : Array[text::Run], b : Array[text::Run]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let ra = a[i]
    let rb = b[i]
    if ra.text != rb.text ||
    ra.weight != rb.weight ||
    ra.italic != rb.italic ||
    ra.code != rb.code ||
    ra.mono != rb.mono ||
    ra.serif != rb.serif ||
    !run_opt_int_eq(ra.face, rb.face) ||
    ra.scale != rb.scale ||
    ra.color != rb.color ||
    ra.bg != rb.bg ||
    !opt_run_ground_eq(ra.ground, rb.ground) ||
    ra.strike != rb.strike ||
    ra.underline != rb.underline ||
    ra.link != rb.link {
      return false
    }
    i += 1
  }
  true
}

fn rects_eq(a : Array[paint::Rect], b : Array[paint::Rect]) -> Bool {
  let n = a.length()
  if n != b.length() {
    return false
  }
  let mut i = 0
  while i < n {
    let ra = a[i]
    let rb = b[i]
    if ra.x != rb.x ||
    ra.y != rb.y ||
    ra.w != rb.w ||
    ra.h != rb.h ||
    ra.color != rb.color ||
    ra.corners.0 != rb.corners.0 ||
    ra.corners.1 != rb.corners.1 ||
    ra.corners.2 != rb.corners.2 ||
    ra.corners.3 != rb.corners.3 {
      return false
    }
    i += 1
  }
  true
}

fn view_block_matches(
  blk : ViewBlock,
  d : view::Drawn,
  gd : view::GroundShape,
  eff_font_size : Double,
  node_scale : Double,
  scale : Double,
  sub_x : Double,
  sub_y : Double,
  atlas_gen : Int,
  shadow_out : Bool,
) -> Bool {
  blk.gen == d.id.gen &&
  blk.atlas_gen == atlas_gen &&
  (blk.sub_x - sub_x).abs() < 1.0e-4 &&
  (blk.sub_y - sub_y).abs() < 1.0e-4 &&
  blk.w == d.w &&
  blk.h == d.h &&
  blk.radius == d.radius &&
  blk.ground == d.ground &&
  blk.edge_w == d.edge.0 &&
  blk.edge_col == d.edge.1 &&
  blk.alpha == d.alpha &&
  blk.ink == d.ink &&
  blk.ellipsis_past == d.ellipsis_past &&
  blk.clips_self == d.clips_self &&
  blk.words_size == eff_font_size &&
  blk.words_weight == d.words_look.weight &&
  blk.words_line == d.words_look.line &&
  blk.words_wrap == d.words_look.wrap &&
  blk.words_balance == d.words_look.balance &&
  blk.words_max_lines == d.words_look.max_lines &&
  blk.words_center == d.words_center &&
  blk.words_optical == d.words_optical &&
  blk.ring_w == d.ring.0 &&
  blk.ring_gap == d.ring.1 &&
  blk.ring_col == d.ring.2 &&
  blk.shadow_blur == d.shadow.0 &&
  blk.shadow_y == d.shadow.1 &&
  blk.shadow_col == d.shadow.2 &&
  blk.shadow_outside == shadow_out &&
  blk.gd_dx == gd.dx &&
  blk.gd_dy == gd.dy &&
  blk.gd_dw == gd.dw &&
  blk.gd_dh == gd.dh &&
  blk.node_scale == node_scale &&
  blk.scale == scale &&
  blk.words == d.words &&
  spacing_eq(blk.words_tracking, d.words_look.tracking) &&
  opt_quad_eq(blk.corners, d.corners) &&
  opt_quad_eq(blk.gd_corners, gd.corners) &&
  opt_image_eq(blk.image, d.image) &&
  opt_image_in_eq(blk.image_in, d.image_in) &&
  blk.image_cover == d.image_cover &&
  blk.image_contain == d.image_contain &&
  opt_pair_eq(blk.image_cover_at, d.image_cover_at) &&
  ((blk.image_obs.length() == 0 && d.image is None) || blk.image_epoch == image_invalidate_epoch.v) &&
  blk.runs_code_ground == d.runs_look.code_ground &&
  runs_eq(blk.runs, d.runs) &&
  rects_eq(blk.rects, d.rects)
}

fn quant_i64(x : Double) -> Int64 {
  if x >= 0.0 {
    (x * 1000.0 + 0.5).to_int64()
  } else {
    (x * 1000.0 - 0.5).to_int64()
  }
}

fn compose_view_block(
  scene : Scene,
  blk : ViewBlock,
  d : view::Drawn,
  gd : view::GroundShape,
  node_scale : Double,
  clip : (Double, Double, Double, Double),
  rc : (Double, Double, Double, Double),
) -> Unit {
  let cnt = blk.ninst
  if cnt <= 0 {
    return
  }
  let (clip_x, clip_y, clip_x1, clip_y1) = clip
  let has_rc = rc.0 > 0.0 || rc.1 > 0.0 || rc.2 > 0.0 || rc.3 > 0.0
  let has_rot = d.turn != 0.0
  let dx = d.x - blk.sub_x
  let dy = d.y - blk.sub_y
  let src = blk.inst
  let base_inst = scene.ninst
  scene.ensure_inst_len((base_inst + cnt) * inst_size)
  let dst = scene.inst
  if !has_rc && !has_rot && !blk.words_square_clip {
    // Fast unrolled path: zero inner loop, zero Array::push, straight-line indexed stores.
    let mut j = 0
    while j < cnt {
      let sb = j * inst_size
      let db = (base_inst + j) * inst_size
      dst[db] = src[sb] + dx
      dst[db + 1] = src[sb + 1] + dy
      dst[db + 2] = src[sb + 2]
      dst[db + 3] = src[sb + 3]
      dst[db + 4] = src[sb + 4]
      dst[db + 5] = src[sb + 5]
      dst[db + 6] = src[sb + 6]
      dst[db + 7] = src[sb + 7]
      dst[db + 8] = src[sb + 8]
      dst[db + 9] = src[sb + 9]
      dst[db + 10] = src[sb + 10]
      dst[db + 11] = src[sb + 11]
      dst[db + 12] = src[sb + 12]
      dst[db + 13] = src[sb + 13]
      dst[db + 14] = src[sb + 14]
      dst[db + 15] = src[sb + 15]
      dst[db + 16] = clip_x
      dst[db + 17] = clip_y
      dst[db + 18] = clip_x1
      dst[db + 19] = clip_y1
      dst[db + 20] = src[sb + 20]
      dst[db + 21] = src[sb + 21]
      dst[db + 22] = src[sb + 22]
      dst[db + 23] = src[sb + 23]
      dst[db + 24] = 0.0
      dst[db + 25] = 0.0
      dst[db + 26] = 0.0
      dst[db + 27] = 0.0
      dst[db + 28] = 0.0
      dst[db + 29] = 0.0
      dst[db + 30] = 0.0
      dst[db + 31] = 0.0
      dst[db + 32] = 0.0
      dst[db + 33] = 0.0
      dst[db + 34] = 0.0
      dst[db + 35] = 0.0
      dst[db + 36] = src[sb + 36]
      dst[db + 37] = src[sb + 37]
      dst[db + 38] = src[sb + 38]
      dst[db + 39] = src[sb + 39]
      dst[db + 40] = 0.0
      dst[db + 41] = 0.0
      dst[db + 42] = 0.0
      dst[db + 43] = 0.0
      dst[db + 44] = 0.0
      dst[db + 45] = 0.0
      dst[db + 46] = 0.0
      dst[db + 47] = 0.0
      dst[db + 48] = 0.0
      dst[db + 49] = 0.0
      dst[db + 50] = 0.0
      dst[db + 51] = 0.0
      dst[db + 52] = 0.0
      dst[db + 53] = 0.0
      dst[db + 54] = 0.0
      dst[db + 55] = 0.0
      dst[db + 56] = 0.0
      dst[db + 57] = 0.0
      dst[db + 58] = 0.0
      dst[db + 59] = 0.0
      j += 1
    }
  } else {
    let gox = d.x + gd.dx * node_scale + (d.w + gd.dw * node_scale) * 0.5
    let goy = d.y + gd.dy * node_scale + (d.h + gd.dh * node_scale) * 0.5
    let ox = d.x + d.w * 0.5
    let oy = d.y + d.h * 0.5
    let mut j = 0
    while j < cnt {
      let sb = j * inst_size
      let db = (base_inst + j) * inst_size
      dst[db] = src[sb] + dx
      dst[db + 1] = src[sb + 1] + dy
      dst[db + 2] = src[sb + 2]
      dst[db + 3] = src[sb + 3]
      dst[db + 4] = src[sb + 4]
      dst[db + 5] = src[sb + 5]
      dst[db + 6] = src[sb + 6]
      dst[db + 7] = src[sb + 7]
      dst[db + 8] = src[sb + 8]
      dst[db + 9] = src[sb + 9]
      dst[db + 10] = src[sb + 10]
      dst[db + 11] = src[sb + 11]
      dst[db + 12] = src[sb + 12]
      dst[db + 13] = src[sb + 13]
      dst[db + 14] = src[sb + 14]
      dst[db + 15] = src[sb + 15]
      let is_sq_words = blk.words_square_clip && j >= blk.words_start && j < blk.words_end
      if is_sq_words {
        dst[db + 16] = dmax(clip_x, src[sb + 16] + dx)
        dst[db + 17] = dmax(clip_y, src[sb + 17] + dy)
        dst[db + 18] = dmin(clip_x1, src[sb + 18] + dx)
        dst[db + 19] = if src[sb + 19] < 5.0e8 { dmin(clip_y1, src[sb + 19] + dy) } else { clip_y1 }
      } else {
        dst[db + 16] = clip_x
        dst[db + 17] = clip_y
        dst[db + 18] = clip_x1
        dst[db + 19] = clip_y1
      }
      dst[db + 20] = src[sb + 20]
      dst[db + 21] = src[sb + 21]
      dst[db + 22] = src[sb + 22]
      dst[db + 23] = src[sb + 23]
      if has_rc && !is_sq_words {
        dst[db + 24] = rc.0
        dst[db + 25] = rc.1
        dst[db + 26] = rc.2
        dst[db + 27] = rc.3
      } else {
        dst[db + 24] = 0.0
        dst[db + 25] = 0.0
        dst[db + 26] = 0.0
        dst[db + 27] = 0.0
      }
      dst[db + 28] = 0.0
      dst[db + 29] = 0.0
      dst[db + 30] = 0.0
      dst[db + 31] = 0.0
      if has_rot {
        dst[db + 32] = d.turn
        dst[db + 33] = if j < blk.after_ground_n { gox } else { ox }
        dst[db + 34] = if j < blk.after_ground_n { goy } else { oy }
        dst[db + 35] = 1.0
      } else {
        dst[db + 32] = 0.0
        dst[db + 33] = 0.0
        dst[db + 34] = 0.0
        dst[db + 35] = 0.0
      }
      dst[db + 36] = src[sb + 36]
      dst[db + 37] = src[sb + 37]
      dst[db + 38] = src[sb + 38]
      dst[db + 39] = src[sb + 39]
      dst[db + 40] = 0.0
      dst[db + 41] = 0.0
      dst[db + 42] = 0.0
      dst[db + 43] = 0.0
      dst[db + 44] = 0.0
      dst[db + 45] = 0.0
      dst[db + 46] = 0.0
      dst[db + 47] = 0.0
      dst[db + 48] = 0.0
      dst[db + 49] = 0.0
      dst[db + 50] = 0.0
      dst[db + 51] = 0.0
      dst[db + 52] = 0.0
      dst[db + 53] = 0.0
      dst[db + 54] = 0.0
      dst[db + 55] = 0.0
      dst[db + 56] = 0.0
      dst[db + 57] = 0.0
      dst[db + 58] = 0.0
      dst[db + 59] = 0.0
      j += 1
    }
  }
  scene.ninst = base_inst + cnt
  scene.glass_run_start = -1
  scene.glass_run_len = 0
}

fn encode_view_magnified(
  scene : Scene,
  d : view::Drawn,
  gd : view::GroundShape,
  node_scale : Double,
  sx : Double,
  sy : Double,
  z : Double,
  own : Int,
) -> Unit {
  if z <= 0.0 || d.alpha <= 0.0 {
    return
  }
  let lx = d.x + gd.dx * node_scale
  let ly = d.y + gd.dy * node_scale
  let lw = d.w + gd.dw * node_scale
  let lh = d.h + gd.dh * node_scale
  if lw <= 0.0 || lh <= 0.0 {
    return
  }
  let cx = lx + lw * 0.5
  let cy = ly + lh * 0.5
  let lrc = match gd.corners {
    Some((c0, c1, c2, c3)) => (c0 * node_scale, c1 * node_scale, c2 * node_scale, c3 * node_scale)
    None => node_corners_tuple(d)
  }
  let qx0 = sx - lw * 0.5 / z
  let qy0 = sy - lh * 0.5 / z
  let qx1 = sx + lw * 0.5 / z
  let qy1 = sy + lh * 0.5 / z
  let dx = cx - sx
  let dy = cy - sy
  let lx1 = lx + lw
  let ly1 = ly + lh

  let mut k = 0
  while k < own {
    let b = k * inst_size
    let kind = scene.inst[b + 5]
    if kind == 7.0 || kind == 9.0 || kind == 12.0 || kind == 14.0 || kind == 15.0 {
      k += 1
      continue
    }
    let ix = scene.inst[b]
    let iy = scene.inst[b + 1]
    let iw = scene.inst[b + 2]
    let ih = scene.inst[b + 3]
    if ix > qx1 || iy > qy1 || ix + iw < qx0 || iy + ih < qy0 {
      k += 1
      continue
    }
    let ic0 = scene.inst[b + 16]
    let ic1 = scene.inst[b + 17]
    let ic2 = scene.inst[b + 18]
    let ic3 = scene.inst[b + 19]
    let has_src_clip = ic2 > ic0 && ic3 > ic1
    if has_src_clip && (ic0 > qx1 || ic1 > qy1 || ic2 < qx0 || ic3 < qy0) {
      k += 1
      continue
    }

    let dst = scene.ninst
    let db = dst * inst_size
    let need = db + inst_size
    scene.ensure_inst_len(need)
    let mut j = 0
    while j < inst_size {
      scene.inst[db + j] = scene.inst[b + j]
      j += 1
    }
    scene.ninst = dst + 1

    // Glass backdrop copied as solid tint fill.
    if kind == 5.0 || kind == 6.0 {
      scene.inst[db + 5] = 0.0
      scene.inst[db + 11] = scene.inst[db + 15]
      scene.inst[db + 6] = 0.0
      scene.inst[db + 7] = 0.0
      scene.inst[db + 12] = 0.0
      scene.inst[db + 13] = 0.0
      scene.inst[db + 14] = 0.0
      scene.inst[db + 15] = 0.0
      scene.inst[db + 20] = 0.0
      scene.inst[db + 21] = 0.0
      scene.inst[db + 22] = 0.0
      scene.inst[db + 23] = 0.0
    }
    scene.inst[db + 11] = scene.inst[db + 11] * d.alpha

    // Transform geometry about (sx, sy) by zoom z and translate to loupe center (cx, cy).
    scene.inst[db] = sx + (scene.inst[db] - sx) * z + dx
    scene.inst[db + 1] = sy + (scene.inst[db + 1] - sy) * z + dy
    scene.inst[db + 2] = scene.inst[db + 2] * z
    scene.inst[db + 3] = scene.inst[db + 3] * z
    scene.inst[db + 4] = scene.inst[db + 4] * z
    scene.inst[db + 36] = scene.inst[db + 36] * z
    scene.inst[db + 37] = scene.inst[db + 37] * z
    scene.inst[db + 38] = scene.inst[db + 38] * z
    scene.inst[db + 39] = scene.inst[db + 39] * z
    let dkind = scene.inst[db + 5]
    if dkind != 5.0 && dkind != 6.0 {
      scene.inst[db + 6] = scene.inst[db + 6] * z
      scene.inst[db + 7] = scene.inst[db + 7] * z
    }
    if dkind == 0.0 || dkind == 5.0 {
      scene.inst[db + 21] = scene.inst[db + 21] * z
      scene.inst[db + 22] = scene.inst[db + 22] * z
      scene.inst[db + 23] = scene.inst[db + 23] * z
    }
    if scene.inst[db + 32] != 0.0 {
      scene.inst[db + 33] = sx + (scene.inst[db + 33] - sx) * z + dx
      scene.inst[db + 34] = sy + (scene.inst[db + 34] - sy) * z + dy
    }

    // Transform source clip and intersect with the loupe rounded capsule.
    let (nc0, nc1, nc2, nc3) = if has_src_clip && ic2 < 1.0e8 && ic3 < 1.0e8 {
      let tc0 = sx + (ic0 - sx) * z + dx
      let tc1 = sy + (ic1 - sy) * z + dy
      let tc2 = sx + (ic2 - sx) * z + dx
      let tc3 = sy + (ic3 - sy) * z + dy
      (dmax(lx, tc0), dmax(ly, tc1), dmin(lx1, tc2), dmin(ly1, tc3))
    } else {
      (lx, ly, lx1, ly1)
    }
    scene.inst[db + 16] = nc0
    scene.inst[db + 17] = nc1
    scene.inst[db + 18] = nc2
    scene.inst[db + 19] = nc3
    scene.inst[db + 24] = lrc.0
    scene.inst[db + 25] = lrc.1
    scene.inst[db + 26] = lrc.2
    scene.inst[db + 27] = lrc.3
    // Clear inherited outer clip/fade so loupe's own rounded capsule governs clipping.
    scene.inst[db + 40] = 0.0
    scene.inst[db + 41] = 0.0
    scene.inst[db + 42] = 0.0
    scene.inst[db + 43] = 0.0
    k += 1
  }
}

/// Shared ground-emission predicate used by both `encode_held_tree` scrim pre-scan and `encode_drawn_node_direct`.
fn node_emits_ground(d : view::Drawn, gd : view::GroundShape, node_scale : Double) -> Bool {
  if d.alpha <= 0.0 || (d.ground & 0xFFL) == 0L {
    return false
  }
  let gw = d.w + gd.dw * node_scale
  let gh = d.h + gd.dh * node_scale
  gw > 0.0 && gh > 0.0
}

fn encode_drawn_node_direct(
  scene : Scene,
  tree_id : Int,
  d : view::Drawn,
  gd : view::GroundShape,
  node_scale : Double,
  frame_no : Int,
  now : Double,
  scale : Double,
  clip : (Double, Double, Double, Double),
  rc : (Double, Double, Double, Double),
  deferred_shadows : Array[DeferredGlassShadow],
  mag : Option[(Double, Double, Double)],
  mag_own : Int,
  shadow_out : Bool,
  bypass_blocks~ : Bool = false,
) -> (Int, Int, Int, Bool, Bool) {
  let (clip_x, clip_y, clip_x1, clip_y1) = clip
  // Drawn `ns` times its laid-out size (View::scale, page zoom): Tree::drawn_held has its box and corners that size
  // already; all it draws inside them, given in its own laid-out points (edge, rects, shapes, lines, words, shadow,
  // ring, caret), is taken `ns` times here.
  let ns = if node_scale > 0.0 { node_scale } else { 1.0 }
  let gx = d.x + gd.dx * node_scale
  let gy = d.y + gd.dy * node_scale
  let gw = d.w + gd.dw * node_scale
  let gh = d.h + gd.dh * node_scale
  let gcorners = match gd.corners {
    Some((c0, c1, c2, c3)) => Some((c0 * node_scale, c1 * node_scale, c2 * node_scale, c3 * node_scale))
    None => d.corners
  }
  let gradius = match gcorners {
    Some((c0, _, _, _)) => c0
    None => d.radius
  }
  let gd_visible = gw > 0.0 && gh > 0.0
  let (sblur0, sy0, scol0) = d.shadow
  let gd_d = view::Drawn::{
    ..d,
    x: gx,
    y: gy,
    w: gw,
    h: gh,
    radius: gradius,
    corners: gcorners,
    shadow: (sblur0 * ns, sy0 * ns, scol0),
  }
  let eff_glass = match d.glass {
    Some(gl) if gl.strength > 0.001 => Some(gl)
    _ => None
  }
  let is_glass = eff_glass.is_some() && !solid_now()
  let is_merged_liquid = match eff_glass {
    Some(gl) => gl.liquid && gl.merge > 0.0 && gl.layer <= 0 && !solid_now()
    None => false
  }
  if !is_merged_liquid {
    flush_deferred_shadows(scene, deferred_shadows)
  }
  let start_idx = scene.ninst

  // 1. Non-glass shadow drawn before ground (glass shadow is drawn after glass, outside-only)
  if gd_visible && !is_glass {
    emit_node_shadow(scene, gd_d, shadow_out, clip_x, clip_y, clip_x1, clip_y1, rc)
  }

  // 2. Glass (kind 5 frosted / 6 liquid) + outside-only shadow after glass
  match eff_glass {
    Some(gl) if gd_visible => {
      encode_glass(scene, gd_d, gl, ns, clip_x, clip_y, clip_x1, clip_y1)
      if is_glass {
        let (sblur, _sy, scol) = d.shadow
        if sblur > 0.0 && (scol & 0xFFL) != 0L {
          if is_merged_liquid {
            deferred_shadows.push(DeferredGlassShadow::{ d: gd_d, clip, rc })
          } else {
            emit_node_shadow(scene, gd_d, true, clip_x, clip_y, clip_x1, clip_y1, rc)
          }
        }
      }
    }
    _ => ()
  }

  // 3. Ground fill + Border/edge merged into a single kind=0.0 instance (apple_render.m:629-634: bw=p6, bc=c2)
  // When magnifying (`mag.is_some()`), draw ground first, then magnified content clipped to the capsule,
  // then the crisp border rim on top.
  let (ew_raw, ecol) = d.edge
  let ew = ew_raw * ns
  let has_ground = node_emits_ground(d, gd, node_scale)
  let has_edge = ew > 0.0 && (ecol & 0xFFL) != 0L
  match mag {
    Some((msx, msy, mz)) if gd_visible && mz > 0.0 => {
      if has_ground {
        let idx = scene.push_inst(
          gd_d.x, gd_d.y, gd_d.w, gd_d.h, gd_d.radius, 0.0,
          0.0, 0.0, d.ground, d.alpha,
          0.0, 0.0, 0.0, 0.0,
          clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
        )
        apply_node_corners(scene, idx, gd_d)
      }
      encode_view_magnified(scene, d, gd, node_scale, msx, msy, mz, mag_own)
      if has_edge {
        let (br, bg_c, bb, ba) = color_rgba_tuple(ecol, d.alpha)
        let eidx = scene.push_inst(
          gd_d.x, gd_d.y, gd_d.w, gd_d.h, gd_d.radius, 0.0,
          ew, 0.0, 0L, d.alpha,
          br, bg_c, bb, ba,
          clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
        )
        apply_node_corners(scene, eidx, gd_d)
      }
    }
    _ =>
    if gd_visible && (has_ground || has_edge) {
      let eff_ecol = if has_ground && has_edge && (ecol & 0xFFL) < 0xFFL {
        over_rgba(d.ground, ecol)
      } else {
        ecol
      }
      let (br, bg_c, bb, ba) = if has_edge { color_rgba_tuple(eff_ecol, d.alpha) } else { (0.0, 0.0, 0.0, 0.0) }
      let idx = scene.push_inst(
        gd_d.x, gd_d.y, gd_d.w, gd_d.h, gd_d.radius, 0.0,
        if has_edge { ew } else { 0.0 },
        0.0,
        if has_ground { d.ground } else { 0L },
        d.alpha,
        br, bg_c, bb, ba,
        clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
      )
      apply_node_corners(scene, idx, gd_d)
    }
  }
  let after_ground_idx = scene.ninst

  // 4. Image (kind 4) — clamp req_px to actual physical drawn size (libs/mbui/src/ui/image.mbt:768)
  let mut image_settled = true
  match d.image {
    Some((src, ph, max_px)) => {
      let drawn_px = (dmax(d.w, d.h) * dmax(scale, 1.0)).ceil().to_int()
      let px = if drawn_px > 0 {
        if max_px > 0 && drawn_px > max_px { max_px } else { drawn_px }
      } else if max_px > 0 {
        if max_px > 256 { 256 } else { max_px }
      } else {
        256
      }
      image_obs_node_at.v = d.id.at
      image_obs_node_gen.v = d.id.gen
      image_obs_call_slot.v = 0
      image_resolve_transitional.v = false
      let primary = if src != "" { image_resolve(src, px, frame_no, now) } else { None }
      let resolved = match primary {
        Some(_) => primary
        None => {
          if src != "" {
            image_settled = false
          }
          if ph != "" && ph != src {
            image_obs_call_slot.v = 1
            image_resolve(ph, px, frame_no, now)
          } else {
            None
          }
        }
      }
      if image_resolve_transitional.v {
        image_settled = false
      }
      image_resolve_transitional.v = false
      image_obs_node_at.v = -1
      image_obs_node_gen.v = -1
      image_obs_call_slot.v = 0
      match resolved {
        Some((hid, iw, ih)) => {
          let mut ix = d.x
          let mut iy = d.y
          let mut rw = d.w
          let mut rh = d.h
          let mut u0 = 0.0
          let mut v0 = 0.0
          let mut du = 1.0
          let mut dv = 1.0
          if iw > 0.0 && ih > 0.0 && d.w > 0.0 && d.h > 0.0 {
            match d.image_cover_at {
              Some((ax, ay)) => {
                let across = dclamp(ax, 0.0, 1.0)
                let down = dclamp(ay, 0.0, 1.0)
                let ir = iw / ih
                let br = d.w / d.h
                if ir > br {
                  du = br / ir
                  u0 = (1.0 - du) * across
                } else if ir < br {
                  dv = ir / br
                  v0 = (1.0 - dv) * down
                }
              }
              None =>
              if d.image_cover {
                let ir = iw / ih
                let br = d.w / d.h
                if ir > br {
                  du = br / ir
                  u0 = (1.0 - du) * 0.5
                } else if ir < br {
                  dv = ir / br
                  v0 = (1.0 - dv) * 0.5
                }
              } else if d.image_contain {
                let k = dmin(d.w / iw, d.h / ih)
                rw = iw * k
                rh = ih * k
                ix = d.x + (d.w - rw) * 0.5
                iy = d.y + (d.h - rh) * 0.5
              }
            }
          }
          let idx = scene.push_inst(
            ix, iy, rw, rh, d.radius, 4.0, 0.0, 0.0, c64(0xFFFF, 0xFFFF), d.alpha,
            u0, v0, du, dv,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
            tex_id=hid.to_double(),
          )
          apply_node_corners(scene, idx, d)
        }
        None => image_settled = false
      }
    }
    None => ()
  }

  // 5. Tree stream node (kind 4 with stream_tex_base + stream.id)
  match find_tree_stream(d.id) {
    Some(ts) => {
      if !bypass_blocks {
        ts.drawn_this_frame = true
      }
      match ts.stream.size {
        Some((pw, ph)) if !ts.stream.closed && ts.stream.id > 0 && pw > 0 && ph > 0 => {
          let idx = scene.push_inst(
            d.x, d.y, d.w, d.h, d.radius, 4.0, 0.0, 0.0, c64(0xFFFF, 0xFFFF), d.alpha,
            0.0, 0.0, 1.0, 1.0,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
            tex_id=(hostapi::stream_tex_base + ts.stream.id).to_double(),
          )
          apply_node_corners(scene, idx, d)
        }
        _ => ()
      }
    }
    None => ()
  }

  // 6. Tree native view node
  match find_tree_native(d.id) {
    Some(tn) => {
      if !bypass_blocks {
        tn.drawn_this_frame = true
        if !tn.view.closed && tn.view.id > 0 {
          hostapi::view_place(
            tn.view.id, d.x, d.y, d.w, d.h,
            clip_x, clip_y, clip_x1, clip_y1,
            rc.0, rc.1, rc.2, rc.3, true,
          )
        }
      }
    }
    None => ()
  }

  // 6b. Tree native terminal node
  match find_tree_terminal(d.id) {
    Some(tt) => {
      if !bypass_blocks {
        tt.drawn_this_frame = true
        if !tt.term.closed && tt.term.id > 0 {
          let cell_w = tt.cell_w * ns
          let cell_h = tt.cell_h * ns
          let cols_f = d.w / cell_w
          let rows_f = d.h / cell_h
          let cols = if cols_f >= 1.0 { cols_f.to_int() } else { 1 }
          let rows = if rows_f >= 1.0 { rows_f.to_int() } else { 1 }
          let cw_px = if cell_w * scale >= 1.0 { (cell_w * scale).to_int() } else { 1 }
          let ch_px = if cell_h * scale >= 1.0 { (cell_h * scale).to_int() } else { 1 }
          tt.term.resize(cols, rows, cw_px, ch_px)
          let _ = tt.term.frame(full=!tt.term.visible)
        }
      }
    }
    None => ()
  }

  // 7. Child rects (kind 0)
  for r in d.rects {
    let ridx = scene.push_inst(
      d.x + r.x * ns, d.y + r.y * ns, r.w * ns, r.h * ns, r.corners.0 * ns, 0.0, 0.0, 0.0, r.color, d.alpha,
      0.0, 0.0, 0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    scene.set_corners(ridx, r.corners.0 * ns, r.corners.1 * ns, r.corners.2 * ns, r.corners.3 * ns)
  }

  // 7b. Vector shapes + vector pictures (kind = 11.0 bands + kind = 12.0 frame-tail segment packs)
  let pic_shapes : Array[paint::Shape] = match d.picture {
    None => {
      if !bypass_blocks {
        let _ = view_pictures.map.remove(d.id)
      }
      []
    }
    Some(p) => {
      let laid_w = if ns > 0.0 { d.w / ns } else { d.w }
      if laid_w > 0.0 && p.w > 0.0 {
        view_picture_shapes(d.id, p, laid_w, scale)
      } else {
        []
      }
    }
  }
  if d.shapes.length() > 0 || pic_shapes.length() > 0 {
    encode_shapes(scene, d, pic_shapes, ns, clip_x, clip_y, clip_x1, clip_y1)
  }

  // 8. Polylines (delegated to Scene::emit_line rotated capsules)
  let lines_start_idx = scene.ninst
  let line_turn = d.turn != 0.0 && d.lines.length() > 0
  let line_ox = d.x + d.w * 0.5
  let line_oy = d.y + d.h * 0.5
  let line_tc = if line_turn { dmath::cos(d.turn) } else { 1.0 }
  let line_ts = if line_turn { dmath::sin(d.turn) } else { 0.0 }
  for ln in d.lines {
    if ln.width > 0.0 && (ln.color & 0xFFL) != 0L && ln.points.length() >= 2 {
      let lw = ln.width * ns
      let mut pi = 0
      while pi + 1 < ln.points.length() {
        let (ax, ay) = ln.points[pi]
        let (bx, by) = ln.points[pi + 1]
        let mut p0x = d.x + ax * ns
        let mut p0y = d.y + ay * ns
        let mut p1x = d.x + bx * ns
        let mut p1y = d.y + by * ns
        if line_turn {
          let adx = p0x - line_ox
          let ady = p0y - line_oy
          p0x = line_ox + line_tc * adx - line_ts * ady
          p0y = line_oy + line_ts * adx + line_tc * ady
          let bdx = p1x - line_ox
          let bdy = p1y - line_oy
          p1x = line_ox + line_tc * bdx - line_ts * bdy
          p1y = line_oy + line_ts * bdx + line_tc * bdy
        }
        if scene.ink_r > 0.0 {
          let hw = lw * 0.5
          let bx = dmin(p0x, p1x) - hw - 1.0
          let by = dmin(p0y, p1y) - hw - 1.0
          let bw = dmax(p0x, p1x) - dmin(p0x, p1x) + 2.0 * (hw + 1.0)
          let bh = dmax(p0y, p1y) - dmin(p0y, p1y) + 2.0 * (hw + 1.0)
          let lidx = scene.push_inst(
            bx, by, bw, bh, hw, 10.0, 0.0, 0.0, ln.color, d.alpha,
            (p0x - bx) / bw, (p0y - by) / bh, (p1x - bx) / bw, (p1y - by) / bh,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
          )
          let lb = lidx * inst_size
          scene.inst[lb + 21] = scene.ink_x
          scene.inst[lb + 22] = scene.ink_y
          scene.inst[lb + 23] = scene.ink_r
        } else {
          scene.emit_line(
            p0x, p0y, p1x, p1y,
            lw, ln.color, alpha=d.alpha,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
          )
        }
        pi += 1
      }
    }
  }
  let lines_end_idx = scene.ninst

  // 9. Text glyphs via real CoreText/hostapi shaping + atlas (kind=1.0 mono / 3.0 color / 7.0 adaptive)
  let words_start_idx = scene.ninst
  let mut words_square_clip = false
  if d.runs.length() > 0 {
    encode_runs(scene, d, scale, ns, clip_x, clip_y, clip_x1, clip_y1)
  } else if d.words.length() > 0 {
    words_square_clip = encode_words(scene, d, scale, ns, clip_x, clip_y, clip_x1, clip_y1)
  }
  let words_end_idx = scene.ninst

  // 10. Focused field caret indicator (true multi-line layout coordinates via packages/editor)
  match find_tree_field_in(tree_id, d.id) {
    Some(tf) => {
      tf.field.last_win_x = d.x
      tf.field.last_win_y = d.y
      tf.field.last_win_scale = ns
      // Keep the editor in laid-out points: selection and handle overlays are child views scaled by Tree::drawn_held.
      let laid_w = d.w / ns
      let sz = (tf.font_size)()
      let lh = field_line_height(sz, tf.line, tf.trim)
      if laid_w > 0.0 && ((tf.field.last_max_w - laid_w).abs() > 0.5 || (tf.field.last_font_size - sz).abs() > 0.05 || (tf.field.last_line_h - lh).abs() > 0.05 || tf.field.editor.lines.length() == 0) {
        let _ = tf.field.layout_for(laid_w, font_size=sz, line_h=lh)
      }
      if tf.field.focused_sig.untracked() {
        let cp = tf.field.caret_pos()
        let cx = d.x + cp.x * ns
        let cy = d.y + (cp.y + 1.0) * ns
        let ch = dmax(cp.height - 2.0, sz) * ns
        let caret_w = 1.5 * ns
        let txt = tf.field.text_sig.untracked()
        let (sel_lo, sel_hi) = tf.field.editor.selection_range()
        let _ = scene.push_inst(
          cx, cy, caret_w, ch, 0.75 * ns, 0.0, 0.0, 0.0, tf.field.caret_color, d.alpha,
          0.0, 0.0, 0.0, 0.0,
          clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
        )
        if !bypass_blocks {
          hostapi::ime_action(tf.field.ime_kind())
          hostapi::set_ime(true, cx, cy, caret_w, ch, txt, utf8_to_utf16_off(txt, sel_lo), utf8_to_utf16_off(txt, sel_hi))
        }
      }
    }
    None => ()
  }

  // 11. Outer focus ring (kind = 0.0 transparent fill + p6=rw + c2=rcol RGBA; never kind=1.0!)
  let (rw_raw, rgap_raw, rcol) = d.ring
  let rw = rw_raw * ns
  let rgap = rgap_raw * ns
  if rw > 0.0 && (rcol & 0xFFL) != 0L {
    let pad = rgap + rw
    let (rr_r, rr_g, rr_b, rr_a) = color_rgba_tuple(rcol, d.alpha)
    let _ = scene.push_inst(
      d.x - pad, d.y - pad, d.w + pad * 2.0, d.h + pad * 2.0,
      concentric_out(d.radius, pad), 0.0, rw, 0.0, 0L, d.alpha,
      rr_r, rr_g, rr_b, rr_a,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
  }

  // Apply inherited rounded clip `rc` (slots 24..27) and node rotation `d.turn` (slots 32..35)
  // uniformly to all instances emitted by this node.
  let has_rc = rc.0 > 0.0 || rc.1 > 0.0 || rc.2 > 0.0 || rc.3 > 0.0
  let has_rot = d.turn != 0.0
  if has_rc || has_rot {
    let gox = gx + gw * 0.5
    let goy = gy + gh * 0.5
    let ox = d.x + d.w * 0.5
    let oy = d.y + d.h * 0.5
    let mut idx = start_idx
    while idx < scene.ninst {
      if has_rc && !(words_square_clip && idx >= words_start_idx && idx < words_end_idx) {
        scene.set_clip_corners(idx, rc.0, rc.1, rc.2, rc.3)
      }
      if has_rot && (idx < lines_start_idx || idx >= lines_end_idx) {
        let base = idx * inst_size
        scene.inst[base + 32] = d.turn
        scene.inst[base + 33] = if idx < after_ground_idx { gox } else { ox }
        scene.inst[base + 34] = if idx < after_ground_idx { goy } else { oy }
        scene.inst[base + 35] = 1.0
      }
      idx += 1
    }
  }
  (after_ground_idx - start_idx, words_start_idx - start_idx, words_end_idx - start_idx, words_square_clip, image_settled)
}

let prewarm_frame_budget : signals::Ref[Int] = ref_new(0)
let prewarm_seen : Map[Int, Int] = Map::new()
let prewarm_seen_epoch : signals::Ref[Int] = ref_new(-1)

fn encode_drawn_node(
  scene : Scene,
  tree_id : Int,
  d : view::Drawn,
  gd : view::GroundShape,
  node_scale : Double,
  frame_no : Int,
  now : Double,
  scale : Double,
  clip : (Double, Double, Double, Double),
  rc : (Double, Double, Double, Double),
  deferred_shadows : Array[DeferredGlassShadow],
  mag : Option[(Double, Double, Double)],
  mag_own : Int,
  shadow_out : Bool,
  bypass_blocks~ : Bool = false,
) -> Unit {
  if d.alpha <= 0.0 || (d.w <= 0.0 && gd.dw <= 0.0) || (d.h <= 0.0 && gd.dh <= 0.0) {
    return
  }
  if view_cull_enabled.v &&
  !bypass_blocks &&
  !image_obs_recording.v &&
  mag.is_none() &&
  (d.shadow.2 & 0xFFL) == 0L &&
  d.glass.is_none() &&
  d.picture.is_none() &&
  d.blur <= 0.0 &&
  d.turn == 0.0 &&
  node_scale == 1.0 &&
  gd.dx == 0.0 &&
  gd.dy == 0.0 &&
  gd.dw == 0.0 &&
  gd.dh == 0.0 &&
  d.shapes.length() == 0 &&
  d.lines.length() == 0 &&
  scene.ink_r <= 0.0 &&
  find_tree_field_in(tree_id, d.id).is_none() &&
  find_tree_stream(d.id).is_none() &&
  find_tree_native(d.id).is_none() &&
  find_tree_terminal(d.id).is_none() {
    let pad = 32.0
    if clip.2 <= clip.0 || clip.3 <= clip.1 ||
    d.x + d.w + pad <= clip.0 || d.x - pad >= clip.2 ||
    d.y + d.h + pad <= clip.1 || d.y - pad >= clip.3 {
      if d.runs.length() > 0 && prewarm_frame_budget.v > 0 && d.id.at >= 0 &&
      d.y + d.h >= clip.1 - 1200.0 && d.y <= clip.3 + 1200.0 {
        if prewarm_seen_epoch.v != glyph_state.epoch || prewarm_seen.length() >= 4096 {
          prewarm_seen.clear()
          prewarm_seen_epoch.v = glyph_state.epoch
        }
        if !prewarm_seen.contains(d.id.at) {
          prewarm_seen.set(d.id.at, glyph_state.epoch)
          prewarm_frame_budget.v = prewarm_frame_budget.v - 1
          prewarm_runs_node(d, scale, node_scale)
        }
      }
      return
    }
  }
  if bypass_blocks {
    let _ = encode_drawn_node_direct(
      scene,
      tree_id,
      d,
      gd,
      node_scale,
      frame_no,
      now,
      scale,
      clip,
      rc,
      deferred_shadows,
      mag,
      mag_own,
      shadow_out,
      bypass_blocks=true,
    )
    return
  }
  let cacheable = view_blocks_state.enabled &&
  mag.is_none() &&
  d.id.at >= 0 &&
  d.glass.is_none() &&
  d.lines.length() == 0 &&
  d.shapes.length() == 0 &&
  d.picture.is_none() &&
  !runs_has_drawing(d.runs) &&
  d.blur <= 0.0 &&
  scene.ink_r <= 0.0 &&
  find_tree_field_in(tree_id, d.id).is_none() &&
  find_tree_stream(d.id).is_none() &&
  find_tree_native(d.id).is_none() &&
  find_tree_terminal(d.id).is_none()
  if !cacheable {
    let before = scene.ninst
    let _ = encode_drawn_node_direct(
      scene, tree_id, d, gd, node_scale, frame_no, now, scale, clip, rc, deferred_shadows, mag, mag_own, shadow_out,
    )
    view_blocks_state.work.made = view_blocks_state.work.made + 1
    view_blocks_state.work.handed = view_blocks_state.work.handed + (scene.ninst - before)
    return
  }
  flush_deferred_shadows(scene, deferred_shadows)
  let slot = d.id.at
  let blocks = view_blocks_state.blocks
  while blocks.length() <= slot {
    blocks.push(None)
  }
  // Scaled by the host's text size so a set_font_scale change misses the cached block and redraws at the new size.
  let eff_font_size = (if d.words_look.size > 0.0 { d.words_look.size } else { tree_theme().font }) * font_scale_mul()
  let atlas_gen = glyph_state.epoch
  let (sub_x, sub_y) = if scale > 0.0 && (d.words.length() > 0 || d.runs.length() > 0) {
    (d.x - (d.x * scale).round() / scale, d.y - (d.y * scale).round() / scale)
  } else {
    (0.0, 0.0)
  }
  match blocks[slot] {
    Some(blk) if view_block_poison.v || view_block_matches(blk, d, gd, eff_font_size, node_scale, scale, sub_x, sub_y, atlas_gen, shadow_out) => {
      if blk.atlas_gen == atlas_gen {
        touch_block_glyph_plots(blk.mono_glyph_plots, blk.colour_glyph_plots)
      }
      if image_obs_recording.v {
        for pair in blk.image_obs {
          frame_image_obs[pair.0] = pair.1
        }
      }
      compose_view_block(scene, blk, d, gd, node_scale, clip, rc)
      view_blocks_state.work.copied = view_blocks_state.work.copied + 1
      view_blocks_state.work.handed = view_blocks_state.work.handed + blk.ninst
      return
    }
    _ => ()
  }
  let scratch = view_blocks_state.scratch
  scratch.clear(scene.width, scene.height, scale)
  let d_local = view::Drawn::{ ..d, x: sub_x, y: sub_y, turn: 0.0 }
  let empty_deferred : Array[DeferredGlassShadow] = []
  let prev_block_glyph_missed = block_glyph_missed.v
  let prev_block_glyph_plots = block_glyph_plots.v
  let prev_image_obs_sink = image_obs_block_sink.v
  let mono_plots : Array[Int] = []
  let col_plots : Array[Int] = []
  let blk_image_obs : Array[(String, Option[(Int, Double, Double)])] = []
  block_glyph_missed.v = false
  block_glyph_plots.v = Some((mono_plots, col_plots))
  image_obs_block_sink.v = Some(blk_image_obs)
  let (after_ground_n, words_start, words_end, words_square_clip, image_settled) = encode_drawn_node_direct(
    scratch,
    tree_id,
    d_local,
    gd,
    node_scale,
    frame_no,
    now,
    scale,
    (-1.0e9, -1.0e9, 1.0e9, 1.0e9),
    (0.0, 0.0, 0.0, 0.0),
    empty_deferred,
    None,
    0,
    shadow_out,
  )
  let glyphs_settled = !block_glyph_missed.v
  block_glyph_missed.v = prev_block_glyph_missed
  block_glyph_plots.v = prev_block_glyph_plots
  image_obs_block_sink.v = prev_image_obs_sink
  let blk_len = scratch.ninst * inst_size
  let blk_inst : Array[Double] = []
  let mut bi = 0
  while bi < blk_len {
    blk_inst.push(scratch.inst[bi])
    bi += 1
  }
  let blk = ViewBlock::{
    gen: d.id.gen,
    w: d.w,
    h: d.h,
    radius: d.radius,
    corners: d.corners,
    ground: d.ground,
    edge_w: d.edge.0,
    edge_col: d.edge.1,
    alpha: d.alpha,
    words: d.words,
    runs: d.runs.copy(),
    runs_code_ground: d.runs_look.code_ground,
    words_size: eff_font_size,
    words_weight: d.words_look.weight,
    words_line: d.words_look.line,
    words_wrap: d.words_look.wrap,
    words_tracking: d.words_look.tracking,
    words_balance: d.words_look.balance,
    words_max_lines: d.words_look.max_lines,
    words_center: d.words_center,
    words_optical: d.words_optical,
    ink: d.ink,
    ellipsis_past: d.ellipsis_past,
    clips_self: d.clips_self,
    image: d.image,
    image_in: d.image_in,
    image_cover: d.image_cover,
    image_contain: d.image_contain,
    image_cover_at: d.image_cover_at,
    ring_w: d.ring.0,
    ring_gap: d.ring.1,
    ring_col: d.ring.2,
    shadow_blur: d.shadow.0,
    shadow_y: d.shadow.1,
    shadow_col: d.shadow.2,
    shadow_outside: shadow_out,
    gd_dx: gd.dx,
    gd_dy: gd.dy,
    gd_dw: gd.dw,
    gd_dh: gd.dh,
    gd_corners: gd.corners,
    rects: d.rects.copy(),
    node_scale,
    scale,
    sub_x,
    sub_y,
    atlas_gen: glyph_state.epoch,
    ninst: scratch.ninst,
    after_ground_n,
    words_start,
    words_end,
    words_square_clip,
    mono_glyph_plots: mono_plots,
    colour_glyph_plots: col_plots,
    image_obs: blk_image_obs,
    image_epoch: image_invalidate_epoch.v,
    inst: blk_inst,
  }
  // Do not cache a pending (not-yet-decoded) image block or a block that dropped glyphs due to a full atlas,
  // so the next frame retries decode / glyph placement while keeping same-frame reference bypass zero-write.
  if image_settled && glyphs_settled {
    blocks[slot] = Some(blk)
  } else {
    blocks[slot] = None
  }
  compose_view_block(scene, blk, d, gd, node_scale, clip, rc)
  view_blocks_state.work.made = view_blocks_state.work.made + 1
  view_blocks_state.work.handed = view_blocks_state.work.handed + blk.ninst
}

let cut_soft_most : Double = 24.0

fn cut_soft(out : Double, left : Double) -> Double {
  dmax(dmin(cut_soft_most, dmin(out, left)), 0.0)
}

fn inst_fade(
  inst : FixedArray[Double],
  b : Int,
  top : Double,
  top_soft : Double,
  foot : Double,
  foot_soft : Double,
) -> Unit {
  if top_soft > 0.0 && (inst[b + 53] <= 0.0 || top + top_soft > inst[b + 52] + inst[b + 53]) {
    inst[b + 52] = top
    inst[b + 53] = top_soft
  }
  if foot_soft > 0.0 && (inst[b + 55] <= 0.0 || foot - foot_soft < inst[b + 54] - inst[b + 55]) {
    inst[b + 54] = foot
    inst[b + 55] = foot_soft
  }
}

fn inst_fade_across(
  inst : FixedArray[Double],
  b : Int,
  start : Double,
  start_soft : Double,
  end : Double,
  end_soft : Double,
) -> Unit {
  if start_soft > 0.0 && (inst[b + 57] <= 0.0 || start + start_soft > inst[b + 56] + inst[b + 57]) {
    inst[b + 56] = start
    inst[b + 57] = start_soft
  }
  if end_soft > 0.0 && (inst[b + 59] <= 0.0 || end - end_soft < inst[b + 58] - inst[b + 59]) {
    inst[b + 58] = end
    inst[b + 59] = end_soft
  }
}

let over_scrim_floor_next_token : signals::Ref[Int] = ref_new(1)
let over_scrim_floor_owner : Map[Int, Int] = Map::new()
let over_scrim_clear : Double = 12.0

/// Push a floor callback `(win_w, win_h) -> Option[(top, tall)]` onto the active window's `over_scrim_floor` stack.
/// Returns a unique token to pass to `remove_over_scrim_floor`.
pub fn push_over_scrim_floor(f : (Double, Double) -> Option[(Double, Double)]) -> Int {
  let tok = over_scrim_floor_next_token.v
  over_scrim_floor_next_token.v = tok + 1
  over_scrim_floor_stack.v.push((tok, f))
  over_scrim_floor_owner[tok] = current_window_id()
  tok
}

fn remove_over_scrim_floor_here(token : Int) -> Unit {
  let stack = over_scrim_floor_stack.v
  let mut i = stack.length() - 1
  while i >= 0 {
    if stack[i].0 == token {
      array_remove_at(stack, i)
      return
    }
    i -= 1
  }
}

/// Remove the `over_scrim_floor` entry matching `token` from its owning window's stack
/// (supports cross-window tree disposal).
pub fn remove_over_scrim_floor(token : Int) -> Unit {
  let owner_opt = over_scrim_floor_owner.get(token)
  over_scrim_floor_owner.remove(token)
  match owner_opt {
    Some(owner_wid) if owner_wid != current_window_id() =>
    if owner_wid == 0 || window_tree_of(owner_wid).is_some() {
      in_window(owner_wid, fn() { remove_over_scrim_floor_here(token) })
    }
    _ => remove_over_scrim_floor_here(token)
  }
}

struct BlurFrame {
  id : view::NodeId
  push_idx : Int
  blur : Double
  clip : (Double, Double, Double, Double)
  rc : (Double, Double, Double, Double)
  mut bx0 : Double
  mut by0 : Double
  mut bx1 : Double
  mut by1 : Double
}

struct LensOpenFrame {
  id : view::NodeId
  hdr_idx : Int
  x : Double
  y : Double
  w : Double
  h : Double
  r0 : Double
  r1 : Double
  r2 : Double
  r3 : Double
  blur : Double
  alpha : Double
  bezel : Double
  refraction : Double
  clip : (Double, Double, Double, Double)
  rc : (Double, Double, Double, Double)
}

struct DeferredOverScrim {
  start_i : Int
  end_i : Int
  outer_in_clip : (Double, Double, Double, Double)
  anc_blurs : Array[BlurFrame]
  anc_lenses : Array[LensOpenFrame]
  anc_fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))]
  ink_x : Double
  ink_y : Double
  ink_r : Double
}

enum SuspendedOptical {
  Blur(BlurFrame)
  Lens(LensOpenFrame)
}

fn close_lens_frame(scene : Scene, lf : LensOpenFrame) -> Unit {
  let child_n = scene.ninst - lf.hdr_idx - 1
  if child_n > 0 {
    scene.inst[lf.hdr_idx * inst_size + 12] = child_n.to_double()
  } else {
    scene.inst[lf.hdr_idx * inst_size + 12] = 0.0
    scene.inst[lf.hdr_idx * inst_size + 11] = 0.0
  }
}

fn close_optical_while(
  scene : Scene,
  tree : view::Tree,
  blur_stack : Array[BlurFrame],
  lens_open : Array[LensOpenFrame],
  deferred_shadows : Array[DeferredGlassShadow],
  fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))],
  stop_id : Option[view::NodeId],
  out : Option[Array[SuspendedOptical]],
) -> Unit {
  while true {
    let b_close = blur_stack.length() > 0 && match stop_id {
      Some(sid) => !tree.holds_in_order(blur_stack[blur_stack.length() - 1].id, sid)
      None => true
    }
    let l_close = lens_open.length() > 0 && match stop_id {
      Some(sid) => !tree.holds_in_order(lens_open[lens_open.length() - 1].id, sid)
      None => true
    }
    if !b_close && !l_close {
      break
    }
    let pop_lens = if l_close && !b_close {
      true
    } else if !l_close && b_close {
      false
    } else {
      lens_open[lens_open.length() - 1].hdr_idx > blur_stack[blur_stack.length() - 1].push_idx
    }
    if pop_lens {
      match lens_open.pop() {
        Some(lf) => {
          close_lens_frame(scene, lf)
          match out {
            Some(arr) => arr.push(SuspendedOptical::Lens(lf))
            None => ()
          }
        }
        None => ()
      }
    } else {
      let top = blur_stack[blur_stack.length() - 1]
      pop_blur_frame(scene, tree, blur_stack, deferred_shadows, fading)
      match out {
        Some(arr) => arr.push(SuspendedOptical::Blur(top))
        None => ()
      }
    }
  }
}

fn expand_blur_stack(scene : Scene, blur_stack : Array[BlurFrame], from_idx : Int, to_idx : Int) -> Unit {
  if blur_stack.length() == 0 || from_idx >= to_idx {
    return
  }
  let mut k = from_idx
  while k < to_idx {
    let b = k * inst_size
    let kind = (scene.inst[b + 5] + 0.5).to_int()
    let pad = if kind == 2 || kind == 14 || kind == 15 {
      3.0 * dmax(scene.inst[b + 7], 0.0) + 2.0
    } else {
      0.0
    }
    let ix0 = scene.inst[b] - pad
    let iy0 = scene.inst[b + 1] - pad
    let ix1 = scene.inst[b] + scene.inst[b + 2] + pad
    let iy1 = scene.inst[b + 1] + scene.inst[b + 3] + pad
    if ix1 > ix0 && iy1 > iy0 {
      for bf in blur_stack {
        if ix0 < bf.bx0 { bf.bx0 = ix0 }
        if iy0 < bf.by0 { bf.by0 = iy0 }
        if ix1 > bf.bx1 { bf.bx1 = ix1 }
        if iy1 > bf.by1 { bf.by1 = iy1 }
      }
    }
    k += 1
  }
}

fn pop_blur_frame(
  scene : Scene,
  tree : view::Tree,
  blur_stack : Array[BlurFrame],
  deferred_shadows : Array[DeferredGlassShadow],
  fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))],
) -> Unit {
  let fl0 = scene.ninst
  flush_deferred_shadows(scene, deferred_shadows)
  expand_blur_stack(scene, blur_stack, fl0, scene.ninst)
  let bf = match blur_stack.pop() {
    Some(f) => f
    None => return
  }
  let bw = dmax(0.0, bf.bx1 - bf.bx0)
  let bh = dmax(0.0, bf.by1 - bf.by0)
  let pb = bf.push_idx * inst_size
  scene.inst[pb] = bf.bx0
  scene.inst[pb + 1] = bf.by0
  scene.inst[pb + 2] = bw
  scene.inst[pb + 3] = bh
  let pop_idx = scene.pop_blur_layer(
    bf.bx0, bf.by0, bw, bh, bf.blur, alpha=1.0,
    clip_x=bf.clip.0, clip_y=bf.clip.1, clip_x1=bf.clip.2, clip_y1=bf.clip.3,
  )
  scene.set_clip_corners(pop_idx, bf.rc.0, bf.rc.1, bf.rc.2, bf.rc.3)
  for f in fading {
    let (by, fbox, fsoft) = f
    if by == bf.id || tree.holds_in_order(bf.id, by) || tree.drawn_clear_of(bf.id, by) {
      continue
    }
    let (fx0, fy0, fx1, fy1) = fbox
    let (fstart, ftop, fend, ffoot) = fsoft
    let b = pop_idx * inst_size
    inst_fade(scene.inst, b, fy0, ftop, fy1, ffoot)
    inst_fade_across(scene.inst, b, fx0, fstart, fx1, fend)
  }
  expand_blur_stack(scene, blur_stack, pop_idx, pop_idx + 1)
}

/// Whether encode_held_tree leaves out what the window cannot show (Tree::drawn_held's `cull`): on, but for tests
/// that compare against everything encoded.
let view_cull_enabled : signals::Ref[Bool] = ref_new(true)

pub fn set_view_cull_enabled(on : Bool) -> Unit {
  view_cull_enabled.v = on
}

/// glass_solid() as one frame's encode reads it: worked out once for the frame (it reads two signals, the system's
/// reduce-transparency setting and an environment variable), not once for each node encoded. -1: not in an encode.
let encode_solid : signals::Ref[Int] = ref_new(-1)

fn solid_now() -> Bool {
  if encode_solid.v >= 0 {
    encode_solid.v == 1
  } else {
    glass_solid()
  }
}

/// more_contrast_now() as one encode reads it (outside a frame each read of it asks the host). -1: not in an encode.
let encode_contrast : signals::Ref[Int] = ref_new(-1)

fn contrast_now() -> Bool {
  if encode_contrast.v >= 0 {
    encode_contrast.v == 1
  } else {
    more_contrast_now()
  }
}

/// glass_frost() as one encode reads it. Below 0: not in an encode.
let encode_frost : signals::Ref[Double] = ref_new(-1.0)

fn frost_now() -> Double {
  if encode_frost.v >= 0.0 {
    encode_frost.v
  } else {
    glass_frost()
  }
}

fn encode_held_tree(
  scene : Scene,
  tree : view::Tree,
  frame_no : Int,
  now : Double,
  scale : Double,
  bypass_blocks~ : Bool = false,
) -> Unit {
  let prev_bypass_glyph = bypass_glyph_atlas_writes.v
  // (whether glass is drawn solid, with more contrast and how frosted, worked out once for the whole frame: solid_now,
  // contrast_now, frost_now)
  let solid_was = encode_solid.v
  let contrast_was = encode_contrast.v
  let frost_was = encode_frost.v
  encode_solid.v = if glass_solid() { 1 } else { 0 }
  encode_contrast.v = if more_contrast_now() { 1 } else { 0 }
  encode_frost.v = glass_frost()
  if bypass_blocks {
    bypass_glyph_atlas_writes.v = true
  } else {
    let atlas_was_init = glyph_state.initialized
    ensure_glyph_atlas(scale)
    frame_atlas_rejected_glyphs.clear()
    glyph_state.mono.next_frame()
    glyph_state.colour.next_frame()
    if !atlas_was_init {
      view_blocks_reset()
    }
    view_blocks_sync_frame()
  }
  let tree_id = tree.phys_id()
  let scales : Array[Double] = []
  // (only what can be seen in the window: a long list's rows scrolled out of its column, or out of the window, not
  // encoded frame by frame; Tree::drawn_held's `cull`, `view_cull_enabled` off for the reference walks)
  // (the theme worked out once for the whole frame: tree_theme_hold)
  tree_theme_hold(true)
  let held = if view_cull_enabled.v && scene.width > 0.0 && scene.height > 0.0 {
    tree.drawn_held(scales=scales, cull=(0.0, 0.0, scene.width, scene.height))
  } else {
    tree.drawn_held(scales=scales)
  }
  let n = held.length()
  let n0 = scene.ninst
  let win_w = scene.width
  let win_h = scene.height
  // Pre-scan for over_scrim lifting only when at least one scrim_under node is alive (zero overhead otherwise).
  let mut scrim_idx = -1
  let mut lift_dy = 0.0
  if tree.scrims_up() {
    let mut k = 0
    while k < n {
      let kd = held[k].0
      let kns = if k < scales.length() { scales[k] } else { 1.0 }
      if tree.scrim_of(kd.id) && node_emits_ground(kd, tree.ground_drawn_of(kd.id), kns) {
        scrim_idx = k
        break
      }
      k += 1
    }
    if scrim_idx >= 0 {
      let mut head = 1.0e300
      let mut foot = -1.0e300
      let mut any_lifted = false
      let mut j = 0
      while j < scrim_idx {
        let jd = held[j].0
        if tree.over_scrim_of(jd.id) {
          any_lifted = true
          let root_id = jd.id
          let mut end_j = j + 1
          while end_j < scrim_idx && tree.holds_in_order(root_id, held[end_j].0.id) {
            end_j += 1
          }
          let mut m = j
          while m < end_j {
            let md = held[m].0
            if md.alpha > 0.0 && md.w > 0.0 && md.h > 0.0 {
              head = dmin(head, md.y)
              foot = dmax(foot, md.y + md.h)
            }
            m += 1
          }
          j = end_j
        } else {
          j += 1
        }
      }
      if !any_lifted {
        scrim_idx = -1
      } else {
        if head > foot {
          head = 0.0
          foot = 0.0
        }
        let floor_opt = {
          let st = over_scrim_floor_stack.v
          if st.length() > 0 {
            (st[st.length() - 1].1)(win_w, win_h)
          } else {
            None
          }
        }
        lift_dy = match floor_opt {
          Some((top, tall)) if foot + over_scrim_clear > top => {
            let up = if tall > 0.0 { dmin(1.0, dmax(0.0, (win_h - top) / tall)) } else { 1.0 }
            let at_rest = win_h - tall - over_scrim_clear - foot
            dmin(0.0, dmax(dmax(top - over_scrim_clear - foot, at_rest * up), -head))
          }
          _ => 0.0
        }
        if tree.leaving(held[scrim_idx].0.id) && lift_dy == 0.0 {
          scrim_idx = -1
        }
      }
    }
  }
  let eff_clip : Array[(Double, Double, Double, Double)] = Array::make(n, (0.0, 0.0, 1.0e9, 1.0e9))
  let eff_rc : Array[(Double, Double, Double, Double)] = Array::make(n, (0.0, 0.0, 0.0, 0.0))
  let deferred_shadows : Array[DeferredGlassShadow] = []
  let fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))] = []
  let blur_stack : Array[BlurFrame] = []
  let ink_stack : Array[(view::NodeId, Double, Double, Double)] = []
  let glass_slots : Array[GlassSlot] = []
  let glass_open : Array[Int] = []
  let lens_open : Array[LensOpenFrame] = []
  let deferred_over_scrim : Array[DeferredOverScrim] = []
  let mut i = 0
  while i < n {
    let (d, holder, _) = held[i]
    while fading.length() > 0 && !tree.holds_in_order(fading[fading.length() - 1].0, d.id) {
      let _ = fading.pop()
    }
    close_optical_while(scene, tree, blur_stack, lens_open, deferred_shadows, fading, Some(d.id), None)
    while glass_open.length() > 0 && !tree.holds_in_order(glass_slots[glass_open[glass_open.length() - 1]].id, d.id) {
      match glass_open.pop() {
        Some(idx) => glass_slots[idx].sub_end = scene.ninst
        None => ()
      }
    }
    while ink_stack.length() > 0 && !tree.holds_in_order(ink_stack[ink_stack.length() - 1].0, d.id) {
      match ink_stack.pop() {
        Some((_, px, py, pr)) => {
          scene.ink_x = px
          scene.ink_y = py
          scene.ink_r = pr
        }
        None => ()
      }
    }
    let (in_clip, in_rc) = if holder >= 0 && holder < i {
      let p = held[holder].0
      if p.clips {
        intersect_clip(eff_clip[holder], eff_rc[holder], p.x, p.y, p.x + p.w, p.y + p.h, node_corners_tuple(p))
      } else {
        (eff_clip[holder], eff_rc[holder])
      }
    } else {
      ((0.0, 0.0, 1.0e9, 1.0e9), (0.0, 0.0, 0.0, 0.0))
    }
    // Defer outermost `over_scrim` subtrees prior to `scrim_idx` into isolated sub-passes after the scrim ground.
    if scrim_idx >= 0 && i < scrim_idx && tree.over_scrim_of(d.id) {
      let mut end_i = i + 1
      while end_i < scrim_idx && tree.holds_in_order(d.id, held[end_i].0.id) {
        end_i += 1
      }
      deferred_over_scrim.push(DeferredOverScrim::{
        start_i: i,
        end_i,
        outer_in_clip: in_clip,
        anc_blurs: blur_stack.copy(),
        anc_lenses: lens_open.copy(),
        anc_fading: fading.copy(),
        ink_x: scene.ink_x,
        ink_y: scene.ink_y,
        ink_r: scene.ink_r,
      })
      i = end_i
      continue
    }
    let node_scale = if i < scales.length() { scales[i] } else { 1.0 }
    let gd = tree.ground_drawn_of(d.id)
    match d.glass {
      Some(gl) if gl.liquid && gl.adaptive && gl.strength > 0.001 && !solid_now() => {
        ink_stack.push((d.id, scene.ink_x, scene.ink_y, scene.ink_r))
        let gx = d.x + gd.dx * node_scale
        let gy = d.y + gd.dy * node_scale
        let gw = dmax(0.0, d.w + gd.dw * node_scale)
        let gh = dmax(0.0, d.h + gd.dh * node_scale)
        scene.ink_x = gx + gw * 0.5
        scene.ink_y = gy + gh * 0.5
        scene.ink_r = dmax(dmin(gw, gh) * 0.5, 1.0)
      }
      _ =>
      if scene.ink_r > 0.0 && d.ground != 0L && (d.ground & 0xFFL) >= 0xC0L {
        ink_stack.push((d.id, scene.ink_x, scene.ink_y, scene.ink_r))
        scene.ink_r = 0.0
      }
    }
    let scrim_has_blur = d.blur > 0.0 && d.alpha > 0.0
    let (node_in_clip, node_in_rc) = if scrim_has_blur {
      let fl0 = scene.ninst
      flush_deferred_shadows(scene, deferred_shadows)
      expand_blur_stack(scene, blur_stack, fl0, scene.ninst)
      // (its blur in the points it is drawn in, as its box is)
      let eff_blur = d.blur * node_scale
      let push_idx = scene.push_blur_layer(d.x, d.y, d.w, d.h, eff_blur)
      blur_stack.push(BlurFrame::{
        id: d.id,
        push_idx,
        blur: eff_blur,
        clip: in_clip,
        rc: in_rc,
        bx0: d.x,
        by0: d.y,
        bx1: d.x + d.w,
        by1: d.y + d.h,
      })
      ((0.0, 0.0, 1.0e9, 1.0e9), (0.0, 0.0, 0.0, 0.0))
    } else {
      (in_clip, in_rc)
    }
    eff_clip[i] = node_in_clip
    eff_rc[i] = node_in_rc
    let (draw_clip, draw_rc) = if d.clips_self {
      intersect_clip(node_in_clip, node_in_rc, d.x, d.y, d.x + d.w, d.y + d.h, node_corners_tuple(d))
    } else {
      (node_in_clip, node_in_rc)
    }
    let mag = tree.magnifies_of(d.id)
    let shadow_out = tree.shadow_outside_of(d.id)
    let k0 = scene.ninst
    encode_drawn_node(
      scene,
      tree_id,
      d,
      gd,
      node_scale,
      frame_no,
      now,
      scale,
      draw_clip,
      draw_rc,
      deferred_shadows,
      mag,
      k0,
      shadow_out,
      bypass_blocks=bypass_blocks,
    )
    if d.glass.is_some() && !solid_now() {
      match d.glass {
        Some(gl) if gl.liquid && gl.layer > 0 && gl.strength > 0.001 => {
          if k0 < scene.ninst && scene.inst[k0 * inst_size + 5] == 6.0 && scene.inst[k0 * inst_size + 15] > 0.001 {
            let si = if k0 + 1 < scene.ninst && scene.inst[(k0 + 1) * inst_size + 5] == 2.0 { k0 + 1 } else { -1 }
            let off = k0 * inst_size
            let gx = scene.inst[off]
            let gy = scene.inst[off + 1]
            let gw = scene.inst[off + 2]
            let gh = scene.inst[off + 3]
            let (cx0, cy0, cx1, cy1) = draw_clip
            if gw > 0.0 && gh > 0.0 && gx < cx1 && gx + gw > cx0 && gy < cy1 && gy + gh > cy0 {
              let bg = if gl.break_gap > 0.0 { gl.break_gap } else { gl.merge * 0.25 }
              let slot_idx = glass_slots.length()
              glass_slots.push(GlassSlot::{
                layer: gl.layer,
                nav_scope: 0,
                id: d.id,
                glass_idx: k0,
                shadow_idx: si,
                sub_start: k0,
                sub_end: scene.ninst,
                x0: gx,
                y0: gy,
                x1: gx + gw,
                y1: gy + gh,
                cx0,
                cy0,
                cx1,
                cy1,
                merge_max: gl.merge,
                break_gap: bg,
              })
              glass_open.push(slot_idx)
            }
          }
        }
        _ => ()
      }
    }
    expand_blur_stack(scene, blur_stack, k0, scene.ninst)
    for f in fading {
      let (by, fbox, fsoft) = f
      if blur_stack.length() > 0 && !tree.holds_in_order(blur_stack[blur_stack.length() - 1].id, by) {
        continue
      }
      let (fx0, fy0, fx1, fy1) = fbox
      let (fstart, ftop, fend, ffoot) = fsoft
      if tree.drawn_clear_of(d.id, by) {
        continue
      }
      let mut k = k0
      while k < scene.ninst {
        let b = k * inst_size
        inst_fade(scene.inst, b, fy0, ftop, fy1, ffoot)
        inst_fade_across(scene.inst, b, fx0, fstart, fx1, fend)
        k += 1
      }
    }
    // Immediately after the scrim node's own ground (and BEFORE opening scrim's lens/fading or encoding
    // panel children at `scrim_idx + 1`), run completely isolated sub-passes for deferred `over_scrim` subtrees.
    // Suspend ALL active main-pass blur layers and foreground lenses in strict LIFO order (`push_idx` / `hdr_idx`)
    // so an inner lens closes before an outer blur emits kind 15, then reopen any suspended layers in reverse
    // (outer-to-inner) order that still enclose subsequent nodes (`scrim_idx + 1`).
    if i == scrim_idx && deferred_over_scrim.length() > 0 {
      let suspended_optical : Array[SuspendedOptical] = []
      close_optical_while(
        scene,
        tree,
        blur_stack,
        lens_open,
        deferred_shadows,
        fading,
        None,
        Some(suspended_optical),
      )
      let lifted_at = fn(idx : Int) -> view::Drawn {
        let orig = held[idx].0
        if lift_dy == 0.0 { orig } else { view::Drawn::{ ..orig, y: orig.y + lift_dy } }
      }
      for def in deferred_over_scrim {
        let saved_ink_x = scene.ink_x
        let saved_ink_y = scene.ink_y
        let saved_ink_r = scene.ink_r
        scene.ink_x = def.ink_x
        scene.ink_y = if def.ink_r > 0.0 { def.ink_y + lift_dy } else { def.ink_y }
        scene.ink_r = def.ink_r

        let sub_deferred_shadows : Array[DeferredGlassShadow] = []
        let sub_fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))] = []
        for af in def.anc_fading {
          let (by, fbox, fsoft) = af
          let (fx0, fy0, fx1, fy1) = fbox
          sub_fading.push((by, (fx0, fy0 + lift_dy, fx1, fy1 + lift_dy), fsoft))
        }
        let sub_blur_stack : Array[BlurFrame] = []
        let sub_ink_stack : Array[(view::NodeId, Double, Double, Double)] = []
        let sub_glass_slots : Array[GlassSlot] = []
        let sub_glass_open : Array[Int] = []
        let sub_lens_open : Array[LensOpenFrame] = []

        let root_ld = lifted_at(def.start_i)
        for ab in def.anc_blurs {
          let rclip = (
            dmin(ab.clip.0, 0.0),
            dmin(ab.clip.1, 0.0),
            dmax(ab.clip.2, win_w),
            dmax(ab.clip.3, win_h),
          )
          let push_idx = scene.push_blur_layer(root_ld.x, root_ld.y, root_ld.w, root_ld.h, ab.blur)
          sub_blur_stack.push(BlurFrame::{
            id: ab.id,
            push_idx,
            blur: ab.blur,
            clip: rclip,
            rc: (0.0, 0.0, 0.0, 0.0),
            bx0: root_ld.x,
            by0: root_ld.y,
            bx1: root_ld.x + root_ld.w,
            by1: root_ld.y + root_ld.h,
          })
        }
        for al in def.anc_lenses {
          let rclip = (
            dmin(al.clip.0, 0.0),
            dmin(al.clip.1, 0.0),
            dmax(al.clip.2, win_w),
            dmax(al.clip.3, win_h),
          )
          let hdr_idx = scene.push_inst(
            al.x,
            al.y + lift_dy,
            al.w,
            al.h,
            al.r0,
            8.0,
            0.0,
            al.blur,
            c64(0xFFFF, 0xFFFF),
            al.alpha,
            0.0,
            al.bezel,
            al.refraction,
            1.0,
            clip_x=rclip.0,
            clip_y=rclip.1,
            clip_x1=rclip.2,
            clip_y1=rclip.3,
          )
          let hoff = hdr_idx * inst_size
          scene.inst[hoff + 12] = 0.0
          scene.inst[hoff + 20] = 0.0
          scene.inst[hoff + 36] = al.r0
          scene.inst[hoff + 37] = al.r1
          scene.inst[hoff + 38] = al.r2
          scene.inst[hoff + 39] = al.r3
          expand_blur_stack(scene, sub_blur_stack, hdr_idx, hdr_idx + 1)
          sub_lens_open.push(LensOpenFrame::{
            ..al,
            hdr_idx,
            y: al.y + lift_dy,
            clip: rclip,
            rc: (0.0, 0.0, 0.0, 0.0),
          })
        }

        let mut idx = def.start_i
        while idx < def.end_i {
          let ld = lifted_at(idx)
          let lholder = held[idx].1
          while sub_fading.length() > 0 && !tree.holds_in_order(sub_fading[sub_fading.length() - 1].0, ld.id) {
            let _ = sub_fading.pop()
          }
          close_optical_while(scene, tree, sub_blur_stack, sub_lens_open, sub_deferred_shadows, sub_fading, Some(ld.id), None)
          while sub_glass_open.length() > 0 && !tree.holds_in_order(sub_glass_slots[sub_glass_open[sub_glass_open.length() - 1]].id, ld.id) {
            match sub_glass_open.pop() {
              Some(sidx) => sub_glass_slots[sidx].sub_end = scene.ninst
              None => ()
            }
          }
          while sub_ink_stack.length() > 0 && !tree.holds_in_order(sub_ink_stack[sub_ink_stack.length() - 1].0, ld.id) {
            match sub_ink_stack.pop() {
              Some((_, px, py, pr)) => {
                scene.ink_x = px
                scene.ink_y = py
                scene.ink_r = pr
              }
              None => ()
            }
          }
          let lns = if idx < scales.length() { scales[idx] } else { 1.0 }
          let lgd = tree.ground_drawn_of(ld.id)
          match ld.glass {
            Some(gl) if gl.liquid && gl.adaptive && gl.strength > 0.001 && !solid_now() => {
              sub_ink_stack.push((ld.id, scene.ink_x, scene.ink_y, scene.ink_r))
              let gx = ld.x + lgd.dx * lns
              let gy = ld.y + lgd.dy * lns
              let gw = dmax(0.0, ld.w + lgd.dw * lns)
              let gh = dmax(0.0, ld.h + lgd.dh * lns)
              scene.ink_x = gx + gw * 0.5
              scene.ink_y = gy + gh * 0.5
              scene.ink_r = dmax(dmin(gw, gh) * 0.5, 1.0)
            }
            _ =>
            if scene.ink_r > 0.0 && ld.ground != 0L && (ld.ground & 0xFFL) >= 0xC0L {
              sub_ink_stack.push((ld.id, scene.ink_x, scene.ink_y, scene.ink_r))
              scene.ink_r = 0.0
            }
          }
          let (lin_clip, lin_rc) = if idx == def.start_i {
            let (ocx0, ocy0, ocx1, ocy1) = def.outer_in_clip
            (
              (dmin(ocx0, 0.0), dmin(ocy0, 0.0), dmax(ocx1, win_w), dmax(ocy1, win_h)),
              (0.0, 0.0, 0.0, 0.0),
            )
          } else if lholder >= def.start_i && lholder < idx {
            let p = lifted_at(lholder)
            if p.clips {
              intersect_clip(eff_clip[lholder], eff_rc[lholder], p.x, p.y, p.x + p.w, p.y + p.h, node_corners_tuple(p))
            } else {
              (eff_clip[lholder], eff_rc[lholder])
            }
          } else {
            ((0.0, 0.0, 1.0e9, 1.0e9), (0.0, 0.0, 0.0, 0.0))
          }
          let (lnode_in_clip, lnode_in_rc) = if ld.blur > 0.0 && ld.alpha > 0.0 {
            let fl0 = scene.ninst
            flush_deferred_shadows(scene, sub_deferred_shadows)
            expand_blur_stack(scene, sub_blur_stack, fl0, scene.ninst)
            let eff_blur = ld.blur * lns
            let push_idx = scene.push_blur_layer(ld.x, ld.y, ld.w, ld.h, eff_blur)
            sub_blur_stack.push(BlurFrame::{
              id: ld.id,
              push_idx,
              blur: eff_blur,
              clip: lin_clip,
              rc: lin_rc,
              bx0: ld.x,
              by0: ld.y,
              bx1: ld.x + ld.w,
              by1: ld.y + ld.h,
            })
            ((0.0, 0.0, 1.0e9, 1.0e9), (0.0, 0.0, 0.0, 0.0))
          } else {
            (lin_clip, lin_rc)
          }
          eff_clip[idx] = lnode_in_clip
          eff_rc[idx] = lnode_in_rc
          let (ldraw_clip, ldraw_rc) = if ld.clips_self {
            intersect_clip(lnode_in_clip, lnode_in_rc, ld.x, ld.y, ld.x + ld.w, ld.y + ld.h, node_corners_tuple(ld))
          } else {
            (lnode_in_clip, lnode_in_rc)
          }
          let lmag = tree.magnifies_of(ld.id)
          let lshadow_out = tree.shadow_outside_of(ld.id)
          let lk0 = scene.ninst
          encode_drawn_node(
            scene,
            tree_id,
            ld,
            lgd,
            lns,
            frame_no,
            now,
            scale,
            ldraw_clip,
            ldraw_rc,
            sub_deferred_shadows,
            lmag,
            lk0,
            lshadow_out,
            bypass_blocks=bypass_blocks,
          )
          if ld.glass.is_some() && !solid_now() {
            match ld.glass {
              Some(gl) if gl.liquid && gl.layer > 0 && gl.strength > 0.001 => {
                if lk0 < scene.ninst && scene.inst[lk0 * inst_size + 5] == 6.0 && scene.inst[lk0 * inst_size + 15] > 0.001 {
                  let si = if lk0 + 1 < scene.ninst && scene.inst[(lk0 + 1) * inst_size + 5] == 2.0 { lk0 + 1 } else { -1 }
                  let off = lk0 * inst_size
                  let gx = scene.inst[off]
                  let gy = scene.inst[off + 1]
                  let gw = scene.inst[off + 2]
                  let gh = scene.inst[off + 3]
                  let (cx0, cy0, cx1, cy1) = ldraw_clip
                  if gw > 0.0 && gh > 0.0 && gx < cx1 && gx + gw > cx0 && gy < cy1 && gy + gh > cy0 {
                    let bg = if gl.break_gap > 0.0 { gl.break_gap } else { gl.merge * 0.25 }
                    let slot_idx = sub_glass_slots.length()
                    sub_glass_slots.push(GlassSlot::{
                      layer: gl.layer,
                      nav_scope: 0,
                      id: ld.id,
                      glass_idx: lk0,
                      shadow_idx: si,
                      sub_start: lk0,
                      sub_end: scene.ninst,
                      x0: gx,
                      y0: gy,
                      x1: gx + gw,
                      y1: gy + gh,
                      cx0,
                      cy0,
                      cx1,
                      cy1,
                      merge_max: gl.merge,
                      break_gap: bg,
                    })
                    sub_glass_open.push(slot_idx)
                  }
                }
              }
              _ => ()
            }
          }
          expand_blur_stack(scene, sub_blur_stack, lk0, scene.ninst)
          for f in sub_fading {
            let (by, fbox, fsoft) = f
            if sub_blur_stack.length() > 0 && !tree.holds_in_order(sub_blur_stack[sub_blur_stack.length() - 1].id, by) {
              continue
            }
            let (fx0, fy0, fx1, fy1) = fbox
            let (fstart, ftop, fend, ffoot) = fsoft
            if tree.drawn_clear_of(ld.id, by) {
              continue
            }
            let mut k = lk0
            while k < scene.ninst {
              let b = k * inst_size
              inst_fade(scene.inst, b, fy0, ftop, fy1, ffoot)
              inst_fade_across(scene.inst, b, fx0, fstart, fx1, fend)
              k += 1
            }
          }
          let llens = tree.content_lens_of(ld.id)
          let llens_active = (llens.blur > 0.05 || llens.refraction > 0.05) && ld.alpha > 0.001
          if llens_active {
            let (lgx, lgy, lgw, lgh) = if lgd.reshaped() {
              (
                ld.x + lgd.dx * lns,
                ld.y + lgd.dy * lns,
                dmax(0.0, ld.w + lgd.dw * lns),
                dmax(0.0, ld.h + lgd.dh * lns),
              )
            } else {
              (ld.x, ld.y, ld.w, ld.h)
            }
            let (r0, r1, r2, r3) = match lgd.corners {
              Some((tl, tr, br, bl)) => (tl * lns, tr * lns, br * lns, bl * lns)
              None =>
              match ld.corners {
                Some((tl, tr, br, bl)) => (tl, tr, br, bl)
                None => (ld.radius, ld.radius, ld.radius, ld.radius)
              }
            }
            let eff_lblur = llens.blur * lns
            let eff_lalpha = dclamp(llens.alpha * ld.alpha, 0.0, 1.0)
            let eff_lbezel = llens.bezel * lns
            let eff_lrefr = llens.refraction * lns
            let hdr_idx = scene.push_inst(
              lgx,
              lgy,
              lgw,
              lgh,
              r0,
              8.0,
              0.0,
              eff_lblur,
              c64(0xFFFF, 0xFFFF),
              eff_lalpha,
              0.0,
              eff_lbezel,
              eff_lrefr,
              1.0,
              clip_x=ldraw_clip.0,
              clip_y=ldraw_clip.1,
              clip_x1=ldraw_clip.2,
              clip_y1=ldraw_clip.3,
            )
            let hoff = hdr_idx * inst_size
            scene.inst[hoff + 12] = 0.0
            scene.inst[hoff + 20] = 0.0
            scene.inst[hoff + 36] = r0
            scene.inst[hoff + 37] = r1
            scene.inst[hoff + 38] = r2
            scene.inst[hoff + 39] = r3
            let has_rc = ldraw_rc.0 > 0.0 || ldraw_rc.1 > 0.0 || ldraw_rc.2 > 0.0 || ldraw_rc.3 > 0.0
            if has_rc {
              scene.set_clip_corners(hdr_idx, ldraw_rc.0, ldraw_rc.1, ldraw_rc.2, ldraw_rc.3)
            }
            expand_blur_stack(scene, sub_blur_stack, hdr_idx, hdr_idx + 1)
            sub_lens_open.push(LensOpenFrame::{
              id: ld.id,
              hdr_idx,
              x: lgx,
              y: lgy,
              w: lgw,
              h: lgh,
              r0,
              r1,
              r2,
              r3,
              blur: eff_lblur,
              alpha: eff_lalpha,
              bezel: eff_lbezel,
              refraction: eff_lrefr,
              clip: ldraw_clip,
              rc: ldraw_rc,
            })
          }
          let (lfstart, lftop, lfend, lffoot) = match tree.cut_soft_of(ld.id) {
            Some((over_top, over_foot, ch)) => (0.0, cut_soft(over_top, ch / 2.0), 0.0, cut_soft(over_foot, ch / 2.0))
            None => tree.fades_of(ld.id)
          }
          if lfstart > 0.0 || lftop > 0.0 || lfend > 0.0 || lffoot > 0.0 {
            let past = if ld.clips && !ld.clips_self { tree.clips_past_of(ld.id) } else { 0.0 }
            let fh = dmax(0.0, ld.h + past)
            sub_fading.push(
              (
                ld.id,
                (ld.x, ld.y, ld.x + ld.w * lns, ld.y + fh * lns),
                (lfstart * lns, lftop * lns, lfend * lns, lffoot * lns),
              ),
            )
          }
          idx += 1
        }
        while sub_ink_stack.length() > 0 {
          let _ = sub_ink_stack.pop()
        }
        scene.ink_x = saved_ink_x
        scene.ink_y = saved_ink_y
        scene.ink_r = saved_ink_r
        close_optical_while(scene, tree, sub_blur_stack, sub_lens_open, sub_deferred_shadows, sub_fading, None, None)
        flush_deferred_shadows(scene, sub_deferred_shadows)
        while sub_glass_open.length() > 0 {
          match sub_glass_open.pop() {
            Some(sidx) => sub_glass_slots[sidx].sub_end = scene.ninst
            None => ()
          }
        }
        for gs in sub_glass_slots {
          glass_slots.push(gs)
        }
      }
      if scrim_idx + 1 < n {
        let next_id = held[scrim_idx + 1].0.id
        let mut si = suspended_optical.length() - 1
        while si >= 0 {
          match suspended_optical[si] {
            SuspendedOptical::Blur(sb) =>
            if tree.holds_in_order(sb.id, next_id) {
              let fl0 = scene.ninst
              flush_deferred_shadows(scene, deferred_shadows)
              expand_blur_stack(scene, blur_stack, fl0, scene.ninst)
              let push_idx = scene.push_blur_layer(
                sb.bx0,
                sb.by0,
                dmax(0.0, sb.bx1 - sb.bx0),
                dmax(0.0, sb.by1 - sb.by0),
                sb.blur,
              )
              blur_stack.push(BlurFrame::{
                id: sb.id,
                push_idx,
                blur: sb.blur,
                clip: sb.clip,
                rc: sb.rc,
                bx0: sb.bx0,
                by0: sb.by0,
                bx1: sb.bx1,
                by1: sb.by1,
              })
            }
            SuspendedOptical::Lens(sl) =>
            if tree.holds_in_order(sl.id, next_id) {
              let hdr_idx = scene.push_inst(
                sl.x,
                sl.y,
                sl.w,
                sl.h,
                sl.r0,
                8.0,
                0.0,
                sl.blur,
                c64(0xFFFF, 0xFFFF),
                sl.alpha,
                0.0,
                sl.bezel,
                sl.refraction,
                1.0,
                clip_x=sl.clip.0,
                clip_y=sl.clip.1,
                clip_x1=sl.clip.2,
                clip_y1=sl.clip.3,
              )
              let hoff = hdr_idx * inst_size
              scene.inst[hoff + 12] = 0.0
              scene.inst[hoff + 20] = 0.0
              scene.inst[hoff + 36] = sl.r0
              scene.inst[hoff + 37] = sl.r1
              scene.inst[hoff + 38] = sl.r2
              scene.inst[hoff + 39] = sl.r3
              let has_rc = sl.rc.0 > 0.0 || sl.rc.1 > 0.0 || sl.rc.2 > 0.0 || sl.rc.3 > 0.0
              if has_rc {
                scene.set_clip_corners(hdr_idx, sl.rc.0, sl.rc.1, sl.rc.2, sl.rc.3)
              }
              expand_blur_stack(scene, blur_stack, hdr_idx, hdr_idx + 1)
              lens_open.push(LensOpenFrame::{ ..sl, hdr_idx })
            }
          }
          si -= 1
        }
      }
    }
    // Foreground optical lens (kind == 8): offscreen Gaussian defocus + spherical bevel refraction + SDF clip
    // over children; zero overhead when resting (blur <= 0.05 && refraction <= 0.05).
    let lens = tree.content_lens_of(d.id)
    let lens_active = (lens.blur > 0.05 || lens.refraction > 0.05) && d.alpha > 0.001
    if lens_active {
      let (lgx, lgy, lgw, lgh) = if gd.reshaped() {
        (
          d.x + gd.dx * node_scale,
          d.y + gd.dy * node_scale,
          dmax(0.0, d.w + gd.dw * node_scale),
          dmax(0.0, d.h + gd.dh * node_scale),
        )
      } else {
        (d.x, d.y, d.w, d.h)
      }
      let (r0, r1, r2, r3) = match gd.corners {
        Some((tl, tr, br, bl)) => (tl * node_scale, tr * node_scale, br * node_scale, bl * node_scale)
        None =>
        match d.corners {
          Some((tl, tr, br, bl)) => (tl, tr, br, bl)
          None => (d.radius, d.radius, d.radius, d.radius)
        }
      }
      let eff_lblur = lens.blur * node_scale
      let eff_lalpha = dclamp(lens.alpha * d.alpha, 0.0, 1.0)
      let eff_lbezel = lens.bezel * node_scale
      let eff_lrefr = lens.refraction * node_scale
      let hdr_idx = scene.push_inst(
        lgx,
        lgy,
        lgw,
        lgh,
        r0,
        8.0,
        0.0,
        eff_lblur,
        c64(0xFFFF, 0xFFFF),
        eff_lalpha,
        0.0,
        eff_lbezel,
        eff_lrefr,
        1.0,
        clip_x=draw_clip.0,
        clip_y=draw_clip.1,
        clip_x1=draw_clip.2,
        clip_y1=draw_clip.3,
      )
      let hoff = hdr_idx * inst_size
      scene.inst[hoff + 12] = 0.0
      scene.inst[hoff + 20] = 0.0
      scene.inst[hoff + 36] = r0
      scene.inst[hoff + 37] = r1
      scene.inst[hoff + 38] = r2
      scene.inst[hoff + 39] = r3
      let has_rc = draw_rc.0 > 0.0 || draw_rc.1 > 0.0 || draw_rc.2 > 0.0 || draw_rc.3 > 0.0
      if has_rc {
        scene.set_clip_corners(hdr_idx, draw_rc.0, draw_rc.1, draw_rc.2, draw_rc.3)
      }
      expand_blur_stack(scene, blur_stack, hdr_idx, hdr_idx + 1)
      lens_open.push(LensOpenFrame::{
        id: d.id,
        hdr_idx,
        x: lgx,
        y: lgy,
        w: lgw,
        h: lgh,
        r0,
        r1,
        r2,
        r3,
        blur: eff_lblur,
        alpha: eff_lalpha,
        bezel: eff_lbezel,
        refraction: eff_lrefr,
        clip: draw_clip,
        rc: draw_rc,
      })
    }
    let (fstart, ftop, fend, ffoot) = match tree.cut_soft_of(d.id) {
      Some((over_top, over_foot, ch)) => (0.0, cut_soft(over_top, ch / 2.0), 0.0, cut_soft(over_foot, ch / 2.0))
      None => tree.fades_of(d.id)
    }
    if fstart > 0.0 || ftop > 0.0 || fend > 0.0 || ffoot > 0.0 {
      let past = if d.clips && !d.clips_self { tree.clips_past_of(d.id) } else { 0.0 }
      let fh = dmax(0.0, d.h + past)
      fading.push(
        (
          d.id,
          (d.x, d.y, d.x + d.w * node_scale, d.y + fh * node_scale),
          (fstart * node_scale, ftop * node_scale, fend * node_scale, ffoot * node_scale),
        ),
      )
    }
    i += 1
  }
  while ink_stack.length() > 0 {
    match ink_stack.pop() {
      Some((_, px, py, pr)) => {
        scene.ink_x = px
        scene.ink_y = py
        scene.ink_r = pr
      }
      None => ()
    }
  }
  close_optical_while(scene, tree, blur_stack, lens_open, deferred_shadows, fading, None, None)
  flush_deferred_shadows(scene, deferred_shadows)
  while glass_open.length() > 0 {
    match glass_open.pop() {
      Some(idx) => glass_slots[idx].sub_end = scene.ninst
      None => ()
    }
  }
  if glass_slots.length() >= 2 {
    scene.merge_liquid_layers(n0, glass_slots)
  }
  encode_solid.v = solid_was
  encode_contrast.v = contrast_was
  encode_frost.v = frost_was
  tree_theme_hold(false)
  bypass_glyph_atlas_writes.v = prev_bypass_glyph
}

/// Encode `tree.drawn_held()` into a standalone 60-Double `Scene` using the currently active `hostapi`
/// (uploads glyphs to the active host's atlas, packs shape segments, and syncs glass light angle).
pub fn encode_tree_scene(tree : view::Tree, w : Double, h : Double, scale : Double, now : Double) -> Scene {
  // (in a frame it reads what the frame sampled; of its own, what it samples once)
  let sampled_was = sampled_offscreen.v
  if !frame_running.v && !sampled_was {
    host_samples_begin()
    sampled_offscreen.v = true
  }
  if scale > 0.0 {
    tree.set_pixel_grid(scale)
  }
  let _ = tree.frame(w, h, now=now)
  hostapi::set_glass_light_angle(glass_light_angle_now())
  let sc = Scene::new()
  sc.clear(w, h, scale)
  encode_held_tree(sc, tree, 1, now, scale)
  sampled_offscreen.v = sampled_was
  sc.emit_segs()
  sc.perf.instances = sc.ninst
  sc
}

fn scene_hash(scene : Scene) -> Int64 {
  let mut h : Int64 = 1469598103934665603L
  let prime : Int64 = (0x00000100.to_int64() << 32) | 0x000001B3.to_int64()
  let inst = scene.inst
  let ninst = scene.ninst
  let mut j = 0
  while j < ninst {
    let b = j * inst_size
    let mut k = 0
    while k < 24 {
      h = (h ^ quant_i64(inst[b + k])) * prime
      k += 1
    }
    // Check all tail slots 24..59 (rc, rs, rot, rr, oclip, orc, ors, fade, fadex) so zero non-zero slot is ever missed.
    let mut has_tail = false
    let mut t = 24
    while t < inst_size {
      if inst[b + t] != 0.0 {
        has_tail = true
        break
      }
      t += 1
    }
    if has_tail {
      let mut s = 24
      while s < inst_size {
        h = (h ^ quant_i64(inst[b + s])) * prime
        s += 1
      }
    } else {
      h = (h ^ 0x5A5A5A5AL) * prime
    }
    j += 1
  }
  h
}

let in_tree_frame : signals::Ref[Bool] = ref_new(false)

/// Execute one pure-tree frame: poll streams, update signals/layout, encode scene, compute damage, present, sync a11y.
/// Returns true if the rendered scene changed compared to the previous frame.
pub fn view_frame(w : Double, h : Double, scale : Double, now : Double) -> Bool {
  let t0 = work_clock_now()
  frame_running.v = true
  host_samples_begin()
  view_app.last_w = w
  view_app.last_h = h
  view_app.last_scale = scale
  view_app.frame_no = view_app.frame_no + 1
  tree_window_size_sig.v.set((w, h))
  tree_window_corner.v.set(hostapi::window_corner())
  host_settings_arrive()
  messages_arrive()
  streams_frame_begin()
  natives_frame_begin()
  terminals_frame_begin()
  let tree = match view_app.tree {
    Some(t) => t
    None => {
      frame_running.v = false
      return false
    }
  }
  run_before_frame_hooks()
  let atlas_gen = hostapi::atlas_generation()
  let atlas_changed = view_app.last_atlas_gen >= 0 && atlas_gen != view_app.last_atlas_gen
  view_app.last_atlas_gen = atlas_gen
  ensure_glyph_atlas(scale)
  if atlas_changed {
    tree.words_again()
  }
  // (the host's pixels a point said to the tree, as the view package expects to hear them: what a column scrolls and
  // what is drawn off move by whole pixels (Scroll::held_dy, View::drawn_off), so a text node keeps its sub-pixel place
  // as it scrolls, its words' glyph phases (#41) and its ViewBlock with it)
  if scale > 0.0 {
    tree.set_pixel_grid(scale)
  }
  // (the app may have moved the tree's focus itself: a Field left behind gives up the input method)
  field_let_go_if_left(tree)
  let prev_in_tree_frame = in_tree_frame.v
  in_tree_frame.v = true
  prewarm_frame_budget.v = 24
  let _ = tree.frame(w, h, now=now)
  in_tree_frame.v = prev_in_tree_frame
  view_cursor_tell()
  if view_app.frame_no == 1 {
    back_enabled_sent.v = None
  }
  sync_back_enabled(tree)
  let t1 = work_clock_now()
  let la = glass_light_angle_now()
  let light_changed = view_app.frame_no > 1 && (la - view_app.last_light_angle).abs() > 1.0e-6
  view_app.last_light_angle = la
  hostapi::set_glass_light_angle(la)
  view_app.scene.clear(w, h, scale)
  match view_app.underlay_painter {
    Some(painter) => painter(view_app.scene, w, h, scale, now)
    None => ()
  }
  let ref_scene_opt : Option[Scene] = match in_frame_looks_hook.v {
    Some(_) => Some(view_app.scene.copy())
    None => None
  }
  image_obs_begin_frame(in_frame_looks_hook.v.is_some())
  encode_held_tree(view_app.scene, tree, view_app.frame_no, now, scale)
  image_obs_recording.v = false
  view_app.scene.emit_segs()
  let t2 = work_clock_now()
  let bg = tree_theme().bg
  let bg_r = ((bg >> 24) & 0xFFL).to_double() / 255.0
  let bg_g = ((bg >> 16) & 0xFFL).to_double() / 255.0
  let bg_b = ((bg >> 8) & 0xFFL).to_double() / 255.0
  if view_app.fast_present {
    view_app.scene.dirty_count = 0
    last_damage_report.v = match damage_report_poison.v {
      Some(p) => p
      None => DamageReport::Full
    }
    hostapi::present(view_app.scene.inst, view_app.scene.ninst, bg_r, bg_g, bg_b)
    view_app.last_bg_r = bg_r
    view_app.last_bg_g = bg_g
    view_app.last_bg_b = bg_b
    let t3 = work_clock_now()
    view_app.scene.perf.layout_ms = dmax(0.0, t1 - t0)
    view_app.scene.perf.paint_ms = dmax(0.0, t2 - t1)
    view_app.scene.perf.present_ms = dmax(0.0, t3 - t2)
    view_app.scene.perf.frame_ms = dmax(0.0, t3 - t0)
    view_app.scene.perf.instances = view_app.scene.ninst
    view_app.scene.perf.dirty_rects = 0
    if hostapi::a11y_on() {
      let _ = a11y_sync(tree, view_app.a11y)
    }
    streams_frame_end()
    natives_frame_end()
    terminals_frame_end()
    shots_after_present(now, bg_r, bg_g, bg_b)
    match (in_frame_looks_hook.v, ref_scene_opt) {
      (Some(hook), Some(ref_scene)) => {
        encode_held_tree(ref_scene, tree, view_app.frame_no, now, scale, bypass_blocks=true)
        ref_scene.emit_segs()
        hook(view_app.scene, ref_scene, last_damage_report.v, w, h, scale, bg_r, bg_g, bg_b)
      }
      _ => ()
    }
    image_obs_end_frame()
    frame_running.v = false
    drain_after_frame()
    return true
  }
  let dirty = view_app.dmg.next(view_app.scene.inst, view_app.scene.ninst, w, h, scale, bg_r, bg_g, bg_b)
  last_damage_report.v = match damage_report_poison.v {
    Some(p) => p
    None => normalize_damage_report(dirty, view_app.frame_no == 1 || light_changed || atlas_changed)
  }
  if light_changed || atlas_changed {
    hostapi::render_dirty(0.0, 0.0, -1.0, -1.0)
  } else if dirty.length() == 0 {
    hostapi::render_dirty(0.0, 0.0, 0.0, 0.0)
  } else {
    for d in dirty {
      let (dx, dy, dw, dh) = d
      hostapi::render_dirty(dx, dy, dw, dh)
    }
  }
  view_app.scene.dirty_count = dirty.length()
  // hostapi::present(buf, count, bg_r, bg_g, bg_b) — clear color RGB, NOT (w, h, scale)!
  hostapi::present(view_app.scene.inst, view_app.scene.ninst, bg_r, bg_g, bg_b)
  view_app.last_bg_r = bg_r
  view_app.last_bg_g = bg_g
  view_app.last_bg_b = bg_b
  let t3 = work_clock_now()
  view_app.scene.perf.layout_ms = dmax(0.0, t1 - t0)
  view_app.scene.perf.paint_ms = dmax(0.0, t2 - t1)
  view_app.scene.perf.present_ms = dmax(0.0, t3 - t2)
  view_app.scene.perf.frame_ms = dmax(0.0, t3 - t0)
  view_app.scene.perf.instances = view_app.scene.ninst
  view_app.scene.perf.dirty_rects = dirty.length()
  if hostapi::a11y_on() {
    let _ = a11y_sync(tree, view_app.a11y)
  }
  streams_frame_end()
  natives_frame_end()
  terminals_frame_end()
  shots_after_present(now, bg_r, bg_g, bg_b)
  match (in_frame_looks_hook.v, ref_scene_opt) {
    (Some(hook), Some(ref_scene)) => {
      encode_held_tree(ref_scene, tree, view_app.frame_no, now, scale, bypass_blocks=true)
      ref_scene.emit_segs()
      hook(view_app.scene, ref_scene, last_damage_report.v, w, h, scale, bg_r, bg_g, bg_b)
    }
    _ => ()
  }
  image_obs_end_frame()
  frame_running.v = false
  drain_after_frame()
  view_app.frame_no == 1 || dirty.length() > 0 || light_changed || atlas_changed
}

fn blur_focused_field() -> Unit {
  match focused_field_ref.v {
    Some(f) => f.let_go()
    None => ()
  }
}

fn view_events_before(events : Array[(Double, Double, Double)], at : Double, x : Double, y : Double) -> Array[(Double, Double, Double)] {
  let before : Array[(Double, Double, Double)] = []
  let mut n = events.length()
  if n > 1 {
    let last = events[n - 1]
    if last.0 == at && last.1 == x && last.2 == y {
      n = n - 1
    }
  }
  let mut i = 0
  while i < n {
    before.push(events[i])
    i += 1
  }
  before
}

fn view_events_push(events : Array[(Double, Double, Double)], at : Double, x : Double, y : Double) -> Unit {
  events.push((at, x, y))
  if events.length() > 20 {
    let mut i = 0
    while i + 1 < events.length() {
      events[i] = events[i + 1]
      i += 1
    }
    let _ = events.pop()
  }
}

/// Route a pointer event into the active view::Tree:
///   kind: 0 = move, 1 = down, 2 = up, 3 = cancel,
///         4 = second down, 5 = second move, 6 = second up, 8 = primary up handing over to second,
///         9 = third+ finger down
///   button: 1 = primary (left), 2 = secondary (right / Ctrl-click)
/// Note: `mac_app.m` sends `0=down, 1=move, 2=up, 3=cancel` with `btn=0` primary / `btn=2` secondary;
/// `ui::run` translates `mac_app.m`'s `(kind, btn)` into this convention before calling `view_pointer`.
pub fn view_pointer(kind : Int, x : Double, y : Double, now : Double, button~ : Int = 1) -> Unit {
  view_pointer_dispatch(kind, x, y, now, button)
  view_cursor_tell()
}

fn view_pointer_dispatch(kind : Int, x : Double, y : Double, now : Double, button : Int) -> Unit {
  if kind <= 3 {
    view_app.pointer_x = x
    view_app.pointer_y = y
  }
  match view_app.pointer_interceptor {
    Some(f) => if f(kind, x, y, button, hostapi::mods_held()) { return }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => return
  }
  if kind == 0 {
    // Move (primary)
    if view_app.press_down && view_app.claim_chain.length() > 0 {
      view_events_push(view_app.press_events, now, x, y)
    }
    if view_app.press_down && view_app.dragging_node.is_none() && view_app.claim_chain.length() > 0 {
      match tree.claimer_of(view_app.claim_chain, x - view_app.press_x, y - view_app.press_y) {
        Some(cid) => {
          view_app.claim_chain.clear()
          let second : Option[(Double, Double)] = match view_app.down2 {
            Some((x2, y2, events2)) if tree.claims_scroll(cid) =>
            if events2.length() > 0 {
              let last = events2[events2.length() - 1]
              Some((last.1, last.2))
            } else {
              Some((x2, y2))
            }
            _ => None
          }
          view_app.down2 = None
          match view_app.pressed_node {
            Some(pid) => {
              let _ = tree.press_held(pid)
              view_app.pressed_node = None
            }
            None => ()
          }
          blur_focused_field()
          view_app.dragging_node = Some(cid)
          view_app.finger_0 = 0
          view_app.finger_1 = -1
          view_app.finger_next = 1
          match second {
            Some((x2, y2)) => {
              view_app.finger_1 = 1
              view_app.finger_next = 2
              let _ = tree.drag_at(cid, view::DragIs::Down, x2, y2, now, finger=1)
            }
            None => ()
          }
          let before = view_events_before(view_app.press_events, now, x, y)
          view_app.press_events.clear()
          let _ = tree.drag_at(cid, view::DragIs::Down, view_app.press_x, view_app.press_y, now, finger=0, track=before)
          let _ = tree.drag_at(cid, view::DragIs::Moved, x, y, now, finger=0)
          tree.point_at(x, y)
          return
        }
        None => ()
      }
    }
    match view_app.dragging_node {
      Some(nid) => {
        if view_app.finger_0 >= 0 {
          let _ = tree.drag_at(nid, view::DragIs::Moved, x, y, now, finger=view_app.finger_0)
        }
      }
      None => ()
    }
    // (what is under the pointer is not looked for while a drag holds it: nothing but what is dragged answers it
    // then, and a scroll bar's thumb dragged over a long list looked through the whole tree at each move; looked
    // for again as the drag ends)
    if view_app.dragging_node.is_none() {
      tree.point_at(x, y)
    }
  } else if kind == 1 {
    // Down (primary)
    tree.went_down(now, x=x, y=y)
    tree.point_at(x, y)
    if button == 2 {
      if tree.menu_at(x, y, now) {
        return
      }
      return
    }
    view_app.press_down = true
    view_app.press_x = x
    view_app.press_y = y
    view_app.press_events.clear()
    view_app.press_events.push((now, x, y))
    view_app.down2 = None
    view_app.pressed_node = None
    view_app.dragging_node = None
    view_app.finger_0 = 0
    view_app.finger_1 = -1
    view_app.finger_next = 1
    view_app.claim_chain = tree.claimers_at(x, y)
    match tree.target_at(x, y) {
      view::Target::Dragged(nid) => {
        blur_focused_field()
        view_app.dragging_node = Some(nid)
        let _ = tree.drag_at(nid, view::DragIs::Down, x, y, now, finger=0)
      }
      view::Target::Pressed(nid) => {
        view_app.pressed_node = Some(nid)
        tree.hold_press(nid)
        match find_tree_field(nid) {
          Some(tf) => tf.field.focus()
          None => blur_focused_field()
        }
      }
      view::Target::Hosted(_) => ()
      view::Target::TopRow(nid) => {
        blur_focused_field()
        // a top row of the app's own (View::moves_window): the press is the window's to move it, as its title bar's
        if tree.moves_window(nid) {
          view_app.press_down = false
          view_app.claim_chain.clear()
          view_app.press_events.clear()
          hostapi::window_drag()
        }
      }
      view::Target::Nothing => blur_focused_field()
    }
  } else if kind == 4 {
    // Second finger down
    match view_app.dragging_node {
      Some(nid) if !tree.yields(nid) => {
        let f = view_app.finger_next
        view_app.finger_1 = f
        view_app.finger_next = f + 1
        let _ = tree.drag_at(nid, view::DragIs::Down, x, y, now, finger=f)
        return
      }
      _ => ()
    }
    if view_app.press_down && view_app.claim_chain.length() > 0 {
      let scrolls : Array[(view::NodeId, Int)] = []
      for e in view_app.claim_chain {
        if tree.claims_scroll(e.0) {
          scrolls.push(e)
        }
      }
      if scrolls.length() > 0 {
        view_app.claim_chain = scrolls
        view_app.down2 = Some((x, y, [(now, x, y)]))
      } else {
        view_app.claim_chain.clear()
        view_app.down2 = None
      }
    } else {
      view_app.down2 = None
    }
  } else if kind == 5 {
    // Second finger move
    match view_app.dragging_node {
      Some(nid) if view_app.finger_1 >= 0 => {
        let _ = tree.drag_at(nid, view::DragIs::Moved, x, y, now, finger=view_app.finger_1)
        return
      }
      _ => ()
    }
    match view_app.down2 {
      Some((x2, y2, events2)) if view_app.claim_chain.length() > 0 => {
        view_events_push(events2, now, x, y)
        match tree.claimer_of(view_app.claim_chain, x - x2, y - y2) {
          Some(cid) => {
            view_app.claim_chain.clear()
            view_app.down2 = None
            match view_app.pressed_node {
              Some(pid) => {
                let _ = tree.press_held(pid)
                view_app.pressed_node = None
              }
              None => ()
            }
            blur_focused_field()
            view_app.dragging_node = Some(cid)
            view_app.finger_0 = 0
            view_app.finger_1 = 1
            view_app.finger_next = 2
            let (f1x, f1y) = if view_app.press_events.length() > 0 {
              let last = view_app.press_events[view_app.press_events.length() - 1]
              (last.1, last.2)
            } else {
              (view_app.press_x, view_app.press_y)
            }
            view_app.press_events.clear()
            let _ = tree.drag_at(cid, view::DragIs::Down, f1x, f1y, now, finger=0)
            let before2 = view_events_before(events2, now, x, y)
            let _ = tree.drag_at(cid, view::DragIs::Down, x2, y2, now, finger=1, track=before2)
            let _ = tree.drag_at(cid, view::DragIs::Moved, x, y, now, finger=1)
          }
          None => ()
        }
      }
      _ => ()
    }
  } else if kind == 6 {
    // Second finger up
    view_app.down2 = None
    match view_app.dragging_node {
      Some(nid) if view_app.finger_1 >= 0 => {
        let f = view_app.finger_1
        view_app.finger_1 = -1
        let _ = tree.drag_at(nid, view::DragIs::Up, x, y, now, finger=f)
      }
      _ => ()
    }
  } else if kind == 8 {
    // Primary finger up while second finger remains down (second becomes primary)
    match view_app.dragging_node {
      Some(nid) => {
        let f0 = view_app.finger_0
        view_app.finger_0 = view_app.finger_1
        view_app.finger_1 = -1
        if f0 >= 0 {
          let _ = tree.drag_at(nid, view::DragIs::Up, x, y, now, finger=f0)
        }
      }
      None => {
        match view_app.pressed_node {
          Some(pid) => {
            let _ = tree.press_held(pid)
            view_app.pressed_node = None
          }
          None => ()
        }
        match view_app.down2 {
          Some((x2, y2, events2)) if view_app.claim_chain.length() > 0 => {
            view_app.press_x = x2
            view_app.press_y = y2
            view_app.press_events = events2
          }
          _ => {
            view_app.claim_chain.clear()
            view_app.press_events.clear()
          }
        }
        view_app.down2 = None
      }
    }
  } else if kind == 9 {
    // Third+ finger down: cancel active 2-finger drag cleanly
    view_app.down2 = None
    match view_app.dragging_node {
      Some(nid) => {
        let f = view_app.finger_next
        view_app.finger_next = f + 1
        let _ = tree.drag_at(nid, view::DragIs::Down, x, y, now, finger=f)
        view_app.dragging_node = None
        view_app.finger_0 = 0
        view_app.finger_1 = -1
      }
      None => ()
    }
  } else if kind == 2 || kind == 3 {
    // Up (2) or Cancel (3)
    let is_cancel = kind == 3
    tree.went_up(now)
    let was_down = view_app.press_down
    view_app.press_down = false
    view_app.claim_chain.clear()
    view_app.press_events.clear()
    view_app.down2 = None
    match view_app.dragging_node {
      Some(nid) => {
        let drag_end = if is_cancel { view::DragIs::Off } else { view::DragIs::Up }
        let f0 = if view_app.finger_0 >= 0 { view_app.finger_0 } else { 0 }
        let _ = tree.drag_at(nid, drag_end, x, y, now, finger=f0)
        view_app.dragging_node = None
        tree.point_at(x, y)
      }
      None => ()
    }
    view_app.finger_0 = 0
    view_app.finger_1 = -1
    view_app.finger_next = 1
    let slop = touch_slop()
    let within_slop = (x - view_app.press_x).abs() <= slop && (y - view_app.press_y).abs() <= slop
    match view_app.pressed_node {
      Some(nid) => {
        let was_held = tree.press_held(nid)
        if !is_cancel && was_down && within_slop && was_held {
          let _ = tree.run_press_at(nid, now)
        }
      }
      None => ()
    }
    view_app.pressed_node = None
  }
}

/// Route a wheel scroll event into the active view::Tree.
pub fn view_wheel(x : Double, y : Double, dx : Double, dy : Double, now : Double, phase~ : Int = 0) -> Unit {
  view_app.last_wheel_phase = phase
  match view_app.wheel_interceptor {
    Some(f) => if f(x, y, dx, dy, phase) { return }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => return
  }
  let mods = phase / 16
  let notch = if phase % 16 == 4 { view::wheel_notch } else { 0 }
  let momentum = if phase % 16 == 3 { view::wheel_momentum } else { 0 }
  let _ = tree.wheel_at(x, y, dx, dy, mods | notch | momentum, now)
}

fn tree_focus_step(tree : view::Tree, delta : Int) -> Bool {
  let order = tree.focus_order()
  if order.length() == 0 {
    return false
  }
  let (cur, _) = tree.focused_now()
  let mut idx = -1
  match cur {
    Some(cid) => {
      let mut i = 0
      while i < order.length() {
        if order[i].id == cid {
          idx = i
          break
        }
        i += 1
      }
    }
    None => ()
  }
  let next_idx = if idx < 0 {
    if delta < 0 { order.length() - 1 } else { 0 }
  } else {
    let raw = idx + delta
    if raw < 0 { order.length() - 1 } else if raw >= order.length() { 0 } else { raw }
  }
  let moved = tree.focus_to(Some(order[next_idx].id), visible=true)
  if moved {
    field_sync_with_tree(tree)
  }
  moved
}

/// Route a keyboard key press into focused Field or active view::Tree
/// (Keymap stroke -> Field -> focused Enter/Space -> node on_key -> Keymap stroke -> default press).
pub fn view_key(code : Int, mods : Int, now : Double) -> Bool {
  match view_app.key_interceptor {
    Some(f) => if f(code, mods, false) { return true }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => {
      match focused_field_ref.v {
        Some(f) if f.focused_sig.untracked() => return f.handle_key(code, mods)
        _ => return false
      }
    }
  }
  // (the app may have moved the tree's focus itself: the Field it is on takes the keys, none left behind)
  field_sync_with_tree(tree)
  let (held, _) = tree.focused_now()
  let facts : Array[String] = []
  let mut field_composing = false
  let mut field_multiline = false
  let field_active = match focused_field_ref.v {
    Some(f) if f.focused_sig.untracked() => {
      facts.push("Field")
      if f.text_sig.untracked().length() == 0 {
        facts.push("FieldEmpty")
      }
      field_composing = f.composing()
      field_multiline = f.editor.config.multiline
      true
    }
    _ => false
  }

  // 1. Tab / Shift+Tab: try keymap stroke first, then focus traversal
  if code == key_tab {
    if tree.stroke(code, mods, now, from=held, facts=facts) {
      return true
    }
    let backward = (mods & mod_shift_key) != 0
    return tree_focus_step(tree, if backward { -1 } else { 1 })
  }

  // 2. Focused Field:
  //    - Cmd/Ctrl shortcuts try the full Keymap first.
  //    - Otherwise (when not mid-IME-composition):
  //      * For unmodified ArrowUp / ArrowDown in a single-line Field, let enclosing focus-chain
  //        context-scoped Keymap bindings (e.g. numeric steppers, Combobox) and focus-chain
  //        `on_key` handlers (e.g. default Combobox) run before Field collapses them to line
  //        start/end, without letting global `Always` bindings or unrelated sibling panels
  //        preempt Field before it handles the key.
  //      * For all other unmodified keys (and multiline ArrowUp/ArrowDown), only continue or
  //        clear an already-pending multi-key chord (`pending_only=true`) so Field keeps full
  //        priority over editing keys (Backspace, arrows, Home/End, Enter, etc.).
  if field_active {
    let has_cmd_or_ctrl = (mods & (mod_cmd | mod_ctrl)) != 0
    if has_cmd_or_ctrl {
      if tree.stroke(code, mods, now, from=held, facts=facts) {
        return true
      }
    } else if !field_composing {
      let single_line_up_down = !field_multiline && mods == 0 && (code == key_code_up || code == key_code_down)
      if single_line_up_down {
        if tree.stroke(code, mods, now, from=held, facts=facts, scoped_only=true, focus_only=true) {
          return true
        }
        if held is Some(_) && tree.key_at(code, mods, now, within=held) {
          return true
        }
      } else if tree.has_pending_keys() {
        if tree.stroke(code, mods, now, from=held, facts=facts, pending_only=true) {
          return true
        }
      }
    }
    match focused_field_ref.v {
      Some(f) => {
        if f.handle_key(code, mods) {
          return true
        }
      }
      None => ()
    }
  }

  // 3. Focused node Enter / Space press:
  //    - When the focused node is the already-active Field (and Field::handle_key returned false,
  //      e.g. Enter with no `on_submitted`), do not invoke its click-to-focus `on_press` and do not
  //      leak Enter/Space into global Always bindings or unrelated sibling `on_key` handlers:
  //      route strictly within the focus chain (scoped keymap -> focus-chain on_key -> default press)
  //      and consume.
  let focused_is_active_field = field_active && match (held, focused_field_ref.v) {
    (Some(nid), Some(f)) => match f.tree_node {
      Some(fnid) => nid == fnid
      None => false
    }
    _ => false
  }
  if mods == 0 && (code == key_enter || code == key_space) {
    let field_leaves_key = match focused_field_ref.v {
      Some(f) => f.leaves.contains(code)
      None => false
    }
    if focused_is_active_field && !field_leaves_key {
      if !field_composing {
        if tree.stroke(code, mods, now, from=held, facts=facts, scoped_only=true, focus_only=true) {
          return true
        }
        if held is Some(_) && tree.key_at(code, mods, now, within=held) {
          return true
        }
      }
      if code == key_enter {
        let _ = tree.press_default_at(now, from=held)
      }
      return true
    }
    if !focused_is_active_field {
      match held {
        Some(nid) => {
          let mask = if code == key_enter { view::focus_enter } else { view::focus_space }
          if (tree.focus_keys_of(nid) & mask) != 0 {
            if tree.press_focused_at(nid, now) {
              return true
            }
          }
        }
        None => ()
      }
    }
  }

  // 4. Keymap bindings (View::keymap + View::on_action) before generic node on_key
  if tree.stroke(code, mods, now, from=held, facts=facts) {
    return true
  }

  // 5. Node View::on_key handlers
  if tree.key_at(code, mods, now) {
    return true
  }

  // 6. Layer default press on Enter
  if mods == 0 && code == key_enter {
    return tree.press_default_at(now, from=held)
  }
  false
}

/// Route a keyboard key-up event through the registered key interceptor (`is_up = true`).
pub fn view_key_up(code : Int, mods : Int, _now : Double) -> Bool {
  match view_app.key_interceptor {
    Some(f) => f(code, mods, true)
    None => false
  }
}

/// Route host text input into the currently focused Field: `kind` 0 commits `s`, 1 sets the composition, 2 cancels
/// it, 3 selects the UTF-16 range `[a, b)` (an empty commit next deletes it), 7 says the host keyboard was hidden.
pub fn view_text(kind : Int, s : String, a~ : Int = 0, b~ : Int = 0) -> Unit {
  match view_app.text_interceptor {
    Some(f) => if f(kind, s, a, b) { return }
    None => ()
  }
  match view_app.tree {
    Some(tree) => field_sync_with_tree(tree)
    None => ()
  }
  match focused_field_ref.v {
    Some(f) if f.focused_sig.untracked() => {
      if kind == 1 {
        f.compose(s)
      } else if kind == 2 {
        f.compose("")
      } else if kind == 3 {
        let txt = f.text_sig.untracked()
        f.pick(utf16_to_utf8_off(txt, a), utf16_to_utf8_off(txt, b))
        hostapi::request_frame()
      } else if kind == 7 {
        f.let_go()
      } else {
        f.insert(s)
      }
    }
    _ => ()
  }
}

/// Map native/web host pointer & touch events into `view_pointer`:
/// - Mouse: `0=down, 1=move, 2=up, 3=cancel, 7=leave` (`btn`: `0=left, 1|3=middle, 2=right`).
/// - Touch: `10=down, 11=move, 12=up, 13=cancel` (`btn` carries `pointerId`, never mouse button).
/// Tracks up to two active touch fingers so two fingers can take turns scrolling a column.
pub fn view_host_pointer(host_kind : Int, x : Double, y : Double, btn : Int, now : Double) -> Unit {
  if host_kind == 10 {
    match view_app.active_touch_id {
      None => {
        view_app.active_touch_id = Some(btn)
        view_app.secondary_touch_id = None
        view_pointer(0, x, y, now, button=1)
        view_pointer(1, x, y, now, button=1)
      }
      Some(primary) if primary != btn => {
        match view_app.secondary_touch_id {
          None => {
            view_app.secondary_touch_id = Some(btn)
            view_pointer(4, x, y, now, button=1)
          }
          Some(sec) if sec != btn => {
            view_pointer(9, x, y, now, button=1)
          }
          _ => ()
        }
      }
      _ => ()
    }
  } else if host_kind == 11 {
    match view_app.active_touch_id {
      Some(id) if id == btn => view_pointer(0, x, y, now, button=1)
      None => view_pointer(0, x, y, now, button=1)
      _ =>
      match view_app.secondary_touch_id {
        Some(sid) if sid == btn => view_pointer(5, x, y, now, button=1)
        _ => ()
      }
    }
  } else if host_kind == 12 {
    let is_primary = match view_app.active_touch_id {
      Some(id) => id == btn
      None => true
    }
    if is_primary {
      match view_app.secondary_touch_id {
        Some(sid) => {
          view_app.active_touch_id = Some(sid)
          view_app.secondary_touch_id = None
          view_pointer(8, x, y, now, button=1)
        }
        None => {
          view_app.active_touch_id = None
          view_pointer(2, x, y, now, button=1)
          view_pointer(0, -10000.0, -10000.0, now, button=1)
        }
      }
    } else {
      match view_app.secondary_touch_id {
        Some(sid) if sid == btn => {
          view_app.secondary_touch_id = None
          view_pointer(6, x, y, now, button=1)
        }
        _ => ()
      }
    }
  } else if host_kind == 13 {
    let matches_any = match view_app.active_touch_id {
      Some(id) if id == btn => true
      None => true
      _ =>
      match view_app.secondary_touch_id {
        Some(sid) if sid == btn => true
        _ => false
      }
    }
    if matches_any {
      view_app.active_touch_id = None
      view_app.secondary_touch_id = None
      view_pointer(3, x, y, now, button=1)
    }
  } else if host_kind == 7 {
    view_pointer(0, -10000.0, -10000.0, now, button=1)
  } else if host_kind >= 0 && host_kind <= 3 {
    let vp_kind = if host_kind == 0 {
      1
    } else if host_kind == 1 {
      0
    } else {
      host_kind
    }
    let vp_btn = if btn == 2 { 2 } else if btn == 1 || btn == 3 { 3 } else { 1 }
    view_pointer(vp_kind, x, y, now, button=vp_btn)
  }
}

/// Dispatch a 4-argument host Back gesture/event (`kind`: 0=Began, 1=Moved, 2=Commit/Standalone, 3=Cancel)
/// on the host's currently selected window (`hostapi::window_current()`).
pub fn view_back(kind : Int, x : Double, progress : Double, edge : Int) -> Unit {
  let wid = hostapi::window_current()
  in_window(wid, fn() -> Unit {
    let tree = match window_tree_of(wid) {
      Some(t) => t
      None => return
    }
    let at = hostapi::now()
    let (win_w, _) = signals::untracked(fn() { tree_window_size_sig.v.get() })
    let rel_x_for = fn(owner : view::NodeId) -> Double {
      if edge == 1 {
        let taker_right = match tree.drawn_of(owner) {
          Some(d) => d.x + d.w
          None => win_w
        }
        taker_right - x
      } else {
        let taker_left = match tree.drawn_of(owner) {
          Some(d) => d.x
          None => 0.0
        }
        x - taker_left
      }
    }
    back_progress_sig.v.set(progress)
    if kind == 0 {
      match back_gesture_state.v {
        BackGestureState::Active(prev_owner) => {
          back_gesture_seq.v = back_gesture_seq.v + 1
          let cancel_seq = back_gesture_seq.v
          back_gesture_state.v = BackGestureState::Idle
          let _ = tree.back_step(prev_owner, view::BackStep::CalledOff, at)
          if back_gesture_seq.v != cancel_seq {
            sync_back_enabled(tree)
            return
          }
        }
        _ => ()
      }
      match tree.back_taker() {
        Some(owner) => {
          let rx = rel_x_for(owner)
          back_gesture_seq.v = back_gesture_seq.v + 1
          let my_seq = back_gesture_seq.v
          back_gesture_state.v = BackGestureState::Active(owner)
          let ok = tree.back_step(owner, view::BackStep::Began(rx, at), at)
          if back_gesture_seq.v == my_seq && !ok {
            back_gesture_state.v = BackGestureState::CancelledByFramework
          }
        }
        None => {
          back_gesture_seq.v = back_gesture_seq.v + 1
          back_gesture_state.v = BackGestureState::CancelledByFramework
        }
      }
      sync_back_enabled(tree)
    } else if kind == 1 {
      match back_gesture_state.v {
        BackGestureState::Active(owner) => {
          let rx = rel_x_for(owner)
          if !tree.back_step(owner, view::BackStep::Moved(rx, at), at) {
            back_gesture_seq.v = back_gesture_seq.v + 1
            back_gesture_state.v = BackGestureState::CancelledByFramework
            let _ = tree.back_step(owner, view::BackStep::CalledOff, at)
            sync_back_enabled(tree)
          }
        }
        _ => ()
      }
    } else if kind == 2 {
      match back_gesture_state.v {
        BackGestureState::Active(owner) => {
          back_gesture_seq.v = back_gesture_seq.v + 1
          back_gesture_state.v = BackGestureState::Idle
          back_progress_sig.v.set(0.0)
          let _ = tree.back_done(owner, at)
          sync_back_enabled(tree)
        }
        BackGestureState::Idle => {
          back_progress_sig.v.set(0.0)
          match tree.back_taker() {
            Some(taker) => {
              let _ = tree.back_step(taker, view::BackStep::Back, at)
            }
            None => ()
          }
          sync_back_enabled(tree)
        }
        BackGestureState::CancelledByFramework => {
          back_gesture_state.v = BackGestureState::Idle
          back_progress_sig.v.set(0.0)
          sync_back_enabled(tree)
        }
      }
    } else {
      match back_gesture_state.v {
        BackGestureState::Active(owner) => {
          back_gesture_seq.v = back_gesture_seq.v + 1
          back_gesture_state.v = BackGestureState::Idle
          back_progress_sig.v.set(0.0)
          let _ = tree.back_step(owner, view::BackStep::CalledOff, at)
          sync_back_enabled(tree)
        }
        BackGestureState::CancelledByFramework => {
          back_gesture_state.v = BackGestureState::Idle
          back_progress_sig.v.set(0.0)
          sync_back_enabled(tree)
        }
        BackGestureState::Idle => ()
      }
    }
  })
}

/// Dispatch an asynchronous host outside event (`set_outside`: 1=image, 3=pick, 9=clipboard, 11=posted, 17=window).
pub fn view_outside_event(kind : Int, id : Int, _st : Int) -> Unit {
  if kind == 1 {
    image_bump_rev()
    hostapi::request_frame()
  } else if kind == 3 {
    let _ = drop_pick_ready(id)
    hostapi::request_frame()
  } else if kind == 9 {
    let _ = field_clip_read_ready(id)
    hostapi::request_frame()
  } else if kind == 11 {
    messages_between()
  } else if kind == 17 {
    window_closed_by_host(id)
  } else {
    hostapi::request_frame()
  }
}

/// Open a pure-tree window and run `tree` until it closes.
/// `transitions_only` defaults to true so changes outside `view::transition` settle immediately.
pub fn run(
  title : String,
  tree : (view::View) -> Unit,
  theme? : () -> Theme,
  transitions_only~ : Bool = true,
) -> Unit {
  view::faults_stop.v = false
  let made = if transitions_only {
    fn(root : view::View) {
      let _ = root.transitions_only()
      tree(root)
    }
  } else {
    tree
  }
  match theme {
    Some(tf) => set_view_app(made, theme=tf)
    None => set_view_app(made)
  }
  hostapi::set_back(view_back)
  // A host that draws only when asked (Windows, Linux) hears of every change marked in the tree (an input's, a
  // signal's, a moment come), and after each frame of what is moving or due next.
  match view_app.tree {
    Some(tree) => tree.on_due(fn() {
      if in_tree_frame.v {
        hostapi::request_frame_on()
      } else {
        hostapi::request_frame()
      }
    })
    None => ()
  }
  // Deliver asynchronous host events between frames (1=image, 3=pick, 9=clipboard, 11=posted, 17=window).
  let _ = hostapi::set_outside(fn(kind : Int, id : Int, st : Int) -> Unit {
    view_outside_event(kind, id, st)
  })
  hostapi::run(
    title,
    fn(w, h, scale, now) {
      in_host_window(fn() {
        let _ = view_frame(w, h, scale, now)
        frames_asked_after(now)
      })
    },
    fn(host_kind, x, y, btn) {
      in_host_window(fn() { view_host_pointer(host_kind, x, y, btn, hostapi::now()) })
    },
    fn(x, y, dx, dy, phase) {
      in_host_window(fn() { view_wheel(x, y, dx, dy, hostapi::now(), phase=phase) })
    },
    fn(code, mods) {
      in_host_window(fn() { let _ = view_key(code, mods, hostapi::now()) })
    },
    fn(kind, s, a, b) {
      in_host_window(fn() { view_text(kind, s, a=a, b=b) })
    },
  )
}

/// After a frame: another at once while something reads the clock (a motion going), else one at the soonest moment due.
fn frames_asked_after(now : Double) -> Unit {
  match view_app.tree {
    Some(tree) =>
    if tree.clock_read() {
      hostapi::request_frame_on()
    } else {
      match tree.wake() {
        Some(at) => hostapi::wake_after(dmax(at - now, 0.0))
        None => ()
      }
    }
    None => ()
  }
}

/// Compatibility alias for `run`.
pub fn run_tree(
  title : String,
  tree : (view::View) -> Unit,
  theme? : () -> Theme,
  transitions_only~ : Bool = true,
) -> Unit {
  match theme {
    Some(tf) => run(title, tree, theme=tf, transitions_only=transitions_only)
    None => run(title, tree, transitions_only=transitions_only)
  }
}
