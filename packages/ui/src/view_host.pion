  frame_no: 0,
  last_w: 0.0,
  last_h: 0.0,
  last_scale: 1.0,
  pointer_x: 0.0,
  pointer_y: 0.0,
  press_x: 0.0,
  press_y: 0.0,
  press_down: false,
  pressed_node: None,
  dragging_node: None,
  claim_chain: [],
  press_events: [],
  down2: None,
  active_touch_id: None,
  secondary_touch_id: None,
  finger_0: 0,
  finger_1: -1,
  finger_next: 1,
  last_present_hash: 0L,
  underlay_painter: None,
  fast_present: false,
  pointer_interceptor: None,
  wheel_interceptor: None,
