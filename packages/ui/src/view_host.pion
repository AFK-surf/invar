  mut dragging_node : Option[view::NodeId]
  mut claim_chain : Array[(view::NodeId, Int)]
  mut press_events : Array[(Double, Double, Double)]
  mut down2 : Option[(Double, Double, Array[(Double, Double, Double)])]
  mut active_touch_id : Option[Int]
  mut secondary_touch_id : Option[Int]
