// Pure-tree window host runtime: 60-Double Scene encoding aligned 100% with apple_render.m,
// damage tracking, view_tree, set_view_app, run, run_tree, encode_tree_scene, and full event
// routing (pointer down/move/up/cancel, drag/gesture, right-click menu, wheel, Keymap/stroke/on_key/IME).
// Ported from libs/mbui/src/ui/view_host.mbt, app.mbt, scene.mbt.

import "damage"
import "dmath"
import "hostapi"
import "paint"
import "signals"
import "view"

/// Instance stride in the flat Double scene buffer sent to hostapi::present and damage::Damage (60 doubles = 15 float4).
pub let inst_size : Int = 60

/// Encoded GPU scene for a single frame (60 doubles per instance matching apple_render.m struct Inst).
pub struct Scene {
  pub inst : Array[Double]
  pub segs : Array[Double]
  pub mut ninst : Int
  pub mut width : Double
  pub mut height : Double
  pub mut scale : Double
  pub mut dirty_count : Int
  pub mut glass_run : Int
  pub mut frost_run : Int
  pub mut liquid_run : Int
  pub mut liquid_blur : Double
  pub mut glass_run_start : Int
  pub mut glass_run_len : Int
  pub perf : FramePerf
}

pub fn Scene::new() -> Scene {
  Scene::{
    inst: [],
    segs: [],
    ninst: 0,
    width: 0.0,
    height: 0.0,
    scale: 1.0,
    dirty_count: 0,
    glass_run: 0,
    frost_run: 0,
    liquid_run: 0,
    liquid_blur: 0.0,
    glass_run_start: -1,
    glass_run_len: 0,
    perf: FramePerf::zero(),
  }
}

pub fn Scene::clear(self : Scene, w : Double, h : Double, scale : Double) -> Unit {
  self.inst.clear()
  self.segs.clear()
  self.ninst = 0
  self.width = w
  self.height = h
  self.scale = scale
  self.dirty_count = 0
  self.glass_run = 0
  self.frost_run = 0
  self.liquid_run = 0
  self.liquid_blur = 0.0
  self.glass_run_start = -1
  self.glass_run_len = 0
}

/// Push a 60-Double instance aligned with apple_render.m:259 `struct Inst`:
///   0..3   rect (x, y, w, h)
///   4..7   p (radius, kind, p6/bw/sat, p7/blur)
///   8..11  color (r, g, b, a)
///   12..15 c2 (border RGBA / glyph uv+wh / shadow flags / glass params)
///   16..19 clip (x0, y0, x1, y1) — defaults to (0, 0, 1e9, 1e9) so unclipped quads are never discarded
///   20..23 pad (tex_id, extra0, extra1, extra2)
///   24..27 rc (rounded clip corners)
///   28..31 rs (clip corner smoothness)
///   32..35 rot (angle, ox, oy, outer_clip_flag)
///   36..39 rr (box per-corner radii tl, tr, br, bl)
///   40..59 oclip, orc, ors, fade, fadex
pub fn Scene::push_inst(
  self : Scene,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  radius : Double,
  kind : Double,
  p6 : Double,
  p7 : Double,
  color : Int64,
  alpha_mul : Double,
  p12 : Double,
  p13 : Double,
  p14 : Double,
  p15 : Double,
  clip_x~ : Double = 0.0,
  clip_y~ : Double = 0.0,
  clip_x1~ : Double = 1.0e9,
  clip_y1~ : Double = 1.0e9,
  tex_id~ : Double = 0.0,
) -> Int {
  let idx = self.ninst
  let r = ((color >> 24) & 0xFFL).to_double() / 255.0
  let g = ((color >> 16) & 0xFFL).to_double() / 255.0
  let b = ((color >> 8) & 0xFFL).to_double() / 255.0
  let a = ((color & 0xFFL).to_double() / 255.0) * dclamp(alpha_mul, 0.0, 1.0)
  // 0..3: rect
  self.inst.push(x)
  self.inst.push(y)
  self.inst.push(w)
  self.inst.push(h)
  // 4..7: p (radius, kind, p6, p7)
  self.inst.push(radius)
  self.inst.push(kind)
  self.inst.push(p6)
  self.inst.push(p7)
  // 8..11: color rgba
  self.inst.push(r)
  self.inst.push(g)
  self.inst.push(b)
  self.inst.push(a)
  // 12..15: c2
  self.inst.push(p12)
  self.inst.push(p13)
  self.inst.push(p14)
  self.inst.push(p15)
  // 16..19: clip (x0, y0, x1, y1)
  self.inst.push(clip_x)
  self.inst.push(clip_y)
  self.inst.push(clip_x1)
  self.inst.push(clip_y1)
  // 20..23: pad (tex_id, extra0, extra1, extra2)
  self.inst.push(tex_id)
  self.inst.push(0.0)
  self.inst.push(0.0)
  self.inst.push(0.0)
  // 24..35: rc (24..27), rs (28..31), rot (32..35)
  let mut z = 24
  while z < 36 {
    self.inst.push(0.0)
    z += 1
  }
  // 36..39: rr (box per-corner radii tl, tr, br, bl)
  self.inst.push(radius)
  self.inst.push(radius)
  self.inst.push(radius)
  self.inst.push(radius)
  // 40..59: oclip, orc, ors, fade, fadex
  let mut pad = 40
  while pad < inst_size {
    self.inst.push(0.0)
    pad += 1
  }
  self.ninst = idx + 1
  if (kind - 5.0).abs() > 0.01 && (kind - 6.0).abs() > 0.01 {
    self.glass_run_start = -1
    self.glass_run_len = 0
  }
  idx
}

/// Fast path for glyph quads (kind=1.0 mono or 3.0 color) with pre-unpacked RGBA.
fn Scene::push_glyph_inst(
  self : Scene,
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  kind : Double,
  r : Double,
  g : Double,
  b : Double,
  a : Double,
  u : Double,
  v : Double,
  uw : Double,
  vh : Double,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
) -> Unit {
  let inst = self.inst
  // 0..3: rect
  inst.push(x)
  inst.push(y)
  inst.push(w)
  inst.push(h)
  // 4..7: p (radius=0, kind, 0, 0)
  inst.push(0.0)
  inst.push(kind)
  inst.push(0.0)
  inst.push(0.0)
  // 8..11: color rgba
  inst.push(r)
  inst.push(g)
  inst.push(b)
  inst.push(a)
  // 12..15: c2 (glyph uv+wh)
  inst.push(u)
  inst.push(v)
  inst.push(uw)
  inst.push(vh)
  // 16..19: clip
  inst.push(clip_x)
  inst.push(clip_y)
  inst.push(clip_x1)
  inst.push(clip_y1)
  // 20..59: 40 zeros (tex_id=0, pad=0, rc=0, rs=0, rot=0, rr=0, oclip..fadex=0)
  let mut z = 20
  while z < 60 {
    inst.push(0.0)
    z += 1
  }
  self.ninst += 1
  self.glass_run_start = -1
  self.glass_run_len = 0
}

/// Set per-corner box radii `rr` in slots 36..39 (tl, tr, br, bl).
pub fn Scene::set_corners(self : Scene, idx : Int, c0 : Double, c1 : Double, c2 : Double, c3 : Double) -> Unit {
  let base = idx * inst_size
  if base + 39 < self.inst.length() {
    self.inst[base + 36] = c0
    self.inst[base + 37] = c1
    self.inst[base + 38] = c2
    self.inst[base + 39] = c3
  }
}

/// Set rounded clip corner radii `rc` in slots 24..27 (tl, tr, br, bl).
pub fn Scene::set_clip_corners(self : Scene, idx : Int, c0 : Double, c1 : Double, c2 : Double, c3 : Double) -> Unit {
  let base = idx * inst_size
  if base + 27 < self.inst.length() {
    self.inst[base + 24] = c0
    self.inst[base + 25] = c1
    self.inst[base + 26] = c2
    self.inst[base + 27] = c3
  }
}

/// Set rotation transform `rot` in slots 32..35: `(angle, ox, oy, outer_clip_flag)`.
pub fn Scene::set_rot(
  self : Scene,
  idx : Int,
  angle : Double,
  ox : Double,
  oy : Double,
  outer_clip~ : Bool = true,
) -> Unit {
  let base = idx * inst_size
  if base + 35 < self.inst.length() {
    self.inst[base + 32] = angle
    self.inst[base + 33] = ox
    self.inst[base + 34] = oy
    self.inst[base + 35] = if outer_clip { 1.0 } else { 0.0 }
  }
}

/// Emit a single antialiased line segment as a rotated rounded capsule (`kind = 0.0`)
/// so diagonal lines avoid AABB overdraw while sharing the renderer's `1.0pt` AA expansion.
pub fn Scene::emit_line(
  self : Scene,
  x0 : Double,
  y0 : Double,
  x1 : Double,
  y1 : Double,
  width : Double,
  color : Int64,
  alpha~ : Double = 1.0,
  clip_x~ : Double = 0.0,
  clip_y~ : Double = 0.0,
  clip_x1~ : Double = 1.0e9,
  clip_y1~ : Double = 1.0e9,
) -> Unit {
  if width <= 0.0 || (color & 0xFFL) == 0L || alpha <= 0.0 {
    return
  }
  let dx = x1 - x0
  let dy = y1 - y0
  let len = dmath::sqrt(dx * dx + dy * dy)
  let mx = (x0 + x1) * 0.5
  let my = (y0 + y1) * 0.5
  let w = len + width
  let h = width
  let r = width * 0.5
  let idx = self.push_inst(
    mx - w * 0.5, my - h * 0.5, w, h, r, 0.0, 0.0, 0.0, color, alpha,
    0.0, 0.0, 0.0, 0.0,
    clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
  )
  if len > 1.0e-9 {
    let angle = dmath::atan2(dy, dx)
    if angle.abs() > 1.0e-9 {
      self.set_rot(idx, angle, mx, my, outer_clip=true)
    }
  }
}

pub fn Scene::copy(self : Scene) -> Scene {
  Scene::{
    inst: self.inst.copy(),
    segs: self.segs.copy(),
    ninst: self.ninst,
    width: self.width,
    height: self.height,
    scale: self.scale,
    dirty_count: self.dirty_count,
    glass_run: self.glass_run,
    frost_run: self.frost_run,
    liquid_run: self.liquid_run,
    liquid_blur: self.liquid_blur,
    glass_run_start: self.glass_run_start,
    glass_run_len: self.glass_run_len,
    perf: FramePerf::{
      frame_ms: self.perf.frame_ms,
      layout_ms: self.perf.layout_ms,
      paint_ms: self.perf.paint_ms,
      present_ms: self.perf.present_ms,
      instances: self.perf.instances,
      dirty_rects: self.perf.dirty_rects,
    },
  }
}

struct ViewAppState {
  mut tree : Option[view::Tree]
  mut maker : Option[(view::View) -> Unit]
  mut scene : Scene
  mut dmg : damage::Damage
  mut a11y : A11yTold
  mut frame_no : Int
  mut last_w : Double
  mut last_h : Double
  mut last_scale : Double
  mut pointer_x : Double
  mut pointer_y : Double
  mut press_x : Double
  mut press_y : Double
  mut press_down : Bool
  mut pressed_node : Option[view::NodeId]
  mut dragging_node : Option[view::NodeId]
  mut claim_chain : Array[(view::NodeId, Int)]
  mut last_present_hash : Int64
  mut underlay_painter : Option[(Scene, Double, Double, Double, Double) -> Unit]
  mut fast_present : Bool
  mut pointer_interceptor : Option[(Int, Double, Double, Int, Int) -> Bool]
  mut wheel_interceptor : Option[(Double, Double, Double, Double, Int) -> Bool]
  mut key_interceptor : Option[(Int, Int, Bool) -> Bool]
  mut text_interceptor : Option[(Int, String, Int, Int) -> Bool]
  mut last_wheel_phase : Int
}

let view_app : ViewAppState = ViewAppState::{
  tree: None,
  maker: None,
  scene: Scene::new(),
  dmg: damage::Damage::new(),
  a11y: A11yTold::new(),
  frame_no: 0,
  last_w: 0.0,
  last_h: 0.0,
  last_scale: 1.0,
  pointer_x: 0.0,
  pointer_y: 0.0,
  press_x: 0.0,
  press_y: 0.0,
  press_down: false,
  pressed_node: None,
  dragging_node: None,
  claim_chain: [],
  last_present_hash: 0L,
  underlay_painter: None,
  fast_present: false,
  pointer_interceptor: None,
  wheel_interceptor: None,
  key_interceptor: None,
  text_interceptor: None,
  last_wheel_phase: 0,
}

/// Active pure-tree window Tree (None before app starts or after dispose).
pub fn view_tree() -> Option[view::Tree] {
  view_app.tree
}

pub fn view_scene_last() -> Scene {
  view_app.scene
}

/// Register a low-level underlay painter invoked after `scene.clear` and before `encode_held_tree`.
pub fn set_underlay_painter(f : Option[(Scene, Double, Double, Double, Double) -> Unit]) -> Unit {
  view_app.underlay_painter = f
}

/// Toggle fast-present mode (skips damage diffing and scene hashing in `view_frame`).
pub fn set_fast_present(on : Bool) -> Unit {
  view_app.fast_present = on
}

/// Register a pointer event interceptor `(vp_kind, x, y, vp_btn, mods) -> Bool`.
pub fn set_pointer_interceptor(f : Option[(Int, Double, Double, Int, Int) -> Bool]) -> Unit {
  view_app.pointer_interceptor = f
}

/// Register a wheel event interceptor `(x, y, dx, dy, phase) -> Bool`.
pub fn set_wheel_interceptor(f : Option[(Double, Double, Double, Double, Int) -> Bool]) -> Unit {
  view_app.wheel_interceptor = f
}

/// Last wheel event phase received by `view_wheel` / `run`.
pub fn last_wheel_phase() -> Int {
  view_app.last_wheel_phase
}

/// Register a keyboard event interceptor `(code, mods, is_up) -> Bool`.
pub fn set_key_interceptor(f : Option[(Int, Int, Bool) -> Bool]) -> Unit {
  view_app.key_interceptor = f
}

/// Register a text/IME event interceptor `(kind, text, a, b) -> Bool`.
pub fn set_text_interceptor(f : Option[(Int, String, Int, Int) -> Bool]) -> Unit {
  view_app.text_interceptor = f
}

/// Thread-safe frame wake-up callable from any background OS thread.
pub fn wake_now() -> Unit {
  hostapi::wake_now()
}

struct BeforeFrameHook {
  id : Int
  cb : () -> Unit
}

struct BeforeFrameState {
  mut next_id : Int
  hooks : Array[BeforeFrameHook]
}

let before_frame_state : BeforeFrameState = BeforeFrameState::{ next_id: 1, hooks: [] }

/// Register a callback invoked at the start of every `view_frame`, before `tree.frame(...)`.
/// Returns a hook id that can be passed to `remove_before_frame`.
pub fn on_before_frame(cb : () -> Unit) -> Int {
  let id = before_frame_state.next_id
  before_frame_state.next_id = id + 1
  before_frame_state.hooks.push(BeforeFrameHook::{ id, cb })
  id
}

/// Remove a previously registered `on_before_frame` callback by id.
pub fn remove_before_frame(id : Int) -> Unit {
  let mut i = 0
  while i < before_frame_state.hooks.length() {
    if before_frame_state.hooks[i].id == id {
      array_remove_at(before_frame_state.hooks, i)
      return
    }
    i += 1
  }
}

fn clear_before_frame_hooks() -> Unit {
  before_frame_state.hooks.clear()
}

fn run_before_frame_hooks() -> Unit {
  if before_frame_state.hooks.length() == 0 {
    return
  }
  let snapshot = before_frame_state.hooks.copy()
  for h in snapshot {
    (h.cb)()
  }
}

fn view_forget() -> Unit {
  clear_before_frame_hooks()
  match view_app.tree {
    Some(t) => t.dispose()
    None => ()
  }
  view_app.tree = None
  view_app.maker = None
  view_app.scene = Scene::new()
  view_app.dmg = damage::Damage::new()
  view_app.a11y = A11yTold::new()
  view_app.frame_no = 0
  view_app.last_w = 0.0
  view_app.last_h = 0.0
  view_app.last_scale = 1.0
  view_app.press_down = false
  view_app.pressed_node = None
  view_app.dragging_node = None
  view_app.claim_chain.clear()
  view_app.last_present_hash = 0L
  view_app.underlay_painter = None
  view_app.fast_present = false
  view_app.pointer_interceptor = None
  view_app.wheel_interceptor = None
  view_app.key_interceptor = None
  view_app.text_interceptor = None
  view_app.last_wheel_phase = 0
  fields_reset()
  streams_and_natives_reset()
  reset_glyph_atlas()
  reset_glass_light_angle()
}

/// Register the pure-tree root builder and optional reactive theme provider.
pub fn set_view_app(make : (view::View) -> Unit, theme? : () -> Theme) -> Unit {
  view_forget()
  match theme {
    Some(tf) => set_tree_theme(tf)
    None => clear_tree_theme()
  }
  view_app.maker = Some(make)
  let tree = view::Tree::new(
    make,
    measure=host_words_measure,
    measure_runs=host_runs_measure,
    measure_runs_least=host_runs_least_measure,
    // (its clock starts at the host's now, the one every frame and event after is told in: started at 0, the first
    // frame took it from 0 to the host's (on Windows, ms since boot), and what was set at a moment of the old start
    // (at_moment(cause_at() + 1000), again at each) came due once for each second between: ~300 000 turns, 0.18 s of a
    // window's start, 2026-11-22)
    time=hostapi::now,
  )
  tree.on_due(fn() { hostapi::request_frame() })
  view_app.tree = Some(tree)
}

fn color_rgba_tuple(c : Int64, alpha_mul : Double) -> (Double, Double, Double, Double) {
  let r = ((c >> 24) & 0xFFL).to_double() / 255.0
  let g = ((c >> 16) & 0xFFL).to_double() / 255.0
  let b = ((c >> 8) & 0xFFL).to_double() / 255.0
  let a = ((c & 0xFFL).to_double() / 255.0) * dclamp(alpha_mul, 0.0, 1.0)
  (r, g, b, a)
}

fn apply_node_corners(scene : Scene, idx : Int, d : view::Drawn) -> Unit {
  match d.corners {
    Some((c0, c1, c2, c3)) => scene.set_corners(idx, c0, c1, c2, c3)
    None => ()
  }
}

fn node_corners_tuple(d : view::Drawn) -> (Double, Double, Double, Double) {
  match d.corners {
    Some((c0, c1, c2, c3)) => (c0, c1, c2, c3)
    None => (d.radius, d.radius, d.radius, d.radius)
  }
}

fn intersect_clip(
  a_clip : (Double, Double, Double, Double),
  a_rc : (Double, Double, Double, Double),
  bx0 : Double,
  by0 : Double,
  bx1 : Double,
  by1 : Double,
  b_rc : (Double, Double, Double, Double),
) -> ((Double, Double, Double, Double), (Double, Double, Double, Double)) {
  let (ax0, ay0, ax1, ay1) = a_clip
  let nx0 = dmax(ax0, bx0)
  let ny0 = dmax(ay0, by0)
  let nx1 = dmin(ax1, bx1)
  let ny1 = dmin(ay1, by1)
  let eps = 0.01
  let c0 = if (nx0 - bx0).abs() < eps && (ny0 - by0).abs() < eps {
    if (nx0 - ax0).abs() < eps && (ny0 - ay0).abs() < eps { dmax(a_rc.0, b_rc.0) } else { b_rc.0 }
  } else if (nx0 - ax0).abs() < eps && (ny0 - ay0).abs() < eps {
    a_rc.0
  } else {
    0.0
  }
  let c1 = if (nx1 - bx1).abs() < eps && (ny0 - by0).abs() < eps {
    if (nx1 - ax1).abs() < eps && (ny0 - ay0).abs() < eps { dmax(a_rc.1, b_rc.1) } else { b_rc.1 }
  } else if (nx1 - ax1).abs() < eps && (ny0 - ay0).abs() < eps {
    a_rc.1
  } else {
    0.0
  }
  let c2 = if (nx1 - bx1).abs() < eps && (ny1 - by1).abs() < eps {
    if (nx1 - ax1).abs() < eps && (ny1 - ay1).abs() < eps { dmax(a_rc.2, b_rc.2) } else { b_rc.2 }
  } else if (nx1 - ax1).abs() < eps && (ny1 - ay1).abs() < eps {
    a_rc.2
  } else {
    0.0
  }
  let c3 = if (nx0 - bx0).abs() < eps && (ny1 - by1).abs() < eps {
    if (nx0 - ax0).abs() < eps && (ny1 - ay1).abs() < eps { dmax(a_rc.3, b_rc.3) } else { b_rc.3 }
  } else if (nx0 - ax0).abs() < eps && (ny1 - ay1).abs() < eps {
    a_rc.3
  } else {
    0.0
  }
  ((nx0, ny0, nx1, ny1), (c0, c1, c2, c3))
}

fn glass_spot(spot : Option[(Double, Double)]) -> Double {
  match spot {
    None => 0.0
    Some((lx, ly)) => {
      let qx = dclamp(((lx + 256.0) * 2.0).round(), 0.0, 4095.0)
      let qy = dclamp(((ly + 256.0) * 2.0).round(), 0.0, 4095.0)
      qx * 4096.0 + qy + 1.0
    }
  }
}

fn rects_meet_by(j : Int, k : Int, a : Array[Double], pad : Double) -> Bool {
  let bj = j * inst_size
  let bk = k * inst_size
  a[bj] - pad < a[bk] + a[bk + 2] &&
  a[bk] - pad < a[bj] + a[bj + 2] &&
  a[bj + 1] - pad < a[bk + 1] + a[bk + 3] &&
  a[bk + 1] - pad < a[bj + 1] + a[bj + 3]
}

fn Scene::glass_capture(self : Scene, k : Int, liquid : Bool, shares : Bool) -> Unit {
  let b = k * inst_size
  let a = self.inst
  let kind = a[b + 5]
  let blur = a[b + 7]
  let eff_blur = if liquid && blur < 0.0 { 0.0 } else { blur }
  let is_single_liquid = liquid && a[b + 23] <= 0.0
  if shares && !liquid && self.frost_run != 0 {
    a[b + 20] = -self.frost_run.to_double()
    return
  }
  if shares && is_single_liquid && eff_blur >= 0.0 && self.liquid_run != 0 && self.liquid_blur == eff_blur {
    a[b + 20] = -self.liquid_run.to_double()
    return
  }
  let prev = self.glass_run_start + self.glass_run_len
  let prev_is_single = liquid && k > 0 && a[(k - 1) * inst_size + 23] <= 0.0
  let prev_eff_blur = if k > 0 {
    let pb = a[(k - 1) * inst_size + 7]
    if liquid && pb < 0.0 { 0.0 } else { pb }
  } else {
    0.0
  }
  let mut same = self.glass_run != 0 &&
    prev == k &&
    eff_blur >= 0.0 &&
    a[(k - 1) * inst_size + 5] == kind &&
    prev_eff_blur == eff_blur &&
    (!liquid ||
      (is_single_liquid && prev_is_single) ||
      (!is_single_liquid && !prev_is_single && self.glass_run_len < 8))
  if same && (!liquid || is_single_liquid) {
    let pad = if is_single_liquid { 2.0 } else { 0.0 }
    let mut j = self.glass_run_start
    while j < k {
      if rects_meet_by(j, k, a, pad) {
        same = false
        break
      }
      j += 1
    }
  }
  if same {
    self.glass_run_len = self.glass_run_len + 1
  } else {
    self.glass_run = self.glass_run + 1
    self.glass_run_start = k
    self.glass_run_len = 1
    if !liquid {
      self.frost_run = self.glass_run
    } else if is_single_liquid && eff_blur >= 0.0 {
      self.liquid_run = self.glass_run
      self.liquid_blur = eff_blur
    }
  }
  a[b + 20] = -self.glass_run.to_double()
}

fn encode_glass(
  scene : Scene,
  d : view::Drawn,
  gl : paint::Glass,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
) -> Unit {
  if gl.strength <= 0.001 {
    return
  }
  let eff_alpha = d.alpha * gl.strength
  if glass_solid() {
    let idx = scene.push_inst(
      d.x, d.y, d.w, d.h, d.radius, 0.0, 0.0, 0.0, gl.solid, eff_alpha,
      0.0, 0.0, 0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    apply_node_corners(scene, idx, d)
    return
  }
  let kind = if gl.liquid { 6.0 } else { 5.0 }
  let blur_slot = if !gl.liquid {
    if gl.contained { -gl.blur } else { gl.blur }
  } else if gl.blur <= 0.0 && gl.zoom > 1.0001 {
    -(dmin(gl.zoom, 3.0) - 1.0)
  } else {
    dmax(gl.blur, 0.0)
  }
  let idx = scene.push_inst(
    d.x, d.y, d.w, d.h, d.radius, kind, gl.saturation, blur_slot, gl.tint, 1.0,
    if gl.liquid { gl.rim } else { gl.rim_edge },
    if gl.liquid { gl.bezel } else { gl.rim_lit },
    if gl.liquid { glass_spot(gl.spot) } else { gl.rim_back },
    eff_alpha,
    clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
  )
  let base = idx * inst_size
  if base + 23 < scene.inst.length() {
    scene.inst[base + 21] = gl.refraction
    scene.inst[base + 22] = gl.chroma
    scene.inst[base + 23] = gl.merge
  }
  scene.glass_capture(idx, gl.liquid, gl.shares_capture)
  apply_node_corners(scene, idx, d)
}

fn emit_node_shadow(
  scene : Scene,
  d : view::Drawn,
  outside : Bool,
  clip_x : Double,
  clip_y : Double,
  clip_x1 : Double,
  clip_y1 : Double,
  rc : (Double, Double, Double, Double),
) -> Unit {
  let (sblur, sy, scol) = d.shadow
  if sblur > 0.0 && (scol & 0xFFL) != 0L {
    let sidx = scene.push_inst(
      d.x, d.y + sy, d.w, d.h, d.radius, 2.0, 0.0, sblur, scol, d.alpha,
      if outside { 1.0 } else { 0.0 },
      if outside { sy } else { 0.0 },
      0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    apply_node_corners(scene, sidx, d)
    scene.set_clip_corners(sidx, rc.0, rc.1, rc.2, rc.3)
    if d.turn != 0.0 {
      let sb = sidx * inst_size
      scene.inst[sb + 32] = d.turn
      scene.inst[sb + 33] = d.x + d.w * 0.5
      scene.inst[sb + 34] = d.y + d.h * 0.5
      scene.inst[sb + 35] = 1.0
    }
  }
}

struct DeferredGlassShadow {
  d : view::Drawn
  clip : (Double, Double, Double, Double)
  rc : (Double, Double, Double, Double)
}

fn flush_deferred_shadows(scene : Scene, pending : Array[DeferredGlassShadow]) -> Unit {
  if pending.length() == 0 {
    return
  }
  for item in pending {
    let (cx0, cy0, cx1, cy1) = item.clip
    emit_node_shadow(scene, item.d, true, cx0, cy0, cx1, cy1, item.rc)
  }
  pending.clear()
}

fn encode_drawn_node(
  scene : Scene,
  d : view::Drawn,
  gd : view::GroundShape,
  node_scale : Double,
  frame_no : Int,
  now : Double,
  scale : Double,
  clip : (Double, Double, Double, Double),
  rc : (Double, Double, Double, Double),
  deferred_shadows : Array[DeferredGlassShadow],
) -> Unit {
  if d.alpha <= 0.0 || (d.w <= 0.0 && gd.dw <= 0.0) || (d.h <= 0.0 && gd.dh <= 0.0) {
    return
  }
  let (clip_x, clip_y, clip_x1, clip_y1) = clip
  let gx = d.x + gd.dx * node_scale
  let gy = d.y + gd.dy * node_scale
  let gw = d.w + gd.dw * node_scale
  let gh = d.h + gd.dh * node_scale
  let gcorners = match gd.corners {
    Some((c0, c1, c2, c3)) => Some((c0 * node_scale, c1 * node_scale, c2 * node_scale, c3 * node_scale))
    None => d.corners
  }
  let gradius = match gcorners {
    Some((c0, _, _, _)) => c0
    None => d.radius
  }
  let gd_visible = gw > 0.0 && gh > 0.0
  let gd_d = view::Drawn::{ ..d, x: gx, y: gy, w: gw, h: gh, radius: gradius, corners: gcorners }
  let eff_glass = match d.glass {
    Some(gl) if gl.strength > 0.001 => Some(gl)
    _ => None
  }
  let is_glass = eff_glass.is_some() && !glass_solid()
  let is_merged_liquid = match eff_glass {
    Some(gl) => gl.liquid && gl.merge > 0.0 && !glass_solid()
    None => false
  }
  if !is_merged_liquid {
    flush_deferred_shadows(scene, deferred_shadows)
  }
  let start_idx = scene.ninst

  // 1. Non-glass shadow drawn before ground (glass shadow is drawn after glass, outside-only)
  if gd_visible && !is_glass {
    emit_node_shadow(scene, gd_d, false, clip_x, clip_y, clip_x1, clip_y1, rc)
  }

  // 2. Glass (kind 5 frosted / 6 liquid) + outside-only shadow after glass
  match eff_glass {
    Some(gl) if gd_visible => {
      encode_glass(scene, gd_d, gl, clip_x, clip_y, clip_x1, clip_y1)
      if is_glass {
        let (sblur, _sy, scol) = d.shadow
        if sblur > 0.0 && (scol & 0xFFL) != 0L {
          if is_merged_liquid {
            deferred_shadows.push(DeferredGlassShadow::{ d: gd_d, clip, rc })
          } else {
            emit_node_shadow(scene, gd_d, true, clip_x, clip_y, clip_x1, clip_y1, rc)
          }
        }
      }
    }
    _ => ()
  }

  // 3. Ground fill + Border/edge merged into a single kind=0.0 instance (apple_render.m:629-634: bw=p6, bc=c2)
  let (ew, ecol) = d.edge
  let has_ground = (d.ground & 0xFFL) != 0L
  let has_edge = ew > 0.0 && (ecol & 0xFFL) != 0L
  if gd_visible && (has_ground || has_edge) {
    let (br, bg_c, bb, ba) = if has_edge { color_rgba_tuple(ecol, d.alpha) } else { (0.0, 0.0, 0.0, 0.0) }
    let idx = scene.push_inst(
      gd_d.x, gd_d.y, gd_d.w, gd_d.h, gd_d.radius, 0.0,
      if has_edge { ew } else { 0.0 },
      0.0,
      if has_ground { d.ground } else { 0L },
      d.alpha,
      br, bg_c, bb, ba,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    apply_node_corners(scene, idx, gd_d)
  }
  let after_ground_idx = scene.ninst

  // 4. Image (kind 4) — clamp req_px to actual physical drawn size (libs/mbui/src/ui/image.mbt:768)
  match d.image {
    Some((src, ph, max_px)) => {
      let drawn_px = (dmax(d.w, d.h) * dmax(scale, 1.0)).ceil().to_int()
      let px = if drawn_px > 0 {
        if max_px > 0 && drawn_px > max_px { max_px } else { drawn_px }
      } else if max_px > 0 {
        if max_px > 256 { 256 } else { max_px }
      } else {
        256
      }
      let primary = if src != "" { image_resolve(src, px, frame_no, now) } else { None }
      let resolved = match primary {
        Some(_) => primary
        None => if ph != "" && ph != src { image_resolve(ph, px, frame_no, now) } else { None }
      }
      match resolved {
        Some((hid, _iw, _ih)) => {
          let idx = scene.push_inst(
            d.x, d.y, d.w, d.h, d.radius, 4.0, 0.0, 0.0, c64(0xFFFF, 0xFFFF), d.alpha,
            0.0, 0.0, 1.0, 1.0,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
            tex_id=hid.to_double(),
          )
          apply_node_corners(scene, idx, d)
        }
        None => ()
      }
    }
    None => ()
  }

  // 5. Tree stream node (kind 4 with stream_tex_base + stream.id)
  match find_tree_stream(d.id) {
    Some(ts) => {
      ts.drawn_this_frame = true
      match ts.stream.size {
        Some((pw, ph)) if !ts.stream.closed && ts.stream.id > 0 && pw > 0 && ph > 0 => {
          let idx = scene.push_inst(
            d.x, d.y, d.w, d.h, d.radius, 4.0, 0.0, 0.0, c64(0xFFFF, 0xFFFF), d.alpha,
            0.0, 0.0, 1.0, 1.0,
            clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
            tex_id=(hostapi::stream_tex_base + ts.stream.id).to_double(),
          )
          apply_node_corners(scene, idx, d)
        }
        _ => ()
      }
    }
    None => ()
  }

  // 6. Tree native view node
  match find_tree_native(d.id) {
    Some(tn) => {
      tn.drawn_this_frame = true
      if !tn.view.closed && tn.view.id > 0 {
        hostapi::view_place(
          tn.view.id, d.x, d.y, d.w, d.h,
          clip_x, clip_y, clip_x1, clip_y1,
          rc.0, rc.1, rc.2, rc.3, true,
        )
      }
    }
    None => ()
  }

  // 7. Child rects (kind 0)
  for r in d.rects {
    let ridx = scene.push_inst(
      d.x + r.x, d.y + r.y, r.w, r.h, r.corners.0, 0.0, 0.0, 0.0, r.color, d.alpha,
      0.0, 0.0, 0.0, 0.0,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
    scene.set_corners(ridx, r.corners.0, r.corners.1, r.corners.2, r.corners.3)
  }

  // 7b. Vector shapes (kind = 11.0 bands + kind = 12.0 frame-tail segment packs)
  if d.shapes.length() > 0 {
    encode_shapes(scene, d, clip_x, clip_y, clip_x1, clip_y1)
  }

  // 8. Polylines (delegated to Scene::emit_line rotated capsules)
  let lines_start_idx = scene.ninst
  let line_turn = d.turn != 0.0 && d.lines.length() > 0
  let line_ox = d.x + d.w * 0.5
  let line_oy = d.y + d.h * 0.5
  let line_tc = if line_turn { dmath::cos(d.turn) } else { 1.0 }
  let line_ts = if line_turn { dmath::sin(d.turn) } else { 0.0 }
  for ln in d.lines {
    if ln.width > 0.0 && (ln.color & 0xFFL) != 0L && ln.points.length() >= 2 {
      let mut pi = 0
      while pi + 1 < ln.points.length() {
        let (ax, ay) = ln.points[pi]
        let (bx, by) = ln.points[pi + 1]
        let mut p0x = d.x + ax
        let mut p0y = d.y + ay
        let mut p1x = d.x + bx
        let mut p1y = d.y + by
        if line_turn {
          let adx = p0x - line_ox
          let ady = p0y - line_oy
          p0x = line_ox + line_tc * adx - line_ts * ady
          p0y = line_oy + line_ts * adx + line_tc * ady
          let bdx = p1x - line_ox
          let bdy = p1y - line_oy
          p1x = line_ox + line_tc * bdx - line_ts * bdy
          p1y = line_oy + line_ts * bdx + line_tc * bdy
        }
        scene.emit_line(
          p0x, p0y, p1x, p1y,
          ln.width, ln.color, alpha=d.alpha,
          clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
        )
        pi += 1
      }
    }
  }
  let lines_end_idx = scene.ninst

  // 9. Text glyphs via real CoreText/hostapi shaping + atlas (kind=1.0 mono / 3.0 color)
  if d.runs.length() > 0 {
    encode_runs(scene, d, scale, clip_x, clip_y, clip_x1, clip_y1)
  } else if d.words.length() > 0 {
    encode_words(scene, d, scale, clip_x, clip_y, clip_x1, clip_y1)
  }

  // 10. Focused field caret indicator
  match find_tree_field(d.id) {
    Some(tf) if tf.field.focused_sig.untracked() => {
      let sz = (tf.font_size)()
      let caret = tf.field.caret_sig.untracked()
      let cx = d.x + caret.to_double() * sz * 0.6
      let _ = scene.push_inst(
        cx, d.y + 2.0, 1.5, dmax(sz, 14.0), 0.75, 0.0, 0.0, 0.0, tf.field.caret_color, d.alpha,
        0.0, 0.0, 0.0, 0.0,
        clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
      )
      hostapi::set_ime(true, cx, d.y, 1.5, dmax(sz, 14.0), tf.field.text_sig.untracked(), caret, caret)
    }
    _ => ()
  }

  // 11. Outer focus ring (kind = 0.0 transparent fill + p6=rw + c2=rcol RGBA; never kind=1.0!)
  let (rw, rgap, rcol) = d.ring
  if rw > 0.0 && (rcol & 0xFFL) != 0L {
    let pad = rgap + rw
    let (rr_r, rr_g, rr_b, rr_a) = color_rgba_tuple(rcol, d.alpha)
    let _ = scene.push_inst(
      d.x - pad, d.y - pad, d.w + pad * 2.0, d.h + pad * 2.0,
      concentric_out(d.radius, pad), 0.0, rw, 0.0, 0L, d.alpha,
      rr_r, rr_g, rr_b, rr_a,
      clip_x=clip_x, clip_y=clip_y, clip_x1=clip_x1, clip_y1=clip_y1,
    )
  }

  // Apply inherited rounded clip `rc` (slots 24..27) and node rotation `d.turn` (slots 32..35)
  // uniformly to all instances emitted by this node.
  let has_rc = rc.0 > 0.0 || rc.1 > 0.0 || rc.2 > 0.0 || rc.3 > 0.0
  let has_rot = d.turn != 0.0
  if has_rc || has_rot {
    let gox = gx + gw * 0.5
    let goy = gy + gh * 0.5
    let ox = d.x + d.w * 0.5
    let oy = d.y + d.h * 0.5
    let mut idx = start_idx
    while idx < scene.ninst {
      if has_rc {
        scene.set_clip_corners(idx, rc.0, rc.1, rc.2, rc.3)
      }
      if has_rot && (idx < lines_start_idx || idx >= lines_end_idx) {
        let base = idx * inst_size
        scene.inst[base + 32] = d.turn
        scene.inst[base + 33] = if idx < after_ground_idx { gox } else { ox }
        scene.inst[base + 34] = if idx < after_ground_idx { goy } else { oy }
        scene.inst[base + 35] = 1.0
      }
      idx += 1
    }
  }
}

let cut_soft_most : Double = 24.0

fn cut_soft(out : Double, left : Double) -> Double {
  dmax(dmin(cut_soft_most, dmin(out, left)), 0.0)
}

fn inst_fade(
  inst : Array[Double],
  b : Int,
  top : Double,
  top_soft : Double,
  foot : Double,
  foot_soft : Double,
) -> Unit {
  if top_soft > 0.0 && (inst[b + 53] <= 0.0 || top + top_soft > inst[b + 52] + inst[b + 53]) {
    inst[b + 52] = top
    inst[b + 53] = top_soft
  }
  if foot_soft > 0.0 && (inst[b + 55] <= 0.0 || foot - foot_soft < inst[b + 54] - inst[b + 55]) {
    inst[b + 54] = foot
    inst[b + 55] = foot_soft
  }
}

fn inst_fade_across(
  inst : Array[Double],
  b : Int,
  start : Double,
  start_soft : Double,
  end : Double,
  end_soft : Double,
) -> Unit {
  if start_soft > 0.0 && (inst[b + 57] <= 0.0 || start + start_soft > inst[b + 56] + inst[b + 57]) {
    inst[b + 56] = start
    inst[b + 57] = start_soft
  }
  if end_soft > 0.0 && (inst[b + 59] <= 0.0 || end - end_soft < inst[b + 58] - inst[b + 59]) {
    inst[b + 58] = end
    inst[b + 59] = end_soft
  }
}

fn encode_held_tree(scene : Scene, tree : view::Tree, frame_no : Int, now : Double, scale : Double) -> Unit {
  ensure_glyph_atlas(scale)
  let scales : Array[Double] = []
  let held = tree.drawn_held(scales=scales)
  let n = held.length()
  let eff_clip : Array[(Double, Double, Double, Double)] = []
  let eff_rc : Array[(Double, Double, Double, Double)] = []
  let deferred_shadows : Array[DeferredGlassShadow] = []
  let fading : Array[(view::NodeId, (Double, Double, Double, Double), (Double, Double, Double, Double))] = []
  let mut i = 0
  while i < n {
    let (d, holder, _) = held[i]
    while fading.length() > 0 && !tree.holds_in_order(fading[fading.length() - 1].0, d.id) {
      let _ = fading.pop()
    }
    let node_scale = if i < scales.length() { scales[i] } else { 1.0 }
    let gd = tree.ground_drawn_of(d.id)
    let (in_clip, in_rc) = if holder >= 0 && holder < i {
      let p = held[holder].0
      if p.clips {
        intersect_clip(eff_clip[holder], eff_rc[holder], p.x, p.y, p.x + p.w, p.y + p.h, node_corners_tuple(p))
      } else {
        (eff_clip[holder], eff_rc[holder])
      }
    } else {
      ((0.0, 0.0, 1.0e9, 1.0e9), (0.0, 0.0, 0.0, 0.0))
    }
    eff_clip.push(in_clip)
    eff_rc.push(in_rc)
    let (draw_clip, draw_rc) = if d.clips_self {
      intersect_clip(in_clip, in_rc, d.x, d.y, d.x + d.w, d.y + d.h, node_corners_tuple(d))
    } else {
      (in_clip, in_rc)
    }
    let k0 = scene.ninst
    encode_drawn_node(scene, d, gd, node_scale, frame_no, now, scale, draw_clip, draw_rc, deferred_shadows)
    for f in fading {
      let (by, fbox, fsoft) = f
      let (fx0, fy0, fx1, fy1) = fbox
      let (fstart, ftop, fend, ffoot) = fsoft
      if tree.drawn_clear_of(d.id, by) {
        continue
      }
      let mut k = k0
      while k < scene.ninst {
        let b = k * inst_size
        inst_fade(scene.inst, b, fy0, ftop, fy1, ffoot)
        inst_fade_across(scene.inst, b, fx0, fstart, fx1, fend)
        k += 1
      }
    }
    let (fstart, ftop, fend, ffoot) = match tree.cut_soft_of(d.id) {
      Some((over_top, over_foot, ch)) => (0.0, cut_soft(over_top, ch / 2.0), 0.0, cut_soft(over_foot, ch / 2.0))
      None => tree.fades_of(d.id)
    }
    if fstart > 0.0 || ftop > 0.0 || fend > 0.0 || ffoot > 0.0 {
      let past = if d.clips && !d.clips_self { tree.clips_past_of(d.id) } else { 0.0 }
      let fh = dmax(0.0, d.h + past)
      fading.push(
        (
          d.id,
          (d.x, d.y, d.x + d.w * node_scale, d.y + fh * node_scale),
          (fstart * node_scale, ftop * node_scale, fend * node_scale, ffoot * node_scale),
        ),
      )
    }
    i += 1
  }
  flush_deferred_shadows(scene, deferred_shadows)
}

/// Encode `tree.drawn_held()` into a standalone 60-Double `Scene` using the currently active `hostapi`
/// (uploads glyphs to the active host's atlas, packs shape segments, and syncs glass light angle).
pub fn encode_tree_scene(tree : view::Tree, w : Double, h : Double, scale : Double, now : Double) -> Scene {
  let _ = tree.frame(w, h, now=now)
  hostapi::set_glass_light_angle(glass_light_angle_now())
  let sc = Scene::new()
  sc.clear(w, h, scale)
  encode_held_tree(sc, tree, 1, now, scale)
  sc.emit_segs()
  sc.perf.instances = sc.ninst
  sc
}

fn scene_hash(scene : Scene) -> Int64 {
  let mut h : Int64 = 1469598103934665603L
  let prime : Int64 = (0x00000100.to_int64() << 32) | 0x000001B3.to_int64()
  let mut i = 0
  while i < scene.inst.length() {
    let q = (scene.inst[i] * 1000.0).round().to_int64()
    h = (h ^ q) * prime
    i += 1
  }
  h
}

/// Execute one pure-tree frame: poll streams, update signals/layout, encode scene, compute damage, present, sync a11y.
/// Returns true if the rendered scene changed compared to the previous frame.
pub fn view_frame(w : Double, h : Double, scale : Double, now : Double) -> Bool {
  let t0 = work_clock_now()
  view_app.last_w = w
  view_app.last_h = h
  view_app.last_scale = scale
  view_app.frame_no = view_app.frame_no + 1
  tree_window_corner.v.set(hostapi::window_corner())
  streams_frame_begin()
  natives_frame_begin()
  let tree = match view_app.tree {
    Some(t) => t
    None => return false
  }
  run_before_frame_hooks()
  let _ = tree.frame(w, h, now=now)
  let t1 = work_clock_now()
  hostapi::set_glass_light_angle(glass_light_angle_now())
  view_app.scene.clear(w, h, scale)
  match view_app.underlay_painter {
    Some(painter) => painter(view_app.scene, w, h, scale, now)
    None => ()
  }
  encode_held_tree(view_app.scene, tree, view_app.frame_no, now, scale)
  view_app.scene.emit_segs()
  let t2 = work_clock_now()
  let bg = tree_theme().bg
  let bg_r = ((bg >> 24) & 0xFFL).to_double() / 255.0
  let bg_g = ((bg >> 16) & 0xFFL).to_double() / 255.0
  let bg_b = ((bg >> 8) & 0xFFL).to_double() / 255.0
  if view_app.fast_present {
    view_app.scene.dirty_count = 0
    hostapi::present(view_app.scene.inst, view_app.scene.ninst, bg_r, bg_g, bg_b)
    let t3 = work_clock_now()
    view_app.scene.perf.layout_ms = dmax(0.0, t1 - t0)
    view_app.scene.perf.paint_ms = dmax(0.0, t2 - t1)
    view_app.scene.perf.present_ms = dmax(0.0, t3 - t2)
    view_app.scene.perf.frame_ms = dmax(0.0, t3 - t0)
    view_app.scene.perf.instances = view_app.scene.ninst
    view_app.scene.perf.dirty_rects = 0
    if hostapi::a11y_on() {
      let _ = a11y_sync(tree, view_app.a11y)
    }
    streams_frame_end()
    natives_frame_end()
    drain_after_frame()
    return true
  }
  let dirty = view_app.dmg.next(view_app.scene.inst, view_app.scene.ninst, w, h, scale, bg_r, bg_g, bg_b)
  view_app.scene.dirty_count = dirty.length()
  // hostapi::present(buf, count, bg_r, bg_g, bg_b) — clear color RGB, NOT (w, h, scale)!
  hostapi::present(view_app.scene.inst, view_app.scene.ninst, bg_r, bg_g, bg_b)
  let t3 = work_clock_now()
  view_app.scene.perf.layout_ms = dmax(0.0, t1 - t0)
  view_app.scene.perf.paint_ms = dmax(0.0, t2 - t1)
  view_app.scene.perf.present_ms = dmax(0.0, t3 - t2)
  view_app.scene.perf.frame_ms = dmax(0.0, t3 - t0)
  view_app.scene.perf.instances = view_app.scene.ninst
  view_app.scene.perf.dirty_rects = dirty.length()
  if hostapi::a11y_on() {
    let _ = a11y_sync(tree, view_app.a11y)
  }
  streams_frame_end()
  natives_frame_end()
  drain_after_frame()
  view_app.frame_no == 1 || dirty.length() > 0
}

fn blur_focused_field() -> Unit {
  match focused_field_ref.v {
    Some(f) => f.let_go()
    None => ()
  }
}

/// Route a pointer event into the active view::Tree:
///   kind: 0 = move, 1 = down, 2 = up, 3 = cancel
///   button: 1 = primary (left), 2 = secondary (right / Ctrl-click)
/// Note: `mac_app.m` sends `0=down, 1=move, 2=up, 3=cancel` with `btn=0` primary / `btn=2` secondary;
/// `ui::run` translates `mac_app.m`'s `(kind, btn)` into this convention before calling `view_pointer`.
pub fn view_pointer(kind : Int, x : Double, y : Double, now : Double, button~ : Int = 1) -> Unit {
  view_app.pointer_x = x
  view_app.pointer_y = y
  match view_app.pointer_interceptor {
    Some(f) => if f(kind, x, y, button, hostapi::mods_held()) { return }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => return
  }
  if kind == 0 {
    // Move
    if view_app.press_down && view_app.dragging_node.is_none() && view_app.claim_chain.length() > 0 {
      match tree.claimer_of(view_app.claim_chain, x - view_app.press_x, y - view_app.press_y) {
        Some(cid) => {
          view_app.claim_chain.clear()
          match view_app.pressed_node {
            Some(pid) => {
              let _ = tree.press_held(pid)
              view_app.pressed_node = None
            }
            None => ()
          }
          blur_focused_field()
          view_app.dragging_node = Some(cid)
          let _ = tree.drag_at(cid, view::DragIs::Down, view_app.press_x, view_app.press_y, now, finger=0)
          let _ = tree.drag_at(cid, view::DragIs::Moved, x, y, now, finger=0)
          tree.point_at(x, y)
          return
        }
        None => ()
      }
    }
    match view_app.dragging_node {
      Some(nid) => {
        let _ = tree.drag_at(nid, view::DragIs::Moved, x, y, now, finger=0)
      }
      None => ()
    }
    tree.point_at(x, y)
  } else if kind == 1 {
    // Down
    tree.went_down(now, x=x, y=y)
    tree.point_at(x, y)
    if button == 2 {
      if tree.menu_at(x, y, now) {
        return
      }
      return
    }
    view_app.press_down = true
    view_app.press_x = x
    view_app.press_y = y
    view_app.pressed_node = None
    view_app.dragging_node = None
    view_app.claim_chain = tree.claimers_at(x, y)
    match tree.target_at(x, y) {
      view::Target::Dragged(nid) => {
        blur_focused_field()
        view_app.dragging_node = Some(nid)
        let _ = tree.drag_at(nid, view::DragIs::Down, x, y, now, finger=0)
      }
      view::Target::Pressed(nid) => {
        view_app.pressed_node = Some(nid)
        tree.hold_press(nid)
        match find_tree_field(nid) {
          Some(tf) => tf.field.focus()
          None => blur_focused_field()
        }
      }
      view::Target::Hosted(_) => ()
      view::Target::TopRow(nid) => {
        blur_focused_field()
        // a top row of the app's own (View::moves_window): the press is the window's to move it, as its title bar's
        if tree.moves_window(nid) {
          view_app.press_down = false
          view_app.claim_chain.clear()
          hostapi::window_drag()
        }
      }
      view::Target::Nothing => blur_focused_field()
    }
  } else if kind == 2 || kind == 3 {
    // Up (2) or Cancel (3)
    let is_cancel = kind == 3
    tree.went_up(now)
    let was_down = view_app.press_down
    view_app.press_down = false
    view_app.claim_chain.clear()
    match view_app.dragging_node {
      Some(nid) => {
        let drag_end = if is_cancel { view::DragIs::Off } else { view::DragIs::Up }
        let _ = tree.drag_at(nid, drag_end, x, y, now, finger=0)
        view_app.dragging_node = None
      }
      None => ()
    }
    let slop = touch_slop()
    let within_slop = (x - view_app.press_x).abs() <= slop && (y - view_app.press_y).abs() <= slop
    if !is_cancel && was_down && within_slop {
      match view_app.pressed_node {
        Some(nid) => {
          let _ = tree.run_press_at(nid, now)
        }
        None => ()
      }
    }
    view_app.pressed_node = None
  }
}

/// Route a wheel scroll event into the active view::Tree.
pub fn view_wheel(x : Double, y : Double, dx : Double, dy : Double, now : Double, phase~ : Int = 0) -> Unit {
  view_app.last_wheel_phase = phase
  match view_app.wheel_interceptor {
    Some(f) => if f(x, y, dx, dy, phase) { return }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => return
  }
  let mods = phase / 16
  let notch = if phase % 16 == 4 { view::wheel_notch } else { 0 }
  let momentum = if phase % 16 == 3 { view::wheel_momentum } else { 0 }
  let _ = tree.wheel_at(x, y, dx, dy, mods | notch | momentum, now)
}

fn tree_focus_step(tree : view::Tree, delta : Int) -> Bool {
  let order = tree.focus_order()
  if order.length() == 0 {
    return false
  }
  let (cur, _) = tree.focused_now()
  let mut idx = -1
  match cur {
    Some(cid) => {
      let mut i = 0
      while i < order.length() {
        if order[i].id == cid {
          idx = i
          break
        }
        i += 1
      }
    }
    None => ()
  }
  let next_idx = if idx < 0 {
    if delta < 0 { order.length() - 1 } else { 0 }
  } else {
    let raw = idx + delta
    if raw < 0 { order.length() - 1 } else if raw >= order.length() { 0 } else { raw }
  }
  tree.focus_to(Some(order[next_idx].id), visible=true)
}

/// Route a keyboard key press into focused Field or active view::Tree
/// (Keymap stroke -> Field -> focused Enter/Space -> node on_key -> Keymap stroke -> default press).
pub fn view_key(code : Int, mods : Int, now : Double) -> Bool {
  match view_app.key_interceptor {
    Some(f) => if f(code, mods, false) { return true }
    None => ()
  }
  let tree = match view_app.tree {
    Some(t) => t
    None => {
      match focused_field_ref.v {
        Some(f) if f.focused_sig.untracked() => return f.handle_key(code, mods)
        _ => return false
      }
    }
  }
  let (held, _) = tree.focused_now()
  let facts : Array[String] = []
  let field_active = match focused_field_ref.v {
    Some(f) if f.focused_sig.untracked() => {
      facts.push("Field")
      if f.text_sig.untracked().length() == 0 {
        facts.push("FieldEmpty")
      }
      true
    }
    _ => false
  }

  // 1. Tab / Shift+Tab: try keymap stroke first, then focus traversal
  if code == key_tab {
    if tree.stroke(code, mods, now, from=held, facts=facts) {
      return true
    }
    let backward = (mods & mod_shift_key) != 0
    return tree_focus_step(tree, if backward { -1 } else { 1 })
  }

  // 2. Focused Field: Cmd/Ctrl shortcuts try Keymap stroke first, else Field::handle_key
  if field_active {
    let has_cmd_or_ctrl = (mods & (mod_cmd | mod_ctrl)) != 0
    if has_cmd_or_ctrl && tree.stroke(code, mods, now, from=held, facts=facts) {
      return true
    }
    match focused_field_ref.v {
      Some(f) => {
        if f.handle_key(code, mods) {
          return true
        }
      }
      None => ()
    }
  }

  // 3. Focused node Enter / Space press
  if mods == 0 && (code == key_enter || code == key_space) {
    match held {
      Some(nid) => {
        let mask = if code == key_enter { view::focus_enter } else { view::focus_space }
        if (tree.focus_keys_of(nid) & mask) != 0 {
          if tree.press_focused_at(nid, now) {
            return true
          }
        }
      }
      None => ()
    }
  }

  // 4. Keymap bindings (View::keymap + View::on_action) before generic node on_key
  if tree.stroke(code, mods, now, from=held, facts=facts) {
    return true
  }

  // 5. Node View::on_key handlers
  if tree.key_at(code, mods, now) {
    return true
  }

  // 6. Layer default press on Enter
  if mods == 0 && code == key_enter {
    return tree.press_default_at(now, from=held)
  }
  false
}

/// Route a keyboard key-up event through the registered key interceptor (`is_up = true`).
pub fn view_key_up(code : Int, mods : Int, _now : Double) -> Bool {
  match view_app.key_interceptor {
    Some(f) => f(code, mods, true)
    None => false
  }
}

/// Route committed or composed text into the currently focused Field.
pub fn view_text(kind : Int, s : String, a~ : Int = 0, b~ : Int = 0) -> Unit {
  match view_app.text_interceptor {
    Some(f) => if f(kind, s, a, b) { return }
    None => ()
  }
  match focused_field_ref.v {
    Some(f) if f.focused_sig.untracked() => {
      if kind == 1 {
        f.compose(s)
      } else {
        f.insert(s)
      }
    }
    _ => ()
  }
}

/// Open a pure-tree window and run `tree` until it closes.
/// `transitions_only` defaults to true so changes outside `view::transition` settle immediately.
pub fn run(
  title : String,
  tree : (view::View) -> Unit,
  theme? : () -> Theme,
  transitions_only~ : Bool = true,
) -> Unit {
  view::faults_stop.v = false
  let made = if transitions_only {
    fn(root : view::View) {
      let _ = root.transitions_only()
      tree(root)
    }
  } else {
    tree
  }
  match theme {
    Some(tf) => set_view_app(made, theme=tf)
    None => set_view_app(made)
  }
  // A host that draws only when asked (Windows, Linux) hears of every change marked in the tree (an input's, a
  // signal's, a moment come), and after each frame of what is moving or due next.
  match view_app.tree {
    Some(tree) => tree.on_due(fn() { hostapi::request_frame() })
    None => ()
  }
  hostapi::run(
    title,
    fn(w, h, scale, now) {
      let _ = view_frame(w, h, scale, now)
      frames_asked_after(now)
    },
    // mac_app.m sends kind: 0=down, 1=move, 2=up, 3=cancel; btn: 0=left, 1=middle, 2=right
    fn(host_kind, x, y, btn) {
      let vp_kind = if host_kind == 0 {
        1
      } else if host_kind == 1 {
        0
      } else {
        host_kind
      }
      let vp_btn = if btn == 2 { 2 } else if btn == 1 { 3 } else { 1 }
      view_pointer(vp_kind, x, y, hostapi::now(), button=vp_btn)
    },
    fn(x, y, dx, dy, phase) { view_wheel(x, y, dx, dy, hostapi::now(), phase=phase) },
    fn(code, mods) { let _ = view_key(code, mods, hostapi::now()) },
    fn(kind, s, a, b) { view_text(kind, s, a=a, b=b) },
  )
}

/// After a frame: another at once while something reads the clock (a motion going), else one at the soonest moment due.
fn frames_asked_after(now : Double) -> Unit {
  match view_app.tree {
    Some(tree) =>
      if tree.clock_read() {
        hostapi::request_frame_on()
      } else {
        match tree.wake() {
          Some(at) => hostapi::wake_after(dmax(at - now, 0.0))
          None => ()
        }
      }
    None => ()
  }
}

/// Compatibility alias for `run`.
pub fn run_tree(
  title : String,
  tree : (view::View) -> Unit,
  theme? : () -> Theme,
  transitions_only~ : Bool = true,
) -> Unit {
  match theme {
    Some(tf) => run(title, tree, theme=tf, transitions_only=transitions_only)
    None => run(title, tree, transitions_only=transitions_only)
  }
}
