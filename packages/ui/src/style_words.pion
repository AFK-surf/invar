// Reactive typography resolution helpers and styled `text::Run` forwarder.

import "signals"
import "text"
import "view"

/// Construct a styled `text::Run` specifying only fields that differ from the paragraph.
/// When `weight != 0`, `weight` takes precedence over `bold`.
pub fn span(
  text : String,
  weight~ : Int = 0,
  bold~ : Bool = false,
  italic~ : Bool = false,
  code~ : Bool = false,
  mono~ : Bool = false,
  serif~ : Bool = false,
  face? : Int,
  scale~ : Double = 1.0,
  color~ : Int64 = 0L,
  bg~ : Int64 = 0L,
  ground? : text::Ground,
  strike~ : Bool = false,
  underline~ : Bool = false,
  link~ : String = "",
  drawing? : text::InlineDrawing,
) -> text::Run {
  text::span(
    text,
    weight=weight,
    bold=bold,
    italic=italic,
    code=code,
    mono=mono,
    serif=serif,
    face?=face,
    scale=scale,
    color=color,
    bg=bg,
    ground?=ground,
    strike=strike,
    underline=underline,
    link=link,
    drawing?=drawing,
  )
}

/// Resolve a `TextStyle` into a `view::WordsLook` using the active window/tree
/// theme (`tree_theme()`) and narrow-layout state (`tree_narrow()`).
pub fn style_words(style : TextStyle) -> view::WordsLook {
  let th = tree_theme()
  let st = style.resolve(narrow=tree_narrow(), dark=th.dark)
  let (size, line_from_size) = match st.size {
    Some(z) => {
      let (sz, ln) = th.text_size(z)
      (sz, Some(ln))
    }
    None => (15.0, None)
  }
  let line_opt = match st.leading {
    Some(l) => match th.leading(l) {
      Some(v) => Some(v)
      None => Some(0.0)
    }
    None => line_from_size
  }
  let line = match line_opt {
    Some(l) => l
    None => -th.text_line
  }
  let weight = match st.weight {
    Some(w) => w.value()
    None => 400
  }
  let wrap = match st.wrap {
    Some(v) => v
    None => true
  }
  let tracking = match st.tracking {
    Some(Tracking::Exact(px)) => view::Spacing::Points(px)
    Some(t) => view::Spacing::Ems(t.px(1.0))
    None => view::letters_own
  }
  let balance = match st.balance {
    Some(v) => v
    None => false
  }
  let max_lines = match st.max_lines {
    Some(v) => v
    None => 0
  }
  view::WordsLook::{
    size,
    weight,
    line,
    wrap,
    tracking,
    balance,
    max_lines,
  }
}

/// Resolve the foreground ink color of `style` for the active window/tree theme
/// and narrow-layout state; falls back to `tree_theme().fg`.
pub fn style_ink(style : TextStyle) -> Int64 {
  let th = tree_theme()
  match style.resolve(narrow=tree_narrow(), dark=th.dark).color {
    Some(c) => th.color(c)
    None => th.fg
  }
}

/// Resolve whether tabular numerals are explicitly set for `style` (`None` when unset).
/// Samples theme dark mode untracked so layout declarations do not subscribe subtrees to theme swaps.
pub fn style_tabular(style : TextStyle) -> Option[Bool] {
  let dark = signals::untracked(fn() { tree_theme().dark })
  style.resolve(narrow=tree_narrow(), dark=dark).tabular
}

/// Resolve whether `style` truncates text with an ellipsis (`w=Len::Cut`).
/// Samples theme dark mode untracked so layout declarations do not subscribe subtrees to theme swaps.
pub fn style_cut(style : TextStyle) -> Bool {
  let dark = signals::untracked(fn() { tree_theme().dark })
  match style.resolve(narrow=tree_narrow(), dark=dark).w {
    Some(Len::Cut) => true
    _ => false
  }
}

/// Resolve whether `style` fills its horizontal room (`w=Len::Full` or `w=Len::Grow(_)`).
/// Samples theme dark mode untracked so layout declarations do not subscribe subtrees to theme swaps.
pub fn style_fills(style : TextStyle) -> Bool {
  let dark = signals::untracked(fn() { tree_theme().dark })
  match style.resolve(narrow=tree_narrow(), dark=dark).w {
    Some(Len::Full) | Some(Len::Grow(_)) => true
    _ => false
  }
}

/// Resolve whether `style` centers its text lines (`center=true`).
/// Samples theme dark mode untracked so layout declarations do not subscribe subtrees to theme swaps.
pub fn style_centered(style : TextStyle) -> Bool {
  let dark = signals::untracked(fn() { tree_theme().dark })
  match style.resolve(narrow=tree_narrow(), dark=dark).center {
    Some(v) => v
    None => false
  }
}
