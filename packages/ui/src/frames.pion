import "hostapi"
import "mbt_compat"

// A run as data: what each frame drew as one number, so two runs of
// the same steps are compared frame by frame (the same, or the first frame they part at) rather than by their last
// screen alone, and a test that gives the same steps another order of what comes from outside (a seed, a replay's
// pace) can say the frames that should not change did not.

///|
fn hash_mix(h : Int64, v : Int64) -> Int64 {
  (h ^ v) * 1099511628211L
}

///|
/// What the last frame drew, as one number (FNV-1a): every instance drawn (where, how large, its kind and colour, in
/// 1/64 px and 1/255 steps; a glyph by its key, a picture by its number, not where the host keeps them) and the
/// laid-out tree with its words and carets (`dump`). The same steps give the same number on every run and every
/// machine, whatever was drawn before.
pub fn Tester::frame_hash(self : Tester) -> Int64 {
  self.reads_own()
  ignore(self)
  drawn_hash()
}

///|
/// What the last frame drew as text: the laid-out tree (`dump`), then each instance drawn, one a line (its 24
/// numbers, positions and sizes in 1/64 px, colours in 1/255): what two frames' hashes part on, line by line. A band of
/// a shape says its pieces by what they are, not where they stand among the frame's (its hash takes them as they
/// stand): what draws the same reads the same, whatever drew before it.
pub fn Tester::drawn_text(self : Tester) -> String {
  self.reads_own()
  ignore(self)
  drawn_text()
}

///|
/// The last frame's instances alone, as drawn_text says them (its `inst` lines, without the nodes' dump before them):
/// what a test that compares only what was drawn reads, without the dump it would throw away.
pub fn Tester::drawn_instances_text(self : Tester) -> String {
  self.reads_own()
  ignore(self)
  let sb = StringBuilder()
  drawn_insts_into(sb, g())
  sb.to_string()
}

///|
fn drawn_text() -> String {
  let c = g()
  let sb = StringBuilder()
  dump_node(sb, 0, 0)
  drawn_insts_into(sb, c)
  sb.to_string()
}

///|
/// `v` in decimal digits, as `\{v}` says it, with no string made for it (drawn_text writes some 20 a line for
/// thousands of lines a frame: their strings were most of what kept_rows_kinds' comparisons cost, 2026-11-14).
fn write_i64(sb : StringBuilder, v : Int64) -> Unit {
  if v == 0L {
    sb.write_char('0')
    return
  }
  if v < 0L {
    sb.write_char('-')
  }
  // (digits from the last; a negative's by its own sign, so the least Int64 is said too)
  let digits = FixedArray::make(20, 0)
  let mut n = 0
  let mut x = v
  while x != 0L {
    let d = (x % 10L).to_int()
    digits[n] = if d < 0 { -d } else { d }
    x = x / 10L
    n = n + 1
  }
  for i = n - 1; i >= 0; i = i - 1 {
    sb.write_char((48 + digits[i]).unsafe_to_char())
  }
}

///|
/// The frame's instances' lines, as drawn_text says them.
fn drawn_insts_into(sb : StringBuilder, c : Ctx) -> Unit {
  let named = image_numbers(c)
  let keys = glyph_keys()
  for k in 0..<c.ninst {
    // (the pieces of the frame's shapes, none drawn: what each band of a shape draws from, said with it)
    if c.inst[k * inst_size + 5] == 12.0 {
      continue
    }
    sb.write_string("inst")
    for j in 0..<inst_size {
      let v = if j == 12 && c.inst[k * inst_size + 5] == 11.0 {
        shape_pieces_key(c, k)
      } else {
        inst_named(c, named, keys, k, j)
      }
      sb.write_char(' ')
      write_i64(sb, (v * 64.0).round().to_int64())
    }
    if c.inst[k * inst_size + 5] == 4.0 {
      let s = stream_drawn(c.inst[k * inst_size + 20].to_int())
      if s != "" {
        sb.write_string(" " + s)
      }
    }
    sb.write_char('\n')
  }
}

///|
/// Every instance drawn in the last frame in the order drawn, as drawn_text says them: a shape's band (kind 11) its
/// pieces by what they are (shape_pieces_key) in the place of where they stand among the frame's, the pieces' own
/// instances (kind 12, none drawn) left out. What draws the same reads the same, whatever drew before it.
pub fn Tester::drawn_instances_keyed(self : Tester) -> Array[Array[Double]] {
  self.reads_own()
  ignore(self)
  let c = g()
  let out = []
  for k in 0..<c.ninst {
    if c.inst[k * inst_size + 5] == 12.0 {
      continue
    }
    out.push(mbt_compat::arr_makei(inst_size, fn(j) {
      if j == 12 && c.inst[k * inst_size + 5] == 11.0 {
        shape_pieces_key(c, k)
      } else {
        c.inst[k * inst_size + j]
      }
    }))
  }
  out
}

///|
/// A shape's band (instance `k`, kind 11): its pieces by what they are (a hash of them, in 64ths), not where they stand
/// among the frame's (shape.pion: what drew before it, kept or built, puts them elsewhere).
fn shape_pieces_key(c : Ctx, k : Int) -> Double {
  let b = k * inst_size
  let first = c.inst[b + 12].to_int()
  let count = c.inst[b + 13].to_int()
  let mut h = 0x811C9DC5
  for v in (first * 4)..<((first + count) * 4) {
    if v >= 0 && v < c.segs.length() {
      h = (h ^ (c.segs[v] * 64.0).round().to_int()) * 0x01000193
    }
  }
  (h & 0x3FFFFFFF).to_double()
}

///|
/// The pictures the last frame drew, numbered as first drawn (their host's ids, which depend on what was decoded
/// before, are not what was drawn).
fn image_numbers(c : Ctx) -> mbt_compat::OrderedMap[Int, Int] {
  let named : mbt_compat::OrderedMap[Int, Int] = mbt_compat::ordered_map_new()
  for k in 0..<c.ninst {
    let b = k * inst_size
    if c.inst[b + 5] == 4.0 {
      let id = c.inst[b + 20].to_int()
      if !named.contains(id) {
        named.set(id, named.length())
      }
    }
  }
  named
}

///|
/// Instance `k`'s number `j` as compared: a picture's id its number as first drawn; a glyph's place in the atlas (12,
/// 13) its key (`keys`: text.pion glyph_keys) and 0, where it is there being what was drawn before.
fn inst_named(c : Ctx, named : mbt_compat::OrderedMap[Int, Int], keys : mbt_compat::OrderedMap[String, Int], k : Int, j : Int) -> Double {
  let b = k * inst_size
  let kind = c.inst[b + 5]
  if j == 20 && kind == 4.0 {
    named.get(c.inst[b + 20].to_int()).unwrap_or(-1).to_double()
  } else if (j == 12 || j == 13) && (kind == 1.0 || kind == 3.0 || kind == 7.0) {
    if j == 13 {
      0.0
    } else {
      keys.get("\{mbt_compat::double_to_string(c.inst[b + 12])} \{mbt_compat::double_to_string(c.inst[b + 13])}").unwrap_or(-1).to_double()
    }
  } else {
    c.inst[b + j]
  }
}

///|
fn drawn_hash() -> Int64 {
  let c = g()
  let mut h = -3750763034362895579L
  let named = image_numbers(c)
  let keys = glyph_keys()
  for k in 0..<c.ninst {
    for j in 0..<inst_size {
      let x = inst_named(c, named, keys, k, j)
      // (a clip's corners' radii only where it has them: a picture with no rounded clip hashed as before they were kept;
      // a box's corners only where they are each its own, not all its radius)
      if j >= 24 && j < 36 && x == 0.0 {
        continue
      }
      if j >= 36 && j < 40 && x == c.inst[k * inst_size + 4] {
        continue
      }
      // (its outer clip only where it has one: drawn as before they were kept elsewhere)
      if j >= 40 && !inst_has_outer(c.inst, k * inst_size) {
        continue
      }
      h = hash_mix(h, (x * 64.0).round().to_int64())
    }
    // a stream's picture: its frame's size and time (stream.pion)
    if c.inst[k * inst_size + 5] == 4.0 {
      { let __mbt_s_209 = stream_drawn(c.inst[k * inst_size + 20].to_int()); let __mbt_sn_209 = mbt_compat::str_byte_len(__mbt_s_209); let mut __mbt_sp_209 = 0; while __mbt_sp_209 < __mbt_sn_209 { let (__mbt_ch_209, __mbt_spn_209) = mbt_compat::str_cursor_step(__mbt_s_209, __mbt_sp_209); __mbt_sp_209 = __mbt_spn_209; let ch = __mbt_ch_209;
        h = hash_mix(h, ch.to_int().to_int64())
      } }
    }
  }
  let sb = StringBuilder()
  dump_node(sb, 0, 0)
  { let __mbt_s_216 = sb.to_string(); let __mbt_sn_216 = mbt_compat::str_byte_len(__mbt_s_216); let mut __mbt_sp_216 = 0; while __mbt_sp_216 < __mbt_sn_216 { let (__mbt_ch_216, __mbt_spn_216) = mbt_compat::str_cursor_step(__mbt_s_216, __mbt_sp_216); __mbt_sp_216 = __mbt_spn_216; let ch = __mbt_ch_216;
    h = hash_mix(h, ch.to_int().to_int64())
  } }
  h
}

///|
/// MBUI_DRAW_LOG=1 on a real host: each frame's `frame_hash` on the log, the inputs between them with it (INPUT,
/// inputrec.pion) (DRAWHASH frame time width height scale hash
/// stable: 1 when the host asked for output the same on every run, MBUI_BENCH=-1),
/// for a Tester over the host's kept text (textrec.pion) given the same frames (`replay_frames`) to be checked against:
/// -1 not asked yet, 0 no, 1 yes.
// moved to 00_init_order.pion: draw_log

///|
// moved to 00_init_order.pion: draw_frames

///|
fn log_drawn(w : Double, h : Double, scale : Double, t : Double) -> Unit {
  if taping() {
    draw_frames.v += 1
    let stable = if bench.mode < 0 { 1 } else { 0 }
    tape_line("DRAWHASH \{draw_frames.v} \{mbt_compat::double_to_string(t)} \{mbt_compat::double_to_string(w)} \{mbt_compat::double_to_string(h)} \{mbt_compat::double_to_string(scale)} \{drawn_hash()} \{stable}")
    // MBUI_DRAW_DUMP=N: frame N drawn as text (drawn_text), a line each
    if draw_logging() && hostapi::env("MBUI_DRAW_DUMP") == draw_frames.v.to_string() {
      for line in drawn_text().split("\n") {
        hostapi::log("DRAWDUMP " + mbt_compat::str_to_owned(line))
      }
    }
  }
}

///|
/// The frame drawn last (those drawn at this moment) reached the screen `ms` later than its time, as a host says of a
/// frame that took longer than the display's frame to build (@hostapi.frame_late), in the next frame drawn after this
/// moment: a slide whose first frame that was moves on that much later (nav.pion).
pub fn Tester::frame_late(self : Tester, ms : Double) -> Unit {
  self.fake.late = ms
  self.fake.late_after = self.fake.time
  self.fake.late_frame = -1
}

///|
/// `n` frames, `ms` apart: each one's hash (`frame_hash`) as it was drawn.
pub fn Tester::frames(self : Tester, n : Int, ms? : Double) -> Array[Int64] {
  let ms = match ms { Some(__mbt_v) => __mbt_v, None => 16.0 }

  let out : Array[Int64] = []
  for _ in 0..<n {
    self.frame(ms=ms)
    out.push(self.frame_hash())
  }
  out
}

///|
/// When a real host's run drew its first frame (its log's first DRAWHASH line's time), if it says.
fn run_first_frame(run : String) -> Option[Double] {
  for line in run.split("\n") {
    match mbt_compat::str_find(line, "DRAWHASH ") {
      Some(i) => {
        let parts = mbt_compat::arr_to_array(mbt_compat::arr_map(mbt_compat::str_exact_view(line, start=i + 9).split(" "), fn(p) { mbt_compat::str_to_owned(p) }))
        if parts.length() >= 2 {
          match (match mbt_compat::mbt_json_parse(parts[1]) { Ok(__mbt_ok_14) => Some(__mbt_ok_14), Err(_) => None }) {
            Some(.Number(d, _)) => return Some(d)
            _ => ()
          }
        }
      }
      None => ()
    }
  }
  Option::None
}

///|
/// A real host's frames as its log said them (MBUI_DRAW_LOG: DRAWHASH lines) drawn again, each at its time, the
/// window's size, scale and stability (Ctx::stable) as it had them: for each, its number, the host's hash and this
/// one's (as text). A frame at the time this Tester drew its last is that one (Tester::new at the host's first frame:
/// `time` 16 ms before it, and `run` this log, so that frame is drawn by the settings the run began with).
pub fn Tester::replay_frames(self : Tester, log : String) -> Array[(Int, String, String)] {
  self.reads_own()
  let out = []
  let mut framed = false
  // an input handed on since the last frame: the next frame is its, drawn though at the Tester's own first frame's
  // time (an input at a frame's moment is taken in a frame at that moment)
  let mut fed = false
  // the scripts the run sent its pages (VIEWSCRIPT), and how many of this one's are compared with them: one that is
  // not the run's parts there, as a frame whose hash is not
  let scripts : Array[String] = []
  let sent_before = self.fake.scripts_sent.length()
  let num = fn(s : String) -> Option[Double] {
    match (match mbt_compat::mbt_json_parse(s) { Ok(__mbt_ok_15) => Some(__mbt_ok_15), Err(_) => None }) {
      Some(.Number(d, _)) => Some(d)
      _ => Option::None
    }
  }
  for v in log.split("\n") {
    let line = mbt_compat::str_to_owned(v)
    // what the host gave between two frames, handed on at its place (inputrec.pion)
    if mbt_compat::str_find(line, "ENV ") is Some(_) {
      replay_env(self.fake, line)
      continue
    }
    if mbt_compat::str_find(line, "INPUT ") is Some(_) {
      replay_input(self.fake, line)
      fed = true
      continue
    }
    match mbt_compat::str_find(line, "VIEWSCRIPT ") {
      Some(i) => {
        scripts.push(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=i + 11)))
        continue
      }
      None => ()
    }
    // what the host said of its views, said again at its place (hostcall.pion: view_say); before its first frame, said
    // already (Tester::new's `run`)
    match mbt_compat::str_find(line, "VIEWSAID ") {
      Some(i) => {
        if framed {
          self.view_said(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=i + 9))) |> ignore
        }
        continue
      }
      None => ()
    }
    // the clipboard as the app took it, given again at its place: the frame after it takes it (device.pion)
    match clip_of_line(line) {
      Some(clip) => {
        fake_clip_give(self.fake, clip)
        continue
      }
      Option::None => ()
    }
    // a native call's answer as the app took it, given again at its place: told there, as the host's event that brought
    // it (native.pion's fake_native_due)
    match native_of_line(line) {
      Some((name, r)) => {
        fake_native_give(self.fake, name, r)
        continue
      }
      Option::None => ()
    }
    // what came from outside, posted again at its place: the frame after it takes it (messages.pion); before its first
    // frame, posted already (Tester::new's `run`)
    if is_message_line(line) {
      if framed {
        replay_message(self.fake, line)
      }
      continue
    }
    // how late the host said the frame before was, said again for the frame it said it in (hostcall.pion's
    // h_frame_late): the next drawn
    match mbt_compat::str_find(line, "LATE ") {
      Some(i) =>
      match num(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=i + 5))) {
        Some(late) => {
          self.fake.late = late
          self.fake.late_after = self.fake.time
          self.fake.late_frame = -1
          continue
        }
        Option::None => ()
      }
      None => ()
    }
    guard mbt_compat::str_find(line, "DRAWHASH ") is Some(i) else { continue }
    framed = true
    let parts = mbt_compat::arr_to_array(mbt_compat::arr_map(mbt_compat::str_exact_view(line, start=i + 9).split(" "), fn(p) { mbt_compat::str_to_owned(p) }))
    guard parts.length() >= 6 else { continue }
    guard (num(parts[0]), num(parts[1]), num(parts[2]), num(parts[3]), num(parts[4]))
    is (Some(n), Some(t), Some(w), Some(h), Some(scale)) else {
      continue
    }
    self.w = w
    self.h = h
    self.fake.scale = scale
    if parts.length() >= 7 {
      bench.mode = if parts[6] == "1" { -1 } else { 0 }
    }
    // (the frame a Tester made at this time already, as it was made: its first, Tester::new's `time`, unless an input
    // came before it; any later one at the same time is drawn, as a Tester's tape has them: Tester::draw)
    if t != self.fake.time || out.length() > 0 || fed {
      self.frame_at(t)
    }
    fed = false
    out.push((n.to_int(), parts[5], drawn_hash().to_string()))
    // the scripts sent by now: the run's and this one's, the same in the same order
    let ours = self.fake.scripts_sent
    let k = ours.length() - sent_before
    if k != scripts.length() || mbt_compat::int_until((0), k).iter().any(fn(j) { ours[sent_before + j] != scripts[j] }) {
      out.push((
        n.to_int(),
        "VIEWSCRIPT " + scripts.join(", "),
        "VIEWSCRIPT " + ({ let __mbt_sl_57 = ours; mbt_compat::arr_iter(mbt_compat::array_slice_clamp(__mbt_sl_57, sent_before, __mbt_sl_57.length())) }).collect().join(", "),
      ))
    }
  }
  out
}

///|
/// The first frame at which two runs' hashes part (None: the same, frame for frame; one longer than the other parts
/// where the shorter ends).
pub fn first_difference(a : Array[Int64], b : Array[Int64]) -> Option[Int] {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    if a[i] != b[i] {
      return Some(i)
    }
  }
  if a.length() != b.length() {
    Some(n)
  } else {
    Option::None
  }
}
