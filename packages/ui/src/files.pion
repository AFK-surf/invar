// Reactive high-level file picking, streaming file save, gallery reading, and app update bridge.
// Thin reactive layer over `packages/hostapi` primitives.

import "hostapi"
import "signals"

/// Reactive file/photo/camera picker wrapping `hostapi::Pick`.
pub struct FilePick {
  raw : hostapi::Pick
  files_sig : signals::Signal[Option[Array[hostapi::Picked]]]
}

/// Start a system file/photo/camera picker; returns `None` when unsupported by the host.
pub fn FilePick::start(kind : hostapi::PickKind, hold~ : Bool = false) -> Option[FilePick] {
  match hostapi::pick(kind, hold=hold) {
    Some(raw) => Some(FilePick::{ raw, files_sig: signals::signal_by(None, fn(_a, _b) { false }) })
    None => None
  }
}

/// Read a gallery photo by `src` into a `FilePick`.
pub fn FilePick::from_photo(src : String) -> Option[FilePick] {
  match hostapi::pick_photo(src) {
    Some(raw) => Some(FilePick::{ raw, files_sig: signals::signal_by(None, fn(_a, _b) { false }) })
    None => None
  }
}

/// Underlying host pick request id.
pub fn FilePick::id(self : FilePick) -> Int {
  self.raw.id()
}

/// Poll host completion once and publish picked files into the reactive signal.
pub fn FilePick::poll(self : FilePick) -> Option[Array[hostapi::Picked]] {
  match self.files_sig.untracked() {
    Some(done) => Some(done)
    None => match self.raw.files() {
      Some(fs) => {
        self.files_sig.set(Some(fs))
        Some(fs)
      }
      None => None
    }
  }
}

/// Reactive view of picked files (`None` until ready).
pub fn FilePick::files(self : FilePick) -> Option[Array[hostapi::Picked]] {
  let _ = self.poll()
  self.files_sig.get()
}

/// Reactive streaming file export/save handle wrapping `hostapi::Keep`.
pub struct FileKeep {
  raw : hostapi::Keep
  kept_sig : signals::Signal[hostapi::Kept]
}

/// Begin saving a file named `name` (`mime`) via `way`.
pub fn FileKeep::begin(name : String, mime : String, way : hostapi::KeepWay) -> Option[FileKeep] {
  match hostapi::keep_begin(name, mime, way=way) {
    Some(raw) => Some(FileKeep::{ raw, kept_sig: signals::signal_by(hostapi::Kept::Keeping, fn(_a, _b) { false }) })
    None => None
  }
}

/// Append a chunk of bytes to the outgoing save stream.
pub fn FileKeep::append(self : FileKeep, data : Bytes) -> Bool {
  self.raw.append(data)
}

/// Commit all written bytes to the destination.
pub fn FileKeep::finish(self : FileKeep) -> Unit {
  self.raw.finish()
  let _ = self.kept()
}

/// Poll and return the reactive save state.
pub fn FileKeep::kept(self : FileKeep) -> hostapi::Kept {
  let cur = self.raw.kept()
  self.kept_sig.set(cur)
  self.kept_sig.get()
}

/// Release the underlying host save handle.
pub fn FileKeep::end(self : FileKeep) -> Unit {
  self.raw.end()
}

/// Convenience helper: save `data` in one call as `name` (`mime`) via `way`.
pub fn keep_bytes(name : String, mime : String, data : Bytes, way : hostapi::KeepWay) -> Option[FileKeep] {
  match FileKeep::begin(name, mime, way) {
    Some(fk) => {
      if fk.append(data) {
        fk.finish()
      }
      Some(fk)
    }
    None => None
  }
}

/// Reactive photo/video gallery reader wrapping `hostapi::GalleryRead`.
pub struct GalleryRead {
  raw : hostapi::GalleryRead
  photos_sig : signals::Signal[Option[Array[hostapi::GalleryPhoto]]]
}

/// Begin reading the device gallery; returns `None` when no gallery is available.
pub fn GalleryRead::start() -> Option[GalleryRead] {
  match hostapi::gallery_read() {
    Some(raw) => Some(GalleryRead::{ raw, photos_sig: signals::signal_by(None, fn(_a, _b) { false }) })
    None => None
  }
}

pub fn GalleryRead::id(self : GalleryRead) -> Int {
  self.raw.id()
}

pub fn GalleryRead::poll(self : GalleryRead) -> Option[Array[hostapi::GalleryPhoto]] {
  match self.photos_sig.untracked() {
    Some(done) => Some(done)
    None => match self.raw.photos() {
      Some(ps) => {
        self.photos_sig.set(Some(ps))
        Some(ps)
      }
      None => None
    }
  }
}

/// Reactive list of gallery photos once read (`None` while pending).
pub fn GalleryRead::photos(self : GalleryRead) -> Option[Array[hostapi::GalleryPhoto]] {
  let _ = self.poll()
  self.photos_sig.get()
}

/// Request the host updater to fetch an update artifact.
pub fn update_fetch(
  url : String,
  sha256 : String,
  size : Double,
  name : String,
  now_flag~ : Bool = false,
  delta~ : String = "",
) -> Unit {
  hostapi::update_fetch(url, sha256, size, name, now_flag, delta)
}

/// Apply a fetched update payload.
pub fn update_apply(said : String) -> Unit {
  hostapi::update_apply(said)
}

/// Read the current host updater state string.
pub fn update_state() -> String {
  hostapi::update_state()
}
