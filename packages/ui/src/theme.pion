    link: 0x0047AEFFL,
    warn: 0xD9962BFFL,
    warn_ink: 0x6E4802FFL,
    lifted: 0xFFFFFFFFL,
    // #322D24 at 6.5%
    wash: 0x322D2411L,
    sidebar: 0xF6F5F1FFL,
    // oklch(98.5% .002 85)
    list: 0xFBFAF9FFL,
    text: TextScale::tailwind(),
    leading: LeadingScale::tailwind(),
    text_line: 0.0,
    radii: RadiusScale::tailwind(),
    corner_ladder: [],
    corner_fit: Option::None,
    lit_apart: 0.0,
    lit_reach: 0.0,
    tabular: true,
