/// Scale alpha channel of 0xRRGGBBAA color `c` by `a` in [0, 1].
pub fn alpha(c : Int64, a : Double) -> Int64 {
  let k = ((c & 0xFFL).to_double() * dclamp(a, 0.0, 1.0)).round().to_int64()
  (c & c64(0xFFFF, 0xFF00)) | (k & 0xFFL)
}

/// Porter-Duff source-over compositing of `top` over `under` (0xRRGGBBAA).
pub fn over(under : Int64, top : Int64) -> Int64 {
  let a = (top & 0xFFL).to_double() / 255.0
  let ua = (under & 0xFFL).to_double() / 255.0
  if ua < 1.0 {
    let oa = a + ua * (1.0 - a)
    if oa <= 0.0 {
      return 0L
    }
    let mix = fn(sh : Int) -> Int64 {
      let u = ((under >> sh) & 0xFFL).to_double()
      let t = ((top >> sh) & 0xFFL).to_double()
      (((t * a + u * ua * (1.0 - a)) / oa).round().to_int64() & 0xFFL) << sh
    }
    return mix(24) | mix(16) | mix(8) | ((oa * 255.0).round().to_int64() & 0xFFL)
  }
  let ch = fn(sh : Int) -> Int64 {
    let u = ((under >> sh) & 0xFFL).to_double()
    let t = ((top >> sh) & 0xFFL).to_double()
    ((u + (t - u) * a).round().to_int64() & 0xFFL) << sh
  }
  ch(24) | ch(16) | ch(8) | 0xFFL
}

/// Linear channel-by-channel interpolation from `a` to `b` at `t` in [0, 1].
pub fn blend(a : Int64, b : Int64, t : Double) -> Int64 {
  let k = dclamp(t, 0.0, 1.0)
  let ch = fn(sh : Int) -> Int64 {
    let x = ((a >> sh) & 0xFFL).to_double()
    let y = ((b >> sh) & 0xFFL).to_double()
    ((x + (y - x) * k).round().to_int64() & 0xFFL) << sh
  }
  ch(24) | ch(16) | ch(8) | ch(0)
}

fn oklab_linear(l : Double, a : Double, b : Double) -> (Double, Double, Double) {
  let l_ = l + 0.3963377774 * a + 0.2158037573 * b
  let m_ = l - 0.1055613458 * a - 0.0638541728 * b
  let s_ = l - 0.0894841775 * a - 1.2914855480 * b
  let l3 = l_ * l_ * l_
  let m3 = m_ * m_ * m_
  let s3 = s_ * s_ * s_
  (
    4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3,
    -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3,
    -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3,
  )
}

fn srgb_byte(v : Double) -> Int64 {
  let c = dclamp(v, 0.0, 1.0)
  let e = if c <= 0.0031308 { 12.92 * c } else { 1.055 * dmath::pow(c, 1.0 / 2.4) - 0.055 }
  (e * 255.0).round().to_int64() & 0xFFL
}

/// OKLCH to 0xRRGGBBAA with sRGB gamut clamping.
pub fn oklch(l : Double, c : Double, h : Double, alpha~ : Double = 1.0) -> Int64 {
  let rad = h * 3.141592653589793 / 180.0
  let mut ch = c
  while ch > 0.0 {
    let (r, g, b) = oklab_linear(l, ch * dmath::cos(rad), ch * dmath::sin(rad))
    if r >= -0.0001 && r <= 1.0001 && g >= -0.0001 && g <= 1.0001 && b >= -0.0001 && b <= 1.0001 {
      break
    }
    ch = ch - 0.005
  }
  let ch2 = if ch < 0.0 { 0.0 } else { ch }
  let (r, g, b) = oklab_linear(l, ch2 * dmath::cos(rad), ch2 * dmath::sin(rad))
  let a = (dclamp(alpha, 0.0, 1.0) * 255.0).round().to_int64() & 0xFFL
  (srgb_byte(r) << 24) | (srgb_byte(g) << 16) | (srgb_byte(b) << 8) | a
}

fn srgb_luminance(v : Int64) -> Double {
  let lin = fn(ch : Double) -> Double {
    if ch <= 0.04045 { ch / 12.92 } else { dmath::pow((ch + 0.055) / 1.055, 2.4) }
  }
  let r = ((v >> 24) & 0xFFL).to_double() / 255.0
  let g = ((v >> 16) & 0xFFL).to_double() / 255.0
  let b = ((v >> 8) & 0xFFL).to_double() / 255.0
  0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)
}

/// WCAG 2 contrast ratio between two opaque 0xRRGGBBAA colors (1.0 .. 21.0).
pub fn contrast_ratio(a : Int64, b : Int64) -> Double {
  let la = srgb_luminance(a)
  let lb = srgb_luminance(b)
  (dmax(la, lb) + 0.05) / (dmin(la, lb) + 0.05)
}

/// Pick the ink color from `inks` with highest WCAG contrast against `ground`.
pub fn ink_on(ground : Int64, inks : Array[Int64]) -> Int64 {
  if inks.length() == 0 {
    return c64(0xFFFF, 0xFFFF)
  }
  let mut best = inks[0]
  let mut best_r = contrast_ratio(best, ground)
  let mut i = 1
  while i < inks.length() {
    let r = contrast_ratio(inks[i], ground)
    if r > best_r {
      best = inks[i]
      best_r = r
    }
    i += 1
  }
  best
}

pub fn Theme::color(self : Theme, c : Color) -> Int64 {
  match c {
    Color::Clear => 0L
    Color::Bg => self.bg
    Color::Surface => self.surface
    Color::Raised => self.raised
    Color::Card => self.card
    Color::Fg => self.fg
    Color::Muted => self.muted
    Color::Subtle => self.subtle
    Color::Faint => self.faint
    Color::Line => self.line
    Color::Border => self.border
    Color::Accent => self.accent
    Color::AccentText => self.accent_text
    Color::AccentBg => self.accent_bg
    Color::OnAccent => self.on_accent
    Color::Primary => self.primary
    Color::OnPrimary => self.on_primary
    Color::Positive => self.positive
    Color::Danger => self.danger
    Color::DangerBg => self.danger_bg
    Color::OnDanger => self.on_danger
    Color::Neutral => self.neutral
    Color::Hover => self.hover
    Color::Selected => self.selected
    Color::Focus => self.focus
    Color::Scrim => self.scrim
    Color::Link => self.link
    Color::ShadowC => self.shadow
    Color::Warn => self.warn
    Color::WarnInk => self.warn_ink
    Color::Tint => alpha(self.fg, 0.06)
    Color::TintStrong => self.line
    Color::Floating => over(self.bg, alpha(self.raised, 0.72))
    Color::Veil => c64(0x0000, 0x009E)
    Color::VeilDeep => c64(0x0000, 0x00EB)
    Color::OnVeil => c64(0xFFFF, 0xFFFF)
    Color::Lifted => self.lifted
    Color::Wash => self.wash
    Color::Sidebar => self.sidebar
    Color::ListGround => self.list
    Color::FieldHover => self.field_hover
    Color::Theater => c64(0x0000, 0x00FF)
    Color::A(inner, o) => alpha(self.color(inner), opacity_value(o))
    Color::Over(u, t) => over(self.color(u), self.color(t))
    Color::Exact(v) => v
    Color::Data(v) => v
  }
}

pub fn Theme::text_size(self : Theme, s : TextSize) -> (Double, Double) {
  match s {
    TextSize::Caption => self.text.caption
    TextSize::Meta => self.text.meta
    TextSize::Ui => self.text.ui
    TextSize::Body => self.text.body
    TextSize::Title => self.text.title
    TextSize::Heading => self.text.heading
    TextSize::Display => self.text.display
    TextSize::Xs3 => self.text.xs3
    TextSize::Xs2 => self.text.xs2
    TextSize::Xs => self.text.xs
    TextSize::Sm => self.text.sm
    TextSize::Base => self.text.base
    TextSize::Lg => self.text.lg
    TextSize::Xl => self.text.xl
    TextSize::Xl2 => self.text.xl2
    TextSize::Xl3 => self.text.xl3
    TextSize::Xl4 => self.text.xl4
    TextSize::Xl5 => self.text.xl5
    TextSize::Xl6 => self.text.xl6
    TextSize::Xl7 => self.text.xl7
    TextSize::Exact(sz, ln) => (exact_ok(sz, "TextSize"), exact_ok(ln, "TextSize"))
  }
}

pub fn Theme::leading(self : Theme, l : Leading) -> Option[Double] {
  match l {
    Leading::Font => None
    Leading::L3 => Some(self.leading.l3)
    Leading::L4 => Some(self.leading.l4)
    Leading::L4_75 => Some(self.leading.l4_75)
    Leading::L5 => Some(self.leading.l5)
    Leading::L6 => Some(self.leading.l6)
    Leading::L7 => Some(self.leading.l7)
    Leading::L8 => Some(self.leading.l8)
    Leading::L9 => Some(self.leading.l9)
    Leading::L10 => Some(self.leading.l10)
    Leading::Exact(v) => Some(exact_ok(v, "Leading"))
  }
}

pub fn Theme::corner(self : Theme, r : Radius) -> Double {
  match r {
    Radius::Sharp => 0.0
    Radius::Inner => 0.0
    Radius::Around => 0.0
    Radius::InnerOr(own) => self.corner(own)
    Radius::Sm => self.radii.sm
    Radius::Base => self.radii.base
    Radius::Md => self.radii.md
    Radius::Lg => self.radii.lg
    Radius::Xl => self.radii.xl
    Radius::Xl1_5 => self.radii.xl1_5
    Radius::Xl2 => self.radii.xl2
    Radius::Xl3 => self.radii.xl3
    Radius::Xl4 => self.radii.xl4
    Radius::Full => 1.0e6
    Radius::Exact(v) => exact_ok(v, "Radius")
    Radius::Corners(a, b, c, d) =>
      dmax(dmax(exact_ok(a, "Radius"), exact_ok(b, "Radius")), dmax(exact_ok(c, "Radius"), exact_ok(d, "Radius")))
    Radius::Linked(c) => paint::corner_radius(c, corner_roots())
    Radius::LinkedEach(a, b, c, d) => {
      let at = corner_roots()
      dmax(dmax(paint::corner_radius(a, at), paint::corner_radius(b, at)), dmax(paint::corner_radius(c, at), paint::corner_radius(d, at)))
    }
  }
}

pub fn radius_each(self : Radius) -> Option[Array[Double]] {
  match self {
    Radius::Corners(a, b, c, d) => Some([a, b, c, d])
    Radius::LinkedEach(a, b, c, d) => {
      let at = corner_roots()
      Some([paint::corner_radius(a, at), paint::corner_radius(b, at), paint::corner_radius(c, at), paint::corner_radius(d, at)])
    }
    Radius::InnerOr(own) => radius_each(own)
    _ => None
  }
}

pub fn Radius::each(self : Radius) -> Option[Array[Double]] {
  radius_each(self)
}

pub fn radius_links(self : Radius) -> Option[Array[paint::CornerOf]] {
  match self {
    Radius::Linked(c) => Some([c, c, c, c])
    Radius::LinkedEach(a, b, c, d) => Some([a, b, c, d])
    Radius::InnerOr(own) => radius_links(own)
    _ => None
  }
}

pub fn Radius::links(self : Radius) -> Option[Array[paint::CornerOf]] {
  radius_links(self)
}

/// Glass optical material (frosted & liquid glass), convertible to/from paint::Glass.
pub struct Glass {
  pub blur : Double
  pub tint : Int64
  pub saturation : Double
  pub solid : Int64
  pub rim_edge : Double
  pub rim_lit : Double
  pub rim_back : Double
  pub liquid : Bool
  pub rim : Double
  pub bezel : Double
  pub refraction : Double
  pub chroma : Double
  pub merge : Double
  pub adaptive : Bool
  pub shares_capture : Bool
  pub contained : Bool
  pub spot : Option[(Double, Double)]
  pub zoom : Double
}

pub fn Glass::frosted(
  blur~ : Double,
  tint~ : Int64,
  solid~ : Int64,
  saturation~ : Double = 1.0,
  rim_edge~ : Double = 0.0,
  rim_lit~ : Double = 0.0,
  rim_back~ : Double = 0.0,
  shares_capture~ : Bool = false,
  contained~ : Bool = false,
) -> Glass {
  Glass::{
    blur, tint, saturation, solid, rim_edge, rim_lit, rim_back,
    liquid: false, rim: 0.0, bezel: 0.0, refraction: 0.0, chroma: 0.0, merge: 0.0,
    adaptive: false, shares_capture, contained, spot: None, zoom: 1.0,
  }
}

pub fn Glass::liquid(
  blur~ : Double = 1.0,
  tint~ : Int64 = c64(0xFFFF, 0xFF1A),
  solid~ : Int64 = c64(0xECEC, 0xF0FF),
  saturation~ : Double = 1.3,
  rim~ : Double = 0.55,
  bezel~ : Double = 14.0,
  refraction~ : Double = 9.0,
  chroma~ : Double = 0.18,
  merge~ : Double = 16.0,
  adaptive~ : Bool = true,
  spot? : (Double, Double),
  zoom~ : Double = 1.0,
) -> Glass {
  Glass::{
    blur, tint, saturation, solid,
    rim_edge: 0.0, rim_lit: 0.0, rim_back: 0.0,
    liquid: true, rim, bezel, refraction, chroma, merge, adaptive,
    shares_capture: false, contained: false, spot, zoom,
  }
}

pub fn Glass::clear(
  blur~ : Double = 0.0,
  tint~ : Int64 = c64(0xFFFF, 0xFF1A),
  solid~ : Int64 = c64(0xECEC, 0xF0FF),
  saturation~ : Double = 1.0,
  rim~ : Double = 0.6,
  bezel~ : Double = 14.0,
  refraction~ : Double = 16.0,
  chroma~ : Double = 0.0,
  merge~ : Double = 16.0,
  adaptive~ : Bool = true,
  spot? : (Double, Double),
  zoom~ : Double = 1.0,
) -> Glass {
  Glass::liquid(
    blur=blur, tint=tint, solid=solid, saturation=saturation, rim=rim,
    bezel=bezel, refraction=refraction, chroma=chroma, merge=merge,
    adaptive=adaptive, spot?=spot, zoom=zoom,
  )
}

pub fn Glass::sharing(self : Glass) -> Glass {
  Glass::{
    blur: self.blur,
    tint: self.tint,
    saturation: self.saturation,
    solid: self.solid,
    rim_edge: self.rim_edge,
    rim_lit: self.rim_lit,
    rim_back: self.rim_back,
    liquid: self.liquid,
    rim: self.rim,
    bezel: self.bezel,
    refraction: self.refraction,
    chroma: self.chroma,
    merge: self.merge,
    adaptive: self.adaptive,
    shares_capture: true,
    contained: self.contained,
    spot: self.spot,
    zoom: self.zoom,
  }
}

pub fn Glass::to_paint(self : Glass) -> paint::Glass {
  paint::Glass::{
    blur: self.blur,
    tint: self.tint,
    saturation: self.saturation,
    solid: self.solid,
    rim_edge: self.rim_edge,
    rim_lit: self.rim_lit,
    rim_back: self.rim_back,
    liquid: self.liquid,
    rim: self.rim,
    bezel: self.bezel,
    refraction: self.refraction,
    chroma: self.chroma,
    merge: self.merge,
    adaptive: self.adaptive,
    shares_capture: self.shares_capture,
    contained: self.contained,
    spot: self.spot,
    zoom: self.zoom,
  }
}

pub fn Glass::from_paint(g : paint::Glass) -> Glass {
  Glass::{
    blur: g.blur,
    tint: g.tint,
    saturation: g.saturation,
    solid: g.solid,
    rim_edge: g.rim_edge,
    rim_lit: g.rim_lit,
    rim_back: g.rim_back,
    liquid: g.liquid,
    rim: g.rim,
    bezel: g.bezel,
    refraction: g.refraction,
    chroma: g.chroma,
    merge: g.merge,
    adaptive: g.adaptive,
    shares_capture: g.shares_capture,
    contained: g.contained,
    spot: g.spot,
    zoom: g.zoom,
  }
}

/// Per-window glass solid override (-1: follow system, 0: glass, 1: solid).
let glass_forced_said : Ref[signals::Signal[Int]] = ref_new(signals::signal(-1))

pub fn set_glass_solid(solid : Option[Bool]) -> Unit {
  let v = match solid {
    None => -1
    Some(true) => 1
    Some(false) => 0
  }
  glass_forced_said.v.set(v)
}

pub fn glass_solid() -> Bool {
  let f = glass_forced_said.v.get()
  if f >= 0 {
    f == 1
  } else {
    hostapi::reduce_transparency() || hostapi::env("MBUI_GLASS") == "solid"
  }
}

/// Per-window reactive signals for tree theme, window corner, and content zoom.
let tree_window_corner : Ref[signals::Signal[Double]] = ref_new(signals::signal(0.0))
let tree_window_zoom : Ref[signals::Signal[Double]] = ref_new(signals::signal(1.0))
let tree_theme_fn : Ref[signals::Signal[Option[() -> Theme]]] = ref_new(signals::signal_ref(None))
let tree_theme_fallback : Ref[signals::Signal[Theme]] = ref_new(signals::signal_ref(Theme::light()))

pub fn set_tree_theme(f : () -> Theme) -> Unit {
  tree_theme_fn.v.set(Some(f))
}

pub fn clear_tree_theme() -> Unit {
  tree_theme_fn.v.set(None)
}

pub fn tree_theme() -> Theme {
  match tree_theme_fn.v.get() {
    Some(f) => f()
    None => tree_theme_fallback.v.get()
  }
}

pub fn corner_roots() -> paint::CornerRoots {
  paint::CornerRoots::{
    window: hostapi::window_corner(),
    fit: tree_theme().corner_fit,
    zoom: tree_window_zoom.v.get(),
  }
}

pub fn tree_corner_roots_now() -> paint::CornerRoots {
  paint::CornerRoots::{
    window: tree_window_corner.v.get(),
    fit: tree_theme().corner_fit,
    zoom: tree_window_zoom.v.get(),
  }
}

/// Reactive linked corner radius for pure-tree nodes.
pub fn corner_of(k : paint::CornerOf) -> view::Live[Double] {
  view::Live::By(fn() { paint::corner_radius(k, tree_corner_roots_now()) })
}
