// Theme, Glass, color algebra (alpha, over, blend, oklch, contrast_ratio, ink_on),
// tree_theme / set_tree_theme, and linked concentric corner_of.
// Ported from libs/mbui/src/ui/theme.mbt, glass.mbt, contrast.mbt, corner_of.mbt.

import "dmath"
import "paint"
import "signals"
import "view"
import "hostapi"

/// Word sizes with line heights (size, line).
pub struct TextScale {
  pub caption : (Double, Double)
  pub meta : (Double, Double)
  pub ui : (Double, Double)
  pub body : (Double, Double)
  pub title : (Double, Double)
  pub heading : (Double, Double)
  pub display : (Double, Double)
  pub xs3 : (Double, Double)
  pub xs2 : (Double, Double)
  pub xs : (Double, Double)
  pub sm : (Double, Double)
  pub base : (Double, Double)
  pub lg : (Double, Double)
  pub xl : (Double, Double)
  pub xl2 : (Double, Double)
  pub xl3 : (Double, Double)
  pub xl4 : (Double, Double)
  pub xl5 : (Double, Double)
  pub xl6 : (Double, Double)
  pub xl7 : (Double, Double)
}

pub fn TextScale::tailwind() -> TextScale {
  TextScale::{
    xs3: (10.0, 14.0),
    xs2: (11.0, 16.0),
    xs: (12.0, 16.0),
    sm: (14.0, 20.0),
    base: (16.0, 24.0),
    lg: (18.0, 28.0),
    xl: (20.0, 28.0),
    xl2: (24.0, 32.0),
    xl3: (30.0, 36.0),
    xl4: (36.0, 40.0),
    xl5: (48.0, 48.0),
    xl6: (60.0, 60.0),
    xl7: (72.0, 72.0),
    caption: (12.0, 16.0),
    meta: (12.0, 16.0),
    ui: (14.0, 20.0),
    body: (16.0, 24.0),
    title: (20.0, 28.0),
    heading: (30.0, 36.0),
    display: (36.0, 40.0),
  }
}

pub struct LeadingScale {
  pub l3 : Double
  pub l4 : Double
  pub l4_75 : Double
  pub l5 : Double
  pub l6 : Double
  pub l7 : Double
  pub l8 : Double
  pub l9 : Double
  pub l10 : Double
}

pub fn LeadingScale::tailwind() -> LeadingScale {
  LeadingScale::{
    l3: 12.0, l4: 16.0, l4_75: 19.0, l5: 20.0, l6: 24.0,
    l7: 28.0, l8: 32.0, l9: 36.0, l10: 40.0,
  }
}

pub struct RadiusScale {
  pub sm : Double
  pub base : Double
  pub md : Double
  pub lg : Double
  pub xl : Double
  pub xl1_5 : Double
  pub xl2 : Double
  pub xl3 : Double
  pub xl4 : Double
}

pub fn RadiusScale::tailwind() -> RadiusScale {
  RadiusScale::{
    sm: 2.0, base: 4.0, md: 6.0, lg: 8.0, xl: 12.0,
    xl1_5: 14.0, xl2: 16.0, xl3: 24.0, xl4: 32.0,
  }
}

