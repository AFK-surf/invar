    scrim: 0x13161B33L,
    shadow: 0x13161B1AL,
    thumb: 0xFFFFFFFFL,
    radius: 12.0,
    radius_lg: 20.0,
    // (a field 36 high, 24 in, in its corners: 24 + 18: capsule_in)
