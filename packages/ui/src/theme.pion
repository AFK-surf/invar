}

///|
/// the app's dark theme, the wide screen's.
pub fn Theme::dark() -> Theme {
  Theme::{
    ..Theme::light(),
    dark: true,
    bg: 0x1F2023FFL,
    surface: 0x2A2C31FFL,
    fg: 0xE9E9EAFFL,
    muted: 0xA8AAAEFFL,
    subtle: 0xA8AAAEFFL,
    faint: 0x313237FFL,
    border: 0x3D3F44FFL,
    line: 0xE9E9EA19L,
    accent: 0xE97342FFL,
    warn_ink: 0xE6B55DFFL,
    primary: 0xECEDEDFFL,
    on_primary: 0x1F2023FFL,
    positive: 0x68C894FFL,
    danger: 0xFF9A97FFL,
    on_danger: 0x1F2023FFL,
    hover: 0xFFFFFF0DL,
    field_hover: 0x5D6066FFL,
    focus: 0x8A8D93FFL,
    scrim: 0x00000080L,
    shadow: 0x00000073L,
    raised: 0x2A2C31FFL,
    card: 0x28292CFFL,
    accent_text: 0xFF9E71FFL,
    accent_bg: 0xFF9E7129L,
    danger_bg: 0xFF9A9729L,
    neutral: 0xE9E9EA0EL,
    selected: 0x323338FFL,
    sidebar: 0x19191BFFL,
    list: 0x1C1D20FFL,
    link: 0x8EB8FEFFL,
    // Native iOS 27.0 dark resting segmented thumb (`(105..111)` over `#1C1C1E`/`#1F2023`/`#28292C`):
    // opaque `0x68686EFF` gives `2.22:1` on canvas, `1.96:1` on card, `>= 1.70:1` on all dark grounds,
    // and `4.56:1` WCAG AA text contrast with `#E9E9EA` without interior shadow darkening.
    lifted: 0x68686EFFL,
    // white at 5%
    wash: 0xFFFFFF0DL,
  }
}

