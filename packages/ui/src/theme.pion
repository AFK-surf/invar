///|
/// The theme in force where the view is building.
pub fn Ctx::theme(self : Ctx) -> Theme {
  self.theme
}

///|
/// The theme from here on (this frame's rest and the next frames'), until set again. With `narrow`, that one in its
/// place in the frames whose window is narrower than `narrow_below` (a phone's), picked as each frame starts from its
/// width (Ctx::narrow; style.pion's `narrow` blocks). The app calls it as it starts and when the person picks light
/// or dark, not every frame. It is the old view's (`Ctx`, built each frame): a window's tree made once says its theme
/// as it is made, followed as it changes (run_tree's and Tester::tree's `theme`, set_tree_theme).
pub fn Ctx::set_theme(self : Ctx, t : Theme, narrow? : Theme, narrow_below? : Double) -> Unit {
  let narrow_below = match narrow_below { Some(__mbt_v) => __mbt_v, None => 700.0 }

  self.theme_wide = t
  self.theme_narrow = narrow
  self.narrow_below = narrow_below
  self.pick_theme()
}

///|
/// The theme set (Ctx::set_theme) for this frame's width.
fn Ctx::pick_theme(self : Ctx) -> Unit {
  self.theme = self.theme_for(self.width)
  self.narrow = self.theme_narrow is Some(_) && self.width < self.narrow_below
  // (what the build goes by of it from here, set as the frame's build begins (frame_build): a theme set as it builds
  // goes by its own for the rest of the build, its corners and spacing worked out by it in this frame)
  self.corner_ladder = self.theme.corner_ladder
  self.corner_fit = self.theme.corner_fit
  self.lit_apart = self.theme.lit_apart
  self.lit_reach = self.theme.lit_reach
}

///|
/// The theme set (Ctx::set_theme) for a window `w` wide: what a frame of that width is drawn in, known before it is
/// built (what the window's tree works out of it as the frame begins: view_frame).
fn Ctx::theme_for(self : Ctx, w : Double) -> Theme {
  match self.theme_narrow {
    Some(n) if w < self.narrow_below => n
    _ => self.theme_wide
  }
}

///|
/// Whether this frame is drawn in the narrow theme (Ctx::set_theme's `narrow`).
pub fn Ctx::narrow(self : Ctx) -> Bool {
  self.narrow
}

///|
/// What a spacing token comes to.
pub fn Ctx::space(self : Ctx, s : Space) -> Double {
  ignore(self)
  s.px()
}

///|
/// What a colour token comes to in the theme in force.
pub fn Ctx::color(self : Ctx, c : Color) -> Int64 {
  Theme::color(self.theme, c)
}

///|
/// A size of words in the theme in force: (size, line).
pub fn Ctx::text_size(self : Ctx, s : TextSize) -> (Double, Double) {
  self.theme.text_size(s)
}

///|
/// What a colour token comes to in this theme.
pub fn Theme::color(self : Theme, c : Color) -> Int64 {
  match c {
    Color::Clear => 0L
    Color::Bg => self.bg
    Color::Surface => self.surface
    Color::Raised => self.raised
    Color::Card => self.card
    Color::Fg => self.fg
    Color::Muted => self.muted
    Color::Subtle => self.subtle
    Color::Faint => self.faint
    Color::Line => self.line
    Color::Border => self.border
    Color::Accent => self.accent
    Color::AccentText => self.accent_text
    Color::AccentBg => self.accent_bg
    Color::OnAccent => self.on_accent
    Color::Primary => self.primary
    Color::OnPrimary => self.on_primary
    Color::Positive => self.positive
    Color::Danger => self.danger
    Color::DangerBg => self.danger_bg
    Color::OnDanger => self.on_danger
    Color::Neutral => self.neutral
    Color::Hover => self.hover
    Color::Selected => self.selected
    Color::Focus => self.focus
    Color::Scrim => self.scrim
    Color::Link => self.link
    Color::ShadowC => self.shadow
    Color::Warn => self.warn
    Color::WarnInk => self.warn_ink
    Color::Tint => alpha(self.fg, 0.06)
    Color::TintStrong => self.line
    Color::Floating => over(self.bg, alpha(self.raised, 0.72))
    Color::Veil => 0x0000009EL
    Color::VeilDeep => 0x000000EBL
    Color::OnVeil => 0xFFFFFFFFL
    Color::Lifted => self.lifted
    Color::Wash => self.wash
    Color::Sidebar => self.sidebar
    Color::ListGround => self.list
    Color::FieldHover => self.field_hover
    Color::Theater => 0x000000FFL
    Color::A(c, o) => alpha(self.color(c), o.value())
    Color::Over(u, t) => over(self.color(u), self.color(t))
    Color::Exact(v) => v
    Color::Data(v) => v
  }
}

///|
/// A size of words in this theme: (size, line).
pub fn Theme::text_size(self : Theme, s : TextSize) -> (Double, Double) {
  match s {
    TextSize::Caption => self.text.caption
    TextSize::Meta => self.text.meta
    TextSize::Ui => self.text.ui
    TextSize::Body => self.text.body
    TextSize::Title => self.text.title
    TextSize::Heading => self.text.heading
    TextSize::Display => self.text.display
    TextSize::Xs3 => self.text.xs3
    TextSize::Xs2 => self.text.xs2
    TextSize::Xs => self.text.xs
    TextSize::Sm => self.text.sm
    TextSize::Base => self.text.base
    TextSize::Lg => self.text.lg
    TextSize::Xl => self.text.xl
    TextSize::Xl2 => self.text.xl2
    TextSize::Xl3 => self.text.xl3
    TextSize::Xl4 => self.text.xl4
    TextSize::Xl5 => self.text.xl5
    TextSize::Xl6 => self.text.xl6
    TextSize::Xl7 => self.text.xl7
    TextSize::Exact(size, line) => (exact_ok(size, "TextSize"), exact_ok(line, "TextSize"))
  }
}

///|
/// A line's height in this theme; None for `Font`, the font's own (no height to say: not a 0 to be taken for one).
pub fn Theme::leading(self : Theme, l : Leading) -> Option[Double] {
  match l {
    Leading::Font => Option::None
    Leading::L3 => Some(self.leading.l3)
    Leading::L4 => Some(self.leading.l4)
    Leading::L4_75 => Some(self.leading.l4_75)
    Leading::L5 => Some(self.leading.l5)
    Leading::L6 => Some(self.leading.l6)
    Leading::L7 => Some(self.leading.l7)
    Leading::L8 => Some(self.leading.l8)
    Leading::L9 => Some(self.leading.l9)
    Leading::L10 => Some(self.leading.l10)
    Leading::Exact(v) => Some(exact_ok(v, "Leading"))
  }
}

///|
/// A corner in this theme (`Inner` and `Around` are worked out once laid out: 0 here; `InnerOr` its own here, the
/// container's once laid out where it lies in a corner of one; `Corners` the roundest of its four, each its own as a box
/// is drawn: Radius::each).
pub fn Theme::corner(self : Theme, r : Radius) -> Double {
  match r {
    Radius::Sharp | Radius::Inner | Radius::Around => 0.0
    Radius::InnerOr(own) => self.corner(own)
    Radius::Sm => self.radii.sm
    Radius::Base => self.radii.base
    Radius::Md => self.radii.md
    Radius::Lg => self.radii.lg
    Radius::Xl => self.radii.xl
    Radius::Xl1_5 => self.radii.xl1_5
    Radius::Xl2 => self.radii.xl2
    Radius::Xl3 => self.radii.xl3
    Radius::Xl4 => self.radii.xl4
    Radius::Full => 1.0e6
    Radius::Exact(v) => exact_ok(v, "Radius")
    // (each its own: the roundest here, each in Ctx::box's corners)
    // (each its own: the roundest here, each in Ctx::box's corners)
    Radius::Corners(a, b, c, d) =>
    dmax(dmax(exact_ok(a, "Radius"), exact_ok(b, "Radius")), dmax(exact_ok(c, "Radius"), exact_ok(d, "Radius")))
    // (where it comes from, now: corner_of.pion)
    // (where it comes from, now: corner_of.pion)
    Radius::Linked(c) => paint::CornerOf::radius(c, corner_roots())
    Radius::LinkedEach(a, b, c, d) => {
      let at = corner_roots()
      dmax(dmax(paint::CornerOf::radius(a, at), paint::CornerOf::radius(b, at)), dmax(paint::CornerOf::radius(c, at), paint::CornerOf::radius(d, at)))
    }
  }
}

///|
/// The corners of `r` each its own (top left, top right, bottom right, bottom left), where they are not one: `Corners`,
/// alone or as what `InnerOr` keeps.
pub fn Radius::each(self : Radius) -> Option[FixedArray[Double]] {
  match self {
    Radius::Corners(a, b, c, d) => Some(FixedArray::from_array([a, b, c, d]))
    Radius::LinkedEach(a, b, c, d) => {
      let at = corner_roots()
      Some(FixedArray::from_array([
        paint::CornerOf::radius(a, at),
        paint::CornerOf::radius(b, at),
        paint::CornerOf::radius(c, at),
        paint::CornerOf::radius(d, at),
      ]),)
    }
    Radius::InnerOr(own) => own.each()
    _ => Option::None
  }
}

///|
/// Where the corners of `r` come from, each (top left, then round it), where they are linked: `Linked`, `LinkedEach`,
/// or what `InnerOr` keeps; None where they are not.
pub fn Radius::links(self : Radius) -> Option[FixedArray[paint::CornerOf]] {
  match self {
    Radius::Linked(c) => Some(FixedArray::make(4, c))
    Radius::LinkedEach(a, b, c, d) => Some(FixedArray::from_array([a, b, c, d]))
    Radius::InnerOr(own) => own.links()
    _ => Option::None
  }
}

///|
/// `body` built under theme `t` (a dark panel in a light page, a part restyled), the theme as it was after it.
pub fn Ctx::with_theme(self : Ctx, t : Theme, body : () -> Unit) -> Unit {
  let saved = self.theme
  self.theme = t
  if t.corner_ladder.length() > 0 {
    self.corner_ladder = t.corner_ladder
  }
  if t.corner_fit is Some(_) {
    self.corner_fit = t.corner_fit
  }
  if t.lit_apart > 0.0 {
    self.lit_apart = t.lit_apart
  }
  if t.lit_reach > 0.0 {
    self.lit_reach = t.lit_reach
  }
  body()
  self.theme = saved
}

///|
/// Which way words and rows run (Radix's DirectionProvider, CSS's `dir`).

#derive(Eq)
pub enum Direction {
  Ltr
  Rtl
}

///|
/// By its name, as the gallery writes it: what `derive(Show)` wrote.
pub fn Direction::to_string(self : Direction) -> String {
  let logger = StringBuilder()
  let __mbt_show_run : () -> Unit = fn() -> Unit {
    logger.write_string(
      match self {
        Direction::Ltr => "Ltr"
        Direction::Rtl => "Rtl"
      },
    )
  }
  __mbt_show_run()
  logger.to_string()
}

///|
/// The direction in force where the view is building.
pub fn Ctx::direction(self : Ctx) -> Direction {
  self.direction
}

///|
/// Whether rows run right to left where the view is building: a row's first child is at its right, its start
/// padding the right one, and the arrows that move along a row go the other way (focus.pion).
pub fn Ctx::rtl(self : Ctx) -> Bool {
  self.direction == Direction::Rtl
}

///|
/// The direction from here on, until set again (the app's language's).
pub fn Ctx::set_direction(self : Ctx, d : Direction) -> Unit {
  self.direction = d
}

///|
/// `body` built in direction `d` (a part in another language), the direction as it was after it.
pub fn Ctx::with_direction(self : Ctx, d : Direction, body : () -> Unit) -> Unit {
  let saved = self.direction
  self.direction = d
  body()
  self.direction = saved
}

///|
/// `c` at `a` of its alpha (0 … 1).
pub fn alpha(c : Int64, a : Double) -> Int64 {
  let k = ((c & 0xFFL).to_double() * dclamp(a, 0.0, 1.0)).round().to_int64()
  (c & 0xFFFFFF00L) | k
}

///|
/// `top` laid over `under` (both RRGGBBAA): the colour it shows as; over a tint (a ground pointed at laid over a
/// translucent one: style.pion Patch::lit_by), the two as one tint, as much of what is under them showing through.
pub fn over(under : Int64, top : Int64) -> Int64 {
  let a = (top & 0xFFL).to_double() / 255.0
  let ua = (under & 0xFFL).to_double() / 255.0
  if ua < 1.0 {
    let oa = a + ua * (1.0 - a)
    if oa <= 0.0 {
      return 0L
    }
    let mix = fn(sh : Int) -> Int64 {
      let u = ((under >> sh) & 0xFFL).to_double()
      let t = ((top >> sh) & 0xFFL).to_double()
      ((t * a + u * ua * (1.0 - a)) / oa).round().to_int64() << sh
    }
    return mix(24) | mix(16) | mix(8) | (oa * 255.0).round().to_int64()
  }
  let ch = fn(sh : Int) -> Int64 {
    let u = ((under >> sh) & 0xFFL).to_double()
    let t = ((top >> sh) & 0xFFL).to_double()
    (u + (t - u) * a).round().to_int64() << sh
  }
  ch(24) | ch(16) | ch(8) | 0xFFL
}

///|
/// `a` going to `b` as `t` goes from 0 to 1, channel by channel (alpha too).
pub fn blend(a : Int64, b : Int64, t : Double) -> Int64 {
  let k = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
  let ch = fn(sh : Int) -> Int64 {
    let x = ((a >> sh) & 0xFFL).to_double()
    let y = ((b >> sh) & 0xFFL).to_double()
    (x + (y - x) * k).round().to_int64() << sh
  }
  ch(24) | ch(16) | ch(8) | ch(0)
}

///|
/// The colour of OKLCH lightness `l` (0 … 1), chroma `c` and hue `h` (degrees), at `alpha` (0 … 1, 1 by default), as
/// 0xRRGGBBAA: at that lightness and hue, as saturated as sRGB has it up to `c` (less by 0.005 at a time till it does).
pub fn oklch(l : Double, c : Double, h : Double, alpha? : Double) -> Int64 {
  let alpha = match alpha { Some(__mbt_v) => __mbt_v, None => 1.0 }

  let rad = h * 3.141592653589793 / 180.0
  let mut c = c
  while c > 0.0 {
    let (r, g, b) = oklab_linear(l, c * dmath::cos(rad), c * dmath::sin(rad))
    if r >= -0.0001 && r <= 1.0001 && g >= -0.0001 && g <= 1.0001 && b >= -0.0001 && b <= 1.0001 {
      break
    }
    c = c - 0.005
  }
  let c = if c < 0.0 { 0.0 } else { c }
  let (r, g, b) = oklab_linear(l, c * dmath::cos(rad), c * dmath::sin(rad))
  let a = (dclamp(alpha, 0.0, 1.0) * 255.0).round().to_int64()
  (srgb_byte(r) << 24) | (srgb_byte(g) << 16) | (srgb_byte(b) << 8) | a
}

///|
/// OKLab to linear sRGB (Björn Ottosson's matrices).
fn oklab_linear(l : Double, a : Double, b : Double) -> (Double, Double, Double) {
  let l_ = l + 0.3963377774 * a + 0.2158037573 * b
  let m_ = l - 0.1055613458 * a - 0.0638541728 * b
  let s_ = l - 0.0894841775 * a - 1.2914855480 * b
  let (l3, m3, s3) = (l_ * l_ * l_, m_ * m_ * m_, s_ * s_ * s_)
  (4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3, -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3, -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3)
}

///|
/// A linear sRGB channel as its byte (clamped, the sRGB curve).
fn srgb_byte(v : Double) -> Int64 {
  let v = if v < 0.0 { 0.0 } else if v > 1.0 { 1.0 } else { v }
  let e = if v <= 0.0031308 { 12.92 * v } else { 1.055 * dmath::pow(v, 1.0 / 2.4) - 0.055 }
  (e * 255.0).round().to_int64()
}
