import "dmath"
import "paint"

// What the views built under it look like unless they say (SwiftUI's environment, Compose's CompositionLocal, egui's
// Style): the theme's colours, corners and sizes, and which way words and rows run. The app sets it once (it stays
// from frame to frame) or for a part of what it builds (Ctx::with_theme, Ctx::with_direction); the widgets read their
// defaults from it, and what a call says itself still wins. ui's kit/styles.pion says how the components use it.

///|
/// The theme: colours RRGGBBAA, corners and sizes in logical pixels. Made from one of its kinds (Theme::light, …) and
/// changed where the app differs (`{ ..Theme::light(), accent: 0x… }`). By default the app's (its web and apps'
/// tokens: the wide screen's white canvas and the app orange, the phone's warm paper); iOS's colours, what ui had
/// hard-coded, are Theme::ios_light and Theme::ios_dark.

#derive(Eq)
pub struct Theme {
  pub dark : Bool
  pub bg : Int64
  pub surface : Int64
  pub fg : Int64
  pub muted : Int64
  pub subtle : Int64
  pub faint : Int64
  pub border : Int64
  pub line : Int64
  pub accent : Int64
  pub on_accent : Int64
  pub primary : Int64
  pub on_primary : Int64
  pub positive : Int64
  pub danger : Int64
  pub on_danger : Int64
  pub hover : Int64
  pub field_hover : Int64
  pub focus : Int64
  pub scrim : Int64
  pub shadow : Int64
  pub thumb : Int64
  pub radius : Double
  pub radius_lg : Double
  pub radius_dialog : Double
  pub font : Double
  pub font_sm : Double
  pub font_title : Double
  pub font_heading : Double
  pub control_h : Double
  pub focus_w : Double
  pub focus_gap : Double
  pub raised : Int64
  pub card : Int64
  pub accent_text : Int64
  pub accent_bg : Int64
  pub danger_bg : Int64
  pub neutral : Int64
  pub selected : Int64
  pub link : Int64
  pub warn : Int64
  pub warn_ink : Int64
  pub lifted : Int64
  pub wash : Int64
  pub sidebar : Int64
  pub list : Int64
  pub text : TextScale
  pub leading : LeadingScale
  pub radii : RadiusScale
  pub corner_ladder : Array[Double]
  pub corner_fit : Option[paint::CornerFit]
  pub lit_apart : Double
  pub lit_reach : Double
  pub text_line : Double
  pub tabular : Bool
}

///|
/// The sizes of words, each with its line's height (size, line): the roles' (TextSize Caption … Display), then the
/// scale's.

#derive(Eq)
pub struct TextScale {
  pub caption : (Double, Double)
  pub meta : (Double, Double)
  pub ui : (Double, Double)
  pub body : (Double, Double)
  pub title : (Double, Double)
  pub heading : (Double, Double)
  pub display : (Double, Double)
  pub xs3 : (Double, Double)
  pub xs2 : (Double, Double)
  pub xs : (Double, Double)
  pub sm : (Double, Double)
  pub base : (Double, Double)
  pub lg : (Double, Double)
  pub xl : (Double, Double)
  pub xl2 : (Double, Double)
  pub xl3 : (Double, Double)
  pub xl4 : (Double, Double)
  pub xl5 : (Double, Double)
  pub xl6 : (Double, Double)
  pub xl7 : (Double, Double)
}

///|
/// Tailwind's (v3.4).
pub fn TextScale::tailwind() -> TextScale {
  TextScale::{
    xs3: (10.0, 14.0),
    xs2: (11.0, 16.0),
    xs: (12.0, 16.0),
    sm: (14.0, 20.0),
    base: (16.0, 24.0),
    lg: (18.0, 28.0),
    xl: (20.0, 28.0),
    xl2: (24.0, 32.0),
    xl3: (30.0, 36.0),
    xl4: (36.0, 40.0),
    xl5: (48.0, 48.0),
    xl6: (60.0, 60.0),
    xl7: (72.0, 72.0),
    // the roles on Tailwind's: xs, xs, sm, base, xl, 3xl, 4xl
    caption: (12.0, 16.0),
    meta: (12.0, 16.0),
    ui: (14.0, 20.0),
    body: (16.0, 24.0),
    title: (20.0, 28.0),
    heading: (30.0, 36.0),
    display: (36.0, 40.0),
  }
}

///|
/// The heights of lines said on their own (Leading's L3 … L10, and L4_75), in pixels.

#derive(Eq)
pub struct LeadingScale {
  pub l3 : Double
  pub l4 : Double
  pub l4_75 : Double
  pub l5 : Double
  pub l6 : Double
  pub l7 : Double
  pub l8 : Double
  pub l9 : Double
  pub l10 : Double
}

///|
/// Tailwind's (v3.4: leading-3 … leading-10, 0.75rem … 2.5rem; leading-4.75, 19).
pub fn LeadingScale::tailwind() -> LeadingScale {
  LeadingScale::{ l3: 12.0, l4: 16.0, l4_75: 19.0, l5: 20.0, l6: 24.0, l7: 28.0, l8: 32.0, l9: 36.0, l10: 40.0 }
}

///|
/// The corners.

#derive(Eq)
pub struct RadiusScale {
  pub sm : Double
  pub base : Double
  pub md : Double
  pub lg : Double
  pub xl : Double
  pub xl1_5 : Double
  pub xl2 : Double
  pub xl3 : Double
  pub xl4 : Double
}

///|
/// Tailwind's (v3.4).
pub fn RadiusScale::tailwind() -> RadiusScale {
  RadiusScale::{ sm: 2.0, base: 4.0, md: 6.0, lg: 8.0, xl: 12.0, xl1_5: 14.0, xl2: 16.0, xl3: 24.0, xl4: 32.0 }
}

