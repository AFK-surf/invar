///|
/// A node reused for the next frame is reset in three parts (alloc sets
/// its kind and parent; Ctx::alloc_part), and a builder that sets a part
/// itself skips it: a box its look, a text its words. This part, what no
/// builder sets all of: its place in the tree, what few nodes use.
fn Node::reset_rest(self : Node) -> Unit {
  self.id = 0
  self.hit = false
  self.points = false
  self.marks = 0
  self.focus = Option::None
  self.corner_by = 0
  self.sem = Option::None
  self.sem_hid = false
  self.island = Option::None
  self.tree_scrolls = false
  self.tree_corrected = 0.0
  self.tree_rows = false
  self.floats = false
  self.scroller = 0
  self.scroller_inner = false
  self.words = Option::None
  self.press_owner = Option::None
  self.press_node = Option::None
  self.moved_vars = Option::None
  self.drawn_built = Option::None
  self.ticks = Option::None
  self.drawn = Option::None
  self.first = -1
  self.last = -1
  self.next = -1
  self.moved_by = Option::None
  self.moved_x = 0.0
  self.moved_y = 0.0
  self.moved_carries = false
  self.room_held = false
  self.fit = Fit::FitCover
  self.fade = true
  self.matte = false
  self.still = false
  self.pages = Option::None
  self.page_no = -1
  self.layer = false
  self.mar_l = 0.0
  self.mar_t = 0.0
  self.mar_r = 0.0
  self.mar_b = 0.0
  self.at_l = 0.0 / 0.0
  self.at_t = 0.0 / 0.0
  self.at_r = 0.0 / 0.0
  self.at_b = 0.0 / 0.0
  self.moves = ""
  self.portal = false
  self.portal_id = 0
  self.stack = -1
  self.stack_in = Option::None
  self.mark = 0
  self.shot = false
  self.surface = false
  self.look_scope = false
  self.paints = Option::None
  self.blocks = false
  self.stops_wheel = false
  self.passes = false
  self.sideways = false
  self.in_sideways = false
  self.bones = 0L
  self.bone_whole = false
  self.shrinks = false
  self.past_most = false
  self.keep = false
  self.allow_ellipsis = false
  self.drop = 0
  self.one_of = false
  self.tallest = false
  self.flow = false
  self.flow_reverse = false
  self.line_gap = -1.0
  self.label = ""
  self.name = ""
  self.rich = Option::None
  // (none, shared: only ever put in place whole, Ctx::lines and Ctx::shapes; a new empty one for each node on every
  // frame was two allocations a node)
  self.lines = no_lines
  self.shapes = no_shapes
  // (its cut runs go with its layout, kept with it: rl, rl_for, rl_whole)
  self.item = -1
  self.stick = 0.0 / 0.0
}

///|
/// Every field as Node::new has it, its flex node aside (its own, never laid out where this is asked: corners.pion
/// tree_laid_spare): the three parts a node reused is reset in, and what those leave to Ctx::alloc_part, to node_known
/// or to the layout; its lines and shapes none, as reset_rest has them (empty, shared). A node of the window's tree's
/// put among the frame's again (Ctx::with_tree_nodes), as a new one. A field added to Node::new is added here too.
fn Node::reset_new(self : Node) -> Unit {
  self.reset_rest()
  self.reset_look()
  self.reset_words()
  self.kind = 0
  self.parent = -1
  self.corners_worked = false
  self.ident = 0
  self.keyless = false
  self.seed = 0
  self.slot = -1
  self.kids = 0
  self.made_pass = -1
  self.notch_y = 0.0
  self.notch_f = 0.0
  self.least = 0.0
  self.fit_least = 0.0
  self.soft_least = 0.0
  self.x = 0.0
  self.y = 0.0
  self.fw = 0.0
  self.fh = 0.0
  self.tl = Option::None
  self.full = Option::None
  self.full_max = 0.0
  self.full_cut = false
  self.said_of = ""
  self.said_hash = no_words_said
  self.shape_bands = Option::None
  self.rcut = Option::None
  self.rl = Option::None
  self.rl_max = 0.0
  self.rl_for = Option::None
  self.rl_whole = 0.0 / 0.0
  self.lk_kind = -1
  self.lk_text = ""
  self.lk_shorter = no_words
  self.lk_size = 0.0
  self.lk_weight = 0
  self.lk_line = 0.0
  self.lk_trim = false
  self.lk_wrap = false
  self.lk_spacing = 0.0
  self.lk_tabular = false
  self.lk_balance = false
  self.lk_max_lines = 0
  self.lk_shaped = -1
  self.lk_rich = Option::None
  self.lk_iw = -1.0
  self.lk_ih = -1.0
  self.lk_scale = -1.0
  self.lk_whole = false
  self.lk_up = 0
  self.otx = 0.0
  self.oty = 0.0
  self.same = false
}

///|
/// The stable_hash of no words (Node::new's `said_hash`), worked out once.
// kept across runs: a table, never written
// moved to 00_init_order.pion: no_words_said

///|
/// Its words' stable_hash (tree_sig): kept with the words it was worked out of, worked out again only where they are
/// other words (the same string, as a row built again from the same data has it, not read again).
fn Node::text_said(self : Node) -> Int64 {
  if !physical_equal(self.said_of, self.text) && self.said_of != self.text {
    self.said_of = self.text
    self.said_hash = stable_hash(self.text)
  }
  self.said_hash
}

