import "flex"
import "paint"
import "view"

// The tree a view builds each frame. Nodes live in a pool that is reused
// from frame to frame; they refer to each other by index, never by pointer,
// so reference counting sees no cycles.

///|

#derive(Eq)
pub enum Size {
  Auto
  Px(Double)
  Fill(Double)
  Cut
  Pct(Double)
}

///|

#derive(Eq)
pub enum Dir {
  Row
  Column
}

///|

#derive(Eq)
pub enum Align {
  AStart
  ACenter
  AEnd
  AStretch
  AFirstLine
  ABaseline
}

///|

#derive(Eq)
pub enum Justify {
  JStart
  JCenter
  JEnd
  JBetween
}

