import "mbt_compat"
import "signals"
import "view"

// A stack of pages drawn flat (Ctx::nav_flat's, a pane's beside a sidebar) held by the window's tree: the stack a node
// of its own, each page in it a node made as it is put on the stack and let go as it leaves it (what the page made for
// it forgotten then: Nav's on_leave), the page itself built in it while it shows. What shows is the page on top, in
// place, nothing sliding — or, where its owner keeps one shown while the one on top waits for what it shows
// (Nav::flat_owned, Nav::flat_keep: page_wait.pion's, at its causes), that one, kept till it is let go; a page put in
// place moving is put where it was going. A page put in place waits for nothing here: what waits is its owner's (no
// owner, it shows at once). What is pushed over the page in place (Nav::push_over: a pane on a tape, a phone's screen)
// slides in over it as nav_view's pages do, once `over_ready` says it has what it shows (`most` ms at most:
// Nav::held_by), and back takes it off sliding, following the system's gesture, down to the page in place (the stack's
// floor), where `takes_back` says back is the stack's now.
//
// Which pages it holds and which show is where a change left things as a whole (@signals.after_flush): the stack told
// anew and what its owner says of it as that comes (the page before kept as the one in its place waits) seen as one,
// never the half between them, whichever of them is told first — so a page kept is never let go and made again.

///|
/// Where a flat stack stands as a change left it (nav_flat_view): the entries it holds a node for, those that show,
/// whether what shows is pushed over the page in place, and what kind of page made once each is (by `keys`' order).

#derive(Eq)
struct FlatSeen {
  keys : Array[Int]
  shown : Array[Int]
  stacked : Bool
  kinds : Array[String]
  kept : Array[Int]
  kept_kinds : Array[String]
}

///|
/// The page drawn in place now (the one kept shown where its owner keeps one, else the one on top), read as it changes.
fn Nav::flat_drawn[P](self : Nav[P]) -> NavPage[P] {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  match self.flat_kept_entry() {
    Some(e) => e
    Option::None => self.pages[self.pages.length() - 1]
  }
}

///|
/// Entry `serial` of a flat stack: on it, going back off it, or kept shown in place though it left it (Nav::flat_keep).
fn Nav::flat_entry[P](self : Nav[P], serial : Int) -> Option[NavPage[P]] {
  match self.entry(serial) {
    Some(e) => Some(e)
    Option::None =>
    match mbt_compat::opt_filter(self.flat_kept_entry(), fn(e) { e.serial == serial }) {
      Some(e) => Some(e)
      // (to be put by on its kept left as the stack stands whole: Nav::parks_soon)
      // (to be put by on its kept left as the stack stands whole: Nav::parks_soon)
      None => self.parks_soon(serial)
    }
  }
}

///|
/// What page entry `serial` is (as it is now: what it became in place) and the page under it as it was put on: one on
/// the stack, going back off it, or kept shown in place though it left it (Nav::flat_keep); read as it changes. What
/// the frame puts over a page asks of it (nav_flat_view's `head`).
pub fn Nav::page_of[P](self : Nav[P], serial : Int) -> Option[(P, Option[P])] {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  mbt_compat::opt_map(self.flat_entry(serial), fn(e) { (e.page, e.under) })
}

///|
/// Entry `serial`'s time on top (a number of its own each time it is put there: Ctx::page_stint's), wherever it is (on
/// the stack, leaving it, on its shelf or kept left, kept shown in place), read as it changes; none once it is gone.
pub fn Nav::stint_of[P](self : Nav[P], serial : Int) -> Option[Int] {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  mbt_compat::opt_map(self.flat_entry(serial), fn(e) { e.stint })
}

///|
/// The entries a flat stack holds a node for: those on it, the one going back off it, and the one kept shown in place
/// though it left it (Nav::flat_keep), read as they change.
fn Nav::flat_entries[P](self : Nav[P]) -> Array[Int] {
  self.said.get() |> ignore
  self.shown.get() |> ignore
  let all = mbt_compat::arr_map(self.pages, fn(e) { e.serial })
  match self.leaving {
    Some(e) => all.push(e.serial)
    Option::None => ()
  }
  match self.flat_kept_entry() {
    Some(e) if !all.contains(e.serial) => all.push(e.serial)
    _ => ()
  }
  all
}

///|
/// Stack `nav` drawn flat as a node of `v`'s, filling the room it is given (above): each page built by `page` (its old
/// view, built again as `page_key` of it changes besides what it reads), on a ground of `bg`; a page put in place shown
/// as its owner says (Nav::flat_owned, Nav::flat_keep), else at once; what is pushed over the page in place sliding in
/// once `over_ready` says it has what it shows (`most` ms at most), taken off by back (within `edge` of its left side)
/// while `takes_back` says back is the stack's; where `stacks` says not (a pane beside a sidebar off a tape), shown in
/// place as any other. Over each page's own view what `head` makes of its entry (by its number, and whether the page
/// is made once there: `made`), nodes of the tree's
/// laid over it (a panel's bar: the page leaving its room), the stack's back over the whole of both (Nav::backs_over);
/// what was kept for it let go by `gone` as its entry is (not as it stops showing: shown again, as it was). `made`: a
/// page made once as nodes of the tree's in the place of its old view, as nav_view's (Nav::made: what `head` makes in
/// its flow over it, the page in the room left under it). `shown`: told the entries that show (by their numbers) as
/// the stack stands whole after a change (never the half between a change and its owner's keeping), and as it is made.
/// `keeps_left`: as nav_view's, an entry that left put by as the stack stands whole once none keeps it shown in place
/// (Nav::flat_keep), never let go and made again between. `keeps_made`: as nav_view's, a root made once that a root is
/// put in the place of (Nav::replace_kept) put on the shelf once none keeps it shown in place, its nodes put by at rest
/// and taken in again as it is put back; the shelf emptied, each on it left for good, as this node is let go.
pub fn nav_flat_view[P](v : view::View, nav : Nav[P], page : (Ctx, P) -> Unit, over_ready : (P) -> Bool, most : Double, bg? : () -> Int64, edge? : Double, takes_back? : () -> Bool, stacks? : () -> Bool, page_key? : (P) -> String, page_for? : (view::View, Int) -> (view::View) -> (Ctx, P) -> Unit, head? : (view::View, Int, Bool) -> Unit, gone? : (Int) -> Unit, made? : (P) -> Option[(String, (view::View, () -> P, Option[P], () -> Int, Int) -> Unit)], keeps_made? : Bool, shown? : (Array[Int]) -> Unit, keeps_left? : (P) -> Option[(String, String)], transition? : NavTransition) -> view::View {
  let bg = match bg { Some(__mbt_v) => __mbt_v, None => fn() { 0L } }
  let edge = match edge { Some(__mbt_v) => __mbt_v, None => 20.0 }
  let takes_back = match takes_back { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let stacks = match stacks { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let page_key = match page_key { Some(__mbt_v) => __mbt_v, None => fn(_) { "" } }
  let gone = match gone { Some(__mbt_v) => __mbt_v, None => fn(_) { } }
  let made = match made { Some(__mbt_v) => __mbt_v, None => fn(_) { Option::None } }
  let keeps_made = match keeps_made { Some(__mbt_v) => __mbt_v, None => false }
  let shown = match shown { Some(__mbt_v) => __mbt_v, None => fn(_) { } }
  let transition = match transition { Some(__mbt_v) => __mbt_v, None => NavTransition::flat() }

  // (what shows pushed over the page in place, where what is pushed over is so here)
  let stacked = fn() { stacks() && nav.stacked() }
  v.box(fn(s) {
    s.grow(view::Live::Is(1.0)).clips(view::Live::Is(true)) |> ignore
    if keeps_left is Some(_) {
      nav.keeps_left = keeps_left
      // (its kept left this node's: let go with it, what it put by let go by the each below, each left for good)
      s.owns(fn() {
        nav.keeps_left = Option::None
        nav.kept_left = []
      })
      |> ignore
    }
    if keeps_made {
      nav.shelves = Some(fn(p) {
        match made(p) {
          Some((kind, _)) => nav_shelf_kind_allows(nav.said, kind)
          Option::None => false
        }
      })
      // (its shelf this node's: let go with it, what it put by let go by the each below, each left for good)
      s.owns(fn() {
        nav.shelves = Option::None
        nav.shelf = []
      })
      |> ignore
    }
    // (what a frame says of a stack, as nav_view's: when it rests, a page held by a finger)
    let k = nav_views_made.v
    nav_views_made.v = k + 1
    nav_views.push((k, fn(c) {
      if nav.mode == 3 {
        c.page_in_hand = true
      }
      let r = nav.rested_at(c.frame_no)
      if r > c.nav_rest {
        c.nav_rest = r
      }
    }))
    s.owns(fn() {
      match arr_search_by(nav_views, fn(e) { e.0 == k }) {
        Some(i) => mbt_compat::arr_remove(nav_views, i) |> ignore
        Option::None => ()
      }
    })
    |> ignore
    // (the entries a node of it holds now: what left the stack with none, let go of as it stands, Nav::flat_gone)
    let held : mbt_compat::OrderedMap[Int, Bool] = mbt_compat::OrderedMap::new_by(fn(k : Int) -> Int { k }, fn(a : Int, b : Int) -> Bool { a == b })
    // (what is pushed over the page in place slides as a phone's, its wait and its slide at their causes)
    nav.held_by(s, fn() { s.laid_size() }, Some(fn(p) { !nav.top_over() || over_ready(p) }), most)
    // (where it stands as a change left it, as a whole: told once each change is told whole, while it is held)
    // (what kind of page made once each of `keys` is, as what it is and what `made` reads to say so are now)
    let kinds_of = fn(keys : Array[Int]) {
      mbt_compat::arr_map(keys, fn(k) {
        match nav.flat_entry(k) {
          Some(e) =>
          match made(e.page) {
            Some((kind, _)) => kind
            Option::None => ""
          }
          Option::None => ""
        }
      })
    }
    let seen_now = fn() -> FlatSeen {
      signals::untracked(fn() {
        let st = stacked()
        let shown = if st {
          let (top, beside) = nav.top_beside()
          match beside {
            // (one put on again from the kept left pushed over the page in place, its slide waiting for what it shows:
            // the page beside alone shown meanwhile, it at rest till then)
            // (one put on again from the kept left pushed over the page in place, its slide waiting for what it shows:
            // the page beside alone shown meanwhile, it at rest till then)
            Some(b) if nav.top_waits() && nav.waiting_taken_back(top.serial) => [b.serial]
            Some(b) => [top.serial, b.serial]
            Option::None => [top.serial]
          }
        } else {
          [nav.flat_drawn().serial]
        }
        // (one put on again from the kept left whose owner waits for what it shows (the one before kept shown meanwhile):
        // left put by as it rests, none of it laid out or woken, till it shows, taken in whole then)
        let all = nav.flat_entries()
        let is_made = fn(k : Int) {
          match nav.flat_entry(k) {
            Some(e) => made(e.page) is Some(_)
            Option::None => false
          }
        }
        let keys = mbt_compat::arr_filter(all, fn(k) { shown.contains(k) || (!is_made(k) && !nav.waiting_taken_back(k)) })
        // (those on the shelf, on the kept left, and covered on the stack, put by at rest: none of them while it shows,
        // one kept shown in place as it goes on the shelf put by once its owner lets it go)
        let kept : Array[Int] = []
        if keeps_made {
          for e in nav.shelf {
            if !keys.contains(e.serial) && !kept.contains(e.serial) {
              kept.push(e.serial)
            }
          }
        }
        for x in nav.kept_left {
          if !keys.contains(x.2.serial) && !kept.contains(x.2.serial) {
            kept.push(x.2.serial)
          }
        }
        for k in all {
          if !keys.contains(k) && !kept.contains(k) {
            kept.push(k)
          }
        }
        FlatSeen::{ keys: keys, shown: shown, stacked: st, kinds: kinds_of(keys), kept: kept, kept_kinds: kinds_of(kept) }
      })
    }
    let seen = signals::signal(seen_now(), same=fn(a, b) { a == b })
    // (which entries show, told the frame as the stack stands whole: what is kept for one shown is that one's)
    s.reacts(fn() { seen.get().shown }, shown)
    // (what left the stack held by no node of it, not kept shown: let go of now, as the stack stands whole, once —
    // left while no node held it: the stack not shown, or before it was)
    // (what left the stack held by a node of it and kept shown in place by none: put by on the kept left where that
    // keeps it, before the stack is seen anew, so that its node is put by in the same change as its entry leaves what
    // shows, never let go first)
    let gone_kept = fn() {
      if nav.keeps_left is Option::None {
        return
      }
      let keep = mbt_compat::arr_filter(nav.gone, fn(e) {
        held.contains(e.serial) && !(nav.flat_kept_entry() is Some(kept) && kept.serial == e.serial)
      })
      for e in keep {
        match arr_search_by(nav.gone, fn(g) { g.serial == e.serial }) {
          Some(i) => {
            mbt_compat::arr_remove(nav.gone, i) |> ignore
            if !nav.try_park_left(e) {
              nav.gone.push(e)
            }
          }
          Option::None => ()
        }
      }
    }
    let gone_free = fn() {
      let free = mbt_compat::arr_filter(nav.gone, fn(e) {
        !held.contains(e.serial) && !(nav.flat_kept_entry() is Some(kept) && kept.serial == e.serial)
      })
      for e in free {
        match arr_search_by(nav.gone, fn(g) { g.serial == e.serial }) {
          Some(i) => mbt_compat::arr_remove(nav.gone, i) |> ignore
          Option::None => ()
        }
        g().forget(e.serial)
        gone(e.serial)
        nav.entry_left(e)
      }
    }
    // (as it is first held: once that change is told whole, its owner's keeping told with it)
    signals::after_flush(fn() {
      if s.alive() {
        signals::untracked(gone_kept)
        signals::untracked(gone_free)
      }
    })
    s.reacts(
      // (what makes it stand anew: the stack told, what may push over it, and what decides which way each is drawn, as
      // `made` reads it: a page's width there, the stack itself told nothing)
      fn() { (nav.said.get(), nav.shown.get(), stacks(), kinds_of(nav.flat_entries())) },
      fn(_) {
        signals::after_flush(fn() {
          if s.alive() {
            signals::untracked(gone_kept)
            seen.set(seen_now())
            signals::untracked(gone_free)
          }
        })
      },
    )
    // (a page put in place, or gone back to one in place, moving: put where it was going, at once, as Ctx::nav_flat)
    s.reacts(
      fn() {
        nav.said.get() |> ignore
        nav.shown.get() |> ignore
        !stacked() && (nav.mode != 0 || nav.leaving is Some(_))
      },
      fn(moving) { if moving { nav.settle() } },
    )
    s.each(
      at_once=true,
      fn() { seen.get().keys },
      fn(k) { k },
      keeps=fn() { seen.get().kept },
      keeps_holds=fn(k) { mbt_compat::arr_iter(nav.pages).any(fn(e) { e.serial == k }) && !nav.waiting_taken_back(k) },
      fn(pv, serial) {
        let k = serial.untracked()
        held.set(k, true)
        let entry = match nav.entry(k) {
          Some(e) => Some(e)
          Option::None => signals::untracked(fn() { nav.flat_kept_entry() })
        }
        let shows = fn() { seen.get().shown.contains(k) }
        pv
        .over(view::Live::Is(true))
        .shift(view::Live::By(fn() {
          if seen.get().stacked {
            nav.shift_of(k, fn() { pv.drawn_at() }, under_parallax=transition.under_parallax)
          } else {
            (0.0, 0.0)
          }
        }), ends=fn() { if signals::untracked(fn() { seen.get().stacked }) { nav.shift_ends_of(k) } else { -1.0 } })
        .presses(view::Live::By(fn() { if seen.get().stacked { nav.takes(k) } else { shows() } }))
        |> ignore
        if transition.rise_under_scale != 1.0 {
          pv
          .scale(
            view::Live::By(fn() {
              if seen.get().stacked {
                nav.rise_scale_of(k, fn() { nav.slide_moment(pv) }, transition.rise_under_scale)
              } else {
                1.0
              }
            }),
            about=view::Pivot::At(0.5, 0.5),
          )
          |> ignore
        }
        let pv_id = pv.id()
        if transition.under_dim > 0.0 || transition.rise_dim > 0.0 || transition.edge_shadow {
          nav_veils.set(pv_id, fn(x, y, w, h, now) {
            if signals::untracked(fn() { seen.get().stacked }) {
              nav.veil_of(k, transition, x, y, w, h, now)
            } else {
              Option::None
            }
          })
        }
        if transition.under_parallax < 1.0 {
          nav_clips.set(pv_id, fn(x, w, now) {
            if signals::untracked(fn() { seen.get().stacked }) {
              nav.clip_of(k, transition, x, w, now)
            } else {
              Option::None
            }
          })
        }
        // (let go as it leaves the stack, not kept shown: what it made forgotten, the app told)
        pv.owns(fn() {
          nav_veils.remove(pv_id)
          nav_clips.remove(pv_id)
          held.remove(k)
          let here = mbt_compat::arr_iter(nav.pages).any(fn(e) { e.serial == k }) ||
          (nav.leaving is Some(e) && e.serial == k) ||
          (nav.flat_kept_entry() is Some(e) && e.serial == k)
          if !here {
            match arr_search_by(nav.gone, fn(e) { e.serial == k }) {
              Some(i) => mbt_compat::arr_remove(nav.gone, i) |> ignore
              Option::None => ()
            }
            g().forget(k)
            gone(k)
            match entry {
              Some(e) => nav.entry_left(e)
              None => ()
            }
          }
        })
        |> ignore
        let draw_for = match page_for { Some(make) => make(pv, k); Option::None => fn(_) { page } }
        // (its old view while it shows; or, where `made` says so of what it is as the stack stood whole (FlatSeen's
        // `kinds`, never the half between a change and its owner's keeping), its nodes made once, as it first shows, and
        // kept while it is held, laid out nowhere while it does not show: as nav_view's)
        pv.pick(at_once=true, fn() {
          let st = seen.get()
          match mbt_compat::arr_search(st.keys, k) {
            Option::Some(i) => st.kinds[i]
            Option::None =>
            match mbt_compat::arr_search(st.kept, k) {
              Option::Some(i) => st.kept_kinds[i]
              Option::None => ""
            }
          }
        }, fn(pb, kind) {
          // (as tall as the stack's room, never as what it holds: what is in it scrolls in that, or is cut to it)
          pb.grow(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_height(view::Live::Is(Some(0.0))) |> ignore
          match signals::untracked(fn() { mbt_compat::opt_map(nav.flat_entry(k), fn(e) { (e, made(e.page)) }) }) {
            Some((e, Some((_, f)))) if kind != "" => {
              let shown = mbt_compat::ref_new(false)
              pb.show(at_once=true, fn() {
                if shows() {
                  shown.v = true
                  e.shown_once = true
                  e.taken_back = false
                }
                shown.v
              }, fn(m) {
                m
                .basis(view::Live::Is(Some(0.0)))
                .min_height(view::Live::Is(Some(0.0)))
                |> ignore
                // (back the stack's while it is pushed over the page in place and on the stack, down to that page)
                let floor = fn() { if takes_back() && stacks() { nav.over_floor() } else { nav.pages.length() } }
                let when = fn() { seen.get().stacked && nav.entry(k) is Some(_) }
                match head {
                  Some(h) => nav.made(m, k, e, f, bg, edge, floor=floor, when=when, head=fn(o) { h(o, k, true) })
                  Option::None => nav.made(m, k, e, f, bg, edge, floor=floor, when=when)
                }
              })
            }
            _ =>
            pb.show(at_once=true, shows, fn(b) {
              b.grow(view::Live::Is(1.0)) |> ignore
              let draw_page = draw_for(b)
              let key = fn() {
                match entry {
                  Some(e) => {
                    let said = mbt_compat::ref_new("")
                    nav.built_by(e, fn() { said.v = page_key(e.page) })
                    said.v
                  }
                  None => ""
                }
              }
              let island = fn() {
                old(b, fn(c) {
                  // (back the stack's down to the page in place, where it is the stack's now)
                  nav.floor = if takes_back() && stacks() { nav.over_floor() } else { nav.pages.length() }
                  if seen.get().stacked && nav.entry(k) is Some(_) {
                    // (under what the frame puts over it, the stack's back that node's: below)
                    nav.page_built(c, k, draw_page, if head is Some(_) { 0L } else { bg() }, edge, stack=head is Option::None)
                  } else {
                    // (in place: built as Ctx::nav_flat builds it, all of its room, cut to it, no back of the stack's; on the
                    // stack, or kept shown though it left it)
                    nav.said.get() |> ignore
                    let e = match nav.entry(k) {
                      Some(e) => Some(e)
                      Option::None => mbt_compat::opt_filter(nav.flat_kept_entry(), fn(e) { e.serial == k })
                    }
                    match e {
                      Some(e) =>
                      c.box(style=if head is Some(_) { flat_in_place } else { flat_in_place.then(style(bg=Data(bg()))) }, fn() {
                        let (owner, stint) = (c.owner, c.stint)
                        c.owner = e.serial
                        c.stint = e.stint
                        nav.built_by(e, fn() { c.scope_(e.serial, fn() { draw_page(c, e.page) }) })
                        c.owner = owner
                        c.stint = stint
                      })
                      |> ignore
                      _ => ()
                    }
                  }
                }, key=key, loc="nav_flat_view.pion:460:21")
                .grow(.Is(1.0))
                |> ignore
              }
              match head {
                // (what the frame puts over the page's own, its nodes the tree's, laid over it (a panel's bar: its room the
                // page's own to leave as it is built, so nothing of it moves as the bar is told what it shows); the page's
                // ground under both, as the page's own was under what it held; the stack's back over the whole of both, as a
                // page made once has it, where it is the stack's: Nav::backs_over)
                // (what the frame puts over the page's own, its nodes the tree's, laid over it (a panel's bar: its room the
                // page's own to leave as it is built, so nothing of it moves as the bar is told what it shows); the page's
                // ground under both, as the page's own was under what it held; the stack's back over the whole of both, as a
                // page made once has it, where it is the stack's: Nav::backs_over)
                Some(h) => {
                  b.ground(view::Live::By(bg)) |> ignore
                  let floor = fn() { if takes_back() && stacks() { nav.over_floor() } else { nav.pages.length() } }
                  nav.backs_over(b, k, edge, floor=floor, when=fn() { seen.get().stacked && nav.entry(k) is Some(_) }, fn() {
                    island()
                    b.box(fn(o) {
                      o.over(view::Live::Is(true)) |> ignore
                      h(o, k, false)
                    })
                    |> ignore
                  })
                }
                Option::None => island()
              }
            })
          }
        })
      },
    )
  })
}

///|
