      Option::None => mbt_compat::MbtJson::null()
    }
    let obj : mbt_compat::OrderedMap[String, mbt_compat::MbtJson] = mbt_compat::ordered_map_from_array([("ref_id", mbt_compat::MbtJson::string(e.ref_id)), ("role", mbt_compat::MbtJson::string((e.role).to_string())), ("label", mbt_compat::MbtJson::string(e.label)), ("description", mbt_compat::MbtJson::string(e.description)), ("value", mbt_compat::MbtJson::string(e.value)), ("redacted", mbt_compat::MbtJson::boolean(e.redacted)), ("check", check_json), ("expanded", agent_opt_bool_json(e.expanded)), ("selected", agent_opt_bool_json(e.selected)), ("pressed", agent_opt_bool_json(e.pressed)), ("disabled", mbt_compat::MbtJson::boolean(e.disabled)), ("range", range_json), ("confirm", agent_opt_string_json(e.confirm)), ("actions", mbt_compat::MbtJson::array(mbt_compat::arr_map(e.actions, mbt_compat::MbtJson::string))), ("source", mbt_compat::MbtJson::string(e.source))])
    arr.push(mbt_compat::MbtJson::object(obj))
