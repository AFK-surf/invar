        Option::None => best = Some((cid, reason))
        Some((prev_id, _)) => if tree.holds(prev_id, cid) { best = Some((cid, reason)) }
      }
    }
  }, None => break } } }
  match best {
    Some((_, reason)) => Some(reason)
    Option::None => Option::None
  }
}

///|
