///|
fn agent_action_name(action : AgentAction) -> String {
  match action {
    AgentAction::Press => "press"
    AgentAction::Focus => "focus"
    AgentAction::Increment => "increment"
    AgentAction::Decrement => "decrement"
    AgentAction::SetValue(_) => "set_value"
  }
}

///|
fn agent_push_unique(arr : Array[String], item : String) -> Unit {
  if !arr.contains(item) {
    arr.push(item)
  }
}

///|
fn agent_tree_moment(tree : view::Tree) -> Double {
  match tree.moment() {
    Some(m) => m
    Option::None =>
    match view_app.v {
      Some(_) => view_moment()
      Option::None => 0.0
    }
  }
}

///|
/// Snapshot all agent-visible controls in `tree`, skipping hidden, modal-occluded, and `agent_hidden` subtrees,
/// redacting `agent_secret` values, and inheriting the nearest `agent_confirm` reason.
pub fn agent_snapshot(tree : view::Tree) -> Array[AgentEntry] {
  let out : Array[AgentEntry] = []
  for sn in tree.said_order() {
    if sn.hidden || !sn.allowed {
      continue
    }
    guard sn.said is Some(s) else { continue }
    if agent_is_hidden(tree, sn.id) {
      continue
    }
    let label = if s.label != "" || !s.role.named_by_held() {
      s.label
    } else {
      tree.words_within(sn.id, fn(_) { "" })
    }
    let redacted = agent_is_secret(tree, sn.id)
    let value = if redacted { "[redacted]" } else { s.value }
    let confirm = agent_confirm_of(tree, sn.id)
    let actions : Array[String] = []
    if !sn.disabled {
      if tree.presses_do(sn.id) || s.actions.contains(view::Action::Activate) {
        agent_push_unique(actions, "press")
      }
      if tree.can_focus(sn.id) || s.actions.contains(view::Action::Focus) {
        agent_push_unique(actions, "focus")
      }
      if s.actions.contains(view::Action::Increment) || (s.role == view::Role::Slider && s.range is Some(_)) {
        agent_push_unique(actions, "increment")
      }
      if s.actions.contains(view::Action::Decrement) || (s.role == view::Role::Slider && s.range is Some(_)) {
        agent_push_unique(actions, "decrement")
      }
      let has_set_text = mbt_compat::arr_iter(s.actions).any(fn(a) { a is .SetText(_) })
      if agent_writers.contains(sn.id) || tree_fields.contains(sn.id) || has_set_text {
        agent_push_unique(actions, "set_value")
      }
    }
    let source = match tree.sources_of(sn.id) {
      __mbt_ap_2 if __mbt_ap_2.length() >= 1 && (match __mbt_ap_2[0] { first => true, _ => false }) => match __mbt_ap_2[0] { first => if first.made_for != "" { first.made_for } else { first.made }, _ => panic("unreachable") }
      __mbt_ap_3 if __mbt_ap_3.length() == 0 => ""
      _ => panic("unreachable")
    }
    out.push(AgentEntry::{
      ref_id: agent_ref_id(sn.id),
      node_id: sn.id,
      role: s.role,
      label: label,
      description: if redacted { "" } else { s.description },
      value: value,
      redacted: redacted,
      check: s.check,
      expanded: s.expanded,
      selected: s.selected,
      pressed: s.pressed,
      disabled: sn.disabled,
      range: s.range,
      confirm: confirm,
      actions: actions,
      source: source,
    })
  }
  out
}

///|
fn agent_find_within(entries : Array[AgentEntry], within : String) -> Array[view::NodeId] {
  for e in entries {
    if e.ref_id == within {
      return [e.node_id]
    }
  }
  let needle = agent_ascii_lower(within)
  let exact : Array[view::NodeId] = []
  for e in entries {
    if agent_ascii_lower(e.label) == needle {
      exact.push(e.node_id)
    }
  }
  if !exact.is_empty() {
    return exact
  }
  let sub : Array[view::NodeId] = []
  for e in entries {
    if agent_ascii_lower(e.label).contains(needle) {
      sub.push(e.node_id)
    }
  }
  sub
}

///|
/// Query visible controls in `tree` by case-insensitive `text` (matching label, description, or non-redacted value),
/// optional `role`, and optional ancestor `within` (`ref_id` or label).
pub fn agent_query(tree : view::Tree, text? : String, role? : view::Role, within? : String) -> Array[AgentEntry] {
  let text = match text { Some(__mbt_v) => __mbt_v, None => "" }
  let within = match within { Some(__mbt_v) => __mbt_v, None => "" }

  let entries = agent_snapshot(tree)
  let scopes : Option[Array[view::NodeId]] = if within == "" {
    Option::None
  } else {
    let found = agent_find_within(entries, within)
    if found.is_empty() {
      return []
    }
    Some(found)
  }
  let needle = agent_ascii_lower(text)
  let out : Array[AgentEntry] = []
  for e in entries {
    match scopes {
      Some(ws) => {
        let mut inside = false
        for w in ws {
          if tree.holds(w, e.node_id) {
            inside = true
            break
          }
        }
        if !inside {
          continue
        }
      }
      Option::None => ()
    }
    match role {
      Some(r) if e.role != r => continue
      _ => ()
    }
    if needle != "" {
      let hit_label = agent_ascii_lower(e.label).contains(needle)
      let hit_desc = agent_ascii_lower(e.description).contains(needle)
      let hit_val = !e.redacted && agent_ascii_lower(e.value).contains(needle)
      if !hit_label && !hit_desc && !hit_val {
        continue
      }
    }
    out.push(e)
  }
  out
}

///|
fn agent_resolve_target(entries : Array[AgentEntry], target : String) -> Result[AgentEntry, AgentActError] {
  if target == "" {
    return Err(AgentActError::NotFound(""))
  }
  for e in entries {
    if e.ref_id == target {
      return Ok(e)
    }
  }
  let exact : Array[AgentEntry] = []
  for e in entries {
    if e.label == target {
      exact.push(e)
    }
  }
  if exact.length() == 1 {
    return Ok(exact[0])
  }
  if exact.length() > 1 {
    return Err(AgentActError::Ambiguous(mbt_compat::arr_map(exact, fn(e) { e.ref_id })))
  }
  let needle = agent_ascii_lower(target)
  let ci_exact : Array[AgentEntry] = []
  for e in entries {
    if agent_ascii_lower(e.label) == needle {
      ci_exact.push(e)
    }
  }
  if ci_exact.length() == 1 {
    return Ok(ci_exact[0])
  }
  if ci_exact.length() > 1 {
    return Err(AgentActError::Ambiguous(mbt_compat::arr_map(ci_exact, fn(e) { e.ref_id })))
  }
  if needle != "" {
    let sub : Array[AgentEntry] = []
    for e in entries {
      if agent_ascii_lower(e.label).contains(needle) {
        sub.push(e)
      }
    }
    if sub.length() == 1 {
      return Ok(sub[0])
    }
    if sub.length() > 1 {
      return Err(AgentActError::Ambiguous(mbt_compat::arr_map(sub, fn(e) { e.ref_id })))
    }
  }
  Err(AgentActError::NotFound(target))
}

///|
fn agent_refetch(tree : view::Tree, fallback : AgentEntry) -> AgentEntry {
  for e in agent_snapshot(tree) {
    if e.node_id == fallback.node_id {
      return e
    }
  }
  fallback
}

///|
fn agent_mark_frame_owed(tree : view::Tree) -> Unit {
  match view_app.v {
    Some(vt) if physical_equal(vt, tree) => h_frame_owed()
    _ => ()
  }
}

///|
/// Execute one `AgentStep` on `tree` with ambiguity checks, disabled/action validation, and `agent_confirm` gating.
pub fn agent_act(tree : view::Tree, step : AgentStep, allow? : (AgentApproval) -> Bool) -> Result[AgentEntry, AgentActError] {
  let entries = agent_snapshot(tree)
  let entry = match agent_resolve_target(entries, step.target) {
    Ok(e) => e
    Err(err) => return Err(err)
  }
  if entry.disabled {
    return Err(AgentActError::Disabled(entry.ref_id))
  }
  let action_name = agent_action_name(step.action)
  if !entry.actions.contains(action_name) {
    return Err(AgentActError::UnsupportedAction("\{entry.ref_id}: \{action_name}"))
  }
  match entry.confirm {
    Some(reason) => {
      let approved = match allow {
        Some(f) => f(AgentApproval::{ entry: entry, action: step.action, reason: reason })
        Option::None => false
      }
      if !approved {
        return Err(AgentActError::NeedsConfirm(reason))
      }
    }
    None => ()
  }
  let at = agent_tree_moment(tree)
  // INVAR-EXT: attribute agent_act as a root Fact when ui::causal_ring() is enabled
  // (guarding before string concat / closure allocation for true zero overhead when disabled;
  // never logs SetValue payloads).
  let ok = if ui_causal_ring_inst.is_enabled() {
    ui_causal_ring_inst.with_fact(
      causal::FactKind::Input,
      entry.ref_id,
      "agent_act:" + action_name,
      at_ms=at.to_int64(),
      fn(_cid : causal::CauseId) -> Bool {
        agent_run_step_action(tree, entry, step.action, at)
      },
    )
  } else {
    agent_run_step_action(tree, entry, step.action, at)
  }
  if !ok {
    return Err(AgentActError::UnsupportedAction("\{entry.ref_id}: \{action_name}"))
  }
  Ok(agent_refetch(tree, entry))
}

///|
/// Execute a sequence of `AgentStep`s on `tree`, stopping immediately at the first `Err`.
pub fn agent_act_all(tree : view::Tree, steps : Array[AgentStep], allow? : (AgentApproval) -> Bool) -> Array[Result[AgentEntry, AgentActError]] {
  let out : Array[Result[AgentEntry, AgentActError]] = []
  for step in steps {
    let res = match allow {
      Some(f) => agent_act(tree, step, allow=f)
      Option::None => agent_act(tree, step)
    }
    out.push(res)
    if res is Err(_) {
      break
    }
  }
  out
}

///|
/// Convenience `Tester` wrapper for `agent_snapshot`.
pub fn Tester::agent_snapshot(self : Tester) -> Array[AgentEntry] {
  self.reads_own()
  match view_tree() {
    Some(tree) => agent_snapshot(tree)
    Option::None => []
  }
}

///|
/// Convenience `Tester` wrapper for `agent_query`.
pub fn Tester::agent_query(self : Tester, text? : String, role? : view::Role, within? : String) -> Array[AgentEntry] {
  let text = match text { Some(__mbt_v) => __mbt_v, None => "" }
  let within = match within { Some(__mbt_v) => __mbt_v, None => "" }

  self.reads_own()
  match view_tree() {
    Some(tree) => agent_query(tree, text=text, role?=role, within=within)
    Option::None => []
  }
}

///|
/// Convenience `Tester` wrapper for `agent_act`; advances one frame with `self.draw()` when the action succeeds.
pub fn Tester::agent_act(self : Tester, step : AgentStep, allow? : (AgentApproval) -> Bool) -> Result[AgentEntry, AgentActError] {
  self.reads_own()
  guard view_tree() is Some(tree) else { return Err(AgentActError::NotFound(step.target)) }
  let res = match allow {
    Some(f) => agent_act(tree, step, allow=f)
    Option::None => agent_act(tree, step)
  }
  match res {
    Ok(entry) => {
      self.draw()
      Ok(agent_refetch(tree, entry))
    }
    Err(_) => res
  }
}

///|
fn agent_opt_bool_json(v : Option[Bool]) -> mbt_compat::MbtJson {
  match v {
    Some(b) => mbt_compat::MbtJson::boolean(b)
    Option::None => mbt_compat::MbtJson::null()
  }
}

///|
fn agent_opt_string_json(v : Option[String]) -> mbt_compat::MbtJson {
  match v {
    Some(s) => mbt_compat::MbtJson::string(s)
    Option::None => mbt_compat::MbtJson::null()
  }
}

