// Comprehensive unit tests for W1 UI runtime parity:
// - D1: Between-frame external message delivery, answered_from_outside deferral, on_frame_take/wake_frame, FrameOutbox[T], app_said/app_tell
// - D2: Fine-grained reactive host_said signals and host command wrappers
// - D3: NativeView, Stream, NativeTerminal, and Multi-Window tree lifecycle with zero handle leaks

import "hostapi"
import "pixels"
import "signals"
import "text"
import "view"

test "d1: post_at delivers external messages at exact timestamp and draws that frame across 60/120/24/7 fps" {
  let diffs = check_fps_matrix(fn(rate : Double) -> String {
    let status = signals::signal("idle")
    let received_at : signals::Ref[Double] = ref_new(-1.0)
    let received_bytes : signals::Ref[Int] = ref_new(0)
    on_message("core.updates", fn(json : String, bytes : Option[Bytes]) -> Unit {
      status.set(json)
      received_at.v = hostapi::now()
      match bytes {
        Some(b) => received_bytes.v = b.length()
        None => received_bytes.v = 0
      }
    })
    let t = Tester::tree(
      fn(root : view::View) {
        let _ = root.words(view::Live::By(fn() { status.get() }), look=view::words_plain)
      },
      fps=rate,
    )
    t.post_at(50.0, "core.updates", "ready-50ms", bytes="BIN4".to_bytes())
    t.run_shown(50.0)
    debug_assert(t.unasked_faults().length() == 0, "no unasked faults on post_at")
    debug_assert(received_at.v == 50.0, "post_at must deliver at exact timestamp 50ms")
    debug_assert(received_bytes.v == 4, "post_at must preserve binary payload")
    debug_assert(t.find("ready-50ms").is_some(), "frame at 50ms must draw updated message state")
    let out = "\{status.untracked()}@\{received_at.v.to_int()}:\{received_bytes.v}"
    t.dispose()
    out
  })
  debug_assert(diffs.length() == 0, "post_at must produce identical results across 60/120/24/7 fps")
}

test "d1: on_message_said fast path and on_messages_ahead batch inspection" {
  let ahead_seen : signals::Ref[Int] = ref_new(0)
  let fast_hits : signals::Ref[Int] = ref_new(0)
  let fallback_hits : signals::Ref[Int] = ref_new(0)
  on_messages_ahead("chan.fast", fn(batch : Array[Option[(String, Option[Bytes])]]) -> Unit {
    ahead_seen.v = batch.length()
  })
  on_message_said("chan.fast", fn(json : String, _b : Option[Bytes]) -> Bool {
    if json == "fast" {
      fast_hits.v = fast_hits.v + 1
      true
    } else {
      false
    }
  })
  on_message("chan.fast", fn(_json : String, _b : Option[Bytes]) -> Unit {
    fallback_hits.v = fallback_hits.v + 1
  })
  debug_assert(message_said_on("chan.fast"), "message_said_on reports registered channel")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(_b : view::View) { () })
  })
  t.post("chan.fast", "fast")
  t.post("chan.fast", "slow")
  debug_assert(t.post_wakes() == 1, "multiple posts before frame coalesce to 1 wake")
  t.frame(ms=16.0)
  debug_assert(ahead_seen.v == 2, "on_messages_ahead sees full batch")
  debug_assert(fast_hits.v == 1, "on_message_said handles fast message")
  debug_assert(fallback_hits.v == 1, "unhandled message falls through to on_message")
  debug_assert(t.messages_taken() == 2, "messages_taken counts both fast and fallback messages")
  t.dispose()
}

test "d1: answered_from_outside defers via signals::after_computing when called inside computed" {
  let base_links = signals::live_link_count()
  let base_nodes = signals::live_node_count()
  let src = signals::signal(1)
  let side = signals::signal(10)
  let trace : Array[String] = []
  let comp = signals::computed(fn(_prev : Option[Int]) -> Int {
    let v = src.get()
    trace.push("compute:\{v}:side=\{side.untracked()}")
    if v == 2 {
      answered_from_outside(fn() -> Unit {
        trace.push("deferred:set_side_20")
        side.set(20)
      })
      // Must NOT have mutated `side` re-entrantly while still inside computed!
      debug_assert(side.untracked() == 10, "answered_from_outside must defer until computed finishes")
    }
    v * 100 + side.untracked()
  })
  debug_assert(comp.get() == 110, "initial computed value")
  src.set(2)
  let v2 = comp.get()
  debug_assert(v2 == 210, "computed reads clean pre-defer value without re-entrant dirty read")
  debug_assert(side.untracked() == 20, "deferred outside answer ran immediately after computed finished")
  debug_assert(trace.length() == 3 && trace[2] == "deferred:set_side_20", "deferred callback executed after compute")
  // A computed read outside any subscriber keeps its node and its link to `src`
  // until disposed; release them so tests sharing this process start clean.
  comp.dispose()
  debug_assert(signals::live_link_count() == base_links, "computed dispose releases its link: \{signals::live_link_count()} != \{base_links}")
  debug_assert(signals::live_node_count() == base_nodes, "computed dispose releases its nodes: \{signals::live_node_count()} != \{base_nodes}")
}

test "d1: on_frame_take, wake_frame coalescing, FrameOutbox[T], and app_said/app_tell" {
  let outbox : FrameOutbox[Int] = FrameOutbox::new()
  let received : Array[Int] = []
  let take_runs : signals::Ref[Int] = ref_new(0)
  let label = signals::signal("empty")

  let t = Tester::tree(fn(root : view::View) {
    let _ = root.words(view::Live::By(fn() { label.get() }), look=view::words_plain)
  })
  outbox.bind(
    fn(batch : Array[Int]) -> Unit {
      take_runs.v = take_runs.v + 1
      for x in batch {
        received.push(x)
      }
      label.set("got:\{received.length()}")
    },
    most=2,
  )

  let wakes_before = t.fake.wake_count
  outbox.tell(10)
  outbox.tell(20)
  outbox.tell(30)
  wake_frame()
  wake_frame()
  debug_assert(outbox.wakes() == 1, "3 tells coalesce to 1 outbox wake")
  debug_assert(t.fake.wake_count == wakes_before + 1, "multi-source wake_frame coalesces to 1 host wake")
  debug_assert(outbox.waiting() == 3, "3 items waiting before frame")

  // Frame 1 takes 2 items (bounded by most=2) and automatically requests next frame for the 3rd
  t.frame(ms=16.0)
  debug_assert(take_runs.v == 1, "first frame ran on_frame_take once")
  debug_assert(received.length() == 2 && received[0] == 10 && received[1] == 20, "FIFO order preserved")
  debug_assert(outbox.waiting() == 1, "1 item remains after bounded take")
  debug_assert(outbox.wakes() == 2, "remaining item re-woke next frame")

  // Frame 2 drains the remaining item
  t.frame(ms=16.0)
  debug_assert(take_runs.v == 2, "second frame drained remainder")
  debug_assert(received.length() == 3 && received[2] == 30, "third item delivered")
  debug_assert(outbox.waiting() == 0, "outbox empty")
  debug_assert(t.find("got:3").is_some(), "UI rendered updated signal from FrameOutbox")

  // app_said / app_tell thin wrappers
  t.fake.app_said_map["version"] = "2.5.0"
  debug_assert(app_said("version") == "2.5.0", "app_said reads host property")
  app_tell("ping", "ok")
  debug_assert(t.fake.app_tells.length() == 1 && t.fake.app_tells[0].0 == "ping", "app_tell forwards to host")
  t.dispose()
}

test "d2: host_said fine-grained reactivity isolates dark, inset, font_scale without waking unrelated nodes" {
  let dark_evals : signals::Ref[Int] = ref_new(0)
  let inset_evals : signals::Ref[Int] = ref_new(0)
  let scale_evals : signals::Ref[Int] = ref_new(0)
  let unrelated_evals : signals::Ref[Int] = ref_new(0)

  let t = Tester::tree(fn(root : view::View) {
    let _ = root.align_items(view::Along::Start)
    let _ = root.box(fn(b : view::View) {
      let _ = b.words(
        view::Live::By(fn() {
          dark_evals.v = dark_evals.v + 1
          if system_dark_now() { "DARK" } else { "LIGHT" }
        }),
        look=view::words_plain,
      )
    })
    let _ = root.box(fn(b : view::View) {
      let _ = b.words(
        view::Live::By(fn() {
          inset_evals.v = inset_evals.v + 1
          if window_inset_now() { "INSET" } else { "FLAT" }
        }),
        look=view::words_plain,
      )
    })
    let _ = root.box(fn(b : view::View) {
      let _ = b.words(
        view::Live::By(fn() {
          scale_evals.v = scale_evals.v + 1
          "SCALE:\{(font_scale_now() * 10.0).round().to_int()}"
        }),
        look=view::words_plain,
      )
    })
    let _ = root.box(fn(b : view::View) {
      let _ = b.words(
        view::Live::By(fn() {
          unrelated_evals.v = unrelated_evals.v + 1
          "STATIC"
        }),
        look=view::words_plain,
      )
    })
  })
  let d0 = dark_evals.v
  let i0 = inset_evals.v
  let s0 = scale_evals.v
  let u0 = unrelated_evals.v

  // Toggle dark mode -> only dark_evals increments
  t.fake.dark_mode = true
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(dark_evals.v == d0 + 1, "dark node re-evaluated on dark_mode change")
  debug_assert(inset_evals.v == i0, "inset node untouched by dark_mode change")
  debug_assert(scale_evals.v == s0, "scale node untouched by dark_mode change")
  debug_assert(unrelated_evals.v == u0, "unrelated node untouched by dark_mode change")

  // Toggle window_inset -> only inset_evals increments
  t.fake.window_inset_flag = true
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(dark_evals.v == d0 + 1, "dark node untouched by inset change")
  debug_assert(inset_evals.v == i0 + 1, "inset node re-evaluated on window_inset change")
  debug_assert(scale_evals.v == s0, "scale node untouched by inset change")
  debug_assert(unrelated_evals.v == u0, "unrelated node untouched by inset change")

  // Measure text width before and after set_font_scale(Some(1.5))
  let mut w_before = 0.0
  for d in t.drawn() {
    if d.words == "STATIC" {
      w_before = d.w
    }
  }
  set_font_scale(Some(1.5))
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(scale_evals.v == s0 + 1, "scale node re-evaluated on font_scale change")
  debug_assert(unrelated_evals.v == u0, "unrelated node signal binding not re-evaluated")
  let mut w_after = 0.0
  for d in t.drawn() {
    if d.words == "STATIC" {
      w_after = d.w
    }
  }
  debug_assert(w_after > w_before * 1.3, "set_font_scale must trigger text re-measurement with larger width")
  set_font_scale(None)
  t.dispose()
}

/// Horizontal span of the glyph quads (kind 1 mono / 3 colour / 7 adaptive) drawn inside `d`'s box.
fn glyph_span_in(sc : Scene, d : view::Drawn) -> Double {
  let mut lo = 1.0e9
  let mut hi = -1.0e9
  let mut k = 0
  while k < sc.ninst {
    let b = k * inst_size
    let kind = sc.inst[b + 5]
    let gy = sc.inst[b + 1] + sc.inst[b + 3] * 0.5
    if (kind == 1.0 || kind == 3.0 || kind == 7.0) && gy >= d.y && gy <= d.y + d.h {
      let gx = sc.inst[b]
      if gx >= d.x - 1.0 && gx <= d.x + d.w + 1.0 {
        if gx < lo {
          lo = gx
        }
        if gx > hi {
          hi = gx
        }
      }
    }
    k += 1
  }
  if hi >= lo { hi - lo } else { 0.0 }
}

fn drawn_named(t : Tester, name : String) -> Option[view::Drawn] {
  for d in t.drawn() {
    if d.words == name || (d.runs.length() > 0 && d.runs[0].text == name) {
      return Some(d)
    }
  }
  None
}

test "d2: set_font_scale scales drawn glyphs with the measured box (words, runs, fixed-width ViewBlock)" {
  set_view_blocks_enabled(true)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.align_items(view::Along::Start)
    let _ = root.box(fn(b : view::View) {
      let _ = b.words(view::Live::Is("PLAINWORDS"), look=view::words_plain)
    })
    let _ = root.box(fn(b : view::View) {
      let run = text::plain("RICHRUNS")
      let _ = b.words_runs(view::Live::Is([run]), ink=0x111111FFL, look=view::words_plain)
    })
    let _ = root.box(fn(b : view::View) {
      // Fixed width and height: only the font-size cache key can tell its ViewBlock is stale.
      let _ = b
      .width(view::Live::Is(Some(400.0)))
      .height(view::Live::Is(Some(40.0)))
      .words(view::Live::Is("FIXEDWIDTH"), look=view::words_plain)
    })
  })
  t.resize(640.0, 480.0)
  t.frame(ms=16.0)
  let names = ["PLAINWORDS", "RICHRUNS", "FIXEDWIDTH"]
  let before_w : Array[Double] = []
  let before_span : Array[Double] = []
  for name in names {
    match drawn_named(t, name) {
      Some(d) => {
        before_w.push(d.w)
        before_span.push(glyph_span_in(t.scene(), d))
      }
      None => debug_assert(false, "missing drawn node " + name)
    }
  }
  set_font_scale(Some(1.5))
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  let mut i = 0
  for name in names {
    match drawn_named(t, name) {
      Some(d) => {
        let span = glyph_span_in(t.scene(), d)
        debug_assert(before_span[i] > 0.0, name + ": glyphs drawn before scaling")
        if name != "FIXEDWIDTH" {
          debug_assert(d.w > before_w[i] * 1.3, name + ": measured width grows with font scale")
        }
        let ratio = span / before_span[i]
        debug_assert(ratio > 1.45 && ratio < 1.55, name + ": drawn glyph span must grow 1.5x with font scale, got \{ratio}")
      }
      None => debug_assert(false, "missing drawn node " + name)
    }
    i += 1
  }
  set_font_scale(None)
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  i = 0
  for name in names {
    match drawn_named(t, name) {
      Some(d) => {
        let ratio = glyph_span_in(t.scene(), d) / before_span[i]
        debug_assert((ratio - 1.0).abs() < 0.01, name + ": glyph span returns to 1x after set_font_scale(None)")
      }
      None => ()
    }
    i += 1
  }
  t.dispose()
}

test "d2: host_said covers all 12 environment signals and host command wrappers" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(_b : view::View) { () })
  })
  t.fake.window_inset_flag = true
  t.fake.window_zoomed_flag = true
  t.fake.window_snap_state_val = 2
  t.fake.dark_mode = true
  t.fake.font_scale_val = 1.25
  t.fake.a11y_enabled = true
  t.fake.reduce_motion_flag = true
  t.fake.reduce_transparency_flag = true
  t.fake.increase_contrast_flag = true
  t.fake.app_visible_flag = false
  t.fake.full_screen_flag = true
  t.fake.frame_requested = true
  t.frame(ms=16.0)

  debug_assert(window_inset_now(), "window_inset_now")
  debug_assert(window_zoomed_now(), "window_zoomed_now")
  debug_assert(window_snap_state_now() == 2, "window_snap_state_now")
  debug_assert(system_dark_now(), "system_dark_now")
  debug_assert((font_scale_now() - 1.25).abs() < 1.0e-6, "font_scale_now")
  debug_assert(reads_out_now(), "reads_out_now")
  debug_assert(reduced_motion_now(), "reduced_motion_now")
  debug_assert(glass_solid_now(), "glass_solid_now")
  debug_assert(more_contrast_now(), "more_contrast_now")
  debug_assert(!app_visible_now(), "app_visible_now")
  debug_assert(full_screen_now(), "full_screen_now")

  // System channel: bars + foldable tabletop pose
  t.post(
    hostapi::system_channel,
    "{\"bars\":{\"top\":44,\"bottom\":34,\"left\":0,\"right\":0},\"fold\":{\"hinge\":\"half\",\"divisions\":[{\"x\":0,\"y\":280,\"w\":800,\"h\":24}]}}",
  )
  t.frame(ms=16.0)
  let bars = system_bars()
  debug_assert(bars.top == 44.0 && bars.bottom == 34.0, "system_bars updated from system channel")
  match system_tabletop_now() {
    Some((y0, y1)) => debug_assert(y0 == 280.0 && y1 == 304.0, "system_tabletop_now extracts horizontal hinge band")
    None => debug_assert(false, "expected Some tabletop band for half-open horizontal fold")
  }

  // Host command wrappers
  menu_setup("{\"items\":[]}")
  debug_assert(t.fake.menus_set.length() == 1, "menu_setup forwarded")
  debug_assert(hotkey_set("toggle", "Cmd+Shift+K"), "hotkey_set returns true")
  debug_assert(t.fake.hotkeys.contains("toggle"), "hotkey recorded")
  hotkey_clear("toggle")
  debug_assert(!t.fake.hotkeys.contains("toggle"), "hotkey cleared")
  set_badge(7)
  debug_assert(t.fake.badge_count == 7, "set_badge forwarded")
  debug_assert(open_url("https://example.com"), "open_url returns true")
  debug_assert(t.fake.opened_urls.length() == 1 && t.fake.opened_urls[0] == "https://example.com", "open_url recorded")
  t.dispose()
}

test "d3: native_view_node, stream_view_node, and native_terminal_node lifecycle with zero handle leaks" {
  let mounted = signals::signal(true)
  let box_w = signals::signal(320.0)
  let box_h = signals::signal(160.0)
  let nv_ref : signals::Ref[Option[NativeView]] = ref_new(None)
  let st_ref : signals::Ref[Option[Stream]] = ref_new(None)
  let tm_ref : signals::Ref[Option[NativeTerminal]] = ref_new(None)
  let stream_acks : Array[Double] = []

  let t = Tester::tree(fn(root : view::View) {
    let _ = root.show(fn() { mounted.get() }, fn(host : view::View) {
      let _ = native_view_node(
        host,
        1,
        arg="https://example.org",
        on_ready=fn(nv : NativeView) { nv_ref.v = Some(nv) },
      )
      .width(view::Live::By(fn() { Some(box_w.get()) }))
      .height(view::Live::By(fn() { Some(box_h.get()) }))

      let st = Stream::new(
        shown=fn(ts : Double) { stream_acks.push(ts) },
        broken=fn() { () },
      )
      st_ref.v = Some(st)
      let _ = stream_view_node(host, st)
      .width(view::Live::Is(Some(320.0)))
      .height(view::Live::Is(Some(180.0)))

      let term = NativeTerminal::open(cols=40, rows=10, cell_w=8, cell_h=16)
      tm_ref.v = Some(term)
      let _ = native_terminal_node(host, term, cell_w=8.0, cell_h=16.0)
      .width(view::Live::By(fn() { Some(box_w.get()) }))
      .height(view::Live::By(fn() { Some(box_h.get()) }))
    })
  })

  // Verify mount created all 3 handles
  debug_assert(t.fake.open_view_ids.length() == 1, "1 native view open after mount")
  debug_assert(t.fake.open_stream_ids.length() == 1, "1 stream open after mount")
  debug_assert(t.fake.open_term_ids.length() == 1, "1 terminal open after mount")

  // Drive native tell, stream frame + decode ok + pointer, terminal write
  match nv_ref.v {
    Some(nv) => nv.tell(1, "reload")
    None => debug_assert(false, "native view should be ready")
  }
  match st_ref.v {
    Some(st) => {
      st.frame("KEYFRAME".to_bytes(), true, 16.0)
      st.pointer("arrow", fn() { "PNG".to_bytes() }, 16.0, 16.0, 0.0, 0.0)
      st.pointer_at(40.0, 20.0, true)
      t.fake.stream_push_event(st.id, "ok 320 180 16")
    }
    None => debug_assert(false, "stream should be created")
  }
  match tm_ref.v {
    Some(tm) => tm.write("hello\r\n".to_bytes())
    None => debug_assert(false, "terminal should be created")
  }

  // Resize triggers re-layout: native view placed at new size, terminal resized to 60x15
  box_w.set(480.0)
  box_h.set(240.0)
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(stream_acks.length() == 1 && stream_acks[0] == 16.0, "stream decode ack delivered")
  match tm_ref.v {
    Some(tm) => debug_assert(tm.cols == 60 && tm.rows == 15, "terminal auto-resized to 480/8=60 x 240/16=15")
    None => ()
  }

  // Unmount must close all 3 handles with zero leaks
  mounted.set(false)
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(t.fake.open_view_ids.length() == 0, "native view closed on unmount (zero leak)")
  debug_assert(t.fake.open_stream_ids.length() == 0, "stream closed on unmount (zero leak)")
  debug_assert(t.fake.open_term_ids.length() == 0, "terminal closed on unmount (zero leak)")

  // Verify lifecycle sequence recorded in FakeHost
  let mut saw_view_open = false
  let mut saw_view_place_show = false
  let mut saw_view_tell = false
  let mut saw_view_close = false
  let mut saw_st_show = false
  let mut saw_st_pointer = false
  let mut saw_st_close = false
  let mut saw_tm_resize = false
  let mut saw_tm_close = false
  for entry in t.fake.lifecycle_log {
    if str_has_prefix(entry, "view_open:") { saw_view_open = true }
    if str_has_prefix(entry, "view_place:") && str_contains(entry, ":show:") { saw_view_place_show = true }
    if str_has_prefix(entry, "view_tell:") { saw_view_tell = true }
    if str_has_prefix(entry, "view_close:") { saw_view_close = true }
    if str_has_prefix(entry, "st_show:") { saw_st_show = true }
    if str_has_prefix(entry, "st_pointer:") { saw_st_pointer = true }
    if str_has_prefix(entry, "st_close:") { saw_st_close = true }
    if str_has_prefix(entry, "tm_resize:") && str_contains(entry, "60x15") { saw_tm_resize = true }
    if str_has_prefix(entry, "tm_close:") { saw_tm_close = true }
  }
  debug_assert(saw_view_open && saw_view_place_show && saw_view_tell && saw_view_close, "native view lifecycle complete")
  debug_assert(saw_st_show && saw_st_pointer && saw_st_close, "stream lifecycle complete")
  debug_assert(saw_tm_resize && saw_tm_close, "terminal lifecycle complete")
  t.dispose()
}

test "d3: multi_window isolation builds secondary window trees and cleans up on close" {
  let closed_ids : Array[Int] = []
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.words(view::Live::Is("MainWindow"), look=view::words_plain)
  })
  set_window_tree(fn(_wid : Int, what : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.words(view::Live::Is("Sub:" + what), look=view::words_plain)
    }
  })
  when_window_closed(fn(wid : Int) { closed_ids.push(wid) })
  debug_assert(windows_here(), "in-process multi-window enabled")

  let w1 = window_open_here("inspector")
  let w2 = window_open_here("preview")
  debug_assert(w1 > 0 && w2 > 0 && w1 != w2, "distinct secondary window ids")
  debug_assert(window_tree_of(w1).is_some() && window_tree_of(w2).is_some(), "each window owns its view::Tree")

  // Per-window signal isolation: set glass_solid override only in w1
  in_window(w1, fn() { set_glass_solid(Some(true)) })
  in_window(w2, fn() { set_glass_solid(Some(false)) })
  let mut w1_solid = false
  let mut w2_solid = true
  in_window(w1, fn() { w1_solid = glass_solid() })
  in_window(w2, fn() { w2_solid = glass_solid() })
  debug_assert(w1_solid && !w2_solid, "per-window globals stay isolated across windows")

  // Step frames for secondary windows
  debug_assert(window_frame(w1, 400.0, 300.0, 2.0, 16.0), "window_frame renders w1")
  debug_assert(window_frame(w2, 400.0, 300.0, 2.0, 16.0), "window_frame renders w2")

  window_close_here(w1)
  window_close_here(w2)
  debug_assert(window_tree_of(w1).is_none() && window_tree_of(w2).is_none(), "closed windows dispose trees")
  debug_assert(closed_ids.length() == 2, "window_closed callbacks fired")

  // Host-initiated window close (MB_OUTSIDE_WINDOW = 17) disposes tree and notifies listeners without re-calling close
  let w3 = window_open_here("popup")
  debug_assert(w3 > 0 && window_tree_of(w3).is_some(), "w3 opened with tree")
  debug_assert(window_frame(w3, 320.0, 180.0, 2.0, 32.0), "window_frame renders and presents w3 via view_frame")
  window_closed_by_host(w3)
  debug_assert(window_tree_of(w3).is_none(), "window_closed_by_host disposes tree")
  debug_assert(closed_ids.length() == 3, "window_closed_by_host fires window_closed callback")
  t.dispose()
}

test "take_picture captures offscreen tree bands into a valid PNG and window_front_here delegates to host" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.words(view::Live::Is("Host"), look=view::words_plain)
  })
  // Wire a deterministic software rasterizer onto drawn_pixels_of so we verify instance shifting,
  // banding, pixel scale, and PNG encoding end-to-end.
  let calls : signals::Ref[Int] = ref_new(0)
  let saw_w : signals::Ref[Int] = ref_new(0)
  let saw_h : signals::Ref[Int] = ref_new(0)
  let saw_inst : signals::Ref[Int] = ref_new(0)
  let h = hostapi::host()
  h.drawn_pixels_of = fn(_inst : FixedArray[Double], count : Int, _r : Double, _g : Double, _b : Double, _sc : Double, w : Int, hh : Int, out : FixedArray[Byte]) -> Bool {
    calls.v = calls.v + 1
    saw_w.v = w
    saw_h.v = saw_h.v + hh
    saw_inst.v = count
    let mut i = 0
    while i + 3 < out.length() {
      out[i] = 0x33 as Byte
      out[i + 1] = 0x66 as Byte
      out[i + 2] = 0x99 as Byte
      out[i + 3] = 0xFF as Byte
      i += 4
    }
    true
  }
  let fronted : signals::Ref[Int] = ref_new(0)
  h.window_front_id = fn(wid : Int) -> Bool {
    fronted.v = wid
    wid == 7
  }
  debug_assert(window_front_here(7) && fronted.v == 7, "window_front_here delegates to hostapi::window_front_id")
  debug_assert(!window_front_here(3) && fronted.v == 3, "window_front_here propagates false")
  debug_assert(
    wheel_mod_shift == 1 && wheel_mod_ctrl == 2 && wheel_mod_alt == 4 && wheel_mod_cmd == 8 && wheel_mod_pinch == 16,
    "wheel modifier constants match host bitmask",
  )

  let got_png : signals::Ref[Option[Bytes]] = ref_new(None)
  let nested_hits : signals::Ref[Int] = ref_new(0)
  on_message_said("shot.nested", fn(_json : String, _b : Option[Bytes]) -> Bool {
    nested_hits.v = nested_hits.v + 1
    true
  })
  take_picture(
    "card",
    80.0,
    fn(b : view::View) {
      let _ = b.height(view::Live::Is(Some(40.0))).ground(view::Live::Is(rgba(0x22, 0x44, 0x66, 0xFF)))
    },
    fn(png : Option[Bytes]) {
      got_png.v = png
      t.post("shot.nested", "{\"ok\":true}")
      messages_between()
    },
    scale=2.0,
    dpi=144.0,
  )
  debug_assert(shots_pending(), "take_picture queues a pending shot")
  t.frame(ms=16.0)
  debug_assert(!shots_pending(), "shot completes and disposes after present")
  debug_assert(nested_hits.v == 1, "take_picture done callback runs after frame_running clears so nested messages_between drains")
  debug_assert(calls.v == 1 && saw_w.v == 160 && saw_h.v == 80 && saw_inst.v >= 1, "rendered at 2x scale (160x80)")
  match got_png.v {
    Some(png) => {
      debug_assert(png.length() > 32, "PNG payload is non-empty")
      debug_assert(
        png[0] == (0x89 as Byte) && png[1] == (0x50 as Byte) && png[2] == (0x4E as Byte) && png[3] == (0x47 as Byte),
        "PNG magic header valid",
      )
      match pixels::png_phys(png) {
        Some((x, y, unit)) => debug_assert(x == 5669 && y == 5669 && unit == 1, "take_picture embeds 144 DPI pHYs")
        None => debug_assert(false, "take_picture must embed pHYs when dpi > 0")
      }
    }
    None => debug_assert(false, "take_picture must deliver Some(png)")
  }
  t.dispose()
}

test "image_ready_at and keys_system fallback work on reactive trees" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.words(view::Live::Is("Host"), look=view::words_plain)
  })
  let h = hostapi::host()
  h.platform = fn() -> Int { 3 }
  h.keys_platform = fn() -> Int { -1 }
  debug_assert(keys_system() == 3, "keys_system falls back to platform() when keys_platform() < 0")
  h.keys_platform = fn() -> Int { 0 }
  debug_assert(keys_system() == 0, "keys_system honors explicit keys_platform() >= 0")

  let key = "mem:ready-test"
  add_image(key, Bytes::new(4))
  debug_assert(!image_ready_at(key, 64.0), "image not ready before load")
  image_ask_at(key, 64.0)
  debug_assert(image_ready_at(key, 64.0), "image_ready_at sees decoded image after image_ask_at")
  forget_image(key)
  t.dispose()
}

test "view picture emits vector bands, preserves layer alpha under tint, and bypasses ViewBlock cache" {
  let vec = pixels::Vector::{
    w: 24.0,
    h: 24.0,
    layers: [
      pixels::VectorPath::{
        d: "M2 2H22V22H2Z",
        fill: rgba(0xFF, 0xFF, 0xFF, 0x80),
        stroke: 0L,
        width: 0.0,
        even_odd: false,
        sx: 1.0,
        sy: 1.0,
        tx: 0.0,
        ty: 0.0,
      },
    ],
  }
  let tint_sig = signals::signal(rgba(0x33, 0xCC, 0x66, 0xFF))
  set_view_blocks_enabled(true)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
      .width(view::Live::Is(Some(24.0)))
      .height(view::Live::Is(Some(24.0)))
      .picture(view::Live::Is(Some(vec)))
      .tint(view::Live::By(fn() { tint_sig.get() }))
    })
  }, width=100.0, height=100.0)
  let sc = t.scene()
  let mut bands = 0
  let mut seg_packs = 0
  let mut saw_r = -1.0
  let mut saw_g = -1.0
  let mut saw_a = -1.0
  let mut i = 0
  while i < sc.ninst {
    let b = i * inst_size
    let kind = sc.inst[b + 5]
    if (kind - 11.0).abs() < 0.01 {
      bands += 1
      saw_r = sc.inst[b + 8]
      saw_g = sc.inst[b + 9]
      saw_a = sc.inst[b + 11]
    } else if (kind - 12.0).abs() < 0.01 {
      seg_packs += 1
    }
    i += 1
  }
  debug_assert(bands > 0 && seg_packs > 0, "View::picture must emit kind=11 bands and kind=12 seg packs")
  // Tinted layer keeps its 0x80 (~0.502) alpha multiplied with tint alpha (0xFF) and takes tint RGB
  debug_assert((saw_r - 0x33.to_double() / 255.0).abs() < 0.02, "picture band carries tint red")
  debug_assert((saw_g - 0xCC.to_double() / 255.0).abs() < 0.02, "picture band carries tint green")
  debug_assert((saw_a - 0x80.to_double() / 255.0).abs() < 0.03, "picture tint preserves layer alpha")
  t.dispose()
}

test "runs_look applies code_ground, code_ink, code_scale, link color, and keeps alpha-0 run transparent" {
  let runs = [
    text::Run::{ ..text::plain("code"), code: true },
    text::Run::{ ..text::plain("hidden"), color: rgba(0xFF, 0xFF, 0xFF, 0x00) },
    text::Run::{ ..text::plain("go"), link: "https://example.com" },
  ]
  let look = view::WordsLook::{ ..view::words_plain, size: 12.0, line: 18.0, wrap: false }
  let rlook = view::RunsLook::{
    ..view::runs_plain,
    code_ink: rgba(0xAA, 0xBB, 0xCC, 0xFF),
    code_ground: rgba(0xFF, 0xFF, 0xFF, 0x20),
    code_scale: 0.85,
    link: rgba(0x11, 0x88, 0xEE, 0xFF),
  }
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
      .width(view::Live::Is(Some(240.0)))
      .words_runs(view::Live::Is(runs), ink=rgba(0xF0, 0xF0, 0xF0, 0xFF), look=look)
      .runs_look(view::Live::Is(rlook))
    })
  }, width=300.0, height=100.0)
  let sc = t.scene()
  let mut code_bg_seen = false
  let mut code_glyphs = 0
  let mut link_glyphs = 0
  let mut total_glyphs = 0
  let mut i = 0
  while i < sc.ninst {
    let b = i * inst_size
    let kind = sc.inst[b + 5]
    if kind == 0.0 && (sc.inst[b + 11] - 0x20.to_double() / 255.0).abs() < 0.02 {
      code_bg_seen = true
    } else if (kind - 1.0).abs() < 0.01 {
      total_glyphs += 1
      if (sc.inst[b + 8] - 0xAA.to_double() / 255.0).abs() < 0.02 {
        code_glyphs += 1
      }
      if (sc.inst[b + 8] - 0x11.to_double() / 255.0).abs() < 0.02 {
        link_glyphs += 1
      }
    }
    i += 1
  }
  debug_assert(code_bg_seen, "runs_look.code_ground must emit inline code background pill")
  debug_assert(code_glyphs == 4, "code run glyphs must use runs_look.code_ink")
  debug_assert(link_glyphs == 2, "link run glyphs must use runs_look.link")
  // "hidden" (alpha=0) must emit 0 glyphs (only 4 + 2 = 6 total)
  debug_assert(total_glyphs == 6, "alpha-0 run must stay invisible instead of falling back to default ink")
  t.dispose()
}

test "image_contains letterboxes and image_covers crops UVs by aspect ratio" {
  let key = "mem:fit-test"
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v
      .width(view::Live::Is(Some(100.0)))
      .height(view::Live::Is(Some(100.0)))
      .image(view::Live::Is(Some((key, "", 256))))
      .image_contains(view::Live::Is(true))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v
      .width(view::Live::Is(Some(100.0)))
      .height(view::Live::Is(Some(100.0)))
      .image(view::Live::Is(Some((key, "", 256))))
      .image_covers(view::Live::Is(true))
    })
  }, width=200.0, height=250.0)
  // FakeHost decodes 200x100 (2:1) image into two 100x100 boxes
  let h = hostapi::host()
  h.image_info = fn(_id : Int, out : FixedArray[Double]) -> Int {
    out[0] = 200.0
    out[1] = 100.0
    1
  }
  add_image(key, Bytes::new(8))
  t.frame(ms=16.0)
  let sc = t.scene()
  let img_rects : Array[(Double, Double, Double, Double, Double, Double)] = []
  let mut i = 0
  while i < sc.ninst {
    let b = i * inst_size
    if (sc.inst[b + 5] - 4.0).abs() < 0.01 {
      img_rects.push((sc.inst[b + 1], sc.inst[b + 2], sc.inst[b + 3], sc.inst[b + 12], sc.inst[b + 14], sc.inst[b + 15]))
    }
    i += 1
  }
  debug_assert(img_rects.length() == 2, "expected 2 image instances")
  // First (contain): 200x100 inside 100x100 -> 100x50 centered at y=25
  debug_assert((img_rects[0].0 - 25.0).abs() < 0.5 && (img_rects[0].1 - 100.0).abs() < 0.5 && (img_rects[0].2 - 50.0).abs() < 0.5, "image_contains centers 2:1 image to 100x50 at y=25")
  // Second (cover): 200x100 inside 100x100 -> u0=0.25, du=0.5, dv=1.0
  debug_assert((img_rects[1].3 - 0.25).abs() < 0.01 && (img_rects[1].4 - 0.5).abs() < 0.01 && (img_rects[1].5 - 1.0).abs() < 0.01, "image_covers crops UVs to u0=0.25, du=0.5")
  forget_image(key)
  t.dispose()
}

test "d3: multi-window isolates ViewBlock and View::picture caches across windows" {
  let vec_primary = pixels::Vector::{
    w: 16.0,
    h: 16.0,
    layers: [pixels::VectorPath::{ d: "M 1 1 L 15 1 L 15 15 L 1 15 Z", fill: 0xFF0000FFL, stroke: 0L, width: 0.0, even_odd: false, sx: 1.0, sy: 1.0, tx: 0.0, ty: 0.0 }],
  }
  let vec_secondary = pixels::Vector::{
    w: 16.0,
    h: 16.0,
    layers: [pixels::VectorPath::{ d: "M 2 2 L 14 2 L 14 14 L 2 14 Z", fill: 0x00FF00FFL, stroke: 0L, width: 0.0, even_odd: false, sx: 1.0, sy: 1.0, tx: 0.0, ty: 0.0 }],
  }
  set_view_blocks_enabled(true)
  let tick = signals::signal(0)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(24.0))).ground(view::Live::Is(0x112233FFL))
    })
    let _ = root.box(fn(p : view::View) {
      let _ = p.width(view::Live::Is(Some(16.0))).height(view::Live::Is(Some(16.0))).picture(view::Live::Is(Some(vec_primary)))
    })
    let _ = root.box(fn(s : view::View) {
      let _ = s.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(10.0))).ground(view::Live::By(fn() { if tick.get() == 0 { 0x111111FFL } else { 0x222222FFL } }))
    })
  }, width=200.0, height=100.0)
  set_window_tree(fn(_wid : Int, _what : String) {
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(32.0))).ground(view::Live::Is(0x445566FFL))
      })
      let _ = root.box(fn(p : view::View) {
        let _ = p.width(view::Live::Is(Some(16.0))).height(view::Live::Is(Some(16.0))).picture(view::Live::Is(Some(vec_secondary)))
      })
    }
  })
  let wid = window_open_here("secondary")
  debug_assert(wid > 0, "secondary window must open")
  let _ = window_frame(wid, 200.0, 100.0, 2.0, 16.0)
  // Rendering secondary window must not evict or overwrite primary window's ViewBlock or View::picture caches.
  view_paint_work_reset()
  tick.set(1)
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert(view_paint_work_now().copied > 0, "primary window ViewBlock cache must survive secondary window frame")
  let mut primary_pics = 0
  for k in view_pictures.map.keys() {
    match view_pictures.map.get(k) {
      Some(cp) => {
        debug_assert(cp.of.layers[0].fill == 0xFF0000FFL, "primary window View::picture cache must stay isolated from secondary window")
        primary_pics += 1
      }
      None => ()
    }
  }
  debug_assert(primary_pics == 1, "primary window must retain its own cached picture")
  in_window(wid, fn() -> Unit {
    let mut sec_pics = 0
    for k in view_pictures.map.keys() {
      match view_pictures.map.get(k) {
        Some(cp) => {
          debug_assert(cp.of.layers[0].fill == 0x00FF00FFL, "secondary window View::picture cache must stay isolated from primary window")
          sec_pics += 1
        }
        None => ()
      }
    }
    debug_assert(sec_pics == 1, "secondary window must retain its own cached picture")
  })
  window_close_here(wid)
  t.dispose()
}

test "d4: text glyphs snap to physical pixels with quarter-pixel phase and tabular style at 1.5x" {
  let ox : signals::Signal[Double] = signals::signal(10.25)
  let oy : signals::Signal[Double] = signals::signal(20.33)
  let seen_keys : Array[Int] = []
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(b : view::View) {
      let _ = b
      .offset(view::Live::By(fn() { (ox.get(), oy.get()) }))
      .words(view::Live::Is("1234"), ink=0xFFFFFFFFL, look=view::WordsLook::{ ..view::words_plain, size: 13.0, line: 18.0, wrap: false })
    })
  }, width=300.0, height=100.0, scale=1.5)
  let h = hostapi::host()
  let orig_glyph = h.glyph
  h.glyph = fn(key : Int, out : FixedArray[Double]) {
    seen_keys.push(key)
    orig_glyph(key, out)
  }
  reset_glyph_atlas()
  view_blocks_reset()
  t.fake.frame_requested = true
  t.frame(ms=16.0)
  debug_assert((t.fake.last_shape_style & hostapi::style_tabular) == hostapi::style_tabular, "default theme tabular sets style_tabular")
  let sc = t.scene()
  let mut glyphs = 0
  let mut i = 0
  while i < sc.ninst {
    let b = i * inst_size
    if (sc.inst[b + 5] - 1.0).abs() < 0.01 {
      let px = sc.inst[b] * 1.5
      let py = sc.inst[b + 1] * 1.5
      debug_assert((px - px.round()).abs() < 0.01, "glyph x must land on physical pixel at 1.5x, got px=\{px}")
      debug_assert((py - py.round()).abs() < 0.01, "glyph y must land on physical pixel at 1.5x, got py=\{py}")
      glyphs += 1
    }
    i += 1
  }
  debug_assert(glyphs == 4, "expected 4 glyph quads, got \{glyphs}")
  let mut has_phase = false
  for k in seen_keys {
    if ((k >> 26) & 3) != 0 {
      has_phase = true
    }
  }
  debug_assert(has_phase, "fractional 1.5x pen position must encode non-zero quarter-pixel phase in bits 26..27")
  // Shift by exact whole physical pixels (2/1.5 pt): ViewBlock cache hits and glyphs stay snapped.
  view_paint_work_reset()
  ox.set(10.25 + 2.0 / 1.5)
  t.frame(ms=16.0)
  debug_assert(view_paint_work_now().copied > 0, "whole-pixel shift reuses cached ViewBlock")
  let sc2 = t.scene()
  let mut j = 0
  while j < sc2.ninst {
    let b = j * inst_size
    if (sc2.inst[b + 5] - 1.0).abs() < 0.01 {
      let px = sc2.inst[b] * 1.5
      let py = sc2.inst[b + 1] * 1.5
      debug_assert((px - px.round()).abs() < 0.01 && (py - py.round()).abs() < 0.01, "cached ViewBlock glyph stays snapped")
    }
    j += 1
  }
  t.dispose()
}

test "d5: view_cursor_tell syncs host cursor on hover and reactive View::cursor change" {
  let brush = signals::signal(false)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(canvas : view::View) {
      let _ = canvas
      .width(view::Live::Is(Some(120.0)))
      .height(view::Live::Is(Some(80.0)))
      .presses(view::Live::Is(true))
      .on_drag(fn(_) { })
      .cursor(view::Live::By(fn() {
        if brush.get() { Some(view::Cursor::Crosshair) } else { Some(view::Cursor::Arrow) }
      }))
    })
    let _ = root.box(fn(zone : view::View) {
      let _ = zone
      .width(view::Live::Is(Some(60.0)))
      .height(view::Live::Is(Some(40.0)))
      .points(view::Live::Is(true))
      .cursor(view::Live::Is(Some(view::Cursor::ResizeX)))
    })
  }, width=240.0, height=160.0)
  t.frame(ms=16.0)
  view_pointer(0, 40.0, 40.0, 16.0)
  debug_assert(t.fake.cursor_id == 0, "expected Arrow (0) before selecting brush, got \{t.fake.cursor_id}")
  // Changing cursor reactively while pointer is stationary must push Crosshair (7) immediately via Tree::on_cursor.
  brush.set(true)
  debug_assert(t.fake.cursor_id == 7, "expected Crosshair (7) after selecting brush, got \{t.fake.cursor_id}")
  // Hovering a hover-only points(true) node shows its cursor (ResizeX = 3).
  view_pointer(0, 20.0, 95.0, 24.0)
  debug_assert(t.fake.cursor_id == 3, "expected ResizeX (3) over points(true) zone, got \{t.fake.cursor_id}")
  // Moving pointer outside interactive zones restores Arrow (0).
  view_pointer(0, 200.0, 140.0, 32.0)
  debug_assert(t.fake.cursor_id == 0, "expected Arrow (0) outside canvas, got \{t.fake.cursor_id}")
  t.dispose()
}

test "d6: translucent edge over ground composites src-over instead of punching a hole" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(panel : view::View) {
      let _ = panel
      .width(view::Live::Is(Some(100.0)))
      .height(view::Live::Is(Some(40.0)))
      .radius(view::Live::Is(12.0))
      .ground(view::Live::Is(0x18191DF7L))
      .edge(view::Live::Is((1.0, 0xFFFFFF2EL)))
    })
  }, width=200.0, height=100.0)
  t.frame(ms=16.0)
  let sc = t.scene()
  let mut found = false
  let mut i = 0
  while i < sc.ninst {
    let b = i * inst_size
    if (sc.inst[b + 5] - 0.0).abs() < 0.01 && sc.inst[b + 6] > 0.5 {
      // Border alpha must reflect src-over (~0.974), NOT raw 0x2E/255 (~0.180), and RGB ~67/255 (~0.263).
      debug_assert(sc.inst[b + 15] > 0.90, "expected composited border alpha > 0.90, got \{sc.inst[b + 15]}")
      debug_assert(sc.inst[b + 12] > 0.20 && sc.inst[b + 12] < 0.35, "expected composited border R ~0.26, got \{sc.inst[b + 12]}")
      found = true
    }
    i += 1
  }
  debug_assert(found, "expected edged panel instance")
  t.dispose()
}

test "d7: sibling reacts scheduling at_moment(cause_at) runs after sibling show mounts in same batch" {
  let ver : signals::Signal[Int] = signals::signal(0)
  let target_ref : signals::Ref[Option[view::View]] = ref_new(None)
  let measured : Array[Double] = []
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(tabs : view::View) {
      let _ = tabs.row(view::Live::Is(true))
      tabs.reacts(fn() { (0, ver.get(), 0) }, fn(_) {
        let at = tabs.cause_at()
        let _ = tabs.at_moment(at, fn() {
          match target_ref.v {
            Some(target) => {
              let (_, _, iw, _) = target.laid_window_now()
              measured.push(iw)
            }
            None => ()
          }
        })
      })
      let _ = tabs.box(fn(b : view::View) {
        target_ref.v = Some(b)
        let _ = b.row(view::Live::Is(true)).gap(view::Live::Is(4.0))
        let _ = b.box(fn(lbl : view::View) {
          let _ = lbl.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(20.0)))
        })
        b.show(fn() { ver.get() > 0 }, fn(dot : view::View) {
          let _ = dot.width(view::Live::Is(Some(5.0))).height(view::Live::Is(Some(5.0)))
        }, at_once=true)
      })
    })
  }, width=300.0, height=80.0)
  t.frame(ms=16.0)
  signals::start_batch()
  ver.set(1)
  signals::end_batch()
  t.frame(ms=16.0)
  debug_assert(measured.length() >= 2, "expected at least 2 measurements, got \{measured.length()}")
  let last_w = measured[measured.length() - 1]
  debug_assert(last_w >= 48.0, "expected widened width >= 48 after sibling show mounts dot, got \{last_w}")
  t.dispose()
}

fn tab_frac_styles(t : Tester, words : String) -> Array[Int] {
  let out : Array[Int] = []
  for e in t.fake.shape_log {
    if e.0 == words {
      out.push(e.1)
    }
  }
  out
}

fn tab_frac_all(styles : Array[Int], mask : Int, want : Int) -> Bool {
  if styles.length() == 0 {
    return false
  }
  for s in styles {
    if (s & mask) != want {
      return false
    }
  }
  true
}

test "d8: WordsLook tabular / diagonal_fractions reach host shape style bits over the theme's tabular" {
  let tab = hostapi::style_tabular
  let frac = hostapi::style_diagonal_fractions
  debug_assert(frac == 128, "style_diagonal_fractions is bit 7")
  debug_assert((frac & (hostapi::style_tabular | hostapi::style_proportional | hostapi::style_no_ligatures | hostapi::style_face_bits)) == 0, "frac bit overlaps no other style bit")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 0123"), look=view::WordsLook::of(16.0))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 4567"), look=view::WordsLook::of(16.0, tabular=Some(false)))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 24/7"), look=view::WordsLook::of(16.0, diagonal_fractions=true))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 9/16"), look=view::WordsLook::of(16.0, tabular=Some(true), diagonal_fractions=true))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 1/2"), look=view::WordsLook::of(16.0, tabular=Some(true)))
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.words(view::Live::Is("d8 1/2"), look=view::WordsLook::of(16.0, tabular=Some(false), diagonal_fractions=true))
    })
  }, width=400.0, height=300.0)
  t.frame(ms=16.0)
  debug_assert(tree_theme().tabular, "default theme is tabular")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d8 0123"), tab | frac, tab), "tabular=None follows theme: tnum on, frac off")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d8 4567"), tab | frac, 0), "tabular=Some(false) clears style_tabular over the theme's")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d8 24/7"), tab | frac, frac), "diagonal_fractions sets style_diagonal_fractions, the theme's tnum not with it")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d8 9/16"), tab | frac, tab | frac), "tabular=Some(true) said with fractions keeps tnum")
  // The same words at two styles are shaped twice (the shape cache is keyed by the whole style)
  let same = tab_frac_styles(t, "d8 1/2")
  let mut saw_tab = false
  let mut saw_frac = false
  for s in same {
    if (s & (tab | frac)) == tab { saw_tab = true }
    if (s & (tab | frac)) == frac { saw_frac = true }
    debug_assert((s & (tab | frac)) != (tab | frac), "no style mixes the two looks of \"d8 1/2\"")
  }
  debug_assert(saw_tab && saw_frac, "same words shaped once per style: tnum and frac never share a cache entry")
  t.dispose()
}

test "d9: words_runs resolve tabular per run over look over theme (not the theme's with fractions), frac per run or look" {
  let tab = hostapi::style_tabular
  let frac = hostapi::style_diagonal_fractions
  let runs = [
    text::plain("d9 run1 10"),
    text::span("d9 run2 20", tabular=Some(true)),
    text::span("d9 run3 3/4", tabular=Some(false), diagonal_fractions=true),
  ]
  let runs_b = [
    text::plain("d9 runB1 10"),
    text::span("d9 runB2 20", tabular=Some(false)),
    text::span("d9 runB3 30", tabular=Some(true)),
  ]
  let look_a = view::WordsLook::of(14.0, tabular=Some(false), wrap=false)
  let look_b = view::WordsLook::of(14.0, diagonal_fractions=true, wrap=false)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(v : view::View) {
      let _ = v.width(view::Live::Is(Some(380.0))).words_runs(view::Live::Is(runs), ink=0xFFFFFFFFL, look=look_a)
    })
    let _ = root.box(fn(v : view::View) {
      let _ = v.width(view::Live::Is(Some(380.0))).words_runs(view::Live::Is(runs_b), ink=0xFFFFFFFFL, look=look_b)
    })
  }, width=400.0, height=200.0)
  t.frame(ms=16.0)
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 run1 10"), tab | frac, 0), "run tabular=None takes look's Some(false): tnum off")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 run2 20"), tab | frac, tab), "run tabular=Some(true) overrides look's Some(false)")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 run3 3/4"), tab | frac, frac), "run Some(false) + diagonal_fractions: frac on, tnum off")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 runB1 10"), tab | frac, frac), "look frac applies to run; theme tnum not with fractions")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 runB2 20"), tab | frac, frac), "run Some(false) keeps look frac")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 runB3 30"), tab | frac, tab | frac), "run Some(true) with look frac: both")
  let run_frac_theme = [text::span("d9 runC1 1/2", diagonal_fractions=true), text::plain("d9 runC2 12")]
  t.fake.shape_log.clear()
  let _ = host_runs_measure(run_frac_theme, view::WordsLook::of(14.0, wrap=false), view::runs_plain, 380.0, 1.0)
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 runC1 1/2"), tab | frac, frac), "run frac over a plain look: no theme tnum")
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 runC2 12"), tab | frac, tab), "its plain sibling keeps the theme's tnum")
  // Measurement (host_runs_measure / host_runs_least_measure) agrees with drawing
  t.fake.shape_log.clear()
  let _ = host_runs_measure(runs, look_a, view::runs_plain, 380.0, 1.0)
  let _ = host_runs_least_measure(runs, look_a, view::runs_plain, 1.0)
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 run3 3/4"), tab | frac, frac), "measure path resolves run3 alike")
  let st_off = view::WordsLook::of(14.0, tabular=Some(false))
  t.fake.shape_log.clear()
  let _ = host_words_measure("d9 measure 99", st_off, 300.0, 1.0)
  debug_assert(tab_frac_all(tab_frac_styles(t, "d9 measure 99"), tab, 0), "host_words_measure honours look tabular=Some(false)")
  t.dispose()
}

test "d10: run_feature_bits and style_words map tabular / fractions exactly" {
  let tab = hostapi::style_tabular
  let frac = hostapi::style_diagonal_fractions
  let lig = hostapi::style_no_ligatures
  let theme_tab = view::words_plain
  let off = view::WordsLook::of(14.0, tabular=Some(false))
  let on = view::WordsLook::of(14.0, tabular=Some(true))
  let fr = view::WordsLook::of(14.0, diagonal_fractions=true)
  let face = 3 << 8
  debug_assert(run_feature_bits(text::plain("x"), theme_tab, tab | lig | face) == (tab | lig | face), "None keeps the look's (theme) tnum, the rest of base kept")
  debug_assert(run_feature_bits(text::span("x", tabular=Some(false)), theme_tab, tab | lig) == lig, "Some(false) clears tnum only")
  debug_assert(run_feature_bits(text::plain("x"), off, lig) == lig, "look Some(false) stays off")
  debug_assert(run_feature_bits(text::span("x", tabular=Some(true)), off, lig) == (tab | lig), "run Some(true) over look Some(false)")
  debug_assert(run_feature_bits(text::span("x", tabular=Some(false)), on, tab) == 0, "run Some(false) over look Some(true)")
  debug_assert(run_feature_bits(text::span("x", diagonal_fractions=true), theme_tab, tab) == frac, "run frac: bit 7, the theme's tnum not with it")
  debug_assert(run_feature_bits(text::span("x", diagonal_fractions=true), on, tab) == (tab | frac), "run frac over look tnum Some(true): both")
  debug_assert(run_feature_bits(text::plain("x"), fr, view_words_style_bits(0.0, fr)) == frac, "look frac kept for plain run")
  debug_assert(view_words_style_bits(0.0, fr) == frac && view_words_style_bits(0.0, theme_tab) == tab, "look bits")
  debug_assert(view_words_style_bits(1.0, off) == lig, "tracking: no ligatures, tnum off as said")
  debug_assert(text::plain("x").tabular is None && !text::plain("x").diagonal_fractions, "plain defaults")
  debug_assert(view::words_plain.tabular is None && !view::words_plain.diagonal_fractions, "words_plain defaults")
  let ui_run = span("x", tabular=false, diagonal_fractions=true)
  debug_assert(ui_run.tabular == Some(false) && ui_run.diagonal_fractions, "ui::span forwards tabular / fractions")
  let seen : Array[view::WordsLook] = []
  let t = Tester::tree(fn(root : view::View) {
    seen.push(style_words(text_style(tabular=false)))
    seen.push(style_words(text_style()))
    let _ = root
  }, width=100.0, height=100.0)
  debug_assert(seen.length() == 2, "style_words ran")
  debug_assert(seen[0].tabular == Some(false), "style_words carries TextStyle tabular=false")
  debug_assert(seen[1].tabular is None, "unset TextStyle tabular stays None (theme's)")
  t.dispose()
}

test "d11: diagonal fractions are drawn whole (text_key of the fraction), advances kept, others untouched" {
  let keyed : Array[String] = []
  let t = Tester::tree(fn(root : view::View) { let _ = root }, width=100.0, height=100.0)
  let h = hostapi::host()
  h.text_key = fn(s : String, _sz : Double, _w : Int, _st : Int) {
    keyed.push(s)
    7000 + keyed.length()
  }
  let shaped = fn(words : String, style : Int) -> FixedArray[Double] {
    let cps = utf16_codepoints(words)
    let n = cps.length()
    let sbuf : FixedArray[Double] = FixedArray::make(n * 4 + 4, 0.0)
    let mut i = 0
    while i < n {
      sbuf[i * 4] = i.to_double()
      sbuf[i * 4 + 1] = 1.0
      sbuf[i * 4 + 2] = 5.0 + i.to_double()
      sbuf[i * 4 + 3] = if cps[i] == 32 { -1.0 } else { (100 + i).to_double() }
      i += 1
    }
    resolve_ligatures(words, n, sbuf, 15.0, 400, style)
    sbuf
  }
  let frac = hostapi::style_diagonal_fractions
  // "a 24/7 x 1⁄2 2026 /" : 24/7 and 1⁄2 grouped; 2026 (no slash) and the lone slash not
  let words = "a 24/7 x 1⁄2 2026 /"
  let sb = shaped(words, frac)
  debug_assert(keyed.length() == 2 && keyed[0] == "24/7" && keyed[1] == "1⁄2", "fractions keyed whole: \{keyed.length()}")
  debug_assert(sb[2 * 4 + 3].to_int() == 7001, "24/7 drawn at its first digit")
  debug_assert(sb[3 * 4 + 3] == -1.0 && sb[4 * 4 + 3] == -1.0 && sb[5 * 4 + 3] == -1.0, "rest of 24/7 drawn as nothing")
  debug_assert(sb[9 * 4 + 3].to_int() == 7002 && sb[10 * 4 + 3] == -1.0 && sb[11 * 4 + 3] == -1.0, "1⁄2 drawn whole")
  let mut i = 13
  while i < 17 {
    debug_assert(sb[i * 4 + 3].to_int() == 100 + i, "2026 keeps its own keys")
    i += 1
  }
  debug_assert(sb[18 * 4 + 3].to_int() == 118, "a lone slash keeps its key")
  let mut j = 0
  while j < 19 {
    debug_assert(sb[j * 4 + 2] == 5.0 + j.to_double(), "advance \{j} kept")
    j += 1
  }
  // An emoji before (two UTF-16 units, one cluster): the fraction after it keyed by its own UTF-16 range
  keyed.clear()
  let emoji = "🎉24/7"
  let eb : FixedArray[Double] = FixedArray::make(5 * 4, 0.0)
  let clusters = [(0, 2), (2, 1), (3, 1), (4, 1), (5, 1)]
  let mut e = 0
  while e < 5 {
    eb[e * 4] = clusters[e].0.to_double()
    eb[e * 4 + 1] = clusters[e].1.to_double()
    eb[e * 4 + 2] = 9.0
    eb[e * 4 + 3] = (200 + e).to_double()
    e += 1
  }
  resolve_ligatures(emoji, 5, eb, 15.0, 400, frac)
  debug_assert(keyed.length() == 1 && keyed[0] == "24/7", "fraction after an emoji keyed \"24/7\"")
  debug_assert(eb[3] == 200.0, "the emoji keeps its key")
  debug_assert(eb[1 * 4 + 3].to_int() == 7001 && eb[2 * 4 + 3] == -1.0 && eb[3 * 4 + 3] == -1.0 && eb[4 * 4 + 3] == -1.0, "24/7 after the emoji drawn whole at its 2")
  // Two slashes: one span drawn whole
  keyed.clear()
  let chain = shaped("1/2/3", frac)
  debug_assert(keyed.length() == 1 && keyed[0] == "1/2/3", "1/2/3 keyed whole")
  debug_assert(chain[3].to_int() == 7001 && chain[1 * 4 + 3] == -1.0 && chain[4 * 4 + 3] == -1.0, "1/2/3 drawn at its first digit")
  // A slash with no digit after it ("12/ x") is no fraction
  keyed.clear()
  let open_end = shaped("12/ x", frac)
  debug_assert(keyed.length() == 0 && open_end[2 * 4 + 3].to_int() == 102, "12/ is not grouped")
  // Without the fractions bit nothing is grouped
  keyed.clear()
  let plain = shaped(words, hostapi::style_tabular)
  debug_assert(keyed.length() == 0 && plain[3 * 4 + 3].to_int() == 103, "no frac bit: clusters drawn as shaped")
  t.dispose()
}
