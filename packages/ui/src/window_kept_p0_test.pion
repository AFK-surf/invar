test "post-build dynamic box binding on offscreen tree reads offscreen room and narrow state" {
  let t = Tester::tree(fn(_r : view::View) { () }, width=1000.0, height=600.0)
  set_narrow_enabled(true)
  t.frame()
  let off = view::Tree::new(
    fn(_r : view::View) { () },
    measure=host_words_measure,
    measure_runs=host_runs_measure,
    measure_runs_least=host_runs_least_measure,
  )
  let _ = encode_tree_scene(off, 400.0, 600.0, 1.0, 10.0)
  let seen_w = signals::ref_new(-1.0)
  let seen_narrow = signals::ref_new(false)
  let _ = off.root().box(fn(b : view::View) {
    let _ = b.words(
      view::Live::By(fn() {
        seen_w.v = window_size_now().0
        seen_narrow.v = tree_narrow()
        if seen_narrow.v { "dyn-narrow" } else { "dyn-wide" }
      }),
      look=view::words_plain,
    )
  })
  let _ = encode_tree_scene(off, 400.0, 600.0, 1.0, 26.0)
  debug_assert(seen_w.v == 400.0, "post-build dynamic box must read offscreen width 400.0")
  debug_assert(seen_narrow.v, "post-build dynamic box must see narrow=true at 400px")
  off.dispose()
  t.dispose()
}

test "secondary reacts callback reads owner narrow policy" {
