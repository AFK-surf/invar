fn check_active_secondary_disposal_width(from_main_effect : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () }, width=1000.0)
  let seen = signals::ref_new(-1.0)
  let owner = signals::ref_new(-1)
  let count = signals::ref_new(0)
  let trigger = signals::signal(0)
  let replace = fn() { set_view_app(fn(_ : view::View) { () }) }
  let stop = signals::effect(fn() { if trigger.get() > 0 { replace() } })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.owns(fn() {
        count.v = count.v + 1
        seen.v = window_size_now().0
        owner.v = current_window_id()
      })
    }
  })
  let w = window_open_here("secondary")
  let _ = window_frame(w, 400.0, 600.0, 1.0, 10.0)
  in_window(w, fn() {
    debug_assert(window_size_now().0 == 400.0, "secondary starts at 400")
    if from_main_effect { trigger.set(1) } else { replace() }
  })
  debug_assert(count.v == 1 && owner.v == w, "cleanup reached the correct window")
  debug_assert(seen.v == 400.0, "secondary cleanup width=" + seen.v.to_string())
  stop()
  t.dispose()
}

test "active secondary disposes with own width" { check_active_secondary_disposal_width(false) }
test "active secondary disposes with own width under main effect" { check_active_secondary_disposal_width(true) }


test "window_lifecycle_guard_error blocks lifecycle mutations during primary, close, and reset teardowns" {
  let check_guarded = fn(phase : String) {
    debug_assert(window_lifecycle_guard_error("set_view_app").is_some(), phase + ": set_view_app must be guarded")
    debug_assert(window_lifecycle_guard_error("view_forget").is_some(), phase + ": view_forget must be guarded")
    debug_assert(window_lifecycle_guard_error("window_open_here").is_some(), phase + ": window_open_here must be guarded")
    debug_assert(window_lifecycle_guard_error("window_close_here").is_some(), phase + ": window_close_here must be guarded")
    debug_assert(window_switch_guard_error("in_window").is_none(), phase + ": in_window must remain allowed during teardown")
  }
  let check_clear = fn(phase : String) {
    debug_assert(window_lifecycle_guard_error("set_view_app").is_none(), phase + ": set_view_app must be clear")
    debug_assert(window_lifecycle_guard_error("view_forget").is_none(), phase + ": view_forget must be clear")
    debug_assert(window_lifecycle_guard_error("window_open_here").is_none(), phase + ": window_open_here must be clear")
    debug_assert(window_lifecycle_guard_error("window_close_here").is_none(), phase + ": window_close_here must be clear")
  }
  let primary_checked = signals::ref_new(false)
  let close_checked = signals::ref_new(false)
  let reset_checked = signals::ref_new(false)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.owns(fn() {
      check_guarded("primary teardown")
      primary_checked.v = true
    })
  })
  set_window_tree(fn(_ : Int, what : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.owns(fn() {
        check_guarded("secondary " + what)
        if what == "close" {
          close_checked.v = true
        } else {
          reset_checked.v = true
        }
      })
    }
  })
  check_clear("initial")
  let w_close = window_open_here("close")
  let w_reset = window_open_here("reset")
  debug_assert(w_close > 0 && w_reset > 0, "two secondary windows opened")
  window_close_here(w_close)
  check_clear("after window_close_here")
  set_view_app(fn(_ : view::View) { () })
  check_clear("after set_view_app")
  debug_assert(primary_checked.v && close_checked.v && reset_checked.v, "all three teardown paths checked")
  t.dispose()
}


fn check_superseded_builder_retains_state(secondary : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "secondary" })
  let cleaned = signals::ref_new(0)
  let installs = signals::ref_new(0)
  let read = signals::ref_new("")
  let builder = fn(root : view::View) {
    draft.v = "superseded"
    let _ = root.owns(fn() {
      cleaned.v = cleaned.v + 1
      read.v = draft.v
      draft.v = "old cleanup"
    })
    set_view_app(fn(_ : view::View) {
      installs.v = installs.v + 1
      draft.v = "new primary"
    })
  }
  if secondary {
    set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { builder })
    debug_assert(window_open_here("cancelled") == 0, "open cancelled")
  } else { set_view_app(builder) }
  debug_assert(cleaned.v == 1 && installs.v == 1, "one release and one new builder")
  debug_assert(read.v == "superseded" && draft.v == "new primary",
    "old builder cleanup read=" + read.v + " latest draft=" + draft.v)
  t.dispose()
}

test "cancelled secondary builder retains its state during cleanup" { check_superseded_builder_retains_state(true) }
test "superseded main builder retains its state during cleanup" { check_superseded_builder_retains_state(false) }

test "standalone tree dispose sets view::tree_disposing and blocks lifecycle mutations" {
  let t = Tester::tree(fn(_ : view::View) { () })
  debug_assert(!view::tree_disposing(), "tree_disposing false before dispose")
  let checked = signals::ref_new(false)
  let tr = view::Tree::new(fn(root : view::View) {
    let _ = root.owns(fn() {
      debug_assert(view::tree_disposing(), "tree_disposing must be true inside standalone Tree::dispose")
      debug_assert(window_lifecycle_guard_error("set_view_app").is_some(), "set_view_app guarded in standalone dispose")
      debug_assert(window_lifecycle_guard_error("view_forget").is_some(), "view_forget guarded in standalone dispose")
      debug_assert(window_lifecycle_guard_error("window_open_here").is_some(), "window_open_here guarded in standalone dispose")
      debug_assert(window_lifecycle_guard_error("window_close_here").is_some(), "window_close_here guarded in standalone dispose")
      debug_assert(window_switch_guard_error("in_window").is_none(), "in_window remains allowed in standalone dispose")
      checked.v = true
    })
  })
  tr.dispose()
  debug_assert(checked.v, "standalone cleanup ran")
  debug_assert(!view::tree_disposing(), "tree_disposing false after dispose")
  debug_assert(window_lifecycle_guard_error("set_view_app").is_none(), "set_view_app guard cleared after dispose")
  debug_assert(window_lifecycle_guard_error("view_forget").is_none(), "view_forget guard cleared after dispose")
  debug_assert(window_lifecycle_guard_error("window_open_here").is_none(), "window_open_here guard cleared after dispose")
  debug_assert(window_lifecycle_guard_error("window_close_here").is_none(), "window_close_here guard cleared after dispose")
  t.dispose()
}

fn check_superseded_builtin_snapshot(secondary : Bool, check_policy : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let snap = signals::ref_new(-1)
  let zoom = signals::ref_new(false)
  let cleaned = signals::ref_new(0)
  let installs = signals::ref_new(0)
  let builder = fn(root : view::View) {
    t.fake.window_snap_state_val = 3
    t.fake.window_zoomed_flag = true
    debug_assert(window_snap_state() == 3 && window_zoomed(), "cached superseded native state")
    let _ = root.owns(fn() {
      cleaned.v = cleaned.v + 1
      snap.v = window_snap_state()
      zoom.v = window_zoomed()
      set_narrow_enabled(false)
    })
    set_view_app(fn(_ : view::View) {
      installs.v = installs.v + 1
      set_narrow_below(700.0)
      set_narrow_enabled(true)
      t.fake.window_snap_state_val = 0
      t.fake.window_zoomed_flag = false
      debug_assert(window_snap_state() == 0 && !window_zoomed(), "confirmed replacement cache")
    })
  }
  if secondary {
    set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { builder })
    debug_assert(window_open_here("old") == 0, "cancelled open")
  } else { set_view_app(builder) }
  debug_assert(cleaned.v == 1 && installs.v == 1, "single dispose and replacement")
  if check_policy {
    t.resize(400.0, 600.0)
    debug_assert(window_size_now().0 == 400.0, "latest main framed")
    debug_assert(tree_narrow(), "old cleanup changed replacement narrow policy")
  } else {
    debug_assert(snap.v == 3 && zoom.v, "old cleanup snap=" + snap.v.to_string() + " zoom=" + zoom.v.to_string())
  }
  t.dispose()
}

test "cancelled secondary builder cleanup reads its old host state" { check_superseded_builtin_snapshot(true, false) }
test "superseded primary builder cleanup reads its old host state" { check_superseded_builtin_snapshot(false, false) }
test "cancelled secondary builder cleanup leaves new narrow policy enabled" { check_superseded_builtin_snapshot(true, true) }
test "superseded primary builder cleanup leaves new narrow policy enabled" { check_superseded_builtin_snapshot(false, true) }

test "stacked primary builders restore their own scalar drafts and builtin state" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("initial")
  window_kept_ref(draft, fn() { "fresh" })
  let seen_draft : Array[String] = []
  let seen_snap : Array[Int] = []
  let seen_zoom : Array[Bool] = []
  set_view_app(fn(a : view::View) {
    draft.v = "outer"
    t.fake.window_snap_state_val = 1
    t.fake.window_zoomed_flag = true
    debug_assert(window_snap_state() == 1 && window_zoomed(), "outer host state cached")
    let _ = a.owns(fn() {
      seen_draft.push(draft.v)
      seen_snap.push(window_snap_state())
      seen_zoom.push(window_zoomed())
      draft.v = "outer cleanup"
      set_narrow_enabled(false)
    })
    set_view_app(fn(b : view::View) {
      draft.v = "middle"
      t.fake.window_snap_state_val = 2
      t.fake.window_zoomed_flag = false
      debug_assert(window_snap_state() == 2 && !window_zoomed(), "middle host state cached")
      let _ = b.owns(fn() {
        seen_draft.push(draft.v)
        seen_snap.push(window_snap_state())
        seen_zoom.push(window_zoomed())
        draft.v = "middle cleanup"
        set_narrow_enabled(false)
      })
      set_view_app(fn(_ : view::View) {
        draft.v = "winner"
        set_narrow_below(700.0)
        set_narrow_enabled(true)
        t.fake.window_snap_state_val = 0
        t.fake.window_zoomed_flag = false
        debug_assert(window_snap_state() == 0 && !window_zoomed(), "winner host state cached")
      })
    })
  })
  debug_assert(
    seen_draft.length() == 2 && seen_draft[0] == "middle" && seen_draft[1] == "outer" && draft.v == "winner",
    "each builder reads own draft",
  )
  debug_assert(
    seen_snap.length() == 2 && seen_snap[0] == 2 && seen_snap[1] == 1,
    "each builder reads own snap state",
  )
  debug_assert(
    seen_zoom.length() == 2 && !seen_zoom[0] && seen_zoom[1],
    "each builder reads own zoomed state",
  )
  t.resize(400.0, 600.0)
  debug_assert(tree_narrow(), "winner narrow policy preserved")
  t.dispose()
}

test "secondary triggered app replacement preserves superseded primary host state and new narrow policy" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let seen_snap = signals::ref_new(-1)
  let seen_zoom = signals::ref_new(false)
  let cleaned = signals::ref_new(0)
  let installs = signals::ref_new(0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(_ : view::View) {
      set_view_app(fn(_ : view::View) {
        installs.v = installs.v + 1
        set_narrow_below(700.0)
        set_narrow_enabled(true)
        t.fake.window_snap_state_val = 0
        t.fake.window_zoomed_flag = false
        debug_assert(window_snap_state() == 0 && !window_zoomed(), "replacement primary host state cached")
      })
    }
  })
  set_view_app(fn(root : view::View) {
    t.fake.window_snap_state_val = 3
    t.fake.window_zoomed_flag = true
    debug_assert(window_snap_state() == 3 && window_zoomed(), "old primary host state cached")
    let _ = root.owns(fn() {
      cleaned.v = cleaned.v + 1
      seen_snap.v = window_snap_state()
      seen_zoom.v = window_zoomed()
      set_narrow_enabled(false)
    })
    debug_assert(window_open_here("trigger") == 0, "secondary open cancelled by app replacement")
  })
  debug_assert(cleaned.v == 1 && installs.v == 1, "single dispose and replacement")
  debug_assert(seen_snap.v == 3 && seen_zoom.v, "old primary cleanup reads old host state")
  t.resize(400.0, 600.0)
  debug_assert(tree_narrow(), "replacement narrow policy preserved after secondary triggered reset")
  t.dispose()
}

test "superseded primary builder effect on_cleanup reads old host state and preserves new narrow policy" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let seen_snap = signals::ref_new(-1)
  let seen_zoom = signals::ref_new(false)
  let cleaned = signals::ref_new(0)
  let installs = signals::ref_new(0)
  set_view_app(fn(root : view::View) {
    t.fake.window_snap_state_val = 3
    t.fake.window_zoomed_flag = true
    debug_assert(window_snap_state() == 3 && window_zoomed(), "old primary host state cached")
    let _ = root.owns(signals::effect_cleanup(fn() {
      fn() {
        cleaned.v = cleaned.v + 1
        seen_snap.v = window_snap_state()
        seen_zoom.v = window_zoomed()
        set_narrow_enabled(false)
      }
    }))
    set_view_app(fn(_ : view::View) {
      installs.v = installs.v + 1
      set_narrow_below(700.0)
      set_narrow_enabled(true)
      t.fake.window_snap_state_val = 0
      t.fake.window_zoomed_flag = false
      debug_assert(window_snap_state() == 0 && !window_zoomed(), "replacement host state cached")
    })
  })
  debug_assert(cleaned.v == 1 && installs.v == 1, "single effect cleanup and replacement")
  debug_assert(seen_snap.v == 3 && seen_zoom.v, "effect on_cleanup reads old host state")
  t.resize(400.0, 600.0)
  debug_assert(tree_narrow(), "effect on_cleanup does not disable replacement narrow policy")
  t.dispose()
}

test "superseded primary builder cleanup calling in_window preserves new primary state" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("init")
  window_kept_ref(draft, fn() { "fresh" })
  let sec_wid = signals::ref_new(0)
  let seen_sec = signals::ref_new("")
  let seen_old = signals::ref_new("")
  let cleaned = signals::ref_new(0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(_ : view::View) {
      draft.v = "secondary_live"
    }
  })
  set_view_app(fn(root : view::View) {
    draft.v = "old_primary"
    let _ = root.owns(fn() {
      cleaned.v = cleaned.v + 1
      seen_old.v = draft.v
      if sec_wid.v != 0 {
        in_window(sec_wid.v, fn() {
          seen_sec.v = draft.v
        })
      }
      debug_assert(draft.v == "old_primary", "old primary draft restored after in_window")
      draft.v = "old_primary_mutated"
    })
    set_view_app(fn(_ : view::View) {
      draft.v = "new_primary"
      sec_wid.v = window_open_here("sec")
      debug_assert(sec_wid.v != 0, "new primary opened secondary window")
      debug_assert(draft.v == "new_primary", "new primary kept its draft after opening secondary")
    })
  })
  debug_assert(cleaned.v == 1, "old primary cleaned once")
  debug_assert(seen_old.v == "old_primary", "old primary saw its own draft")
  debug_assert(seen_sec.v == "secondary_live", "in_window read live secondary draft")
  debug_assert(draft.v == "new_primary", "new primary draft preserved after old cleanup in_window")
  t.dispose()
}

fn check_winning_effect_during_superseded_cleanup(during_cleanup : Bool, check_write : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let changed = signals::signal(false)
  let observed = signals::ref_new(-1)
  let runs = signals::ref_new(0)
  set_view_app(fn(old : view::View) {
    t.fake.window_snap_state_val = 3
    debug_assert(window_snap_state() == 3, "old host value cached")
    let _ = old.owns(fn() {
      if during_cleanup { changed.set(true) }
    })
    set_view_app(fn(winner : view::View) {
      t.fake.window_snap_state_val = 0
      debug_assert(window_snap_state() == 0, "winner host value cached")
      set_narrow_below(700.0)
      set_narrow_enabled(true)
      let _ = winner.owns(signals::effect(fn() {
        if changed.get() {
          runs.v = runs.v + 1
          observed.v = window_snap_state()
          set_narrow_enabled(false)
        }
      }))
    })
  })
  if !during_cleanup { changed.set(true) }
  debug_assert(runs.v == 1, "winning effect reran exactly once")
  if check_write {
    t.resize(400.0, 600.0)
    debug_assert(!tree_narrow(), "winning effect failed to disable its own narrow policy")
  } else {
    debug_assert(observed.v == 0, "winning effect read snap=" + observed.v.to_string())
  }
  t.dispose()
}

test "winning primary effect reads own snap during old cleanup" { check_winning_effect_during_superseded_cleanup(true, false) }
test "winning primary effect changes own policy during old cleanup" { check_winning_effect_during_superseded_cleanup(true, true) }
test "winning primary effect reads own snap after old cleanup" { check_winning_effect_during_superseded_cleanup(false, false) }
test "winning primary effect changes own policy after old cleanup" { check_winning_effect_during_superseded_cleanup(false, true) }

test "preexisting primary subscriber reads and writes live primary state during superseded cleanup" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let changed = signals::signal(false)
  let observed = signals::ref_new(-1)
  let runs = signals::ref_new(0)
  let stop_ext = signals::effect(fn() {
    if changed.get() {
      runs.v = runs.v + 1
      observed.v = window_snap_state()
      set_narrow_enabled(false)
    }
  })
  set_view_app(fn(old : view::View) {
    t.fake.window_snap_state_val = 3
    debug_assert(window_snap_state() == 3, "old host value cached")
    let _ = old.owns(fn() {
      changed.set(true)
    })
    set_view_app(fn(_ : view::View) {
      t.fake.window_snap_state_val = 0
      debug_assert(window_snap_state() == 0, "winner host value cached")
      set_narrow_below(700.0)
      set_narrow_enabled(true)
    })
  })
  stop_ext()
  debug_assert(runs.v == 1, "external subscriber reran once during old cleanup")
  debug_assert(observed.v == 0, "external subscriber read winner snap=" + observed.v.to_string())
  t.resize(400.0, 600.0)
  debug_assert(!tree_narrow(), "external subscriber disabled winner narrow policy")
  t.dispose()
}

test "secondary triggered set_view_app disposes primary tree once and window_tree_of zero returns primary tree" {
  let primary_disposed = signals::ref_new(0)
  let secondary_disposed = signals::ref_new(0)
  let saw_primary_tree_in_secondary = signals::ref_new(false)
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.owns(fn() { primary_disposed.v = primary_disposed.v + 1 })
  })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(sec : view::View) {
      saw_primary_tree_in_secondary.v = window_tree_of(0).is_some()
      let _ = sec.owns(fn() { secondary_disposed.v = secondary_disposed.v + 1 })
    }
  })
  let w1 = window_open_here("panel")
  debug_assert(w1 > 0 && saw_primary_tree_in_secondary.v, "window_tree_of(0) returns primary tree inside secondary")
  in_window(w1, fn() {
    set_view_app(fn(_ : view::View) { () })
  })
  debug_assert(primary_disposed.v == 1, "primary tree disposed once, got=" + primary_disposed.v.to_string())
  debug_assert(secondary_disposed.v == 1, "secondary tree disposed once, got=" + secondary_disposed.v.to_string())
  debug_assert(window_tree_of(0).is_some(), "new primary tree installed")
  saw_primary_tree_in_secondary.v = false
  let w2 = window_open_here("panel2")
  debug_assert(w2 > 0 && saw_primary_tree_in_secondary.v, "window_tree_of(0) returns new primary tree inside new secondary")
  t.dispose()
}

test "window_closed_by_host disposes secondary tree and notifies listeners without host close callback" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let disposed = signals::ref_new(0)
  let closed_wid = signals::ref_new(0)
  let host_close_calls = signals::ref_new(0)
  let h = hostapi::host()
  let orig_close = h.window_close_id
  h.window_close_id = fn(wid : Int) {
    host_close_calls.v = host_close_calls.v + 1
    orig_close(wid)
  }
  when_window_closed(fn(wid : Int) { closed_wid.v = wid })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(sec : view::View) {
      let _ = sec.owns(fn() { disposed.v = disposed.v + 1 })
    }
  })
  let w = window_open_here("hosted")
  debug_assert(w > 0 && window_tree_of(w).is_some(), "secondary opened")
  window_closed_by_host(w)
  debug_assert(disposed.v == 1, "window_closed_by_host disposed tree once")
  debug_assert(closed_wid.v == w, "window_closed_by_host notified when_window_closed")
  debug_assert(host_close_calls.v == 0, "window_closed_by_host did not call hostapi::window_close_id")
  debug_assert(window_tree_of(w).is_none(), "window_tree_of cleared after host close")
  t.dispose()
}

fn check_window_frame_zero_target(explicit_main_scope : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () }, width=1000.0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { fn(_ : view::View) { () } })
  let panel = window_open_here("panel")
  let _ = window_frame(panel, 400.0, 600.0, 1.0, 11.0)
  let frame_main = fn() { let _ = window_frame(0, 900.0, 600.0, 1.0, 20.0) }
  in_window(panel, fn() {
    if explicit_main_scope { in_window(0, frame_main) } else { frame_main() }
  })
  let main_w = match window_tree_of(0) { Some(tr) => tr.root().laid_size().0; None => -1.0 }
  let main_room_w = match window_tree_of(0) { Some(tr) => tr.room_signal().get().0; None => -1.0 }
  let panel_w = match window_tree_of(panel) { Some(tr) => tr.root().laid_size().0; None => -1.0 }
  let panel_room_w = match window_tree_of(panel) { Some(tr) => tr.room_signal().get().0; None => -1.0 }
  debug_assert(
    main_w == 900.0 && main_room_w == 900.0 && panel_w == 400.0 && panel_room_w == 400.0,
    "actual main/panel widths=" + main_w.to_string() + "/" + panel_w.to_string(),
  )
  t.dispose()
}

test "window_frame zero inside secondary scope targets primary window" { check_window_frame_zero_target(false) }
test "window_frame zero with explicit primary scope targets primary window" { check_window_frame_zero_target(true) }
