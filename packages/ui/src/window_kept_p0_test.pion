test "window_switch_guard_error blocks lifecycle re-entry during take, restore, and fresh" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let checked_take = signals::ref_new(false)
  let checked_restore = signals::ref_new(false)
  let checked_fresh = signals::ref_new(false)
  let check_all_guarded = fn(phase : String) {
    debug_assert(window_switch_guard_error("set_view_app").is_some(), phase + ": set_view_app must be guarded")
    debug_assert(window_switch_guard_error("view_forget").is_some(), phase + ": view_forget must be guarded")
    debug_assert(window_switch_guard_error("window_open_here").is_some(), phase + ": window_open_here must be guarded")
    debug_assert(window_switch_guard_error("window_close_here").is_some(), phase + ": window_close_here must be guarded")
    debug_assert(window_switch_guard_error("in_window").is_some(), phase + ": in_window must be guarded")
    debug_assert(window_switch_guard_error("window_kept").is_some(), phase + ": window_kept must be guarded")
  }
  let check_all_clear = fn(phase : String) {
    debug_assert(window_switch_guard_error("set_view_app").is_none(), phase + ": set_view_app must be clear")
    debug_assert(window_switch_guard_error("view_forget").is_none(), phase + ": view_forget must be clear")
    debug_assert(window_switch_guard_error("window_open_here").is_none(), phase + ": window_open_here must be clear")
    debug_assert(window_switch_guard_error("window_close_here").is_none(), phase + ": window_close_here must be clear")
    debug_assert(window_switch_guard_error("in_window").is_none(), phase + ": in_window must be clear")
    debug_assert(window_switch_guard_error("window_kept").is_none(), phase + ": window_kept must be clear")
  }
  window_kept(
    fn() {
      checked_take.v = true
      check_all_guarded("take")
      fn() {
        checked_restore.v = true
        check_all_guarded("restore")
      }
    },
    fn() {
      checked_fresh.v = true
      check_all_guarded("fresh")
    },
  )
  check_all_clear("before switch")
  in_window(23, fn() {
    check_all_clear("inside body")
  })
  check_all_clear("after switch")
  debug_assert(checked_take.v && checked_restore.v && checked_fresh.v, "all three slot phases ran")
  t.dispose()
}

test "secondary app replacement resets primary narrow policy" {
  let t = Tester::tree(fn(_ : view::View) { () }, width=800.0)
  set_narrow_enabled(true)
  set_narrow_below(900.0)
  debug_assert(tree_narrow(), "old primary narrow positive control")
  in_window(23, fn() { set_view_app(fn(_ : view::View) { () }) })
  t.frame()
  debug_assert(!tree_narrow(), "replacement primary retained old enabled flag")
  set_narrow_enabled(true)
  debug_assert(!tree_narrow(), "replacement primary retained old breakpoint")
  t.dispose()
}


test "reset disposes multiple secondary trees with isolated multi-owner cleanups" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "fresh" })
  let dropped = signals::ref_new(0)
  let reads : Array[String] = []
  set_window_tree(fn(_wid : Int, what : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "sec:" + what
      let _ = root.owns(fn() {
        dropped.v = dropped.v + 1
        reads.push(draft.v)
        draft.v = "cleanup1:" + what
      })
      let _ = root.owns(fn() {
        dropped.v = dropped.v + 1
        reads.push(draft.v)
        draft.v = "cleanup2:" + what
      })
    }
  })
  let a = window_open_here("A")
  let b = window_open_here("B")
  guard a > 0 && b > 0 && a != b else { panic("two windows required") }
  let first = match window_tree_of(a) { Some(tr) => tr; None => panic("missing secondary tree") }
  let second = match window_tree_of(b) { Some(tr) => tr; None => panic("missing secondary tree") }
  let next_draft = signals::ref_new("")
  set_view_app(fn(_ : view::View) { next_draft.v = draft.v })
  debug_assert(dropped.v == 4 && first.alive() == 0 && second.alive() == 0, "secondary releases: " + dropped.v.to_string())
  debug_assert(next_draft.v == "primary" && reads.length() == 4, "primary draft preserved across multi-cleanup reset")
  t.dispose()
}

test "reset size notification cannot reinstall superseded app" {
  let t = Tester::tree(fn(_ : view::View) { () }, width=800.0)
  let armed = signals::ref_new(false)
  let nested = signals::ref_new(false)
  let superseded = signals::ref_new(false)
  let stop = signals::effect(fn() {
    let w = window_size_now().0
    if armed.v && w == 0.0 {
      armed.v = false
      set_view_app(fn(_ : view::View) { nested.v = true })
    }
  })
  debug_assert(window_size_now().0 == 800.0, "positive control width")
  armed.v = true
  set_view_app(fn(_ : view::View) { superseded.v = true })
  debug_assert(nested.v, "nested app must be built by size observer")
  debug_assert(!superseded.v, "old builder ran after nested app installation")
  stop()
  t.dispose()
}

fn check_policy_reset_reentry(width : Double) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  set_narrow_enabled(true)
  set_narrow_below(900.0)
  let armed = signals::ref_new(false)
  let last = signals::ref_new(false)
  let nested = signals::ref_new(false)
  let superseded = signals::ref_new(false)
  let stop = signals::ref_new(fn() { () })
  let off = view::Tree::new(fn(_ : view::View) {
    stop.v = signals::effect(fn() {
      let narrow = tree_narrow()
      last.v = narrow
      if armed.v && !narrow {
        armed.v = false
        set_view_app(fn(_ : view::View) { nested.v = true })
      }
    })
  })
  let _ = off.frame(width, 600.0)
  debug_assert(last.v, "positive control: standalone tree was narrow before replacement")
  armed.v = true
  set_view_app(fn(_ : view::View) { superseded.v = true })
  debug_assert(nested.v, "policy change must synchronously install nested app")
  debug_assert(!superseded.v, "policy observer installed nested app then superseded outer builder ran")
  (stop.v)()
  off.dispose()
  t.dispose()
}

test "policy resetting breakpoint can install replacement app" { check_policy_reset_reentry(800.0) }
test "policy resetting enabled flag can install replacement app" { check_policy_reset_reentry(400.0) }


test "main builder replacement keeps inner tree and disposes outer" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let dropped = signals::ref_new(0)
  let inner : signals::Ref[Option[view::View]] = signals::ref_new(None)
  set_view_app(fn(root : view::View) {
    let _ = root.owns(fn() { dropped.v = dropped.v + 1 })
    set_view_app(fn(r : view::View) { inner.v = Some(r) })
  })
  debug_assert(dropped.v == 1, "superseded root not released exactly once")
  match inner.v { Some(r) => debug_assert(r.alive(), "nested root was lost"); None => panic("missing inner") }
  t.dispose()
}

test "theme notification keeps inner application" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let armed = signals::ref_new(true)
  let inner = signals::ref_new(false)
  let outer = signals::ref_new(false)
  let stop = signals::effect(fn() {
    if tree_theme().dark && armed.v {
      armed.v = false
      set_view_app(fn(_ : view::View) { inner.v = true })
    }
  })
  set_view_app(fn(_ : view::View) { outer.v = true }, theme=fn() { Theme::dark() })
  debug_assert(inner.v && !outer.v, "obsolete builder ran after theme replacement")
  stop()
  t.dispose()
}

fn check_host_reset_reentry(which : Int) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  set_system_bars(21.0, 0.0, 0.0, 0.0)
  set_glass_light_angle(0.7)
  let armed = signals::ref_new(true)
  let nested = signals::ref_new(false)
  let outer = signals::ref_new(false)
  let stop = signals::effect(fn() {
    let triggered = if which == 0 { system_bars().top == 0.0 } else if which == 1 { glass_light_angle() == 0.0 } else { window_zoomed() }
    if armed.v && triggered {
      armed.v = false
      set_view_app(fn(_ : view::View) { nested.v = true })
    }
  })
  debug_assert(!nested.v, "baseline did not hold")
  if which == 2 { t.fake.window_zoomed_flag = true }
  set_view_app(fn(_ : view::View) { outer.v = true })
  debug_assert(nested.v, "reset subscriber did not install inner app")
  debug_assert(!outer.v, "superseded builder ran after reset observer installed inner app")
  stop()
  t.dispose()
}

test "system bars reset observer owns application" { check_host_reset_reentry(0) }
test "light angle reset observer owns application" { check_host_reset_reentry(1) }

test "secondary builder app replacement never publishes stale tree" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let built = signals::ref_new(false)
  let dropped = signals::ref_new(0)
  let opened = signals::ref_new(0)
  set_window_tree(fn(wid : Int, _name : String) -> (view::View) -> Unit {
    opened.v = wid
    fn(root : view::View) {
      let _ = root.owns(fn() { dropped.v = dropped.v + 1 })
      set_view_app(fn(_ : view::View) { built.v = true })
    }
  })
  let ret = window_open_here("old secondary")
  debug_assert(ret == 0, "superseded window_open_here must return 0")
  debug_assert(opened.v > 0 && built.v && window_shows(opened.v).is_none(), "new app active and old window listing cleared")
  debug_assert(window_tree_of(opened.v).is_none() && dropped.v == 1, "old window present in tree registry: " + window_tree_of(opened.v).is_some().to_string() + ", cleanup count: " + dropped.v.to_string())
  t.dispose()
}

test "window zoom notification during host reset owns application" { check_host_reset_reentry(2) }


fn verify_window_open_cancellation(phase : Int) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let allocated = signals::ref_new(0)
  let built = signals::ref_new(false)
  let dropped = signals::ref_new(0)
  let replaced = signals::ref_new(false)
  let replace = fn() { set_view_app(fn(_ : view::View) { replaced.v = true }) }
  set_window_tree(fn(wid : Int, _ : String) -> (view::View) -> Unit {
    allocated.v = wid
    if phase == 0 { replace() }
    fn(root : view::View) {
      built.v = true
      let _ = root.owns(fn() { dropped.v = dropped.v + 1 })
      if phase >= 2 { window_close_here(wid) }
      if phase != 2 { replace() }
    }
  })
  let ret = window_open_here("withdrawn")
  let wid = allocated.v
  debug_assert(wid > 0, "host allocated window")
  debug_assert(built.v == (phase != 0) && replaced.v == (phase != 2), "expected callbacks")
  let mut closes = 0
  for line in t.fake.lifecycle_log {
    if line == "window_close_id:" + wid.to_string() { closes = closes + 1 }
  }
  let published = window_tree_of(wid).is_some()
  debug_assert(ret == 0 && !published && window_shows(wid).is_none() && closes == 1 && dropped.v == (if built.v { 1 } else { 0 }),
    "return=" + ret.to_string() + " published=" + published.to_string() + " host closes=" + closes.to_string() + " disposed=" + dropped.v.to_string())
  t.dispose()
}

test "replacement inside secondary factory cancels before construction" { verify_window_open_cancellation(0) }
test "replacement inside secondary builder closes allocated host once" { verify_window_open_cancellation(1) }
test "secondary builder explicitly withdraws its own window" { verify_window_open_cancellation(2) }
test "secondary builder explicitly closes then replaces app" { verify_window_open_cancellation(3) }

test "superseded host allocation leaves no listing or factory calls" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let factory_calls = signals::ref_new(0)
  let allocated = signals::ref_new(0)
  let inner = signals::ref_new(false)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    factory_calls.v = factory_calls.v + 1
    fn(_ : view::View) { () }
  })
  let h = hostapi::host()
  let allocate = h.window_open_id
  h.window_open_id = fn(name : String) -> Int {
    let id = allocate(name)
    allocated.v = id
    set_view_app(fn(_ : view::View) { inner.v = true })
    id
  }
  let ret = window_open_here("cancelled at host")
  h.window_open_id = allocate
  let wid = allocated.v
  let listed = window_shows(wid).is_some()
  let mut closes = 0
  for line in t.fake.lifecycle_log {
    if line == "window_close_id:" + wid.to_string() { closes = closes + 1 }
  }
  debug_assert(wid > 0 && inner.v, "replacement during allocation must complete")
  debug_assert(ret == 0 && !listed && closes == 1 && factory_calls.v == 0,
    "return=" + ret.to_string() + " listed=" + listed.to_string() + " host closes=" + closes.to_string() + " factory calls=" + factory_calls.v.to_string())
  t.dispose()
}


fn check_reopen_during_open(reuse : Bool, check_value~ : Bool = false) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let h = hostapi::host()
  let allocate = h.window_open_id
  let close = h.window_close_id
  let free_id = signals::ref_new(0)
  if reuse {
    h.window_close_id = fn(w : Int) { close(w); free_id.v = w }
    h.window_open_id = fn(name : String) {
      if free_id.v > 0 { let w = free_id.v; free_id.v = 0; w } else { allocate(name) }
    }
  }
  let local = signals::ref_new(42)
  window_kept_ref(local, fn() { -1 })
  let inner_value = signals::ref_new(-2)
  let replacement = signals::ref_new(0)
  let old_id = signals::ref_new(0)
  let releases = signals::ref_new(0)
  set_window_tree(fn(wid : Int, what : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      if what == "old" {
        debug_assert(local.v == -1, "old window received a fresh slot")
        local.v = 23
        old_id.v = wid
        let _ = root.owns(fn() { releases.v = releases.v + 1 })
        window_close_here(wid)
        replacement.v = window_open_here("new")
      } else { inner_value.v = local.v }
    }
  })
  let result = window_open_here("old")
  let w = replacement.v
  debug_assert(result == 0 && w > 0 && (w == old_id.v) == reuse && releases.v == 1, "open and ownership controls")
  debug_assert(window_tree_of(w).is_some(), "replacement has a tree")
  let listed = match window_shows(w) { Some(tag) => tag == "new"; None => false }
  if check_value { debug_assert(inner_value.v == -1, "new window inherited old window value " + inner_value.v.to_string()) }
  debug_assert(listed, "a successful replacement has a tree but lost its listing")
  window_close_here(w)
  h.window_open_id = allocate
  h.window_close_id = close
  t.dispose()
}

test "distinct ids preserve nested secondary replacement" { check_reopen_during_open(false) }
test "reused id preserves nested secondary replacement" { check_reopen_during_open(true) }

test "cancelled builder releases native handle once" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let allocated = signals::ref_new(0)
  let releases = signals::ref_new(0)
  set_window_tree(fn(wid : Int, _name : String) -> (view::View) -> Unit {
    allocated.v = wid
    fn(root : view::View) {
      let _ = root.owns(fn() { releases.v = releases.v + 1 })
      set_view_app(fn(_ : view::View) { () })
    }
  })
  let result = window_open_here("cancelled")
  let w = allocated.v
  let mut closes = 0
  for entry in t.fake.lifecycle_log {
    if entry == "window_close_id:" + w.to_string() { closes = closes + 1 }
  }
  debug_assert(w > 0 && result == 0 && releases.v == 1 && window_tree_of(w).is_none(), "cancelled builder was released")
  debug_assert(closes == 1, "native closes=" + closes.to_string())
  t.dispose()
}

test "immediate slot reuse gets fresh per-window value" { check_reopen_during_open(true, check_value=true) }
test "distinct slot gets fresh per-window value" { check_reopen_during_open(false, check_value=true) }


fn setup_recycled_window_host(_t : Tester) -> () -> Unit {
  let h = hostapi::host()
  let allocate = h.window_open_id
  let close = h.window_close_id
  let free = signals::ref_new(0)
  h.window_close_id = fn(w : Int) { close(w); free.v = w }
  h.window_open_id = fn(name : String) {
    if free.v == 0 { allocate(name) } else {
      let w = free.v
      free.v = 0
      w
    }
  }
  fn() { h.window_open_id = allocate; h.window_close_id = close }
}

test "old effect cannot poll replacement host at same numeric id" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let reset_host = setup_recycled_window_host(t)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { fn(_ : view::View) { () } })
  let a = window_open_here("old")
  let tick = signals::signal(0)
  let observed = signals::ref_new(false)
  let stop = signals::ref_new(fn() { () })
  in_window(a, fn() {
    t.fake.window_zoomed_flag = true
    stop.v = signals::effect(fn() { let _ = tick.get(); observed.v = window_zoomed() })
  })
  debug_assert(a > 0 && observed.v, "old owner was zoomed")
  window_close_here(a)
  let b = window_open_here("new")
  debug_assert(a == b && window_tree_of(b).is_some(), "host reused id after prior close returned")
  in_window(b, fn() {
    t.fake.window_zoomed_flag = false
    debug_assert(!window_zoomed(), "new host is not zoomed")
    tick.set(1)
  })
  debug_assert(observed.v, "old effect observed new instance's native zoom")
  (stop.v)()
  window_close_here(b)
  reset_host()
  t.dispose()
}

test "disposing withdrawn secondary root preserves recycled successor" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let reset_host = setup_recycled_window_host(t)
  let new_id = signals::ref_new(0)
  let releases = signals::ref_new(0)
  set_window_tree(fn(w : Int, name : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      if name == "old" {
        let _ = root.owns(fn() { () })
        window_close_here(w)
        new_id.v = window_open_here("new")
      } else {
        let _ = root.owns(fn() { releases.v = releases.v + 1 })
      }
    }
  })
  let ret = window_open_here("old")
  let b = new_id.v
  debug_assert(ret == 0 && b > 0, "old cancelled, successor opened")
  debug_assert(window_tree_of(b).is_some() && window_shows(b).is_some() && releases.v == 0,
    "successor's registered tree=" + window_tree_of(b).is_some().to_string() + ", successor releases=" + releases.v.to_string())
  window_close_here(b)
  reset_host()
  t.dispose()
}

fn check_fresh_room_for_instance(reuse : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let reset_host = if reuse { setup_recycled_window_host(t) } else { fn() { () } }
  let captured = signals::ref_new(-1.0)
  window_kept_ref(captured, fn() { window_size_now().0 })
  let seen = signals::ref_new(-1.0)
  let replacement = signals::ref_new(0)
  set_window_tree(fn(w : Int, name : String) -> (view::View) -> Unit {
    fn(_root : view::View) {
      if name == "old" {
        let off = view::Tree::new(fn(root : view::View) {
          root.reacts(fn() { window_size_now().0 }, fn(width) {
            if width == 400.0 {
              window_close_here(w)
              replacement.v = window_open_here("new")
            }
          })
        })
        let _ = off.frame(400.0, 600.0)
        off.dispose()
      } else { seen.v = captured.v }
    }
  })
  let result = window_open_here("old")
  debug_assert(result == 0 && replacement.v > 0 && window_tree_of(replacement.v).is_some(), "new instance was published")
  debug_assert(seen.v == 0.0, "new window initializer captured old tree width " + seen.v.to_string())
  window_close_here(replacement.v)
  reset_host()
  t.dispose()
}

test "fresh callback for reused instance sees new room" { check_fresh_room_for_instance(true) }
test "fresh callback for distinct instance sees new room" { check_fresh_room_for_instance(false) }


fn setup_recycled_close_host() -> () -> Unit {
  let h = hostapi::host()
  let open = h.window_open_id
  let close = h.window_close_id
  let freed = signals::ref_new(0)
  h.window_close_id = fn(w : Int) { close(w); freed.v = w }
  h.window_open_id = fn(name : String) {
    if freed.v == 0 { open(name) } else { let w = freed.v; freed.v = 0; w }
  }
  fn() { h.window_open_id = open; h.window_close_id = close }
}

test "close listener replacement survives outer close" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let undo = setup_recycled_close_host()
  let closed = signals::ref_new(0)
  let successor = signals::ref_new(0)
  set_window_tree(fn(_w : Int, _name : String) -> (view::View) -> Unit {
    fn(_root : view::View) { () }
  })
  let a = window_open_here("old")
  debug_assert(a > 0 && window_tree_of(a).is_some(), "old open completed")
  when_window_closed(fn(w : Int) {
    if w == a {
      closed.v = closed.v + 1
      if closed.v == 1 { successor.v = window_open_here("new") }
    }
  })
  window_close_here(a)
  let mut calls = 0
  for line in t.fake.lifecycle_log {
    if line == "window_close_id:" + a.to_string() { calls = calls + 1 }
  }
  let listed = match window_shows(a) { Some(name) => name == "new"; None => false }
  debug_assert(successor.v == a && window_tree_of(a).is_some(), "new instance opened in close callback")
  debug_assert(listed, "outer close erased successor listing, native close calls=" + calls.to_string())
  debug_assert(calls == 1 && closed.v == 1, "native closes=" + calls.to_string() + ", close notifications=" + closed.v.to_string())
  undo()
  t.dispose()
}

test "stale owner outside disposal preserves successor" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let undo = setup_recycled_close_host()
  let tick = signals::signal(false)
  let attempts = signals::ref_new(0)
  let stop = signals::ref_new(fn() { () })
  set_window_tree(fn(_w : Int, _name : String) -> (view::View) -> Unit {
    fn(_root : view::View) { () }
  })
  let a = window_open_here("old")
  in_window(a, fn() {
    stop.v = signals::effect(fn() {
      if tick.get() { attempts.v = attempts.v + 1; window_close_here(a) }
    })
  })
  window_close_here(a)
  let b = window_open_here("new")
  debug_assert(a > 0 && b == a, "new instance reused id")
  tick.set(true)
  debug_assert(attempts.v == 1, "one stale owner attempted close")
  debug_assert(window_tree_of(b).is_some() && window_shows(b).is_some(), "stale effect closed the successor")
  (stop.v)()
  undo()
  t.dispose()
}


test "close from inside secondary window disposes with kept state without running fresh" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft : signals::Ref[String] = signals::ref_new("main")
  let fresh_runs : signals::Ref[Int] = signals::ref_new(0)
  window_kept_ref(draft, fn() { fresh_runs.v = fresh_runs.v + 1; "" })
  let seen : signals::Ref[String] = signals::ref_new("<none>")
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "typed in secondary"
      let _ = root.owns(fn() { seen.v = draft.v })
    }
  })
  let wid = window_open_here("W")
  guard wid > 0 else { panic("window required") }
  let fresh_before = fresh_runs.v
  in_window(wid, fn() { window_close_here(wid) })
  debug_assert(seen.v == "typed in secondary", "dispose saw draft '\{seen.v}'")
  debug_assert(fresh_runs.v == fresh_before, "closing must not run fresh() again (ran \{fresh_runs.v - fresh_before} more)")
  debug_assert(draft.v == "main", "main window draft restored, got '\{draft.v}'")
  t.dispose()
}

test "close from main window disposes secondary with its kept state" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft : signals::Ref[String] = signals::ref_new("main")
  window_kept_ref(draft, fn() { "" })
  let seen : signals::Ref[String] = signals::ref_new("<none>")
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "typed in secondary"
      let _ = root.owns(fn() { seen.v = draft.v })
    }
  })
  let wid = window_open_here("W")
  guard wid > 0 else { panic("window required") }
  window_close_here(wid)
  debug_assert(seen.v == "typed in secondary", "dispose saw draft '\{seen.v}'")
  debug_assert(draft.v == "main", "main window draft restored, got '\{draft.v}'")
  t.dispose()
}

fn check_close_owner_context(from_inside : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let value = signals::ref_new(5)
  window_kept_ref(value, fn() { -1 })
  let cleanup = signals::ref_new(-2)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      value.v = 23
      let _ = root.owns(fn() { cleanup.v = value.v })
    }
  })
  let w = window_open_here("test")
  debug_assert(w > 0 && value.v == 5, "primary restored after open")
  if from_inside {
    in_window(w, fn() {
      debug_assert(value.v == 23, "active window has its state")
      window_close_here(w)
    })
  } else { window_close_here(w) }
  debug_assert(cleanup.v == 23, "teardown read " + cleanup.v.to_string() + " instead of owner value 23")
  t.dispose()
}

test "close from primary restores secondary state for cleanup" { check_close_owner_context(false) }
test "close from secondary preserves secondary state for cleanup" { check_close_owner_context(true) }

fn check_normal_close_isolation(check_read : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "empty" })
  let observed = signals::ref_new("")
  let owner = signals::ref_new(-1)
  let drops = signals::ref_new(0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "secondary"
      let _ = root.owns(fn() {
        drops.v = drops.v + 1
        owner.v = current_window_id()
        observed.v = draft.v
        draft.v = "cleared by old root"
      })
    }
  })
  let w = window_open_here("test")
  debug_assert(w > 0 && draft.v == "primary", "secondary was initialized and primary restored")
  window_close_here(w)
  debug_assert(drops.v == 1 && window_tree_of(w).is_none(), "disposal control")
  if check_read {
    debug_assert(observed.v == "secondary" && owner.v == w, "cleanup read=" + observed.v + ", window=" + owner.v.to_string())
  } else {
    debug_assert(draft.v == "primary", "main draft after cleanup=" + draft.v)
  }
  t.dispose()
}

test "normal close reads secondary state during cleanup" { check_normal_close_isolation(true) }
test "normal close keeps primary writes isolated from cleanup" { check_normal_close_isolation(false) }

test "reset secondary teardown reads its cached host state" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let installed = signals::ref_new(false)
  let seen = signals::ref_new(-1)
  let zoomed = signals::ref_new(false)
  let drops = signals::ref_new(0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      t.fake.window_snap_state_val = 3
      t.fake.window_zoomed_flag = true
      debug_assert(window_snap_state() == 3 && window_zoomed(), "old window has cached native values")
      let _ = root.owns(fn() {
        seen.v = window_snap_state()
        zoomed.v = window_zoomed()
        drops.v = drops.v + 1
      })
    }
  })
  let w = window_open_here("old")
  t.fake.window_snap_state_val = 0
  t.fake.window_zoomed_flag = false
  debug_assert(w > 0 && window_snap_state() == 0 && !window_zoomed(), "main native state is different")
  set_view_app(fn(_ : view::View) { installed.v = true })
  debug_assert(installed.v && drops.v == 1, "reset released old secondary tree")
  debug_assert(seen.v == 3 && zoomed.v, "old teardown observed snap=" + seen.v.to_string() + " zoomed=" + zoomed.v.to_string())
  t.dispose()
}


test "detached secondary effect stays detached after calling in_window(0)" {
  let t = Tester::tree(fn(_ : view::View) { () })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { fn(_ : view::View) { () } })
  let w = window_open_here("sec")
  let tick = signals::signal(0)
  let before_snap = signals::ref_new(-1)
  let before_zoomed = signals::ref_new(false)
  let inner_snap = signals::ref_new(-1)
  let inner_zoomed = signals::ref_new(true)
  let after_snap = signals::ref_new(-1)
  let after_zoomed = signals::ref_new(false)
  let stop = signals::ref_new(fn() { () })
  in_window(w, fn() {
    t.fake.window_snap_state_val = 2
    t.fake.window_zoomed_flag = true
    debug_assert(window_snap_state() == 2 && window_zoomed(), "secondary cached native values")
    stop.v = signals::effect(fn() {
      if tick.get() > 0 {
        before_snap.v = window_snap_state()
        before_zoomed.v = window_zoomed()
        in_window(0, fn() {
          inner_snap.v = window_snap_state()
          inner_zoomed.v = window_zoomed()
        })
        after_snap.v = window_snap_state()
        after_zoomed.v = window_zoomed()
      }
    })
  })
  t.fake.window_snap_state_val = 0
  t.fake.window_zoomed_flag = false
  debug_assert(window_snap_state() == 0 && !window_zoomed(), "main window native values")
  tick.set(1)
  debug_assert(before_snap.v == 2 && before_zoomed.v, "detached effect before in_window(0)")
  debug_assert(inner_snap.v == 0 && !inner_zoomed.v, "in_window(0) reads native main window")
  debug_assert(after_snap.v == 2 && after_zoomed.v, "detached effect after in_window(0) must still read cached secondary values")
  (stop.v)()
  window_close_here(w)
  t.dispose()
}


fn check_teardown_nested_in_window(which : Int) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let cleanup = signals::ref_new(false)
  let phase_snap = signals::ref_new(-1)
  let back_snap = signals::ref_new(-1)
  let self_snap = signals::ref_new(-1)
  let main_snap = signals::ref_new(-1)
  let count = signals::ref_new(0)
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "new window" })
  window_kept(fn() {
    let old = current_window_id()
    if cleanup.v && old != 0 {
      phase_snap.v = window_snap_state()
    }
    fn() {
      if cleanup.v && old != 0 { back_snap.v = window_snap_state() }
    }
  }, fn() { () })
  set_window_tree(fn(wid : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      t.fake.window_snap_state_val = 3
      debug_assert(window_snap_state() == 3, "cache old host")
      let _ = root.owns(fn() {
        count.v = count.v + 1
        cleanup.v = true
        debug_assert(window_snap_state() == 3, "old root starts detached")
        if which == 2 {
          in_window(wid, fn() { self_snap.v = window_snap_state() })
        } else {
          in_window(0, fn() {
            main_snap.v = window_snap_state()
            draft.v = "written to main"
          })
        }
        cleanup.v = false
      })
    }
  })
  let w = window_open_here("secondary")
  t.fake.window_snap_state_val = 0
  debug_assert(w > 0 && window_snap_state() == 0, "main host active")
  set_view_app(fn(_ : view::View) { () })
  debug_assert(count.v == 1, "old tree released once")
  if which != 2 { debug_assert(main_snap.v == 0, "explicit main reads main host") }
  if which == 0 { debug_assert(phase_snap.v == 3 && back_snap.v == 3, "old take/restore observed " + phase_snap.v.to_string() + "/" + back_snap.v.to_string()) }
  if which == 1 { debug_assert(draft.v == "written to main", "main write after teardown: " + draft.v) }
  if which == 2 { debug_assert(self_snap.v == 3, "same window read " + self_snap.v.to_string()) }
  t.dispose()
}

test "detached source take and restore use cached host during teardown" { check_teardown_nested_in_window(0) }
test "explicit main write survives old root teardown" { check_teardown_nested_in_window(1) }
test "explicit current window inside old cleanup preserves cached host" { check_teardown_nested_in_window(2) }


fn check_reset_preserves_owners(replace : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "fresh" })
  let who = signals::ref_new(-1)
  let read = signals::ref_new("")
  let drops = signals::ref_new(0)
  let next = signals::ref_new("")
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "secondary"
      let _ = root.owns(fn() {
        drops.v = drops.v + 1
        who.v = current_window_id()
        read.v = draft.v
        draft.v = "cleared by secondary"
      })
    }
  })
  let w = window_open_here("secondary")
  debug_assert(w > 0 && draft.v == "primary", "main owns its original draft")
  if !replace { window_close_here(w) }
  set_view_app(fn(_ : view::View) { next.v = draft.v })
  debug_assert(drops.v == 1, "secondary cleanup ran once")
  debug_assert(who.v == w && read.v == "secondary" && next.v == "primary",
    "cleanup window=" + who.v.to_string() + " read=" + read.v + " replacement read=" + next.v)
  t.dispose()
}

test "explicit close preserves both primary and secondary owners" { check_reset_preserves_owners(false) }
test "app reset preserves both primary and secondary owners" { check_reset_preserves_owners(true) }

fn check_disposing_instance_roundtrip(via_main : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "fresh" })
  let seen = signals::ref_new("")
  let snap = signals::ref_new(-1)
  let released = signals::ref_new(0)
  set_window_tree(fn(wid : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "secondary"
      t.fake.window_snap_state_val = 3
      debug_assert(window_snap_state() == 3, "cached old native state")
      let _ = root.owns(fn() {
        released.v = released.v + 1
        let capture = fn() { in_window(wid, fn() {
          seen.v = draft.v
          snap.v = window_snap_state()
        }) }
        if via_main { in_window(0, capture) } else { capture() }
      })
    }
  })
  let w = window_open_here("secondary")
  debug_assert(w > 0, "secondary opened")
  t.fake.window_snap_state_val = 0
  set_view_app(fn(_ : view::View) { () })
  debug_assert(released.v == 1, "one cleanup")
  debug_assert(seen.v == "secondary" && snap.v == 3, "old window draft=" + seen.v + " snap=" + snap.v.to_string())
  t.dispose()
}

test "direct reentry into disposing instance preserves cached state" { check_disposing_instance_roundtrip(false) }
test "reentry into disposing instance from explicit main preserves cached state" { check_disposing_instance_roundtrip(true) }


fn check_primary_and_secondary_disposal(from_secondary : Bool) -> Unit {
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "fresh" })
  let who = signals::ref_new(-1)
  let observed = signals::ref_new("")
  let secondary = signals::ref_new("")
  let next = signals::ref_new("")
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.owns(fn() {
      who.v = current_window_id()
      observed.v = draft.v
      draft.v = "primary cleanup"
    })
  })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      draft.v = "secondary"
      let _ = root.owns(fn() { secondary.v = draft.v })
    }
  })
  let w = window_open_here("secondary")
  debug_assert(w > 0 && draft.v == "primary", "initial primary")
  let replace = fn() { set_view_app(fn(_ : view::View) { next.v = draft.v }) }
  if from_secondary { in_window(w, replace) } else { replace() }
  debug_assert(who.v == 0 && observed.v == "primary" && secondary.v == "secondary" && next.v == "primary cleanup",
    "primary cleanup owner=" + who.v.to_string() + " value=" + observed.v + " secondary=" + secondary.v + " next=" + next.v)
  t.dispose()
}

test "main initiates main and secondary disposal in own contexts" { check_primary_and_secondary_disposal(false) }
test "secondary initiates main and secondary disposal in own contexts" { check_primary_and_secondary_disposal(true) }

fn check_overlay_reset_main_signal(via_effect : Bool) -> Unit {
  let t = Tester::tree(fn(_ : view::View) { () }, width=1000.0)
  let width = signals::ref_new(-1.0)
  let tick = signals::signal(0)
  let replace = fn() { set_view_app(fn(_ : view::View) { () }) }
  let stop = signals::ref_new(fn() { () })
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.owns(fn() { in_window(0, fn() { width.v = window_size_now().0 }) })
    }
  })
  let w = window_open_here("secondary")
  in_window(w, fn() {
    stop.v = signals::effect(fn() { if tick.get() > 0 { replace() } })
  })
  debug_assert(window_size_now().0 == 1000.0, "main width before reset")
  if via_effect { tick.set(1) } else { replace() }
  debug_assert(width.v == 1000.0, "explicit main width during reset=" + width.v.to_string())
  (stop.v)()
  t.dispose()
}

test "reset from main provides real main signal in cleanup" { check_overlay_reset_main_signal(false) }
test "reset from detached effect provides real main signal in cleanup" { check_overlay_reset_main_signal(true) }

test "cancelled secondary builder cleanup preserves new main" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let draft = signals::ref_new("primary")
  window_kept_ref(draft, fn() { "fresh" })
  let who = signals::ref_new(-1)
  let seen = signals::ref_new("")
  let owner = signals::ref_new(-1)
  set_window_tree(fn(wid : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      owner.v = wid
      draft.v = "secondary"
      let _ = root.owns(fn() {
        who.v = current_window_id()
        seen.v = draft.v
        draft.v = "secondary cleanup"
      })
      set_view_app(fn(_ : view::View) { draft.v = "replacement" })
    }
  })
