test "effect created inside explicit secondary window from primary effect is not detached" {
  let t = Tester::tree(fn(_ : view::View) { () })
  let tick = signals::signal(0)
  let sec_tick = signals::signal(0)
  let sec_snap = signals::ref_new(-1)
  let sec_stop = signals::ref_new(fn() { () })
  let stop = signals::effect(fn() {
    if tick.get() == 1 {
      in_window(23, fn() {
        t.fake.window_snap_state_val = 2
        sec_stop.v = signals::effect(fn() {
          let _ = sec_tick.get()
          sec_snap.v = window_snap_state()
        })
      })
    }
  })
  tick.set(1)
  debug_assert(sec_snap.v == 2, "initial secondary effect read 2")
  // Trigger inside window 23: must NOT be detached, so host update 4 is observed!
  in_window(23, fn() {
    t.fake.window_snap_state_val = 4
    sec_tick.set(1)
  })
  debug_assert(sec_snap.v == 4, "active secondary effect inside window 23 must observe live host value 4")
  (sec_stop.v)()
  stop()
  t.dispose()
}

test "scoped computed gives same width through untracked accessor" {
  let t = Tester::tree(fn(_ : view::View) { () }, width=1000.0)
  let c : signals::Ref[Option[signals::Computed[Double]]] = signals::ref_new(None)
  let off = view::Tree::new(fn(_ : view::View) {
    c.v = Some(signals::computed_scoped(
      fn(_ : Option[Double]) { window_size_now().0 },
      untracked_read=Some(fn() { Some(window_size_now().0) }),
    ))
  })
  let _ = off.frame(400.0, 600.0)
  match c.v {
    Some(held) => {
      let tracked = signals::ref_new(-1.0)
      let stop = signals::effect(fn() { tracked.v = held.get() })
      debug_assert(tracked.v == 400.0, "tracked getter must see its tree")
      let n = held.untracked()
      debug_assert(n == 400.0, "untracked accessor got " + n.to_string())
      stop()
      held.dispose()
    }
    None => panic("missing computed")
  }
  off.dispose()
  t.dispose()
}

