// Wave P0-1A unit tests:
// - Cross-package `signals::Ref[T]` identity & forwarders (`signals`, `view`, `ui`)
// - `in_window` identity timing, late registration, re-entrancy guard, `window_kept_{ref,map,array}`
// - Per-tree stable `room_signal()` / `current_tree_room()` & offscreen `encode_tree_scene` isolation
// - Reactive `window_zoomed()` and `window_snap_state()` aliases with per-window isolation

import "hostapi"
import "signals"
import "view"

fn mutate_int_ref(r : signals::Ref[Int], next : Int) -> Unit {
  r.v = next
}

test "p0-1a: cross-package Ref[T] mutation and unique phys_id across forwarders" {
  let r_sig : signals::Ref[Int] = signals::ref_new(1)
  let r_view : signals::Ref[Int] = view::ref_new(2)
  let r_ui : signals::Ref[Int] = ref_new(3)
  let r_str : signals::Ref[String] = view::ref_new("a")

  debug_assert(r_sig.phys_id < r_view.phys_id, "signals::ref_new < view::ref_new")
  debug_assert(r_view.phys_id < r_ui.phys_id, "view::ref_new < ui::ref_new")
  debug_assert(r_ui.phys_id < r_str.phys_id, "distinct T phys_id strictly monotonic")

  mutate_int_ref(r_sig, 11)
  mutate_int_ref(r_view, 22)
  mutate_int_ref(r_ui, 33)
  debug_assert(r_sig.v == 11 && r_view.v == 22 && r_ui.v == 33, "cross-package in-place mutation")
}

test "p0-1a: in_window A -> B(late register) -> A -> B -> C, aliases, self-alias array fresh, signal isolation, and re-entrancy guard" {
  let _ = windows_reset()

  // Pre-registered containers + aliases
  let kept_r : signals::Ref[Int] = signals::ref_new(10)
  let kept_m : Map[String, Int] = Map::new()
  let kept_m_alias = kept_m
  let kept_set : Map[String, Unit] = Map::new()
  let kept_arr_default : Array[Int] = []
  let kept_arr_alias = kept_arr_default
  let kept_arr_self : Array[Int] = [7, 8]
  let kept_sig_ref : signals::Ref[signals::Signal[Int]] = signals::ref_new(signals::signal(0))

  // Track `current_window_id()` observed inside `fresh` and `restore`, plus re-entrancy guard checks
  let fresh_wids : Array[Int] = []
  let restore_wids : Array[Int] = []
  let guard_checked_take : signals::Ref[Bool] = signals::ref_new(false)
  let guard_checked_restore : signals::Ref[Bool] = signals::ref_new(false)
  let guard_checked_fresh : signals::Ref[Bool] = signals::ref_new(false)

  window_kept(
    fn() {
      debug_assert(
        window_switch_guard_error("window_kept").is_some() &&
        window_switch_guard_error("in_window").is_some(),
        "re-entrancy guard must be active inside take callback",
      )
      guard_checked_take.v = true
      fn() {
        debug_assert(
          window_switch_guard_error("window_kept").is_some() &&
          window_switch_guard_error("in_window").is_some(),
          "re-entrancy guard must be active inside restore callback",
        )
        guard_checked_restore.v = true
        restore_wids.push(current_window_id())
      }
    },
    fn() {
      debug_assert(
        window_switch_guard_error("window_kept").is_some() &&
        window_switch_guard_error("in_window").is_some(),
        "re-entrancy guard must be active inside fresh callback",
      )
      guard_checked_fresh.v = true
      fresh_wids.push(current_window_id())
    },
  )

  window_kept_ref(kept_r, fn() { current_window_id() * 100 })
  window_kept_map(kept_m)
  window_kept_map(kept_set)
  window_kept_array(kept_arr_default)
  // Self-aliasing fresh: returns the same array `kept_arr_self` after pushing a window tag!
  window_kept_array(kept_arr_self, fresh=fn() {
    let w = current_window_id()
    kept_arr_self.push(w)
    kept_arr_self
  })
  window_kept_ref(kept_sig_ref, fn() { signals::signal(current_window_id()) })

  // Window A (wid = 0): populate state and attach an effect on A's signal
  kept_r.v = 11
  kept_m["k"] = 1
  kept_set["a_only"] = ()
  kept_arr_default.push(101)
  let a_sig_fires : signals::Ref[Int] = signals::ref_new(0)
  let stop_a = signals::effect(fn() {
    let _ = kept_sig_ref.v.get()
    a_sig_fires.v = a_sig_fires.v + 1
  })
  debug_assert(a_sig_fires.v == 1, "window A effect runs once initially")

  // Late-registered slot (registered inside B's body!)
  let late_ref : signals::Ref[Int] = signals::ref_new(-1)
  let late_fresh_wids : Array[Int] = []

  // Step 1: A (0) -> B (101) with late registration
  in_window(101, fn() {
    debug_assert(current_window_id() == 101, "in B body wid == 101")
    debug_assert(window_switch_guard_error("window_kept").is_none(), "normal body allows window_kept")
    debug_assert(kept_r.v == 10100, "fresh saw wid == 101")
    debug_assert(kept_m_alias.length() == 0, "map cleared in place preserving alias")
    debug_assert(kept_set.length() == 0, "set-map cleared in B")
    debug_assert(kept_arr_alias.length() == 0, "1-arg array defaults to empty preserving alias")
    // Self-aliasing fresh preserved elements instead of wiping itself!
    debug_assert(
      kept_arr_self.length() == 3 && kept_arr_self[0] == 7 && kept_arr_self[1] == 8 && kept_arr_self[2] == 101,
      "self-aliasing array fresh must copy before clearing",
    )

    // Mutate B's state and B's signal (must NOT wake A's effect!)
    kept_r.v = 202
    kept_m["k"] = 2
    kept_set["b_only"] = ()
    kept_arr_default.push(202)
    kept_sig_ref.v.set(999)
    debug_assert(a_sig_fires.v == 1, "mutating B's signal must not wake A's effect")

    // Late registration inside B's body
    late_ref.v = 555
    window_kept_ref(late_ref, fn() {
      let w = current_window_id()
      late_fresh_wids.push(w)
      w + 1000
    })
  })

  // Step 2: Back in A (0) — A restored, late_ref ran fresh under wid == 0!
  debug_assert(current_window_id() == 0, "returned to window A (0)")
  debug_assert(kept_r.v == 11, "A ref restored")
  match kept_m_alias.get("k") {
    Some(v) => debug_assert(v == 1, "A map restored via alias")
    None => debug_assert(false, "A map missing key k")
  }
  debug_assert(kept_set.get("a_only").is_some() && kept_set.get("b_only").is_none(), "A set-map restored")
  debug_assert(kept_arr_alias.length() == 1 && kept_arr_alias[0] == 101, "A array restored via alias")
  debug_assert(kept_arr_self.length() == 2 && kept_arr_self[0] == 7 && kept_arr_self[1] == 8, "A self-alias array restored")
  debug_assert(late_ref.v == 1000, "late-registered slot ran fresh for A with wid == 0")
  debug_assert(late_fresh_wids.length() == 1 && late_fresh_wids[0] == 0, "late fresh saw wid == 0 on return to A")

  // Step 3: Re-enter B (101) — B's saved values (including late_ref == 555) restored!
  in_window(101, fn() {
    debug_assert(current_window_id() == 101, "re-entered B")
    debug_assert(kept_r.v == 202, "B ref restored")
    match kept_m_alias.get("k") {
      Some(v) => debug_assert(v == 2, "B map restored")
      None => debug_assert(false, "B map missing key k")
    }
    debug_assert(kept_set.get("b_only").is_some() && kept_set.get("a_only").is_none(), "B set-map restored")
    debug_assert(kept_arr_alias.length() == 1 && kept_arr_alias[0] == 202, "B array restored")
    debug_assert(late_ref.v == 555, "B preserved its late-registered value")
  })

  // Step 4: Open brand new window C (102)
  in_window(102, fn() {
    debug_assert(current_window_id() == 102, "entered C")
    debug_assert(kept_r.v == 10200, "C ref initialized fresh with wid == 102")
    debug_assert(kept_m_alias.length() == 0, "C map starts empty")
    debug_assert(kept_arr_alias.length() == 0, "C array starts empty")
    debug_assert(late_ref.v == 1102, "C late_ref initialized fresh with wid == 102")
  })

  debug_assert(guard_checked_take.v && guard_checked_restore.v && guard_checked_fresh.v, "all 3 switching callbacks verified guard")
  // fresh_wids should have observed 101 (B) and 102 (C)
  debug_assert(fresh_wids.length() == 2 && fresh_wids[0] == 101 && fresh_wids[1] == 102, "fresh saw target wid")
  // restore_wids should have observed 0 (return A), 101 (re-enter B), 0 (return A), 0 (return A from C)
  debug_assert(
    restore_wids.length() == 4 &&
    restore_wids[0] == 0 &&
    restore_wids[1] == 101 &&
    restore_wids[2] == 0 &&
    restore_wids[3] == 0,
    "restore saw target wid on every switch",
  )

  stop_a()
  let _ = windows_reset()
}

test "p0-1a: offscreen standalone Tree::new inside 1000px narrow-enabled main window flips 400 -> 1000 -> 400 with zero cross-wakeups" {
  let main_effect_runs : signals::Ref[Int] = signals::ref_new(0)
  let main_narrow_seen : signals::Ref[Bool] = signals::ref_new(false)
  let offscreen_bind_runs : signals::Ref[Int] = signals::ref_new(0)
  let offscreen_last_label : signals::Ref[String] = signals::ref_new("")

  // 1. Start a 1000px main window with narrow mode enabled
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.words(
        view::Live::By(fn() {
          if tree_narrow() { "main-narrow" } else { "main-wide" }
        }),
        look=view::words_plain,
      )
    },
    width=1000.0,
    height=600.0,
  )
  // Default narrow_enabled is false
  debug_assert(!tree_narrow(), "tree_narrow defaults to false")
  set_narrow_enabled(true)
  t.frame()
  debug_assert(!tree_narrow(), "1000px main window is wide when narrow_below=700")
  debug_assert(t.find("main-wide").is_some(), "main window renders wide")

  // Attach an effect on the main window reading window_size_now() & tree_narrow()
  let stop_main_eff = signals::effect(fn() {
    let _ = window_size_now()
    main_narrow_seen.v = tree_narrow()
    main_effect_runs.v = main_effect_runs.v + 1
  })
  let main_runs_before_offscreen = main_effect_runs.v

  // 2. Directly build a standalone offscreen tree while the 1000px main window is active
  let offscreen = view::Tree::new(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b
          .fill()
          .ground(
            view::Live::By(fn() {
              offscreen_bind_runs.v = offscreen_bind_runs.v + 1
              if tree_narrow() {
                offscreen_last_label.v = "narrow"
                rgba(220, 40, 40, 255)
              } else {
                offscreen_last_label.v = "wide"
                rgba(40, 120, 220, 255)
              }
            }),
          )
          .words(
            view::Live::By(fn() {
              if tree_narrow() { "off-narrow" } else { "off-wide" }
            }),
            look=view::words_plain,
          )
      })
    },
    measure=host_words_measure,
    measure_runs=host_runs_measure,
    measure_runs_least=host_runs_least_measure,
  )

  // Verify room_signal() is exported and distinct from main tree's room_signal()
  let main_tree = match view_tree() {
    Some(mt) => mt
    None => panic("missing main tree")
  }
  let (ow0, oh0) = offscreen.room_signal().untracked()
  debug_assert(ow0 == 0.0 && oh0 == 0.0, "offscreen room starts at (0,0)")
  let (mw0, mh0) = main_tree.room_signal().untracked()
  debug_assert(mw0 == 1000.0 && mh0 == 600.0, "main tree room is (1000,600)")

  // 3. Encode the same offscreen tree at 400 -> 1000 -> 400
  let sc1 = encode_tree_scene(offscreen, 400.0, 600.0, 1.0, 10.0)
  debug_assert(offscreen_last_label.v == "narrow", "frame 1 (400px) must be narrow")
  let (ow1, oh1) = offscreen.room_signal().untracked()
  debug_assert(ow1 == 400.0 && oh1 == 600.0, "offscreen room updated to 400")
  debug_assert(sc1.ninst > 0, "frame 1 encoded instances")
  // Check actual drawn box ground color + words for frame 1 (narrow = red)
  let mut saw_f1_narrow = false
  for d in offscreen.drawn() {
    if d.words == "off-narrow" && d.ground == rgba(220, 40, 40, 255) {
      saw_f1_narrow = true
    }
  }
  debug_assert(saw_f1_narrow, "frame 1 actual drawn style must be narrow red")

  let sc2 = encode_tree_scene(offscreen, 1000.0, 600.0, 1.0, 26.0)
  debug_assert(offscreen_last_label.v == "wide", "frame 2 (1000px) must be wide")
  let (ow2, oh2) = offscreen.room_signal().untracked()
  debug_assert(ow2 == 1000.0 && oh2 == 600.0, "offscreen room updated to 1000")
  debug_assert(sc2.ninst > 0, "frame 2 encoded instances")
  let mut saw_f2_wide = false
  for d in offscreen.drawn() {
    if d.words == "off-wide" && d.ground == rgba(40, 120, 220, 255) {
      saw_f2_wide = true
    }
  }
  debug_assert(saw_f2_wide, "frame 2 actual drawn style must be wide blue")

  let sc3 = encode_tree_scene(offscreen, 400.0, 600.0, 1.0, 42.0)
  debug_assert(offscreen_last_label.v == "narrow", "frame 3 (400px) must flip back to narrow")
  let (ow3, oh3) = offscreen.room_signal().untracked()
  debug_assert(ow3 == 400.0 && oh3 == 600.0, "offscreen room updated back to 400")
  debug_assert(sc3.ninst > 0, "frame 3 encoded instances")
  let mut saw_f3_narrow = false
  for d in offscreen.drawn() {
    if d.words == "off-narrow" && d.ground == rgba(220, 40, 40, 255) {
      saw_f3_narrow = true
    }
  }
  debug_assert(saw_f3_narrow, "frame 3 actual drawn style must flip back to narrow red")

  // (c) Encoding offscreen tree triggered 0 wakeups on main window effect!
  debug_assert(
    main_effect_runs.v == main_runs_before_offscreen,
    "encoding offscreen tree must trigger 0 main-window effect wakeups",
  )

  // (b) Resizing main window triggers 0 on_due notifications and 0 recomputations on offscreen tree!
  let offscreen_due_fires : signals::Ref[Int] = signals::ref_new(0)
  offscreen.on_due(fn() { offscreen_due_fires.v = offscreen_due_fires.v + 1 })
  let offscreen_due_before_main_resize = offscreen_due_fires.v
  let offscreen_runs_before_main_resize = offscreen_bind_runs.v
  t.resize(500.0, 600.0)
  t.frame()
  debug_assert(main_narrow_seen.v, "main window became narrow at 500px")
  debug_assert(main_effect_runs.v > main_runs_before_offscreen, "main effect woke on main resize")
  t.resize(1100.0, 600.0)
  t.frame()
  debug_assert(!main_narrow_seen.v, "main window became wide at 1100px")
  debug_assert(
    offscreen_due_fires.v == offscreen_due_before_main_resize,
    "resizing main window must trigger 0 on_due notifications on offscreen tree",
  )
  // Re-encode offscreen at unchanged 400x600 to prove queued bindings were never marked dirty!
  let _ = encode_tree_scene(offscreen, 400.0, 600.0, 1.0, 58.0)
  debug_assert(
    offscreen_bind_runs.v == offscreen_runs_before_main_resize,
    "resizing main window must trigger 0 recomputations on offscreen tree",
  )

  // Verify set_narrow_below breakpoint reactivity
  set_narrow_below(1200.0)
  t.frame()
  debug_assert(tree_narrow(), "1100px is narrow when narrow_below=1200")

  stop_main_eff()
  offscreen.dispose()
  t.dispose()
}

test "p0-1a: window_zoomed() and window_snap_state() reactive aliases isolate per window" {
  let t = Tester::tree(fn(root : view::View) {
    let _ = root.box(fn(_b : view::View) { () })
  })

  let w0_zoom_fires : signals::Ref[Int] = signals::ref_new(0)
  let w0_snap_fires : signals::Ref[Int] = signals::ref_new(0)
  let w0_zoom_val : signals::Ref[Bool] = signals::ref_new(false)
  let w0_snap_val : signals::Ref[Int] = signals::ref_new(0)

  let stop_w0_z = signals::effect(fn() {
    w0_zoom_val.v = window_zoomed()
    w0_zoom_fires.v = w0_zoom_fires.v + 1
  })
  let stop_w0_s = signals::effect(fn() {
    w0_snap_val.v = window_snap_state()
    w0_snap_fires.v = w0_snap_fires.v + 1
  })

  debug_assert(w0_zoom_fires.v == 1 && !w0_zoom_val.v, "w0 zoomed initial")
  debug_assert(w0_snap_fires.v == 1 && w0_snap_val.v == 0, "w0 snap initial")

  let w1_zoom_fires : signals::Ref[Int] = signals::ref_new(0)
  let w1_snap_fires : signals::Ref[Int] = signals::ref_new(0)
  let w1_zoom_val : signals::Ref[Bool] = signals::ref_new(false)
  let w1_snap_val : signals::Ref[Int] = signals::ref_new(0)
  let stop_w1_z : signals::Ref[() -> Unit] = signals::ref_new(fn() { () })
  let stop_w1_s : signals::Ref[() -> Unit] = signals::ref_new(fn() { () })

  // Set up effects inside window 201
  in_window(201, fn() {
    stop_w1_z.v = signals::effect(fn() {
      w1_zoom_val.v = window_zoomed()
      w1_zoom_fires.v = w1_zoom_fires.v + 1
    })
    stop_w1_s.v = signals::effect(fn() {
      w1_snap_val.v = window_snap_state()
      w1_snap_fires.v = w1_snap_fires.v + 1
    })
  })
  debug_assert(w1_zoom_fires.v == 1 && !w1_zoom_val.v, "w1 zoomed initial")
  debug_assert(w1_snap_fires.v == 1 && w1_snap_val.v == 0, "w1 snap initial")

  // Change host zoomed & snap in window 0 only
  t.fake.window_zoomed_flag = true
  t.fake.window_snap_state_val = 2
  t.frame()
  debug_assert(w0_zoom_fires.v == 2 && w0_zoom_val.v, "w0 zoomed woke once on change")
  debug_assert(w0_snap_fires.v == 2 && w0_snap_val.v == 2, "w0 snap woke once on change")
  debug_assert(w1_zoom_fires.v == 1 && !w1_zoom_val.v, "w1 zoomed unaffected by w0")
  debug_assert(w1_snap_fires.v == 1 && w1_snap_val.v == 0, "w1 snap unaffected by w0")

  // Same values on next frame -> 0 extra fires
  t.frame()
  debug_assert(w0_zoom_fires.v == 2 && w0_snap_fires.v == 2, "unchanged host state causes 0 extra fires")

  // Change host zoomed & snap inside window 201 only
  in_window(201, fn() {
    t.fake.window_zoomed_flag = true
    t.fake.window_snap_state_val = 3
    host_settings_arrive()
  })
  debug_assert(w1_zoom_fires.v == 2 && w1_zoom_val.v, "w1 zoomed woke once")
  debug_assert(w1_snap_fires.v == 2 && w1_snap_val.v == 3, "w1 snap woke once")
  debug_assert(w0_zoom_fires.v == 2 && w0_snap_fires.v == 2, "w0 unaffected by w1 change")

  stop_w0_z()
  stop_w0_s()
  (stop_w1_z.v)()
  (stop_w1_s.v)()
  t.dispose()
}

test "p0-1a: pre-startup set_narrow_enabled and set_narrow_below survive first Tester::tree and reset on dispose" {
  set_narrow_enabled(true)
  set_narrow_below(900.0)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.words(
        view::Live::By(fn() {
          if tree_narrow() { "pre-narrow" } else { "pre-wide" }
        }),
        look=view::words_plain,
      )
    },
    width=800.0,
    height=600.0,
  )
  debug_assert(tree_narrow(), "pre-startup narrow_enabled=true and narrow_below=900 must survive first Tester::tree")
  debug_assert(t.find("pre-narrow").is_some(), "800px < 900px renders narrow")
  t.dispose()
  debug_assert(!tree_narrow(), "dispose resets narrow_enabled to false")
}

test "p0-1a: app-level effect created outside tree does not leak offscreen tree room when triggered during Tree::frame" {
  let t = Tester::tree(fn(_root : view::View) { () }, width=1000.0, height=600.0)
  let ping = signals::signal(0)
  let seen_w = signals::ref_new(0.0)
  let seen_room_none = signals::ref_new(false)
  let stop_eff = signals::effect(fn() {
    let _ = ping.get()
    seen_room_none.v = view::current_tree_room().is_none()
    seen_w.v = window_size_now().0
  })
  debug_assert(seen_room_none.v && seen_w.v == 1000.0, "app-level effect initially reads main window")

  let off = view::Tree::new(fn(root : view::View) {
    root.reacts(fn() { window_size_now().0 }, fn(w) {
      if w == 400.0 {
        // Trigger app-level effect synchronously while inside off.frame(400, 600)!
        ping.set(1)
      }
    })
  })
  let _ = off.frame(400.0, 600.0)
  debug_assert(seen_room_none.v, "app-level effect must see current_tree_room() == None")
  debug_assert(seen_w.v == 1000.0, "app-level effect must read main window 1000.0, not offscreen 400.0")

  stop_eff()
  off.dispose()
  t.dispose()
}

test "p0-1a: review isolate computed read" {
  let t = Tester::tree(fn(_root : view::View) { () }, width=1000.0)
  let tick = signals::signal(0)
  let last = signals::ref_new(0.0)
  let tr = view::Tree::new(fn(root : view::View) {
    let m = signals::computed_by(fn(_ : Option[Double]) -> Double {
      let _ = tick.get()
      window_size_now().0
    }, same=fn(a, b) { a == b })
    root.reacts(fn() { m.get() }, fn(w) { last.v = w })
  })
  let _ = tr.frame(400.0, 600.0)
  debug_assert(last.v == 400.0, "offscreen width at start")
  tick.set(1)
  debug_assert(last.v == 400.0, "offscreen computed must keep own tree room after independent write")
  tr.dispose()
  t.dispose()
}

test "p0-1a: review isolate narrow policy" {
  let t = Tester::tree(fn(_root : view::View) { () }, width=1000.0)
  let tick = signals::signal(0)
  let last = signals::ref_new(false)
  let saved : signals::Ref[Option[view::Tree]] = signals::ref_new(None)
  in_window(123, fn() {
    set_narrow_enabled(true)
    let tr = view::Tree::new(fn(root : view::View) {
      root.reacts(fn() { let _ = tick.get(); tree_narrow() }, fn(b) { last.v = b })
    })
    let _ = tr.frame(400.0, 600.0)
    saved.v = Some(tr)
  })
  debug_assert(last.v, "secondary starts narrow")
  tick.set(1)
  debug_assert(last.v, "secondary must keep its own narrow policy when triggered from main window")
  match saved.v { Some(tr) => tr.dispose(); None => () }
  t.dispose()
}

test "p0-1a: review late measurement" {
  let t = Tester::tree(fn(_root : view::View) { () }, width=1000.0)
  let tick = signals::signal(0)
  let seen = signals::ref_new(-2.0)
  let measure_node : signals::Ref[Option[view::View]] = signals::ref_new(None)
  let tr = view::Tree::new(fn(root : view::View) {
    let v = root.box(fn(_b : view::View) { () }).measured(view::Live::By(fn() { tick.get() }), fn(k, _) {
      seen.v = window_size_now().0
      (35.0 + k.to_double(), 20.0 + k.to_double())
    })
    measure_node.v = Some(v)
  })
  let _ = tr.frame(400.0, 600.0)
  debug_assert(seen.v == 400.0, "framed measurement offscreen")
  tick.set(1)
  seen.v = -1.0
  match measure_node.v { Some(v) => { let _ = v.laid_size() }; None => () }
  debug_assert(seen.v != -1.0, "pre-frame layout must measure")
  debug_assert(seen.v == 400.0, "pre-frame measurement must run with owner tree room")
  tr.dispose()
  t.dispose()
}

test "p0-1a: review host aliases detach" {
  let t = Tester::tree(fn(_root : view::View) { () })
  let tick = signals::signal(0)
  let last = signals::ref_new(-1)
  let lastz = signals::ref_new(false)
  let stop = signals::ref_new(fn() { () })
  in_window(123, fn() {
    t.fake.window_snap_state_val = 3
    t.fake.window_zoomed_flag = true
    stop.v = signals::effect(fn() {
      let _ = tick.get()
      last.v = window_snap_state()
      lastz.v = window_zoomed()
    })
  })
  debug_assert(last.v == 3 && lastz.v, "secondary aliases established")
  t.fake.window_snap_state_val = 0
  t.fake.window_zoomed_flag = false
  tick.set(1)
  debug_assert(last.v == 3 && lastz.v, "secondary effect must keep secondary host state")
  (stop.v)()
  t.dispose()
}

test "p0-1a: review nested tree scopes restore" {
  let t = Tester::tree(fn(_root : view::View) { () }, width=1000.0)
  let tr = view::Tree::new(fn(root : view::View) {
    root.reacts(fn() { window_size_now().0 }, fn(w) {
      if w == 400.0 {
        let inside = view::Tree::new(fn(_r : view::View) {
          debug_assert(window_size_now().0 == 0.0, "nested builder reads own unframed room")
        })
        let _ = inside.frame(200.0, 300.0)
        debug_assert(window_size_now().0 == 400.0, "outer scope restored after nested frame")
        inside.dispose()
      }
    })
  })
  let _ = tr.frame(400.0, 600.0)
  debug_assert(view::current_tree_room().is_none() && window_size_now().0 == 1000.0, "ambient window restored")
  tr.dispose()
  t.dispose()
}

