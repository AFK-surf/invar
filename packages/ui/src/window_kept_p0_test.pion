}

test "primary snapshot is taken and restored under primary room during detached cross-window switch" {
  let t = Tester::tree(fn(_ : view::View) { () }, width=1000.0)
  let record = signals::ref_new(false)
  let saved_w = signals::ref_new(-1.0)
  let restored_w = signals::ref_new(-1.0)
  window_kept(fn() {
    if record.v && current_window_id() == 0 { saved_w.v = window_size_now().0 }
    fn() {
      if record.v && current_window_id() == 0 { restored_w.v = window_size_now().0 }
    }
  }, fn() { () })
  let tick = signals::signal(0)
  let tr : signals::Ref[Option[view::Tree]] = signals::ref_new(None)
  in_window(23, fn() {
    let tree = view::Tree::new(fn(root : view::View) {
      root.reacts(fn() { tick.get() }, fn(i) {
        if i == 1 { in_window(42, fn() { () }) }
      })
    })
    let _ = tree.frame(400.0, 600.0)
    tr.v = Some(tree)
  })
  record.v = true
  tick.set(1)
  record.v = false
  debug_assert(
    saved_w.v == 1000.0 && restored_w.v == 1000.0,
    "primary take/restore widths " + saved_w.v.to_string() + "/" + restored_w.v.to_string(),
  )
  match tr.v { Some(tree) => tree.dispose(); None => () }
  t.dispose()
}

