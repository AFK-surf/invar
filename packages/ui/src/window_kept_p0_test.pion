test "nested computed created during detached secondary effect keeps detached window state" {
  let t = Tester::tree(fn(_root : view::View) { () })
  let tick = signals::signal(0)
  let child : signals::Ref[Option[signals::Computed[Int]]] = signals::ref_new(None)
  let stop = signals::ref_new(fn() { () })
  in_window(23, fn() {
    t.fake.window_snap_state_val = 3
    host_settings_arrive()
    stop.v = signals::effect(fn() {
      if tick.get() > 0 {
        child.v = Some(signals::computed(fn(_ : Option[Int]) { window_snap_state() }))
      }
    })
  })
  t.fake.window_snap_state_val = 0
  tick.set(1)
  match child.v {
    Some(c) => {
      let seen = c.get()
      debug_assert(seen == 3, "nested computed read snap " + seen.to_string())
      c.dispose()
    }
    None => panic("missing computed")
  }
  (stop.v)()
  t.dispose()
}

