  set_damage_report_poison(None)
  g.v = g.v + 1
  let h_a2 = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_a2.length() == 0, "atlas generation bump must pass without poison")
  h.atlas_generation = prev_gen
  t2.dispose()
}

test "phase1 rect_of and tap_text: secondary window viewport clipping and clipped target tap center" {
  // 1. Secondary narrow window clips text outside its own 80x60 viewport
  let t1 = Tester::tree(fn(_ : view::View) { () }, w=400.0, h=300.0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.over_at(view::Live::Is((Some(140.0), Some(10.0), None, None)))
        let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(30.0)))
        let _ = b.words(view::Live::Is("PanelOffscreen"))
      })
    }
  })
  let w = window_open_here("narrow_panel")
  let _ = window_frame(w, 80.0, 60.0, 1.0, 0.0)
  let found_off = ref_new(true)
  in_window(w, fn() { found_off.v = t1.rect_of("PanelOffscreen").is_some() })
  debug_assert(!found_off.v, "text at x=140 outside 80pt secondary window must be skipped by rect_of")
  t1.dispose()

  // 2. Clipped button A next to sibling B: rect_of returns unclipped bounds, tap_text clicks visible center
  let hit_a = ref_new(0)
  let hit_b = ref_new(0)
  let t2 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(p : view::View) {
        let _ = p.over_at(view::Live::Is((Some(0.0), Some(0.0), None, None)))
        let _ = p.width(view::Live::Is(Some(20.0))).height(view::Live::Is(Some(40.0))).clips(view::Live::Is(true))
        let _ = p.box(fn(a : view::View) {
          let _ = a.over_at(view::Live::Is((Some(0.0), Some(0.0), None, None)))
          let _ = a.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0)))
          let _ = a.words(view::Live::Is("ClippedA"))
          let _ = a.on_press(fn() { hit_a.v = hit_a.v + 1 })
        })
      })
      let _ = root.box(fn(b : view::View) {
        let _ = b.over_at(view::Live::Is((Some(30.0), Some(0.0), None, None)))
        let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(40.0)))
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="SibB"))))
        let _ = b.on_press(fn() { hit_b.v = hit_b.v + 1 })
      })
    },
    w=120.0,
    h=80.0,
  )
  debug_assert(p1_opt_rect_near(t2.rect_of("ClippedA"), 0.0, 0.0, 100.0, 40.0), "rect_of returns unclipped bounds")
  t2.tap_text("ClippedA")
  debug_assert(hit_a.v == 1 && hit_b.v == 0, "tap_text must click visible clipped center of A, not sibling B")
  t2.dispose()
}

test "phase1 draw: drains nested after_frame callbacks without explicit wake" {
  let t = Tester::tree(fn(_ : view::View) { () }, w=200.0, h=100.0)
  let ran = ref_new(0)
  let before = t.fake.frames_on
  after_frame(fn() {
    after_frame(fn() {
      ran.v = ran.v + 1
    })
  })
  t.draw()
  debug_assert(ran.v == 1 && t.fake.frames_on == before + 2, "nested after_frame must drain in 2 frames")

  // Unbounded self-requeueing after_frame must halt after 3 frames naming after_frame_cbs
  let keep_requeue = ref_new(true)
  let self_cb : signals::Ref[() -> Unit] = ref_new(fn() { () })
  self_cb.v = fn() {
    if keep_requeue.v {
      after_frame(fn() { (self_cb.v)() })
    }
  }
  after_frame(fn() { (self_cb.v)() })
  match t.draw_said() {
    Some(msg) => debug_assert(msg.length() > 0, "unbounded after_frame must report a reason")
    None => debug_assert(false, "unbounded self-requeueing after_frame must return Some reason")
  }
  keep_requeue.v = false
  t.frame()
  t.dispose()
}

test "phase1 check_looks: segs 1e-9 tolerance and NaN rejection" {
  debug_assert(drawn_same(1.0, 1.0 + 0.5e-9), "within 1e-9 absolute tolerance")
  debug_assert(!drawn_same(1.0, 1.0 + 2.0e-9), "beyond 1e-9 tolerance rejected")
  debug_assert(drawn_same(1000.0, 1000.0 + 0.5e-6), "within 1e-9 relative tolerance")
  debug_assert(!drawn_same(1000.0, 1000.0 + 2.0e-6), "beyond 1e-9 relative tolerance rejected")
  let nan = 0.0 / 0.0
  debug_assert(!drawn_same(1.0, nan), "finite vs NaN rejected")
  debug_assert(!drawn_same(nan, 1.0), "NaN vs finite rejected")
  debug_assert(drawn_same(nan, nan), "NaN vs NaN equal")
}

