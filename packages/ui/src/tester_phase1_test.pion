  debug_assert(h4.length() == 0, "atlas bump recovers cleanly")
  h.atlas_generation = prev_gen
  t2.dispose()
}

test "phase1 check_looks: cached 32px thumbnail and newly added 96px node of same image key do not cross-talk" {
  set_view_blocks_enabled(true)
  let show_large = signals::signal(false)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(small : view::View) {
        let _ = small.width(view::Live::Is(Some(16.0))).height(view::Live::Is(Some(16.0)))
        let _ = small.image(view::Live::Is(Some(("phase1-multi-px-img", "", 32))))
      })
      root.show(fn() { show_large.get() }, fn(large : view::View) {
        let _ = large.width(view::Live::Is(Some(48.0))).height(view::Live::Is(Some(48.0)))
        let _ = large.image(view::Live::Is(Some(("phase1-multi-px-img", "", 96))))
      })
    },
    w=400.0,
    h=300.0,
    scale=2.0,
  )
  show_large.set(true)
  let h = tester_capture_halts(fn() { t.frame() })
  debug_assert(h.length() == 0, "32px and 96px nodes of same image key must not halt check_looks")
  t.dispose()
}

test "phase1 check_looks: theme bg switch while off without drawing catches None poison after re-enabling" {
  let dark_sig = signals::signal(false)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(60.0)))
      })
    },
    w=300.0,
    h=200.0,
    theme=fn() { if dark_sig.get() { Theme::dark() } else { Theme::light() } },
  )
  t.check_looks(false)
  dark_sig.set(true)
  t.check_looks(true)
  set_damage_report_poison(Some(DamageReport::None))
  let h = tester_capture_halts(fn() { t.frame() })
  set_damage_report_poison(None)
  debug_assert(h.length() == 1, "theme bg switch while off must catch None poison after re-enabling")
  t.dispose()
}

test "phase1 check_looks: image_ask_at 256 times with check_looks off leaves frame_image_obs empty" {
  let t = Tester::tree(fn(_ : view::View) { () }, w=200.0, h=200.0)
  t.check_looks(false)
  for _ in 0..<256 {
    image_decode_ahead("phase1-ask-leak-check", 64.0)
  }
  debug_assert(image_cache_count() <= 2, "256 repeated decodes of same key must not leak cache entries")
  t.dispose()
}

test "phase1 check_looks: prewarmed 32px and 96px same image key stays consistent on cached 32px node" {
  set_view_blocks_enabled(true)
  let show_img = signals::signal(false)
  let t = Tester::tree(
    fn(root : view::View) {
      root.show(fn() { show_img.get() }, fn(small : view::View) {
        let _ = small.width(view::Live::Is(Some(16.0))).height(view::Live::Is(Some(16.0)))
        let _ = small.image(view::Live::Is(Some(("phase1-prewarmed-32-96", "", 32))))
      })
    },
    w=400.0,
    h=300.0,
    scale=2.0,
  )
  image_decode_ahead("phase1-prewarmed-32-96", 32.0)
  image_decode_ahead("phase1-prewarmed-32-96", 96.0)
  show_img.set(true)
  let h1 = tester_capture_halts(fn() { t.frame() })
  let h2 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h1.length() == 0, "first frame with prewarmed 32px/96px must pass")
  debug_assert(h2.length() == 0, "cached second frame must stay consistent")
  t.dispose()
}

test "phase1 check_looks: forget_image invalidates cached ViewBlock and emits zero image instances" {
  set_view_blocks_enabled(true)
  let key = "mem:phase1-forget-check"
  add_image(key, "PNGDATA".to_bytes())
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
        let _ = b.image(view::Live::Is(Some((key, "", 80))))
      })
    },
    w=300.0,
    h=200.0,
    scale=2.0,
  )
  let count_kind4 = fn() -> Int {
    let sc = view_scene_last()
    let mut n = 0
    for k in 0..<sc.ninst {
      if sc.inst[k * inst_size + 5] == 4.0 {
        n += 1
      }
    }
    n
  }
  debug_assert(count_kind4() == 1, "initial frame must draw 1 image instance")
  forget_image(key)
  t.frame()
  debug_assert(count_kind4() == 0, "after forget_image production scene must emit 0 image instances")
  t.dispose()
}

test "phase1 check_looks: add_image async replacement transitions from old texture to ready new texture" {
  set_view_blocks_enabled(true)
  let key = "mem:phase1-replace-async"
  add_image(key, "PNGDATA_V1".to_bytes())
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
        let _ = b.image(view::Live::Is(Some((key, "", 80))))
      })
    },
    w=300.0,
    h=200.0,
    scale=2.0,
  )
  let first_kind4_tex_id = fn() -> Int {
    let sc = view_scene_last()
    for k in 0..<sc.ninst {
      if sc.inst[k * inst_size + 5] == 4.0 {
        return sc.inst[k * inst_size + 20].to_int()
      }
    }
    0
  }
  let id1 = first_kind4_tex_id()
  debug_assert(id1 > 0, "initial frame must draw initial texture id")
  let h = hostapi::host()
  let orig_load = h.image_load_bytes
  let orig_info = h.image_info
  let id2_ref : signals::Ref[Int] = ref_new(0)
  let ready2 : signals::Ref[Bool] = ref_new(false)
  h.image_load_bytes = fn(data : Bytes, px : Int) -> Int {
    let nid = orig_load(data, px)
    id2_ref.v = nid
    nid
  }
  h.image_info = fn(id : Int, out : FixedArray[Double]) -> Int {
    if id == id2_ref.v && !ready2.v {
      0
    } else {
      orig_info(id, out)
    }
  }
  add_image(key, "PNGDATA_V2".to_bytes())
  t.frame()
  debug_assert(id2_ref.v > 0 && id2_ref.v != id1, "async replacement must allocate a distinct new texture id")
  debug_assert(first_kind4_tex_id() == id1, "transitional frame must display old texture while new decode is pending")
  ready2.v = true
  t.frame()
  debug_assert(first_kind4_tex_id() == id2_ref.v, "frame after decode ready must switch to new texture instead of stale cached ViewBlock")
  t.frame()
  debug_assert(first_kind4_tex_id() == id2_ref.v, "subsequent cached frame must keep displaying new texture")
  h.image_load_bytes = orig_load
  h.image_info = orig_info
  t.dispose()
}
