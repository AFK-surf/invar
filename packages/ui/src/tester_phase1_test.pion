// Phase-1 high-frequency ui::Tester tests:
// - check_looks: 5 poison counter-proofs, pure vector underlay, off->change->on->unchanged,
//   resize (0,0,-1,-1) sentinel, drain_after_frame, multi-rect union coverage (exact & 1px gap),
//   and zero side effects on view_paint_work / glyph atlas / host callbacks
// - draw(): 1-frame, 2-3 frame convergence, clock animation non-looping, 3rd-round halt with flags
// - audit(): exact unasked_faults ++ ui_craft_audit ++ contrast_faults without deduplication
// - touch(): Option[Pointing] (None vs Some(Mouse)) restore on up/cancel/dispose, no auto-frame
// - rect_of / tap_text: words, runs, field (value/secret/IME/placeholder), skip alpha<=0/zero-size/
//   bones/clipped, unclipped coordinates, exact missing-text halt
// - drawn_rects: slot 5 == 0.0 filter and 0xRRGGBBAA packing

import "hostapi"
import "paint"
import "signals"
import "text"
import "view"

fn p1_opt_rect_near(
  got : Option[(Double, Double, Double, Double)],
  ex : Double,
  ey : Double,
  ew : Double,
  eh : Double,
) -> Bool {
  match got {
    Some((x, y, w, h)) =>
    (x - ex).abs() < 0.5 && (y - ey).abs() < 0.5 && (w - ew).abs() < 0.5 && (h - eh).abs() < 0.5
    None => false
  }
}

fn p1_opt_pointing_is_none(p : Option[Pointing]) -> Bool {
  match p {
    None => true
    Some(_) => false
  }
}

fn p1_opt_pointing_is_mouse(p : Option[Pointing]) -> Bool {
  match p {
    Some(Pointing::Mouse) => true
    _ => false
  }
}

test "phase1 check_looks: 5 poison counter-proofs fail then recover" {
  // 1. set_view_block_poison(true) stale cache block
  let col1 = signals::signal(rgba(220, 40, 40, 255))
  let t1 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
        let _ = b.ground(view::Live::By(fn() { col1.get() }))
      })
    },
    w=400.0,
    h=300.0,
  )
  set_view_block_poison(true)
  col1.set(rgba(40, 200, 40, 255))
  let h1 = tester_capture_halts(fn() { t1.frame() })
  debug_assert(h1.length() == 1 && str_contains(h1[0], "mismatch"), "poison 1 (stale view_block) must trigger check_looks halt")
  set_view_block_poison(false)
  let h1_ok = tester_capture_halts(fn() { t1.frame() })
  debug_assert(h1_ok.length() == 0, "poison 1 must recover cleanly once unpoisoned")
  t1.dispose()

  // 2. 100x100 color change paired with DamageReport::None poison
  let col2 = signals::signal(rgba(200, 30, 30, 255))
  let t2 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
        let _ = b.ground(view::Live::By(fn() { col2.get() }))
      })
    },
    w=400.0,
    h=300.0,
  )
  set_damage_report_poison(Some(DamageReport::None))
  col2.set(rgba(30, 30, 220, 255))
  let h2 = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h2.length() == 1 && str_contains(h2[0], "actual damage is None"), "poison 2 (100x100 change + None) must halt")
  set_damage_report_poison(None)
  col2.set(rgba(30, 180, 180, 255))
  let h2_ok = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h2_ok.length() == 0, "poison 2 must recover cleanly")
  t2.dispose()

  // 3. 100x100 color change paired with 1x1 tiny rect poison
  let col3 = signals::signal(rgba(200, 30, 30, 255))
  let t3 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
        let _ = b.ground(view::Live::By(fn() { col3.get() }))
      })
    },
    w=400.0,
    h=300.0,
  )
  set_damage_report_poison(Some(DamageReport::Rects([(0.0, 0.0, 1.0, 1.0)])))
  col3.set(rgba(30, 220, 30, 255))
  let h3 = tester_capture_halts(fn() { t3.frame() })
  debug_assert(h3.length() == 1 && str_contains(h3[0], "missed expected"), "poison 3 (100x100 change + 1x1 rect) must halt")
  set_damage_report_poison(None)
  col3.set(rgba(220, 220, 30, 255))
  let h3_ok = tester_capture_halts(fn() { t3.frame() })
  debug_assert(h3_ok.length() == 0, "poison 3 must recover cleanly")
  t3.dispose()

  // 4. Moving element omitting old rect poison (only reports new rect)
  let pos_x = signals::signal(10.0)
  let t4 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.over_at(view::Live::By(fn() { (Some(pos_x.get()), Some(20.0), None, None) }))
        let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(60.0)))
        let _ = b.ground(view::Live::Is(rgba(80, 120, 220, 255)))
      })
    },
    w=400.0,
    h=300.0,
  )
  set_damage_report_poison(Some(DamageReport::Rects([(216.0, 16.0, 68.0, 68.0)])))
  pos_x.set(220.0)
  let h4 = tester_capture_halts(fn() { t4.frame() })
  debug_assert(h4.length() == 1 && str_contains(h4[0], "missed expected"), "poison 4 (move omitting old rect) must halt")
  set_damage_report_poison(None)
  pos_x.set(100.0)
  let h4_ok = tester_capture_halts(fn() { t4.frame() })
  debug_assert(h4_ok.length() == 0, "poison 4 must recover cleanly")
  t4.dispose()

  // 5. Deleting element omitting old rect poison
  let show_el = signals::signal(true)
  let t5 = Tester::tree(
    fn(root : view::View) {
      root.show(fn() { show_el.get() }, fn(b : view::View) {
        let _ = b.over_at(view::Live::Is((Some(40.0), Some(40.0), None, None)))
        let _ = b.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(80.0)))
        let _ = b.ground(view::Live::Is(rgba(220, 80, 120, 255)))
      })
    },
    w=400.0,
    h=300.0,
  )
  set_damage_report_poison(Some(DamageReport::Rects([(300.0, 200.0, 20.0, 20.0)])))
  show_el.set(false)
  let h5 = tester_capture_halts(fn() { t5.frame() })
  debug_assert(h5.length() == 1 && str_contains(h5[0], "missed expected"), "poison 5 (delete omitting old rect) must halt")
  set_damage_report_poison(None)
  show_el.set(true)
  let h5_ok = tester_capture_halts(fn() { t5.frame() })
  debug_assert(h5_ok.length() == 0, "poison 5 must recover cleanly")
  t5.dispose()
}

test "phase1 check_looks: vector underlay, off->change->on->unchanged, resize sentinel, after_frame, multi-rect union, zero side effects" {
  // 1. Pure vector underlay & underlay-only color change with DamageReport::None poison
  let ul_col = signals::signal(rgba(255, 0, 0, 255))
  let t = Tester::tree(fn(_root : view::View) { () }, w=400.0, h=300.0)
  set_underlay_painter(Some(fn(_sc : Scene, _w : Double, _h : Double, _s : Double, _now : Double) {
    g().emit_rect(10.0, 10.0, 100.0, 100.0, 0.0, ul_col.untracked(), 0.0, 0L, 1.0)
  }))
  let h_ul0 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h_ul0.length() == 0, "pure vector underlay must pass check_looks")
  set_damage_report_poison(Some(DamageReport::None))
  ul_col.set(rgba(0, 0, 255, 255))
  let h_ul1 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h_ul1.length() == 1 && str_contains(h_ul1[0], "actual damage is None"), "underlay-only color change + None poison must halt")
  set_damage_report_poison(None)
  ul_col.set(rgba(0, 200, 0, 255))
  let h_ul2 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h_ul2.length() == 0, "underlay color change must pass without poison")
  set_underlay_painter(None)
  t.dispose()

  // 2. off -> change -> on -> unchanged must NOT false-positive
  let c_sig = signals::signal(rgba(10, 20, 30, 255))
  let t2 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(100.0)))
        let _ = b.ground(view::Live::By(fn() { c_sig.get() }))
      })
    },
    w=400.0,
    h=300.0,
  )
  t2.check_looks(false)
  c_sig.set(rgba(200, 100, 50, 255))
  t2.frame()
  t2.check_looks(true)
  let h_seed = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_seed.length() == 0, "off -> change -> on -> unchanged must not false-positive")

  // 3. Resize (0, 0, -1, -1) sentinel normalization on both actual & expected sides
  set_damage_report_poison(Some(DamageReport::Rects([(0.0, 0.0, -1.0, -1.0)])))
  let h_res = tester_capture_halts(fn() { t2.resize(500.0, 350.0) })
  debug_assert(h_res.length() == 0, "resize sentinel (0,0,-1,-1) must normalize to Full")
  set_damage_report_poison(None)

  // 4. after_frame post-frame tree mutation must not false-positive
  after_frame(fn() { c_sig.set(rgba(90, 40, 210, 255)) })
  let h_af1 = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_af1.length() == 0, "frame running after_frame mutation must pass")
  let h_af2 = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_af2.length() == 0, "next frame rendering after_frame mutation must pass")

  // 5. Multi-rect union tiling coverage: 2 rects covering [0..102, 0..102] passes; leaving a gap fails
  set_damage_report_poison(Some(DamageReport::Rects([(0.0, 0.0, 51.0, 102.0), (51.0, 0.0, 51.0, 102.0)])))
  c_sig.set(rgba(11, 22, 33, 255))
  let h_tile_ok = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_tile_ok.length() == 0, "two rects whose union covers 100% of expected must pass")
  set_damage_report_poison(Some(DamageReport::Rects([(0.0, 0.0, 40.0, 102.0), (60.0, 0.0, 42.0, 102.0)])))
  c_sig.set(rgba(44, 55, 66, 255))
  let h_tile_gap = tester_capture_halts(fn() { t2.frame() })
  debug_assert(h_tile_gap.length() == 1 && str_contains(h_tile_gap[0], "missed expected"), "gap between tiles must halt")
  set_damage_report_poison(None)

  // 4. Zero side effects on view_paint_work_now() & glyph atlas uploads
  let word_sig = signals::signal("CheckZeroSideEffects")
  t2.dispose()
  let t3 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(240.0))).height(view::Live::Is(Some(48.0)))
        let _ = b.words(view::Live::By(fn() { word_sig.get() }))
      })
    },
    w=400.0,
    h=200.0,
  )
  t3.check_looks(true)
  view_paint_work_reset()
  let puts_before_on = t3.fake.glyphs_put
  t3.frame()
  let work_on = view_paint_work_now()
  let puts_on = t3.fake.glyphs_put - puts_before_on

  t3.check_looks(false)
  view_paint_work_reset()
  let puts_before_off = t3.fake.glyphs_put
  t3.frame()
  let work_off = view_paint_work_now()
  let puts_off = t3.fake.glyphs_put - puts_before_off
  debug_assert(
    work_on.made == work_off.made && work_on.copied == work_off.copied && work_on.handed == work_off.handed,
    "check_looks(true) must have zero view_paint_work side effects",
  )
  debug_assert(puts_on == puts_off, "check_looks(true) must have zero glyph upload side effects")
  t3.dispose()
}

test "phase1 draw: single-frame, 2-3 frame convergence, clock animation non-looping, and 3rd-round halt" {
  // 1. Single-frame settle
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0)))
      })
    },
    w=400.0,
    h=200.0,
  )
  let fc0 = t.fake.frames_on
  t.draw()
  debug_assert(t.fake.frames_on == fc0 + 1, "idle draw() must run exactly 1 frame")

  // 2. 2-frame convergence via after_frame
  let step2 = ref_new(0)
  after_frame(fn() {
    step2.v = step2.v + 1
    hostapi::request_frame()
  })
  let fc1 = t.fake.frames_on
  t.draw()
  debug_assert(step2.v == 1 && t.fake.frames_on == fc1 + 2, "1-step after_frame request must settle in 2 frames")

  // 3. 3-frame convergence via chained after_frame
  let step3 = ref_new(0)
  after_frame(fn() {
    step3.v = step3.v + 1
    hostapi::request_frame()
    after_frame(fn() {
      step3.v = step3.v + 1
      wake_frame()
    })
  })
  let fc2 = t.fake.frames_on
  t.draw()
  debug_assert(step3.v == 2 && t.fake.frames_on == fc2 + 3, "2-step chained work must settle in 3 frames")

  // 4. Persistent non-clock work caps at 3 frames via draw_said
  let hook_id = on_before_frame(fn() {
    hostapi::request_frame()
  })
  let fc3 = t.fake.frames_on
  match t.draw_said() {
    Some(msg) => debug_assert(msg.length() > 0, "3rd-round halt must report a reason")
    None => debug_assert(false, "persistent non-clock work must return Some reason on 3rd-round halt")
  }
  remove_before_frame(hook_id)
  debug_assert(t.fake.frames_on == fc3 + 3, "unsettled draw() must stop after 3 frames")
  t.dispose()

  // 5. Pure clock animation does NOT loop or halt, AND does NOT mask real non-clock work
  let shifted = signals::signal(false)
  let start_ms = signals::signal(0.0)
  let t_clk = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(44.0)))
        let _ = b.moved_by(
          fn(_w : Double, _h : Double, now : Double) {
            if !shifted.get() {
              (0.0, 0.0)
            } else {
              let p = dclamp((now - start_ms.get()) / 300.0, 0.0, 1.0)
              (100.0 * p, 0.0)
            }
          },
          fn(_w : Double, _h : Double) {
            if shifted.get() { start_ms.get() + 300.0 } else { 0.0 }
          },
        )
      })
    },
    w=400.0,
    h=200.0,
  )
  view::transition(fn() {
    start_ms.set(t_clk.time())
    shifted.set(true)
  })
  t_clk.fake.time = 16.0
  let fc_clk0 = t_clk.fake.frames_on
  debug_assert(t_clk.draw_said() is Option::None, "pure clock animation must not halt draw()")
  debug_assert(t_clk.fake.frames_on == fc_clk0 + 1, "pure clock animation must run only 1 frame in draw()")

  // Clock animation active + real non-clock work (wake_frame) must NOT be masked by clock_read()
  let woke = ref_new(0)
  on_frame_take(fn() { woke.v = woke.v + 1 })
  after_frame(fn() { wake_frame() })
  let fc_clk1 = t_clk.fake.frames_on
  t_clk.draw()
  debug_assert(woke.v == 1 && t_clk.fake.frames_on == fc_clk1 + 2, "clock_read() must not mask real non-clock wake_frame")
  t_clk.dispose()
}

test "phase1 audit: exact concatenation unasked_faults ++ ui_craft_audit ++ contrast_faults without dedup" {
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.ground(view::Live::Is(rgba(255, 255, 255, 255)))
      let _ = root.box(fn(ghost : view::View) {
        let _ = ghost.width(view::Live::Is(Some(40.0))).height(view::Live::Is(Some(40.0)))
        let _ = ghost.alpha(view::Live::Is(0.0)).takes_unseen(view::Live::Is(true))
        let _ = ghost.on_press(fn() { () })
        let _ = ghost.says(view::Live::Is(Some(view::said(view::Role::Button, label="GhostBtn"))))
      })
      let _ = root.box(fn(w1 : view::View) {
        let _ = w1.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(24.0)))
        let _ = w1.words(view::Live::Is("Faint"), ink=rgba(245, 245, 245, 255))
      })
      let _ = root.box(fn(w2 : view::View) {
        let _ = w2.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(24.0)))
        let _ = w2.words(view::Live::Is("Faint"), ink=rgba(245, 245, 245, 255))
      })
    },
    w=400.0,
    h=300.0,
    unseen_press_held=false,
  )
  let u = t.unasked_faults()
  let c = t.ui_craft_audit()
  let k = t.contrast_faults()
  debug_assert(c.length() >= 1, "must have at least 1 ui_craft_audit fault")
  debug_assert(k.length() == 2 && k[0] == k[1], "must have 2 identical contrast faults")
  let all = t.audit()
  debug_assert(all.length() == u.length() + c.length() + k.length(), "audit() must concatenate without deduplication")
  let mut idx = 0
  for f in u {
    debug_assert(all[idx] == f, "unasked fault order mismatch at \{idx}")
    idx += 1
  }
  for f in c {
    debug_assert(all[idx] == f, "ui_craft_audit fault order mismatch at \{idx}")
    idx += 1
  }
  for f in k {
    debug_assert(all[idx] == f, "contrast fault order mismatch at \{idx}")
    idx += 1
  }
  t.dispose()
}

test "phase1 touch: restores None and Some(Mouse) on up/cancel/dispose without advancing frame" {
  // 1. Prior pointing = None
  set_pointing(None)
  let pressed = ref_new(0)
  let t1 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(60.0)))
        let _ = b.says(view::Live::Is(Some(view::said(view::Role::Button, label="Tap"))))
        let _ = b.on_press(fn() { pressed.v = pressed.v + 1 })
      })
    },
    w=400.0,
    h=300.0,
    platform=0,
  )
  debug_assert(p1_opt_pointing_is_none(said_pointing.v), "initial said_pointing must be None")
  let fc0 = t1.fake.frames_on
  t1.fake.wants = false
  t1.fake.time = 250.0
  t1.touch(0, 50.0, 30.0)
  debug_assert(t1.fake.frames_on == fc0, "touch(0) must NOT advance frame")
  debug_assert(t1.fake.wants, "touch(0) must set frame_requested = true")
  debug_assert(pointing() == Pointing::Finger, "during touch gesture pointing() must be Finger")
  t1.touch(1, 52.0, 30.0)
  debug_assert(t1.fake.frames_on == fc0, "touch(1) must NOT advance frame")
  debug_assert(pointing() == Pointing::Finger, "touch(1) keeps Finger")
  t1.touch(2, 52.0, 30.0)
  debug_assert(t1.fake.frames_on == fc0, "touch(2) must NOT advance frame")
  debug_assert(pressed.v == 1, "touch down+up on button must fire on_press")
  debug_assert(p1_opt_pointing_is_none(said_pointing.v), "touch(2) must restore None (not Some(Mouse))")

  // Cancel also restores None
  t1.touch(0, 50.0, 30.0)
  debug_assert(pointing() == Pointing::Finger, "touch down sets Finger")
  t1.touch(3, 50.0, 30.0)
  debug_assert(p1_opt_pointing_is_none(said_pointing.v), "touch(3) cancel must restore None")

  // Dispose mid-gesture restores None
  t1.touch(0, 50.0, 30.0)
  debug_assert(pointing() == Pointing::Finger, "mid-gesture pointing is Finger")
  t1.dispose()
  debug_assert(p1_opt_pointing_is_none(said_pointing.v), "dispose() mid-gesture must restore None")

  // 2. Prior pointing = Some(Pointing::Mouse)
  set_pointing(Some(Pointing::Mouse))
  let t2 = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(60.0)))
      })
    },
    w=400.0,
    h=300.0,
    platform=1,
  )
  debug_assert(p1_opt_pointing_is_mouse(said_pointing.v), "initial said_pointing is Some(Mouse)")
  t2.touch(0, 20.0, 20.0)
  debug_assert(pointing() == Pointing::Finger, "touch sets Finger")
  t2.touch(2, 20.0, 20.0)
  debug_assert(p1_opt_pointing_is_mouse(said_pointing.v), "touch(2) must restore Some(Mouse)")
  debug_assert(pointing() == Pointing::Mouse, "pointing() stays Mouse even on iOS platform=1")

  // Dispose mid-gesture restores Some(Mouse)
  t2.touch(0, 20.0, 20.0)
  t2.dispose()
  debug_assert(p1_opt_pointing_is_mouse(said_pointing.v), "dispose() mid-gesture must restore Some(Mouse)")
  set_pointing(None)
}

test "phase1 rect_of and tap_text: words, runs, field, visibility filtering, unclipped coords, and halt" {
  let plain_fld = Field::new()
  let secret_fld = Field::new()
  let taps = ref_new(0)
  let t = Tester::tree(
    fn(root : view::View) {
      // 1. Plain words button
      let _ = root.box(fn(b : view::View) {
        let _ = b.over_at(view::Live::Is((Some(10.0), Some(10.0), None, None)))
        let _ = b.width(view::Live::Is(Some(120.0))).height(view::Live::Is(Some(40.0)))
        let _ = b.words(view::Live::Is("Submit Order"))
        let _ = b.on_press(fn() { taps.v = taps.v + 1 })
      })
      // 2. Rich runs node
      let _ = root.box(fn(r : view::View) {
        let _ = r.over_at(view::Live::Is((Some(10.0), Some(60.0), None, None)))
        let _ = r.width(view::Live::Is(Some(160.0))).height(view::Live::Is(Some(30.0)))
        let _ = r.words_runs(view::Live::Is([text::plain("Rich "), text::bold("Badge")]))
      })
      // 3. Plain field (placeholder -> value -> IME)
      let _ = root.box(fn(fc : view::View) {
        let _ = fc.over_at(view::Live::Is((Some(10.0), Some(100.0), None, None)))
        let _ = fc.width(view::Live::Is(Some(180.0))).height(view::Live::Is(Some(32.0)))
        let _ = field(fc, plain_fld, label="Search docs", placeholder="Search docs")
      })
      // 4. Secret field
      let _ = root.box(fn(sc : view::View) {
        let _ = sc.over_at(view::Live::Is((Some(10.0), Some(140.0), None, None)))
        let _ = sc.width(view::Live::Is(Some(180.0))).height(view::Live::Is(Some(32.0)))
        let _ = field(sc, secret_fld, label="Passcode", placeholder="Passcode", secret=true)
      })
      // 5. Hidden alpha=0 node
      let _ = root.box(fn(h : view::View) {
        let _ = h.over_at(view::Live::Is((Some(200.0), Some(10.0), None, None)))
        let _ = h.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(30.0)))
        let _ = h.alpha(view::Live::Is(0.0)).words(view::Live::Is("GhostAlpha"))
      })
      // 6. Zero-size node
      let _ = root.box(fn(z : view::View) {
        let _ = z.over_at(view::Live::Is((Some(200.0), Some(50.0), None, None)))
        let _ = z.width(view::Live::Is(Some(0.0))).height(view::Live::Is(Some(30.0)))
        let _ = z.words(view::Live::Is("ZeroWide"))
      })
      // 7. Bones (skeleton) node
      let _ = root.box(fn(sk : view::View) {
        let _ = sk.over_at(view::Live::Is((Some(200.0), Some(90.0), None, None)))
        let _ = sk.bones(view::Live::Is(rgba(200, 200, 200, 255)))
        let _ = sk.box(fn(ch : view::View) {
          let _ = ch.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(30.0)))
          let _ = ch.words(view::Live::Is("SkeletonLabel"))
        })
      })
      // 8. Completely clipped child inside a clipping parent
      let _ = root.box(fn(clip_box : view::View) {
        let _ = clip_box.over_at(view::Live::Is((Some(200.0), Some(140.0), None, None)))
        let _ = clip_box.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(40.0))).clips(view::Live::Is(true))
        let _ = clip_box.box(fn(off : view::View) {
          let _ = off.over_at(view::Live::Is((Some(150.0), Some(0.0), None, None)))
          let _ = off.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(30.0)))
          let _ = off.words(view::Live::Is("ClippedOut"))
        })
      })
      // 9. Partially clipped node -> must be found AND return UNCLIPPED (x, y, w, h)
      let _ = root.box(fn(part : view::View) {
        let _ = part.over_at(view::Live::Is((Some(350.0), Some(200.0), None, None)))
        let _ = part.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(40.0)))
        let _ = part.words(view::Live::Is("HalfEdge"))
      })
    },
    w=400.0,
    h=300.0,
  )
  // Plain words
  debug_assert(p1_opt_rect_near(t.rect_of("Submit Order"), 10.0, 10.0, 120.0, 40.0), "rect_of plain words")
  // Rich runs (substring spanning across runs!)
  debug_assert(p1_opt_rect_near(t.rect_of("Rich Badge"), 10.0, 60.0, 160.0, 30.0), "rect_of rich runs")
  // Field placeholder -> plain text -> IME composition
  debug_assert(t.rect_of("Search docs").is_some(), "rect_of field placeholder")
  plain_fld.set("query123")
  t.frame()
  debug_assert(t.rect_of("query123").is_some(), "rect_of field value")
  debug_assert(t.rect_of("Search docs").is_none(), "placeholder hidden once value set")
  plain_fld.set("")
  plain_fld.focus()
  plain_fld.compose("nihao")
  t.frame()
  debug_assert(t.rect_of("nihao").is_some(), "rect_of field IME composition")
  // Secret field placeholder -> masked value (never plaintext)
  debug_assert(t.rect_of("Passcode").is_some(), "rect_of secret field placeholder")
  secret_fld.set("topsecret")
  t.frame()
  debug_assert(t.rect_of("topsecret").is_none(), "secret field must NOT match plaintext")
  debug_assert(t.rect_of(secret_fld.st.display_text()).is_some(), "secret field matches masked display text")
  // Skips alpha<=0, zero-size, bones, completely clipped
  debug_assert(t.rect_of("GhostAlpha").is_none(), "alpha<=0 must be skipped")
  debug_assert(t.rect_of("ZeroWide").is_none(), "zero-size must be skipped")
  debug_assert(t.rect_of("SkeletonLabel").is_none(), "bones node must be skipped")
  debug_assert(t.rect_of("ClippedOut").is_none(), "completely clipped node must be skipped")
  // Partially clipped returns UNCLIPPED (350, 200, 100, 40) even though viewport width is 400
  debug_assert(p1_opt_rect_near(t.rect_of("HalfEdge"), 350.0, 200.0, 100.0, 40.0), "partially clipped must return unclipped rect")

  // tap_text hits center once
  t.tap_text("Submit Order")
  debug_assert(taps.v == 1, "tap_text must click center of Submit Order once")
  debug_assert(t.rect_of("NotOnScreen").is_none(), "missing text has no rect_of")
  t.dispose()
}

test "phase1 drawn_rects: filters slot 5 == 0.0 and packs 0xRRGGBBAA" {
  let t = Tester::tree(
    fn(root : view::View) {
      // Opaque rect (kind=0.0)
      let _ = root.box(fn(b1 : view::View) {
        let _ = b1.over_at(view::Live::Is((Some(10.0), Some(20.0), None, None)))
        let _ = b1.width(view::Live::Is(Some(80.0))).height(view::Live::Is(Some(40.0)))
        let _ = b1.ground(view::Live::Is(rgba(0x12, 0x34, 0x56, 0xFF)))
      })
      // Translucent rect (alpha=0.5 on 0xAABBCCFF -> alpha byte 0x80)
      let _ = root.box(fn(b2 : view::View) {
        let _ = b2.over_at(view::Live::Is((Some(100.0), Some(20.0), None, None)))
        let _ = b2.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(30.0)))
        let _ = b2.alpha(view::Live::Is(0.5)).ground(view::Live::Is(rgba(0xAA, 0xBB, 0xCC, 0xFF)))
      })
      // Non-rect primitives: text glyphs (kind=1.0), shadow (kind=2.0), frosted glass (kind=5.0)
      let _ = root.box(fn(txt : view::View) {
        let _ = txt.over_at(view::Live::Is((Some(10.0), Some(80.0), None, None)))
        let _ = txt.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(24.0)))
        let _ = txt.words(view::Live::Is("NotARect"))
      })
      let _ = root.box(fn(gl : view::View) {
        let _ = gl.over_at(view::Live::Is((Some(10.0), Some(120.0), None, None)))
        let _ = gl.width(view::Live::Is(Some(100.0))).height(view::Live::Is(Some(50.0)))
        let _ = gl.glass(view::Live::Is(Some(paint::Glass::frosted(
          blur=12.0,
          tint=rgba(255, 255, 255, 180),
          solid=rgba(240, 240, 240, 255),
        ))))
        let _ = gl.shadow(view::Live::Is((8.0, 2.0, rgba(0, 0, 0, 80))))
      })
    },
    w=400.0,
    h=300.0,
  )
  let rects = t.drawn_rects()
  debug_assert(rects.length() == 2, "must contain only the 2 kind=0.0 rect instances (got \{rects.length()})")
  let (x0, y0, w0, h0, c0) = rects[0]
  debug_assert(
    (x0 - 10.0).abs() < 0.1 && (y0 - 20.0).abs() < 0.1 && (w0 - 80.0).abs() < 0.1 && (h0 - 40.0).abs() < 0.1,
    "first rect geometry must match",
  )
  debug_assert(c0 == rgba(0x12, 0x34, 0x56, 0xFF), "first rect color must pack to 0x123456FF")
  let (x1, y1, w1, h1, c1) = rects[1]
  debug_assert(
    (x1 - 100.0).abs() < 0.1 && (y1 - 20.0).abs() < 0.1 && (w1 - 60.0).abs() < 0.1 && (h1 - 30.0).abs() < 0.1,
    "second rect geometry must match",
  )
  debug_assert(c1 == rgba(0xAA, 0xBB, 0xCC, 0x80), "translucent rect must pack alpha=0.5 as 0x80")
  t.dispose()
}

test "phase1 check_looks: pending image bypass polls image_info once and matches production" {
  let t = Tester::tree(fn(_ : view::View) { () }, w=400.0, h=300.0)
  let h = hostapi::host()
  let prev_load = h.image_load
  let prev_info = h.image_info
  let polls = ref_new(0)
  h.image_load = fn(_ : String, _ : Int) { 97 }
  h.image_info = fn(_ : Int, out : FixedArray[Double]) {
    polls.v = polls.v + 1
    out[0] = 64.0
    out[1] = 64.0
    if polls.v == 1 { 0 } else { 1 }
  }
  let root = match view_tree() {
    Some(tr) => tr.root()
    None => {
      debug_assert(false, "tree must exist")
      return
    }
  }
  let _ = root.box(fn(b : view::View) {
    let _ = b.width(view::Live::Is(Some(64.0))).height(view::Live::Is(Some(64.0)))
    let _ = b.image(view::Live::Is(Some(("phase1-pending-image", "", 64))))
  })
  t.frame()
  h.image_load = prev_load
  h.image_info = prev_info
  t.dispose()
  debug_assert(polls.v == 1, "pending image must poll image_info exactly once (got \{polls.v})")
}

test "phase1 check_looks: multi-window off->on reseeds primary and secondary windows independently" {
  let main_col = signals::signal(rgba(10, 10, 10, 255))
  let sec_col = signals::signal(rgba(200, 0, 0, 255))
  let mk_box = fn(col : signals::Signal[Int64]) -> (view::View) -> Unit {
    fn(root : view::View) {
      let _ = root.box(fn(b : view::View) {
        let _ = b.width(view::Live::Is(Some(60.0))).height(view::Live::Is(Some(60.0)))
        let _ = b.ground(view::Live::By(fn() { col.get() }))
      })
    }
  }
  let t = Tester::tree(mk_box(main_col), w=400.0, h=300.0)
  set_window_tree(fn(_ : Int, _ : String) -> (view::View) -> Unit { mk_box(sec_col) })
  let w = window_open_here("secondary")
  debug_assert(w > 0, "secondary window must open")
  let _ = window_frame(w, 400.0, 600.0, 1.0, 10.0)

  t.check_looks(false)
  t.check_looks(true)
  let h0 = tester_capture_halts(fn() { let _ = window_frame(w, 400.0, 600.0, 1.0, 20.0) })
  debug_assert(h0.length() == 0, "secondary window off->on without change must not halt")

  t.check_looks(false)
  sec_col.set(rgba(0, 0, 200, 255))
  let _ = window_frame(w, 400.0, 600.0, 1.0, 30.0)
  t.check_looks(true)
  set_damage_report_poison(Some(DamageReport::None))
  sec_col.set(rgba(0, 200, 0, 255))
  let h1 = tester_capture_halts(fn() { let _ = window_frame(w, 400.0, 600.0, 1.0, 40.0) })
  debug_assert(h1.length() == 1, "secondary window change + None poison must halt")
  set_damage_report_poison(None)
  let h2 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h2.length() == 0, "primary window recovers cleanly")

  t.check_looks(false)
  main_col.set(rgba(0, 120, 220, 255))
  t.frame()
  let _ = window_frame(w, 400.0, 600.0, 1.0, 50.0)
  t.check_looks(true)
  let h3 = tester_capture_halts(fn() { t.frame() })
  debug_assert(h3.length() == 0, "primary window off->change->on->unchanged must not halt")
  window_close_here(w)
  debug_assert(!windows_beside.contains(w), "secondary window cleanup")
  t.dispose()
}

test "phase1 check_looks: set_view_app auto-restores hook on next frame" {
  let col = signals::signal(rgba(10, 10, 10, 255))
