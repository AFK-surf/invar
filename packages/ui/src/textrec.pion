import "hostapi"
import "mbt_compat"

// A host's text answered once and kept (what its system says of fonts, how it shapes words, the glyphs' keys and
// boxes), then given again under a Tester: the laid-out tree and what is drawn are then the host's own, to the
// instance, with no window, no GPU and no font system. So a screen's frames are compared as data (frames.pion) on any
// machine for each host, and only the renderers themselves draw pixels.
//
//   MBUI_TEXT_RECORD=1   on a real host: each answer, once, on the log as TEXTREC {…}
//   Tester::new(text=)   a test's fake host answers from those lines; what they lack is said (text_missing)
//
// The lines: {"m":[size,weight,style],"r":[ascent,descent,line,han ascent,han descent,whole]}
// (the font Han falls back to's two, then 1 where the host sets lines on whole pixels; kept from before without
// them: the font's own, not), {"s":[size,weight,style,text],"r":[clusters…]}
// (start, length, advance, key: four numbers each), {"k":[size,weight,style,text],"r":key}, {"g":key,"r":[box…]}.

///|
struct TextTable {
  metrics : mbt_compat::OrderedMap[String, Array[Double]]
  shapes : mbt_compat::OrderedMap[String, Array[Double]]
  keys : mbt_compat::OrderedMap[String, Int]
  glyphs : mbt_compat::OrderedMap[Int, Array[Double]]
  missing : Array[String]
  answers : mbt_compat::OrderedMap[String, mbt_compat::MbtJson]
}

///|
/// A Tester's kept text (Tester::new's `text`), None: the fake host's own made-up metrics.
// moved to 00_init_order.pion: text_table

///|
/// Recording (MBUI_TEXT_RECORD=1): -1 not asked yet, 0 no, 1 yes; what was said already.
// moved to 00_init_order.pion: text_rec

///|
// moved to 00_init_order.pion: text_said

///|
fn text_recording() -> Bool {
  if text_rec.v < 0 {
    { let __mbt_r = text_rec; __mbt_r.v = (if hostapi::env("MBUI_TEXT_RECORD") == "1" { 1 } else { 0 }) }
  }
  text_rec.v == 1
}

///|
fn style_key(size : Double, weight : Int, style : Int) -> String {
  "\{mbt_compat::double_to_string(size)}|\{weight}|\{style}"
}

///|
fn nums(a : FixedArray[Double], n : Int) -> mbt_compat::MbtJson {
  let out : Array[mbt_compat::MbtJson] = []
  for i in 0..<n {
    out.push(mbt_compat::MbtJson::number(a[i]))
  }
  mbt_compat::MbtJson::array(out)
}

///|
fn text_say(key : String, line : mbt_compat::MbtJson) -> Unit {
  if !text_said.contains(key) {
    text_said.set(key, true)
    hostapi::log("TEXTREC " + line.stringify())
  }
}

///|
fn rec_metrics(size : Double, weight : Int, style : Int, out : FixedArray[Double]) -> Unit {
  if text_recording() {
    let args : mbt_compat::MbtJson = mbt_compat::MbtJson::Array([mbt_compat::MbtJson::number(size), mbt_compat::MbtJson::number(weight.to_double()), mbt_compat::MbtJson::number(style.to_double())])
    text_say("m" + style_key(size, weight, style), mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("m", args), ("r", nums(out, 6))])))
  }
}

///|
fn rec_shape(text : String, size : Double, weight : Int, style : Int, out : FixedArray[Double], k : Int) -> Unit {
  if text_recording() {
    let args : mbt_compat::MbtJson = mbt_compat::MbtJson::Array([mbt_compat::MbtJson::number(size), mbt_compat::MbtJson::number(weight.to_double()), mbt_compat::MbtJson::number(style.to_double()), mbt_compat::MbtJson::string(text)])
    text_say("s" + style_key(size, weight, style) + "|" + text, mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("s", args), ("r", nums(out, k * 4))])))
  }
}

///|
fn rec_key(text : String, size : Double, weight : Int, style : Int, key : Int) -> Unit {
  if text_recording() {
    let args : mbt_compat::MbtJson = mbt_compat::MbtJson::Array([mbt_compat::MbtJson::number(size), mbt_compat::MbtJson::number(weight.to_double()), mbt_compat::MbtJson::number(style.to_double()), mbt_compat::MbtJson::string(text)])
    text_say("k" + style_key(size, weight, style) + "|" + text, mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("k", args), ("r", mbt_compat::MbtJson::number(key.to_double()))])))
  }
}

///|
fn rec_glyph(key : Int, out : FixedArray[Double]) -> Unit {
  if text_recording() {
    text_say("g\{key}", mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([("g", mbt_compat::MbtJson::number(key.to_double())), ("r", nums(out, 7))])))
  }
}

///|
fn json_nums(j : Option[mbt_compat::MbtJson]) -> Array[Double] {
  match j {
    Some(.Array(a)) =>
    mbt_compat::arr_map(a, fn(v) {
      match v {
        .Number(d, _) => d
        _ => 0.0
      }
    })
    _ => []
  }
}

///|
fn json_args(j : Option[mbt_compat::MbtJson]) -> Option[(String, String)] {
  match j {
    Some(.Array(arr)) if arr.length() >= 3 => {
      guard (arr[0], arr[1], arr[2]) is (.Number(size, _), .Number(weight, _), .Number(style, _)) else {
        return Option::None
      }
      let text = if arr.length() >= 4 {
        match arr[3] {
          String(t) => t
          _ => ""
        }
      } else {
        ""
      }
      Some((style_key(size, weight.to_int(), style.to_int()), text))
    }
    _ => Option::None
  }
}

///|
/// The kept text in `lines` (MBUI_TEXT_RECORD's TEXTREC lines, or the bare JSON of each), for a Tester (its `text`).
fn text_table_of(lines : String) -> TextTable {
  let t : TextTable = TextTable::{
    metrics: mbt_compat::ordered_map_new(),
    shapes: mbt_compat::ordered_map_new(),
    keys: mbt_compat::ordered_map_new(),
    glyphs: mbt_compat::ordered_map_new(),
    missing: [],
    answers: host_answers_of(lines),
  }
  for v in lines.split("\n") {
    let line = mbt_compat::str_to_owned(v)
    let start = match mbt_compat::str_find(line, "TEXTREC ") {
      Some(i) => i + 8
      None => if mbt_compat::str_has_prefix(line, "{") { 0 } else { continue }
    }
    let j = match mbt_compat::mbt_json_parse(mbt_compat::str_to_owned(mbt_compat::str_exact_view(line, start=start))) { Ok(__mbt_ok_30) => __mbt_ok_30, Err(_) => continue }
    guard j is .Object(m) else { continue }
    match (m.get("m"), m.get("s"), m.get("k"), m.get("g")) {
      (Some(_), _, _, _) =>
      match json_args(m.get("m")) {
        Some((sk, _)) => t.metrics.set(sk, json_nums(m.get("r")))
        Option::None => ()
      }
      (_, Some(_), _, _) =>
      match json_args(m.get("s")) {
        Some((sk, text)) => t.shapes.set(sk + "|" + text, json_nums(m.get("r")))
        Option::None => ()
      }
      (_, _, Some(_), _) =>
      match (json_args(m.get("k")), m.get("r")) {
        (Some((sk, text)), Some(.Number(key, _))) => t.keys.set(sk + "|" + text, key.to_int())
        _ => ()
      }
      (_, _, _, Some(.Number(key, _))) => t.glyphs.set(key.to_int(), json_nums(m.get("r")))
      _ => ()
    }
  }
  t
}

///|
/// What the kept text (Tester::new's `text`) did not have that the view asked of it, once each: "metrics 15|400|0",
/// "shape 15|400|0|words", "key …", "glyph N".
pub fn Tester::text_missing(self : Tester) -> Array[String] {
  self.reads_own()
  ignore(self)
  match text_table.v {
    Some(t) => t.missing.copy()
    Option::None => []
  }
}

///|
fn text_lacks(t : TextTable, what : String) -> Unit {
  if !t.missing.contains(what) {
    t.missing.push(what)
  }
}

///|
/// The kept answer for the font metrics, if a Tester has kept text: true when it answered.
fn kept_metrics(size : Double, weight : Int, style : Int, out : FixedArray[Double]) -> Bool {
  guard text_table.v is Some(t) else { return false }
  let sk = style_key(size, weight, style)
  match t.metrics.get(sk) {
    Some(r) => {
      for i in 0..<r.length() {
        out[i] = r[i]
      }
      true
    }
    Option::None => {
      text_lacks(t, "metrics " + sk)
      false
    }
  }
}

///|
/// The kept shaping of `text` (its clusters' count), if a Tester has kept text and it has this.
fn kept_shape(text : String, size : Double, weight : Int, style : Int, out : FixedArray[Double]) -> Option[Int] {
  guard text_table.v is Some(t) else { return Option::None }
  let key = style_key(size, weight, style) + "|" + text
  match t.shapes.get(key) {
    Some(r) if r.length() <= out.length() => {
      for i in 0..<r.length() {
        out[i] = r[i]
      }
      Some(r.length() / 4)
    }
    _ => {
      text_lacks(t, "shape " + key)
      Option::None
    }
  }
}

///|
fn kept_key(text : String, size : Double, weight : Int, style : Int) -> Option[Int] {
  guard text_table.v is Some(t) else { return Option::None }
  let key = style_key(size, weight, style) + "|" + text
  match t.keys.get(key) {
    Some(k) => Some(k)
    Option::None => {
      text_lacks(t, "key " + key)
      Option::None
    }
  }
}

///|
fn kept_glyph(key : Int, out : FixedArray[Double]) -> Bool {
  guard text_table.v is Some(t) else { return false }
  // Its phase's own box first (bits 26..27: a phase's bounds take its shift in); a run kept before phases were told
  // apart has only its base's.
  let base = if key >= 0 { key & 0x03FFFFFF } else { key }
  let kept = match t.glyphs.get(key) {
    Option::None => t.glyphs.get(base)
    r => r
  }
  match kept {
    Some(r) => {
      for i in 0..<r.length() {
        out[i] = r[i]
      }
      true
    }
    Option::None => {
      text_lacks(t, "glyph \{base}")
      false
    }
  }
}
