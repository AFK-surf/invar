// Pion-JSX PascalCase thin-shell components for packages/ui:
// Box, Row, Col, Spacer, Text, Show, Scroll, Image.
// Follows the zero-magic P31-C protocol: `in={root}` -> first positional `parent : view::View`,
// child tags forward `__jsx_p_N`, children blocks pass `children=fn(__jsx_p_N) { ... }`.

import "view"

///|
/// Core flex container JSX component. Supports both static props (`bg`, `width`, `alpha`, `blur`, `shown`)
/// and reactive `*_by` closures (`bg_by`, `width_by`, `alpha_by`, `blur_by`, `shown_by`); `*_by` takes precedence.
pub fn Box(
  parent : view::View,
  row~ : Bool = false,
  fill~ : Bool = false,
  center~ : Bool = false,
  rigid~ : Bool = false,
  clip~ : Bool = false,
  cut~ : Bool = false,
  moves_window~ : Bool = false,
  wrap~ : Bool = false,
  line_gap~ : Double = 0.0,
  width? : Double,
  width_by? : () -> Option[Double],
  height? : Double,
  height_by? : () -> Option[Double],
  min_width? : Double,
  min_height? : Double,
  max_width? : Double,
  max_height? : Double,
  grow? : Double,
  shrink? : Double,
  pad? : Double,
  pad_x? : Double,
  pad_y? : Double,
  gap? : Double,
  along? : view::Lies,
  align? : view::Along,
  over~ : Bool = false,
  x? : Double,
  y? : Double,
  bg? : Int64,
  bg_by? : () -> Int64,
  radius? : Double,
  border_color? : Int64,
  border_width~ : Double = 1.0,
  alpha? : Double,
  alpha_by? : () -> Double,
  blur? : Double,
  blur_by? : () -> Double,
  shown? : Bool,
  shown_by? : () -> Bool,
  cursor? : view::Cursor,
  on_press? : () -> Unit,
  ref_view? : (view::View) -> Unit,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    if row {
      let _ = v.row(view::Live::Is(true), loc=loc)
    }
    if fill {
      let _ = v.fill(loc=loc)
    }
    if center {
      let _ = v.center(loc=loc)
    }
    if rigid {
      let _ = v.rigid(loc=loc)
    }
    if clip {
      let _ = v.clip(loc=loc)
    }
    if cut {
      let _ = v.cut(loc=loc)
    }
    if moves_window {
      let _ = v.moves_window(view::Live::Is(true))
    }
    if wrap {
      let _ = v.wraps(view::Live::Is(Some(line_gap)), loc=loc)
    }
    match width_by {
      Some(f) => {
        let _ = v.width(view::Live::By(f), loc=loc)
      }
      None =>
      match width {
        Some(w) => {
          let _ = v.width(view::Live::Is(Some(w)), loc=loc)
        }
        None => ()
      }
    }
    match height_by {
      Some(f) => {
        let _ = v.height(view::Live::By(f), loc=loc)
      }
      None =>
      match height {
        Some(h) => {
          let _ = v.height(view::Live::Is(Some(h)), loc=loc)
        }
        None => ()
      }
    }
    match min_width {
      Some(w) => {
        let _ = v.min_width(view::Live::Is(Some(w)), loc=loc)
      }
      None => ()
    }
    match min_height {
      Some(h) => {
        let _ = v.min_height(view::Live::Is(Some(h)), loc=loc)
      }
      None => ()
    }
    match max_width {
      Some(w) => {
        let _ = v.max_width(view::Live::Is(Some(w)), loc=loc)
      }
      None => ()
    }
    match max_height {
      Some(h) => {
        let _ = v.max_height(view::Live::Is(Some(h)), loc=loc)
      }
      None => ()
    }
    match grow {
      Some(g) => {
        let _ = v.grow(view::Live::Is(g), loc=loc)
      }
      None => ()
    }
    match shrink {
      Some(s) => {
        let _ = v.shrink(view::Live::Is(s), loc=loc)
      }
      None => ()
    }
    if pad_x.is_some() || pad_y.is_some() {
      let base = pad.unwrap_or(0.0)
      let px = pad_x.unwrap_or(base)
      let py = pad_y.unwrap_or(base)
      let _ = v.padding(view::Live::Is((px, py, px, py)), loc=loc)
    } else {
      match pad {
        Some(p) => {
          let _ = v.pad(view::Live::Is(p), loc=loc)
        }
        None => ()
      }
    }
    match gap {
      Some(g) => {
        let _ = v.gap(view::Live::Is(g), loc=loc)
      }
      None => ()
    }
    match along {
      Some(l) => {
        let _ = v.lies_along(view::Live::Is(l), loc=loc)
      }
      None => ()
    }
    match align {
      Some(a) => {
        let _ = v.lines_up(view::Live::Is(Some(a)), loc=loc)
      }
      None => ()
    }
    if over || x.is_some() || y.is_some() {
      if x.is_some() || y.is_some() {
        let _ = v.over(view::Live::Is(true), edges=(x, y, None, None), loc=loc)
      } else {
        let _ = v.over(view::Live::Is(true), loc=loc)
      }
    }
    match bg_by {
      Some(f) => {
        let _ = v.ground(view::Live::By(f), loc=loc)
      }
      None =>
      match bg {
        Some(c) => {
          let _ = v.ground(view::Live::Is(c), loc=loc)
        }
        None => ()
      }
    }
    match radius {
      Some(r) => {
        let _ = v.radius(view::Live::Is(r), loc=loc)
      }
      None => ()
    }
    match border_color {
      Some(c) => {
        let _ = v.edge(view::Live::Is((border_width, c)), loc=loc)
      }
      None => ()
    }
    match alpha_by {
      Some(f) => {
        let _ = v.alpha(view::Live::By(f), loc=loc)
      }
      None =>
      match alpha {
        Some(a) => {
          let _ = v.alpha(view::Live::Is(a), loc=loc)
        }
        None => ()
      }
    }
    match blur_by {
      Some(f) => {
        let _ = v.blur(view::Live::By(f), loc=loc)
      }
      None =>
      match blur {
        Some(b) => {
          let _ = v.blur(view::Live::Is(b), loc=loc)
        }
        None => ()
      }
    }
    match shown_by {
      Some(f) => {
        let _ = v.laid_nowhere(view::Live::By(fn() { !f() }), loc=loc)
      }
      None =>
      match shown {
        Some(s) => {
          let _ = v.laid_nowhere(view::Live::Is(!s), loc=loc)
        }
        None => ()
      }
    }
    match cursor {
      Some(c) => {
        let _ = v.cursor(view::Live::Is(Some(c)), loc=loc)
      }
      None => ()
    }
    match on_press {
      Some(f) => {
        let _ = v.on_press(f)
      }
      None => ()
    }
    match ref_view {
      Some(f) => f(v)
      None => ()
    }
    match children {
      Some(c) => c(v)
      None => ()
    }
  })
}

///|
/// Horizontal flex row JSX component (equivalent to `<Box row ...>`).
pub fn Row(
  parent : view::View,
  fill~ : Bool = false,
  center~ : Bool = false,
  rigid~ : Bool = false,
  clip~ : Bool = false,
  cut~ : Bool = false,
  moves_window~ : Bool = false,
  wrap~ : Bool = false,
  line_gap~ : Double = 0.0,
  width? : Double,
  width_by? : () -> Option[Double],
  height? : Double,
  height_by? : () -> Option[Double],
  min_width? : Double,
  min_height? : Double,
  max_width? : Double,
  max_height? : Double,
  grow? : Double,
  shrink? : Double,
  pad? : Double,
  pad_x? : Double,
  pad_y? : Double,
  gap? : Double,
  along? : view::Lies,
  align? : view::Along,
  over~ : Bool = false,
  x? : Double,
  y? : Double,
  bg? : Int64,
  bg_by? : () -> Int64,
  radius? : Double,
  border_color? : Int64,
  border_width~ : Double = 1.0,
  alpha? : Double,
  alpha_by? : () -> Double,
  blur? : Double,
  blur_by? : () -> Double,
  shown? : Bool,
  shown_by? : () -> Bool,
  cursor? : view::Cursor,
  on_press? : () -> Unit,
  ref_view? : (view::View) -> Unit,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  Box(
    parent,
    row=true,
    fill=fill,
    center=center,
    rigid=rigid,
    clip=clip,
    cut=cut,
    moves_window=moves_window,
    wrap=wrap,
    line_gap=line_gap,
    width?=width,
    width_by?=width_by,
    height?=height,
    height_by?=height_by,
    min_width?=min_width,
    min_height?=min_height,
    max_width?=max_width,
    max_height?=max_height,
    grow?=grow,
    shrink?=shrink,
    pad?=pad,
    pad_x?=pad_x,
    pad_y?=pad_y,
    gap?=gap,
    along?=along,
    align?=align,
    over=over,
    x?=x,
    y?=y,
    bg?=bg,
    bg_by?=bg_by,
    radius?=radius,
    border_color?=border_color,
    border_width=border_width,
    alpha?=alpha,
    alpha_by?=alpha_by,
    blur?=blur,
    blur_by?=blur_by,
    shown?=shown,
    shown_by?=shown_by,
    cursor?=cursor,
    on_press?=on_press,
    ref_view?=ref_view,
    children?=children,
    loc=loc,
  )
}

///|
/// Vertical flex column JSX component (equivalent to `<Box ...>`).
pub fn Col(
  parent : view::View,
  fill~ : Bool = false,
  center~ : Bool = false,
  rigid~ : Bool = false,
  clip~ : Bool = false,
  cut~ : Bool = false,
  moves_window~ : Bool = false,
  wrap~ : Bool = false,
  line_gap~ : Double = 0.0,
  width? : Double,
  width_by? : () -> Option[Double],
  height? : Double,
  height_by? : () -> Option[Double],
  min_width? : Double,
  min_height? : Double,
  max_width? : Double,
  max_height? : Double,
  grow? : Double,
  shrink? : Double,
  pad? : Double,
  pad_x? : Double,
  pad_y? : Double,
  gap? : Double,
  along? : view::Lies,
  align? : view::Along,
  over~ : Bool = false,
  x? : Double,
  y? : Double,
  bg? : Int64,
  bg_by? : () -> Int64,
  radius? : Double,
  border_color? : Int64,
  border_width~ : Double = 1.0,
  alpha? : Double,
  alpha_by? : () -> Double,
  blur? : Double,
  blur_by? : () -> Double,
  shown? : Bool,
  shown_by? : () -> Bool,
  cursor? : view::Cursor,
  on_press? : () -> Unit,
  ref_view? : (view::View) -> Unit,
  children? : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  Box(
    parent,
    row=false,
    fill=fill,
    center=center,
    rigid=rigid,
    clip=clip,
    cut=cut,
    moves_window=moves_window,
    wrap=wrap,
    line_gap=line_gap,
    width?=width,
    width_by?=width_by,
    height?=height,
    height_by?=height_by,
    min_width?=min_width,
    min_height?=min_height,
    max_width?=max_width,
    max_height?=max_height,
    grow?=grow,
    shrink?=shrink,
    pad?=pad,
    pad_x?=pad_x,
    pad_y?=pad_y,
    gap?=gap,
    along?=along,
    align?=align,
    over=over,
    x?=x,
    y?=y,
    bg?=bg,
    bg_by?=bg_by,
    radius?=radius,
    border_color?=border_color,
    border_width=border_width,
    alpha?=alpha,
    alpha_by?=alpha_by,
    blur?=blur,
    blur_by?=blur_by,
    shown?=shown,
    shown_by?=shown_by,
    cursor?=cursor,
    on_press?=on_press,
    ref_view?=ref_view,
    children?=children,
    loc=loc,
  )
}

///|
/// Flexible or fixed-size spacer JSX component.
/// When `width` or `height` is given, fixes that dimension with `shrink(0.0)`; otherwise expands with `grow`.
pub fn Spacer(
  parent : view::View,
  width? : Double,
  height? : Double,
  grow~ : Double = 1.0,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    if width.is_some() || height.is_some() {
      match width {
        Some(w) => {
          let _ = v.width(view::Live::Is(Some(w)), loc=loc)
        }
        None => ()
      }
      match height {
        Some(h) => {
          let _ = v.height(view::Live::Is(Some(h)), loc=loc)
        }
        None => ()
      }
      let _ = v.shrink(view::Live::Is(0.0), loc=loc)
    } else {
      let _ = v.grow(view::Live::Is(grow), loc=loc)
    }
  })
}

///|
/// Text leaf JSX component supporting static `text` or reactive `text_by`, `size`, `weight`,
/// `wrap`/`lines`, `center`, `color`/`color_by`, `alpha`/`alpha_by`, and `blur`.
pub fn Text(
  parent : view::View,
  text~ : String = "",
  text_by? : () -> String,
  size~ : Double = 14.0,
  weight~ : Int = 400,
  wrap~ : Bool = false,
  lines~ : Int = 0,
  center~ : Bool = false,
  color? : Int64,
  color_by? : () -> Int64,
  alpha? : Double,
  alpha_by? : () -> Double,
  blur? : Double,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    let look = view::WordsLook::of(size, weight=weight, wrap=wrap || lines > 0, max_lines=lines)
    let live_text = match text_by {
      Some(f) => view::Live::By(f)
      None => view::Live::Is(text)
    }
    match color {
      Some(c) => {
        let _ = v.words(live_text, ink=c, look=look, loc=loc)
      }
      None => {
        let _ = v.words(live_text, look=look, loc=loc)
      }
    }
    match color_by {
      Some(f) => {
        let _ = v.ink(view::Live::By(f), loc=loc)
      }
      None => ()
    }
    if center {
      let _ = v.words_centered(view::Live::Is(true), loc=loc)
    }
    match alpha_by {
      Some(f) => {
        let _ = v.alpha(view::Live::By(f), loc=loc)
      }
      None =>
      match alpha {
        Some(a) => {
          let _ = v.alpha(view::Live::Is(a), loc=loc)
        }
        None => ()
      }
    }
    match blur {
      Some(b) => {
        let _ = v.blur(view::Live::Is(b), loc=loc)
      }
      None => ()
    }
  })
}

///|
/// Conditional mount/unmount JSX component delegating to `parent.show(when, children, ...)`.
pub fn Show(
  parent : view::View,
  when~ : () -> Bool,
  children~ : (view::View) -> Unit,
  at_once~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  parent.show(when, children, at_once=at_once, loc=loc)
  parent
}

///|
/// Scrollable viewport JSX component.
/// Delegates to `ui::scroll_box` (vertical) or `ui::scroll_row` (horizontal) so `.fill()`,
/// `ui::tree_scroll_bar()`, and `ui::touch_slop()` are wired automatically with zero scroll faults.
pub fn Scroll(
  parent : view::View,
  horizontal~ : Bool = false,
  scroll? : view::Scroll,
  children~ : (view::View) -> Unit,
  loc~ : String = "",
) -> view::View {
  if horizontal {
    match scroll {
      Some(s) => scroll_row(parent, children, scroll=s, loc=loc)
      None => scroll_row(parent, children, loc=loc)
    }
  } else {
    match scroll {
      Some(s) => scroll_box(parent, children, scroll=s, loc=loc)
      None => scroll_box(parent, children, loc=loc)
    }
  }
}

///|
/// Image JSX component supporting static `src` or reactive `src_by`, `stand_in` fallback,
/// `max_px`, `cover`/`contain`, `fade`, `radius`, `alpha`, and `blur`.
pub fn Image(
  parent : view::View,
  src~ : String = "",
  src_by? : () -> String,
  stand_in~ : String = "",
  max_px~ : Int = 0,
  width? : Double,
  height? : Double,
  radius? : Double,
  cover~ : Bool = false,
  contain~ : Bool = false,
  fade~ : Bool = true,
  alpha? : Double,
  blur? : Double,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) {
    match width {
      Some(w) => {
        let _ = v.width(view::Live::Is(Some(w)), loc=loc)
      }
      None => ()
    }
    match height {
      Some(h) => {
        let _ = v.height(view::Live::Is(Some(h)), loc=loc)
      }
      None => ()
    }
    match radius {
      Some(r) => {
        let _ = v.radius(view::Live::Is(r), loc=loc)
      }
      None => ()
    }
    let live_img : view::Live[Option[(String, String, Int)]] = match src_by {
      Some(f) => view::Live::By(fn() { Some((f(), stand_in, max_px)) })
      None => view::Live::Is(Some((src, stand_in, max_px)))
    }
    let _ = v.image(live_img, loc=loc)
    if cover {
      let _ = v.image_covers(view::Live::Is(true), loc=loc)
    }
    if contain {
      let _ = v.image_contains(view::Live::Is(true), loc=loc)
    }
    let _ = v.image_fades(view::Live::Is(fade), loc=loc)
    match alpha {
      Some(a) => {
        let _ = v.alpha(view::Live::Is(a), loc=loc)
      }
      None => ()
    }
    match blur {
      Some(b) => {
        let _ = v.blur(view::Live::Is(b), loc=loc)
      }
      None => ()
    }
  })
}
