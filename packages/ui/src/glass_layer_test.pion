// White-box tests for framework-level same-layer liquid glass proximity fusion (`Glass::liquid(layer?, break_gap?)`
// + `Scene::merge_liquid_layers` in `glass_layer.pion`) and foreground optical lens (`View::content_lens`, `kind == 8`).

import "dmath"
import "paint"
import "signals"
import "view"

fn gl_liquid_insts(t : Tester) -> Array[(Int, Double, Double)] {
  let out : Array[(Int, Double, Double)] = []
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 23 && a[5] == 6.0 {
      out.push((i, a[20], a[23]))
    }
    i += 1
  }
  out
}

fn gl_shadow_indices(t : Tester) -> Array[Int] {
  let out : Array[Int] = []
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 5 && a[5] == 2.0 {
      out.push(i)
    }
    i += 1
  }
  out
}

fn gl_rect_indices_of_color(t : Tester, color : Int64) -> Array[Int] {
  let out : Array[Int] = []
  let insts = t.drawn_instances()
  let r = ((color >> 24) & 0xFFL).to_double() / 255.0
  let g = ((color >> 16) & 0xFFL).to_double() / 255.0
  let b = ((color >> 8) & 0xFFL).to_double() / 255.0
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 11 &&
    a[5] == 0.0 &&
    dmath::abs(a[8] - r) < 0.02 &&
    dmath::abs(a[9] - g) < 0.02 &&
    dmath::abs(a[10] - b) < 0.02 {
      out.push(i)
    }
    i += 1
  }
  out
}

fn gl_lens_insts(t : Tester) -> Array[(Int, Double, Double, Double, Double)] {
  let out : Array[(Int, Double, Double, Double, Double)] = []
  let insts = t.drawn_instances()
  let mut i = 0
  while i < insts.length() {
    let a = insts[i]
    if a.length() > 15 && a[5] == 8.0 {
      out.push((i, a[7], a[12], a[13], a[14]))
    }
    i += 1
  }
  out
}

test "same-layer liquid glass auto-merges when gap < break_gap, lifts children above glass, keeps shadows beneath, and decouples at rest" {
  set_glass_solid(None)
  let gap_sig = signals::signal(6.0)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(page : view::View) {
        let _ = page.grow(view::Live::Is(1.0)).ground(view::Live::Is(c64(0xF5F5, 0xF7FF)))
        // Trigger pill in bar (layer=1, with shadow and child icon rect 0x1122CCFF)
        let _ = page.box(fn(pill : view::View) {
          let _ = pill
          .over(view::Live::Is(true))
          .offset(view::Live::Is((40.0, 20.0)))
          .width(view::Live::Is(Some(80.0)))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(18.0))
          .glass(view::Live::Is(Some(paint::Glass::liquid(blur=2.5, merge=28.0, layer=1, break_gap=3.2))))
          .shadow(view::Live::Is((4.0, 1.5, c64(0x0000, 0x0022))))
          .shadow_outside(view::Live::Is(true))
          let _ = pill.box(fn(ic : view::View) {
            let _ = ic
            .width(view::Live::Is(Some(16.0)))
            .height(view::Live::Is(Some(16.0)))
            .ground(view::Live::Is(c64(0x1122, 0xCCFF)))
          })
        })
        // Unrelated page content between the two glass surfaces
        let _ = page.box(fn(mid : view::View) {
          let _ = mid
          .over(view::Live::Is(true))
          .offset(view::Live::Is((10.0, 100.0)))
          .width(view::Live::Is(Some(200.0)))
          .height(view::Live::Is(Some(40.0)))
          .ground(view::Live::Is(c64(0xDDDD, 0xDDFF)))
        })
        // Overlay panel in another layer (layer=1, with shadow and child menu row 0xCC2211FF)
        let _ = page.box(fn(ov : view::View) {
          let _ = ov.over(view::Live::Is(true))
          let _ = ov.box(fn(panel : view::View) {
            let _ = panel
            .over(view::Live::Is(true))
            .offset(view::Live::By(fn() { (40.0, 56.0 + gap_sig.get()) }))
            .width(view::Live::Is(Some(140.0)))
            .height(view::Live::Is(Some(100.0)))
            .radius(view::Live::Is(14.0))
            .glass(view::Live::Is(Some(paint::Glass::liquid(blur=8.0, merge=28.0, layer=1, break_gap=3.2))))
            .shadow(view::Live::Is((12.0, 4.0, c64(0x0000, 0x0033))))
            .shadow_outside(view::Live::Is(true))
            let _ = panel.box(fn(row : view::View) {
              let _ = row
              .width(view::Live::Is(Some(100.0)))
              .height(view::Live::Is(Some(20.0)))
              .ground(view::Live::Is(c64(0xCC22, 0x11FF)))
            })
          })
        })
      })
    },
    width=400.0,
    height=300.0,
  )
  // 1. At rest (gap = 6.0pt >= 3.2pt): independent captures, merge == 0.0
  t.frame()
  let rest_liq = gl_liquid_insts(t)
  debug_assert(rest_liq.length() == 2, "2 liquid instances at rest")
  debug_assert(rest_liq[0].1 != rest_liq[1].1, "independent capture ids at rest")
  debug_assert(rest_liq[0].2 == 0.0, "pill merge is 0.0 at rest")
  debug_assert(rest_liq[1].2 == 0.0, "panel merge is 0.0 at rest")

  // 2. Within break_gap (gap = 1.6pt < 3.2pt): auto-merged!
  gap_sig.set(1.6)
  t.frame()
  let close_liq = gl_liquid_insts(t)
  let shadows = gl_shadow_indices(t)
  let pill_icons = gl_rect_indices_of_color(t, c64(0x1122, 0xCCFF))
  let panel_rows = gl_rect_indices_of_color(t, c64(0xCC22, 0x11FF))
  debug_assert(close_liq.length() == 2, "2 liquid instances when bridging")
  debug_assert(close_liq[1].0 - close_liq[0].0 == 1, "merged liquid instances are strictly adjacent")
  debug_assert(close_liq[0].1 == close_liq[1].1, "merged liquid instances share one capture id")
  debug_assert(close_liq[0].2 > 0.0 && close_liq[1].2 > 0.0, "positive merge radius when gap < break_gap")
  debug_assert(shadows.length() == 2, "both shadows preserved")
  debug_assert(shadows[0] < close_liq[0].0 && shadows[1] < close_liq[0].0, "all shadows strictly beneath merged glass")
  debug_assert(pill_icons.length() == 1, "pill icon drawn")
  debug_assert(panel_rows.length() == 1, "panel row drawn")
  debug_assert(pill_icons[0] > close_liq[1].0, "pill child icon lifted strictly above merged glass")
  debug_assert(panel_rows[0] > close_liq[1].0, "panel child row strictly above merged glass")
  t.dispose()
  set_glass_solid(None)
}

test "3-way same-layer merge, cross-layer isolation, and solid glass fallback" {
  set_glass_solid(None)
  let panel_y = signals::signal(57.5)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(page : view::View) {
        let _ = page.grow(view::Live::Is(1.0)).ground(view::Live::Is(c64(0xF5F5, 0xF7FF)))
        // Pill A (layer=1) at x=20..56, y=20..56
        let _ = page.box(fn(a : view::View) {
          let _ = a
          .over(view::Live::Is(true))
          .offset(view::Live::Is((20.0, 20.0)))
          .width(view::Live::Is(Some(36.0)))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(18.0))
          .glass(view::Live::Is(Some(paint::Glass::liquid(blur=2.5, merge=28.0, layer=1, break_gap=3.2))))
        })
        // Pill B (layer=1) at x=62..132, y=20..56 (6pt from Pill A -> independent at rest!)
        let _ = page.box(fn(b : view::View) {
          let _ = b
          .over(view::Live::Is(true))
          .offset(view::Live::Is((62.0, 20.0)))
          .width(view::Live::Is(Some(70.0)))
          .height(view::Live::Is(Some(36.0)))
          .radius(view::Live::Is(18.0))
          .glass(view::Live::Is(Some(paint::Glass::liquid(blur=2.5, merge=28.0, layer=1, break_gap=3.2))))
        })
        // Different layer (layer=2) overlapping Pill B -> must NEVER merge with layer=1
        let _ = page.box(fn(other : view::View) {
          let _ = other
          .over(view::Live::Is(true))
          .offset(view::Live::Is((70.0, 25.0)))
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(24.0)))
          .radius(view::Live::Is(12.0))
          .glass(view::Live::Is(Some(paint::Glass::liquid(blur=2.5, merge=28.0, layer=2, break_gap=10.0))))
        })
        // Panel C (layer=1) spanning x=30..132, y=panel_y (1.5pt below BOTH Pill A and Pill B!)
        let _ = page.box(fn(c : view::View) {
          let _ = c
          .over(view::Live::Is(true))
          .offset(view::Live::By(fn() { (30.0, panel_y.get()) }))
          .width(view::Live::Is(Some(102.0)))
          .height(view::Live::Is(Some(80.0)))
          .radius(view::Live::Is(14.0))
          .glass(view::Live::Is(Some(paint::Glass::liquid(blur=8.0, merge=28.0, layer=1, break_gap=3.2))))
        })
      })
    },
    width=400.0,
    height=300.0,
  )
  // 1. Panel C within 1.5pt of BOTH Pill A and Pill B -> 3-way merge on layer=1; layer=2 stays separate
  t.frame()
  let liq = gl_liquid_insts(t)
  debug_assert(liq.length() == 4, "4 liquid instances total")
  let merged : Array[(Int, Double, Double)] = []
  let isolated : Array[(Int, Double, Double)] = []
  for x in liq {
    if x.2 > 0.0 {
      merged.push(x)
    } else {
      isolated.push(x)
    }
  }
  debug_assert(merged.length() == 3, "3-way merge on layer=1")
  debug_assert(isolated.length() == 1, "layer=2 remains isolated")
  debug_assert(merged[0].1 == merged[1].1, "merged[0] & merged[1] share capture")
  debug_assert(merged[1].1 == merged[2].1, "merged[1] & merged[2] share capture")
  debug_assert(merged[1].0 - merged[0].0 == 1, "merged[0] & merged[1] adjacent")
  debug_assert(merged[2].0 - merged[1].0 == 1, "merged[1] & merged[2] adjacent")
  debug_assert(isolated[0].1 != merged[0].1, "layer=2 has its own capture id")

  // 2. Move Panel C away (y = 70.0 -> 14pt gap): all 4 become independent
  panel_y.set(70.0)
  t.frame()
  let far = gl_liquid_insts(t)
  debug_assert(far.length() == 4, "4 independent liquid instances when separated")
  for x in far {
    debug_assert(x.2 == 0.0, "merge is 0.0 when separated")
  }

  // 3. solid glass fallback: 0 liquid instances
  set_glass_solid(Some(true))
  t.frame()
  debug_assert(gl_liquid_insts(t).length() == 0, "0 liquid glass instances in solid mode")
  t.dispose()
  set_glass_solid(None)
}

test "glass layer nav_scope and m_eff cap strictly <= 2.0 * break_gap" {
  debug_assert(glass_slots_nav_compatible(0, 0), "0 & 0 compatible")
  debug_assert(glass_slots_nav_compatible(1, 1), "1 & 1 compatible")
  debug_assert(glass_slots_nav_compatible(1, 0), "1 & 0 compatible")
  debug_assert(glass_slots_nav_compatible(0, 2), "0 & 2 compatible")
  debug_assert(!glass_slots_nav_compatible(1, 2), "1 & 2 incompatible")
  debug_assert(!glass_slots_nav_compatible(2, 1), "2 & 1 incompatible")

  let sc = Scene::new()
  sc.clear(360.0, 740.0, 2.0)
  let g0 = sc.push_inst(40.0, 20.0, 60.0, 36.0, 18.0, 6.0, 1.3, 4.0, c64(0xFFFF, 0xFF1A), 1.0, 0.55, 14.0, -1.0, 1.0)
  let g1 = sc.push_inst(50.0, 20.0, 60.0, 36.0, 18.0, 6.0, 1.3, 4.0, c64(0xFFFF, 0xFF1A), 1.0, 0.55, 14.0, -1.0, 1.0)
  let s0 = GlassSlot::{
    layer: 1,
    nav_scope: 1,
    id: view::NodeId::{ at: 1, gen: 1 },
    glass_idx: g0,
    shadow_idx: -1,
    sub_start: 0,
    sub_end: 1,
    x0: 40.0,
    y0: 20.0,
    x1: 100.0,
    y1: 56.0,
    cx0: 0.0,
    cy0: 0.0,
    cx1: 360.0,
    cy1: 740.0,
    merge_max: 20.0,
    break_gap: 3.0,
  }
  let s1 = GlassSlot::{
    layer: 1,
    nav_scope: 2,
    id: view::NodeId::{ at: 2, gen: 1 },
    glass_idx: g1,
    shadow_idx: -1,
    sub_start: 1,
    sub_end: 2,
    x0: 50.0,
    y0: 20.0,
    x1: 110.0,
    y1: 56.0,
    cx0: 0.0,
    cy0: 0.0,
    cx1: 360.0,
    cy1: 740.0,
    merge_max: 20.0,
    break_gap: 3.0,
  }
  sc.merge_liquid_layers(0, [s0, s1])
  debug_assert(sc.inst[g0 * inst_size + 23] == 0.0, "nav_scope=1 must not merge with nav_scope=2")
  debug_assert(sc.inst[g1 * inst_size + 23] == 0.0, "nav_scope=2 must not merge with nav_scope=1")

  let s1_root = GlassSlot::{ ..s1, nav_scope: 0 }
  sc.merge_liquid_layers(0, [s0, s1_root])
  debug_assert(sc.inst[g0 * inst_size + 23] > 5.9 && sc.inst[g0 * inst_size + 23] <= 6.01, "m_eff capped at 2*break_gap=6.0")
  debug_assert(sc.inst[g1 * inst_size + 23] > 5.9 && sc.inst[g1 * inst_size + 23] <= 6.01, "second slot capped at 6.0")
  debug_assert(sc.inst[g0 * inst_size + 20] == sc.inst[g1 * inst_size + 20], "shared capture id for page + root overlay")
}

test "View::content_lens emits zero kind == 8 instances at rest and wraps children when active" {
  let active = signals::signal(false)
  let t = Tester::tree(
    fn(root : view::View) {
      let _ = root.box(fn(box : view::View) {
        let _ = box
        .width(view::Live::Is(Some(120.0)))
        .height(view::Live::Is(Some(80.0)))
        .radius(view::Live::Is(16.0))
        .content_lens(
          view::Live::By(fn() {
            if active.get() {
              paint::ContentLens::{ blur: 4.0, refraction: 14.0, bezel: 20.0, alpha: 0.9 }
            } else {
              paint::ContentLens::none()
            }
          }),
        )
        let _ = box.box(fn(child : view::View) {
          let _ = child
          .width(view::Live::Is(Some(40.0)))
          .height(view::Live::Is(Some(40.0)))
          .ground(view::Live::Is(c64(0xFF00, 0x00FF)))
        })
      })
    },
    width=300.0,
    height=200.0,
  )
  // At rest: zero kind == 8 instances
  t.frame()
  debug_assert(gl_lens_insts(t).length() == 0, "zero kind == 8 instances at rest")

  // Active: 1 kind == 8 instance wrapping 1 child
  active.set(true)
  t.frame()
  let lenses = gl_lens_insts(t)
  debug_assert(lenses.length() == 1, "1 kind == 8 instance when active")
  debug_assert(dmath::abs(lenses[0].1 - 4.0) < 0.01, "blur == 4.0")
  debug_assert(lenses[0].2 == 1.0, "child_n == 1")
  debug_assert(dmath::abs(lenses[0].3 - 20.0) < 0.01, "bezel == 20.0")
  debug_assert(dmath::abs(lenses[0].4 - 14.0) < 0.01, "refraction == 14.0")
  t.dispose()
}
