    pill
    .over(.Is(true))
    .points(.Is(false))
    .offset(.Is((0.0, 0.0)))
    .width(.Is(Some(0.0)))
    .height(.Is(Some(0.0)))
    .radius(.Is(0.0))
    .alpha(.By(fn() { 1.0 - lm_smoothstep(0.15, 0.75, lens_of(pill)) }))
    .ground_drawn(.By(fn() {
