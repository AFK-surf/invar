      let full = fn() { lens_of(gl) }
      gl
      .over(.Is(true))
      .points(.Is(false))
      .offset(.Is((0.0, 0.0)))
      .width(.Is(Some(0.0)))
      .height(.Is(Some(0.0)))
      .radius(.Is(1.0e6))
      .shadow(.By(fn() {
