          if no_lens() {
            dd.drop_lens()
            dd.slide_to(orig.to_double(), spec=motion::snappy_damped)
          } else {
            dd.settle_to(orig.to_double(), spec=motion::snappy_damped, within_frac=0.18, relative_trip=true)
          }
        }
        if !keep_vertical_lock {
          dd.end_gesture(g)
        }
      }
      let cancel_drag = fn() { cancel_drag_opts(false) }
      let finger_preview = fn(k : Int, event : Option[view::Drag]) -> Option[Int] {
        let last = last_fn()
        dd.attach_if_needed(g)
        dd.set_bounds(lo=0.0, hi=last)
        match event {
          Some(d) => {
            let p = index_at(x_of(k) + d.x)
            let nearest = clamp((p + 0.5).floor(), 0.0, last).to_int()
            let prev_felt = felt.v.unwrap_or(signals::untracked(selected))
            let steps = (nearest - prev_felt).abs()
            for _ in 0..<steps {
              ui::haptic(.TextHandleMove)
            }
            felt.v = Some(nearest)
            let target = nearest.to_double()
            let leaned = target + (p - target) * ctrl_seg_drag_lean
            if !finger_previewing.v {
              finger_previewing.v = true
              if !no_lens() {
                dd.press()
              }
            }
            if no_lens() {
              dd.slide_to(leaned, spec=motion::tactile_bounce)
            } else {
              dd.update_value(leaned, spec=motion::tactile_bounce)
            }
            Some(nearest)
          }
          Option::None => {
            cancel_drag_opts(true)
            Option::None
          }
        }
      }
      let finger_commit = fn(sel : Int) {
        let prev = signals::untracked(selected)
        if felt.v != Some(sel) && sel != prev {
          ui::haptic(.TextHandleMove)
        }
        let was_previewing = finger_previewing.v
        clear_press_state()
        let commit_spec = if was_previewing { motion::tactile_bounce } else { motion::snappy_damped }
        drag_commit(sel, Some(commit_spec))
      }
      host
      .row(.Is(true))
      .gap(.Is(gap))
      .height(.By(fn() { Some(total_h()) }))
      .lines_up(.Is(Some(.Middle)))
      |> ignore
      host.each(fn() {
        let ls = labels()
        let out : Array[(Int, String)] = []
        for i, s in ls {
          out.push((i, s))
        }
        out
      }, fn(p) { p.0 }, fn(slot, item_sig) {
        let idx = signals::untracked(fn() { item_sig.get().0 })
        let idx_f = idx.to_double()
        rg.item(made_for=loc, slot, fn() { item_sig.get().0 }, fn() { item_sig.get().1 }, in_node=true, fn(seg, it) {
          let across = fn(d : view::Drag) { (d.x - d.ox).abs() > (d.y - d.oy).abs() }
          let on_it = fn(d : view::Drag) { seg.finger_target(d.wx, d.wy) }
          if widths is Some(_) {
            seg.width(view::Live::By(fn() { Some(w_of(idx)) })) |> ignore
          } else {
            seg
            .grow(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .padding(view::Live::By(fn() {
              let sw = w_of(idx)
              let px = if sw > 0.0 && sw < 86.0 { 4.0 } else { ctrl_seg_px }
              (px, 0.0, px, 0.0)
            }))
            |> ignore
          }
          seg
          .height(view::Live::By(fn() { Some(if glass_track { total_h() } else { inner_h() }) }))
          .lines_up(view::Live::Is(Some(.Middle)))
          .lies_along(view::Live::Is(.Middle))
          |> ignore
          match render_item {
            Some(draw_item) => draw_item(seg, idx, fn() { it.chosen() })
            Option::None =>
            seg.box(fn(w) {
              w
              .words(view::Live::By(fn() { item_sig.get().1 }))
              .words_look(view::Live::By(fn() {
                let sz = match text_size {
                  Some(f) => f()
                  Option::None => ctrl_type_seg
                }
                if glass_track {
                  words_at(sz, weight=if it.chosen() { 600 } else { weight_medium })
                } else {
                  view::WordsLook::{
                    size: sz,
                    weight: if it.chosen() { 600 } else { 500 },
                    line: -ui::tree_theme().text_line,
                    wrap: false,
                    tracking: view::letters_own,
                    balance: false,
                    max_lines: 0, diagonal_fractions: false, tabular: Option::None
                  }
                }
              }))
              .ink(view::Live::By(fn() {
                let lit = clamp(1.0 - (dd.value(w) - idx_f).abs(), 0.0, 1.0)
                let (off_c, on_c) = if glass_track {
                  (ctrl_seg_inactive_ink(), colors().content)
                } else {
                  (colors().content, colors().content)
                }
                if !glass_track && it.hovered() && lit < 0.5 {
                  on_c
                } else {
                  lerp_color(off_c, on_c, lit)
                }
              }))
              |> ignore
            })
            |> ignore
          }
          // Gesture target directly on the item (no nested pressable box, keeping 36pt press_room intact).
          // Intentional mouse vs touch asymmetry: mouse press on an unselected segment never grabs the thumb or
          // lifts a lens; mouse drag/hold only activates on the already-selected segment.
          seg.gesture(ui::touch_slop(), press=fn(d) {
            if !dd.same_host(Some(g)) {
              dd.attach(g)
            }
            dd.set_bounds(lo=0.0, hi=last_fn())
            dd.claim_gesture(g)
            pressing_here.v = true
            press_was_finger.v = ui::pointing() is .Finger
            drag_active.v = false
            axis_locked.v = Option::None
            press_idx.v = Some(idx)
            press_on_selected.v = idx == signals::untracked(selected)
            press_labels.v = signals::untracked(labels).copy()
            strip_origin_x.v = d.wx - (x_of(idx) + d.x)
          }, tap=fn(d) {
            if press_was_finger.v {
              if !labels_unchanged() {
                cancel_drag()
              } else if on_it(d) {
                if !finger_previewing.v && idx != signals::untracked(selected) {
                  clear_press_state()
                  tap_commit(idx)
                } else {
                  finger_commit(idx)
                }
              } else {
                cancel_drag()
              }
            } else {
              let was_drag = drag_active.v
              let unchanged = labels_unchanged()
              let still_on = on_it(d)
              if !unchanged || !still_on {
                cancel_drag()
              } else {
                clear_press_state()
                if was_drag {
                  drag_commit(idx, Option::None)
                } else {
                  tap_commit(idx)
                }
              }
            }
          }, hold=(ctrl_seg_hold_ms, fn(d) {
            if !labels_unchanged() {
              cancel_drag()
              return
            }
            if press_was_finger.v {
              finger_preview(idx, Some(d)) |> ignore
            } else if press_on_selected.v {
              drag_active.v = true
              if !no_lens() && !dd.pressing() {
                dd.press()
              }
            }
          }), hold_yields=true, drag=fn(d) {
            let last = last_fn()
            dd.attach_if_needed(g)
            dd.set_bounds(lo=0.0, hi=last)
            if press_was_finger.v {
              match d.kind {
                view::DragIs::Down | view::DragIs::Moved => {
                  if !labels_unchanged() {
                    cancel_drag()
                    return
                  }
                  if d.kind == .Down {
                    axis_locked.v = Some(across(d))
                  }
                  if axis_locked.v == Some(true) {
                    finger_preview(idx, Some(d)) |> ignore
                  } else {
                    finger_preview(idx, Option::None) |> ignore
                  }
                }
                view::DragIs::Up => {
                  let hold_still = finger_previewing.v &&
                  axis_locked.v is Option::None &&
                  (d.x - d.ox).abs() <= ui::touch_slop() &&
                  (d.y - d.oy).abs() <= ui::touch_slop()
                  if !labels_unchanged() ||
                  axis_locked.v == Some(false) ||
                  (!hold_still && !axis_locked.v.unwrap_or(across(d))) {
                    cancel_drag()
                  } else {
                    match finger_preview(idx, Some(d)) {
                      Some(sel) => finger_commit(sel)
                      Option::None => cancel_drag()
                    }
                  }
                }
                view::DragIs::Off => cancel_drag()
              }
            } else {
              let started_on_selected = press_on_selected.v
              if !started_on_selected {
                match d.kind {
                  view::DragIs::Down | view::DragIs::Moved => ()
                  view::DragIs::Up =>
                  if !drag_active.v && on_it(d) && labels_unchanged() {
                    clear_press_state()
                    tap_commit(idx)
                  } else {
                    cancel_drag()
                  }
                  view::DragIs::Off => cancel_drag()
                }
              } else {
                match d.kind {
                  view::DragIs::Down => {
                    if !labels_unchanged() {
                      cancel_drag()
                      return
                    }
                    let is_h = across(d)
                    axis_locked.v = Some(is_h)
                    if is_h {
                      drag_active.v = true
                      if !no_lens() && !dd.pressing() {
                        dd.press()
                      }
                      let p = index_at(d.wx - strip_origin_x.v)
                      if no_lens() {
                        dd.slide_to(p)
                      } else {
                        dd.update_value(p)
                      }
                    } else {
                      cancel_drag_opts(true)
                    }
                  }
                  view::DragIs::Moved => {
                    if !labels_unchanged() {
                      cancel_drag()
                      return
                    }
                    if axis_locked.v == Some(true) {
                      let p = index_at(d.wx - strip_origin_x.v)
                      if no_lens() {
                        dd.slide_to(p)
                      } else {
                        dd.update_value(p)
                      }
                    }
                  }
                  view::DragIs::Up => {
                    if !labels_unchanged() || axis_locked.v == Some(false) {
                      cancel_drag()
                    } else if axis_locked.v.unwrap_or(across(d)) {
                      let p = index_at(d.wx - strip_origin_x.v)
                      let i = clamp(p.round(), 0.0, last).to_int()
                      clear_press_state()
                      drag_commit(i, Option::None)
                    } else {
                      cancel_drag()
                    }
                  }
                  view::DragIs::Off => cancel_drag()
                }
              }
            }
          })
          |> ignore
          seg
          .radius(view::Live::By(fn() { inner_h() / 2.0 }))
          .edge(view::Live::By(fn() {
            if it.focus_shown() {
              (ctrl_focus_w, if glass_track { colors().accent } else { ui::tree_theme().focus })
            } else {
              (0.0, clear)
            }
          }))
          |> ignore
        })
        |> ignore
      }, at_once=true)
      // Mount the clear refraction loupe above labels for both `glass_track=true` and `glass_track=false`
      // so dragging magnifies and refracts the segment labels underneath (iOS 26/27 optical Z-order).
      mount_lens()
    }
    if widths is Some(_) {
      build_body(g, pad, fn() { 0.0 })
    } else {
      g.by_room(fn(inner, room) { build_body(inner, 0.0, fn() { room.width() }) }) |> ignore
    }
  }, loc="liquid_segmented.mbt:259:3")
}
