///|
/// Words `size` high at `weight`, on one line unless `wrap` (at most `lines` of them where `lines` > 0).
pub fn words_at(size : Double, weight? : Int, wrap? : Bool, lines? : Int) -> view::WordsLook {
  let weight = match weight { Some(__mbt_v) => __mbt_v, None => 400 }
  let wrap = match wrap { Some(__mbt_v) => __mbt_v, None => false }
  let lines = match lines { Some(__mbt_v) => __mbt_v, None => 0 }

  view::WordsLook::{
    size: size,
    weight: weight,
    line: size * 1.4,
    wrap: wrap,
    tracking: if size >= 18.0 { .Points(-0.25) } else { .Points(0.0) },
    balance: false,
    max_lines: lines, diagonal_fractions: false, tabular: Option::None
  }
}

