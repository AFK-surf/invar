import "view"

// Fluid Scrubber Track (Apple AVPlayer / Apple Music style): a thumb-free pill track that swells smoothly in place
// on hover (5pt -> 7.5pt) and press/drag (7.5pt -> 10pt) via paint-layer `ground_drawn` (laid == 0, 0 glass layers).
// Both buffered and active fill segments nest inside the clipping base track (`track.clips(true)`), which pushes its
// live `ground_drawn` capsule SDF clip so `fill` and `buffered` stay strictly inside `track_capsule ∩ {x <= w * p}`
// with exact right-edge accuracy at every progress (including 1% on a 72pt volume bar) and zero vertical overflow.

///|
/// Visual configuration for `fluid_scrubber_look`, decoupling fluid track/buffered/fill/focus
/// painting from gesture and media state handling.
pub struct ScrubberLook {
  pub rest_h : Double
  pub hover_h : Double
  pub active_h : Double
  pub track_color : () -> Int64
  pub fill_color : () -> Int64
  pub buffered : Option[() -> Double]
  pub buffered_color : Option[() -> Int64]
  pub focus_shown : Option[() -> Bool]
  pub focus_color : Option[() -> Int64]
  pub disabled : () -> Bool
}

///|
/// Construct a `ScrubberLook` with Apple AVPlayer-style fluid scrubber defaults (5pt rest, 7.5pt hover, 10pt active).
pub fn ScrubberLook::new(heights? : (Double, Double, Double), track_color? : () -> Int64, fill_color? : () -> Int64, buffered? : Option[() -> Double], buffered_color? : Option[() -> Int64], focus_shown? : Option[() -> Bool], focus_color? : Option[() -> Int64], disabled? : () -> Bool) -> ScrubberLook {
  let heights = match heights { Some(__mbt_v) => __mbt_v, None => (5.0, 7.5, 10.0) }
  let track_color = match track_color { Some(__mbt_v) => __mbt_v, None => fn() { colors().track } }
  let fill_color = match fill_color { Some(__mbt_v) => __mbt_v, None => fn() { colors().accent } }
  let buffered = match buffered { Some(__mbt_v) => __mbt_v, None => Option::None }
  let buffered_color = match buffered_color { Some(__mbt_v) => __mbt_v, None => Option::None }
  let focus_shown = match focus_shown { Some(__mbt_v) => __mbt_v, None => Option::None }
  let focus_color = match focus_color { Some(__mbt_v) => __mbt_v, None => Option::None }
  let disabled = match disabled { Some(__mbt_v) => __mbt_v, None => fn() { false } }

  let (rest_h, hover_h, active_h) = heights
  ScrubberLook::{
    rest_h: rest_h,
    hover_h: hover_h,
    active_h: active_h,
    track_color: track_color,
    fill_color: fill_color,
    buffered: buffered,
    buffered_color: buffered_color,
    focus_shown: focus_shown,
    focus_color: focus_color,
    disabled: disabled,
  }
