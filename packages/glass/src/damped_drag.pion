///|
/// At `initial` along `lo` … `hi`, resting within `threshold`, drawn `rest_scale` times as large at rest and
/// `held_scale` held.
pub fn DampedDrag::new(initial : Double, lo~ : Double, hi~ : Double, threshold? : Double, rest_scale? : Double, held_scale~ : Double) -> DampedDrag {
  let threshold = match threshold { Some(__mbt_v) => __mbt_v, None => 0.001 }
  let rest_scale = match rest_scale { Some(__mbt_v) => __mbt_v, None => 1.0 }

  let v = clamp(initial, lo, hi)
  DampedDrag::{
    lo: lo,
    hi: hi,
    threshold: threshold,
    rest_scale: rest_scale,
    held_scale: held_scale,
    value: motion::NodeWay::new(v),
    speed: motion::NodeWay::new(0.0),
    press: motion::NodeWay::new(0.0),
    scale_x: motion::NodeWay::new(rest_scale),
    scale_y: motion::NodeWay::new(rest_scale),
    node: mbt_compat::ref_new(Option::None),
    active_driver: mbt_compat::ref_new(Option::None),
    gest_owner: mbt_compat::ref_new(Option::None),
    gest_seq: signals::signal(0),
    host_seq: signals::signal(0),
    bounds_seq: signals::signal(0),
    last: mbt_compat::ref_new(Option::None),
    letting_go: mbt_compat::ref_new(Option::None),
    stilling: mbt_compat::ref_new(Option::None),
    last_release: mbt_compat::ref_new((0.025, false)),
    letting_go_scheduled: 0,
    stilling_scheduled: 0,
  }
