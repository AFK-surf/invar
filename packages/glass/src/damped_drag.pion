  priv scale_x : motion::NodeWay
  priv scale_y : motion::NodeWay
  priv node : mbt_compat::Ref[Option[view::View]]
  priv active_driver : mbt_compat::Ref[Option[view::View]]
  priv gest_owner : mbt_compat::Ref[Option[view::View]]
