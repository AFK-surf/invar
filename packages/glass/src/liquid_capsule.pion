  let sharing = match sharing { Some(__mbt_v) => __mbt_v, None => true }
  let clips = match clips { Some(__mbt_v) => __mbt_v, None => true }
  let with_scale = match with_scale { Some(__mbt_v) => __mbt_v, None => true }

  let ih = match highlight {
    Some(h) => h
    Option::None => InteractiveHighlight::new()
  }
  ih.attach(b)
  if with_scale {
    b
    .scale(.By(fn() {
      let (_, _, sx, sy) = ih.stretch(b)
      (sx + sy) / 2.0
    }), about=.At(0.5, 0.5), moves_besides=false)
    |> ignore
  }
  b
  .glass(.By(fn() {
    let spot = if !b.glass_solid() && ih.pressed(b) > 0.001 {
      let (_, _, bw, bh) = b.placed_now()
      if bw > 0.0 && bh > 0.0 {
        Some(ih.spot(b, bw, bh))
      } else {
        let (sw, sh) = ih.size.get()
        if sw > 0.0 && sh > 0.0 {
          Some(ih.spot(b, sw, sh))
        } else {
          None
        }
      }
    } else {
      None
    }
    let sol = match solid {
      Some(f) => f()
      Option::None => clear
    }
    let custom_tint = match tint {
      Some(f) => f()
      Option::None => None
    }
    Some(capsule_tone_glass(tone, spot, sol, custom_tint, sharing))
  }))
  .edge(.By(fn() {
    if b.glass_solid() {
      match solid_edge {
        Some(f) => f()
        Option::None => liquid_solid_edge()
      }
    } else {
      (0.0, clear)
    }
  }))
  .shadow(.By(fn() {
    match shadow {
      Some(f) => f()
      Option::None => shadow_default
    }
  }))
  .shadow_outside(.Is(true))
  |> ignore
  if clips {
    b.clips(.Is(true)) |> ignore
  }
  ih
}

