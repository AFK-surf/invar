      let g = liquid_bar_pill_glass(spot=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        Option::None => g
      }
    }
    LiquidCapsuleTone::ViewerClear => {
      let g = liquid_viewer_clear_glass(spot=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        Option::None => g
      }
    }
    LiquidCapsuleTone::ViewerDark => {
      let g = liquid_viewer_dark_glass(spot=spot, solid=sol, sharing=sharing)
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        Option::None => g
      }
    }
    LiquidCapsuleTone::Panel => {
      let g = maybe_sharing(liquid_panel_glass(solid=sol), sharing)
      let g = match spot {
        Some(_) => paint::Glass::{ ..g, spot }
        Option::None => g
      }
      match custom_tint {
        Some(c) => paint::Glass::{ ..g, tint: c }
        Option::None => g
