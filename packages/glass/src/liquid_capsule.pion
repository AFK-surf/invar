        Some(sf) => { let __mbt_su_b_2 : paint::Glass = base; paint::Glass::{ blur: __mbt_su_b_2.blur, tint: __mbt_su_b_2.tint, saturation: __mbt_su_b_2.saturation, solid: sf(), rim_edge: __mbt_su_b_2.rim_edge, rim_lit: __mbt_su_b_2.rim_lit, rim_back: __mbt_su_b_2.rim_back, liquid: __mbt_su_b_2.liquid, rim: __mbt_su_b_2.rim, bezel: __mbt_su_b_2.bezel, refraction: __mbt_su_b_2.refraction, chroma: __mbt_su_b_2.chroma, merge: __mbt_su_b_2.merge, adaptive: __mbt_su_b_2.adaptive, shares_capture: __mbt_su_b_2.shares_capture, contained: __mbt_su_b_2.contained, spot: __mbt_su_b_2.spot, zoom: __mbt_su_b_2.zoom, strength: __mbt_su_b_2.strength, progressive: __mbt_su_b_2.progressive, layer: __mbt_su_b_2.layer, break_gap: __mbt_su_b_2.break_gap, droplet_role: __mbt_su_b_2.droplet_role } }
        Option::None => base
