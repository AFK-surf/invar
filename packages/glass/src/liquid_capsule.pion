///|
/// Creates a child box in `parent`, decorates it with `liquid_capsule_decorate`, and runs `body`.

pub fn liquid_capsule_node(parent : view::View, body : (view::View) -> Unit, tone? : LiquidCapsuleTone, min_height? : Option[Double], radius? : Option[Double], sharing? : Bool, interactive? : Bool, solid? : () -> Int64, tint? : () -> Option[Int64], extra_blur? : () -> Double, active? : () -> Bool, shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), clips? : Bool, loc~ : String = "") -> view::View {
  let tone = match tone { Some(__mbt_v) => __mbt_v, None => LiquidCapsuleTone::Floating }
  let min_height = match min_height { Some(__mbt_v) => __mbt_v, None => Option::None }
  let radius = match radius { Some(__mbt_v) => __mbt_v, None => Option::None }
  let sharing = match sharing { Some(__mbt_v) => __mbt_v, None => true }
  let interactive = match interactive { Some(__mbt_v) => __mbt_v, None => false }
  let clips = match clips { Some(__mbt_v) => __mbt_v, None => true }

  parent.box(made_for=loc, fn(v) {
    liquid_capsule_decorate(v, tone=tone, min_height=min_height, radius=radius, sharing=sharing, interactive=interactive, solid?=solid, tint?=tint, extra_blur?=extra_blur, active?=active, shadow?=shadow, solid_edge?=solid_edge, clips=clips)
    |> ignore
    body(v)
  })
}

///|
/// Decorates an interactive control `b` with an `InteractiveHighlight`-driven elastic scale,
/// touch-tracked GPU `spot` liquid glass, outside-only shadow, and `MBUI_GLASS=solid` hairline
/// edge. Returns the attached `InteractiveHighlight` so the caller's gesture handler drives
/// `down`, `moved`, and `up`.
pub fn liquid_press_glass_decorate(b : view::View, tone? : LiquidCapsuleTone, sharing? : Bool, solid? : () -> Int64, tint? : () -> Option[Int64], shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), clips? : Bool, with_scale? : Bool, highlight? : InteractiveHighlight) -> InteractiveHighlight {
