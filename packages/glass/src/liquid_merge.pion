///|
/// Creates a `LiquidMerge` controller, starting either merged (`separated=false`) or separated.
pub fn LiquidMerge::new(separated? : Bool, merge_max? : Double, break_gap? : Double, merged_gap? : Double, separated_gap? : Double, max_gap? : Double, auto_separate? : Bool) -> LiquidMerge {
  let separated = match separated { Some(__mbt_v) => __mbt_v, None => false }
  let merge_max = match merge_max { Some(__mbt_v) => __mbt_v, None => merge_k_max }
  let break_gap = match break_gap { Some(__mbt_v) => __mbt_v, None => merge_break_gap }
  let merged_gap = match merged_gap { Some(__mbt_v) => __mbt_v, None => merge_merged_gap }
  let separated_gap = match separated_gap { Some(__mbt_v) => __mbt_v, None => merge_separated_gap }
  let max_gap = match max_gap { Some(__mbt_v) => __mbt_v, None => merge_max_gap }
  let auto_separate = match auto_separate { Some(__mbt_v) => __mbt_v, None => true }

  let start_x = (if separated { separated_gap } else { merged_gap }) + merge_contact_gap
  LiquidMerge::{
    merged_gap: merged_gap,
    separated_gap: separated_gap,
    max_gap: max_gap,
    auto_separate: auto_separate,
    bond: motion::LiquidBond::new(merged=!separated, merge_max=merge_max, break_gap=break_gap, contact_gap=0.0),
    x_way: motion::Way::new(start_x),
    y_way: motion::Way::new(0.0),
    recoil_x: motion::Way::new(0.0),
    recoil_y: motion::Way::new(0.0),
    separated_sig: signals::signal(separated, same=fn(a, b) { a == b }),
    dragging_sig: signals::signal(false, same=fn(a, b) { a == b }),
    dragging: mbt_compat::ref_new(false),
    drag_start_wx: mbt_compat::ref_new(0.0),
    drag_start_wy: mbt_compat::ref_new(0.0),
    drag_start_x: mbt_compat::ref_new(start_x),
    drag_start_y: mbt_compat::ref_new(0.0),
    split_this_drag: mbt_compat::ref_new(false),
    geom: mbt_compat::ref_new((0.0, 12.0, merge_main_w, merge_main_h, merge_sat_size)),
    bounds: mbt_compat::ref_new((merged_gap - 6.0, max_gap, 0.0, 0.0)),
