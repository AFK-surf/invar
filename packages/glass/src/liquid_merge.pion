///|
fn merge_smoothstep(lo : Double, hi : Double, x : Double) -> Double {
  if hi <= lo {
    return if x >= hi { 1.0 } else { 0.0 }
  }
  let u = clamp((x - lo) / (hi - lo), 0.0, 1.0)
  u * u * (3.0 - 2.0 * u)
}

///|
fn merge_glass(merge : Double, rim? : Double, spot? : Option[(Double, Double)]) -> paint::Glass {
  let rim = match rim { Some(__mbt_v) => __mbt_v, None => 0.6 }
  let spot = match spot { Some(__mbt_v) => __mbt_v, None => Option::None }

  let d = is_dark()
  paint::Glass::liquid(blur=2.1, tint=if d { 0x20202067L } else { 0xFDFCFD67L }, solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL }, saturation=1.0, rim=rim, bezel=20.0, refraction=28.0, chroma=0.0, merge=merge, adaptive=false, spot=spot)
}

///|
/// Controller for a two-body 360° 2D liquid glass merge/split interaction.
pub struct LiquidMerge {
  priv merged_gap : Double
  priv separated_gap : Double
  priv max_gap : Double
  priv auto_separate : Bool
  priv bond : motion::LiquidBond
