  let from_top = match from_top { Some(__mbt_v) => __mbt_v, None => false }
  let shield = match shield { Some(__mbt_v) => __mbt_v, None => true }
  let pure = match pure { Some(__mbt_v) => __mbt_v, None => false }

  let build_scrim = fn(scrim : view::View) {
    scrim
    .width_share(.Is(1.0))
    .height(.By(fn() { Some(base_h(scrim)) }))
    .fades(.By(fn() {
      match side {
        ScrollEdgeSide::Top => (0.0, 0.0, 0.0, fade_h(scrim))
        ScrollEdgeSide::Bottom => (0.0, fade_h(scrim), 0.0, 0.0)
      }
    }))
    |> ignore
    scrim.box(fn(fill) {
      // Register fill in inputs_in via pointed() while keeping points=false when shield=true so Tree::target_at
      // visits fill and applies Node::covers to block click-through onto scrolled content without affecting hover.
      fill
      .width_share(.Is(1.0))
      .height_share(.Is(1.0))
      .glass(.By(fn() {
        if base_h(fill) > 0.0 {
          let color = match bg_by {
            Some(f) => f(fill)
            Option::None =>
            match bg {
              Some(f) => f()
              Option::None => clear
            }
          }
          Some(liquid_scroll_edge_glass(bg=color, pure=pure))
        } else {
          Option::None
        }
      }))
      .points(.Is(false))
      |> ignore
      if shield {
        signals::untracked(fn() { fill.pointed() }) |> ignore
      }
    })
    |> ignore
  }
  match side {
    ScrollEdgeSide::Top =>
    parent.box(made_for=loc, fn(scrim) {
      scrim.over(.Is(true), from_top=from_top) |> ignore
      build_scrim(scrim)
    })
