///|
/// Clear refractive liquid glass lens recipe for knobs and text loupes (`blur=0`, `tint=clear`,
/// `bezel=7`, `refraction=3.5`, `chroma=0.0` — strictly below Switch `pinchWeight` 4.5 threshold).
pub fn liquid_knob_glass(solid? : Int64) -> paint::Glass {
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => clear }

  let sol = if solid != clear { solid } else { colors().paper }
  paint::Glass::liquid(blur=0.0, tint=0xFFFFFF00L, solid=sol, saturation=1.0, rim=0.6, bezel=7.0, refraction=3.5, chroma=0.0, merge=0.0, adaptive=false)
}

///|
/// Clear lifted Liquid Glass loupe for bottom tab bar / segmented control thumbs while held.
pub fn liquid_tab_lens_glass(press : Double, solid? : Int64, sharing? : Bool, droplet_role? : Int) -> paint::Glass {
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => clear }
  let sharing = match sharing { Some(__mbt_v) => __mbt_v, None => false }
  let droplet_role = match droplet_role { Some(__mbt_v) => __mbt_v, None => 4 }

  let p = clamp(press, 0.0, 1.0)
  let d = is_dark()
  let sol = if solid != clear {
    solid
  } else if d {
    0x242428FFL
  } else {
    0xFFFFFFFFL
  }
  maybe_sharing(paint::Glass::liquid(blur=0.0, tint=0xFFFFFF00L, solid=sol, saturation=1.0, rim=1.0 * p, bezel=14.0 * p, refraction=13.5 * p, chroma=0.04 * p, merge=0.0, adaptive=false, spot=Option::None, zoom=if droplet_role == 4 { 1.0 + 0.16 * p } else { 1.0 }, droplet_role=droplet_role), sharing)
}

///|
fn ctrl_segmented_track_glass() -> paint::Glass {
  let d = is_dark()
  paint::Glass::liquid(blur=1.2, tint=if d { 0x20202067L } else { 0xFDFCFD67L }, solid=if d { 0x1E1F24FFL } else { 0xFAFAFAFFL }, saturation=1.0, rim=0.6, bezel=16.0, refraction=20.0, chroma=0.06, merge=0.0, adaptive=false, spot=Option::None)
}

///|
/// Calibrated clear loupe recipe for standalone 40-44pt segmented capsules overlaid above labels (`glass_track=true`).
/// Keeps maximum inward refraction inside the clear vertical margin so top/bottom bevel rims never ghost text strokes.
fn ctrl_segmented_lens_glass(p : Double, solid? : Int64) -> paint::Glass {
  let p = clamp(p, 0.0, 1.0)
  let c = colors()
  let sol = match solid {
    Some(s) if s != clear => s
    _ => alpha(c.container, 1.0 / 0.4)
  }
  paint::Glass::liquid(blur=0.0, tint=0xFFFFFF00L, solid=sol, saturation=1.0, rim=1.0 * p, bezel=9.0 * p, refraction=9.0 * p, chroma=0.04 * p, merge=0.0, adaptive=false, spot=Option::None, zoom=1.0, droplet_role=3)
}

///|
/// Calibrated clear loupe recipe for compact 30-36pt segmented capsules overlaid above labels (`glass_track=false`).
/// Pure crystal droplet (`tint=0xFFFFFF00L`, `zoom=1.0`) overhanging track edges for Native iOS 27 concentric moat.
fn ctrl_segmented_compact_lens_glass(p : Double) -> paint::Glass {
  let p = clamp(p, 0.0, 1.0)
  let c = colors()
  paint::Glass::liquid(blur=0.0, tint=0xFFFFFF00L, solid=alpha(c.container, 1.0 / 0.4), saturation=1.0, rim=1.0 * p, bezel=9.0 * p, refraction=9.0 * p, chroma=0.04 * p, merge=0.0, adaptive=false, spot=Option::None, zoom=1.0, droplet_role=3)
}
