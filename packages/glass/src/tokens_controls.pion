///|
/// Theme-adaptive hairline edge for `MBUI_GLASS=solid` fallback (0.5pt).
pub fn liquid_solid_edge() -> (Double, Int64) {
  if is_dark() {
    (0.5, 0xFFFFFF26L)
  } else {
    (0.5, 0x0000001CL)
  }
}

///|
/// Theme-adaptive hover overlay ink for controls inside a liquid glass pill group.
/// Light mode uses a soft dark wash (~11%) that the GPU automatically flips to luminous white (~16%)
/// when an adaptive glass capsule sits over dark or saturated backdrops.
pub fn liquid_pill_hover_ink(solid? : Bool) -> Int64 {
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => false }

  ignore(solid)
  if is_dark() {
    0xFFFFFF29L
  } else {
    0x0000001CL
  }
}

///|
/// Theme-adaptive press overlay ink over translucent glass: luminous white highlight over real GPU liquid glass
/// in both Light and Dark modes (matching Apple `.glassEffect(.interactive())` with zero grey veil), falling back
/// to subtle dark contrast ink in Light mode when `MBUI_GLASS=solid` disables the GPU spot highlight.
pub fn liquid_press_ink(solid? : Bool) -> Int64 {
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => false }

  if !solid {
    if is_dark() {
      0xFFFFFF38L
    } else {
      0xFFFFFF4CL
    }
  } else if is_dark() {
    0xFFFFFF38L
  } else {
    0x00000018L
  }
}

///|
fn maybe_sharing(g : paint::Glass, sharing : Bool) -> paint::Glass {
  if sharing {
    g.sharing()
  } else {
    g
  }
}

///|
/// Translucent iOS 27 Liquid Glass for floating top-bar action pills (36–40pt tall), sharing capture by default.
pub fn liquid_bar_pill_glass(spot? : Option[(Double, Double)], solid? : Int64, sharing? : Bool, adaptive? : Bool) -> paint::Glass {
  let spot = match spot { Some(__mbt_v) => __mbt_v, None => Option::None }
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => clear }
  let sharing = match sharing { Some(__mbt_v) => __mbt_v, None => true }
  let adaptive = match adaptive { Some(__mbt_v) => __mbt_v, None => false }

  let d = is_dark()
  let tint = if d { 0x20202067L } else { 0xFDFCFD67L }
  let sol = if solid != clear {
    solid
  } else if d {
    0x1E1F24FFL
  } else {
    0xFAFAFAFFL
  }
  maybe_sharing(paint::Glass::liquid(blur=1.2, tint=tint, solid=sol, saturation=1.0, rim=0.6, bezel=14.0, refraction=20.0, chroma=0.06, merge=0.0, adaptive=adaptive, spot=spot), sharing)
}

///|
/// Floating adaptive iOS 27 Liquid Glass capsule (e.g. composer / floating island over scrolling content).
pub fn liquid_floating_glass(tint? : Option[Int64], solid? : Int64, spot? : Option[(Double, Double)], sharing? : Bool) -> paint::Glass {
  let tint = match tint { Some(__mbt_v) => __mbt_v, None => Option::None }
  let solid = match solid { Some(__mbt_v) => __mbt_v, None => clear }
  let spot = match spot { Some(__mbt_v) => __mbt_v, None => Option::None }
  let sharing = match sharing { Some(__mbt_v) => __mbt_v, None => false }

  let d = is_dark()
  let glass_tint = match tint {
    Some(c) => c
    Option::None => if d { 0x20202067L } else { 0xFDFCFD67L }
  }
  let sol = if solid != clear {
    solid
  } else if d {
    0x1E1F24FFL
  } else {
    0xFAFAFAFFL
  }
  maybe_sharing(paint::Glass::liquid(blur=1.2, tint=glass_tint, solid=sol, saturation=1.0, rim=0.6, bezel=20.0, refraction=28.0, chroma=0.06, merge=0.0, adaptive=true, spot=spot), sharing)
}

