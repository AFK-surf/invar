    let p = press()
    let s = match solid {
      Some(f) => f()
      Option::None => clear
    }
    Some(liquid_tab_lens_glass(p, solid=s))
  }))
  |> ignore
  match shadow {
    Some(s) => v.shadow(.Is(s)).shadow_outside(.Is(true))
    Option::None => v
  }
}
