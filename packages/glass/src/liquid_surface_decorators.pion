  let shadow = match shadow { Some(__mbt_v) => __mbt_v, None => fn() { shadow_default } }
  let solid_edge = match solid_edge { Some(__mbt_v) => __mbt_v, None => liquid_overlay_solid_edge }
  let clips = match clips { Some(__mbt_v) => __mbt_v, None => true }

