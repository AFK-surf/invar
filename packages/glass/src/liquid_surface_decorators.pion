///|
/// Helper forwarding `alpha` so `liquid_popover_surface_decorate` can accept an `alpha?` parameter without shadowing.
fn popover_fade_ink(c : Int64, share : Double) -> Int64 {
  alpha(c, share)
}

///|
/// Decorates an existing anchored popover container node `p` in place (zero wrapper nodes) in either:
/// 1. Standard anchored overlay mode (when `morph` is `None`):
///    binds `liquid_panel_glass(solid=...)`, `shadow`, `shadow_outside(Is(true))`, `MBUI_GLASS=solid` hairline
///    fallback, and optional `alpha` / `scale`.
/// 2. iOS 27.0 liquid-bridge morph mode (when `morph` is `Some(eval)`, whatever the window's glass material: solid glass
///    morphs as its solid ground):
///    encapsulates three-anchor `liquid_menu_morph_glass` optical interpolation, capillary `merge`/`layer`/`break_gap`,
///    `content_lens` blur/refraction, `ground_drawn` animated silhouette, `alpha` gating (zero hidden glass when
///    inactive), and smooth shadow ramp. Returns `p` for chaining.
pub fn liquid_popover_surface_decorate(p : view::View, radius? : Double, solid? : () -> Int64, shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), clips? : Bool, alpha? : () -> Double, scale? : () -> Double, scale_about? : view::Pivot, max_shift? : Double, morph? : () -> Option[(Double, Bool, Double, Double, LiquidMorphFrame)], layer? : Int, break_gap? : Double, close_break_gap? : Double) -> view::View {
  let shadow = match shadow { Some(__mbt_v) => __mbt_v, None => fn() { shadow_default } }
  let solid_edge = match solid_edge { Some(__mbt_v) => __mbt_v, None => liquid_overlay_solid_edge }
  let clips = match clips { Some(__mbt_v) => __mbt_v, None => true }
  let scale_about = match scale_about { Some(__mbt_v) => __mbt_v, None => .FromBeside }
  let max_shift = match max_shift { Some(__mbt_v) => __mbt_v, None => 0.0 }
  let layer = match layer { Some(__mbt_v) => __mbt_v, None => 0 }
  let break_gap = match break_gap { Some(__mbt_v) => __mbt_v, None => 32.0 }
  let close_break_gap = match close_break_gap { Some(__mbt_v) => __mbt_v, None => 48.0 }

  let resolve_solid = fn() -> Int64 {
    match solid {
      Some(f) => f()
      Option::None => clear
    }
  }
  match radius {
    Some(r) => p.radius(.Is(r)) |> ignore
    Option::None => ()
  }
  if clips {
    p.clips(.Is(true)) |> ignore
  }
  p
  .edge(.By(fn() { if p.glass_solid() { solid_edge() } else { (0.0, clear) } }))
  .shadow_outside(.Is(true))
  |> ignore
  match morph {
    Some(eval_morph) => {
      let unlaid_opening = fn(t : Double, closing : Bool, w : Double, h : Double) {
        !closing && t < lm_open_duration_ms / 1000.0 - 0.001 && (w <= 0.0 || h <= 0.0)
      }
      p
      .alpha(.By(fn() {
        match eval_morph() {
          Some((t, closing, w, h, f)) =>
          if unlaid_opening(t, closing, w, h) {
            0.0
          } else if !closing {
            if f.raw_value <= 0.001 { 0.0 } else { 1.0 }
          } else if !f.platter_active {
            0.0
          } else {
            1.0
          }
          Option::None =>
          match alpha {
            Some(af) => af()
            Option::None => 1.0
          }
        }
      }))
      .glass(.By(fn() {
        let s = resolve_solid()
        match eval_morph() {
          Some((t, closing, w, h, f)) =>
          if unlaid_opening(t, closing, w, h) {
            Option::None
          } else if !closing {
            if f.raw_value <= 0.001 {
              Option::None
            } else {
              let stage = 0.5 + 0.5 * lm_smoothstep(0.08, 0.20, t)
              if f.open_anchor_scale > 0.15 {
                Some(liquid_menu_morph_glass(stage, solid=s, merge=14.0 * f.open_anchor_scale, layer=layer, break_gap=break_gap),)
              } else {
                Some(liquid_menu_morph_glass(stage, solid=s))
              }
            }
          } else if !f.platter_active {
            Option::None
          } else {
            let stage = 0.5 * lm_smoothstep(0.0, 0.12, f.raw_value) +
            0.5 * lm_smoothstep(0.35, 0.95, f.raw_value)
            if f.blob_a_emerge > 0.001 {
              Some(liquid_menu_morph_glass(stage, solid=s, merge=lm_close_blend(f.raw_value), layer=layer, break_gap=close_break_gap),)
            } else {
              Some(liquid_menu_morph_glass(stage, solid=s))
            }
          }
          Option::None => Some(liquid_panel_glass(solid=s))
        }
      }))
      .content_lens(.By(fn() {
        match eval_morph() {
          Some((t, closing, w, h, f)) =>
          if unlaid_opening(t, closing, w, h) {
            paint::ContentLens::none()
          } else if f.content_opacity > 0.01 && f.content_blur > 0.05 {
            paint::ContentLens::{
              blur: f.content_blur,
              refraction: 6.0 * clamp(f.content_blur / 8.0, 0.0, 1.0),
              bezel: 24.0,
              alpha: f.content_opacity,
            }
          } else {
            paint::ContentLens::none()
          }
          Option::None => paint::ContentLens::none()
        }
      }))
      .shadow(.By(fn() {
        match eval_morph() {
          Some((t, closing, w, h, f)) =>
          if unlaid_opening(t, closing, w, h) {
            shadow_none
          } else if closing && !f.platter_active {
            shadow_none
          } else {
            let ga = lm_smoothstep(0.25, 0.78, clamp(f.raw_value, 0.0, 1.0))
            if ga <= 0.001 {
              shadow_none
            } else {
              let (s, dy, ink) = shadow()
              (s, dy, popover_fade_ink(ink, ga))
            }
          }
          Option::None => shadow()
        }
      }))
      .ground_drawn(.By(fn() {
        match eval_morph() {
          Some((t, closing, w, h, f)) =>
          if w <= 0.0 || h <= 0.0 || (!closing && t >= lm_open_duration_ms / 1000.0 - 0.001) {
            view::ground_as_laid
          } else {
            let r = f.radius
            view::GroundShape::{ dx: f.mx, dy: f.my, dw: f.cur_w - w, dh: f.cur_h - h, corners: Some((r, r, r, r)) }
          }
          Option::None => view::ground_as_laid
        }
      }))
    }
    _ => {
      p.glass(.By(fn() { Some(liquid_panel_glass(solid=resolve_solid())) })).shadow(.By(shadow)) |> ignore
      match alpha {
        Some(af) => p.alpha(.By(af)) |> ignore
        Option::None => ()
      }
      match scale {
        Some(sf) => p.scale(.By(sf), about=scale_about, max_shift=max_shift) |> ignore
        Option::None => ()
      }
      p
    }
  }
}

///|
/// Decorates an existing tooltip node `v` in place (zero wrapper nodes) with `points(Is(false))` click-through,
/// `active` gating (submits `None` glass, zero edge, and zero shadow when inactive), `shadow_outside(Is(true))`,
/// `MBUI_GLASS=solid` hairline fallback, and single-layer liquid glass (`liquid_capsule_glass` by default, or
/// `liquid_panel_glass` when `panel=true`). Returns `v` for chaining.
pub fn liquid_tooltip_surface_decorate(v : view::View, radius? : Double, active? : () -> Bool, solid? : () -> Int64, shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), panel? : Bool) -> view::View {
  let active = match active { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let shadow = match shadow { Some(__mbt_v) => __mbt_v, None => fn() { shadow_default } }
  let solid_edge = match solid_edge { Some(__mbt_v) => __mbt_v, None => liquid_overlay_solid_edge }
  let panel = match panel { Some(__mbt_v) => __mbt_v, None => false }

  match radius {
    Some(r) => v.radius(.Is(r)) |> ignore
    Option::None => ()
  }
  v
  .points(.Is(false))
  .glass(.By(fn() {
    if !active() {
      return Option::None
    }
    let s = match solid {
      Some(f) => f()
      Option::None => clear
    }
    if panel {
      Some(liquid_panel_glass(solid=s))
    } else {
      Some(liquid_capsule_glass(solid=s))
    }
  }))
  .edge(.By(fn() {
    if active() && v.glass_solid() {
      solid_edge()
    } else {
      (0.0, clear)
    }
  }))
  .shadow(.By(fn() {
    if active() {
      shadow()
    } else {
      shadow_none
    }
  }))
  .shadow_outside(.Is(true))
}

///|
/// Decorates an existing side-drawer container node `v` in place (zero wrapper nodes) with single-layer
/// `liquid_drawer_glass`, `active` gating (zero hidden glass when inactive), `shadow_outside(Is(true))`,
/// `MBUI_GLASS=solid` hairline fallback, and optional `radius` / `clips`. Returns `v` for chaining.
pub fn liquid_drawer_surface_decorate(v : view::View, radius? : Double, active? : () -> Bool, strength? : () -> Double, solid? : () -> Int64, shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), clips? : Bool) -> view::View {
  let active = match active { Some(__mbt_v) => __mbt_v, None => fn() { true } }
  let shadow = match shadow { Some(__mbt_v) => __mbt_v, None => fn() { shadow_default } }
  let solid_edge = match solid_edge { Some(__mbt_v) => __mbt_v, None => liquid_overlay_solid_edge }
  let clips = match clips { Some(__mbt_v) => __mbt_v, None => true }

  match radius {
    Some(r) => v.radius(.Is(r)) |> ignore
    Option::None => ()
  }
  if clips {
    v.clips(.Is(true)) |> ignore
  }
  let level = match strength {
    Some(f) => fn() { if active() { clamp(f(), 0.0, 1.0) } else { 0.0 } }
    Option::None => fn() { if active() { 1.0 } else { 0.0 } }
  }
  v
  .glass(.By(fn() {
    let k = level()
    if k <= 0.001 {
      return Option::None
    }
    let s = match solid {
      Some(f) => f()
      Option::None => clear
    }
    let base = liquid_drawer_glass(solid=s)
    Some(if k >= 0.999 { base } else { base.at_strength(k) })
  }))
  .edge(.By(fn() {
    let k = level()
    if k > 0.001 && v.glass_solid() {
      let (w, c) = solid_edge()
      (w, if k >= 0.999 { c } else { alpha(c, k) })
    } else {
      (0.0, clear)
    }
  }))
  .shadow(.By(fn() {
    let k = level()
    if k <= 0.001 {
      shadow_none
    } else if k >= 0.999 {
      shadow()
    } else {
      let (sigma, dy, color) = shadow()
      (sigma * k, dy * k, alpha(color, k))
    }
  }))
  .shadow_outside(.Is(true))
}

