pub fn liquid_panel_shell_node(parent : view::View, body : (view::View) -> Unit, radius? : Double, solid? : () -> Int64, merge? : () -> Double, active? : () -> Bool, shadow? : () -> (Double, Double, Int64), solid_edge? : () -> (Double, Int64), clips? : Bool, loc~ : String = "") -> view::View {
