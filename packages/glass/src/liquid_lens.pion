      .over(.Is(true))
      .offset(.By(fn() {
        let (tx, ty) = laid()
        (tx - width / 2.0, ty - height / 2.0)
      }))
      .width(.Is(Some(width)))
      .height(.Is(Some(height)))
      .radius(.Is(height / 2.0))
      .ground(.By(bg))
      .ground_drawn(.By(fn() { drawn(at) }))
      .magnifies(.By(fn() {
        match read.get() {
          Option::Some(p) => Some((p.0, p.1, zoom))
          Option::None => Option::None
