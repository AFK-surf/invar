///|
/// Generic floating text/drag magnifying loupe over the whole window (`View::over_all` +
/// `View::magnifies` + `@motion.SpringFollow2D` velocity-stretched capsule + `liquid_knob_glass`).
/// Renders 0 nodes and 0 glass whenever inactive and settled.

pub fn liquid_loupe_node(root : view::View, active : () -> Bool, target : () -> Option[(Double, Double)], bg? : () -> Int64, solid? : () -> Int64, shadow_color? : () -> Int64, width? : Double, height? : Double, zoom? : Double, lift? : Double, side_inset? : Double, grow? : Double, shadow_blur? : Double, shadow_y? : Double, loc~ : String = "") -> Unit {
