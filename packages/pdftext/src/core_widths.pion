import "mbt_compat"

// The widths of the standard fonts a PDF may name without embedding or measuring them, ASCII 32 to 126 in 1/1000 of
// their size (Adobe Core 14 AFM). Oblique faces are as wide as upright ones; every Courier glyph is 600.

///|
// moved to 00_init_order.pion: helvetica_widths

///|
// moved to 00_init_order.pion: helvetica_bold_widths

///|
// moved to 00_init_order.pion: times_widths

///|
// moved to 00_init_order.pion: times_bold_widths

///|
// moved to 00_init_order.pion: times_italic_widths

///|
// moved to 00_init_order.pion: times_bold_italic_widths

///|
/// The widths of the standard font `name` stands for (its subset's prefix left off, the usual names of its metric
/// twins too): a table, or Courier's one width; None where it is no standard font.
fn core_widths(name : String) -> Option[(Option[FixedArray[Int]], Int)] {
  let plain = match mbt_compat::str_find(name, "+") {
    Some(6) => mbt_compat::str_to_owned(mbt_compat::str_exact_view(name, start=7))
    _ => name
  }
  let low = mbt_compat::str_to_lower(plain)
  let bold = low.contains("bold")
  let italic = low.contains("italic") || low.contains("oblique")
  if mbt_compat::str_has_prefix(low, "courier") {
    Some((Option::None, 600))
  } else if mbt_compat::str_has_prefix(low, "helvetica") || mbt_compat::str_has_prefix(low, "arial") {
    Some((Some(if bold { helvetica_bold_widths } else { helvetica_widths }), if bold { 611 } else { 556 }))
  } else if mbt_compat::str_has_prefix(low, "times") {
    let t = match (bold, italic) {
      (true, true) => times_bold_italic_widths
      (true, false) => times_bold_widths
      (false, true) => times_italic_widths
      (false, false) => times_widths
    }
    Some((Some(t), 500))
  } else {
    Option::None
  }
}
