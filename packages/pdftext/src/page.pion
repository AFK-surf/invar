///|
/// The PDF in `data`; None where it cannot be read for words (damaged, encrypted, too big).
pub fn Doc::open(data : Bytes) -> Option[Doc] {
  guard Objects::scan(data) is Some(o) else { return Option::None }
  let pages : Array[PageDict] = []
  guard o.dict(Some(o.root)) is Some(root) else { return Option::None }
  o.walk_pages(root.get("Pages"), Obj::Null, Option::None, Option::None, 0, pages, mbt_compat::ordered_set_from_array([]))
  if pages.is_empty() {
    return Option::None
  }
  Some(Doc::{ objects: o, page_dicts: pages, fonts: mbt_compat::ordered_map_new(), texts: mbt_compat::ordered_map_new() })
}

///|
/// How many pages it was found to have.
pub fn Doc::pages(self : Doc) -> Int {
  self.page_dicts.length()
}

///|
fn Objects::walk_pages(self : Objects, node : Option[Obj], resources : Obj, media : Option[Array[Double]], crop : Option[Array[Double]], rotate : Int, out : Array[PageDict], seen : mbt_compat::OrderedSet[Int]) -> Unit {
  guard node is Some(n) else { return }
  match n {
    .Link(id) => {
      if seen.contains(id) {
        return
      }
      seen.insert(id)
    }
    _ => ()
  }
  guard self.get(n) is Dict(d) else { return }
  if out.length() >= MOST_PAGES || seen.length() > MOST_PAGES * 2 {
    return
  }
  let res = match d.get("Resources") {
    Option::Some(r) => r
    Option::None => resources
  }
  let box_of = fn(key : String, had : Option[Array[Double]]) {
    let a = self.nums(d.get(key))
    if a.length() == 4 {
      Some(a)
    } else {
      had
    }
  }
  let m = box_of("MediaBox", media)
  let c = box_of("CropBox", crop)
  let r = match self.of(d.get("Rotate")) {
    .Num(v) => ((v.to_int() % 360) + 360) % 360
    _ => rotate
  }
  match self.of(d.get("Kids")) {
    .List(kids) =>
    { for k in kids {
      self.walk_pages(Some(k), res, m, c, r, out, seen)
    } }
    _ => {
      let mb = normal_box(m.unwrap_or([0.0, 0.0, 612.0, 792.0]))
      let shown = match c {
        Some(a) => {
          let cb = normal_box(a)
          let cut = (dmax(cb.0, mb.0), dmax(cb.1, mb.1), dmin(cb.2, mb.2), dmin(cb.3, mb.3))
          if cut.2 > cut.0 && cut.3 > cut.1 {
            cut
          } else {
            mb
          }
        }
        Option::None => mb
      }
      out.push(PageDict::{ dict: d, resources: res, box_: shown, rotate: r })
    }
  }
}

///|
fn normal_box(a : Array[Double]) -> (Double, Double, Double, Double) {
  (dmin(a[0], a[2]), dmin(a[1], a[3]), dmax(a[0], a[2]), dmax(a[1], a[3]))
}

///|
fn dmin(a : Double, b : Double) -> Double {
  if a < b {
    a
  } else {
    b
  }
}

///|
fn dmax(a : Double, b : Double) -> Double {
  if a > b {
    a
  } else {
    b
  }
}

///|
/// A matrix `[a b c d e f]`.
struct Mat {
  a : Double
  b : Double
  c : Double
  d : Double
  e : Double
  f : Double
}

///|
// moved to 00_init_order.pion: identity

///|
/// `self` applied first, then `o`.
fn Mat::then(self : Mat, o : Mat) -> Mat {
  Mat::{
    a: self.a * o.a + self.b * o.c,
    b: self.a * o.b + self.b * o.d,
    c: self.c * o.a + self.d * o.c,
    d: self.c * o.b + self.d * o.d,
    e: self.e * o.a + self.f * o.c + o.e,
    f: self.e * o.b + self.f * o.d + o.f,
  }
}

///|
fn Mat::point(self : Mat, x : Double, y : Double) -> (Double, Double) {
  (x * self.a + y * self.c + self.e, x * self.b + y * self.d + self.f)
}

///|
fn mat_of(a : Array[Double]) -> Option[Mat] {
  if a.length() == 6 {
    Some(Mat::{ a: a[0], b: a[1], c: a[2], d: a[3], e: a[4], f: a[5] })
  } else {
    Option::None
  }
}

///|
struct Gs {
  ctm : Mat
  font : Option[Font]
  size : Double
  char_space : Double
  word_space : Double
  horizontal : Double
  leading : Double
  rise : Double
}

///|
/// A page being read.
struct Reader {
  doc : Doc
  out : Array[Glyph]
  mut ops : Int
  box_ : (Double, Double, Double, Double)
  rotate : Int
}

///|
/// A point of the page's default space as a fraction of the page as shown.
fn Reader::on_page(self : Reader, x : Double, y : Double) -> (Double, Double) {
  let (x0, y0, x1, y1) = self.box_
  let w = x1 - x0
  let h = y1 - y0
  match self.rotate {
    90 => ((y - y0) / h, (x - x0) / w)
    180 => ((x1 - x) / w, (y - y0) / h)
    270 => ((y1 - y) / h, (x1 - x) / w)
    _ => ((x - x0) / w, (y1 - y) / h)
  }
}

///|
/// What page `i` says; none where it is past the end.
pub fn Doc::page(self : Doc, i : Int) -> PageText {
  match self.texts.get(i) {
    Some(t) => t
    Option::None => {
      let t = self.read_page(i)
      self.texts.set(i, t)
      t
    }
  }
}

///|
fn Doc::read_page(self : Doc, i : Int) -> PageText {
  guard i >= 0 && i < self.page_dicts.length() else { return PageText::{ glyphs: [], right: 0.0 } }
  let p = self.page_dicts[i]
  let o = self.objects
  o.decoded = 0
  let r : Reader = Reader::{ doc: self, out: [], ops: 0, box_: p.box_, rotate: p.rotate }
  let parts : Array[Bytes] = []
  match o.of(p.dict.get("Contents")) {
    s if (match s { .Stream(_, _, _) => true, _ => false }) => match o.stream_bytes(s) {
      Some(x) => parts.push(x)
      Option::None => ()
    }
    .List(a) =>
    { for x in a {
      match o.stream_bytes(o.get(x)) {
        Some(y) => parts.push(y)
        Option::None => ()
      }
    } }
    _ => ()
  }
  // (a page's content streams are one: an operator may end in the next)
  let whole = mbt_compat::bytes_buf_new_with_capacity(mbt_compat::arr_fold(parts, 0, fn(n, x) { n + x.length() + 1 }))
  for x in parts {
    whole.write_bytesview(x)
    whole.write_byte(10.to_byte())
  }
  let gs : Gs = Gs::{
    ctm: identity,
    font: Option::None,
    size: 0.0,
    char_space: 0.0,
    word_space: 0.0,
    horizontal: 1.0,
    leading: 0.0,
    rise: 0.0,
  }
  r.run(whole.to_bytes(), o.of(Some(p.resources)), gs, 0)
  placed(r.out)
}

///|
/// A run of glyphs drawn together on one line, and the box it lies in.
struct Run {
  from : Int
  to : Int
  x0 : Double
  y0 : Double
  x1 : Double
  y1 : Double
}

///|
/// Glyphs in the order they are read, each with its line said. A file may draw a page's parts in any order (a heading
/// after the words under it, a footer first), and picking runs through glyphs in this order.
fn placed(raw : Array[Glyph]) -> PageText {
  let order : Array[Run] = []
  read_order(runs_of(raw), order, 0)
  let sorted : Array[Glyph] = []
  for r in order {
    for k in r.from..<r.to {
      sorted.push(raw[k])
    }
  }
  let out : Array[Glyph] = []
  let mut line = 0
  let mut top = 0.0
  let mut foot = 0.0
  let mut was_x = 0.0
  let mut right = 0.0
  for k, g in sorted {
    let mid = (g.y0 + g.y1) / 2.0
    if k > 0 {
      let tall = dmax(g.y1 - g.y0, foot - top)
      // (off the line it was on, or back across it by more than a line's height)
      if mid < top || mid > foot || g.x0 < was_x - 2.0 * tall {
        line += 1
        top = g.y0
        foot = g.y1
      } else {
        top = dmin(top, g.y0)
        foot = dmax(foot, g.y1)
      }
    } else {
      top = g.y0
      foot = g.y1
    }
    was_x = g.x1
    right = dmax(right, g.x1)
    out.push(Glyph::{ ..g, line, })
  }
  PageText::{ glyphs: out, right: right }
}

///|
/// The runs of glyphs next to each other on a line, as drawn.
fn runs_of(raw : Array[Glyph]) -> Array[Run] {
  let out : Array[Run] = []
  let mut k = 0
  while k < raw.length() {
    let from = k
    let mut x0 = raw[k].x0
    let mut y0 = raw[k].y0
    let mut x1 = raw[k].x1
    let mut y1 = raw[k].y1
    k += 1
    while k < raw.length() {
      let g = raw[k]
      let mid = (g.y0 + g.y1) / 2.0
      let tall = y1 - y0
      if mid < y0 || mid > y1 || g.x0 < x1 - tall || g.x0 > x1 + 2.0 * tall {
        break
      }
      x0 = dmin(x0, g.x0)
      y0 = dmin(y0, g.y0)
      x1 = dmax(x1, g.x1)
      y1 = dmax(y1, g.y1)
      k += 1
    }
    out.push(Run::{ from: from, to: k, x0: x0, y0: y0, x1: x1, y1: y1 })
  }
  out
}

///|
/// How narrow a gap down the page may be and still part two columns.
// moved to 00_init_order.pion: column_gap

///|
/// How wide a column's lines reach at least, as a share of the page: a table's cells are narrower, and read across.
// moved to 00_init_order.pion: column_line

///|
/// How deep a page's parts may be cut.
// moved to 00_init_order.pion: MOST_CUTS

///|
/// `runs` into `out` in reading order: cut into columns where a clear gap runs down all of them, else into blocks where
/// a gap wider than the lines' own runs across them, each part read the same way; what cannot be cut, top to bottom.
fn read_order(runs : Array[Run], out : Array[Run], depth : Int) -> Unit {
  if runs.length() <= 1 || depth >= MOST_CUTS {
    top_down(runs, out)
    return
  }
  match column_cut(runs) {
    Some((left, right)) => {
      read_order(left, out, depth + 1)
      read_order(right, out, depth + 1)
    }
    Option::None => {
      let blocks = block_cut(runs)
      if blocks.length() <= 1 {
        top_down(runs, out)
      } else {
        for b in blocks {
          read_order(b, out, depth + 1)
        }
      }
    }
  }
}

///|
/// Top to bottom, what shares a line left to right. By each run's line first (its middle, to a quarter of a line), so
/// the order is a total one whatever the runs are.
fn top_down(runs : Array[Run], out : Array[Run]) -> Unit {
  let talls = mbt_compat::arr_map(runs, fn(r) { r.y1 - r.y0 })
  mbt_compat::arr_sort_double(talls)
  let unit = if talls.is_empty() { 0.01 } else { dmax(talls[talls.length() / 2] * 0.5, 0.0005) }
  let sorted = runs.copy()
  mbt_compat::arr_sort_by(sorted, fn(a, b) {
    let la = ((a.y0 + a.y1) / 2.0 / unit).floor()
    let lb = ((b.y0 + b.y1) / 2.0 / unit).floor()
    if la != lb {
      la.compare(lb)
    } else {
      a.x0.compare(b.x0)
    }
  })
  mbt_compat::arr_append(out, sorted)
}

///|
/// The widest gap running down all of `runs`, parting two columns of real lines.
fn column_cut(runs : Array[Run]) -> Option[(Array[Run], Array[Run])] {
  let by_x = runs.copy()
  mbt_compat::arr_sort_by(by_x, fn(a, b) { a.x0.compare(b.x0) })
  let mut reach = by_x[0].x1
  let mut best = -1.0
  let mut at = -1.0
  for k in 1..<by_x.length() {
    let gap = by_x[k].x0 - reach
    if gap > best {
      best = gap
      at = reach + gap / 2.0
    }
    reach = dmax(reach, by_x[k].x1)
  }
  if best < column_gap {
    return Option::None
  }
  let left = mbt_compat::arr_filter(runs, fn(r) { r.x1 <= at })
  let right = mbt_compat::arr_filter(runs, fn(r) { r.x0 >= at })
  if left.length() < 3 || right.length() < 3 || wide_part(left) < column_line || wide_part(right) < column_line {
    return Option::None
  }
  Some((left, right))
}

///|
/// How wide the lines of a part reach, the widest of them.
fn wide_part(runs : Array[Run]) -> Double {
  let mut most = 0.0
  for r in runs {
    most = dmax(most, r.x1 - r.x0)
  }
  most
}

///|
/// `runs` parted where a gap across them is wider than their lines are tall.
fn block_cut(runs : Array[Run]) -> Array[Array[Run]] {
  let by_y = runs.copy()
  mbt_compat::arr_sort_by(by_y, fn(a, b) { a.y0.compare(b.y0) })
  let talls = mbt_compat::arr_map(runs, fn(r) { r.y1 - r.y0 })
  mbt_compat::arr_sort_double(talls)
  let tall = talls[talls.length() / 2]
  let out : Array[Array[Run]] = []
  let mut now = [by_y[0]]
  let mut foot = by_y[0].y1
  for k in 1..<by_y.length() {
    let r = by_y[k]
    if r.y0 - foot > tall * 0.6 {
      out.push(now)
      now = []
    }
    now.push(r)
    foot = dmax(foot, r.y1)
  }
  out.push(now)
  out
}

///|
fn Reader::font_named(self : Reader, res : Obj, name : String) -> Option[Font] {
  let o = self.doc.objects
  guard res is .Dict(rd) else { return Option::None }
  guard o.dict(rd.get("Font")) is Some(fonts) else { return Option::None }
  guard fonts.get(name) is Some(f) else { return Option::None }
  match f {
    .Link(id) =>
    match self.doc.fonts.get(id) {
      Option::Some(made) => Some(made)
      Option::None =>
      match o.dict(Some(f)) {
        Some(d) => {
          let made = o.font(d)
          self.doc.fonts.set(id, made)
          Some(made)
        }
        Option::None => Option::None
      }
    }
    _ =>
    match o.dict(Some(f)) {
      Some(d) => Some(o.font(d))
      Option::None => Option::None
    }
  }
}

///|
/// A string shown from text matrix `tm`; the matrix after it.
fn Reader::show(self : Reader, s : Bytes, gs : Gs, tm : Mat) -> Mat {
  guard gs.font is Some(font) else { return tm }
  let mut now = tm
  let mut i = 0
  while i < s.length() {
    let (code, n) = font.code_at(s, i)
    i += imax(n, 1)
    let w = font.advance(code)
    if self.out.length() < MOST_GLYPHS {
      let trm = Mat::{ a: gs.size * gs.horizontal, b: 0.0, c: 0.0, d: gs.size, e: 0.0, f: gs.rise }
      .then(now)
      .then(gs.ctm)
      let corners = [
        trm.point(0.0, font.descent),
        trm.point(w, font.descent),
        trm.point(0.0, font.ascent),
        trm.point(w, font.ascent),
      ]
      let mut x0 = 1.0e18
      let mut y0 = 1.0e18
      let mut x1 = -1.0e18
      let mut y1 = -1.0e18
      for c in corners {
        let (u, v) = self.on_page(c.0, c.1)
        x0 = dmin(x0, u)
        y0 = dmin(y0, v)
        x1 = dmax(x1, u)
        y1 = dmax(y1, v)
      }
      // (what lies off the page, or has no size, cannot be pressed)
      if x1 > 0.0 && y1 > 0.0 && x0 < 1.0 && y0 < 1.0 && y1 > y0 && x0 == x0 && y0 == y0 {
        self.out.push(Glyph::{ text: plain_text(font.text_of(code)), x0: x0, y0: y0, x1: x1, y1: y1, line: 0 })
      }
    }
    let space = if n == 1 && code == 32 { gs.word_space } else { 0.0 }
    let tx = (w * gs.size + gs.char_space + space) * gs.horizontal
    now = Mat::{ ..identity, e: tx }.then(now)
  }
  now
}

///|
fn num_at(args : Array[Obj], k : Int) -> Double {
  if k >= 0 && k < args.length() && args[k] is .Num(n) {
    n
  } else {
    0.0
  }
}

///|
/// Content stream `data` run with resources `res`, from graphics state `start`.
fn Reader::run(self : Reader, data : Bytes, res : Obj, start : Gs, depth : Int) -> Unit {
  let lex = Lex::new(data, 0, data.length(), links=false)
  let mut gs = start
  let stack : Array[Gs] = []
  let mut tm = identity
  let mut line = identity
  let args : Array[Obj] = []
  let next_line = fn(x : Double, y : Double) {
    line = Mat::{ ..identity, e: x, f: y }.then(line)
    tm = line
  }
  while self.ops < MOST_OPS {
    guard lex.next() is Some(t) else { break }
    guard t is .Op(op) else {
      args.push(t)
      if args.length() > 4096 {
        args.clear()
      }
      continue
    }
    self.ops += 1
    let n = args.length()
    match op {
      "q" => if stack.length() < 512 { stack.push(gs) }
      "Q" =>
      match stack.pop() {
        Option::Some(g) => gs = g
        Option::None => ()
      }
      "cm" =>
      if n >= 6 {
        let m = Mat::{ a: num_at(args, n - 6), b: num_at(args, n - 5), c: num_at(args, n - 4), d: num_at(args, n - 3), e: num_at(args, n - 2), f: num_at(args, n - 1) }
        gs = { let __mbt_su_b_1 = gs; Gs::{ ctm: m.then(gs.ctm), font: __mbt_su_b_1.font, size: __mbt_su_b_1.size, char_space: __mbt_su_b_1.char_space, word_space: __mbt_su_b_1.word_space, horizontal: __mbt_su_b_1.horizontal, leading: __mbt_su_b_1.leading, rise: __mbt_su_b_1.rise } }
      }
      "BT" => {
        tm = identity
        line = identity
      }
      "Tf" =>
      if n >= 2 && args[n - 2] is .Name(f) {
        gs = { let __mbt_su_b_2 = gs; Gs::{ ctm: __mbt_su_b_2.ctm, font: self.font_named(res, f), size: num_at(args, n - 1), char_space: __mbt_su_b_2.char_space, word_space: __mbt_su_b_2.word_space, horizontal: __mbt_su_b_2.horizontal, leading: __mbt_su_b_2.leading, rise: __mbt_su_b_2.rise } }
      }
      "Tc" => gs = { let __mbt_su_b_3 = gs; Gs::{ ctm: __mbt_su_b_3.ctm, font: __mbt_su_b_3.font, size: __mbt_su_b_3.size, char_space: num_at(args, n - 1), word_space: __mbt_su_b_3.word_space, horizontal: __mbt_su_b_3.horizontal, leading: __mbt_su_b_3.leading, rise: __mbt_su_b_3.rise } }
      "Tw" => gs = { let __mbt_su_b_4 = gs; Gs::{ ctm: __mbt_su_b_4.ctm, font: __mbt_su_b_4.font, size: __mbt_su_b_4.size, char_space: __mbt_su_b_4.char_space, word_space: num_at(args, n - 1), horizontal: __mbt_su_b_4.horizontal, leading: __mbt_su_b_4.leading, rise: __mbt_su_b_4.rise } }
      "Tz" => gs = { let __mbt_su_b_5 = gs; Gs::{ ctm: __mbt_su_b_5.ctm, font: __mbt_su_b_5.font, size: __mbt_su_b_5.size, char_space: __mbt_su_b_5.char_space, word_space: __mbt_su_b_5.word_space, horizontal: num_at(args, n - 1) / 100.0, leading: __mbt_su_b_5.leading, rise: __mbt_su_b_5.rise } }
      "TL" => gs = { let __mbt_su_b_6 = gs; Gs::{ ctm: __mbt_su_b_6.ctm, font: __mbt_su_b_6.font, size: __mbt_su_b_6.size, char_space: __mbt_su_b_6.char_space, word_space: __mbt_su_b_6.word_space, horizontal: __mbt_su_b_6.horizontal, leading: num_at(args, n - 1), rise: __mbt_su_b_6.rise } }
      "Ts" => gs = { let __mbt_su_b_7 = gs; Gs::{ ctm: __mbt_su_b_7.ctm, font: __mbt_su_b_7.font, size: __mbt_su_b_7.size, char_space: __mbt_su_b_7.char_space, word_space: __mbt_su_b_7.word_space, horizontal: __mbt_su_b_7.horizontal, leading: __mbt_su_b_7.leading, rise: num_at(args, n - 1) } }
