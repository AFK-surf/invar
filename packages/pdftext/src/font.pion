  let hex_from = if mbt_compat::str_has_prefix(base, "uni") && mbt_compat::utf16_len(base) >= 7 {
    3
  } else if mbt_compat::str_has_prefix(base, "u") && mbt_compat::utf16_len(base) >= 5 && mbt_compat::utf16_len(base) <= 7 {
    1
  } else {
    -1
  }
  if hex_from > 0 {
    let end = if hex_from == 3 { 7 } else { mbt_compat::utf16_len(base) }
    let mut v = 0
    for k in hex_from..<end {
      let h = hex_value(mbt_compat::utf16_code_unit_at(base, k).to_int())
