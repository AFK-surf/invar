              unicode.set(c, moved_on(first, c - a))
              mapped += 1
              c += 1
            }
          }
          .List(items) =>
          { for k, it in items {
            if a + k > z || mapped >= MOST_MAPPED {
              break
            }
            if it is .Str(u) {
              unicode.set(a + k, utf16be(u))
              mapped += 1
            }
          } }
          _ => ()
        }
      } }
      .Op("begincidchar") =>
      { while true {
        match lex.next() {
          Some(.Str(c)) =>
          match lex.next() {
            Some(.Num(n)) => {
              cids.set(code_of(c), n.to_int())
              mapped += 1
            }
            _ => break
          }
          _ => break
        }
      } }
      .Op("begincidrange") =>
      { while true {
        guard lex.next() is Some(.Str(lo)) else { break }
        guard lex.next() is Some(.Str(hi)) else { break }
        guard lex.next() is Some(.Num(n)) else { break }
