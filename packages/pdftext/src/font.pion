            _ => break
          }
          _ => break
        }
      } }
      .Op("beginbfrange") =>
      { while true {
        guard lex.next() is Some(.Str(lo)) else { break }
        guard lex.next() is Some(.Str(hi)) else { break }
        guard lex.next() is Some(dest) else { break }
        let a = code_of(lo)
        let z = imin(code_of(hi), a + 65535)
