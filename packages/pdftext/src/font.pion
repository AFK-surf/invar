///|
/// Adobe's Standard encoding where it is not ASCII: code, character.
// moved to 00_init_order.pion: standard_differs

///|
/// Code `c`'s character in base encoding `base`; 0 none.
fn base_char(base : Int, c : Int) -> Int {
  match base {
    1 =>
    if c >= 0x80 && c <= 0x9F {
      win_high[c - 0x80]
    } else if c >= 0x20 {
      c
    } else {
      0
    }
    2 =>
    if c >= 0x80 && c <= 0xFF {
      mac_high[c - 0x80]
    } else if c >= 0x20 {
      c
    } else {
      0
    }
    3 => {
      for d in standard_differs {
        if d.0 == c {
          return d.1
        }
      }
      if c >= 0x20 && c < 0x7F {
        c
      } else {
        0
      }
    }
    _ => 0
  }
}

///|
