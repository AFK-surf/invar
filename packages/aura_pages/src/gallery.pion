let ap_initial_cat : signals::Signal[Int] = signals::signal(0)

fn ap_ascii_lower(c : Int) -> Int {
  if c >= 65 && c <= 90 {
    c + 32
  } else {
    c
  }
}

/// Case-insensitive ASCII substring match.
pub fn ap_str_contains_ci(hay : String, needle : String) -> Bool {
  let nlen = needle.length()
  if nlen == 0 {
    return true
  }
  let hlen = hay.length()
  if nlen > hlen {
    return false
  }
  let limit = hlen - nlen
  for i = 0; i <= limit; i = i + 1 {
    let mut ok = true
    for j = 0; j < nlen; j = j + 1 {
      if ap_ascii_lower(hay[i + j]) != ap_ascii_lower(needle[j]) {
        ok = false
        break
      }
    }
    if ok {
      return true
    }
  }
  false
}

/// True when `s` is empty or contains only ASCII whitespace.
fn ap_is_blank(s : String) -> Bool {
  let mut i = 0
  let n = s.length()
  while i < n {
    let c = s[i]
    if c != 32 && c != 9 && c != 10 && c != 13 {
      return false
    }
    i += 1
  }
  true
}

/// Parse URL `?cat=` parameter into category index `0..7`
/// (`0..7` or `overview|buttons|inputs|selection|navigation|overlays|collections|composite`).
pub fn parse_library_cat(raw : String) -> Int {
  if raw == "" || raw == "0" {
    return 0
  }
  if raw == "1" {
    return 1
  }
  if raw == "2" {
    return 2
  }
  if raw == "3" {
    return 3
  }
  if raw == "4" {
    return 4
  }
  if raw == "5" {
    return 5
  }
  if raw == "6" {
    return 6
  }
  if raw == "7" {
    return 7
  }
  if ap_str_contains_ci(raw, "comp") || ap_str_contains_ci(raw, "date") || ap_str_contains_ci(raw, "color") || ap_str_contains_ci(raw, "feed") {
    7
  } else if ap_str_contains_ci(raw, "coll") || ap_str_contains_ci(raw, "table") || ap_str_contains_ci(raw, "list") {
    6
  } else if ap_str_contains_ci(raw, "over") && !ap_str_contains_ci(raw, "overview") {
    5
  } else if ap_str_contains_ci(raw, "nav") || ap_str_contains_ci(raw, "tab") {
    4
  } else if ap_str_contains_ci(raw, "sel") || ap_str_contains_ci(raw, "range") || ap_str_contains_ci(raw, "slid") {
    3
  } else if ap_str_contains_ci(raw, "input") || ap_str_contains_ci(raw, "form") {
    2
  } else if ap_str_contains_ci(raw, "btn") || ap_str_contains_ci(raw, "button") || ap_str_contains_ci(raw, "action") {
    1
  } else {
    0
  }
}

/// Set initial category (`0..7`) for subsequent `gallery` mounts.
pub fn set_library_initial_cat(cat : Int) -> Unit {
  let clamped = if cat < 0 || cat > 7 { 0 } else { cat }
  ap_initial_cat.set(clamped)
}

/// Clamp any category index into `0..7`.
fn ap_clamp_cat(cat_id : Int) -> Int {
  if cat_id < 0 || cat_id > 7 { 0 } else { cat_id }
}

/// Whether the viewport width is at or above the `lg` breakpoint (`>= 1024pt`).
fn ap_is_lg(v : view::View) -> Bool {
  v.tree.room_signal().get().0 >= 1024.0
}

/// Standard WordsLook helper for Aura Studio typography.
fn ap_words(size : Double, weight : Int, line : Double, wrap~ : Bool = false) -> view::WordsLook {
  view::WordsLook::{ ..view::words_plain, size, weight, line, wrap }
}

/// Mount a section title + subtitle + chip count header inside a category page.
fn ap_section_intro(
  parent : view::View,
  title : String,
  subtitle : String,
  badge : String,
) -> Unit {
  let _ = parent.box(fn(hdr : view::View) -> Unit {
    let _ = hdr.fills_across(view::Live::Is(true)).gap(view::Live::Is(6.0))
    let _ = hdr.box(fn(top_row : view::View) -> Unit {
      let _ = top_row
        .row(view::Live::Is(true))
        .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(top_row) }))
        .fills_across(view::Live::Is(true))
        .lies_along(view::Live::Is(view::Lies::Between))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .wraps(view::Live::Is(Some(8.0)))
        .gap(view::Live::Is(10.0))
      let _ = top_row.box(fn(title_wrap : view::View) -> Unit {
        let _ = title_wrap.shrink(view::Live::Is(1.0)).min_width(view::Live::Is(Some(0.0)))
        let _ = aura::typography_node(title_wrap, view::Live::Is(title), kind=aura::AuraTypographyType::H2)
      })
      let _ = aura::chip_node(
        top_row,
        view::Live::Is(badge),
        variant=aura::AuraChipVariant::Soft,
        color=aura::AuraStatusColor::Accent,
        size=aura::AuraControlSize::Sm,
      )
    })
    let _ = hdr.box(fn(sub : view::View) -> Unit {
      let _ = sub
        .fills_across(view::Live::Is(true))
        .words(view::Live::Is(subtitle), look=ap_words(13.5, 400, 20.0, wrap=true))
        .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(13.5, 400, 20.0, wrap=true).with_rtl(aura::aura_rtl(sub)) }))
        .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(sub).palette.muted }))
    })
    let _ = aura::separator_node(hdr)
  })
}

/// Reusable elevated Aura Card wrapper for a component specimen block.
fn ap_demo_card(
  parent : view::View,
  title : String,
  subtitle : String,
  body : (view::View) -> Unit,
  tag~ : String = "",
) -> view::View {
  let c = aura::card_node(
    parent,
    variant=aura::AuraSurfaceVariant::Default,
    radius=20.0,
    pad=20.0,
    gap=14.0,
    content=fn(card : view::View) -> Unit {
      let _ = card.box(fn(hdr : view::View) -> Unit {
        let _ = hdr
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(hdr) }))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
        let _ = hdr.box(fn(titles : view::View) -> Unit {
          let _ = titles
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .gap(view::Live::Is(2.0))
            .lines_up(view::Live::By(fn() -> Option[view::Along] {
              Some(if aura::aura_rtl(titles) { view::Along::End } else { view::Along::Start })
            }))
          let _ = aura::card_title_node(titles, view::Live::Is(title))
          if subtitle != "" {
            let _ = aura::card_description_node(titles, view::Live::Is(subtitle))
          }
        })
        if tag != "" {
          let _ = aura::chip_node(
            hdr,
            view::Live::Is(tag),
            variant=aura::AuraChipVariant::Secondary,
            color=aura::AuraStatusColor::Default,
            size=aura::AuraControlSize::Sm,
          )
        }
      })
      let _ = card.box(fn(content_box : view::View) -> Unit {
        let _ = content_box.fills_across(view::Live::Is(true)).gap(view::Live::Is(12.0))
        body(content_box)
      })
    },
  )
  let _ = c.fills_across(view::Live::Is(true))
  c
}

/// Responsive two-column grid helper: side-by-side at `>= 1024pt`, single vertical stack below.
/// Keeps both column subtrees persistently mounted across viewport resizes so unsaved form input and focus are never lost.
fn ap_two_col(
  parent : view::View,
  left : (view::View) -> Unit,
  right : (view::View) -> Unit,
  gap~ : Double = 16.0,
) -> Unit {
  let _ = parent.box(fn(row : view::View) -> Unit {
    let is_two = fn() -> Bool { aura::aura_is_md(row) && ap_is_lg(row) }
    let _ = row
      .fills_across(view::Live::Is(true))
      .gap(view::Live::Is(gap))
      .row_reverse(view::Live::By(fn() -> Bool { is_two() && aura::aura_rtl(row) }))
      .row(view::Live::By(fn() -> Bool {
        let _ = aura::aura_rtl(row)
        is_two()
      }))
    let _ = row.box(fn(c1 : view::View) -> Unit {
      let _ = c1
        .grow(view::Live::By(fn() -> Double { if is_two() { 1.0 } else { 0.0 } }))
        .shrink(view::Live::By(fn() -> Double { if is_two() { 1.0 } else { 0.0 } }))
        .basis(view::Live::By(fn() -> Option[Double] { if is_two() { Some(0.0) } else { None } }))
        .fills_across(view::Live::By(fn() -> Bool { !is_two() }))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(16.0))
      left(c1)
    })
    let _ = row.box(fn(c2 : view::View) -> Unit {
      let _ = c2
        .grow(view::Live::By(fn() -> Double { if is_two() { 1.0 } else { 0.0 } }))
        .shrink(view::Live::By(fn() -> Double { if is_two() { 1.0 } else { 0.0 } }))
        .basis(view::Live::By(fn() -> Option[Double] { if is_two() { Some(0.0) } else { None } }))
        .fills_across(view::Live::By(fn() -> Bool { !is_two() }))
        .min_width(view::Live::Is(Some(0.0)))
        .gap(view::Live::Is(16.0))
      right(c2)
    })
  })
}

/// Small muted specimen sub-label.
fn ap_sub_label(parent : view::View, text : String) -> Unit {
  let _ = parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .fills_across(view::Live::Is(true))
      .words(view::Live::Is(text), look=ap_words(12.0, 500, 16.0))
      .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(12.0, 500, 16.0).with_rtl(aura::aura_rtl(v)) }))
      .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(v).palette.muted }))
  })
}

/// Dispatch to the requested category section (`0..7`).
fn ap_render_category(
  parent : view::View,
  cat_id : Int,
  cfg : signals::Signal[aura::AuraConfig],
  active_cat : signals::Signal[Int],
  toast_queue : aura::ToastQueue,
  state : ApStudioState,
  overlays_open~ : Bool = false,
) -> Unit {
  let id = ap_clamp_cat(cat_id)
  match id {
    0 => section_overview(parent, cfg, active_cat, toast_queue)
    1 => section_buttons(parent, toast_queue, state)
    2 => section_inputs(parent, toast_queue, state)
    3 => section_selection(parent, state)
    4 => section_navigation(parent, state)
    5 => section_overlays(parent, state, overlays_open=overlays_open)
    6 => section_collections(parent, toast_queue, state)
    _ => section_composite(parent, toast_queue, state)
  }
}

/// Complete interactive 86-component Aura Studio gallery.
/// Mounts `aura::aura_provide_config(root, cfg)` and renders sidebar + top chrome (when `chrome=true`)
/// with live reactive toggles for Light/Dark, Standard/Vibrant, LTR/RTL, and Smooth/Circular corners.
pub fn gallery(
  root : view::View,
  cfg : signals::Signal[aura::AuraConfig],
  chrome~ : Bool = true,
  initial_cat? : Int,
) -> Unit {
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let _ = root.ground(view::Live::By(fn() -> Int64 { aura::aura_theme(root).palette.background }))
  let start_cat = match initial_cat {
    Some(c) => ap_clamp_cat(c)
    None => ap_initial_cat.get()
  }
  let active_cat = signals::signal(start_cat)
  let toast_queue = aura::ToastQueue::new()
  let state = ApStudioState::new()
  ap_mount_library_shell(root, cfg, active_cat, toast_queue, state, chrome=chrome)
}

/// Internal exhibition helper supporting expanded overlay snapshots.
pub fn showcase_page_ex(
  root : view::View,
  cat_id : Int,
  cfg : signals::Signal[aura::AuraConfig],
  overlays_open~ : Bool = false,
) -> Unit {
  ui::set_tree_theme(fn() -> ui::Theme { aura::aura_ui_theme(cfg.get()) })
  let _ = aura::aura_provide_config(root, cfg)
  let _ = root.ground(view::Live::By(fn() -> Int64 { aura::aura_theme(root).palette.background }))
  let active_cat = signals::signal(ap_clamp_cat(cat_id))
  let toast_queue = aura::ToastQueue::new()
  let state = ApStudioState::new()
  let _ = root.box(fn(shell : view::View) -> Unit {
    let _ = shell.fill()
    let _ = ui::scroll_box(shell, fn(body : view::View) -> Unit {
      let _ = body
        .fills_across(view::Live::Is(true))
        .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
          if aura::aura_is_md(body) {
            (28.0, 24.0, 28.0, 28.0)
          } else {
            (14.0, 16.0, 14.0, 24.0)
          }
        }))
        .gap(view::Live::Is(18.0))
      ap_render_category(body, cat_id, cfg, active_cat, toast_queue, state, overlays_open=overlays_open)
    })
    let _ = aura::toast_provider_node(shell, toast_queue, placement=aura::AuraToastPlacement::BottomEnd)
  })
}

/// Render a single category section (`0..7`) directly for offscreen exhibition screenshots.
pub fn showcase_page(root : view::View, cat_id : Int, cfg : signals::Signal[aura::AuraConfig]) -> Unit {
  showcase_page_ex(root, cat_id, cfg, overlays_open=false)
}
