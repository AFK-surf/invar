// Aura Studio — 86-Component Interactive Gallery & Exhibition Entrypoint.
// Public API contract for `packages/aura_web` and `packages/aura_shots`:
//   - `parse_library_cat(raw : String) -> Int`
//   - `set_library_initial_cat(cat : Int) -> Unit`
//   - `gallery(root : view::View, cfg : signals::Signal[aura::AuraConfig], chrome~ : Bool = true, initial_cat? : Int) -> Unit`
//   - `showcase_page(root : view::View, cat_id : Int, cfg : signals::Signal[aura::AuraConfig]) -> Unit`

import "aura"
import "headless_core"
import "signals"
import "ui"
import "view"

/// Metadata for each of the 8 Aura Studio gallery categories (`0..7`).
pub struct AuraCategory {
  pub id : Int
  pub slug : String
  pub name : String
  pub count : String
  pub subtitle : String
  pub keywords : String
}

/// Persistent interactive state shared across category switches in a gallery instance.
struct ApStudioState {
  // Buttons
  btn_clicks : signals::Signal[Int]
  btn_bold_on : signals::Signal[Bool]
  btn_italic_on : signals::Signal[Bool]
  btn_align : signals::Signal[String]
  btn_toolbar_status : signals::Signal[String]
  btn_close_count : signals::Signal[Int]
  // Inputs
  inp_qty : signals::Signal[Double]
  inp_search_val : signals::Signal[String]
  inp_form_submitted : signals::Signal[Bool]
  inp_street_val : signals::Signal[String]
  inp_street_field : ui::Field
  inp_bio_field : ui::Field
  // Selection
  sel_cb_alerts : signals::Signal[Bool]
  sel_cb_beta : signals::Signal[Bool]
  sel_plan : signals::Signal[String]
  sel_sw_sm : signals::Signal[Bool]
  sel_sw_md : signals::Signal[Bool]
  sel_sw_off : signals::Signal[Bool]
  sel_sw_lg : signals::Signal[Bool]
  sel_volume : signals::Signal[Double]
  sel_price_lo : signals::Signal[Double]
  sel_price_hi : signals::Signal[Double]
  // Navigation
  nav_tab_primary : signals::Signal[String]
  nav_tab_secondary : signals::Signal[String]
  nav_acc_open : signals::Signal[String]
  nav_disc_open : signals::Signal[Bool]
  nav_dg_open : signals::Signal[String]
  nav_cur_page : signals::Signal[Int]
  // Overlays
  ov_last_action : signals::Signal[String]
  ov_nav_tab : signals::Signal[String]
  // Collections & Table
  col_lb_sel : signals::Signal[String]
  col_tag_sel : signals::Signal[String]
  col_menu_choice : signals::Signal[String]
  col_sel_count : signals::Signal[Int]
  col_sort_desc : signals::Signal[String]
  col_sort_col : signals::Signal[String]
  col_sort_dir : signals::Signal[Int]
  col_loaded_count : signals::Signal[Int]
  // Composite (DateTime & Color)
  cmp_cal_date : signals::Signal[Option[headless_core::IsoDate]]
  cmp_range_dates : signals::Signal[Option[(headless_core::IsoDate, headless_core::IsoDate)]]
  cmp_df_val : signals::Signal[headless_core::SegmentedDateTime]
  cmp_tf_val : signals::Signal[headless_core::SegmentedDateTime]
  cmp_dp_val : signals::Signal[headless_core::SegmentedDateTime]
  cmp_drp_start : signals::Signal[headless_core::SegmentedDateTime]
  cmp_drp_end : signals::Signal[headless_core::SegmentedDateTime]
  cmp_color_val : signals::Signal[headless_core::ColorModel]
  cmp_swatch_hex : signals::Signal[String]
  cmp_picker_color : signals::Signal[headless_core::ColorModel]
}

fn ApStudioState::new() -> ApStudioState {
  let nov24 = aura::aura_date(2026, 11, 24)
  let nov10 = aura::aura_date(2026, 11, 10)
  let nov18 = aura::aura_date(2026, 11, 18)
  ApStudioState::{
    btn_clicks: signals::signal(0),
    btn_bold_on: signals::signal(true),
    btn_italic_on: signals::signal(false),
    btn_align: signals::signal("L"),
    btn_toolbar_status: signals::signal("Ready"),
    btn_close_count: signals::signal(0),
    inp_qty: signals::signal(42.0),
    inp_search_val: signals::signal("aura"),
    inp_form_submitted: signals::signal(false),
    inp_street_val: signals::signal("128 Horizon Way"),
    inp_street_field: ui::Field::new(text="128 Horizon Way"),
    inp_bio_field: ui::Field::new(text="Designing reactive cross-platform GPU interfaces with Invar Aura."),
    sel_cb_alerts: signals::signal(true),
    sel_cb_beta: signals::signal(false),
    sel_plan: signals::signal("pro"),
    sel_sw_sm: signals::signal(true),
    sel_sw_md: signals::signal(true),
    sel_sw_off: signals::signal(false),
    sel_sw_lg: signals::signal(true),
    sel_volume: signals::signal(68.0),
    sel_price_lo: signals::signal(25.0),
    sel_price_hi: signals::signal(78.0),
    nav_tab_primary: signals::signal("overview"),
    nav_tab_secondary: signals::signal("code"),
    nav_acc_open: signals::signal("q1"),
    nav_disc_open: signals::signal(true),
    nav_dg_open: signals::signal("g1"),
    nav_cur_page: signals::signal(3),
    ov_last_action: signals::signal("None"),
    ov_nav_tab: signals::signal("modal"),
    col_lb_sel: signals::signal("build"),
    col_tag_sel: signals::signal("pion"),
    col_menu_choice: signals::signal("None"),
    col_sel_count: signals::signal(0),
    col_sort_desc: signals::signal("Unsorted"),
    col_sort_col: signals::signal(""),
    col_sort_dir: signals::signal(0),
    col_loaded_count: signals::signal(4),
    cmp_cal_date: signals::signal_by(Some(nov24), fn(a, b) {
      match (a, b) {
        (Some(x), Some(y)) => x == y
        (None, None) => true
        _ => false
      }
    }),
    cmp_range_dates: signals::signal_by(Some((nov10, nov18)), fn(a, b) {
      match (a, b) {
        (Some((x1, x2)), Some((y1, y2))) => x1 == y1 && x2 == y2
        (None, None) => true
        _ => false
      }
    }),
    cmp_df_val: signals::signal_by(aura::aura_segmented_date(2026, 11, 24), fn(a, b) { a.eq(b) }),
    cmp_tf_val: signals::signal_by(aura::aura_segmented_time(14, 30), fn(a, b) { a.eq(b) }),
    cmp_dp_val: signals::signal_by(aura::aura_segmented_date(2026, 11, 24), fn(a, b) { a.eq(b) }),
    cmp_drp_start: signals::signal_by(aura::aura_segmented_date(2026, 11, 10), fn(a, b) { a.eq(b) }),
    cmp_drp_end: signals::signal_by(aura::aura_segmented_date(2026, 11, 18), fn(a, b) { a.eq(b) }),
    cmp_color_val: signals::signal_by(aura::aura_color_hsva(210.0, 0.80, 0.92, alpha=0.85), fn(a, b) { a == b }),
    cmp_swatch_hex: signals::signal("#0485F7"),
    cmp_picker_color: signals::signal_by(
      aura::aura_color_rgba(4.0 / 255.0, 133.0 / 255.0, 247.0 / 255.0, alpha=1.0),
      fn(a, b) { a == b },
    ),
  }
}

