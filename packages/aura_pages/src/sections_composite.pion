// Aura Studio — Category 6 (Collections & Table) and Category 7 (DateTime, Color & Feedback).

import "aura"
import "headless"
import "headless_core"
import "view"

struct ApTableMember {
  key : String
  name : String
  role : String
  status : String
  color : aura::AuraStatusColor
}

let ap_all_members : Array[ApTableMember] = [
  ApTableMember::{ key: "alex", name: "Alex Rivera", role: "Principal Architect", status: "Active", color: aura::AuraStatusColor::Success },
  ApTableMember::{ key: "jordan", name: "Jordan Chen", role: "Formal Verifier", status: "Review", color: aura::AuraStatusColor::Accent },
  ApTableMember::{ key: "sam", name: "Sam Patel", role: "Compiler Lead", status: "Active", color: aura::AuraStatusColor::Success },
  ApTableMember::{ key: "morgan", name: "Morgan Ellis", role: "Typography Engine", status: "Paused", color: aura::AuraStatusColor::Warning },
  ApTableMember::{ key: "taylor", name: "Taylor Brooks", role: "Type Systems", status: "Active", color: aura::AuraStatusColor::Success },
  ApTableMember::{ key: "casey", name: "Casey Lin", role: "GPU Pipeline", status: "Review", color: aura::AuraStatusColor::Accent },
]

fn ap_cmp_str_ci(a : String, b : String) -> Int {
  let na = a.length()
  let nb = b.length()
  let lim = if na < nb { na } else { nb }
  let mut i = 0
  while i < lim {
    let ca = ap_ascii_lower(a[i])
    let cb = ap_ascii_lower(b[i])
    if ca < cb {
      return -1
    }
    if ca > cb {
      return 1
    }
    i += 1
  }
  if na < nb { -1 } else if na > nb { 1 } else { 0 }
}

fn ap_member_field(m : ApTableMember, col : String) -> String {
  if col == "role" {
    m.role
  } else if col == "status" {
    m.status
  } else {
    m.name
  }
}

fn ap_sorted_table_rows(loaded : Int, sort_col : String, sort_dir : Int) -> Array[ApTableMember] {
  let count = if loaded > ap_all_members.length() { ap_all_members.length() } else if loaded < 0 { 0 } else { loaded }
  let out : Array[ApTableMember] = []
  let mut i = 0
  while i < count {
    out.push(ap_all_members[i])
    i += 1
  }
  if sort_dir == 0 || sort_col == "" {
    return out
  }
  // Simple insertion sort (stable, small array)
  let mut k = 1
  while k < out.length() {
    let cur = out[k]
    let cur_v = ap_member_field(cur, sort_col)
    let mut j = k - 1
    while j >= 0 {
      let cmp = ap_cmp_str_ci(ap_member_field(out[j], sort_col), cur_v)
      let swap_needed = if sort_dir == 1 { cmp > 0 } else { cmp < 0 }
      if swap_needed {
        out[j + 1] = out[j]
        j -= 1
      } else {
        break
      }
    }
    out[j + 1] = cur
    k += 1
  }
  out
}

// ============================================================================
// Category 6: Collections & Table (11 Components)
// ============================================================================

fn section_collections(parent : view::View, toast_queue : aura::ToastQueue, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "Collections & Data Table",
    "ListBox, Menu, TagGroup, Select, ComboBox, Autocomplete, and sortable multi-select Data Table.",
    "11 Components",
  )

  let lb_sel = state.col_lb_sel
  let tag_sel = state.col_tag_sel
  let menu_choice = state.col_menu_choice
  let sel_count = state.col_sel_count
  let sort_desc = state.col_sort_desc
  let sort_col = state.col_sort_col
  let sort_dir = state.col_sort_dir
  let loaded_count = state.col_loaded_count

  // Row 1: Select, ComboBox & Autocomplete (3 columns on desktop, single column on narrow)
  let _ = ap_demo_card(
    parent,
    "Select, ComboBox & Autocomplete",
    "Keyboard-navigable popovers with filtering, clearing, and live selection.",
    fn(c : view::View) -> Unit {
      let _ = c.box(fn(row : view::View) -> Unit {
        let is_lg = fn() -> Bool { aura::aura_is_md(row) && ap_is_lg(row) }
        let _ = row
          .fills_across(view::Live::Is(true))
          .gap(view::Live::Is(16.0))
          .row_reverse(view::Live::By(fn() -> Bool { is_lg() && aura::aura_rtl(row) }))
          .row(view::Live::By(fn() -> Bool {
            let _ = aura::aura_rtl(row)
            is_lg()
          }))
        let col_style = fn(col : view::View) -> Unit {
          let _ = col
            .grow(view::Live::By(fn() -> Double { if is_lg() { 1.0 } else { 0.0 } }))
            .shrink(view::Live::By(fn() -> Double { if is_lg() { 1.0 } else { 0.0 } }))
            .basis(view::Live::By(fn() -> Option[Double] { if is_lg() { Some(0.0) } else { None } }))
            .fills_across(view::Live::By(fn() -> Bool { !is_lg() }))
            .min_width(view::Live::Is(Some(0.0)))
        }

        // Select
        let _ = row.box(fn(col1 : view::View) -> Unit {
          col_style(col1)
          let states = [
            aura::AuraSelectOption::new("ca", "California"),
            aura::AuraSelectOption::new("ny", "New York"),
            aura::AuraSelectOption::new("tx", "Texas"),
            aura::AuraSelectOption::new("wa", "Washington"),
          ]
          let _ = aura::select_node(
            col1,
            states,
            label=view::Live::Is("Region (Select)"),
            initial_selected=["ca"],
            popover_width=240.0,
            gap=6.0,
          )
        })

        // ComboBox
        let _ = row.box(fn(col2 : view::View) -> Unit {
          col_style(col2)
          let engines = [
            aura::AuraSelectOption::new("native_gpu", "Native GPU"),
            aura::AuraSelectOption::new("gles", "EGL / GLES3"),
            aura::AuraSelectOption::new("d3d11", "Direct3D 11"),
            aura::AuraSelectOption::new("webgl2", "WebGL2"),
          ]
          let _ = aura::combo_box_node(
            col2,
            engines,
            label=view::Live::Is("GPU Backend (ComboBox)"),
            initial_selected=["native_gpu"],
            popover_width=240.0,
            gap=6.0,
          )
        })

        // Autocomplete
        let _ = row.box(fn(col3 : view::View) -> Unit {
          col_style(col3)
          let langs = [
            aura::AuraSelectOption::new("pion", "Pion"),
            aura::AuraSelectOption::new("lean", "Lean 4"),
            aura::AuraSelectOption::new("wgsl", "WGSL"),
            aura::AuraSelectOption::new("glsl", "GLSL"),
          ]
          let _ = aura::autocomplete_node(
            col3,
            langs,
            label=view::Live::Is("Language (Autocomplete)"),
            filter_placeholder=view::Live::Is("Filter languages..."),
            initial_selected=["pion"],
            popover_width=240.0,
            gap=6.0,
          )
        })
      })
    },
    tag="Pickers",
  )

  // Row 2: ListBox + TagGroup | Inline Menu
  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "ListBox & TagGroup",
        "Sectioned command list and interactive selectable tags.",
        fn(c : view::View) -> Unit {
          let lb = aura::listbox_node(
            c,
            fn(k : String) -> Bool { lb_sel.get() == k },
            fn(k : String) -> Unit { lb_sel.set(k) },
            fn(lb_v : view::View, lb : headless::Listbox[String]) -> Unit {
              let _ = aura::listbox_section_node(lb_v, lb, "Workspace Commands", fn(sv : view::View) -> Unit {
                let _ = aura::listbox_item_node(sv, lb, "build", "Build Packages")
                let _ = aura::listbox_item_node(sv, lb, "test", "Run Unit Tests")
                let _ = aura::listbox_item_node(sv, lb, "shot", "Render 2x Snapshots")
              })
            },
            label="Workspace Commands",
            in_overlay=false,
          )
          let _ = lb.fills_across(view::Live::Is(true))
          let _ = aura::separator_node(c)
          let _ = aura::tag_group_node(
            c,
            fn(lv : view::View, tg : headless::TagGroup[String]) -> Unit {
              let _ = aura::tag_node(lv, tg, "pion", "Pion")
              let _ = aura::tag_node(lv, tg, "invar", "Invar")
              let _ = aura::tag_node(lv, tg, "aura", "Aura")
              let _ = aura::tag_node(lv, tg, "oklch", "OKLCH")
            },
            label="Tags",
            is_selected=fn(k : String) -> Bool { tag_sel.get() == k },
            on_select=fn(k : String) -> Unit { tag_sel.set(k) },
          )
        },
        tag="Lists & Tags",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Menu & MenuSection",
        "Inline command menu with sections and destructive action styling.",
        fn(c : view::View) -> Unit {
          let m = aura::menu_node(
            c,
            fn(mv : view::View, menu : headless::Menu) -> Unit {
              let _ = aura::menu_section_node(mv, menu, "Release", fn(sv : view::View) -> Unit {
                let _ = aura::menu_item_node(sv, menu, "Publish Preview", on_action=fn() -> Unit { menu_choice.set("Publish Preview") })
                let _ = aura::menu_item_node(sv, menu, "Verify Checksums", on_action=fn() -> Unit { menu_choice.set("Verify Checksums") })
              })
              let _ = aura::menu_section_node(mv, menu, "Danger Zone", fn(sv : view::View) -> Unit {
                let _ = aura::menu_item_node(sv, menu, "Purge Build Cache", variant=aura::AuraItemVariant::Danger, on_action=fn() -> Unit { menu_choice.set("Purge Build Cache") })
              })
            },
            label="Release Menu",
            in_popover=false,
          )
          let _ = m.fills_across(view::Live::Is(true))
          let _ = aura::chip_node(
            c,
            view::Live::By(fn() -> String { "Selected: \{menu_choice.get()}" }),
            variant=aura::AuraChipVariant::Soft,
            color=aura::AuraStatusColor::Accent,
            size=aura::AuraControlSize::Sm,
          )
        },
        tag="Menu",
      )
    },
  )

  // Row 3: Full interactive Data Table (real sorting, multi-select, finite load-more)
  let _ = ap_demo_card(
    parent,
    "Data Table",
    "Sortable columns, multi-row selection, status chips, and finite load-more footer.",
    fn(c : view::View) -> Unit {
      let col_keys : Array[String] = ["name", "role", "status"]
      let total_members = ap_all_members.length()
      let _ = aura::table_node(c, variant=aura::AuraTableVariant::Primary, content=fn(tbl : view::View) -> Unit {
        let _ = aura::table_scroll_container_node(tbl, content=fn(sc : view::View) -> Unit {
          let _ = aura::TableContent(
            sc,
            row_keys=fn() -> Array[String] {
              let rows = ap_sorted_table_rows(loaded_count.get(), sort_col.get(), sort_dir.get())
              let keys : Array[String] = []
              for r in rows {
                keys.push(r.key)
              }
              keys
            },
            col_keys=fn() -> Array[String] { col_keys },
            label="Engineering Team",
            selection_mode=aura::aura_table_sel_multiple(),
            has_more=true,
            on_sort=fn(col_k : String, dir : headless_core::SortDir) -> Unit {
              let (dir_i, dir_s) = match dir {
                headless_core::SortDir::Ascending => (1, "ASC")
                headless_core::SortDir::Descending => (2, "DESC")
                headless_core::SortDir::None => (0, "None")
              }
              sort_col.set(col_k)
              sort_dir.set(dir_i)
              if dir_i == 0 {
                sort_desc.set("Unsorted")
              } else {
                sort_desc.set("\{col_k} (\{dir_s})")
              }
            },
            on_selection_change=fn(keys : Array[String]) -> Unit {
              sel_count.set(keys.length())
            },
            on_load_more=fn() -> Unit {
              let cur = loaded_count.get()
              if cur < total_members {
                let next = if cur + 2 > total_members { total_members } else { cur + 2 }
                let added = next - cur
                loaded_count.set(next)
                toast_queue.push(
                  aura::AuraToastData::new(
                    "tbl-more",
                    "Loaded \{added} additional members",
                    variant=aura::AuraToastVariant::Default,
                  ),
                )
              }
            },
            children=fn(tc : view::View) -> Unit {
              let _ = aura::table_header_node(tc, content=fn(hdr : view::View) -> Unit {
                let _ = aura::table_column_node(hdr, "name", view::Live::Is("Name"), sortable=true, flex_grow=1.4)
                let _ = aura::table_column_node(hdr, "role", view::Live::Is("Role"), sortable=true, flex_grow=1.2)
                let _ = aura::table_column_node(hdr, "status", view::Live::Is("Status"), sortable=true, is_last=true, flex_grow=0.8)
              })
              let _ = aura::table_body_node(tc, content=fn(tb : view::View) -> Unit {
                let _ = tb.pick(
                  fn() -> String { "\{loaded_count.get()}:\{sort_col.get()}:\{sort_dir.get()}" },
                  fn(rows_slot : view::View, _key : String) -> Unit {
                    let _ = rows_slot.fills_across(view::Live::Is(true))
                    let rows = ap_sorted_table_rows(loaded_count.get(), sort_col.get(), sort_dir.get())
                    let mut i = 0
                    while i < rows.length() {
                      let m = rows[i]
                      let last = i + 1 == rows.length()
                      let _ = aura::table_row_node(rows_slot, m.key, is_last=last, content=fn(tr : view::View, _sel : () -> Bool) -> Unit {
                        let _ = aura::table_cell_node(tr, "name", text=view::Live::Is(m.name), flex_grow=1.4)
                        let _ = aura::table_cell_node(tr, "role", text=view::Live::Is(m.role), flex_grow=1.2)
                        let _ = aura::table_cell_node(
                          tr,
                          "status",
                          label=m.status,
                          flex_grow=0.8,
                          content=fn(cell : view::View, _foc : () -> Bool) -> Unit {
                            let _ = aura::chip_node(cell, view::Live::Is(m.status), variant=aura::AuraChipVariant::Soft, color=m.color, size=aura::AuraControlSize::Sm)
                          },
                        )
                      })
                      i += 1
                    }
                  },
                  at_once=true,
                )
              })
              let _ = tc.show(
                fn() -> Bool { loaded_count.get() < total_members },
                fn(lm_slot : view::View) -> Unit {
                  let _ = lm_slot.fills_across(view::Live::Is(true))
                  let _ = aura::table_load_more_node(lm_slot, label="Load more members")
                },
                at_once=true,
              )
              let _ = aura::table_footer_node(tc, content=fn(ftr : view::View) -> Unit {
                let _ = ftr.box(fn(info : view::View) -> Unit {
                  let _ = info
                    .words(
                      view::Live::By(fn() -> String {
                        "Selected: \{sel_count.get()} · Sort: \{sort_desc.get()}"
                      }),
                      look=ap_words(12.0, 500, 16.0),
                    )
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(info).palette.muted }))
                })
                let _ = aura::chip_node(
                  ftr,
                  view::Live::By(fn() -> String { "\{loaded_count.get()} rows" }),
                  variant=aura::AuraChipVariant::Secondary,
                  color=aura::AuraStatusColor::Default,
                  size=aura::AuraControlSize::Sm,
                )
              })
            },
          )
        })
      })
    },
    tag="Table",
  )
}

// ============================================================================
// Category 7: DateTime, Color & Feedback (24 Components)
// ============================================================================

fn section_composite(parent : view::View, toast_queue : aura::ToastQueue, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "DateTime, Color & Feedback",
    "Calendars, segmented date/time pickers, pure-GPU 2D color spectrum, channel sliders, alerts, toasts, badges, avatars, progress, and skeletons.",
    "24 Components",
  )

  let nov24 = aura::aura_date(2026, 11, 24)
  let nov10 = aura::aura_date(2026, 11, 10)

  let cal_date = state.cmp_cal_date
  let range_dates = state.cmp_range_dates
  let df_val = state.cmp_df_val
  let tf_val = state.cmp_tf_val
  let dp_val = state.cmp_dp_val
  let drp_start = state.cmp_drp_start
  let drp_end = state.cmp_drp_end

  let color_val = state.cmp_color_val
  let swatch_hex = state.cmp_swatch_hex
  let picker_color = state.cmp_picker_color

  // Row 1: Date & Time (Calendar + RangeCalendar + Date/Time Fields & Pickers)
  let _ = ap_demo_card(
    parent,
    "Date & Time Suite",
    "Calendar with YearPicker, RangeCalendar, DateField, TimeField, DatePicker, and DateRangePicker.",
    fn(c : view::View) -> Unit {
      let _ = c.box(fn(row : view::View) -> Unit {
        let _ = row
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
          .fills_across(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Start)))
          .wraps(view::Live::Is(Some(16.0)))
          .gap(view::Live::Is(16.0))

        // Calendar (includes CalendarYearPicker) — aligned container height with RangeCalendar
        let _ = row.box(fn(c1 : view::View) -> Unit {
          let _ = c1.shrink(view::Live::Is(0.0))
          let _ = aura::surface_node(
            c1,
            variant=aura::AuraSurfaceVariant::Secondary,
            radius=16.0,
            pad=12.0,
            gap=0.0,
            content=fn(inner : view::View) -> Unit {
              let _ = inner.min_height(view::Live::Is(Some(308.0)))
              let _ = aura::calendar_node(
                inner,
                nov24,
                fn() { cal_date.get() },
                fn(d) { cal_date.set(Some(d)) },
                today=fn() { Some(nov24) },
                show_year_picker=true,
              )
            },
          )
        })

        // RangeCalendar — aligned container height with Calendar
        let _ = row.box(fn(c2 : view::View) -> Unit {
          let _ = c2.shrink(view::Live::Is(0.0))
          let _ = aura::surface_node(
            c2,
            variant=aura::AuraSurfaceVariant::Secondary,
            radius=16.0,
            pad=12.0,
            gap=0.0,
            content=fn(inner : view::View) -> Unit {
              let _ = inner.min_height(view::Live::Is(Some(308.0)))
              let _ = aura::range_calendar_node(
                inner,
                nov10,
                fn() { range_dates.get() },
                fn(a, b) { range_dates.set(Some((a, b))) },
                today=fn() { Some(nov24) },
              )
            },
          )
        })

        // Segmented Fields & Pickers
        let _ = row.box(fn(c3 : view::View) -> Unit {
          let _ = c3
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(240.0)))
            .min_width(view::Live::Is(Some(220.0)))
            .gap(view::Live::Is(12.0))
          let _ = aura::date_field_node(
            c3,
            fn() { df_val.get() },
            fn(v) { df_val.set(v) },
            label="DateField",
            variant=aura::AuraFieldVariant::Secondary,
          )
          let _ = aura::time_field_node(
            c3,
            fn() { tf_val.get() },
            fn(v) { tf_val.set(v) },
            label="TimeField",
            variant=aura::AuraFieldVariant::Secondary,
          )
          let _ = aura::date_picker_node(
            c3,
            value=fn() { dp_val.get() },
            on_change=fn(v) { dp_val.set(v) },
            label="DatePicker",
            variant=aura::AuraFieldVariant::Secondary,
            today=fn() { Some(nov24) },
          )
          let _ = aura::date_range_picker_node(
            c3,
            start_value=fn() { drp_start.get() },
            end_value=fn() { drp_end.get() },
            on_change=fn(ns, ne) { drp_start.set(ns); drp_end.set(ne) },
            label="DateRangePicker",
            variant=aura::AuraFieldVariant::Secondary,
            today=fn() { Some(nov24) },
          )
        })
      })
    },
    tag="DateTime",
  )

  // Row 2: Color Suite | Feedback & Media Suite
  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Color Spectrum & Pickers",
        "Pure-GPU ColorArea, Hue/Alpha ColorSliders, Swatches, ColorField, and ColorPicker.",
        fn(c : view::View) -> Unit {
          let palette_hex : Array[String] = ["#0485F7", "#17C964", "#F5A524", "#F31260", "#7828C8", "#27272A"]
          let palette_rgba : Array[Int64] = [0x0485F7FFL, 0x17C964FFL, 0xF5A524FFL, 0xF31260FFL, 0x7828C8FFL, 0x27272AFFL]

          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .wraps(view::Live::Is(Some(8.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(10.0))
            for col_hex in palette_rgba {
              let _ = aura::color_swatch_node(row, view::Live::Is(col_hex), size=aura::AuraColorSwatchSize::Md)
            }
          })
          let _ = aura::color_swatch_picker_node(
            c,
            palette_hex,
            fn() -> Option[String] { Some(swatch_hex.get()) },
            fn(s : String) -> Unit { swatch_hex.set(s) },
            size=aura::AuraColorSwatchSize::Md,
            gap=8.0,
          )
          let _ = c.box(fn(area_row : view::View) -> Unit {
            let _ = area_row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(area_row) }))
              .fills_across(view::Live::Is(true))
              .wraps(view::Live::Is(Some(12.0)))
              .gap(view::Live::Is(16.0))
            let _ = aura::color_area_node(
              area_row,
              fn() { color_val.get() },
              fn(m) { color_val.set(m) },
              x_channel=aura::aura_ch_saturation(),
              y_channel=aura::aura_ch_brightness(),
              size=172.0,
            )
            let _ = area_row.box(fn(sliders : view::View) -> Unit {
              let _ = sliders
                .grow(view::Live::Is(1.0))
                .shrink(view::Live::Is(1.0))
                .basis(view::Live::Is(Some(140.0)))
                .min_width(view::Live::Is(Some(140.0)))
                .gap(view::Live::Is(12.0))
              let _ = aura::color_slider_node(sliders, aura::aura_ch_hue(), fn() { color_val.get() }, fn(m) { color_val.set(m) }, label="Hue")
              let _ = aura::color_slider_node(sliders, aura::aura_ch_alpha(), fn() { color_val.get() }, fn(m) { color_val.set(m) }, label="Alpha")
              let _ = aura::color_field_node(sliders, fn() { color_val.get() }, fn(m) { color_val.set(m) }, label="Hex Value")
            })
          })
          let _ = aura::color_picker_node(
            c,
            model=fn() { picker_color.get() },
            on_change=fn(m) { picker_color.set(m) },
            label="Pick Brand Accent",
          )
        },
        tag="Color",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Alerts, Toasts, Badges & Loading",
        "Semantic alerts, interactive toast launcher, avatars, progress, spinner, and skeleton.",
        fn(c : view::View) -> Unit {
          let _ = aura::alert_node(c, status=aura::AuraAlertStatus::Accent, title=view::Live::Is("Accent Alert"), description=view::Live::Is("Informational notice with monochrome icon."))
          let _ = aura::alert_node(c, status=aura::AuraAlertStatus::Warning, title=view::Live::Is("Warning Alert"), description=view::Live::Is("Review token contrast before publishing."))
          let _ = aura::alert_node(c, status=aura::AuraAlertStatus::Danger, title=view::Live::Is("Danger Alert"), description=view::Live::Is("Action requires confirmation."))

          let _ = c.box(fn(toast_btns : view::View) -> Unit {
            let _ = toast_btns
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(toast_btns) }))
              .wraps(view::Live::Is(Some(8.0)))
              .gap(view::Live::Is(8.0))
            let _ = aura::button_node(toast_btns, view::Live::Is("Success Toast"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit {
              toast_queue.push(aura::AuraToastData::new("t-ok", "Build Succeeded", description="All Aura checks passed.", variant=aura::AuraToastVariant::Success))
            })
            let _ = aura::button_node(toast_btns, view::Live::Is("Warning Toast"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit {
              toast_queue.push(aura::AuraToastData::new("t-warn", "Cache Warmup", description="Rebuilding glyph atlas.", variant=aura::AuraToastVariant::Warning))
            })
            let _ = aura::button_node(toast_btns, view::Live::Is("Danger Toast"), variant=aura::AuraButtonVariant::DangerSoft, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit {
              toast_queue.push(aura::AuraToastData::new("t-err", "Upload Failed", description="Retry in 5 seconds.", variant=aura::AuraToastVariant::Danger))
            })
          })

          let _ = c.box(fn(avatar_row : view::View) -> Unit {
            let _ = avatar_row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(avatar_row) }))
              .wraps(view::Live::Is(Some(10.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(14.0))
            let _ = aura::badge_anchor_node(avatar_row, content=fn(anc : view::View) -> Unit {
              let _ = aura::avatar_node(anc, fallback=view::Live::Is("AR"))
              let _ = aura::badge_node(anc, label=view::Live::Is("5"), variant=aura::AuraBadgeVariant::Primary, color=aura::AuraStatusColor::Accent, size=aura::AuraControlSize::Sm, placement=aura::AuraBadgePlacement::TopRight)
            })
            let _ = aura::avatar_group_node(
              avatar_row,
              [
                aura::AuraAvatarItem::new("A1"),
                aura::AuraAvatarItem::new("B2"),
                aura::AuraAvatarItem::new("C3"),
                aura::AuraAvatarItem::new("D4"),
              ],
              max=3,
            )
            let _ = aura::chip_node(avatar_row, view::Live::Is("Primary"), variant=aura::AuraChipVariant::Primary, color=aura::AuraStatusColor::Accent, size=aura::AuraControlSize::Sm)
            let _ = aura::chip_node(avatar_row, view::Live::Is("Soft"), variant=aura::AuraChipVariant::Soft, color=aura::AuraStatusColor::Success, size=aura::AuraControlSize::Sm)
          })

          let _ = c.box(fn(prog_row : view::View) -> Unit {
            let _ = prog_row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(prog_row) }))
              .fills_across(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(16.0))
            let _ = prog_row.box(fn(pb : view::View) -> Unit {
              let _ = pb.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = aura::progress_bar_node(pb, fn() -> Option[Double] { Some(74.0) }, label="Pipeline Progress", color=aura::AuraStatusColor::Success)
            })
            let _ = aura::progress_circle_node(prog_row, fn() -> Option[Double] { Some(78.0) }, size=aura::AuraControlSize::Md, color=aura::AuraStatusColor::Accent)
            let _ = aura::spinner_node(prog_row, size=aura::AuraSpinnerSize::Md, color=aura::AuraSpinnerColor::Accent)
          })

          let _ = aura::skeleton_group_node(c, gap=8.0, content=fn(sg : view::View) -> Unit {
            let _ = aura::skeleton_node(sg, width=240.0, height=16.0, radius=6.0)
            let _ = aura::skeleton_node(sg, width=180.0, height=14.0, radius=6.0)
          })
        },
        tag="Feedback",
      )
    },
  )
}
