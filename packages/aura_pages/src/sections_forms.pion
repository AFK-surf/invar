// Aura Studio — Category 2 (Inputs & Forms) and Category 3 (Selection & Range).

import "aura"
import "view"

// ============================================================================
// Category 2: Inputs & Forms (14 Components)
// ============================================================================

fn section_inputs(parent : view::View, toast_queue : aura::ToastQueue, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "Inputs & Forms",
    "Text fields, multiline areas, affixed input groups, search, numeric steppers, OTP codes, and structured fieldsets with validation.",
    "14 Components",
  )

  let qty = state.inp_qty
  let search_val = state.inp_search_val
  let form_submitted = state.inp_form_submitted
  let street_val = state.inp_street_val
  let street_field = state.inp_street_field
  let bio_field = state.inp_bio_field

  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      // Card 1: TextField variants + standalone TextArea + InputGroup
      let _ = ap_demo_card(
        col,
        "TextField, TextArea & InputGroup",
        "Primary, Secondary, Invalid states, multiline bio, and URL prefix/suffix.",
        fn(c : view::View) -> Unit {
          let _ = aura::text_field_node(
            c,
            label=view::Live::Is("Work Email (Primary)"),
            value="alex@example.test",
            description=view::Live::Is("Used for build notifications and release digests."),
            variant=aura::AuraFieldVariant::Primary,
          )
          let _ = aura::text_field_node(
            c,
            label=view::Live::Is("Workspace (Secondary)"),
            value="Aura Studio",
            variant=aura::AuraFieldVariant::Secondary,
          )
          let _ = c.box(fn(inv_wrap : view::View) -> Unit {
            let _ = inv_wrap.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
            let _ = inv_wrap.box(fn(lbl_slot : view::View) -> Unit {
              let _ = aura::label_node(lbl_slot, view::Live::Is("Handle (Invalid)"))
            })
            let _ = aura::input_node(
              inv_wrap,
              value="x",
              label="Handle (Invalid)",
              invalid=view::Live::Is(true),
              variant=aura::AuraFieldVariant::Primary,
            )
            let _ = aura::field_error_node(
              inv_wrap,
              view::Live::Is("Handle must be at least 3 characters."),
              visible=view::Live::Is(true),
            )
          })
          let _ = c.box(fn(ig_wrap : view::View) -> Unit {
            let _ = ig_wrap.fills_across(view::Live::Is(true)).gap(view::Live::Is(6.0))
            let _ = ig_wrap.box(fn(lbl_slot : view::View) -> Unit {
              let _ = aura::label_node(lbl_slot, view::Live::Is("Domain (InputGroup)"))
            })
            let _ = aura::input_group_node(
              ig_wrap,
              variant=aura::AuraFieldVariant::Primary,
              content=fn(grp : view::View) -> Unit {
                let _ = aura::input_group_prefix_node(grp, text=view::Live::Is("https://"))
                let _ = aura::input_group_input_node(grp, value="invar", has_prefix=true, has_suffix=true)
                let _ = aura::input_group_suffix_node(grp, text=view::Live::Is(".dev"))
              },
            )
            let _ = ig_wrap.box(fn(desc_slot : view::View) -> Unit {
              let _ = aura::description_node(desc_slot, view::Live::Is("Prefix and suffix share the unified field focus ring."))
            })
          })
          let _ = c.box(fn(bio_wrap : view::View) -> Unit {
            let _ = bio_wrap.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
            let _ = bio_wrap.box(fn(lbl_slot : view::View) -> Unit {
              let _ = aura::label_node(lbl_slot, view::Live::Is("Bio (TextArea)"))
            })
            let _ = aura::textarea_node(
              bio_wrap,
              field=bio_field,
              label="Bio (TextArea)",
              rows=2,
              variant=aura::AuraFieldVariant::Primary,
            )
          })
        },
        tag="Text Fields",
      )
    },
    fn(col : view::View) -> Unit {
      // Card 2: SearchField, NumberField, InputOTP
      let _ = ap_demo_card(
        col,
        "SearchField, NumberField & InputOTP",
        "Specialized keyboard-accessible search, numeric stepper, and 6-slot OTP.",
        fn(c : view::View) -> Unit {
          let _ = aura::search_field_node(
            c,
            label=view::Live::Is("Search Components"),
            value=search_val.get(),
            variant=aura::AuraFieldVariant::Primary,
            on_change=fn(s : String) -> Unit { search_val.set(s) },
          )
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
            let _ = aura::chip_node(
              row,
              view::Live::By(fn() -> String { "Query: \"\{search_val.get()}\"" }),
              variant=aura::AuraChipVariant::Soft,
              color=aura::AuraStatusColor::Accent,
              size=aura::AuraControlSize::Sm,
            )
          })
          let _ = aura::number_field_node(
            c,
            view::Live::By(fn() -> Double { qty.get() }),
            fn(v : Double) -> Unit { qty.set(v) },
            label=view::Live::Is("Replica Count (NumberField)"),
            min=0.0,
            max=999.0,
            step=1.0,
            variant=aura::AuraFieldVariant::Primary,
          )
          let _ = c.box(fn(otp_wrap : view::View) -> Unit {
            let _ = otp_wrap.fills_across(view::Live::Is(true)).gap(view::Live::Is(8.0))
            let _ = aura::label_node(otp_wrap, view::Live::Is("Verification Code (InputOTP)"))
            let _ = aura::input_otp_node(
              otp_wrap,
              max_length=6,
              value="4821",
              content=fn(otp_v : view::View, _ctrl) -> Unit {
                let _ = aura::input_otp_group_node(otp_v, content=fn(g : view::View) -> Unit {
                  let _ = aura::input_otp_slot_node(g, 0)
                  let _ = aura::input_otp_slot_node(g, 1)
                  let _ = aura::input_otp_slot_node(g, 2)
                })
                let _ = aura::input_otp_separator_node(otp_v)
                let _ = aura::input_otp_group_node(otp_v, content=fn(g : view::View) -> Unit {
                  let _ = aura::input_otp_slot_node(g, 3)
                  let _ = aura::input_otp_slot_node(g, 4)
                  let _ = aura::input_otp_slot_node(g, 5)
                })
              },
            )
          })
        },
        tag="Specialized",
      )

      // Card 3: Form + Fieldset + standalone Input + ErrorMessage + FieldError
      let _ = ap_demo_card(
        col,
        "Form, Fieldset & FieldError",
        "Semantic form grouping with legend, description, actions, and error feedback.",
        fn(c : view::View) -> Unit {
          let _ = aura::form_node(
            c,
            label=view::Live::Is("Shipping profile"),
            gap=14.0,
            content=fn(fv : view::View, _f) -> Unit {
              let _ = aura::fieldset_node(
                fv,
                label=view::Live::Is("Shipping Address"),
                gap=10.0,
                content=fn(fsv : view::View, _fs) -> Unit {
                  let _ = fsv.box(fn(leg_slot : view::View) -> Unit {
                    let _ = aura::fieldset_legend_node(leg_slot, view::Live::Is("Shipping Address"))
                  })
                  let _ = fsv.box(fn(fdesc_slot : view::View) -> Unit {
                    let _ = aura::fieldset_description_node(fdesc_slot, view::Live::Is("Destination for hardware kits and printed badges."))
                  })
                  let _ = aura::fieldset_group_node(fsv, gap=10.0, content=fn(fg : view::View) -> Unit {
                    let _ = aura::input_node(
                      fg,
                      field=street_field,
                      label="Street address",
                      placeholder=view::Live::Is("Street address"),
                      invalid=view::Live::By(fn() -> Bool { ap_is_blank(street_val.get()) }),
                      variant=aura::AuraFieldVariant::Secondary,
                      on_change=fn(s : String) -> Unit { street_val.set(s) },
                    )
                    let _ = aura::field_error_node(
                      fg,
                      view::Live::Is("Street address cannot be empty."),
                      visible=view::Live::By(fn() -> Bool { ap_is_blank(street_val.get()) }),
                    )
                  })
                  let _ = aura::fieldset_actions_node(fsv, content=fn(act : view::View) -> Unit {
                    let _ = aura::button_node(
                      act,
                      view::Live::Is("Save Address"),
                      variant=aura::AuraButtonVariant::Primary,
                      size=aura::AuraButtonSize::Sm,
                      on_press=fn() -> Unit {
                        let cur = street_field.text()
                        street_val.set(cur)
                        if ap_is_blank(cur) {
                          form_submitted.set(false)
                        } else {
                          form_submitted.set(true)
                          toast_queue.push(
                            aura::AuraToastData::new(
                              "form-saved",
                              "Address Saved",
                              description="Updated shipping destination.",
                              variant=aura::AuraToastVariant::Success,
                            ),
                          )
                        }
                      },
                    )
                    let _ = aura::button_node(
                      act,
                      view::Live::Is("Reset"),
                      variant=aura::AuraButtonVariant::Tertiary,
                      size=aura::AuraButtonSize::Sm,
                      on_press=fn() -> Unit {
                        street_field.set("128 Horizon Way")
                        street_val.set("128 Horizon Way")
                        form_submitted.set(false)
                      },
                    )
                  })
                },
              )
              let _ = fv.box(fn(em_slot : view::View) -> Unit {
                let _ = aura::error_message_node(em_slot, view::Live::Is("Standalone ErrorMessage specimen for form-level validation."))
              })
            },
          )
        },
        tag="Form",
      )
    },
  )
}

// ============================================================================
// Category 3: Selection & Range (9 Components)
// ============================================================================

fn section_selection(parent : view::View, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "Selection & Range",
    "Checkboxes, radio groups, switches across all sizes, continuous sliders, dual-thumb range sliders, and live meters.",
    "9 Components",
  )

  let cb_alerts = state.sel_cb_alerts
  let cb_beta = state.sel_cb_beta
  let plan = state.sel_plan
  let sw_sm = state.sel_sw_sm
  let sw_md = state.sel_sw_md
  let sw_off = state.sel_sw_off
  let sw_lg = state.sel_sw_lg
  let volume = state.sel_volume
  let price_lo = state.sel_price_lo
  let price_hi = state.sel_price_hi

  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "CheckboxGroup & RadioGroup",
        "Interactive checked, indeterminate, disabled checkboxes and radio plans.",
        fn(c : view::View) -> Unit {
          let _ = aura::checkbox_group_node(
            c,
            label=view::Live::Is("Feature Flags"),
            gap=12.0,
            content=fn(cg : view::View) -> Unit {
              let _ = aura::checkbox_node(
                cg,
                label=view::Live::Is("Release alerts"),
                checked=view::Live::By(fn() -> Bool { cb_alerts.get() }),
                on_change=fn(v : Bool) -> Unit { cb_alerts.set(v) },
              )
              let _ = aura::checkbox_node(
                cg,
                label=view::Live::Is("Experimental shaders"),
                checked=view::Live::By(fn() -> Bool { cb_beta.get() }),
                on_change=fn(v : Bool) -> Unit { cb_beta.set(v) },
              )
              let _ = aura::checkbox_node(
                cg,
                label=view::Live::Is("Partial selection (Indeterminate)"),
                indeterminate=view::Live::Is(true),
              )
              let _ = aura::checkbox_node(
                cg,
                label=view::Live::Is("Locked policy (Disabled)"),
                disabled=view::Live::Is(true),
              )
            },
          )
          let _ = aura::separator_node(c)
          let _ = aura::radio_group_node(
            c,
            view::Live::By(fn() -> String { plan.get() }),
            fn(v : String) -> Unit { plan.set(v) },
            label=view::Live::Is("Compute Tier"),
            gap=10.0,
            content=fn(rg : view::View) -> Unit {
              let _ = rg.gap(view::Live::Is(12.0))
              let _ = aura::radio_node(rg, "starter", label=view::Live::Is("Starter · Free"))
              let _ = aura::radio_node(rg, "pro", label=view::Live::Is("Pro · 8 GPU cores"))
              let _ = aura::radio_node(rg, "enterprise", label=view::Live::Is("Enterprise · Dedicated cluster"))
            },
          )
        },
        tag="Choice",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "SwitchGroup, Sliders & Meters",
        "All switch sizes, single/range sliders wired live to semantic meters.",
        fn(c : view::View) -> Unit {
          let sg_root = aura::switch_group_node(
            c,
            label=view::Live::Is("Switches (sm / md / lg)"),
            orientation=aura::AuraOrientation::Horizontal,
            gap=10.0,
            item_gap=14.0,
            content=fn(sg : view::View) -> Unit {
              let _ = sg
                .fills_across(view::Live::Is(true))
                .wraps(view::Live::Is(Some(10.0)))
                .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(sg) }))
              let _ = aura::switch_node(sg, view::Live::By(fn() -> Bool { sw_sm.get() }), fn(v : Bool) -> Unit { sw_sm.set(v) }, label=view::Live::Is("SM"), size=aura::AuraSwitchSize::Sm)
              let _ = aura::switch_node(sg, view::Live::By(fn() -> Bool { sw_md.get() }), fn(v : Bool) -> Unit { sw_md.set(v) }, label=view::Live::Is("MD On"), size=aura::AuraSwitchSize::Md)
              let _ = aura::switch_node(sg, view::Live::By(fn() -> Bool { sw_off.get() }), fn(v : Bool) -> Unit { sw_off.set(v) }, label=view::Live::Is("MD Off"), size=aura::AuraSwitchSize::Md)
              let _ = aura::switch_node(sg, view::Live::By(fn() -> Bool { sw_lg.get() }), fn(v : Bool) -> Unit { sw_lg.set(v) }, label=view::Live::Is("LG"), size=aura::AuraSwitchSize::Lg)
            },
          )
          let _ = sg_root
            .fills_across(view::Live::Is(true))
            .lines_up(view::Live::By(fn() -> Option[view::Along] {
              Some(if aura::aura_rtl(sg_root) { view::Along::End } else { view::Along::Start })
            }))
          let _ = aura::separator_node(c)
          let _ = aura::slider_node(
            c,
            view::Live::By(fn() -> Double { volume.get() }),
            fn(v : Double) -> Unit { volume.set(v) },
            label=view::Live::Is("Master Volume"),
            min=0.0,
            max=100.0,
            step=1.0,
          )
          let _ = aura::range_slider_node(
            c,
            view::Live::By(fn() -> Double { price_lo.get() }),
            view::Live::By(fn() -> Double { price_hi.get() }),
            fn(a : Double, b : Double) -> Unit { price_lo.set(a); price_hi.set(b) },
            label=view::Live::Is("Budget Range"),
            min=0.0,
            max=100.0,
            step=1.0,
          )
          let _ = aura::separator_node(c)
          let _ = aura::meter_node(
            c,
            view::Live::By(fn() -> Double { volume.get() }),
            label=view::Live::Is("Storage Allocation (linked to Volume)"),
            color=aura::AuraMeterColor::Accent,
          )
          let _ = aura::meter_node(
            c,
            view::Live::By(fn() -> Double { price_hi.get() }),
            label=view::Live::Is("Quota Ceiling (linked to Range High)"),
            color=aura::AuraMeterColor::Warning,
          )
        },
        tag="Range",
      )
    },
  )
}
