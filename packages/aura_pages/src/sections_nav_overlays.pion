// Aura Studio — Category 4 (Navigation) and Category 5 (Overlays).

import "aura"
import "headless"
import "signals"
import "view"

// ============================================================================
// Category 4: Navigation (6 Components)
// ============================================================================

fn section_navigation(parent : view::View, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "Navigation",
    "Pill and underline tabs, surface accordions, standalone and grouped disclosures, breadcrumbs, and pagination.",
    "6 Components",
  )

  let tab_primary = state.nav_tab_primary
  let tab_secondary = state.nav_tab_secondary
  let acc_open = state.nav_acc_open
  let disc_open = state.nav_disc_open
  let dg_open = state.nav_dg_open
  let cur_page = state.nav_cur_page

  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Tabs (Primary & Secondary)",
        "Sliding pill indicator tabs with panels and underline secondary tabs.",
        fn(c : view::View) -> Unit {
          let p_items = [
            aura::AuraTabItem::new("overview", "Overview", fn(pv : view::View) -> Unit {
              let _ = pv.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .words(view::Live::Is("Overview panel — OKLCH semantic tokens and smooth corner radii."), look=ap_words(13.5, 400, 20.0, wrap=true))
                  .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(tv).palette.muted }))
              })
            }),
            aura::AuraTabItem::new("metrics", "Metrics", fn(pv : view::View) -> Unit {
              let _ = pv.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .words(view::Live::Is("Metrics panel — 86 components verified with 0 craft audit faults."), look=ap_words(13.5, 400, 20.0, wrap=true))
                  .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(tv).palette.muted }))
              })
            }),
            aura::AuraTabItem::new("settings", "Settings", fn(pv : view::View) -> Unit {
              let _ = pv.box(fn(tv : view::View) -> Unit {
                let _ = tv
                  .words(view::Live::Is("Settings panel — toggle Light/Dark, Vibrant, RTL, or Circular corners in the top bar."), look=ap_words(13.5, 400, 20.0, wrap=true))
                  .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(tv).palette.muted }))
              })
            }),
          ]
          let _ = aura::tabs_node(
            c,
            p_items,
            fn() -> String { tab_primary.get() },
            fn(k : String) -> Unit { tab_primary.set(k) },
            variant=aura::AuraTabsVariant::Primary,
            panel_gap=12.0,
          )
          let _ = aura::separator_node(c)
          let s_items = [
            aura::AuraTabItem::new("code", "Code", fn(_pv : view::View) -> Unit { () }),
            aura::AuraTabItem::new("preview", "Preview", fn(_pv : view::View) -> Unit { () }),
            aura::AuraTabItem::new("tokens", "Tokens", fn(_pv : view::View) -> Unit { () }),
          ]
          let _ = aura::tabs_node(
            c,
            s_items,
            fn() -> String { tab_secondary.get() },
            fn(k : String) -> Unit { tab_secondary.set(k) },
            variant=aura::AuraTabsVariant::Secondary,
            show_panels=false,
          )
        },
        tag="Tabs",
      )

      let _ = ap_demo_card(
        col,
        "Accordion (Surface Variant)",
        "Accessible collapsible sections with keyboard navigation.",
        fn(c : view::View) -> Unit {
          let items = [
            aura::AuraAccordionItem::new("q1", "How does Aura handle theming?", fn(pv : view::View) -> Unit {
              let _ = pv.show(
                fn() -> Bool { acc_open.get() == "q1" },
                fn(bv : view::View) -> Unit {
                  let _ = bv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is("A single reactive AuraConfig signal drives OKLCH light/dark/vibrant palettes, RTL mirroring, and corner geometry."), look=ap_words(13.5, 400, 20.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                },
                at_once=true,
              )
            }),
            aura::AuraAccordionItem::new("q2", "Are all 86 components interactive?", fn(pv : view::View) -> Unit {
              let _ = pv.show(
                fn() -> Bool { acc_open.get() == "q2" },
                fn(bv : view::View) -> Unit {
                  let _ = bv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is("Yes — every component uses headless state machines with keyboard, pointer, and focus-ring support."), look=ap_words(13.5, 400, 20.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                },
                at_once=true,
              )
            }),
            aura::AuraAccordionItem::new("q3", "What corner style is default?", fn(pv : view::View) -> Unit {
              let _ = pv.show(
                fn() -> Bool { acc_open.get() == "q3" },
                fn(bv : view::View) -> Unit {
                  let _ = bv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is("Continuous smooth corners (squircle) are enabled by default; circular arcs can be toggled live."), look=ap_words(13.5, 400, 20.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                },
                at_once=true,
              )
            }),
          ]
          let _ = aura::accordion_node(
            c,
            items,
            fn() -> Array[String] {
              let cur = acc_open.get()
              if cur == "" { [] } else { [cur] }
            },
            fn(k : String) -> Unit {
              if acc_open.get() == k { acc_open.set("") } else { acc_open.set(k) }
            },
            variant=aura::AuraAccordionVariant::Surface,
          )
        },
        tag="Accordion",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Breadcrumbs & Pagination",
        "Hierarchical location trail and multi-page navigation bar.",
        fn(c : view::View) -> Unit {
          ap_sub_label(c, "Breadcrumbs")
          let bc = [
            aura::AuraBreadcrumbItem::new("Invar"),
            aura::AuraBreadcrumbItem::new("Packages"),
            aura::AuraBreadcrumbItem::new("Aura"),
            aura::AuraBreadcrumbItem::new("Navigation"),
          ]
          let _ = aura::breadcrumbs_node(c, bc)
          let _ = aura::separator_node(c)
          ap_sub_label(c, "Pagination")
          let _ = aura::pagination_node(
            c,
            fn() -> Int { 12 },
            fn() -> Int { cur_page.get() },
            fn(p : Int) -> Unit { cur_page.set(p) },
          )
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(8.0))
            let _ = aura::chip_node(
              row,
              view::Live::By(fn() -> String { "Page \{cur_page.get()} of 12" }),
              variant=aura::AuraChipVariant::Soft,
              color=aura::AuraStatusColor::Accent,
              size=aura::AuraControlSize::Sm,
            )
          })
        },
        tag="Trail & Pages",
      )

      let _ = ap_demo_card(
        col,
        "Disclosure & DisclosureGroup",
        "Standalone collapsible trigger and coordinated disclosure group.",
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(disc_wrap : view::View) -> Unit {
            let _ = disc_wrap.fills_across(view::Live::Is(true)).min_width(view::Live::Is(Some(0.0)))
            let _ = aura::disclosure_node(
              disc_wrap,
              view::Live::Is("Release Notes (Disclosure)"),
              fn() -> Bool { disc_open.get() },
              fn() -> Unit { disc_open.set(!disc_open.get()) },
              fn(pv : view::View) -> Unit {
                let _ = pv
                  .words(view::Live::Is("Aura Studio showcases all 86 reactive components with live RTL mirroring and Smooth/Circular corner toggles."), look=ap_words(13.5, 400, 20.0, wrap=true))
                  .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(pv).palette.muted }))
              },
            )
          })
          let _ = aura::separator_node(c)
          let dg_items = [
            aura::AuraAccordionItem::new("g1", "GPU Shaders", fn(pv : view::View) -> Unit {
              let _ = pv.show(
                fn() -> Bool { dg_open.get() == "g1" },
                fn(bv : view::View) -> Unit {
                  let _ = bv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is("Native GPU, EGL/GLES3, Direct3D 11, and WebGL2 in lockstep."), look=ap_words(13.0, 400, 19.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                },
                at_once=true,
              )
            }),
            aura::AuraAccordionItem::new("g2", "Accessibility", fn(pv : view::View) -> Unit {
              let _ = pv.show(
                fn() -> Bool { dg_open.get() == "g2" },
                fn(bv : view::View) -> Unit {
                  let _ = bv
                    .fills_across(view::Live::Is(true))
                    .words(view::Live::Is("Headless ARIA roles, roving tabindex, and focus-visible rings."), look=ap_words(13.0, 400, 19.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                },
                at_once=true,
              )
            }),
          ]
          let _ = aura::disclosure_group_node(
            c,
            dg_items,
            fn() -> Array[String] {
              let cur = dg_open.get()
              if cur == "" { [] } else { [cur] }
            },
            fn(k : String) -> Unit {
              if dg_open.get() == k { dg_open.set("") } else { dg_open.set(k) }
            },
          )
        },
        tag="Disclosure",
      )
    },
  )
}

// ============================================================================
// Category 5: Overlays (7 Components)
// ============================================================================

fn section_overlays(parent : view::View, state : ApStudioState, overlays_open~ : Bool = false) -> Unit {
  ap_section_intro(
    parent,
    "Overlays & Dialogs",
    "Interactive modals, destructive alert dialogs, edge drawers, bottom sheets, anchored popovers, dropdown menus, and tooltips.",
    "7 Components",
  )

  let modal_open = signals::signal(false)
  let alert_open = signals::signal(false)
  let drawer_open = signals::signal(false)
  let sheet_open = signals::signal(false)
  let popover_open = signals::signal(overlays_open)
  let dropdown_open = signals::signal(overlays_open)
  let last_action = state.ov_last_action
  let nav_tab = state.ov_nav_tab

  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      // Card 1: Modal, AlertDialog, Drawer & Sheet launchers
      let _ = ap_demo_card(
        col,
        "Modal, AlertDialog, Drawer & Sheet",
        "Click any trigger to launch its live overlay with focus trap and backdrop scrim.",
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .wraps(view::Live::Is(Some(10.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(10.0))
            let _ = aura::button_node(row, view::Live::Is("Open Modal"), variant=aura::AuraButtonVariant::Primary, on_press=fn() -> Unit { modal_open.set(true) })
            let _ = aura::button_node(row, view::Live::Is("Alert Dialog"), variant=aura::AuraButtonVariant::DangerSoft, on_press=fn() -> Unit { alert_open.set(true) })
            let _ = aura::button_node(row, view::Live::Is("Open Drawer"), variant=aura::AuraButtonVariant::Secondary, on_press=fn() -> Unit { drawer_open.set(true) })
            let _ = aura::button_node(row, view::Live::Is("Bottom Sheet"), variant=aura::AuraButtonVariant::Outline, on_press=fn() -> Unit { sheet_open.set(true) })
          })
          let _ = c.box(fn(chip_row : view::View) -> Unit {
            let _ = chip_row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(chip_row) }))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
            let _ = aura::chip_node(
              chip_row,
              view::Live::By(fn() -> String { "Last overlay action: \{last_action.get()}" }),
              variant=aura::AuraChipVariant::Soft,
              color=aura::AuraStatusColor::Accent,
              size=aura::AuraControlSize::Sm,
            )
          })
        },
        tag="Dialogs",
      )

      // Card 2: Popover & Tooltip (aligned flush with card body)
      let _ = ap_demo_card(
        col,
        "Popover & Tooltip",
        "Anchored floating surfaces with directional arrow and dark-mode hairline rim.",
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(stage : view::View) -> Unit {
            let _ = stage
              .fills_across(view::Live::Is(true))
              .min_height(view::Live::Is(Some(if overlays_open { 240.0 } else { 80.0 })))
              .padding(view::Live::Is((0.0, 24.0, 0.0, 8.0)))
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(stage) }))
              .wraps(view::Live::Is(Some(12.0)))
              .lies_along(view::Live::Is(view::Lies::Start))
              .lines_up(view::Live::Is(Some(view::Along::Start)))
              .gap(view::Live::Is(16.0))

            let _ = aura::popover_node(
              stage,
              "Layer Popover",
              fn() -> Bool { popover_open.get() },
              fn(b : Bool) -> Unit { popover_open.set(b) },
              fn(panel : view::View) -> Unit {
                let _ = panel.box(fn(bv : view::View) -> Unit {
                  let _ = bv
                    .words(view::Live::Is("Configure canvas dimensions and snap-to-grid precision."), look=ap_words(13.0, 400, 19.0, wrap=true))
                    .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
                })
                let _ = panel.box(fn(act : view::View) -> Unit {
                  let _ = act.row(view::Live::Is(true)).gap(view::Live::Is(8.0)).margin(view::Live::Is((0.0, 8.0, 0.0, 0.0)))
                  let _ = aura::button_node(act, view::Live::Is("Apply"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit {
                    last_action.set("Popover Applied")
                    popover_open.set(false)
                  })
                  let _ = aura::button_node(act, view::Live::Is("Close"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit {
                    popover_open.set(false)
                  })
                })
              },
              heading="Layer Settings",
              trigger_variant=aura::AuraButtonVariant::Secondary,
              placement=headless::Placement::BelowStart,
              gap=8.0,
              width=260.0,
              show_arrow=true,
            )

            let _ = aura::tooltip_node(
              stage,
              view::Live::Is("Instant GPU-rendered tooltip"),
              fn(h : view::View) -> view::View {
                aura::button_node(h, view::Live::Is("Hover Tooltip"), variant=aura::AuraButtonVariant::Outline)
              },
              placement=headless::Placement::AboveCenter,
              gap=6.0,
              show_arrow=true,
              force_open=overlays_open,
            )
          })
        },
        tag="Anchored",
      )
    },
    fn(col : view::View) -> Unit {
      // Card 3: Dropdown Menu + Navigation Summary
      let _ = ap_demo_card(
        col,
        "Dropdown Menu",
        "Action menu with keyboard navigation, sections, and danger items.",
        fn(c : view::View) -> Unit {
          let _ = c.box(fn(stage : view::View) -> Unit {
            let _ = stage
              .fills_across(view::Live::Is(true))
              .min_height(view::Live::Is(Some(if overlays_open { 240.0 } else { 80.0 })))
              .padding(view::Live::Is((0.0, 8.0, 0.0, 8.0)))
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(stage) }))
              .lines_up(view::Live::Is(Some(view::Along::Start)))
            let _ = aura::dropdown_node(
              stage,
              "Actions Menu",
              fn() -> Bool { dropdown_open.get() },
              fn(b : Bool) -> Unit { dropdown_open.set(b) },
              fn(mv : view::View, menu : headless::Menu) -> Unit {
                let _ = aura::menu_section_node(mv, menu, "Workspace", fn(sv : view::View) -> Unit {
                  let _ = aura::menu_item_node(sv, menu, "New Document", on_action=fn() -> Unit { last_action.set("New Document") })
                  let _ = aura::menu_item_node(sv, menu, "Duplicate Branch", on_action=fn() -> Unit { last_action.set("Duplicate Branch") })
                  let _ = aura::menu_item_node(sv, menu, "Export Bundle", on_action=fn() -> Unit { last_action.set("Export Bundle") })
                })
                let _ = aura::menu_item_node(mv, menu, "Delete Workspace", variant=aura::AuraItemVariant::Danger, on_action=fn() -> Unit { last_action.set("Delete Workspace") })
              },
              trigger_variant=aura::AuraButtonVariant::Secondary,
              placement=headless::Placement::BelowStart,
              gap=8.0,
              min_width=220.0,
            )
          })
        },
        tag="Dropdown",
      )

      // Card 4: Inline Navigation quick preview (Tabs + Breadcrumbs)
      let _ = ap_demo_card(
        col,
        "Navigation Context",
        "Inline Breadcrumbs and Tabs paired alongside active overlays.",
        fn(c : view::View) -> Unit {
          let bc = [
            aura::AuraBreadcrumbItem::new("Studio"),
            aura::AuraBreadcrumbItem::new("Overlays"),
            aura::AuraBreadcrumbItem::new("Live Layer"),
          ]
          let _ = aura::breadcrumbs_node(c, bc)
          let nav_items = [
            aura::AuraTabItem::new("modal", "Modal", fn(_pv : view::View) -> Unit { () }),
            aura::AuraTabItem::new("drawer", "Drawer", fn(_pv : view::View) -> Unit { () }),
            aura::AuraTabItem::new("popover", "Popover", fn(_pv : view::View) -> Unit { () }),
          ]
          let _ = aura::tabs_node(
            c,
            nav_items,
            fn() -> String { nav_tab.get() },
            fn(k : String) -> Unit { nav_tab.set(k) },
            variant=aura::AuraTabsVariant::Primary,
            show_panels=false,
          )
        },
        tag="Context",
      )
    },
  )

  // Live overlay hosts mounted at section level
  let _ = aura::modal_node(
    parent,
    fn() -> Bool { modal_open.get() },
    fn() -> Unit { modal_open.set(false) },
    heading="Welcome to Aura Studio",
    width=360.0,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(view::Live::Is("This modal traps focus, dims the backdrop, and closes on Escape or button action."), look=ap_words(14.0, 400, 20.0, wrap=true))
        .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
    },
    footer=fn(fv : view::View) -> Unit {
      let _ = aura::button_node(fv, view::Live::Is("Cancel"), variant=aura::AuraButtonVariant::Tertiary, on_press=fn() -> Unit { modal_open.set(false) })
      let _ = aura::button_node(fv, view::Live::Is("Confirm"), variant=aura::AuraButtonVariant::Primary, on_press=fn() -> Unit {
        last_action.set("Modal Confirmed")
        modal_open.set(false)
      })
    },
  )

  let _ = aura::alert_dialog_node(
    parent,
    fn() -> Bool { alert_open.get() },
    fn() -> Unit { alert_open.set(false) },
    "Archive release artifacts?",
    "Archived builds will move to cold storage and cannot be restored from cache.",
    icon_variant=aura::AuraAlertIconVariant::Danger,
    width=360.0,
    footer=fn(fv : view::View) -> Unit {
      let _ = aura::button_node(fv, view::Live::Is("Keep"), variant=aura::AuraButtonVariant::Tertiary, on_press=fn() -> Unit { alert_open.set(false) })
      let _ = aura::button_node(fv, view::Live::Is("Archive"), variant=aura::AuraButtonVariant::Danger, on_press=fn() -> Unit {
        last_action.set("AlertDialog Archived")
        alert_open.set(false)
      })
    },
  )

  let _ = aura::drawer_node(
    parent,
    fn() -> Bool { drawer_open.get() },
    fn() -> Unit { drawer_open.set(false) },
    heading="Inspector Drawer",
    placement=aura::AuraDrawerPlacement::Right,
    panel_width=320.0,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(view::Live::Is("Slide-over side drawer anchored to the trailing edge with reactive theme tokens."), look=ap_words(14.0, 400, 20.0, wrap=true))
        .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
    },
    footer=fn(fv : view::View) -> Unit {
      let _ = aura::button_node(fv, view::Live::Is("Close"), variant=aura::AuraButtonVariant::Secondary, on_press=fn() -> Unit { drawer_open.set(false) })
      let _ = aura::button_node(fv, view::Live::Is("Save"), variant=aura::AuraButtonVariant::Primary, on_press=fn() -> Unit {
        last_action.set("Drawer Saved")
        drawer_open.set(false)
      })
    },
  )

  let _ = aura::sheet_node(
    parent,
    fn() -> Bool { sheet_open.get() },
    fn() -> Unit { sheet_open.set(false) },
    heading="Quick Actions Sheet",
    placement=aura::AuraDrawerPlacement::Bottom,
    show_handle=true,
    body=fn(bv : view::View) -> Unit {
      let _ = bv
        .words(view::Live::Is("Bottom sheet overlay with drag handle and full-width action footer."), look=ap_words(14.0, 400, 20.0, wrap=true))
        .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(bv).palette.muted }))
    },
    footer=fn(fv : view::View) -> Unit {
      let b = aura::button_node(fv, view::Live::Is("Done"), variant=aura::AuraButtonVariant::Primary, full_width=true, on_press=fn() -> Unit {
        last_action.set("Sheet Closed")
        sheet_open.set(false)
      })
      let _ = b.grow(view::Live::Is(1.0))
    },
  )
}
