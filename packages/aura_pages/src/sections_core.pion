// Aura Studio — Category 0 (Overview & Live Theme Playground) and Category 1 (Buttons, Actions, Cards & Typography).

import "aura"
import "color"
import "signals"
import "ui"
import "view"

fn ap_abs_f(x : Double) -> Double {
  if x < 0.0 { -x } else { x }
}

/// Derive the matching swatch hex from the live `AuraConfig.accent` OKLCH value.
fn ap_swatch_hex_for_accent(acc : color::Oklch) -> String {
  if ap_abs_f(acc.h - 152.0) < 2.0 {
    "#17C964"
  } else if ap_abs_f(acc.h - 75.0) < 2.0 {
    "#F5A524"
  } else if ap_abs_f(acc.h - 15.0) < 2.0 {
    "#F31260"
  } else if ap_abs_f(acc.h - 305.0) < 2.0 {
    "#7828C8"
  } else if ap_abs_f(acc.h - 232.0) < 2.0 {
    "#0EA5E9"
  } else {
    "#0485F7"
  }
}

fn ap_mount_dir_card(
  parent : view::View,
  target_id : Int,
  title : String,
  desc : String,
  vari : aura::AuraSurfaceVariant,
  active_cat : signals::Signal[Int],
) -> Unit {
  let _ = parent.box(fn(slot : view::View) -> Unit {
    let _ = slot
      .fills_across(view::Live::By(fn() -> Bool { !aura::aura_is_sm(slot) }))
      .grow(view::Live::By(fn() -> Double { if aura::aura_is_sm(slot) { 1.0 } else { 0.0 } }))
      .shrink(view::Live::By(fn() -> Double { if aura::aura_is_sm(slot) { 1.0 } else { 0.0 } }))
      .basis(view::Live::By(fn() -> Option[Double] { if aura::aura_is_sm(slot) { Some(0.0) } else { None } }))
      .min_width(view::Live::Is(Some(0.0)))
    let s = aura::surface_node(
      slot,
      variant=vari,
      radius=16.0,
      pad=14.0,
      gap=8.0,
      content=fn(inner : view::View) -> Unit {
        let _ = inner.lines_up(view::Live::By(fn() -> Option[view::Along] {
          Some(if aura::aura_rtl(inner) { view::Along::End } else { view::Along::Start })
        }))
        let _ = inner.box(fn(t : view::View) -> Unit {
          let _ = t
            .fills_across(view::Live::Is(true))
            .words(view::Live::Is(title), look=ap_words(13.5, 600, 18.0))
            .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(13.5, 600, 18.0).with_rtl(aura::aura_rtl(t)) }))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(t).palette.foreground }))
        })
        let _ = inner.box(fn(d : view::View) -> Unit {
          let _ = d
            .fills_across(view::Live::Is(true))
            .words(view::Live::Is(desc), look=ap_words(12.0, 400, 17.0, wrap=true))
            .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(12.0, 400, 17.0, wrap=true).with_rtl(aura::aura_rtl(d)) }))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(d).palette.muted }))
        })
        let _ = aura::button_node(
          inner,
          view::Live::Is("Open"),
          variant=aura::AuraButtonVariant::Secondary,
          size=aura::AuraButtonSize::Sm,
          on_press=fn() -> Unit { active_cat.set(target_id) },
        )
      },
    )
    let _ = s.fills_across(view::Live::Is(true))
  })
}

// ============================================================================
// Category 0: Overview & Live Theme Playground
// ============================================================================

fn section_overview(
  parent : view::View,
  cfg : signals::Signal[aura::AuraConfig],
  active_cat : signals::Signal[Int],
  toast_queue : aura::ToastQueue,
) -> Unit {
  // Hero card
  let hero = aura::card_node(
    parent,
    variant=aura::AuraSurfaceVariant::Default,
    radius=24.0,
    pad=24.0,
    gap=16.0,
    content=fn(card : view::View) -> Unit {
      let _ = card.box(fn(top_row : view::View) -> Unit {
        let _ = top_row
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(top_row) }))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .wraps(view::Live::Is(Some(8.0)))
          .gap(view::Live::Is(10.0))
        let _ = top_row.box(fn(tags : view::View) -> Unit {
          let _ = tags
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(tags) }))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .wraps(view::Live::Is(Some(6.0)))
            .shrink(view::Live::Is(1.0))
            .min_width(view::Live::Is(Some(0.0)))
            .gap(view::Live::Is(8.0))
          let _ = aura::chip_node(tags, view::Live::Is("86 Components"), variant=aura::AuraChipVariant::Primary, color=aura::AuraStatusColor::Accent, size=aura::AuraControlSize::Sm)
          let _ = aura::chip_node(tags, view::Live::Is("OKLCH Palette"), variant=aura::AuraChipVariant::Soft, color=aura::AuraStatusColor::Success, size=aura::AuraControlSize::Sm)
          let _ = aura::chip_node(
            tags,
            view::Live::By(fn() -> String {
              if cfg.get().corner_circular { "Circular Corners" } else { "Smooth Corners" }
            }),
            variant=aura::AuraChipVariant::Soft,
            color=aura::AuraStatusColor::Warning,
            size=aura::AuraControlSize::Sm,
          )
          let _ = aura::chip_node(tags, view::Live::Is("BiDi & RTL"), variant=aura::AuraChipVariant::Secondary, color=aura::AuraStatusColor::Default, size=aura::AuraControlSize::Sm)
        })
        let _ = aura::avatar_group_node(
          top_row,
          [
            aura::AuraAvatarItem::new("AR"),
            aura::AuraAvatarItem::new("JC"),
            aura::AuraAvatarItem::new("SP"),
            aura::AuraAvatarItem::new("ME"),
          ],
          max=3,
        )
      })

      let _ = card.box(fn(h1_wrap : view::View) -> Unit {
        let _ = h1_wrap
          .fills_across(view::Live::Is(true))
          .lines_up(view::Live::By(fn() -> Option[view::Along] {
            Some(if aura::aura_rtl(h1_wrap) { view::Along::End } else { view::Along::Start })
          }))
        let _ = aura::typography_node(h1_wrap, view::Live::Is("Invar Aura Design System"), kind=aura::AuraTypographyType::H1)
      })
      let _ = card.box(fn(desc : view::View) -> Unit {
        let _ = desc
          .fills_across(view::Live::Is(true))
          .words(
            view::Live::Is("A pure-Pion, fine-grained reactive GPU component library featuring 86 accessible compound controls, OKLCH semantic tokens, continuous smooth corners, and full RTL mirroring."),
            look=ap_words(14.0, 400, 21.0, wrap=true),
          )
          .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(14.0, 400, 21.0, wrap=true).with_rtl(aura::aura_rtl(desc)) }))
          .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(desc).palette.muted }))
      })

      let _ = card.box(fn(actions : view::View) -> Unit {
        let _ = actions
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(actions) }))
          .fills_across(view::Live::Is(true))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .wraps(view::Live::Is(Some(8.0)))
          .gap(view::Live::Is(10.0))
        let _ = aura::button_node(
          actions,
          view::Live::Is("Explore Inputs"),
          variant=aura::AuraButtonVariant::Primary,
          on_press=fn() -> Unit { active_cat.set(2) },
        )
        let _ = aura::button_node(
          actions,
          view::Live::Is("Open Overlays"),
          variant=aura::AuraButtonVariant::Secondary,
          on_press=fn() -> Unit { active_cat.set(5) },
        )
        let _ = aura::button_node(
          actions,
          view::Live::Is("Data Table & Pickers"),
          variant=aura::AuraButtonVariant::Outline,
          on_press=fn() -> Unit { active_cat.set(6) },
        )
        let _ = aura::button_node(
          actions,
          view::Live::Is("Fire Toast"),
          variant=aura::AuraButtonVariant::Tertiary,
          on_press=fn() -> Unit {
            toast_queue.push(
              aura::AuraToastData::new(
                "overview-ping",
                "Welcome to Invar Aura",
                description="All 86 components are live and interactive.",
                variant=aura::AuraToastVariant::Accent,
              ),
            )
          },
        )
      })
    },
  )
  let _ = hero.fills_across(view::Live::Is(true))

  // Two-column playground row: Live Theme Controls + System Telemetry
  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Live Theme Controls",
        "Mutate AuraConfig in real time across the entire studio.",
        fn(c : view::View) -> Unit {
          ap_sub_label(c, "Accent Swatch (OKLCH)")
          let swatches : Array[String] = ["#0485F7", "#17C964", "#F5A524", "#F31260", "#7828C8", "#0EA5E9"]
          let _ = aura::color_swatch_picker_node(
            c,
            swatches,
            fn() -> Option[String] { Some(ap_swatch_hex_for_accent(cfg.get().accent)) },
            fn(hex : String) -> Unit {
              let next_acc = if hex == "#17C964" {
                color::Oklch::new(0.68, 0.19, 152.0)
              } else if hex == "#F5A524" {
                color::Oklch::new(0.75, 0.16, 75.0)
              } else if hex == "#F31260" {
                color::Oklch::new(0.60, 0.23, 15.0)
              } else if hex == "#7828C8" {
                color::Oklch::new(0.55, 0.22, 305.0)
              } else if hex == "#0EA5E9" {
                color::Oklch::new(0.67, 0.16, 232.0)
              } else {
                aura::aura_default_accent()
              }
              let cur = cfg.get()
              cfg.set(aura::AuraConfig::{ ..cur, accent: next_acc })
            },
            size=aura::AuraColorSwatchSize::Md,
            gap=10.0,
          )
          let _ = aura::separator_node(c)
          let sg_root = aura::switch_group_node(
            c,
            label=view::Live::Is("Appearance Flags"),
            orientation=aura::AuraOrientation::Horizontal,
            gap=10.0,
            item_gap=14.0,
            content=fn(sg : view::View) -> Unit {
              let _ = sg
                .fills_across(view::Live::Is(true))
                .wraps(view::Live::Is(Some(10.0)))
                .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(sg) }))
              let _ = aura::switch_node(
                sg,
                view::Live::By(fn() -> Bool { cfg.get().dark }),
                fn(on : Bool) -> Unit { cfg.set(aura::AuraConfig::{ ..cfg.get(), dark: on }) },
                label=view::Live::Is("Dark"),
                size=aura::AuraSwitchSize::Sm,
              )
              let _ = aura::switch_node(
                sg,
                view::Live::By(fn() -> Bool { cfg.get().vibrant }),
                fn(on : Bool) -> Unit { cfg.set(aura::AuraConfig::{ ..cfg.get(), vibrant: on }) },
                label=view::Live::Is("Vibrant"),
                size=aura::AuraSwitchSize::Sm,
              )
              let _ = aura::switch_node(
                sg,
                view::Live::By(fn() -> Bool { cfg.get().rtl }),
                fn(on : Bool) -> Unit { cfg.set(aura::AuraConfig::{ ..cfg.get(), rtl: on }) },
                label=view::Live::Is("RTL"),
                size=aura::AuraSwitchSize::Sm,
              )
              let _ = aura::switch_node(
                sg,
                view::Live::By(fn() -> Bool { !cfg.get().corner_circular }),
                fn(on : Bool) -> Unit { cfg.set(aura::AuraConfig::{ ..cfg.get(), corner_circular: !on }) },
                label=view::Live::Is("Smooth"),
                size=aura::AuraSwitchSize::Sm,
              )
            },
          )
          let _ = sg_root
            .fills_across(view::Live::Is(true))
            .lines_up(view::Live::By(fn() -> Option[view::Along] {
              Some(if aura::aura_rtl(sg_root) { view::Along::End } else { view::Along::Start })
            }))
        },
        tag="Reactive",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Surface & Status Preview",
        "Layered surfaces, progress meters, and live indicators.",
        fn(c : view::View) -> Unit {
          let _ = aura::alert_node(
            c,
            status=aura::AuraAlertStatus::Success,
            title=view::Live::Is("All 86 Aura components active"),
            description=view::Live::By(fn() -> String {
              if cfg.get().corner_circular {
                "Zero liquid glass, circular corners enabled."
              } else {
                "Zero liquid glass, continuous smooth corners enabled."
              }
            }),
          )
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .fills_across(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(16.0))
            let _ = row.box(fn(pb : view::View) -> Unit {
              let _ = pb.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = aura::progress_bar_node(
                pb,
                fn() -> Option[Double] { Some(86.0) },
                label="Catalog Coverage",
                color=aura::AuraStatusColor::Accent,
              )
            })
            let _ = aura::progress_circle_node(
              row,
              fn() -> Option[Double] { Some(100.0) },
              size=aura::AuraControlSize::Md,
              color=aura::AuraStatusColor::Success,
            )
            let _ = aura::badge_anchor_node(row, content=fn(anc : view::View) -> Unit {
              let _ = aura::avatar_node(anc, fallback=view::Live::Is("AU"))
              let _ = aura::badge_node(
                anc,
                label=view::Live::Is("86"),
                variant=aura::AuraBadgeVariant::Primary,
                color=aura::AuraStatusColor::Accent,
                size=aura::AuraControlSize::Sm,
                placement=aura::AuraBadgePlacement::TopRight,
              )
            })
          })
          let _ = c.box(fn(row2 : view::View) -> Unit {
            let _ = row2
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row2) }))
              .fills_across(view::Live::Is(true))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(14.0))
            let _ = row2.box(fn(m_wrap : view::View) -> Unit {
              let _ = m_wrap.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0)))
              let _ = aura::meter_node(m_wrap, view::Live::Is(94.0), label=view::Live::Is("GPU Frame Budget"), color=aura::AuraMeterColor::Success)
            })
            let _ = aura::spinner_node(row2, size=aura::AuraSpinnerSize::Md, color=aura::AuraSpinnerColor::Accent)
          })
        },
        tag="Status",
      )
    },
  )

  // Category quick-jump surface hierarchy (4 cols >= 1024pt, 2 cols 640..1023pt, 1 col < 640pt)
  let _ = ap_demo_card(
    parent,
    "Surface Hierarchy & Category Directory",
    "Nested Default, Secondary, and Tertiary Aura surfaces with quick navigation.",
    fn(c : view::View) -> Unit {
      let _ = c.box(fn(grid_host : view::View) -> Unit {
        let _ = grid_host.fills_across(view::Live::Is(true))
        let _ = grid_host.pick(
          fn() -> Int {
            if ap_is_lg(grid_host) { 4 } else if aura::aura_is_sm(grid_host) { 2 } else { 1 }
          },
          fn(grid : view::View, cols : Int) -> Unit {
            let _ = grid.fills_across(view::Live::Is(true)).gap(view::Live::Is(12.0))
            if cols == 4 {
              let _ = grid
                .row(view::Live::Is(true))
                .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(grid) }))
              ap_mount_dir_card(grid, 1, "Buttons & Actions", "15 actions, cards & type", aura::AuraSurfaceVariant::Secondary, active_cat)
              ap_mount_dir_card(grid, 2, "Inputs & Forms", "14 fields, OTP & forms", aura::AuraSurfaceVariant::Tertiary, active_cat)
              ap_mount_dir_card(grid, 5, "Overlays & Dialogs", "7 modals, drawers & menus", aura::AuraSurfaceVariant::Secondary, active_cat)
              ap_mount_dir_card(grid, 7, "DateTime & Color", "24 calendars, color & toasts", aura::AuraSurfaceVariant::Tertiary, active_cat)
            } else if cols == 2 {
              let _ = grid.box(fn(pair1 : view::View) -> Unit {
                let _ = pair1
                  .row(view::Live::Is(true))
                  .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(pair1) }))
                  .fills_across(view::Live::Is(true))
                  .gap(view::Live::Is(12.0))
                ap_mount_dir_card(pair1, 1, "Buttons & Actions", "15 actions, cards & type", aura::AuraSurfaceVariant::Secondary, active_cat)
                ap_mount_dir_card(pair1, 2, "Inputs & Forms", "14 fields, OTP & forms", aura::AuraSurfaceVariant::Tertiary, active_cat)
              })
              let _ = grid.box(fn(pair2 : view::View) -> Unit {
                let _ = pair2
                  .row(view::Live::Is(true))
                  .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(pair2) }))
                  .fills_across(view::Live::Is(true))
                  .gap(view::Live::Is(12.0))
                ap_mount_dir_card(pair2, 5, "Overlays & Dialogs", "7 modals, drawers & menus", aura::AuraSurfaceVariant::Secondary, active_cat)
                ap_mount_dir_card(pair2, 7, "DateTime & Color", "24 calendars, color & toasts", aura::AuraSurfaceVariant::Tertiary, active_cat)
              })
            } else {
              ap_mount_dir_card(grid, 1, "Buttons & Actions", "15 actions, cards & type", aura::AuraSurfaceVariant::Secondary, active_cat)
              ap_mount_dir_card(grid, 2, "Inputs & Forms", "14 fields, OTP & forms", aura::AuraSurfaceVariant::Tertiary, active_cat)
              ap_mount_dir_card(grid, 5, "Overlays & Dialogs", "7 modals, drawers & menus", aura::AuraSurfaceVariant::Secondary, active_cat)
              ap_mount_dir_card(grid, 7, "DateTime & Color", "24 calendars, color & toasts", aura::AuraSurfaceVariant::Tertiary, active_cat)
            }
          },
          at_once=true,
        )
      })
    },
    tag="Surfaces",
  )
}

// ============================================================================
// Category 1: Buttons, Actions, Cards, Surfaces & Typography
// ============================================================================

fn section_buttons(parent : view::View, toast_queue : aura::ToastQueue, state : ApStudioState) -> Unit {
  ap_section_intro(
    parent,
    "Buttons & Actions",
    "Interactive buttons, toggle groups, toolbars, cards, nested surfaces, typography scale, scroll shadows, and monochrome icons.",
    "15 Components",
  )

  let clicks = state.btn_clicks
  let bold_on = state.btn_bold_on
  let italic_on = state.btn_italic_on
  let align = state.btn_align
  let toolbar_status = state.btn_toolbar_status
  let close_count = state.btn_close_count

  // Card 1: Button Variants & Sizes
  let _ = ap_demo_card(
    parent,
    "Button Variants & Sizes",
    "All 7 semantic variants, 3 sizes, disabled, icon-only, and CloseButton.",
    fn(c : view::View) -> Unit {
      let _ = c.box(fn(row : view::View) -> Unit {
        let _ = row
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
          .wraps(view::Live::Is(Some(8.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(10.0))
        let variants : Array[(String, aura::AuraButtonVariant)] = [
          ("Primary", aura::AuraButtonVariant::Primary),
          ("Secondary", aura::AuraButtonVariant::Secondary),
          ("Tertiary", aura::AuraButtonVariant::Tertiary),
          ("Ghost", aura::AuraButtonVariant::Ghost),
          ("Outline", aura::AuraButtonVariant::Outline),
          ("Danger", aura::AuraButtonVariant::Danger),
          ("Danger Soft", aura::AuraButtonVariant::DangerSoft),
        ]
        for item in variants {
          let (lbl, vari) = item
          let _ = aura::button_node(
            row,
            view::Live::Is(lbl),
            variant=vari,
            on_press=fn() -> Unit { clicks.set(clicks.get() + 1) },
          )
        }
      })

      let _ = c.box(fn(row : view::View) -> Unit {
        let _ = row
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
          .wraps(view::Live::Is(Some(8.0)))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(10.0))
        let _ = aura::button_node(row, view::Live::Is("Small"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit { clicks.set(clicks.get() + 1) })
        let _ = aura::button_node(row, view::Live::Is("Medium"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Md, on_press=fn() -> Unit { clicks.set(clicks.get() + 1) })
        let _ = aura::button_node(row, view::Live::Is("Large"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Lg, on_press=fn() -> Unit { clicks.set(clicks.get() + 1) })
        let _ = aura::button_node(row, view::Live::Is("Disabled"), variant=aura::AuraButtonVariant::Primary, disabled=view::Live::Is(true))
        let _ = aura::button_node(
          row,
          view::Live::Is("Add"),
          variant=aura::AuraButtonVariant::Secondary,
          icon_only=true,
          on_press=fn() -> Unit { clicks.set(clicks.get() + 1) },
          content=fn(inner : view::View) -> Unit {
            let _ = aura::aura_icon_node(inner, aura::AuraIconKind::Plus, size=14.0, ink=fn() -> Int64 { aura::aura_theme(inner).palette.accent_soft_foreground })
          },
        )
        let _ = aura::close_button_node(row, on_press=fn() -> Unit { close_count.set(close_count.get() + 1) })
        let _ = aura::chip_node(
          row,
          view::Live::By(fn() -> String { "Clicks: \{clicks.get()} · Close: \{close_count.get()}" }),
          variant=aura::AuraChipVariant::Soft,
          color=aura::AuraStatusColor::Accent,
          size=aura::AuraControlSize::Sm,
        )
      })
    },
    tag="Button + CloseButton",
  )

  // Row 2: ButtonGroup & ToggleButtonGroup | Toolbar, Link & Kbd
  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "ButtonGroup & ToggleButtonGroup",
        "Joined action pills and single/multi toggle controls.",
        fn(c : view::View) -> Unit {
          let _ = aura::button_group_node(
            c,
            label="View Mode",
            variant=aura::AuraButtonVariant::Secondary,
            content=fn(g : view::View) -> Unit {
              let _ = aura::button_group_item_node(g, view::Live::Is("Left"), 0, 3, on_press=fn() -> Unit { align.set("L") })
              let _ = aura::button_group_separator_node(g)
              let _ = aura::button_group_item_node(g, view::Live::Is("Center"), 1, 3, on_press=fn() -> Unit { align.set("C") })
              let _ = aura::button_group_separator_node(g)
              let _ = aura::button_group_item_node(g, view::Live::Is("Right"), 2, 3, on_press=fn() -> Unit { align.set("R") })
            },
          )
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .wraps(view::Live::Is(Some(8.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(10.0))
            let _ = aura::toggle_button_node(row, view::Live::Is("Bold"), fn() -> Bool { bold_on.get() }, on_change=fn(v : Bool) -> Unit { bold_on.set(v) })
            let _ = aura::toggle_button_node(row, view::Live::Is("Italic"), fn() -> Bool { italic_on.get() }, on_change=fn(v : Bool) -> Unit { italic_on.set(v) })
            let _ = aura::toggle_button_group_node(
              row,
              view::Live::Is("Alignment"),
              fn(k : String) -> Bool { align.get() == k },
              fn(k : String, _on : Bool) -> Unit { align.set(k) },
              fn(g : view::View, grp : aura::AuraToggleGroup[String]) -> Unit {
                let _ = grp.item(g, "L", view::Live::Is("L"), index=0, total=3)
                let _ = aura::toggle_button_group_separator_node(g)
                let _ = grp.item(g, "C", view::Live::Is("C"), index=1, total=3)
                let _ = aura::toggle_button_group_separator_node(g)
                let _ = grp.item(g, "R", view::Live::Is("R"), index=2, total=3)
              },
            )
          })
        },
        tag="Groups",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Toolbar, Link & Kbd",
        "Roving-focus toolbar, accessible links, and keyboard shortcut badges.",
        fn(c : view::View) -> Unit {
          let _ = aura::toolbar_node(c, label=view::Live::Is("Editor actions"), gap=8.0, content=fn(bar : view::View, tb : aura::AuraToolbar) -> Unit {
            let _ = tb.button(bar, view::Live::Is("Cut"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit { toolbar_status.set("Cut") })
            let _ = tb.button(bar, view::Live::Is("Copy"), variant=aura::AuraButtonVariant::Secondary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit { toolbar_status.set("Copy") })
            let _ = tb.separator(bar, span=16.0)
            let _ = tb.button(bar, view::Live::Is("Paste"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm, on_press=fn() -> Unit { toolbar_status.set("Paste") })
          })
          let _ = c.box(fn(row : view::View) -> Unit {
            let _ = row
              .row(view::Live::Is(true))
              .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(row) }))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .wraps(view::Live::Is(Some(8.0)))
              .gap(view::Live::Is(14.0))
            let _ = aura::link_node(row, view::Live::Is("Aura Documentation"), external=true, on_press=fn() -> Unit {
              toast_queue.push(aura::AuraToastData::new("docs-link", "Opened Aura Docs", variant=aura::AuraToastVariant::Default))
            })
            let _ = aura::kbd_node(row, content=fn(kv : view::View) -> Unit {
              let _ = aura::kbd_abbr_node(kv, aura::AuraKbdKey::Command)
              let _ = aura::kbd_content_node(kv, view::Live::Is("K"))
            })
            let _ = aura::kbd_node(row, content=fn(kv : view::View) -> Unit {
              let _ = aura::kbd_abbr_node(kv, aura::AuraKbdKey::Shift)
              let _ = aura::kbd_abbr_node(kv, aura::AuraKbdKey::Command)
              let _ = aura::kbd_content_node(kv, view::Live::Is("P"))
            })
            let _ = aura::chip_node(
              row,
              view::Live::By(fn() -> String { "Action: \{toolbar_status.get()}" }),
              variant=aura::AuraChipVariant::Soft,
              color=aura::AuraStatusColor::Default,
              size=aura::AuraControlSize::Sm,
            )
          })
        },
        tag="Actions",
      )
    },
  )

  // Row 3: Card + Header + ScrollShadow + EmptyState | Typography & 15 Icons
  ap_two_col(
    parent,
    fn(col : view::View) -> Unit {
      let sc_state = view::Scroll::new()
      let _ = ap_demo_card(
        col,
        "Card, Header, ScrollShadow & EmptyState",
        "Structured card layout with fade-masked scrolling and empty placeholder.",
        fn(c : view::View) -> Unit {
          let _ = aura::card_node(c, variant=aura::AuraSurfaceVariant::Secondary, radius=16.0, pad=14.0, gap=10.0, content=fn(ic : view::View) -> Unit {
            let _ = aura::card_header_node(ic, content=fn(h : view::View) -> Unit {
              let _ = aura::card_title_node(h, view::Live::Is("Release Pipeline"))
              let _ = aura::card_description_node(h, view::Live::Is("All checks passed on main."))
            })
            let _ = aura::card_content_node(ic, content=fn(b : view::View) -> Unit {
              let _ = aura::header_node(b, view::Live::Is("Build Log"))
              let _ = aura::separator_node(b)
              let _ = b.box(fn(sh_box : view::View) -> Unit {
                let _ = sh_box.fills_across(view::Live::Is(true)).height(view::Live::Is(Some(80.0)))
                let _ = aura::scroll_shadow_node(sh_box, sc_state, vertical=true, shadow_size=14.0, content=fn(sh : view::View) -> Unit {
                  let _ = ui::scroll_box(
                    sh,
                    fn(lines_col : view::View) -> Unit {
                      let _ = lines_col.padding(view::Live::Is((6.0, 6.0, 6.0, 6.0))).gap(view::Live::Is(3.0))
                      let lines = [
                        "01. Verified 86 Aura component exports",
                        "02. OKLCH token palette resolved cleanly",
                        "03. Zero liquid glass audit passed",
                        "04. Smooth corner squircle shader ready",
                        "05. Offscreen 2x exhibition snapshots verified",
                      ]
                      for ln in lines {
                        let _ = lines_col.box(fn(lv : view::View) -> Unit {
                          let _ = lv.words(view::Live::Is(ln), look=ap_words(12.0, 400, 16.0)).ink(view::Live::By(fn() -> Int64 { aura::aura_theme(lv).palette.muted }))
                        })
                      }
                    },
                    scroll=sc_state,
                  )
                })
              })
            })
            let _ = aura::card_footer_node(ic, gap=8.0, content=fn(f : view::View) -> Unit {
              let _ = aura::button_node(f, view::Live::Is("Inspect"), variant=aura::AuraButtonVariant::Tertiary, size=aura::AuraButtonSize::Sm)
              let _ = aura::button_node(f, view::Live::Is("Ship"), variant=aura::AuraButtonVariant::Primary, size=aura::AuraButtonSize::Sm)
            })
          })

          let _ = aura::empty_state_node(c, pad=12.0, gap=4.0, content=fn(es : view::View) -> Unit {
            let _ = es.box(fn(t : view::View) -> Unit {
              let _ = t.words(view::Live::Is("EmptyState: No pending warnings"), look=ap_words(13.0, 500, 18.0)).ink(view::Live::By(fn() -> Int64 { aura::aura_theme(t).palette.muted }))
            })
          })
        },
        tag="Layout",
      )
    },
    fn(col : view::View) -> Unit {
      let _ = ap_demo_card(
        col,
        "Typography Scale & Monochrome Icons",
        "H1–H6, Body, Muted, Code, and all 15 built-in vector glyphs.",
        fn(c : view::View) -> Unit {
          let _ = aura::typography_node(c, view::Live::Is("Heading 1 · Display"), kind=aura::AuraTypographyType::H1)
          let _ = aura::typography_node(c, view::Live::Is("Heading 3 · Section"), kind=aura::AuraTypographyType::H3)
          let _ = aura::typography_node(c, view::Live::Is("Heading 5 · Subhead"), kind=aura::AuraTypographyType::H5)
          let _ = aura::typography_node(c, view::Live::Is("Body text regular 16px with clear hierarchy."), kind=aura::AuraTypographyType::Body)
          let _ = aura::typography_node(c, view::Live::Is("Muted secondary annotation text."), kind=aura::AuraTypographyType::Muted)
          let _ = aura::typography_node(c, view::Live::Is("let cfg = aura::AuraConfig::default()"), kind=aura::AuraTypographyType::Code)
          let _ = aura::separator_node(c)
          ap_sub_label(c, "15 Built-in Vector Icons")
          let _ = c.box(fn(ic_row : view::View) -> Unit {
            let _ = ic_row
              .row(view::Live::Is(true))
              .wraps(view::Live::Is(Some(10.0)))
              .lines_up(view::Live::Is(Some(view::Along::Middle)))
              .gap(view::Live::Is(12.0))
            let kinds : Array[aura::AuraIconKind] = [
              aura::AuraIconKind::Check,
              aura::AuraIconKind::ChevronDown,
              aura::AuraIconKind::ChevronLeft,
              aura::AuraIconKind::ChevronRight,
              aura::AuraIconKind::ChevronUp,
              aura::AuraIconKind::Xmark,
              aura::AuraIconKind::Magnifier,
              aura::AuraIconKind::CircleInfo,
              aura::AuraIconKind::CircleCheck,
              aura::AuraIconKind::TriangleExclamation,
              aura::AuraIconKind::CircleExclamation,
              aura::AuraIconKind::Eye,
              aura::AuraIconKind::EyeSlash,
              aura::AuraIconKind::Calendar,
              aura::AuraIconKind::Plus,
            ]
            for k in kinds {
              let _ = aura::aura_icon_node(ic_row, k, size=18.0, ink=fn() -> Int64 { aura::aura_theme(ic_row).palette.foreground })
            }
          })
        },
        tag="Type & Icons",
      )
    },
  )
}
