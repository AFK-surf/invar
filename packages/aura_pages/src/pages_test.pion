// Unit & UI craft audit tests for `packages/aura_pages`.
// Covers all 8 categories across 1280x800, 1024x768, 768x800, and 390x844 (LTR & RTL)
// with `aura::assert_aura_ui`, plus full interactive regression tests.

import "aura"
import "halt"
import "signals"
import "ui"
import "view"

let ap_settled : Double = 1000.0

fn ap_assert_eq_int(actual : Int, expected : Int, msg : String) -> Unit {
  if actual != expected {
    halt::saying("aura_pages_test", "\{msg}: expected \{expected}, got \{actual}")
  }
}

fn ap_assert_true(cond : Bool, msg : String) -> Unit {
  if !cond {
    halt::saying("aura_pages_test", msg)
  }
}

fn ap_tap(t : ui::Tester, label : String, role : view::Role) -> Unit {
  match t.get(label, role=role) {
    Some(d) => t.tap(d.x + d.w / 2.0, d.y + d.h / 2.0)
    None => halt::saying("aura_pages_test", "expected node '\{label}' to exist")
  }
}

fn ap_has_words(t : ui::Tester, needle : String) -> Bool {
  for d in t.drawn() {
    let s = d.words
    if s != "" && (s == needle || ap_str_contains_ci(s, needle)) {
      return true
    }
  }
  false
}

fn ap_words_y(t : ui::Tester, needle : String) -> Option[Double] {
  for d in t.drawn() {
    if d.words != "" && (d.words == needle || ap_str_contains_ci(d.words, needle)) {
      return Some(d.y)
    }
  }
  None
}

test "parse_library_cat maps all 8 category slugs, numeric strings, and defaults" {
  ap_assert_eq_int(parse_library_cat(""), 0, "empty")
  ap_assert_eq_int(parse_library_cat("0"), 0, "num 0")
  ap_assert_eq_int(parse_library_cat("1"), 1, "num 1")
  ap_assert_eq_int(parse_library_cat("2"), 2, "num 2")
  ap_assert_eq_int(parse_library_cat("3"), 3, "num 3")
  ap_assert_eq_int(parse_library_cat("4"), 4, "num 4")
  ap_assert_eq_int(parse_library_cat("5"), 5, "num 5")
  ap_assert_eq_int(parse_library_cat("6"), 6, "num 6")
  ap_assert_eq_int(parse_library_cat("7"), 7, "num 7")
  ap_assert_eq_int(parse_library_cat("overview"), 0, "overview")
  ap_assert_eq_int(parse_library_cat("buttons"), 1, "buttons")
  ap_assert_eq_int(parse_library_cat("inputs"), 2, "inputs")
  ap_assert_eq_int(parse_library_cat("selection"), 3, "selection")
  ap_assert_eq_int(parse_library_cat("navigation"), 4, "navigation")
  ap_assert_eq_int(parse_library_cat("overlays"), 5, "overlays")
  ap_assert_eq_int(parse_library_cat("collections"), 6, "collections")
  ap_assert_eq_int(parse_library_cat("composite"), 7, "composite")
  ap_assert_eq_int(parse_library_cat("unknown-slug"), 0, "fallback")
}

test "all 8 categories pass assert_aura_ui in Light, Dark, Vibrant, RTL, and Circular at 1280x800" {
  let configs : Array[(String, aura::AuraConfig)] = [
    ("light", aura::AuraConfig::light()),
    ("dark", aura::AuraConfig::dark()),
    ("vibrant", aura::AuraConfig::dark(vibrant=true)),
    ("rtl", aura::AuraConfig::{ ..aura::AuraConfig::light(), rtl: true }),
    ("circular", aura::AuraConfig::light(corner_circular=true)),
  ]
  for pair in configs {
    let (mode_name, base_cfg) = pair
    let mut cat = 0
    while cat < 8 {
      let cid = cat
      let cfg = signals::signal(base_cfg)
      let t = ui::Tester::tree(fn(root : view::View) -> Unit {
        showcase_page(root, cid, cfg)
      }, width=1280.0, height=800.0)
      t.run_shown(ap_settled)
      aura::assert_aura_ui(t, label="cat-\{cid}-\{mode_name}")
      t.dispose()
      cat += 1
    }
  }
}

test "all 8 categories pass assert_aura_ui at 1024x768, 768x800, and 390x844 (LTR and RTL)" {
  let sizes : Array[(String, Double, Double, Bool)] = [
    ("1024x768-ltr", 1024.0, 768.0, false),
    ("768x800-ltr", 768.0, 800.0, false),
    ("390x844-ltr", 390.0, 844.0, false),
    ("390x844-rtl", 390.0, 844.0, true),
  ]
  for spec in sizes {
    let (sname, w, h, is_rtl) = spec
    let mut cat = 0
    while cat < 8 {
      let cid = cat
      let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::light(), rtl: is_rtl })
      let t = ui::Tester::tree(fn(root : view::View) -> Unit {
        gallery(root, cfg, chrome=true, initial_cat=cid)
      }, width=w, height=h)
      t.run_shown(ap_settled)
      aura::assert_aura_ui(t, label="gallery-\{sname}-cat-\{cid}")
      t.dispose()
      cat += 1
    }
  }
}

test "gallery full shell passes assert_aura_ui in Light, Dark, RTL, and chromeless" {
  set_library_initial_cat(0)
  let modes : Array[(String, aura::AuraConfig, Bool)] = [
    ("gallery-light", aura::AuraConfig::light(), true),
    ("gallery-dark", aura::AuraConfig::dark(), true),
    ("gallery-rtl", aura::AuraConfig::{ ..aura::AuraConfig::light(), rtl: true }, true),
    ("gallery-no-chrome", aura::AuraConfig::light(), false),
  ]
  for item in modes {
    let (lbl, base_cfg, chrome) = item
    let cfg = signals::signal(base_cfg)
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      gallery(root, cfg, chrome=chrome)
    }, width=1280.0, height=800.0)
    t.run_shown(ap_settled)
    aura::assert_aura_ui(t, label=lbl)
    t.dispose()
  }
}

test "390x844 mobile shell: top bar controls in viewport, Light/Toast taps, drawer navigation" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=0)
  }, width=390.0, height=844.0)
  t.run_shown(ap_settled)

  // Every top bar button must fit inside 0..390
  let top_btns = ["Menu", "Light", "Standard", "LTR", "Smooth", "Toast"]
  for lbl in top_btns {
    match t.get(lbl, role=view::Role::Button) {
      Some(d) => {
        ap_assert_true(d.x >= 0.0 && d.x + d.w <= 390.5, "mobile top button '\{lbl}' fits within 390pt (x=\{d.x}, w=\{d.w})")
      }
      None => halt::saying("aura_pages_test", "mobile top button '\{lbl}' missing")
    }
  }

  // Tap Light -> switches to Dark
  ap_tap(t, "Light", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(cfg.get().dark, "mobile Light toggle switched to Dark")

  // Tap Toast -> toast appears
  ap_tap(t, "Toast", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Aura Studio Ready"), "mobile Toast button triggered toast")

  // Tap Menu -> opens drawer, pick Inputs & Forms -> switches category & closes drawer
  ap_tap(t, "Menu", view::Role::Button)
  t.run_shown(ap_settled)
  ap_tap(t, "Inputs & Forms", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Work Email (Primary)"), "mobile drawer switched to Inputs & Forms")

  aura::assert_aura_ui(t, label="mobile-390-interactive")
  t.dispose()
}

test "interactive gallery: sidebar switch, search filter, theme sync, and accent persistence" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=0)
  }, width=1280.0, height=800.0)
  t.run_shown(ap_settled)

  // 1. Toggle Light -> Dark via top chrome toggle button
  ap_assert_true(!cfg.get().dark, "starts in light mode")
  ap_tap(t, "Light", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(cfg.get().dark, "switched to dark mode")

  // 2. Toggle Smooth -> Circular and verify Overview hero chip & alert sync
  ap_assert_true(ap_has_words(t, "Smooth Corners"), "starts showing Smooth Corners chip")
  ap_tap(t, "Smooth", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(cfg.get().corner_circular, "switched to circular corners")
  ap_assert_true(ap_has_words(t, "Circular Corners"), "Hero chip updated to Circular Corners")
  ap_assert_true(ap_has_words(t, "circular corners enabled"), "Alert text updated to circular corners")

  // 3. Pick green accent swatch (#17C964), navigate away and back, verify persistence
  ap_tap(t, "#17C964", view::Role::Option)
  t.run_shown(ap_settled)
  ap_assert_true(ap_swatch_hex_for_accent(cfg.get().accent) == "#17C964", "accent updated to green")
  ap_tap(t, "Buttons & Actions", view::Role::Button)
  t.run_shown(ap_settled)
  ap_tap(t, "Overview", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_swatch_hex_for_accent(cfg.get().accent) == "#17C964", "green accent persisted after round-trip")
  match t.get("#17C964", role=view::Role::Option) {
    Some(d) => ap_assert_true(d.w > 0.0 && d.h > 0.0, "green swatch option rendered after round-trip")
    None => halt::saying("aura_pages_test", "expected #17C964 swatch option")
  }

  // 4. Toggle LTR -> RTL -> LTR
  ap_tap(t, "LTR", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(cfg.get().rtl, "switched to RTL")
  ap_tap(t, "RTL", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!cfg.get().rtl, "back to LTR")

  // 5. Filter categories via sidebar SearchField
  ap_tap(t, "Search", view::Role::TextField)
  t.type_text("overlays")
  t.run_shown(ap_settled)
  ap_assert_true(t.get("Overlays", role=view::Role::Button).is_some(), "Overlays category remains visible after filter")
  ap_assert_true(t.get("Buttons & Actions", role=view::Role::Button).is_none(), "Buttons & Actions filtered out")

  aura::assert_aura_ui(t, label="interactive-gallery-end")
  t.dispose()
}

test "shipping address: Reset restores 128 Horizon Way and empty Save blocks toast" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    showcase_page(root, 2, cfg)
  }, width=1280.0, height=900.0)
  t.run_shown(ap_settled)

  // Focus street input, append "ZZ", then Reset -> restores "128 Horizon Way"
  ap_tap(t, "Street address", view::Role::TextField)
  t.type_text("ZZ")
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "ZZ"), "typed ZZ into street address")

  ap_tap(t, "Reset", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "128 Horizon Way"), "Reset restored 128 Horizon Way")
  ap_assert_true(!ap_has_words(t, "ZZ"), "Reset removed ZZ")

  // Clear street address via Backspace, click Save Address -> no toast, FieldError shown
  ap_tap(t, "Street address", view::Role::TextField)
  let mut k = 0
  while k < 25 {
    t.backspace()
    k += 1
  }
  t.run_shown(ap_settled)
  ap_tap(t, "Save Address", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!ap_has_words(t, "Address Saved"), "empty Save must not fire success toast")
  ap_assert_true(ap_has_words(t, "Street address cannot be empty."), "FieldError shown when empty")

  // Reset and save valid address -> fires success toast
  ap_tap(t, "Reset", view::Role::Button)
  t.run_shown(ap_settled)
  ap_tap(t, "Save Address", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Address Saved"), "valid Save fires Address Saved toast")

  t.dispose()
}

test "data table: real Name sorting swaps row y coordinates and Load more hides when exhausted" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    showcase_page(root, 6, cfg)
  }, width=1280.0, height=1200.0)
  t.run_shown(ap_settled)

  // Click Name column header -> ASC (Alex < Jordan < Morgan < Sam)
  ap_tap(t, "Name", view::Role::ColumnHeader)
  t.run_shown(ap_settled)
  let y_alex_asc = match ap_words_y(t, "Alex Rivera") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "Alex Rivera missing in ASC")
  }
  let y_sam_asc = match ap_words_y(t, "Sam Patel") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "Sam Patel missing in ASC")
  }
  ap_assert_true(y_alex_asc < y_sam_asc, "ASC: Alex Rivera should be above Sam Patel")

  // Click Name column header again -> DESC (Sam > Morgan > Jordan > Alex)
  ap_tap(t, "Name", view::Role::ColumnHeader)
  t.run_shown(ap_settled)
  let y_alex_desc = match ap_words_y(t, "Alex Rivera") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "Alex Rivera missing in DESC")
  }
  let y_sam_desc = match ap_words_y(t, "Sam Patel") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "Sam Patel missing in DESC")
  }
  ap_assert_true(y_sam_desc < y_alex_desc, "DESC: Sam Patel should be above Alex Rivera")

  // Load more -> appends 2 rows (total 6) and hides Load more button
  ap_assert_true(t.get("Load more members", role=view::Role::Button).is_some(), "Load more visible initially")
  ap_tap(t, "Load more members", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Taylor Brooks"), "Taylor Brooks loaded")
  ap_assert_true(ap_has_words(t, "Casey Lin"), "Casey Lin loaded")
  ap_assert_true(ap_has_words(t, "6 rows"), "row count chip shows 6 rows")
  ap_assert_true(t.get("Load more members", role=view::Role::Button).is_none(), "Load more button hidden when exhausted")

  t.dispose()
}

test "accordion and disclosure group collapse when clicking expanded item again" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    showcase_page(root, 4, cfg)
  }, width=1280.0, height=1000.0)
  t.run_shown(ap_settled)

  // Accordion item "How does Aura handle theming?" starts expanded
  ap_assert_true(ap_has_words(t, "A single reactive AuraConfig"), "Accordion q1 starts open")
  ap_tap(t, "How does Aura handle theming?", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!ap_has_words(t, "A single reactive AuraConfig"), "Accordion q1 collapsed on second tap")

  // DisclosureGroup item "GPU Shaders" starts expanded
  ap_assert_true(ap_has_words(t, "Native GPU, EGL/GLES3"), "DisclosureGroup g1 starts open")
  ap_tap(t, "GPU Shaders", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!ap_has_words(t, "Native GPU, EGL/GLES3"), "DisclosureGroup g1 collapsed on second tap")

  t.dispose()
}

test "interactive overlays: Modal and Popover open and close cleanly" {
  let cfg = signals::signal(aura::AuraConfig::dark())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    showcase_page(root, 5, cfg)
  }, width=1280.0, height=800.0)
  t.run_shown(ap_settled)

  // Open Modal
  ap_tap(t, "Open Modal", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Welcome to Aura Studio"), "Modal heading visible")
  ap_tap(t, "Confirm", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!ap_has_words(t, "Welcome to Aura Studio"), "Modal closed after Confirm")

  // Open Popover
  ap_tap(t, "Layer Popover", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "Layer Settings"), "Popover heading visible")
  ap_tap(t, "Apply", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(!ap_has_words(t, "Layer Settings"), "Popover closed after Apply")

  aura::assert_aura_ui(t, label="interactive-overlays-end")
  t.dispose()
}

test "gallery category cycling Overview -> Inputs -> Overview (5x) has zero reactive node or link leak" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=0)
  }, width=1280.0, height=800.0)
  t.run_shown(ap_settled)

  // Warm-up round-trip so any lazy one-time caches settle before baseline measurement.
  ap_tap(t, "Inputs & Forms", view::Role::Button)
  t.run_shown(ap_settled)
  ap_tap(t, "Overview", view::Role::Button)
  t.run_shown(ap_settled)

  let base_nodes = signals::live_node_count()
  let base_links = signals::live_link_count()

  let mut round = 0
  while round < 5 {
    ap_tap(t, "Inputs & Forms", view::Role::Button)
    t.run_shown(ap_settled)
    ap_tap(t, "Overview", view::Role::Button)
    t.run_shown(ap_settled)
    let cur_nodes = signals::live_node_count()
    let cur_links = signals::live_link_count()
    ap_assert_eq_int(cur_nodes, base_nodes, "cycle round \{round} live_node_count")
    ap_assert_eq_int(cur_links, base_links, "cycle round \{round} live_link_count")
    round += 1
  }
  t.dispose()
}

test "gallery full tour + dispose across 4 rounds returns reactive nodes and links to baseline" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let tour_once = fn() -> Unit {
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      gallery(root, cfg, chrome=true, initial_cat=0)
    }, width=1280.0, height=800.0)
    t.run_shown(ap_settled)

    let cats = [
      "Buttons & Actions",
      "Inputs & Forms",
      "Selection & Range",
      "Navigation",
      "Overlays",
      "Collections & Table",
      "DateTime & Color",
      "Overview",
    ]
    for cname in cats {
      ap_tap(t, cname, view::Role::Button)
      t.run_shown(ap_settled)
      if cname == "Overlays" {
        ap_tap(t, "Layer Popover", view::Role::Button)
        t.run_shown(ap_settled)
        ap_tap(t, "Apply", view::Role::Button)
        t.run_shown(ap_settled)
      }
    }
    ap_tap(t, "Light", view::Role::Button)
    t.run_shown(ap_settled)
    ap_tap(t, "Dark", view::Role::Button)
    t.run_shown(ap_settled)
    t.dispose()
  }

  // Warm-up tour to establish steady-state baseline with external `cfg` signal alive.
  tour_once()
  let base_nodes = signals::live_node_count()
  let base_links = signals::live_link_count()

  let mut round = 0
  while round < 4 {
    tour_once()
    ap_assert_eq_int(signals::live_node_count(), base_nodes, "tour round \{round} live_node_count after dispose")
    ap_assert_eq_int(signals::live_link_count(), base_links, "tour round \{round} live_link_count after dispose")
    round += 1
  }
}

test "dynamic resize across 1024pt preserves unsaved Work Email edits" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=2)
  }, width=1100.0, height=800.0)
  t.run_shown(ap_settled)

  ap_tap(t, "Work Email (Primary)", view::Role::TextField)
  t.type_text("UNSAVED")
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "UNSAVED"), "typed UNSAVED visible at 1100pt")

  t.resize(1000.0, 800.0)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "UNSAVED"), "UNSAVED must persist after shrinking across 1024pt breakpoint")
  let y_c1_narrow = match ap_words_y(t, "TextField, TextArea & InputGroup") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "left card missing at 1000pt")
  }
  let y_c2_narrow = match ap_words_y(t, "SearchField, NumberField & InputOTP") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "right card missing at 1000pt")
  }
  ap_assert_true(y_c2_narrow > y_c1_narrow + 100.0, "cards must stack vertically below 1024pt (y1=\{y_c1_narrow}, y2=\{y_c2_narrow})")

  t.resize(1100.0, 800.0)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "UNSAVED"), "UNSAVED must persist after expanding back across 1024pt")
  let y_c1_wide = match ap_words_y(t, "TextField, TextArea & InputGroup") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "left card missing at 1100pt")
  }
  let y_c2_wide = match ap_words_y(t, "SearchField, NumberField & InputOTP") {
    Some(y) => y
    None => halt::saying("aura_pages_test", "right card missing at 1100pt")
  }
  ap_assert_true((y_c2_wide - y_c1_wide).abs() < 4.0, "cards must sit side-by-side at >= 1024pt (y1=\{y_c1_wide}, y2=\{y_c2_wide})")
  t.dispose()
}

test "wide -> narrow -> wide resize preserves sidebar search query and Clear button" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=0)
  }, width=1100.0, height=800.0)
  t.run_shown(ap_settled)

  ap_tap(t, "Search", view::Role::TextField)
  t.type_text("zzznomatch")
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "No matching category"), "no match state active at 1100pt")
  ap_assert_true(t.get("Clear search", role=view::Role::Button).is_some(), "Clear search button present before resize")

  t.resize(390.0, 844.0)
  t.run_shown(ap_settled)
  t.resize(1100.0, 800.0)
  t.run_shown(ap_settled)

  ap_assert_true(ap_has_words(t, "zzznomatch"), "search field text preserved after wide -> narrow -> wide")
  ap_assert_true(t.get("Clear search", role=view::Role::Button).is_some(), "Clear search button preserved after wide -> narrow -> wide")

  ap_tap(t, "Clear search", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(t.get("Overlays", role=view::Role::Button).is_some(), "categories restored after Clear search")
  t.dispose()
}

test "768x800 top bar keeps active category title visible and 600x800 RTL passes assert_aura_ui across all 8 categories" {
  let cfg768 = signals::signal(aura::AuraConfig::light())
  let t768 = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg768, chrome=true, initial_cat=7)
  }, width=768.0, height=800.0)
  t768.run_shown(ap_settled)
  let mut saw_top_title = false
  for d in t768.drawn() {
    if d.words == "DateTime & Color" && d.y < 64.0 && d.w > 60.0 {
      saw_top_title = true
    }
  }
  ap_assert_true(saw_top_title, "768x800 top bar must display full DateTime & Color category title")
  aura::assert_aura_ui(t768, label="gallery-768-cat-7")
  t768.dispose()

  let mut cat = 0
  while cat < 8 {
    let cid = cat
    let cfg = signals::signal(aura::AuraConfig::{ ..aura::AuraConfig::dark(), rtl: true })
    let t = ui::Tester::tree(fn(root : view::View) -> Unit {
      gallery(root, cfg, chrome=true, initial_cat=cid)
    }, width=600.0, height=800.0)
    t.run_shown(ap_settled)
    aura::assert_aura_ui(t, label="gallery-600x800-rtl-dark-cat-\{cid}")
    t.dispose()
    cat += 1
  }
}

test "collections Select preserves chosen New York across 1024pt breakpoint resize" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=6)
  }, width=1100.0, height=1000.0)
  t.run_shown(ap_settled)

  t.press("Region (Select)")
  t.run_shown(ap_settled)
  t.tap_text("New York")
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "New York") && !ap_has_words(t, "Texas"), "New York selected at 1100pt")

  t.resize(1070.0, 1000.0)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "New York"), "New York kept at 1070pt")

  t.resize(1000.0, 1000.0)
  t.run_shown(ap_settled)
  ap_assert_true(ap_has_words(t, "New York") && !ap_has_words(t, "California"), "New York kept across 1024pt resize to 1000pt")
  t.dispose()
}

test "growing viewport from 390pt to 1100pt auto-closes open mobile drawer" {
  let cfg = signals::signal(aura::AuraConfig::light())
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    gallery(root, cfg, chrome=true, initial_cat=0)
  }, width=390.0, height=844.0)
  t.run_shown(ap_settled)

  ap_tap(t, "Menu", view::Role::Button)
  t.run_shown(ap_settled)
  ap_assert_true(t.get("Invar Aura", role=view::Role::Dialog).is_some(), "mobile drawer opened at 390pt")

  t.resize(1100.0, 844.0)
  t.run_shown(ap_settled)
  ap_assert_true(t.get("Invar Aura", role=view::Role::Dialog).is_none(), "mobile drawer auto-closed on desktop resize")

  let mut search_count = 0
  for d in t.drawn() {
    if d.words.contains("Filter categories") {
      search_count += 1
    }
  }
  ap_assert_eq_int(search_count, 1, "exactly one sidebar search field visible at 1100pt")
  t.dispose()
}
