// Aura Studio — Self-Hosted Sidebar, Responsive Drawer, Search Filter, Top Chrome & Global Toast Host.
// Built 100% from `aura::*` components (zero `paint::Glass::liquid`).

import "aura"
import "signals"
import "ui"
import "view"

fn ap_cat_matches(cat : AuraCategory, query : String) -> Bool {
  if query == "" {
    return true
  }
  ap_str_contains_ci(cat.name, query)
    || ap_str_contains_ci(cat.subtitle, query)
    || ap_str_contains_ci(cat.keywords, query)
    || ap_str_contains_ci(cat.slug, query)
}

fn ap_sidebar_nav_item(
  parent : view::View,
  cat : AuraCategory,
  active_cat : signals::Signal[Int],
  on_pick~ : () -> Unit = fn() { () },
) -> Unit {
  let cid = cat.id
  let _ = parent.box(fn(row_wrap : view::View) -> Unit {
    let _ = row_wrap.fills_across(view::Live::Is(true))
    let btn = aura::button_node(
      row_wrap,
      view::Live::Is(cat.name),
      variant=aura::AuraButtonVariant::Ghost,
      size=aura::AuraButtonSize::Md,
      full_width=true,
      on_press=fn() -> Unit {
        active_cat.set(cid)
        on_pick()
      },
      content=fn(inner : view::View) -> Unit {
        let _ = inner
          .row(view::Live::Is(true))
          .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(inner) }))
          .fills_across(view::Live::Is(true))
          .lies_along(view::Live::Is(view::Lies::Between))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .gap(view::Live::Is(8.0))
        let _ = inner.box(fn(lbl_col : view::View) -> Unit {
          let _ = lbl_col
            .grow(view::Live::Is(1.0))
            .shrink(view::Live::Is(1.0))
            .basis(view::Live::Is(Some(0.0)))
            .min_width(view::Live::Is(Some(0.0)))
            .words(view::Live::Is(cat.name), look=ap_words(13.5, 500, 18.0))
            .words_look(view::Live::By(fn() -> view::WordsLook {
              let w = if active_cat.get() == cid { 600 } else { 500 }
              ap_words(13.5, w, 18.0).with_rtl(aura::aura_rtl(lbl_col))
            }))
            .ink(view::Live::By(fn() -> Int64 {
              let pal = aura::aura_theme(lbl_col).palette
              if active_cat.get() == cid { pal.accent_soft_foreground } else { pal.foreground }
            }))
        })
        let _ = aura::chip_node(
          inner,
          view::Live::Is(cat.count),
          variant=aura::AuraChipVariant::Soft,
          color=aura::AuraStatusColor::Default,
          size=aura::AuraControlSize::Sm,
        )
      },
    )
    let _ = btn
      .ground(view::Live::By(fn() -> Int64 {
        let pal = aura::aura_theme(btn).palette
        if active_cat.get() == cid { pal.accent_soft } else { 0x00000000L }
      }))
      .radius(view::Live::Is(12.0))
      .corner_circular(view::Live::By(fn() -> Bool { aura::aura_corner_circular(btn) }))
      .padding(view::Live::Is((12.0, 0.0, 10.0, 0.0)))
  })
}

fn ap_mount_category_list(
  list : view::View,
  active_cat : signals::Signal[Int],
  search_query : signals::Signal[String],
  on_pick~ : () -> Unit = fn() { () },
) -> Unit {
  let _ = list.fills_across(view::Live::Is(true)).gap(view::Live::Is(4.0))
  let _ = list.show(
    fn() -> Bool {
      let q = search_query.get()
      let mut any = false
      for cat in aura_categories {
        if ap_cat_matches(cat, q) {
          any = true
        }
      }
      !any
    },
    fn(es_slot : view::View) -> Unit {
      let _ = aura::empty_state_node(es_slot, pad=12.0, gap=4.0, content=fn(es : view::View) -> Unit {
        let _ = es.box(fn(t : view::View) -> Unit {
          let _ = t
            .words(view::Live::Is("No matching category"), look=ap_words(12.5, 500, 18.0))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(t).palette.muted }))
        })
      })
    },
    at_once=true,
  )
  for cat in aura_categories {
    let c = cat
    let _ = list.show(
      fn() -> Bool { ap_cat_matches(c, search_query.get()) },
      fn(slot : view::View) -> Unit {
        let _ = slot.fills_across(view::Live::Is(true))
        ap_sidebar_nav_item(slot, c, active_cat, on_pick=on_pick)
      },
      at_once=true,
    )
  }
}

fn ap_mount_sidebar(
  parent : view::View,
  cfg : signals::Signal[aura::AuraConfig],
  active_cat : signals::Signal[Int],
  search_query : signals::Signal[String],
  search_field : ui::Field,
) -> Unit {
  let _ = parent.box(fn(rail : view::View) -> Unit {
    let _ = rail
      .width(view::Live::Is(Some(256.0)))
      .shrink(view::Live::Is(0.0))
      .fills_across(view::Live::Is(true))
      .ground(view::Live::By(fn() -> Int64 { aura::aura_theme(rail).palette.surface }))
      .padding(view::Live::Is((16.0, 18.0, 16.0, 16.0)))
      .gap(view::Live::Is(14.0))

    // Brand header
    let _ = rail.box(fn(brand : view::View) -> Unit {
      let _ = brand
        .row(view::Live::Is(true))
        .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(brand) }))
        .fills_across(view::Live::Is(true))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
        .gap(view::Live::Is(10.0))
      let _ = brand.box(fn(mark : view::View) -> Unit {
        let _ = mark
          .width(view::Live::Is(Some(32.0)))
          .height(view::Live::Is(Some(32.0)))
          .shrink(view::Live::Is(0.0))
          .radius(view::Live::Is(10.0))
          .corner_circular(view::Live::By(fn() -> Bool { aura::aura_corner_circular(mark) }))
          .ground(view::Live::By(fn() -> Int64 { aura::aura_theme(mark).palette.accent }))
          .lines_up(view::Live::Is(Some(view::Along::Middle)))
          .lies_along(view::Live::Is(view::Lies::Middle))
        let _ = mark.box(fn(glyph : view::View) -> Unit {
          let _ = glyph
            .words(view::Live::Is("A"), look=ap_words(16.0, 700, 20.0))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(glyph).palette.accent_foreground }))
        })
      })
      let _ = brand.box(fn(titles : view::View) -> Unit {
        let _ = titles.grow(view::Live::Is(1.0)).shrink(view::Live::Is(1.0)).basis(view::Live::Is(Some(0.0))).min_width(view::Live::Is(Some(0.0))).gap(view::Live::Is(1.0))
        let _ = titles.box(fn(t : view::View) -> Unit {
          let _ = t
            .words(view::Live::Is("Invar Aura"), look=ap_words(15.0, 700, 20.0))
            .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(15.0, 700, 20.0).with_rtl(aura::aura_rtl(t)) }))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(t).palette.foreground }))
        })
        let _ = titles.box(fn(sub : view::View) -> Unit {
          let _ = sub
            .words(view::Live::Is("86-Component Studio"), look=ap_words(11.5, 500, 16.0))
            .words_look(view::Live::By(fn() -> view::WordsLook { ap_words(11.5, 500, 16.0).with_rtl(aura::aura_rtl(sub)) }))
            .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(sub).palette.muted }))
        })
      })
    })

    // Sidebar SearchField to filter categories (shared Field preserves query & Clear button across resizes)
    let _ = aura::search_field_node(
      rail,
      field=search_field,
      placeholder=view::Live::Is("Filter categories..."),
      variant=aura::AuraFieldVariant::Secondary,
      on_change=fn(s : String) -> Unit { search_query.set(s) },
      on_clear=fn() -> Unit { search_query.set("") },
    )

    let _ = aura::separator_node(rail)

    // Scrollable category list
    let _ = rail.box(fn(nav_wrap : view::View) -> Unit {
      let _ = nav_wrap.fill()
      let _ = ui::scroll_box(nav_wrap, fn(list : view::View) -> Unit {
        ap_mount_category_list(list, active_cat, search_query)
      })
    })

    let _ = aura::separator_node(rail)

    // Compact live config status footer
    let _ = rail.box(fn(foot : view::View) -> Unit {
      let _ = foot
        .row(view::Live::Is(true))
        .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(foot) }))
        .fills_across(view::Live::Is(true))
        .lies_along(view::Live::Is(view::Lies::Between))
        .lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = foot.box(fn(st : view::View) -> Unit {
        let _ = st
          .words(
            view::Live::By(fn() -> String {
              let c = cfg.get()
              let mode = if c.dark { "Dark" } else { "Light" }
              let corner = if c.corner_circular { "Circular" } else { "Smooth" }
              "\{mode} · \{corner}"
            }),
            look=ap_words(11.5, 500, 16.0),
          )
          .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(st).palette.muted }))
      })
      let _ = aura::chip_node(
        foot,
        view::Live::By(fn() -> String {
          if cfg.get().rtl { "RTL" } else { "LTR" }
        }),
        variant=aura::AuraChipVariant::Soft,
        color=aura::AuraStatusColor::Accent,
        size=aura::AuraControlSize::Sm,
      )
    })
  })
}

fn ap_mount_top_chrome(
  parent : view::View,
  cfg : signals::Signal[aura::AuraConfig],
  active_cat : signals::Signal[Int],
  toast_queue : aura::ToastQueue,
  nav_drawer_open : signals::Signal[Bool],
) -> Unit {
  let _ = parent.box(fn(host : view::View) -> Unit {
    let _ = host
      .fills_across(view::Live::Is(true))
      .shrink(view::Live::Is(0.0))
      .ground(view::Live::By(fn() -> Int64 { aura::aura_theme(host).palette.surface }))
    let _ = host.pick(
      fn() -> Bool { aura::aura_is_md(host) },
      fn(bar : view::View, is_md : Bool) -> Unit {
        let _ = bar.fills_across(view::Live::Is(true))
        if is_md {
          let _ = bar
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(bar) }))
            .min_height(view::Live::Is(Some(60.0)))
            .padding(view::Live::Is((24.0, 10.0, 24.0, 10.0)))
            .lies_along(view::Live::Is(view::Lies::Between))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(12.0))
        } else {
          let _ = bar
            .padding(view::Live::Is((12.0, 10.0, 12.0, 10.0)))
            .gap(view::Live::Is(8.0))
        }

        // Left (Row 1 on narrow): Mobile menu button + Active category title + desktop subtitle chip
        let _ = bar.box(fn(left : view::View) -> Unit {
          let _ = left
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(left) }))
            .fills_across(view::Live::Is(!is_md))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .gap(view::Live::Is(10.0))
          if !is_md {
            let _ = aura::button_node(
              left,
              view::Live::Is("Menu"),
              variant=aura::AuraButtonVariant::Secondary,
              size=aura::AuraButtonSize::Sm,
              on_press=fn() -> Unit { nav_drawer_open.set(true) },
            )
          }
          let _ = left.box(fn(t : view::View) -> Unit {
            let _ = t
              .shrink(view::Live::Is(if is_md { 0.0 } else { 1.0 }))
              .min_width(view::Live::Is(Some(0.0)))
              .words(
                view::Live::By(fn() -> String {
                  let id = ap_clamp_cat(active_cat.get())
                  aura_categories[id].name
                }),
                look=ap_words(16.0, 600, 22.0),
              )
              .words_look(view::Live::By(fn() -> view::WordsLook {
                ap_words(16.0, 600, 22.0).with_rtl(aura::aura_rtl(t))
              }))
              .ink(view::Live::By(fn() -> Int64 { aura::aura_theme(t).palette.foreground }))
          })
          if is_md {
            let _ = left.show(
              fn() -> Bool { ap_is_lg(left) },
              fn(sub_slot : view::View) -> Unit {
                let _ = aura::chip_node(
                  sub_slot,
                  view::Live::By(fn() -> String {
                    let id = ap_clamp_cat(active_cat.get())
                    aura_categories[id].subtitle
                  }),
                  variant=aura::AuraChipVariant::Secondary,
                  color=aura::AuraStatusColor::Default,
                  size=aura::AuraControlSize::Sm,
                )
              },
              at_once=true,
            )
          }
        })

        // Right (Row 2 on narrow): Live reactive theme controls (auto-wrapping on narrow viewports)
        let _ = bar.box(fn(controls : view::View) -> Unit {
          let _ = controls
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(controls) }))
            .fills_across(view::Live::Is(!is_md))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .wraps(view::Live::Is(Some(6.0)))
            .gap(view::Live::Is(if is_md { 8.0 } else { 6.0 }))

          let _ = aura::toggle_button_node(
            controls,
            view::Live::By(fn() -> String {
              if cfg.get().dark { "Dark" } else { "Light" }
            }),
            fn() -> Bool { cfg.get().dark },
            on_change=fn(next : Bool) -> Unit {
              let c = cfg.get()
              cfg.set(aura::AuraConfig::{ ..c, dark: next })
            },
            size=aura::AuraButtonSize::Sm,
          )
          let _ = aura::toggle_button_node(
            controls,
            view::Live::By(fn() -> String {
              if cfg.get().vibrant { "Vibrant" } else { "Standard" }
            }),
            fn() -> Bool { cfg.get().vibrant },
            on_change=fn(next : Bool) -> Unit {
              let c = cfg.get()
              cfg.set(aura::AuraConfig::{ ..c, vibrant: next })
            },
            size=aura::AuraButtonSize::Sm,
          )
          let _ = aura::toggle_button_node(
            controls,
            view::Live::By(fn() -> String {
              if cfg.get().rtl { "RTL" } else { "LTR" }
            }),
            fn() -> Bool { cfg.get().rtl },
            on_change=fn(next : Bool) -> Unit {
              let c = cfg.get()
              cfg.set(aura::AuraConfig::{ ..c, rtl: next })
            },
            size=aura::AuraButtonSize::Sm,
          )
          let _ = aura::toggle_button_node(
            controls,
            view::Live::By(fn() -> String {
              if cfg.get().corner_circular { "Circular" } else { "Smooth" }
            }),
            fn() -> Bool { !cfg.get().corner_circular },
            on_change=fn(smooth : Bool) -> Unit {
              let c = cfg.get()
              cfg.set(aura::AuraConfig::{ ..c, corner_circular: !smooth })
            },
            size=aura::AuraButtonSize::Sm,
          )
          let _ = aura::button_node(
            controls,
            view::Live::Is("Toast"),
            variant=aura::AuraButtonVariant::Primary,
            size=aura::AuraButtonSize::Sm,
            on_press=fn() -> Unit {
              let c = cfg.get()
              let mode = if c.dark { "Dark" } else { "Light" }
              let corner = if c.corner_circular { "Circular" } else { "Smooth" }
              toast_queue.push(
                aura::AuraToastData::new(
                  "studio-theme",
                  "Aura Studio Ready",
                  description="Theme: \{mode} · \{corner} corners active.",
                  variant=aura::AuraToastVariant::Success,
                ),
              )
            },
          )
        })
      },
      at_once=true,
    )
  })
}

/// Mount the full Aura Studio split shell (responsive sidebar/drawer + top chrome + scrollable exhibition canvas + ToastProvider).
fn ap_mount_library_shell(
  root : view::View,
  cfg : signals::Signal[aura::AuraConfig],
  active_cat : signals::Signal[Int],
  toast_queue : aura::ToastQueue,
  state : ApStudioState,
  chrome~ : Bool = true,
) -> Unit {
  let search_query = signals::signal("")
  let search_field = ui::Field::new(text="")
  let nav_drawer_open = signals::signal(false)

  let _ = root.box(fn(shell : view::View) -> Unit {
    let _ = shell
      .fill()
      .row(view::Live::Is(true))
      .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(shell) }))

    if chrome {
      shell.reacts(
        fn() -> Bool { aura::aura_is_md(shell) },
        fn(is_md : Bool) -> Unit {
          if is_md && nav_drawer_open.untracked() {
            nav_drawer_open.set(false)
          }
        },
      )
    }

    if chrome {
      let _ = shell.show(
        fn() -> Bool { aura::aura_is_md(shell) },
        fn(rail_slot : view::View) -> Unit {
          let _ = rail_slot
            .row(view::Live::Is(true))
            .row_reverse(view::Live::By(fn() -> Bool { aura::aura_rtl(rail_slot) }))
            .shrink(view::Live::Is(0.0))
            .fills_across(view::Live::Is(true))
          ap_mount_sidebar(rail_slot, cfg, active_cat, search_query, search_field)
          let _ = rail_slot.box(fn(div : view::View) -> Unit {
            let _ = div
              .width(view::Live::Is(Some(1.0)))
              .shrink(view::Live::Is(0.0))
              .fills_across(view::Live::Is(true))
              .ground(view::Live::By(fn() -> Int64 { aura::aura_theme(div).palette.separator }))
          })
        },
        at_once=true,
      )
    }

    // Main content column
    let _ = shell.box(fn(main_col : view::View) -> Unit {
      let _ = main_col.fill()
      if chrome {
        ap_mount_top_chrome(main_col, cfg, active_cat, toast_queue, nav_drawer_open)
        let _ = main_col.box(fn(hdiv : view::View) -> Unit {
          let _ = hdiv
            .height(view::Live::Is(Some(1.0)))
            .shrink(view::Live::Is(0.0))
            .fills_across(view::Live::Is(true))
            .ground(view::Live::By(fn() -> Int64 { aura::aura_theme(hdiv).palette.separator }))
        })
      }

      // Scrollable active section
      let _ = main_col.box(fn(content_wrap : view::View) -> Unit {
        let _ = content_wrap.fill()
        let _ = content_wrap.pick(
          fn() -> Int { active_cat.get() },
          fn(page_slot : view::View, cid : Int) -> Unit {
            let _ = page_slot.fill()
            let _ = ui::scroll_box(page_slot, fn(body : view::View) -> Unit {
              let _ = body
                .fills_across(view::Live::Is(true))
                .padding(view::Live::By(fn() -> (Double, Double, Double, Double) {
                  if aura::aura_is_md(body) {
                    (28.0, 24.0, 28.0, 32.0)
                  } else {
                    (14.0, 16.0, 14.0, 24.0)
                  }
                }))
                .gap(view::Live::Is(18.0))
              ap_render_category(body, cid, cfg, active_cat, toast_queue, state)
            })
          },
          at_once=true,
        )
      })
    })

    // Mobile navigation drawer (for viewports < 768pt; slides from start edge: Left in LTR, Right in RTL)
    if chrome {
      let _ = shell.pick(
        fn() -> Bool { aura::aura_rtl(shell) },
        fn(drawer_slot : view::View, is_rtl : Bool) -> Unit {
          let _ = aura::drawer_node(
            drawer_slot,
            fn() -> Bool { nav_drawer_open.get() },
            fn() -> Unit { nav_drawer_open.set(false) },
            heading="Invar Aura",
            placement=if is_rtl { aura::AuraDrawerPlacement::Right } else { aura::AuraDrawerPlacement::Left },
            panel_width=280.0,
            body=fn(dv : view::View) -> Unit {
              let _ = dv.fills_across(view::Live::Is(true)).gap(view::Live::Is(12.0))
              let _ = aura::search_field_node(
                dv,
                field=search_field,
                placeholder=view::Live::Is("Filter categories..."),
                variant=aura::AuraFieldVariant::Secondary,
                on_change=fn(s : String) -> Unit { search_query.set(s) },
                on_clear=fn() -> Unit { search_query.set("") },
              )
              let _ = aura::separator_node(dv)
              let _ = dv.box(fn(list : view::View) -> Unit {
                ap_mount_category_list(list, active_cat, search_query, on_pick=fn() -> Unit {
                  nav_drawer_open.set(false)
                })
              })
            },
          )
        },
        at_once=true,
      )
    }

    // Global toast notification host
    let _ = aura::toast_provider_node(shell, toast_queue, placement=aura::AuraToastPlacement::BottomEnd)
  })
}
