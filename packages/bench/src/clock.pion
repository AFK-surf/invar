// FFI bindings to compat/bench_clock.c (real monotonic wall-clock & peak RSS).

extern "C" fn c_bench_now_ms() -> Double = "invar_bench_now_ms"
extern "C" fn c_bench_rss_kb() -> Int64 = "invar_bench_rss_kb"

pub fn now_ms() -> Double {
  c_bench_now_ms()
}

pub fn rss_peak_kb() -> Int64 {
  c_bench_rss_kb()
}
