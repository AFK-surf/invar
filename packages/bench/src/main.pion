// CLI entrypoint for Layer-1 pure CPU Invar benchmark suite (`invar-bench`).
// Usage: invar-bench [--json] [--filter <substr>]

pub fn main(world : World) -> Int {
  let args = world_args(world)
  let mut as_json = false
  let mut filter = ""
  let mut i = 1
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--filter" && i + 1 < args.length() {
      filter = args[i + 1]
      i += 1
    } else if a == "--help" || a == "-h" {
      io_println(world, "Usage: invar-bench [--json] [--filter <substr>]")
      return 0
    }
    i += 1
  }
  let results = run_all_cpu(filter)
  let rss = rss_peak_kb()
  if as_json {
    io_println(world, format_cpu_json(results, rss))
  } else {
    io_println(world, format_cpu_table(results, rss))
  }
  0
}
