// Unit tests for packages/bench: verify non-zero checksums, O(changed) signal propagation,
// zero duplicate diamond evals, keyed row reuse, incremental damage <= 2 rects, and spring FPS parity.

import "text"

test "bench: signals_fanout_10k O(changed) propagation" {
  let m = bench_signals_fanout_10k(warmup=1, iters=3)
  debug_assert(m.result.checksum != 0L, "fanout checksum must be non-zero")
  debug_assert(m.single_evals == 100, "1 root update must recompute exactly 100 leaves, got " + m.single_evals.to_string())
  debug_assert(m.batch_evals == 1000, "10-root batch must recompute exactly 1000 leaves, got " + m.batch_evals.to_string())
}

test "bench: signals_diamond_200 zero duplicate evals" {
  let m = bench_signals_diamond_200(warmup=1, iters=3)
  debug_assert(m.result.checksum != 0L, "diamond checksum must be non-zero")
  debug_assert(m.evals_per_write == 600, "200-layer diamond must evaluate 600 nodes once, got " + m.evals_per_write.to_string())
}

test "bench: tree_mount_1k and tree_update_10pct_1k and tree_swap_rows_1k" {
  let m1 = bench_tree_mount("tree_mount_1k", 1000, warmup=1, iters=2)
  debug_assert(m1.checksum != 0L, "tree_mount_1k checksum non-zero")

  let m2 = bench_tree_update_10pct_1k(warmup=1, iters=2)
  debug_assert(m2.checksum != 0L, "tree_update_10pct_1k checksum non-zero")

  let m3 = bench_tree_swap_rows_1k(warmup=1, iters=3)
  debug_assert(m3.result.checksum != 0L, "tree_swap_rows_1k checksum non-zero")
  debug_assert(m3.initial_created == 1000, "initial_created must be 1000")
  debug_assert(m3.final_created == 1000, "keyed swap must not recreate rows, final=" + m3.final_created.to_string())
}

test "bench: flex_deep_20x2k_resize and text and skia and svg" {
  let mf = bench_flex_deep_20x2k_resize(warmup=1, iters=2)
  debug_assert(mf.checksum != 0L, "flex checksum non-zero")

  let mt = bench_text_unicode_wrap_cjk(warmup=1, iters=2)
  debug_assert(mt.checksum != 0L, "text checksum non-zero")

  let msk = bench_skia_aa_100x(warmup=1, iters=2)
  debug_assert(msk.checksum != 0L, "skia checksum non-zero")

  let msvg = bench_svg_parse_raster(warmup=1, iters=2)
  debug_assert(msvg.checksum != 0L, "svg checksum non-zero")
}

test "bench: scene_encode_2k_and_damage_1 incremental dirty_rects <= 2" {
  let md = bench_scene_encode_2k_and_damage_1(warmup=1, iters=3)
  debug_assert(md.result.checksum != 0L, "damage checksum non-zero")
  debug_assert(md.instances >= 2000, "expected >= 2000 instances, got " + md.instances.to_string())
  debug_assert(md.dirty_rects >= 1 && md.dirty_rects <= 2, "expected 1..=2 dirty rects, got " + md.dirty_rects.to_string())
  debug_assert(md.dirty_area_pct > 0.0 && md.dirty_area_pct < 5.0, "expected small dirty area pct")
}

test "bench: motion_springs_50x120f FPS parity and clock" {
  let mm = bench_motion_springs_50x120f(warmup=1, iters=3)
  debug_assert(mm.result.checksum != 0L, "motion checksum non-zero")
  debug_assert(mm.fps_parity_ok, "60fps vs 120fps endpoints must match")
  debug_assert(now_ms() > 0.0, "monotonic clock must be positive")
  debug_assert(rss_peak_kb() > 0L, "rss_peak_kb must be positive")
}

test "bench: large single-line CJK O(1) grapheme stepping" {
  // Build >= 200 KiB single-line CJK string (0 newlines): 8600 * 24 bytes = 206400 bytes.
  let mut chunk = "汉字测试边界性能"
  let mut doc = ""
  let mut rem = 8600
  while rem > 0 {
    if (rem & 1) != 0 {
      doc = doc + chunk
    }
    rem = rem >> 1
    if rem > 0 {
      chunk = chunk + chunk
    }
  }
  debug_assert(doc.length() == 206400, "expected 206400 bytes, got " + doc.length().to_string())
  let start_off = doc.length() - 3000
  let t0 = now_ms()
  let mut cur = start_off
  for _ in 0..<1000 {
    cur = text::next_grapheme_utf8(doc, cur)
  }
  debug_assert(cur == doc.length(), "1000 next_grapheme_utf8 steps must reach end, got " + cur.to_string())
  for _ in 0..<1000 {
    cur = text::prev_grapheme_utf8(doc, cur)
  }
  debug_assert(cur == start_off, "1000 prev_grapheme_utf8 steps must return to start_off, got " + cur.to_string())
  let elapsed_ms = now_ms() - t0
  debug_assert(elapsed_ms >= 0.0 && elapsed_ms < 50.0, "expected O(1) grapheme stepping < 50.0 ms, got " + elapsed_ms.to_string() + " ms")
}
