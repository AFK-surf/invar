// Real Pion-JSX + Leading-Dot (.Enum) unit tests for packages/kit PascalCase shells.

import "signals"
import "ui"
import "view"

test "kit_jsx_icon_svg_and_glow_reactive" {
  ui::images_reset()
  ui::host_image_bytes_known([("", 65536)])
  let c1 = ui::rgba(255, 90, 60, 255)
  let c2 = ui::rgba(60, 200, 255, 255)
  let g1 = ui::rgba(120, 180, 255, 190)
  let g2 = ui::rgba(255, 140, 80, 190)
  let tint = signals::signal(c1)
  let glow_col = signals::signal(g1)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    <IconView in={root} kind={.Refresh} size={18.0} color_by=>{tint.get()} />
    <SvgIcon in={root} d="M 4 4 H 20 V 20 H 4 Z" size={22.0} color_by=>{tint.get()} fill />
    <Glow in={root} width={160.0} height={120.0} color_by=>{glow_col.get()} tex_px={32} />
  })
  let mut icon_ok = false
  let mut svg_ok = false
  let mut glow_key1 = ""
  for d in t.drawn() {
    if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c1 && d.shapes[0].stroke != 0L, "IconView starts with c1 stroke")
      icon_ok = true
    } else if d.w == 22.0 && d.h == 22.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c1 && d.shapes[0].fill != 0L, "SvgIcon starts with c1 fill")
      svg_ok = true
    } else if d.w == 160.0 && d.h == 120.0 {
      match d.image {
        Some((k, _, _)) => glow_key1 = k
        None => ()
      }
    }
  }
  debug_assert(icon_ok && svg_ok && glow_key1 != "", "IconView, SvgIcon and Glow all render")

  tint.set(c2)
  glow_col.set(g2)
  t.frame()
  let mut icon_upd = false
  let mut svg_upd = false
  let mut glow_key2 = ""
  for d in t.drawn() {
    if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c2 && d.shapes[0].stroke != 0L, "IconView updates stroke reactively")
      icon_upd = true
    } else if d.w == 22.0 && d.h == 22.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c2 && d.shapes[0].fill != 0L, "SvgIcon updates fill reactively")
      svg_upd = true
    } else if d.w == 160.0 && d.h == 120.0 {
      match d.image {
        Some((k, _, _)) => glow_key2 = k
        None => ()
      }
    }
  }
  debug_assert(icon_upd && svg_upd, "reactive icon color updates apply on frame")
  debug_assert(glow_key2 != "" && glow_key2 != glow_key1, "Glow updates texture key on color change")
  t.dispose()
}

test "kit_jsx_scroll_area_and_controls" {
  let clicks = ui::ref_new(0)
  let disabled = signals::signal(false)
  let checked = signals::signal(false)
  let sw_on = signals::signal(false)
  let vol = signals::signal(0.3)
  let prog = signals::signal(0.5)
  let field = Field::new(text="hi")
  let sc = view::Scroll::new()
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    <ScrollArea in={root} width={320.0} height={240.0} scroll={sc}>
      <Button
        label="Save"
        primary
        disabled_by=>{disabled.get()}
        on_press=>{clicks.v = clicks.v + 1}
      />
      <Checkbox
        label="Accept"
        checked_by=>{checked.get()}
        on_change={fn(v : Bool) -> Unit { checked.set(v) }}
      />
      <Switch
        label="WiFi"
        checked_by=>{sw_on.get()}
        on_change={fn(v : Bool) -> Unit { sw_on.set(v) }}
      />
      <Slider
        label="Volume"
        value_by=>{vol.get()}
        on_change={fn(v : Double) -> Unit { vol.set(v) }}
        width={180.0}
      />
      <Progress label="Sync" value_by=>{Some(prog.get())} width={180.0} />
      <TextField field={field} placeholder="Name" width={200.0} />
      <IconView kind={.Check} size={16.0} />
    </ScrollArea>
  })
  debug_assert(t.scroll_faults().length() == 0, "JSX ScrollArea must report 0 scroll_faults")

  t.tap_by_name("Save")
  debug_assert(clicks.v == 1, "JSX Button invokes on_press")
  disabled.set(true)
  t.frame()
  t.tap_by_name("Save")
  debug_assert(clicks.v == 1, "disabled JSX Button ignores press")

  t.tap_by_name("Accept")
  debug_assert(checked.get(), "JSX Checkbox toggles checked signal")

  t.tap_by_name("WiFi")
  debug_assert(sw_on.get(), "JSX Switch toggles signal")

  debug_assert(t.drawn_by_name("Volume").is_some(), "JSX Slider exposes semantic node")
  debug_assert(t.drawn_by_name("Sync").is_some(), "JSX Progress exposes semantic node")

  field.focus()
  t.type_text("!")
  debug_assert(field.text() == "hi!", "JSX TextField accepts typed text")
  t.dispose()
}

test "kit_jsx_into_single_prop_and_compat_by" {
  ui::images_reset()
  ui::host_image_bytes_known([("", 65536)])
  let c1 = ui::rgba(255, 100, 50, 255)
  let c2 = ui::rgba(50, 220, 120, 255)
  let tint = signals::signal(c1)
  let tint_ro : signals::ReadSignal[Int64] = tint.read()
  let clicks = ui::ref_new(0)
  let bare_clicks = ui::ref_new(0)
  let dis = signals::signal(false)
  let checked = signals::signal(false)
  let sw_on = signals::signal(false)
  let vol = signals::signal(0.4)

  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    <ScrollArea in={root} width={320.0} height={280.0}>
      <IconView kind={.Refresh} size={18.0} color={tint_ro} />
      <SvgIcon d="M 4 4 H 20 V 20 H 4 Z" size={22.0} color=>{tint.get()} fill />
      <Glow width={120.0} height={80.0} color={tint} tex_px={32} />
      <Button
        label="Go"
        disabled={dis}
        on_press=>{clicks.v = clicks.v + 1}
      />
      <Button
        label="Locked"
        disabled
        on_press=>{bare_clicks.v = bare_clicks.v + 1}
      />
      <Checkbox
        label="OptIn"
        checked={checked}
        on_change={fn(v : Bool) -> Unit { checked.set(v) }}
      />
      <Switch
        label="Sync"
        checked={sw_on}
        disabled={.Is(false)}
        on_change={fn(v : Bool) -> Unit { sw_on.set(v) }}
      />
      <Slider
        label="Gain"
        value={vol}
        on_change={fn(v : Double) -> Unit { vol.set(v) }}
        width={180.0}
      />
    </ScrollArea>
  })
  debug_assert(t.scroll_faults().length() == 0, "kit into test has 0 scroll_faults")

  t.tap_by_name("Go")
  debug_assert(clicks.v == 1, "Button with into disabled=Signal fires when false")
  t.tap_by_name("Locked")
  debug_assert(bare_clicks.v == 0, "Button with bare `disabled` ignores press")

  dis.set(true)
  tint.set(c2)
  t.frame()
  t.tap_by_name("Go")
  debug_assert(clicks.v == 1, "Button with into disabled=Signal ignores press after set(true)")

  let mut icon_upd = false
  let mut svg_upd = false
  for d in t.drawn() {
    if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c2 && d.shapes[0].stroke != 0L, "IconView color={ReadSignal} updates")
      icon_upd = true
    } else if d.w == 22.0 && d.h == 22.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == c2 && d.shapes[0].fill != 0L, "SvgIcon color=>{...} updates")
      svg_upd = true
    }
  }
  debug_assert(icon_upd && svg_upd, "kit into color reactive updates applied")

  t.tap_by_name("OptIn")
  debug_assert(checked.get(), "Checkbox checked={Signal} toggles")
  t.tap_by_name("Sync")
  debug_assert(sw_on.get(), "Switch checked={Signal} toggles")
  debug_assert(t.drawn_by_name("Gain").is_some(), "Slider value={Signal} mounts")
  t.dispose()
}
