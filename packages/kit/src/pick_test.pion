// Picking a passage of words (pick.pion) as a finger does it: held still, the word under it; sliding on, widened by
// words; start and end handles dragged without crossing; a tap anywhere else, let go; and holds handed through a cover.

import "signals"
import "text"
import "ui"
import "view"

fn str_array_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i += 1
  }
  true
}

test "pick_hold_slide_release_and_tap_away" {
  let p = Pick::new()
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      // (words a box's rich paragraphs hold: Ctx::words)
      let id = c.id("w")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("alpha beta gamma delta")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      if p.hold(c, "w", id) {
        c.take_press()
      }
      p.slide(c)
      let _ = p.tapped_away(c, [])
    },
    w=400.0,
    h=200.0,
  )
  let (rx, ry, _, rh) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return }
  }
  let (x, y) = (rx + 4.0, ry + rh / 2.0)
  t.press_at(x, y)
  // not yet a long press's time
  t.run_for(ui::long_press_ms / 2.0)
  debug_assert(!p.of("w"), "half long_press_ms must not pick yet")
  t.run_for(ui::long_press_ms)
  debug_assert(p.of("w"), "holding long_press_ms must pick word")
  debug_assert(p.a == 0 && p.b == 5, "first word alpha must be (0, 5), got (\{p.a}, \{p.b})")
  // sliding on to the end: from the word first held to the word under the finger
  let (_, _, rw, _) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return }
  }
  t.move_to(rx + rw - 2.0, y)
  debug_assert(p.a == 0 && p.b == 22, "sliding to end must widen to (0, 22), got (\{p.a}, \{p.b})")
  t.release(rx + rw - 2.0, y)
  t.draw()
  debug_assert(p.of("w") && !p.widening, "release must keep selection and stop widening")
  // a tap away from it lets go
  t.tap(300.0, 150.0)
  debug_assert(!p.of("w"), "tap away must clear selection")
  t.dispose()
}

test "pick_handles_drag_clamp_keep_all_and_reset" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      let bar = c.id("bar")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("alpha beta gamma delta")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      if p.hold(c, "w", id, may=p.handle == 0) {
        c.take_press()
      }
      p.slide(c)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=bar,
                left=200.0,
                top=120.0,
                w=ui::Size::Px(80.0),
                h=ui::Size::Px(30.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
      let _ = p.tapped_away(c, [h_start, h_end, bar])
    },
    w=400.0,
    h=200.0,
  )
  let (rx, ry, rw, rh) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return }
  }
  // Long press on "beta" (around 30% across the line)
  let mid_x = rx + rw * 0.30
  let mid_y = ry + rh / 2.0
  t.press_at(mid_x, mid_y)
  t.run_for(ui::long_press_ms + 50.0)
  t.release(mid_x, mid_y)
  t.draw()
  debug_assert(p.of("w"), "word must be picked after long press")
  let init_a = p.a
  let init_b = p.b
  debug_assert(init_b > init_a, "picked range must be non-empty")

  // Tap on keep bar must NOT clear selection
  t.tap(240.0, 135.0)
  debug_assert(p.of("w"), "tap inside keep bar must preserve selection")

  // Drag end handle rightward to expand, then leftward past start handle: must clamp at a + 1
  let w_now = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); return }
  }
  let rects1 = w_now.rects(p.a, p.b)
  debug_assert(rects1.length() > 0, "selection rects must exist")
  let end_r = rects1[rects1.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(rx + rw - 1.0, end_hy)
  debug_assert(p.b > init_b, "dragging end handle right must expand end offset")
  t.move_to(rx - 20.0, end_hy)
  debug_assert(p.b == p.a + 1, "end handle must never cross start (clamped at a + 1), got a=\{p.a} b=\{p.b}")
  t.release(rx - 20.0, end_hy)
  t.draw()
  debug_assert(p.handle == 0, "handle must release on pointer up")

  // Expand to full text via Pick::all, then drag start handle past end handle: must clamp at b - 1
  p.all(w_now)
  debug_assert(p.a == 0 && p.b == 22, "Pick::all must select entire text (0, 22), got (\{p.a}, \{p.b})")
  t.draw()
  let rects2 = w_now.rects(p.a, p.b)
  let start_r = rects2[0]
  let start_hx = start_r.0
  let start_hy = start_r.1 + start_r.3 + 8.0
  t.press_at(start_hx, start_hy)
  t.move_to(rx + rw + 40.0, start_hy)
  debug_assert(p.a == p.b - 1, "start handle must never cross end (clamped at b - 1), got a=\{p.a} b=\{p.b}")
  t.release(rx + rw + 40.0, start_hy)
  t.draw()

  // Pick::reset clears all fields back to initial state
  p.reset()
  debug_assert(!p.of("w") && p.a == 0 && p.b == 0 && p.from_a == 0 && p.from_b == 0 && p.press == -1, "reset must restore initial state")
  t.dispose()
}

// Words picked by a finger held still on a cover of the window's tree over them, its hold handed through to them
// (View::gesture's `through`): as with no cover, frames drawn between or none.

let pick_later_ms : Double = 100.0

/// When words are laid out for picking: always, or only as they are held (a press in them, a hold handed them).
enum Laid {
  Always
  Held
}

/// Words in an old view, a cover of the tree's over them holding through; a finger held still on the first word past a
/// long press and let go, frames drawn as it is held or (`frames` false) none between its down and its up. What was
/// picked then, and what the cover was told.
fn picked_through(frames : Bool, laid~ : Laid = Laid::Always) -> ((Int, Int, Bool), Array[String]) {
  let p = Pick::new()
  let said : Array[String] = []
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit { () }, w=400.0, h=200.0, platform=2)
  t.check_looks(false)
  ui::set_view_app(fn(root : view::View) -> Unit {
    let _ = root.box(fn(b : view::View) -> Unit {
      let _ = b.over(view::Live::Is(true)).width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
      let _ = ui::old(b, fn(c : ui::Ctx) -> Unit {
        let id = c.id("w")
        c.takes_presses(id)
        let box = c.box(id=id, fn() -> Unit {
          let _ = c.rich([text::plain("alpha beta gamma delta")], wrap=false)
        })
        // (its words laid out: always; or only while a press is in it, or a hold handed it, or once picked)
        let lays = match laid {
          Laid::Always => true
          Laid::Held => p.of("w") || ((c.press().down || c.handed_hold() is Some(_)) && c.press_within(id))
        }
        if lays {
          c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
        }
        if p.hold(c, "w", id) {
          c.take_press()
        }
        p.slide(c)
      }).over(view::Live::Is(true))
      let _ = b.box(fn(cv : view::View) -> Unit {
        let _ = cv
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(400.0)))
        .height(view::Live::Is(Some(200.0)))
        .gesture(
          ui::touch_slop(),
          press=fn(_d : view::Drag) -> Unit { said.push("cover press") },
          tap=fn(_d : view::Drag) -> Unit { said.push("cover tap") },
          drag=fn(d : view::Drag) -> Unit { said.push("cover drag \{d.kind.to_string()}") },
          through=ui::long_press_ms,
        )
      })
    })
  })
  t.draw()
  let (rx, ry, _, rh) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return ((0, 0, false), said) }
  }
  let (x, y) = (rx + 4.0, ry + rh / 2.0)
  t.touch(0, x, y)
  if frames {
    t.draw()
    t.run_for(ui::long_press_ms + pick_later_ms)
  } else {
    t.advance(ui::long_press_ms + pick_later_ms)
  }
  t.touch(2, x, y)
  t.draw()
  let res = ((p.a, p.b, p.of("w")), said)
  t.dispose()
  res
}

test "pick_through_cover_frames_and_no_frames" {
  let want_said = ["cover press", "cover drag Off"]
  let (r1, s1) = picked_through(true)
  debug_assert(r1.0 == 0 && r1.1 == 5 && r1.2 && str_array_eq(s1, want_said), "frames between must pick (0, 5) and cancel cover")
  let (r2, s2) = picked_through(false)
  debug_assert(r2.0 == 0 && r2.1 == 5 && r2.2 && str_array_eq(s2, want_said), "no frame between must pick (0, 5) and cancel cover")
}

test "pick_through_cover_laid_when_held" {
  let want_said = ["cover press", "cover drag Off"]
  let (r1, s1) = picked_through(true, laid=Laid::Held)
  debug_assert(r1.0 == 0 && r1.1 == 5 && r1.2 && str_array_eq(s1, want_said), "laid=Held frames between must pick (0, 5)")
  let (r2, s2) = picked_through(false, laid=Laid::Held)
  debug_assert(r2.0 == 0 && r2.1 == 5 && r2.2 && str_array_eq(s2, want_said), "laid=Held no frame between must pick (0, 5)")
}

/// What comes after a finger held past a long press on words under a cover holding through, with no frame between
/// (handed_lost's): nothing; the press called off instead of let go; or, let go, before a frame: the words not shown in
/// the frame it comes to (shown in the one after), a modal layer over them, their old view taking no presses, the
/// window's tree made anew, a press on a button of the tree's (as it goes down now, or `same`: said to go down at the
/// moment the first did).
enum After {
  Nothing
  Off
  Hidden
  Modal
  Inert
  Anew
  Button(Bool)
}

fn after_name(a : After) -> String {
  match a {
    After::Nothing => "Nothing"
    After::Off => "Off"
    After::Hidden => "Hidden"
    After::Modal => "Modal"
    After::Inert => "Inert"
    After::Anew => "Anew"
    After::Button(same) => if same { "Button(same=true)" } else { "Button(same=false)" }
  }
}

/// Words laid out only as they are held under a cover holding through (picked_through's), a button of the tree's below
/// them, the finger held past a long press with no frame between, then `after`: whether a word is picked once frames come.
fn handed_lost(after : After) -> Bool {
  let p = Pick::new()
  let shown = signals::signal(true)
  let open = signals::signal(true)
  let modal = signals::signal(false)
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit { () }, w=400.0, h=300.0, platform=2)
  t.check_looks(false)
  let make = fn(root : view::View) -> Unit {
    let _ = root.box(fn(b : view::View) -> Unit {
      let _ = b.over(view::Live::Is(true)).width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(300.0)))
      let _ = ui::old(b, fn(c : ui::Ctx) -> Unit {
        if !shown.get() {
          return
        }
        let id = c.id("w")
        c.takes_presses(id)
        let box = c.box(id=id, fn() -> Unit {
          let _ = c.rich([text::plain("alpha beta gamma delta")], wrap=false)
        })
        if p.of("w") || ((c.press().down || c.handed_hold() is Some(_)) && c.press_within(id)) {
          c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
        }
        if p.hold(c, "w", id) {
          c.take_press()
        }
      })
      .over(view::Live::Is(true))
      .presses(view::Live::By(fn() -> Bool { open.get() }))
      let _ = b.box(fn(cv : view::View) -> Unit {
        let _ = cv
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(400.0)))
        .height(view::Live::Is(Some(200.0)))
        .gesture(ui::touch_slop(), through=ui::long_press_ms)
      })
      let _ = b.box(fn(bt : view::View) -> Unit {
        let _ = bt
        .offset(view::Live::Is((0.0, 220.0)))
        .width(view::Live::Is(Some(100.0)))
        .height(view::Live::Is(Some(60.0)))
        .on_press(fn() -> Unit { () })
      })
      let _ = b.box(fn(l : view::View) -> Unit {
        let _ = l.over(view::Live::Is(true)).modal(view::Live::By(fn() -> Bool { modal.get() }))
      })
    })
  }
  ui::set_view_app(make)
  t.draw()
  let (rx, ry, _, rh) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return false }
  }
  let (x, y) = (rx + 4.0, ry + rh / 2.0)
  let down = t.time()
  t.touch(0, x, y)
  t.advance(ui::long_press_ms + pick_later_ms)
  t.touch(if after is After::Off { 3 } else { 2 }, x, y)
  match after {
    After::Hidden => {
      shown.set(false)
      t.draw()
      shown.set(true)
    }
    After::Modal => modal.set(true)
    After::Inert => open.set(false)
    After::Anew => ui::set_view_app(make)
    After::Button(same) =>
    if same {
      t.touch_at(0, 50.0, 250.0, down)
      t.touch_at(2, 50.0, 250.0, down)
    } else {
      t.touch(0, 50.0, 250.0)
      t.touch(2, 50.0, 250.0)
    }
    _ => ()
  }
  t.draw()
  modal.set(false)
  open.set(true)
  t.draw()
  t.draw()
  let res = p.of("w")
  t.dispose()
  res
}

test "pick_through_handed_hold_lost_cases" {
  let cases = [
    After::Off,
    After::Hidden,
    After::Modal,
    After::Inert,
    After::Anew,
    After::Button(false),
    After::Button(true),
  ]
  for a in cases {
    debug_assert(!handed_lost(a), "handed hold interrupted by \{after_name(a)} must not pick later")
  }
  // (none of them: picked, as picked_through has it)
  debug_assert(handed_lost(After::Nothing), "uninterrupted handed hold must pick")
}

/// Words in an old view, under a cover of the tree's: one a finger drags only once held (`held_first`; `swiped`: a
/// finger down on the first word moved past the slop at once, let go there with no other move), or one holding through
/// (not `swiped`: a finger held still on the first word past a long press and let go); frames drawn between or none.
/// What was picked, whether anything was, how many times the words' hold took the press, what the cover was told, and
/// what was felt (a hold handed to words through a cover is felt by nothing of theirs: as with picked_through).
fn picked_under(swiped : Bool, frames : Bool) -> ((Int, Int, Bool), Int, Array[String], Int) {
  let p = Pick::new()
  // (how many times its hold took the press: picked)
  let took = ui::ref_new(0)
  let said : Array[String] = []
  let t = ui::Tester::new(fn(_c : ui::Ctx) -> Unit { () }, w=400.0, h=200.0, platform=2)
  t.check_looks(false)
  ui::set_view_app(fn(root : view::View) -> Unit {
    let _ = root.box(fn(b : view::View) -> Unit {
      let _ = b.over(view::Live::Is(true)).width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
      let _ = ui::old(b, fn(c : ui::Ctx) -> Unit {
        let id = c.id("w")
        c.takes_presses(id)
        let box = c.box(id=id, fn() -> Unit {
          let _ = c.rich([text::plain("alpha beta gamma delta")], wrap=false)
        })
        c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
        if p.hold(c, "w", id) {
          c.take_press()
          took.v = took.v + 1
        }
        p.slide(c)
      }).over(view::Live::Is(true))
      let _ = b.box(fn(cv : view::View) -> Unit {
        let _ = cv.over(view::Live::Is(true)).width(view::Live::Is(Some(400.0))).height(view::Live::Is(Some(200.0)))
        let press = fn(_d : view::Drag) -> Unit { said.push("cover press") }
        let tap = fn(_d : view::Drag) -> Unit { said.push("cover tap") }
        let drag = fn(d : view::Drag) -> Unit { said.push("cover drag \{d.kind.to_string()}") }
        if swiped {
          let _ = cv.gesture(
            ui::touch_slop(),
            press=press,
            tap=tap,
            drag=drag,
            hold=(ui::long_press_ms, fn(_d : view::Drag) -> Unit { said.push("cover held") }),
            held_first=fn(_d : view::Drag) -> Bool { true },
          )
        } else {
          let _ = cv.gesture(ui::touch_slop(), press=press, tap=tap, drag=drag, through=ui::long_press_ms)
        }
      })
    })
  })
  t.draw()
  let (rx, ry, _, rh) = match t.rect_of("alpha beta gamma delta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); return ((0, 0, false), 0, said, 0) }
  }
  let (x, y) = (rx + 4.0, ry + rh / 2.0)
  let t0 = t.time() + pick_later_ms
  t.advance(t0 - t.time())
  t.touch_raw(0, 1, x, y, t0)
  if swiped {
    let at = t0 + pick_later_ms
    if frames {
      t.frame_at(t0 + pick_later_ms / 2.0)
    }
    t.advance(at - t.time())
    t.touch_raw(1, 1, x + ui::touch_slop() * 4.0, y, at)
    t.touch_raw(2, 1, x + ui::touch_slop() * 4.0, y, at)
  } else {
    let at = t0 + ui::long_press_ms + pick_later_ms
    if frames {
      t.frame_at(t0 + pick_later_ms)
      t.frame_at(t0 + ui::long_press_ms + pick_later_ms / 2.0)
    }
    t.advance(at - t.time())
    t.touch_raw(2, 1, x, y, at)
  }
  t.run_for(ui::long_press_ms * 2.0)
  let felt = t.haptics().length()
  let res = ((p.a, p.b, p.of("w")), took.v, said, felt)
  t.dispose()
  res
}

test "pick_under_held_first_swipe_and_through_hold" {
  let want_said = ["cover press", "cover drag Off"]
  for frames in [true, false] {
    let (picked, took, said, felt) = picked_under(true, frames)
    debug_assert(
      !picked.2 && took == 0 && str_array_eq(said, want_said) && felt == 0,
      "swiped under held_first (frames=\{frames}) must pick nothing and trigger no haptics",
    )
    let (h_picked, h_took, h_said, h_felt) = picked_under(false, frames)
    debug_assert(
      h_picked.0 == 0 && h_picked.1 == 5 && h_picked.2 && h_took == 1 && str_array_eq(h_said, want_said) && h_felt == 0,
      "held under through cover (frames=\{frames}) must pick (0, 5) once with no haptics",
    )
  }
}

test "pick_handles_surrogate_pair_clamp" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("😀A")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let (rx, _ry, rw, _rh) = match t.rect_of("😀A") {
    Some(r) => r
    None => { debug_assert(false, "emoji text rect must exist"); t.dispose(); return }
  }
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  p.key = "w"
  p.all(w0)
  t.draw()
  debug_assert(p.a == 0 && p.b == 3, "full surrogate pair + ASCII must be (0, 3), got (\{p.a}, \{p.b})")

  // Drag end handle left past start: must clamp to [0, 2] without splitting the surrogate pair
  let rects1 = w0.rects(p.a, p.b)
  let end_r = rects1[rects1.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(rx - 40.0, end_hy)
  debug_assert(
    p.a == 0 && p.b == 2 && w0.slice(p.a, p.b) == "😀",
    "end handle clamp must keep full surrogate pair [0, 2], got (\{p.a}, \{p.b}) slice=\{w0.slice(p.a, p.b)}",
  )
  t.release(rx - 40.0, end_hy)
  t.draw()

  // With "😀" ([0, 2]) selected, drag start handle right past end: must clamp to [0, 2] and remain non-empty
  let rects2 = w0.rects(p.a, p.b)
  let start_r = rects2[0]
  let start_hx = start_r.0
  let start_hy = start_r.1 + start_r.3 + 8.0
  t.press_at(start_hx, start_hy)
  t.move_to(rx + rw + 40.0, start_hy)
  debug_assert(
    p.a == 0 && p.b == 2 && w0.slice(p.a, p.b) == "😀",
    "start handle clamp must keep full surrogate pair [0, 2], got (\{p.a}, \{p.b}) slice=\{w0.slice(p.a, p.b)}",
  )
  t.release(rx + rw + 40.0, start_hy)
  t.draw()
  t.dispose()
}

test "pick_hold_empty_text_returns_false" {
  let p = Pick::new()
  let held_true = ui::ref_new(false)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      c.takes_presses(id)
      let box = c.box(id=id, w=ui::Size::Px(120.0), h=ui::Size::Px(40.0), fn() -> Unit {
        let _ = c.rich([text::plain("")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      if p.hold(c, "w", id) {
        held_true.v = true
        c.take_press()
      }
    },
    w=400.0,
    h=200.0,
  )
  t.press_at(20.0, 20.0)
  t.run_for(ui::long_press_ms + 50.0)
  t.release(20.0, 20.0)
  t.draw()
  debug_assert(!held_true.v && !p.of("w"), "holding on empty words must return false and not select")
  t.dispose()
}

test "pick_hold_may_false_suppresses_selection" {
  let p = Pick::new()
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("alpha beta")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      if p.hold(c, "w", id, may=false) {
        c.take_press()
      }
    },
    w=400.0,
    h=200.0,
  )
  let (rx, ry, _, rh) = match t.rect_of("alpha beta") {
    Some(r) => r
    None => { debug_assert(false, "text rect must exist"); t.dispose(); return }
  }
  t.press_at(rx + 4.0, ry + rh / 2.0)
  t.run_for(ui::long_press_ms + 50.0)
  t.release(rx + 4.0, ry + rh / 2.0)
  t.draw()
  debug_assert(!p.of("w"), "hold with may=false must not pick")
  t.dispose()
}

test "pick_handles_ignores_extra_ends_beyond_two" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      let h_extra = c.id("h_extra")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("alpha beta")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_extra,
                left=220.0,
                top=120.0,
                w=ui::Size::Px(40.0),
                h=ui::Size::Px(40.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end, h_extra])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  p.key = "w"
  p.all(w0)
  t.draw()
  t.press_at(240.0, 140.0)
  debug_assert(p.handle == 0, "pressing third handle id beyond 2 ends must leave handle == 0, got \{p.handle}")
  t.release(240.0, 140.0)
  t.draw()
  t.dispose()
}

test "pick_handles_clears_handle_on_release_when_rects_empty" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("alpha beta")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
            }
            p.handles(c, w, [h_start, h_end])
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  p.key = "w"
  p.all(w0)
  t.draw()
  let rects = w0.rects(p.a, p.b)
  let end_r = rects[rects.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  debug_assert(p.handle == 2, "end handle must be grabbed")
  // Collapse selection so words.rects(p.a, p.b) is empty when pointer releases
  p.a = p.b
  t.release(end_hx, end_hy)
  t.draw()
  debug_assert(p.handle == 0, "releasing pointer while rects is empty must clear handle to 0, got \{p.handle}")
  t.dispose()
}

test "pick_handles_two_paragraph_synthetic_newline_never_stalls" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain("A")], wrap=false)
        let _ = c.rich([text::plain("B")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  debug_assert(w0.slice(0, 3) == "A\nB", "two rich paragraphs must join with synthetic newline, got \{w0.slice(0, 3)}")
  // Select [0, 2) ("A\n") and drag start handle past end (and across offset 1)
  p.key = "w"
  p.a = 0
  p.b = 2
  t.draw()
  let rects1 = w0.rects(p.a, p.b)
  debug_assert(rects1.length() > 0, "initial [0, 2) must have painted rects")
  let start_r = rects1[0]
  let start_hx = start_r.0
  let start_hy = start_r.1 + start_r.3 + 8.0
  t.press_at(start_hx, start_hy)
  debug_assert(p.handle == 1, "start handle must be grabbed")
  // Drag far right/down past offset 1 and 2: must never land on [1, 2) with 0 rects
  t.move_to(start_hx + 200.0, start_hy + 80.0)
  debug_assert(
    w0.rects(p.a, p.b).length() > 0 && p.a == 0 && p.b == 2,
    "start handle must not stall on synthetic newline [1, 2), got (\{p.a}, \{p.b}) rects=\{w0.rects(p.a, p.b).length()}",
  )
  // Continue dragging after release: end handle can still expand into paragraph B
  t.release(start_hx + 200.0, start_hy + 80.0)
  t.draw()
  let rects2 = w0.rects(p.a, p.b)
  let end_r = rects2[rects2.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(end_hx + 120.0, end_hy + 80.0)
  debug_assert(p.b == 3 && w0.rects(p.a, p.b).length() >= 2, "subsequent end-handle drag must expand to (0, 3), got (\{p.a}, \{p.b})")
  t.release(end_hx + 120.0, end_hy + 80.0)
  t.draw()
  t.dispose()
}

test "pick_handles_combining_grapheme_clamp" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let sample = "e\u{0301}A"
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain(sample)], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let (rx, _ry, rw, _rh) = match t.rect_of(sample) {
    Some(r) => r
    None => { debug_assert(false, "combining grapheme text rect must exist"); t.dispose(); return }
  }
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  p.key = "w"
  p.all(w0)
  t.draw()
  debug_assert(p.a == 0 && p.b == 3, "combining grapheme + ASCII must be (0, 3), got (\{p.a}, \{p.b})")

  // Drag end handle left past start: must clamp to [0, 2) keeping full "e\u{0301}"
  let rects1 = w0.rects(p.a, p.b)
  let end_r = rects1[rects1.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(rx - 40.0, end_hy)
  debug_assert(
    p.a == 0 && p.b == 2 && w0.slice(p.a, p.b) == "e\u{0301}",
    "end handle clamp must keep full combining grapheme [0, 2), got (\{p.a}, \{p.b}) slice=\{w0.slice(p.a, p.b)}",
  )
  t.release(rx - 40.0, end_hy)
  t.draw()

  // With "e\u{0301}" ([0, 2)) selected, drag start handle right past end: must clamp to [0, 2)
  let rects2 = w0.rects(p.a, p.b)
  let start_r = rects2[0]
  let start_hx = start_r.0
  let start_hy = start_r.1 + start_r.3 + 8.0
  t.press_at(start_hx, start_hy)
  t.move_to(rx + rw + 40.0, start_hy)
  debug_assert(
    p.a == 0 && p.b == 2 && w0.slice(p.a, p.b) == "e\u{0301}",
    "start handle clamp must keep full combining grapheme [0, 2), got (\{p.a}, \{p.b}) slice=\{w0.slice(p.a, p.b)}",
  )
  t.release(rx + rw + 40.0, start_hy)
  t.draw()
  t.dispose()
}

test "pick_handles_long_blank_lines_clamp" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let sb = StringBuilder()
  sb.write_string("A")
  let mut i = 0
  while i < 64 {
    sb.write_string("\n")
    i += 1
  }
  sb.write_string("B")
  let sample = sb.to_string()
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::plain(sample)], wrap=true)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=2000.0,
  )
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  debug_assert(w0.utf16_len() == 66, "A + 64 newlines + B must have utf16_len 66, got \{w0.utf16_len()}")

  // Select [0, 65) ("A" + 64 newlines), drag start handle past end: must skip all 64 blank lines back to [0, 65)
  p.key = "w"
  p.a = 0
  p.b = 65
  t.draw()
  let rects1 = w0.rects(p.a, p.b)
  debug_assert(rects1.length() > 0, "initial [0, 65) must have painted rects")
  let start_r = rects1[0]
  let start_hx = start_r.0
  let start_hy = start_r.1 + start_r.3 + 8.0
  t.press_at(start_hx, start_hy)
  t.move_to(start_hx + 120.0, start_hy + 1800.0)
  debug_assert(
    p.a == 0 && p.b == 65 && w0.rects(p.a, p.b).length() > 0,
    "start handle over 64 blank lines must clamp to [0, 65), got (\{p.a}, \{p.b})",
  )
  t.release(start_hx + 120.0, start_hy + 1800.0)
  t.draw()

  // Select all [0, 66), drag end handle past start: must stop at [0, 1) ("A") without swallowing blank lines
  p.all(w0)
  t.draw()
  let rects2 = w0.rects(p.a, p.b)
  let end_r = rects2[rects2.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(-40.0, -40.0)
  debug_assert(
    p.a == 0 && p.b == 1 && w0.slice(p.a, p.b) == "A",
    "end handle over 64 blank lines must clamp to [0, 1) without swallowing newlines, got (\{p.a}, \{p.b})",
  )
  t.release(-40.0, -40.0)
  t.draw()
  t.dispose()
}

