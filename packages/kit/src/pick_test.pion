    debug_assert(
      p.a == 0 && p.b == 1 && w0.slice(p.a, p.b) == "A",
      "end handle on Unicode hard line break must clamp to [0, 1), got (\{p.a}, \{p.b})",
    )
    t.release(-40.0, -40.0)
    t.draw()

    // With [0, 2) ("A" + sep), start handle dragged past end: must keep [0, 2) without stalling on sep
    p.a = 0
    p.b = 2
    t.draw()
    let rects2 = w0.rects(p.a, p.b)
    let start_r = rects2[0]
    let start_hx = start_r.0
    let start_hy = start_r.1 + start_r.3 + 8.0
    t.press_at(start_hx, start_hy)
    t.move_to(start_hx + 200.0, start_hy + 120.0)
    debug_assert(
      p.a == 0 && p.b == 2 && w0.rects(p.a, p.b).length() > 0,
      "start handle on [0, 2) with Unicode hard line break must keep [0, 2), got (\{p.a}, \{p.b})",
    )
    t.release(start_hx + 200.0, start_hy + 120.0)
    t.draw()
    t.dispose()
  }
}

test "pick_handles_empty_text_inline_drawing_no_collapse" {
  let p = Pick::new()
  let last_words : signals::Ref[Option[ui::Words]] = ui::ref_new(None)
  let d = text::InlineDrawing::{
    width: 16.0,
    height: 16.0,
    baseline: 12.0,
    paths: [],
    words: [],
  }
  let t = ui::Tester::new(
    fn(c : ui::Ctx) -> Unit {
      let id = c.id("w")
      let h_start = c.id("h_start")
      let h_end = c.id("h_end")
      c.takes_presses(id)
      let box = c.box(id=id, fn() -> Unit {
        let _ = c.rich([text::span("", drawing=Some(d)), text::plain("A")], wrap=false)
      })
      c.words(box, "w", a=p.a, b=p.b, color=0x3B82F640L)
      match c.words_of("w") {
        Some(w) => {
          last_words.v = Some(w)
          if p.of("w") {
            let rects = w.rects(p.a, p.b)
            if rects.length() > 0 {
              let first = rects[0]
              let last = rects[rects.length() - 1]
              let _ = c.box(
                id=h_start,
                left=first.0 - 8.0,
                top=first.1 + first.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              let _ = c.box(
                id=h_end,
                left=last.0 + last.2 - 8.0,
                top=last.1 + last.3,
                w=ui::Size::Px(16.0),
                h=ui::Size::Px(16.0),
                fn() -> Unit { () },
              )
              p.handles(c, w, [h_start, h_end])
            }
          }
        }
        None => ()
      }
    },
    w=400.0,
    h=200.0,
  )
  let w0 = match last_words.v {
    Some(w) => w
    None => { debug_assert(false, "words must be recorded"); t.dispose(); return }
  }
  p.key = "w"
  p.all(w0)
  t.draw()
  debug_assert(p.a == 0 && p.b == 1 && w0.slice(p.a, p.b) == "A", "initial selection must be [0, 1) A, got (\{p.a}, \{p.b})")

  // Drag end handle left past start: zero-length inline drawing at offset 0 must not collapse selection to [0, 0)
  let rects1 = w0.rects(p.a, p.b)
  debug_assert(rects1.length() > 0, "initial [0, 1) must have painted rects")
  let end_r = rects1[rects1.length() - 1]
  let end_hx = end_r.0 + end_r.2
  let end_hy = end_r.1 + end_r.3 + 8.0
  t.press_at(end_hx, end_hy)
  t.move_to(-40.0, end_hy)
  debug_assert(
    p.a == 0 && p.b == 1 && w0.slice(p.a, p.b) == "A" && w0.rects(p.a, p.b).length() > 0,
    "end handle past empty-text inline drawing must keep [0, 1) A without collapsing, got (\{p.a}, \{p.b})",
  )
  t.release(-40.0, end_hy)
  t.draw()
  t.dispose()
}
