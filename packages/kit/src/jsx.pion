// PascalCase Pion-JSX thin shells delegating 100% to packages/kit primitives.
// Zero-magic protocol: first positional parameter is `parent : view::View`, returns `view::View`;
// dual static/reactive props use `prop? : T` + `prop_by? : () -> T` (`prop_by` takes precedence).

import "view"

fn jsx_live_color(
  color : Option[Int64],
  color_by : Option[() -> Int64],
  fallback : Int64,
) -> view::Live[Int64] {
  match color_by {
    Some(f) => view::Live::By(f)
    None =>
    match color {
      Some(c) => view::Live::Is(c)
      None => view::Live::Is(fallback)
    }
  }
}

fn jsx_bool_getter(v : Bool, by : Option[() -> Bool]) -> () -> Bool {
  match by {
    Some(f) => f
    None => fn() -> Bool { v }
  }
}

/// Pure-GPU built-in vector icon (`<IconView kind={.Refresh} size={16.0} />`).
pub fn IconView(
  parent : view::View,
  kind~ : Icon,
  size~ : Double = 16.0,
  color? : Int64,
  color_by? : () -> Int64,
  stroke_width~ : Double = 2.0,
  loc~ : String = "",
) -> view::View {
  icon(
    parent,
    kind,
    size=size,
    color=jsx_live_color(color, color_by, 0xFFFFFFFF.to_int64()),
    stroke_width=stroke_width,
    loc=loc,
  )
}

/// Pure-GPU custom SVG `d` path icon (`<SvgIcon d="..." size={16.0} />`).
pub fn SvgIcon(
  parent : view::View,
  d~ : String,
  size~ : Double = 16.0,
  viewbox~ : Double = 24.0,
  color? : Int64,
  color_by? : () -> Int64,
  stroke_width~ : Double = 2.0,
  fill~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  svg_icon(
    parent,
    d,
    size=size,
    viewbox=viewbox,
    color=jsx_live_color(color, color_by, 0xFFFFFFFF.to_int64()),
    stroke_width=stroke_width,
    fill=fill,
    loc=loc,
  )
}

/// Single-quad GPU-cached radial glow (`<Glow width={160.0} height={120.0} color_by=>{...} />`).
pub fn Glow(
  parent : view::View,
  width~ : Double,
  height~ : Double,
  color? : Int64,
  color_by? : () -> Int64,
  softness~ : Double = 2.2,
  tex_px~ : Int = 64,
  loc~ : String = "",
) -> view::View {
  radial_glow(
    parent,
    width,
    height,
    jsx_live_color(color, color_by, 0xFFFFFFFF.to_int64()),
    softness=softness,
    tex_px=tex_px,
    loc=loc,
  )
}

/// Scrollable viewport container (`<ScrollArea width={300.0} height={200.0}>...</ScrollArea>`).
pub fn ScrollArea(
  parent : view::View,
  width~ : Double = 0.0,
  height~ : Double = 0.0,
  scroll? : view::Scroll,
  children~ : (view::View) -> Unit = fn(_ : view::View) -> Unit {},
) -> view::View {
  scroll_area(parent, width=width, height=height, scroll?=scroll, children)
}

/// Pressable button (`<Button label="Save" primary on_press=>{...} />`).
pub fn Button(
  parent : view::View,
  label~ : String,
  on_press~ : () -> Unit = fn() -> Unit {},
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  primary~ : Bool = false,
) -> view::View {
  button(
    parent,
    label,
    on_press,
    disabled=jsx_bool_getter(disabled, disabled_by),
    primary=primary,
  )
}

/// Checkbox toggle (`<Checkbox label="Accept" checked_by=>{...} on_change={...} />`).
pub fn Checkbox(
  parent : view::View,
  label~ : String = "",
  checked~ : Bool = false,
  checked_by? : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_ : Bool) -> Unit {},
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
) -> view::View {
  checkbox(
    parent,
    label,
    jsx_bool_getter(checked, checked_by),
    on_change,
    disabled=jsx_bool_getter(disabled, disabled_by),
  )
}

/// Spring toggle switch (`<Switch label="WiFi" checked_by=>{...} on_change={...} />`).
pub fn Switch(
  parent : view::View,
  label~ : String = "",
  checked~ : Bool = false,
  checked_by? : () -> Bool,
  on_change~ : (Bool) -> Unit = fn(_ : Bool) -> Unit {},
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  look? : SwitchLook,
) -> view::View {
  switch(
    parent,
    label,
    jsx_bool_getter(checked, checked_by),
    on_change,
    disabled=jsx_bool_getter(disabled, disabled_by),
    look?=look,
  )
}

/// Horizontal slider (`<Slider label="Volume" value_by=>{...} on_change={...} />`).
pub fn Slider(
  parent : view::View,
  label~ : String = "",
  value~ : Double = 0.0,
  value_by? : () -> Double,
  on_change~ : (Double) -> Unit = fn(_ : Double) -> Unit {},
  min~ : Double = 0.0,
  max~ : Double = 1.0,
  step~ : Double = 0.0,
  width~ : Double = 200.0,
  disabled~ : Bool = false,
  disabled_by? : () -> Bool,
  look? : SliderLook,
) -> view::View {
  let read_val = match value_by {
    Some(f) => f
    None => fn() -> Double { value }
  }
  slider(
    parent,
    label,
    read_val,
    on_change,
    min=min,
    max=max,
    step=step,
    width=width,
    disabled=jsx_bool_getter(disabled, disabled_by),
    look?=look,
  )
}

/// Determinate or indeterminate progress bar (`<Progress value_by=>{...} width={180.0} />`).
pub fn Progress(
  parent : view::View,
  value? : Double,
  value_by? : () -> Option[Double],
  width~ : Double = 200.0,
  label~ : String = "Progress",
  look? : ProgressLook,
) -> view::View {
  let read_val = match value_by {
    Some(f) => f
    None => fn() -> Option[Double] { value }
  }
  progress(parent, read_val, width=width, label=label, look?=look)
}

/// Text input field (`<TextField field={f} placeholder="Name" width={220.0} />`).
pub fn TextField(
  parent : view::View,
  field~ : Field,
  placeholder~ : String = "",
  width~ : Double = 220.0,
  on_submit? : (String) -> Unit,
) -> view::View {
  text_field(parent, field, placeholder=placeholder, width=width, on_submit?=on_submit)
}
