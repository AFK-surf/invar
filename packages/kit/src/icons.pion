// Pure-GPU vector icons backed by pixels::svg_path + paint::shape_of + View::shapes.
// Zero svg/skia dependencies; outlines are flattened and scaled once at node creation.

import "paint"
import "pixels"
import "view"

/// Built-in minimalist 24x24 geometric stroke icons for desktop and app UI.
#derive(Eq)
pub enum Icon {
  Refresh
  Close
  Minimize
  Maximize
  Restore
  Check
  Plus
  Minus
  ChevronLeft
  ChevronRight
  ChevronUp
  ChevronDown
  Search
  Settings
  Info
  Warning
  Sun
  Moon
  Play
  Pause
  Copy
  Trash
  Folder
  ExternalLink
  Sliders
  Power
  Mouse
  Battery
}

/// Standard 24x24 viewBox SVG path data for each built-in `Icon`.
/// All coordinates stay within [1, 23] to preserve stroke headroom.
pub fn icon_path(kind : Icon) -> String {
  match kind {
    Icon::Refresh => "M 20 12 A 8 8 0 1 1 17.66 6.34 M 18 3.5 V 7.5 H 14"
    Icon::Close => "M 6 6 L 18 18 M 18 6 L 6 18"
    Icon::Minimize => "M 5 12 H 19"
    Icon::Maximize => "M 5 5 H 19 V 19 H 5 Z"
    Icon::Restore => "M 8 8 H 19 V 19 H 8 Z M 5 16 V 5 H 16"
    Icon::Check => "M 5 12.5 L 9.5 17 L 19 7.5"
    Icon::Plus => "M 12 5 V 19 M 5 12 H 19"
    Icon::Minus => "M 5 12 H 19"
    Icon::ChevronLeft => "M 15 6 L 9 12 L 15 18"
    Icon::ChevronRight => "M 9 6 L 15 12 L 9 18"
    Icon::ChevronUp => "M 6 15 L 12 9 L 18 15"
    Icon::ChevronDown => "M 6 9 L 12 15 L 18 9"
    Icon::Search => "M 17 10.5 A 6.5 6.5 0 1 0 4 10.5 A 6.5 6.5 0 1 0 17 10.5 Z M 15.2 15.2 L 20 20"
    Icon::Settings => "M 15 12 A 3 3 0 1 0 9 12 A 3 3 0 1 0 15 12 Z M 18.5 12 A 6.5 6.5 0 1 0 5.5 12 A 6.5 6.5 0 1 0 18.5 12 Z M 12 3 V 5.5 M 12 18.5 V 21 M 3 12 H 5.5 M 18.5 12 H 21 M 5.6 5.6 L 7.4 7.4 M 16.6 16.6 L 18.4 18.4 M 18.4 5.6 L 16.6 7.4 M 7.4 16.6 L 5.6 18.4"
    Icon::Info => "M 21 12 A 9 9 0 1 0 3 12 A 9 9 0 1 0 21 12 Z M 12 11 V 16.5 M 12 7.5 V 8.5"
    Icon::Warning => "M 12 3.5 L 21 19.5 H 3 Z M 12 9.5 V 13.5 M 12 16.2 V 17.2"
    Icon::Sun => "M 16 12 A 4 4 0 1 0 8 12 A 4 4 0 1 0 16 12 Z M 12 2.5 V 5 M 12 19 V 21.5 M 2.5 12 H 5 M 19 12 H 21.5 M 5.3 5.3 L 7.1 7.1 M 16.9 16.9 L 18.7 18.7 M 18.7 5.3 L 16.9 7.1 M 7.1 16.9 L 5.3 18.7"
    Icon::Moon => "M 19.5 14.5 A 7.5 7.5 0 1 1 9.5 4.5 A 5.8 5.8 0 0 0 19.5 14.5 Z"
    Icon::Play => "M 7 5 L 19 12 L 7 19 Z"
    Icon::Pause => "M 7 5 H 10 V 19 H 7 Z M 14 5 H 17 V 19 H 14 Z"
    Icon::Copy => "M 9 9 H 19 V 19 H 9 Z M 5 15 V 5 H 15"
    Icon::Trash => "M 4 7 H 20 M 9 7 V 4.5 H 15 V 7 M 6.5 7 L 7.5 20 H 16.5 L 17.5 7 M 10 11 V 16.5 M 14 11 V 16.5"
    Icon::Folder => "M 3.5 6.5 H 9.5 L 11.5 9 H 20.5 V 18.5 H 3.5 Z"
    Icon::ExternalLink => "M 14 5 H 19 V 10 M 11 13 L 19 5 M 18 14 V 19 H 5 V 6 H 10"
    Icon::Sliders => "M 4 7 H 20 M 9 5 V 9 M 4 12 H 20 M 15 10 V 14 M 4 17 H 20 M 11 15 V 19"
    Icon::Power => "M 12 3.5 V 11.5 M 16.8 6.75 A 7.5 7.5 0 1 1 7.2 6.75"
    Icon::Mouse => "M 7 9 A 5 5 0 0 1 17 9 V 15 A 5 5 0 0 1 7 15 Z M 12 7 V 10"
    Icon::Battery => "M 3.5 7.5 H 18.5 V 16.5 H 3.5 Z M 20.5 10 V 14 M 6.5 10.5 V 13.5 M 10 10.5 V 13.5"
  }
}

fn flatten_svg_outlines(d : String, size : Double, viewbox : Double) -> Array[(Array[Double], Bool)] {
  if d == "" || size <= 0.0 || viewbox <= 0.0 {
    return []
  }
  let k = size / viewbox
  let curve_scale = if k * 2.0 > 1.0 { k * 2.0 } else { 1.0 }
  let raw = pixels::svg_path(d, curve_scale)
  let out : Array[(Array[Double], Bool)] = []
  for sub in raw {
    let (pts, closed) = sub
    if pts.length() >= 2 {
      let scaled : Array[Double] = []
      let mut i = 0
      while i + 1 < pts.length() {
        scaled.push(pts[i] * k)
        scaled.push(pts[i + 1] * k)
        i += 2
      }
      out.push((scaled, closed))
    }
  }
  out
}

fn shapes_from_outlines(
  outlines : Array[(Array[Double], Bool)],
  color : Int64,
  stroke_w : Double,
  fill : Bool,
) -> Array[paint::Shape] {
  if outlines.length() == 0 {
    return []
  }
  if fill {
    [paint::shape_of(outlines, fill=color)]
  } else {
    [paint::shape_of(outlines, stroke=color, width=stroke_w)]
  }
}

/// Flatten an SVG `d` path string into scaled GPU `paint::Shape` descriptors in `[0, size]`.
pub fn icon_shapes(
  d : String,
  size~ : Double = 16.0,
  viewbox~ : Double = 24.0,
  color~ : Int64 = 0xFFFFFFFF.to_int64(),
  stroke_width~ : Double = 2.0,
  fill~ : Bool = false,
) -> Array[paint::Shape] {
  let k = if viewbox > 0.0 { size / viewbox } else { 1.0 }
  let outlines = flatten_svg_outlines(d, size, viewbox)
  shapes_from_outlines(outlines, color, stroke_width * k, fill)
}

fn mount_icon_outlines(
  parent : view::View,
  outlines : Array[(Array[Double], Bool)],
  size : Double,
  viewbox : Double,
  color : view::Live[Int64],
  stroke_width : Double,
  fill : Bool,
  loc : String,
) -> view::View {
  let k = if viewbox > 0.0 { size / viewbox } else { 1.0 }
  let sw = stroke_width * k
  let live_shapes : view::Live[Array[paint::Shape]] = match color {
    view::Live::Is(c) => view::Live::Is(shapes_from_outlines(outlines, c, sw, fill))
    view::Live::By(f) => view::Live::By(fn() -> Array[paint::Shape] {
      shapes_from_outlines(outlines, f(), sw, fill)
    })
  }
  parent.box(fn(v : view::View) -> Unit {
    let _ = v
      .width(view::Live::Is(Some(size)))
      .height(view::Live::Is(Some(size)))
      .shrink(view::Live::Is(0.0))
      .shapes(live_shapes, loc=loc)
  })
}

/// Mount a GPU vector icon from an SVG `d` path string.
/// The path is parsed and flattened once at node creation; reactive color changes reuse the cached outlines.
pub fn svg_icon(
  parent : view::View,
  d : String,
  size~ : Double = 16.0,
  viewbox~ : Double = 24.0,
  color~ : view::Live[Int64] = view::Live::Is(0xFFFFFFFF.to_int64()),
  stroke_width~ : Double = 2.0,
  fill~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let outlines = flatten_svg_outlines(d, size, viewbox)
  mount_icon_outlines(parent, outlines, size, viewbox, color, stroke_width, fill, loc)
}

/// Mount a GPU vector icon merging multiple SVG `d` paths into a single `View::shapes` node.
pub fn svg_icon_paths(
  parent : view::View,
  paths : Array[String],
  size~ : Double = 16.0,
  viewbox~ : Double = 24.0,
  color~ : view::Live[Int64] = view::Live::Is(0xFFFFFFFF.to_int64()),
  stroke_width~ : Double = 2.0,
  fill~ : Bool = false,
  loc~ : String = "",
) -> view::View {
  let all_outlines : Array[(Array[Double], Bool)] = []
  for d in paths {
    for sub in flatten_svg_outlines(d, size, viewbox) {
      all_outlines.push(sub)
    }
  }
  mount_icon_outlines(parent, all_outlines, size, viewbox, color, stroke_width, fill, loc)
}

/// Mount a built-in `Icon` as a pure-GPU vector node.
pub fn icon(
  parent : view::View,
  kind : Icon,
  size~ : Double = 16.0,
  color~ : view::Live[Int64] = view::Live::Is(0xFFFFFFFF.to_int64()),
  stroke_width~ : Double = 2.0,
  loc~ : String = "",
) -> view::View {
  svg_icon(
    parent,
    icon_path(kind),
    size=size,
    viewbox=24.0,
    color=color,
    stroke_width=stroke_width,
    fill=false,
    loc=loc,
  )
}
