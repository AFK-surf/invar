// Unit & pure-tree interaction tests for packages/kit under ui::Tester::tree.

import "pixels"
import "signals"
import "ui"
import "view"

test "kit_button_press_and_disabled" {
  let clicks = ui::ref_new(0)
  let disabled = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = button(root, "Save", fn() -> Unit { clicks.v = clicks.v + 1 }, disabled=fn() -> Bool { disabled.get() }, primary=true)
  })
  t.press("Save")
  debug_assert(clicks.v == 1, "button press must invoke handler")
  disabled.set(true)
  t.frame()
  t.press("Save")
  debug_assert(clicks.v == 1, "disabled button must ignore press")
  t.dispose()
}

test "kit_checkbox_toggles_checked_state" {
  let checked = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = checkbox(root, "Accept", fn() -> Bool { checked.get() }, fn(v : Bool) -> Unit { checked.set(v) })
  })
  debug_assert(!checked.get(), "checkbox starts unchecked")
  t.press("Accept")
  debug_assert(checked.get(), "clicking checkbox toggles to checked")
  t.press("Accept")
  debug_assert(!checked.get(), "clicking again toggles back to unchecked")
  t.dispose()
}

test "kit_switch_toggles_and_animates" {
  ui::set_reduced_motion(Some(false))
  let on = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = switch(root, "WiFi", fn() -> Bool { on.get() }, fn(v : Bool) -> Unit { on.set(v) })
  }, transitions_only=false)
  debug_assert(!on.get(), "switch starts off")
  t.press("WiFi")
  debug_assert(on.get(), "pressing switch turns it on")
  t.run_shown(300.0)
  debug_assert(t.scene().ninst > 0, "switch renders track and knob instances")
  t.dispose()
}

test "kit_slider_renders_and_updates_value" {
  let vol = signals::signal(0.25)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = slider(root, "Volume", fn() -> Double { vol.get() }, fn(v : Double) -> Unit { vol.set(v) }, min=0.0, max=1.0, width=200.0)
  })
  debug_assert(t.get("Volume").is_some(), "slider exposes semantic node")
  vol.set(0.75)
  t.frame()
  debug_assert(t.scene().ninst >= 3, "slider draws track, fill, and thumb")
  t.dispose()
}

test "kit_progress_determinate_and_indeterminate" {
  let p = signals::signal(0.4)
  let indet = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = progress(root, fn() -> Option[Double] {
      if indet.get() { None } else { Some(p.get()) }
    }, width=160.0, label="Upload")
  }, transitions_only=false)
  debug_assert(t.get("Upload").is_some(), "progress exposes semantic node")
  p.set(0.9)
  t.run_shown(250.0)
  indet.set(true)
  t.frame(ms=100.0)
  debug_assert(t.scene().ninst >= 2, "indeterminate progress renders track and sweeping bar")
  t.dispose()
}

test "kit_radio_group_selection" {
  let sel = signals::signal("a")
  let entries = [item("a", "Alpha"), item("b", "Beta"), item("c", "Gamma", disabled=true)]
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = radio_group(root, entries, fn() -> String { sel.get() }, fn(v : String) -> Unit { sel.set(v) })
  })
  debug_assert(sel.get() == "a", "initial selection is a")
  t.press("Beta")
  debug_assert(sel.get() == "b", "clicking Beta selects b")
  t.press("Gamma")
  debug_assert(sel.get() == "b", "disabled Gamma cannot be selected")
  t.dispose()
}

test "kit_toggle_group_selection" {
  let sel = signals::signal("day")
  let entries = [item("day", "Day"), item("week", "Week"), item("month", "Month")]
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = toggle_group(root, entries, fn() -> String { sel.get() }, fn(v : String) -> Unit { sel.set(v) })
  })
  t.press("Week")
  debug_assert(sel.get() == "week", "toggle_group switches to week")
  t.press("Month")
  debug_assert(sel.get() == "month", "toggle_group switches to month")
  t.dispose()
}

test "kit_text_field_typing" {
  let f = Field::new(text="hi")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = text_field(root, f, placeholder="Enter name")
  })
  debug_assert(f.text() == "hi", "initial field text")
  f.focus()
  t.type_text("!")
  debug_assert(f.text() == "hi!", "typing appends into kit Field")
  t.dispose()
}

test "kit_dialog_open_and_close" {
  let open = signals::signal(false)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = dialog(root, fn() -> Bool { open.get() }, fn() -> Unit { open.set(false) }, title="Confirm", fn(p : view::View) -> Unit {
      let _ = button(p, "OK", fn() -> Unit { open.set(false) })
    })
  })
  debug_assert(t.get("Confirm").is_none(), "closed dialog is not mounted")
  open.set(true)
  t.frame()
  debug_assert(t.get("Confirm").is_some(), "open dialog renders with semantic title")
  open.set(false)
  t.run_shown(250.0)
  debug_assert(t.get("Confirm").is_none(), "closed dialog unmounts after exit transition")
  t.dispose()
}

test "kit_dropdown_menu_pick_and_close" {
  let open = signals::signal(true)
  let picked = ui::ref_new("")
  let entries = [
    menu_label("Actions"),
    menu_item("copy", "Copy"),
    menu_separator(),
    menu_radio("dark", "Dark Mode", checked=true),
  ]
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = dropdown_menu(
      root,
      entries,
      fn() -> Bool { open.get() },
      fn(id : String) -> Unit { picked.v = id },
      fn() -> Unit { open.set(false) },
    )
  })
  t.press("Copy")
  debug_assert(picked.v == "copy", "picking menu item invokes on_pick")
  debug_assert(!open.get(), "picking menu item closes menu")
  t.dispose()
}

test "kit_sheet_and_in_room_helpers" {
  let open = signals::signal(true)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = in_room(root, max_w=400.0, max_h=300.0, fn(r : view::View) -> Unit {
      let _ = sheet(r, "demo-sheet", fn() -> Bool { open.get() }, fn() -> Unit { open.set(false) }, height=180.0, fn(s : view::View) -> Unit {
        let _ = button(s, "Done", fn() -> Unit { open.set(false) })
      })
    })
  }, transitions_only=false)
  t.frame()
  debug_assert(sheet_place("demo-sheet").is_some(), "open sheet records sheet_place")
  debug_assert(part_id("card", "title") == "card/title", "part_id joins scope and name")
  t.dispose()
}

test "kit_sheet_place_tracks_horizontal_resize_while_open" {
  let open = signals::signal(true)
  let room_w = signals::signal(400.0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = root.box(fn(host : view::View) -> Unit {
      let _ = host
        .width(view::Live::By(fn() -> Option[Double] { Some(room_w.get()) }))
        .height(view::Live::Is(Some(300.0)))
      let _ = in_room(host, max_h=300.0, fn(r : view::View) -> Unit {
        let _ = r.fills_across(view::Live::Is(true))
        let _ = sheet(r, "resize-sheet", fn() -> Bool { open.get() }, fn() -> Unit { open.set(false) }, height=180.0, fn(s : view::View) -> Unit {
          let _ = button(s, "Close", fn() -> Unit { open.set(false) })
        })
      })
    })
  }, width=800.0, height=400.0, transitions_only=false)
  t.frame()
  let w0 = match sheet_place("resize-sheet") {
    Some((_, _, w, _)) => w
    None => { debug_assert(false, "initial sheet_place must exist"); 0.0 }
  }
  debug_assert((w0 - 400.0).abs() < 1.0, "initial sheet_place width should be 400.0, got \{w0}")
  room_w.set(640.0)
  t.frame()
  let w1 = match sheet_place("resize-sheet") {
    Some((_, _, w, _)) => w
    None => { debug_assert(false, "resized sheet_place must exist"); 0.0 }
  }
  debug_assert((w1 - 640.0).abs() < 1.0, "resized sheet_place width should update to 640.0, got \{w1}")
  t.dispose()
}

test "kit_toaster_and_scroll_area" {
  let dismissed = ui::ref_new("")
  let sc = view::Scroll::new()
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = scroll_area(root, width=300.0, height=200.0, scroll=sc, fn(s : view::View) -> Unit {
      let _ = toaster(s, "main", fn() -> Array[(String, String)] { [("t1", "Saved")] }, fn(id : String) -> Unit { dismissed.v = id })
      let mut i = 0
      while i < 10 {
        let idx = i
        let _ = s.box(fn(row : view::View) -> Unit {
          let _ = row.height(view::Live::Is(Some(40.0)))
            .words(view::Live::Is("Row \{idx}"), look=view::words_plain)
        })
        i += 1
      }
    })
  })
  debug_assert(t.scroll_faults().length() == 0, "kit::scroll_area reports 0 scroll_faults")
  debug_assert(t.find("Saved").is_some(), "toaster renders toast message")
  t.press("Saved")
  debug_assert(dismissed.v == "t1", "pressing toast invokes on_dismiss")
  debug_assert(toast_rest("main") >= 0.0, "toast_rest returns non-negative timestamp")

  let before_y = match t.find("Row 1") {
    Some((_, y)) => y
    None => { debug_assert(false, "Row 1 must be drawn"); 0.0 }
  }
  t.wheel(150.0, 100.0, 80.0)
  let tree = match ui::view_tree() {
    Some(tr) => tr
    None => { debug_assert(false, "tree must exist"); return }
  }
  debug_assert(sc.at(tree) > 50.0, "kit::scroll_area actually scrolls on wheel")
  let after_y = match t.find("Row 1") {
    Some((_, y)) => y
    None => { debug_assert(false, "Row 1 must still be drawn"); 0.0 }
  }
  debug_assert(after_y < before_y - 40.0, "kit::scroll_area child shifts upward after wheel")
  t.dispose()
}

test "kit_dialog_center_scrim_and_escape" {
  let open = signals::signal(true)
  let closes = ui::ref_new(0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = dialog(
      root,
      fn() -> Bool { open.get() },
      fn() -> Unit {
        closes.v = closes.v + 1
        open.set(false)
      },
      title="Centered Dialog",
      fn(p : view::View) -> Unit {
        let _ = p.box(fn(b : view::View) -> Unit {
          let _ = b.width(view::Live::Is(Some(200.0))).height(view::Live::Is(Some(80.0)))
            .words(view::Live::Is("Dialog Body"))
        })
      },
    )
  })
  let panel = match t.get("Centered Dialog") {
    Some(d) => d
    None => { debug_assert(false, "dialog panel must be drawn"); return }
  }
  debug_assert(panel.x > 50.0 && panel.y > 50.0, "dialog panel must be centered horizontally and vertically")
  // Clicking inside panel must not close dialog.
  t.click(panel.x + panel.w * 0.5, panel.y + panel.h * 0.5)
  debug_assert(open.get() && closes.v == 0, "clicking inside dialog panel must not trigger on_close")
  // Clicking outside scrim must close dialog.
  t.click(10.0, 10.0)
  debug_assert(!open.get() && closes.v == 1, "clicking outside scrim must trigger on_close")
  // Reopen and press Escape to close.
  open.set(true)
  t.frame()
  debug_assert(t.get("Centered Dialog").is_some(), "reopened dialog must be drawn")
  t.key(ui::key_escape)
  debug_assert(!open.get() && closes.v == 2, "pressing Escape must close dialog")
  t.dispose()
}

test "kit_sheet_bottom_dock_scrim_and_escape" {
  let open = signals::signal(true)
  let closes = ui::ref_new(0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = in_room(root, max_w=400.0, max_h=400.0, fn(r : view::View) -> Unit {
      let _ = sheet(
        r,
        "bottom-dock-sheet",
        fn() -> Bool { open.get() },
        fn() -> Unit {
          closes.v = closes.v + 1
          open.set(false)
        },
        height=180.0,
        fn(s : view::View) -> Unit {
          let _ = s.box(fn(b : view::View) -> Unit {
            let _ = b.words(view::Live::Is("Sheet Content"))
          })
        },
      )
    })
  })
  let mut panel_y = -1.0
  let mut panel_x = -1.0
  for d in t.drawn() {
    if d.h == 180.0 && d.w >= 399.0 {
      panel_x = d.x
      panel_y = d.y
    }
  }
  debug_assert(panel_y > 100.0, "sheet panel must dock near bottom instead of y == 0")
  // Clicking inside sheet panel must not close sheet.
  t.click(panel_x + 40.0, panel_y + 40.0)
  debug_assert(open.get() && closes.v == 0, "clicking inside sheet panel must not trigger on_close")
  // Clicking scrim above sheet must close sheet.
  t.click(20.0, 20.0)
  debug_assert(!open.get() && closes.v == 1, "clicking scrim above sheet must trigger on_close")
  // Reopen and press Escape to close.
  open.set(true)
  t.frame()
  t.key(ui::key_escape)
  debug_assert(!open.get() && closes.v == 2, "pressing Escape must close sheet")
  t.dispose()
}

test "kit_popover_escape_closes" {
  let open = signals::signal(true)
  let closes = ui::ref_new(0)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = popover(
      root,
      fn() -> Bool { open.get() },
      fn() -> Unit {
        closes.v = closes.v + 1
        open.set(false)
      },
      fn(p : view::View) -> Unit {
        let _ = p.words(view::Live::Is("Popover Body"))
      },
    )
  })
  debug_assert(t.find("Popover Body").is_some(), "open popover renders content")
  t.key(ui::key_escape)
  debug_assert(!open.get() && closes.v == 1, "pressing Escape must invoke popover on_close")
  t.dispose()
}

test "kit_toaster_reactive_signal_updates" {
  let toasts : signals::Signal[Array[(String, String)]] = signals::signal_ref([])
  let dismissed = ui::ref_new("")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = toaster(
      root,
      "reactive-toaster",
      fn() -> Array[(String, String)] { toasts.get() },
      fn(id : String) -> Unit { dismissed.v = id },
    )
  })
  debug_assert(t.find("Toast One").is_none() && t.find("Toast Two").is_none(), "toaster starts empty")
  toasts.set([("t1", "Toast One"), ("t2", "Toast Two")])
  t.frame()
  debug_assert(t.find("Toast One").is_some() && t.find("Toast Two").is_some(), "toaster reactively renders 2 toast cards")
  t.press("Toast One")
  debug_assert(dismissed.v == "t1", "clicking first toast invokes on_dismiss with its id")
  toasts.set([("t2", "Toast Two")])
  t.frame()
  debug_assert(t.find("Toast One").is_none() && t.find("Toast Two").is_some(), "toaster reactively removes dismissed toast")
  t.dispose()
}

test "kit_dynamic_theme_switch" {
  let light_th = ui::Theme::light()
  let dark_th = ui::Theme::dark()
  let f = Field::new(text="abc")
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    ui::set_tree_theme(fn() -> ui::Theme { light_th })
    let _ = button(root, "ThemeBtn", fn() -> Unit {})
    let _ = text_field(root, f, placeholder="Name", width=220.0)
  })
  let btn_light = match t.get("ThemeBtn") {
    Some(d) => d
    None => { debug_assert(false, "ThemeBtn must be drawn"); ui::clear_tree_theme(); return }
  }
  debug_assert(btn_light.ground == light_th.surface, "button ground uses light theme initially")
  debug_assert(btn_light.ink == light_th.fg, "button ink uses light theme initially")
  debug_assert(btn_light.h >= 32.0, "button respects 32pt min_height")
  let mut tf_light_ok = false
  for d in t.drawn() {
    if d.w == 220.0 && d.ground == light_th.surface {
      tf_light_ok = true
    }
  }
  debug_assert(tf_light_ok, "text_field ground uses light theme initially")

  ui::set_tree_theme(fn() -> ui::Theme { dark_th })
  t.frame()
  let btn_dark = match t.get("ThemeBtn") {
    Some(d) => d
    None => { debug_assert(false, "ThemeBtn must remain drawn after theme switch"); ui::clear_tree_theme(); return }
  }
  debug_assert(btn_dark.ground == dark_th.surface, "button ground updates live to dark theme")
  debug_assert(btn_dark.ink == dark_th.fg, "button ink updates live to dark theme")
  let mut tf_dark_ok = false
  for d in t.drawn() {
    if d.w == 220.0 && d.ground == dark_th.surface {
      tf_dark_ok = true
    }
  }
  debug_assert(tf_dark_ok, "text_field ground updates live to dark theme")
  ui::clear_tree_theme()
  t.dispose()
}

test "kit_all_28_icons_flatten_in_bounds" {
  let all_icons : Array[Icon] = [
    Icon::Refresh,
    Icon::Close,
    Icon::Minimize,
    Icon::Maximize,
    Icon::Restore,
    Icon::Check,
    Icon::Plus,
    Icon::Minus,
    Icon::ChevronLeft,
    Icon::ChevronRight,
    Icon::ChevronUp,
    Icon::ChevronDown,
    Icon::Search,
    Icon::Settings,
    Icon::Info,
    Icon::Warning,
    Icon::Sun,
    Icon::Moon,
    Icon::Play,
    Icon::Pause,
    Icon::Copy,
    Icon::Trash,
    Icon::Folder,
    Icon::ExternalLink,
    Icon::Sliders,
    Icon::Power,
    Icon::Mouse,
    Icon::Battery,
  ]
  debug_assert(all_icons.length() == 28, "must cover all 28 built-in Icon variants")
  for k in all_icons {
    let shapes = icon_shapes(icon_path(k), size=24.0)
    debug_assert(shapes.length() > 0, "icon_shapes must return non-empty Shape array")
    let mut pt_count = 0
    for sh in shapes {
      debug_assert(sh.outlines.length() > 0, "shape must contain outlines")
      for sub in sh.outlines {
        let pts = sub.0
        debug_assert(pts.length() >= 4, "outline must contain at least 2 points")
        for coord in pts {
          debug_assert(coord >= 0.0 && coord <= 24.0, "outline coordinate must be finite and within [0, 24]")
          pt_count += 1
        }
      }
    }
    debug_assert(pt_count >= 4, "icon must produce flattened vertices")
  }
}

test "kit_icon_and_svg_icon_live_color_switch" {
  let col1 = ui::rgba(255, 80, 40, 255)
  let col2 = ui::rgba(40, 180, 255, 255)
  let tint = signals::signal(col1)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = icon(root, Icon::Check, size=20.0, color=view::Live::By(fn() -> Int64 { tint.get() }))
    let _ = svg_icon(root, "M 4 4 H 20 V 20 H 4 Z", size=18.0, color=view::Live::By(fn() -> Int64 { tint.get() }), fill=true)
    let _ = svg_icon_paths(root, ["M 4 12 H 20", "M 12 4 V 20"], size=16.0, color=view::Live::Is(col1))
  })
  let mut found_icon = false
  let mut found_svg = false
  let mut found_multi = false
  for d in t.drawn() {
    if d.w == 20.0 && d.h == 20.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == col1 && d.shapes[0].stroke != 0L, "icon starts tinted col1 over a stroked shape")
      found_icon = true
    } else if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == col1 && d.shapes[0].fill != 0L, "filled svg_icon starts tinted col1 over a filled shape")
      found_svg = true
    } else if d.w == 16.0 && d.h == 16.0 && d.shapes.length() == 1 {
      debug_assert(
        d.shapes[0].outlines.length() == 2 && d.shapes[0].stroke == col1 && d.tint == 0L,
        "svg_icon_paths merges 2 paths into 1 shape node in its fixed colour, untinted",
      )
      found_multi = true
    }
  }
  debug_assert(found_icon && found_svg && found_multi, "all icon nodes drawn at exact fixed sizes")

  tint.set(col2)
  t.frame()
  let mut updated_icon = false
  let mut updated_svg = false
  for d in t.drawn() {
    if d.w == 20.0 && d.h == 20.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == col2 && d.shapes[0].stroke != 0L, "icon updates its tint reactively")
      updated_icon = true
    } else if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == col2 && d.shapes[0].fill != 0L, "filled svg_icon updates its tint reactively")
      updated_svg = true
    }
  }
  debug_assert(updated_icon && updated_svg, "reactive icon color updates must apply on frame")

  tint.set(0L)
  t.frame()
  let mut clear_icon = false
  let mut clear_svg = false
  for d in t.drawn() {
    if d.w == 20.0 && d.h == 20.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == 0L && d.shapes[0].stroke == 0x01010100L, "icon with a 0 colour keeps the clear placeholder stroke")
      clear_icon = true
    } else if d.w == 18.0 && d.h == 18.0 && d.shapes.length() == 1 {
      debug_assert(d.tint == 0L && d.shapes[0].fill == 0x01010100L, "filled svg_icon with a 0 colour keeps the clear placeholder fill")
      clear_svg = true
    }
  }
  debug_assert(clear_icon && clear_svg, "a 0 colour reaches both live icons")
  t.dispose()
}

test "kit_radial_glow_image_png_edges_and_reset" {
  ui::images_reset()
  let glow_col = ui::rgba(100, 180, 255, 220)
  let key = radial_glow_image(glow_col, softness=2.0, tex_px=32)
  let bytes = match ui::image_bytes_for(key) {
    Some(b) => b
    None => { debug_assert(false, "radial_glow_image must register bytes in ui"); return }
  }
  debug_assert(bytes.length() > 8, "PNG bytes must be non-empty")
  debug_assert(
    bytes[0].to_int() == 0x89 && bytes[1].to_int() == 0x50 && bytes[2].to_int() == 0x4E && bytes[3].to_int() == 0x47,
    "registered bytes must start with PNG magic header",
  )
  match pixels::decode_png(bytes) {
    Some((w, h, rgba)) => {
      debug_assert(w == 32 && h == 32, "decoded PNG dimensions must match tex_px")
      let center_a = rgba[(16 * 32 + 16) * 4 + 3].to_int()
      debug_assert(center_a > 100, "center pixel alpha must be strongly positive")
      let c00 = rgba[(0 * 32 + 0) * 4 + 3].to_int()
      let c01 = rgba[(0 * 32 + 31) * 4 + 3].to_int()
      let c10 = rgba[(31 * 32 + 0) * 4 + 3].to_int()
      let c11 = rgba[(31 * 32 + 31) * 4 + 3].to_int()
      let e_top = rgba[(0 * 32 + 16) * 4 + 3].to_int()
      let e_bot = rgba[(31 * 32 + 16) * 4 + 3].to_int()
      let e_left = rgba[(16 * 32 + 0) * 4 + 3].to_int()
      let e_right = rgba[(16 * 32 + 31) * 4 + 3].to_int()
      debug_assert(c00 == 0 && c01 == 0 && c10 == 0 && c11 == 0, "all four corners must have zero alpha")
      debug_assert(e_top == 0 && e_bot == 0 && e_left == 0 && e_right == 0, "all four edges must have zero alpha")
    }
    None => debug_assert(false, "radial_glow_image PNG must decode cleanly")
  }

  let count_before = ui::image_cache_count()
  let key2 = radial_glow_image(glow_col, softness=2.0, tex_px=32)
  debug_assert(key2 == key, "identical parameters must reuse the same cache key")
  debug_assert(ui::image_cache_count() == count_before, "repeated call must not duplicate image registry entry")

  ui::images_reset()
  debug_assert(ui::image_bytes_for(key).is_none(), "images_reset clears registered glow image")
  let key3 = radial_glow_image(glow_col, softness=2.0, tex_px=32)
  debug_assert(key3 == key, "key remains deterministic after images_reset")
  debug_assert(ui::image_bytes_for(key3).is_some(), "radial_glow_image re-registers automatically after images_reset")
}

test "kit_radial_glow_single_node_and_reactive_color" {
  ui::images_reset()
  let c1 = ui::rgba(255, 120, 60, 180)
  let c2 = ui::rgba(60, 220, 160, 180)
  let sig = signals::signal(c1)
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = radial_glow(root, 180.0, 120.0, view::Live::By(fn() -> Int64 { sig.get() }), softness=2.2, tex_px=32)
  })
  // Root + 1 single glow node = 2 drawn nodes total.
  debug_assert(t.drawn().length() == 2, "radial_glow must mount exactly 1 child view node")
  let mut img_nodes = 0
  let mut first_key = ""
  for d in t.drawn() {
    match d.image {
      Some((k, ph, max_px)) => {
        img_nodes += 1
        first_key = k
        debug_assert(ph == "" && max_px == 0, "radial_glow sets empty placeholder and max_px=0")
        debug_assert(d.w == 180.0 && d.h == 120.0, "radial_glow respects explicit width and height")
        debug_assert(!d.image_cover && !d.image_contain && !d.image_fade, "radial_glow stretches without fade")
      }
      None => ()
    }
  }
  debug_assert(img_nodes == 1 && first_key != "", "radial_glow renders a single image node")

  sig.set(c2)
  t.frame()
  let mut second_key = ""
  for d in t.drawn() {
    match d.image {
      Some((k, _, _)) => second_key = k
      None => ()
    }
  }
  debug_assert(second_key != "" && second_key != first_key, "radial_glow updates image key when Live color changes")
  debug_assert(ui::image_bytes_for(second_key).is_some(), "updated glow image is registered in ui")
  t.dispose()
}

test "kit_icon_close_emits_kind11_stroke_with_zero_rr_fade" {
  let t = ui::Tester::tree(fn(root : view::View) -> Unit {
    let _ = icon(root, Icon::Close, size=40.0, color=view::Live::Is(ui::rgba(0, 0, 0, 255)))
  })
  let sc = t.scene()
  let mut k11 = 0
  let mut i = 0
  while i < sc.ninst {
    let b = i * ui::inst_size
    if (sc.inst[b + 5] - 11.0).abs() < 0.01 {
      k11 += 1
      debug_assert(sc.inst[b + 4] > 0.0, "kit::icon Close stroke band must preserve half-width in slot 4")
      debug_assert(
        sc.inst[b + 36] == 0.0 && sc.inst[b + 37] == 0.0 && sc.inst[b + 38] == 0.0 && sc.inst[b + 39] == 0.0,
        "kit::icon Close without local fade must clear rr slots 36..39 to 0",
      )
    }
    i += 1
  }
  debug_assert(k11 >= 1, "kit::icon Close must emit at least one kind=11 stroke band")
  t.dispose()
}
