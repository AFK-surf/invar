// Pure-tree interactive kit controls: button, checkbox, switch, slider, progress,
// radio_group, toggle_group, text_field, scroll_area.
// Built directly on packages/{view,headless,motion,ui,signals}.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

fn clamp_d(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo { lo } else if v > hi { hi } else { v }
}

/// Pure-tree pressable button backed by `headless::button` with tactile `motion::press_feel`.
pub fn button(
  parent : view::View,
  label : String,
  on_press : () -> Unit,
  disabled~ : () -> Bool = fn() -> Bool { false },
  primary~ : Bool = false,
) -> view::View {
  headless::button(
    parent,
    fn() -> String { label },
    fn(_v : view::View) -> Unit { on_press() },
    fn(v : view::View, _b : headless::Button) -> Unit {
      let _ = motion::press_feel(v, live=fn() -> Bool { !disabled() })
      let _ = v
      .center()
      .min_height(view::Live::Is(Some(32.0)))
      .padding(view::Live::Is((12.0, 8.0, 12.0, 8.0)))
      .corners(view::Live::Is(Some((8.0, 8.0, 8.0, 8.0))))
      .ground(view::Live::By(fn() -> Int64 {
        let th = ui::tree_theme()
        if primary { th.accent } else { th.surface }
      }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        (1.0, ui::tree_theme().border)
      }))
      .alpha(view::Live::By(fn() -> Double { if disabled() { 0.45 } else { 1.0 } }))
      .words(view::Live::Is(label))
      .ink(view::Live::By(fn() -> Int64 {
        if primary { ui::rgba(255, 255, 255, 255) } else { ui::tree_theme().fg }
      }))
    },
    disabled=disabled,
  )
}

/// Pure-tree checkbox backed by `headless::toggle`.
pub fn checkbox(
  parent : view::View,
  label : String,
  checked : () -> Bool,
  on_change : (Bool) -> Unit,
  disabled~ : () -> Bool = fn() -> Bool { false },
) -> view::View {
  let box_size = 18.0
  headless::toggle(
    parent,
    headless::ToggleKind::Checkbox,
    fn() -> String { label },
    checked,
    on_change,
    fn(v : view::View, _t : headless::Toggle) -> Unit {
      let _ = v
      .row(view::Live::Is(true))
      .gap(view::Live::Is(8.0))
      .lines_up(view::Live::Is(Some(view::Along::Middle)))
      let _ = v.box(fn(indicator : view::View) -> Unit {
        let _ = indicator
        .width(view::Live::Is(Some(box_size)))
        .height(view::Live::Is(Some(box_size)))
        .corners(view::Live::Is(Some((4.0, 4.0, 4.0, 4.0))))
        .ground(view::Live::By(fn() -> Int64 {
          let th = ui::tree_theme()
          if checked() { th.accent } else { th.surface }
        }))
        .edge(view::Live::By(fn() -> (Double, Int64) {
          if checked() { (0.0, 0L) } else { (1.5, ui::tree_theme().border) }
        }))
      })
      if label != "" {
        let _ = v.box(fn(lbl : view::View) -> Unit {
          let _ = lbl.words(view::Live::Is(label)).ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
        })
      }
    },
    disabled=disabled,
  )
}

/// Pure-tree toggle switch backed by `headless::toggle` with spring knob motion (`motion::knob_spring`).
pub fn switch(
  parent : view::View,
  label : String,
  checked : () -> Bool,
  on_change : (Bool) -> Unit,
  disabled~ : () -> Bool = fn() -> Bool { false },
  look? : SwitchLook,
) -> view::View {
  let lk = match look { Some(l) => l; None => switch_look_of() }
  let knob_way = motion::NodeWay::new(if signals::untracked(checked) { 1.0 } else { 0.0 })
  let pad = (lk.track_h - lk.knob_size) * 0.5
  let travel = lk.track_w - lk.knob_size - pad * 2.0
  headless::toggle(
    parent,
    headless::ToggleKind::Switch,
    fn() -> String { label },
    checked,
    on_change,
    fn(v : view::View, _t : headless::Toggle) -> Unit {
      v.reacts(checked, fn(on : Bool) -> Unit {
        knob_way.go(v, if on { 1.0 } else { 0.0 }, motion::knob_spring)
      }, at_start=false)
      let tr = lk.track_h * 0.5
      let _ = v
      .width(view::Live::Is(Some(lk.track_w)))
      .height(view::Live::Is(Some(lk.track_h)))
      .corners(view::Live::Is(Some((tr, tr, tr, tr))))
      .ground(view::Live::By(fn() -> Int64 {
        if checked() { lk.on_bg } else { lk.off_bg }
      }))
      .alpha(view::Live::By(fn() -> Double { if disabled() { 0.45 } else { 1.0 } }))
      let _ = v.box(fn(knob : view::View) -> Unit {
        let r = lk.knob_size * 0.5
        let _ = knob
        .width(view::Live::Is(Some(lk.knob_size)))
        .height(view::Live::Is(Some(lk.knob_size)))
        .corners(view::Live::Is(Some((r, r, r, r))))
        .ground(view::Live::Is(lk.knob_bg))
        .offset(view::Live::By(fn() -> (Double, Double) {
          (pad + travel * clamp_d(knob_way.shown(knob), 0.0, 1.0), pad)
        }))
      })
    },
    disabled=disabled,
  )
}

/// Pure-tree horizontal slider backed by `headless::slider`.
pub fn slider(
  parent : view::View,
  label : String,
  value : () -> Double,
  on_change : (Double) -> Unit,
  min~ : Double = 0.0,
  max~ : Double = 1.0,
  step~ : Double = 0.0,
  width~ : Double = 200.0,
  disabled~ : () -> Bool = fn() -> Bool { false },
  look? : SliderLook,
) -> view::View {
  let lk = match look { Some(l) => l; None => slider_look_of() }
  let span = if max > min { max - min } else { 1.0 }
  headless::slider(
    parent,
    fn() -> String { label },
    value,
    min=min,
    max=max,
    step=step,
    on_change,
    fn(v : view::View, _s : headless::Slider) -> Unit {
      let _ = v
      .width(view::Live::Is(Some(width)))
      .height(view::Live::Is(Some(lk.thumb_size + 4.0)))
      let frac = fn() -> Double { clamp_d((value() - min) / span, 0.0, 1.0) }
      let track_y = (lk.thumb_size + 4.0 - lk.track_h) * 0.5
      let _ = v.box(fn(track : view::View) -> Unit {
        let r = lk.track_h * 0.5
        let _ = track
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(width)))
        .height(view::Live::Is(Some(lk.track_h)))
        .offset(view::Live::Is((0.0, track_y)))
        .corners(view::Live::Is(Some((r, r, r, r))))
        .ground(view::Live::Is(lk.track_bg))
        let _ = track.box(fn(fill : view::View) -> Unit {
          let _ = fill
          .width(view::Live::By(fn() -> Option[Double] { Some(width * frac()) }))
          .height(view::Live::Is(Some(lk.track_h)))
          .corners(view::Live::Is(Some((r, r, r, r))))
          .ground(view::Live::Is(lk.fill_bg))
        })
      })
      let _ = v.box(fn(thumb : view::View) -> Unit {
        let r = lk.thumb_size * 0.5
        let _ = thumb
        .over(view::Live::Is(true))
        .width(view::Live::Is(Some(lk.thumb_size)))
        .height(view::Live::Is(Some(lk.thumb_size)))
        .corners(view::Live::Is(Some((r, r, r, r))))
        .ground(view::Live::Is(lk.thumb_bg))
        .offset(view::Live::By(fn() -> (Double, Double) {
          (clamp_d(width * frac() - r, 0.0, width - lk.thumb_size), 2.0)
        }))
      })
    },
    disabled=disabled,
  )
}

/// Pure-tree determinate/indeterminate progress bar backed by `headless::progress` with smooth `motion::NodeWay` fill.
pub fn progress(
  parent : view::View,
  value : () -> Option[Double],
  width~ : Double = 200.0,
  label~ : String = "Progress",
  look? : ProgressLook,
) -> view::View {
  let lk = match look { Some(l) => l; None => progress_look_of() }
  let init_v = match signals::untracked(value) { Some(x) => clamp_d(x, 0.0, 1.0); None => 0.0 }
  let fill_way = motion::NodeWay::new(init_v)
  headless::progress(
    parent,
    value,
    fn(v : view::View, p : headless::Progress) -> Unit {
      let read_val = fn() -> Double {
        match p.value() {
          Some(x) => x
          None => -1.0
        }
      }
      v.reacts(read_val, fn(cur : Double) -> Unit {
        if cur >= 0.0 {
          fill_way.go(v, cur, motion::tween(progress_ms, ease=ui::Ease::Out))
        }
      }, at_start=false)
      let _ = v
      .width(view::Live::Is(Some(width)))
      .height(view::Live::Is(Some(lk.height)))
      .clips(view::Live::Is(true))
      .corners(view::Live::Is(Some((lk.radius, lk.radius, lk.radius, lk.radius))))
      .ground(view::Live::Is(lk.track_bg))
      let _ = v.box(fn(bar : view::View) -> Unit {
        let _ = bar
        .width(view::Live::By(fn() -> Option[Double] {
          if p.indeterminate() {
            Some(width * 0.35)
          } else {
            Some(width * clamp_d(fill_way.shown(bar), 0.0, 1.0))
          }
        }))
        .height(view::Live::Is(Some(lk.height)))
        .offset(view::Live::By(fn() -> (Double, Double) {
          if p.indeterminate() {
            let cyc = motion::resident_cycle(bar, lk.period)
            ((cyc * 1.35 - 0.35) * width, 0.0)
          } else {
            (0.0, 0.0)
          }
        }))
        .corners(view::Live::Is(Some((lk.radius, lk.radius, lk.radius, lk.radius))))
        .ground(view::Live::Is(lk.fill_bg))
      })
    },
    min=0.0,
    max=1.0,
    label=fn() -> String { label },
  )
}

/// Pure-tree radio group over `Array[Entry]` backed by `headless::radio_group`.
pub fn radio_group(
  parent : view::View,
  entries : Array[Entry],
  selected : () -> String,
  on_select : (String) -> Unit,
  row~ : Bool = false,
) -> view::View {
  headless::radio_group(
    parent,
    fn() -> String { "" },
    selected,
    on_select,
    fn(group : view::View, rg : headless::RadioGroup[String]) -> Unit {
      let _ = group.row(view::Live::Is(row)).gap(view::Live::Is(8.0))
      for entry in entries {
        let eid = entry.id
        let elabel = entry.label
        let edisabled = entry.disabled
        let _ = rg.item(
          group,
          fn() -> String { eid },
          fn() -> String { elabel },
          fn(opt : view::View, ri : headless::RadioItem) -> Unit {
            let _ = opt
            .row(view::Live::Is(true))
            .gap(view::Live::Is(6.0))
            .lines_up(view::Live::Is(Some(view::Along::Middle)))
            .padding(view::Live::Is((8.0, 6.0, 8.0, 6.0)))
            .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
            .ground(view::Live::By(fn() -> Int64 {
              if ri.chosen() { ui::tree_theme().surface } else { 0L }
            }))
            let _ = opt.box(fn(dot : view::View) -> Unit {
              let _ = dot
              .width(view::Live::Is(Some(14.0)))
              .height(view::Live::Is(Some(14.0)))
              .corners(view::Live::Is(Some((7.0, 7.0, 7.0, 7.0))))
              .ground(view::Live::By(fn() -> Int64 {
                if ri.chosen() { ui::tree_theme().accent } else { 0L }
              }))
              .edge(view::Live::By(fn() -> (Double, Int64) {
                if ri.chosen() { (0.0, 0L) } else { (1.5, ui::tree_theme().border) }
              }))
            })
            let _ = opt.box(fn(lbl : view::View) -> Unit {
              let _ = lbl.words(view::Live::Is(elabel)).ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
            })
          },
          disabled=fn() -> Bool { edisabled },
        )
      }
    },
    axis=headless::GroupAxis::Both,
  )
}

/// Pure-tree segmented toggle group over `Array[Entry]` backed by `headless::toggle_group`.
pub fn toggle_group(
  parent : view::View,
  entries : Array[Entry],
  selected : () -> String,
  on_select : (String) -> Unit,
) -> view::View {
  headless::toggle_group(
    parent,
    fn() -> String { "" },
    fn(k : String) -> Bool { selected() == k },
    fn(k : String, _on : Bool) -> Unit { on_select(k) },
    fn(group : view::View, tg : headless::ToggleGroup[String]) -> Unit {
      let _ = group
      .row(view::Live::Is(true))
      .gap(view::Live::Is(4.0))
      .padding(view::Live::Is((3.0, 3.0, 3.0, 3.0)))
      .corners(view::Live::Is(Some((8.0, 8.0, 8.0, 8.0))))
      .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
      .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }))
      for entry in entries {
        let eid = entry.id
        let elabel = entry.label
        let edisabled = entry.disabled
        let _ = tg.item(
          group,
          eid,
          fn() -> String { elabel },
          fn(seg : view::View, t : headless::Toggle) -> Unit {
            let _ = motion::press_feel(seg, live=fn() -> Bool { !t.disabled() })
            let _ = seg
            .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
            .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
            .ground(view::Live::By(fn() -> Int64 {
              if t.on() { ui::tree_theme().accent } else { 0L }
            }))
            .words(view::Live::Is(elabel))
            .ink(view::Live::By(fn() -> Int64 {
              if t.on() { ui::rgba(255, 255, 255, 255) } else { ui::tree_theme().fg }
            }))
          },
          disabled=fn() -> Bool { edisabled },
        )
      }
    },
    kind=headless::ToggleGroupKind::Single,
    axis=headless::GroupAxis::Horizontal,
  )
}

/// Pure-tree text input field backed by `headless::TextField` and `ui::field`.
pub fn text_field(
  parent : view::View,
  f : Field,
  placeholder~ : String = "",
  width~ : Double = 220.0,
  on_submit? : (String) -> Unit,
  label~ : String = "",
  description~ : String = "",
  error~ : String = "",
  invalid~ : () -> Bool = fn() -> Bool { false },
  disabled~ : () -> Bool = fn() -> Bool { false },
  read_only~ : () -> Bool = fn() -> Bool { false },
) -> view::View {
  let tf = headless::TextField::new(
    fn() -> String { if label != "" { label } else { placeholder } },
    description=fn() -> String { description },
    error=fn() -> String { error },
    invalid=invalid,
    disabled=disabled,
    read_only=read_only,
  )
  let submit_cb : Option[(String) -> Unit] = match on_submit {
    Some(cb) => Some(fn(s : String) -> Unit {
      if !disabled() && !read_only() {
        cb(s)
      }
    })
    None => None
  }
  let mount_input = fn(host : view::View) -> view::View {
    host.box(fn(wrap : view::View) -> Unit {
      let _ = wrap
      .width(view::Live::Is(Some(width)))
      .padding(view::Live::Is((10.0, 7.0, 10.0, 7.0)))
      .corners(view::Live::Is(Some((8.0, 8.0, 8.0, 8.0))))
      .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
      .alpha(view::Live::By(fn() -> Double { if tf.disabled() { 0.45 } else { 1.0 } }))
      .edge(view::Live::By(fn() -> (Double, Int64) {
        let th = ui::tree_theme()
        if tf.invalid() {
          (1.5, ui::rgba(220, 53, 69, 255))
        } else if f.focused() || tf.focused() {
          (1.5, th.accent)
        } else {
          (1.0, th.border)
        }
      }))
      let input_node = ui::field(
        wrap,
        f.inner,
        placeholder=placeholder,
        submitted?=submit_cb,
        label=if label != "" { label } else { placeholder },
      )
      let _ = tf.control(
        input_node,
        fn(v : view::View, _c : headless::TextField) -> Unit {
          v.reacts(fn() -> Bool { v.focused() }, fn(on : Bool) -> Unit {
            if on && !disabled() {
              f.focus()
            }
          }, at_start=false)
        },
        value=fn() -> String { f.text() },
        in_node=true,
      )
    })
  }
  if label == "" && description == "" && error == "" {
    mount_input(parent)
  } else {
    parent.box(fn(col : view::View) -> Unit {
      let _ = col.gap(view::Live::Is(4.0))
      if label != "" {
        let _ = tf.label(col, fn(lv : view::View) -> Unit {
          let _ = lv.words(view::Live::Is(label)).ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
        })
      }
      let _ = mount_input(col)
      if description != "" {
        let _ = tf.description(col, fn(dv : view::View) -> Unit {
          let _ = dv.words(view::Live::By(fn() -> String { tf.description_text() }))
            .ink(view::Live::By(fn() -> Int64 { ui::tree_theme().muted }))
        })
      }
      if error != "" {
        let _ = tf.error(col, fn(ev : view::View) -> Unit {
          let _ = ev.words(view::Live::By(fn() -> String { tf.error_text() }))
            .ink(view::Live::Is(ui::rgba(220, 53, 69, 255)))
        })
      }
    })
  }
}

/// Pure-tree scrollable viewport container (`@kit.scroll_area`).
pub fn scroll_area(
  parent : view::View,
  width~ : Double = 0.0,
  height~ : Double = 0.0,
  scroll? : view::Scroll,
  make : (view::View) -> Unit,
) -> view::View {
  let s = match scroll {
    Some(sc) => sc
    None => view::Scroll::new()
  }
  parent.box(fn(v : view::View) -> Unit {
    let _ = v.scrolls(
      s,
      make,
      slop=ui::touch_slop(),
      bar=ui::tree_scroll_bar(),
      fill=(height <= 0.0 && width <= 0.0),
    )
    if width > 0.0 {
      let _ = v.width(view::Live::Is(Some(width)))
    }
    if height > 0.0 {
      let _ = v.height(view::Live::Is(Some(height)))
    } else if width > 0.0 {
      let _ = v.fill()
      let _ = v.width(view::Live::Is(Some(width)))
    }
  })
}
