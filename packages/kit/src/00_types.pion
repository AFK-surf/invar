// Core pure-tree kit types, look descriptors, menu entries, and layout helpers.
// Aligns 100% of downstream @kit.* types and look helpers over view/headless/motion/ui.

import "motion"
import "ui"
import "view"

pub let progress_ms : Double = motion::progress_ms

/// Compose a deterministic hierarchical part identifier.
pub fn part_id(ns : String, name : String) -> String {
  if ns == "" { name } else { "\{ns}/\{name}" }
}

/// Popover/tooltip/hover-card visual state passed to custom look renderers.
pub struct PopState {
  pub open : Bool
  pub progress : Double
  pub side : view::Side
  pub along : view::Along
}

/// Switch visual state passed to custom look renderers.
pub struct SwitchState {
  pub checked : Bool
  pub disabled : Bool
  pub hovered : Bool
  pub pressed : Bool
  pub knob_progress : Double
}

/// Menu item visual state passed to custom look renderers.
pub struct MenuItemState {
  pub id : String
  pub label : String
  pub disabled : Bool
  pub active : Bool
  pub checked : Bool
  pub danger : Bool
}

/// Menu entry item kind.
#derive(Eq)
pub enum EntryKind {
  Action
  Radio
  Label
  Separator
}

/// Declarative menu / toggle-group / radio-group entry.
pub struct Entry {
  pub kind : EntryKind
  pub id : String
  pub label : String
  pub note : String
  pub disabled : Bool
  pub checked : Bool
  pub danger : Bool
}

/// Construct a standard selectable entry (`@kit.item`).
pub fn item(
  id : String,
  label : String,
  note~ : String = "",
  disabled~ : Bool = false,
  checked~ : Bool = false,
  danger~ : Bool = false,
) -> Entry {
  Entry::{ kind: EntryKind::Action, id, label, note, disabled, checked, danger }
}

/// Construct a clickable menu item entry (`@kit.menu_item`).
pub fn menu_item(
  id : String,
  label : String,
  note~ : String = "",
  disabled~ : Bool = false,
  danger~ : Bool = false,
) -> Entry {
  Entry::{ kind: EntryKind::Action, id, label, note, disabled, checked: false, danger }
}

/// Construct a radio menu item entry (`@kit.menu_radio`).
pub fn menu_radio(
  id : String,
  label : String,
  checked~ : Bool = false,
  disabled~ : Bool = false,
) -> Entry {
  Entry::{ kind: EntryKind::Radio, id, label, note: "", disabled, checked, danger: false }
}

/// Construct a non-interactive section label entry (`@kit.menu_label`).
pub fn menu_label(label : String) -> Entry {
  Entry::{ kind: EntryKind::Label, id: "", label, note: "", disabled: true, checked: false, danger: false }
}

/// Construct a visual menu separator entry (`@kit.menu_separator`).
pub fn menu_separator() -> Entry {
  Entry::{ kind: EntryKind::Separator, id: "", label: "", note: "", disabled: true, checked: false, danger: false }
}

/// Active menu handle returned by `dropdown_menu`.
pub struct Menu {
  pub open : Bool
  pub picked : Option[String]
  pub node : view::View
}

/// Text field controller wrapper (`@kit.Field`) backed by `ui::Field`.
pub struct Field {
  pub inner : ui::Field
}

pub fn Field::new(text~ : String = "") -> Field {
  Field::{ inner: ui::Field::new(text=text) }
}

pub fn Field::text(self : Field) -> String {
  self.inner.text()
}

pub fn Field::set(self : Field, s : String) -> Unit {
  self.inner.set(s)
}

pub fn Field::focus(self : Field) -> Unit {
  self.inner.focus()
}

pub fn Field::focused(self : Field) -> Bool {
  self.inner.focused()
}

/// Visual look configuration for `popover`.
pub struct PopoverLook {
  pub bg : Int64
  pub border : Int64
  pub radius : Double
  pub pad : Double
  pub shadow_blur : Double
  pub shadow_y : Double
  pub shadow_color : Int64
}

pub fn popover_look(
  bg? : Int64,
  border? : Int64,
  radius~ : Double = 12.0,
  pad~ : Double = 8.0,
  shadow_blur~ : Double = 18.0,
  shadow_y~ : Double = 6.0,
) -> PopoverLook {
  let th = ui::tree_theme()
  PopoverLook::{
    bg: match bg { Some(c) => c; None => th.surface },
    border: match border { Some(c) => c; None => th.border },
    radius,
    pad,
    shadow_blur,
    shadow_y,
    shadow_color: ui::rgba(0, 0, 0, 48),
  }
}

/// Visual look configuration for `switch`.
pub struct SwitchLook {
  pub track_w : Double
  pub track_h : Double
  pub knob_size : Double
  pub on_bg : Int64
  pub off_bg : Int64
  pub knob_bg : Int64
}

pub fn switch_look_of(
  track_w~ : Double = 40.0,
  track_h~ : Double = 22.0,
  knob_size~ : Double = 18.0,
  on_bg? : Int64,
  off_bg? : Int64,
  knob_bg? : Int64,
) -> SwitchLook {
  let th = ui::tree_theme()
  SwitchLook::{
    track_w,
    track_h,
    knob_size,
    on_bg: match on_bg { Some(c) => c; None => th.accent },
    off_bg: match off_bg { Some(c) => c; None => th.border },
    knob_bg: match knob_bg { Some(c) => c; None => ui::rgba(255, 255, 255, 255) },
  }
}

/// Visual look configuration for `slider`.
pub struct SliderLook {
  pub track_h : Double
  pub thumb_size : Double
  pub track_bg : Int64
  pub fill_bg : Int64
  pub thumb_bg : Int64
}

pub fn slider_look_of(
  track_h~ : Double = 4.0,
  thumb_size~ : Double = 16.0,
  track_bg? : Int64,
  fill_bg? : Int64,
  thumb_bg? : Int64,
) -> SliderLook {
  let th = ui::tree_theme()
  SliderLook::{
    track_h,
    thumb_size,
    track_bg: match track_bg { Some(c) => c; None => th.border },
    fill_bg: match fill_bg { Some(c) => c; None => th.accent },
    thumb_bg: match thumb_bg { Some(c) => c; None => ui::rgba(255, 255, 255, 255) },
  }
}

/// Visual look configuration for `progress`.
pub struct ProgressLook {
  pub height : Double
  pub radius : Double
  pub track_bg : Int64
  pub fill_bg : Int64
  pub period : Double
}

pub fn progress_look_of(
  height~ : Double = 6.0,
  radius~ : Double = 3.0,
  track_bg? : Int64,
  fill_bg? : Int64,
  period~ : Double = motion::progress_sweep_ms,
) -> ProgressLook {
  let th = ui::tree_theme()
  ProgressLook::{
    height,
    radius,
    track_bg: match track_bg { Some(c) => c; None => th.border },
    fill_bg: match fill_bg { Some(c) => c; None => th.accent },
    period,
  }
}

/// Constrain `make` within a bounded clipped container of at most `max_w` x `max_h` (`@kit.in_room`).
pub fn in_room(
  parent : view::View,
  max_w~ : Double = 0.0,
  max_h~ : Double = 0.0,
  make : (view::View) -> Unit,
) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let _ = v.clips(view::Live::Is(true))
    if max_w > 0.0 {
      let _ = v.width(view::Live::Is(Some(max_w)))
    }
    if max_h > 0.0 {
      let _ = v.height(view::Live::Is(Some(max_h)))
    }
    make(v)
  })
}

fn make_said(
  role : view::Role,
  label : String,
  value~ : String = "",
  check? : view::Check,
  expanded? : Bool,
  selected? : Bool,
) -> Option[view::Said] {
  Some(view::Said::{
    role,
    label,
    description: "",
    value,
    range: None,
    check,
    expanded,
    selected,
    pressed: None,
    actions: [],
  })
}
