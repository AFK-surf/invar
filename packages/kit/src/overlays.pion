// Pure-tree overlay kit components: dialog, popover, tooltip, hover_card, dropdown_menu,
// sheet (+ sheet_place / sheet_top / sheet_rest), and toaster (+ toast_rest).
// Built on packages/{view,headless,motion,ui,signals}.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

let sheet_places : Map[String, (Double, Double, Double, Double)] = Map::new()
let sheet_tops : Map[String, Double] = Map::new()
let sheet_rests : Map[String, Double] = Map::new()

pub fn sheet_place(key : String) -> Option[(Double, Double, Double, Double)] {
  sheet_places.get(key)
}

pub fn sheet_top(key : String) -> Double {
  match sheet_tops.get(key) {
    Some(y) => y
    None => 0.0
  }
}

pub fn sheet_rest(key : String) -> Double {
  match sheet_rests.get(key) {
    Some(t) => t
    None => 0.0
  }
}

pub fn toast_rest(key : String) -> Double {
  match headless::toaster_rest(key) {
    Some(t) => t
    None => 0.0
  }
}

/// Pure-tree modal dialog with backdrop scrim and `motion::dialog_in` / `motion::dialog_out`.
pub fn dialog(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title~ : String = "",
  make : (view::View) -> Unit,
) -> view::View {
  let th = ui::tree_theme()
  parent.box(fn(host_box : view::View) -> Unit {
    host_box.show(open, fn(layer : view::View) -> Unit {
      let (look, modal_live) = motion::overlay_presence(layer, enter=motion::dialog_in, exit=motion::dialog_out)
      let _ = layer
        .over(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .height_share(view::Live::Is(1.0))
        .ground(view::Live::Is(ui::rgba(0, 0, 0, 110)))
        .alpha(view::Live::By(fn() -> Double { look().alpha }))
        .presses(view::Live::By(modal_live))
        .on_press(on_close)
      let _ = layer.box(fn(panel : view::View) -> Unit {
        let _ = panel
          .padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))
          .corners(view::Live::Is(Some((14.0, 14.0, 14.0, 14.0))))
          .ground(view::Live::Is(th.surface))
          .edge(view::Live::Is((1.0, th.border)))
          .scale(view::Live::By(fn() -> Double { look().sx }))
          .offset(view::Live::By(fn() -> (Double, Double) { (look().dx, look().dy) }))
          .says(view::Live::Is(make_said(view::Role::Dialog, title, expanded=true)))
        if title != "" {
          let _ = panel.box(fn(h : view::View) -> Unit {
            let _ = h.words(view::Live::Is(title)).ink(view::Live::Is(th.fg))
          })
        }
        make(panel)
      })
    }, leave=motion::dialog_out_ms)
  })
}

/// Pure-tree anchored popover with `motion::pop_in` / `motion::pop_out`.
pub fn popover(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  look? : PopoverLook,
  make : (view::View) -> Unit,
) -> view::View {
  let lk = match look { Some(l) => l; None => popover_look() }
  parent.box(fn(host_box : view::View) -> Unit {
    host_box.show(open, fn(pop : view::View) -> Unit {
      let (ov_look, live) = motion::overlay_presence(pop, enter=motion::pop_in, exit=motion::pop_out)
      let _ = pop
        .over(view::Live::Is(true))
        .padding(view::Live::Is((lk.pad, lk.pad, lk.pad, lk.pad)))
        .corners(view::Live::Is(Some((lk.radius, lk.radius, lk.radius, lk.radius))))
        .ground(view::Live::Is(lk.bg))
        .edge(view::Live::Is((1.0, lk.border)))
        .alpha(view::Live::By(fn() -> Double { ov_look().alpha }))
        .scale(view::Live::By(fn() -> Double { ov_look().sx }))
        .presses(view::Live::By(live))
      let _ = on_close
      make(pop)
    }, leave=motion::pop_out_ms)
  })
}

/// Pure-tree tooltip bubble revealed on hover/focus.
pub fn tooltip(
  parent : view::View,
  text : String,
  trigger : (view::View) -> Unit,
) -> view::View {
  let th = ui::tree_theme()
  let open = signals::signal(false)
  parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.box(fn(trig : view::View) -> Unit {
      trig.reacts(fn() -> Bool { trig.pointed() || trig.focus_shown() }, fn(on : Bool) -> Unit {
        open.set(on)
      })
      trigger(trig)
    })
    wrap.show(fn() -> Bool { open.get() }, fn(tip : view::View) -> Unit {
      let (ov_look, _) = motion::overlay_presence(tip, enter=motion::tip_in, exit=motion::tip_out)
      let _ = tip
        .over(view::Live::Is(true))
        .padding(view::Live::Is((8.0, 5.0, 8.0, 5.0)))
        .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
        .ground(view::Live::Is(th.surface))
        .edge(view::Live::Is((1.0, th.border)))
        .alpha(view::Live::By(fn() -> Double { ov_look().alpha }))
        .words(view::Live::Is(text))
        .ink(view::Live::Is(th.fg))
        .presses(view::Live::Is(false))
    }, leave=motion::tip_out_ms)
  })
}

/// Pure-tree hover card revealed when hovering the trigger.
pub fn hover_card(
  parent : view::View,
  trigger : (view::View) -> Unit,
  card : (view::View) -> Unit,
) -> view::View {
  let open = signals::signal(false)
  parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.box(fn(trig : view::View) -> Unit {
      trig.reacts(fn() -> Bool { trig.pointed() }, fn(on : Bool) -> Unit {
        open.set(on)
      })
      trigger(trig)
    })
    let _ = popover(wrap, fn() -> Bool { open.get() }, fn() -> Unit { open.set(false) }, card)
  })
}

/// Pure-tree dropdown menu over `Array[Entry]`.
pub fn dropdown_menu(
  parent : view::View,
  entries : Array[Entry],
  open : () -> Bool,
  on_pick : (String) -> Unit,
  on_close : () -> Unit,
) -> Menu {
  let th = ui::tree_theme()
  let last_picked : ui::Ref[Option[String]] = ui::ref_new(None)
  let node = popover(parent, open, on_close, fn(panel : view::View) -> Unit {
    let _ = panel.gap(view::Live::Is(2.0))
    for entry in entries {
      match entry.kind {
        EntryKind::Separator => {
          let _ = panel.box(fn(sep : view::View) -> Unit {
            let _ = sep.height(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true)).ground(view::Live::Is(th.border))
          })
        }
        EntryKind::Label => {
          let _ = panel.box(fn(lbl : view::View) -> Unit {
            let _ = lbl.padding(view::Live::Is((8.0, 4.0, 8.0, 4.0))).words(view::Live::Is(entry.label)).ink(view::Live::Is(th.muted))
          })
        }
        EntryKind::Action | EntryKind::Radio => {
          let eid = entry.id
          let elabel = entry.label
          let edisabled = entry.disabled
          let _ = panel.box(fn(row : view::View) -> Unit {
            let _ = row
              .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
              .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
              .words(view::Live::Is(elabel))
              .ink(view::Live::Is(if edisabled { th.muted } else { th.fg }))
              .says(view::Live::Is(make_said(view::Role::MenuItem, elabel, value=eid)))
              .on_press(fn() -> Unit {
                if !edisabled {
                  last_picked.v = Some(eid)
                  on_pick(eid)
                  on_close()
                }
              })
          })
        }
      }
    }
  })
  Menu::{ open: signals::untracked(open), picked: last_picked.v, node }
}

/// Pure-tree bottom sheet with scrim fade and rest/place tracking (`sheet_place`, `sheet_top`, `sheet_rest`).
pub fn sheet(
  parent : view::View,
  key : String,
  open : () -> Bool,
  on_close : () -> Unit,
  height~ : Double = 320.0,
  make : (view::View) -> Unit,
) -> view::View {
  let th = ui::tree_theme()
  let slide = motion::NodeWay::new(if signals::untracked(open) { 0.0 } else { height })
  parent.box(fn(host_box : view::View) -> Unit {
    host_box.reacts(open, fn(on : Bool) -> Unit {
      slide.go(host_box, if on { 0.0 } else { height }, motion::carousel_spring)
      sheet_rests[key] = slide.end()
    }, at_start=false)
    host_box.show(open, fn(layer : view::View) -> Unit {
      let _ = layer
        .over(view::Live::Is(true))
        .fills_across(view::Live::Is(true))
        .height_share(view::Live::Is(1.0))
        .ground(view::Live::Is(ui::rgba(0, 0, 0, 100)))
        .on_press(on_close)
      let _ = layer.box(fn(panel : view::View) -> Unit {
        let _ = panel
          .fills_across(view::Live::Is(true))
          .height(view::Live::Is(Some(height)))
          .padding(view::Live::Is((16.0, 12.0, 16.0, 16.0)))
          .corners(view::Live::Is(Some((16.0, 16.0, 0.0, 0.0))))
          .ground(view::Live::Is(th.surface))
          .offset(view::Live::By(fn() -> (Double, Double) {
            let y = slide.shown(panel)
            sheet_tops[key] = y
            sheet_places[key] = (0.0, y, panel.laid_size().0, height)
            (0.0, y)
          }))
        make(panel)
      })
    }, leave=motion::sheet_scrim_ms)
  })
}

/// Pure-tree toast stack host (`@kit.toaster`).
pub fn toaster(
  parent : view::View,
  key : String,
  items : () -> Array[(String, String)],
  on_dismiss : (String) -> Unit,
) -> view::View {
  let _ = key
  let th = ui::tree_theme()
  parent.box(fn(stack : view::View) -> Unit {
    let _ = stack
      .over(view::Live::Is(true))
      .gap(view::Live::Is(8.0))
      .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
    let cur = items()
    for pair in cur {
      let tid = pair.0
      let msg = pair.1
      let _ = stack.box(fn(card : view::View) -> Unit {
        let _ = card
          .padding(view::Live::Is((12.0, 8.0, 12.0, 8.0)))
          .corners(view::Live::Is(Some((10.0, 10.0, 10.0, 10.0))))
          .ground(view::Live::Is(th.surface))
          .edge(view::Live::Is((1.0, th.border)))
          .words(view::Live::Is(msg))
          .ink(view::Live::Is(th.fg))
          .on_press(fn() -> Unit { on_dismiss(tid) })
      })
    }
  })
}
