// Pure-tree overlay kit components: dialog, popover, tooltip, hover_card, dropdown_menu,
// sheet (+ sheet_place / sheet_top / sheet_rest), and toaster (+ toast_rest).
// Built on packages/{view,headless,motion,ui,signals}.

import "headless"
import "motion"
import "signals"
import "ui"
import "view"

let sheet_places : Map[String, (Double, Double, Double, Double)] = Map::new()
let sheet_tops : Map[String, Double] = Map::new()
let sheet_rests : Map[String, Double] = Map::new()

pub fn sheet_place(key : String) -> Option[(Double, Double, Double, Double)] {
  sheet_places.get(key)
}

pub fn sheet_top(key : String) -> Double {
  match sheet_tops.get(key) {
    Some(y) => y
    None => 0.0
  }
}

pub fn sheet_rest(key : String) -> Double {
  match sheet_rests.get(key) {
    Some(t) => t
    None => 0.0
  }
}

pub fn toast_rest(key : String) -> Double {
  match headless::toaster_rest(key) {
    Some(t) => if t < 0.0 { 0.0 } else { t }
    None => 0.0
  }
}

/// Pure-tree modal dialog backed by `headless::dialog` with backdrop scrim and `motion::dialog_in` / `motion::dialog_out`.
pub fn dialog(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  title~ : String = "",
  make : (view::View) -> Unit,
) -> view::View {
  parent.box(fn(host_box : view::View) -> Unit {
    let _ = host_box.over(view::Live::Is(true))
    host_box.show(open, fn(layer : view::View) -> Unit {
      let (look, _modal_live) = motion::overlay_presence(layer, enter=motion::dialog_in, exit=motion::dialog_out)
      let _ = layer
        .over(view::Live::Is(true))
        .scrim_under()
        .fills_across(view::Live::Is(true))
        .height_share(view::Live::Is(1.0))
        .center()
        .ground(view::Live::Is(ui::rgba(0, 0, 0, 110)))
        .alpha(view::Live::By(fn() -> Double { look().alpha }))
      let _ = headless::dialog(
        layer,
        fn() -> String { title },
        open,
        on_close,
        fn(panel : view::View, _d : headless::Dialog) -> Unit {
          let _ = panel
            .padding(view::Live::Is((16.0, 16.0, 16.0, 16.0)))
            .corners(view::Live::Is(Some((14.0, 14.0, 14.0, 14.0))))
            .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
            .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }))
            .scale(view::Live::By(fn() -> Double { look().sx }))
            .offset(view::Live::By(fn() -> (Double, Double) { (look().dx, look().dy) }))
          if title != "" {
            let _ = panel.box(fn(h : view::View) -> Unit {
              let _ = h.words(view::Live::Is(title)).ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
            })
          }
          make(panel)
        },
        modal=true,
        close_on_escape=true,
        close_on_outside=true,
      )
    }, leave=motion::dialog_out_ms)
  })
}

/// Pure-tree anchored popover backed by `headless::Popover` with `motion::pop_in` / `motion::pop_out`.
pub fn popover(
  parent : view::View,
  open : () -> Bool,
  on_close : () -> Unit,
  look? : PopoverLook,
  make : (view::View) -> Unit,
) -> view::View {
  let has_custom = look.is_some()
  let lk = match look { Some(l) => l; None => popover_look() }
  let pop = headless::Popover::new(open, fn(on : Bool) -> Unit {
    if !on {
      on_close()
    }
  })
  parent.box(fn(host_box : view::View) -> Unit {
    pop.layer(
      host_box,
      fn() -> String { "" },
      fn(p : view::View, _opener : Option[view::View]) -> Unit {
        let (ov_look, _live) = motion::overlay_presence(p, enter=motion::pop_in, exit=motion::pop_out)
        let _ = p
          .over(view::Live::Is(true))
          .padding(view::Live::Is((lk.pad, lk.pad, lk.pad, lk.pad)))
          .corners(view::Live::Is(Some((lk.radius, lk.radius, lk.radius, lk.radius))))
          .ground(if has_custom { view::Live::Is(lk.bg) } else { view::Live::By(fn() -> Int64 { ui::tree_theme().surface }) })
          .edge(if has_custom { view::Live::Is((1.0, lk.border)) } else { view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }) })
          .alpha(view::Live::By(fn() -> Double { ov_look().alpha }))
          .scale(view::Live::By(fn() -> Double { ov_look().sx }))
        make(p)
      },
      leave=motion::pop_out_ms,
    )
  })
}

/// Pure-tree tooltip bubble backed by `headless::window_tooltip_group` + `headless::tooltip_bubble`.
pub fn tooltip(
  parent : view::View,
  text : String,
  trigger : (view::View) -> Unit,
) -> view::View {
  let tip_key = view::next_phys_id()
  parent.box(fn(wrap : view::View) -> Unit {
    let group = headless::window_tooltip_group(wrap)
    let _ = wrap.keymap(view::Live::Is(view::Keymap::new(headless::tooltip_keys)))
    let _ = wrap.box(fn(trig : view::View) -> Unit {
      trigger(trig)
      group.trigger(trig, tip_key, within=true)
    })
    wrap.show(fn() -> Bool { group.is_open(tip_key) }, fn(slot : view::View) -> Unit {
      let _ = headless::tooltip_bubble(slot, fn() -> String { text }, fn(tip : view::View) -> Unit {
        let (ov_look, _) = motion::overlay_presence(tip, enter=motion::tip_in, exit=motion::tip_out)
        let _ = tip
          .over(view::Live::Is(true))
          .padding(view::Live::Is((8.0, 5.0, 8.0, 5.0)))
          .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
          .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }))
          .alpha(view::Live::By(fn() -> Double { ov_look().alpha }))
          .words(view::Live::Is(text))
          .ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
      })
    }, leave=motion::tip_out_ms)
  })
}

/// Pure-tree hover card backed by `headless::HoverCard` with open/close delay and pointer bridging.
pub fn hover_card(
  parent : view::View,
  trigger : (view::View) -> Unit,
  card : (view::View) -> Unit,
) -> view::View {
  let open = signals::signal(false)
  let hc = headless::HoverCard::new(
    fn() -> Bool { open.get() },
    fn(on : Bool) -> Unit { open.set(on) },
  )
  parent.box(fn(wrap : view::View) -> Unit {
    let _ = wrap.box(fn(trig : view::View) -> Unit {
      trigger(trig)
      hc.trigger(trig)
    })
    wrap.show(fn() -> Bool { hc.open() }, fn(slot : view::View) -> Unit {
      let lk = popover_look()
      let _ = hc.card(slot, fn() -> String { "" }, fn(c : view::View) -> Unit {
        let (ov_look, _) = motion::overlay_presence(c, enter=motion::pop_in, exit=motion::pop_out)
        let _ = c
          .over(view::Live::Is(true))
          .points(view::Live::Is(true))
          .padding(view::Live::Is((lk.pad, lk.pad, lk.pad, lk.pad)))
          .corners(view::Live::Is(Some((lk.radius, lk.radius, lk.radius, lk.radius))))
          .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
          .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }))
          .alpha(view::Live::By(fn() -> Double { ov_look().alpha }))
          .scale(view::Live::By(fn() -> Double { ov_look().sx }))
        card(c)
      })
    }, leave=motion::pop_out_ms)
  })
}

/// Pure-tree dropdown menu over `Array[Entry]` backed by `headless::menu` inside `popover`.
pub fn dropdown_menu(
  parent : view::View,
  entries : Array[Entry],
  open : () -> Bool,
  on_pick : (String) -> Unit,
  on_close : () -> Unit,
) -> Menu {
  let last_picked : signals::Ref[Option[String]] = ui::ref_new(None)
  let node = popover(parent, open, on_close, fn(panel : view::View) -> Unit {
    let _ = headless::menu(
      panel,
      fn(menu_box : view::View, m : headless::Menu) -> Unit {
        let _ = menu_box.gap(view::Live::Is(2.0))
        for entry in entries {
          match entry.kind {
            EntryKind::Separator => {
              let _ = menu_box.box(fn(sep : view::View) -> Unit {
                let _ = sep.height(view::Live::Is(Some(1.0))).fills_across(view::Live::Is(true)).ground(view::Live::By(fn() -> Int64 { ui::tree_theme().border }))
              })
            }
            EntryKind::Label => {
              let _ = menu_box.box(fn(lbl : view::View) -> Unit {
                let _ = lbl.padding(view::Live::Is((8.0, 4.0, 8.0, 4.0))).words(view::Live::Is(entry.label)).ink(view::Live::By(fn() -> Int64 { ui::tree_theme().muted }))
              })
            }
            EntryKind::Action => {
              let eid = entry.id
              let elabel = entry.label
              let edisabled = entry.disabled
              let _ = m.item(
                menu_box,
                fn() -> String { elabel },
                fn(_v : view::View) -> Unit {
                  last_picked.v = Some(eid)
                  on_pick(eid)
                  on_close()
                },
                fn(row : view::View, mi : headless::MenuItem) -> Unit {
                  let _ = row
                    .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
                    .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
                    .ground(view::Live::By(fn() -> Int64 {
                      if mi.focused() || mi.hovered() { ui::tree_theme().border } else { 0L }
                    }))
                    .words(view::Live::Is(elabel))
                    .ink(view::Live::By(fn() -> Int64 { if mi.disabled() { ui::tree_theme().muted } else { ui::tree_theme().fg } }))
                },
                disabled=fn() -> Bool { edisabled },
              )
            }
            EntryKind::Radio => {
              let eid = entry.id
              let elabel = entry.label
              let edisabled = entry.disabled
              let echecked = entry.checked
              let _ = m.radio_item(
                menu_box,
                fn() -> String { elabel },
                fn() -> Bool { echecked },
                fn(_v : view::View) -> Unit {
                  last_picked.v = Some(eid)
                  on_pick(eid)
                  on_close()
                },
                fn(row : view::View, mi : headless::MenuItem) -> Unit {
                  let _ = row
                    .padding(view::Live::Is((10.0, 6.0, 10.0, 6.0)))
                    .corners(view::Live::Is(Some((6.0, 6.0, 6.0, 6.0))))
                    .ground(view::Live::By(fn() -> Int64 {
                      if mi.focused() || mi.hovered() { ui::tree_theme().border } else { 0L }
                    }))
                    .words(view::Live::Is(elabel))
                    .ink(view::Live::By(fn() -> Int64 { if mi.disabled() { ui::tree_theme().muted } else { ui::tree_theme().fg } }))
                },
                disabled=fn() -> Bool { edisabled },
              )
            }
          }
        }
      },
      takes_focus=true,
      captures_unfocused=true,
    )
  })
  Menu::{ open: signals::untracked(open), picked: last_picked.v, node }
}

/// Pure-tree bottom sheet backed by `headless::drawer` with scrim fade and rest/place tracking (`sheet_place`, `sheet_top`, `sheet_rest`).
pub fn sheet(
  parent : view::View,
  key : String,
  open : () -> Bool,
  on_close : () -> Unit,
  height~ : Double = 320.0,
  make : (view::View) -> Unit,
) -> view::View {
  let slide = motion::NodeWay::new(if signals::untracked(open) { 0.0 } else { height })
  parent.box(fn(host_box : view::View) -> Unit {
    let _ = host_box.over(view::Live::Is(true))
    host_box.reacts(open, fn(on : Bool) -> Unit {
      slide.go(host_box, if on { 0.0 } else { height }, motion::carousel_spring)
      sheet_rests[key] = slide.end()
    }, at_start=false)
    host_box.show(open, fn(layer : view::View) -> Unit {
      let _ = layer
        .over(view::Live::Is(true))
        .scrim_under()
        .fills_across(view::Live::Is(true))
        .height_share(view::Live::Is(1.0))
        .lies_along(view::Live::Is(view::Lies::End))
        .ground(view::Live::Is(ui::rgba(0, 0, 0, 100)))
      let _ = headless::drawer(
        layer,
        fn() -> String { key },
        open,
        on_close,
        fn(panel : view::View, dr : headless::Drawer) -> Unit {
          let y_of = fn() -> Double { if dr.dragging() { dr.drag_offset() } else { slide.shown(panel) } }
          let _ = panel
            .fills_across(view::Live::Is(true))
            .height(view::Live::Is(Some(height)))
            .padding(view::Live::Is((16.0, 12.0, 16.0, 16.0)))
            .corners(view::Live::Is(Some((16.0, 16.0, 0.0, 0.0))))
            .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
            .offset(view::Live::By(fn() -> (Double, Double) { (0.0, y_of()) }))
          // Where it rests is noted as its offset or laid width changes, outside the offset's own read.
          panel.reacts_by(
            fn() -> (Double, Double) {
              let y = y_of()
              let lw = match panel.laid_size_told() {
                Some((w, _)) => w
                None => 0.0
              }
              (y, lw)
            },
            fn(a : (Double, Double), b : (Double, Double)) -> Bool { a.0 == b.0 && a.1 == b.1 },
            fn(pair : (Double, Double)) -> Unit {
              let (y, lw) = pair
              let w = if lw > 0.0 { lw } else { panel.laid_size().0 }
              sheet_tops[key] = y
              sheet_places[key] = (0.0, y, w, height)
            },
            at_start=true,
          )
          make(panel)
        },
        edge=headless::DrawerEdge::Bottom,
        overpull_max=32.0,
      )
    }, leave=motion::sheet_scrim_ms)
  })
}

struct ToastItem {
  id : String
  msg : String
}

impl view::ViewEq for ToastItem {
  fn eq(self : ToastItem, other : ToastItem) -> Bool {
    self.id == other.id && self.msg == other.msg
  }
}

/// Pure-tree toast stack host (`@kit.toaster`) backed by `headless::toaster`.
pub fn toaster(
  parent : view::View,
  key : String,
  items : () -> Array[(String, String)],
  on_dismiss : (String) -> Unit,
) -> view::View {
  headless::toaster(
    parent,
    fn() -> Array[ToastItem] {
      let cur = items()
      let out : Array[ToastItem] = []
      for pair in cur {
        out.push(ToastItem::{ id: pair.0, msg: pair.1 })
      }
      out
    },
    fn(it : ToastItem) -> String { it.id },
    fn(it : ToastItem) -> (String, String) { (it.msg, "") },
    fn(_it : ToastItem) -> Double { 4000.0 },
    fn(stack : view::View) -> Unit {
      let _ = stack
        .over(view::Live::Is(true))
        .points(view::Live::Is(false))
        .gap(view::Live::Is(8.0))
        .padding(view::Live::Is((12.0, 12.0, 12.0, 12.0)))
    },
    fn(card : view::View, it : headless::ToastItem[ToastItem]) -> Unit {
      let _ = card
        .corners(view::Live::Is(Some((10.0, 10.0, 10.0, 10.0))))
        .ground(view::Live::By(fn() -> Int64 { ui::tree_theme().surface }))
        .edge(view::Live::By(fn() -> (Double, Int64) { (1.0, ui::tree_theme().border) }))
        .offset(view::Live::By(fn() -> (Double, Double) { (it.dx(), 0.0) }))
      let _ = card.box(fn(body : view::View) -> Unit {
        let _ = body
          .padding(view::Live::Is((12.0, 8.0, 12.0, 8.0)))
          .words(view::Live::By(fn() -> String { it.toast().msg }))
          .ink(view::Live::By(fn() -> Int64 { ui::tree_theme().fg }))
          .presses(view::Live::Is(true))
          .on_press(fn() -> Unit { it.close() })
      })
    },
    on_dismiss,
    on_dismiss,
    key=key,
  )
}
