// Single-quad GPU-cached radial glow texture and view primitive.
// Replaces stacked translucent circles with one bilinearly stretched PNG texture registered in ui::add_image.

import "dmath"
import "pixels"
import "signals"
import "ui"
import "view"

fn glow_clamp_int(v : Int, lo : Int, hi : Int) -> Int {
  if v < lo { lo } else if v > hi { hi } else { v }
}

fn glow_clamp_double(v : Double, lo : Double, hi : Double) -> Double {
  if v < lo { lo } else if v > hi { hi } else { v }
}

/// Generate (if not already registered in `ui`) and return the deterministic image key
/// for a radial glow texture with zero-alpha edges and power-law falloff `pow(1 - t, softness)`.
pub fn radial_glow_image(
  color : Int64,
  softness~ : Double = 2.2,
  tex_px~ : Int = 64,
) -> String {
  let px = glow_clamp_int(tex_px, 16, 256)
  let soft = glow_clamp_double(softness, 0.5, 8.0)
  let soft_q = (soft * 100.0).round().to_int()
  let key = "kit:radial_glow:\{color}:\{soft_q}:\{px}"
  if ui::image_bytes_for(key).is_none() {
    let r = ((color >> 24) & 0xFF.to_int64()).to_int() as Byte
    let g = ((color >> 16) & 0xFF.to_int64()).to_int() as Byte
    let b = ((color >> 8) & 0xFF.to_int64()).to_int() as Byte
    let base_a = (color & 0xFF.to_int64()).to_double()
    let half = (px - 1).to_double() / 2.0
    let sb = StringBuilder::new()
    for y in 0..<px {
      let dy = y.to_double() - half
      let dy2 = dy * dy
      for x in 0..<px {
        let dx = x.to_double() - half
        let t = (dx * dx + dy2).sqrt() / half
        let a = if t >= 1.0 {
          0
        } else {
          let falloff = dmath::pow(1.0 - t, soft)
          glow_clamp_int((base_a * falloff).round().to_int(), 0, 255)
        }
        sb.write_byte(r)
        sb.write_byte(g)
        sb.write_byte(b)
        sb.write_byte(a as Byte)
      }
    }
    let png_bytes = pixels::png(px, px, pixels::bytes_to_fixed(sb.to_string().to_bytes()))
    ui::add_image(key, png_bytes)
  }
  key
}

/// Mount a single-quad radial glow view node of `width` x `height`.
pub fn radial_glow(
  parent : view::View,
  width : Double,
  height : Double,
  color : view::Live[Int64],
  softness~ : Double = 2.2,
  tex_px~ : Int = 64,
  loc~ : String = "",
) -> view::View {
  parent.box(fn(v : view::View) -> Unit {
    let live_img : view::Live[Option[(String, String, Int)]] = match color {
      view::Live::Is(c) =>
        view::Live::Is(Some((radial_glow_image(c, softness=softness, tex_px=tex_px), "", 0)))
      view::Live::By(f) => {
        // The texture is made and registered as the colour changes; the image binding only reads its key.
        let key_sig = signals::signal("")
        v.reacts(f, fn(c : Int64) -> Unit {
          key_sig.set(radial_glow_image(c, softness=softness, tex_px=tex_px))
        }, at_start=true)
        view::Live::By(fn() -> Option[(String, String, Int)] {
          let k = key_sig.get()
          if k == "" { None } else { Some((k, "", 0)) }
        })
      }
    }
    let _ = v
      .width(view::Live::Is(Some(width)))
      .height(view::Live::Is(Some(height)))
      .shrink(view::Live::Is(0.0))
      .image_covers(view::Live::Is(false))
      .image_contains(view::Live::Is(false))
      .image_fades(view::Live::Is(false))
      .image(live_img, loc=loc)
  })
}
