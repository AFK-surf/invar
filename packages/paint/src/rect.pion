// Rounded rectangle drawing primitive descriptor.
// Ported from libs/mbui/src/paint/rect.mbt.

pub struct Rect {
  pub x : Double
  pub y : Double
  pub w : Double
  pub h : Double
  pub color : Int64
  pub corners : (Double, Double, Double, Double)
}

pub fn rect(
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  color~ : Int64,
  corners~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
) -> Rect {
  Rect::{ x, y, w, h, color, corners }
}

pub fn rect_of(
  x : Double,
  y : Double,
  w : Double,
  h : Double,
  color~ : Int64,
  corners~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
) -> Rect {
  Rect::{ x, y, w, h, color, corners }
}
