// Glass descriptor (frosted & iOS 27 liquid glass optical parameters).
// Ported from libs/mbui/src/paint/glass.mbt.

pub fn color_i64(hi16 : Int, lo16 : Int) -> Int64 {
  (hi16.to_int64() << 16) | lo16.to_int64()
}

pub struct Glass {
  pub blur : Double
  pub tint : Int64
  pub saturation : Double
  pub solid : Int64
  pub rim_edge : Double
  pub rim_lit : Double
  pub rim_back : Double
  pub liquid : Bool
  pub rim : Double
  pub bezel : Double
  pub refraction : Double
  pub chroma : Double
  pub merge : Double
  pub adaptive : Bool
  pub shares_capture : Bool
  pub contained : Bool
  pub spot : Option[(Double, Double)]
}

pub fn Glass::frosted(
  blur~ : Double,
  tint~ : Int64,
  solid~ : Int64,
  saturation~ : Double = 1.0,
  rim_edge~ : Double = 0.0,
  rim_lit~ : Double = 0.0,
  rim_back~ : Double = 0.0,
  shares_capture~ : Bool = false,
  contained~ : Bool = false,
) -> Glass {
  Glass::{
    blur,
    tint,
    saturation,
    solid,
    rim_edge,
    rim_lit,
    rim_back,
    liquid: false,
    rim: 0.0,
    bezel: 0.0,
    refraction: 0.0,
    chroma: 0.0,
    merge: 0.0,
    adaptive: false,
    shares_capture,
    contained,
    spot: None,
  }
}

pub fn Glass::sharing(self : Glass) -> Glass {
  Glass::{
    blur: self.blur,
    tint: self.tint,
    saturation: self.saturation,
    solid: self.solid,
    rim_edge: self.rim_edge,
    rim_lit: self.rim_lit,
    rim_back: self.rim_back,
    liquid: self.liquid,
    rim: self.rim,
    bezel: self.bezel,
    refraction: self.refraction,
    chroma: self.chroma,
    merge: self.merge,
    adaptive: self.adaptive,
    shares_capture: true,
    contained: self.contained,
    spot: self.spot,
  }
}

pub fn Glass::liquid(
  blur~ : Double = 1.0,
  tint~ : Int64 = (0xFFFF.to_int64() << 16) | 0xFF1A.to_int64(),
  solid~ : Int64 = (0xECEC.to_int64() << 16) | 0xF0FF.to_int64(),
  saturation~ : Double = 1.3,
  rim~ : Double = 0.55,
  bezel~ : Double = 14.0,
  refraction~ : Double = 9.0,
  chroma~ : Double = 0.18,
  merge~ : Double = 16.0,
  adaptive~ : Bool = true,
  spot? : (Double, Double),
) -> Glass {
  Glass::{
    blur,
    tint,
    saturation,
    solid,
    rim_edge: 0.0,
    rim_lit: 0.0,
    rim_back: 0.0,
    liquid: true,
    rim,
    bezel,
    refraction,
    chroma,
    merge,
    adaptive,
    shares_capture: false,
    contained: false,
    spot,
  }
}
