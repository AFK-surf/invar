// Glass descriptor (frosted & iOS 27 liquid glass optical parameters).
// Ported from libs/mbui/src/paint/glass.mbt.

pub fn color_i64(hi16 : Int, lo16 : Int) -> Int64 {
  (hi16.to_int64() << 16) | lo16.to_int64()
}

fn glass_clamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

pub struct Glass {
  pub blur : Double
  pub tint : Int64
  pub saturation : Double
  pub solid : Int64
  pub rim_edge : Double
  pub rim_lit : Double
  pub rim_back : Double
  pub liquid : Bool
  pub rim : Double
  pub bezel : Double
  pub refraction : Double
  pub chroma : Double
  pub merge : Double
  pub adaptive : Bool
  pub shares_capture : Bool
  pub contained : Bool
  pub spot : Option[(Double, Double)]
  pub zoom : Double
  pub strength : Double
}

pub fn Glass::frosted(
  blur~ : Double,
  tint~ : Int64,
  solid~ : Int64,
  saturation~ : Double = 1.0,
  rim_edge~ : Double = 0.0,
  rim_lit~ : Double = 0.0,
  rim_back~ : Double = 0.0,
  shares_capture~ : Bool = false,
  contained~ : Bool = false,
  strength~ : Double = 1.0,
) -> Glass {
  Glass::{
    blur,
    tint,
    saturation,
    solid,
    rim_edge,
    rim_lit,
    rim_back,
    liquid: false,
    rim: 0.0,
    bezel: 0.0,
    refraction: 0.0,
    chroma: 0.0,
    merge: 0.0,
    adaptive: false,
    shares_capture,
    contained,
    spot: None,
    zoom: 1.0,
    strength: glass_clamp(strength, 0.0, 1.0),
  }
}

pub fn Glass::sharing(self : Glass) -> Glass {
  Glass::{
    blur: self.blur,
    tint: self.tint,
    saturation: self.saturation,
    solid: self.solid,
    rim_edge: self.rim_edge,
    rim_lit: self.rim_lit,
    rim_back: self.rim_back,
    liquid: self.liquid,
    rim: self.rim,
    bezel: self.bezel,
    refraction: self.refraction,
    chroma: self.chroma,
    merge: self.merge,
    adaptive: self.adaptive,
    shares_capture: true,
    contained: self.contained,
    spot: self.spot,
    zoom: self.zoom,
    strength: self.strength,
  }
}

pub fn Glass::liquid(
  blur~ : Double = 1.0,
  tint~ : Int64 = (0xFFFF.to_int64() << 16) | 0xFF1A.to_int64(),
  solid~ : Int64 = (0xECEC.to_int64() << 16) | 0xF0FF.to_int64(),
  saturation~ : Double = 1.3,
  rim~ : Double = 0.55,
  bezel~ : Double = 14.0,
  refraction~ : Double = 9.0,
  chroma~ : Double = 0.18,
  merge~ : Double = 16.0,
  adaptive~ : Bool = true,
  spot? : (Double, Double),
  zoom~ : Double = 1.0,
  strength~ : Double = 1.0,
) -> Glass {
  Glass::{
    blur,
    tint,
    saturation,
    solid,
    rim_edge: 0.0,
    rim_lit: 0.0,
    rim_back: 0.0,
    liquid: true,
    rim,
    bezel,
    refraction,
    chroma,
    merge,
    adaptive,
    shares_capture: false,
    contained: false,
    spot,
    zoom,
    strength: glass_clamp(strength, 0.0, 1.0),
  }
}

/// Scale this glass's materialisation continuously by `t` in `[0.0, 1.0]` for smooth flat-to-glass
/// transitions (clamping spring overshoots). `bezel` keeps its full width so the bevel never
/// collapses into a sharp hairline, while optical effects and `strength` scale smoothly.
pub fn Glass::at_strength(self : Glass, t : Double) -> Glass {
  let s = glass_clamp(t, 0.0, 1.0)
  if s >= 0.9999 {
    return self
  }
  Glass::{
    ..self,
    blur: self.blur * s,
    refraction: self.refraction * s,
    rim: self.rim * s,
    chroma: self.chroma * s,
    rim_edge: self.rim_edge * s,
    rim_lit: self.rim_lit * s,
    rim_back: self.rim_back * s,
    saturation: 1.0 + (self.saturation - 1.0) * s,
    zoom: 1.0 + (self.zoom - 1.0) * s,
    strength: self.strength * s,
  }
}

pub fn Glass::clear(
  blur~ : Double = 0.0,
  tint~ : Int64 = (0xFFFF.to_int64() << 16) | 0xFF1A.to_int64(),
  solid~ : Int64 = (0xECEC.to_int64() << 16) | 0xF0FF.to_int64(),
  saturation~ : Double = 1.0,
  rim~ : Double = 0.6,
  bezel~ : Double = 14.0,
  refraction~ : Double = 16.0,
  chroma~ : Double = 0.0,
  merge~ : Double = 16.0,
  adaptive~ : Bool = true,
  spot? : (Double, Double),
  zoom~ : Double = 1.0,
  strength~ : Double = 1.0,
) -> Glass {
  Glass::liquid(
    blur=blur,
    tint=tint,
    solid=solid,
    saturation=saturation,
    rim=rim,
    bezel=bezel,
    refraction=refraction,
    chroma=chroma,
    merge=merge,
    adaptive=adaptive,
    spot?=spot,
    zoom=zoom,
    strength=strength,
  )
}
