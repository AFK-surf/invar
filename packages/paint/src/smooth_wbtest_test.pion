  { let __mbt_aa_94 = (last - 1.0).abs() < 1.0e-3; let __mbt_aa_95 : String = "at the middle \{mbt_compat::double_to_string(last)}"; if !(__mbt_aa_94) { panic("assertion failed at smooth_wbtest.mbt:277: " + __mbt_aa_95) } }
