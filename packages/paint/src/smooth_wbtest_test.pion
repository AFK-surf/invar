  for i in 0..=140 {
    let d = i.to_double() * 0.01 * 18.0
    for y in [12.0, 16.0, 17.5, 18.5] {
      for hx in [25.2, 29.0, 300.0] {
        { let __mbt_aa_100 = (sd_box(hx - d, y, hx, 18.0, 18.0) - sd_box(300.0 - d, y, 300.0, 18.0, 18.0)).abs() < 1.0e-9; let __mbt_aa_101 : String = "\{mbt_compat::double_to_string(hx)} at \{mbt_compat::double_to_string(d)}, \{mbt_compat::double_to_string(y)}"; if !(__mbt_aa_100) { panic("assertion failed at smooth_wbtest.mbt:299: " + __mbt_aa_101) } }
      }
    }
  }
  // a circle 80 across: a circle's distance
  for j in 0..=40 {
    let a = 1.5707963267948966 * j.to_double() / 40.0
    for off in [-1.0, 0.0, 1.0] {
      let x = (40.0 + off) * dmath::cos(a)
      let y = (40.0 + off) * dmath::sin(a)
      let l = (x * x + y * y).sqrt()
      { let __mbt_aa_102 = (sd_box(x, y, 40.0, 40.0, 40.0) - (l - 40.0)).abs() < 1.0e-12; mbt_compat::assert_true(__mbt_aa_102, "smooth_wbtest.mbt:310") }
    }
  }
  // standing up, the same as lying down
  for u in [0.5, 0.9, 1.3] {
    let x = 150.0 - 40.0 * u
    for y in [37.0, 39.5, 40.5] {
      { let __mbt_aa_103 = sd_box(y, x, 40.0, 150.0, 40.0); let __mbt_aa_104 = sd_box(x, y, 150.0, 40.0, 40.0); if !(__mbt_aa_103 == __mbt_aa_104) { panic("assert_eq failed at smooth_wbtest.mbt:317") } }
    }
  }
  // a capsule growing from a circle: its outline at r from the tip never jumps
  let mut last = capsule_drop(40.0, 1.0)
  for i in 1..=120 {
    let d = capsule_drop(40.0 + i.to_double() * 0.5, 1.0)
    { let __mbt_aa_105 = (d - last).abs() < 0.001; let __mbt_aa_106 : String = "jumps at \{40.0 + i.to_double() * 0.5}"; if !(__mbt_aa_105) { panic("assertion failed at smooth_wbtest.mbt:324: " + __mbt_aa_106) } }
    last = d
  }
  // a corner with room across (wholly smooth), and a round one given in a big box (a window's): not eased
  { let __mbt_aa_107 = capsule_ease(1.0, 0.0); let __mbt_aa_108 = 0.0; if !(__mbt_aa_107 == __mbt_aa_108) { panic("assert_eq failed at smooth_wbtest.mbt:328") } }
  { let __mbt_aa_109 = sd_box(140.0, 30.0, 150.0, 40.0, 12.0); let __mbt_aa_110 = sd_corner(140.0, 30.0, 150.0, 40.0, 12.0, 1.0); if !(__mbt_aa_109 == __mbt_aa_110) { panic("assert_eq failed at smooth_wbtest.mbt:329") } }
}
