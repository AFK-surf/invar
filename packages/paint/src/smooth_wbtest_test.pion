    { let __mbt_aa_80 = (got - want).abs() < 0.009; let __mbt_aa_81 : String = "at \{mbt_compat::double_to_string(u)} r: \{mbt_compat::double_to_string(got)}, measured \{mbt_compat::double_to_string(want)}"; if !(__mbt_aa_80) { panic("assertion failed at smooth_wbtest.mbt:248: " + __mbt_aa_81) } }
  }
  // the circle's at its middle, the edge's from 1.4 r in; a circle met the edge at r with nothing left
  for u in [0.1, 0.2, 0.3] {
    let circle = 1.0 - (u * (2.0 - u)).sqrt()
    { let __mbt_aa_82 = (capsule_drop(150.0, u) - circle).abs() < 1.0e-9; let __mbt_aa_83 : String = "at \{mbt_compat::double_to_string(u)}: \{capsule_drop(150.0, u)}, the circle \{mbt_compat::double_to_string(circle)}"; if !(__mbt_aa_82) { panic("assertion failed at smooth_wbtest.mbt:253: " + __mbt_aa_83) } }
  }
  { let __mbt_aa_84 = capsule_drop(150.0, 1.0) > 0.005; mbt_compat::assert_true(__mbt_aa_84, "smooth_wbtest.mbt:255") }
  { let __mbt_aa_85 = capsule_drop(150.0, 1.4) < 1.0e-9; mbt_compat::assert_true(__mbt_aa_85, "smooth_wbtest.mbt:256") }
  // how sharply it bends, from the edge in to the tip: none, then rising once to at most 1.15 the circle's and back to
  // the circle's, by no step (a half circle's goes from none to all at once at r; the quintic's before turned at once
  // where it left the circle, and twice on the way)
