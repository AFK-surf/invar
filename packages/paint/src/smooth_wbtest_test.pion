///|
test "the wholly smooth corner's polynomials are its factors within 2e-5" {
  let n = smooth_exponent
  for i in 0..=1000 {
    let t = i.to_double() / 1000.0
    let tn1 = if t == 0.0 { 0.0 } else { dmath::pow(t, n - 1.0) }
    let tn = tn1 * t
    let u = dmath::pow(1.0 + tn, 1.0 / n)
    let g = (1.0 + tn1 * tn1).sqrt()
    { let __mbt_aa_76 = (smooth_a(t) - (1.0 + tn) / g).abs() < 2.0e-5; let __mbt_aa_77 : String = "a at \{mbt_compat::double_to_string(t)}"; if !(__mbt_aa_76) { panic("assertion failed at smooth_wbtest.mbt:192: " + __mbt_aa_77) } }
    { let __mbt_aa_78 = (smooth_b(t) - (1.0 + tn) / (u * g)).abs() < 2.0e-5; let __mbt_aa_79 : String = "b at \{mbt_compat::double_to_string(t)}"; if !(__mbt_aa_78) { panic("assertion failed at smooth_wbtest.mbt:193: " + __mbt_aa_79) } }
  }
}

///|
/// How far below the top edge a capsule 300 by 80 (its corners 40) has its top edge `u` r from its right tip, in r: the
/// point on that column where sd_box is 0, by halving.
fn capsule_drop(hx : Double, u : Double) -> Double {
  let x = hx - 40.0 * u
  let mut lo = 0.0
  let mut hi = 40.0
  for _ in 0..<60 {
    let mid = (lo + hi) / 2.0
    if sd_box(x, mid, hx, 40.0, 40.0) <= 0.0 {
      lo = mid
    } else {
      hi = mid
    }
  }
  (40.0 - lo) / 40.0
}

///|
/// How sharply the top edge of a capsule 300 by 80 bends `u` r from its right tip, in 1/r: from its drops a step either
/// side.
fn capsule_bend(u : Double) -> Double {
  let h = 0.002
  let a = capsule_drop(150.0, u - h)
  let b = capsule_drop(150.0, u)
  let c = capsule_drop(150.0, u + h)
  let slope = (c - a) / (2.0 * h)
  let w = 1.0 + slope * slope
  (a - 2.0 * b + c) / (h * h) / (w * w.sqrt())
}

///|
test "a capsule's end is Apple's: the circle's at its middle, easing into the long edges, how much it bends never jumping or turning at once" {
  // Reference capsule measurements (288px high): how far below the edge its outline
