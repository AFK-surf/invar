// Shape descriptor, vector_shapes, dashed_outlines, meniscus_outline.
// Ported from libs/mbui/src/paint/shape.mbt.

import "dmath"
import "pixels"

pub struct Shape {
  pub outlines : Array[(Array[Double], Bool)]
  pub fill : Int64
  pub even_odd : Bool
  pub stroke : Int64
  pub width : Double
  /// Optional shape-local vertical linear alpha fade endpoints & lengths in shape-local points
  /// (stored as plain scalars so legacy 5-field `Shape::{ ... }` struct literals zero-initialize safely).
  /// Evaluated in unrotated local coordinates (`p.y`) independently of parent `View::fades` and screen-space clips.
  pub fade_top_y : Double
  pub fade_top_len : Double
  pub fade_bot_y : Double
  pub fade_bot_len : Double
}

pub fn shape_of(
  outlines : Array[(Array[Double], Bool)],
  fill~ : Int64 = 0.to_int64(),
  even_odd~ : Bool = false,
  stroke~ : Int64 = 0.to_int64(),
  width~ : Double = 0.0,
  fade~ : (Double, Double, Double, Double) = (0.0, 0.0, 0.0, 0.0),
) -> Shape {
  Shape::{
    outlines,
    fill,
    even_odd,
    stroke,
    width,
    fade_top_y: fade.0,
    fade_top_len: fade.1,
    fade_bot_y: fade.2,
    fade_bot_len: fade.3,
  }
}

pub fn vector_shapes(v : pixels::Vector, w : Double, scale : Double, tint? : Int64) -> Array[Shape] {
  let k = w / v.w
  let out : Array[Shape] = []
  for l in v.layers {
    let subs = l.outlines(k, scale)
    if l.fill != 0.to_int64() {
      out.push(shape_of(subs, fill=pixels::tinted(l.fill, tint), even_odd=l.even_odd))
    }
    if l.stroke != 0.to_int64() && l.width > 0.0 {
      out.push(shape_of(subs, stroke=pixels::tinted(l.stroke, tint), width=l.width * l.sx * k))
    }
  }
  out
}

pub fn dashed_outlines(w : Double, h : Double, r : Double, line : Double) -> Array[(Array[Double], Bool)] {
  let pi = dmath::pi
  let r = dclamp(r, 0.0, dmin(w, h) / 2.0)
  let straight_w = w - 2.0 * r
  let straight_h = h - 2.0 * r
  let arc_len = pi * r / 2.0
  let whole = 2.0 * (straight_w + straight_h) + 4.0 * arc_len
  let n = dmax(1.0, (whole / (5.0 * line)).round())
  let step = whole / n
  let dash = step * 3.0 / 5.0
  let corner = fn(cx : Double, cy : Double, from : Double, k : Double) -> (Double, Double) {
    let a = from + k * pi / 2.0
    (cx + r * dmath::cos(a), cy + r * dmath::sin(a))
  }
  let at = fn(s0 : Double) -> (Double, Double) {
    let mut s = s0
    if s < straight_w {
      return (r + s, 0.0)
    }
    s = s - straight_w
    if s < arc_len {
      return corner(w - r, r, -pi / 2.0, s / arc_len)
    }
    s = s - arc_len
    if s < straight_h {
      return (w, r + s)
    }
    s = s - straight_h
    if s < arc_len {
      return corner(w - r, h - r, 0.0, s / arc_len)
    }
    s = s - arc_len
    if s < straight_w {
      return (w - r - s, h)
    }
    s = s - straight_w
    if s < arc_len {
      return corner(r, h - r, pi / 2.0, s / arc_len)
    }
    s = s - arc_len
    if s < straight_h {
      return (0.0, h - r - s)
    }
    s = s - straight_h
    corner(r, r, pi, dmin(1.0, s / arc_len))
  }
  let pieces = dmax(1.0, (dash / 0.75).ceil()).to_int()
  let out : Array[(Array[Double], Bool)] = []
  for k in 0..<n.to_int() {
    let from = k.to_double() * step
    let pts : Array[Double] = []
    for i in 0..=pieces {
      let (x, y) = at(from + dash * i.to_double() / pieces.to_double())
      pts.push(x)
      pts.push(y)
    }
    out.push((pts, false))
  }
  out
}

pub fn meniscus_outline(
  x0 : Double,
  cy : Double,
  track_h : Double,
  cx : Double,
  r : Double,
  tension : Double,
) -> Array[(Array[Double], Bool)] {
  let pi = dmath::pi
  let flat = fn(pts : Array[(Double, Double)], out : Array[Double]) -> Unit {
    for p in pts {
      out.push(p.0)
      out.push(p.1)
    }
  }
  if r <= 0.0 {
    return []
  }
  if tension <= 0.01 || cx - x0 <= r {
    let disc : Array[Double] = []
    flat(arc(cx, cy, r, from=0.0, sweep=2.0 * pi), disc)
    return [(disc, true)]
  }
  let k = dclamp(tension, 0.0, 1.0)
  let half = dclamp(track_h / 2.0, 0.0, r)
  let phi0 = dmath::asin(half / r)
  let phi = phi0 + (dmax(1.05, phi0) - phi0) * k
  let (px, py) = (cx - r * dmath::cos(phi), cy - r * dmath::sin(phi))
  let xa = dmax(x0 + half, px - r * 1.8 * k)
  let (top, foot) = (cy - half, cy + half)
  let reach = dmax(px - xa, 0.0)
  let c = reach * 0.5
  let neck = fn(ey : Double, qy : Double, dir_y : Double) -> Array[(Double, Double)] {
    let (c1x, c1y) = (xa + c, ey)
    let (c2x, c2y) = (px - c * dmath::sin(phi), qy - c * dir_y)
    let chord = ((px - xa) * (px - xa) + (qy - ey) * (qy - ey)).sqrt()
    let n = dmax(4.0, (chord / (8.0 * arc_sag).sqrt() / 2.0).ceil()).to_int()
    let pts : Array[(Double, Double)] = []
    for i in 0..=n {
      let t = i.to_double() / n.to_double()
      let u = 1.0 - t
      let x = u * u * u * xa + 3.0 * u * u * t * c1x + 3.0 * u * t * t * c2x + t * t * t * px
      let y = u * u * u * ey + 3.0 * u * u * t * c1y + 3.0 * u * t * t * c2y + t * t * t * qy
      pts.push((x, y))
    }
    pts
  }
  let out : Array[Double] = []
  flat(arc(x0 + half, cy, half, from=pi / 2.0, sweep=pi), out)
  flat(neck(top, py, -dmath::cos(phi)), out)
  flat(arc(cx, cy, r, from=pi + phi, sweep=2.0 * pi - 2.0 * phi), out)
  let under = neck(foot, cy + r * dmath::sin(phi), dmath::cos(phi))
  // reverse in place
  let mut li = 0
  let mut ri = under.length() - 1
  while li < ri {
    let tmp = under[li]
    under[li] = under[ri]
    under[ri] = tmp
    li += 1
    ri -= 1
  }
  flat(under, out)
  [(out, true)]
}

fn dclamp(x : Double, lo : Double, hi : Double) -> Double {
  if x < lo { lo } else if x > hi { hi } else { x }
}

fn dmin(a : Double, b : Double) -> Double {
  if a < b { a } else { b }
}

fn dmax(a : Double, b : Double) -> Double {
  if a > b { a } else { b }
}
