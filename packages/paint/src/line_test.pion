///|
fn length_of(p : Array[(Double, Double)]) -> Double {
  let mut l = 0.0
  for i in 1..<p.length() {
    let (dx, dy) = (p[i].0 - p[i - 1].0, p[i].1 - p[i - 1].1)
    l = l + (dx * dx + dy * dy).sqrt()
  }
  l
}

