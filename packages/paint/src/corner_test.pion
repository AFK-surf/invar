  { let __mbt_aa_3 = (edge.follows(mac), edge.inset(mac), edge.source(mac)); let __mbt_aa_4 = (true, Some(6.0), Some(16.0)); if !({ let __eq_l_13 : (Bool, Option[Double], Option[Double]) = __mbt_aa_3; let __eq_r_13 : (Bool, Option[Double], Option[Double]) = __mbt_aa_4; (__eq_l_13.0 == __eq_r_13.0) && (match (__eq_l_13.1, __eq_r_13.1) { (Some(__oa), Some(__ob)) => __oa == __ob, (None, None) => true, _ => false }) && (match (__eq_l_13.2, __eq_r_13.2) { (Some(__oa_1), Some(__ob_1)) => __oa_1 == __ob_1, (None, None) => true, _ => false }) }) { panic("assert_eq failed at corner_test.mbt:13") } }
  { let __mbt_aa_5 = edge.radius(full); let __mbt_aa_6 = 34.0; if !(__mbt_aa_5 == __mbt_aa_6) { panic("assert_eq failed at corner_test.mbt:14") } }
  { let __mbt_aa_7 = (edge.follows(full), edge.inset(full), edge.source(full)); let __mbt_aa_8 = (false, None, Some(0.0)); if !({ let __eq_l_15 : (Bool, Option[Double], Option[Double]) = __mbt_aa_7; let __eq_r_15 : (Bool, Option[Double], Option[Double]) = __mbt_aa_8; (__eq_l_15.0 == __eq_r_15.0) && (match (__eq_l_15.1, __eq_r_15.1) { (Some(__oa_2), Some(__ob_2)) => __oa_2 == __ob_2, (None, None) => true, _ => false }) && (match (__eq_l_15.2, __eq_r_15.2) { (Some(__oa_3), Some(__ob_3)) => __oa_3 == __ob_3, (None, None) => true, _ => false }) }) { panic("assert_eq failed at corner_test.mbt:15") } }
  // (one following that, 6 in again: as the chain has it under each)
  let inner : CornerOf = CornerOf::Follow(edge, 6.0, 10.0)
  { let __mbt_aa_9 = inner.radius(full); let __mbt_aa_10 = concentric(34.0, 6.0); if !(__mbt_aa_9 == __mbt_aa_10) { panic("assert_eq failed at corner_test.mbt:18") } }
  // (under a Mac's 16 the edge's is 10: 6 in that, 4, squarer than the ranges let: alone)
