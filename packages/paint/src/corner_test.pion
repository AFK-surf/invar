  // (no ranges: any corner, any place)
  let deep : CornerOf = CornerOf::Follow(CornerOf::Window, 14.0, 34.0)
  let none : CornerRoots = CornerRoots::{ window: 16.0, fit: Option::None, zoom: 1.0 }
