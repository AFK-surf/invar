///|
test "a linked window corner is judged by its visible size after content zoom" {
  let edge : CornerOf = CornerOf::Follow(CornerOf::Window, 6.0, 28.0)
  let enlarged : CornerRoots = CornerRoots::{ window: 10.0, fit: Option::Some(ranges), zoom: 2.0 }
  { let __mbt_aa_15 = edge.follows(enlarged); mbt_compat::assert_true(__mbt_aa_15, "corner_test.mbt:31") }
  { let __mbt_aa_16 = edge.radius(enlarged); let __mbt_aa_17 = concentric(10.0, 6.0); if !(__mbt_aa_16 == __mbt_aa_17) { panic("assert_eq failed at corner_test.mbt:32") } }
  // The same small logical corner without magnification remains below the theme's minimum.
  { let __mbt_aa_18 = edge.follows(CornerRoots::{ ..enlarged, zoom: 1.0 }); mbt_compat::assert_false(__mbt_aa_18, "corner_test.mbt:34") }
}
