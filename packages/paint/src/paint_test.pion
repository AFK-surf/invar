// Unit tests for paint (Glass, Rect, CornerOf, Line, subline, tension_line, meniscus_outline, smooth corners, det_pow).
// Ported from libs/mbui/src/paint/{corner_test,line_test,smooth_wbtest}.mbt.

import "dmath"
import "pixels"

fn near(a : Double, b : Double) -> Bool {
  (a - b).abs() <= 1.0e-9
}

fn about(a : Double, b : Double) -> Bool {
  (a - b).abs() <= 0.06
}

fn length_of(p : Array[(Double, Double)]) -> Double {
  let mut l = 0.0
  for i in 1..<p.length() {
    let dx = p[i].0 - p[i - 1].0
    let dy = p[i].1 - p[i - 1].1
    l += (dx * dx + dy * dy).sqrt()
  }
  l
}

test "paint: Glass frosted, liquid (iOS 27), sharing, and Rect" {
  let lg = Glass::liquid()
  debug_assert(lg.liquid, "liquid true")
  debug_assert(near(lg.blur, 1.0) && near(lg.saturation, 1.3) && near(lg.rim, 0.55) && near(lg.bezel, 14.0), "liquid defaults")
  debug_assert(near(lg.refraction, 9.0) && near(lg.chroma, 0.18) && near(lg.merge, 16.0) && lg.adaptive, "liquid optics")
  let lg_spot = Glass::liquid(spot=(12.0, 24.0))
  match lg_spot.spot {
    Some((sx, sy)) => debug_assert(near(sx, 12.0) && near(sy, 24.0), "liquid spot")
    None => debug_assert(false, "expected spot")
  }
  let fg = Glass::frosted(blur=12.0, tint=color_i64(0xFFFF, 0xFF80), solid=color_i64(0xF0F0, 0xF0FF))
  debug_assert(!fg.liquid && !fg.shares_capture && near(fg.blur, 12.0), "frosted")
  let fg2 = fg.sharing()
  debug_assert(fg2.shares_capture && near(fg2.blur, 12.0), "sharing")

  let r = rect(10.0, 20.0, 100.0, 50.0, color=color_i64(0xFF00, 0x00FF))
  debug_assert(near(r.x, 10.0) && near(r.w, 100.0) && near(r.corners.0, 0.0), "rect default corners")
  let r2 = rect_of(0.0, 0.0, 40.0, 40.0, color=color_i64(0x00FF, 0x00FF), corners=(8.0, 8.0, 8.0, 8.0))
  debug_assert(near(r2.corners.3, 8.0), "rect_of corners")
}

test "paint: linked corners follow window corner and respect zoom & ranges" {
  let ranges = CornerFit::{ least: 6.0, most: 34.0, near: 4.0, far: 16.0 }
  let edge = CornerOf::Follow(CornerOf::Window, 6.0, 34.0)
  let mac = CornerRoots::{ window: 16.0, fit: Some(ranges), zoom: 1.0 }
  let full = CornerRoots::{ window: 0.0, fit: Some(ranges), zoom: 1.0 }
  debug_assert(near(corner_radius(edge, mac), concentric(16.0, 6.0)), "mac concentric")
  debug_assert(corner_follows(edge, mac), "mac follows")
  debug_assert(near(corner_radius(edge, full), 34.0) && !corner_follows(edge, full), "full alone")
  let inner = CornerOf::Follow(edge, 6.0, 10.0)
  debug_assert(near(corner_radius(inner, full), concentric(34.0, 6.0)), "inner follows full")
  debug_assert(near(corner_radius(inner, mac), 10.0), "inner alone on mac")

  let enlarged = CornerRoots::{ window: 10.0, fit: Some(ranges), zoom: 2.0 }
  let edge2 = CornerOf::Follow(CornerOf::Window, 6.0, 28.0)
  debug_assert(corner_follows(edge2, enlarged) && near(corner_radius(edge2, enlarged), 4.0), "zoomed follows")
  let unzoomed = CornerRoots::{ window: 10.0, fit: Some(ranges), zoom: 1.0 }
  debug_assert(!corner_follows(edge2, unzoomed), "unzoomed alone")
}

test "paint: subline, tension_line, dashed_outlines, meniscus_outline" {
  let white = color_i64(0xFFFF, 0xFFFF)
  let tick = [(0.0, 0.0), (6.0, 8.0), (12.0, 0.0)]
  let whole = subline(tick, from=0.0, upto=1.0, width=2.0, color=white)
  let first = subline(tick, from=0.0, upto=0.25, width=2.0, color=white)
  let middle = subline(tick, from=0.25, upto=0.75, width=2.0, color=white)
  let none_l = subline(tick, from=0.6, upto=0.6, width=2.0, color=white)
  debug_assert(whole.points.length() == 3 && near(whole.upto, 1.0), "whole")
  debug_assert(first.points.length() == 2 && near(first.points[1].0, 3.0) && near(first.points[1].1, 4.0), "first")
  debug_assert(middle.points.length() == 3 && near(length_of(middle.points), 10.0), "middle")
  debug_assert(none_l.points.length() == 0, "none")

  let rest = tension_line(200.0, 3.0, 0.04, 100.0)
  debug_assert(rest.length() == 2, "rest 2 pts")
  let pulled = tension_line(200.0, 3.0, 6.0, 80.0)
  debug_assert(pulled.length() > 10 && near(pulled[0].0, 3.0) && near(pulled[pulled.length() - 1].1, 200.0), "pulled ends")

  let dashes = dashed_outlines(100.0, 60.0, 8.0, 2.0)
  debug_assert(dashes.length() > 5, "dashes count")

  let disc = meniscus_outline(0.0, 10.0, 4.0, 60.0, 9.0, 0.0)
  let drop = meniscus_outline(0.0, 10.0, 4.0, 60.0, 9.0, 1.0)
  debug_assert(disc.length() == 1 && disc[0].1 && drop.length() == 1 && drop[0].1, "meniscus closed")
}

test "paint: vector_shapes converts pixels::Vector" {
  let v = pixels::Vector::{
    w: 24.0,
    h: 24.0,
    layers: [
      pixels::VectorPath::{
        d: "M 2 2 L 22 2 L 22 22 L 2 22 Z",
        fill: color_i64(0xFF00, 0x00FF),
        stroke: 0.to_int64(),
        width: 0.0,
        even_odd: false,
        sx: 1.0,
        sy: 1.0,
        tx: 0.0,
        ty: 0.0,
      },
    ],
  }
  let shapes = vector_shapes(v, 48.0, 2.0)
  debug_assert(shapes.length() == 1 && shapes[0].outlines.length() == 1, "vector_shapes")
}

fn on_curve(r : Double, s : Double, a : Double) -> (Double, Double, Double, Double) {
  let n = 2.0 + (smooth_exponent - 2.0) * s
  let big = r * (1.0 + (smooth_scale - 1.0) * s)
  let c = dmath::cos(a)
  let sn = dmath::sin(a)
  let rho = dmath::pow(dmath::pow(c, n) + dmath::pow(sn, n), -1.0 / n)
  let x = big * rho * c
  let y = big * rho * sn
  let gx = dmath::pow(x, n - 1.0)
  let gy = dmath::pow(y, n - 1.0)
  let gl = (gx * gx + gy * gy).sqrt()
  (300.0 - big + x, 200.0 - big + y, gx / gl, gy / gl)
}

test "paint: smooth superellipse corner, smoothness, concentric, det_pow" {
  debug_assert((smooth_exponent * smooth_exponent - 8.0).abs() < 1.0e-12, "exponent^2 = 8")
  for j in 0..=40 {
    let (x, y, _, _) = on_curve(160.0, 1.0, 1.5707963267948966 * j.to_double() / 40.0)
    let d = corner_shape(x, y, 300.0, 200.0, 160.0, 1.0, 1.0e30)
    debug_assert(d.abs() < 0.01, "on smooth curve")
  }
  debug_assert(near(smoothness(26.0, 26.0), 0.0), "capsule smoothness 0")
  debug_assert(near(smoothness(26.0, 32.5), 1.0), "full smoothness 1")
  debug_assert(near(concentric(26.0, 10.0), 16.0), "concentric")
  debug_assert(near(concentric_out(16.0, 10.0), 26.0), "concentric_out")
  debug_assert(near(capsule_in(28.0, 20.0), 18.0), "capsule_in")
  let m = smooth_middle(20.0)
  debug_assert(sd_corner(300.0 - m, 200.0 - m, 300.0, 200.0, 20.0, 1.0).abs() < 1.0e-3, "smooth_middle")
  let xs = [1.0e-6, 0.001, 0.25, 0.5, 0.9, 1.0, 1.3, 2.0]
  let es = [0.353553, 0.5, 1.0, 2.0, 2.8284271247461903]
  for x in xs {
    for e in es {
      let want = dmath::pow(x, e)
      let got = det_pow(x, e)
      debug_assert((got - want).abs() <= want * 4.0e-14, "det_pow precision")
    }
  }
  debug_assert(near(det_pow(0.0, 2.0), 0.0), "det_pow 0")
}
