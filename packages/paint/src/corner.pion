}

///|
/// The radius of what it follows, where it is a `Follow`.
pub fn CornerOf::source(self : CornerOf, at : CornerRoots) -> Option[Double] {
  match self {
    CornerOf::Follow(from, _, _) => Some(from.radius(at))
    _ => Option::None
  }
}

///|
/// Where a capsule or a circle `height` high stands in it to be concentric with it (its radius less the capsule's half:
/// capsule_in), where the theme's ranges let it stand there; None where they do not (it too square for the capsule, or too
/// round).
pub fn CornerOf::capsule_at(self : CornerOf, height : Double, at : CornerRoots) -> Option[Double] {
  let r = self.radius(at)
  let d = capsule_in(r, height)
  if place_fit_ok(at.fit, d) {
    Some(d)
  } else {
    Option::None
  }
}

///|
/// Whether a corner `k` round, `d` in from what it follows, is one ranges `fit` let it have (any where there are none).
/// A window does not zoom with its contents: for its linked corners, the smallest visible radius is judged after the
/// content zoom, so an enlarged but still visibly round corner does not suddenly fall back to its unrelated own radius
/// (worked out there, the window's less how far in that stands, both as drawn: a Mac's 16 at 1.75, 6 in, 5.5, not
/// 5.4999… out of a corner taken apart by the zoom and put back).
fn corner_fit_ok(fit : Option[CornerFit], k : Double, d : Double, zoom : Double) -> Bool {
  match fit {
    Some(f) => (k * zoom * 1.0e6).round() / 1.0e6 >= f.least - 0.5 && k <= f.most + 0.5 && d >= f.near - 0.5 && d <= f.far + 0.5
    Option::None => k >= 0.0
  }
}

///|
/// Whether `d` in from a corner's edges is a place ranges `fit` let what lies there stand.
fn place_fit_ok(fit : Option[CornerFit], d : Double) -> Bool {
  match fit {
    Some(f) => d >= f.near - 0.5 && d <= f.far + 0.5
    Option::None => d >= 0.0
  }
}
