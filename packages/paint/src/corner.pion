///|
/// Its radius, from `at`.
pub fn CornerOf::radius(self : CornerOf, at : CornerRoots) -> Double {
  match self {
    CornerOf::Window => at.window
    CornerOf::Own(r) => r
    CornerOf::Follow(from, inset, alone) => {
      let r = from.radius(at)
      let k = concentric(r, inset)
      if r > 0.0 && inset < r && corner_fit_ok(at.fit, k, inset, if from is CornerOf::Window { at.zoom } else { 1.0 }) {
        k
      } else {
        alone
      }
    }
  }
}

///|
/// Whether it follows what it says, from `at` (a `Follow` concentric with its source, not standing alone; a root
/// always).
pub fn CornerOf::follows(self : CornerOf, at : CornerRoots) -> Bool {
  match self {
    CornerOf::Follow(from, inset, _) => {
      let r = from.radius(at)
      r > 0.0 && inset < r && corner_fit_ok(at.fit, concentric(r, inset), inset, if from is CornerOf::Window { at.zoom } else { 1.0 })
    }
    _ => true
  }
}

///|
/// Where it stands from its source's edges where it follows it (a `Follow`'s inset), None where it does not.
pub fn CornerOf::inset(self : CornerOf, at : CornerRoots) -> Option[Double] {
