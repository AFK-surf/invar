// Linked concentric corner radius resolution.
// Ported from libs/mbui/src/paint/corner.mbt.

pub enum CornerOf {
  Window
  Own(Double)
  Follow(CornerOf, Double, Double)
}

pub struct CornerFit {
  pub least : Double
  pub most : Double
  pub near : Double
  pub far : Double
}

pub struct CornerRoots {
  pub window : Double
  pub fit : Option[CornerFit]
  pub zoom : Double
}

pub fn corner_radius(self : CornerOf, at : CornerRoots) -> Double {
  match self {
    CornerOf::Window => at.window
    CornerOf::Own(r) => r
    CornerOf::Follow(from, inset, alone) => {
      let r = corner_radius(from, at)
      let k = concentric(r, inset)
      let is_win = match from {
        CornerOf::Window => true
        _ => false
      }
      if r > 0.0 && inset < r && corner_fit_ok(at.fit, k, inset, if is_win { at.zoom } else { 1.0 }) {
        k
      } else {
        alone
      }
    }
  }
}

pub fn corner_follows(self : CornerOf, at : CornerRoots) -> Bool {
  match self {
    CornerOf::Follow(from, inset, _) => {
      let r = corner_radius(from, at)
      let is_win = match from {
        CornerOf::Window => true
        _ => false
      }
      r > 0.0 && inset < r && corner_fit_ok(at.fit, concentric(r, inset), inset, if is_win { at.zoom } else { 1.0 })
    }
    _ => true
  }
}

pub fn corner_inset(self : CornerOf, at : CornerRoots) -> Option[Double] {
  match self {
    CornerOf::Follow(_, inset, _) => if corner_follows(self, at) { Some(inset) } else { None }
    _ => None
  }
}

pub fn corner_source(self : CornerOf, at : CornerRoots) -> Option[Double] {
  match self {
    CornerOf::Follow(from, _, _) => Some(corner_radius(from, at))
    _ => None
  }
}

pub fn corner_capsule_at(self : CornerOf, height : Double, at : CornerRoots) -> Option[Double] {
  let r = corner_radius(self, at)
  let d = capsule_in(r, height)
  if place_fit_ok(at.fit, d) {
    Some(d)
  } else {
    None
  }
}

fn corner_fit_ok(fit : Option[CornerFit], k : Double, d : Double, zoom : Double) -> Bool {
  match fit {
    Some(f) => (k * zoom * 1.0e6).round() / 1.0e6 >= f.least - 0.5 && k <= f.most + 0.5 && d >= f.near - 0.5 && d <= f.far + 0.5
    None => k >= 0.0
  }
}

fn place_fit_ok(fit : Option[CornerFit], d : Double) -> Bool {
  match fit {
    Some(f) => d >= f.near - 0.5 && d <= f.far + 0.5
    None => d >= 0.0
  }
}
