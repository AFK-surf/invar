// Aura Studio — Browser WebGL2 / WebAssembly entry point.
// Installs the WebGL2 host bridge (`host_web::install`), reads the URL query switches
// (`?dark=`, `?vibrant=`, `?rtl=`, `?circular=`, `?cat=`) into one reactive `aura::AuraConfig`,
// mounts `aura_pages::gallery`, and drives `ui::view_frame` + input events via `hostapi::run`.

import "aura"
import "aura_pages"
import "host_web"
import "signals"
import "ui"
import "view"

/// Whether a query switch is on (`1`, `true`, or its own name such as `dark=dark`).
fn web_flag(raw : String, name : String) -> Bool {
  raw == "1" || raw == "true" || raw == name
}

fn main() -> Unit {
  host_web::install()
  let dark = web_flag(ui::env("dark"), "dark")
  let vibrant = web_flag(ui::env("vibrant"), "vibrant")
  let rtl = web_flag(ui::env("rtl"), "rtl")
  let corner_circular = web_flag(ui::env("circular"), "circular")
  let cat_env = ui::env("cat")
  let web_cfg : signals::Signal[aura::AuraConfig] = signals::signal(
    aura::AuraConfig::{ ..aura::AuraConfig::default(), dark, vibrant, rtl, corner_circular },
  )
  aura_pages::set_library_initial_cat(aura_pages::parse_library_cat(cat_env))
  view::faults_stop.v = false
  ui::run(
    "Invar · Aura Studio (Pion WASM)",
    fn(root) { aura_pages::gallery(root, web_cfg, chrome=true) },
    theme=fn() { aura::aura_ui_theme(web_cfg.get()) },
  )
}
