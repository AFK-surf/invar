def _pionc_supports_query_analyze(pionc_info):
    if not pionc_info.get("found") or not pionc_info.get("path"):
        return False
    rc, out, err, _ = run_cmd([pionc_info["path"], "--help"])
    help_text = out + "\n" + err
    return bool(re.search(r"\bquery\b[^\n]*\banalyze\b", help_text))


def _is_reactive_read_closure(cl):
    cc = cl.get("context_callee", "")
    ca = cl.get("context_arg", "")
    if cc in REACTIVE_GETTER_CALLEES and ca in REACTIVE_GETTER_ARGS:
        return True
    if cc in ("view::View::reacts", "view::View::reacts_by") and ca in ("0", "read"):
        return True
    if cc == "ui::Show" and ca in ("when", "0"):
        return True
    if ca.endswith("_by") and not ca.startswith("on_") and ca not in ("children", "ref_view"):
        return True
    return False


def _is_reactive_io_target(target):
    if target in ("builtin::scope", "builtin::spawn"):
        return True
    for pref in ("builtin::io_", "builtin::fs_", "builtin::net_", "builtin::proc_", "builtin::sleep"):
        if target.startswith(pref):
            return True
    return False


def _is_safe_reactive_capture_ty(ty):
    if not ty:
        return False
    if ty in REACTIVE_SAFE_SIGNAL_EXACT or ty.startswith(REACTIVE_SAFE_SIGNAL_PREFIXES):
        return True
    if ty in REACTIVE_SAFE_FRAMEWORK_HANDLE_EXACT or ty.startswith(REACTIVE_SAFE_FRAMEWORK_HANDLE_PREFIXES):
        return True
    if ty.startswith("Option[") and ty.endswith("]"):
        return _is_safe_reactive_capture_ty(ty[7:-1])
    return False


def _is_writable_signal_ty(ty):
    if not ty:
        return False
    if ty in REACTIVE_WRITABLE_SIGNAL_EXACT or ty.startswith(REACTIVE_WRITABLE_SIGNAL_PREFIXES):
        return True
    if ty.startswith("Option[") and ty.endswith("]"):
        return _is_writable_signal_ty(ty[7:-1])
    return False


_EFFECT_READ_METHODS = {"get", "has", "keys", "count", "laid_size_told"}
_EFFECT_WRITE_METHODS = {
    "set", "update", "set_at", "update_at", "push", "remove", "clear",
    "insert", "insert_at", "swap", "replace", "mark", "notify", "dispatch",
    "put", "drop", "begin", "clear_error", "succeed", "succeed_if_latest",
    "fail", "fail_if_latest", "cancel",
}


def _get_cached_file_lines(file_lines_cache, file_path):
    lines = file_lines_cache.get(file_path)
    if lines is None:
        try:
            with open(file_path, "r", encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
        except OSError:
            lines = []
        file_lines_cache[file_path] = lines
    return lines


def _extract_closure_body(lines, start_line, start_col):
    if not lines or start_line <= 0 or start_line > len(lines):
        return ""
    # Join from start_line onward (capped to 250 lines for safety)
    chunk_lines = lines[start_line - 1 : min(len(lines), start_line - 1 + 250)]
    if not chunk_lines:
        return ""
    col0 = max(0, int(start_col or 1) - 1)
    text = chunk_lines[0][col0:] + "".join(chunk_lines[1:])
    # Find opening '{' of closure body
    open_idx = text.find("{")
    if open_idx == -1:
        return ""
    depth = 0
    i = open_idx
    n = len(text)
    in_str = False
    while i < n:
        ch = text[i]
        if in_str:
            if ch == "\\" and i + 1 < n:
                i += 2
                continue
            if ch == '"':
                in_str = False
            i += 1
            continue
        if ch == "/" and i + 1 < n and text[i + 1] == "/":
            nl = text.find("\n", i + 2)
            i = n if nl == -1 else nl + 1
            continue
        if ch == '"':
            in_str = True
            i += 1
            continue
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return text[open_idx + 1 : i]
        i += 1
    return ""


def _strip_pion_comments_and_strings(src):
    out = []
    i = 0
    n = len(src)
    while i < n:
        c = src[i]
        nxt = src[i + 1] if i + 1 < n else ""
        if c == "/" and nxt == "/":
            i += 2
            while i < n and src[i] != "\n":
                i += 1
        elif c == "/" and nxt == "*":
            i += 2
            depth = 1
            while i < n and depth > 0:
                if src[i] == "/" and i + 1 < n and src[i + 1] == "*":
                    depth += 1
                    i += 2
                elif src[i] == "*" and i + 1 < n and src[i + 1] == "/":
                    depth -= 1
                    i += 2
                else:
                    if src[i] == "\n":
                        out.append("\n")
                    i += 1
        elif c == '"':
            out.append('""')
            i += 1
            while i < n:
                if src[i] == "\\":
                    i += 2
                elif src[i] == '"':
                    i += 1
                    break
                else:
                    if src[i] == "\n":
                        out.append("\n")
                    i += 1
        elif c == "'":
            end = _pion_char_literal_end(src, i)
            if end > 0:
                out.append("''")
                i = end
            else:
                out.append(c)
                i += 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


def _pion_char_literal_end(src, i):
    """Index just past the char literal starting at src[i] == "'" ('a', '"', '\\'', '\\x41',
    '\\u{1F}'), or 0 when no char literal starts there."""
    n = len(src)
    j = i + 1
    if j >= n or src[j] in ("\n", "'"):
        return 0
    if src[j] == "\\":
        j += 1
        if j >= n:
            return 0
        if src[j] == "u" and j + 1 < n and src[j + 1] == "{":
            close = src.find("}", j + 2, j + 10)
            if close == -1:
                return 0
            j = close + 1
        elif src[j] == "x":
            j += 3
        else:
            j += 1
    else:
        j += 1
    if j < n and src[j] == "'":
        return j + 1
    return 0


_SIGNAL_ALIAS_RE = re.compile(
    r"\blet\s+(?:mut\s+)?([A-Za-z_]\w*)\s*(?::[^=\n]+)?=\s*([A-Za-z_]\w*)(?:\s*\.\s*read\s*\(\s*\))?(?=\s*(?:[;\n]|$))"
)


_ANY_LET_RE = re.compile(r"\blet\s+(?:mut\s+)?([A-Za-z_]\w*)\b")


def _lookup_binding(name, scope_stack):
    """The lexical identity `(decl_id, root_name)` `name` has in `scope_stack` (innermost block
    first): what it was bound to as it was declared. A name declared nowhere in view is the
    binding from outside the scanned code (a parameter, a capture from further out): `(0, name)`."""
    for layer in reversed(scope_stack):
        if name in layer:
            return layer[name]
    return (0, name)


def _collect_signal_aliases(lines, start_line):
    """The bindings in force where the effect is made (`name -> (decl_id, root_name)`), and the
    counter of fresh declaration ids to go on with in the closure body."""
    outer_env = {}
    next_id = [1]
    if not lines or start_line <= 1:
        return outer_env, next_id
    # Walk backward to the true enclosing fn header (no fixed line cap)
    fn_start = 0
    for idx in range(start_line - 2, -1, -1):
        if re.match(r"^\s*(?:pub\s+)?fn\s+[A-Za-z_]", lines[idx]):
            fn_start = idx
            break
    prefix_src = "\n".join(lines[fn_start : start_line - 1])
    cleaned_prefix = _strip_pion_comments_and_strings(prefix_src)
    _walk_scoped_aliases(cleaned_prefix, [{}], None, outer_env, next_id)
    return outer_env, next_id


def _let_stmt_end(src, pos):
    """Index where the initializer of a `let` starting before `pos` ends (at `;`, `\\n`, or an
    unmatched closing delimiter, with `()`, `[]`, `{}` balanced): a shadowed `let a = a.get()`
    still resolves `a.get()` against the outer `a` before the new `a` enters scope."""
    depth = 0
    n = len(src)
    i = pos
    while i < n:
        ch = src[i]
        if ch in "([{":
            depth += 1
        elif ch in ")]}":
            if depth == 0:
                return i
            depth -= 1
        elif depth == 0 and ch in ";\n":
            return i
        i += 1
    return n


def _walk_scoped_aliases(cleaned, scope_stack, on_call, out_aliases=None, next_id=None):
    """Walk `cleaned` in source order keeping one binding table per open `{`, dropped at its `}`:
    a `let` holds only to the end of its block. Each binding is the lexical identity
    `(decl_id, root_name)` fixed as it is declared: an alias `let ro = a[.read()]` takes the
    identity `a` has right there, so a later inner `let a = b` never changes what `ro` is; any
    other `let x = ...` is a new binding of its own, entering scope once its initializer ends.
    `on_call(recv, meth, scope_stack)` sees each `recv.meth(` with the bindings in force right
    there; `out_aliases` gets the bindings still in force at the end."""
    if next_id is None:
        next_id = [1]
    alias_ms = list(_SIGNAL_ALIAS_RE.finditer(cleaned))
    alias_starts = {m.start() for m in alias_ms}
    events = [(m.end(), "let", m) for m in alias_ms]
    events += [
        (_let_stmt_end(cleaned, m.end()), "newlet", m)
        for m in _ANY_LET_RE.finditer(cleaned)
        if m.start() not in alias_starts
    ]
    events += [(k, ch, None) for k, ch in enumerate(cleaned) if ch in "{}"]
    if on_call is not None:
        events += [(m.start(), "call", m) for m in _SIGNAL_CALL_RE.finditer(cleaned)]
    # (a binding that ends at `}` belongs to the block about to close; calls after it see it)
    order = {"let": 0, "newlet": 0, "{": 1, "}": 1, "call": 2}
    events.sort(key=lambda e: (e[0], order[e[1]]))

    def fresh(name):
        nid = next_id[0]
        next_id[0] += 1
        return (nid, name)

    for _, kind, m in events:
        if kind == "{":
            scope_stack.append({})
        elif kind == "}":
            if len(scope_stack) > 1:
                scope_stack.pop()
        elif kind == "let":
            lhs, rhs = m.group(1), m.group(2)
            if rhs in ("true", "false", "None"):
                scope_stack[-1][lhs] = fresh(lhs)
            else:
                # (resolved before the new binding is in force: `let a = a` is the outer `a`)
                scope_stack[-1][lhs] = _lookup_binding(rhs, scope_stack)
        elif kind == "newlet":
            lhs = m.group(1)
            scope_stack[-1][lhs] = fresh(lhs)
        else:
            on_call(m.group(1), m.group(2), scope_stack)
    if out_aliases is not None:
        for layer in scope_stack:
            out_aliases.update(layer)


_SIGNAL_CALL_RE = re.compile(r"\b([A-Za-z_]\w*)\s*\.\s*([A-Za-z_]\w*)\s*\(")


def _analyze_effect_signal_identity(file_lines_cache, fpath, line, col, captures, rchain_len, wchain_len):
    lines = _get_cached_file_lines(file_lines_cache, fpath)
    body = _extract_closure_body(lines, line, col)
    if not body:
        return ("unknown", [])
    cleaned = _strip_pion_comments_and_strings(body)
    cap_names = {c.get("name", "") for c in captures if c.get("name")}
    outer_env, next_id = _collect_signal_aliases(lines, line)
    # (what the captured names are bound to where the effect is made: the only signals it can touch)
    captured_identities = {_lookup_binding(c, [outer_env]) for c in cap_names}
    read_roots = set()
    write_roots = set()

    def on_call(recv, meth, scope_stack):
        ident = _lookup_binding(recv, scope_stack)
        if ident not in captured_identities:
            return
        if meth in _EFFECT_READ_METHODS:
            read_roots.add(ident)
        elif meth in _EFFECT_WRITE_METHODS:
            write_roots.add(ident)

    # The bindings in force where the effect is made sit at the bottom; the body's own blocks
    # stack over them.
    _walk_scoped_aliases(cleaned, [outer_env], on_call, None, next_id)
    shared_idents = read_roots & write_roots
    if shared_idents:
        return ("same", sorted({name for (_, name) in shared_idents}))
    if read_roots and write_roots and read_roots.isdisjoint(write_roots) and rchain_len == 1 and wchain_len == 1:
        return ("distinct", [])
    return ("unknown", [])


def _has_inline_allow(file_lines_cache, file_path, line, code):
    if not file_path or line <= 0:
        return False
    lines = _get_cached_file_lines(file_lines_cache, file_path)
    short_code = _AUDIT_SHORT_CODES.get(code, code)
    for ln in (line, line - 1):
        if 1 <= ln <= len(lines):
            text = lines[ln - 1]
            idx = text.find("invar-audit-allow:")
            if idx != -1:
                tail = text[idx + len("invar-audit-allow:"):]
                tokens = {tok.strip() for tok in re.split(r"[,\s;]+", tail) if tok.strip()}
                if code in tokens or short_code in tokens or "all" in tokens:
                    return True
    return False


def _bfs_find_call_chain(direct_calls, fn_calls, pred, opaque_nodes=()):
    q = deque()
    visited = set()
    for c in direct_calls:
        t = c.get("target", "")
        if not t or t in opaque_nodes:
            continue
        if pred(t):
            return [t]
        if t not in visited:
            visited.add(t)
            q.append((t, [t]))
    while q:
        cur, path = q.popleft()
        for nxt in fn_calls.get(cur, ()):
            if not nxt or nxt in opaque_nodes:
                continue
            if pred(nxt):
                return path + [nxt]
            if nxt not in visited:
                visited.add(nxt)
                q.append((nxt, path + [nxt]))
    return None


def _discover_analyze_targets(target_dir):
    if not target_dir:
        if os.path.isfile(os.path.join(INVAR_ROOT, "pion.toml")):
            return [INVAR_ROOT]
        targets = []
        for sub in ("packages", "examples"):
            sd = os.path.join(INVAR_ROOT, sub)
            if os.path.isdir(sd):
                for name in sorted(os.listdir(sd)):
                    p = os.path.join(sd, name)
                    if os.path.isfile(os.path.join(p, "pion.toml")):
                        targets.append(p)
        return targets

    if os.path.isfile(os.path.join(target_dir, "pion.toml")) or os.path.isdir(os.path.join(target_dir, "src")):
        return [target_dir]

    skip_dirs = {".git", "target", "_build", "node_modules", "out", "tmp", "__pycache__"}
    targets = []
    for r_d, ds, fs in os.walk(target_dir):
        ds[:] = [d for d in sorted(ds) if d not in skip_dirs and not d.startswith(".")]
        if "pion.toml" in fs:
            targets.append(r_d)
            ds[:] = []
    return targets


def _run_reactive_audit(target_dir, no_reactive, add_diag):
    if no_reactive:
        return {"ran": False, "reason": "disabled via --no-reactive"}

    pionc = resolve_pionc()
    if not pionc["found"]:
        return {"ran": False, "reason": "pionc not found"}

    if not _pionc_supports_query_analyze(pionc):
        return {"ran": False, "reason": "pionc does not support `query analyze`"}

    targets = _discover_analyze_targets(target_dir)
    if not targets:
        return {"ran": False, "reason": "no Pion packages found in target"}

    env = build_pion_env(pionc)
    fn_calls = {}
    closures = []
    seen_closures = set()

    for t in targets:
        rc, out, err, _ = run_cmd([pionc["path"], "query", "analyze", "--json", t], cwd=INVAR_ROOT, env=env)
        combined_err = (out + "\n" + err).lower()
        if rc != 0 and ("unknown query kind" in combined_err or "usage:" in combined_err):
            return {"ran": False, "reason": "pionc does not support `query analyze`"}
        payload = None
        if out.strip():
            try:
                payload = json.loads(out)
            except ValueError:
                payload = None
        if not isinstance(payload, dict) or "closures" not in payload or "fns" not in payload:
            reason = (err.strip() or out.strip() or f"exit code {rc}")[:200]
            return {"ran": False, "reason": f"pionc query analyze failed for {t}: {reason}"}

        for fn in payload.get("fns", []):
            fq = f"{fn.get('pkg', '')}::{fn.get('name', '')}"
            if fq not in fn_calls:
                fn_calls[fq] = [c.get("target", "") for c in fn.get("calls", []) if c.get("target")]

        for cl in payload.get("closures", []):
            fpath = os.path.realpath(cl.get("file", "")) if cl.get("file") else ""
            key = (fpath, cl.get("line", 0), cl.get("col", 0), cl.get("context_callee", ""), cl.get("context_arg", ""))
            if key not in seen_closures:
                seen_closures.add(key)
                closures.append((fpath, cl))

    scope_root = os.path.realpath(target_dir) if target_dir else INVAR_ROOT
    file_lines_cache = {}
    closures_checked = 0

    for fpath, cl in closures:
        if not fpath:
            continue
        if fpath != scope_root and not fpath.startswith(scope_root + os.sep):
            continue
        if fpath.endswith("_test.pion"):
            continue

        closures_checked += 1
        rel = os.path.relpath(fpath, INVAR_ROOT) if fpath.startswith(INVAR_ROOT + os.sep) else fpath
        line = int(cl.get("line", 1) or 1)
        cc = cl.get("context_callee", "")
        ca = cl.get("context_arg", "")
        ctx_desc = f"{cc}({ca})" if cc else f"arg {ca}"

        if _is_reactive_read_closure(cl):
            # E007: Reactive read closure writing signals directly or transitively
            if not _has_inline_allow(file_lines_cache, fpath, line, "INVAR_E007_REACTIVE_WRITE"):
                wchain = _bfs_find_call_chain(
                    cl.get("calls", []),
                    fn_calls,
                    lambda tgt: tgt in REACTIVE_SIGNAL_WRITES,
                    opaque_nodes=REACTIVE_E007_OPAQUE_INTERNALS,
                )
                if wchain:
                    chain_str = " -> ".join(["closure"] + wchain)
                    add_diag(
                        "INVAR_E007_REACTIVE_WRITE",
                        "error",
                        rel,
                        line,
                        f"Reactive read closure `{ctx_desc}` writes signal via call chain: {chain_str}",
                        "Do not write signals inside reactive getters or render bindings; move signal writes into event callbacks (on_press, etc.), ui::Worker handlers, signals::Action, or signals::effect.",
                    )

            # E008: Reactive read closure capturing let mut or non-reactive mutable objects
            if not _has_inline_allow(file_lines_cache, fpath, line, "INVAR_E008_REACTIVE_MUT_CAPTURE"):
                is_internal_engine_file = (
                    rel in REACTIVE_E008_INTERNAL_FILES
                    or rel.startswith(REACTIVE_E008_INTERNAL_PREFIXES)
                )
                for cap in cl.get("captures", []):
                    cap_name = cap.get("name", "")
                    cap_ty = cap.get("ty", "")
                    if cap.get("is_mut"):
                        add_diag(
                            "INVAR_E008_REACTIVE_MUT_CAPTURE",
                            "error",
                            rel,
                            line,
                            f"Reactive read closure `{ctx_desc}` captures mutable binding `let mut {cap_name} : {cap_ty}`",
                            "Replace `let mut` with `signals::signal(...)` / `ReadSignal` or an immutable `val struct` snapshot so UI updates track changes.",
                        )
                    elif (
                        not is_internal_engine_file
                        and cap.get("is_mutable_ty")
                        and not _is_safe_reactive_capture_ty(cap_ty)
                    ):
                        add_diag(
                            "INVAR_E008_REACTIVE_MUT_CAPTURE",
                            "error",
                            rel,
                            line,
                            f"Reactive read closure `{ctx_desc}` captures non-reactive mutable value `{cap_name} : {cap_ty}`",
                            "Use `signals::signal(...)` / `ReadSignal` / `Computed`, or an immutable `val struct` snapshot; mutations to non-reactive objects will not trigger UI updates.",
                        )

            # E010: Reactive read closure performing blocking IO or spawning threads
            if not _has_inline_allow(file_lines_cache, fpath, line, "INVAR_E010_REACTIVE_IO"):
                iochain = _bfs_find_call_chain(
                    cl.get("calls", []),
                    fn_calls,
                    _is_reactive_io_target,
                )
                if iochain:
                    chain_str = " -> ".join(["closure"] + iochain)
                    add_diag(
                        "INVAR_E010_REACTIVE_IO",
                        "error",
                        rel,
                        line,
                        f"Reactive read closure `{ctx_desc}` performs blocking IO/concurrency via call chain: {chain_str}",
                        "Never perform IO or spawn threads inside reactive getters or render bindings; move IO into `ui::Worker`.",
                    )

        # E009: signals::effect reading and writing the same captured signal (or its .read() alias)
        if cc in REACTIVE_EFFECT_CALLEES and ca in ("0", "f"):
            if not _has_inline_allow(file_lines_cache, fpath, line, "INVAR_E009_EFFECT_SELF_WRITE"):
                captures = cl.get("captures", [])
                writable_caps = [
                    cap for cap in captures
                    if _is_writable_signal_ty(cap.get("ty", ""))
                ]
                if writable_caps:
                    rchain_any = _bfs_find_call_chain(
                        cl.get("calls", []),
                        fn_calls,
                        lambda tgt: tgt in REACTIVE_SIGNAL_READS,
                    )
                    wchain = _bfs_find_call_chain(
                        cl.get("calls", []),
                        fn_calls,
                        lambda tgt: tgt in REACTIVE_SIGNAL_WRITES,
                        opaque_nodes=REACTIVE_E007_OPAQUE_INTERNALS,
                    )
                    if rchain_any and wchain:
                        col = int(cl.get("col", 1) or 1)
                        id_kind, shared_sigs = _analyze_effect_signal_identity(
                            file_lines_cache, fpath, line, col, captures, len(rchain_any), len(wchain)
                        )
                        if id_kind == "same":
                            cap_names = ", ".join(shared_sigs)
                            add_diag(
                                "INVAR_E009_EFFECT_SELF_WRITE",
                                "error",
                                rel,
                                line,
                                f"`{cc}` both reads ({' -> '.join(rchain_any)}) and writes ({' -> '.join(wchain)}) the same signal(s) [{cap_names}]",
                                "Avoid reading and writing the same signal inside `signals::effect` (risk of cross-frame self-trigger loops); use `signals::computed` / `signals::derived_signal` for derived state or move writes into event handlers.",
                            )
                        elif id_kind == "unknown":
                            rchain_w = _bfs_find_call_chain(
                                cl.get("calls", []),
                                fn_calls,
                                lambda tgt: tgt in REACTIVE_WRITABLE_SIGNAL_READS,
                                opaque_nodes=REACTIVE_READONLY_SIGNAL_READS,
                            )
                            if rchain_w:
                                cap_names = ", ".join(c.get("name", "") for c in writable_caps)
                                add_diag(
                                    "INVAR_E009_EFFECT_SELF_WRITE",
                                    "error",
                                    rel,
                                    line,
                                    f"`{cc}` both reads ({' -> '.join(rchain_w)}) and writes ({' -> '.join(wchain)}) with captured signal(s) [{cap_names}]",
                                    "Avoid reading and writing signals inside the same `signals::effect` (risk of cross-frame self-trigger loops); use `signals::computed` / `signals::derived_signal` for derived state or move writes into event handlers.",
                                )

    return {
        "ran": True,
        "closures_checked": closures_checked,
        "fns_checked": len(fn_calls),
    }


def _unescape_c_str(raw):
    out = []
    i = 0
    n = len(raw)
    esc_map = {"n": "\n", "r": "\r", "t": "\t", "\\": "\\", '"': '"', "'": "'", "0": "\0"}
    while i < n:
        ch = raw[i]
        if ch == "\\" and i + 1 < n:
            nxt = raw[i + 1]
            out.append(esc_map.get(nxt, nxt))
            i += 2
        else:
            out.append(ch)
            i += 1
    return "".join(out)


def _extract_c_string_concat(text, start_pos, macros=None, unknown_macros=None):
    """Parse concatenated C string literals (and macro identifiers in `macros`) until `;`."""
    macros = macros or {}
    parts = []
    i = start_pos
    n = len(text)
    while i < n:
        ch = text[i]
        if ch in " \t\r\n\\":
            i += 1
            continue
        if ch == "/" and i + 1 < n and text[i + 1] == "/":
            nl = text.find("\n", i + 2)
            i = n if nl == -1 else nl + 1
            continue
        if ch == "/" and i + 1 < n and text[i + 1] == "*":
            end_c = text.find("*/", i + 2)
            i = n if end_c == -1 else end_c + 2
            continue
        if ch == ";":
            break
        if ch == '"':
            i += 1
            buf = []
            while i < n:
                c2 = text[i]
                if c2 == "\\" and i + 1 < n:
                    buf.append(c2)
                    buf.append(text[i + 1])
                    i += 2
                    continue
                if c2 == '"':
                    i += 1
                    break
                buf.append(c2)
                i += 1
            parts.append(_unescape_c_str("".join(buf)))
            continue
        if ch.isalpha() or ch == "_":
            j = i + 1
            while j < n and (text[j].isalnum() or text[j] == "_"):
                j += 1
            ident = text[i:j]
            if ident in macros:
                parts.append(macros[ident])
            elif unknown_macros is not None and re.fullmatch(r"[A-Z][A-Z0-9_]+", ident):
                unknown_macros.append(ident)
            i = j
            continue
        i += 1
    return "".join(parts)


def _win_shader_fnv(data_bytes, h=1469598103934665603):
    for b in data_bytes:
        h ^= b
        h = (h * 1099511628211) & 0xFFFFFFFFFFFFFFFF
    return h


def _check_win_baked_shaders():
    win_render_path = os.path.join(INVAR_ROOT, "packages", "host", "native", "win_render.cpp")
    corner_sl_path = os.path.join(INVAR_ROOT, "packages", "host", "native", "corner_sl.h")
    baked_h_path = os.path.join(INVAR_ROOT, "packages", "host", "native", "win_shaders_baked.h")

    if not os.path.isfile(baked_h_path):
        return {
            "baked_file_exists": False,
            "baked_keys_matched": 0,
            "baked_keys_expected": [],
            "baked_keys_missing": [],
            "error": "missing win_shaders_baked.h",
        }
    if not os.path.isfile(win_render_path) or not os.path.isfile(corner_sl_path):
        return {
            "baked_file_exists": True,
            "baked_keys_matched": 0,
            "baked_keys_expected": [],
            "baked_keys_missing": [],
            "error": "missing win_render.cpp or corner_sl.h",
        }

    # Parse MB_CORNER_SL macro from corner_sl.h
    corner_lines = open(corner_sl_path, "r", encoding="utf-8", errors="replace").read().splitlines()
    macro_body_lines = []
    in_macro = False
    for line in corner_lines:
        if not in_macro:
            if line.startswith("#define MB_CORNER_SL"):
                in_macro = True
                rest = line[len("#define MB_CORNER_SL"):]
                macro_body_lines.append(rest.rstrip("\\"))
                if not line.rstrip().endswith("\\"):
                    break
        else:
            macro_body_lines.append(line.rstrip("\\"))
            if not line.rstrip().endswith("\\"):
                break
    mb_corner_sl = _extract_c_string_concat("\n".join(macro_body_lines) + ";", 0)

    # Parse shader_src from win_render.cpp
    win_src = open(win_render_path, "r", encoding="utf-8", errors="replace").read()
    m_src = re.search(r"static\s+const\s+char\s*\*\s*shader_src\s*=", win_src)
    if not m_src:
        return {
            "baked_file_exists": True,
            "baked_keys_matched": 0,
            "baked_keys_expected": [],
            "baked_keys_missing": [],
            "error": "could not locate shader_src in win_render.cpp",
        }
    unknown_macros = []
    shader_src_str = _extract_c_string_concat(
        win_src, m_src.end(), macros={"MB_CORNER_SL": mb_corner_sl}, unknown_macros=unknown_macros
    )
    if unknown_macros:
        uniq_unknown = sorted(set(unknown_macros))
        return {
            "baked_file_exists": True,
            "baked_keys_matched": 0,
            "baked_keys_expected": [],
            "baked_keys_missing": [],
            "unverified": True,
            "unknown_macros": uniq_unknown,
            "error": f"unverified shader_src: unknown C macro(s) {', '.join(uniq_unknown)}",
        }
    shader_src_bytes = shader_src_str.encode("utf-8")

    # Read baked keys from win_shaders_baked.h
    baked_text = open(baked_h_path, "r", encoding="utf-8", errors="replace").read()
    baked_keys = {int(hx, 16) for hx in re.findall(r"\{0x([0-9a-fA-F]+)ULL\b", baked_text)}

    # Cold-start shaders: D3D_COMPILER_VERSION=47, D3DCOMPILE_OPTIMIZATION_LEVEL3=32768
    made_by = struct.pack("<II", 47, 32768)
    base_h = _win_shader_fnv(shader_src_bytes, 1469598103934665603)
    expected = []
    missing = []
    matched = 0
    for entry, target in (("vmain", "vs_4_0"), ("fmain", "ps_4_0"), ("fflat", "ps_4_0")):
        h = _win_shader_fnv(entry.encode("utf-8") + b"\x00", base_h)
        h = _win_shader_fnv(target.encode("utf-8") + b"\x00", h)
        h = _win_shader_fnv(made_by, h)
        key_hex = f"0x{h:016x}"
        hit = h in baked_keys
        if hit:
            matched += 1
        else:
            missing.append(f"{entry}/{target} ({key_hex})")
        expected.append({"entry": entry, "target": target, "key": key_hex, "matched": hit})

    return {
        "baked_file_exists": True,
        "baked_keys_matched": matched,
        "baked_keys_expected": expected,
        "baked_keys_missing": missing,
        "baked_total_in_header": len(baked_keys),
    }


def cmd_audit(args):
    diags = []

    def add_diag(code, severity, file_path, line, message, fixit):
        diags.append({
            "code": code,
            "severity": severity,
            "file": file_path,
            "line": line,
            "message": message,
            "fixit": fixit,
        })

    target_dir = os.path.realpath(args.target_dir) if args.target_dir else None
    is_external_app = False
    if target_dir:
        in_invar_pkgs = target_dir.startswith(os.path.join(INVAR_ROOT, "packages") + os.sep) or target_dir == os.path.join(INVAR_ROOT, "packages")
        if os.path.isfile(os.path.join(target_dir, "pion.toml")) and not in_invar_pkgs:
            is_external_app = True

    # E001: Hand-rolled Glass::liquid outside packages/lg/
    lg_dir = os.path.realpath(os.path.join(INVAR_ROOT, "packages", "lg"))
    scan_roots = [target_dir] if target_dir else [os.path.join(INVAR_ROOT, "packages"), os.path.join(INVAR_ROOT, "examples")]
    for sr in scan_roots:
        if not os.path.isdir(sr):
            continue
        for r_d, _ds, fs in os.walk(sr):
            real_rd = os.path.realpath(r_d)
            if real_rd == lg_dir or real_rd.startswith(lg_dir + os.sep):
                continue
            for fn in sorted(fs):
                if not fn.endswith(".pion"):
                    continue
                fp = os.path.join(r_d, fn)
                with open(fp, "r", encoding="utf-8", errors="replace") as f:
                    for ln, text in enumerate(f, 1):
                        if "Glass::liquid" in text:
                            # Ignore pure comments explaining the rule
                            stripped = text.lstrip()
                            if stripped.startswith("//"):
                                continue
                            # Allow inside Invar's own primitive/encoder/optical-showcase/microbench packages
                            rel = os.path.relpath(fp, INVAR_ROOT) if fp.startswith(INVAR_ROOT) else fp
                            if rel.startswith((
                                "packages/paint/",
                                "packages/ui/",
                                "packages/view/",
                                "packages/lg_pages/",
                                "packages/bench_gpu/",
                                "packages/layer1a_check/",
                            )):
                                continue
                            add_diag(
                                "INVAR_E001_HAND_ROLLED_GLASS",
                                "error",
                                rel,
                                ln,
                                "Direct `Glass::liquid` call outside `packages/lg`",
                                "Use a component from `packages/lg` (`lg::Panel`, `lg::Button`, `lg::liquid_*_node`) instead.",
                            )

    # E002: 4-backend renderer lockstep + Windows manifest sources + baked shaders
    renderers = [
        ("packages/host/native/apple_render.m", False),
        ("packages/host/native/gles_render.h", False),
        ("packages/host/native/win_render.cpp", False),
        ("web/host.js", True),
    ]
    for rel, is_js in renderers:
        fp = os.path.join(INVAR_ROOT, rel)
        if not os.path.isfile(fp):
            add_diag("INVAR_E002_RENDERER_LOCKSTEP", "error", rel, 1, f"Missing renderer file {rel}", "Restore all 4 GPU renderer backends.")
            continue
        src = open(fp, "r", encoding="utf-8", errors="replace").read()
        has_blur_buf = ("MB_BLUR_LAYERS" in src) or ("blPy" in src)
        has_k14 = ("kind === 14" in src) if is_js else ("kind == 14" in src)
        has_k15 = ("kind === 15" in src) if is_js else ("kind == 15" in src)
        has_stride60 = ("INST = 60" in src) if is_js else ("60" in src and "MB_INST" in src)
        has_layer_tex = ("LAYER_TEX" in src) if is_js else ("MB_LAYER_TEX" in src)
        has_fast_rect = ("FS_RECT" in src) if is_js else (("frect" in src) or ("FS_RECT" in src))
        missing = []
        if not has_blur_buf:
            missing.append("MB_BLUR_LAYERS/blPy")
        if not has_k14:
            missing.append("kind==14")
        if not has_k15:
            missing.append("kind==15")
        if not has_stride60:
            missing.append("stride=60")
        if not has_layer_tex:
            missing.append("MB_LAYER_TEX/LAYER_TEX")
        if not has_fast_rect:
            missing.append("frect/FS_RECT")
        if missing:
            add_diag(
                "INVAR_E002_RENDERER_LOCKSTEP",
                "error",
                rel,
                1,
                f"Renderer out of lockstep; missing markers: {', '.join(missing)}",
                "Keep all 4 GPU renderers synchronized with blur layers (kind 14/15), offscreen layers (MB_LAYER_TEX), fast rect (frect/FS_RECT), and 60-float instance stride.",
            )

    host_toml = os.path.join(INVAR_ROOT, "packages", "host", "pion.toml")
    if os.path.isfile(host_toml):
        tsrc = open(host_toml, "r", encoding="utf-8").read()
        m_win = re.search(r"\[link\.windows\](.*)", tsrc, re.S)
        if m_win:
            m_cs = re.search(r"c_sources\s*=\s*\[(.*?)\]", m_win.group(1), re.S)
            if m_cs:
                for sm in re.finditer(r'"([^"]+)"', m_cs.group(1)):
                    csrc = sm.group(1)
                    full = os.path.join(INVAR_ROOT, "packages", "host", csrc)
                    if not os.path.isfile(full):
                        add_diag(
                            "INVAR_E002_RENDERER_LOCKSTEP",
                            "error",
                            "packages/host/pion.toml",
                            1,
                            f"[link.windows] c_source missing on disk: {csrc}",
                            f"Create or fix path for packages/host/{csrc}.",
                        )
    baked_h = os.path.join(INVAR_ROOT, "packages", "host", "native", "win_shaders_baked.h")
    if not os.path.isfile(baked_h):
        add_diag(
            "INVAR_E002_RENDERER_LOCKSTEP",
            "error",
            "packages/host/native/win_shaders_baked.h",
            1,
            "Missing baked Windows shaders header win_shaders_baked.h",
            "Rebake shaders with packages/host/tools/bake_win_shaders.c.",
        )
    elif not is_external_app:
        win_baked = _check_win_baked_shaders()
        if win_baked.get("error"):
            add_diag(
                "INVAR_W002_WIN_BAKED_STALE",
                "warning",
                "packages/host/native/win_shaders_baked.h",
                1,
                f"Could not verify Windows baked shader keys: {win_baked['error']}",
                "Check packages/host/native/win_render.cpp and corner_sl.h.",
            )
        elif win_baked["baked_keys_matched"] < len(win_baked["baked_keys_expected"]):
            add_diag(
                "INVAR_W002_WIN_BAKED_STALE",
                "warning",
                "packages/host/native/win_shaders_baked.h",
                1,
                f"Windows baked shaders stale ({win_baked['baked_keys_matched']}/{len(win_baked['baked_keys_expected'])} cold-start keys matched); missing: {', '.join(win_baked['baked_keys_missing'])}",
                "Rebake win_shaders_baked.h on Windows with packages/host/tools/bake_win_shaders.c.",
            )

    # E003: JS syntax check via node --check
    node = shutil.which("node")
    if node:
        for wf in WEB_RUNTIME_FILES:
            fp = os.path.join(INVAR_ROOT, "web", wf)
            if not os.path.isfile(fp):
                add_diag("INVAR_E003_JS_SYNTAX", "error", f"web/{wf}", 1, f"Missing web/{wf}", "Restore web runtime asset.")
                continue
            rc, out, err, _ = run_cmd([node, "--check", fp])
            if rc != 0:
                add_diag("INVAR_E003_JS_SYNTAX", "error", f"web/{wf}", 1, (out + err).strip(), f"Fix JS syntax errors in web/{wf}.")
    else:
        add_diag("INVAR_E003_JS_SYNTAX", "warning", "web/", 1, "node not found; skipped JS syntax check", "Install Node.js to validate web/*.js.")

    # E004: WASM imports check
    wasm_imports_report = None
    tmp_wasm = None
    wasm_path = args.wasm
    if args.build_wasm and not wasm_path:
        pionc = resolve_pionc()
        if not pionc["found"]:
            add_diag("INVAR_E004_WASM_IMPORTS", "error", "packages/lg_web", 1, "pionc not found for --build-wasm", "Set PIONC or install pionc2.")
        else:
            env = build_pion_env(pionc)
            fd, tmp_wasm = tempfile.mkstemp(prefix="invar_audit_", suffix=".wasm")
            os.close(fd)
            rc, out, err, _ = run_cmd([pionc["path"], "build", "--release", "--target", "wasm32", os.path.join(INVAR_ROOT, "packages", "lg_web"), "-o", tmp_wasm], cwd=INVAR_ROOT, env=env)
            if rc != 0:
                add_diag("INVAR_E004_WASM_IMPORTS", "error", "packages/lg_web", 1, f"wasm32 build failed: {(out + err).strip()}", "Fix wasm32 build errors.")
            else:
                wasm_path = tmp_wasm

    if wasm_path:
        try:
            wasm_imports_report = verify_wasm_imports(wasm_path)
            if not wasm_imports_report["ok"]:
                if wasm_imports_report["missing"]:
                    add_diag(
                        "INVAR_E004_WASM_IMPORTS",
                        "error",
                        wasm_path,
                        1,
                        f"Missing pion_rt WASM imports: {', '.join(wasm_imports_report['missing'])}",
                        "Add the missing imports to web/pion_wasm_rt_web.min.mjs or web/pion_host_bridge.mjs.",
                    )
                if wasm_imports_report["other_modules"]:
                    add_diag(
                        "INVAR_E004_WASM_IMPORTS",
                        "error",
                        wasm_path,
                        1,
                        f"Unexpected non-pion_rt WASM imports: {', '.join(wasm_imports_report['other_modules'])}",
                        "Ensure all WASM imports come from pion_rt.",
                    )
        except Exception as e:
            add_diag("INVAR_E004_WASM_IMPORTS", "error", wasm_path, 1, f"Failed to parse WASM imports: {e}", "Verify WASM binary integrity.")
    if tmp_wasm and os.path.exists(tmp_wasm):
        os.unlink(tmp_wasm)

    # E005: packages/headless_core dependency isolation (only halt, dmath, signals allowed)
    hc_allowed_deps = {"halt", "dmath", "signals"}
    hc_dir = os.path.join(INVAR_ROOT, "packages", "headless_core")
    hc_toml = os.path.join(hc_dir, "pion.toml")
    if os.path.isfile(hc_toml):
        in_deps = False
        with open(hc_toml, "r", encoding="utf-8", errors="replace") as f:
            for ln, raw_line in enumerate(f, 1):
                line = raw_line.split("#", 1)[0].strip()
                if not line:
                    continue
                if line.startswith("[") and line.endswith("]"):
                    in_deps = (line == "[dependencies]")
                    continue
                if in_deps and "=" in line:
                    dep_name = line.split("=", 1)[0].strip().strip('"').strip("'")
                    if dep_name and dep_name not in hc_allowed_deps:
                        add_diag(
                            "INVAR_E005_HEADLESS_CORE_DEPS",
                            "error",
                            "packages/headless_core/pion.toml",
                            ln,
                            f"Forbidden dependency `{dep_name}` in packages/headless_core/pion.toml (allowed: halt, dmath, signals)",
                            f"Remove `{dep_name}` from packages/headless_core/pion.toml; keep view/render logic in packages/headless.",
                        )
    hc_src = os.path.join(hc_dir, "src")
    if os.path.isdir(hc_src):
        import_pat = re.compile(r'^\s*import\s+"([^"]+)"')
        for r_d, _ds, fs in os.walk(hc_src):
            for fn in sorted(fs):
                if not fn.endswith(".pion"):
                    continue
                fp = os.path.join(r_d, fn)
                rel = os.path.relpath(fp, INVAR_ROOT)
                with open(fp, "r", encoding="utf-8", errors="replace") as f:
                    for ln, raw_line in enumerate(f, 1):
                        stripped = raw_line.lstrip()
                        if stripped.startswith("//"):
                            continue
                        m = import_pat.match(raw_line)
                        if m:
                            imp = m.group(1)
                            if imp not in hc_allowed_deps:
                                add_diag(
                                    "INVAR_E005_HEADLESS_CORE_DEPS",
                                    "error",
                                    rel,
                                    ln,
                                    f"Forbidden import `\"{imp}\"` in packages/headless_core (allowed: halt, dmath, signals)",
                                    f"Remove `import \"{imp}\"` from {rel}; keep view/render bindings in packages/headless.",
                                )

    # W005: Stale brand & internal host leak check across tracked repository files
    w005_skip_dirs = {".git", ".pion", "target", ".pion_cache", "out", "LICENSES", "node_modules", "__pycache__", "build"}
    w005_skip_files = {
        "THIRD_PARTY_NOTICES.md",
        "NOTICE",
    }
    w005_binary_exts = {
        ".png", ".webp", ".jpg", ".jpeg", ".gif", ".ico", ".mp4", ".mov",
        ".woff", ".woff2", ".ttf", ".otf", ".wasm", ".jar", ".zip", ".gz",
        ".a", ".o", ".so", ".dylib", ".dll", ".exe", ".pdf",
    }
    stale_pat = re.compile(
        "|".join([
            "still" + r"\.?" + "fail",
            "fail" + r"\." + "still" + r"\.",
            "ui" + r"\." + "mon" + "oid",
            r"\b" + "mon" + "oid" + r"\b",
            r"\." + "agents/" + "skills/",
            "Office" + "-Host",
            "tokyo-" + "mac-studio",
            "mac-" + "studio-0",
            "pvg-" + "office",
            "youdid" + r"\." + "wtf",
            "cue" + r"\." + "surf",
        ]),
        re.IGNORECASE,
    )
    w005_rel_files = []
    rc_ls, ls_out, _, _ = run_cmd(["git", "ls-files", "-z"], cwd=INVAR_ROOT)
    if rc_ls == 0 and ls_out:
        for rel in ls_out.split("\0"):
            rel = rel.replace(os.sep, "/")
            if not rel or rel.startswith("LICENSES/"):
                continue
            w005_rel_files.append(rel)
    else:
        for r_d, ds, fs in os.walk(INVAR_ROOT):
            ds[:] = sorted(d for d in ds if d not in w005_skip_dirs)
            for fn in sorted(fs):
                fp = os.path.join(r_d, fn)
                rel = os.path.relpath(fp, INVAR_ROOT).replace(os.sep, "/")
                w005_rel_files.append(rel)
    for rel in sorted(w005_rel_files):
        if rel in w005_skip_files or rel.startswith("LICENSES/"):
            continue
        _, ext = os.path.splitext(rel)
        if ext.lower() in w005_binary_exts:
            continue
        fp = os.path.join(INVAR_ROOT, rel)
        if not os.path.isfile(fp):
            continue
        try:
            with open(fp, "rb") as fb:
                head = fb.read(2048)
            if b"\x00" in head:
                continue
            with open(fp, "r", encoding="utf-8", errors="replace") as f:
                for ln, text in enumerate(f, 1):
                    # Narrow exemption: hygiene rule pattern definition line only
                    if rel == "scripts/check-android-host.sh" and text.lstrip().startswith("BAD_PATTERN="):
                        continue
                    m = stale_pat.search(text)
                    if m:
                        add_diag(
                            "INVAR_W005_STALE_BRAND",
                            "error",
                            rel,
                            ln,
                            f"Stale brand or internal host reference `{m.group(0)}` in public file",
                            f"Remove or replace `{m.group(0)}` with a neutral public name.",
                        )
        except OSError:
            continue

    # W006: External app gates
    if is_external_app:
        src_dir = os.path.join(target_dir, "src")
        has_glass_audit = False
        has_scroll_audit = False
        if os.path.isdir(src_dir):
            for r_d, _ds, fs in os.walk(src_dir):
                for fn in sorted(fs):
                    if not fn.endswith(".pion"):
                        continue
                    fp = os.path.join(r_d, fn)
                    txt = open(fp, "r", encoding="utf-8", errors="replace").read()
                    if "view" in fn.lower() and not fn.endswith("_test.pion"):
                        for ln, line in enumerate(txt.splitlines(), 1):
                            if re.search(r"\bWorld\b", line) and not line.lstrip().startswith("//"):
                                add_diag(
                                    "INVAR_W006_APP_GATES",
                                    "error",
                                    fp,
                                    ln,
                                    "View file references `World` capability (render thread must stay IO-free)",
                                    "Move IO to `ui::Worker` and remove `World` from view files.",
                                )
                    if fn.endswith("_test.pion"):
                        if "assert_no_nested_glass" in txt or "assert_apple_ui" in txt:
                            has_glass_audit = True
                        if "scroll_faults" in txt or "assert_scrollable" in txt or "assert_apple_ui" in txt:
                            has_scroll_audit = True
        if not has_glass_audit:
            add_diag(
                "INVAR_W006_APP_GATES",
                "warning",
                target_dir,
                1,
                "App tests missing `lg::assert_no_nested_glass` audit gate",
                "Call `lg::assert_no_nested_glass(t, label=\"...\")` in `src/*_test.pion`.",
            )
        if not has_scroll_audit:
            add_diag(
                "INVAR_W006_APP_GATES",
                "warning",
                target_dir,
                1,
                "App tests missing `scroll_faults` / `assert_scrollable` audit gate",
                "Assert `t.scroll_faults().length() == 0` in `src/*_test.pion`.",
            )

    # E007-E010: Typed reactive static audit via `pionc query analyze --json`
    reactive_report = _run_reactive_audit(
        target_dir,
        bool(getattr(args, "no_reactive", False)),
        add_diag,
    )
    if bool(getattr(args, "require_reactive", False)) and not reactive_report.get("ran"):
        add_diag(
            "INVAR_E007_REACTIVE_AUDIT_SKIPPED",
            "error",
            args.target_dir or ".",
            1,
            f"Typed reactive audit did not run (required by --require-reactive): {reactive_report.get('reason', 'unavailable')}",
            "Ensure pionc supports `query analyze`, omit `--no-reactive`, and fix any analyze errors.",
        )

    err_cnt = sum(1 for d in diags if d["severity"] == "error")
    warn_cnt = sum(1 for d in diags if d["severity"] == "warning")
    ok = err_cnt == 0
    res = {
        "ok": ok,
        "error_count": err_cnt,
        "warning_count": warn_cnt,
        "diagnostics": diags,
        "reactive_audit": reactive_report,
    }
    if wasm_imports_report is not None:
        res["wasm_imports"] = wasm_imports_report

    if args.json:
        emit_json(res)
    else:
        for d in diags:
            print(f"[{d['severity'].upper()}] {d['code']} {d['file']}:{d['line']}: {d['message']}")
            print(f"  fixit: {d['fixit']}")
        if wasm_imports_report is not None:
            print(f"WASM imports: {wasm_imports_report['total']} total ({wasm_imports_report['pion_rt_total']} pion_rt), {len(wasm_imports_report['missing'])} missing")
        if reactive_report.get("ran"):
            print(f"Reactive audit: {reactive_report['closures_checked']} closures, {reactive_report['fns_checked']} fns checked")
        else:
            print(f"Reactive audit: skipped ({reactive_report.get('reason', 'unavailable')})")
        print(f"invar audit: {'OK' if ok else 'FAILED'} ({err_cnt} errors, {warn_cnt} warnings)")
    return 0 if ok else 1


