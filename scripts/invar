def _pkg_name_from_toml(pkg_dir):
    tp = os.path.join(pkg_dir, "pion.toml")
    if os.path.isfile(tp):
        m = re.search(r'^\s*name\s*=\s*"([^"]+)"', open(tp, "r", encoding="utf-8").read(), re.M)
        if m:
            return m.group(1)
    return os.path.basename(pkg_dir)


WEB_DIST_STATE = os.path.join(INVAR_ROOT, "target", ".invar-web-dist-state.json")


def _web_dist_state_load():
    try:
        with open(WEB_DIST_STATE, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _file_sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _web_dist_reconcile(out_dir, managed):
    """Remove from `out_dir` only the files an earlier build here wrote and this one did not, then
    record what this build wrote, with each file's SHA-256. The record lives under target/, never
    in `out_dir`, and a file is removed only while its bytes are still the ones that build wrote:
    files the caller keeps there (their own .wasm, headers, ... even under a name an earlier build
    used, as in a directory made again) are never touched."""
    key = os.path.realpath(out_dir)
    state = _web_dist_state_load()
    prev = state.get(key, {})
    removed = []
    # (a record of names alone, from before the hashes, claims nothing: those files stay)
    if isinstance(prev, dict):
        for name, digest in prev.items():
            if not isinstance(name, str) or name in managed or os.path.basename(name) != name or name in ("", ".", ".."):
                continue
            if not isinstance(digest, str) or not digest:
                continue
            path = os.path.join(out_dir, name)
            if not os.path.isfile(path) or os.path.islink(path):
                continue
            try:
                if _file_sha256(path) != digest:
                    continue
                os.unlink(path)
                removed.append(name)
            except OSError:
                pass
    # (records of output dirs that no longer exist, such as temporary ones, are dropped)
    state = {d: files for d, files in state.items() if d != key and os.path.isdir(d)}
    written = {}
    for name in sorted(managed):
        path = os.path.join(out_dir, name)
        try:
            if os.path.isfile(path) and not os.path.islink(path):
                written[name] = _file_sha256(path)
        except OSError:
            pass
    state[key] = written
    os.makedirs(os.path.dirname(WEB_DIST_STATE), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".invar-web-dist-state.", dir=os.path.dirname(WEB_DIST_STATE))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2, sort_keys=True)
        os.replace(tmp, WEB_DIST_STATE)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    return sorted(removed)


def _web_build_impl(pkg_dir, out_dir, title, release, do_opt, track_dist=True):
    pionc = resolve_pionc()
    if not pionc["found"]:
        return {"ok": False, "error": "pionc not found (set PIONC or add to PATH)"}
    env = build_pion_env(pionc)
    pkg_name = _pkg_name_from_toml(pkg_dir)
    os.makedirs(out_dir, exist_ok=True)
    wasm_name = f"{pkg_name}.wasm"
    wasm_file = os.path.join(out_dir, wasm_name)

    cmd = [pionc["path"], "build"]
    if release:
        cmd.append("--release")
    cmd += ["--target", "wasm32", pkg_dir, "-o", wasm_file]
    rc, out, err, build_ms = run_cmd(cmd, cwd=INVAR_ROOT, env=env)
    if rc != 0:
        return {"ok": False, "error": (out + err).strip(), "elapsed_ms": build_ms}

    wasm_opt_ran = False
    wasm_opt_skipped = None
    if do_opt:
        wasm_opt = shutil.which("wasm-opt")
        if wasm_opt:
            rc2, out2, err2, _ = run_cmd([
                wasm_opt, "-Oz",
                # pionc wasm32 output uses bulk-memory and trunc_sat ops.
                "--enable-bulk-memory", "--enable-bulk-memory-opt", "--enable-nontrapping-float-to-int",
                wasm_file, "-o", wasm_file,
            ])
            if rc2 != 0 and "bulk-memory-opt" in (out2 + err2):
                rc2, out2, err2, _ = run_cmd([
                    wasm_opt, "-Oz",
                    "--enable-bulk-memory", "--enable-nontrapping-float-to-int",
                    wasm_file, "-o", wasm_file,
                ])
            if rc2 != 0:
                return {"ok": False, "error": f"wasm-opt failed: {(out2 + err2).strip()}", "wasm_opt_ran": False}
            wasm_opt_ran = True
        else:
            wasm_opt_skipped = "wasm-opt not found"

    managed = {wasm_name, "index.html"}
    required_files = list(WEB_DIST_RUNTIME_FILES) + list(WEB_STATIC_ASSETS)
    if pkg_name == "lg_web":
        required_files.extend(["_headers", "_redirects"])
    for wf in required_files:
        src = os.path.join(INVAR_ROOT, "web", wf)
        if not os.path.isfile(src):
            return {"ok": False, "error": f"Missing required web asset: web/{wf}", "wasm_opt_ran": wasm_opt_ran}
        shutil.copy2(src, os.path.join(out_dir, wf))
        managed.add(wf)
    if pkg_name != "lg_web":
        for cf in ("_headers", "_redirects"):
            custom_src = os.path.join(pkg_dir, cf)
            if os.path.isfile(custom_src):
                shutil.copy2(custom_src, os.path.join(out_dir, cf))
                managed.add(cf)
    vt_src = os.path.join(INVAR_ROOT, "web", "ghostty-vt.wasm")
    if os.path.isfile(vt_src):
        shutil.copy2(vt_src, os.path.join(out_dir, "ghostty-vt.wasm"))
        managed.add("ghostty-vt.wasm")
    # Bundle root license and third-party notice files alongside inter.woff2 and JS runtimes (OFL-1.1 / Apache-2.0 / MIT)
    for lf in ("LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md"):
        lsrc = os.path.join(INVAR_ROOT, lf)
        if os.path.isfile(lsrc):
            shutil.copy2(lsrc, os.path.join(out_dir, lf))
            managed.add(lf)
    lic_dir_src = os.path.join(INVAR_ROOT, "LICENSES")
    if os.path.isdir(lic_dir_src):
        lic_dir_dst = os.path.join(out_dir, "LICENSES")
        os.makedirs(lic_dir_dst, exist_ok=True)
        for fn in sorted(os.listdir(lic_dir_src)):
            fsrc = os.path.join(lic_dir_src, fn)
            if os.path.isfile(fsrc):
                shutil.copy2(fsrc, os.path.join(lic_dir_dst, fn))

    # Write clean index.html tailored to wasm_name & title
    tpl_path = os.path.join(INVAR_ROOT, "web", "index.html")
    if not os.path.isfile(tpl_path):
        return {"ok": False, "error": "Missing required web asset: web/index.html", "wasm_opt_ran": wasm_opt_ran}
    tpl_html = open(tpl_path, "r", encoding="utf-8").read()
    tpl_html = re.sub(r"<title>.*?</title>", f"<title>{title}</title>", tpl_html, count=1, flags=re.S)
    tpl_html = tpl_html.replace("./lg_web.wasm", f"./{wasm_name}").replace('"lg_web.wasm"', f'"{wasm_name}"')
    with open(os.path.join(out_dir, "index.html"), "w", encoding="utf-8") as f:
        f.write(tpl_html)
    # Files an earlier build here wrote and this one did not (another package's .wasm, its
    # _headers/_redirects): gone; anything else in out_dir is the caller's and stays.
    stale_removed = _web_dist_reconcile(out_dir, managed) if track_dist else []

    # Verify WASM imports
    imp_res = verify_wasm_imports(wasm_file)
    raw_bytes = os.path.getsize(wasm_file)
    with open(wasm_file, "rb") as f:
        raw_data = f.read()
    gzip_bytes = len(gzip.compress(raw_data, compresslevel=9))

    brotli_bytes = None
    brotli_bin = shutil.which("brotli")
    if brotli_bin:
        rc_b, _, _, _ = run_cmd([brotli_bin, "-f", "-q", "11", wasm_file, "-o", wasm_file + ".br"])
        if rc_b == 0 and os.path.isfile(wasm_file + ".br"):
            brotli_bytes = os.path.getsize(wasm_file + ".br")
            os.unlink(wasm_file + ".br")

    result = {
        "ok": imp_res["ok"],
        "out_dir": out_dir,
        "wasm_file": wasm_file,
        "raw_bytes": raw_bytes,
        "gzip_bytes": gzip_bytes,
        "brotli_bytes": brotli_bytes,
        "imports_total": imp_res["total"],
        "imports_missing": imp_res["missing"],
        "wasm_opt_ran": wasm_opt_ran,
        "stale_removed": stale_removed,
        "elapsed_ms": build_ms,
    }
    if wasm_opt_skipped:
        result["wasm_opt_skipped"] = wasm_opt_skipped
    return result


def cmd_web(args):
    pkg_dir = resolve_pkg_dir(args.pkg) if args.pkg else os.path.join(INVAR_ROOT, "packages", "lg_web")
    title = args.title or f"Invar · {_pkg_name_from_toml(pkg_dir)} (Pion WASM)"

    if args.web_action == "build":
        out_dir = os.path.abspath(args.out) if args.out else os.path.join(INVAR_ROOT, "target", "web-dist")
        res = _web_build_impl(pkg_dir, out_dir, title, True if args.release or not args.debug else False, args.opt)
        if args.json:
            emit_json(res)
        else:
            if res["ok"]:
                print(f"Built {res['wasm_file']} ({res['raw_bytes']} B raw, {res['gzip_bytes']} B gzip, {res['imports_total']} imports, 0 missing)")
            else:
                print(f"invar web build FAILED: {res.get('error') or res.get('imports_missing')}", file=sys.stderr)
        return 0 if res["ok"] else 1

    if args.web_action == "check":
        tmp_dir = tempfile.mkdtemp(prefix="invar_web_check_")
        try:
            node = shutil.which("node")
            js_errors = []
            if node:
                for wf in WEB_RUNTIME_FILES:
                    rc, out, err, _ = run_cmd([node, "--check", os.path.join(INVAR_ROOT, "web", wf)])
                    if rc != 0:
                        js_errors.append(f"web/{wf}: {(out + err).strip()}")
            res = _web_build_impl(pkg_dir, tmp_dir, title, True, args.opt, track_dist=False)
            res["js_errors"] = js_errors
            if js_errors:
                res["ok"] = False
            if args.json:
                emit_json(res)
            else:
                if res["ok"]:
                    print(f"invar web check OK ({res['raw_bytes']} B, {res['imports_total']} imports, 0 missing)")
                else:
                    print(f"invar web check FAILED: {res.get('error') or res.get('imports_missing') or js_errors}", file=sys.stderr)
            return 0 if res["ok"] else 1
        finally:
            shutil.rmtree(tmp_dir, ignore_errors=True)

    # dev server
    out_dir = os.path.abspath(args.out) if args.out else os.path.join(INVAR_ROOT, "target", "web-dev")
    res = _web_build_impl(pkg_dir, out_dir, title, True, args.opt)
    if not res["ok"]:
        emit_json(res) if args.json else print(f"Build failed: {res.get('error')}", file=sys.stderr)
        return 1

    class WasmHandler(http.server.SimpleHTTPRequestHandler):
        extensions_map = {
            **http.server.SimpleHTTPRequestHandler.extensions_map,
            ".wasm": "application/wasm",
            ".mjs": "text/javascript",
            ".js": "text/javascript",
        }

    handler = functools.partial(WasmHandler, directory=out_dir)
    socketserver.TCPServer.allow_reuse_address = True
    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), handler)
    url = f"http://127.0.0.1:{args.port}/"
    print(f"Serving {out_dir} at {url} (Ctrl-C to stop)")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


# ---------------------------------------------------------------------------
# Subcommand 7: shot
# ---------------------------------------------------------------------------

def _snapshot_media_dir(out_dir):
    snap = {}
    if not os.path.isdir(out_dir):
        return snap
    for fn in os.listdir(out_dir):
        if fn.endswith(".png") or fn.endswith(".mp4"):
            fp = os.path.join(out_dir, fn)
            try:
                st = os.stat(fp)
                snap[fn] = (st.st_mtime_ns, st.st_size, st.st_ino)
            except OSError:
                pass
    return snap


def cmd_shot(args):
    pionc = resolve_pionc()
    if not pionc["found"]:
        err = {"ok": False, "error": "pionc not found (set PIONC or add to PATH)"}
        emit_json(err) if args.json else print(err["error"], file=sys.stderr)
        return 1
    env = build_pion_env(pionc)
    pkg_dir = resolve_pkg_dir(args.pkg) if args.pkg else os.path.join(INVAR_ROOT, "packages", "lg_shots")
    out_dir = os.path.abspath(args.out) if args.out else os.path.join(INVAR_ROOT, "target", "shots")
    os.makedirs(out_dir, exist_ok=True)

    env["MBUI_LG_OUT"] = out_dir
    if getattr(args, "list", False):
        env["MBUI_LG_LIST"] = "1"
    if args.only:
        env["MBUI_LG_ONLY"] = args.only
    if args.w:
        env["MBUI_LG_W"] = str(args.w)
    if args.h:
        env["MBUI_LG_H"] = str(args.h)
    if args.scale:
        env["MBUI_LG_SCALE"] = str(args.scale)
    if platform.system().lower() == "linux" and not env.get("DISPLAY") and not env.get("WAYLAND_DISPLAY"):
        env.setdefault("LIBGL_ALWAYS_SOFTWARE", "1")
        env.setdefault("GALLIUM_DRIVER", "llvmpipe")

    fd, bin_path = tempfile.mkstemp(prefix="invar_shot_")
    os.close(fd)
    try:
        build_cmd = [pionc["path"], "build"]
        if getattr(args, "release", False):
            build_cmd.append("--release")
        build_cmd += [pkg_dir, "-o", bin_path]
        rc, out, err, build_ms = run_cmd(build_cmd, cwd=INVAR_ROOT, env=env)
        if rc != 0:
            res = {"ok": False, "error": f"build failed: {(out + err).strip()}", "build_ms": build_ms}
            emit_json(res) if args.json else print(res["error"], file=sys.stderr)
            return 1
        before_snap = _snapshot_media_dir(out_dir)
        t_run_ns = time.time_ns()
        rc2, out2, err2, run_ms = run_cmd([bin_path], cwd=INVAR_ROOT, env=env)
        combined = (out2 + "\n" + err2).strip()
        if getattr(args, "list", False):
            ok = (rc2 == 0) and ("shots presets:" in combined)
            res = {
                "ok": ok,
                "build_ms": build_ms,
                "run_ms": run_ms,
                "output": combined,
                "error": "" if ok else (combined or "package does not support MBUI_LG_LIST"),
            }
            if args.json:
                emit_json(res)
            else:
                if combined:
                    print(combined)
            return 0 if ok else 1

        pngs = []
        mp4s = []
        for fn in sorted(os.listdir(out_dir)):
            if not (fn.endswith(".png") or fn.endswith(".mp4")):
                continue
            fp = os.path.join(out_dir, fn)
            try:
                st = os.stat(fp)
            except OSError:
                continue
            sig = (st.st_mtime_ns, st.st_size, st.st_ino)
            prev_sig = before_snap.get(fn)
            # Only report files created or updated during this run (never stale leftovers).
            if prev_sig is not None and sig == prev_sig and st.st_mtime_ns < t_run_ns:
                continue
            if fn.endswith(".png"):
                dims = read_png_ihdr(fp)
                pngs.append({
                    "file": fp,
                    "width": dims[0] if dims else 0,
                    "height": dims[1] if dims else 0,
                    "bytes": st.st_size,
                })
            else:
                mp4s.append({
                    "file": fp,
                    "bytes": st.st_size,
                })
        ok = (rc2 == 0) and (len(pngs) + len(mp4s) > 0)
        res = {
            "ok": ok,
            "out_dir": out_dir,
            "build_ms": build_ms,
            "run_ms": run_ms,
            "pngs": pngs,
            "mp4s": mp4s,
            "error": "" if ok else (combined or "no PNG or MP4 outputs produced"),
        }
        if args.json:
            emit_json(res)
        else:
            for p in pngs:
                print(f"  {p['file']} ({p['width']}x{p['height']}, {p['bytes']} B)")
            for v in mp4s:
                print(f"  {v['file']} (MP4, {v['bytes']} B)")
            if not ok and res["error"]:
                print(res["error"], file=sys.stderr)
            print(f"invar shot: {'OK' if ok else 'FAILED'} ({len(pngs)} PNGs, {len(mp4s)} MP4s, build {build_ms} ms, run {run_ms} ms)")
        return 0 if ok else 1
    finally:
        if os.path.exists(bin_path):
            os.unlink(bin_path)


# ---------------------------------------------------------------------------
# Subcommand 8: diff
# ---------------------------------------------------------------------------

def cmd_diff(args):
    try:
        w1, h1, b1 = decode_png_rgba(args.before)
        w2, h2, b2 = decode_png_rgba(args.after)
    except Exception as e:
        res = {"ok": False, "error": str(e)}
        emit_json(res) if args.json else print(res["error"], file=sys.stderr)
        return 1

    same_size = (w1 == w2 and h1 == h2)
    if not same_size:
        res = {
            "ok": True,
            "same_size": False,
            "before_size": [w1, h1],
            "after_size": [w2, h2],
            "identical": False,
        }
        emit_json(res) if args.json else print(f"Size mismatch: {w1}x{h1} vs {w2}x{h2}")
        return 0

    w, h = w1, h1
    total_pixels = w * h
    thresh = max(0, min(255, args.threshold))
    changed_pixels = 0
    max_delta = 0
    sum_abs = 0
    sum_sq = 0
    min_x, min_y, max_x, max_y = w, h, -1, -1

    need_diff_img = bool(args.out or args.sbs)
    diff_rgba = bytearray(total_pixels * 4) if need_diff_img else None

    for y in range(h):
        row_off = y * w * 4
        for x in range(w):
            o = row_off + x * 4
            dr = abs(b1[o] - b2[o])
            dg = abs(b1[o + 1] - b2[o + 1])
            db = abs(b1[o + 2] - b2[o + 2])
            da = abs(b1[o + 3] - b2[o + 3])
            dmax = max(dr, dg, db, da)
            sum_abs += dr + dg + db + da
            sum_sq += dr * dr + dg * dg + db * db + da * da
            if dmax > max_delta:
                max_delta = dmax
            if dmax > thresh:
                changed_pixels += 1
                if x < min_x:
                    min_x = x
                if x > max_x:
                    max_x = x
                if y < min_y:
                    min_y = y
                if y > max_y:
                    max_y = y
                if diff_rgba is not None:
                    boost = min(255, 160 + (dmax * 95) // 255)
                    diff_rgba[o] = 255
                    diff_rgba[o + 1] = 24
                    diff_rgba[o + 2] = boost
                    diff_rgba[o + 3] = 255
            elif diff_rgba is not None:
                diff_rgba[o] = b1[o] // 3
                diff_rgba[o + 1] = b1[o + 1] // 3
                diff_rgba[o + 2] = b1[o + 2] // 3
                diff_rgba[o + 3] = 255

    mae = sum_abs / (total_pixels * 4) if total_pixels else 0.0
    mse = sum_sq / (total_pixels * 4) if total_pixels else 0.0
    psnr = None if mse == 0.0 else round(10.0 * math.log10((255.0 * 255.0) / mse), 3)
    changed_ratio = (changed_pixels / total_pixels) if total_pixels else 0.0
    bbox = [min_x, min_y, max_x - min_x + 1, max_y - min_y + 1] if changed_pixels > 0 else None
    identical = (max_delta == 0)

    if args.out and diff_rgba is not None:
        encode_png_rgba(args.out, w, h, diff_rgba)

    if args.sbs and diff_rgba is not None:
        sep = 4
        sbs_w = w * 3 + sep * 2
        sbs = bytearray(sbs_w * h * 4)
        for y in range(h):
            s_off = y * w * 4
            d_off = y * sbs_w * 4
            sbs[d_off:d_off + w * 4] = b1[s_off:s_off + w * 4]
            for sx in range(sep):
                p = d_off + (w + sx) * 4
                sbs[p:p + 4] = b"\x30\x34\x40\xff"
            o2 = d_off + (w + sep) * 4
            sbs[o2:o2 + w * 4] = b2[s_off:s_off + w * 4]
            for sx in range(sep):
                p = d_off + (2 * w + sep + sx) * 4
                sbs[p:p + 4] = b"\x30\x34\x40\xff"
            o3 = d_off + (2 * w + 2 * sep) * 4
            sbs[o3:o3 + w * 4] = diff_rgba[s_off:s_off + w * 4]
        encode_png_rgba(args.sbs, sbs_w, h, sbs)

    res = {
        "ok": True,
        "same_size": True,
        "width": w,
        "height": h,
        "total_pixels": total_pixels,
        "changed_pixels": changed_pixels,
        "changed_ratio": round(changed_ratio, 6),
        "max_delta": max_delta,
        "mae": round(mae, 6),
        "psnr": psnr,
        "changed_bbox": bbox,
        "identical": identical,
    }
    if args.out:
        res["diff_out"] = args.out
    if args.sbs:
        res["sbs_out"] = args.sbs

    if args.json:
        emit_json(res)
    else:
        print(f"diff {w}x{h}: changed={changed_pixels}/{total_pixels} ({changed_ratio*100:.2f}%), max_delta={max_delta}, mae={mae:.4f}, psnr={psnr}")
    return 0


# ---------------------------------------------------------------------------
# Subcommand 8b: compare (pure stdlib ROI side-by-side & luma/diff metrics)
# ---------------------------------------------------------------------------

