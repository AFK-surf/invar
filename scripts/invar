def cmd_new(args):
    out_dir = os.path.abspath(args.dir)
    pkg_name = args.name or os.path.basename(out_dir).replace("-", "_")
    if not re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*$", pkg_name):
        msg = f"Invalid package identifier `{pkg_name}` (must match ^[a-zA-Z_][a-zA-Z0-9_]*$)"
        emit_json({"ok": False, "error": msg}) if args.json else print(msg, file=sys.stderr)
        return 1

    invar_path = os.path.realpath(args.invar) if args.invar else INVAR_ROOT
    pkgs_abs = os.path.join(invar_path, "packages")
    use_rel = bool(getattr(args, "relative", False))
    if not use_rel:
        try:
            if os.path.commonpath([os.path.realpath(out_dir), invar_path]) == invar_path:
                use_rel = True
        except ValueError:
            use_rel = False
    if use_rel:
        try:
            pkgs_path = os.path.relpath(pkgs_abs, out_dir).replace(os.sep, "/")
        except ValueError:
            pkgs_path = pkgs_abs
    else:
        pkgs_path = pkgs_abs
    tpl = args.template

    files = {}
    if tpl == "jsx-app":
        files["pion.toml"] = (
            f'[package]\nname = "{pkg_name}"\nversion = "0.1.0"\n\n'
            f'[dependencies]\n'
            f'host = {{ path = "{pkgs_path}/host" }}\n'
            f'signals = {{ path = "{pkgs_path}/signals" }}\n'
            f'view = {{ path = "{pkgs_path}/view" }}\n'
            f'ui = {{ path = "{pkgs_path}/ui" }}\n'
            f'kit = {{ path = "{pkgs_path}/kit" }}\n'
            f'lg = {{ path = "{pkgs_path}/lg" }}\n\n'
            + MACOS_FRAMEWORKS_TOML
        )
