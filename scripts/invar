INVAR_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

WASM32_ONLY_PKGS = {"host_web", "lg_web"}
GPU_DISPLAY_TEST_PKGS = {"host", "film"}


def _pkg_has_tests(pkg_dir):
    for fn in os.listdir(pkg_dir):
        if fn.endswith("_test.pion") and os.path.isfile(os.path.join(pkg_dir, fn)):
            return True
    for sub in ("src", "tests"):
        d = os.path.join(pkg_dir, sub)
        if not os.path.isdir(d):
            continue
        for _r_d, _ds, fs in os.walk(d):
            if any(fn.endswith("_test.pion") for fn in fs):
                return True
    return False


def discover_workspace_pkgs(mode):
    """Discover packages from packages/*/pion.toml and examples/*/pion.toml."""
    discovered = []
    for base, prefix in (("packages", ""), ("examples", "examples/")):
        base_dir = os.path.join(INVAR_ROOT, base)
        if not os.path.isdir(base_dir):
            continue
        for name in sorted(os.listdir(base_dir)):
            pdir = os.path.join(base_dir, name)
            if os.path.isfile(os.path.join(pdir, "pion.toml")):
                spec = f"{prefix}{name}"
                discovered.append((spec, name, pdir))

    sys_os = platform.system().lower()
    pkgs = []
    skipped = []
    for spec, name, pdir in discovered:
        if name in WASM32_ONLY_PKGS:
            skipped.append({
                "pkg": spec,
                "reason": "wasm32-only browser package (checked via invar web check)",
            })
            continue
        if mode == "check":
            pkgs.append(spec)
        elif mode == "test":
            if not _pkg_has_tests(pdir):
                continue
            if name in GPU_DISPLAY_TEST_PKGS:
                if sys_os == "linux" and not (
                    os.environ.get("DISPLAY")
                    or os.environ.get("WAYLAND_DISPLAY")
                    or os.environ.get("LIBGL_ALWAYS_SOFTWARE")
                ):
                    skipped.append({
                        "pkg": spec,
                        "reason": "requires GPU/display or llvmpipe on Linux (run via `scripts/check-linux-host.sh`)",
                    })
                    continue
                if sys_os not in ("darwin", "linux"):
                    skipped.append({
                        "pkg": spec,
                        "reason": f"requires native GPU/display environment on {sys_os}",
                    })
                    continue
            pkgs.append(spec)
    return pkgs, skipped

WEB_RUNTIME_FILES = [
    "host.js",
    "pion_host_bridge.mjs",
    "pion_wasm_rt_web.mjs",
    "pion_wasm_rt_web.min.mjs",
]

# Runtime JS files copied into dist output (index.html imports pion_wasm_rt_web.min.mjs).
WEB_DIST_RUNTIME_FILES = [
    "host.js",
    "pion_host_bridge.mjs",
    "pion_wasm_rt_web.min.mjs",
]

# Non-JS files the page fetches at boot or Cloudflare static assets config; kept
# apart from WEB_RUNTIME_FILES so E003 does not run `node --check` on them.
WEB_STATIC_ASSETS = ["inter.woff2"]


def emit_json(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, indent=2) + "\n")


def run_cmd(cmd, cwd=None, env=None, capture=True):
    t0 = time.monotonic()
    try:
        p = subprocess.run(
            cmd,
            cwd=cwd,
            env=env,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            text=True,
        )
        ms = int((time.monotonic() - t0) * 1000)
        return p.returncode, (p.stdout or ""), (p.stderr or ""), ms
    except FileNotFoundError as e:
        ms = int((time.monotonic() - t0) * 1000)
        return 127, "", str(e), ms


def resolve_pionc():
    candidates = []
    env_p = os.environ.get("PIONC", "").strip()
    if env_p:
        candidates.append(env_p)
    for name in ("pionc", "pionc2"):
        found = shutil.which(name)
        if found:
            candidates.append(found)
    rel = os.path.join(os.path.dirname(INVAR_ROOT), "pion", "out", "pionc2")
    candidates.append(rel)

    pionc_path = None
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            pionc_path = os.path.realpath(c)
            break

    info = {
        "found": pionc_path is not None,
        "path": pionc_path,
        "qbe": None,
        "libpionrt": None,
        "wasm_rt": None,
        "subcommands": [],
        "supports_only_pkg": False,
        "supports_jobs": False,
    }
    if not pionc_path:
        return info

    d = os.path.dirname(pionc_path)
    qbe = os.environ.get("PION_QBE", "").strip() or os.path.join(d, "qbe")
    if os.path.isfile(qbe):
        info["qbe"] = qbe
    for rt_cand in (
        os.environ.get("PION_RT_LIB", "").strip(),
        os.path.join(d, "libpionrt.a"),
        os.path.normpath(os.path.join(d, "..", "lib", "libpionrt.a")),
    ):
        if rt_cand and os.path.isfile(rt_cand):
            info["libpionrt"] = rt_cand
            break
    for wr_cand in (
        os.environ.get("PION_WASM_RT", "").strip(),
        os.path.normpath(os.path.join(d, "..", "runtime", "pion_wasm_rt.mjs")),
        os.path.normpath(os.path.join(d, "..", "share", "pion", "pion_wasm_rt.mjs")),
    ):
        if wr_cand and os.path.isfile(wr_cand):
            info["wasm_rt"] = wr_cand
            break

    rc, out, err, _ = run_cmd([pionc_path, "--help"])
    help_text = out + "\n" + err
    subs = []
    for sub in ("check", "build", "test", "fmt", "query", "doc", "run"):
        if re.search(rf"\b{sub}\b", help_text):
            subs.append(sub)
    info["subcommands"] = subs
    info["supports_only_pkg"] = bool(re.search(r"--only-pkg\b", help_text))
    info["supports_jobs"] = bool(re.search(r"^\s*pionc\s+test\b[^\n]*--jobs\b", help_text, re.M))
    return info


def build_pion_env(pion_info):
    env = os.environ.copy()
    if pion_info.get("path"):
        pdir = os.path.dirname(pion_info["path"])
        env["PATH"] = pdir + os.pathsep + env.get("PATH", "")
    if pion_info.get("qbe"):
        env["PION_QBE"] = pion_info["qbe"]
    if pion_info.get("libpionrt"):
        env["PION_RT_LIB"] = pion_info["libpionrt"]
    if pion_info.get("wasm_rt"):
        env["PION_WASM_RT"] = pion_info["wasm_rt"]
    return env


def resolve_pkg_dir(spec):
    if os.path.isdir(spec) and os.path.isfile(os.path.join(spec, "pion.toml")):
        return os.path.realpath(spec)
    p1 = os.path.join(INVAR_ROOT, spec)
    if os.path.isdir(p1) and os.path.isfile(os.path.join(p1, "pion.toml")):
        return p1
    p2 = os.path.join(INVAR_ROOT, "packages", spec)
    if os.path.isdir(p2) and os.path.isfile(os.path.join(p2, "pion.toml")):
        return p2
    return os.path.realpath(spec)


def default_pkg_list(base_list):
    pkgs = list(base_list)
    jsx_app = os.path.join(INVAR_ROOT, "examples", "jsx_app", "pion.toml")
    if os.path.isfile(jsx_app) and "examples/jsx_app" not in pkgs:
        pkgs.append("examples/jsx_app")
    return pkgs


# ---------------------------------------------------------------------------
# Pure-Python WASM Import Section (ID 2) Parser & JS Export Extractor
# ---------------------------------------------------------------------------

def _read_u32_leb(data, pos):
    val = 0
    shift = 0
    while True:
        if pos >= len(data):
            raise ValueError("Truncated LEB128 in WASM")
        b = data[pos]
        pos += 1
        val |= (b & 0x7F) << shift
        if (b & 0x80) == 0:
            return val, pos
        shift += 7
        if shift > 35:
            raise ValueError("LEB128 overflow in WASM")


def parse_wasm_imports(wasm_path):
    with open(wasm_path, "rb") as f:
        data = f.read()
    if len(data) < 8 or data[:4] != b"\x00asm":
        raise ValueError("Invalid WASM magic header")
    pos = 8
    imports = []
    while pos < len(data):
        sec_id = data[pos]
        pos += 1
        sec_len, pos = _read_u32_leb(data, pos)
        sec_end = pos + sec_len
        if sec_id == 2:  # Import section
            count, pos = _read_u32_leb(data, pos)
            for _ in range(count):
                mlen, pos = _read_u32_leb(data, pos)
                mod = data[pos:pos + mlen].decode("utf-8", errors="replace")
                pos += mlen
                nlen, pos = _read_u32_leb(data, pos)
                name = data[pos:pos + nlen].decode("utf-8", errors="replace")
                pos += nlen
                kind = data[pos]
                pos += 1
                if kind == 0x00:  # func
                    _, pos = _read_u32_leb(data, pos)
                elif kind == 0x01:  # table
                    pos += 1  # elemtype
                    flags, pos = _read_u32_leb(data, pos)
                    _, pos = _read_u32_leb(data, pos)
                    if flags & 1:
                        _, pos = _read_u32_leb(data, pos)
                elif kind == 0x02:  # mem
                    flags, pos = _read_u32_leb(data, pos)
                    _, pos = _read_u32_leb(data, pos)
                    if flags & 1:
                        _, pos = _read_u32_leb(data, pos)
                elif kind == 0x03:  # global
                    pos += 2  # valtype + mutability
                elif kind == 0x04:  # tag
                    pos += 1
                    _, pos = _read_u32_leb(data, pos)
                imports.append((mod, name, kind))
            break
        pos = sec_end
    return imports


def extract_web_provided_pion_rt():
    provided = set()
    rt_path = os.path.join(INVAR_ROOT, "web", "pion_wasm_rt_web.min.mjs")
    bridge_path = os.path.join(INVAR_ROOT, "web", "pion_host_bridge.mjs")

    # Parse `pion_rt: { ... }` inside pion_wasm_rt_web.min.mjs (the file imported by index.html)
    if os.path.isfile(rt_path):
        src = open(rt_path, "r", encoding="utf-8").read()
        m = re.search(r"pion_rt\s*:\s*\{", src)
        if m:
            i = m.end()
            depth = 1
            while i < len(src) and depth > 0:
                ch = src[i]
                if ch == "{":
                    depth += 1
                elif ch == "}":
                    depth -= 1
                i += 1
            body = src[m.end():i - 1]
            # Strip nested braces/parens so we only see top-level keys of pion_rt object
            top = []
            d_brace = 0
            d_paren = 0
            in_str = None
            esc = False
            for ch in body:
                if in_str:
                    if esc:
                        esc = False
                    elif ch == "\\":
                        esc = True
                    elif ch == in_str:
                        in_str = None
                    continue
                if ch in ("'", '"', "`"):
                    in_str = ch
                    continue
                if ch == "{":
                    d_brace += 1
                    continue
                if ch == "}":
                    d_brace -= 1
                    continue
                if ch == "(":
                    d_paren += 1
                    continue
                if ch == ")":
                    d_paren -= 1
                    continue
                if d_brace == 0 and d_paren == 0:
                    top.append(ch)
            flat = "".join(top)
            for item in flat.split(","):
                item = item.strip()
                if not item:
                    continue
                key = item.split(":", 1)[0].strip()
                if re.match(r"^[A-Za-z_$][A-Za-z0-9_$]*$", key):
                    provided.add(key)

    # Parse bridge exports in pion_host_bridge.mjs
    if os.path.isfile(bridge_path):
        bsrc = open(bridge_path, "r", encoding="utf-8").read()
        # Object.assign(rt.imports.pion_rt, { ... }) or const hostImports = { ... }
        for m in re.finditer(r"Object\.assign\(\s*rt\.imports\.pion_rt\s*,\s*\{", bsrc):
            i = m.end()
            depth = 1
            while i < len(bsrc) and depth > 0:
                if bsrc[i] == "{":
                    depth += 1
                elif bsrc[i] == "}":
                    depth -= 1
                i += 1
            body = bsrc[m.end():i - 1]
            # Strip comments
            body = re.sub(r"//[^\n]*", "", body)
            for km in re.finditer(r"(?:^|[,{\s])([A-Za-z_$][A-Za-z0-9_$]*)\s*(?::|\()", body):
                name = km.group(1)
                if name.startswith("mb_web_") or name.startswith("invar_") or name.startswith("pion_"):
                    provided.add(name)
        for m in re.finditer(r"(?:rt\.imports\.pion_rt|pion_rt)\.([A-Za-z_$][A-Za-z0-9_$]*)\s*=", bsrc):
            provided.add(m.group(1))
        for m in re.finditer(r"\b(mb_web_[A-Za-z0-9_]+|invar_hostapi_[A-Za-z0-9_]+|getenv|fflush)\s*(?::|\()", bsrc):
            provided.add(m.group(1))

    return provided


def verify_wasm_imports(wasm_path):
    imps = parse_wasm_imports(wasm_path)
    provided = extract_web_provided_pion_rt()
    pion_rt_imps = [name for (mod, name, _k) in imps if mod == "pion_rt"]
    other_imps = [f"{mod}.{name}" for (mod, name, _k) in imps if mod != "pion_rt"]
    missing = [name for name in pion_rt_imps if name not in provided]
    return {
        "total": len(imps),
        "pion_rt_total": len(pion_rt_imps),
        "missing": missing,
        "other_modules": other_imps,
        "ok": len(missing) == 0 and len(other_imps) == 0,
    }


# ---------------------------------------------------------------------------
# Pure-Python PNG Decoder / Encoder (stdlib only: struct + zlib)
# ---------------------------------------------------------------------------

def _paeth(a, b, c):
    p = a + b - c
    pa = abs(p - a)
    pb = abs(p - b)
    pc = abs(p - c)
    if pa <= pb and pa <= pc:
        return a
    if pb <= pc:
        return b
    return c


def decode_png_rgba(path):
    with open(path, "rb") as f:
        data = f.read()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError(f"Not a PNG file: {path}")
    pos = 8
    w = h = bit_depth = color_type = 0
    idat = bytearray()
    while pos + 8 <= len(data):
        length, ctype = struct.unpack(">I4s", data[pos:pos + 8])
        chunk = data[pos + 8:pos + 8 + length]
        pos += 12 + length
        if ctype == b"IHDR":
            w, h, bit_depth, color_type, comp, filt, interlace = struct.unpack(">IIBBBBB", chunk)
            if bit_depth != 8 or interlace != 0:
                raise ValueError(f"Unsupported PNG format (bit_depth={bit_depth}, interlace={interlace})")
        elif ctype == b"IDAT":
            idat.extend(chunk)
        elif ctype == b"IEND":
            break

    bpp_map = {0: 1, 2: 3, 4: 2, 6: 4}
    if color_type not in bpp_map:
        raise ValueError(f"Unsupported PNG color_type={color_type}")
    bpp = bpp_map[color_type]
    raw = zlib.decompress(bytes(idat))
    stride = w * bpp
    if len(raw) < h * (stride + 1):
        raise ValueError("truncated PNG image data")
    recon = bytearray(h * stride)

    for y in range(h):
        row_start = y * (stride + 1)
        ftype = raw[row_start]
        src_off = row_start + 1
        dst_off = y * stride
        if ftype == 0:
            recon[dst_off:dst_off + stride] = raw[src_off:src_off + stride]
            continue
        prev_off = (y - 1) * stride
        for i in range(stride):
            x = raw[src_off + i]
            a = recon[dst_off + i - bpp] if i >= bpp else 0
            b = recon[prev_off + i] if y > 0 else 0
            c = recon[prev_off + i - bpp] if (y > 0 and i >= bpp) else 0
            if ftype == 1:
                v = (x + a) & 0xFF
            elif ftype == 2:
                v = (x + b) & 0xFF
            elif ftype == 3:
                v = (x + ((a + b) >> 1)) & 0xFF
            elif ftype == 4:
                v = (x + _paeth(a, b, c)) & 0xFF
            else:
                raise ValueError(f"Unknown PNG filter type {ftype}")
            recon[dst_off + i] = v

    if color_type == 6:
        return w, h, recon

    rgba = bytearray(w * h * 4)
    if color_type == 2:  # RGB
        for p in range(w * h):
            si = p * 3
            di = p * 4
            rgba[di] = recon[si]
            rgba[di + 1] = recon[si + 1]
            rgba[di + 2] = recon[si + 2]
            rgba[di + 3] = 255
    elif color_type == 0:  # Gray
        for p in range(w * h):
            g = recon[p]
            di = p * 4
            rgba[di] = g
            rgba[di + 1] = g
            rgba[di + 2] = g
            rgba[di + 3] = 255
    elif color_type == 4:  # GrayA
        for p in range(w * h):
            g = recon[p * 2]
            a = recon[p * 2 + 1]
            di = p * 4
            rgba[di] = g
            rgba[di + 1] = g
            rgba[di + 2] = g
            rgba[di + 3] = a
    return w, h, rgba


def encode_png_rgba(path, w, h, rgba):
    def _chunk(ctype, body):
        crc = zlib.crc32(ctype)
        crc = zlib.crc32(body, crc) & 0xFFFFFFFF
        return struct.pack(">I", len(body)) + ctype + body + struct.pack(">I", crc)

    raw = bytearray()
    row_bytes = w * 4
    for y in range(h):
        raw.append(0)  # Filter None
        off = y * row_bytes
        raw.extend(rgba[off:off + row_bytes])
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)
    out = bytearray(b"\x89PNG\r\n\x1a\n")
    out.extend(_chunk(b"IHDR", ihdr))
    out.extend(_chunk(b"IDAT", zlib.compress(bytes(raw), 6)))
    out.extend(_chunk(b"IEND", b""))
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "wb") as f:
        f.write(out)


def read_png_ihdr(path):
    with open(path, "rb") as f:
        hdr = f.read(24)
    if len(hdr) < 24 or hdr[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    w, h = struct.unpack(">II", hdr[16:24])
    return w, h


# ---------------------------------------------------------------------------
# Subcommand 1: doctor
# ---------------------------------------------------------------------------

def cmd_doctor(args):
    sys_os = platform.system().lower()
    arch = platform.machine()
    pionc = resolve_pionc()
    issues = []

    if not pionc["found"]:
        issues.append("pionc compiler not found (set PIONC or add pionc/pionc2 to PATH)")
    else:
        if not pionc["qbe"]:
            issues.append("qbe binary not found beside pionc (set PION_QBE)")
        if not pionc["libpionrt"]:
            issues.append("libpionrt.a not found beside pionc (set PION_RT_LIB)")

    hosts = {}
    # macOS & iOS
    if sys_os == "darwin":
        clang = shutil.which("clang")
        xcrun = shutil.which("xcrun")
        mac_sdk = None
        ios_sdk = None
        if xcrun:
            rc, out, _, _ = run_cmd(["xcrun", "--show-sdk-path"])
            if rc == 0:
                mac_sdk = out.strip()
            rc, out, _, _ = run_cmd(["xcrun", "--sdk", "iphonesimulator", "--show-sdk-path"])
            if rc == 0:
                ios_sdk = out.strip()
        hosts["macos"] = {"available": bool(clang and mac_sdk), "clang": clang, "xcrun": xcrun, "sdk": mac_sdk}
        hosts["ios"] = {"available": bool(xcrun and ios_sdk), "iphonesimulator_sdk": ios_sdk}
    else:
        hosts["macos"] = {"available": False}
        hosts["ios"] = {"available": False}

    # Linux
    if sys_os == "linux":
        cc = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
        pkg_cfg = shutil.which("pkg-config")
        req_libs = ["gtk4", "epoxy", "pangocairo", "pangoft2", "fontconfig", "gdk-pixbuf-2.0", "libsoup-3.0", "zlib"]
        missing_libs = []
        if pkg_cfg:
            for lib in req_libs:
                rc, _, _, _ = run_cmd([pkg_cfg, "--exists", lib])
                if rc != 0:
                    missing_libs.append(lib)
        else:
            missing_libs = req_libs
        ffmpeg = shutil.which("ffmpeg")
        mesa = os.path.exists("/usr/lib/x86_64-linux-gnu/dri/swrast_dri.so") or os.path.exists("/usr/lib/aarch64-linux-gnu/dri/swrast_dri.so")
        hosts["linux"] = {
            "available": bool(cc and not missing_libs),
            "cc": cc,
            "pkg_config": pkg_cfg,
            "missing_libs": missing_libs,
            "ffmpeg": ffmpeg,
            "mesa_llvmpipe": mesa,
        }
    else:
        hosts["linux"] = {"available": False}

    # Windows
    wv2_candidates = []
    wv2_root = os.path.join(INVAR_ROOT, "packages", "host", "native", "webview2")
    if os.path.isdir(wv2_root):
        for root_d, _dirs, files in os.walk(wv2_root):
            if "WebView2.h" in files:
                wv2_candidates.append(os.path.join(root_d, "WebView2.h"))
    baked_shaders = os.path.join(INVAR_ROOT, "packages", "host", "native", "win_shaders_baked.h")
    hosts["windows"] = {
        "available": sys_os == "windows" and bool(shutil.which("clang")) and bool(wv2_candidates),
        "clang": shutil.which("clang"),
        "lld": shutil.which("lld-link") or shutil.which("lld"),
        "llvm_rc": shutil.which("llvm-rc"),
        "webview2_header": wv2_candidates[0] if wv2_candidates else None,
        "baked_shaders": os.path.isfile(baked_shaders),
    }

    # Web
    node = shutil.which("node")
    wasm_opt = shutil.which("wasm-opt")
    brotli_bin = shutil.which("brotli")
    web_files = {f: os.path.isfile(os.path.join(INVAR_ROOT, "web", f)) for f in WEB_RUNTIME_FILES}
    if not node:
        issues.append("node not found on PATH (needed for web syntax checks)")
    for wf, exists in web_files.items():
        if not exists:
            issues.append(f"missing web/{wf}")
    web_info = {
        "available": bool(node) and all(web_files.values()),
        "node": node,
        "wasm_opt": wasm_opt,
        "brotli": brotli_bin,
        "files": web_files,
    }

    ok = pionc["found"] and bool(pionc["qbe"]) and bool(pionc["libpionrt"]) and web_info["available"]
    res = {
        "ok": ok,
        "invar_root": INVAR_ROOT,
        "os": sys_os,
        "arch": arch,
        "pionc": pionc,
        "hosts": hosts,
        "web": web_info,
        "issues": issues,
    }
    if args.json:
        emit_json(res)
    else:
        print(f"Invar Doctor ({sys_os}/{arch}) — {'OK' if ok else 'ISSUES FOUND'}")
        print(f"  root : {INVAR_ROOT}")
        print(f"  pionc: {pionc['path'] or 'NOT FOUND'}")
        print(f"  qbe  : {pionc['qbe'] or 'NOT FOUND'}")
        print(f"  rt   : {pionc['libpionrt'] or 'NOT FOUND'}")
        print(f"  web  : node={node or 'missing'}, wasm-opt={wasm_opt or 'optional'}, brotli={brotli_bin or 'optional'}")
        for iss in issues:
            print(f"  [!] {iss}")
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# Workspace & Parallel Execution Helpers
# ---------------------------------------------------------------------------

def _default_jobs(requested=0, cap=8):
    if requested and int(requested) > 0:
        return int(requested)
    cpus = os.cpu_count() or 4
    return max(1, min(cpus, cap))


def _parse_workspace_members():
    """Return set of realpaths listed under [workspace] members in INVAR_ROOT/pion.toml, or None."""
    ws_toml = os.path.join(INVAR_ROOT, "pion.toml")
    if not os.path.isfile(ws_toml):
        return None
    try:
        text = open(ws_toml, "r", encoding="utf-8").read()
    except OSError:
        return None
    in_ws = False
    in_members = False
    members = []
    for raw_line in text.splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        if line.startswith("["):
            in_ws = (line == "[workspace]")
            in_members = False
            continue
        if not in_ws:
            continue
        if not in_members:
            m = re.match(r"^members\s*=\s*\[(.*)$", line)
            if not m:
                continue
            rest = m.group(1)
            in_members = True
        else:
            rest = line
        end_idx = rest.find("]")
        chunk = rest[:end_idx] if end_idx >= 0 else rest
        for sm in re.finditer(r'"([^"]+)"', chunk):
            members.append(os.path.realpath(os.path.join(INVAR_ROOT, sm.group(1))))
        if end_idx >= 0:
            in_members = False
    return set(members) if members else None


def _read_pkg_manifest_name(pkg_dir):
    toml_path = os.path.join(pkg_dir, "pion.toml")
    if os.path.isfile(toml_path):
        try:
            in_pkg = False
            for raw_line in open(toml_path, "r", encoding="utf-8"):
                line = raw_line.split("#", 1)[0].strip()
                if not line:
                    continue
                if line.startswith("["):
                    in_pkg = (line == "[package]")
                    continue
                if in_pkg:
                    m = re.match(r'^name\s*=\s*"([^"]+)"', line)
                    if m:
                        return m.group(1)
        except OSError:
            pass
    return os.path.basename(os.path.normpath(pkg_dir))


def _parse_json_tail(text):
    """Parse JSON from stdout, tolerating leading non-JSON log lines."""
    s = (text or "").strip()
    if not s:
        return None
    try:
        return json.loads(s)
    except (ValueError, TypeError):
        pass
    for line in reversed(s.splitlines()):
        ls = line.strip()
        if ls.startswith("{") and ls.endswith("}"):
            try:
                return json.loads(ls)
            except (ValueError, TypeError):
                continue
    return None


def _format_diag_line(d):
    f = d.get("file", "")
    line = d.get("line", 0)
    col = d.get("col", 0)
    code = d.get("code", "")
    msg = d.get("message", "")
    loc = f"{f}:{line}:{col}" if f else ""
    prefix = f"{loc}: " if loc else ""
    code_s = f"[{code}] " if code else ""
    return f"{prefix}{code_s}{msg}".strip()


def _map_file_to_pkg_spec(file_path, pkg_dir_pairs):
    """Map a diagnostic file path to its owning package spec (longest dir prefix wins)."""
    if not file_path:
        return None
    cand = file_path if os.path.isabs(file_path) else os.path.join(INVAR_ROOT, file_path)
    real = os.path.realpath(cand)
    for pdir_real, spec in pkg_dir_pairs:
        if real == pdir_real or real.startswith(pdir_real + os.sep):
            return spec
    return None


def _filter_stderr_for_pkg(err_text, pdir_real, spec):
    """Extract stderr lines belonging to one package; fall back to stderr tail if unmatched."""
    raw = (err_text or "").strip()
    if not raw:
        return ""
    needles = [pdir_real + os.sep]
    if os.sep != "/":
        needles.append(pdir_real.replace(os.sep, "/") + "/")
    try:
        rel = os.path.relpath(pdir_real, INVAR_ROOT)
        if rel and not rel.startswith(".."):
            needles.append(rel + os.sep)
            needles.append(rel.replace(os.sep, "/") + "/")
    except ValueError:
        pass
    if spec:
        needles.append("/" + spec + "/")
    matched = [ln for ln in raw.splitlines() if any(nd in ln for nd in needles)]
    if matched:
        return "\n".join(matched).strip()[-1200:]
    return raw[-1200:]


def _run_pkg_fmt_check(pionc_path, env, pdir):
    pion_files = []
    src_dir = os.path.join(pdir, "src")
    if os.path.isdir(src_dir):
        for r_d, _ds, fs in os.walk(src_dir):
            for fn in sorted(fs):
                if fn.endswith(".pion"):
                    pion_files.append(os.path.join(r_d, fn))
    if not pion_files:
        return True, ""
    rc, out, err, _ = run_cmd([pionc_path, "fmt", "--check"] + pion_files, cwd=INVAR_ROOT, env=env)
    if rc != 0:
        return False, (out + err).strip()
    return True, ""


# ---------------------------------------------------------------------------
# Subcommand 2: check
# ---------------------------------------------------------------------------

def cmd_check(args):
    pionc = resolve_pionc()
    if not pionc["found"]:
        err = {"ok": False, "error": "pionc not found (set PIONC or add to PATH)"}
        emit_json(err) if args.json else print(err["error"], file=sys.stderr)
        return 1
    env = build_pion_env(pionc)
    if args.pkg:
        pkgs, skipped = list(args.pkg), []
    else:
        pkgs, skipped = discover_workspace_pkgs("check")
    t_all = time.monotonic()
    do_fmt = bool(args.fmt) and not bool(args.no_fmt)
    jobs = _default_jobs(getattr(args, "jobs", 0))

    ws_members = None if args.pkg else _parse_workspace_members()
    pkg_real_map = {spec: os.path.realpath(resolve_pkg_dir(spec)) for spec in pkgs}
    use_ws = (
        not args.pkg
        and ws_members is not None
        and set(pkg_real_map.values()) == ws_members
    )

    results = []
    all_ok = True
    ws_done = False
    precomputed_fmt = None

    if use_ws:
        fmt_results = {spec: (True, "") for spec in pkgs}
        if do_fmt:
            workers = min(max(1, len(pkgs)), jobs)
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = {
                    ex.submit(_run_pkg_fmt_check, pionc["path"], env, pkg_real_map[spec]): spec
                    for spec in pkgs
                }
                for fut in as_completed(futs):
                    spec = futs[fut]
                    fmt_results[spec] = fut.result()
            precomputed_fmt = fmt_results

        rc, out, err, _chk_ms = run_cmd([pionc["path"], "check", "--json", INVAR_ROOT], cwd=INVAR_ROOT, env=env)
        data = _parse_json_tail(out)
        pkg_diags = {spec: [] for spec in pkgs}
        unmapped_diags = []
        pkg_dir_pairs = sorted(
            [(pkg_real_map[s], s) for s in pkgs],
            key=lambda kv: len(kv[0]),
            reverse=True,
        )

        ws_check_ok = (rc == 0)
        has_diag_list = isinstance(data, dict) and isinstance(data.get("diagnostics"), list)
        if has_diag_list:
            if not data.get("ok", True) or data["diagnostics"]:
                ws_check_ok = False
            for d in data["diagnostics"]:
                if not isinstance(d, dict):
                    unmapped_diags.append(str(d))
                    continue
                owner = _map_file_to_pkg_spec(d.get("file", ""), pkg_dir_pairs)
                line_s = _format_diag_line(d)
                if owner is not None:
                    pkg_diags[owner].append(line_s)
                else:
                    unmapped_diags.append(line_s)
        elif rc != 0:
            ws_check_ok = False

        # Only accept workspace result when either all checks passed cleanly, or every diagnostic
        # mapped cleanly to its owning package. Otherwise (manifest error, unmapped error, or
        # non-zero exit with empty diagnostics), fall back to parallel per-package checks so
        # attribution is exact and unaffected packages still report accurately.
        mapped_diag_count = sum(len(v) for v in pkg_diags.values())
        ws_usable = (ws_check_ok and has_diag_list) or (
            not ws_check_ok and has_diag_list and mapped_diag_count > 0 and len(unmapped_diags) == 0
        )

        if ws_usable:
            ws_done = True
            for spec in pkgs:
                fmt_ok, fmt_err = fmt_results[spec]
                diags = pkg_diags[spec]
                check_ok = (len(diags) == 0)
                err_parts = []
                if fmt_err:
                    err_parts.append(fmt_err)
                if diags:
                    err_parts.append("\n".join(diags))
                pkg_ok = fmt_ok and check_ok
                if not pkg_ok:
                    all_ok = False
                results.append({
                    "pkg": spec,
                    "ok": pkg_ok,
                    "fmt_ok": fmt_ok,
                    "check_ok": check_ok,
                    "elapsed_ms": 0,
                    "error": "\n".join(err_parts).strip(),
                })
            if not ws_check_ok:
                all_ok = False

            if not args.json:
                for r in results:
                    status = "PASS" if r["ok"] else "FAIL"
                    print(f"[{status}] {r['pkg']}")
                    if r["error"]:
                        print("  " + r["error"].replace("\n", "\n  "))

    if not ws_done:
        def _check_one(spec):
            pdir = resolve_pkg_dir(spec)
            t0 = time.monotonic()
            fmt_ok = True
            check_ok = True
            err_msg = ""

            if not os.path.isdir(pdir):
                return {
                    "pkg": spec,
                    "ok": False,
                    "fmt_ok": False,
                    "check_ok": False,
                    "elapsed_ms": 0,
                    "error": f"package directory not found: {pdir}",
                }

            if do_fmt:
                if precomputed_fmt is not None and spec in precomputed_fmt:
                    fmt_ok, fmt_err = precomputed_fmt[spec]
                else:
                    fmt_ok, fmt_err = _run_pkg_fmt_check(pionc["path"], env, pdir)
                if not fmt_ok:
                    err_msg = fmt_err

            rc, out, err, _ = run_cmd([pionc["path"], "check", pdir], cwd=INVAR_ROOT, env=env)
            if rc != 0:
                check_ok = False
                err_msg = (err_msg + "\n" + (out + err).strip()).strip()

            pkg_ok = fmt_ok and check_ok
            ms = int((time.monotonic() - t0) * 1000)
            return {
                "pkg": spec,
                "ok": pkg_ok,
                "fmt_ok": fmt_ok,
                "check_ok": check_ok,
                "elapsed_ms": ms,
                "error": err_msg,
            }

        workers = min(max(1, len(pkgs)), jobs)
        by_idx = [None] * len(pkgs)
        if workers <= 1:
            for idx, spec in enumerate(pkgs):
                r = _check_one(spec)
                by_idx[idx] = r
                if not r["ok"]:
                    all_ok = False
                if not args.json:
                    status = "PASS" if r["ok"] else "FAIL"
                    print(f"[{status}] {r['pkg']} ({r['elapsed_ms']} ms)", flush=True)
                    if r["error"]:
                        print("  " + r["error"].replace("\n", "\n  "), flush=True)
        else:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = {ex.submit(_check_one, spec): idx for idx, spec in enumerate(pkgs)}
                for fut in as_completed(futs):
                    idx = futs[fut]
                    r = fut.result()
                    by_idx[idx] = r
                    if not r["ok"]:
                        all_ok = False
                    if not args.json:
                        status = "PASS" if r["ok"] else "FAIL"
                        print(f"[{status}] {r['pkg']} ({r['elapsed_ms']} ms)", flush=True)
                        if r["error"]:
                            print("  " + r["error"].replace("\n", "\n  "), flush=True)
        results = by_idx

    total_ms = int((time.monotonic() - t_all) * 1000)
    res = {
        "ok": all_ok,
        "elapsed_ms": total_ms,
        "fmt_checked": do_fmt,
        "packages": results,
        "skipped": skipped,
    }
    if args.json:
        emit_json(res)
    else:
        for sk in skipped:
            print(f"[SKIP] {sk['pkg']} ({sk['reason']})")
        print(f"invar check: {'OK' if all_ok else 'FAILED'} ({len(results)} packages, {len(skipped)} skipped, {total_ms} ms)")
    return 0 if all_ok else 1


# ---------------------------------------------------------------------------
# Subcommand 3: test
# ---------------------------------------------------------------------------

def cmd_test(args):
    pionc = resolve_pionc()
    if not pionc["found"]:
        err = {"ok": False, "error": "pionc not found (set PIONC or add to PATH)"}
        emit_json(err) if args.json else print(err["error"], file=sys.stderr)
        return 1
    env = build_pion_env(pionc)
    if args.pkg:
        pkgs, skipped = list(args.pkg), []
    else:
        pkgs, skipped = discover_workspace_pkgs("test")
    t_all = time.monotonic()
    with_deps = bool(getattr(args, "with_deps", False))
    req_jobs = int(getattr(args, "jobs", 0) or 0)
    jobs = _default_jobs(req_jobs)

    # Check if we can run the entire workspace in ONE native `pionc test --json <root>` call
    # (builds shared CAS objects once, compiles/links & runs all unique package tests in parallel).
    use_ws = False
    if not args.pkg and not with_deps:
        ws_members = _parse_workspace_members()
        if ws_members is not None:
            chk_pkgs, _ = discover_workspace_pkgs("check")
            chk_reals = {os.path.realpath(resolve_pkg_dir(s)) for s in chk_pkgs}
            skipped_reals = {os.path.realpath(resolve_pkg_dir(sk["pkg"])) for sk in skipped}
            if chk_reals == ws_members and not (skipped_reals & ws_members):
                use_ws = True

    results = []
    total_passed = 0
    total_failed = 0
    all_ok = True
    ws_done = False

    if use_ws:
        cmd = [pionc["path"], "test", "--json"]
        if args.filter:
            cmd += ["--filter", args.filter]
        if req_jobs > 0 and pionc.get("supports_jobs"):
            cmd += ["--jobs", str(req_jobs)]
        cmd.append(INVAR_ROOT)

        rc, out, err, _ws_ms = run_cmd(cmd, cwd=INVAR_ROOT, env=env)
        data = _parse_json_tail(out)
        spec_to_dir = {spec: os.path.realpath(resolve_pkg_dir(spec)) for spec in pkgs}
        spec_to_name = {spec: _read_pkg_manifest_name(spec_to_dir[spec]) for spec in pkgs}

        if isinstance(data, dict) and isinstance(data.get("tests"), list):
            by_name = {}
            for t in data["tests"]:
                if not isinstance(t, dict):
                    continue
                pname = t.get("pkg", "")
                rec = by_name.setdefault(pname, {"passed": 0, "failed": 0, "fail_names": []})
                if t.get("ok"):
                    rec["passed"] += 1
                else:
                    rec["failed"] += 1
                    rec["fail_names"].append(t.get("name", "<unnamed>"))

            ws_ok = (rc == 0 and bool(data.get("ok", False)) and int(data.get("failed", 0)) == 0)
            ws_failed_tests = sum(r["failed"] for r in by_name.values())
            reported_pkgs = set(data.get("packages") or []) if isinstance(data.get("packages"), list) else set()
            ws_pkgs_complete = all(n in reported_pkgs for n in spec_to_name.values())
            # Accept workspace result when all tests passed or concrete per-package test failures
            # were reported with every expected package accounted for. Otherwise (e.g. a
            # compile/typecheck/link/manifest error or an older pionc without workspace test
            # support), fall back to parallel per-package Path B so unaffected packages still run
            # and every failure is attributed to its exact package.
            if ws_ok or (ws_failed_tests > 0 and ws_pkgs_complete):
                ws_done = True
                seen_names = set()
                for spec in pkgs:
                    pname = spec_to_name[spec]
                    seen_names.add(pname)
                    rec = by_name.get(pname, {"passed": 0, "failed": 0, "fail_names": []})
                    passed = rec["passed"]
                    failed = rec["failed"]
                    pkg_ok = (failed == 0)
                    err_msg = ""
                    if failed > 0:
                        err_msg = "failed tests: " + ", ".join(rec["fail_names"])
                        pkg_stderr = _filter_stderr_for_pkg(err, spec_to_dir[spec], spec)
                        if pkg_stderr:
                            err_msg = err_msg + "\n" + pkg_stderr
                    total_passed += passed
                    total_failed += failed
                    if not pkg_ok:
                        all_ok = False
                    results.append({
                        "pkg": spec,
                        "ok": pkg_ok,
                        "passed": passed,
                        "failed": failed,
                        "elapsed_ms": 0,
                        "error": err_msg,
                    })
                # Defensively account for any workspace test package not in discovered `pkgs`
                for pname, rec in by_name.items():
                    if pname in seen_names:
                        continue
                    passed = rec["passed"]
                    failed = rec["failed"]
                    pkg_ok = (failed == 0)
                    total_passed += passed
                    total_failed += failed
                    if not pkg_ok:
                        all_ok = False
                    err_msg = ""
                    if failed > 0:
                        err_msg = "failed tests: " + ", ".join(rec["fail_names"])
                        pkg_stderr = _filter_stderr_for_pkg(err, os.path.join(INVAR_ROOT, "packages", pname), pname)
                        if pkg_stderr:
                            err_msg = err_msg + "\n" + pkg_stderr
                    results.append({
                        "pkg": pname,
                        "ok": pkg_ok,
                        "passed": passed,
                        "failed": failed,
                        "elapsed_ms": 0,
                        "error": err_msg,
                    })
                if not ws_ok:
                    all_ok = False

                if not args.json:
                    for r in results:
                        status = "PASS" if r["ok"] else "FAIL"
                        print(f"[{status}] {r['pkg']}: {r['passed']} passed, {r['failed']} failed")
                        if r["error"]:
                            print(r["error"])

    if not ws_done:
        use_only_pkg = bool(pionc.get("supports_only_pkg")) and not with_deps
        outer_workers = min(max(1, len(pkgs)), jobs)
        cpu_budget = req_jobs if req_jobs > 0 else (os.cpu_count() or 4)
        inner_jobs = max(1, cpu_budget // outer_workers)

        def _test_one(spec):
            pdir = resolve_pkg_dir(spec)
            t0 = time.monotonic()
            if not os.path.isdir(pdir):
                return {
                    "pkg": spec,
                    "ok": False,
                    "passed": 0,
                    "failed": 1,
                    "elapsed_ms": 0,
                    "error": f"package directory not found: {pdir}",
                }
            cmd = [pionc["path"], "test", "--json"]
            if use_only_pkg:
                cmd.append("--only-pkg")
            if args.filter:
                cmd += ["--filter", args.filter]
            if pionc.get("supports_jobs"):
                if outer_workers > 1:
                    cmd += ["--jobs", str(inner_jobs)]
                elif req_jobs > 0:
                    cmd += ["--jobs", str(req_jobs)]
            cmd.append(pdir)

            rc, out, err, _ = run_cmd(cmd, cwd=INVAR_ROOT, env=env)
            ms = int((time.monotonic() - t0) * 1000)
            data = _parse_json_tail(out)
            if isinstance(data, dict) and "passed" in data and "failed" in data:
                passed = int(data.get("passed", 0))
                failed = int(data.get("failed", 0))
                pkg_ok = (rc == 0 and bool(data.get("ok", False)) and failed == 0)
                if not pkg_ok and failed == 0:
                    failed = 1
                err_msg = ""
                if not pkg_ok:
                    fail_names = [
                        t.get("name", "<unnamed>")
                        for t in (data.get("tests") or [])
                        if isinstance(t, dict) and not t.get("ok")
                    ]
                    parts = []
                    if fail_names:
                        parts.append("failed tests: " + ", ".join(fail_names))
                    tail = (err or "").strip()[-1200:]
                    if tail:
                        parts.append(tail)
                    err_msg = "\n".join(parts).strip() or (out + "\n" + err).strip()[-1200:]
            else:
                combined = out + "\n" + err
                m = re.search(r"test result:\s*\w+\.\s*(\d+)\s+passed;\s*(\d+)\s+failed", combined)
                passed = int(m.group(1)) if m else 0
                failed = int(m.group(2)) if m else (0 if rc == 0 else 1)
                pkg_ok = (rc == 0 and failed == 0)
                err_msg = "" if pkg_ok else combined.strip()[-1200:]

            return {
                "pkg": spec,
                "ok": pkg_ok,
                "passed": passed,
                "failed": failed,
                "elapsed_ms": ms,
                "error": err_msg,
            }

        by_idx = [None] * len(pkgs)
        if outer_workers <= 1:
            for idx, spec in enumerate(pkgs):
                r = _test_one(spec)
                by_idx[idx] = r
                total_passed += r["passed"]
                total_failed += r["failed"]
                if not r["ok"]:
                    all_ok = False
                if not args.json:
                    status = "PASS" if r["ok"] else "FAIL"
                    print(f"[{status}] {r['pkg']}: {r['passed']} passed, {r['failed']} failed ({r['elapsed_ms']} ms)", flush=True)
                    if r["error"]:
                        print(r["error"], flush=True)
        else:
            with ThreadPoolExecutor(max_workers=outer_workers) as ex:
                futs = {ex.submit(_test_one, spec): idx for idx, spec in enumerate(pkgs)}
                for fut in as_completed(futs):
                    idx = futs[fut]
                    r = fut.result()
                    by_idx[idx] = r
                    total_passed += r["passed"]
                    total_failed += r["failed"]
                    if not r["ok"]:
                        all_ok = False
                    if not args.json:
                        status = "PASS" if r["ok"] else "FAIL"
                        print(f"[{status}] {r['pkg']}: {r['passed']} passed, {r['failed']} failed ({r['elapsed_ms']} ms)", flush=True)
                        if r["error"]:
                            print(r["error"], flush=True)
        results = by_idx

    total_ms = int((time.monotonic() - t_all) * 1000)
    res = {
        "ok": all_ok,
        "elapsed_ms": total_ms,
        "total_passed": total_passed,
        "total_failed": total_failed,
        "packages": results,
        "skipped": skipped,
    }
    if args.json:
        emit_json(res)
    else:
        for sk in skipped:
            print(f"[SKIP] {sk['pkg']} ({sk['reason']})")
        print(f"invar test: {'OK' if all_ok else 'FAILED'} ({total_passed} passed, {total_failed} failed, {len(skipped)} skipped, {total_ms} ms)")
    return 0 if all_ok else 1


# ---------------------------------------------------------------------------
# Subcommand 4: audit (including typed reactive static audit E007-E010)
# ---------------------------------------------------------------------------

REACTIVE_SIGNAL_WRITES = {
    "signals::Signal::set",
    "signals::Signal::set_at",
    "signals::Signal::update",
    "signals::DerivedSignal::set",
    "signals::DerivedSignal::update",
    "signals::Optimistic::push",
    "signals::Optimistic::set_value",
    "signals::Optimistic::clear",
    "signals::Keyed::set",
    "signals::Keyed::add",
    "signals::Keyed::remove",
    "signals::KeyedList::put",
    "signals::KeyedList::drop",
    "signals::Action::begin",
    "signals::Action::clear_error",
    "signals::ActionTicket::succeed",
    "signals::ActionTicket::succeed_if_latest",
    "signals::ActionTicket::fail",
    "signals::ActionTicket::fail_if_latest",
    "signals::ActionTicket::cancel",
}

REACTIVE_SIGNAL_READS = {
    "signals::Signal::get",
    "signals::ReadSignal::get",
    "signals::Computed::get",
