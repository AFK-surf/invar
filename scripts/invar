  >
    <ui::Col pad={16.0} gap={12.0}>
      <lg::SurfaceCard radius={28.0} pad={12.0} gap={10.0} label="Status">
        <ui::Row gap={8.0} align={.Middle}>
          <lg::Icon kind={.Sparkles} size={16.0} color_by=>{ lg::surface().accent } />
          <ui::Text text="Apple Two-Layer Surface" size={15.0} weight={600} color_by=>{ lg::surface().ink } />
          <ui::Spacer />
          <lg::Badge label_by=>{ status.get() } tone={.Success} dot />
        </ui::Row>
        <ui::Text text_by=>{ "Refreshes: \{count.get()}" } size={13.5} color_by=>{ lg::surface().ink_secondary } />
        <ui::Row gap={8.0} align={.Middle}>
          <lg::Button label="Refresh Now" prominent on_press=>{ let _ = worker.send(Cmd::Refresh) } />
        </ui::Row>
