      <lg::BarPillGroup in={tr} height={36.0} label="Toolbar">
        <lg::Button flat ghost height={36.0} pad_x={10.5} label="Refresh" on_press=>{ let _ = worker.send(Cmd::Refresh) }>
          <lg::Icon kind={.Refresh} size={15.0} />
        </lg::Button>
        <lg::Button flat ghost height={36.0} pad_x={10.5} label="Settings" on_press=>{ () }>
          <lg::Icon kind={.Settings} size={15.0} />
        </lg::Button>
